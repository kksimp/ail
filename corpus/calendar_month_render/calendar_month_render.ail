## Renders month calendars like the Unix cal tool. The weekday of any date
## comes from Sakamoto's integer formula, month lengths follow the Gregorian
## leap rule, and each month is drawn as a Sunday-first grid. Also counts the
## Friday the 13ths of a year.

fn day_names() List[str]
    ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]

fn month_names() List[str]
    ["January", "February", "March", "April", "May", "June", "July",
        "August", "September", "October", "November", "December"]

fn offsets() List[int]
    [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]

fn is_leap(year int) bool
    (year % 4 == 0 and year % 100 != 0) or year % 400 == 0

fn days_in_month(year int, month int) int
    if month == 2
        return if is_leap(year) then 29 else 28
    if month == 4 or month == 6 or month == 9 or month == 11
        return 30
    31

fn weekday(year int, month int, day int) int
    y := if month < 3 then year - 1 else year
    (y + y / 4 - y / 100 + y / 400 + offsets()[month - 1] + day) % 7

fn render(year int, month int) List[str]
    title := "{month_names()[month - 1]} {year}"
    pad := (20 - title.len()) / 2
    mut lines := [title.pad_left(pad + title.len(), ' '), "Su Mo Tu We Th Fr Sa"]
    mut cells := List[str]()
    for blank in 0..weekday(year, month, 1)
        cells.push("  ")
    for day in 1..=days_in_month(year, month)
        cells.push("{day:>2}")
    mut start := 0
    while start < cells.len()
        stop := (start + 7).min(cells.len())
        lines.push(cells[start..stop].join(" "))
        start += 7
    lines

fn friday_13ths(year int) List[str]
    mut out := List[str]()
    for month in 1..=12
        if weekday(year, month, 13) == 5
            out.push(month_names()[month - 1].slice(0, 3))
    out

fn main()
    for line in render(2024, 2)
        print(line)
    print("")
    for line2 in render(2026, 11)
        print(line2)
    print("")
    for line3 in render(2000, 2)
        print(line3)
    print("")
    print("2024-02-29 fell on a {day_names()[weekday(2024, 2, 29)]}")
    print("2026-11-13 is a {day_names()[weekday(2026, 11, 13)]}")
    print("2000-01-01 was a {day_names()[weekday(2000, 1, 1)]}")
    for year in [2023, 2024, 2026]
        print("Friday the 13th in {year}: {friday_13ths(year).join(" ")}")
    print("leap years 1896..1912: {[y for y in 1896..=1912 if is_leap(y)].join(" ")}")

@test fn known_weekdays()
    assert_eq(weekday(1970, 1, 1), 4)
    assert_eq(weekday(2000, 1, 1), 6)
    assert_eq(weekday(2024, 2, 29), 4)

@test fn leap_rule()
    assert(is_leap(2000))
    assert(not is_leap(1900))
    assert(is_leap(2024))
    assert(not is_leap(2023))

@test fn february_lengths()
    assert_eq(days_in_month(2024, 2), 29)
    assert_eq(days_in_month(2023, 2), 28)
    assert_eq(days_in_month(2023, 12), 31)

@test fn render_has_a_header_and_every_day()
    lines := render(2023, 2)
    assert_eq(lines[1], "Su Mo Tu We Th Fr Sa")
    assert_eq(lines[2], "          1  2  3  4")
    assert_eq(lines[lines.len() - 1], "26 27 28")
