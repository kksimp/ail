## A text buffer with undo and redo. Every edit is an enum value (insert or
## delete text at a position) that knows its inverse; the history keeps one
## stack of done edits and one of undone edits. A new edit clears redo.

enum Edit
    Insert(at int, text str)
    Delete(at int, text str)

fn Edit.invert(self) Edit
    match self
        Insert(p, t) => Edit.Delete(at: p, text: t)
        Delete(p, t) => Edit.Insert(at: p, text: t)

fn apply(doc str, e Edit) str
    match e
        Insert(at, text) =>
            front := doc.slice(0, at)
            back := doc.slice(at, doc.len())
            "{front}{text}{back}"
        Delete(at, text) =>
            front := doc.slice(0, at)
            back := doc.slice(at + text.len(), doc.len())
            "{front}{back}"

struct History
    doc str
    done List[Edit]
    undone List[Edit]

fn History.edit(mut self, e Edit)
    doc = apply(doc, e)
    done.push(e)
    undone.clear()

fn History.undo(mut self) bool
    e := done.pop() else return false
    inv := e.invert()
    doc = apply(doc, inv)
    undone.push(e)
    true

fn History.redo(mut self) bool
    e := undone.pop() else return false
    doc = apply(doc, e)
    done.push(e)
    true

fn History.status(self) str
    "\"{doc}\" (undo {done.len()}, redo {undone.len()})"

fn main()
    mut h := History(doc: "", done: [], undone: [])
    h.edit(Edit.Insert(at: 0, text: "hello world"))
    print(h.status())
    h.edit(Edit.Insert(at: 5, text: ","))
    h.edit(Edit.Delete(at: 7, text: "world"))
    h.edit(Edit.Insert(at: 7, text: "there"))
    print(h.status())
    for step in 1..=3
        h.undo()
        print("undo {step}: {h.status()}")
    h.redo()
    print("redo: {h.status()}")
    h.edit(Edit.Insert(at: 0, text: ">> "))
    print("new edit: {h.status()}")
    print("redo possible: {h.redo()}")
    while h.undo()
        continue
    print("all undone: {h.status()}")

@test fn undo_restores_the_previous_text()
    mut h := History(doc: "abc", done: [], undone: [])
    h.edit(Edit.Insert(at: 1, text: "XY"))
    assert_eq(h.doc, "aXYbc")
    assert(h.undo())
    assert_eq(h.doc, "abc")

@test fn redo_replays_an_undone_edit()
    mut h := History(doc: "abc", done: [], undone: [])
    h.edit(Edit.Delete(at: 0, text: "a"))
    h.undo()
    assert(h.redo())
    assert_eq(h.doc, "bc")

@test fn new_edit_clears_redo()
    mut h := History(doc: "", done: [], undone: [])
    h.edit(Edit.Insert(at: 0, text: "a"))
    h.undo()
    h.edit(Edit.Insert(at: 0, text: "b"))
    assert(not h.redo())
    assert(h.undo())
    assert(not h.undo())
