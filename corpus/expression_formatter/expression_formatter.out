1+2*3
  normal:  1 + 2 * 3
  full:    (1 + (2 * 3))
  re-parse stable: true
(1+2)*3
  normal:  (1 + 2) * 3
  full:    ((1 + 2) * 3)
  re-parse stable: true
a - (b - c)
  normal:  a - (b - c)
  full:    (a - (b - c))
  re-parse stable: true
((a*b))/(c*d)
  normal:  a * b / (c * d)
  full:    ((a * b) / (c * d))
  re-parse stable: true
-(x+1)*-y
  normal:  -(x + 1) * -y
  full:    (-(x + 1) * -y)
  re-parse stable: true
1 + * 2: syntax error
(1+2: syntax error
