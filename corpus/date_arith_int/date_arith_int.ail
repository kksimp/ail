## Date arithmetic with integers only: converts civil dates to day counts since
## 1970-01-01 and back (proleptic Gregorian), then adds days, takes differences,
## finds weekdays and day-of-year, and validates calendar dates.

struct Date
    y int
    m int
    d int

fn is_leap(y int) bool
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0

fn days_in_month(y int, m int) int
    match m
        2 => if is_leap(y) then 29 else 28
        4 | 6 | 9 | 11 => 30
        _ => 31

fn valid(dt Date) bool
    dt.y >= 1970 and dt.m >= 1 and dt.m <= 12 and dt.d >= 1 and dt.d <= days_in_month(dt.y, dt.m)

fn to_days(dt Date) int
    yy := if dt.m <= 2 then dt.y - 1 else dt.y
    era := yy / 400
    yoe := yy - era * 400
    mp := (dt.m + 9) % 12
    doy := (153 * mp + 2) / 5 + dt.d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

fn from_days(days int) Date
    z := days + 719468
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10 then mp + 3 else mp - 9
    y := yoe + era * 400
    ry := if m <= 2 then y + 1 else y
    Date(y: ry, m: m, d: d)

fn show(dt Date) str
    "{dt.y}-{dt.m:02}-{dt.d:02}"

fn parse(text str) Date?
    parts := text.split("-")
    if parts.len() != 3
        return none
    dt := Date(y: parts[0].to_int()?, m: parts[1].to_int()?, d: parts[2].to_int()?)
    if valid(dt)
        return dt
    none

fn weekday(dt Date) str
    names := ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"]
    names[to_days(dt) % 7]

fn day_of_year(dt Date) int
    to_days(dt) - to_days(Date(y: dt.y, m: 1, d: 1)) + 1

fn add_days(dt Date, n int) Date
    from_days(to_days(dt) + n)

fn main()
    inputs := [
        "1970-01-01",
        "2000-02-29",
        "2024-03-01",
        "2023-02-29",
        "2024-12-31",
        "1969-12-31",
        "2100-02-29",
        "bad",
    ]
    for t in inputs
        dt := parse(t) else
            print("{t}: invalid")
            continue
        span := if is_leap(dt.y) then 366 else 365
        print("{show(dt)} {weekday(dt)} day {day_of_year(dt)} of {span} days={to_days(dt)}")
    start := Date(y: 2024, m: 1, d: 31)
    for n in [1, 29, 30, 366, 10000]
        print("{show(start)} + {n} = {show(add_days(start, n))}")
    a := Date(y: 2000, m: 1, d: 1)
    b := Date(y: 2024, m: 11, d: 13)
    print("days from {show(a)} to {show(b)}: {to_days(b) - to_days(a)}")

@test fn epoch_is_zero()
    assert_eq(to_days(Date(y: 1970, m: 1, d: 1)), 0)
    assert_eq(to_days(Date(y: 1970, m: 3, d: 1)), 59)

@test fn round_trips_every_day()
    for n in 0..800
        assert_eq(to_days(from_days(n * 37)), n * 37)

@test fn leap_rules()
    assert(is_leap(2000))
    assert(not is_leap(2100))
    assert(valid(Date(y: 2024, m: 2, d: 29)))
    assert(not valid(Date(y: 2023, m: 2, d: 29)))
    assert_eq(weekday(Date(y: 2000, m: 1, d: 1)), "Sat")
