## Shapes behind one trait: each shape reports its area and perimeter in
## integers (pi is taken as 3), the trait's default describe() builds a line
## from them, and a mixed list of shapes is totalled and ranked by area.

trait Shape
    fn area(self) int
    fn perimeter(self) int
    fn name(self) str
    fn describe(self) str
        "{self.name()}: area {self.area()}, perimeter {self.perimeter()}"

struct Circle
    r int

struct Rect
    w int
    h int

struct RightTriangle
    a int
    b int
    c int

impl Shape for Circle
    fn area(self) int
        3 * self.r * self.r
    fn perimeter(self) int
        6 * self.r
    fn name(self) str
        "circle"

impl Shape for Rect
    fn area(self) int
        self.w * self.h
    fn perimeter(self) int
        2 * (self.w + self.h)
    fn name(self) str
        if self.w == self.h
            "square"
        else
            "rect"

impl Shape for RightTriangle
    fn area(self) int
        self.a * self.b / 2
    fn perimeter(self) int
        self.a + self.b + self.c
    fn name(self) str
        "triangle"
    fn describe(self) str
        "triangle {self.a}-{self.b}-{self.c} with area {self.area()}"

struct Ranked
    area int
    name str

impl Ord for Ranked

fn total_area(shapes List[any Shape]) int
    mut sum := 0
    for s in shapes
        sum += s.area()
    sum

fn ranking(shapes List[any Shape]) List[Ranked]
    ranked := [Ranked(area: s.area(), name: s.name()) for s in shapes]
    ranked.sorted().reversed()

fn main()
    mut all := List[any Shape]()
    all.push(Circle(r: 4))
    all.push(Rect(w: 6, h: 3))
    all.push(RightTriangle(a: 6, b: 8, c: 10))
    all.push(Rect(w: 5, h: 5))
    all.push(Circle(r: 1))
    for s in all
        print(s.describe())
    print("total area: {total_area(all)}")
    mut place := 1
    for r in ranking(all)
        print("{place}. {r.name} {r.area}")
        place += 1

@test fn circle_uses_three_for_pi()
    assert_eq(Circle(r: 2).area(), 12)
    assert_eq(Circle(r: 2).perimeter(), 12)

@test fn rect_names_squares()
    assert_eq(Rect(w: 3, h: 3).name(), "square")
    assert_eq(Rect(w: 3, h: 4).name(), "rect")

@test fn default_describe_uses_the_methods()
    assert_eq(Rect(w: 2, h: 5).describe(), "rect: area 10, perimeter 14")
    assert_eq(RightTriangle(a: 3, b: 4, c: 5).area(), 6)
