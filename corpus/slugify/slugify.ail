## Slugify: turns titles into URL slugs (lowercase words joined by "-"),
## truncates at word boundaries, and makes repeated slugs unique with a counter.

fn words_of(title str) List[str]
    mut words := List[str]()
    mut cur := ""
    for c in title.to_lower().chars()
        if c.is_alpha() or c.is_digit()
            cur = "{cur}{c}"
        elif cur != ""
            words.push(cur)
            cur = ""
    if cur != ""
        words.push(cur)
    words

fn slugify(title str, max_len int) str
    mut out := ""
    for w in words_of(title)
        cand := if out == "" then w else "{out}-{w}"
        if cand.len() > max_len
            if out == ""
                out = w.slice(0, max_len)
            break
        out = cand
    out

fn unique_slugs(titles List[str], max_len int) List[str]
    mut seen := Map[str, int]()
    mut out := List[str]()
    for t in titles
        base := slugify(t, max_len)
        seen[base] += 1
        n := seen[base]
        if n == 1
            out.push(base)
        else
            out.push("{base}-{n}")
    out

fn main()
    titles := [
        "Hello, World!",
        "  Parsing JSON: A Practical Guide  ",
        "C++ vs. Rust vs. AIL (2026 edition)",
        "Hello, World!",
        "100% Memory-Safe",
        "!!!",
        "Hello World",
        "An extraordinarily long title that keeps going and going",
    ]
    for t in titles
        print("{t:<58} -> '{slugify(t, 30)}'")
    print("unique:")
    for s in unique_slugs(titles, 30)
        print("  {s}")

@test fn basic_slugs()
    assert_eq(slugify("Hello, World!", 50), "hello-world")
    assert_eq(slugify("  A  b--c ", 50), "a-b-c")
    assert_eq(slugify("!!!", 50), "")

@test fn truncates_on_word_boundaries()
    assert_eq(slugify("alpha beta gamma", 10), "alpha-beta")
    assert_eq(slugify("alpha beta gamma", 5), "alpha")
    assert_eq(slugify("supercalifragilistic", 5), "super")

@test fn makes_unique()
    assert_eq(unique_slugs(["A b", "a  B", "c", "A-b"], 20), ["a-b", "a-b-2", "c", "a-b-3"])
