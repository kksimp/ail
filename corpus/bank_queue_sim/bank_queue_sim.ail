## A bank with two tellers and one FIFO line, simulated minute by minute.
## Customers arrive and need a service time, both generated from an integer
## LCG. Prints who is served by which teller and when, then the waiting
## statistics and the longest the line ever got.

struct Customer
    arrive int
    need int

fn next_rand(s int) int
    (s * 1103515245 + 12345) % 2147483648

fn make_customers(n int, seed int) List[Customer]
    mut s := seed
    mut clock := 0
    mut out := List[Customer]()
    for k in 0..n
        s = next_rand(s)
        clock += 1 + s / 65536 % 3
        s = next_rand(s)
        out.push(Customer(arrive: clock, need: 2 + s / 65536 % 5))
    out

struct Stats
    served int
    total_wait int
    worst_wait int
    longest_line int
    finished_at int

fn simulate(people List[Customer], tellers int, verbose bool) Stats
    mut busy_until := List[int]()
    for i in 0..tellers
        busy_until.push(0)
    mut line := List[int]()
    mut head := 0
    mut next_arrival := 0
    mut st := Stats(served: 0, total_wait: 0, worst_wait: 0, longest_line: 0, finished_at: 0)
    mut t := 0
    while st.served < people.len()
        while next_arrival < people.len() and people[next_arrival].arrive == t
            line.push(next_arrival)
            next_arrival += 1
        waiting := line.len() - head
        if waiting > st.longest_line
            st.longest_line = waiting
        for k2 in 0..tellers
            if busy_until[k2] <= t and head < line.len()
                who := line[head]
                head += 1
                waited := t - people[who].arrive
                busy_until[k2] = t + people[who].need
                st.served += 1
                st.total_wait += waited
                st.worst_wait = st.worst_wait.max(waited)
                st.finished_at = st.finished_at.max(busy_until[k2])
                if verbose
                    print("t={t:>2} teller {k2 + 1} takes customer {who + 1} (waited {waited}, needs {people[who].need})")
        t += 1
    st

fn main()
    people := make_customers(12, 99)
    st := simulate(people, 2, true)
    print("served: {st.served}")
    print("total wait: {st.total_wait}")
    print("average wait x10: {st.total_wait * 10 / st.served}")
    print("worst wait: {st.worst_wait}")
    print("longest line: {st.longest_line}")
    print("last teller free at: {st.finished_at}")
    one := simulate(people, 1, false)
    print("with one teller: total wait {one.total_wait}, finished at {one.finished_at}")

@test fn single_customer_never_waits()
    st := simulate([Customer(arrive: 3, need: 4)], 1, false)
    assert_eq(st.served, 1)
    assert_eq(st.total_wait, 0)
    assert_eq(st.finished_at, 7)

@test fn second_customer_waits_for_the_only_teller()
    st := simulate([Customer(arrive: 1, need: 5), Customer(arrive: 2, need: 1)], 1, false)
    assert_eq(st.total_wait, 4)
    assert_eq(st.worst_wait, 4)
    assert_eq(st.longest_line, 1)

@test fn more_tellers_never_hurt()
    people := make_customers(10, 5)
    a := simulate(people, 1, false)
    b := simulate(people, 3, false)
    assert(b.total_wait <= a.total_wait)
