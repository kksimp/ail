## A round-robin CPU scheduler. Jobs arrive at fixed ticks and run for at most
## one quantum before going to the back of the ready ring. A job that arrives
## during a slice queues ahead of the job that was just preempted. The program
## prints the timeline and turnaround and waiting times for three quanta.

struct Job
    name str
    arrival int
    burst int
    left int
    finish int

struct Report
    jobs List[Job]
    slices List[str]
    switches int

fn Job.new(label str, start int, dur int) Job
    Job(name: label, arrival: start, burst: dur, left: dur, finish: 0)

fn Job.turnaround(self) int
    finish - arrival

fn Job.waiting(self) int
    finish - arrival - burst

fn simulate(jobs List[Job], quantum int) Report
    mut work := jobs
    n := work.len()
    mut ready := Deque[int]()
    mut clock := 0
    mut next := 0
    mut done := 0
    mut slices := List[str]()
    mut switches := 0
    while done < n
        while next < n and work[next].arrival <= clock
            ready.push_back(next)
            next += 1
        if ready.is_empty()
            clock = work[next].arrival
            continue
        idx := ready.pop_front() else continue
        run := quantum.min(work[idx].left)
        slices.push("{work[idx].name}x{run}")
        clock += run
        work[idx].left -= run
        while next < n and work[next].arrival <= clock
            ready.push_back(next)
            next += 1
        if work[idx].left > 0
            ready.push_back(idx)
            switches += 1
        else
            work[idx].finish = clock
            done += 1
    Report(jobs: work, slices: slices, switches: switches)

fn summarize(label str, r Report)
    timeline := r.slices.join(" ")
    print("{label}: {timeline}")
    mut turn := 0
    mut wait := 0
    for j in r.jobs
        turn += j.turnaround()
        wait += j.waiting()
    print("  turnaround total {turn}, waiting total {wait}, preemptions {r.switches}")
    finishes := ["{q.name}@{q.finish}" for q in r.jobs]
    ends := finishes.join(" ")
    print("  finish: {ends}")

fn main()
    jobs := [
        Job.new("A", 0, 5),
        Job.new("B", 1, 3),
        Job.new("C", 2, 8),
        Job.new("D", 3, 2),
        Job.new("E", 20, 4),
    ]
    summarize("q=2", simulate(jobs, 2))
    summarize("q=4", simulate(jobs, 4))
    summarize("q=100 (first come first served)", simulate(jobs, 100))

@test fn single_job_runs_to_completion()
    r := simulate([Job.new("X", 0, 5)], 2)
    assert_eq(r.jobs[0].finish, 5)
    assert_eq(r.slices, ["Xx2", "Xx2", "Xx1"])
    assert_eq(r.switches, 2)

@test fn idle_gap_jumps_to_next_arrival()
    r := simulate([Job.new("A", 0, 1), Job.new("B", 10, 2)], 4)
    assert_eq(r.jobs[1].finish, 12)
    assert_eq(r.jobs[1].waiting(), 0)

@test fn arrival_queues_before_preempted_job()
    r := simulate([Job.new("A", 0, 4), Job.new("B", 1, 1)], 2)
    assert_eq(r.slices, ["Ax2", "Bx1", "Ax2"])
    assert_eq(r.jobs[0].finish, 5)
