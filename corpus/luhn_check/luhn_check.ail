## Luhn checker: validates card-style numbers (spaces and dashes ignored),
## computes the check digit for a payload, and names the issuer by prefix.

fn digits_of(s str) List[int]?
    mut ds := List[int]()
    for c in s.chars()
        if c == ' ' or c == '-'
            continue
        d := c.to_digit(10) else return none
        ds.push(d)
    ds

fn luhn_sum(ds List[int]) int
    mut total := 0
    for i in 0..ds.len()
        mut v := ds[ds.len() - 1 - i]
        if i % 2 == 1
            v = v * 2
            if v > 9
                v -= 9
        total += v
    total

fn is_valid(s str) bool
    ds := digits_of(s) else return false
    ds.len() >= 2 and luhn_sum(ds) % 10 == 0

fn check_digit(payload List[int]) int
    mut ds := payload
    ds.push(0)
    (10 - luhn_sum(ds) % 10) % 10

fn with_check(payload str) str
    ds := digits_of(payload) else return ""
    "{payload}{check_digit(ds)}"

fn issuer(s str) str
    ds := digits_of(s) else return "unknown"
    if ds.len() < 2
        return "unknown"
    two := ds[0] * 10 + ds[1]
    if ds[0] == 4
        return "visa"
    if two >= 51 and two <= 55
        return "mastercard"
    if two == 34 or two == 37
        return "amex"
    if two == 60 or two == 65
        return "discover"
    "other"

fn main()
    samples := ["79927398713", "4111 1111 1111 1111", "5500-0000-0000-0004", "3782 822463 10005", "6011111111111117", "4111 1111 1111 1112", "1234 5678 9012 3456", "12a4", "0", "8"]
    for s in samples
        verdict := if is_valid(s) then "valid" else "invalid"
        print("{s:<22} {verdict:<8} {issuer(s)}")
    for payload in ["7992739871", "411111111111111", "37828224631000"]
        full := with_check(payload)
        print("{payload} -> {full} ({is_valid(full)})")

@test fn known_numbers()
    assert(is_valid("79927398713"))
    assert(not is_valid("79927398710"))
    assert(is_valid("4111-1111-1111-1111"))

@test fn rejects_garbage()
    assert(not is_valid("12x4"))
    assert(not is_valid(""))
    assert(not is_valid("0"))

@test fn check_digits()
    assert_eq(check_digit([7, 9, 9, 2, 7, 3, 9, 8, 7, 1]), 3)
    assert_eq(with_check("7992739871"), "79927398713")
    assert_eq(issuer("4111111111111111"), "visa")
    assert_eq(issuer("378282246310005"), "amex")
