   n | binary           | octal | hex  | ones
   0 | 0                |     0 |    0 | 0
   5 | 101              |     5 |    5 | 2
  10 | 1010             |    12 |    A | 2
 255 | 11111111         |   377 |   FF | 8
1000 | 1111101000       |  1750 |  3E8 | 6
65535 | 1111111111111111 | 177777 | FFFF | 16
101101 in base 2 = 45
777 in base 8 = 511
FF in base 16 = 255
Z9 in base 16 = -1
12 in base 2 = -1
   1 -> 00000001
  -1 -> 11111111
  -2 -> 11111110
-128 -> 10000000
 127 -> 01111111
 100 -> 01100100
-100 -> 10011100
gray code: 000 001 011 010 110 111 101 100
