## A binary search tree stored in parallel arrays (child links are indices,
## -1 for none). Supports insert, lookup with depth, ordered traversal,
## height, min/max and a rank query. Keys come from an integer LCG.

struct Bst
    keys List[int]
    left List[int]
    right List[int]

fn Bst.new() Bst
    Bst(keys: [], left: [], right: [])

fn Bst.insert(mut self, k int) bool
    nid := self.keys.len()
    if nid == 0
        self.keys.push(k)
        self.left.push(-1)
        self.right.push(-1)
        return true
    mut cur := 0
    while true
        if k == self.keys[cur]
            return false
        if k < self.keys[cur]
            if self.left[cur] == -1
                self.left[cur] = nid
                break
            cur = self.left[cur]
        else
            if self.right[cur] == -1
                self.right[cur] = nid
                break
            cur = self.right[cur]
    self.keys.push(k)
    self.left.push(-1)
    self.right.push(-1)
    true

fn Bst.depth_of(self, k int) int
    if self.keys.len() == 0
        return -1
    mut cur := 0
    mut d := 0
    while cur != -1
        if k == self.keys[cur]
            return d
        cur = if k < self.keys[cur] then self.left[cur] else self.right[cur]
        d += 1
    -1

fn Bst.inorder(self, i int) List[int]
    if i == -1
        return List[int]()
    mut out := self.inorder(self.left[i])
    out.push(self.keys[i])
    out.extend(self.inorder(self.right[i]))
    out

fn Bst.height(self, i int) int
    if i == -1
        return 0
    lh := self.height(self.left[i])
    rh := self.height(self.right[i])
    1 + lh.max(rh)

fn next_rand(s int) int
    (s * 1103515245 + 12345) % 2147483648

fn main()
    mut tree := Bst.new()
    mut seed := 7
    mut dups := 0
    for i in 0..20
        seed = next_rand(seed)
        if not tree.insert(seed / 65536 % 50)
            dups += 1
    sorted_keys := tree.inorder(0)
    print("keys in order: {sorted_keys}")
    print("nodes: {tree.keys.len()}, duplicates skipped: {dups}")
    print("height: {tree.height(0)}")
    print("min: {sorted_keys[0]}, max: {sorted_keys[sorted_keys.len() - 1]}")
    for probe in [tree.keys[0], 25, 49, 100]
        print("depth of {probe}: {tree.depth_of(probe)}")
    below := [k for k in sorted_keys if k < 25]
    print("keys below 25: {below.len()}")

@test fn insert_rejects_duplicates()
    mut t := Bst.new()
    assert(t.insert(5))
    assert(t.insert(3))
    assert(not t.insert(5))
    assert_eq(t.keys.len(), 2)

@test fn traversal_is_sorted()
    mut t := Bst.new()
    for k in [8, 3, 10, 1, 6, 14, 4]
        t.insert(k)
    assert_eq(t.inorder(0), [1, 3, 4, 6, 8, 10, 14])
    assert_eq(t.height(0), 4)

@test fn depth_of_missing_key()
    mut t := Bst.new()
    t.insert(2)
    t.insert(1)
    assert_eq(t.depth_of(1), 1)
    assert_eq(t.depth_of(9), -1)
