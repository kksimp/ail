## Markdown headings: extracts the headings of a document (skipping fenced
## code) and prints an indented table of contents with unique anchor slugs.

struct Heading
    level int
    title str

fn sample() List[str]
    [
        "# Guide",
        "Intro text.",
        "## Install",
        "```",
        "# not a heading",
        "```",
        "## Usage",
        "### Flags",
        "####### too deep",
        "#nospace",
        "## Usage",
        "# Done",
    ]

fn parse_heading(line str) Heading?
    mut n := 0
    for c in line.chars()
        if c == '#'
            n += 1
        else
            break
    rest := line.slice(n, line.len())
    if n < 1 or n > 6 or not rest.starts_with(" ")
        return none
    Heading(level: n, title: rest.trim())

fn headings(lines List[str]) List[Heading]
    mut out := List[Heading]()
    mut fenced := false
    for line in lines
        if line.starts_with("```")
            fenced = not fenced
            continue
        if fenced
            continue
        h := parse_heading(line) else continue
        out.push(h)
    out

fn slug(title str) str
    mut out := ""
    for c in title.to_lower().chars()
        if c.is_alpha() or c.is_digit()
            out = "{out}{c}"
        elif c == ' ' or c == '-'
            out = "{out}-"
    out

fn main()
    hs := headings(sample())
    print("{hs.len()} headings")
    mut seen := Map[str, int]()
    for h in hs
        base := slug(h.title)
        k := seen.get(base) else 0
        seen[base] = k + 1
        anchor := if k == 0 then base else "{base}-{k}"
        pad := "".pad_left((h.level - 1) * 2, ' ')
        print("{pad}- {h.title} (#{anchor})")

@test fn parses_levels()
    h := parse_heading("### Hello World")?
    assert_eq(h.level, 3)
    assert_eq(h.title, "Hello World")
    assert(parse_heading("#Hello") == none)
    assert(parse_heading("plain") == none)

@test fn slugs()
    assert_eq(slug("Hello, World 2"), "hello-world-2")
    assert_eq(slug("A - B"), "a---b")
