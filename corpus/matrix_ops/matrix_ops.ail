## Integer matrix toolkit: multiply, transpose, identity, trace, a 3x3
## determinant and fast exponentiation modulo a prime. Matrix powers compute
## Fibonacci numbers and count walks in a small graph.

fn identity(n int) List[List[int]]
    mut out := List[List[int]]()
    for i in 0..n
        mut row := List[int]()
        for j in 0..n
            row.push(if i == j then 1 else 0)
        out.push(row)
    out

fn mat_mul(a List[List[int]], b List[List[int]], m int) List[List[int]]
    n := a.len()
    mut out := List[List[int]]()
    for i in 0..n
        mut row := List[int]()
        for j in 0..n
            mut acc := 0
            for k in 0..n
                acc += a[i][k] * b[k][j]
            row.push(acc % m)
        out.push(row)
    out

fn mat_pow(base List[List[int]], e int, m int) List[List[int]]
    mut result := identity(base.len())
    mut sq := base
    mut left := e
    while left > 0
        if left % 2 == 1
            result = mat_mul(result, sq, m)
        sq = mat_mul(sq, sq, m)
        left /= 2
    result

fn transpose(a List[List[int]]) List[List[int]]
    n := a.len()
    mut out := List[List[int]]()
    for i in 0..n
        mut row := List[int]()
        for j in 0..n
            row.push(a[j][i])
        out.push(row)
    out

fn trace(a List[List[int]]) int
    mut t := 0
    for i in 0..a.len()
        t += a[i][i]
    t

fn det3(a List[List[int]]) int
    t0 := a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1])
    t1 := a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0])
    t2 := a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0])
    t0 - t1 + t2

fn show(label str, a List[List[int]])
    print("{label}:")
    for row in a
        text := row.join(" ")
        print("  {text}")

fn main()
    a := [[2, 0, 1], [1, 3, 2], [0, 1, 4]]
    b := [[1, 2, 0], [0, 1, 1], [3, 0, 1]]
    big := 1000003
    show("a * b", mat_mul(a, b, big))
    show("transpose of a", transpose(a))
    print("trace of a: {trace(a)}")
    print("det of a: {det3(a)}")
    print("det of b: {det3(b)}")
    fib := [[1, 1], [1, 0]]
    for n in [1, 10, 30, 90]
        f := mat_pow(fib, n, big)
        print("fib({n}) mod {big} = {f[0][1]}")
    walks := [[0, 1, 1], [1, 0, 1], [1, 1, 0]]
    w := mat_pow(walks, 6, big)
    print("walks of length 6 from node 0 to node 0: {w[0][0]}")

@test fn identity_is_neutral()
    a := [[2, 0, 1], [1, 3, 2], [0, 1, 4]]
    assert_eq(mat_mul(a, identity(3), 1000003), a)

@test fn fibonacci_by_power()
    f := mat_pow([[1, 1], [1, 0]], 10, 1000003)
    assert_eq(f[0][1], 55)

@test fn determinant_of_identity()
    assert_eq(det3(identity(3)), 1)
    assert_eq(trace(identity(4)), 4)
