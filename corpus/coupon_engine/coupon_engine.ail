## Coupon engine. Coupons have a kind (percent, capped percent, fixed amount),
## a minimum total, an expiry day and a use limit. An order applies up to two
## codes in sequence, each to the running total; invalid codes fail with typed
## errors and do not use up the coupon.

error enum CouponError
    UnknownCode(code str) "unknown coupon {code}"
    Expired(code str, day int) "{code} expired on day {day}"
    MinNotMet(code str, need int) "{code} needs a total of at least {need}"
    Exhausted(code str) "{code} has no uses left"

enum Kind
    Percent(pct int)
    Capped(pct int, limit int)
    Fixed(cents int)

struct Coupon
    kind Kind
    min_total int
    expires int
    max_uses int

struct Engine
    coupons Map[str, Coupon]
    used Map[str, int]

fn money(cents int) str
    rest := cents % 100
    "{cents / 100}.{rest:0>2}"

fn amount(kind Kind, total int) int
    match kind
        Percent(p) => total * p / 100
        Capped(q, limit) => (total * q / 100).min(limit)
        Fixed(cents) => cents.min(total)

fn Engine.redeem(mut self, code str, total int, day int) int ! CouponError
    c := self.coupons.get(code) else return UnknownCode(code: code)
    if day > c.expires
        return Expired(code: code, day: c.expires)
    if total < c.min_total
        return MinNotMet(code: code, need: c.min_total)
    n := self.used.get(code) else 0
    if n >= c.max_uses
        return Exhausted(code: code)
    self.used[code] = n + 1
    amount(c.kind, total)

fn Engine.price(mut self, id int, total int, day int, codes str)
    mut running := total
    mut applied := 0
    for code in codes.split(",")
        if applied >= 2
            print("  {code}: skipped, two coupons per order")
            continue
        d := self.redeem(code, running, day) else err
            print("  {code}: {err}")
            continue
        running -= d
        applied += 1
        print("  {code}: -{money(d)}")
    print("order {id}: {money(total)} -> {money(running)}")

fn main()
    mut engine := Engine(coupons: {}, used: {})
    engine.coupons["TENOFF"] = Coupon(
        kind: Kind.Percent(pct: 10),
        min_total: 0,
        expires: 30,
        max_uses: 3,
    )
    engine.coupons["BIG20"] = Coupon(
        kind: Kind.Capped(pct: 20, limit: 2500),
        min_total: 10000,
        expires: 30,
        max_uses: 2,
    )
    engine.coupons["FIVER"] = Coupon(
        kind: Kind.Fixed(cents: 500),
        min_total: 2000,
        expires: 10,
        max_uses: 1,
    )
    engine.price(1, 4000, 5, "TENOFF,FIVER")
    engine.price(2, 20000, 6, "BIG20,TENOFF,FIVER")
    engine.price(3, 3000, 7, "FIVER,NOPE,BIG20")
    engine.price(4, 15000, 12, "FIVER,BIG20")
    engine.price(5, 800, 12, "TENOFF")
    engine.price(6, 9000, 13, "TENOFF")
    for code in ["BIG20", "FIVER", "TENOFF"]
        print("{code} used {engine.used.get(code) else 0}")

@test fn percent_and_cap()
    assert_eq(amount(Kind.Percent(pct: 10), 5000), 500)
    assert_eq(amount(Kind.Capped(pct: 20, limit: 2500), 20000), 2500)
    assert_eq(amount(Kind.Fixed(cents: 500), 300), 300)

@test fn use_limit_is_enforced()
    mut e := Engine(coupons: {}, used: {})
    e.coupons["X"] = Coupon(kind: Kind.Fixed(cents: 100), min_total: 0, expires: 9, max_uses: 1)
    assert_eq(e.redeem("X", 500, 1)?, 100)
    assert_err(e.redeem("X", 500, 1))

@test fn invalid_codes_fail_without_use()
    mut e := Engine(coupons: {}, used: {})
    e.coupons["Y"] = Coupon(kind: Kind.Percent(pct: 5), min_total: 1000, expires: 3, max_uses: 1)
    assert_err(e.redeem("Z", 500, 1))
    assert_err(e.redeem("Y", 500, 1))
    assert_err(e.redeem("Y", 5000, 4))
    assert_eq(e.redeem("Y", 5000, 3)?, 250)
