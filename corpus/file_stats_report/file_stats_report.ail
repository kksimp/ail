## File statistics report: writes a few text files into a temp directory,
## streams each one line at a time to count lines, words, blank lines, bytes
## and the longest line, then prints a table with totals, the longest file and
## a per-extension summary.
use std.file

struct Stats
    lines int
    words int
    blank int
    longest int
    bytes int

fn scan_file(p str) !Stats
    mut r := file.open(p)?
    mut s := Stats(lines: 0, words: 0, blank: 0, longest: 0, bytes: 0)
    while true
        line := r.read_line()? else break
        text := line.trim_end()
        s.lines += 1
        s.words += text.words().len()
        s.bytes += line.byte_len()
        s.longest = s.longest.max(text.byte_len())
        if text.is_empty()
            s.blank += 1
    r.close()
    s

fn combine(a Stats, b Stats) Stats
    Stats(
        lines: a.lines + b.lines,
        words: a.words + b.words,
        blank: a.blank + b.blank,
        longest: a.longest.max(b.longest),
        bytes: a.bytes + b.bytes,
    )

fn extension(name str) str
    parts := name.split(".")
    if parts.len() < 2
        return "(none)"
    parts[parts.len() - 1]

fn main() !
    dir := fs.make_temp_dir("corpus_file_stats_report")?
    names := ["README.md", "main.ail", "notes.txt", "util.ail", "data.csv", "Makefile"]
    texts := [
        "# Demo\n\nA small demo project.\nIt has two modules.\n",
        "fn main()\n    print(\"hi\")\n\n\nfn helper(x int) int\n    x + 1\n",
        "todo:\n  - write tests   \n  - ship it\n\nlater: refactor everything in sight\n",
        "fn add(a int, b int) int\n    a + b\n",
        "id,name\n1,ann\n2,bob\n3,cy",
        "all:\n\tail build\n",
    ]
    for i in 0..names.len()
        fs.write_text(path.join(dir, names[i]), texts[i])?
    print("{"file":<11}{"lines":>6}{"words":>6}{"blank":>6}{"longest":>8}{"bytes":>7}")
    mut total := Stats(lines: 0, words: 0, blank: 0, longest: 0, bytes: 0)
    mut by_lines := Map[str, int]()
    mut by_count := Map[str, int]()
    mut busiest := names[0]
    mut busiest_lines := -1
    for name in names
        s := scan_file(path.join(dir, name))?
        print("{name:<11}{s.lines:>6}{s.words:>6}{s.blank:>6}{s.longest:>8}{s.bytes:>7}")
        total = combine(total, s)
        by_lines[extension(name)] += s.lines
        by_count[extension(name)] += 1
        if s.lines > busiest_lines
            busiest = name
            busiest_lines = s.lines
    print("{"total":<11}{total.lines:>6}{total.words:>6}{total.blank:>6}{total.longest:>8}{total.bytes:>7}")
    print("most lines: {busiest} ({busiest_lines})")
    for ext in by_lines.keys().sorted()
        print("{ext:<7}{by_count[ext]:>2} files{by_lines[ext]:>5} lines")
    for name in names
        fs.remove(path.join(dir, name))?
    fs.remove(dir)?
    print("cleaned up: {not fs.exists(dir)}")

@test fn scans_a_file()
    dir := fs.make_temp_dir("corpus_file_stats_report_t")?
    p := path.join(dir, "t.txt")
    fs.write_text(p, "a b\n\nccc dd e\n")?
    s := scan_file(p)?
    assert_eq(s, Stats(lines: 3, words: 5, blank: 1, longest: 8, bytes: 14))
    fs.remove(p)?
    fs.remove(dir)?

@test fn extension_of_names()
    assert_eq(extension("a.tar.gz"), "gz")
    assert_eq(extension("Makefile"), "(none)")

@test fn combine_adds_and_keeps_the_longest()
    a := Stats(lines: 1, words: 2, blank: 0, longest: 9, bytes: 10)
    b := Stats(lines: 3, words: 4, blank: 1, longest: 5, bytes: 20)
    c := combine(a, b)
    assert_eq(c.lines, 4)
    assert_eq(c.longest, 9)
    assert_eq(c.bytes, 30)
