## GCD and LCM toolkit: Euclid's algorithm, the extended form with Bezout
## coefficients, the least common multiple of a list, and a printed table of
## gcd(r, c) for the numbers 1 to 8.

struct Bezout
    g int
    x int
    y int

fn gcd(a int, b int) int
    mut p := a.abs()
    mut q := b.abs()
    while q != 0
        t := p % q
        p = q
        q = t
    p

fn lcm(a int, b int) int
    if a == 0 or b == 0
        return 0
    (a / gcd(a, b) * b).abs()

fn ext_gcd(a int, b int) Bezout
    if b == 0
        return Bezout(g: a, x: 1, y: 0)
    r := ext_gcd(b, a % b)
    Bezout(g: r.g, x: r.y, y: r.x - (a / b) * r.y)

fn lcm_all(xs List[int]) int
    mut acc := 1
    for v in xs
        acc = lcm(acc, v)
    acc

fn print_table(size int)
    mut head := "   |"
    for c in 1..=size
        head = "{head}{c:>3}"
    print(head)
    print("---+------------------------")
    for r in 1..=size
        mut line := "{r:>2} |"
        for k in 1..=size
            g := gcd(r, k)
            line = "{line}{g:>3}"
        print(line)

fn main()
    print_table(8)
    firsts := [4, 21, 8, 17, 100]
    seconds := [6, 6, 12, 5, 75]
    for a, b in zip(firsts, seconds)
        print("gcd({a}, {b}) = {gcd(a, b)}, lcm({a}, {b}) = {lcm(a, b)}")
    for pair in [[240, 46], [99, 78], [17, 5]]
        r := ext_gcd(pair[0], pair[1])
        print("{pair[0]}*({r.x}) + {pair[1]}*({r.y}) = {r.g}")
    nums := [k for k in 1..=20]
    print("lcm of 1..20 = {lcm_all(nums)}")

@test fn gcd_basics()
    assert_eq(gcd(48, 18), 6)
    assert_eq(gcd(17, 5), 1)
    assert_eq(gcd(0, 9), 9)
    assert_eq(gcd(-12, 18), 6)

@test fn lcm_basics()
    assert_eq(lcm(4, 6), 12)
    assert_eq(lcm(0, 5), 0)
    assert_eq(lcm_all([2, 3, 4, 5]), 60)

@test fn bezout_identity_holds()
    for a in [12, 35, 240]
        for b in [5, 18, 46]
            r := ext_gcd(a, b)
            assert_eq(a * r.x + b * r.y, r.g)
            assert_eq(r.g, gcd(a, b))
