## Timesheet totals: parses "name,date,start,end" shifts (HH:MM), takes a
## 30 minute break off shifts over six hours, and reports days worked, total,
## regular and overtime (over 8 hours a day) time per person as H:MM.

struct Shift
    name str
    date str
    minutes int

fn data() List[str]
    [
        "ann,2026-03-02,08:30,17:00",
        "bob,2026-03-02,09:00,13:15",
        "ann,2026-03-03,08:00,18:30",
        "bob,2026-03-03,10:00,09:00",
        "cy,2026-03-03,07:45,16:15",
        "bob,2026-03-04,09:00,17:30",
        "ann,2026-03-04,12:00,xx:00",
        "cy,2026-03-04,08:00,12:00",
        "ann,2026-03-05,08:00,16:00",
    ]

fn clock(text str) int?
    parts := text.split(":")
    if parts.len() != 2
        return none
    h := parts[0].to_int()?
    m := parts[1].to_int()?
    if h < 0 or h > 23 or m < 0 or m > 59
        return none
    h * 60 + m

fn parse(line str) Shift?
    c := line.split(",")
    if c.len() != 4
        return none
    start := clock(c[2])?
    stop := clock(c[3])?
    if stop <= start
        return none
    mut span := stop - start
    if span > 360
        span -= 30
    Shift(name: c[0], date: c[1], minutes: span)

fn hm(minutes int) str
    rest := minutes % 60
    "{minutes / 60}:{rest:0>2}"

fn main()
    mut shifts := List[Shift]()
    for line in data()
        sh := parse(line) else
            print("rejected: {line}")
            continue
        shifts.push(sh)
    mut total := Map[str, int]()
    mut overtime := Map[str, int]()
    mut days := Map[str, int]()
    for s in shifts
        total[s.name] += s.minutes
        days[s.name] += 1
        if s.minutes > 480
            overtime[s.name] += s.minutes - 480
    print("name  days   total  regular  overtime")
    mut everyone := 0
    for n in total.keys().sorted()
        t := total[n]
        ot := overtime.get(n) else 0
        everyone += t
        print("{n:<5} {days[n]:>4} {hm(t):>7} {hm(t - ot):>8} {hm(ot):>9}")
    print("all   {hm(everyone)}")

@test fn parses_clock_times()
    assert_eq(clock("08:30")?, 510)
    assert(clock("24:00") == none)
    assert(clock("8") == none)
    assert(clock("aa:10") == none)

@test fn break_applies_over_six_hours()
    assert_eq(parse("a,d,08:00,14:00")?.minutes, 360)
    assert_eq(parse("a,d,08:00,14:01")?.minutes, 331)

@test fn rejects_backwards_shifts()
    assert(parse("a,d,10:00,09:00") == none)

@test fn formats_hours()
    assert_eq(hm(485), "8:05")
    assert_eq(hm(0), "0:00")
