## Log filter: writes an embedded service log to a temp file, then streams it
## back line by line and keeps the entries that pass a query: a minimum
## level, a text to find, and a time window. Also tallies entries per level.
use std.file

struct Entry
    stamp str
    level str
    msg str

struct Query
    min_rank int
    needle str
    after str
    before str

fn log_lines() List[str]
    [
        "09:58:01 INFO boot: starting api",
        "09:58:02 DEBUG boot: loading config",
        "10:00:15 INFO http: GET /health 200",
        "10:01:40 WARN db: slow query 1200ms",
        "10:02:03 ERROR http: GET /orders 500",
        "10:02:04 INFO http: GET /orders 200",
        "10:03:30 ERROR db: connection lost",
        "10:03:31 WARN db: retrying connection",
        "10:05:00 INFO boot: ready",
        "this line is garbled",
    ]

fn rank(level str) int
    match level
        "DEBUG" => 0
        "INFO" => 1
        "WARN" => 2
        "ERROR" => 3
        _ => -1

fn parse_line(line str) Entry?
    parts := line.split(" ", 3)
    if parts.len() != 3 or rank(parts[1]) < 0
        return none
    Entry(stamp: parts[0], level: parts[1], msg: parts[2])

fn Query.accepts(self, e Entry) bool
    rank(e.level) >= self.min_rank
        and e.msg.contains(self.needle)
        and e.stamp >= self.after
        and e.stamp < self.before

fn filter_file(p str, q Query) !List[Entry]
    mut r := file.open(p)?
    mut kept := List[Entry]()
    while true
        line := r.read_line()? else break
        e := parse_line(line.trim_end()) else continue
        if q.accepts(e)
            kept.push(e)
    r.close()
    kept

fn write_log(p str) !
    mut w := file.create(p)?
    for line in log_lines()
        w.write_line(line)?
    w.close()?

fn show(title str, got List[Entry])
    print("{title}: {got.len()} match")
    for e in got
        print("  {e.stamp} {e.level:<5} {e.msg}")

fn main() !
    dir := fs.make_temp_dir("corpus_log_filter_cli")?
    p := path.join(dir, "service.log")
    write_log(p)?
    everything := Query(min_rank: 0, needle: "", after: "00:00:00", before: "99:99:99")
    show("all valid", filter_file(p, everything)?)
    show(
        "warn and up",
        filter_file(p, Query(min_rank: 2, needle: "", after: "00:00:00", before: "99:99:99"))?,
    )
    show(
        "db entries",
        filter_file(p, Query(min_rank: 0, needle: "db:", after: "00:00:00", before: "99:99:99"))?,
    )
    show(
        "10:02 to 10:04",
        filter_file(p, Query(min_rank: 0, needle: "", after: "10:02:00", before: "10:04:00"))?,
    )
    mut counts := Map[str, int]()
    for e in filter_file(p, everything)?
        counts[e.level] += 1
    for level in counts.keys().sorted()
        print("{level:<5} {counts[level]}")
    fs.remove(p)?
    fs.remove(dir)?
    print("cleaned up: {not fs.exists(dir)}")

@test fn parses_a_good_line()
    e := parse_line("10:00:00 WARN db: slow") else Entry(stamp: "", level: "", msg: "")
    assert_eq(e.level, "WARN")
    assert_eq(e.msg, "db: slow")

@test fn garbled_lines_are_dropped()
    blank := Entry(stamp: "", level: "", msg: "")
    assert_eq(parse_line("not a log line") else blank, blank)
    assert_eq(parse_line("10:00:00 LOUD x") else blank, blank)

@test fn query_checks_every_field()
    q := Query(min_rank: 2, needle: "db", after: "10:00:00", before: "11:00:00")
    assert(q.accepts(Entry(stamp: "10:30:00", level: "ERROR", msg: "db down")))
    assert(not q.accepts(Entry(stamp: "10:30:00", level: "INFO", msg: "db up")))
    assert(not q.accepts(Entry(stamp: "11:30:00", level: "ERROR", msg: "db down")))
