## Exact factorials far beyond 64 bits. A number is a list of decimal digits,
## least significant first, multiplied by a small factor with a carry. Prints
## digit counts, digit sums, trailing zeros and the leading digits of several
## factorials, plus the digits of 2 to the power 100.

fn times_small(mut digits List[int], factor int)
    mut carry := 0
    for i in 0..digits.len()
        v := digits[i] * factor + carry
        digits[i] = v % 10
        carry = v / 10
    while carry > 0
        digits.push(carry % 10)
        carry = carry / 10

fn factorial_digits(n int) List[int]
    mut digits := [1]
    for k in 2..=n
        times_small(mut digits, k)
    digits

fn power_digits(base int, power int) List[int]
    mut digits := [1]
    for k in 0..power
        times_small(mut digits, base)
    digits

fn as_text(digits List[int]) str
    digits.reversed().join("")

fn digit_sum(digits List[int]) int
    mut total := 0
    for d in digits
        total += d
    total

fn trailing_zeros(digits List[int]) int
    mut count := 0
    for d in digits
        if d != 0
            break
        count += 1
    count

fn report(n int)
    digits := factorial_digits(n)
    text := as_text(digits)
    print("{n}! has {digits.len()} digits, digit sum {digit_sum(digits)}, {trailing_zeros(digits)} trailing zeros")
    if digits.len() <= 30
        print("  = {text}")
    else
        print("  starts {text.slice(0, 12)}...")

fn main()
    for n in [5, 10, 20, 25, 50, 100, 250]
        report(n)
    two := power_digits(2, 100)
    print("2^100 = {as_text(two)}")
    print("digit sum of 2^100: {digit_sum(two)}")
    small := factorial_digits(0)
    print("0! = {as_text(small)}")

@test fn ten_factorial()
    assert_eq(as_text(factorial_digits(10)), "3628800")

@test fn twenty_one_factorial_is_exact()
    assert_eq(as_text(factorial_digits(21)), "51090942171709440000")

@test fn carry_grows_the_list()
    mut d := [9, 9]
    times_small(mut d, 9)
    assert_eq(as_text(d), "891")

@test fn zeros_at_the_end()
    assert_eq(trailing_zeros(factorial_digits(25)), 6)
