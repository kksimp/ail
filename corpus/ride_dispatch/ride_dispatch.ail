## Ride dispatch simulation on a 20x20 grid. Requests ("TIME RIDER FX FY TX TY")
## go to the nearest free driver (ties to the lower id). A driver is busy until
## the pickup and trip are done, then waits at the drop-off. Fares come from a
## Pricing trait (flat, or flat with a surge window); the same requests run under
## both. Bad, out-of-zone, or unserved requests are typed errors.

error enum DispatchError
    BadRequest(text str) "bad request '{text}'"
    OutOfZone(rider str) "{rider} is outside the service zone"
    NoDrivers(rider str, now int) "no free driver for {rider} at t={now}"

trait Pricing
    fn label(self) str
    fn fare(self, dist int, now int) int

struct Flat
    base int
    per int

struct Surge
    base int
    per int
    pct int
    opens int
    closes int

impl Pricing for Flat
    fn label(self) str
        "flat"
    fn fare(self, dist int, now int) int
        self.base + self.per * dist

impl Pricing for Surge
    fn label(self) str
        "surge {self.pct}%"
    fn fare(self, dist int, now int) int
        plain := self.base + self.per * dist
        if now >= self.opens and now <= self.closes
            return plain * self.pct / 100
        plain

struct Driver
    id int
    x int
    y int
    free_at int
    trips int
    earned int

struct Dispatcher
    drivers List[Driver]
    pricing any Pricing
    zone int

fn Dispatcher.assign(mut self, line str) str ! DispatchError
    p := line.words()
    if p.len() != 6
        return BadRequest(text: line)
    mut v := List[int]()
    for k in [0, 2, 3, 4, 5]
        n := p[k].to_int() else return BadRequest(text: line)
        v.push(n)
    for j in 1..5
        if v[j] < 0 or v[j] >= self.zone
            return OutOfZone(rider: p[1])
    trip := (v[3] - v[1]).abs() + (v[4] - v[2]).abs()
    if trip == 0
        return BadRequest(text: line)
    mut best := -1
    mut best_d := 0
    for i, d in self.drivers.enumerate()
        gap := (d.x - v[1]).abs() + (d.y - v[2]).abs()
        if d.free_at <= v[0] and (best < 0 or gap < best_d)
            best = i
            best_d = gap
    if best < 0
        return NoDrivers(rider: p[1], now: v[0])
    cur := self.drivers[best]
    cost := self.pricing.fare(trip, v[0])
    self.drivers[best] = Driver(id: cur.id, x: v[3], y: v[4], free_at: v[0] + best_d + trip, trips: cur.trips + 1, earned: cur.earned + cost)
    "t={v[0]} {p[1]} -> driver {cur.id}, pickup {best_d}, trip {trip}, free at {v[0] + best_d + trip}, fare {cost}"

fn fleet() List[Driver]
    [Driver(id: 1, x: 2, y: 2, free_at: 0, trips: 0, earned: 0), Driver(id: 2, x: 10, y: 10, free_at: 0, trips: 0, earned: 0),
        Driver(id: 3, x: 18, y: 3, free_at: 0, trips: 0, earned: 0)]

fn run(pricing any Pricing, requests List[str])
    print("== {pricing.label()}")
    mut disp := Dispatcher(drivers: fleet(), pricing: pricing, zone: 20)
    for r in requests
        msg := disp.assign(r) else err
            print("! {err}")
            continue
        print(msg)
    for d in disp.drivers
        print("driver {d.id}: {d.trips} trips, earned {d.earned}, at {d.x},{d.y}")

fn main()
    requests := ["0 ann 3 3 8 9", "2 bob 9 9 1 1", "3 cy 17 2 17 15", "4 dee 5 5 6 6", "15 eli 8 9 2 2",
        "16 fay 40 1 2 2", "17 gus 1 1 x 2", "21 hal 1 1 5 5", "22 ivy 2 2 2 2"]
    run(Flat(base: 300, per: 120), requests)
    run(Surge(base: 300, per: 120, pct: 150, opens: 14, closes: 20), requests)

@test fn surge_window()
    s := Surge(base: 100, per: 10, pct: 200, opens: 5, closes: 9)
    assert_eq(s.fare(10, 4), 200)
    assert_eq(s.fare(10, 5), 400)
    assert_eq(s.fare(10, 10), 200)

@test fn nearest_driver_wins()
    mut d := Dispatcher(drivers: fleet(), pricing: Flat(base: 0, per: 1), zone: 20)
    msg := d.assign("0 a 3 3 4 3")?
    assert_eq(msg, "t=0 a -> driver 1, pickup 2, trip 1, free at 3, fare 1")

@test fn rejects_requests()
    mut d := Dispatcher(drivers: fleet(), pricing: Flat(base: 0, per: 1), zone: 20)
    assert_err(d.assign("0 a 3 3"))
    assert_err(d.assign("0 a 30 3 4 4"))
    assert_err(d.assign("0 a 3 3 3 3"))
    _ := d.assign("0 a 2 2 5 5")?
    _ := d.assign("0 b 10 10 5 5")?
    _ := d.assign("0 c 18 3 5 5")?
    assert_err(d.assign("1 d 4 4 5 5"))
