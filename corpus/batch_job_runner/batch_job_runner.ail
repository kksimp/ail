## Batch job runner: runs a list of "kind:arg" jobs in batches of three. The
## jobs of one batch run as tasks and report through a channel; the runner
## waits for the batch, sorts the reports by job number, and moves on. Bad
## specs (unknown kind, non-numeric argument) fail their job, not the run.

struct Report
    idx int
    spec str
    ok bool
    out str

fn sum_to(n int) int
    mut t := 0
    for i in 1..=n
        t += i
    t

fn factorial(n int) int
    mut t := 1
    for i in 2..=n
        t *= i
    t

fn fib(n int) int
    mut a := 0
    mut b := 1
    for _ in 0..n
        nxt := a + b
        a = b
        b = nxt
    a

fn run_job(idx int, spec str) Report
    parts := spec.split(":")
    if parts.len() != 2
        return Report(idx: idx, spec: spec, ok: false, out: "malformed spec")
    n := parts[1].to_int() else return Report(idx: idx, spec: spec, ok: false, out: "bad argument '{parts[1]}'")
    if n < 0 or n > 90
        return Report(idx: idx, spec: spec, ok: false, out: "argument {n} out of range")
    if parts[0] == "fact" and n > 20
        return Report(idx: idx, spec: spec, ok: false, out: "factorial overflows at {n}")
    match parts[0]
        "sum" => Report(idx: idx, spec: spec, ok: true, out: "{sum_to(n)}")
        "fact" => Report(idx: idx, spec: spec, ok: true, out: "{factorial(n)}")
        "fib" => Report(idx: idx, spec: spec, ok: true, out: "{fib(n)}")
        _ => Report(idx: idx, spec: spec, ok: false, out: "unknown kind '{parts[0]}'")

fn job_task(idx int, spec str, out Channel[Report])
    out.send(run_job(idx, spec))

fn run_batch(first int, specs List[str]) !List[Report]
    out := Channel[Report](8)
    g := TaskGroup()
    for i in 0..specs.len()
        g.add(spawn job_task(first + i, specs[i], out))
    g.wait_all()?
    out.close()
    mut got := List[Report]()
    for r in out
        got.push(r)
    got.sorted(by: |x| x.idx)

fn main() !
    specs := ["sum:80", "fact:10", "fib:30", "fact:25", "pow:2", "sum:abc", "fib:10", "sum", "fact:5"]
    size := 3
    mut failed := 0
    mut start := 0
    mut batch_no := 1
    while start < specs.len()
        stop := (start + size).min(specs.len())
        print("batch {batch_no}")
        for r in run_batch(start, specs[start..stop])?
            status := if r.ok then "ok  " else "FAIL"
            print("  job {r.idx} {status} {r.spec:<8} {r.out}")
            if not r.ok
                failed += 1
        start = stop
        batch_no += 1
    print("{specs.len() - failed} ok, {failed} failed")

@test fn jobs_compute()
    assert_eq(run_job(0, "sum:10").out, "55")
    assert_eq(run_job(0, "fact:5").out, "120")
    assert_eq(run_job(0, "fib:10").out, "55")

@test fn bad_specs_fail_their_job()
    assert(not run_job(1, "nope:3").ok)
    assert(not run_job(1, "fib").ok)
    assert_eq(run_job(1, "fact:21").out, "factorial overflows at 21")
    assert_eq(run_job(1, "sum:91").out, "argument 91 out of range")

@test fn batch_reports_come_back_sorted()
    got := run_batch(10, ["sum:1", "sum:2", "sum:3", "sum:4"])?
    assert_eq([r.idx for r in got], [10, 11, 12, 13])
    assert_eq([r.out for r in got], ["1", "3", "6", "10"])
