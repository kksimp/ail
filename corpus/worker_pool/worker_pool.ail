## A fixed pool of worker tasks pulls numbers from a job channel and sends
## back how many Collatz steps each needs. Results arrive in any order, so
## they are collected and sorted before printing; a `par` comprehension
## cross-checks the same answers.

struct Outcome
    n int
    steps int

fn collatz(n int) int
    mut x := n
    mut steps := 0
    while x != 1
        x = if x % 2 == 0 then x / 2 else 3 * x + 1
        steps += 1
    steps

fn worker(jobs Channel[int], results Channel[Outcome])
    for n in jobs
        results.send(Outcome(n: n, steps: collatz(n)))

fn run_pool(ns List[int], workers int) List[Outcome]
    jobs := Channel[int](8)
    results := Channel[Outcome](64)
    g := TaskGroup()
    for _ in 0..workers
        g.add(spawn worker(jobs, results))
    for n in ns
        jobs.send(n)
    jobs.close()
    mut outs := List[Outcome]()
    for _ in 0..ns.len()
        r := results.recv() else break
        outs.push(r)
    outs.sorted(by: |o| o.n)

fn main()
    ns := [1, 2, 3, 6, 7, 9, 11, 19, 27, 97, 171, 231, 313, 871]
    outs := run_pool(ns, 4)
    print("{"n":>5}{"steps":>7}")
    for o in outs
        print("{o.n:>5}{o.steps:>7}")
    mut best := outs[0]
    mut total := 0
    for o in outs
        total += o.steps
        if o.steps > best.steps
            best = o
    print("jobs: {outs.len()}, total steps: {total}")
    print("longest: n={best.n} with {best.steps} steps")
    checked := [collatz(n) par for n in ns]
    mut same := true
    for i in 0..ns.len()
        if checked[i] != outs[i].steps
            same = false
    print("par check: {same}")

@test fn collatz_known_values()
    assert_eq(collatz(1), 0)
    assert_eq(collatz(6), 8)
    assert_eq(collatz(27), 111)

@test fn pool_returns_every_job_sorted()
    outs := run_pool([5, 3, 8, 1], 3)
    assert_eq([o.n for o in outs], [1, 3, 5, 8])
    assert_eq(outs[2].steps, collatz(5))

@test fn one_worker_gives_the_same_answers()
    assert_eq(run_pool([7, 9, 11], 1), run_pool([7, 9, 11], 4))
