## A stock portfolio in integer cents. Trades ("buy SYM qty price") update
## positions at average cost; sells realize profit against that cost basis. A
## `Commission` trait prices each trade (flat or per share). Overselling, bad
## lines and non-positive amounts fail with a typed error. Prints a position
## table marked to closing prices, plus realized and unrealized profit.

error enum TradeError
    BadLine(text str) "cannot read '{text}'"
    BadAmount(text str) "non-positive amount in '{text}'"
    Oversell(sym str, have int, want int) "{sym}: have {have}, want to sell {want}"

trait Commission
    fn fee(self, qty int, price int) int

struct Flat
    cents int

struct PerShare
    cents int

impl Commission for Flat
    fn fee(self, qty int, price int) int
        self.cents

impl Commission for PerShare
    fn fee(self, qty int, price int) int
        self.cents * qty

struct Position
    shares int
    basis int

struct Portfolio
    held Map[str, Position]
    realized int
    fees int

fn Portfolio.trade(mut self, line str, comm any Commission) int ! TradeError
    parts := line.split(" ")
    if parts.len() != 4
        return BadLine(text: line)
    qty := parts[2].to_int() else return BadLine(text: line)
    price := parts[3].to_int() else return BadLine(text: line)
    if qty <= 0 or price <= 0
        return BadAmount(text: line)
    sym := parts[1]
    cur := self.held.get(sym) else Position(shares: 0, basis: 0)
    fee := comm.fee(qty, price)
    if parts[0] == "buy"
        self.held[sym] = Position(shares: cur.shares + qty, basis: cur.basis + qty * price)
    elif parts[0] == "sell"
        if qty > cur.shares
            return Oversell(sym: sym, have: cur.shares, want: qty)
        removed := cur.basis * qty / cur.shares
        self.realized += qty * price - removed
        self.held[sym] = Position(shares: cur.shares - qty, basis: cur.basis - removed)
    else
        return BadLine(text: line)
    self.fees += fee
    fee

fn money(cents int) str
    sign := if cents < 0 then "-" else ""
    a := cents.abs()
    "{sign}{a / 100}.{a % 100:0>2}"

fn main()
    trades := [
        "buy ACME 100 1500", "buy ACME 50 1800", "buy BOLT 10 20000",
        "sell ACME 60 2000", "sell BOLT 11 21000", "buy ZED 0 100",
        "hold ACME 1 1", "sell BOLT 4 19000", "buy CORN 7",
    ]
    marks := {"ACME": 1900, "BOLT": 20500, "CORN": 100}
    mut book := Portfolio(held: {}, realized: 0, fees: 0)
    rates := List[any Commission]()
    rates.push(Flat(cents: 499))
    rates.push(PerShare(cents: 2))
    for i in 0..trades.len()
        t := trades[i]
        paid := book.trade(t, rates[i % 2]) else err
            print("rejected: {err}")
            continue
        print("ok {t}, fee {money(paid)}")
    mut syms := []
    for s in book.held.keys()
        syms.push(s)
    syms.sort()
    mut unreal := 0
    for s in syms
        p := book.held[s]
        mark := p.shares * marks[s]
        unreal += mark - p.basis
        print("{s}: {p.shares} shares, basis {money(p.basis)}, value {money(mark)}")
    print("realized {money(book.realized)}")
    print("unrealized {money(unreal)}")
    print("fees {money(book.fees)}")

@test fn average_cost_basis()
    mut b := Portfolio(held: {}, realized: 0, fees: 0)
    b.trade("buy X 10 100", Flat(cents: 0))?
    b.trade("buy X 10 200", Flat(cents: 0))?
    b.trade("sell X 5 300", Flat(cents: 0))?
    assert_eq(b.held["X"].shares, 15)
    assert_eq(b.held["X"].basis, 2250)
    assert_eq(b.realized, 750)

@test fn rejects_oversell_and_junk()
    mut b := Portfolio(held: {}, realized: 0, fees: 0)
    b.trade("buy X 1 100", Flat(cents: 0))?
    assert_err(b.trade("sell X 2 100", Flat(cents: 0)))
    assert_err(b.trade("buy X -1 100", Flat(cents: 0)))
    assert_err(b.trade("swap X 1 100", Flat(cents: 0)))

@test fn commissions_differ()
    assert_eq(Flat(cents: 5).fee(10, 100), 5)
    assert_eq(PerShare(cents: 5).fee(10, 100), 50)
    assert_eq(money(-250), "-2.50")
