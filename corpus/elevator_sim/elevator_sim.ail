## A single-elevator simulation with the SCAN policy: keep going in the current
## direction while a request lies ahead, otherwise turn around. Requests arrive
## at fixed ticks; the log shows each stop, and the summary the travel and the
## average wait.

FLOORS := 10

struct Request
    at int
    floor int

struct Elevator
    level int
    heading int
    waiting List[int]
    served int
    wait_total int
    moved int

fn Elevator.new() Elevator
    mut w := List[int]()
    for i in 0..FLOORS
        w.push(-1)
    Elevator(level: 0, heading: 0, waiting: w, served: 0, wait_total: 0, moved: 0)

fn Elevator.ahead(self, dir int) bool
    mut f := self.level + dir
    while f >= 0 and f < FLOORS
        if self.waiting[f] >= 0
            return true
        f += dir
    false

fn Elevator.choose(self) int
    up := self.ahead(1)
    down := self.ahead(-1)
    if self.heading == 1 and up
        return 1
    if self.heading == -1 and down
        return -1
    if up
        return 1
    if down
        return -1
    0

fn Elevator.tick(mut self, t int)
    if self.waiting[self.level] >= 0
        w := t - self.waiting[self.level]
        self.wait_total += w
        self.served += 1
        self.waiting[self.level] = -1
        print("t={t} stop at floor {self.level} (waited {w})")
        return
    self.heading = self.choose()
    self.level += self.heading
    self.moved += self.heading.abs()

fn main()
    requests := [
        Request(at: 0, floor: 5), Request(at: 1, floor: 2), Request(at: 3, floor: 8),
        Request(at: 4, floor: 3), Request(at: 12, floor: 0), Request(at: 14, floor: 9),
        Request(at: 15, floor: 4), Request(at: 22, floor: 6),
    ]
    mut car := Elevator.new()
    for t in 0..40
        for r in requests
            if r.at == t and car.waiting[r.floor] < 0
                car.waiting[r.floor] = t
        car.tick(t)
    print("served: {car.served}")
    print("floors travelled: {car.moved}")
    print("total wait: {car.wait_total}")
    print("average wait x10: {car.wait_total * 10 / car.served}")
    print("ended at floor {car.level}")

@test fn idle_car_stays_put()
    mut car := Elevator.new()
    car.tick(0)
    assert_eq(car.level, 0)
    assert_eq(car.moved, 0)

@test fn serves_a_request_above()
    mut car := Elevator.new()
    car.waiting[2] = 0
    car.tick(0)
    car.tick(1)
    car.tick(2)
    assert_eq(car.level, 2)
    assert_eq(car.served, 1)

@test fn keeps_direction_while_requests_remain()
    mut car := Elevator.new()
    car.waiting[3] = 0
    car.waiting[1] = 0
    car.tick(0)
    assert_eq(car.heading, 1)
    assert_eq(car.choose(), 1)
