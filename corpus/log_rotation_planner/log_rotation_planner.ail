## Log rotation planner: given a set of log files with sizes and ages, decides
## for each one whether to keep it, compress it (rename to `.gz`) or delete
## it, using a maximum age, a maximum number of kept files and an age after
## which files are compressed. The plan is printed first, then applied to real
## files in a temp directory, and the directory listing is shown afterwards.

struct Entry
    name str
    size int
    age int

struct Policy
    max_age int
    keep int
    compress_after int

fn decide(e Entry, rank int, p Policy) str
    if e.age > p.max_age or rank >= p.keep
        return "delete"
    if e.age > p.compress_after and not e.name.ends_with(".gz")
        return "compress"
    "keep"

fn plan(entries List[Entry], p Policy) List[str]
    ordered := entries.sorted(by: |x| x.age)
    mut out := List[str]()
    for i in 0..ordered.len()
        out.push(decide(ordered[i], i, p))
    out

fn apply(dir str, entries List[Entry], actions List[str]) !
    ordered := entries.sorted(by: |x| x.age)
    for i in 0..ordered.len()
        file_path := path.join(dir, ordered[i].name)
        if actions[i] == "delete"
            fs.remove(file_path)?
        elif actions[i] == "compress"
            fs.rename(file_path, "{file_path}.gz")?

fn main() !
    entries := [
        Entry(name: "app.log", size: 40, age: 0),
        Entry(name: "app.log.1", size: 55, age: 1),
        Entry(name: "app.log.2.gz", size: 20, age: 9),
        Entry(name: "app.log.3", size: 60, age: 3),
        Entry(name: "app.log.4", size: 70, age: 12),
        Entry(name: "app.log.5.gz", size: 18, age: 31),
        Entry(name: "app.log.6", size: 65, age: 6),
        Entry(name: "app.log.7", size: 90, age: 20),
    ]
    policy := Policy(max_age: 30, keep: 6, compress_after: 7)
    actions := plan(entries, policy)
    ordered := entries.sorted(by: |x| x.age)
    mut freed := 0
    for i in 0..ordered.len()
        e := ordered[i]
        print("{actions[i]:<9}{e.name:<14}{e.age:>3}d {e.size:>4}")
        if actions[i] == "delete"
            freed += e.size
    print("frees {freed} bytes")
    dir := fs.make_temp_dir("corpus_log_rotation_planner")?
    for e in entries
        fs.write_text(path.join(dir, e.name), "x".repeat(e.size))?
    apply(dir, entries, actions)?
    mut left := 0
    for name in fs.list_dir(dir)?.sorted()
        size := fs.metadata(path.join(dir, name))?.size
        left += size
        print("  {name:<14}{size:>4}")
    print("{fs.list_dir(dir)?.len()} files, {left} bytes left")
    for name in fs.list_dir(dir)?
        fs.remove(path.join(dir, name))?
    fs.remove(dir)?
    print("cleaned up: {not fs.exists(dir)}")

@test fn decisions_follow_the_policy()
    p := Policy(max_age: 30, keep: 3, compress_after: 7)
    assert_eq(decide(Entry(name: "a", size: 1, age: 2), 0, p), "keep")
    assert_eq(decide(Entry(name: "a", size: 1, age: 10), 1, p), "compress")
    assert_eq(decide(Entry(name: "a.gz", size: 1, age: 10), 1, p), "keep")
    assert_eq(decide(Entry(name: "a", size: 1, age: 40), 2, p), "delete")
    assert_eq(decide(Entry(name: "a", size: 1, age: 1), 3, p), "delete")

@test fn plan_is_in_age_order()
    es := [Entry(name: "old", size: 1, age: 9), Entry(name: "new", size: 1, age: 0)]
    assert_eq(plan(es, Policy(max_age: 30, keep: 5, compress_after: 5)), ["keep", "compress"])

@test fn applying_a_plan_changes_files()
    dir := fs.make_temp_dir("corpus_log_rotation_planner_t")?
    es := [
        Entry(name: "x", size: 3, age: 0),
        Entry(name: "y", size: 3, age: 20),
        Entry(name: "z", size: 3, age: 50),
    ]
    for e in es
        fs.write_text(path.join(dir, e.name), "abc")?
    apply(dir, es, plan(es, Policy(max_age: 30, keep: 9, compress_after: 7)))?
    assert_eq(fs.list_dir(dir)?.sorted(), ["x", "y.gz"])
    fs.remove(path.join(dir, "x"))?
    fs.remove(path.join(dir, "y.gz"))?
    fs.remove(dir)?
