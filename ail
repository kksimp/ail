#!/usr/bin/env bash
# The AIL command-line tool. From the repository root:
#
#   ./ail run examples/hello.ail     check and run a program
#   ./ail check FILE                 check without running (add --json for tools)
#   ./ail selftest                   the Mac gate (tools/gate/mac-gate.sh)
#
# There is no Rust toolchain here (ADR 0855): the published seed (tools/release/fetch-seed.sh) builds the native CLI.
set -euo pipefail

# Git for Windows' sh (the gate's scripts run `./ail` through it): this script can't build or run anything there, so hand
# the arguments to the PowerShell twin, which does (ail.ps1, like ail.cmd for programs that start `ail` themselves).
case "$(uname -s 2>/dev/null)" in
    MINGW* | MSYS* | CYGWIN*)
        exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -W)/ail.ps1" "$@" ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# std.app.10: a program finds the app host built under the toolchain.
export AIL_ROOT="$root"

die() { echo "ail: $*" >&2; exit 2; }

# conc.sched.1: `--schedule=fixed|random[:SEED]` of `run` and `test` becomes AIL_SCHEDULE, which the build (switch points at
# atomic operations) and the runtime (sched.ail) read; a random schedule without a seed picks one and prints it.
case "${1:-}" in run | test)
    sched_rest=()
    for a in "$@"; do
        case "$a" in
            --schedule=*)
                w="${a#--schedule=}"
                case "$w" in
                    fixed) export AIL_SCHEDULE=fixed ;;
                    random) w="random:$(( $(date +%s) % 1000000 ))"; echo "schedule seed ${w#random:}: replay with --schedule=$w" >&2; export AIL_SCHEDULE="$w" ;;
                    random:*[!0-9]* | random:) die "\`$a\` isn't a schedule; use \`--schedule=random\` or \`--schedule=random:SEED\` with a non-negative SEED (conc.sched.1)" ;;
                    random:*) export AIL_SCHEDULE="$w" ;;
                    *) die "\`$a\` isn't a schedule; use \`--schedule=random\` or \`--schedule=random:SEED\` with a non-negative SEED (conc.sched.1)" ;;
                esac ;;
            *) sched_rest+=("$a") ;;
        esac
    done
    set -- "${sched_rest[@]}" ;;
esac

# Package options for the native loader (mod.pkg.7-8, compiler/pkg/git.ail): `run` and `test` write
# `ail.lock`, `--deterministic` refuses a stale one, `--deny net` fetches nothing.
case "${1:-}" in run | test) export AIL_PKG_WRITE_LOCK=1 ;; esac
prev=
for a in "$@"; do
    case "$a" in --deterministic) export AIL_PKG_FROZEN=1 ;; esac
    if [ "$prev" = --deny ] && [ "${a#*net}" != "$a" ]; then export AIL_PKG_OFFLINE=1; fi
    prev="$a"
done

# `AIL_NATIVE_COMPILER=PATH`: `ail build` is done by a natively built compiler (stage 1 of
# tools/self-host/run.sh) in place of the Rust-hosted one. The program is checked first, as `ail build` does
# (with `--unsafe driver`, unsafe.hw.1, when given); the native compiler takes the same arguments.
if [ "${1:-}" = build ] && [ -n "${AIL_NATIVE_COMPILER:-}" ]; then
    [ -x "$AIL_NATIVE_COMPILER" ] || die "AIL_NATIVE_COMPILER=$AIL_NATIVE_COMPILER isn't an executable"
    native_file="" native_skip=0 native_unsafe=""
    for native_arg in "${@:2}"; do
        if [ "$native_skip" = 1 ]; then native_skip=0; continue; fi
        case "$native_arg" in
            -o | --target | --timeout | --max-memory | --unsafe) native_skip=1 ;;
            -*) ;;
            *) [ -n "$native_file" ] || native_file="$native_arg" ;;
        esac
    done
    native_prev=""
    for native_arg in "$@"; do
        if [ "$native_prev" = --unsafe ] && [ "$native_arg" = driver ]; then native_unsafe=driver; fi
        native_prev="$native_arg"
    done
    if [ -n "$native_file" ]; then
        if [ -n "$native_unsafe" ]; then
            AIL_NATIVE_COMPILER= "$root/ail" check --unsafe driver "$native_file" || exit 1
        else
            AIL_NATIVE_COMPILER= "$root/ail" check "$native_file" || exit 1
        fi
        exec "$AIL_NATIVE_COMPILER" "$@"
    fi
fi

# The native CLI (ADR 0855) is the default: `ail fmt ...`, `ail test FILE` (tools/ailtest), `ail api FILE`, `ail build`,
# `ail check FILE` and `ail run [--timeout MS] [--max-memory MB] FILE [ARGS]` are done by compiler/main.ail
# built natively into .native/ail (by the published seed, stage 0): `check-program` first, then the program from the build
# cache, exec'd so it keeps the terminal. A program outside the native subset is an error; a command with no native form is refused.
# `ail api` natively: one file, with at most --outline, --text, --pretty and --symbols.
# trace.run.1: the tracing options belong to `run` and `test`.
if [ "${1:-}" != run ] && [ "${1:-}" != test ]; then
    for trace_arg in "$@"; do
        case "$trace_arg" in
            --trace | --trace=* | --trace-limit | --watch | --watch=* | --verbose) echo "error[trace.run.1]: the tracing options (\`$trace_arg\`) work with \`ail run\` and \`ail test\` (trace.run.1)" >&2; exit 2 ;;
        esac
    done
fi
# replay.rec.1: `--record` and `--replay` belong to `run` and `test`.
if [ "${1:-}" != run ] && [ "${1:-}" != test ]; then
    for rec_arg in "$@"; do
        case "$rec_arg" in
            --record | --replay) echo "error[replay.rec.1]: \`$rec_arg\` works with \`ail run\` and \`ail test\` and a file name (replay.rec.1)" >&2; exit 2 ;;
        esac
    done
fi
native_run=
run_opts=
budget_opts=
run_skip=0
check_opts=
if [ "${1:-}" = run ]; then
    run_args=("$@")
    k=1
    while [ "$k" -lt "${#run_args[@]}" ]; do
        a="${run_args[$k]}"
        case "$a" in
            --timeout | --max-memory)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]* | 0 | 0[0-9]*) die "error[run.limit.4]: \`$a\` needs a positive whole number (run.limit.4)" ;; esac
                run_opts="$run_opts $a $v"; k=$((k + 2)) ;;
            --budget)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) budget_opts="$budget_opts --budget"; k=$((k + 1)) ;; *) budget_opts="$budget_opts --budget $v"; k=$((k + 2)) ;; esac ;;
            --from)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) break ;; esac
                budget_opts="$budget_opts --from $v"; k=$((k + 2)) ;;
            --json) budget_opts="$budget_opts --json"; k=$((k + 1)) ;;
            --record | --replay)
                v="${run_args[$((k + 1))]-}"
                [ -n "$v" ] || die "\`$a\` needs a recording file, e.g. \`$a r.json\` (replay.rec.1)"
                if [ "$a" = --record ]; then export AIL_RECORD="$v"; rec_run=1; else export AIL_REPLAY="$v"; rep_run=1; fi
                export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}record"; k=$((k + 2)) ;;
            --max-steps)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]* | 0) die "\`--max-steps\` needs a positive number of steps (run.limit.4)" ;; esac
                export AIL_MAX_STEPS="$v" AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}steps"; k=$((k + 2)) ;;
            --watch)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!A-Za-z0-9_]*) die "\`--watch\` needs a variable name, e.g. \`--watch total\` (trace.watch.1)" ;; esac
                export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}watch=$v"; trace_run=1; k=$((k + 2)) ;;
            --at)
                v="${run_args[$((k + 1))]-}"
                probe_tail="${v##*:}"
                case "$probe_tail" in "" | *[!0-9]*) die "error[probe.run.4]: \`--at\` needs FILE:LINE, e.g. \`--at main.ail:12\` (probe.run.4)" ;; esac
                [ "$probe_tail" != "$v" ] && [ "${v%:*}" != "" ] || die "error[probe.run.4]: \`--at\` needs FILE:LINE, e.g. \`--at main.ail:12\` (probe.run.4)"
                probe_at="$v"; k=$((k + 2)) ;;
            --show)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!A-Za-z0-9_,]*) die "error[probe.run.4]: \`--show\` needs variable names, e.g. \`--show i,total\` (probe.run.4)" ;; esac
                probe_show="${v//,/|}"; k=$((k + 2)) ;;
            --no-contracts) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}nocontracts"; k=$((k + 1)) ;;
            --trace | --trace=all) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}trace,traceeffects"; trace_run=1; k=$((k + 1)) ;;
            --trace=calls) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}trace"; trace_run=1; k=$((k + 1)) ;;
            --trace=effects) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}traceeffects"; trace_run=1; k=$((k + 1)) ;;
            --trace=*) die "\`$a\` isn't a trace kind: use \`--trace\`, \`--trace=calls\`, \`--trace=effects\` or \`--trace=all\` (trace.run.1)" ;;
            --trace-limit)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]* | 0) die "\`--trace-limit\` needs a positive number of events (trace.run.4)" ;; esac
                export AIL_TRACE_LIMIT="$v"; k=$((k + 2)) ;;
            --verbose) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}values,verbose"; k=$((k + 1)) ;;
            --attach-input) export AIL_ATTACH_INPUT=1; k=$((k + 1)) ;;
            --no-attach) run_opts="$run_opts --no-attach"; k=$((k + 1)) ;;
            --values) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}values"; k=$((k + 1)) ;;
            --deterministic) export AIL_DETERMINISTIC=1; det_run=1; check_opts="$check_opts --deterministic"; k=$((k + 1)) ;;
            --deny)
                v="${run_args[$((k + 1))]-}"
                [ -n "$v" ] || die "\`--deny\` needs a list of capabilities, e.g. \`--deny fs,proc\`"
                check_opts="$check_opts --deny $v"; k=$((k + 2)) ;;
            --parallel) export AIL_PARALLEL=1; k=$((k + 1)) ;;
            --unsafe)
                [ "${run_args[$((k + 1))]-}" = driver ] || break
                check_opts="$check_opts --unsafe driver"; k=$((k + 2)) ;;
            --seed)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) die "\`--seed\` needs an integer, e.g. \`--seed 42\` (std.random.3)" ;; esac
                export AIL_SEED="$v"; k=$((k + 2)) ;;
            "" | -*) break ;;
            *) native_run=1; run_file="$a"; k=$((k + 1)); break ;;
        esac
    done
    run_skip=$k
    # probe.run.1: `--at FILE:LINE --show a,b` builds the probe in; each needs the other.
    if [ -n "${probe_at:-}${probe_show:-}" ]; then
        [ -n "${probe_at:-}" ] && [ -n "${probe_show:-}" ] || die "error[probe.run.4]: \`--at\` and \`--show\` go together, e.g. \`--at main.ail:12 --show i,total\` (probe.run.4)"
        export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}probe=$probe_at:$probe_show"; trace_run=1
    fi
    # trace.run.1: with a trace, `--json` makes the events JSON objects.
    if [ "${trace_run:-}" = 1 ] && [ "$budget_opts" = " --json" ]; then
        budget_opts=""; export AIL_TRACE_JSON=1 AIL_INSTRUMENT="$AIL_INSTRUMENT,tracejson"
    fi
    # Record and replay (ADR 0873, replay.rec.1-2, replay.run.1): the recording's first line says what ran.
    if [ "${rep_run:-}" = 1 ] && [ "${rec_run:-}" != 1 ]; then
        [ -r "$AIL_REPLAY" ] || die "can't read the recording $AIL_REPLAY (replay.run.1)"
        rep_head="$(head -n 1 "$AIL_REPLAY")"
        # Plain parameter expansion and awk, so BSD sed (macOS) reads the header the same way.
        rep_unq() { printf '%s' "$1" | sed 's/\\"/"/g; s/\\\\/\\/g'; }
        rep_prog="${rep_head#*\"program\":\"}"; rep_prog="$(rep_unq "${rep_prog%%\",\"args\"*}")"
        rep_seed="${rep_head#*\"seed\":}"; rep_seed="${rep_seed%%,*}"
        rep_list="${rep_head#*\"args\":[}"; rep_list="${rep_list%%],\"seed\"*}"
        rep_args=()
        if [ -n "$rep_list" ]; then
            while IFS= read -r rep_a; do rep_args+=("$rep_a"); done < <(printf '%s' "$rep_list" | sed 's/^"//; s/"$//' | awk 'BEGIN { FS = "\",\"" } { for (i = 1; i <= NF; i++) print $i }' | sed 's/\\"/"/g; s/\\\\/\\/g')
        fi
        [ -n "$rep_seed" ] && export AIL_SEED="$rep_seed"
        [ -n "${run_file:-}" ] || run_file="$rep_prog"
        set -- run "$run_file" ${rep_args[@]+"${rep_args[@]}"}
        run_skip=2; native_run=1
    elif [ "${rec_run:-}" = 1 ] && [ -n "${native_run:-}" ]; then
        [ -n "${AIL_SEED:-}" ] || export AIL_SEED="$(( $(date +%s) * 1000003 + $$ ))"
        rec_q() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
        rec_list=
        rec_i=$run_skip
        while [ "$rec_i" -lt "${#run_args[@]}" ]; do rec_list="$rec_list${rec_list:+,}\"$(rec_q "${run_args[$rec_i]}")\""; rec_i=$((rec_i + 1)); done
        printf '{"ail_record":1,"program":"%s","args":[%s],"seed":%s,"limit":67108864}\n' "$(rec_q "$run_file")" "$rec_list" "$AIL_SEED" > "$AIL_RECORD" || die "can't write the recording $AIL_RECORD"
    fi
    # trace.snap.4: `--json` alone makes a trap one JSON object (tools/trapjson.awk reads the verbose report).
    snap_json=
    if [ -z "${trace_run:-}" ] && [ "$budget_opts" = " --json" ] && [ -n "${native_run:-}" ]; then
        snap_json=1; budget_opts=""
        export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}values,verbose"
    fi
    case "$budget_opts" in "" | *--budget*) ;; *) native_run= ;; esac
fi
# run.limit.4: the limit options belong to `run` and `test`; `check` with one is a usage error.
if [ "${1:-}" = check ]; then
    for a in "${@:2}"; do
        case "$a" in --timeout | --max-memory | --max-steps) die "error[run.limit.4]: \`$a\` works with \`ail run\` and \`ail test\` (run.limit.4)" ;; esac
    done
fi
native_build=
if [ "${1:-}" = build ]; then
    native_build=1
    for a in "${@:2}"; do
        case "$a" in --derived-out) native_build= ;; esac
    done
fi
# Every `ail api` mode is native (outline, --symbols, --expanded, packages, --card, --diff, --locals/--type/--refs, --tokens, --ast).
native_api=
if [ "${1:-}" = api ]; then
    native_api=1
fi
# `ail check --deny/--deterministic/--unsafe ...` is native too (eff.cap.1, eff.det.1, unsafe.hw.1).
native_check=
if [ "${1:-}" = check ]; then case "${2:-}" in --deny | --deterministic | --unsafe) native_check=1 ;; esac; fi
# `ail check --fix FILE` applies the safe fixes first, then checks (fix.check.1).
if [ "${1:-}" = check ]; then for a in "${@:2}"; do [ "$a" = --fix ] && native_check=1; done; fi
# `ail effects [--json] FILE` is native too (#695).
native_effects=
if [ "${1:-}" = effects ]; then
    native_effects=1; files=0
    for a in "${@:2}"; do
        case "$a" in --json|--parallel) ;; -*) native_effects= ;; *) if [ -f "$a" ]; then files=$((files + 1)); else native_effects=; fi ;; esac
    done
    [ "$files" = 1 ] || native_effects=
fi
# Routes only the Rust bootstrap could run are refused (ADR 0900): `test --native` compared native builds with the
# interpreter, and `selftest --test NAME` ran one cargo test.
if [ "${1:-}" = test ]; then
    for a in "${@:2}"; do
        [ "$a" = --native ] && die "\`ail test --native\` is retired: \`ail test\` runs every test natively and there is no interpreter to compare with (native.test.1, ADR 0900)"
    done
fi
if [ "${1:-}" = selftest ] && [ "${2:-}" = --test ]; then
    die "\`ail selftest --test NAME\` ran one cargo test and is retired: name a gate suite, as \`ail selftest cases\`, or run \`ail test FILE\` (ADR 0900)"
fi
# `--budget`/`--from` anywhere in `check` or `test` runs the command under the budget (budget.out.1-7).
has_budget=
if [ "${1:-}" = check ] || [ "${1:-}" = test ]; then
    for a in "${@:2}"; do case "$a" in --budget | --from) has_budget=1 ;; esac; done
fi
# bundle.run.1: `test --bundle-failure[=DIR]` and `test --bundle FILE` run the native test runner whatever their argument order.
has_bundle=
if [ "${1:-}" = test ]; then
    for a in "${@:2}"; do case "$a" in --bundle | --bundle-failure | --bundle-failure=*) has_bundle=1 ;; esac; done
fi
native_errors=
if [ "${1:-}" = check ]; then
    for a in "${@:2}"; do [ "$a" = --errors ] && native_errors=1; done
fi
if { [ -n "$native_errors" ] || [ -n "$native_api" ] || [ -n "$native_effects" ] || [ -n "$native_check" ] || [ -n "$native_build" ] || [ -n "$native_run" ] || [ "${1:-}" = pkg ] || [ "${1:-}" = header ] || [ "${1:-}" = diff ] || [ "${1:-}" = fmt ] || [ "${1:-}" = fix ] || [ "${1:-}" = explain ] || [ "${1:-}" = edit ] || [ "${1:-}" = ask ] || [ "${1:-}" = card ] || [ "${1:-}" = prove ] || [ "${1:-}" = context ] || [ "${1:-}" = review ] || [ "${1:-}" = attach ] || [ "${1:-}" = new ] || { [ "${1:-}" = check ] && [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; } || { { [ "${1:-}" = check ] || [ "${1:-}" = test ]; } && [ -n "$has_budget" ]; } || { [ "${1:-}" = check ] && [ "${2:-}" = --json ] && [ -n "${3:-}" ] && [ "${3#-}" = "$3" ]; } || { [ "${1:-}" = test ] && [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; } || { [ "${1:-}" = test ] && [ -n "$has_bundle" ]; } || [ "${1:-}" = verify ] || { [ "${1:-}" = replay ] && [ "${2:-}" = --shrink ]; }; }; then
    native="$root/.native/ail"
    # AIL_NATIVE_FRESH=1 (the gate sets it after its first build): the caller says the sources have not changed, so skip the scan.
    if [ ! -x "$native" ] || { [ "${AIL_NATIVE_FRESH:-}" != 1 ] && [ -n "$(find "$root/compiler" "$root/std" -name '*.ail' -newer "$native" 2>/dev/null | head -n 1)" ]; }; then
        # The published seed is stage 0: it builds the native CLI (ADR 0855).
        mkdir -p "$root/.native"
        want_tag="$(head -n 1 "$root/tools/release/SEED_TAG" 2>/dev/null || true)"
        if [ ! -x "$root/.native/seed" ] || [ "$(cat "$root/.native/seed.tag" 2>/dev/null)" != "$want_tag" ]; then
            if "$root/tools/release/fetch-seed.sh"; then echo "$want_tag" > "$root/.native/seed.tag"; else rm -f "$root/.native/seed"; fi
        fi
        log="$native.log"
        if [ -x "$root/.native/seed" ]; then
            AIL_ROOT="$root" "$root/.native/seed" build "$root/compiler/main.ail" -o "$native.new" 2>"$log" || { cat "$log" >&2; die "the seed couldn't build the native CLI"; }
        else
            die "no seed for this host: check the network and rerun (tools/release/fetch-seed.sh; ADR 0855)"
        fi
        rm -f "$log"
        mv "$native.new" "$native"
    fi
    if [ "$1" = pkg ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" pkg "$@"; fi
    if [ "$1" = fmt ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" fmt "$@"; fi
    if [ "$1" = build ]; then
        # The native CLI's build doesn't check: check the file (the first operand) first.
        file=
        for a in "${@:2}"; do case "$a" in -*) ;; *) if [ -z "$file" ] && [ -f "$a" ]; then file="$a"; fi ;; esac; done
        unsafe_driver=
        prev=; for a in "${@:2}"; do if [ "$prev" = --unsafe ] && [ "$a" = driver ]; then unsafe_driver="--unsafe driver"; fi; prev="$a"; done
        [ -z "$file" ] || AIL_ROOT="$root" AIL_COMPILER="$root/compiler" "$native" check-program $unsafe_driver "$file" || exit $?
        shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" build "$@"
    fi
    if [ "$1" = diff ]; then shift; AIL="$root/ail" AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" diff "$@"; fi
    if [ "$1" = explain ] || [ "$1" = edit ] || [ "$1" = ask ] || [ "$1" = card ] || [ "$1" = prove ] || [ "$1" = context ] || [ "$1" = review ] || [ "$1" = attach ] || [ "$1" = new ]; then c="$1"; shift; AIL="$root/ail" AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" "$c" "$@"; fi
    if [ "$1" = fix ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" fix "$@"; fi
    if [ "$1" = api ]; then
        shift
        bdiff=
        for a in "$@"; do [ "$a" = --diff ] && bdiff=1; done
        if [ -n "$bdiff" ]; then
            # `ail api --diff ... --budget [N] [--from K]`: the native diff under the budget (api.diff.5, budget.out.1-7).
            bopts=(api --diff); aopts=(); prev=
            for a in "$@"; do
                case "$prev:$a" in
                    --budget:*[!0-9]* | --budget:) ;;
                    --budget:* | --from:*) bopts+=("$a"); prev=; continue ;;
                esac
                prev=
                case "$a" in
                    --budget | --from) bopts+=("$a"); prev="$a" ;;
                    --diff) ;;
                    --json) bopts+=("$a"); aopts+=("$a") ;;
                    *) aopts+=("$a") ;;
                esac
            done
            case " ${bopts[*]} " in
                *" --budget "* | *" --from "*) AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" budget "${bopts[@]}" -- "$native" api --diff "${aopts[@]}" ;;
            esac
        fi
        AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" api "$@"
    fi
    if [ "$1" = effects ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" effects "$@"; fi
    if [ "$1" = header ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" header "$@"; fi
    if [ "$1" = test ] && [ -n "$has_budget" ]; then
        # `ail test --budget [N] [--from K] [--json] FILE`: the native runner under the budget (budget.out.3).
        bopts=(); copts=(); prev=
        for a in "${@:2}"; do
            case "$prev:$a" in
                --budget:*[!0-9]* | --budget:) ;;
                --budget:* | --from:*) bopts+=("$a"); prev=; continue ;;
            esac
            prev=
            case "$a" in
                --budget | --from) bopts+=("$a"); prev="$a" ;;
                --json) bopts+=("$a"); copts+=("$a") ;;
                *) copts+=("$a") ;;
            esac
        done
        AIL="$root/ail" AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" budget test "${bopts[@]}" -- "$root/ail" run "$root/tools/ailtest/ailtest.ail" "${copts[@]}"
    fi
    # shrink.run.1: `ail replay --shrink BUNDLE` cuts a failure bundle's recorded texts (tools/shrink/shrink.ail).
    if [ "$1" = replay ]; then shift; AIL="$root/ail" exec "$root/ail" run "$root/tools/shrink/shrink.ail" "$@"; fi
    # verify.run.1: `ail verify --diff` composes `ask --affected`, `check` and `test --affected` (tools/verify/verify.ail).
    if [ "$1" = verify ]; then shift; AIL="$root/ail" exec "$root/ail" run "$root/tools/verify/verify.ail" "$@"; fi
    if [ "$1" = test ]; then shift; AIL="$root/ail" exec "$root/ail" run "$root/tools/ailtest/ailtest.ail" "$@"; fi
    if [ -n "$native_errors" ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" check-errors "$@"; fi
    if [ "$1" = check ] && [ -n "$has_budget" ]; then
        # `ail check --budget [N] [--from K] [--json] FILE`: the native check under the budget (budget.out.1-7).
        bopts=(); copts=(); prev=
        for a in "${@:2}"; do
            case "$prev:$a" in
                --budget:*[!0-9]* | --budget:) ;;
                --budget:* | --from:*) bopts+=("$a"); prev=; continue ;;
            esac
            prev=
            case "$a" in
                --budget | --from) bopts+=("$a"); prev="$a" ;;
                --json) bopts+=("$a"); copts+=("$a") ;;
                *) copts+=("$a") ;;
            esac
        done
        AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" budget check "${bopts[@]}" -- "$native" check-program "${copts[@]}"
    fi
    if [ "$1" = check ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" check-program "$@"; fi
    # shellcheck disable=SC2086
    AIL_ROOT="$root" AIL_COMPILER="$root/compiler" "$native" check-program $check_opts "$run_file" || exit $?
    prep_err="$(mktemp)"
    # shellcheck disable=SC2086
    if exe="$(AIL_COMPILER="$root/compiler" "$native" prepare $run_opts "$run_file" 2>"$prep_err")"; then
        rm -f "$prep_err"
        shift "$run_skip"
        # shellcheck disable=SC2086
        if [ -n "$budget_opts" ]; then AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" budget run $budget_opts -- "$exe" "$@"; fi
        if [ -n "${snap_json:-}" ]; then
            snap_err="$(mktemp)"
            snap_rc=0
            (AIL="$root/ail" exec -a "$run_file" "$exe" "$@") 2>"$snap_err" || snap_rc=$?
            awk -v main="$run_file" -f "$root/tools/trapjson.awk" < "$snap_err" >&2; rm -f "$snap_err"
            exit "$snap_rc"
        fi
        # `env.program()` is the source path, as it was given (std.env.4), so paths next to the source work:
        # argv[0] is set to it rather than the cached executable. `AIL` names this wrapper.
        AIL="$root/ail" exec -a "$run_file" "$exe" "$@"
    fi
    cat "$prep_err" >&2; rm -f "$prep_err"; exit 1
fi

# `ail selftest` with no arguments is the native gate (ADR 0865, item 252): tools/gate/mac-gate.sh runs gate.ail's suites with the
# native compiler. `selftest SUITE...` runs those gate suites, `selftest --fuzz N [SEED]` the AIL fuzzers.
if [ "${1:-}" = selftest ]; then
    if [ "$#" = 1 ]; then exec "$root/tools/gate/mac-gate.sh"; fi
    if [ "${2:-}" = --fuzz ]; then
        # The AIL fuzzers (tools/fuzz/suite.ail, modules.ail): programs and module inputs, no Rust harness.
        n="${3:?usage: ail selftest --fuzz N [SEED]}"; shift 3
        seed=1; case "${1:-}" in ''|*[!0-9]*) ;; *) seed="$1"; shift ;; esac
        echo "fuzz: $n inputs per fuzzer from seed $seed" >&2
        "$root/ail" run "$root/tools/fuzz/suite.ail" "$n" "$seed" || exit $?
        exec "$root/ail" run "$root/tools/fuzz/modules.ail" "$n" "$seed"
    fi
    # Gate suites by name (tools/gate/gate.ail), as the Mac gate runs them.
    shift; exec "$root/ail" run "$root/tools/gate/gate.ail" "$@"
fi

# `ail test` is native only (plan.md step B): the AIL runner (tools/ailtest/ailtest.ail) builds the tests natively and
# runs each. A test it can't build is reported `skip` with the construct that blocks it.
if [ "${1:-}" = test ] && [ -n "${2:-}" ]; then
    for test_arg in "${@:2}"; do
        case "$test_arg" in
            --watch | --watch=*)
                echo "ail test: $test_arg is not native yet" >&2
                exit 2 ;;
        esac
    done
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailtest/ailtest.ail" "${@:2}"
fi

# `ail mcp` (ADR 0918): the compiler's tools as an MCP server on stdio, tools/ailmcp/ailmcp.ail.
# AIL_MCP_NATIVE names the native CLI, which `run` keeps fresh, for the warm path (mcp.warm.1).
if [ "${1:-}" = mcp ]; then
    AIL_MCP_NATIVE="$root/.native/ail" AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailmcp/ailmcp.ail" "${@:2}"
fi

# `ail lsp` (ADR 0966): the compiler's semantic API as a language server on stdio, tools/ailsp/ailsp.ail.
if [ "${1:-}" = lsp ]; then
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailsp/ailsp.ail" "${@:2}"
fi

# `ail sanitize` (ADR 0967): the schedule sanitizer, tools/ailsan/ailsan.ail.
if [ "${1:-}" = sanitize ]; then
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailsan/ailsan.ail" "${@:2}"
fi

# `ail leak` (ADR 0968): build FILE, run it with the leak report on (AIL_LEAK, san.leak.*).
# The report goes to standard error after the program's own output; the exit status is the program's.
if [ "${1:-}" = leak ]; then
    shift
    leak_json=0
    leak_all=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) leak_json=1 ;;
            --all) leak_all=1 ;;
            *) break ;;
        esac
        shift
    done
    [ $# -ge 1 ] || die "usage: ail leak [--json] [--all] FILE [ARGS...]"
    leak_file="$1"
    shift
    leak_mode=1
    [ "$leak_all" = 1 ] && leak_mode=all
    [ "$leak_json" = 1 ] && leak_mode=json
    [ "$leak_all$leak_json" = 11 ] && leak_mode=all,json
    leak_exe="$(mktemp "${TMPDIR:-/tmp}/ail-leak.XXXXXX")" || exit 2
    "$root/ail" build "$leak_file" -o "$leak_exe" || { rm -f "$leak_exe"; exit 2; }
    AIL_LEAK="$leak_mode" "$leak_exe" "$@"
    leak_rc=$?
    rm -f "$leak_exe"
    exit "$leak_rc"
fi

# `ail infer --contracts FN FILE` (ADR 1023): proposes requires/ensures from the calls the tests make, tools/infer/infer.ail.
if [ "${1:-}" = infer ]; then
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/infer/infer.ail" "${@:2}"
fi

# `ail task` (ADR 0917): the agent task protocol, tools/ailtask/ailtask.ail.
if [ "${1:-}" = task ]; then
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailtask/ailtask.ail" "${@:2}"
fi

# `ail try` (ADR 0893): check and test patch sets on a scratch copy, tools/ailtry/ailtry.ail.
if [ "${1:-}" = try ]; then
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailtry/ailtry.ail" "${@:2}"
fi

# `ail merge` (ADR 1019): a three-way merge by declaration and a git merge driver, tools/ailmerge/ailmerge.ail.
if [ "${1:-}" = merge ]; then
    AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailmerge/ailmerge.ail" "${@:2}"
fi

if [ "${1:-}" = version ] || [ "${1:-}" = --version ]; then echo "ail $(head -n 1 "$root/tools/release/VERSION" 2>/dev/null || echo 0.0.0) ($(git -C "$root" describe --tags --always --dirty 2>/dev/null || echo unknown), native)"; exit 0; fi

# Everything else has no native form.
die "\`ail ${1:-}\` has no native form; run \`./ail\` with a command from docs/quick-reference.md"
