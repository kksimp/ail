#!/usr/bin/env bash
# The AIL command-line tool (bootstrap edition). From the repository root:
#
#   ./ail run examples/hello.ail     check and run a program
#   ./ail check FILE                 check without running (add --json for tools)
#   ./ail selftest                   the Mac gate (tools/gate/mac-gate.sh); AIL_SELFTEST=cargo runs the Rust tests
#
# Rust (ADR 0087): if the system Rust doesn't exactly match the version pinned
# in bootstrap/rust-toolchain.toml, that version is installed privately into
# .toolchain/ on first run. Nothing outside this repository is changed.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# std.app.10: a program finds the app host built under the toolchain.
export AIL_ROOT="$root"
manifest="$root/bootstrap/Cargo.toml"
binary="$root/bootstrap/target/release/ail"
pin="$(sed -n 's/^channel *= *"\(.*\)"$/\1/p' "$root/bootstrap/rust-toolchain.toml")"
tooldir="${AIL_TOOLCHAIN_DIR:-$root/.toolchain}"

die() { echo "ail: $*" >&2; exit 2; }

host_triple() {
    case "$(uname -s)-$(uname -m)" in
        Darwin-arm64) echo aarch64-apple-darwin ;;
        Linux-x86_64) echo x86_64-unknown-linux-gnu ;;
        Linux-aarch64 | Linux-arm64) echo aarch64-unknown-linux-gnu ;;
        Darwin-x86_64) die "Intel Macs aren't supported (ADR 0004)" ;;
        *) die "unsupported host: $(uname -s) $(uname -m)" ;;
    esac
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

install_private_rust() {
    local triple tmp url
    triple="$(host_triple)"
    echo "ail: installing Rust $pin privately into ${tooldir#"$root"/}/ (first run only; takes a few minutes) ..." >&2
    tmp="$(mktemp -d)"
    url="https://static.rust-lang.org/rustup/dist/$triple/rustup-init"
    curl --proto '=https' --tlsv1.2 -fsS -o "$tmp/rustup-init" "$url" || die "couldn't download $url"
    curl --proto '=https' --tlsv1.2 -fsS -o "$tmp/rustup-init.sha256" "$url.sha256" || die "couldn't download $url.sha256"
    [ "$(cut -d' ' -f1 "$tmp/rustup-init.sha256")" = "$(sha256_of "$tmp/rustup-init")" ] ||
        die "rustup-init checksum mismatch; not installing"
    chmod +x "$tmp/rustup-init"
    if ! "$tmp/rustup-init" -y --no-modify-path --profile minimal --default-toolchain "$pin" >"$tmp/install.log" 2>&1; then
        cat "$tmp/install.log" >&2
        die "Rust installation failed"
    fi
    rm -rf "$tmp"
    echo "ail: Rust $pin installed" >&2
}

# conc.sched.1: `--schedule=fixed|random[:SEED]` of `run` and `test` becomes AIL_SCHEDULE, which the build (switch points at
# atomic operations) and the runtime (sched.ail) read; a random schedule without a seed picks one and prints it.
case "${1:-}" in run | test)
    sched_rest=()
    for a in "$@"; do
        case "$a" in
            --schedule=*)
                w="${a#--schedule=}"
                case "$w" in
                    fixed) export AIL_SCHEDULE=fixed ;;
                    random) w="random:$(( $(date +%s) % 1000000 ))"; echo "schedule seed ${w#random:}: replay with --schedule=$w" >&2; export AIL_SCHEDULE="$w" ;;
                    random:*[!0-9]* | random:) die "\`$a\` isn't a schedule; use \`--schedule=random\` or \`--schedule=random:SEED\` with a non-negative SEED (conc.sched.1)" ;;
                    random:*) export AIL_SCHEDULE="$w" ;;
                    *) die "\`$a\` isn't a schedule; use \`--schedule=random\` or \`--schedule=random:SEED\` with a non-negative SEED (conc.sched.1)" ;;
                esac ;;
            *) sched_rest+=("$a") ;;
        esac
    done
    set -- "${sched_rest[@]}" ;;
esac

# Package options for the native loader (mod.pkg.7-8, compiler/pkg/git.ail): `run` and `test` write
# `ail.lock`, `--deterministic` refuses a stale one, `--deny net` fetches nothing.
case "${1:-}" in run | test) export AIL_PKG_WRITE_LOCK=1 ;; esac
prev=
for a in "$@"; do
    case "$a" in --deterministic) export AIL_PKG_FROZEN=1 ;; esac
    if [ "$prev" = --deny ] && [ "${a#*net}" != "$a" ]; then export AIL_PKG_OFFLINE=1; fi
    prev="$a"
done

# `AIL_NATIVE_COMPILER=PATH`: `ail build` is done by a natively built compiler (stage 1 of
# tools/self-host/run.sh) in place of the Rust-hosted one. The program is checked first, as `ail build` does
# (with `--unsafe driver`, unsafe.hw.1, when given); the native compiler takes the same arguments.
if [ "${1:-}" = build ] && [ -n "${AIL_NATIVE_COMPILER:-}" ]; then
    [ -x "$AIL_NATIVE_COMPILER" ] || die "AIL_NATIVE_COMPILER=$AIL_NATIVE_COMPILER isn't an executable"
    native_file="" native_skip=0 native_unsafe=""
    for native_arg in "${@:2}"; do
        if [ "$native_skip" = 1 ]; then native_skip=0; continue; fi
        case "$native_arg" in
            -o | --target | --timeout | --max-memory | --unsafe) native_skip=1 ;;
            -*) ;;
            *) [ -n "$native_file" ] || native_file="$native_arg" ;;
        esac
    done
    native_prev=""
    for native_arg in "$@"; do
        if [ "$native_prev" = --unsafe ] && [ "$native_arg" = driver ]; then native_unsafe=driver; fi
        native_prev="$native_arg"
    done
    if [ -n "$native_file" ]; then
        if [ -n "$native_unsafe" ]; then
            AIL_NATIVE_COMPILER= "$root/ail" check --unsafe driver "$native_file" || exit 1
        else
            AIL_NATIVE_COMPILER= "$root/ail" check "$native_file" || exit 1
        fi
        exec "$AIL_NATIVE_COMPILER" "$@"
    fi
fi

# The native CLI (ADR 0855) is the default: `ail fmt ...`, `ail test FILE` (tools/ailtest), `ail api FILE`, `ail build`,
# `ail check FILE` and `ail run [--timeout MS] [--max-memory MB] FILE [ARGS]` are done by compiler/main.ail
# built natively into .native/ail (by the published seed, stage 0; no cargo fallback): `check-program` first,
# then the program from the build cache, exec'd so it keeps the terminal. `AIL_RUST=1` (or a pinned AIL_BINARY) is the
# one way to the Rust `ail` and its interpreter, until the Rust is deleted; a program outside the native subset is an error.
# Anything else, and `run` with other options before the file, goes to the Rust `ail` below.
# `ail api` natively: one file, with at most --outline, --text, --pretty and --symbols.
native_on=1
if [ "${AIL_RUST:-}" = 1 ] || [ -n "${AIL_BINARY:-}" ]; then native_on=0; fi
# trace.run.1: the tracing options belong to `run` and `test`.
if [ "${1:-}" != run ] && [ "${1:-}" != test ]; then
    for trace_arg in "$@"; do
        case "$trace_arg" in
            --trace | --trace=* | --trace-limit | --watch | --watch=* | --verbose) echo "error[trace.run.1]: the tracing options (\`$trace_arg\`) work with \`ail run\` and \`ail test\` (trace.run.1)" >&2; exit 2 ;;
        esac
    done
fi
# replay.rec.1: `--record` and `--replay` belong to `run` and `test`.
if [ "${1:-}" != run ] && [ "${1:-}" != test ]; then
    for rec_arg in "$@"; do
        case "$rec_arg" in
            --record | --replay) echo "error[replay.rec.1]: \`$rec_arg\` works with \`ail run\` and \`ail test\` and a file name (replay.rec.1)" >&2; exit 2 ;;
        esac
    done
fi
native_run=
run_opts=
budget_opts=
run_skip=0
check_opts=
if [ "${1:-}" = run ] && [ "$native_on" = 1 ]; then
    run_args=("$@")
    k=1
    while [ "$k" -lt "${#run_args[@]}" ]; do
        a="${run_args[$k]}"
        case "$a" in
            --timeout | --max-memory)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) break ;; esac
                run_opts="$run_opts $a $v"; k=$((k + 2)) ;;
            --budget)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) budget_opts="$budget_opts --budget"; k=$((k + 1)) ;; *) budget_opts="$budget_opts --budget $v"; k=$((k + 2)) ;; esac ;;
            --from)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) break ;; esac
                budget_opts="$budget_opts --from $v"; k=$((k + 2)) ;;
            --json) budget_opts="$budget_opts --json"; k=$((k + 1)) ;;
            --record | --replay)
                v="${run_args[$((k + 1))]-}"
                [ -n "$v" ] || die "\`$a\` needs a recording file, e.g. \`$a r.json\` (replay.rec.1)"
                if [ "$a" = --record ]; then export AIL_RECORD="$v"; rec_run=1; else export AIL_REPLAY="$v"; rep_run=1; fi
                export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}record"; k=$((k + 2)) ;;
            --max-steps)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]* | 0) die "\`--max-steps\` needs a positive number of steps (run.limit.4)" ;; esac
                export AIL_MAX_STEPS="$v" AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}steps"; k=$((k + 2)) ;;
            --watch)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!A-Za-z0-9_]*) die "\`--watch\` needs a variable name, e.g. \`--watch total\` (trace.watch.1)" ;; esac
                export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}watch=$v"; k=$((k + 2)) ;;
            --no-contracts) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}nocontracts"; k=$((k + 1)) ;;
            --trace | --trace=all) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}trace,traceeffects"; trace_run=1; k=$((k + 1)) ;;
            --trace=calls) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}trace"; trace_run=1; k=$((k + 1)) ;;
            --trace=effects) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}traceeffects"; trace_run=1; k=$((k + 1)) ;;
            --trace=*) die "\`$a\` isn't a trace kind: use \`--trace\`, \`--trace=calls\`, \`--trace=effects\` or \`--trace=all\` (trace.run.1)" ;;
            --trace-limit)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]* | 0) die "\`--trace-limit\` needs a positive number of events (trace.run.4)" ;; esac
                export AIL_TRACE_LIMIT="$v"; k=$((k + 2)) ;;
            --verbose) k=$((k + 1)) ;;
            --no-attach) run_opts="$run_opts --no-attach"; k=$((k + 1)) ;;
            --values) export AIL_INSTRUMENT="${AIL_INSTRUMENT:+$AIL_INSTRUMENT,}values"; k=$((k + 1)) ;;
            --deterministic) export AIL_DETERMINISTIC=1; det_run=1; check_opts="$check_opts --deterministic"; k=$((k + 1)) ;;
            --deny)
                v="${run_args[$((k + 1))]-}"
                [ -n "$v" ] || die "\`--deny\` needs a list of capabilities, e.g. \`--deny fs,proc\`"
                check_opts="$check_opts --deny $v"; k=$((k + 2)) ;;
            --parallel) export AIL_PARALLEL=1; k=$((k + 1)) ;;
            --unsafe)
                [ "${run_args[$((k + 1))]-}" = driver ] || break
                check_opts="$check_opts --unsafe driver"; k=$((k + 2)) ;;
            --seed)
                v="${run_args[$((k + 1))]-}"
                case "$v" in "" | *[!0-9]*) die "\`--seed\` needs an integer, e.g. \`--seed 42\` (std.random.3)" ;; esac
                export AIL_SEED="$v"; k=$((k + 2)) ;;
            "" | -*) break ;;
            *) native_run=1; run_file="$a"; k=$((k + 1)); break ;;
        esac
    done
    run_skip=$k
    # trace.run.1: with a trace, `--json` makes the events JSON objects.
    if [ "${trace_run:-}" = 1 ] && [ "$budget_opts" = " --json" ]; then
        budget_opts=""; export AIL_TRACE_JSON=1 AIL_INSTRUMENT="$AIL_INSTRUMENT,tracejson"
    fi
    # Record and replay (ADR 0873, replay.rec.1-2, replay.run.1): the recording's first line says what ran.
    if [ "${rep_run:-}" = 1 ] && [ "${rec_run:-}" != 1 ]; then
        [ -r "$AIL_REPLAY" ] || die "can't read the recording $AIL_REPLAY (replay.run.1)"
        rep_head="$(head -n 1 "$AIL_REPLAY")"
        # Plain parameter expansion and awk, so BSD sed (macOS) reads the header the same way.
        rep_unq() { printf '%s' "$1" | sed 's/\\"/"/g; s/\\\\/\\/g'; }
        rep_prog="${rep_head#*\"program\":\"}"; rep_prog="$(rep_unq "${rep_prog%%\",\"args\"*}")"
        rep_seed="${rep_head#*\"seed\":}"; rep_seed="${rep_seed%%,*}"
        rep_list="${rep_head#*\"args\":[}"; rep_list="${rep_list%%],\"seed\"*}"
        rep_args=()
        if [ -n "$rep_list" ]; then
            while IFS= read -r rep_a; do rep_args+=("$rep_a"); done < <(printf '%s' "$rep_list" | sed 's/^"//; s/"$//' | awk 'BEGIN { FS = "\",\"" } { for (i = 1; i <= NF; i++) print $i }' | sed 's/\\"/"/g; s/\\\\/\\/g')
        fi
        [ -n "$rep_seed" ] && export AIL_SEED="$rep_seed"
        [ -n "${run_file:-}" ] || run_file="$rep_prog"
        set -- run "$run_file" ${rep_args[@]+"${rep_args[@]}"}
        run_skip=2; native_run=1
    elif [ "${rec_run:-}" = 1 ] && [ -n "${native_run:-}" ]; then
        [ -n "${AIL_SEED:-}" ] || export AIL_SEED="$(( $(date +%s) * 1000003 + $$ ))"
        rec_q() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
        rec_list=
        rec_i=$run_skip
        while [ "$rec_i" -lt "${#run_args[@]}" ]; do rec_list="$rec_list${rec_list:+,}\"$(rec_q "${run_args[$rec_i]}")\""; rec_i=$((rec_i + 1)); done
        printf '{"ail_record":1,"program":"%s","args":[%s],"seed":%s,"limit":67108864}\n' "$(rec_q "$run_file")" "$rec_list" "$AIL_SEED" > "$AIL_RECORD" || die "can't write the recording $AIL_RECORD"
    fi
    case "$budget_opts" in "" | *--budget*) ;; *) native_run= ;; esac
fi
native_build=
if [ "${1:-}" = build ]; then
    native_build=1
    for a in "${@:2}"; do
        case "$a" in --derived-out) native_build= ;; esac
    done
fi
# Every `ail api` mode is native (outline, --symbols, --expanded, packages, --card, --diff, --locals/--type/--refs, --tokens, --ast).
native_api=
if [ "${1:-}" = api ]; then
    native_api=1
fi
# `ail check --deny/--deterministic/--unsafe ...` is native too (eff.cap.1, eff.det.1, unsafe.hw.1).
native_check=
if [ "${1:-}" = check ]; then case "${2:-}" in --deny | --deterministic | --unsafe) native_check=1 ;; esac; fi
# `ail effects [--json] FILE` is native too (#695).
native_effects=
if [ "${1:-}" = effects ]; then
    native_effects=1; files=0
    for a in "${@:2}"; do
        case "$a" in --json) ;; -*) native_effects= ;; *) if [ -f "$a" ]; then files=$((files + 1)); else native_effects=; fi ;; esac
    done
    [ "$files" = 1 ] || native_effects=
fi
if [ "$native_on" = 1 ] && { [ -n "$native_api" ] || [ -n "$native_effects" ] || [ -n "$native_check" ] || [ -n "$native_build" ] || [ -n "$native_run" ] || [ "${1:-}" = pkg ] || [ "${1:-}" = diff ] || [ "${1:-}" = fmt ] || [ "${1:-}" = fix ] || [ "${1:-}" = explain ] || [ "${1:-}" = edit ] || [ "${1:-}" = ask ] || { [ "${1:-}" = check ] && [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; } || { [ "${1:-}" = check ] && { [ "${2:-}" = --budget ] || [ "${2:-}" = --from ]; }; } || { [ "${1:-}" = check ] && [ "${2:-}" = --json ] && [ -n "${3:-}" ] && [ "${3#-}" = "$3" ]; } || { [ "${1:-}" = test ] && [ -n "${2:-}" ] && [ "${2#-}" = "$2" ]; }; }; then
    native="$root/.native/ail"
    if [ ! -x "$native" ] || [ -n "$(find "$root/compiler" "$root/std" -name '*.ail' -newer "$native" 2>/dev/null | head -n 1)" ]; then
        # The published seed is stage 0: it builds the native CLI (ADR 0855, D4); there is no cargo fallback.
        mkdir -p "$root/.native"
        want_tag="$(head -n 1 "$root/tools/release/SEED_TAG" 2>/dev/null || true)"
        if [ ! -x "$root/.native/seed" ] || [ "$(cat "$root/.native/seed.tag" 2>/dev/null)" != "$want_tag" ]; then
            if "$root/tools/release/fetch-seed.sh"; then echo "$want_tag" > "$root/.native/seed.tag"; else rm -f "$root/.native/seed"; fi
        fi
        log="$native.log"
        if [ -x "$root/.native/seed" ]; then
            AIL_ROOT="$root" "$root/.native/seed" build "$root/compiler/main.ail" -o "$native.new" 2>"$log" || { cat "$log" >&2; die "the seed couldn't build the native CLI"; }
        else
            die "no seed for this host: sign in with gh or set GITHUB_TOKEN, then rerun (tools/release/fetch-seed.sh; ADR 0855)"
        fi
        rm -f "$log"
        mv "$native.new" "$native"
    fi
    if [ "$1" = pkg ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" pkg "$@"; fi
    if [ "$1" = fmt ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" fmt "$@"; fi
    if [ "$1" = build ]; then
        # The native CLI's build doesn't check: check the file (the first operand) first.
        file=
        for a in "${@:2}"; do case "$a" in -*) ;; *) if [ -z "$file" ] && [ -f "$a" ]; then file="$a"; fi ;; esac; done
        unsafe_driver=
        prev=; for a in "${@:2}"; do if [ "$prev" = --unsafe ] && [ "$a" = driver ]; then unsafe_driver="--unsafe driver"; fi; prev="$a"; done
        [ -z "$file" ] || AIL_ROOT="$root" AIL_COMPILER="$root/compiler" "$native" check-program $unsafe_driver "$file" || exit $?
        shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" build "$@"
    fi
    if [ "$1" = diff ]; then shift; AIL="$root/ail" AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" diff "$@"; fi
    if [ "$1" = explain ] || [ "$1" = edit ] || [ "$1" = ask ]; then c="$1"; shift; AIL="$root/ail" AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" "$c" "$@"; fi
    if [ "$1" = fix ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" fix "$@"; fi
    if [ "$1" = api ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" api "$@"; fi
    if [ "$1" = effects ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" effects "$@"; fi
    if [ "$1" = test ]; then shift; AIL="$root/ail" exec "$root/ail" run "$root/tools/ailtest/ailtest.ail" "$@"; fi
    if [ "$1" = check ] && { [ "${2:-}" = --budget ] || [ "${2:-}" = --from ]; }; then
        # `ail check --budget [N] [--from K] [--json] FILE`: the native check under the budget (budget.out.1-7).
        bopts=(); copts=(); prev=
        for a in "${@:2}"; do
            case "$prev:$a" in
                --budget:*[!0-9]* | --budget:) ;;
                --budget:* | --from:*) bopts+=("$a"); prev=; continue ;;
            esac
            prev=
            case "$a" in
                --budget | --from) bopts+=("$a"); prev="$a" ;;
                --json) bopts+=("$a"); copts+=("$a") ;;
                *) copts+=("$a") ;;
            esac
        done
        AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" budget check "${bopts[@]}" -- "$native" check-program "${copts[@]}"
    fi
    if [ "$1" = check ]; then shift; AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" check-program "$@"; fi
    # shellcheck disable=SC2086
    AIL_ROOT="$root" AIL_COMPILER="$root/compiler" "$native" check-program $check_opts "$run_file" || exit $?
    prep_err="$(mktemp)"
    # shellcheck disable=SC2086
    if exe="$(AIL_COMPILER="$root/compiler" "$native" prepare $run_opts "$run_file" 2>"$prep_err")"; then
        rm -f "$prep_err"
        shift "$run_skip"
        # shellcheck disable=SC2086
        if [ -n "$budget_opts" ]; then AIL_ROOT="$root" AIL_COMPILER="$root/compiler" exec "$native" budget run $budget_opts -- "$exe" "$@"; fi
        # `env.program()` is the source path, as it was given (std.env.4), so paths next to the source work:
        # argv[0] is set to it rather than the cached executable. `AIL` names this wrapper.
        AIL="$root/ail" exec -a "$run_file" "$exe" "$@"
    fi
    cat "$prep_err" >&2; rm -f "$prep_err"; exit 1
fi

# `ail selftest` with no arguments is the native gate (ADR 0865, item 252): tools/gate/mac-gate.sh runs gate.ail's suites with the
# native compiler. `selftest SUITE...` runs those gate suites, `selftest --fuzz N [SEED]` the AIL fuzzers; `AIL_SELFTEST=cargo` keeps the cargo tests.
if [ "${1:-}" = selftest ] && [ "$native_on" = 1 ] && [ "${AIL_SELFTEST:-}" != cargo ]; then
    if [ "$#" = 1 ]; then exec "$root/tools/gate/mac-gate.sh"; fi
    if [ "${2:-}" = --fuzz ]; then
        # The AIL fuzzers (tools/fuzz/suite.ail, modules.ail): programs and module inputs, no Rust harness.
        n="${3:?usage: ail selftest --fuzz N [SEED]}"; shift 3
        seed=1; case "${1:-}" in ''|*[!0-9]*) ;; *) seed="$1"; shift ;; esac
        echo "fuzz: $n inputs per fuzzer from seed $seed" >&2
        "$root/ail" run "$root/tools/fuzz/suite.ail" "$n" "$seed" || exit $?
        exec "$root/ail" run "$root/tools/fuzz/modules.ail" "$n" "$seed"
    fi
    # Gate suites by name (tools/gate/gate.ail), as the Mac gate runs them.
    shift; exec "$root/ail" run "$root/tools/gate/gate.ail" "$@"
fi

# `ail test` is native only (plan.md step B): the AIL runner (tools/ailtest/ailtest.ail) builds the tests natively and
# runs each. A test it can't build is reported `skip` with the construct that blocks it. `--trace` belongs
# to the interpreter and is refused until it is ported.
if [ "${1:-}" = test ] && [ -n "${2:-}" ]; then
    for test_arg in "${@:2}"; do
        case "$test_arg" in
            --watch | --watch=*)
                echo "ail test: $test_arg is not native yet (interpreter only: AIL_RUST=1 ./ail test ...)" >&2
                [ "${AIL_RUST:-}" = 1 ] || exit 2 ;;
        esac
    done
    if [ "${AIL_RUST:-}" != 1 ]; then
        AIL_NATIVE_CLI= AIL="$root/ail" exec "$root/ail" run "$root/tools/ailtest/ailtest.ail" "${@:2}"
    fi
fi

# A test run pins the binary it is testing (AIL_BINARY), so a program that starts `ail` itself isn't
# rebuilt under it when the sources change mid-run.
if [ "${1:-}" != selftest ] && [ -n "${AIL_BINARY:-}" ] && [ -x "$AIL_BINARY" ]; then
    exec "$AIL_BINARY" "$@"
fi

# Fast path: when nothing the bootstrap builds from is newer than its binary, run it without
# looking for a toolchain. Cargo's freshness check and the Rust version probe cost about 0.1 s per run.
if [ "${1:-}" != selftest ] && [ -x "$binary" ] &&
    [ -z "$(find "$root/bootstrap/src" "$manifest" "$root/bootstrap/Cargo.lock" "$root/bootstrap/build.rs" \
        "$root/bootstrap/rust-toolchain.toml" -newer "$binary" 2>/dev/null | head -n 1)" ]; then
    exec "$binary" "$@"
fi

# Pick cargo: the system's if it matches the pin, otherwise the private copy.
if command -v cargo >/dev/null 2>&1 && [ "$(rustc --version 2>/dev/null | cut -d' ' -f2)" = "$pin" ]; then
    cargo="cargo"
else
    export RUSTUP_HOME="$tooldir/rustup" CARGO_HOME="$tooldir/cargo" RUSTUP_TOOLCHAIN="$pin"
    cargo="$CARGO_HOME/bin/cargo"
    if [ ! -x "$cargo" ]; then
        install_private_rust
    elif ! "$CARGO_HOME/bin/rustup" toolchain list 2>/dev/null | grep -q "^$pin"; then
        "$CARGO_HOME/bin/rustup" toolchain install --profile minimal "$pin" >&2 || die "couldn't install Rust $pin"
    fi
fi

# Building Rust code needs the platform linker.
if [ "$(uname -s)" = Darwin ] && ! xcrun --find cc >/dev/null 2>&1; then
    die "Apple's command-line developer tools are required (one-time): run  xcode-select --install"
fi

# Runs the test binaries listed in $2 with $1 workers; logs and exit codes go to $3.
run_binaries() {
    AIL_SELFTEST_DIR="$3" AIL_SELFTEST_ROOT="$root/bootstrap" xargs -P "$1" -n 1 sh -c '
        name="$(basename "$1")"
        [ -e "$AIL_SELFTEST_DIR/FAILED" ] && exit 0
        (cd "$AIL_SELFTEST_ROOT" && "$1") >"$AIL_SELFTEST_DIR/$name.log" 2>&1
        rc=$?
        echo "$rc" >"$AIL_SELFTEST_DIR/$name.rc"
        [ "$rc" -eq 0 ] || touch "$AIL_SELFTEST_DIR/FAILED"
        exit 0' sh <"$2"
}

# `./ail selftest` with no arguments (ADR 0814): build the test binaries with cargo, then run
# them on four workers, the native test first since it is the longest. Each binary's output
# goes to its own log, and the logs print in cargo's order at the end. After a failure, the
# workers start no new binaries; those are reported as skipped. The workers only run the
# binaries, so a test's own temporary paths must be unique per run (ADR 0814).
selftest_parallel() {
    local dir exe name rc status=0
    dir="$(mktemp -d)" || die "can't make a temporary directory"
    if ! (cd "$root/bootstrap" && "$cargo" test --release --manifest-path "$manifest" --no-run) >"$dir/build.log" 2>&1; then
        cat "$dir/build.log" >&2
        rm -rf "$dir"
        return 1
    fi
    # cargo prints one `Executable NAME (PATH)` line per test binary; PATH is relative to bootstrap/.
    sed -n 's/^ *Executable .*(\(.*\))$/\1/p' "$dir/build.log" > "$dir/all"
    grep 'deps/native-' "$dir/all" > "$dir/first" || true
    grep -v 'deps/native-' "$dir/all" > "$dir/rest" || true
    cat "$dir/first" "$dir/rest" > "$dir/order"
    # The native binary runs alone: it already uses four threads (ADR 0814). The rest
    # share four workers.
    run_binaries 1 "$dir/first" "$dir"
    run_binaries 4 "$dir/rest" "$dir"
    while read -r exe; do
        name="$(basename "$exe")"
        echo "     Running $exe"
        if [ -e "$dir/$name.rc" ]; then
            cat "$dir/$name.log"
            read -r rc <"$dir/$name.rc"
            if [ "$rc" -ne 0 ]; then
                echo "test binary $name failed (exit $rc)" >&2
                status=1
            fi
        else
            echo "skipped after a failure: $name"
            status=1
        fi
    done <"$dir/order"
    rm -rf "$dir"
    return "$status"
}

if [ "${1:-}" = selftest ]; then
    shift
    # `--fuzz N [SEED]` runs both fuzzers (fuzz.run.2); other words go to `cargo test`
    # (fuzz.run.1: `./ail selftest --test fuzz`).
    if [ "${1:-}" = --fuzz ]; then
        export AIL_FUZZ_N="${2:?usage: ail selftest --fuzz N [SEED]}"
        shift 2
        case "${1:-}" in ''|*[!0-9]*) ;; *) export AIL_FUZZ_SEED="$1"; shift ;; esac
        echo "fuzz: $AIL_FUZZ_N inputs per fuzzer from seed ${AIL_FUZZ_SEED:-1}" >&2
        exec "$cargo" test --quiet --release --manifest-path "$manifest" --test fuzz --test fuzz_modules fuzz_ "$@" -- --nocapture
    fi
    if [ "$#" -eq 0 ] && [ "${AIL_SELFTEST:-gate}" != cargo ]; then
        # The Mac gate (ADR 0842) is the selftest: native only. `AIL_SELFTEST=cargo` keeps the Rust test binaries.
        exec "$root/tools/gate/mac-gate.sh"
    fi
    if [ "$#" -eq 0 ]; then
        selftest_parallel
        exit $?
    fi
    exec "$cargo" test --quiet --release --manifest-path "$manifest" "$@"
fi

[ -x "$binary" ] || echo "ail: building the bootstrap (first run only) ..." >&2
"$cargo" build --quiet --release --manifest-path "$manifest" || die "building the bootstrap failed"
exec "$binary" "$@"
