# The self-hosted front end's entry point (Stage 3, ADR 0022), run by the
# bootstrap and compared with it by the selftest:
#   ail run compiler check PROGRAM.json   the checker's diagnostics for a program dumped by
#                                         `ail api --ast --program` (first line), one JSON line each
#   ail run compiler tokens FILE...       the AIL lexer's tokens, as `ail api --tokens FILE` (ADR 0371)
#   ail run compiler parse FILE...        the AIL parser's tree, as `ail api --ast FILE`
#   ail run compiler mir FILE             the native backend's MIR of a program (ADR 0384)
# With several files, each output starts with a line `== PATH`.
use ast
use check
use mir
use syntax

fn main() !
    args := env.args()
    if args.len() < 2
        io.eprint("usage: ail run compiler (check PROGRAM.json... | tokens FILE... | parse FILE... | mir FILE)")
        io.exit(2)
    match args[0]
        "check" =>
            for path in args[1..]
                check_dump(path, args.len() > 2)?
        "tokens" =>
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                print(syntax.tokens_text(syntax.lex(fs.read_text(path)?)))
        "parse" =>
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                lexed := syntax.lex(fs.read_text(path)?)
                print(syntax.ast_text(lexed, syntax.parse(lexed.tokens)))
        "mir" =>
            m := lower_file(args[1])?
            print(mir.module_text(m))
        _ =>
            io.eprint("unknown command {args[0]}")
            io.exit(2)

## The checker's diagnostics for one dump, sorted by position as `ail check`
## reports them. With several dumps, each starts with `== PATH` and ends
## with what the checker covers (`rules ...`, `skip FILE FIRST LAST`).
fn check_dump(path str, many bool) !
    text := fs.read_text(path)?
    first := text.lines().first() else ""
    prog := ast.Program.from_json(parse_json(first)?)?
    diags := check.check_declarations(prog).sorted(by: |d| d.pos.line * 100000 + d.pos.col)
    if many
        print("== {path}")
    for d in diags
        print(d.to_json(prog.files))
    if many
        print("rules {check.COVERED_RULES.join(" ")}")
        for s in check.skipped(prog)
            print("skip {s.file} {s.first} {s.last}")

## Parse a program and lower it to MIR; problems outside the native subset
## are printed as `ail check` prints diagnostics, and the run fails.
fn lower_file(path str) !mir.Module
    text := fs.read_text(path)?
    lexed := syntax.lex(text)
    parsed := syntax.parse(lexed.tokens)
    m := mir.lower_module(path, text, parsed.program, none) else err
        for p in err.items
            io.eprint("{path}:{p.pos.line}:{p.pos.col}: error[{p.rule}]: {p.message}")
        io.exit(1)
        return mir.Module(path: path, funcs: [], strs: [], sites: [], lines: [])
    m
