# The self-hosted front end's entry point (Stage 3, ADR 0022), run by the
# bootstrap and compared with it by the selftest:
#   ail run compiler check PROGRAM.json   the checker's diagnostics for a program dumped by
#                                         `ail api --ast --program` (first line), one JSON line each
#   ail run compiler explain [RULE] [--json]
#                                         `ail explain`, the rule text read from docs/spec (ADR 0146)
#   ail run compiler tokens FILE...       the AIL lexer's tokens, as `ail api --tokens FILE` (ADR 0371)
#   ail run compiler parse FILE...        the AIL parser's tree, as `ail api --ast FILE`
#   ail run compiler mir FILE [RT]        the native backend's MIR of a program (ADR 0384), with
#                                         the runtime in directory RT when given
#   ail run compiler build FILE RT [TARGET [MS [MB [STD]]]]
#                                         an executable of a program as hex text, with the runtime
#                                         in directory RT, for x86_64-linux (the default) or
#                                         aarch64-linux or aarch64-macos (ADRs 0385, 0388, 0389;
#                                         `ail build`)
#   ail run compiler load FILE...         the program of `ail api --ast --program FILE` (ADR 0855)
#   ail run compiler check-program [--json] FILE|DIR   `ail check` (ADR 0855)
#   ail run compiler api [--outline] FILE [--text | --pretty]   `ail api` (ADR 0855)
#   ail run compiler run FILE [ARGS...]   the native CLI's `ail run` (ADR 0855)
#   ail run compiler prepare FILE         builds FILE into the cache and prints the executable's path
#   ail run compiler build-many RT TARGET MS MB STD FILE...
#                                         the same for several programs in one run (ADR 0814,
#                                         used by the selftest), each under a line `== PATH`
# With several files, each output starts with a line `== PATH`.
use a64
use api
use ast
use attachcli
use budget
use cheader
use check
use doc
use edit
use fix
use fmt
use help
use derive
use doctor
use explain
use load
use mir
use obj
use pkg
use scaffold
use syntax
use watch
use x64

fn main() !
    args := env.args()
    # tool.new.1: a bare `new` gets the `new` usage line, not the compiler's.
    # tool.help.1-3: `help`, `--help`, `-h` and no command at all are the command list; `CMD --help` is `help CMD`.
    if args.len() == 0
        io.exit(help.command([]))
    if args[0] == "help" or args[0] == "--help" or args[0] == "-h"
        io.exit(help.command(args[1..]))
    if args.len() >= 2 and (args[1] == "--help" or args[1] == "-h") and not args[0].starts_with("-")
        io.exit(help.command([args[0]]))
    # tool.doctor.1: `doctor` needs the toolchain root, the cache directory and the host's target.
    if args[0] == "doctor"
        io.exit(doctor.command(
            args[1..],
            env.get("AIL_ROOT") else path.dir(compiler_dir()),
            cache_dir(),
            host_target(),
        ))
    if args.len() == 1 and args[0] == "new"
        io.exit(scaffold.command([]))
    if args.len() == 1 and args[0] == "card"
        io.exit(api.card_topic_command([]))
    if args.len() == 0
        or (args.len() < 2 and args[0] != "explain" and args[0] != "diff" and args[0] != "attach")
        io.eprint("usage: ail run compiler (check PROGRAM.json... | tokens FILE... | parse FILE... | mir FILE | build FILE RT)")
        io.exit(2)
    match args[0]
        "check" =>
            for path in args[1..]
                check_dump(path, args.len() > 2)?
        "fix" =>
            io.exit(load.fix_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "fmt" =>
            io.exit(fmt.command(args[1..]))
        "edit" =>
            io.exit(edit.command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "budget" =>
            # `budget [COMMAND] [--budget [N]] [--from K] [--json] -- EXE ARGS...`: EXE under a budget (budget.out.1-7); COMMAND picks the default (budget.out.5).
            cut := args.index_of("--") else args.len()
            mut opts := args[1..cut]
            json := opts.contains("--json")
            taken := budget.take(mut opts)
            if taken.why != ""
                io.eprint("error: {taken.why}")
                io.exit(2)
            if not taken.found or cut + 1 >= args.len()
                io.eprint("usage: compiler budget --budget [N] [--from K] [--json] -- EXE ARGS...")
                io.exit(2)
            io.exit(budget.run(taken.budget, args[cut + 1], args[cut + 2..], json))
        "docs" =>
            # The doc comment attached to each line, as `LINE: text` (api.doc.1).
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                docs := doc.by_line(fs.read_text(path)?)
                for line in docs.keys().sorted()
                    print("{line}: {syntax.quote(docs[line])}")
        "doctests" =>
            # The doc examples of each file as tests (test.doc.1-3): one line per example,
            # then the source with them appended.
            for path in args[1..]
                text := fs.read_text(path)?
                lexed := syntax.lex(text)
                prog := syntax.parse(lexed.tokens).program
                tests := doc.collect(text, prog)
                if args.len() > 2
                    print("== {path}")
                for t in tests
                    print("{t.name} {t.fn_name} fence={t.fence} lines={[ "{n}" for n in doc.expected_lines(t) ].join(",")} expected=[{t.expected.join(", ")}]")
                aug := doc.augment(text, tests)
                print(aug.text)
                print(aug.origin)
        "explain" =>
            io.exit(explain.command(args[1..]))
        "perf" =>
            io.exit(perf_command(args[1..]))
        "new" =>
            io.exit(scaffold.command(args[1..]))
        "tokens" =>
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                print(syntax.tokens_text(syntax.lex(fs.read_text(path)?)))
        "diagnose" =>
            for path in args[1..]
                text := fs.read_text(path)?
                lexed := syntax.lex(text)
                mut diags := lexed.diags
                diags.extend(syntax.parse(lexed.tokens).diags)
                report := syntax.report_text(path, text, diags)
                if report.len() > 0
                    if args.len() > 2
                        print("== {path}")
                    print(report)
        "parse" =>
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                lexed := syntax.lex(fs.read_text(path)?)
                print(syntax.ast_text(lexed, syntax.parse(lexed.tokens)))
        "mir" =>
            if args.len() > 2
                print(mir.module_text(lower_file(args[1], runtime(args[2], args[1])?, "")?))
            else
                print(mir.module_text(lower_file(args[1], none, "")?))
        "pe-mir-sample" =>
            print(obj.hex(obj.pe_image(x64.generate_windows(x64.win_sample()))))
        "pe-sample" =>
            print(obj.hex(obj.pe_sample()))
        "load" =>
            load_dump(args[1..])
        "check-program" =>
            check_cmd(args[1..])
        "pkg" =>
            io.exit(pkg.command(args[1..]))
        "header" =>
            io.exit(load.header_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "effects" =>
            io.exit(load.effects_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "prove" =>
            io.exit(load.prove_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "check-errors" =>
            io.exit(api.errors_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "api" =>
            api_cmd(args[1..])
        "diff" =>
            io.exit(api.semantic_diff_command(args[1..], path.join(
                path.dir(compiler_dir()),
                "std",
            )))
        "attach" =>
            io.exit(attachcli.command(args[1..]))
        "ask" =>
            io.exit(api.ask_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "card" =>
            io.exit(api.card_topic_command(args[1..]))
        "context" =>
            io.exit(api.context_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "review" =>
            io.exit(api.review_command(args[1..], path.join(path.dir(compiler_dir()), "std")))
        "run" =>
            cli_run(args[1..])
        "prepare" =>
            cli_prepare_cmd(args[1..])
        "build" =>
            # `build FILE [-o OUT] ...` is `ail build` itself; the
            # positional form below is what the bootstrap calls.
            if args.len() == 2 or args[1].starts_with("-") or args[2].starts_with("-")
                build_cli(args[1..])
                return
            # Optional defaults for the run limits (run.limit.5): `0` for none.
            ms := if args.len() > 4 then args[4] else "0"
            mb := if args.len() > 5 then args[5] else "0"
            std := if args.len() > 6 then args[6] else ""
            m := lower_file(args[1], runtime_with(args[2], args[1], ms, mb)?, std)?
            target := if args.len() > 3 then args[3] else "x86_64-linux"
            print(executable_hex(m, args[1], target))
        "build-many" =>
            # ADR 0814: `build-many RT TARGET MS MB STD FILE...` builds several programs in
            # one run, so the compiler loads and checks once. Each executable is printed
            # as `== PATH` and its hex, as `build` prints it; the first problem ends the
            # run, and the caller then builds each file on its own to report per file.
            # The limits (run.limit.5) are the same for all; the runtime is chosen per program
            # (a program that spawns tasks links the task runtime).
            for path in args[6..]
                print("== {path}")
                rt := runtime_with(args[1], path, args[3], args[4])?
                print(executable_hex(lower_file(path, rt, args[5])?, path, args[2]))
        _ =>
            io.eprint("unknown command {args[0]}")
            io.exit(2)

PERF_USAGE := "usage: ail perf --explain FN FILE"

## One remark line of `ail perf --explain`, as the lowering leaves it in `Module.notes`.
struct PerfLine
    path str
    line int
    kind str
    text str

## `ail perf --explain FN FILE` (tool.perf.1-2, ADR 1021): for each loop of `FN`, whether
## its bounds checks were removed, whether it runs in a vector kernel, whether the checker
## finds its iterations independent, and which calls stay in it, each with the rule and,
## where one exists, a fix. The `ail` launcher sets `AIL_PERF_EXPLAIN=FN` and checks FILE
## first; the exit status is 0, or 2 for a bad call or a function that isn't there.
fn perf_command(rest List[str]) int
    bad := rest.len() != 3 or rest[0] != "--explain"
    if bad or rest[1].starts_with("-") or rest[2].starts_with("-")
        io.eprint(PERF_USAGE)
        return 2
    fname := rest[1]
    file := rest[2]
    if (env.get("AIL_PERF_EXPLAIN") else "") != fname
        io.eprint("error[tool.perf.1]: start it as `ail perf --explain FN FILE`")
        return 2
    dir := compiler_dir()
    std := path.join(path.dir(dir), "std")
    rt := runtime_with(path.join(dir, "rt/native"), file, "0", "0") else err
        io.eprint("error[native.build.3]: can't read the runtime: {err}")
        return 2
    m := lower_file(file, rt, std) else err
        io.eprint("error[native.build.3]: {err}")
        return 1
    loaded := load.load(file, std) else err
        io.eprint("error: {err.message}")
        return 2
    mut names := List[str]()
    for f in m.funcs
        if not f.name.starts_with("rt.") and mir.rk_matches(f.name, fname)
            names.push(f.name)
    if names.is_empty()
        known := [f.name for f in m.funcs if not f.name.starts_with("rt.")]
        io.eprint("error[tool.perf.1]: no function `{fname}` in {file}; functions: {known.sorted().join(", ")}")
        return 2
    mut found := List[PerfLine]()
    for note in m.notes
        cut := note.split("\t")
        if cut.len() == 5 and cut[0] == "perf"
            at := cut[2].to_int() else 0
            found.push(PerfLine(path: cut[1], line: at, kind: cut[3], text: cut[4]))
    all_rows := check.parallel_rows(loaded.program)
    rows := [r for r in all_rows if r.func == "fn:{fname}" or r.func == "method:{fname}"]
    print("perf {fname} ({file})")
    for l in found
        if l.kind == "func"
            print("  {l.text}")
    starts := [l for l in found if l.kind == "loop"].sorted(by: |l| l.line)
    if starts.is_empty()
        print("  no loops")
        return 0
    for s in starts
        print("{s.path}:{s.line} loop ({s.text})")
        for l in found
            if l.path == s.path and l.line == s.line and l.kind == "bce"
                print("  bounds checks: {l.text}")
            elif l.path == s.path and l.line == s.line and l.kind == "fix"
                print("    fix: {l.text}")
            elif l.path == s.path and l.line == s.line and l.kind == "hoist"
                print("  list headers: {l.text}")
        for l in found
            if l.path == s.path and l.line == s.line and l.kind == "vec"
                print("  vectorised: {l.text}")
        for r in rows
            if r.pos.line == s.line
                print("  parallel: {perf_par(r)}")
        for l in found
            if l.path == s.path and l.line == s.line and l.kind == "inline"
                print("  calls: {l.text}")
    0

## The words for one loop's verdict from the checker (conc.par.6).
fn perf_par(r check.ParRow) str
    if r.verdict == "sequential"
        return "no, {r.reason} ({r.rule})"
    if r.is_par
        return "yes, written `par for` ({r.rule})"
    "yes, the iterations are independent; the loop goes to the pool when it is big enough ({r.rule}, conc.par.8)"

BUILD_USAGE := "usage: ail build FILE [-o OUT] [--target x86_64-linux|aarch64-linux|aarch64-macos|x86_64-windows|aarch64-windows (experimental, unverified)] [--no-cache] [--attach] [--timeout MS] [--max-memory MB]"

## A positive whole number (run.limit.4).
fn positive(v str) bool
    n := v.to_int() else return false
    n > 0

## `p` with `/` for each `\\` on Windows, where the compiler splits paths on
## `/` and the shell hands it backslashes.
fn fwd(p str) str
    if (env.get("OS") else "") == "Windows_NT"
        return p.replace("\\", "/")
    p

## The target `ail build` makes by default: the host's, from `uname`.
fn host_target() str
    # Windows sets `OS`; it has no `uname`.
    if (env.get("OS") else "") == "Windows_NT"
        if (env.get("PROCESSOR_ARCHITECTURE") else "").to_lower() == "arm64"
            return "aarch64-windows"
        return "x86_64-windows"
    out := proc.run("uname", ["-sm"]) else
        return "x86_64-linux"
    match out.out.trim()
        "Darwin arm64" => "aarch64-macos"
        "Linux aarch64" | "Linux arm64" => "aarch64-linux"
        _ => "x86_64-linux"

## `ail build FILE [-o OUT] [--target T] [--timeout MS] [--max-memory MB]
## [--no-cache]` (native.build.3), the bootstrap's command line: the checked
## program's executable, written to OUT (by default FILE's name in the
## current directory). The repository is `AIL_COMPILER`, the `compiler/`
## directory, or `AIL_ROOT`, the directory holding it. `ail` runs `ail check` first.
fn build_cli(rest List[str])
    mut file := ""
    mut out := ""
    mut target := ""
    mut ms := "0"
    mut mb := "0"
    mut cached := true
    mut attach := false
    mut i := 0
    while i < rest.len()
        a := rest[i]
        has := i + 1 < rest.len()
        if a == "-o" and has
            out = rest[i + 1]
            i += 1
        elif a == "--target" and has
            target = rest[i + 1]
            i += 1
        elif a == "--timeout" and has and positive(rest[i + 1])
            ms = rest[i + 1]
            i += 1
        elif a == "--max-memory" and has and positive(rest[i + 1])
            mb = rest[i + 1]
            i += 1
        elif a == "--unsafe" and has and rest[i + 1] == "driver"
            # unsafe.hw.1: the checker, run first, took it; the lowering needs nothing.
            i += 1
        elif a == "--no-cache"
            cached = false
        elif a == "--attach"
            attach = true
        elif file == "" and not a.starts_with("-")
            file = a
        else
            io.eprint(BUILD_USAGE)
            io.exit(2)
        i += 1
    if file == ""
        io.eprint(BUILD_USAGE)
        io.exit(2)
    if cached
        compile_to(file, out, target, ms, mb, attach)
    else
        compile_fresh(
            file,
            if out == "" then path.stem(file) else out,
            if target == "" then host_target() else target,
            ms,
            mb,
            attach,
        )

## The `compiler/` directory: `AIL_COMPILER`, or `compiler` under `AIL_ROOT`.
fn compiler_dir() str
    dir := env.get("AIL_COMPILER") else ""
    if dir != ""
        return dir
    root := env.get("AIL_ROOT") else
        io.eprint("error[native.build.3]: can't find the native backend's `compiler/` directory; set AIL_COMPILER")
        io.exit(2)
        ""
    path.join(root, "compiler")

## Build `file` for `target` (the host's when empty) into `out` (by default
## the file's name in the current directory) with the run limits `ms` and `mb`.
fn compile_to(file str, out_arg str, target_arg str, ms str, mb str, attach bool)
    target := if target_arg == "" then host_target() else target_arg
    out := if out_arg == "" then path.stem(file) else out_arg
    dir := cache_dir()
    exe := path.join(dir, "{cache_key(file, target, ms, mb, attach)}{exe_ext(target)}")
    if cached_copy(exe, out, target)
        return
    fs.make_dir(dir) else err
        io.eprint("error[native.build.5]: can't make {dir}")
    cache_store(file, exe, target, ms, mb, attach)
    cache_trim(dir)
    if not cached_copy(exe, out, target)
        io.eprint("error[native.build.5]: can't write {out}")
        io.exit(2)

## Build `file` into the cache entry `exe`. The build goes to a temporary
## name only this process uses, then is renamed into place, so `ail`
## processes building the same program at once never share a file; when the
## rename fails because another one stored the entry first, that entry is
## the same build (the key names its inputs) and is used (native.build.5).
fn cache_store(file str, exe str, target str, ms str, mb str, attach bool)
    tag := crypto.random_bytes(8).hex()
    tmp := "{exe}.{time.now_ms()}-{tag}.tmp"
    compile_fresh(file, tmp, target, ms, mb, attach)
    fs.rename(tmp, exe) else err
        if not fs.exists(exe)
            io.eprint("error[native.build.5]: can't store {exe}")
            io.exit(2)
        fs.remove(tmp) else e2
            return

## Copy the cached executable `exe` to `out`; false when there is none
## (native.build.5).
fn cached_copy(exe str, out str, target str) bool
    data := fs.read_bytes(exe) else return false
    fs.write_bytes(out, data) else return false
    if not target.ends_with("windows")
        fs.set_mode(out, 493) else return false
    true

## `compile_to` without the cache.
fn compile_fresh(file str, out str, target str, ms str, mb str, attach bool)
    dir := compiler_dir()
    rt := runtime_with(path.join(dir, "rt/native"), file, ms, mb) else err
        io.eprint("error[native.build.3]: can't read the runtime: {err}")
        io.exit(2)
        return
    std := path.join(path.dir(dir), "std")
    over := if attach then watch.shim(fs.read_text(file) else "") else ""
    if over != ""
        # A shim that doesn't build leaves the program as written, with a warning.
        shimmed := lower_file_with(file, rt, std, over) else shim_err
            io.eprint("warning[attach.run.2]: attach is off for this run: {shim_err}")
            compile_fresh(file, out, target, ms, mb, false)
            return
        finish_build(shimmed, file, out, target)
        return
    m := lower_file(file, rt, std) else err
        io.eprint("error[native.build.3]: {err}")
        io.exit(1)
        return
    finish_build(m, file, out, target)

## The executable of `m` for `target`, written to `out`.
fn finish_build(m mir.Module, file str, out str, target str)
    exe := executable_bytes(m, file, target)
    fs.write_bytes(out, exe) else err
        io.eprint("error[native.build.3]: can't write {out}: {err}")
        io.exit(2)
        return
    if not target.ends_with("windows")
        fs.set_mode(out, 493) else err
            io.eprint("error[native.build.3]: can't make {out} executable: {err}")
            io.exit(2)

## The checker's diagnostics for one dump, sorted by position as `ail check`
## reports them. With several dumps, each starts with `== PATH` and ends
## with what the checker covers (`rules ...`, `skip FILE FIRST LAST`).
fn check_dump(path str, many bool) !
    text := fs.read_text(path)?
    first := text.lines().first() else ""
    prog := ast.Program.from_json(parse_json(first)?)?
    report := check.check_program(prog)
    diags := report.diags.sorted(by: |d| d.pos.line * 100000 + d.pos.col)
    if many
        print("== {path}")
    mut sources := Map[str, List[List[char]]]()
    for f in prog.files
        if f.base < 1073741824
            src := fs.read_text(f.path) else ""
            if src != ""
                sources[f.path] = fix.split_lines(src)
    for d in diags
        print(d.to_json(prog.files, sources))
    if many
        print("rules {check.COVERED_RULES.join(" ")}")
        for s in check.skipped(prog, report)
            print("skip {s.file} {s.first} {s.last}")
        bodies := [
            i
            for i in 0..prog.fns.len() if prog.fns[i].body != none
                and prog.fns[i].pos.line < 1073741824
        ]
        print("bodies {[i for i in bodies if not report.gapped.contains(i)].len()} {bodies.len()}")

## The native runtime in directory `dir`, parsed as one program.
fn runtime(dir str, path str) !ast.Program
    runtime_with(dir, path, "0", "0")

## The runtime with `ail build`'s default time limit in milliseconds and
## memory limit in megabytes baked into `limits.ail` (run.limit.5). The task
## runtime links only into a program that may use tasks (ADR 0599).
fn runtime_with(dir str, path str, ms str, mb str) !ast.Program
    mut texts := List[str]()
    src := imported_text(path, source_text(path)?, "{dir}/../../../std")
    # `std.ui` is written over `std.app`, so it needs the task runtime (ADR 0863).
    # A loop the pool may take (conc.par.8) needs it, and only then.
    tasks := mir.uses_tasks(src) or mentions_ui(src) or parallel_on() and par_keys(
        path,
        "{dir}/../../../std",
        src.len(),
    ).len() > 0
    skip := if tasks then "notask.ail" else "task.ail"
    # Every `.ail` file of the directory, so lanes add runtime files
    # without editing this list; `prim`, `core` and `math` come first.
    mut names := ["prim.ail", "core.ail", "math.ail"]
    for name in fs.list_dir(dir)?.sorted()
        # The deterministic scheduler links with the task runtime (sched.ail).
        if name == "sched.ail" and not tasks
            continue
        if name.ends_with(".ail") and not names.contains(name) and name != skip
            names.push(name)
    for name in names
        text := fs.read_text("{dir}/{name}")?
        texts.push(text.replace("0 # BAKED_TIMEOUT_MS", ms).replace("0 # BAKED_MEMORY_MB", mb))
        # A runtime file with a syntax error fails the build with the error
        # shown, instead of compiling whatever the parser recovered to
        # (a `&` once dropped the rest of its statement silently).
        runtime_syntax("{dir}/{name}", text)
    # A baked time limit also makes `while` loops check it (run.limit.6).
    if ms != "0"
        texts.push("fn lim_loop_polls() bool\n    true\n")
    syntax.parse(syntax.lex(texts.join("\n")).tokens).program

## The text of a program: a file, or all the files of a package directory.
fn source_text(path str) !str
    if path.ends_with(".ail")
        return fs.read_text(path)?
    mut texts := List[str]()
    for name in fs.list_dir(path)?.sorted()
        if name.ends_with(".ail")
            texts.push(fs.read_text("{path}/{name}")?)
    texts.join("\n")

## `text` (the program's own source) followed by the text of every module it
## imports, transitively, so the runtime choice sees a task or a channel in a
## module as well as in the main file. A module that can't be read is skipped
## (the build reports it).
fn imported_text(file_arg str, text str, std str) str
    file := fwd(file_arg)
    mut root := "."
    if file.ends_with(".ail")
        cut := file.split("/")
        root = if cut.len() > 1 then cut[..cut.len() - 1].join("/") else "."
    else
        root = file
    mut all := [text]
    mut seen := Set[str]()
    mut queue := [text]
    mut k := 0
    while k < queue.len()
        for line in queue[k].split("\n")
            if not line.starts_with("use ")
                continue
            imp := line.slice(4, line.len()).trim().split(" ")[0]
            if seen.contains(imp)
                continue
            seen.add(imp)
            mut got := ""
            if imp.starts_with("std.")
                got = fs.read_text(std_file(std, imp)) else ""
            else
                dir := "{root}/{imp.replace(".", "/")}"
                for name in fs.list_dir(dir) else []
                    if name.ends_with(".ail")
                        got = "{got}\n{fs.read_text("{dir}/{name}") else ""}"
            if got != ""
                all.push(got)
                queue.push(got)
        k += 1
    all.join("\n")

## The executable of lowered program `m` for `target` as hex text (native.build.3).
## `path` names the program: the macOS target takes its name from it.
fn executable_hex(m mir.Module, path str, target str) str
    obj.hex(executable_list(m, path, target))

## The same executable as bytes. This goes through hex text on purpose: the
## seed's lowering keeps a `List[u8]` one word an element (ADR 0907), so the
## stage-1 compiler can't hand one to the runtime's `bytes.from_list`.
fn executable_bytes(m mir.Module, path str, target str) bytes
    hex := executable_hex(m, path, target)
    exe := bytes.from_hex(hex.replace("\n", "")) else
        io.eprint("error[native.build.3]: the native backend produced something other than hexadecimal")
        io.exit(2)
        return b""
    exe

fn executable_list(m mir.Module, path str, target str) List[u8]
    match target
        "x86_64-linux" => obj.elf(x64.generate(m), obj.X86_64)
        "aarch64-linux" => obj.elf(a64.generate(m, a64.LINUX), obj.AARCH64)
        "x86_64-windows" => obj.pe_image(x64.generate_windows(m))
        "aarch64-windows" => obj.pe_image_for(a64.generate(m, a64.WINDOWS), obj.PE_ARM64)
        "aarch64-macos" =>
            name := path.split("/").last() else path
            obj.macho(a64.generate(m, a64.MACOS), name.replace(".ail", ""))
        _ =>
            io.eprint("error[native.build.3]: unknown target `{target}`")
            io.exit(2)
            []

## The lexer's and the parser's diagnostics for one runtime file; any ends the run.
fn runtime_syntax(path str, text str)
    lexed := syntax.lex(text)
    parsed := syntax.parse(lexed.tokens)
    mut diags := lexed.diags
    diags.extend(parsed.diags)
    if diags.len() > 0
        for d in diags
            io.eprint("{path}:{d.pos.line}:{d.pos.col}: error[{d.rule}]: {d.msg}")
        io.exit(1)

## Parse a program and the modules it imports, and lower them to MIR
## (mod.unit.3-5, ADR 0393). `path` is a file, the root module by itself,
## or a package directory whose files form the root module. Problems
## outside the native subset are printed as `ail check` prints
## diagnostics, and the run fails.
fn lower_file(path str, rt ast.Program?, std str) !mir.Module
    lower_file_with(path, rt, std, "")

## `lower_file` with the root file's text given when `over` isn't empty (the
## attach shim).
fn lower_file_with(path_arg str, rt ast.Program?, std str, over str) !mir.Module
    path := fwd(path_arg)
    mut srcs := List[mir.Source]()
    mut root := path
    if path.ends_with(".ail")
        cut := path.split("/")
        root = if cut.len() > 1 then cut[..cut.len() - 1].join("/") else "."
        if over != ""
            mut names := prelude_generic_names()
            for n in syntax.generic_names(syntax.lex(over).tokens).sorted()
                names.add(n)
            srcs.push(parse_with("", path, over, names))
        else
            srcs.push(parse_source("", path)?)
    else
        mut files := List[str]()
        for name in fs.list_dir(path)?.sorted()
            if name.ends_with(".ail")
                files.push("{path}/{name}")
        srcs.extend(parse_module("", files)?)
    mut loaded := Set[str]()
    # Packages (mod.pkg.1-6): a dependency's modules load under its name and
    # resolve their imports against its own root and manifest (mod.pkg.3).
    packages := pkg.read(root)
    mut k := 0
    while k < srcs.len()
        # std.use.4: the standard modules in AIL the file names without `use`,
        # as `ail check` loads them (load/stduse.ail).
        if std != "" and not srcs[k].module.starts_with("std.") and load.may_name_std(srcs[k].text)
            rows := load.std_mentions(syntax.lex(srcs[k].text).tokens, std)
            wanted := load.keep_implicit(
                load.implicit_uses(rows, 1),
                srcs[k].prog.uses,
                load.FILE_LINES,
            )
            srcs[k].prog.uses.extend(wanted)
        for ui in 0..srcs[k].prog.uses.len()
            u := srcs[k].prog.uses[ui]
            parts := [i.name for i in u.path]
            if parts.len() == 0
                continue
            imp := parts.join(".")
            if cheader.is_use(parts)
                # `use c "header.h" as name` (ffi.decl.1, ADR 0926): the module is written from the header.
                if loaded.contains(imp)
                    continue
                loaded.add(imp)
                if text := cheader.module_for(cheader.header_of(imp), cheader.dir_of(srcs[k].path))
                    srcs.push(parse_text(imp, "<{imp}>", text))
                continue
            if parts[0] == "std"
                if loaded.contains(imp)
                    continue
                loaded.add(imp)
                # A standard module in AIL: one file under the std directory.
                if std != "" and mir.STD_AIL.contains(imp)
                    srcs.push(parse_source(imp, std_file(std, imp))?)
                continue
            t := packages.target(srcs[k].module, parts)
            if t.undeclared
                continue
            if loaded.contains(t.module)
                continue
            loaded.add(t.module)
            mut files := List[str]()
            for name in fs.list_dir(t.dir)?.sorted()
                if name.ends_with(".ail")
                    files.push("{t.dir}/{name}")
            srcs.extend(parse_module(t.module, files)?)
        k += 1
    # A generic type of another module starts type arguments after `m.Name`
    # (gen.infer.2): parse again the files that name one, knowing every
    # module's generic names.
    mut generics := Set[str]()
    for src in srcs
        for n in syntax.generic_names(syntax.lex(src.text).tokens).sorted()
            generics.add(n)
    for i in 0..srcs.len()
        if srcs[i].path != "<prelude>" and [
            n
            for n in generics.sorted() if srcs[i].text.contains(".{n}[")
        ].len() > 0
            # The implicit imports (std.use.4) are not in the text: keep them.
            kept_uses := [u for u in srcs[i].prog.uses if load.is_implicit_use(u)]
            srcs[i] = parse_with(srcs[i].module, srcs[i].path, srcs[i].text, generics)
            srcs[i].prog.uses.extend(kept_uses)
    # Imports name modules by their place in the program (`shapes` in package
    # `geo` is `geo.shapes`), keeping the name the file uses for them.
    for i in 0..srcs.len()
        for ui in 0..srcs[i].prog.uses.len()
            u := srcs[i].prog.uses[ui]
            parts := [x.name for x in u.path]
            if parts.len() == 0 or parts[0] == "std" or cheader.is_use(parts)
                continue
            t := packages.target(srcs[i].module, parts)
            if t.module == parts.join(".") or t.undeclared
                continue
            mut alias := ast.Ident(name: parts[parts.len() - 1], pos: u.pos)
            if given := u.alias
                alias = given
            srcs[i].prog.uses[ui] = ast.Use(
                path: [ast.Ident(name: n, pos: u.pos) for n in t.module.split(".")],
                alias: alias,
                pos: u.pos,
            )
    srcs.extend(derive_builtin(srcs))
    srcs.extend(derive_user(srcs, rt, std))
    lazy := srcs.len()
    # The prelude's JSON, `Default` and `Seq` modules come from the embedded
    # copy, for the programs that name them (json.prelude.1, ADR 0808, ADR 1073).
    if mentions_prelude(srcs)
        srcs.push(parse_text("", "<prelude>", mir.prelude_text_for(mir.PRELUDE_EMBED, srcs)))
    # The proof checks the whole program once more, so a program over about
    # 60k lines keeps its loops in order (ADR 0911).
    mut size := 0
    for src in srcs
        size += src.text.len()
    pooled := par_keys(path, std, size)
    m := mir.lower_package_par(srcs, rt, lazy, pooled) else err
        for i in 0..err.items.len()
            p := err.items[i]
            io.eprint("{err.files[i]}:{p.pos.line}:{p.pos.col}: error[{p.rule}]: {p.message}")
            if p.rule == "native.subset.1"
                hint := mir.subset_help(p.message)
                if hint != ""
                    io.eprint("help: {hint}")
        io.exit(1)
        return mir.Module(
            path: path,
            funcs: [],
            strs: [],
            sites: [],
            lines: [],
            files: [],
            file_lines: [],
            notes: [],
        )
    for note in m.notes
        # `ail perf --explain` reads its own lines (tool.perf.1).
        if not note.starts_with("perf\t")
            io.eprint(note)
    m

## Source bytes past which the loop proof is skipped (ADR 0911).
PROOF_MAX_BYTES := 1500000

## The proven loops of the program, none when it is too big to check again
## (ADR 0911).
fn par_keys(file str, std str, size int) Set[str]
    if size > PROOF_MAX_BYTES
        return Set[str]()
    proven_loop_keys(file, std)

## Whether the independent loops may go to the pool (conc.par.8): by default,
## unless `AIL_PARALLEL=0`; `--deterministic` keeps every loop on one thread
## (conc.par.9).
fn parallel_on() bool
    off := env.get("AIL_PARALLEL") else ""
    det := env.get("AIL_DETERMINISTIC") else ""
    off != "0" and det == ""

## The `file:line:col` of every loop of the program that `conc.par.2-4`
## prove independent, when `--parallel` is on.
fn proven_loop_keys(file str, std str) Set[str]
    mut keys := Set[str]()
    if not parallel_on()
        return keys
    loaded := load.load(file, std) else return keys
    if loaded.diags.len() > 0
        return keys
    sites := check.par_sites(loaded.program)
    for at in sites.loops
        found := load.locate(loaded.program.files, at)
        keys.add("{found.0}:{found.1.line}:{found.1.col}")
    for site in sites.forks
        found := load.locate(loaded.program.files, site.pos)
        keys.add("{found.0}:{found.1.line}:{found.1.col}#{site.mark}")
    keys

## Whether a source names a module of the prelude written in AIL: the test
## `ail build` makes before it adds the embedded prelude.
fn mentions_prelude(srcs List[mir.Source]) bool
    for s in srcs
        if s.text.contains("json")
            or s.text.contains("Json")
            or s.text.contains("Default")
            or s.text.contains("Grid")
            or s.text.contains("Seq")
            or s.text.contains("Heap")
            or s.text.contains("Deque")
            return true
        # A derive generator reads a `TypeInfo` (refl.info.1).
        if s.text.contains("@derive")
            or s.text.contains("TypeInfo")
            or s.text.contains("FieldInfo")
            or s.text.contains("VariantInfo")
            or s.text.contains("DeriveError")
            or s.text.contains("FromArgs")
            return true
    false

## The file of standard module `imp` (`std.csv`, `std.net.http`) under `std`.
fn std_file(std str, imp str) str
    parts := imp.split(".")[1..]
    if parts.len() == 1
        return "{std}/{parts[0]}/{parts[0]}.ail"
    "{std}/{parts.join("/")}.ail"

## The methods of the `impl`s the built-in generators derive (ADR 0850),
## each as a source of its module.
fn derive_builtin(srcs List[mir.Source]) List[mir.Source]
    mut have := Set[str]()
    for s in srcs
        have.add(s.path)
    mut out := List[mir.Source]()
    for e in derive.expand([s.module for s in srcs], documented(srcs))
        if have.contains("gen:impl:{e.label}")
            continue
        if e.problem != ""
            io.eprint("{srcs[e.file].path}:{e.pos.line}:{e.pos.col}: error[ct.derive.4]: {derive_failure(e.label)}: {e.problem}")
            io.exit(1)
        out.push(derived_source(
            if e.module == "" then "-" else e.module,
            e.label,
            derive.tidy(e.text).lines(),
        ))
    out

## The methods of the `impl`s of traits with a user-written `@derive(f)`
## generator (ct.derive.1-4, ADR 0856), each as a source of its module. The
## generators are the program's own code, so they run as a program of their
## own: the sources, with every function quiet except the generator calls
## (the program may call methods that don't exist yet), built for the host
## and run; each generator's text comes back on its standard output.
fn derive_user(srcs List[mir.Source], rt ast.Program?, std str) List[mir.Source]
    mut have := Set[str]()
    for s in srcs
        have.add(s.path)
    mut jobs := List[derive.Job]()
    for j in derive.user_jobs([s.module for s in srcs], documented(srcs))
        if not have.contains("gen:impl:{j.label}")
            jobs.push(j)
    if jobs.len() == 0
        return []
    texts := run_generators(srcs, jobs, rt, false)
    mut out := List[mir.Source]()
    for k in 0..jobs.len()
        j := jobs[k]
        if texts[k].starts_with("@@err ")
            io.eprint("{srcs[j.file].path}:{j.pos.line}:{j.pos.col}: error[ct.derive.4]: {derive_failure(j.label)}: {texts[k].slice(6, texts[k].len())}")
            io.exit(1)
        out.push(derived_source(
            if j.module == "" then "-" else j.module,
            j.label,
            derive.tidy(texts[k]).lines(),
        ))
    out

## The text each job's generator wrote, in order, or `@@err MESSAGE`.
fn run_generators(
    srcs List[mir.Source],
    jobs List[derive.Job],
    rt ast.Program?,
    quiet bool,
) List[str]
    mut calls := List[str]()
    mut by_module := Map[str, List[str]]()
    for k in 0..jobs.len()
        j := jobs[k]
        calls.push("    run_job_{k}()")
        mut fns := by_module.get(j.trait_module) else []
        fns.push("pub fn derive_job_{k}() str ! DeriveError\n    {j.generator}({j.info})?\n")
        by_module[j.trait_module] = fns
    mut head := List[str]()
    for k in 0..jobs.len()
        alias := if jobs[k].trait_module
            == "" then "" else "{jobs[k].trait_module.split(".").last() else ""}."
        head.push("fn run_job_{k}()\n    print(\"@@job {k}\")\n    t := {alias}derive_job_{k}() else err\n        print(\"@@err \{err.message}\")\n        print(\"@@end\")\n        return\n    print(t)\n    print(\"@@end\")\n")
    mut gen := List[mir.Source]()
    mut uses := List[str]()
    for m in by_module.keys().sorted()
        text := by_module[m].join("\n")
        if m == ""
            head.push(text)
        else
            gen.push(parse_text(m, "gen:derive", text))
            uses.push("use {m}\n")
    head.push("fn main()\n{calls.join("\n")}\n")
    mut all := [parse_text("", "gen:derive:main", "{uses.join("")}{head.join("\n")}")]
    all.extend(gen)
    from := all.len()
    for s in srcs
        all.push(user_main_renamed(s))
    mut prelude := mir.prelude_text_for(mir.PRELUDE_EMBED, srcs)
    all.push(parse_text("", "<prelude>", prelude))
    m := mir.lower_package_with(all, rt, from) else err
        if quiet
            # `ail check` reports the generators' own problems itself.
            return []
        for i in 0..err.items.len()
            p := err.items[i]
            io.eprint("{err.files[i]}:{p.pos.line}:{p.pos.col}: error[{p.rule}]: {p.message}")
        io.exit(1)
        return []
    exe := executable_bytes(m, "derive", host_target())
    tmp := env.get("TMPDIR") else "/tmp"
    ext := exe_ext(host_target())
    file := "{tmp}/ail-derive-{time.now_ms()}{ext}"
    fs.write_bytes(file, exe) else err
        io.eprint("error[native.build.3]: can't write {file}: {err}")
        io.exit(2)
        return []
    if ext.is_empty()
        fs.set_mode(file, 493) else err
            io.eprint("error[native.build.3]: can't run the generators: {err}")
            io.exit(2)
            return []
    ran := proc.run(file, []) else err
        remove_quietly(file)
        io.eprint("error[native.build.3]: can't run the generators: {err}")
        io.exit(2)
        return []
    remove_quietly(file)
    if ran.status != 0
        io.eprint("error[ct.derive.4]: a derive generator stopped unexpectedly: {ran.err.trim()}")
        io.exit(1)
    mut texts := List[str]()
    for part in ran.out.split("@@end\n")
        if part.starts_with("@@job ")
            body := part.lines()[1..].join("\n")
            texts.push(body)
    texts

## The sources' programs with their `##` docs, which a generator reads in
## `FieldInfo.doc` (refl.info.1, ct.derive.5).
fn documented(srcs List[mir.Source]) List[ast.Program]
    [doc.attach(s.prog, s.text) for s in srcs]

## "`Trait` can't be derived for `Type`" for the label `Type.Trait`.
fn derive_failure(label str) str
    parts := label.split(".")
    "`{parts.last() else ""}` can't be derived for `{parts[0]}`"

fn remove_quietly(path str)
    fs.remove(path) else err
        io.eprint("warning: can't remove {path}: {err}")

## `s` with its function `main` of the root module renamed, so the generator
## program has a `main` of its own.
fn user_main_renamed(s mir.Source) mir.Source
    if s.module != ""
        return s
    mut prog := s.prog
    for i in 0..prog.fns.len()
        if prog.fns[i].name == "main" and prog.fns[i].owner == none
            prog.fns[i].name = "user_main"
    mir.Source(module: s.module, path: s.path, text: s.text, prog: prog)

## `ail check`'s texts of the program's own derive generators, by
## `TYPE.TRAIT`, for `load.load_derived`: `@@err MESSAGE` for a generator's
## `DeriveError`, `@@fx REASONS` for one that isn't compile-time-safe
## (ct.derive.3), which isn't run. Empty when the program has none, or when
## the generators don't build (the checker reports why).
fn user_derive_texts(loaded load.Loaded, path_arg str) Map[str, str]
    mut srcs := List[mir.Source]()
    for k in 0..loaded.program.files.len()
        f := loaded.program.files[k]
        if k < loaded.texts.len() and f.path.ends_with(".ail")
            srcs.push(parse_text(f.module, f.path, loaded.texts[k]))
    mut out := Map[str, str]()
    if srcs.len() == 0
        return out
    jobs := derive.user_jobs([s.module for s in srcs], documented(srcs))
    if jobs.len() == 0
        return out
    names := [
        if j.trait_module == "" then j.generator else "{j.trait_module}.{j.generator}"
        for j in jobs
    ]
    fx := check.generator_effects(loaded.program, names)
    mut safe := List[derive.Job]()
    for k in 0..jobs.len()
        if fx[k] != ""
            out[jobs[k].label] = "@@fx {fx[k]}"
        else
            safe.push(jobs[k])
    if safe.len() == 0
        return out
    rt := runtime_with(path.join(compiler_dir(), "rt/native"), path_arg, "0", "0") else return out
    texts := run_generators(srcs, safe, rt, true)
    for k in 0..texts.len()
        if k < safe.len()
            out[safe[k].label] = texts[k]
    out

## The generated text `body` of the `impl` `label` (`TYPE.TRAIT`) in
## `module`, each `fn m` written `fn TYPE.m`, so lines stay where the
## generator put them.
fn derived_source(module str, label str, body List[str]) mir.Source
    cut := label.split(".")
    owner := cut[..cut.len() - 1].join(".")
    mut lines := List[str]()
    for l in body
        if rest := l.strip_prefix("fn ")
            lines.push("fn {owner}.{rest}")
        else
            lines.push(l)
    parse_text(if module == "-" then "" else module, "gen:impl:{label}", "{lines.join("\n")}\n")

## Whether the program has a `use` that ends in `regex` (`use std.regex`, `use app.regex`).
fn uses_regex(prog ast.Program) bool
    for u in prog.uses
        if u.path.len() > 0 and u.path[u.path.len() - 1].name == "regex"
            return true
    false

## Whether the program has a `use` that ends in `ui` (`use std.ui`).
fn uses_ui(prog ast.Program) bool
    for u in prog.uses
        if u.path.len() > 0 and u.path[u.path.len() - 1].name == "ui"
            return true
    false

## Whether `text` names `ui.` as a word: not the end of a longer name
## (`gui.`, `build.`).
fn mentions_ui(text str) bool
    mut from := 0
    while from < text.len()
        rest := text.slice(from, text.len())
        at := rest.find("ui.") else return false
        k := from + at
        b := text.char_at(k - 1) else ' '
        if not (b.is_alpha() or b.is_digit() or b == '_' or b == '.')
            return true
        from = k + 3
    false

## One file, parsed; syntax errors are printed and the run fails.
fn parse_source(module str, path str) !mir.Source
    srcs := parse_module(module, [path])?
    srcs[0]

## The files of one module, parsed together: a generic name declared in one
## file starts type arguments in the others (gen.infer.2).
fn parse_module(module str, paths List[str]) !List[mir.Source]
    mut texts := List[str]()
    # The root module sees the prelude's generic functions too
    # (`load_json[T](path)`, json.load.1).
    mut names := if module == "" then prelude_generic_names() else Set[str]()
    for path in paths
        text := fs.read_text(path)?
        texts.push(text)
        for n in syntax.generic_names(syntax.lex(text).tokens).sorted()
            names.add(n)
    [parse_with(module, paths[k], texts[k], names) for k in 0..paths.len()]

fn prelude_generic_names() Set[str]
    syntax.generic_names(syntax.lex(mir.prelude_text(mir.PRELUDE_EMBED)).tokens)

## Text from `path`, parsed; syntax errors are printed and the run fails.
fn parse_text(module str, path str, text str) mir.Source
    parse_with(module, path, text, Set[str]())

## The generic functions of the prelude's `jsonderive` module (`mir/prelude_embed.ail`): the
## prelude is not in the file's tokens here, so `load_json[T](...)` needs them named.
PRELUDE_GENERIC := ["load_json", "print_json"]

fn parse_with(module str, path str, text str, names Set[str]) mir.Source
    lexed := syntax.lex(text)
    mut generic := names
    for n in PRELUDE_GENERIC
        generic.add(n)
    parsed := syntax.parse_with(lexed.tokens, generic)
    mut diags := lexed.diags
    diags.extend(parsed.diags)
    report := syntax.report_text(path, text, diags)
    if report.len() > 0
        io.eprint(report)
        io.exit(1)
    mut prog := parsed.program
    # `regex` needs no `use` (std.use.1); the module written in AIL is imported
    # by the mention (ADR 0819).
    if text.contains("regex.") and not uses_regex(prog)
        pos := ast.Pos(line: 1, col: 1)
        prog.uses.push(ast.Use(
            path: [ast.Ident(name: "std", pos: pos), ast.Ident(name: "regex", pos: pos)],
            alias: none,
            pos: pos,
        ))
    # `ui` needs none either; `std.ui` is written in AIL here (std.ui.1).
    if mentions_ui(text) and not uses_ui(prog) and module != "std.ui"
        pos := ast.Pos(line: 1, col: 1)
        prog.uses.push(ast.Use(
            path: [ast.Ident(name: "std", pos: pos), ast.Ident(name: "ui", pos: pos)],
            alias: none,
            pos: pos,
        ))
    mir.Source(module: module, path: path, text: text, prog: prog)

## The native `ail` command line (ADR 0855): `run` builds a program into the
## build cache and starts it. `prepare FILE` is `run` without the start: it
## prints the executable's path, which `./ail` execs so the program keeps the
## terminal (the native std can't replace a process yet).

## Entries the cache keeps; the least recently used go first (native.build.5).
CACHE_KEEP := 64

## The build cache directory: `AIL_CACHE_DIR`, `$XDG_CACHE_HOME/ail/build`,
## `%LOCALAPPDATA%\ail\build` or `~/.cache/ail/build`.
fn cache_dir() str
    d := env.get("AIL_CACHE_DIR") else ""
    if d != ""
        return d
    x := env.get("XDG_CACHE_HOME") else ""
    if x != ""
        return path.join(x, "ail/build")
    w := env.get("LOCALAPPDATA") else ""
    if w != ""
        return path.join(w, "ail/build")
    h := env.get("HOME") else "."
    path.join(h, ".cache/ail/build")

## One line per `.ail` file under `root` (path and the SHA-256 of its text),
## sorted, for the cache key.
fn tree_stamp(tag str, root str) str
    mut lines := List[str]()
    files := fs.walk(root) else []
    for f in files.sorted()
        if f.ends_with(".ail")
            text := fs.read_text(f) else continue
            lines.push("{tag} {f} {hash.sha256(text)}")
    lines.join("\n")

## `--schedule=random` builds atomic operations with switch points (conc.sched.1); the build
## cache tells those executables apart. Other builds pay nothing.
fn sched_points() bool
    s := env.get("AIL_SCHEDULE") else ""
    s.starts_with("random")

## Windows runs only files named `.exe`.
fn exe_ext(target str) str
    if target.ends_with("windows")
        return ".exe"
    ""

## The key of building `file` for `target`: everything that decides the
## executable's bytes.
fn cache_key(file str, target str, ms str, mb str, attach bool) str
    dir := compiler_dir()
    root := path.dir(file)
    # `ail.lock` names the commit of every git dependency, whose files live in the cache outside `root`.
    # (`file` may be the package directory itself.)
    lock := "{fs.read_text(path.join(root, "ail.lock")) else ""}{fs.read_text(path.join(file, "ail.lock")) else ""}"
    std := path.join(path.dir(dir), "std")
    parts := [
        "ail-native-cache-3 {target} {ms} {mb} {attach} {file} {sched_points()} {parallel_on()} {env.get("AIL_INSTRUMENT") else ""} {env.get("AIL_SANITIZE") else ""} {env.get("AIL_OPT_OFF") else ""}",
        tree_stamp("backend", dir),
        tree_stamp("program", root),
        "lock {hash.sha256(lock)}",
        tree_stamp("std", std),
    ]
    hash.sha256(parts.join("\n"))

## Keep the newest `CACHE_KEEP` executables of `dir` (newest by modification time; ADR 1059 replaced `ls -t`).
fn cache_trim(dir str)
    names := fs.list_dir(dir) else return
    # "AGE NAME" lines, where AGE counts down from 10^14 so that byte order is newest first.
    mut keyed := List[str]()
    for name in names
        if name.len() != 64
            continue
        meta := fs.metadata(path.join(dir, name)) else continue
        keyed.push("{100000000000000 - meta.modified_ms} {name}")
    mut n := 0
    for line in keyed.sorted()
        n += 1
        if n > CACHE_KEEP
            fs.remove(path.join(dir, line.slice(line.len() - 64, line.len()))) else continue

## The cached executable of `file` for the host, built first when missing.
fn cli_prepare(file str) str
    cli_prepare_with(file, "0", "0", false)

## `cli_prepare` with the run limits baked in (`--timeout MS`, `--max-memory MB`).
fn cli_prepare_with(file str, ms str, mb str, attach bool) str
    target := host_target()
    dir := cache_dir()
    exe := path.join(dir, "{cache_key(file, target, ms, mb, attach)}{exe_ext(target)}")
    if fs.exists(exe)
        return exe
    fs.make_dir(dir) else err
        io.eprint("error[native.build.5]: can't make {dir}")
    cache_store(file, exe, target, ms, mb, attach)
    cache_trim(dir)
    exe

fn cli_prepare_cmd(rest List[str])
    usage := "usage: ail prepare [--no-attach] [--timeout MS] [--max-memory MB] FILE"
    mut ms := "0"
    mut mb := "0"
    mut attach := true
    mut file := ""
    mut i := 0
    while i < rest.len()
        a := rest[i]
        has := i + 1 < rest.len()
        if a == "--timeout" and has and positive(rest[i + 1])
            ms = rest[i + 1]
            i += 1
        elif a == "--max-memory" and has and positive(rest[i + 1])
            mb = rest[i + 1]
            i += 1
        elif a == "--no-attach"
            attach = false
        elif file == "" and not a.starts_with("-")
            file = a
        else
            io.eprint(usage)
            io.exit(2)
        i += 1
    if file == ""
        io.eprint(usage)
        io.exit(2)
    print(cli_prepare_with(file, ms, mb, attach))

## `run FILE [ARGS...]`: the program's output and exit status are passed on.
fn cli_run(rest List[str])
    if rest.len() < 1
        io.eprint("usage: ail run FILE [ARGS...]")
        io.exit(2)
    # attach.run.1: on by default for `ail run`; `--no-attach` turns it off.
    attach := rest[0] != "--no-attach"
    args := if attach then rest else rest[1..]
    if args.len() < 1
        io.eprint("usage: ail run [--no-attach] FILE [ARGS...]")
        io.exit(2)
    exe := cli_prepare_with(args[0], "0", "0", attach)
    out := proc.run(exe, args[1..]) else err
        io.eprint("error[native.build.3]: can't start {exe}: {err}")
        io.exit(2)
        return
    # `print` and `eprint` add a newline; the program's own text has its own.
    if out.out != ""
        print(chop(out.out))
    if out.err != ""
        io.eprint(chop(out.err))
    io.exit(out.status)

## `s` without one final newline.
fn chop(s str) str
    if s.ends_with("\n")
        return s.chars()[..s.len() - 1].join("")
    s

## `load FILE...`: the loaded program as `ail api --ast --program` prints it.
fn load_dump(files List[str])
    std := path.join(path.dir(compiler_dir()), "std")
    for f in files
        if files.len() > 1
            print("== {f}")
        loaded := load.load(f, std) else err
            io.eprint("{f}: error: {err.message}")
            continue
        print(loaded.program.to_json().to_text())
        for d in loaded.diags
            print("{d.pos.line}:{d.pos.col} diag {d.rule}")

## `check-program [--json] FILE|DIR`: `ail check` on the native front end. The
## diagnostics go to stderr as `ail check` prints them; the exit status is 2
## when the program is rejected.
fn check_cmd(rest List[str])
    usage := "usage: ail check [--json] [--summary] [--fix] [--no-fix] [--deny LIST] [--allow LIST] [--deterministic] FILE|DIR"
    mut json := false
    mut driver := false
    mut repair := false
    mut no_fix := false
    mut fix_rounds := 0
    mut summary := false
    mut deny := List[str]()
    mut allow_given := false
    mut allow_text := ""
    mut policy_out := ""
    mut paths := List[str]()
    mut i := 0
    while i < rest.len()
        a := rest[i]
        has := i + 1 < rest.len()
        if a == "--json"
            json = true
        elif a == "--fix"
            repair = true
        elif a == "--no-fix"
            no_fix = true
        elif a == "--fix-round"
            # fix.auto.1: internal, one per round of certain fixes already applied.
            fix_rounds += 1
        elif a == "--summary"
            # check.out.1, check.out.3: the launcher adds it to `ail check`; the checks `ail run` and `ail build` make first stay quiet.
            summary = true
        elif a == "--unsafe" and has and rest[i + 1] == "driver"
            driver = true
            i += 1
        elif a == "--deterministic"
            deny.extend(check.deterministic_deny())
        elif a == "--policy-out" and has
            policy_out = rest[i + 1]
            i += 1
        elif a == "--allow" and has
            allow_given = true
            allow_text = "{allow_text},{rest[i + 1]}"
            i += 1
        elif a == "--deny" and has
            parsed := check.parse_deny(rest[i + 1])
            if parsed.1 != ""
                io.eprint("error: {parsed.1}")
                io.exit(2)
            deny.extend(parsed.0)
            i += 1
        elif not a.starts_with("--")
            paths.push(a)
        else
            io.eprint(usage)
            io.exit(2)
        i += 1
    if paths.len() != 1
        io.eprint(usage)
        io.exit(2)
    if allow_given
        # eff.allow.1: what the allow-list leaves out is denied, as with `--deny`.
        allowed := check.parse_allow(allow_text)
        if allowed.1 != ""
            io.eprint("error: {allowed.1}")
            io.exit(2)
        deny.extend(allowed.0)
    std := path.join(path.dir(compiler_dir()), "std")
    if repair
        # fix.check.1: apply every safe fix to a fixed point, then check what is left.
        done := load.repair(paths[0], std)
        if done.code != 0
            io.exit(done.code)
        if done.rules.len() > 0
            line := load.fixed_line(done.rules)
            if json
                print("\{\"api\":1,\"fixed\":{done.rules.len()},\"line\":{Json.Str(line).to_text()}}")
            else
                print(line)
    mut loaded := load.load(paths[0], std) else err
        io.eprint("error: {err.message}")
        io.exit(2)
        return
    if [d for d in loaded.diags if not d.rule.starts_with("ct.")].len() == 0
        user := user_derive_texts(loaded, paths[0])
        if user.len() > 0
            loaded = load.load_derived(paths[0], std, user) else loaded
    mut found := [load.shown_syntax(d) for d in loaded.diags]
    if loaded.diags.len() == 0
        mut program := loaded.program
        if driver
            # unsafe.hw.1: `--unsafe driver` lets the root package reach hardware.
            program.driver_allowed.push("")
        found = [
            load.shown_check(d)
            for d in check.analyze_denying(program, false, deny).report.diags
        ]
    else
        # gram.rec.4: the checker's errors from the declarations that parsed cleanly.
        more := [
            load.shown_check(d)
            for d in check.analyze_denying(loaded.program, false, deny).report.diags
        ]
        found.extend(load.one_pass(loaded, more, found))
    # fix.auto.1 (ADR 1130): errors with a certain fix are fixed in their files, then the program is checked again.
    # fix.auto.3: never with `--json`, the form editors and tools read; there the fixes are marked `"certain":true`.
    # With `--fix` the caller asked for writes, so the certain fixes in the program's other files follow too (FILE is --fix's own).
    if (repair or (not json and load.auto_fix_on(no_fix)))
        and fix_rounds < load.AUTO_ROUNDS
        and load.has_sure_fix(found)
        and load.auto_fix(loaded.program.files, found, std, repair) > 0
        mut again := rest
        again.push("--fix-round")
        check_cmd(again)
        return
    if found.len() > 0
        io.eprint(load.report_next(loaded.program.files, loaded.texts, found, json))
    mut n_err := 0
    mut n_warn := 0
    mut n_fix := 0
    for d in found
        if d.warning
            n_warn += 1
        else
            n_err += 1
        if d.edits.len() > 0
            n_fix += 1
    # check.out.1: one summary line on stdout, so "clean" is told from "did not run"; the diagnostics stay on stderr.
    if summary and json
        print("\{\"api\":1,\"summary\":true,\"errors\":{n_err},\"warnings\":{n_warn},\"fixable\":{n_fix}}")
    elif summary and n_err == 0
        # A prelude function sits past line 1073741824 (PRELUDE_LINE) and is not the program's.
        count := [f for f in loaded.program.fns if f.pos.line < 1073741824].len()
        print("ok {paths[0]}: {count} functions, {n_warn} warnings")
    if n_err > 0
        io.exit(2)
    if policy_out != ""
        # eff.allow.10: the run's policy from the manifests' scoped `caps`, for `ail run` to hand the program.
        fs.write_text(policy_out, check.grants_policy(loaded.program)) else err
            io.eprint("error: can't write {policy_out}: {err.kind}")
            io.exit(2)

## `api [--outline] FILE [--text | --pretty]`: the outline of one file
## (api.out.1-5). `--symbols`, `--expanded`, packages and the queries stay
## with the Rust `ail api` for now.
## `ail api --tokens FILE`, `--ast FILE` and `--ast --program FILE|DIR` (api.tok.1, api.ast.1-3):
## the lexer's tokens, the parser's tree and the loaded program.
fn api_syntax(rest List[str])
    usage := "usage: ail api (--tokens | --ast) FILE\n       ail api --ast --program DIR|FILE"
    tree := rest.contains("--ast")
    whole := rest.contains("--program")
    files := [a for a in rest if not a.starts_with("--")]
    mut known := true
    for a in rest
        if a.starts_with("--") and a != "--ast" and a != "--tokens" and a != "--program"
            known = false
    if files.len() != 1 or not known or (whole and not tree)
        io.eprint(usage)
        io.exit(2)
    file := files[0]
    if whole
        std := path.join(path.dir(compiler_dir()), "std")
        loaded := load.load(file, std) else err
            io.eprint("error: {err.message}")
            io.exit(2)
            return
        print(loaded.program.to_json().to_text())
        for d in loaded.diags
            print("{d.pos.line}:{d.pos.col} diag {d.rule}")
        return
    text := fs.read_text(file) else err
        io.eprint("error: can't read {file}: {err.kind}")
        io.exit(2)
        return
    lexed := syntax.lex(text)
    if tree
        print(syntax.ast_text(lexed, syntax.parse(lexed.tokens)))
    else
        print(syntax.tokens_text(lexed))

fn api_cmd(rest List[str])
    usage := "usage: ail api [--outline] FILE [--text | --pretty] [--symbols]"
    if rest.contains("--tokens") or rest.contains("--ast")
        api_syntax(rest)
        return
    if rest.contains("--diff")
        io.exit(api.diff_command(rest, path.join(path.dir(compiler_dir()), "std")))
    if rest.contains("--locals") or rest.contains("--type") or rest.contains("--refs")
        io.exit(api.query_command(rest, path.join(path.dir(compiler_dir()), "std")))
    if rest.contains("--card")
        io.exit(api.card_command(rest, path.join(path.dir(compiler_dir()), "std")))
    mut form := api.Form.Plain
    mut expanded := false
    mut symbols := false
    # `--json`: a rejected program's diagnostics as JSON lines (api.out.5); the outline is JSON anyway.
    mut json := false
    mut files := List[str]()
    for a in rest
        match a
            "--outline" => continue
            "--json" => json = true
            "--expanded" => expanded = true
            "--text" => form = api.Form.Text
            "--pretty" => form = api.Form.Pretty
            "--symbols" => symbols = true
            _ =>
                if a.starts_with("--") or files.len() > 0
                    io.eprint(usage)
                    io.exit(2)
                files.push(a)
    if files.len() != 1
        io.eprint(usage)
        io.exit(2)
    std := path.join(path.dir(compiler_dir()), "std")
    if not files[0].ends_with(".ail")
        io.exit(api.package_command(files[0], form, std, symbols))
    mut loaded := load.load(files[0], std) else err
        io.eprint("error: {err.message}")
        io.exit(2)
        return
    if expanded and [d for d in loaded.diags if not d.rule.starts_with("ct.")].len() == 0
        # ct.gen.4: the program's own derive generators run, as for `check`, so their code is listed.
        user := user_derive_texts(loaded, files[0])
        if user.len() > 0
            loaded = load.load_derived(files[0], std, user) else loaded
    mut found := [load.shown_syntax(d) for d in loaded.diags]
    mut analysis := check.analyze(loaded.program, true)
    if loaded.diags.len() == 0
        found = [load.shown_check(d) for d in analysis.report.diags if d.rule != "mod.main.1"]
    for d in found
        if not d.warning
            io.eprint(load.report(loaded.program.files, loaded.texts, found, json))
            io.exit(2)
    prog := doc.attach(loaded.program, loaded.texts[0])
    facts := api.Facts(
        effects: analysis.effects,
        errors: analysis.errors,
        symbols: analysis.symbols,
        weak_symbols: analysis.weak_symbols,
    )
    out := if expanded then api.outline_expanded(
        prog,
        facts,
        loaded.texts,
        files[0],
        form,
        symbols,
    ) else api.outline(prog, facts, files[0], form, symbols)
    if out != ""
        print(out.strip_suffix("\n") else out)
