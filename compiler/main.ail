# The self-hosted front end's entry point (Stage 3, ADR 0022), run by the
# bootstrap and compared with it by the selftest:
#   ail run compiler check PROGRAM.json   the checker's diagnostics for a program dumped by
#                                         `ail api --ast --program` (first line), one JSON line each
#   ail run compiler tokens FILE...       the AIL lexer's tokens, as `ail api --tokens FILE` (ADR 0371)
#   ail run compiler parse FILE...        the AIL parser's tree, as `ail api --ast FILE`
#   ail run compiler mir FILE [RT]        the native backend's MIR of a program (ADR 0384), with
#                                         the runtime in directory RT when given
#   ail run compiler build FILE RT [TARGET]
#                                         an executable of a program as hex text, with the runtime
#                                         in directory RT, for x86_64-linux (the default) or
#                                         aarch64-linux or aarch64-macos (ADRs 0385, 0388, 0389;
#                                         `ail build`)
# With several files, each output starts with a line `== PATH`.
use a64
use ast
use check
use mir
use obj
use syntax
use x64

fn main() !
    args := env.args()
    if args.len() < 2
        io.eprint("usage: ail run compiler (check PROGRAM.json... | tokens FILE... | parse FILE... | mir FILE | build FILE RT)")
        io.exit(2)
    match args[0]
        "check" =>
            for path in args[1..]
                check_dump(path, args.len() > 2)?
        "tokens" =>
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                print(syntax.tokens_text(syntax.lex(fs.read_text(path)?)))
        "parse" =>
            for path in args[1..]
                if args.len() > 2
                    print("== {path}")
                lexed := syntax.lex(fs.read_text(path)?)
                print(syntax.ast_text(lexed, syntax.parse(lexed.tokens)))
        "mir" =>
            if args.len() > 2
                print(mir.module_text(lower_file(args[1], runtime(args[2])?)?))
            else
                print(mir.module_text(lower_file(args[1], none)?))
        "build" =>
            m := lower_file(args[1], runtime(args[2])?)?
            target := if args.len() > 3 then args[3] else "x86_64-linux"
            match target
                "x86_64-linux" => print(obj.hex(obj.elf(x64.generate(m), obj.X86_64)))
                "aarch64-linux" => print(obj.hex(obj.elf(a64.generate(m, a64.LINUX), obj.AARCH64)))
                "aarch64-macos" =>
                    name := args[1].split("/").last() else args[1]
                    print(obj.hex(obj.macho(a64.generate(m, a64.MACOS), name.replace(".ail", ""))))
                _ =>
                    io.eprint("error[native.build.3]: unknown target `{target}`")
                    io.exit(2)
        _ =>
            io.eprint("unknown command {args[0]}")
            io.exit(2)

## The checker's diagnostics for one dump, sorted by position as `ail check`
## reports them. With several dumps, each starts with `== PATH` and ends
## with what the checker covers (`rules ...`, `skip FILE FIRST LAST`).
fn check_dump(path str, many bool) !
    text := fs.read_text(path)?
    first := text.lines().first() else ""
    prog := ast.Program.from_json(parse_json(first)?)?
    diags := check.check_declarations(prog).sorted(by: |d| d.pos.line * 100000 + d.pos.col)
    if many
        print("== {path}")
    for d in diags
        print(d.to_json(prog.files))
    if many
        print("rules {check.COVERED_RULES.join(" ")}")
        for s in check.skipped(prog)
            print("skip {s.file} {s.first} {s.last}")

## The native runtime in directory `dir`, parsed as one program.
fn runtime(dir str) !ast.Program
    mut texts := List[str]()
    for name in ["prim.ail", "core.ail", "map.ail"]
        texts.push(fs.read_text("{dir}/{name}")?)
    syntax.parse(syntax.lex(texts.join("\n")).tokens).program

## Parse a program and lower it to MIR; problems outside the native subset
## are printed as `ail check` prints diagnostics, and the run fails.
fn lower_file(path str, rt ast.Program?) !mir.Module
    text := fs.read_text(path)?
    lexed := syntax.lex(text)
    parsed := syntax.parse(lexed.tokens)
    mut diags := lexed.diags
    diags.extend(parsed.diags)
    if diags.len() > 0
        for d in diags
            io.eprint("{path}:{d.pos.line}:{d.pos.col}: error[{d.rule}]: {d.msg}")
        io.exit(1)
    m := mir.lower_module(path, text, parsed.program, rt) else err
        for p in err.items
            io.eprint("{path}:{p.pos.line}:{p.pos.col}: error[{p.rule}]: {p.message}")
        io.exit(1)
        return mir.Module(path: path, funcs: [], strs: [], sites: [], lines: [])
    m
