## The parser's smaller parts, as the bootstrap splits them: contract
## lines (contract.decl.1-3), error messages (err.msg.1-2), modules
## (mod.use.1-2, mod.vis.1-2), `@derive` traits (ct.derive.1), and
## recovery from other languages' constructs (gram.foreign.1, gram.rec.1).
use ast
use cheader
use fix

# ---- Contracts ----

## A function body: an indented block whose first lines may be `requires
## COND` and `ensures COND` (contract.decl.1). A trait method may have
## contract lines and no body (contract.inh.1).
fn Parser.fn_body(mut self, after str, bodyless_ok bool) FnBody?
    if tag_at(1) != "indent"
        body := block(after, "gram.fn.1")?
        return FnBody(body: body, contracts: [])
    i += 2
    mut contracts := List[ast.Contract]()
    while true
        while eat_newline()
            i += 0
        is_ensures := at_kw("ensures")
        if not is_ensures and not at_kw("requires")
            break
        if c := contract_line(is_ensures)
            contracts.push(c)
        else
            skip_statement()
    if bodyless_ok and contracts.len() > 0 and eat_dedent()
        return FnBody(body: none, contracts: contracts)
    FnBody(body: block_rest(), contracts: contracts)

## `requires COND`, `ensures COND` or `invariant COND`, up to the end of
## the line, which is not consumed.
fn Parser.contract_line(mut self, is_ensures bool) ast.Contract?
    pos := bump().pos
    start := i
    outer_in := in_ensures
    outer := olds
    in_ensures = is_ensures
    olds = []
    cond := expression()
    found := olds
    in_ensures = outer_in
    olds = outer
    c := cond?
    text := render(tokens[start..i])
    if peek() != Tok.Newline
        unexpected("end of line after the condition", "contract.decl.1")
        return none
    ast.Contract(is_ensures: is_ensures, cond: c, text: text, pos: pos, olds: found)

fn plain_arg(a ast.Arg) bool
    a.label == none and not a.mutable and not a.moved and a.param == none

## A call, or contract.ens.3's `old(e)` inside an `ensures` condition: the
## value `e` had on entry, as a hidden name the interpreter binds.
fn Parser.call_or_old(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos) ast.Expr
    if name_of(callee) != "old" or not in_ensures
        return ast.Expr.Call(callee: callee, args: args, pos: pos)
    if args.len() != 1 or not plain_arg(args[0])
        error_text(
            "contract.ens.3",
            pos,
            "`old` takes one expression: the value to remember from when the function was called",
            "write `old(x)`",
            "",
        )
        return ast.Expr.Name(name: "old", pos: pos)
    # The hidden name is the call as written, which can't be a user's name.
    close := i - 1
    mut open := close
    mut depth := 0
    while open > 0
        s := if tok_tag(tokens[open].tok) == "sym" then tok_text(tokens[open].tok) else ""
        if s == ")"
            depth += 1
        elif s == "("
            depth -= 1
        if depth == 0
            break
        open -= 1
    hidden := "old({render(tokens[open + 1..close])})"
    olds.push(ast.Old(name: hidden, value: args[0].value))
    ast.Expr.Name(name: hidden, pos: pos)

## contract.decl.1: a contract line anywhere but directly under a signature.
fn Parser.misplaced_contract(mut self) bool
    if not at_kw("requires") and not at_kw("ensures")
        return false
    word := tok_text(peek())
    error_text(
        "contract.decl.1",
        here(),
        "`{word}` must come directly under a function's signature, before its first statement",
        "move the `{word}` line up to just below the `fn` line",
        "",
    )
    skip_statement()
    true

## The source form of a condition's tokens, with the formatter's spacing
## (fmt.space): what a trap and `ail api` show (contract.req.1).
fn render(toks List[Token]) str
    mut out := List[str]()
    mut before := absent[Tok]()
    mut prev := absent[Tok]()
    for t in toks
        if stops(t.tok)
            continue
        if p := prev
            if spaced(before, p, t.tok)
                out.push(" ")
        out.push(render_word(t.tok))
        before = prev
        prev = t.tok
    out.join("")

## Ends an operand, so a following `(` or `[` is a call or an index and a
## following `-` is binary.
fn ends_operand(t Tok) bool
    match t
        Kw(k) => k == "self" or k == "true" or k == "false" or k == "none" or k == "todo"
        Sym(s) => s == ")" or s == "]" or s == "}" or s == "?"
        Ident(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => true

fn sym_of(t Tok) str
    if tok_tag(t) == "sym" then tok_text(t) else ""

## Whether a space separates `a` and `b`; `before` precedes `a` (fmt.space).
fn spaced(before Tok?, a Tok, b Tok) bool
    sb := sym_of(b)
    sa := sym_of(a)
    if [",", ")", "]", "}", ".", "?", ":", "..", "..="].contains(sb)
        return false
    if ["(", "[", "\{", ".", "..", "..="].contains(sa)
        return false
    # A prefix `-` or `!`.
    if sa == "-" or sa == "!"
        prefix := if t := before then not ends_operand(t) else true
        if prefix
            return false
    if sb == "(" or sb == "["
        return not ends_operand(a)
    true

fn render_word(t Tok) str
    match t
        Ident(s) => s
        Kw(s) => s
        Sym(s) => s
        Str(s) => "\"{escape(s)}\""
        Bytes(hex) => "b\"{bytes_source(hex)}\""
        Interp(parts) =>
            mut out := List[str]()
            for part in parts
                match part
                    Lit(s) => out.push(escape(s))
                    Code(code) => out.push("\{{render(code)}}")
                    Fmt(code, _) => out.push("\{{render(code)}}")
            "\"{out.join("")}\""
        Char(c) => "'{escape("{c}")}'"
        Int(v) => "{v}"
        IntMin => "9223372036854775808"
        Float(v) => debug_float(v)
        Newline | Indent | Dedent | Eof => ""

## A float as Rust's `{:?}` writes it: AIL's text, but an exponent has no
## `+` and no leading zeros.
fn debug_float(v float) str
    s := "{v}"
    k := s.find("e") else return s
    mantissa := s.slice(0, k)
    mut exp := s.slice(k + 1, s.chars().len())
    mut sign := ""
    if exp.starts_with("+")
        exp = exp.chars()[1..].join("")
    elif exp.starts_with("-")
        sign = "-"
        exp = exp.chars()[1..].join("")
    while exp.len() > 1 and exp.starts_with("0")
        exp = exp.chars()[1..].join("")
    "{mantissa}e{sign}{exp}"

fn escape(s str) str
    mut out := List[str]()
    for c in s.chars()
        if c == '"'
            out.push("\\\"")
        elif c == '\\'
            out.push("\\\\")
        elif c == '\{'
            out.push("\\\{")
        elif c == '\n'
            out.push("\\n")
        elif c == '\t'
            out.push("\\t")
        else
            out.push("{c}")
    out.join("")

# ---- Error messages (err.msg.1-2) ----

## The message after an error type's name or one of its variants, if the
## next token is a string (err.msg.1).
fn Parser.error_message(mut self, is_error bool) Token?
    t := tag_at(0)
    if t != "str" and t != "interp"
        return none
    message := bump()
    if not is_error
        error_text(
            "err.msg.1",
            message.pos,
            "only `error` types have messages",
            "declare it with `error struct` or `error enum`, or write `impl ToStr`",
            "",
        )
        return none
    message

## err.msg.2: every variant has a message, or none does. Splices the `impl
## ToStr` that the messages define after the declaration.
fn Parser.splice_messages(
    mut self,
    name str,
    pos ast.Pos,
    generic bool,
    arms List[VariantMessage],
    whole Token?,
)
    given := [a for a in arms if a.message != none].len()
    if whole == none and given == 0
        return
    if generic
        error_text(
            "err.msg.2",
            pos,
            "`{name}` has type parameters, so it can't have messages",
            "write `impl ToStr` for it instead",
            "",
        )
        return
    if given != 0 and given != arms.len()
        mut missing := ""
        for a in arms
            if a.message == none and missing == ""
                missing = a.name
        error_text(
            "err.msg.2",
            pos,
            "some variants of `{name}` have a message but `{missing}` doesn't",
            "give every variant a message, or none (and write `impl ToStr`)",
            "",
        )
        return
    mut t := List[Token]()
    for k in [
        Tok.Kw("impl"),
        Tok.Ident("ToStr"),
        Tok.Kw("for"),
        Tok.Ident(name),
        Tok.Newline,
        Tok.Indent,
    ]
        t.push(Token(tok: k, pos: pos))
    for k in [
        Tok.Kw("fn"),
        Tok.Ident("to_str"),
        Tok.Sym("("),
        Tok.Kw("self"),
        Tok.Sym(")"),
        Tok.Ident("str"),
        Tok.Newline,
        Tok.Indent,
    ]
        t.push(Token(tok: k, pos: pos))
    if m := whole
        # A struct's fields are in scope by bare name (ADR 0141).
        t.push(m)
        t.push(Token(tok: Tok.Newline, pos: pos))
    else
        for k in [Tok.Kw("match"), Tok.Kw("self"), Tok.Newline, Tok.Indent]
            t.push(Token(tok: k, pos: pos))
        for arm in arms
            message := arm.message else continue
            used := names_in(message.tok)
            t.push(Token(tok: Tok.Ident(arm.name), pos: pos))
            if arm.fields.len() > 0
                t.push(Token(tok: Tok.Sym("("), pos: pos))
                for f in arm.fields
                    if t[t.len() - 1].tok != Tok.Sym("(")
                        t.push(Token(tok: Tok.Sym(","), pos: pos))
                    n := if used.contains(f) then f else "_"
                    t.push(Token(tok: Tok.Ident(n), pos: pos))
                t.push(Token(tok: Tok.Sym(")"), pos: pos))
            t.push(Token(tok: Tok.Sym("=>"), pos: pos))
            t.push(message)
            t.push(Token(tok: Tok.Newline, pos: pos))
        t.push(Token(tok: Tok.Dedent, pos: pos))
    t.push(Token(tok: Tok.Dedent, pos: pos))
    t.push(Token(tok: Tok.Dedent, pos: pos))
    mut spliced := tokens[0..i]
    spliced.extend(t)
    spliced.extend(tokens[i..])
    tokens = spliced

## The plain names used inside a string's `{...}` parts.
fn names_in(tok Tok) List[str]
    mut names := List[str]()
    match tok
        Interp(parts) =>
            for part in parts
                code := match part
                    Lit(_) => List[Token]()
                    Code(ts) => ts
                    Fmt(ts, _) => ts
                for t in code
                    match t.tok
                        Ident(n) => names.push(n)
                        Interp(_) => names.extend(names_in(t.tok))
                        Kw(_) | Sym(_) | Str(_) | Bytes(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => continue
        Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => return names
    names

# ---- Modules (mod.use.1-2, mod.vis.1-2) ----

## `use a.b.c` or `use a.b.c as d`, on a line of its own (mod.use.1).
fn Parser.use_decl(mut self)
    pos := bump().pos
    if u := use_path(pos)
        last := if a := u.alias then a else u.path[u.path.len() - 1]
        aliases.add(last.name)
        uses.push(u)
    else
        skip_statement()

fn Parser.use_path(mut self, pos ast.Pos) ast.Use?
    if header := c_header()
        return header_use(pos, header)
    mut path := [take_name("a module path after `use`", "mod.use.1")?]
    while true
        if at_sym(":") and sym_at(1) == ":" and adjacent(i)
            error_fix(
                "gram.foreign.1",
                here(),
                "AIL writes paths with `.`, not `::`",
                "write `use std.fs`",
                "write `.`",
                [fix.span(here(), ast.Pos(line: here().line, col: here().col + 2), ".")],
            )
            i += 2
            path.push(take_name("a module name after `.`", "mod.use.1")?)
        elif eat_sym(".")
            path.push(take_name("a module name after `.`", "mod.use.1")?)
        else
            break
    mut alias := none
    if eat_kw("as")
        alias = take_name("a name after `as`", "mod.use.1")?
    if not eat_newline() and peek() != Tok.Eof
        unexpected("end of line after the import", "mod.use.1")
        return none
    ast.Use(path: path, alias: alias, pos: pos)

## The header of a `use c "header.h"`, when the line is one (ffi.decl.1).
fn Parser.c_header(self) str?
    if tag_at(0) != "id" or ident() != "c"
        return none
    h := str_at(1)
    if h == ""
        return none
    h

## The text of the string literal `n` tokens ahead, or "".
fn Parser.str_at(self, n int) str
    match peek_at(n)
        Str(h) => h
        Ident(_) | Kw(_) | Sym(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

## `use c "header.h" as name` (ffi.decl.1, ADR 0926): the import of the module that
## `cheader.module_name` makes for the header, under `name`.
fn Parser.header_use(mut self, pos ast.Pos, header str) ast.Use?
    i += 2
    if not eat_kw("as")
        error_text(
            "ffi.decl.1",
            here(),
            "`use c \"{header}\"` needs a name",
            "write `use c \"{header}\" as NAME`",
            "",
        )
        skip_statement()
        return none
    alias := take_name("a name after `as`", "ffi.decl.1")?
    if not eat_newline() and peek() != Tok.Eof
        unexpected("end of line after the import", "mod.use.1")
        return none
    ast.Use(path: [ast.Ident(name: cheader.module_name(header), pos: pos)], alias: alias, pos: pos)

## `pub` before a top-level declaration (mod.vis.1). The declaration follows
## on the same line, so the line marks it public.
fn Parser.pub_marker(mut self)
    pos := bump().pos
    k := kw_at(0)
    if k == "fn"
        or k == "extern"
        or tag_at(0) == "id" and tok_text(peek()) == "export" and at_export_fn()
        or k == "struct"
        or k == "enum"
        or k == "error"
        or k == "unique"
        or k == "trait"
        or tag_at(0) == "id" and sym_at(1) == ":="
        public.add(pos.line)
    elif k == "impl"
        error_text(
            "mod.vis.2",
            pos,
            "an `impl` has no visibility of its own; its methods have the trait's visibility",
            "remove `pub`",
            "",
        )
    elif k == "use"
        error_text(
            "mod.use.2",
            pos,
            "an import can't be re-exported; importers write their own `use`",
            "remove `pub`",
            "",
        )
    else
        unexpected(
            "a declaration after `pub` (`fn`, `struct`, `enum`, `error`, `trait` or a constant)",
            "mod.vis.1",
        )
        skip_statement()

## `pub` before a member that takes its visibility from its trait or enum
## (mod.vis.2): reported and skipped.
fn Parser.member_pub(mut self, what str)
    if at_kw("pub")
        owner := if what.contains("variant") then "enum" else "trait"
        error_text(
            "mod.vis.2",
            bump().pos,
            "{what} have the visibility of their {owner}",
            "remove `pub`",
            "",
        )

## `pub` before a struct field (mod.vis.1).
fn Parser.field_pub(mut self, rule str)
    if not at_kw("pub")
        return
    pos := bump().pos
    if rule == "type.struct.2"
        public.add(pos.line)
    else
        error_text(
            "mod.vis.2",
            pos,
            "variant fields have the visibility of their enum",
            "remove `pub`",
            "",
        )

# ---- `@derive(f) trait Name` (ct.derive.1) ----

## At `@`: whether the line declares a trait with a generator. Consumes
## nothing when it doesn't, so `@derive` before a function stays an
## unknown attribute (test.attr.1).
fn Parser.derive_trait(mut self) bool
    if tag_at(1) != "id" or tok_text(peek_at(1)) != "derive"
        return false
    shape := sym_at(2) == "(" and tag_at(3) == "id" and sym_at(4) == ")" and kw_at(5) == "trait"
    if not shape
        mut k := i
        mut has_trait := false
        while tokens[k].tok != Tok.Newline and tokens[k].tok != Tok.Eof
            if tokens[k].tok == Tok.Kw("trait")
                has_trait = true
            k += 1
        if not has_trait
            return false
        error_text(
            "ct.derive.1",
            here(),
            "`@derive` before a trait names one generator function",
            "write `@derive(generator) trait Name`",
            "",
        )
        skip_statement()
        return true
    name := tok_text(peek_at(3))
    pos := tokens[i + 3].pos
    i += 5
    before := traits.len()
    trait_decl()
    if traits.len() > before
        traits[before].derive = ast.Ident(name: name, pos: pos)
    true

# ---- Other languages' constructs (gram.foreign.1, gram.rec.1) ----

## A foreign declaration word's fix: "" for none, "-" to delete the word,
## or its replacement.
fn decl_fix(w str) str?
    match w
        "def" | "func" | "function" | "fun" => "fn"
        "class" => "struct"
        "interface" | "protocol" => "trait"
        "import" => "use"
        "async" => "-"
        "public" | "export" => "pub"
        "private" | "protected" | "static" | "final" | "abstract" | "override" | "sealed" | "internal" => "-"
        "package" | "namespace" | "module" | "type" => ""
        _ => none

## The message and help of a foreign declaration word (`foreign::decl_word`).
fn decl_info(w str)(str, str)
    match w
        "def" | "func" | "function" | "fun" => ("AIL declares functions with `fn`", "write `fn name(a int) int`")
        "class" =>
            ("AIL has no `class`", "declare a `struct` with its fields, then methods as `fn Name.method(self)`")
        "interface" | "protocol" => ("AIL has no `interface`", "a set of methods a type provides is a `trait`")
        "import" =>
            ("AIL imports with `use`", "write `use` and a module name; the standard modules need no `use` (std.use.4)")
        "async" =>
            ("AIL has no `async`", "tasks are colorless: start any function with `spawn f(x)` and wait with `t.wait()`")
        "public" | "export" => ("AIL exports with `pub`", "write `pub` before the declaration")
        "type" =>
            ("AIL has no `type X = Y` alias", "a new type is a `struct` with a field: `struct Celsius` then an indented `value float`; a function type is written `fn(int) int` where it is used")
        "package" | "namespace" | "module" =>
            ("AIL modules are directories, not declared in the file", "put the file in a directory and import it elsewhere with `use dir`")
        _ =>
            ("AIL has no access or storage modifiers on declarations", "a declaration is private to its module unless it is marked `pub`")

## The message and help of a foreign statement word (`foreign::stmt_word`).
fn stmt_info(w str)(str, str)
    errors := "errors are values: declare `fn f() T ! MyError`, fail with `return Variant`, and handle a call with `?` or `else` (spec chapter 08)"
    match w
        "try" | "catch" | "except" | "finally" => ("AIL has no exceptions", errors)
        "throw" | "raise" => ("AIL has no `throw`", errors)
        "switch" | "case" | "default" =>
            ("AIL has no `switch`", "write `match value` with one `pattern => result` arm per line")
        "pass" =>
            ("AIL has no `pass`", "a block needs a statement; write `todo` for code you haven't written yet")
        "await" =>
            ("AIL has no `await`", "tasks are colorless: `t := spawn f(x)` starts one and `t.wait()` waits for it")
        "loop" => ("AIL has no `loop`", "write `while true`")
        "elseif" | "elsif" | "else_if" => ("AIL writes `elseif` as `elif`", "write `elif`")
        _ =>
            ("this keyword from another language has no AIL form", "see the language card for the statements AIL has")

fn stmt_foreign(w str) bool
    match w
        "try" | "catch" | "except" | "finally" | "throw" | "raise" | "switch" | "case" | "default" => true
        "pass" | "await" | "loop" | "elseif" | "elsif" | "else_if" => true
        "unless" | "until" | "lambda" | "del" | "global" | "nonlocal" | "goto" | "do" => true
        _ => false

## A top-level word from another language's declarations (`def`, `class`,
## `import`, `async`, ...). Reports it and skips the line.
fn Parser.foreign_decl(mut self, w str) bool
    s := sym_at(1)
    if s == ":=" or s == "=" or s == "(" or s == "." or s == "["
        return false
    # `from a.b import c` becomes `use a.b.c`.
    if w == "from"
        return from_import()
    repl := decl_fix(w) else return false
    info := decl_info(w)
    error_text(
        "gram.foreign.1",
        here(),
        info.0,
        info.1,
        if repl == "-" then "remove `{w}`" else if repl == "" then "" else "write `{repl}`",
    )
    if repl == "-"
        attach("remove `{w}`", [fix.delete(here(), through_blank(i) else here())])
    elif repl != ""
        attach("write `{repl}`", [fix.span(here(), tok_end(i) else here(), repl)])
    # A modifier is followed by the declaration itself.
    t := tag_at(1)
    if (repl == "-" or repl == "pub") and (t == "kw" or t == "id")
        i += 1
        return true
    skip_statement()
    true

## `from a.b import c`: Python's import.
fn Parser.from_import(mut self) bool
    mut k := i + 1
    while true
        if tok_tag(tokens[k].tok) != "id"
            return false
        k += 1
        if tokens[k].tok == Tok.Sym(".")
            k += 1
        else
            break
    if tokens[k].tok != Tok.Ident("import")
        return false
    mut path := List[str]()
    for j in i + 1..k
        if tok_tag(tokens[j].tok) == "id"
            path.push(tok_text(tokens[j].tok))
    error_text(
        "gram.foreign.1",
        here(),
        "AIL has no `from ... import`",
        "import the module with `use {path.join(".")}` and write `{path[path.len() - 1]}.name` for its items",
        "",
    )
    if k + 2 < tokens.len() and tok_tag(tokens[k + 1].tok) == "id"
        if end := tok_end(k + 1)
            after := tokens[k + 2].tok
            if after == Tok.Newline or after == Tok.Eof
                attach("write a `use`", [fix.span(
                    here(),
                    end,
                    "use {path.join(".")}.{tok_text(tokens[k + 1].tok)}",
                )])
    skip_statement()
    true

## A statement word from another language (`try`, `switch`, `pass`,
## `throw`, ...), unless the word is used as a name.
fn Parser.foreign_stmt(mut self) bool
    if tag_at(0) != "id"
        return false
    t := tag_at(1)
    if t != "nl" and t != "id" and t != "str" and t != "interp" and t != "int" and t != "kw"
        return false
    if not stmt_foreign(tok_text(peek()))
        return false
    word := tok_text(peek())
    info := stmt_info(word)
    error_text("gram.foreign.1", here(), info.0, info.1, "")
    mut repl := ""
    if word == "pass"
        repl = "todo"
    elif word == "loop" and tag_at(1) == "nl"
        repl = "while true"
    elif word == "elseif" or word == "elsif" or word == "else_if"
        repl = "elif"
    if repl != ""
        attach("write `{repl}`", [fix.span(here(), tok_end(i) else here(), repl)])
    skip_statement()
    true

## After a block header the line didn't end where it should (`if c:`,
## `else:`, `if a = b`, `if x is none`, `if a && b {`).
fn Parser.header_tail(mut self, after str) Header
    k0 := i
    pos := tok_pos(k0)
    cond := after.contains("condition")
    s := sym_at(0)
    # `if let Some(x) = e` (Rust)
    if cond
        and k0 >= 1
        and tokens[k0 - 1].tok == Tok.Ident("let")
        and tag_at(0) == "id"
        and sym_at(1) == "("
        and tag_at(2) == "id"
        and sym_at(3) == ")"
        and sym_at(4) == "="
        wrapper := tok_text(peek())
        is_while := after.contains("`while`")
        if is_while
            error_text(
                "gram.foreign.1",
                tok_pos(k0 - 1),
                "AIL has no `while let`",
                "loop with `while true` and take the value inside: `x := e else break`",
                "",
            )
            return Header.Reported
        if wrapper == "Some" or wrapper == "Ok"
            name := tok_text(tokens[k0 + 2].tok)
            error_fix(
                "gram.foreign.1",
                tok_pos(k0 - 1),
                "AIL has no `if let`",
                "bind the value in the condition: `if {name} := e` runs the block when `e` has a value (`T?`) or succeeds (`T ! E`), and binds `{name}`; an `else` block runs otherwise",
                "write `if {name} := e`",
                [fix.span(tok_pos(k0 - 1), tok_end(k0 + 4) else pos, "{name} :=")],
            )
        else
            error_text(
                "gram.foreign.1",
                tok_pos(k0 - 1),
                "AIL has no `if let`",
                "handle a failure with `v := f() else err` and a block, or `v := f() else return`; test an optional with `if x := e`",
                "",
            )
        return Header.Reported
    if s == ":" and (not cond or tag_at(1) == "nl")
        # `if c:` ends the line; `fn f() : int` goes on to the type.
        colon_only := tag_at(1) == "nl"
        error_fix(
            "gram.foreign.1",
            pos,
            "AIL doesn't put a `:` after a block header",
            "a line that opens a block ends where the header ends; the block is the indented lines below",
            "remove the `:`",
            [fix.delete(pos, colon_end(k0, pos, colon_only))],
        )
        i += 1
        if colon_only
            i += 1
            return Header.GoOn
        return Header.Reported
    if s == "=" and cond
        error_fix(
            "expr.bind.3",
            pos,
            "`=` assigns; it can't be a condition",
            "compare with `==`",
            "write `==`",
            [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 1), "==")],
        )
        return Header.Reported
    if cond and tag_at(0) == "id" and tok_text(peek()) == "is"
        text := if kw_at(1) == "not" then "is not" else "is"
        op := if text == "is" then "==" else "!="
        error_fix(
            "gram.foreign.1",
            pos,
            "AIL has no `{text}`",
            "compare with `{op}`, e.g. `x {op} none`",
            "write `{op}`",
            [fix.span(pos, tok_end(if text == "is" then k0 else k0 + 1) else pos, op)],
        )
        return Header.Reported
    if cond and kw_at(0) == "in"
        diags.push(Diag(
            rule: "gram.foreign.1",
            pos: pos,
            msg: "AIL has no `in` operator for membership",
            fixed: true,
            help: "write the test as a method on the collection: `xs.contains(x)`, `m.contains(key)`, `s.contains(sub)`",
            fix: "write `.contains`",
            edits: [fix.operands(pos, "in", "$r.contains($l)")],
        ))
        return Header.Reported
    if s == "\{" and (tag_at(1) == "nl" or line_ends_at(k0))
        error_text(
            "gram.foreign.1",
            pos,
            "AIL doesn't use braces around blocks",
            "a block is the lines indented 4 spaces below its header, with no closing line",
            "",
        )
        braces := brace_edits(k0)
        if braces.len() > 0
            attach("remove the braces", braces)
        return Header.Reported
    Header.NotHeader

## The generic "expected end of line after the statement" at a token that
## betrays another language. `start` is the index of the statement's first
## token. Returns true when it reported something specific.
fn Parser.stray_after_statement(mut self, start int) bool
    k0 := i
    pos := tok_pos(k0)
    cur := sym_at(0)
    # `outer: for ...`
    if tok_tag(tokens[start].tok) == "id"
        and cur == ":"
        and k0 == start + 1
        and (tokens[k0 + 1].tok == Tok.Kw("for") or tokens[k0 + 1].tok == Tok.Kw("while"))
        error_text(
            "gram.foreign.1",
            tok_pos(start),
            "AIL has no loop labels",
            "`break` leaves the innermost loop; to leave nested loops move them into a function and `return`, or keep a `mut done := false` flag and test it in each loop",
            "",
        )
        return true
    # `println!(..)`, `vec![..]`, `format!(..)`
    if cur == "!"
        and k0 >= 1
        and tok_tag(tokens[k0 - 1].tok) == "id"
        and touches(k0)
        and (sym_at(1) == "(" or sym_at(1) == "[")
        return macro_call(k0)
    # `go work(1)`
    if tokens[start].tok == Tok.Ident("go") and k0 == start + 1 and tag_at(0) == "id"
        error_text(
            "gram.foreign.1",
            tok_pos(start),
            "AIL has no `go`",
            "start a task with `t := spawn work(1)` and wait for it with `t.wait()`; a task handle must be waited or added to a `TaskGroup` (conc.task.2)",
            "",
        )
        return true
    # `a, b = b, a`
    if tok_tag(tokens[start].tok) == "id" and cur == "," and k0 == start + 1 and assign_ahead(k0)
        error_text(
            "gram.foreign.1",
            tok_pos(start),
            "AIL has no multiple assignment",
            "swap through a temporary (`t := a`, `a = b`, `b = t`), or swap list elements with `xs.swap(i, j)`; `a, b := f()` takes a tuple apart",
            "",
        )
        return true
    # `x: int = 5`
    if tok_tag(tokens[start].tok) == "id" and cur == ":" and k0 == start + 1
        name := tok_text(tokens[start].tok)
        error_text(
            "expr.bind.1",
            tok_pos(start),
            "`{name}` is declared without a type annotation",
            "write `{name} := value`; the type is inferred. An empty collection names its type in the value: `List[int]()`",
            "",
        )
        mut eq := -1
        mut e := k0
        while e < tokens.len() and tokens[e].tok != Tok.Newline and tokens[e].tok != Tok.Eof
            if eq < 0 and tokens[e].tok == Tok.Sym("=")
                eq = e
            e += 1
        mut empty := false
        if eq >= 0 and eq + 2 < tokens.len()
            a := tokens[eq + 1].tok
            b := tokens[eq + 2].tok
            empty = (a == Tok.Sym("[") or a == Tok.Sym("\{"))
                and (b == Tok.Sym("]") or b == Tok.Sym("}"))
        if eq >= 0 and empty
            attach(
                "declare it with `:=` and the type as a constructor",
                [fix.empty_decl(tok_pos(start))],
            )
        elif eq >= 0
            ep := tokens[eq].pos
            attach("declare it with `:=`", [fix.span(
                pos,
                ast.Pos(line: ep.line, col: ep.col + 1),
                " :=",
            )])
        return true
    # `Color::Red`, `std::fs`
    if cur == ":" and sym_at(1) == ":" and adjacent(k0)
        error_fix(
            "gram.foreign.1",
            pos,
            "AIL writes paths with `.`, not `::`",
            "write `Color.Red`, `std.fs`",
            "write `.`",
            [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 2), ".")],
        )
        return true
    # `new Point(...)`
    if k0 >= 1 and tokens[k0 - 1].tok == Tok.Ident("new") and tag_at(0) == "id"
        error_fix(
            "gram.foreign.1",
            tok_pos(k0 - 1),
            "AIL has no `new`",
            "construct a struct by calling its name: `Point(x: 1, y: 2)`",
            "remove `new`",
            [fix.delete(tok_pos(k0 - 1), pos)],
        )
        return true
    # `n > 0 ? a : b`
    if k0 >= 1 and tokens[k0 - 1].tok == Tok.Sym("?") and peek() != Tok.Newline
        error_text(
            "gram.foreign.1",
            tok_pos(k0 - 1),
            "AIL has no `?:` conditional operator",
            "use an `if` expression: `x := if n > 0 then a else b`",
            "",
        )
        if edits := ternary_edits(start, k0 - 1)
            attach("write it as `if c then a else b`", edits)
        return true
    # `(x) => x + 1` (ADR 1067: AIL writes `|x| x + 1`)
    if cur == "=>"
        error_text(
            "gram.foreign.1",
            pos,
            "AIL writes a function literal `|x| x + 1`, not `=>`",
            "put the parameters between bars and the body after them, on the same line",
            "",
        )
        if first := arrow_params(k0)
            names := [tok_text(tokens[k].tok) for k in first..k0 if tok_tag(tokens[k].tok) == "id"]
            head := "|{names.join(", ")}|"
            attach("write `{head}`", [fix.span(tokens[first].pos, tok_end(k0) else pos, head)])
        return true
    # `Point{x: 1}`
    if cur == "\{" and k0 >= 1 and upper_ident(tokens[k0 - 1].tok)
        error_text(
            "gram.foreign.1",
            pos,
            "AIL builds a struct with parentheses, not braces",
            "write `Point(x: 1, y: 2)`: the name, then `field: value` pairs in parentheses",
            "",
        )
        if close := matching(k0)
            cp := tokens[close].pos
            attach("use parentheses", [
                fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 1), "("),
                fix.span(cp, ast.Pos(line: cp.line, col: cp.col + 1), ")"),
            ])
        return true
    false

## The first token of the parameters before the `=>` at `k0`: the `(` of
## `(a, b) =>` or the name of `x =>`; `none` otherwise.
fn Parser.arrow_params(self, k0 int) int?
    if k0 >= 1 and tok_tag(tokens[k0 - 1].tok) == "id"
        return k0 - 1
    if k0 < 2 or tokens[k0 - 1].tok != Tok.Sym(")")
        return none
    mut k := k0 - 2
    while k >= 0
        t := tokens[k].tok
        if t == Tok.Sym("(")
            return k
        if tok_tag(t) != "id" and t != Tok.Sym(",")
            return none
        k -= 1
    none

fn upper_ident(t Tok) bool
    match t
        Ident(n) => n.chars().len() > 0 and n.chars()[0].is_upper()
        Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => false

## The source form of the bytes `hex` holds, between the quotes of `b"..."`.
fn bytes_source(hex str) str
    cs := hex.chars()
    mut out := List[str]()
    mut k := 0
    while k + 1 < cs.len()
        n := (cs[k].to_digit(16) else 0) * 16 + (cs[k + 1].to_digit(16) else 0)
        if n == 34 or n == 92
            out.push("\\{char.from_code(n) else ' '}")
        elif n >= 32 and n <= 126
            out.push("{char.from_code(n) else ' '}")
        else
            out.push("\\x{cs[k]}{cs[k + 1]}")
        k += 2
    out.join("")

## Whether token `k` starts exactly where the one before it ends.
fn Parser.touches(self, k int) bool
    e := tok_end(k - 1) else return false
    e == tokens[k].pos

## Whether a plain `=` follows on this line, outside brackets, from token `k`.
fn Parser.assign_ahead(self, k int) bool
    mut depth := 0
    mut j := k
    while j < tokens.len() and tokens[j].tok != Tok.Newline and tokens[j].tok != Tok.Eof
        t := tokens[j].tok
        if t == Tok.Sym("(") or t == Tok.Sym("[")
            depth += 1
        elif t == Tok.Sym(")") or t == Tok.Sym("]")
            depth -= 1
        elif t == Tok.Sym("=") and depth == 0
            return true
        j += 1
    false

## `name!(..)` or `name![..]` (a Rust macro call), with the `!` at token `k0`.
fn Parser.macro_call(mut self, k0 int) bool
    name := tok_text(tokens[k0 - 1].tok)
    npos := tok_pos(k0 - 1)
    bang := tok_pos(k0)
    bend := tok_end(k0) else bang
    paren := sym_at(1) == "("
    if name == "vec" and not paren
        error_fix(
            "gram.foreign.1",
            npos,
            "AIL has no `vec!`",
            "a list is a literal: `[1, 2]`; an empty one names its type: `List[int]()`",
            "write the list literal",
            [fix.delete(npos, bend)],
        )
    elif paren
        and (name == "println" or name == "print" or name == "eprintln" or name == "eprint" or name == "dbg")
        error_fix(
            "gram.foreign.1",
            npos,
            "AIL has no `{name}!`",
            "`print(value)` writes a value and a newline; text with values is interpolated: `print(\"n is \{n}\")`, with no `\{}` placeholders",
            "write `print`",
            [fix.span(npos, bend, "print")],
        )
    elif paren
        and (name == "assert" or name == "assert_eq" or name == "assert_ne" or name == "debug_assert")
        error_fix(
            "gram.foreign.1",
            npos,
            "AIL has no `{name}!`",
            "`assert(cond)` and `assert_eq(a, b)` are plain calls, in an `@test` function (spec chapter 19)",
            "remove the `!`",
            [fix.delete(bang, bend)],
        )
    elif paren and (name == "panic" or name == "unimplemented")
        error_fix(
            "gram.foreign.1",
            npos,
            "AIL has no `{name}!`",
            "stop the program with `unreachable(\"message\")`; a failure the caller can handle is an `error enum` returned with `T ! E`",
            "write `unreachable`",
            [fix.span(npos, bend, "unreachable")],
        )
    elif name == "format" or name == "write" or name == "writeln"
        error_text(
            "gram.foreign.1",
            npos,
            "AIL has no `{name}!`",
            "build text with interpolation: `s := \"\{a}-\{b}\"`, with the value inside the braces and no `\{}` placeholders; a width or precision goes after a colon: `\{x:>6}`, `\{x:.2}`",
            "",
        )
    elif name == "matches"
        error_text(
            "gram.foreign.1",
            npos,
            "AIL has no `matches!`",
            "test with `match v` and a `pattern => true` arm, `_ => false`; or compare with `==`",
            "",
        )
    else
        error_text(
            "gram.foreign.1",
            npos,
            "AIL has no macros: `{name}!` is not a call",
            "call a function without the `!`: `{name}(...)`; there is no compile-time code generation",
            "",
        )
    true

## `for (const x of xs)`: the edits that write `for x in xs`, at `(`.
fn Parser.js_for_edits(self) List[fix.Edit]?
    mut k := i + 1
    if tokens[k].tok == Tok.Ident("const")
        or tokens[k].tok == Tok.Ident("let")
        or tokens[k].tok == Tok.Ident("var")
        k += 1
    if tok_tag(tokens[k].tok) != "id"
        return none
    if tokens[k + 1].tok != Tok.Ident("of") and tokens[k + 1].tok != Tok.Kw("in")
        return none
    close := matching(i) else return none
    if tokens[close + 1].tok != Tok.Newline
        return none
    mut edits := [fix.delete(tok_pos(i), tok_pos(k))]
    if tokens[k + 1].tok == Tok.Ident("of")
        edits.push(fix.span(tok_pos(k + 1), tok_end(k + 1) else tok_pos(k + 1), "in"))
    edits.push(fix.delete(tok_pos(close), tok_end(close) else tok_pos(close)))
    edits

## `for i < 3` or `for i, x := range xs` (Go): the loop variable and
## perhaps one more name are read, and the parser is at the next token.
fn Parser.for_foreign(mut self, for_i int, names List[ast.Binder]) bool
    s := sym_at(0)
    if s == ":=" and tokens[i + 1].tok == Tok.Ident("range")
        error_text(
            "gram.foreign.1",
            tok_pos(for_i),
            "AIL has no `range` clause",
            "loop over the collection: `for x in xs`; with the index `for i, x in xs.enumerate()`; a count is `for i in 0..n`",
            "",
        )
        mut last := i + 1
        while tokens[last + 1].tok != Tok.Newline and tokens[last + 1].tok != Tok.Eof
            last += 1
        if last > i + 1 and names.len() == 2 and names[1].name != "_"
            tail := tok_end(last) else tok_pos(last)
            if names[0].name == "_"
                attach("write `for {names[1].name} in`", [fix.span(
                    tok_pos(for_i + 1),
                    tok_end(i + 1) else tok_pos(i + 1),
                    "{names[1].name} in",
                )])
            else
                attach("write `in` and `.enumerate()`", [
                    fix.span(tok_pos(i), tok_end(i + 1) else tok_pos(i + 1), "in"),
                    fix.insert(tail, ".enumerate()"),
                ])
        return true
    if s == "<" or s == "<=" or s == ">" or s == ">=" or s == "==" or s == "!="
        error_fix(
            "gram.foreign.1",
            tok_pos(for_i),
            "a `for` always has `in`: a loop on a condition is `while`",
            "write `while cond`; `for x in xs` is for each element of a collection or range",
            "write `while`",
            [fix.span(tok_pos(for_i), tok_end(for_i) else tok_pos(for_i), "while")],
        )
        return true
    false

## `fn (p P) name()`: Go's method receiver, at `(` after `fn`.
fn Parser.go_receiver(mut self) bool
    if not at_sym("(") or tag_at(1) != "id"
        return false
    mut t := i + 2
    if tokens[t].tok == Tok.Sym("*")
        t += 1
    if tok_tag(tokens[t].tok) != "id"
        or tokens[t + 1].tok != Tok.Sym(")")
        or tok_tag(tokens[t + 2].tok) != "id"
        return false
    tname := tok_text(tokens[t].tok)
    mname := tok_text(tokens[t + 2].tok)
    error_text(
        "gram.foreign.1",
        here(),
        "AIL declares a method as `fn {tname}.{mname}(self)`",
        "the type name goes before the method name and the receiver is the parameter `self`; inside, a field is `self.x` or just `x`: `fn {tname}.{mname}(self) T`",
        "",
    )
    skip_statement()
    true

## `Result[T, E]` at `Result`: the edits that write `T ! E`.
fn Parser.result_type_edits(self) List[fix.Edit]?
    close := matching(i + 1) else return none
    mut depth := 0
    mut comma := -1
    for k in i + 2..close
        t := tokens[k].tok
        if t == Tok.Sym("[") or t == Tok.Sym("(")
            depth += 1
        elif t == Tok.Sym("]") or t == Tok.Sym(")")
            depth -= 1
        elif t == Tok.Sym(",") and depth == 0
            if comma >= 0
                return none
            comma = k
    if comma < 0
        return none
    [
        fix.delete(tok_pos(i), tok_pos(i + 2)),
        fix.span(tok_pos(comma), tok_end(comma) else tok_pos(comma), " !"),
        fix.delete(tok_pos(close), tok_end(close) else tok_pos(close)),
    ]
