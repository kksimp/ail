## The AIL parser, in AIL (Stage 3, ADR 0371): tokens to the syntax tree
## of `compiler/ast/`, as the bootstrap's `parser.rs` builds it.
## `compiler/selfhost.ail parse FILE` prints the tree in the form of
## `ail api --ast FILE` (api.ast.1-2), and the selftest compares the two on
## every `.ail` file in the repository.
##
## Grammar rules: gram.fn.1-2, gram.list.1, gram.generic.1, gram.syntax.1,
## gram.attr.1-3, gram.foreign.1, gram.rec.1, lex.stmt.1, lex.kw.1,
## type.struct.1-3, type.enum.1-2, expr.bind.1-3, expr.if.1-6, expr.if.8,
## expr.loop.1-6, expr.match.1-9, expr.prec.1-2, expr.op.1, expr.comp.1-2,
## expr.key.1, gen.decl.1, gen.bound.1, gen.method.1-3, gen.infer.2,
## trait.decl.1-2, trait.impl.1, trait.any.1, trait.super.1, err.else.1-6,
## err.msg.1-2, err.prop.1, contract.decl.1, contract.ens.3, mod.use.1-2,
## mod.vis.1-2, mod.const.1, own.uniq.1, conc.par.5, conc.share.6,
## ct.derive.1.
use ast
use fix

## The tree of a file and the diagnostics found making it, in order.
pub struct Parsed
    pub program ast.Program
    pub diags List[Diag]

## How `header_tail` left the parser.
enum Header
    ## Not recognised: report the generic error.
    NotHeader
    ## Reported; stop parsing this statement.
    Reported
    ## Reported, and the line's end was consumed: the block follows.
    GoOn

## The `else` part of a binding, which may be absent (err.else.1-3).
struct ElsePart
    part ast.Else?

## A function's body and contract lines (contract.decl.1).
struct FnBody
    body List[ast.Stmt]?
    contracts List[ast.Contract]

struct Parser
    tokens List[Token]
    i int
    diags List[Diag]
    ## Parsing the expression inside a string's `{...}`, which ends at `}`.
    in_interp bool
    ## The names bound by `use` so far: `m.Stack[int]` is a qualified
    ## generic type, not an index (gen.infer.2, mod.use.2).
    aliases Set[str]
    ## The lines of `pub` markers (`Program.public`).
    public Set[int]
    ## Where each `uhwhatnow?` is (`Program.asks`, expr.hole.3).
    asks List[ast.Pos]
    generic_names Set[str]
    ## Parsing an `ensures` condition, and its `old(e)` calls (contract.ens.3).
    in_ensures bool
    olds List[ast.Old]
    fns List[ast.FnDecl]
    structs List[ast.StructDecl]
    enums List[ast.EnumDecl]
    traits List[ast.TraitDecl]
    impls List[ast.ImplDecl]
    consts List[ast.ConstDecl]
    uses List[ast.Use]
    ## The struct whose members are being parsed ("" outside one), for the
    ## fix that moves its methods out (type.struct.2).
    member_owner str

## The kind of a token, in one word.
fn tok_tag(t Tok) str
    match t
        Ident(_) => "id"
        Kw(_) => "kw"
        Sym(_) => "sym"
        Str(_) => "str"
        Bytes(_) => "bytes"
        Interp(_) => "interp"
        Char(_) => "char"
        Int(_) => "int"
        IntMin => "intmin"
        Float(_) => "float"
        Newline => "nl"
        Indent => "indent"
        Dedent => "dedent"
        Eof => "eof"

## The text of a name, keyword or symbol; "" for any other token.
fn tok_text(t Tok) str
    match t
        Ident(n) => n
        Kw(w) => w
        Sym(s) => s
        Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

## Keywords the spec defines that the bootstrap doesn't implement yet.
fn not_yet(k str) bool
    k == "as"

fn assign_op(s str) ast.BinOp?
    match s
        "+=" => ast.BinOp.Add
        "-=" => ast.BinOp.Sub
        "*=" => ast.BinOp.Mul
        "/=" => ast.BinOp.Div
        "%=" => ast.BinOp.Rem
        _ => none

## The bit operator of `&= |= ^= <<= >>=` (expr.bit.5), or "".
fn bit_assign(s str) str
    match s
        "&=" => "&"
        "|=" => "|"
        "^=" => "^"
        "<<=" => "<<"
        ">>=" => ">>"
        _ => ""

fn comparison(s str) ast.BinOp?
    match s
        "==" => ast.BinOp.Eq
        "!=" => ast.BinOp.Ne
        "<" => ast.BinOp.Lt
        "<=" => ast.BinOp.Le
        ">" => ast.BinOp.Gt
        ">=" => ast.BinOp.Ge
        _ => none

## Names declared generic (`fn f[`, `struct S[`, `enum E[`): after one of
## these, `[` starts type arguments rather than an index (gen.infer.2).
pub fn generic_names(tokens List[Token]) Set[str]
    mut names := {"List", "Map", "Set", "Channel", "Mutex", "Atomic"}
    for k in 2..tokens.len()
        a := tok_text(tokens[k - 2].tok)
        if tok_tag(tokens[k - 2].tok) == "kw"
            and (a == "fn" or a == "struct" or a == "enum")
            and tok_tag(tokens[k - 1].tok) == "id"
            and tok_tag(tokens[k].tok) == "sym"
            and tok_text(tokens[k].tok) == "["
            names.add(tok_text(tokens[k - 1].tok))
    names

fn new_parser(tokens List[Token], generic List[str]) Parser
    Parser(
        tokens: tokens,
        i: 0,
        diags: [],
        in_interp: false,
        aliases: Set[str](),
        public: Set[int](),
        asks: [],
        generic_names: Set[str](),
        in_ensures: false,
        olds: [],
        fns: [],
        structs: [],
        enums: [],
        traits: [],
        impls: [],
        consts: [],
        uses: [],
        member_owner: "",
    )

## Parse a file's tokens (the lexer's, ending in `Eof`).
pub fn parse(tokens List[Token]) Parsed
    parse_with(tokens, Set[str]())

## `parse` of a file whose module's other files declare generic names too:
## `extra` are theirs (`absent[int]()` in a file that doesn't declare `absent`).
pub fn parse_with(tokens List[Token], extra Set[str]) Parsed
    mut p := new_parser(tokens, [])
    p.generic_names = generic_names(tokens)
    for n in extra.sorted()
        p.generic_names.add(n)
    p.top_level()
    public := p.public.sorted()
    program := ast.Program(
        fns: p.fns,
        structs: p.structs,
        enums: p.enums,
        traits: p.traits,
        impls: p.impls,
        consts: p.consts,
        uses: p.uses,
        public: public,
        files: [],
        grants: [],
        unsafe_allowed: none,
        driver_allowed: [],
        generated: [],
        asks: p.asks,
    )
    Parsed(program: program, diags: p.diags)

fn Parser.top_level(mut self)
    while true
        tag := tok_tag(peek())
        text := tok_text(peek())
        if tag == "eof"
            break
        if tag == "nl" or tag == "dedent"
            i += 1
        elif tag == "indent"
            unexpected_indent()
            skip_block()
        elif tag == "kw" and text == "fn"
            if f := function(ast.Within.TopLevel)
                fns.push(f)
        elif tag == "kw"
            and (text == "unsafe" and kw_at(1) == "fn" or text == "extern" and at_extern_fn())
            if f := function(ast.Within.TopLevel)
                fns.push(f)
        elif tag == "kw" and text == "use"
            use_decl()
        elif tag == "kw" and text == "pub"
            pub_marker()
        elif tag == "id" and text == "export" and at_export_fn()
            if f := export_function()
                fns.push(f)
        elif tag == "sym" and text == "@"
            # `@derive(f) trait Name` (ct.derive.1), or `@name fn ...` (gram.attr.1-2).
            if not derive_trait()
                if f := attributed_function()
                    fns.push(f)
        elif tag == "kw" and text == "trait"
            trait_decl()
        elif tag == "kw" and text == "impl"
            impl_decl()
        elif tag == "id" and sym_at(1) == ":="
            # `NAME := expr`: a constant (mod.const.1).
            pos := bump().pos
            i += 1
            if value := expression()
                if eat_newline()
                    consts.push(ast.ConstDecl(name: text, pos: pos, doc: none, value: value))
                else
                    unexpected("end of line after the constant", "lex.stmt.1")
                    skip_statement()
            else
                skip_statement()
        elif tag == "kw" and text == "struct"
            if s := struct_decl(false)
                structs.push(s)
        elif tag == "kw" and text == "unique"
            # `unique struct` and `unique enum` (own.uniq.1).
            if kw_at(1) == "struct"
                i += 1
                if s := struct_decl(false)
                    mut u := s
                    u.is_unique = true
                    structs.push(u)
            elif kw_at(1) == "enum"
                i += 1
                if e := enum_decl(false)
                    mut u := e
                    u.is_unique = true
                    enums.push(u)
            else
                i += 1
                unexpected("`struct` or `enum` after `unique`", "own.uniq.1")
                skip_statement()
        elif tag == "kw" and text == "enum"
            if e := enum_decl(false)
                enums.push(e)
        elif tag == "kw" and text == "error"
            # `error struct` and `error enum` declare error types (err.decl.1).
            if kw_at(1) == "struct"
                i += 1
                if s := struct_decl(true)
                    structs.push(s)
            elif kw_at(1) == "enum"
                i += 1
                if e := enum_decl(true)
                    enums.push(e)
            else
                i += 1
                unexpected("`struct` or `enum` after `error`", "err.decl.1")
                skip_statement()
        elif tag == "kw" and text == "mut" and tag_at(1) == "id"
            error_text(
                "mod.const.1",
                here(),
                "there are no mutable top-level variables",
                "declare a constant `NAME := value`, or pass the value to the functions that change it",
                "",
            )
            skip_statement()
        elif tag == "id"
            and (text == "const" or text == "let" or text == "var")
            and tag_at(1) == "id"
            title := if sym_at(2) == "=" then "declare the constant with `:=`" else ""
            error_text(
                "mod.const.1",
                here(),
                "AIL has no `{text}`; a constant is declared `NAME := value`",
                "remove the keyword and write `NAME := value`",
                title,
            )
            if title != ""
                eq := tokens[i + 2].pos
                attach(title, [
                    fix.delete(here(), tokens[i + 1].pos),
                    fix.span(eq, ast.Pos(line: eq.line, col: eq.col + 1), ":="),
                ])
            skip_statement()
        elif tag == "id" and foreign_decl(text)
            i += 0
        else
            unexpected(
                "a declaration (`fn`, `struct`, `enum`, `error`, `unique`, `trait`, `impl` or a constant)",
                "gram.syntax.1",
            )
            skip_statement()

# ---- Tokens ----

fn Parser.peek(self) Tok
    tokens[i].tok

fn Parser.peek_at(self, n int) Tok
    k := i + n
    if k < tokens.len() then tokens[k].tok else tokens[tokens.len() - 1].tok

fn Parser.tag_at(self, n int) str
    tok_tag(peek_at(n))

## The symbol `n` tokens ahead, or "".
fn Parser.sym_at(self, n int) str
    match peek_at(n)
        Sym(s) => s
        Ident(_) | Kw(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

## The keyword `n` tokens ahead, or "".
fn Parser.kw_at(self, n int) str
    match peek_at(n)
        Kw(w) => w
        Ident(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

fn Parser.here(self) ast.Pos
    tokens[i].pos

fn Parser.tok_pos(self, k int) ast.Pos
    tokens[k.min(tokens.len() - 1)].pos

fn Parser.bump(mut self) Token
    t := tokens[i]
    if t.tok != Tok.Eof
        i += 1
    t

fn Parser.at_newline(self) bool
    peek() == Tok.Newline

fn Parser.eat_newline(mut self) bool
    if peek() == Tok.Newline
        i += 1
        return true
    false

fn Parser.eat_indent(mut self) bool
    if peek() == Tok.Indent
        i += 1
        return true
    false

fn Parser.eat_dedent(mut self) bool
    if peek() == Tok.Dedent
        i += 1
        return true
    false

fn Parser.at_sym(self, s str) bool
    sym_at(0) == s

fn Parser.eat_sym(mut self, s str) bool
    if sym_at(0) == s
        i += 1
        return true
    false

fn Parser.at_kw(self, k str) bool
    kw_at(0) == k

fn Parser.eat_kw(mut self, k str) bool
    if kw_at(0) == k
        i += 1
        return true
    false

## At a name: its text.
fn Parser.ident(self) str?
    if tag_at(0) == "id" then tok_text(peek()) else none

## The previous token closed a block, so the statement ended there.
fn Parser.after_block(self) bool
    i > 0 and tokens[i - 1].tok == Tok.Dedent

## Whether token `k + 1` follows token `k` with no blank between.
fn Parser.adjacent(self, k int) bool
    if k + 1 >= tokens.len()
        return false
    a := tokens[k].pos
    b := tokens[k + 1].pos
    a.line == b.line and b.col == a.col + 1

## Whether the token at `k` is the last one on its line.
fn Parser.line_ends_at(self, k int) bool
    if k + 1 >= tokens.len()
        return true
    tokens[k + 1].pos.line > tokens[k].pos.line or tokens[k + 1].tok == Tok.Eof

# ---- Diagnostics ----

fn Parser.diag(mut self, rule str, pos ast.Pos)
    diags.push(Diag(rule: rule, pos: pos, msg: "", fixed: false, help: "", fix: "", edits: []))

## The position of the next token when it is on the line of `at`, else `at`.
fn Parser.next_on_line(self, here_pos ast.Pos) ast.Pos
    if i + 1 < tokens.len() and tokens[i + 1].pos.line == here_pos.line
        return tokens[i + 1].pos
    here_pos

## `n` columns after `at`, or the next token's position when it is on the line.
fn Parser.after_on_line(self, here_pos ast.Pos, n int) ast.Pos
    if i + 1 < tokens.len() and tokens[i + 1].pos.line == here_pos.line
        return tokens[i + 1].pos
    ast.Pos(line: here_pos.line, col: here_pos.col + n)

## The end of token `k` on its line, when its text is known (identifiers, keywords, symbols).
## The edits of `{{x}}` in a string: `\{` for the first brace, and the last `}` goes.
fn escape_brace_edits(code List[Token]) List[fix.Edit]
    inner := code[0].pos
    mut edits := [fix.span(
        ast.Pos(line: inner.line, col: inner.col - 1),
        ast.Pos(line: inner.line, col: inner.col + 1),
        "\\\{",
    )]
    if code.len() >= 2
        last := code[code.len() - 2]
        if tok_tag(last.tok) == "sym" and tok_text(last.tok) == "}"
            edits.push(fix.delete(
                ast.Pos(line: last.pos.line, col: last.pos.col + 1),
                ast.Pos(line: last.pos.line, col: last.pos.col + 2),
            ))
    edits

fn Parser.tok_end(self, k int) ast.Pos?
    if k < 0 or k >= tokens.len()
        return none
    text := tok_text(tokens[k].tok)
    if text == ""
        return none
    ast.Pos(line: tokens[k].pos.line, col: tokens[k].pos.col + text.chars().len())

## Whether the previous token ends exactly at `at`.
fn Parser.attached_before(self, here_pos ast.Pos) bool
    e := tok_end(i - 1) else return false
    e == here_pos

## Give the diagnostic just reported a fix.
fn Parser.attach(mut self, title str, edits List[fix.Edit])
    diags[diags.len() - 1].fixed = true
    diags[diags.len() - 1].fix = title
    diags[diags.len() - 1].edits = edits

## A diagnostic with a fix. The same mistake again on one line is one
## diagnostic with one fix (gram.rec.1): `msg` identifies the mistake.
fn Parser.error_fix(
    mut self,
    rule str,
    pos ast.Pos,
    msg str,
    help str,
    title str,
    edits List[fix.Edit],
)
    if diags.len() > 0
        last := diags[diags.len() - 1]
        if last.rule == rule and last.pos.line == pos.line and last.msg == msg and last.fixed
            # The same mistake again on one line: its edits join the first report's.
            diags[diags.len() - 1].edits.extend(edits)
            return
    diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: true,
        help: help,
        fix: title,
        edits: edits,
    ))

## A diagnostic with the bootstrap's message, help line and fix title.
fn Parser.error_text(mut self, rule str, pos ast.Pos, msg str, help str, title str)
    diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: false,
        help: help,
        fix: title,
        edits: [],
    ))

fn Parser.int_too_big(mut self, pos ast.Pos)
    error_text(
        "lex.num.3",
        pos,
        "integer literal `9223372036854775808` doesn't fit in `int` (64-bit signed)",
        "",
        "",
    )

fn Parser.range_start_error(mut self, pos ast.Pos)
    error_text(
        "expr.match.12",
        pos,
        "only integer and character literals can start a range pattern",
        "write `lo..hi` or `lo..=hi` with literal ends",
        "",
    )

fn Parser.unexpected_indent(mut self)
    error_text(
        "lex.block.1",
        here(),
        "unexpected indentation",
        "only a line that opens a block (like `if`, `for` or `fn`) can be followed by an indented line",
        "",
    )

## How the Rust front end names a token in "expected X, found Y".
fn Parser.describe(self, t Tok) str
    match t
        Eof => if in_interp then "`}`" else "end of file"
        Ident(n) => "`{n}`"
        Kw(k) => "the keyword `{k}`"
        Sym(x) => "`{x}`"
        Str(_) | Interp(_) => "a string"
        Bytes(_) => "a `bytes` literal"
        Int(_) | IntMin => "an integer"
        Float(_) => "a number"
        Char(_) => "a character"
        Newline => "end of line"
        Indent => "an indented block"
        Dedent => "end of block"

## Report an unexpected token, preferring "not supported yet" for spec
## keywords the bootstrap doesn't implement.
fn Parser.unexpected(mut self, expected str, rule str)
    if tag_at(0) == "kw" and not_yet(kw_at(0))
        error_text(
            "bootstrap.unsupported",
            here(),
            "`{kw_at(0)}` is not supported by the bootstrap yet (spec ffi.decl.1)",
            "",
            "",
        )
        return
    error_text(rule, here(), "expected {expected}, found {describe(peek())}", "", "")

fn Parser.expect_sym(mut self, s str, expected str, rule str) bool?
    if eat_sym(s)
        return true
    unexpected(expected, rule)
    none

## Skip to the end of the current statement, including any indented
## blocks that follow it, so one error doesn't cascade.
fn Parser.skip_statement(mut self)
    while not stops(peek())
        i += 1
    eat_newline()
    while peek() == Tok.Indent
        skip_block()
        # `elif`/`else` continue the statement whose block was skipped.
        if at_kw("elif") or at_kw("else")
            while not stops(peek())
                i += 1
            eat_newline()

fn stops(t Tok) bool
    t == Tok.Newline or t == Tok.Indent or t == Tok.Dedent or t == Tok.Eof

## Skip an indented block, starting at its INDENT.
fn Parser.skip_block(mut self)
    if not eat_indent()
        return
    mut depth := 1
    while depth > 0 and peek() != Tok.Eof
        t := bump().tok
        if t == Tok.Indent
            depth += 1
        elif t == Tok.Dedent
            depth -= 1

## A name (not a keyword).
fn Parser.take_name(mut self, expected str, rule str) ast.Ident?
    if n := ident()
        pos := bump().pos
        return ast.Ident(name: n, pos: pos)
    if tag_at(0) == "kw" and not not_yet(kw_at(0))
        error_text(
            "lex.kw.1",
            here(),
            "`{kw_at(0)}` is a keyword and can't be used as a name",
            "choose a different name",
            "",
        )
        return none
    unexpected(expected, rule)
    none

## `Name`, or a qualified `m.Name` of an imported module (mod.use.2).
fn Parser.dotted_name(mut self, expected str, rule str) ast.Ident?
    first := take_name(expected, rule)?
    mut name := first.name
    while at_sym(".") and tag_at(1) == "id"
        i += 1
        next := take_name(expected, rule)?
        name = "{name}.{next.name}"
    ast.Ident(name: name, pos: first.pos)

# ---- Blocks ----

## NEWLINE INDENT statement+ DEDENT, after a line that opens a block.
fn Parser.block(mut self, after str, rule str) List[ast.Stmt]?
    if not eat_newline()
        match header_tail(after)
            GoOn => i += 0
            Reported => return none
            NotHeader =>
                unexpected("end of line after {after}", rule)
                return none
    if not eat_indent()
        error_text(
            rule,
            here(),
            "expected an indented block after {after}",
            "indent the block by 4 spaces",
            "",
        )
        return []
    block_rest()

## The statements of a block after its INDENT, through its DEDENT.
fn Parser.block_rest(mut self) List[ast.Stmt]
    mut body := List[ast.Stmt]()
    while peek() != Tok.Dedent and peek() != Tok.Eof
        if eat_newline()
            continue
        if s := statement()
            body.push(s)
    eat_dedent()
    body

# ---- Declarations ----

## `fn [Type.]name(params) [ReturnType]` and its body. In a trait, the
## body is optional (trait.decl.2).
fn Parser.function(mut self, within ast.Within) ast.FnDecl?
    f := function_inner(within)
    if f == none
        skip_statement()
    f

## `@name` or `@name(args)`, repeated, then a function (gram.attr.1-2).
fn Parser.attributed_function(mut self) ast.FnDecl?
    mut attrs := List[ast.Attr]()
    while at_sym("@")
        i += 1
        a := take_name("an attribute name after `@`", "gram.attr.1") else
            skip_statement()
            return none
        mut arg := absent[str]()
        mut listed := ""
        if at_sym("(")
            mut depth := 0
            while true
                t := peek()
                tag := tok_tag(t)
                if tag == "nl" or tag == "eof"
                    break
                match t
                    Str(text) =>
                        if depth == 1 and arg == none
                            arg = text
                    Ident(word) =>
                        if depth == 1
                            listed = "{listed}{word}"
                    Kw(word) =>
                        if depth == 1
                            listed = "{listed}{word}"
                    Sym(s) =>
                        if s == "("
                            depth += 1
                        elif s == ")"
                            depth -= 1
                        elif depth == 1 and (s == "." or s == ",")
                            listed = "{listed}{s}"
                    Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => i += 0
                i += 1
                if depth == 0
                    break
        # `@caps(fs, net.serve)` (eff.cap.6): the list is kept as `fs,net.serve`.
        if a.name == "caps" and listed != ""
            arg = listed
        attrs.push(ast.Attr(name: a.name, pos: a.pos, arg: arg))
        # gram.attr.2: an attribute may sit on its own line above its function.
        while at_newline()
            and (sym_at(1) == "@" or kw_at(1) == "fn" or kw_at(1) == "unsafe" or kw_at(1) == "extern")
            i += 1
    if not at_kw("fn") and not (at_kw("unsafe") and kw_at(1) == "fn") and not at_extern_fn()
        error_text(
            "gram.attr.2",
            here(),
            "an attribute applies to the function declared right after it",
            "write `@test fn name()` or put the function on the next line",
            "",
        )
        skip_statement()
        return none
    mut f := function(ast.Within.TopLevel)?
    # Keep the `variadic c` mark the signature added (ffi.var.1).
    mut all := attrs
    for a in f.attrs
        all.push(a)
    f.attrs = all
    f

## At `extern c ["lib"] fn`.
fn Parser.at_extern_fn(self) bool
    if not at_kw("extern") or tag_at(1) != "id"
        return false
    kw_at(2) == "fn" or tag_at(2) == "str" and kw_at(3) == "fn"

## At `export c ["symbol"] fn` (ffi.export.1).
fn Parser.at_export_fn(self) bool
    if tag_at(1) != "id"
        return false
    kw_at(2) == "fn" or tag_at(2) == "str" and kw_at(3) == "fn"

## `pub export c ["symbol"] fn name(params) Result` and its body: an ordinary
## function plus the attribute `@export` (ffi.export.1). The optional string
## is the C symbol; the default is the AIL name.
fn Parser.export_function(mut self) ast.FnDecl?
    had_pub := kw_at(-1) == "pub"
    kw_pos := bump().pos
    if not had_pub
        error_text(
            "ffi.export.1",
            kw_pos,
            "an exported function is public to C, so it needs `pub`",
            "write `pub export c fn name(params) Result`",
            "",
        )
    lang := take_name("`c` after `export`", "ffi.export.1")?
    if lang.name != "c"
        error_text(
            "ffi.export.1",
            lang.pos,
            "`export {lang.name}` is not supported",
            "write `pub export c fn name(params) Result`",
            "",
        )
        skip_statement()
        return none
    mut sym := absent[str]()
    match peek()
        Str(text) =>
            i += 1
            sym = text
        Ident(_) | Kw(_) | Sym(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => i += 0
    mut f := function(ast.Within.TopLevel)?
    f.attrs.push(ast.Attr(name: "export c", pos: kw_pos, arg: sym))
    f

fn in_trait(w ast.Within) bool
    match w
        InTrait(_) => true
        TopLevel | InImpl(_) => false

fn Parser.function_inner(mut self, within ast.Within) ast.FnDecl?
    mut unsafe_fn := false
    mut ext := absent[ast.Extern]()
    if eat_kw("unsafe")
        unsafe_fn = true
    elif at_kw("extern")
        kw_pos := bump().pos
        lang := take_name("`c` after `extern`", "ffi.decl.2")?
        if lang.name != "c"
            error_text(
                "ffi.decl.2",
                lang.pos,
                "`extern {lang.name}` is not supported",
                "write `extern c fn name(params) Result`",
                "",
            )
            return none
        mut lib := absent[str]()
        match peek()
            Str(text) =>
                i += 1
                lib = text
            Ident(_) | Kw(_) | Sym(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => i += 0
        if within != ast.Within.TopLevel
            error_text(
                "ffi.decl.2",
                kw_pos,
                "an `extern c fn` is declared at the top level",
                "move it out of the `trait` or `impl` block",
                "",
            )
            return none
        ext = ast.Extern(lib: lib)
    bump()
    first := take_name("a function name after `fn`", "gram.fn.1")?
    # `fn f[T](...)`, `fn Type.m(...)`, `fn Type[T Bound].m(...)` (gen.method.1-2).
    mut generics := List[ast.GenericParam]()
    if at_sym("[")
        generics = generic_params()?
    mut owner := none
    mut name := first.name
    mut pos := first.pos
    if eat_sym(".")
        mut params := none
        if generics.len() > 0
            params = generics
        generics = []
        m := take_name("a method name after `.`", "trait.method.1")?
        if at_sym("[")
            generics = generic_params()?
        if at_sym(".")
            error_text(
                "mod.unit.4",
                here(),
                "a method is declared in the module of its type",
                "move the method into the module that declares `{first.name}.{m.name}`",
                "",
            )
            return none
        owner = ast.Owner(name: first.name, pos: first.pos, params: params)
        name = m.name
        pos = m.pos
    if owner != none and within != ast.Within.TopLevel
        block := if in_trait(within) then "a `trait`" else "an `impl`"
        error_text(
            "trait.impl.1",
            pos,
            "functions in {block} block are written without a type name",
            "write `fn {name}(...)`",
            "",
        )
        return none
    expect_sym("(", "`(` after the function name", "gram.fn.1")?
    mut receiver := absent[ast.Receiver]()
    mut params := List[ast.Param]()
    mut variadic := false
    while not at_sym(")")
        if at_sym("..") and sym_at(1) == "."
            # ffi.var.1: `...` ends the parameters of an `extern c fn`, after at least one.
            if ext == none or params.len() == 0
                error_text(
                    "ffi.var.1",
                    here(),
                    "`...` ends the parameter list of an `extern c fn` that has a named parameter before it",
                    "write `extern c fn name(first i32, ...) Result`",
                    "",
                )
                return none
            i += 2
            variadic = true
            break
        is_self := at_kw("self") or (at_kw("mut") or at_kw("move")) and kw_at(1) == "self"
        if is_self
            mutable := eat_kw("mut")
            moved := not mutable and eat_kw("move")
            spos := bump().pos
            if owner == none and within == ast.Within.TopLevel
                error_text(
                    "trait.method.1",
                    spos,
                    "`self` is only allowed in methods",
                    "declare a method as `fn Type.{name}(self, ...)`",
                    "",
                )
            elif receiver != none or params.len() > 0
                error_text("trait.method.1", spos, "`self` must be the first parameter", "", "")
            elif moved and within != ast.Within.TopLevel
                error_text(
                    "bootstrap.unsupported",
                    spos,
                    "`move self` in a trait or `impl` block is not supported by the bootstrap yet (spec own.move.6, OQ-050)",
                    "declare it as an inherent method, `fn Type.{name}(move self)`",
                    "",
                )
                return none
            else
                receiver = ast.Receiver(mutable: mutable, moved: moved)
        else
            mutable := eat_kw("mut")
            moved := not mutable and eat_kw("move")
            p := take_name("a parameter name", "gram.fn.2")?
            if at_sym(":")
                error_fix(
                    "gram.fn.2",
                    here(),
                    "parameters are written `name Type`, without a colon",
                    "write `{p.name} <Type>`",
                    "remove the `:`",
                    [fix.span(here(), next_on_line(here()), " ")],
                )
                i += 1
            ty := type_ref("the parameter's type (written `name Type`)", "gram.fn.2")?
            params.push(ast.Param(name: p.name, pos: p.pos, mutable: mutable, moved: moved, ty: ty))
        if not eat_sym(",")
            break
    expect_sym(")", "`)` or `,` in the parameter list", "gram.fn.2")?
    if at_sym("->") or at_sym(":") and tag_at(1) != "nl"
        sym := if at_sym("->") then "->" else ":"
        error_fix(
            "gram.fn.2",
            here(),
            "there is no `{sym}`; the return type follows `)` directly",
            "remove the `{sym}`",
            "remove the `{sym}`",
            [fix.delete(here(), after_on_line(here(), sym.chars().len()))],
        )
        i += 1
    mut ret := none
    if tag_at(0) == "id"
        or at_sym("!")
        or at_sym("*")
        or at_sym("(")
        or at_kw("any")
        or at_kw("ref")
        or at_kw("fn")
        ret = type_ref("a return type", "gram.fn.2")?
    full := if o := owner then "`{o.name}.{name}`" else "`{name}`"
    # A trait method without a default ends with its signature (trait.decl.2).
    mut fb := FnBody(body: none, contracts: [])
    if ext != none and (owner != none or receiver != none or generics.len() > 0)
        error_text(
            "ffi.decl.2",
            pos,
            "an `extern c fn` is a plain function: no type, `self` or type parameters",
            "declare it as `extern c fn name(params) Result`, and wrap it in an AIL method",
            "",
        )
        return none
    if ext != none
        # ffi.decl.2: a C function has a signature and no body.
        if not eat_newline()
            unexpected("end of line after the signature of an `extern c fn`", "ffi.decl.2")
            return none
    elif in_trait(within) and tag_at(1) != "indent"
        if not eat_newline()
            unexpected("end of line after the signature", "trait.decl.1")
            return none
    else
        fb = fn_body("the signature of {full}", in_trait(within))?
    mut marks := List[ast.Attr]()
    if variadic
        marks.push(ast.Attr(name: "variadic c", pos: pos, arg: absent[str]()))
    ast.FnDecl(
        attrs: marks,
        owner: owner,
        name: name,
        pos: pos,
        doc: none,
        generics: generics,
        receiver: receiver,
        params: params,
        ret: ret,
        body: fb.body,
        within: within,
        contracts: fb.contracts,
        inherits: none,
        unsafe_fn: unsafe_fn,
        ext: ext,
    )

## `[T, U Bound + Bound]` (gen.decl.1, gen.bound.1).
fn Parser.generic_params(mut self) List[ast.GenericParam]?
    bump()
    mut params := List[ast.GenericParam]()
    while not at_sym("]")
        # gen.const.1: `const N int`, a const parameter.
        is_const := tag_at(0) == "id"
            and tok_text(peek()) == "const"
            and tag_at(1) == "id"
            and tag_at(2) == "id"
        if is_const
            bump()
        n := take_name("a type parameter name", "gen.decl.1")?
        mut bounds := List[ast.Ident]()
        if tag_at(0) == "id"
            bounds.push(dotted_name("a trait", "gen.bound.1")?)
            while eat_sym("+")
                bounds.push(dotted_name("a trait after `+`", "gen.bound.1")?)
        params.push(ast.GenericParam(name: n.name, pos: n.pos, bounds: bounds, is_const: is_const))
        if not eat_sym(",")
            break
    expect_sym("]", "`]` or `,` in the type parameters", "gen.decl.1")?
    params

## `trait Name` and its indented block of functions (trait.decl.1).
fn Parser.trait_decl(mut self)
    bump()
    n := take_name("a trait name after `trait`", "trait.decl.1") else
        skip_statement()
        return
    if at_sym("[")
        error_text(
            "bootstrap.unsupported",
            here(),
            "traits with type parameters are not designed yet (OQ-037)",
            "",
            "",
        )
        skip_statement()
        return
    # trait.super.1: `trait Ord Eq` and `trait Sorted Ord + ToStr`.
    mut supers := List[ast.Ident]()
    if tag_at(0) == "id"
        first := dotted_name("a supertrait", "trait.super.1") else
            skip_statement()
            return
        supers.push(first)
        while eat_sym("+")
            next := dotted_name("a supertrait after `+`", "trait.super.1") else
                skip_statement()
                return
            supers.push(next)
    index := traits.len()
    traits.push(ast.TraitDecl(
        name: n.name,
        pos: n.pos,
        doc: none,
        methods: [],
        derive: none,
        supers: supers,
    ))
    if not eat_newline()
        unexpected("end of line after `trait {n.name}`", "trait.decl.1")
        skip_statement()
        return
    # A trait with supertraits may have no methods (trait.super.1). (The
    # prelude's `Hash` has none either; a file alone is never the prelude.)
    if (n.pos.line >= 1073741824 or supers.len() > 0) and peek() != Tok.Indent
        return
    methods := fn_block(ast.Within.InTrait(index), "`trait {n.name}`")
    traits[index].methods = methods

## Whether a `trait` of this name is declared in the file.
fn Parser.trait_declared(self, name str) bool
    for k in 0..tokens.len() - 1
        if tokens[k].tok == Tok.Kw("trait") and tokens[k + 1].tok == Tok.Ident(name)
            return true
    false

## `impl Trait for Type`, with an optional block of functions (trait.impl.1).
fn Parser.impl_decl(mut self)
    pos := bump().pos
    trait_name := dotted_name("a trait name after `impl`", "trait.impl.1") else
        skip_statement()
        return
    if not eat_kw("for")
        if at_newline()
            error_text(
                "trait.impl.1",
                tokens[i - 1].pos,
                "`impl {trait_name.name}` needs `for Type`: `impl` implements a trait",
                "methods of a struct are plain functions: `fn {trait_name.name}.name(self) T`",
                "",
            )
            declared := trait_declared(trait_name.name)
            if tag_at(1) == "indent" and not declared
                if moved := methods_out(i + 2, trait_name.name)
                    mut edits := moved
                    edits.push(fix.delete(
                        ast.Pos(line: pos.line, col: 1),
                        ast.Pos(line: pos.line + 1, col: 1),
                    ))
                    attach(
                        "move the methods out of the `impl` block and name the type in each",
                        edits,
                    )
        else
            unexpected("`for` after the trait name", "trait.impl.1")
        skip_statement()
        return
    target := dotted_name("the implementing type after `for`", "trait.impl.1") else
        skip_statement()
        return
    mut params := none
    if at_sym("[")
        ps := generic_params() else
            skip_statement()
            return
        params = ps
    index := impls.len()
    owner := ast.Owner(name: target.name, pos: target.pos, params: params)
    impls.push(ast.ImplDecl(
        trait_name: trait_name.name,
        trait_pos: trait_name.pos,
        target: owner,
        pos: pos,
        methods: [],
        uses: [],
    ))
    if not eat_newline()
        unexpected("end of line after the `impl`", "trait.impl.1")
        skip_statement()
        return
    if peek() == Tok.Indent
        if trait_name.name == "Hash" and uses_next()
            impls[index].uses = hash_uses()
        else
            methods := fn_block(ast.Within.InImpl(index), "the `impl`")
            impls[index].methods = methods

## Whether the block after an `impl` line starts with the word `uses`.
fn Parser.uses_next(self) bool
    match peek_at(1)
        Ident(s) => s == "uses"
        Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => false

## The indented line `uses a, b` of an `impl Hash` block: the fields that
## take part in the hash (trait.hash.1).
fn Parser.hash_uses(mut self) List[ast.Ident]
    mut out := List[ast.Ident]()
    eat_indent()
    bump()
    while true
        n := take_name("a field name after `uses`", "trait.hash.1") else break
        out.push(n)
        if not eat_sym(",")
            break
    eat_newline()
    while peek() != Tok.Dedent and peek() != Tok.Eof
        unexpected("the end of the `impl Hash` block, which holds one `uses` line", "trait.hash.1")
        skip_statement()
    eat_dedent()
    out

## The indented functions of a `trait` or `impl` block; their indexes in `fns`.
fn Parser.fn_block(mut self, within ast.Within, what str) List[int]
    mut indexes := List[int]()
    if not eat_indent()
        if in_trait(within)
            error_text(
                "trait.decl.1",
                here(),
                "{what} needs an indented block of methods",
                "indent each method by 4 spaces",
                "",
            )
        return indexes
    while peek() != Tok.Dedent and peek() != Tok.Eof
        if eat_newline()
            continue
        member_pub("trait and `impl` methods")
        if not at_kw("fn")
            unexpected("a method (`fn ...`) in {what}", "trait.decl.1")
            skip_statement()
            continue
        if f := function(within)
            indexes.push(fns.len())
            fns.push(f)
    eat_dedent()
    indexes

## A type: `T`, `T?`, `T ! E`, `T ! A | B`, `!T`, or a bare `!`
## (type.opt.2, err.type.1-2, err.type.5).
fn Parser.type_ref(mut self, expected str, rule str) ast.TypeRef?
    pos := here()
    if eat_sym("!")
        mut ok := none
        if tag_at(0) == "id"
            ok = optional_type(expected, rule)?
        elif at_kw("any")
            ok = type_ref(expected, rule)?
        # `! A | B`: no success value, and these errors (err.type.7).
        if first := ok
            if at_sym("|")
                mut errors := [first]
                while eat_sym("|")
                    errors.push(named_type("an error type after `|`", "err.type.5")?)
                return ast.TypeRef(
                    shape: ast.TypeShape.Fallible(ok: none, errors: errors),
                    pos: pos,
                )
        return ast.TypeRef(shape: ast.TypeShape.Fallible(ok: ok, errors: none), pos: pos)
    if eat_kw("any")
        t := dotted_name("a trait after `any`", "trait.any.1")?
        return ast.TypeRef(shape: ast.TypeShape.AnyTrait(t.name), pos: pos)
    ok := optional_type(expected, rule)?
    if not eat_sym("!")
        return ok
    mut errors := [named_type("an error type after `!`", "err.type.1")?]
    while eat_sym("|")
        errors.push(named_type("an error type after `|`", "err.type.5")?)
    ast.TypeRef(shape: ast.TypeShape.Fallible(ok: ok, errors: errors), pos: pos)

## `T` or `T?` (type.opt.2); `T??` is an optional of an optional (type.opt.6).
fn Parser.optional_type(mut self, expected str, rule str) ast.TypeRef?
    mut t := named_type(expected, rule)?
    while eat_sym("?")
        t = ast.TypeRef(shape: ast.TypeShape.Optional(t), pos: t.pos)
    t

## `Name` or `Name[Arg, ...]` (gram.generic.1), a module's type `m.Name`
## (mod.use.2), or `ref T` (own.ref.1).
fn Parser.named_type(mut self, expected str, rule str) ast.TypeRef?
    if at_kw("ref")
        pos := bump().pos
        inner := named_type("a type after `ref`", "own.ref.1")?
        return ast.TypeRef(shape: ast.TypeShape.RefTo(inner), pos: pos)
    if at_sym("*")
        pos := bump().pos
        inner := named_type("a type after `*`", "unsafe.ptr.1")?
        return ast.TypeRef(shape: ast.TypeShape.PtrTo(inner), pos: pos)
    # `(A, B)`: a tuple type, two or more elements (type.tuple.1).
    if at_sym("(")
        pos := bump().pos
        mut elems := List[ast.TypeRef]()
        while not at_sym(")")
            elems.push(type_ref("an element type", "type.tuple.1")?)
            if not eat_sym(",")
                break
        expect_sym(")", "`)` or `,` in the tuple type", "type.tuple.1")?
        if elems.len() < 2
            error_text(
                "type.tuple.1",
                pos,
                "a tuple type has two or more elements",
                "write the element type alone, or `(A, B)`",
                "",
            )
            return none
        return ast.TypeRef(shape: ast.TypeShape.TupleType(elems), pos: pos)
    # `fn(A, B) R`: a function value's type (type.fn.1).
    if at_kw("fn")
        pos := bump().pos
        expect_sym("(", "`(` after `fn` in a type", "type.fn.1")?
        mut params := List[ast.TypeRef]()
        while not at_sym(")")
            params.push(type_ref("a parameter type", "type.fn.1")?)
            if not eat_sym(",")
                break
        expect_sym(")", "`)` or `,` in the function type", "type.fn.1")?
        if at_sym("->")
            # The result type follows `)` directly, as in a declaration (gram.fn.2).
            arrow := here()
            error_fix(
                "gram.fn.2",
                arrow,
                "there is no `->` in a function type; the result type follows `)` directly",
                "write `fn(int) int`",
                "remove the `->`",
                [fix.delete(arrow, after_on_line(arrow, 2))],
            )
            return none
        mut ret := absent[ast.TypeRef]()
        if tag_at(0) == "id" or at_sym("(") or at_kw("any") or at_kw("ref")
            ret = optional_type("the result type", "type.fn.1")?
        # `fn(A) R ! E` and `fn(A) ! E`: a function value that can fail (type.fn.6, ADR 1067).
        if at_sym("!")
            bang := bump().pos
            mut errors := [named_type("an error type after `!`", "type.fn.6")?]
            while eat_sym("|")
                errors.push(named_type("an error type after `|`", "err.type.5")?)
            ret = ast.TypeRef(shape: ast.TypeShape.Fallible(ok: ret, errors: errors), pos: bang)
        return ast.TypeRef(shape: ast.TypeShape.FnType(params: params, ret: ret), pos: pos)
    n := dotted_name(expected, rule)?
    mut args := List[ast.TypeRef]()
    if at_sym("<")
        error_text(
            "gram.generic.1",
            here(),
            "type arguments are written in square brackets",
            "write `{n.name}[...]`",
            "",
        )
        return none
    if eat_sym("[")
        while true
            args.push(type_arg("gram.generic.1")?)
            if not eat_sym(",") or at_sym("]")
                break
        expect_sym("]", "`]` after the type arguments", "gram.generic.1")?
    ast.TypeRef(shape: ast.TypeShape.Named(name: n.name, args: args), pos: n.pos)

## `name Type`, a field of a struct or of a variant (type.struct.2, type.enum.2).
fn Parser.field_decl(mut self, rule str) ast.Field?
    mut observe := false
    if at_sym("@")
        i += 1
        a := take_name("an attribute name after `@`", "gram.attr.6")?
        if a.name != "observe"
            error_text(
                "gram.attr.6",
                a.pos,
                "`@{a.name}` doesn't apply to a field; the only field attribute is `@observe`",
                "write `@observe name Type`, or remove the attribute",
                "",
            )
            return none
        observe = true
    field_pub(rule)
    if at_kw("fn")
        msg := "methods aren't declared inside a struct"
        help := "declare the method after the struct, with the type's name: `fn Name.method(self) T`"
        # Methods are the last members, so they move out where they stand.
        if member_owner != "" and here().col == 5
            if moved := methods_out(i, member_owner)
                error_fix(
                    rule,
                    here(),
                    msg,
                    help,
                    "move the methods after the struct and name the type in each",
                    moved,
                )
                return none
        error_text(rule, here(), msg, help, "")
        return none
    f := take_name("a field name", rule)?
    if at_sym(":")
        error_fix(
            rule,
            here(),
            "fields are written `name Type`, without a colon",
            "write `{f.name} <Type>`",
            "remove the `:`",
            [fix.span(here(), next_on_line(here()), " ")],
        )
        i += 1
    ty := type_ref("the field's type (written `name Type`)", rule)?
    ast.Field(name: f.name, pos: f.pos, doc: none, ty: ty, observe: observe)

## `struct Name` and one `name Type` field per line (type.struct.1-2).
fn Parser.struct_decl(mut self, is_error bool) ast.StructDecl?
    bump()
    n := take_name("a struct name after `struct`", "type.struct.1") else
        skip_statement()
        return none
    mut generics := List[ast.GenericParam]()
    if at_sym("[")
        g := generic_params() else
            skip_statement()
            return none
        generics = g
    whole := error_message(is_error)
    mut fields := List[ast.Field]()
    mut invariants := List[ast.Contract]()
    # err.msg.1: an error struct with a message may have no fields.
    bare := whole != none and at_newline() and tag_at(1) != "indent"
    if bare
        bump()
    elif members_open("type.struct.1", "`struct {n.name}`")
        member_owner = n.name
        while peek() != Tok.Dedent and peek() != Tok.Eof
            if eat_newline()
                continue
            mut ok := false
            if at_kw("invariant")
                if c := contract_line(false)
                    invariants.push(c)
                    ok = true
            elif f := field_decl("type.struct.2")
                fields.push(f)
                ok = true
            member_end(ok)
        member_owner = ""
        eat_dedent()
    if whole != none
        splice_messages(n.name, n.pos, generics.len() > 0, [], whole)
    ast.StructDecl(
        name: n.name,
        pos: n.pos,
        doc: none,
        is_error: is_error,
        is_unique: false,
        generics: generics,
        fields: fields,
        invariants: invariants,
    )

## A variant's name, its fields and its message (err.msg.1).
struct VariantMessage
    name str
    fields List[str]
    message Token?

## `enum Name` and one variant per line (type.enum.1-2).
fn Parser.enum_decl(mut self, is_error bool) ast.EnumDecl?
    bump()
    n := take_name("an enum name after `enum`", "type.enum.1") else
        skip_statement()
        return none
    mut generics := List[ast.GenericParam]()
    if at_sym("[")
        g := generic_params() else
            skip_statement()
            return none
        generics = g
    mut variants := List[ast.Variant]()
    mut messages := List[VariantMessage]()
    if members_open("type.enum.1", "`enum {n.name}`")
        while peek() != Tok.Dedent and peek() != Tok.Eof
            if eat_newline()
                continue
            mut ok := false
            if v := variant(is_error, mut messages)
                variants.push(v)
                ok = true
            member_end(ok)
        eat_dedent()
    splice_messages(n.name, n.pos, generics.len() > 0, messages, none)
    ast.EnumDecl(
        name: n.name,
        pos: n.pos,
        doc: none,
        is_error: is_error,
        is_unique: false,
        generics: generics,
        variants: variants,
    )

fn Parser.variant(mut self, is_error bool, mut messages List[VariantMessage]) ast.Variant?
    member_pub("enum variants")
    v := take_name("a variant name", "type.enum.1")?
    mut fields := List[ast.Field]()
    if eat_sym("(")
        while not at_sym(")")
            fields.push(field_decl("type.enum.2")?)
            if not eat_sym(",")
                break
        expect_sym(")", "`)` or `,` in the variant's fields", "type.enum.2")?
    messages.push(VariantMessage(
        name: v.name,
        fields: [f.name for f in fields],
        message: error_message(is_error),
    ))
    ast.Variant(name: v.name, pos: v.pos, doc: none, fields: fields)

## The start of an indented block of one-line members: whether it opened.
fn Parser.members_open(mut self, rule str, what str) bool
    if not eat_newline()
        unexpected("end of line after {what}", rule)
        skip_statement()
        return false
    if not eat_indent()
        error_text(
            rule,
            here(),
            "{what} needs an indented block of members",
            "indent each member by 4 spaces",
            "",
        )
        return false
    true

## After a member: its line must end (lex.stmt.1).
fn Parser.member_end(mut self, ok bool)
    if ok and eat_newline()
        return
    if diags.len() == 0 or diags[diags.len() - 1].pos.line != here().line
        unexpected("end of line", "lex.stmt.1")
    skip_statement()

# ---- Statements ----

## A statement ends at the end of its line (lex.stmt.1), or with its block.
fn Parser.statement(mut self) ast.Stmt?
    if peek() == Tok.Indent
        unexpected_indent()
        skip_block()
        return none
    if misplaced_contract()
        return none
    errors_before := diags.len()
    start := i
    if s := statement_inner()
        if after_block() or eat_newline()
            return s
        if not stray_after_statement(start)
            unexpected("end of line after the statement", "lex.stmt.1")
        skip_statement()
        return none
    if diags.len() == errors_before
        unexpected("a statement", "gram.syntax.1")
    skip_statement()
    none

fn Parser.statement_inner(mut self) ast.Stmt?
    pos := here()
    tag := tag_at(0)
    text := tok_text(peek())
    if tag == "kw" and text == "defer"
        # `defer S` (own.defer.1).
        bump()
        inner := statement_inner()?
        return ast.Stmt.Defer(stmt: inner, pos: pos)
    if tag == "kw" and text == "mut" and tag_at(1) == "id" and sym_at(2) == ","
        bump()
        n := take_name("a binding name after `mut`", "expr.bind.2")?
        return let_tuple(ast.Binder(name: n.name, pos: n.pos, mutable: true))
    if tag == "id" and sym_at(1) == "," and at_let_tuple()
        i += 1
        return let_tuple(ast.Binder(name: text, pos: pos, mutable: false))
    if tag == "kw" and text == "mut"
        bump()
        n := take_name("a binding name after `mut`", "expr.bind.2")?
        expect_sym(":=", "`:=` after the name", "expr.bind.2")?
        value := expression_plain()?
        e := otherwise()?
        return ast.Stmt.Let(
            name: n.name,
            pos: n.pos,
            mutable: true,
            value: value,
            otherwise: e.part,
        )
    if tag == "id" and sym_at(1) == ":="
        i += 2
        value := expression_plain()?
        e := otherwise()?
        return ast.Stmt.Let(name: text, pos: pos, mutable: false, value: value, otherwise: e.part)
    if tag == "id" and (text == "let" or text == "var" or text == "const") and tag_at(1) == "id"
        title := if sym_at(2) == "=" then "declare it with `:=`" else ""
        error_text(
            "expr.bind.1",
            pos,
            "AIL has no `{text}`; bindings are declared with `:=`",
            "write `name := value`, or `mut name := value` to allow reassignment",
            title,
        )
        if title != ""
            eq := tokens[i + 2].pos
            first := if text == "var" then fix.span(
                pos,
                ast.Pos(line: pos.line, col: pos.col + 3),
                "mut",
            ) else fix.delete(pos, tokens[i + 1].pos)
            attach(title, [first, fix.span(eq, ast.Pos(line: eq.line, col: eq.col + 1), ":=")])
        return none
    if tag == "kw" and sym_at(1) == ":=" and not not_yet(text)
        error_text(
            "lex.kw.1",
            pos,
            "`{text}` is a keyword and can't be used as a name",
            "choose a different name",
            "",
        )
        return none
    if tag == "kw" and text == "while"
        bump()
        cond := range()?
        body := block("the `while` condition", "expr.loop.1")?
        return ast.Stmt.While(cond: cond, body: body, pos: pos)
    if tag == "kw" and text == "for"
        return for_loop(false, pos)
    if tag == "kw" and text == "with"
        return with_stmt(pos)
    if tag == "kw" and text == "unsafe" and kw_at(1) != "fn"
        # unsafe.block.1: `unsafe` and an indented block.
        bump()
        body := block("`unsafe`", "unsafe.block.1")?
        return ast.Stmt.Unsafe(body: body, pos: pos)
    if tag == "kw" and text == "par"
        # conc.par.5: `par for` asserts that the iterations are independent.
        bump()
        if not at_kw("for")
            unexpected("`for` after `par`", "conc.par.5")
            return none
        return for_loop(true, pos)
    if tag == "kw" and text == "break"
        bump()
        return ast.Stmt.Break(pos)
    if tag == "kw" and text == "continue"
        bump()
        return ast.Stmt.Continue(pos)
    if tag == "kw" and text == "return"
        bump()
        t := tag_at(0)
        if t == "nl" or t == "dedent" or t == "eof"
            return ast.Stmt.Return(value: none, pos: pos)
        value := expression()?
        return ast.Stmt.Return(value: value, pos: pos)
    if tag == "kw" and (text == "elif" or text == "else")
        error_text(
            "expr.if.1",
            pos,
            "`{text}` without a matching `if`",
            "line it up with its `if` (or with the statement the `if` starts in)",
            "",
        )
        return none
    if foreign_stmt()
        return none
    target := expression_plain()?
    # `f(x) else ...` handles a failure with no success value (err.else.5);
    # `e else d` gives a value (err.else.6).
    if at_kw("else")
        leaves := kw_at(1) == "return" or kw_at(1) == "break" or kw_at(1) == "continue"
        if not else_block_follows() and not leaves
            return ast.Stmt.Eval(else_expr(target)?)
        e := otherwise()?
        if part := e.part
            return ast.Stmt.Handle(value: target, otherwise: part)
        return none
    s := sym_at(0)
    if bit_assign(s) != ""
        return bit_assignment(target, s)
    if s == "=" or assign_op(s) != none
        apos := bump().pos
        value := expression()?
        return ast.Stmt.Assign(target: target, op: assign_op(s), value: value, pos: apos)
    if s == ":="
        error_text("expr.bind.1", here(), "only a plain name can be declared with `:=`", "", "")
        return none
    ast.Stmt.Eval(target)

## `x &= e` and the other four bit forms (expr.bit.5): `x = x & e` for a plain
## name `x`. A place with an index or a field is written out in full.
fn Parser.bit_assignment(mut self, target ast.Expr, s str) ast.Stmt?
    apos := bump().pos
    op := bit_assign(s)
    if name_of(target) != none
        value := expression()?
        arg := ast.Arg(label: none, mutable: false, moved: false, value: value, param: none)
        call := ast.Expr.Method(recv: target, name: bit_method(op), name_pos: apos, args: [arg])
        return ast.Stmt.Assign(target: target, op: none, value: call, pos: apos)
    error_text(
        "expr.bit.5",
        apos,
        "`{s}` works on a plain name",
        "write the place twice: `a[i] = a[i] {op} e` (expr.bit.5)",
        "",
    )
    none

## `for x in e` or `for mut x in e` (expr.loop.1, expr.loop.6), at `for`.
fn Parser.for_loop(mut self, is_par bool, pos ast.Pos) ast.Stmt?
    bump()
    mutable := eat_kw("mut")
    if at_sym("(")
        error_text(
            "expr.loop.1",
            here(),
            "AIL has no C-style `for`",
            "loop over a range: `for i in 0..n` (excludes `n`) or `for i in 1..=n` (includes it); use `while` for other conditions",
            "write the range loop",
        )
        attach("write the range loop", [fix.c_for(here())])
        return none
    v := take_name("a loop variable after `for`", "expr.loop.1")?
    mut var := v.name
    # type.tuple.5: `for a, b in xs` takes each element apart.
    mut unpack := List[ast.Binder]()
    if at_sym(",")
        if mutable
            error_text(
                "type.tuple.5",
                here(),
                "`for mut` has one variable",
                "loop with `for a, b in xs` and assign through an index to change the list",
                "",
            )
            return none
        unpack = more_binders(ast.Binder(name: v.name, pos: v.pos, mutable: false), "type.tuple.5")?
        var = hidden_name(unpack)
    if not eat_kw("in")
        unexpected("`in` after the loop variable", "expr.loop.1")
        return none
    iter := range()?
    # err.else.6: `for x in xs else []` (ADR 0252).
    iter2 := else_expr(iter)?
    mut body := block("the `for` header", "expr.loop.1")?
    if unpack.len() > 0
        value := ast.Expr.Name(name: var, pos: v.pos)
        body.insert(0, ast.Stmt.LetTuple(names: unpack, value: value, pos: v.pos))
    ast.Stmt.For(
        is_par: is_par,
        var: var,
        var_pos: v.pos,
        mutable: mutable,
        iter: iter2,
        body: body,
        pos: pos,
    )

## After the first name of `a, b := e` or `for a, b in`, at `,`: the first
## and the other names, each `mut` only in a binding (type.tuple.4).
fn Parser.more_binders(mut self, first ast.Binder, rule str) List[ast.Binder]?
    mut names := [first]
    while eat_sym(",")
        mutable := rule == "type.tuple.4" and eat_kw("mut")
        n := take_name("a name or `_` for the element", rule)?
        names.push(ast.Binder(name: n.name, pos: n.pos, mutable: mutable))
    names

## At `a, b, ... :=`: names, each maybe `mut`, then `:=` on this line.
fn Parser.at_let_tuple(self) bool
    mut k := 0
    while true
        if kw_at(k) == "mut"
            k += 1
        if tag_at(k) != "id"
            return false
        s := sym_at(k + 1)
        if s == ","
            k += 2
        elif s == ":="
            return true
        else
            return false
    false

## `a, mut b := e` after the first name, at `,` (type.tuple.4).
fn Parser.let_tuple(mut self, first ast.Binder) ast.Stmt?
    names := more_binders(first, "type.tuple.4")?
    expect_sym(":=", "`:=` after the names", "type.tuple.4")?
    value := expression()?
    ast.Stmt.LetTuple(names: names, value: value, pos: first.pos)

## The hidden variable of `for a, b in xs` (type.tuple.5): `(a, b)`, which
## no program can name.
fn hidden_name(names List[ast.Binder]) str
    "({[b.name for b in names].join(", ")})"

## The `else` part of a binding, if any (err.else.1-3); `none` after a
## syntax error.
fn Parser.otherwise(mut self) ElsePart?
    if not at_kw("else")
        return ElsePart(part: none)
    pos := bump().pos
    if at_newline()
        body := block("`else`", "err.else.2")?
        return ElsePart(part: ast.Else.Handler(err: none, body: body, pos: pos))
    if n := ident()
        if tag_at(1) == "nl" and tag_at(2) == "indent"
            err_pos := bump().pos
            body := block("`else {n}`", "err.else.3")?
            return ElsePart(part: ast.Else.Handler(
                err: ast.Ident(name: n, pos: err_pos),
                body: body,
                pos: pos,
            ))
    k := kw_at(0)
    if k == "return" or k == "break" or k == "continue"
        s := statement_inner()?
        return ElsePart(part: ast.Else.Leave(s))
    value := expression()?
    ElsePart(part: ast.Else.Fallback(value))

# ---- Expressions, loosest binding first (expr.prec.1) ----

## An expression, which may end in an `else` fallback (err.else.6).
fn Parser.expression(mut self) ast.Expr?
    value := expression_plain()?
    else_expr(value)

## An expression without a trailing `else`.
fn Parser.expression_plain(mut self) ast.Expr?
    if at_kw("if")
        return if_expr()
    if at_kw("match")
        return match_expr()
    if at_sym("|") or at_sym("||")
        return closure()
    if lambda_colon() > 0
        return python_lambda()
    range()

## Python's `lambda x, y: e` ahead: the offset of its `:`, else 0.
fn Parser.lambda_colon(self) int
    if tag_at(0) != "id" or tok_text(peek()) != "lambda"
        return 0
    mut k := 1
    while tag_at(k) == "id"
        k += 1
        if sym_at(k) != ","
            break
        k += 1
    if sym_at(k) == ":" then k else 0

## `lambda x: e` (gram.foreign.1, ADR 1067): reported with the AIL form
## `|x| e`, with a fix, and parsed as that function literal.
fn Parser.python_lambda(mut self) ast.Expr?
    pos := here()
    colon := i + lambda_colon()
    mut params := List[ast.ClosureParam]()
    mut names := List[str]()
    i += 1
    while i < colon
        if tag_at(0) == "id"
            params.push(ast.ClosureParam(
                name: tok_text(peek()),
                pos: here(),
                ty: absent[ast.TypeRef](),
            ))
            names.push(tok_text(peek()))
        i += 1
    i += 1
    head := "|{names.join(", ")}|"
    error_text(
        "gram.foreign.1",
        pos,
        "AIL has no `lambda`; a function literal is written `{head} ...`",
        "the parameters go between bars and the body follows on the same line, `|x| x + 1`",
        "write `{head}`",
    )
    attach("write `{head}`", [fix.span(pos, tok_end(colon) else here(), head)])
    body := expression()?
    ast.Expr.Closure(params: params, body: body, pos: pos)

## `|a, b| e`, `|x int| e` or `|| e`: a function literal whose body is one
## expression, running to the end of the expression (type.fn.4, ADR 1067).
fn Parser.closure(mut self) ast.Expr?
    pos := here()
    mut params := List[ast.ClosureParam]()
    if not eat_sym("||")
        i += 1
        while not at_sym("|")
            if tag_at(0) != "id"
                # A `|` where an operand is expected and no parameter follows (ADR 1067).
                error_text(
                    "type.fn.4",
                    here(),
                    "expected a parameter name or `|` in a function literal, found {describe(peek())}",
                    "a `|` before an operand opens a function literal `|x| x + 1`; bit-or goes between two operands, `a | b`",
                    "",
                )
                return none
            p := take_name("a parameter name", "type.fn.4")?
            mut ty := absent[ast.TypeRef]()
            if not at_sym(",") and not at_sym("|")
                ty = type_ref("the parameter's type", "type.fn.4")?
            params.push(ast.ClosureParam(name: p.name, pos: p.pos, ty: ty))
            if not eat_sym(",")
                break
        expect_sym("|", "`|` after the function literal's parameters", "type.fn.4")?
    if at_newline() or peek() == Tok.Eof
        error_text(
            "type.fn.4",
            here(),
            "a function literal's body is one expression on the same line",
            "write `|x| x + 1`; for a longer body, declare a function and call it from the literal",
            "",
        )
        return none
    body := expression()?
    ast.Expr.Closure(params: params, body: body, pos: pos)

## The `for x in xs [if c]` clauses of a comprehension (expr.comp.2).
fn Parser.comp_clauses(mut self) List[ast.CompFor]?
    mut clauses := List[ast.CompFor]()
    while true
        # conc.par.12: `[e par for x in xs]` computes the elements on the pool.
        is_par := at_comp_for() and eat_kw("par")
        if not eat_kw("for")
            break
        if at_kw("mut")
            error_text(
                "expr.comp.2",
                here(),
                "a comprehension's variable can't be `mut`",
                "use a `for mut` loop to change elements in place",
                "",
            )
            return none
        v := take_name("a variable after `for`", "expr.comp.2")?
        mut var := v.name
        # type.tuple.5: `[e for a, b in xs]`.
        mut unpack := List[ast.Binder]()
        if at_sym(",")
            unpack = more_binders(
                ast.Binder(name: v.name, pos: v.pos, mutable: false),
                "type.tuple.5",
            )?
            var = hidden_name(unpack)
        if not eat_kw("in")
            unexpected("`in` after the comprehension's variable", "expr.comp.2")
            return none
        iter := range()?
        mut cond := none
        if eat_kw("if")
            cond = expression()?
        clauses.push(ast.CompFor(
            is_par: is_par,
            var: var,
            var_pos: v.pos,
            iter: iter,
            cond: cond,
            unpack: unpack,
        ))
    clauses

fn Parser.at_comp_for(self) bool
    at_kw("for") or at_kw("par") and kw_at(1) == "for"

## `with m as mut x` and its block (conc.share.6), at `with`.
fn Parser.with_stmt(mut self, pos ast.Pos) ast.Stmt?
    bump()
    mutex := range()?
    if not eat_kw("as")
        unexpected("`as mut NAME` after the mutex", "conc.share.6")
        return none
    if not eat_kw("mut")
        error_text(
            "conc.share.6",
            here(),
            "a `with` block writes its variable back to the mutex, so the variable is `mut`",
            "write `with m as mut x`; to read the value once, use `m.get()`",
            "write `as mut`",
        )
        attach("write `as mut`", [fix.insert(here(), "mut ")])
        return none
    v := take_name("a variable after `as mut`", "conc.share.6")?
    body := block("the `with` header", "conc.share.6")?
    ast.Stmt.With(mutex: mutex, var: v.name, var_pos: v.pos, body: body, pos: pos)

## `value else d` or `value else return ...` (err.else.6), the loosest
## operator. An `else` that starts a block belongs to a statement.
fn Parser.else_expr(mut self, value ast.Expr) ast.Expr?
    if not at_kw("else") or else_block_follows()
        return value
    pos := bump().pos
    k := kw_at(0)
    if k == "return" or k == "break" or k == "continue"
        s := statement_inner()?
        return ast.Expr.OrElse(value: value, otherwise: ast.Else.Leave(s), pos: pos)
    d := expression()?
    ast.Expr.OrElse(value: value, otherwise: ast.Else.Fallback(d), pos: pos)

## At `else`: whether an indented block follows it (`else` or `else err`).
fn Parser.else_block_follows(self) bool
    t := tag_at(1)
    if t == "nl"
        return true
    t == "id" and tag_at(2) == "nl" and tag_at(3) == "indent"

## `a..b` and `a..=b` (expr.loop.3): the loosest operators. A bound may be
## left out before `]`, for a slice (type.coll.10).
fn Parser.range(mut self) ast.Expr?
    mut lo := none
    if not at_sym("..") and not at_sym("..=")
        lo = or_expr()?
    inclusive := at_sym("..=")
    if not at_sym("..") and not inclusive
        return lo
    pos := bump().pos
    mut hi := none
    if not at_sym("]")
        hi = or_expr()?
    ast.Expr.Range(lo: lo, hi: hi, inclusive: inclusive, pos: pos)

## A C-style logical operator: report it and treat it as its AIL spelling.
fn Parser.logical_typo(mut self, sym str, spelled str) bool
    if not at_sym(sym)
        return false
    error_fix(
        "expr.op.1",
        here(),
        "AIL writes `{sym}` as `{spelled}`",
        "write `{spelled}`",
        "write `{spelled}`",
        [fix.span(
            here(),
            ast.Pos(line: here().line, col: here().col + sym.chars().len()),
            if sym == "!" then "not " else spelled,
        )],
    )
    true

fn Parser.or_expr(mut self) ast.Expr?
    mut lhs := and_expr()?
    while at_kw("or") or logical_typo("||", "or")
        pos := bump().pos
        rhs := and_expr()?
        lhs = ast.Expr.Binary(op: ast.BinOp.Or, lhs: lhs, rhs: rhs, pos: pos)
    lhs

fn Parser.and_expr(mut self) ast.Expr?
    mut lhs := not_expr()?
    while at_kw("and") or logical_typo("&&", "and")
        pos := bump().pos
        rhs := not_expr()?
        lhs = ast.Expr.Binary(op: ast.BinOp.And, lhs: lhs, rhs: rhs, pos: pos)
    lhs

## `not` binds more loosely than comparisons (ADR 0112).
fn Parser.not_expr(mut self) ast.Expr?
    if at_kw("not") or logical_typo("!", "not")
        pos := bump().pos
        inner := not_expr()?
        return ast.Expr.Unary(op: ast.UnOp.Not, operand: inner, pos: pos)
    comparison_expr()

## Comparisons don't chain (expr.prec.2).
fn Parser.comparison_expr(mut self) ast.Expr?
    lhs := additive()?
    op := comparison(sym_at(0)) else return lhs
    pos := bump().pos
    if op == ast.BinOp.Lt and at_sym(">") and adjacent(i - 1)
        error_fix(
            "gram.foreign.1",
            pos,
            "AIL writes `<>` as `!=`",
            "write `!=`",
            "write `!=`",
            [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 2), "!=")],
        )
        return none
    rhs := additive()?
    if comparison(sym_at(0)) != none
        second := here()
        # `List<int>()`: type arguments use `[]`.
        if op == ast.BinOp.Lt and upper_name(lhs) and at_sym(">")
            error_fix(
                "gram.foreign.1",
                pos,
                "type arguments are written in `[]`, not `<>`",
                "write `List[int]()`",
                "use brackets",
                [
                    fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 1), "["),
                    fix.span(second, ast.Pos(line: second.line, col: second.col + 1), "]"),
                ],
            )
            return none
        diags.push(Diag(
            rule: "expr.prec.2",
            pos: second,
            msg: "comparisons can't be chained",
            fixed: true,
            help: "combine them with `and`, e.g. `a < b and b < c`",
            fix: "repeat the middle operand with `and`",
            edits: [fix.chain(pos, second)],
        ))
        return none
    ast.Expr.Binary(op: op, lhs: lhs, rhs: rhs, pos: pos)

## A name that starts with an uppercase letter.
fn upper_name(e ast.Expr) bool
    match e
        Name(n, _) => n.chars().len() > 0 and n.chars()[0].is_upper()
        Str(_, _) | Bytes(_, _) | Interp(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(_, _, _) | ListLit(_, _) | Call(_, _, _) | Method(_, _, _, _) | Member(_, _, _) | Index(_, _, _) | Unary(_, _, _) | Binary(_, _, _, _) | Range(_, _, _, _) | MapLit(_, _) | SetLit(_, _) | If(_, _, _, _) | Match(_, _, _) | Try(_, _, _) | Comp(
            _,
            _,
            _,
            _,
            _,
        ) | OrElse(_, _, _) | NewRef(_, _) | TupleLit(_, _) | Closure(_, _, _) => false

fn Parser.additive(mut self) ast.Expr?
    mut lhs := multiplicative()?
    while at_sym("+") or at_sym("-")
        plus := at_sym("+")
        op := if plus then ast.BinOp.Add else ast.BinOp.Sub
        pos := bump().pos
        # `n++` and `n--`
        if (plus and at_sym("+") or not plus and at_sym("-"))
            and adjacent(i - 1)
            and line_ends_at(i)
            sym := if plus then "++" else "--"
            assign := if plus then "+=" else "-="
            error_fix(
                "gram.foreign.1",
                pos,
                "AIL has no `{sym}`",
                "write `n {assign} 1`",
                "write `{assign} 1`",
                [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 2), " {assign} 1")],
            )
            return none
        rhs := multiplicative()?
        lhs = ast.Expr.Binary(op: op, lhs: lhs, rhs: rhs, pos: pos)
    lhs

fn Parser.multiplicative(mut self) ast.Expr?
    mut lhs := bit_operand()?
    while at_sym("*") or at_sym("/") or at_sym("%")
        mut op := ast.BinOp.Rem
        if at_sym("*")
            op = ast.BinOp.Mul
        elif at_sym("/")
            op = ast.BinOp.Div
        pos := bump().pos
        rhs := bit_operand()?
        lhs = ast.Expr.Binary(op: op, lhs: lhs, rhs: rhs, pos: pos)
    lhs

## The method a bit operator stands for (expr.bit.3), or "".
fn bit_method(s str) str
    match s
        "&" => "bit_and"
        "|" => "bit_or"
        "^" => "bit_xor"
        "<<" => "shl"
        ">>" => "shr"
        _ => ""

## The operators a bit operator may not touch without parentheses (expr.bit.4).
fn arith_or_cmp(s str) bool
    ["+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "..", "..="].contains(s)

## `a & b`, `a | b`, `a ^ b`, `a << k`, `a >> k` (expr.bit.3): the same call as
## the method form, `a.bit_and(b)`. A bit operator takes tight operands and never
## mixes with another operator without parentheses (expr.bit.4): the chain is one
## operator repeated (`a & b & c`, never `a | b & c`, `a << 1 << 2`), and nothing
## arithmetic or comparing touches it on either side.
fn Parser.bit_operand(mut self) ast.Expr?
    first := i
    mut lhs := unary()?
    sym := sym_at(0)
    if bit_method(sym) == ""
        return lhs
    if first > 0 and arith_or_cmp(sym_at(first - 1 - i))
        return bit_mix(sym_at(first - 1 - i), sym)
    mut count := 0
    while bit_method(sym_at(0)) != ""
        op := sym_at(0)
        if op != sym
            return bit_mix(sym, op)
        if (op == "<<" or op == ">>") and count > 0
            return bit_mix(op, op)
        pos := bump().pos
        rhs := unary()?
        arg := ast.Arg(label: none, mutable: false, moved: false, value: rhs, param: none)
        lhs = ast.Expr.Method(recv: lhs, name: bit_method(op), name_pos: pos, args: [arg])
        count += 1
    after := sym_at(0)
    if arith_or_cmp(after)
        return bit_mix(sym, after)
    lhs

## Report two operators that meet without parentheses and give up on the expression.
fn Parser.bit_mix(mut self, a str, b str) ast.Expr?
    msg := if a == b
        "`{a}` can't repeat without parentheses"
    else
        "`{a}` and `{b}` can't meet without parentheses"
    error_text(
        "expr.bit.4",
        here(),
        msg,
        "put parentheses around one side: `(x {a} y) {b} z` or `x {a} (y {b} z)`",
        "add parentheses",
    )
    none

fn Parser.unary(mut self) ast.Expr?
    # lex.num.3: `-9223372036854775808` is the minimum `int`, unless a
    # postfix operator binds the literal first.
    if at_sym("-") and tag_at(1) == "intmin"
        s := sym_at(2)
        if s != "." and s != "[" and s != "("
            pos := bump().pos
            i += 1
            return ast.Expr.Int(value: "-9223372036854775808", pos: pos)
    if at_sym("-")
        pos := bump().pos
        inner := unary()?
        return ast.Expr.Unary(op: ast.UnOp.Neg, operand: inner, pos: pos)
    # expr.bit.3: `~a` is `a.bit_not()`.
    if at_sym("~")
        pos := bump().pos
        inner := unary()?
        return ast.Expr.Method(recv: inner, name: "bit_not", name_pos: pos, args: List[ast.Arg]())
    if at_sym("&")
        error_text(
            "gram.foreign.1",
            here(),
            "AIL has no `&x` reference",
            "values are passed by value and `mut` marks changes at the call; `a & b` is the bitwise and of two values (expr.bit.3)",
            "",
        )
        return none
    # `ref e` (own.ref.1, ADR 0067).
    if at_kw("ref")
        pos := bump().pos
        value := unary()?
        return ast.Expr.NewRef(value: value, pos: pos)
    # conc.task.1: `spawn f(args)`.
    if at_kw("spawn")
        pos := bump().pos
        inner := postfix()?
        return ast.Expr.Unary(op: ast.UnOp.Spawn, operand: inner, pos: pos)
    postfix()

## The name of a plain name expression.
fn name_of(e ast.Expr) str?
    match e
        Name(n, _) => n
        Str(_, _) | Bytes(_, _) | Interp(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(_, _, _) | ListLit(_, _) | Call(_, _, _) | Method(_, _, _, _) | Member(_, _, _) | Index(_, _, _) | Unary(_, _, _) | Binary(_, _, _, _) | Range(_, _, _, _) | MapLit(_, _) | SetLit(_, _) | If(_, _, _, _) | Match(_, _, _) | Try(_, _, _) | Comp(
            _,
            _,
            _,
            _,
            _,
        ) | OrElse(_, _, _) | NewRef(_, _) | TupleLit(_, _) | Closure(_, _, _) => none

fn name_pos(e ast.Expr) ast.Pos
    match e
        Name(_, p) => p
        Str(_, _) | Bytes(_, _) | Interp(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(_, _, _) | ListLit(_, _) | Call(_, _, _) | Method(_, _, _, _) | Member(_, _, _) | Index(_, _, _) | Unary(_, _, _) | Binary(_, _, _, _) | Range(_, _, _, _) | MapLit(_, _) | SetLit(_, _) | If(_, _, _, _) | Match(_, _, _) | Try(_, _, _) | Comp(_, _, _, _, _) | OrElse(_, _, _) | NewRef(_, _) | TupleLit(_, _) | Closure(_, _, _) => ast.Pos(
            line: 0,
            col: 0,
        )

## A type argument, or a const argument: an int literal, kept as a `Named`
## whose name is the digits (`4`, never a type name; gen.const.1).
fn Parser.type_arg(mut self, rule str) ast.TypeRef?
    if tag_at(0) == "int"
        v := match peek()
            Int(x) => "{x}"
            Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""
        cpos := bump().pos
        return ast.TypeRef(
            shape: ast.TypeShape.Named(name: v, args: List[ast.TypeRef]()),
            pos: cpos,
        )
    type_ref("a type argument", rule)

## Type arguments after `[`, through `]` (gen.infer.2).
fn Parser.type_args(mut self) List[ast.TypeRef]?
    bump()
    mut args := List[ast.TypeRef]()
    while not at_sym("]")
        args.push(type_arg("gen.infer.2")?)
        if not eat_sym(",")
            break
    expect_sym("]", "`]` or `,` in the type arguments", "gen.infer.2")?
    args

## Calls, fields, methods and indexing (expr.prec.1 level 1).
fn Parser.postfix(mut self) ast.Expr?
    mut e := primary()?
    # `f[int](x)`, `Stack[int].new()`: type arguments after a generic name (gen.infer.2).
    if n := name_of(e)
        if at_sym("[") and generic_names.contains(n)
            pos := name_pos(e)
            args := type_args()?
            e = ast.Expr.TypeArgs(name: n, args: args, pos: pos)
    while true
        if at_sym("(")
            pos := bump().pos
            args := call_args()?
            e = call_or_old(e, args, pos)
        elif eat_sym(".")
            # type.tuple.3: `t.0`, an element of a tuple.
            if tag_at(0) == "int"
                k := match peek()
                    Int(v) => "{v}"
                    Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""
                kpos := bump().pos
                e = ast.Expr.Member(recv: e, name: k, name_pos: kpos)
                continue
            # `xs.any(f)` (type.coll.22): the keyword `any` names the list method after `.`.
            mut m := ast.Ident(name: "any", pos: here())
            if kw_at(0) == "any" and sym_at(1) == "("
                i += 1
            else
                m = take_name("a field or method name after `.`", "gram.syntax.1")?
            recv_name := name_of(e) else ""
            # `m.Stack[int]` after an import `m` (gen.infer.2, mod.use.2).
            if recv_name != ""
                and aliases.contains(recv_name)
                and at_sym("[")
                and generic_names.contains(m.name)
                pos := name_pos(e)
                args := type_args()?
                e = ast.Expr.TypeArgs(name: "{recv_name}.{m.name}", args: args, pos: pos)
            elif eat_sym("(")
                args := call_args()?
                e = ast.Expr.Method(recv: e, name: m.name, name_pos: m.pos, args: args)
            else
                e = ast.Expr.Member(recv: e, name: m.name, name_pos: m.pos)
        elif at_sym("[")
            pos := bump().pos
            mut index := range()?
            # type.grid.3: `g[i, j]` indexes with the tuple `(i, j)`.
            if at_sym(",")
                mut elems := [index]
                while eat_sym(",") and not at_sym("]")
                    elems.push(expression()?)
                index = ast.Expr.TupleLit(items: elems, pos: pos)
            if at_sym(":")
                error_fix(
                    "type.coll.4",
                    here(),
                    "a slice is written with `..`, not `:`",
                    "write `xs[a..b]`, `xs[a..]` or `xs[..b]`",
                    "write `..`",
                    [fix.span(here(), ast.Pos(line: here().line, col: here().col + 1), "..")],
                )
                return none
            expect_sym("]", "`]` after the index", "type.coll.4")?
            e = ast.Expr.Index(recv: e, index: index, pos: pos)
        elif at_sym("?")
            # `e?` propagates; `e? "message"` also adds context (err.prop.1, err.ctx.2).
            pos := bump().pos
            mut context := none
            if tag_at(0) == "str" or tag_at(0) == "interp"
                context = primary()?
            e = ast.Expr.Try(expr: e, context: context, pos: pos)
        else
            return e
    none

## Arguments after `(`, through `)` (gram.list.1).
fn Parser.call_args(mut self) List[ast.Arg]?
    mut args := List[ast.Arg]()
    while not at_sym(")")
        mut label := none
        if tag_at(0) == "id" and sym_at(1) == ":"
            label = take_name("a field name", "type.struct.3")?
            i += 1
        mutable := eat_kw("mut")
        moved := not mutable and eat_kw("move")
        # expr.key.1: `by: |x| e`, a key function.
        mut param := none
        # `|x| e` with one untyped parameter is a function literal that also names its
        # parameter in `Arg.param`, the key-function form (expr.key.1, type.fn.4, ADR 1067):
        # `ast.key_body` reads `e` back.
        if at_sym("|") and tag_at(1) == "id" and sym_at(2) == "|"
            param = ast.Ident(name: tok_text(peek_at(1)), pos: tok_pos(i + 1))
        value := expression()?
        # `a @ b` is a matrix product (ADR 0382); `name=value` is `name: value`.
        if at_sym("@")
            error_text(
                "gram.foreign.1",
                here(),
                "AIL has no `@` operator",
                "the matrix product is a method: `a.matmul(b)` (std.tensor.10)",
                "write `.matmul`",
            )
            attach("write `.matmul`", [fix.operands(here(), "@", "$l.matmul($r)")])
            return none
        if at_sym("=")
            error_text(
                "expr.call.1",
                here(),
                "a named argument is written `name: value`, not `name=value`",
                "write `f(dx: 1, dy: 2)`",
                "write `:`",
            )
            attach("write `:`", [fix.span(
                here(),
                ast.Pos(line: here().line, col: here().col + 1),
                ": ",
            )])
            return none
        args.push(ast.Arg(label: label, mutable: mutable, moved: moved, value: value, param: param))
        if not eat_sym(",")
            break
    expect_sym(")", "`)` or `,` in the argument list", "expr.call.1")?
    args

fn Parser.primary(mut self) ast.Expr?
    pos := here()
    t := peek()
    match t
        Str(s) =>
            i += 1
            return ast.Expr.Str(value: s, pos: pos)
        Bytes(hex) =>
            i += 1
            return ast.Expr.Bytes(hex: hex, pos: pos)
        Interp(parts) =>
            i += 1
            return interpolation(parts, pos)
        Int(v) =>
            i += 1
            return ast.Expr.Int(value: "{v}", pos: pos)
        IntMin =>
            i += 1
            int_too_big(pos)
            return ast.Expr.Int(value: "0", pos: pos)
        Float(v) =>
            i += 1
            return ast.Expr.Float(value: v, pos: pos)
        Char(c) =>
            i += 1
            return ast.Expr.Char(value: "{c}", pos: pos)
        Ident(n) =>
            i += 1
            return ast.Expr.Name(name: n, pos: pos)
        Kw(k) =>
            if k == "true" or k == "false"
                i += 1
                return ast.Expr.Bool(value: k == "true", pos: pos)
            if k == "none"
                i += 1
                return ast.Expr.NoneLit(pos)
            if k == "todo"
                i += 1
                return ast.Expr.Hole(pos)
            if k == "uhwhatnow?"
                i += 1
                asks.push(pos)
                return ast.Expr.Hole(pos)
            if k == "self"
                i += 1
                return ast.Expr.Name(name: "self", pos: pos)
            if k == "if"
                error_text(
                    "expr.if.8",
                    pos,
                    "an `if` operand needs parentheses",
                    "write `(if c then a else b)`, or bind the `if` to a name first",
                    "",
                )
                return none
            if k == "match"
                error_text(
                    "gram.syntax.1",
                    pos,
                    "`{k}` can't be part of a larger expression",
                    "bind the `{k}` to a name first, then use the name",
                    "",
                )
                return none
        Sym(s) =>
            if s == "("
                i += 1
                # expr.if.8: a parenthesised one-line `if` is an operand.
                inner := if at_kw("if") then if_expr()? else range()?
                inner2 := else_expr(inner)?
                # type.tuple.2: `(a, b, ...)` is a tuple.
                if at_sym(",")
                    mut elems := [inner2]
                    while eat_sym(",") and not at_sym(")")
                        elems.push(expression()?)
                    expect_sym(")", "`)` or `,` in the tuple", "type.tuple.2")?
                    if elems.len() < 2
                        error_text(
                            "type.tuple.2",
                            pos,
                            "a tuple has two or more elements",
                            "write the value alone, without `(` `,` `)`",
                            "",
                        )
                        return none
                    return ast.Expr.TupleLit(items: elems, pos: pos)
                expect_sym(")", "`)`", "gram.syntax.1")?
                return inner2
            if s == "["
                return list_literal(pos)
            if s == "\{"
                return brace_literal(pos)
        Newline | Indent | Dedent | Eof => i += 0
    unexpected("an expression", "gram.syntax.1")
    none

## `[a, b]` or `[e for x in xs]` (type.coll.2, expr.comp.1), at `[`.
fn Parser.list_literal(mut self, pos ast.Pos) ast.Expr?
    i += 1
    mut elems := List[ast.Expr]()
    while not at_sym("]")
        elems.push(expression()?)
        if elems.len() == 1 and at_comp_for()
            elem := elems[0]
            clauses := comp_clauses()?
            expect_sym("]", "`]` after the comprehension", "expr.comp.1")?
            return ast.Expr.Comp(
                form: ast.CompKind.ListComp,
                elem: elem,
                value: none,
                clauses: clauses,
                pos: pos,
            )
        if not eat_sym(",")
            break
    expect_sym("]", "`]` or `,` in the list", "type.coll.2")?
    ast.Expr.ListLit(items: elems, pos: pos)

## `{k: v, ...}`, `{a, b, ...}`, `{}`, or a comprehension (type.coll.2), at `{`.
fn Parser.brace_literal(mut self, pos ast.Pos) ast.Expr?
    i += 1
    if eat_sym("}")
        return ast.Expr.MapLit(entries: [], pos: pos)
    first := expression()?
    if eat_sym(":")
        value := expression()?
        if at_comp_for()
            clauses := comp_clauses()?
            expect_sym("}", "`}` after the comprehension", "expr.comp.1")?
            return ast.Expr.Comp(
                form: ast.CompKind.MapComp,
                elem: first,
                value: value,
                clauses: clauses,
                pos: pos,
            )
        mut entries := [ast.MapEntry(key: first, value: value)]
        while eat_sym(",") and not at_sym("}")
            k := expression()?
            expect_sym(":", "`:` after the key", "type.coll.2")?
            v := expression()?
            entries.push(ast.MapEntry(key: k, value: v))
        expect_sym("}", "`}` or `,` in the map", "type.coll.2")?
        return ast.Expr.MapLit(entries: entries, pos: pos)
    if at_comp_for()
        clauses := comp_clauses()?
        expect_sym("}", "`}` after the comprehension", "expr.comp.1")?
        return ast.Expr.Comp(
            form: ast.CompKind.SetComp,
            elem: first,
            value: none,
            clauses: clauses,
            pos: pos,
        )
    mut elems := [first]
    while eat_sym(",") and not at_sym("}")
        elems.push(expression()?)
    expect_sym("}", "`}` or `,` in the set", "type.coll.2")?
    ast.Expr.SetLit(items: elems, pos: pos)

## Parse each `{...}` part of an interpolated string (lex.str.2).
fn Parser.interpolation(mut self, parts List[Part], pos ast.Pos) ast.Expr?
    mut out := List[ast.InterpPart]()
    mut ok := true
    for part in parts
        match part
            Lit(text) => out.push(ast.InterpPart.Lit(text))
            Code(code) =>
                if code.len() > 0
                    and tok_tag(code[0].tok) == "sym"
                    and tok_text(code[0].tok) == "\{"
                    # lex.str.2: `{{` isn't an escape; `\{` is.
                    diags.push(Diag(
                        rule: "lex.str.2",
                        pos: code[0].pos,
                        msg: "`\{\{` in a string isn't an escaped brace",
                        fixed: true,
                        help: "write `\\\{` for a literal `\{`, or use a raw string `r\"...\"`",
                        fix: "escape the brace with a backslash",
                        edits: escape_brace_edits(code),
                    ))
                    ok = false
                elif e := sub_expression(code)
                    out.push(ast.InterpPart.Hole(e))
                else
                    ok = false
            Fmt(code, spec) =>
                if e := sub_expression(code)
                    out.push(ast.InterpPart.Fmt(value: e, spec: ast_spec(spec)))
                else
                    ok = false
    if ok then ast.Expr.Interp(parts: out, pos: pos) else none

## The expression of one interpolated part, parsed on its own; `none` if
## it has a mistake, which is reported.
fn Parser.sub_expression(mut self, code List[Token]) ast.Expr?
    mut sub := new_parser(code, [])
    sub.in_interp = true
    sub.generic_names = generic_names
    sub.aliases = aliases
    e := sub.expression()
    if e != none and sub.peek() != Tok.Eof
        sub.unexpected("`}` after the interpolated expression", "lex.str.2")
    clean := sub.diags.len() == 0
    diags.extend(sub.diags)
    asks.extend(sub.asks)
    if clean then e else none

## The none of any optional type, where nothing else names the type (a local
## that is read before its first assignment, type.opt.9).
fn absent[T]() T?
    none

fn ast_spec(f FormatSpec) ast.FormatSpec
    ast.FormatSpec(
        fill: if v := f.fill then "{v}" else none,
        align: if v := f.align then "{v}" else none,
        width: f.width,
        precision: f.precision,
        hex: f.hex,
    )

## `if c` block, any `elif c` blocks, optional `else` block (expr.if.1, expr.if.3).
fn Parser.if_expr(mut self) ast.Expr?
    pos := bump().pos
    cond := condition()?
    if n := ident()
        if n == "then"
            return if_then(cond, pos)
    body := block("the `if` condition", "expr.if.1")?
    mut branches := [ast.Branch(cond: cond, body: body)]
    mut els := none
    mut else_err := none
    while true
        if eat_kw("elif")
            c := condition()?
            b := block("the `elif` condition", "expr.if.1")?
            branches.push(ast.Branch(cond: c, body: b))
        elif at_kw("else")
            else_pos := bump().pos
            if at_kw("if")
                diags.push(Diag(
                    rule: "expr.if.1",
                    pos: else_pos,
                    msg: "AIL writes `else if` as `elif`",
                    fixed: true,
                    help: "write `elif`",
                    fix: "write `elif`",
                    edits: [fix.replace(else_pos, "else if", "elif")],
                ))
                return none
            # `else err` binds the error (expr.if.6).
            if n := ident()
                if tag_at(1) == "nl"
                    else_err = ast.Ident(name: n, pos: bump().pos)
            els = block("`else`", "expr.if.1")?
            break
        else
            break
    ast.Expr.If(branches: branches, els: els, else_err: else_err, pos: pos)

## expr.if.8: the one-line form `if c then a else b`, after `c`.
fn Parser.if_then(mut self, cond ast.Cond, pos ast.Pos) ast.Expr?
    bump()
    a := expression_plain()?
    if not eat_kw("else")
        error_text(
            "expr.if.8",
            here(),
            "`if c then a` needs `else b` on the same line",
            "add `else` and the other value; for a statement with no `else`, put the body on its own line",
            "",
        )
        return none
    b := expression_plain()?
    ast.Expr.If(
        branches: [ast.Branch(cond: cond, body: [ast.Stmt.Eval(a)])],
        els: [ast.Stmt.Eval(b)],
        else_err: none,
        pos: pos,
    )

## A `bool` condition, or a binding `name := e` (expr.if.5).
fn Parser.condition(mut self) ast.Cond?
    if n := ident()
        if sym_at(1) == ":="
            pos := bump().pos
            i += 1
            value := range()?
            return ast.Cond.Bind(name: n, pos: pos, value: value)
    value := range()?
    ast.Cond.Test(value)

## `match e` and one `pattern => result` arm per line (expr.match.1).
fn Parser.match_expr(mut self) ast.Expr?
    pos := bump().pos
    scrutinee := range()?
    if not eat_newline()
        unexpected("end of line after the `match` value", "expr.match.1")
        return none
    if not eat_indent()
        error_text(
            "expr.match.1",
            here(),
            "a `match` needs an indented block of arms",
            "write one `pattern => result` per line",
            "",
        )
        return none
    mut arms := List[ast.Arm]()
    while peek() != Tok.Dedent and peek() != Tok.Eof
        if eat_newline()
            continue
        if a := arm()
            arms.push(a)
        else
            skip_statement()
    eat_dedent()
    ast.Expr.Match(scrutinee: scrutinee, arms: arms, pos: pos)

fn Parser.arm(mut self) ast.Arm?
    pat := pattern()?
    # expr.match.11: `pattern if cond =>`.
    mut guard := absent[ast.Expr]()
    if eat_kw("if")
        guard = expression_plain()?
    if not eat_sym("=>")
        if at_sym(":") or at_sym("->")
            error_fix(
                "expr.match.1",
                here(),
                "arms are written `pattern => result`",
                "write `=>`",
                "write `=>`",
                [fix.span(
                    here(),
                    ast.Pos(line: here().line, col: here().col + (if at_sym(":") then 1 else 2)),
                    if attached_before(here()) then " =>" else "=>",
                )],
            )
            i += 1
        else
            match pat
                Variant(q, nm, _, cpos) if nm == "case" and q == none =>
                    # AIL has no `case`: an arm is `pattern => result`.
                    error_text(
                        "expr.match.1",
                        cpos,
                        "AIL has no `case`: an arm is `pattern => result`",
                        "drop `case`, e.g. `1 => \"one\"`",
                        "",
                    )
                    attach("drop `case`", [fix.delete(cpos, here())])
                _ =>
                    unexpected("`=>` after the pattern", "expr.match.1")
            return none
    if at_newline()
        body := block("`=>`", "expr.match.1")?
        return ast.Arm(pat: pat, guard: guard, body: body)
    # expr.match.9: one statement on the arm's line.
    s := statement_inner()?
    if not after_block() and not eat_newline()
        unexpected("end of line after the arm", "expr.match.1")
        return none
    ast.Arm(pat: pat, guard: guard, body: [s])

## A pattern, or several joined by `|` (expr.match.8).
fn Parser.pattern(mut self) ast.Pattern?
    pos := here()
    first := single_pattern()?
    if not at_sym("|")
        return first
    mut alts := [first]
    while eat_sym("|")
        alts.push(single_pattern()?)
    ast.Pattern.Alt(alts: alts, pos: pos)

## One alternative: a literal or a `lo..hi` / `lo..=hi` range of integer or
## character literals (expr.match.12), or see `plain_pattern`.
fn Parser.single_pattern(mut self) ast.Pattern?
    pos := here()
    lo := plain_pattern()?
    inclusive := at_sym("..=")
    if not inclusive and not at_sym("..")
        return lo
    mut lo_lit := ast.Literal.BoolLit(false)
    match lo
        Literal(value, _) =>
            match value
                IntLit(_) | CharLit(_) => lo_lit = value
                StrLit(_) | BoolLit(_) =>
                    range_start_error(pos)
                    return none
        Wildcard(_) | Alt(_, _) | Variant(
            _,
            _,
            _,
            _,
        ) | Range(_, _, _, _) | TuplePat(_, _) | BindName(_, _) =>
            range_start_error(pos)
            return none
    i += 1
    hpos := here()
    # expr.match.12: a range needs both ends (`lo..=hi`).
    if at_sym("=>") or at_sym(".") or at_kw("if")
        error_text(
            "expr.match.12",
            hpos,
            "a range needs both ends, written with two dots",
            "write `lo..=hi` for both ends, e.g. `0..=9`; `_` covers the rest",
            "",
        )
        if at_sym(".")
            attach("write `..=`", [fix.span(
                hpos,
                ast.Pos(line: hpos.line, col: hpos.col + 1),
                "=",
            )])
        return none
    hi := plain_pattern()?
    match hi
        Literal(value, _) =>
            match value
                IntLit(_) | CharLit(_) =>
                    return ast.Pattern.Range(lo: lo_lit, hi: value, inclusive: inclusive, pos: pos)
                StrLit(_) | BoolLit(_) => i += 0
        Wildcard(_) | Alt(_, _) | Variant(
            _,
            _,
            _,
            _,
        ) | Range(_, _, _, _) | TuplePat(_, _) | BindName(_, _) => i += 0
    error_text(
        "expr.match.12",
        hpos,
        "the end of a range pattern must be an integer or character literal",
        "write `lo..hi` or `lo..=hi` with literal ends",
        "",
    )
    none

## `_`, `Variant`, `Enum.Variant`, or a literal (expr.match.4, expr.match.7).
fn Parser.plain_pattern(mut self) ast.Pattern?
    pos := here()
    match peek()
        Ident(n) =>
            i += 1
            if n == "_"
                return ast.Pattern.Wildcard(pos)
            # `Enum.Variant`, or `m.Enum.Variant` for an imported enum (mod.use.2).
            mut path := [n]
            while eat_sym(".")
                path.push(take_name("a variant name after `.`", "expr.match.4")?.name)
            name := path[path.len() - 1]
            mut qualifier := none
            if path.len() > 1
                qualifier = path[0..path.len() - 1].join(".")
            # `Variant(a, _)`: one binding per field (expr.match.6).
            mut bindings := none
            if eat_sym("(")
                mut names := List[ast.Ident]()
                while not at_sym(")")
                    names.push(take_name("a name or `_` for the field", "expr.match.6")?)
                    if not eat_sym(",")
                        break
                expect_sym(")", "`)` or `,` in the pattern", "expr.match.6")?
                bindings = names
            return ast.Pattern.Variant(
                qualifier: qualifier,
                name: name,
                bindings: bindings,
                pos: pos,
            )
        Int(v) =>
            i += 1
            return ast.Pattern.Literal(value: ast.Literal.IntLit("{v}"), pos: pos)
        Sym(s) =>
            if s == "("
                return tuple_pattern(pos)
            t := tag_at(1)
            if s == "-" and (t == "int" or t == "intmin")
                i += 1
                v := match bump().tok
                    Int(n) => "{-n}"
                    Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => "-9223372036854775808"
                return ast.Pattern.Literal(value: ast.Literal.IntLit(v), pos: pos)
        IntMin =>
            i += 1
            int_too_big(pos)
            return ast.Pattern.Literal(value: ast.Literal.IntLit("0"), pos: pos)
        Char(c) =>
            i += 1
            return ast.Pattern.Literal(value: ast.Literal.CharLit("{c}"), pos: pos)
        Str(s) =>
            i += 1
            return ast.Pattern.Literal(value: ast.Literal.StrLit(s), pos: pos)
        Kw(k) =>
            if k == "true" or k == "false"
                i += 1
                return ast.Pattern.Literal(value: ast.Literal.BoolLit(k == "true"), pos: pos)
        Interp(_) | Float(_) =>
            error_text(
                "expr.match.7",
                pos,
                "a pattern can be an integer, character, string or `bool` literal",
                "compare with `==` in an `if` instead",
                "",
            )
            return none
        Bytes(_) | Newline | Indent | Dedent | Eof => i += 0
    unexpected("a pattern (a variant name or `_`)", "expr.match.4")
    none

## `(p, q, ...)` at `(` (type.tuple.6); a plain name in it binds the element.
fn Parser.tuple_pattern(mut self, pos ast.Pos) ast.Pattern?
    i += 1
    mut elems := List[ast.Pattern]()
    while not at_sym(")")
        s := sym_at(1)
        n := ident() else ""
        if n != "" and n != "_" and (s == "," or s == ")")
            npos := bump().pos
            elems.push(ast.Pattern.BindName(name: n, pos: npos))
        else
            elems.push(pattern()?)
        if not eat_sym(",")
            break
    expect_sym(")", "`)` or `,` in the tuple pattern", "type.tuple.6")?
    if elems.len() < 2
        error_text(
            "type.tuple.6",
            pos,
            "a tuple pattern has two or more elements",
            "write `(p, q)`",
            "",
        )
        return none
    ast.Pattern.TuplePat(elems: elems, pos: pos)
