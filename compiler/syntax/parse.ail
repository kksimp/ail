## The AIL parser, in AIL (Stage 3, ADR 0371): tokens to the syntax tree
## of `compiler/ast/`, as the bootstrap's `parser.rs` builds it.
## `compiler/selfhost.ail parse FILE` prints the tree in the form of
## `ail api --ast FILE` (api.ast.1-2), and the selftest compares the two on
## every `.ail` file in the repository.
##
## Grammar rules: gram.fn.1-2, gram.list.1, gram.generic.1, gram.syntax.1,
## gram.attr.1-3, gram.foreign.1, gram.rec.1, lex.stmt.1, lex.kw.1, lex.kw.3,
## type.struct.1-3, type.enum.1-2, expr.bind.1-3, expr.if.1-6, expr.if.8,
## expr.loop.1-6, expr.match.1-9, expr.prec.1-2, expr.op.1, expr.comp.1-2,
## expr.key.1, gen.decl.1, gen.bound.1, gen.method.1-3, gen.infer.2,
## trait.decl.1-2, trait.impl.1, trait.any.1, trait.super.1, err.else.1-6,
## err.msg.1-2, err.prop.1, contract.decl.1, contract.ens.3, mod.use.1-2,
## mod.vis.1-2, mod.const.1, own.uniq.1, conc.par.5, conc.share.6,
## ct.derive.1.
use ast
use fix

## The tree of a file and the diagnostics found making it, in order.
pub struct Parsed
    pub program ast.Program
    pub diags List[Diag]

## How `header_tail` left the parser.
enum Header
    ## Not recognised: report the generic error.
    NotHeader
    ## Reported; stop parsing this statement.
    Reported
    ## Reported, and the line's end was consumed: the block follows.
    GoOn

## The `else` part of a binding, which may be absent (err.else.1-3).
struct ElsePart
    part ast.Else?

## A function's body and contract lines (contract.decl.1).
struct FnBody
    body List[ast.Stmt]?
    contracts List[ast.Contract]

## An enclosing loop: `name` is its label ("" for none), `at` the loop
## keyword's position, `in_par` a `par for`, which `break` can't leave (conc.par.2).
struct LoopLabel
    name str
    at ast.Pos
    in_par bool

## The deepest expression nesting the parser follows (gram.rec.5).
NEST_LIMIT := 200

struct Parser
    tokens List[Token]
    i int
    diags List[Diag]
    ## Parsing the expression inside a string's `{...}`, which ends at `}`.
    in_interp bool
    ## The names bound by `use` so far: `m.Stack[int]` is a qualified
    ## generic type, not an index (gen.infer.2, mod.use.2).
    aliases Set[str]
    ## The lines of `pub` markers (`Program.public`).
    public Set[int]
    ## Where each `uhwhatnow?` is (`Program.asks`, expr.hole.3).
    asks List[ast.Pos]
    ## The operators of unparenthesized `else a OP b` fallbacks (`Program.else_ops`, expr.prec.1).
    else_ops List[ast.Pos]
    generic_names Set[str]
    ## Parsing an `ensures` condition, and its `old(e)` calls (contract.ens.3).
    in_ensures bool
    ## Statements a statement leaves behind for its block to add after it (`x = e else` and a block, err.else.8).
    after_stmts List[ast.Stmt]
    olds List[ast.Old]
    fns List[ast.FnDecl]
    structs List[ast.StructDecl]
    enums List[ast.EnumDecl]
    traits List[ast.TraitDecl]
    impls List[ast.ImplDecl]
    consts List[ast.ConstDecl]
    uses List[ast.Use]
    ## The struct whose members are being parsed ("" outside one), for the
    ## fix that moves its methods out (type.struct.2).
    member_owner str
    ## The loops enclosing the statement being parsed in this function, outermost
    ## first, for `break outer` (expr.loop.10).
    loops List[LoopLabel]
    ## Keywords already reported as a binding's name: later uses read as that
    ## name, so the one `lex.kw.1` with its rename fix is the only error (ADR 1085).
    misnamed Set[str]
    ## `word@N`: the keyword `word` was renamed through the function whose header is token `N` (lex.kw.1, ADR 1211).
    renamed Set[str]
    ## How deep the expression being parsed nests (`NEST_LIMIT`).
    nest int

## The kind of a token, in one word.
fn tok_tag(t Tok) str
    match t
        Ident(_) => "id"
        Kw(_) => "kw"
        Sym(_) => "sym"
        Str(_) => "str"
        Bytes(_) => "bytes"
        Interp(_) => "interp"
        Char(_) => "char"
        Int(_) => "int"
        IntMin => "intmin"
        Float(_) => "float"
        Newline => "nl"
        Indent => "indent"
        Dedent => "dedent"
        Eof => "eof"

## The text of a name, keyword or symbol; "" for any other token.
fn tok_text(t Tok) str
    match t
        Ident(n) => n
        Kw(w) => w
        Sym(s) => s
        Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

## Keywords the spec defines that the bootstrap doesn't implement yet.
fn not_yet(k str) bool
    k == "as"

fn assign_op(s str) ast.BinOp?
    match s
        "+=" => ast.BinOp.Add
        "-=" => ast.BinOp.Sub
        "*=" => ast.BinOp.Mul
        "/=" => ast.BinOp.Div
        "%=" => ast.BinOp.Rem
        _ => none

## The bit operator of `&= |= ^= <<= >>=` (expr.bit.5), or "".
fn bit_assign(s str) str
    match s
        "&=" => "&"
        "|=" => "|"
        "^=" => "^"
        "<<=" => "<<"
        ">>=" => ">>"
        _ => ""

fn comparison(s str) ast.BinOp?
    match s
        "==" => ast.BinOp.Eq
        "!=" => ast.BinOp.Ne
        "<" => ast.BinOp.Lt
        "<=" => ast.BinOp.Le
        ">" => ast.BinOp.Gt
        ">=" => ast.BinOp.Ge
        _ => none

## Names declared generic (`fn f[`, `struct S[`, `enum E[`): after one of
## these, `[` starts type arguments rather than an index (gen.infer.2).
pub fn generic_names(tokens List[Token]) Set[str]
    mut names := {"List", "Map", "Set", "Channel", "Mutex", "Atomic", "TaskGroup"}
    for k in 2..tokens.len()
        a := tok_text(tokens[k - 2].tok)
        if tok_tag(tokens[k - 2].tok) == "kw"
            and (a == "fn" or a == "struct" or a == "enum")
            and tok_tag(tokens[k - 1].tok) == "id"
            and tok_tag(tokens[k].tok) == "sym"
            and tok_text(tokens[k].tok) == "["
            names.add(tok_text(tokens[k - 1].tok))
    names

fn new_parser(tokens List[Token], generic List[str]) Parser
    Parser(
        tokens: tokens,
        i: 0,
        diags: [],
        in_interp: false,
        aliases: Set[str](),
        public: Set[int](),
        asks: [],
        else_ops: [],
        generic_names: Set[str](),
        in_ensures: false,
        after_stmts: [],
        olds: [],
        fns: [],
        structs: [],
        enums: [],
        traits: [],
        impls: [],
        consts: [],
        uses: [],
        member_owner: "",
        misnamed: Set[str](),
        renamed: Set[str](),
        loops: [],
        nest: 0,
    )

## Parse a file's tokens (the lexer's, ending in `Eof`).
pub fn parse(tokens List[Token]) Parsed
    parse_with(tokens, Set[str]())

## `parse` of a file whose module's other files declare generic names too:
## `extra` are theirs (`absent[int]()` in a file that doesn't declare `absent`).
pub fn parse_with(tokens List[Token], extra Set[str]) Parsed
    mut p := new_parser(tokens, [])
    p.generic_names = generic_names(tokens)
    for n in extra.sorted()
        p.generic_names.add(n)
    p.top_level()
    public := p.public.sorted()
    program := ast.Program(
        fns: p.fns,
        structs: p.structs,
        enums: p.enums,
        traits: p.traits,
        impls: p.impls,
        consts: p.consts,
        uses: p.uses,
        public: public,
        files: [],
        grants: [],
        unsafe_allowed: none,
        driver_allowed: [],
        generated: [],
        asks: p.asks,
        else_ops: p.else_ops,
    )
    Parsed(program: program, diags: p.diags)

fn Parser.top_level(mut self)
    while true
        tag := tok_tag(self.peek())
        text := tok_text(self.peek())
        if tag == "eof"
            break
        if tag == "nl" or tag == "dedent"
            self.i += 1
        elif tag == "indent"
            self.unexpected_indent()
            self.skip_block()
        elif tag == "kw" and text == "fn"
            if f := self.function(ast.Within.TopLevel)
                self.fns.push(f)
        elif tag == "kw"
            and (text == "unsafe" and self.kw_at(1) == "fn" or text == "extern" and self.at_extern_fn())
            if f := self.function(ast.Within.TopLevel)
                self.fns.push(f)
        elif tag == "kw" and text == "use"
            use_decl()
        elif tag == "kw" and text == "pub"
            pub_marker()
        elif tag == "id" and text == "export" and self.at_export_fn()
            if f := self.export_function()
                self.fns.push(f)
        elif tag == "sym" and text == "@"
            # `@derive(f) trait Name` (ct.derive.1), or `@name fn ...` (gram.attr.1-2).
            if not derive_trait()
                if f := self.attributed_function()
                    self.fns.push(f)
        elif tag == "kw" and text == "trait"
            self.trait_decl()
        elif tag == "kw" and text == "impl"
            self.impl_decl()
        elif tag == "id" and self.sym_at(1) == ":="
            # `NAME := expr`: a constant (mod.const.1).
            pos := self.bump().pos
            self.i += 1
            if value := self.expression()
                if self.eat_newline()
                    self.consts.push(ast.ConstDecl(name: text, pos: pos, doc: none, value: value))
                else
                    self.unexpected("end of line after the constant", "lex.stmt.1")
                    self.skip_statement()
            else
                self.skip_statement()
        elif tag == "kw" and text == "struct"
            if s := self.struct_decl(false)
                self.structs.push(s)
        elif tag == "id" and text == "type" and self.tag_at(1) == "id"
            # `type Name = Base`: a distinct type (type.distinct.1, ADR 1103).
            if s := distinct_decl()
                self.structs.push(s)
        elif tag == "kw" and text == "unique"
            # `unique struct` and `unique enum` (own.uniq.1).
            if self.kw_at(1) == "struct"
                self.i += 1
                if s := self.struct_decl(false)
                    mut u := s
                    u.is_unique = true
                    self.structs.push(u)
            elif self.kw_at(1) == "enum"
                self.i += 1
                if e := self.enum_decl(false)
                    mut u := e
                    u.is_unique = true
                    self.enums.push(u)
            else
                self.i += 1
                self.unexpected("`struct` or `enum` after `unique`", "own.uniq.1")
                self.skip_statement()
        elif tag == "kw" and text == "enum"
            if e := self.enum_decl(false)
                self.enums.push(e)
        elif tag == "kw" and text == "error"
            # `error struct` and `error enum` declare error types (err.decl.1).
            if self.kw_at(1) == "struct"
                self.i += 1
                if s := self.struct_decl(true)
                    self.structs.push(s)
            elif self.kw_at(1) == "enum"
                self.i += 1
                if e := self.enum_decl(true)
                    self.enums.push(e)
            else
                self.i += 1
                self.unexpected("`struct` or `enum` after `error`", "err.decl.1")
                self.skip_statement()
        elif tag == "kw" and text == "mut" and self.tag_at(1) == "id"
            self.error_text(
                "mod.const.1",
                self.here(),
                "there are no mutable top-level variables",
                "declare a constant `NAME := value`, or pass the value to the functions that change it",
                "",
            )
            self.skip_statement()
        elif tag == "id"
            and (text == "const" or text == "let" or text == "var")
            and self.tag_at(1) == "id"
            mut title := ""
            if self.sym_at(2) == "="
                title = "declare the constant with `:=`"
            elif self.sym_at(2) == ":="
                title = "remove `{text}`"
            self.error_text(
                "mod.const.1",
                self.here(),
                "AIL has no `{text}`; a constant is declared `NAME := value`",
                "remove the keyword and write `NAME := value`",
                title,
            )
            if title != "" and self.sym_at(2) == ":="
                self.attach(title, [fix.delete(self.here(), self.tokens[self.i + 1].pos)])
            elif title != ""
                eq := self.tokens[self.i + 2].pos
                self.attach(title, [
                    fix.delete(self.here(), self.tokens[self.i + 1].pos),
                    fix.span(eq, ast.Pos(line: eq.line, col: eq.col + 1), ":="),
                ])
            self.skip_statement()
        elif tag == "id" and foreign_decl(text)
            self.i += 0
        else
            self.unexpected(
                "a declaration (`fn`, `struct`, `enum`, `error`, `unique`, `trait`, `impl` or a constant)",
                "gram.syntax.1",
            )
            self.skip_statement()

# ---- Tokens ----

fn Parser.peek(self) Tok
    self.tokens[self.i].tok

fn Parser.peek_at(self, n int) Tok
    k := self.i + n
    if k < self.tokens.len() then self.tokens[k].tok else self.tokens[self.tokens.len() - 1].tok

fn Parser.tag_at(self, n int) str
    tok_tag(self.peek_at(n))

## The symbol `n` tokens ahead, or "".
fn Parser.sym_at(self, n int) str
    match self.peek_at(n)
        Sym(s) => s
        Ident(_) | Kw(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

## The keyword `n` tokens ahead, or "".
fn Parser.kw_at(self, n int) str
    match self.peek_at(n)
        Kw(w) => w
        Ident(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""

fn Parser.here(self) ast.Pos
    self.tokens[self.i].pos

fn Parser.tok_pos(self, k int) ast.Pos
    self.tokens[k.min(self.tokens.len() - 1)].pos

fn Parser.bump(mut self) Token
    t := self.tokens[self.i]
    if t.tok != Tok.Eof
        self.i += 1
    t

fn Parser.at_newline(self) bool
    self.peek() == Tok.Newline

fn Parser.eat_newline(mut self) bool
    if self.peek() == Tok.Newline
        self.i += 1
        return true
    false

fn Parser.eat_indent(mut self) bool
    if self.peek() == Tok.Indent
        self.i += 1
        return true
    false

fn Parser.eat_dedent(mut self) bool
    if self.peek() == Tok.Dedent
        self.i += 1
        return true
    false

fn Parser.at_sym(self, s str) bool
    self.sym_at(0) == s

fn Parser.eat_sym(mut self, s str) bool
    if self.sym_at(0) == s
        self.i += 1
        return true
    false

fn Parser.at_kw(self, k str) bool
    self.kw_at(0) == k

fn Parser.eat_kw(mut self, k str) bool
    if self.kw_at(0) == k
        self.i += 1
        return true
    false

## At a name: its text.
fn Parser.ident(self) str?
    if self.tag_at(0) == "id" then tok_text(self.peek()) else none

## The previous token closed a block, so the statement ended there.
fn Parser.after_block(self) bool
    self.i > 0 and self.tokens[self.i - 1].tok == Tok.Dedent

## Whether token `k + 1` follows token `k` with no blank between.
fn Parser.adjacent(self, k int) bool
    if k + 1 >= self.tokens.len()
        return false
    a := self.tokens[k].pos
    b := self.tokens[k + 1].pos
    a.line == b.line and b.col == a.col + 1

## Whether the token at `k` is the last one on its line.
fn Parser.line_ends_at(self, k int) bool
    if k + 1 >= self.tokens.len()
        return true
    self.tokens[k + 1].pos.line > self.tokens[k].pos.line or self.tokens[k + 1].tok == Tok.Eof

# ---- Diagnostics ----

fn Parser.diag(mut self, rule str, pos ast.Pos)
    self.diags.push(Diag(rule: rule, pos: pos, msg: "", fixed: false, help: "", fix: "", edits: []))

## `return a, b` (lex.stmt.1): several values are returned as one tuple, `return (a, b)`. The fix is certain when the
## values end on the `return` line (fix.auto.1, ADR 1175). `first` is where the first value starts; the parser is at
## the comma.
fn Parser.return_list(mut self, first ast.Pos)
    mut j := self.i
    while j < self.tokens.len()
        and self.tokens[j].pos.line == first.line
        and tok_tag(self.tokens[j].tok) != "nl"
        j += 1
    one_line := j < self.tokens.len() and tok_tag(self.tokens[j].tok) == "nl"
    self.error_text(
        "lex.stmt.1",
        self.here(),
        "`return` takes one value: several are returned as a tuple",
        "write `return (a, b)`, with the result type `(A, B)`; the caller takes it apart with `a, b := f()`",
        if one_line then fix.RETURN_TUPLE_FIX else "",
    )
    if one_line
        self.attach(fix.RETURN_TUPLE_FIX, [fix.insert(first, "("), fix.at_line_end(first, ")")])

## The position of the next token when it is on the line of `at`, else `at`.
fn Parser.next_on_line(self, here_pos ast.Pos) ast.Pos
    if self.i + 1 < self.tokens.len() and self.tokens[self.i + 1].pos.line == here_pos.line
        return self.tokens[self.i + 1].pos
    here_pos

## `n` columns after `at`, or the next token's position when it is on the line.
fn Parser.after_on_line(self, here_pos ast.Pos, n int) ast.Pos
    if self.i + 1 < self.tokens.len() and self.tokens[self.i + 1].pos.line == here_pos.line
        return self.tokens[self.i + 1].pos
    ast.Pos(line: here_pos.line, col: here_pos.col + n)

## The end of token `k` on its line, when its text is known (identifiers, keywords, symbols).
## The edits of `{{x}}` in a string: `\{` for the first brace, and the last `}` goes.
fn escape_brace_edits(code List[Token]) List[fix.Edit]
    inner := code[0].pos
    mut edits := [fix.span(
        ast.Pos(line: inner.line, col: inner.col - 1),
        ast.Pos(line: inner.line, col: inner.col + 1),
        "\\\{",
    )]
    if code.len() >= 2
        last := code[code.len() - 2]
        if tok_tag(last.tok) == "sym" and tok_text(last.tok) == "}"
            edits.push(fix.delete(
                ast.Pos(line: last.pos.line, col: last.pos.col + 1),
                ast.Pos(line: last.pos.line, col: last.pos.col + 2),
            ))
    edits

fn Parser.tok_end(self, k int) ast.Pos?
    if k < 0 or k >= self.tokens.len()
        return none
    text := tok_text(self.tokens[k].tok)
    if text == ""
        return none
    ast.Pos(line: self.tokens[k].pos.line, col: self.tokens[k].pos.col + text.chars().len())

## Whether the previous token ends exactly at `at`.
fn Parser.attached_before(self, here_pos ast.Pos) bool
    e := self.tok_end(self.i - 1) else return false
    e == here_pos

## Give the diagnostic just reported a fix.
fn Parser.attach(mut self, title str, edits List[fix.Edit])
    self.diags[self.diags.len() - 1].fixed = true
    self.diags[self.diags.len() - 1].fix = title
    self.diags[self.diags.len() - 1].edits = edits

## A diagnostic with a fix. The same mistake again on one line is one
## diagnostic with one fix (gram.rec.1): `msg` identifies the mistake.
fn Parser.error_fix(
    mut self,
    rule str,
    pos ast.Pos,
    msg str,
    help str,
    title str,
    edits List[fix.Edit],
)
    if self.diags.len() > 0
        last := self.diags[self.diags.len() - 1]
        if last.rule == rule and last.pos.line == pos.line and last.msg == msg and last.fixed
            # The same mistake again on one line: its edits join the first report's.
            self.diags[self.diags.len() - 1].edits.extend(edits)
            return
    self.diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: true,
        help: help,
        fix: title,
        edits: edits,
    ))

## A diagnostic with the bootstrap's message, help line and fix title.
fn Parser.error_text(mut self, rule str, pos ast.Pos, msg str, help str, title str)
    self.diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: false,
        help: help,
        fix: title,
        edits: [],
    ))

fn Parser.int_too_big(mut self, pos ast.Pos)
    self.error_text(
        "lex.num.3",
        pos,
        "integer literal `9223372036854775808` doesn't fit in `int` (64-bit signed)",
        "",
        "",
    )

fn Parser.range_start_error(mut self, pos ast.Pos)
    self.error_text(
        "expr.match.12",
        pos,
        "only integer and character literals can start a range pattern",
        "write `lo..hi` or `lo..=hi` with literal ends",
        "",
    )

fn Parser.unexpected_indent(mut self)
    self.error_text(
        "lex.block.1",
        self.here(),
        "unexpected indentation",
        "only a line that opens a block (like `if`, `for` or `fn`) can be followed by an indented line",
        "",
    )

## How the Rust front end names a token in "expected X, found Y".
fn Parser.describe(self, t Tok) str
    match t
        Eof => if self.in_interp then "`}`" else "end of file"
        Ident(n) => "`{n}`"
        Kw(k) => "the keyword `{k}`"
        Sym(x) => "`{x}`"
        Str(_) | Interp(_) => "a string"
        Bytes(_) => "a `bytes` literal"
        Int(_) | IntMin => "an integer"
        Float(_) => "a number"
        Char(_) => "a character"
        Newline => "end of line"
        Indent => "an indented block"
        Dedent => "end of block"

## Report an unexpected token, preferring "not supported yet" for spec
## keywords the bootstrap doesn't implement.
fn Parser.unexpected(mut self, expected str, rule str)
    prev_tag := if self.i > 0 then tok_tag(self.tokens[self.i - 1].tok) else ""
    cast := prev_tag == "id"
        or prev_tag == "int"
        or prev_tag == "float"
        or (self.i > 0 and (self.tokens[self.i - 1].tok == Tok.Sym(")") or self.tokens[self.i - 1].tok == Tok.Sym("]")))
    if self.tag_at(0) == "kw" and not_yet(self.kw_at(0)) and not cast
        self.error_text(
            "bootstrap.unsupported",
            self.here(),
            "`{self.kw_at(0)}` is not supported by the bootstrap yet (spec ffi.decl.1)",
            "",
            "",
        )
        return
    if self.tag_at(0) == "kw" and not_yet(self.kw_at(0))
        # `x as float` (a Rust or TypeScript cast) after a value.
        self.error_text(
            "gram.foreign.1",
            self.here(),
            "`as` is not an expression keyword in AIL",
            "convert with a method: `n.to_float()`, `x.to_int()` (a `float` truncates toward zero), `n.to_str()`",
            "",
        )
        t := tok_text(self.tokens[self.i + 1].tok)
        method := match t
            "float" | "f64" => "to_float"
            "int" | "i64" | "usize" | "isize" | "u64" => "to_int"
            "str" | "string" | "String" => "to_str"
            _ => ""
        prev := if self.i > 0 then tok_tag(self.tokens[self.i - 1].tok) else ""
        if method != "" and prev == "id"
            if e1 := self.tok_end(self.i - 1)
                if e2 := self.tok_end(self.i + 1)
                    self.attach("write `.{method}()`", [fix.span(e1, e2, ".{method}()")])
        return
    # `a if c else b` (lex.stmt.1): the Python form of a one-line `if`.
    if rule == "lex.stmt.1" and self.at_kw("if")
        self.error_text(
            rule,
            self.here(),
            "expected {expected}, found `if`",
            "write the condition first: `if c then a else b` (in a larger expression `(if c then a else b)`)",
            "",
        )
        return
    self.error_text(
        rule,
        self.here(),
        "expected {expected}, found {self.describe(self.peek())}",
        "",
        "",
    )

fn Parser.expect_sym(mut self, s str, expected str, rule str) bool?
    if self.eat_sym(s)
        return true
    self.unexpected(expected, rule)
    none

## Skip to the end of the current statement, including any indented
## blocks that follow it, so one error doesn't cascade.
fn Parser.skip_statement(mut self)
    while not stops(self.peek())
        self.i += 1
    self.eat_newline()
    while self.peek() == Tok.Indent
        self.skip_block()
        # `elif`/`else` continue the statement whose block was skipped.
        if self.at_kw("elif") or self.at_kw("else")
            while not stops(self.peek())
                self.i += 1
            self.eat_newline()

fn stops(t Tok) bool
    t == Tok.Newline or t == Tok.Indent or t == Tok.Dedent or t == Tok.Eof

## Skip an indented block, starting at its INDENT.
fn Parser.skip_block(mut self)
    if not self.eat_indent()
        return
    mut depth := 1
    while depth > 0 and self.peek() != Tok.Eof
        t := self.bump().tok
        if t == Tok.Indent
            depth += 1
        elif t == Tok.Dedent
            depth -= 1

## A name (not a keyword).
fn Parser.take_name(mut self, expected str, rule str) ast.Ident?
    if n := self.ident()
        pos := self.bump().pos
        return ast.Ident(name: n, pos: pos)
    if self.tag_at(0) == "kw" and not not_yet(self.kw_at(0))
        self.keyword_as_name(self.i)
        return none
    self.unexpected(expected, rule)
    none

## The name after `fn`; `method` allows a keyword (lex.kw.3, ADR 1085).
fn Parser.fn_name(mut self, method bool) ast.Ident?
    if method
        return self.member_name("a function name after `fn`", "gram.fn.1")
    self.take_name("a function name after `fn`", "gram.fn.1")

## The keyword `n` tokens ahead when it can stand as a name, or none: every
## keyword but the hole `uhwhatnow?` (lex.kw.3, ADR 1085).
fn Parser.kw_name_at(self, n int) str?
    w := self.kw_at(n)
    if w == "" or w == "uhwhatnow?"
        return none
    w

## A name where a keyword can mean nothing else, so any keyword is a plain
## name: a field, a name after `.`, a label before `:`, a method (lex.kw.3, ADR 1085).
fn Parser.member_name(mut self, expected str, rule str) ast.Ident?
    if w := self.kw_name_at(0)
        pos := self.bump().pos
        return ast.Ident(name: w, pos: pos)
    self.take_name(expected, rule)

## A keyword where a name is declared (lex.kw.1). Its help names a better
## word; a word with no other use in a function body also gets a fix that
## renames it through the rest of the function (ADR 1085).
fn Parser.keyword_as_name(mut self, k int)
    word := tok_text(self.tokens[k].tok)
    pos := self.tokens[k].pos
    msg := "`{word}` is a keyword and can't be used as a name"
    mut better := keyword_rename(word)
    if better == ""
        self.error_text("lex.kw.1", pos, msg, "choose a different name", "")
        return
    # A name no word of the file uses, so the rename can't merge two bindings (ADR 1211).
    better = self.fresh_name(better)
    help := "choose a different name, such as `{better}`; a keyword is a name only as a field, after `.` or as a label (lex.kw.3)"
    head := self.function_head(k)
    if head >= 0 and self.renamed.contains("{word}@{head}")
        # An earlier report's rename already runs through this function and rewrites this declaration too.
        return
    if not rename_is_safe(word) and self.used_later(k, word)
        # A word the language itself uses in bodies, written again later in the function: which of those are the
        # name is the author's call, so there is no fix; renaming the declaration alone would leave the uses broken
        # (fix.apply.1, checkbench ADR 1111).
        self.error_text("lex.kw.1", pos, msg, help, "")
        return
    # Certain (fix.auto.1) only inside a function, where the rename reaches every use (ADR 1211).
    scoped := if head >= 0 then fix.KEYWORD_RENAME_SCOPE else ""
    if not rename_is_safe(word)
        # A word the language itself uses in bodies, declared and never written again: rename the declaration.
        self.error_fix(
            "lex.kw.1",
            pos,
            msg,
            help,
            "rename `{word}` to `{better}` here{scoped}",
            [rename_edit(pos, word, better)],
        )
        return
    self.misnamed.add(word)
    if head >= 0
        self.renamed.add("{word}@{head}")
    self.error_fix(
        "lex.kw.1",
        pos,
        msg,
        help,
        "rename `{word}` to `{better}`{scoped}",
        self.rename_edits(k, word, better),
    )

## The token of the header of the function that holds token `k` (`fn` or `pub fn` or a test at column 1), or -1 when
## `k` is not inside one: a module item, or a type or `impl` body, where a rename can't reach every use (ADR 1211).
fn Parser.function_head(self, k int) int
    mut j := k
    while j >= 0
        t := self.tokens[j]
        tag := tok_tag(t.tok)
        if t.pos.col == 1 and (tag == "id" or tag == "kw" or tag == "sym")
            if j == k
                return -1
            w := tok_text(t.tok)
            if w == "fn" or w == "test"
                if j + 1 == k and w == "fn"
                    return -1
                return j
            if w == "pub" and j + 1 < k and tok_text(self.tokens[j + 1].tok) == "fn"
                if j + 2 == k
                    return -1
                return j
            return -1
        j -= 1
    -1

## `name` when no word of the file is spelled so, else `name_`, `name__`, ... (ADR 1211).
fn Parser.fresh_name(self, name str) str
    mut n := name
    while tokens_spell(self.tokens, n)
        n = "{n}_"
    n

fn tokens_spell(toks List[Token], name str) bool
    for t in toks
        match t.tok
            Ident(w) =>
                if w == name
                    return true
            Interp(parts) =>
                for part in parts
                    match part
                        Lit(_) => continue
                        Code(code) =>
                            if tokens_spell(code, name)
                                return true
                        Fmt(code, _) =>
                            if tokens_spell(code, name)
                                return true
            Kw(_) | Sym(_) | Str(_) | Bytes(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => continue
    false

## The tokens of the keywords among the names of `a, b := e` that starts at token `k`; none when the line is not
## such a declaration.
fn Parser.keyword_names_declared(self, k int) List[int]
    mut out := List[int]()
    mut j := k
    while j + 1 < self.tokens.len()
        t := self.tokens[j].tok
        tag := tok_tag(t)
        if tag == "kw" and not not_yet(tok_text(t))
            out.push(j)
        elif tag != "id"
            return List[int]()
        nt := self.tokens[j + 1].tok
        if nt == Tok.Sym(",")
            j += 2
            continue
        if nt == Tok.Sym(":=")
            return out
        return List[int]()
    List[int]()

## Whether the keyword `word` is written again after token `k`, before the end of the function (the next
## line that starts at column 1).
fn Parser.used_later(self, k int, word str) bool
    mut j := k + 1
    while j < self.tokens.len()
        t := self.tokens[j]
        tag := tok_tag(t.tok)
        if tag == "eof" or (t.pos.col == 1 and (tag == "id" or tag == "kw" or tag == "sym"))
            return false
        if tag == "kw" and tok_text(t.tok) == word
            return true
        j += 1
    false

## The edits that rename the keyword `word` at token `k` and each later use
## of it as a name, through the end of the function: the next line that
## starts at column 1 (lex.kw.1, ADR 1085).
fn Parser.rename_edits(self, k int, word str, better str) List[fix.Edit]
    mut edits := [rename_edit(self.tokens[k].pos, word, better)]
    mut j := k + 1
    while j < self.tokens.len()
        t := self.tokens[j]
        tag := tok_tag(t.tok)
        if tag == "eof" or (t.pos.col == 1 and (tag == "id" or tag == "kw" or tag == "sym"))
            break
        rename_uses(self.tokens, j, word, better, mut edits)
        j += 1
    edits

fn rename_edit(pos ast.Pos, word str, better str) fix.Edit
    fix.span(pos, ast.Pos(line: pos.line, col: pos.col + word.len()), better)

## Token `j` of `toks` as a use of the renamed keyword `word`: the word
## followed by a symbol, a line end or an operator word, and not after `.`;
## or such a use inside an interpolated string (lex.kw.1, ADR 1085).
fn rename_uses(toks List[Token], j int, word str, better str, mut edits List[fix.Edit])
    match toks[j].tok
        Interp(parts) =>
            for part in parts
                match part
                    Lit(_) => continue
                    Code(code) =>
                        for c in 0..code.len()
                            rename_uses(code, c, word, better, mut edits)
                    Fmt(code, _) =>
                        for c in 0..code.len()
                            rename_uses(code, c, word, better, mut edits)
        Kw(w) =>
            if w != word or j + 1 >= toks.len()
                return
            if j > 0 and toks[j - 1].tok == Tok.Sym(".")
                return
            # The keyword itself, not a name: `for x in xs`, `match -x`.
            if word == "in"
                and j > 0
                and (tok_tag(toks[j - 1].tok) == "id" or toks[j - 1].tok == Tok.Sym(")") or toks[j - 1].tok == Tok.Sym("]"))
                return
            if word == "match"
                and (toks[j + 1].tok == Tok.Sym("-") or toks[j + 1].tok == Tok.Sym("[") or toks[j + 1].tok == Tok.Sym("\{") or toks[j + 1].tok == Tok.Sym("|"))
                return
            # A label in a call or literal (`Outcome(error: e)`) is the field's name, not this binding (lex.kw.3).
            if toks[j + 1].tok == Tok.Sym(":") and in_call_parens(toks, j)
                return
            if name_use_follows(toks[j + 1].tok)
                edits.push(rename_edit(toks[j].pos, word, better))
        Ident(_) | Sym(_) | Str(_) | Bytes(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => return

## Whether token `j` stands directly inside parentheses (the nearest unclosed bracket before it is `(`).
fn in_call_parens(toks List[Token], j int) bool
    mut depth := 0
    mut i := j - 1
    while i >= 0
        t := toks[i].tok
        if t == Tok.Sym(")") or t == Tok.Sym("]") or t == Tok.Sym("}")
            depth += 1
        elif t == Tok.Sym("(") or t == Tok.Sym("[") or t == Tok.Sym("\{")
            if depth == 0
                return t == Tok.Sym("(")
            depth -= 1
        i -= 1
    false

fn name_use_follows(t Tok) bool
    match t
        Sym(s) => s != "("
        Kw(w) => w == "and" or w == "or" or w == "else" or w == "in"
        Newline | Dedent | Eof => true
        Ident(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Indent => false

## A name to write instead of the keyword `word`, or "" (lex.kw.1, ADR 1085).
fn keyword_rename(word str) str
    match word
        "error" => "err"
        "todo" => "pending"
        "any" => "some"
        "unique" => "distinct"
        "all" => "every"
        "with" => "using"
        "par" => "parallel"
        "ref" => "reference"
        "enum" => "kind"
        "struct" => "record"
        "use" => "usage"
        "pub" => "public"
        "in" => "input"
        "match" => "matched"
        "fn" => "func"
        "move" => "step"
        _ => "{word}_"

## Whether the keyword `word` has no use inside a function body that a
## rename could hit, so the rename can be applied (lex.kw.1, ADR 1085).
fn rename_is_safe(word str) bool
    match word
        "return" | "break" | "continue" | "true" | "false" | "none" | "self" | "else" | "elif" | "and" | "or" | "not" | "if" | "while" | "for" | "defer" | "unsafe" | "fn" | "move" | "mut" | "spawn" | "yield" | "as" => false
        _ => true

## `Name`, or a qualified `m.Name` of an imported module (mod.use.2).
fn Parser.dotted_name(mut self, expected str, rule str) ast.Ident?
    first := self.take_name(expected, rule)?
    mut name := first.name
    while self.at_sym(".") and self.tag_at(1) == "id"
        self.i += 1
        next := self.take_name(expected, rule)?
        name = "{name}.{next.name}"
    ast.Ident(name: name, pos: first.pos)

# ---- Blocks ----

## NEWLINE INDENT statement+ DEDENT, after a line that opens a block.
fn Parser.block(mut self, after str, rule str) List[ast.Stmt]?
    if not self.eat_newline()
        match header_tail(after)
            GoOn => self.i += 0
            Reported => return none
            NotHeader =>
                self.unexpected("end of line after {after}", rule)
                return none
    if not self.eat_indent()
        self.error_text(
            rule,
            self.here(),
            "expected an indented block after {after}",
            "indent the block by 4 spaces",
            "",
        )
        return []
    self.block_rest()

## The statements of a block after its INDENT, through its DEDENT.
fn Parser.block_rest(mut self) List[ast.Stmt]
    mut body := List[ast.Stmt]()
    while self.peek() != Tok.Dedent and self.peek() != Tok.Eof
        if self.eat_newline()
            continue
        if s := self.statement()
            body.push(s)
            for t in self.after_stmts
                body.push(t)
            self.after_stmts = []
    self.eat_dedent()
    body

# ---- Declarations ----

## `fn [Type.]name(params) [ReturnType]` and its body. In a trait, the
## body is optional (trait.decl.2).
fn Parser.function(mut self, within ast.Within) ast.FnDecl?
    f := self.function_inner(within)
    if f == none
        self.skip_statement()
    f

## `@name` or `@name(args)`, repeated, then a function (gram.attr.1-2).
fn Parser.attributed_function(mut self) ast.FnDecl?
    mut attrs := List[ast.Attr]()
    while self.at_sym("@")
        self.i += 1
        a := self.take_name("an attribute name after `@`", "gram.attr.1") else
            self.skip_statement()
            return none
        mut arg := absent[str]()
        mut listed := ""
        if self.at_sym("(")
            mut depth := 0
            while true
                t := self.peek()
                tag := tok_tag(t)
                if tag == "nl" or tag == "eof"
                    break
                match t
                    Str(text) =>
                        if depth == 1 and arg == none
                            arg = text
                    Ident(word) =>
                        if depth == 1
                            listed = "{listed}{word}"
                    Kw(word) =>
                        if depth == 1
                            listed = "{listed}{word}"
                    Sym(s) =>
                        if s == "("
                            depth += 1
                        elif s == ")"
                            depth -= 1
                        elif depth == 1 and (s == "." or s == ",")
                            listed = "{listed}{s}"
                    Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => self.i += 0
                self.i += 1
                if depth == 0
                    break
        # `@caps(fs, net.serve)` (eff.cap.6): the list is kept as `fs,net.serve`.
        if a.name == "caps" and listed != ""
            arg = listed
        # `@needs(net, proc)` (test.sandbox.1): bare words name capabilities, kept as `cap:net,proc`;
        # `@needs("NAME")` with a string names a fixture (test.fixture.3).
        if a.name == "needs" and arg == none and listed != ""
            arg = "cap:{listed}"
        attrs.push(ast.Attr(name: a.name, pos: a.pos, arg: arg))
        # gram.attr.2: an attribute may sit on its own line above its function.
        while self.at_newline()
            and (self.sym_at(1) == "@" or self.kw_at(1) == "fn" or self.kw_at(1) == "unsafe" or self.kw_at(1) == "extern")
            self.i += 1
    if not self.at_kw("fn")
        and not (self.at_kw("unsafe") and self.kw_at(1) == "fn")
        and not self.at_extern_fn()
        self.error_text(
            "gram.attr.2",
            self.here(),
            "an attribute applies to the function declared right after it",
            "write `@test fn name()` or put the function on the next line",
            "",
        )
        self.skip_statement()
        return none
    mut f := self.function(ast.Within.TopLevel)?
    # Keep the `variadic c` mark the signature added (ffi.var.1).
    mut all := attrs
    for a in f.attrs
        all.push(a)
    f.attrs = all
    f

## At `extern c ["lib"] fn`.
fn Parser.at_extern_fn(self) bool
    if not self.at_kw("extern") or self.tag_at(1) != "id"
        return false
    self.kw_at(2) == "fn" or self.tag_at(2) == "str" and self.kw_at(3) == "fn"

## At `export c ["symbol"] fn` (ffi.export.1).
fn Parser.at_export_fn(self) bool
    if self.tag_at(1) != "id"
        return false
    self.kw_at(2) == "fn" or self.tag_at(2) == "str" and self.kw_at(3) == "fn"

## `pub export c ["symbol"] fn name(params) Result` and its body: an ordinary
## function plus the attribute `@export` (ffi.export.1). The optional string
## is the C symbol; the default is the AIL name.
fn Parser.export_function(mut self) ast.FnDecl?
    had_pub := self.kw_at(-1) == "pub"
    kw_pos := self.bump().pos
    if not had_pub
        self.error_text(
            "ffi.export.1",
            kw_pos,
            "an exported function is public to C, so it needs `pub`",
            "write `pub export c fn name(params) Result`",
            "",
        )
    lang := self.take_name("`c` after `export`", "ffi.export.1")?
    if lang.name != "c"
        self.error_text(
            "ffi.export.1",
            lang.pos,
            "`export {lang.name}` is not supported",
            "write `pub export c fn name(params) Result`",
            "",
        )
        self.skip_statement()
        return none
    mut sym := absent[str]()
    match self.peek()
        Str(text) =>
            self.i += 1
            sym = text
        Ident(_) | Kw(_) | Sym(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => self.i += 0
    mut f := self.function(ast.Within.TopLevel)?
    f.attrs.push(ast.Attr(name: "export c", pos: kw_pos, arg: sym))
    f

fn in_trait(w ast.Within) bool
    match w
        InTrait(_) => true
        TopLevel | InImpl(_) => false

fn Parser.function_inner(mut self, within ast.Within) ast.FnDecl?
    mut unsafe_fn := false
    mut ext := absent[ast.Extern]()
    if self.eat_kw("unsafe")
        unsafe_fn = true
    elif self.at_kw("extern")
        kw_pos := self.bump().pos
        lang := self.take_name("`c` after `extern`", "ffi.decl.2")?
        if lang.name != "c"
            self.error_text(
                "ffi.decl.2",
                lang.pos,
                "`extern {lang.name}` is not supported",
                "write `extern c fn name(params) Result`",
                "",
            )
            return none
        mut lib := absent[str]()
        match self.peek()
            Str(text) =>
                self.i += 1
                lib = text
            Ident(_) | Kw(_) | Sym(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => self.i += 0
        if within != ast.Within.TopLevel
            self.error_text(
                "ffi.decl.2",
                kw_pos,
                "an `extern c fn` is declared at the top level",
                "move it out of the `trait` or `impl` block",
                "",
            )
            return none
        ext = ast.Extern(lib: lib)
    self.bump()
    # `fn error(self)` inside a trait or impl block names a method (lex.kw.3, ADR 1085).
    in_block := within != ast.Within.TopLevel and self.kw_name_at(0) != none
    method_kw := in_block and (self.sym_at(1) == "(" or self.sym_at(1) == "[")
    if go_receiver()
        return none
    first := self.fn_name(method_kw)?
    # `fn f[T](...)`, `fn Type.m(...)`, `fn Type[T Bound].m(...)` (gen.method.1-2).
    mut generics := List[ast.GenericParam]()
    if self.at_sym("[")
        generics = self.generic_params()?
    mut owner := none
    mut name := first.name
    mut pos := first.pos
    if self.eat_sym(".")
        mut params := none
        if generics.len() > 0
            params = generics
        generics = []
        m := self.member_name("a method name after `.`", "trait.method.1")?
        if self.at_sym("[")
            generics = self.generic_params()?
        if self.at_sym(".")
            self.error_text(
                "mod.unit.4",
                self.here(),
                "a method is declared in the module of its type",
                "move the method into the module that declares `{first.name}.{m.name}`",
                "",
            )
            return none
        owner = ast.Owner(name: first.name, pos: first.pos, params: params)
        name = m.name
        pos = m.pos
    if owner != none and within != ast.Within.TopLevel
        block := if in_trait(within) then "a `trait`" else "an `impl`"
        self.error_text(
            "trait.impl.1",
            pos,
            "functions in {block} block are written without a type name",
            "write `fn {name}(...)`",
            "",
        )
        return none
    self.expect_sym("(", "`(` after the function name", "gram.fn.1")?
    mut receiver := absent[ast.Receiver]()
    mut params := List[ast.Param]()
    mut variadic := false
    while not self.at_sym(")")
        if self.at_sym("..") and self.sym_at(1) == "."
            # ffi.var.1: `...` ends the parameters of an `extern c fn`, after at least one.
            if ext == none or params.len() == 0
                self.error_text(
                    "ffi.var.1",
                    self.here(),
                    "`...` ends the parameter list of an `extern c fn` that has a named parameter before it",
                    "write `extern c fn name(first i32, ...) Result`",
                    "",
                )
                return none
            self.i += 2
            variadic = true
            break
        is_self := self.at_kw("self")
            or (self.at_kw("mut") or self.at_kw("move")) and self.kw_at(1) == "self"
        if is_self
            mutable := self.eat_kw("mut")
            moved := not mutable and self.eat_kw("move")
            spos := self.bump().pos
            if owner == none and within == ast.Within.TopLevel
                self.error_text(
                    "trait.method.1",
                    spos,
                    "`self` is only allowed in methods",
                    "declare a method as `fn Type.{name}(self, ...)`",
                    "",
                )
            elif receiver != none or params.len() > 0
                self.error_text(
                    "trait.method.1",
                    spos,
                    "`self` must be the first parameter",
                    "",
                    "",
                )
            elif moved and within != ast.Within.TopLevel
                self.error_text(
                    "bootstrap.unsupported",
                    spos,
                    "`move self` is only allowed on a method written `fn T.m(move self)` outside an `impl` or `trait` block (own.move.6)",
                    "move the method out of the block: `fn Type.{name}(move self)`",
                    "",
                )
                return none
            else
                receiver = ast.Receiver(mutable: mutable, moved: moved)
        else
            mutable := self.eat_kw("mut")
            moved := not mutable and self.eat_kw("move")
            p := self.take_name("a parameter name", "gram.fn.2")?
            if self.at_sym(":")
                self.error_fix(
                    "gram.fn.2",
                    self.here(),
                    "parameters are written `name Type`, without a colon",
                    "write `{p.name} <Type>`",
                    "remove the `:`",
                    [fix.span(self.here(), self.next_on_line(self.here()), " ")],
                )
                self.i += 1
            if not mutable and not moved and (self.at_kw("mut") or self.at_kw("move"))
                # gram.fn.2 (fix.auto.1): `items mut Map[K, V]` is `mut items Map[K, V]`.
                word := tok_text(self.peek())
                self.error_fix(
                    "gram.fn.2",
                    self.here(),
                    "`{word}` goes before the parameter's name",
                    "write `{word} {p.name} Type`",
                    "write `{word} {p.name}`",
                    [fix.insert(p.pos, "{word} "), fix.span(
                        self.here(),
                        self.next_on_line(self.here()),
                        "",
                    )],
                )
                self.i += 1
            ty := self.type_ref("the parameter's type (written `name Type`)", "gram.fn.2")?
            mut default := absent[ast.Expr]()
            if self.at_sym("=")
                if within != ast.Within.TopLevel
                    self.error_text(
                        "expr.call.4",
                        self.here(),
                        "a method of a trait or of an `impl Trait` block has no parameter defaults",
                        "give the default to the function that calls it, or declare the method as `fn Type.name(...)`",
                        "",
                    )
                    return none
                if mutable or moved
                    self.error_text(
                        "expr.call.4",
                        self.here(),
                        "a `mut` or `move` parameter has no default",
                        "remove the `= value`, or the `mut`/`move`",
                        "",
                    )
                    return none
                self.bump()
                default = self.expression()?
            elif params.len() > 0 and params[params.len() - 1].default != none
                self.error_text(
                    "expr.call.4",
                    self.here(),
                    "a parameter without a default can't follow one with a default",
                    "put the parameters with defaults last",
                    "",
                )
                return none
            params.push(ast.Param(
                name: p.name,
                pos: p.pos,
                mutable: mutable,
                moved: moved,
                ty: ty,
                default: default,
            ))
        if not self.eat_sym(",")
            break
    self.expect_sym(")", "`)` or `,` in the parameter list", "gram.fn.2")?
    if self.at_sym("->") or self.at_sym(":") and self.tag_at(1) != "nl"
        sym := if self.at_sym("->") then "->" else ":"
        self.error_fix(
            "gram.fn.2",
            self.here(),
            "there is no `{sym}`; the return type follows `)` directly",
            "remove the `{sym}`",
            "remove the `{sym}`",
            [fix.delete(self.here(), self.after_on_line(self.here(), sym.chars().len()))],
        )
        self.i += 1
    mut ret := none
    if self.tag_at(0) == "id"
        or self.at_sym("!")
        or self.at_sym("*")
        or self.at_sym("(")
        or self.at_kw("any")
        or self.at_kw("ref")
        or self.at_kw("fn")
        ret = self.type_ref("a return type", "gram.fn.2")?
    full := if o := owner then "`{o.name}.{name}`" else "`{name}`"
    # A trait method without a default ends with its signature (trait.decl.2).
    mut fb := FnBody(body: none, contracts: [])
    if ext != none and (owner != none or receiver != none or generics.len() > 0)
        self.error_text(
            "ffi.decl.2",
            pos,
            "an `extern c fn` is a plain function: no type, `self` or type parameters",
            "declare it as `extern c fn name(params) Result`, and wrap it in an AIL method",
            "",
        )
        return none
    if ext != none
        # ffi.decl.2: a C function has a signature and no body.
        if not self.eat_newline()
            self.unexpected("end of line after the signature of an `extern c fn`", "ffi.decl.2")
            return none
    elif in_trait(within) and self.tag_at(1) != "indent"
        if not self.eat_newline()
            self.unexpected("end of line after the signature", "trait.decl.1")
            return none
    else
        fb = fn_body("the signature of {full}", in_trait(within))?
    mut marks := List[ast.Attr]()
    if variadic
        marks.push(ast.Attr(name: "variadic c", pos: pos, arg: absent[str]()))
    ast.FnDecl(
        attrs: marks,
        owner: owner,
        name: name,
        pos: pos,
        doc: none,
        generics: generics,
        receiver: receiver,
        params: params,
        ret: ret,
        body: fb.body,
        within: within,
        contracts: fb.contracts,
        inherits: none,
        unsafe_fn: unsafe_fn,
        ext: ext,
    )

## `[T, U Bound + Bound]` (gen.decl.1, gen.bound.1).
fn Parser.generic_params(mut self) List[ast.GenericParam]?
    self.bump()
    mut params := List[ast.GenericParam]()
    while not self.at_sym("]")
        # gen.const.1: `const N int`, a const parameter.
        is_const := self.tag_at(0) == "id"
            and tok_text(self.peek()) == "const"
            and self.tag_at(1) == "id"
            and self.tag_at(2) == "id"
        if is_const
            self.bump()
        n := self.take_name("a type parameter name", "gen.decl.1")?
        mut bounds := List[ast.Ident]()
        if self.tag_at(0) == "id"
            bounds.push(self.dotted_name("a trait", "gen.bound.1")?)
            while self.eat_sym("+")
                bounds.push(self.dotted_name("a trait after `+`", "gen.bound.1")?)
        params.push(ast.GenericParam(name: n.name, pos: n.pos, bounds: bounds, is_const: is_const))
        if not self.eat_sym(",")
            break
    self.expect_sym("]", "`]` or `,` in the type parameters", "gen.decl.1")?
    params

## `trait Name` and its indented block of functions (trait.decl.1).
fn Parser.trait_decl(mut self)
    self.bump()
    n := self.take_name("a trait name after `trait`", "trait.decl.1") else
        self.skip_statement()
        return
    if self.at_sym("[")
        self.error_text(
            "trait.decl.3",
            self.here(),
            "a trait can't have type parameters in 0.1 (OQ-037)",
            "use a generic function `fn f[T](x T)`, or one trait per type; associated types are an open question",
            "",
        )
        self.skip_statement()
        return
    # trait.super.1: `trait Ord Eq` and `trait Sorted Ord + ToStr`.
    mut supers := List[ast.Ident]()
    if self.tag_at(0) == "id"
        first := self.dotted_name("a supertrait", "trait.super.1") else
            self.skip_statement()
            return
        supers.push(first)
        while self.eat_sym("+")
            next := self.dotted_name("a supertrait after `+`", "trait.super.1") else
                self.skip_statement()
                return
            supers.push(next)
    index := self.traits.len()
    self.traits.push(ast.TraitDecl(
        name: n.name,
        pos: n.pos,
        doc: none,
        methods: [],
        derive: none,
        supers: supers,
    ))
    if not self.eat_newline()
        self.unexpected("end of line after `trait {n.name}`", "trait.decl.1")
        self.skip_statement()
        return
    # A trait with supertraits may have no methods (trait.super.1). (The
    # prelude's `Hash` has none either; a file alone is never the prelude.)
    if (n.pos.line >= 1073741824 or supers.len() > 0) and self.peek() != Tok.Indent
        return
    methods := self.fn_block(ast.Within.InTrait(index), "`trait {n.name}`")
    self.traits[index].methods = methods

## Whether a `trait` of this name is declared in the file.
fn Parser.trait_declared(self, name str) bool
    for k in 0..self.tokens.len() - 1
        if self.tokens[k].tok == Tok.Kw("trait") and self.tokens[k + 1].tok == Tok.Ident(name)
            return true
    false

## Whether this file declares `trait name[...]`, which trait.decl.3 reports.
fn Parser.generic_trait_declared(self, name str) bool
    for k in 0..self.tokens.len() - 2
        if self.tokens[k].tok == Tok.Kw("trait")
            and self.tokens[k + 1].tok == Tok.Ident(name)
            and self.tokens[k + 2].tok == Tok.Sym("[")
            return true
    false

## `impl Trait for Type`, with an optional block of functions (trait.impl.1).
fn Parser.impl_decl(mut self)
    pos := self.bump().pos
    trait_name := self.dotted_name("a trait name after `impl`", "trait.impl.1") else
        self.skip_statement()
        return
    if not self.eat_kw("for")
        if self.at_newline()
            self.error_text(
                "trait.impl.1",
                self.tokens[self.i - 1].pos,
                "`impl {trait_name.name}` needs `for Type`: `impl` implements a trait",
                "methods of a struct are plain functions: `fn {trait_name.name}.name(self) T`",
                "",
            )
            declared := self.trait_declared(trait_name.name)
            if self.tag_at(1) == "indent" and not declared
                if moved := methods_out(self.i + 2, trait_name.name)
                    mut edits := moved
                    edits.push(fix.delete(
                        ast.Pos(line: pos.line, col: 1),
                        ast.Pos(line: pos.line + 1, col: 1),
                    ))
                    self.attach(
                        "move the methods out of the `impl` block and name the type in each",
                        edits,
                    )
        elif not (self.at_sym("[") and self.generic_trait_declared(trait_name.name))
            # `impl From[str] for A` of a `trait From[T]` already reported (trait.decl.3): no second report.
            self.unexpected("`for` after the trait name", "trait.impl.1")
        self.skip_statement()
        return
    target := self.dotted_name("the implementing type after `for`", "trait.impl.1") else
        self.skip_statement()
        return
    mut params := none
    if self.at_sym("[")
        ps := self.generic_params() else
            self.skip_statement()
            return
        params = ps
    index := self.impls.len()
    owner := ast.Owner(name: target.name, pos: target.pos, params: params)
    self.impls.push(ast.ImplDecl(
        trait_name: trait_name.name,
        trait_pos: trait_name.pos,
        target: owner,
        pos: pos,
        methods: [],
        uses: [],
    ))
    if not self.eat_newline()
        self.unexpected("end of line after the `impl`", "trait.impl.1")
        self.skip_statement()
        return
    if self.peek() == Tok.Indent
        if trait_name.name == "Hash" and self.uses_next()
            self.impls[index].uses = self.hash_uses()
        else
            methods := self.fn_block(ast.Within.InImpl(index), "the `impl`")
            self.impls[index].methods = methods

## Whether the block after an `impl` line starts with the word `uses`.
fn Parser.uses_next(self) bool
    match self.peek_at(1)
        Ident(s) => s == "uses"
        Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => false

## The indented line `uses a, b` of an `impl Hash` block: the fields that
## take part in the hash (trait.hash.1).
fn Parser.hash_uses(mut self) List[ast.Ident]
    mut out := List[ast.Ident]()
    self.eat_indent()
    self.bump()
    while true
        n := self.member_name("a field name after `uses`", "trait.hash.1") else break
        out.push(n)
        if not self.eat_sym(",")
            break
    self.eat_newline()
    while self.peek() != Tok.Dedent and self.peek() != Tok.Eof
        self.unexpected(
            "the end of the `impl Hash` block, which holds one `uses` line",
            "trait.hash.1",
        )
        self.skip_statement()
    self.eat_dedent()
    out

## The indented functions of a `trait` or `impl` block; their indexes in `fns`.
fn Parser.fn_block(mut self, within ast.Within, what str) List[int]
    mut indexes := List[int]()
    if not self.eat_indent()
        if in_trait(within)
            self.error_text(
                "trait.decl.1",
                self.here(),
                "{what} needs an indented block of methods",
                "indent each method by 4 spaces",
                "",
            )
        return indexes
    while self.peek() != Tok.Dedent and self.peek() != Tok.Eof
        if self.eat_newline()
            continue
        member_pub("trait and `impl` methods")
        if self.tag_at(0) == "id" and tok_text(self.peek()) == "type" and self.tag_at(1) == "id"
            self.error_text(
                "trait.decl.1",
                self.here(),
                "{what} holds methods only; an associated type isn't part of AIL 0.1",
                "make the type a parameter of a generic function, `fn f[T](x T)`, or name the concrete type in each method",
                "",
            )
            self.skip_statement()
            continue
        if not self.at_kw("fn")
            self.unexpected("a method (`fn ...`) in {what}", "trait.decl.1")
            self.skip_statement()
            continue
        if f := self.function(within)
            indexes.push(self.fns.len())
            self.fns.push(f)
    self.eat_dedent()
    indexes

## A type: `T`, `T?`, `T ! E`, `T ! A | B`, `!T`, or a bare `!`
## (type.opt.2, err.type.1-2, err.type.5).
fn Parser.type_ref(mut self, expected str, rule str) ast.TypeRef?
    pos := self.here()
    if self.at_sym("&")
        end := if self.kw_at(1) == "mut" then self.tok_pos(self.i + 2) else self.tok_pos(self.i + 1)
        self.error_fix(
            "gram.foreign.1",
            pos,
            "AIL has no references: `&T` is just `T`",
            "values are passed by value and a parameter that changes is marked `mut` at the call site (own.val.2); write the type without `&`: `s str`; shared mutation goes through `ref T` (own.ref.1)",
            "remove the `&`",
            [fix.delete(pos, end)],
        )
        return none
    if self.eat_sym("!")
        mut ok := none
        if self.tag_at(0) == "id"
            ok = self.optional_type(expected, rule)?
        elif self.at_kw("any")
            ok = self.type_ref(expected, rule)?
        # `! A | B`: no success value, and these errors (err.type.7).
        if first := ok
            if self.at_sym("|")
                mut errors := [first]
                while self.eat_sym("|")
                    errors.push(self.named_type("an error type after `|`", "err.type.5")?)
                return ast.TypeRef(
                    shape: ast.TypeShape.Fallible(ok: none, errors: errors),
                    pos: pos,
                )
        return ast.TypeRef(shape: ast.TypeShape.Fallible(ok: ok, errors: none), pos: pos)
    if self.eat_kw("any")
        t := self.dotted_name("a trait after `any`", "trait.any.1")?
        return ast.TypeRef(shape: ast.TypeShape.AnyTrait(t.name), pos: pos)
    ok := self.optional_type(expected, rule)?
    if not self.eat_sym("!")
        return ok
    mut errors := [self.named_type("an error type after `!`", "err.type.1")?]
    while self.eat_sym("|")
        errors.push(self.named_type("an error type after `|`", "err.type.5")?)
    ast.TypeRef(shape: ast.TypeShape.Fallible(ok: ok, errors: errors), pos: pos)

## `T` or `T?` (type.opt.2); `T??` is an optional of an optional (type.opt.6).
fn Parser.optional_type(mut self, expected str, rule str) ast.TypeRef?
    mut t := self.named_type(expected, rule)?
    while self.eat_sym("?")
        t = ast.TypeRef(shape: ast.TypeShape.Optional(t), pos: t.pos)
    t

## `Name` or `Name[Arg, ...]` (gram.generic.1), a module's type `m.Name`
## (mod.use.2), or `ref T` (own.ref.1).
fn Parser.named_type(mut self, expected str, rule str) ast.TypeRef?
    if self.at_kw("error")
        self.error_text(
            "err.type.1",
            self.here(),
            "`error` is not a type in AIL",
            "a function that can fail ends its signature with `! MyError`, where `MyError` is declared with `error enum`: `fn f(n int) int ! MyError`; the success value is returned as it is",
            "",
        )
        return none
    if self.tokens[self.i].tok == Tok.Ident("Result") and self.sym_at(1) == "["
        if edits := result_type_edits()
            self.error_fix(
                "err.type.1",
                self.here(),
                "a result type is written `T ! E`, not `Result[T, E]`",
                "write `int ! MyError`: the success type, then `!`, then the error type declared with `error enum` (err.type.1)",
                "write `T ! E`",
                edits,
            )
            return none
    if self.at_kw("ref")
        pos := self.bump().pos
        inner := self.named_type("a type after `ref`", "own.ref.1")?
        return ast.TypeRef(shape: ast.TypeShape.RefTo(inner), pos: pos)
    if self.at_sym("*")
        pos := self.bump().pos
        inner := self.named_type("a type after `*`", "unsafe.ptr.1")?
        return ast.TypeRef(shape: ast.TypeShape.PtrTo(inner), pos: pos)
    # `(A, B)`: a tuple type, two or more elements (type.tuple.1).
    if self.at_sym("(")
        pos := self.bump().pos
        mut elems := List[ast.TypeRef]()
        while not self.at_sym(")")
            elems.push(self.type_ref("an element type", "type.tuple.1")?)
            if not self.eat_sym(",")
                break
        self.expect_sym(")", "`)` or `,` in the tuple type", "type.tuple.1")?
        if elems.len() < 2
            self.error_text(
                "type.tuple.1",
                pos,
                "a tuple type has two or more elements",
                "write the element type alone, or `(A, B)`",
                "",
            )
            return none
        return ast.TypeRef(shape: ast.TypeShape.TupleType(elems), pos: pos)
    # `fn(A, B) R`: a function value's type (type.fn.1).
    if self.at_kw("fn")
        pos := self.bump().pos
        self.expect_sym("(", "`(` after `fn` in a type", "type.fn.1")?
        mut params := List[ast.TypeRef]()
        while not self.at_sym(")")
            params.push(self.type_ref("a parameter type", "type.fn.1")?)
            if not self.eat_sym(",")
                break
        self.expect_sym(")", "`)` or `,` in the function type", "type.fn.1")?
        if self.at_sym("->")
            # The result type follows `)` directly, as in a declaration (gram.fn.2).
            arrow := self.here()
            self.error_fix(
                "gram.fn.2",
                arrow,
                "there is no `->` in a function type; the result type follows `)` directly",
                "write `fn(int) int`",
                "remove the `->`",
                [fix.delete(arrow, self.after_on_line(arrow, 2))],
            )
            return none
        mut ret := absent[ast.TypeRef]()
        if self.tag_at(0) == "id" or self.at_sym("(") or self.at_kw("any") or self.at_kw("ref")
            ret = self.optional_type("the result type", "type.fn.1")?
        # `fn(A) R ! E` and `fn(A) ! E`: a function value that can fail (type.fn.6, ADR 1067).
        if self.at_sym("!")
            bang := self.bump().pos
            mut errors := [self.named_type("an error type after `!`", "type.fn.6")?]
            while self.eat_sym("|")
                errors.push(self.named_type("an error type after `|`", "err.type.5")?)
            ret = ast.TypeRef(shape: ast.TypeShape.Fallible(ok: ret, errors: errors), pos: bang)
        return ast.TypeRef(shape: ast.TypeShape.FnType(params: params, ret: ret), pos: pos)
    n := self.dotted_name(expected, rule)?
    mut args := List[ast.TypeRef]()
    if self.at_sym("<")
        self.error_text(
            "gram.generic.1",
            self.here(),
            "type arguments are written in square brackets",
            "write `{n.name}[...]`",
            "",
        )
        return none
    if self.eat_sym("[")
        while true
            args.push(self.type_arg("gram.generic.1")?)
            if not self.eat_sym(",") or self.at_sym("]")
                break
        self.expect_sym("]", "`]` after the type arguments", "gram.generic.1")?
    ast.TypeRef(shape: ast.TypeShape.Named(name: n.name, args: args), pos: n.pos)

## `name Type`, a field of a struct or of a variant (type.struct.2, type.enum.2).
fn Parser.field_decl(mut self, rule str) ast.Field?
    mut observe := false
    if self.at_sym("@")
        self.i += 1
        a := self.take_name("an attribute name after `@`", "gram.attr.6")?
        if a.name != "observe"
            self.error_text(
                "gram.attr.6",
                a.pos,
                "`@{a.name}` doesn't apply to a field; the only field attribute is `@observe`",
                "write `@observe name Type`, or remove the attribute",
                "",
            )
            return none
        observe = true
    field_pub(rule)
    if self.at_kw("fn")
        msg := "methods aren't declared inside a struct"
        help := "declare the method after the struct, with the type's name: `fn Name.method(self) T`"
        # Methods are the last members, so they move out where they stand.
        if self.member_owner != "" and self.here().col == 5
            if moved := methods_out(self.i, self.member_owner)
                self.error_fix(
                    rule,
                    self.here(),
                    msg,
                    help,
                    "move the methods after the struct and name the type in each",
                    moved,
                )
                return none
        self.error_text(rule, self.here(), msg, help, "")
        return none
    f := self.member_name("a field name", rule)?
    if self.at_sym(":")
        self.error_fix(
            rule,
            self.here(),
            "fields are written `name Type`, without a colon",
            "write `{f.name} <Type>`",
            "remove the `:`",
            [fix.span(self.here(), self.next_on_line(self.here()), " ")],
        )
        self.i += 1
    if rule == "type.enum.2" and (self.at_sym(")") or self.at_sym(","))
        # `Num(int)`: the type alone, as other languages write a variant's payload.
        self.error_text(
            rule,
            f.pos,
            "a variant's field needs a name before its type; `{f.name}` alone is read as a name",
            "write `name Type`, such as `value {f.name}`",
            "",
        )
        return none
    ty := self.type_ref("the field's type (written `name Type`)", rule)?
    mut default := absent[ast.Expr]()
    if self.at_sym("=")
        if rule != "type.struct.2"
            self.error_text(
                "type.struct.8",
                self.here(),
                "a variant's field has no default",
                "only a struct field may declare one, as `name Type = value`; give the variant's fields when you construct it",
                "",
            )
            return none
        self.bump()
        default = self.expression()?
    ast.Field(name: f.name, pos: f.pos, doc: none, ty: ty, observe: observe, default: default)

## `struct Name` and one `name Type` field per line (type.struct.1-2).
fn Parser.struct_decl(mut self, is_error bool) ast.StructDecl?
    self.bump()
    n := self.take_name("a struct name after `struct`", "type.struct.1") else
        self.skip_statement()
        return none
    mut generics := List[ast.GenericParam]()
    if self.at_sym("[")
        g := self.generic_params() else
            self.skip_statement()
            return none
        generics = g
    whole := error_message(is_error)
    mut fields := List[ast.Field]()
    mut invariants := List[ast.Contract]()
    # err.msg.1: an error struct with a message may have no fields.
    bare := whole != none and self.at_newline() and self.tag_at(1) != "indent"
    if self.at_sym("(")
        self.error_text(
            "type.struct.1",
            self.here(),
            "a struct names each of its fields",
            "write `struct {n.name}` and one field per indented line: `value float`; a one-value wrapper is a struct with one field",
            "",
        )
        self.skip_statement()
        return none
    if bare
        self.bump()
    elif self.members_open("type.struct.1", "`struct {n.name}`")
        self.member_owner = n.name
        while self.peek() != Tok.Dedent and self.peek() != Tok.Eof
            if self.eat_newline()
                continue
            mut ok := false
            if self.at_kw("invariant")
                if c := contract_line(false)
                    invariants.push(c)
                    ok = true
            elif f := self.field_decl("type.struct.2")
                fields.push(f)
                ok = true
            self.member_end(ok)
        self.member_owner = ""
        self.eat_dedent()
    mut spliced := whole
    if m := whole
        if self.message_fields(n.name, n.pos, fields, m)
            spliced = none
    if spliced != none
        splice_messages(n.name, n.pos, generics.len() > 0, [], spliced)
    ast.StructDecl(
        name: n.name,
        pos: n.pos,
        doc: none,
        is_error: is_error,
        is_unique: false,
        is_distinct: false,
        generics: generics,
        fields: fields,
        invariants: invariants,
    )

## A variant's name, its fields and its message (err.msg.1).
struct VariantMessage
    name str
    fields List[str]
    message Token?

## `enum Name` and one variant per line (type.enum.1-2).
fn Parser.enum_decl(mut self, is_error bool) ast.EnumDecl?
    self.bump()
    n := self.take_name("an enum name after `enum`", "type.enum.1") else
        self.skip_statement()
        return none
    mut generics := List[ast.GenericParam]()
    if self.at_sym("[")
        g := self.generic_params() else
            self.skip_statement()
            return none
        generics = g
    mut variants := List[ast.Variant]()
    mut messages := List[VariantMessage]()
    if self.members_open("type.enum.1", "`enum {n.name}`")
        while self.peek() != Tok.Dedent and self.peek() != Tok.Eof
            if self.eat_newline()
                continue
            mut ok := false
            if v := self.variant(is_error, mut messages)
                variants.push(v)
                ok = true
            self.member_end(ok)
        self.eat_dedent()
    splice_messages(n.name, n.pos, generics.len() > 0, messages, none)
    ast.EnumDecl(
        name: n.name,
        pos: n.pos,
        doc: none,
        is_error: is_error,
        is_unique: false,
        generics: generics,
        variants: variants,
    )

fn Parser.variant(mut self, is_error bool, mut messages List[VariantMessage]) ast.Variant?
    member_pub("enum variants")
    v := self.take_name("a variant name", "type.enum.1")?
    mut fields := List[ast.Field]()
    if self.eat_sym("(")
        while not self.at_sym(")")
            fields.push(self.field_decl("type.enum.2")?)
            if not self.eat_sym(",")
                break
        self.expect_sym(")", "`)` or `,` in the variant's fields", "type.enum.2")?
    messages.push(VariantMessage(
        name: v.name,
        fields: [f.name for f in fields],
        message: error_message(is_error),
    ))
    ast.Variant(name: v.name, pos: v.pos, doc: none, fields: fields)

## The start of an indented block of one-line members: whether it opened.
fn Parser.members_open(mut self, rule str, what str) bool
    if not self.eat_newline()
        self.unexpected("end of line after {what}", rule)
        self.skip_statement()
        return false
    if not self.eat_indent()
        self.error_text(
            rule,
            self.here(),
            "{what} needs an indented block of members",
            "indent each member by 4 spaces",
            "",
        )
        return false
    true

## After a member: its line must end (lex.stmt.1).
fn Parser.member_end(mut self, ok bool)
    if ok and self.eat_newline()
        return
    if self.diags.len() == 0 or self.diags[self.diags.len() - 1].pos.line != self.here().line
        self.unexpected("end of line", "lex.stmt.1")
    self.skip_statement()

# ---- Statements ----

## A statement ends at the end of its line (lex.stmt.1), or with its block.
fn Parser.statement(mut self) ast.Stmt?
    if self.peek() == Tok.Indent
        self.unexpected_indent()
        self.skip_block()
        return none
    if misplaced_contract()
        return none
    errors_before := self.diags.len()
    start := self.i
    if s := self.statement_inner()
        if self.after_block() or self.eat_newline()
            return s
        if not stray_after_statement(start)
            self.unexpected("end of line after the statement", "lex.stmt.1")
        self.skip_statement()
        return none
    if self.diags.len() == errors_before
        self.unexpected("a statement", "gram.syntax.1")
    self.skip_statement()
    none

## A statement. A loop is on `loops` while its header and block are parsed, so
## `break outer` finds it (expr.loop.9-10, ADR 1107).
fn Parser.statement_inner(mut self) ast.Stmt?
    tag := self.tag_at(0)
    text := tok_text(self.peek())
    if tag == "id"
        and self.sym_at(1) == ":"
        and (self.kw_at(2) == "for" or self.kw_at(2) == "while")
        return self.labeled_loop(text)
    if tag == "kw" and (text == "for" or text == "while" or text == "par")
        self.loops.push(LoopLabel(name: "", at: self.here(), in_par: text == "par"))
        s := self.statement_core()
        self.loops.pop()
        return s
    self.statement_core()

## `outer: for ...` and `outer: while ...` (expr.loop.9): the name labels the
## loop, so `break outer` and `continue outer` in a nested loop leave or
## continue this one (expr.loop.10).
fn Parser.labeled_loop(mut self, name str) ast.Stmt?
    lpos := self.here()
    for l in self.loops
        if l.name == name
            self.error_text(
                "expr.loop.9",
                lpos,
                "the loop label `{name}` is already used by an enclosing loop",
                "give this loop a different label, for example `{name}2`",
                "",
            )
            return none
    self.i += 2
    self.loops.push(LoopLabel(name: name, at: self.here(), in_par: false))
    s := self.statement_core()
    self.loops.pop()
    s

fn Parser.statement_core(mut self) ast.Stmt?
    pos := self.here()
    tag := self.tag_at(0)
    text := tok_text(self.peek())
    if tag == "kw" and text == "pub" and (self.tag_at(1) == "id" or self.kw_at(1) == "mut")
        # mod.vis.1 (fix.auto.1): only a top-level item or a field is `pub`; a local has no visibility.
        self.error_fix(
            "mod.vis.1",
            pos,
            "a local has no visibility, so it takes no `pub`",
            "remove `pub`: only a top-level item or a struct field is `pub`",
            "remove `pub`",
            [fix.span(pos, self.next_on_line(pos), "")],
        )
        return none
    if tag == "kw" and text == "fn" and self.tag_at(1) == "id"
        return self.local_fn()
    if tag == "kw" and text == "defer" and self.sym_at(1) != ":="
        # `defer S` (own.defer.1); `defer := e` is a keyword used as a name, reported below (lex.kw.1).
        self.bump()
        inner := self.statement_inner()?
        return ast.Stmt.Defer(stmt: inner, pos: pos)
    if tag == "kw" and text == "mut" and self.tag_at(1) == "id" and self.sym_at(2) == ","
        self.bump()
        n := self.take_name("a binding name after `mut`", "expr.bind.2")?
        return self.let_tuple(ast.Binder(name: n.name, pos: n.pos, mutable: true))
    if tag == "id" and self.sym_at(1) == "," and self.at_let_tuple()
        self.i += 1
        return self.let_tuple(ast.Binder(name: text, pos: pos, mutable: false))
    if tag == "kw" and text == "mut"
        self.bump()
        n := self.take_name("a binding name after `mut`", "expr.bind.2")?
        if self.sym_at(0) == "="
            # expr.bind.2: `mut x = e` declares with `:=`.
            eq := self.here()
            self.error_text(
                "expr.bind.2",
                eq,
                "expected `:=` after the name, found `=`",
                "`mut NAME := value` declares a new mutable name; `=` changes one that exists",
                "declare it with `:=`",
            )
            self.attach("declare it with `:=`", [fix.span(
                eq,
                ast.Pos(line: eq.line, col: eq.col + 1),
                ":=",
            )])
            self.i += 1
        else
            self.expect_sym(":=", "`:=` after the name", "expr.bind.2")?
        value := self.expression_plain()?
        e := self.otherwise()?
        return ast.Stmt.Let(
            name: n.name,
            pos: n.pos,
            mutable: true,
            value: value,
            otherwise: e.part,
        )
    if tag == "id" and self.sym_at(1) == ":="
        self.i += 2
        value := self.expression_plain()?
        e := self.otherwise()?
        return ast.Stmt.Let(name: text, pos: pos, mutable: false, value: value, otherwise: e.part)
    if tag == "id"
        and (text == "let" or text == "var" or text == "const")
        and self.tag_at(1) == "id"
        title := if self.sym_at(2) == "=" then "declare it with `:=`" else ""
        self.error_text(
            "expr.bind.1",
            pos,
            "AIL has no `{text}`; bindings are declared with `:=`",
            "write `name := value`, or `mut name := value` to allow reassignment",
            title,
        )
        if title != ""
            eq := self.tokens[self.i + 2].pos
            first := if text == "var" then fix.span(
                pos,
                ast.Pos(line: pos.line, col: pos.col + 3),
                "mut",
            ) else fix.delete(pos, self.tokens[self.i + 1].pos)
            self.attach(title, [first, fix.span(eq, ast.Pos(line: eq.line, col: eq.col + 1), ":=")])
        return none
    if tag == "id"
        and text == "let"
        and self.kw_at(1) == "mut"
        and self.tag_at(2) == "id"
        and self.sym_at(3) == "="
        self.error_text(
            "expr.bind.1",
            pos,
            "AIL has no `let mut`; a changeable binding is declared with `mut name :=`",
            "write `mut name := value`; `mut` marks the binding as changeable",
            "write `mut name :=`",
        )
        eq := self.tokens[self.i + 3].pos
        self.attach("write `mut name :=`", [
            fix.delete(pos, self.tokens[self.i + 1].pos),
            fix.span(eq, ast.Pos(line: eq.line, col: eq.col + 1), ":="),
        ])
        return none
    if (tag == "kw" or tag == "id") and self.sym_at(1) == ","
        # `error, any := f()`: each keyword among the names gets its own report and fix, not one per run (lex.kw.1).
        bad := self.keyword_names_declared(self.i)
        if bad.len() > 0
            for k in bad
                self.keyword_as_name(k)
            return none
    if tag == "kw" and self.sym_at(1) == ":="
        self.keyword_as_name(self.i)
        return none
    if tag == "kw" and text == "while"
        self.bump()
        if n := self.ident()
            if n == "let" and self.tag_at(1) == "id" and self.sym_at(2) == "="
                # `while let x = e`: the Rust habit (expr.loop.8).
                eq := self.tokens[self.i + 2].pos
                self.error_fix(
                    "expr.loop.8",
                    self.here(),
                    "AIL has no `while let`; write `while name := e`",
                    "`while name := e` loops while `e` has a value, binding `name` each time",
                    "write `while name := e`",
                    [
                        fix.delete(self.here(), self.tokens[self.i + 1].pos),
                        fix.span(eq, ast.Pos(line: eq.line, col: eq.col + 1), ":="),
                    ],
                )
                return none
            if self.sym_at(1) == ":="
                # `while name := e` (expr.loop.8): `while true` whose body starts
                # with `name := e else break`.
                bind_pos := self.bump().pos
                self.i += 1
                value := self.range()?
                body := self.block("the `while` condition", "expr.loop.8")?
                mut stmts := [ast.Stmt.Let(
                    name: n,
                    pos: bind_pos,
                    mutable: false,
                    value: value,
                    otherwise: ast.Else.Leave(ast.Stmt.Break(pos, none)),
                )]
                for st in body
                    stmts.push(st)
                return ast.Stmt.While(
                    cond: ast.Expr.Bool(value: true, pos: pos),
                    body: stmts,
                    pos: pos,
                )
        cond := self.range()?
        body := self.block("the `while` condition", "expr.loop.1")?
        return ast.Stmt.While(cond: cond, body: body, pos: pos)
    if tag == "kw" and text == "for"
        return self.for_loop(false, pos)
    if tag == "kw" and text == "with"
        return self.with_stmt(pos)
    if tag == "kw" and text == "select"
        return select_stmt(pos)
    if tag == "kw" and text == "unsafe" and self.kw_at(1) != "fn"
        # unsafe.block.1: `unsafe` and an indented block.
        self.bump()
        body := self.block("`unsafe`", "unsafe.block.1")?
        return ast.Stmt.Unsafe(body: body, pos: pos)
    if tag == "kw" and text == "par"
        # conc.par.5: `par for` asserts that the iterations are independent.
        self.bump()
        if not self.at_kw("for")
            self.unexpected("`for` after `par`", "conc.par.5")
            return none
        return self.for_loop(true, pos)
    if tag == "kw" and (text == "break" or text == "continue")
        return self.leave_stmt(text == "break", pos)
    if tag == "kw" and text == "return"
        self.bump()
        t := self.tag_at(0)
        if t == "nl" or t == "dedent" or t == "eof"
            return ast.Stmt.Return(value: none, pos: pos)
        first := self.here()
        value := self.expression()?
        if self.sym_at(0) == ","
            self.return_list(first)
            return none
        return ast.Stmt.Return(value: value, pos: pos)
    if tag == "kw" and text == "yield"
        # expr.yield.2: `yield e` gives a generator's next element.
        self.bump()
        value := self.expression()?
        return ast.yield_stmt(value, pos)
    if tag == "kw" and (text == "elif" or text == "else")
        self.error_text(
            "expr.if.1",
            pos,
            "`{text}` without a matching `if`",
            "line it up with its `if` (or with the statement the `if` starts in)",
            "",
        )
        return none
    if foreign_stmt()
        return none
    target := self.expression_plain()?
    # `f(x) else ...` handles a failure with no success value (err.else.5);
    # `e else d` gives a value (err.else.6).
    if self.at_kw("else")
        leaves := self.kw_at(1) == "return"
            or self.kw_at(1) == "break"
            or self.kw_at(1) == "continue"
        if not self.else_block_follows() and not leaves
            return ast.Stmt.Eval(self.else_expr(target)?)
        e := self.otherwise()?
        if part := e.part
            return ast.Stmt.Handle(value: target, otherwise: part)
        return none
    s := self.sym_at(0)
    if bit_assign(s) != ""
        return self.bit_assignment(target, s)
    if s == "=" or assign_op(s) != none
        apos := self.bump().pos
        value := self.expression()?
        if self.at_kw("else") and self.else_block_follows()
            # err.else.8: `x = e else` and a block is `tmp := e else` and the block, then `x = tmp`.
            e := self.otherwise()?
            tmp := "(else {apos.line}:{apos.col})"
            let_pos := ast.expr_start(target)
            self.after_stmts.push(ast.Stmt.Assign(
                target: target,
                op: assign_op(s),
                value: ast.Expr.Name(name: tmp, pos: apos),
                pos: apos,
            ))
            return ast.Stmt.Let(
                name: tmp,
                pos: let_pos,
                mutable: false,
                value: value,
                otherwise: e.part,
            )
        return ast.Stmt.Assign(target: target, op: assign_op(s), value: value, pos: apos)
    if s == ":="
        self.error_text(
            "expr.bind.1",
            self.here(),
            "only a plain name can be declared with `:=`",
            "to take a tuple apart, write the names with no parentheses: `a, b := t`",
            "",
        )
        self.attach("write the names without parentheses", [fix.unparen(ast.Pos(
            line: self.here().line,
            col: 1,
        ))])
        return none
    ast.Stmt.Eval(target)

## `x &= e` and the other four bit forms (expr.bit.5): `x = x & e` for a plain
## name `x`. A place with an index or a field is written out in full.
fn Parser.bit_assignment(mut self, target ast.Expr, s str) ast.Stmt?
    apos := self.bump().pos
    op := bit_assign(s)
    if name_of(target) != none
        value := self.expression()?
        arg := ast.Arg(label: none, mutable: false, moved: false, value: value, param: none)
        call := ast.Expr.Method(recv: target, name: bit_method(op), name_pos: apos, args: [arg])
        return ast.Stmt.Assign(target: target, op: none, value: call, pos: apos)
    self.error_text(
        "expr.bit.5",
        apos,
        "`{s}` works on a plain name",
        "write the place twice: `a[i] = a[i] {op} e` (expr.bit.5)",
        "",
    )
    none

## `break`, `continue`, `break outer` or `continue outer` (expr.loop.2, expr.loop.10).
## The label names an enclosing loop of this function; it can't leave a `par for`.
fn Parser.leave_stmt(mut self, is_break bool, pos ast.Pos) ast.Stmt?
    word := if is_break then "break" else "continue"
    self.bump()
    mut target := absent[ast.Pos]()
    if self.tag_at(0) == "id"
        n := self.take_name("a loop label", "expr.loop.10")?
        mut k := self.loops.len() - 1
        mut crossed := false
        while k >= 0 and target == none
            l := self.loops[k]
            if l.name == n.name
                target = l.at
            elif l.in_par
                crossed = true
                break
            k -= 1
        if target == none
            self.unknown_label(word, n, crossed)
            return none
    if is_break
        return ast.Stmt.Break(pos, target)
    ast.Stmt.Continue(pos, target)

## `break outer` where no enclosing loop of the function is labeled `outer`
## (expr.loop.10), or one is but a `par for` lies between (conc.par.2).
fn Parser.unknown_label(mut self, word str, n ast.Ident, crossed bool)
    if crossed
        self.error_text(
            "conc.par.2",
            n.pos,
            "`{word} {n.name}` would leave a `par for`",
            "a later iteration must not run after an earlier one leaves; keep the loop sequential (drop `par`), or collect the results and decide after the loop",
            "",
        )
        return
    at_label := n.pos
    at_end := ast.Pos(line: at_label.line, col: at_label.col + n.name.len())
    mut names := List[str]()
    mut outermost := absent[ast.Pos]()
    for l in self.loops
        if l.in_par
            names = []
            outermost = none
        elif l.name != ""
            names.push(l.name)
        if not l.in_par and outermost == none
            outermost = l.at
    if names.len() == 0 and outermost == none
        self.error_text(
            "expr.loop.5",
            at_label,
            "`{word} {n.name}` is outside a loop",
            "`{word}` is only allowed inside a `for` or `while` loop",
            "",
        )
        return
    if names.len() > 0
        last := names[names.len() - 1]
        self.error_text(
            "expr.loop.10",
            at_label,
            "`{word} {n.name}` names no enclosing loop; the labeled loops here are {names.join(", ")}",
            "write the label of the loop to {word}, such as `{word} {last}`",
            "write `{word} {last}`",
        )
        self.attach("write `{word} {last}`", [fix.span(at_label, at_end, last)])
        return
    start := outermost else return
    self.error_text(
        "expr.loop.10",
        at_label,
        "`{word} {n.name}` names no enclosing loop; no loop here is labeled",
        "label the outer loop with `{n.name}: for ...` (or `{n.name}: while ...`), then `{word} {n.name}` leaves it",
        "label the outermost loop `{n.name}`",
    )
    self.attach("label the outermost loop `{n.name}`", [fix.span(start, start, "{n.name}: ")])

## `for x in e` or `for mut x in e` (expr.loop.1, expr.loop.6), at `for`.
fn Parser.for_loop(mut self, is_par bool, pos ast.Pos) ast.Stmt?
    for_i := self.i
    self.bump()
    mutable := self.eat_kw("mut")
    if self.at_sym("(")
        if edits := js_for_edits()
            self.error_text(
                "expr.loop.1",
                self.here(),
                "a `for` header has no parentheses and no `of`",
                "write `for x in xs`: the variable, `in`, then the collection or range",
                "write `for x in xs`",
            )
            self.attach("write `for x in xs`", edits)
            return none
        self.error_text(
            "expr.loop.1",
            self.here(),
            "AIL has no C-style `for`",
            "loop over a range: `for i in 0..n` (excludes `n`) or `for i in 1..=n` (includes it); use `while` for other conditions",
            "write the range loop",
        )
        self.attach("write the range loop", [fix.c_for(self.here())])
        return none
    v := self.take_name("a loop variable after `for`", "expr.loop.1")?
    mut var := v.name
    # type.tuple.5: `for a, b in xs` takes each element apart.
    mut unpack := List[ast.Binder]()
    if self.at_sym(",")
        if mutable
            self.error_text(
                "type.tuple.5",
                self.here(),
                "`for mut` has one variable",
                "loop with `for a, b in xs` and assign through an index to change the list",
                "",
            )
            return none
        unpack = self.more_binders(
            ast.Binder(name: v.name, pos: v.pos, mutable: false),
            "type.tuple.5",
        )?
        var = hidden_name(unpack)
    if not self.eat_kw("in")
        if for_foreign(for_i, unpack)
            return none
        self.unexpected("`in` after the loop variable", "expr.loop.1")
        return none
    iter := self.range()?
    # err.else.6: `for x in xs else []` (ADR 0252).
    iter2 := self.else_expr(iter)?
    mut body := self.block("the `for` header", "expr.loop.1")?
    if unpack.len() > 0
        value := ast.Expr.Name(name: var, pos: v.pos)
        body.insert(0, ast.Stmt.LetTuple(names: unpack, value: value, pos: v.pos))
    ast.Stmt.For(
        is_par: is_par,
        var: var,
        var_pos: v.pos,
        mutable: mutable,
        iter: iter2,
        body: body,
        pos: pos,
    )

## After the first name of `a, b := e` or `for a, b in`, at `,`: the first
## and the other names, each `mut` only in a binding (type.tuple.4).
fn Parser.more_binders(mut self, first ast.Binder, rule str) List[ast.Binder]?
    mut names := [first]
    while self.eat_sym(",")
        mutable := rule == "type.tuple.4" and self.eat_kw("mut")
        n := self.take_name("a name or `_` for the element", rule)?
        names.push(ast.Binder(name: n.name, pos: n.pos, mutable: mutable))
    names

## At `a, b, ... :=`: names, each maybe `mut`, then `:=` on this line.
fn Parser.at_let_tuple(self) bool
    mut k := 0
    while true
        if self.kw_at(k) == "mut"
            k += 1
        if self.tag_at(k) != "id"
            return false
        s := self.sym_at(k + 1)
        if s == ","
            k += 2
        elif s == ":="
            return true
        else
            return false
    false

## `a, mut b := e` after the first name, at `,` (type.tuple.4).
fn Parser.let_tuple(mut self, first ast.Binder) ast.Stmt?
    names := self.more_binders(first, "type.tuple.4")?
    self.expect_sym(":=", "`:=` after the names", "type.tuple.4")?
    value := self.expression()?
    ast.Stmt.LetTuple(names: names, value: value, pos: first.pos)

## The hidden variable of `for a, b in xs` (type.tuple.5): `(a, b)`, which
## no program can name.
fn hidden_name(names List[ast.Binder]) str
    "({[b.name for b in names].join(", ")})"

## The `else` part of a binding, if any (err.else.1-3); `none` after a
## syntax error.
fn Parser.otherwise(mut self) ElsePart?
    if not self.at_kw("else")
        return ElsePart(part: none)
    pos := self.bump().pos
    if self.at_newline()
        body := self.block("`else`", "err.else.2")?
        return ElsePart(part: ast.Else.Handler(err: none, body: body, pos: pos))
    if n := self.ident()
        if self.tag_at(1) == "nl" and self.tag_at(2) == "indent"
            err_pos := self.bump().pos
            body := self.block("`else {n}`", "err.else.3")?
            return ElsePart(part: ast.Else.Handler(
                err: ast.Ident(name: n, pos: err_pos),
                body: body,
                pos: pos,
            ))
    k := self.kw_at(0)
    if k == "return" or k == "break" or k == "continue"
        s := self.statement_inner()?
        return ElsePart(part: ast.Else.Leave(s))
    first := self.i
    value := self.expression()?
    self.note_else_op(first, value)
    ElsePart(part: ast.Else.Fallback(value))

# ---- Expressions, loosest binding first (expr.prec.1) ----

## An expression, which may end in an `else` fallback (err.else.6).
fn Parser.expression(mut self) ast.Expr?
    value := self.expression_plain()?
    self.else_expr(value)

## An expression without a trailing `else`.
fn Parser.expression_plain(mut self) ast.Expr?
    if self.too_deep()
        return none
    self.nest += 1
    found := self.expression_plain_inner()
    self.nest -= 1
    found

## One report, at the first expression nested past `NEST_LIMIT`, so a file of ten thousand `(` is an error and not a
## stack overflow (gram.rec.5); the callers above drop their statement as for any other expression error.
fn Parser.too_deep(mut self) bool
    if self.nest < NEST_LIMIT
        return false
    if self.nest == NEST_LIMIT
        self.error_text(
            "gram.syntax.1",
            self.here(),
            "this expression is nested more than {NEST_LIMIT} levels deep",
            "name the inner part with `x := ...` on its own line",
            "",
        )
    true

fn Parser.expression_plain_inner(mut self) ast.Expr?
    if self.at_kw("if")
        return self.if_expr()
    if self.at_kw("match")
        return self.match_expr()
    if self.at_sym("|") or self.at_sym("||")
        return self.closure()
    if self.lambda_colon() > 0
        return self.python_lambda()
    self.range()

## Python's `lambda x, y: e` ahead: the offset of its `:`, else 0.
fn Parser.lambda_colon(self) int
    if self.tag_at(0) != "id" or tok_text(self.peek()) != "lambda"
        return 0
    mut k := 1
    while self.tag_at(k) == "id"
        k += 1
        if self.sym_at(k) != ","
            break
        k += 1
    if self.sym_at(k) == ":" then k else 0

## `lambda x: e` (gram.foreign.1, ADR 1067): reported with the AIL form
## `|x| e`, with a fix, and parsed as that function literal.
fn Parser.python_lambda(mut self) ast.Expr?
    pos := self.here()
    colon := self.i + self.lambda_colon()
    mut params := List[ast.ClosureParam]()
    mut names := List[str]()
    self.i += 1
    while self.i < colon
        if self.tag_at(0) == "id"
            params.push(ast.ClosureParam(
                name: tok_text(self.peek()),
                pos: self.here(),
                ty: absent[ast.TypeRef](),
            ))
            names.push(tok_text(self.peek()))
        self.i += 1
    self.i += 1
    head := "|{names.join(", ")}|"
    self.error_text(
        "gram.foreign.1",
        pos,
        "AIL has no `lambda`; a function literal is written `{head} ...`",
        "the parameters go between bars and the body follows on the same line, `|x| x + 1`",
        "write `{head}`",
    )
    self.attach("write `{head}`", [fix.span(pos, self.tok_end(colon) else self.here(), head)])
    body := self.expression()?
    ast.Expr.Closure(params: params, body: body, pos: pos)

## `|a, b| e`, `|x int| e` or `|| e`: a function literal whose body is one
## expression, running to the end of the expression (type.fn.4, ADR 1067).
fn Parser.closure(mut self) ast.Expr?
    pos := self.here()
    mut params := List[ast.ClosureParam]()
    if not self.eat_sym("||")
        self.i += 1
        while not self.at_sym("|")
            if self.tag_at(0) != "id"
                # A `|` where an operand is expected and no parameter follows (ADR 1067).
                self.error_text(
                    "type.fn.4",
                    self.here(),
                    "expected a parameter name or `|` in a function literal, found {self.describe(self.peek())}",
                    "a `|` before an operand opens a function literal `|x| x + 1`; bit-or goes between two operands, `a | b`",
                    "",
                )
                return none
            p := self.take_name("a parameter name", "type.fn.4")?
            mut ty := absent[ast.TypeRef]()
            if not self.at_sym(",") and not self.at_sym("|")
                ty = self.type_ref("the parameter's type", "type.fn.4")?
            params.push(ast.ClosureParam(name: p.name, pos: p.pos, ty: ty))
            if not self.eat_sym(",")
                break
        self.expect_sym("|", "`|` after the function literal's parameters", "type.fn.4")?
    if self.at_newline() or self.peek() == Tok.Eof
        self.error_text(
            "type.fn.4",
            self.here(),
            "a function literal's body is one expression on the same line",
            "write `|x| x + 1`; for a longer body, declare a function and call it from the literal",
            "",
        )
        return none
    # A loop label isn't visible inside a function literal (expr.loop.10).
    saved := self.loops
    self.loops = []
    parsed := self.expression()
    self.loops = saved
    body := parsed?
    ast.Expr.Closure(params: params, body: body, pos: pos)

## `fn name(params) R` and its block inside a function body: a named local
## function (type.fn.9, ADR 1094). Not generic, not a method, no contracts.
fn Parser.local_fn(mut self) ast.Stmt?
    f := self.function_inner(ast.Within.TopLevel)?
    plain := f.generics.len() == 0 and f.owner == none and f.contracts.len() == 0
    if not plain or f.unsafe_fn or f.body == none
        self.error_text(
            "type.fn.9",
            f.pos,
            "a local function is a plain `fn name(params) Result` with a body",
            "declare a generic function, a method or one with contracts at the top level",
            "",
        )
        return none
    ast.Stmt.LocalFn(decl: f)

## The `for x in xs [if c]` clauses of a comprehension (expr.comp.2).
fn Parser.comp_clauses(mut self) List[ast.CompFor]?
    mut clauses := List[ast.CompFor]()
    while true
        # conc.par.12: `[e par for x in xs]` computes the elements on the pool.
        is_par := self.at_comp_for() and self.eat_kw("par")
        if not self.eat_kw("for")
            break
        if self.at_kw("mut")
            self.error_text(
                "expr.comp.2",
                self.here(),
                "a comprehension's variable can't be `mut`",
                "use a `for mut` loop to change elements in place",
                "",
            )
            return none
        v := self.take_name("a variable after `for`", "expr.comp.2")?
        mut var := v.name
        # type.tuple.5: `[e for a, b in xs]`.
        mut unpack := List[ast.Binder]()
        if self.at_sym(",")
            unpack = self.more_binders(
                ast.Binder(name: v.name, pos: v.pos, mutable: false),
                "type.tuple.5",
            )?
            var = hidden_name(unpack)
        if not self.eat_kw("in")
            self.unexpected("`in` after the comprehension's variable", "expr.comp.2")
            return none
        iter := self.range()?
        mut cond := none
        if self.eat_kw("if")
            cond = self.expression()?
        clauses.push(ast.CompFor(
            is_par: is_par,
            var: var,
            var_pos: v.pos,
            iter: iter,
            cond: cond,
            unpack: unpack,
        ))
    clauses

fn Parser.at_comp_for(self) bool
    self.at_kw("for") or self.at_kw("par") and self.kw_at(1) == "for"

## `with m as mut x` and its block (conc.share.6), at `with`.
fn Parser.with_stmt(mut self, pos ast.Pos) ast.Stmt?
    self.bump()
    mutex := self.range()?
    if not self.eat_kw("as")
        self.unexpected("`as mut NAME` after the mutex", "conc.share.6")
        return none
    if not self.eat_kw("mut")
        self.error_text(
            "conc.share.6",
            self.here(),
            "a `with` block writes its variable back to the mutex, so the variable is `mut`",
            "write `with m as mut x`; to read the value once, use `m.get()`",
            "write `as mut`",
        )
        self.attach("write `as mut`", [fix.insert(self.here(), "mut ")])
        return none
    v := self.take_name("a variable after `as mut`", "conc.share.6")?
    body := self.block("the `with` header", "conc.share.6")?
    ast.Stmt.With(mutex: mutex, var: v.name, var_pos: v.pos, body: body, pos: pos)

## `value else d` or `value else return ...` (err.else.6), the loosest
## operator. An `else` that starts a block belongs to a statement.
fn Parser.else_expr(mut self, value ast.Expr) ast.Expr?
    if not self.at_kw("else") or self.else_block_follows()
        return value
    pos := self.bump().pos
    k := self.kw_at(0)
    if k == "return" or k == "break" or k == "continue"
        s := self.statement_inner()?
        return ast.Expr.OrElse(value: value, otherwise: ast.Else.Leave(s), pos: pos)
    first := self.i
    d := self.expression()?
    self.note_else_op(first, d)
    ast.Expr.OrElse(value: value, otherwise: ast.Else.Fallback(d), pos: pos)

## expr.prec.1 (ADR 1205): `e else a OP b` is `e else (a OP b)`. Note the operator of a fallback `d` that
## is a binary expression and was not written in parentheses, for the checker's warning. `first` is the token
## where the fallback starts.
@allow("expr.match.3") fn Parser.note_else_op(mut self, first int, d ast.Expr)
    match d
        Binary(_, _, _, at) =>
            if not self.wrapped(first, self.i)
                self.else_ops.push(at)
        _ => return

## Whether tokens `lo` up to `hi` (exclusive) are one parenthesized group: a `(` first and its `)` last.
fn Parser.wrapped(self, lo int, hi int) bool
    if hi - lo < 2
        or tok_text(self.tokens[lo].tok) != "("
        or tok_text(self.tokens[hi - 1].tok) != ")"
        return false
    mut depth := 0
    for k in lo..hi
        t := self.tokens[k].tok
        if tok_tag(t) != "sym"
            continue
        s := tok_text(t)
        if s == "("
            depth += 1
        elif s == ")"
            depth -= 1
            if depth == 0 and k < hi - 1
                return false
    true

## At `else`: whether an indented block follows it (`else` or `else err`).
fn Parser.else_block_follows(self) bool
    t := self.tag_at(1)
    if t == "nl"
        return true
    t == "id" and self.tag_at(2) == "nl" and self.tag_at(3) == "indent"

## `a..b` and `a..=b` (expr.loop.3): the loosest operators. A bound may be
## left out before `]`, for a slice (type.coll.10).
fn Parser.range(mut self) ast.Expr?
    # `...xs` (a JavaScript spread) lexes as `..` then `.`, and would read as an open range.
    if self.at_sym("..") and self.sym_at(1) == "." and touches(self.i + 1)
        self.error_text(
            "gram.foreign.1",
            self.here(),
            "AIL has no spread `...`",
            "a new list from two is `xs.concat(ys)`: write `xs.concat([x])` for `[...xs, x]` and `[x].concat(xs)` for `[x, ...xs]`; `xs.extend(ys)` grows a `mut` list in place; copy a struct with `b := a`, then change a field",
            "",
        )
        self.attach("write `.concat`", [fix.spread_list(self.here())])
        return none
    mut lo := none
    if not self.at_sym("..") and not self.at_sym("..=")
        lo = self.or_expr()?
    inclusive := self.at_sym("..=")
    if not self.at_sym("..") and not inclusive
        return lo
    pos := self.bump().pos
    mut hi := none
    if not self.at_sym("]")
        hi = self.or_expr()?
    ast.Expr.Range(lo: lo, hi: hi, inclusive: inclusive, pos: pos)

## A C-style logical operator: report it and treat it as its AIL spelling.
fn Parser.logical_typo(mut self, sym str, spelled str) bool
    if not self.at_sym(sym)
        return false
    self.error_fix(
        "expr.op.1",
        self.here(),
        "AIL writes `{sym}` as `{spelled}`",
        "write `{spelled}`",
        "write `{spelled}`",
        [fix.span(
            self.here(),
            ast.Pos(line: self.here().line, col: self.here().col + sym.chars().len()),
            if sym == "!" then "not " else spelled,
        )],
    )
    true

fn Parser.or_expr(mut self) ast.Expr?
    mut lhs := self.and_expr()?
    while self.at_kw("or") or self.logical_typo("||", "or")
        pos := self.bump().pos
        rhs := self.and_expr()?
        lhs = ast.Expr.Binary(op: ast.BinOp.Or, lhs: lhs, rhs: rhs, pos: pos)
    lhs

fn Parser.and_expr(mut self) ast.Expr?
    mut lhs := self.not_expr()?
    while self.at_kw("and") or self.logical_typo("&&", "and")
        pos := self.bump().pos
        rhs := self.not_expr()?
        lhs = ast.Expr.Binary(op: ast.BinOp.And, lhs: lhs, rhs: rhs, pos: pos)
    lhs

## `not` binds more loosely than comparisons (ADR 0112).
fn Parser.not_expr(mut self) ast.Expr?
    if self.too_deep()
        return none
    self.nest += 1
    found := self.not_expr_inner()
    self.nest -= 1
    found

fn Parser.not_expr_inner(mut self) ast.Expr?
    if self.at_kw("not") or self.logical_typo("!", "not")
        pos := self.bump().pos
        inner := self.not_expr()?
        return ast.Expr.Unary(op: ast.UnOp.Not, operand: inner, pos: pos)
    self.comparison_expr()

## Comparisons don't chain (expr.prec.2).
fn Parser.comparison_expr(mut self) ast.Expr?
    lhs := self.additive()?
    op := comparison(self.sym_at(0)) else return lhs
    pos := self.bump().pos
    if op == ast.BinOp.Lt and self.at_sym(">") and self.adjacent(self.i - 1)
        self.error_fix(
            "gram.foreign.1",
            pos,
            "AIL writes `<>` as `!=`",
            "write `!=`",
            "write `!=`",
            [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 2), "!=")],
        )
        return none
    rhs := self.additive()?
    if comparison(self.sym_at(0)) != none
        second := self.here()
        # `List<int>()`: type arguments use `[]`.
        if op == ast.BinOp.Lt and upper_name(lhs) and self.at_sym(">")
            self.error_fix(
                "gram.foreign.1",
                pos,
                "type arguments are written in `[]`, not `<>`",
                "write `List[int]()`",
                "use brackets",
                [
                    fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 1), "["),
                    fix.span(second, ast.Pos(line: second.line, col: second.col + 1), "]"),
                ],
            )
            return none
        self.diags.push(Diag(
            rule: "expr.prec.2",
            pos: second,
            msg: "comparisons can't be chained",
            fixed: true,
            help: "combine them with `and`, e.g. `a < b and b < c`",
            fix: "repeat the middle operand with `and`",
            edits: [fix.chain(pos, second)],
        ))
        return none
    ast.Expr.Binary(op: op, lhs: lhs, rhs: rhs, pos: pos)

## A name that starts with an uppercase letter.
fn upper_name(e ast.Expr) bool
    match e
        Name(n, _) => n.chars().len() > 0 and n.chars()[0].is_upper()
        Str(_, _) | Bytes(_, _) | Interp(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(_, _, _) | ListLit(_, _) | Call(_, _, _) | Method(_, _, _, _) | Member(_, _, _) | Index(_, _, _) | Unary(_, _, _) | Binary(_, _, _, _) | Range(_, _, _, _) | MapLit(_, _) | SetLit(_, _) | If(_, _, _, _) | Match(_, _, _) | Try(_, _, _) | Comp(
            _,
            _,
            _,
            _,
            _,
        ) | OrElse(_, _, _) | NewRef(_, _) | TupleLit(_, _) | Closure(_, _, _) => false

fn Parser.additive(mut self) ast.Expr?
    mut lhs := self.multiplicative()?
    while self.at_sym("+") or self.at_sym("-")
        plus := self.at_sym("+")
        op := if plus then ast.BinOp.Add else ast.BinOp.Sub
        pos := self.bump().pos
        # `n++` and `n--`
        if (plus and self.at_sym("+") or not plus and self.at_sym("-"))
            and self.adjacent(self.i - 1)
            and self.line_ends_at(self.i)
            sym := if plus then "++" else "--"
            assign := if plus then "+=" else "-="
            self.error_fix(
                "gram.foreign.1",
                pos,
                "AIL has no `{sym}`",
                "write `n {assign} 1`",
                "write `{assign} 1`",
                [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 2), " {assign} 1")],
            )
            return none
        rhs := self.multiplicative()?
        lhs = ast.Expr.Binary(op: op, lhs: lhs, rhs: rhs, pos: pos)
    lhs

fn Parser.multiplicative(mut self) ast.Expr?
    mut lhs := self.bit_operand()?
    while self.at_sym("*") or self.at_sym("/") or self.at_sym("%")
        mut op := ast.BinOp.Rem
        if self.at_sym("*")
            op = ast.BinOp.Mul
        elif self.at_sym("/")
            op = ast.BinOp.Div
        pos := self.bump().pos
        rhs := self.bit_operand()?
        lhs = ast.Expr.Binary(op: op, lhs: lhs, rhs: rhs, pos: pos)
    lhs

## The method a bit operator stands for (expr.bit.3), or "".
fn bit_method(s str) str
    match s
        "&" => "bit_and"
        "|" => "bit_or"
        "^" => "bit_xor"
        "<<" => "shl"
        ">>" => "shr"
        _ => ""

## The operators a bit operator may not touch without parentheses (expr.bit.4).
fn arith_or_cmp(s str) bool
    ["+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "..", "..="].contains(s)

## `a & b`, `a | b`, `a ^ b`, `a << k`, `a >> k` (expr.bit.3): the same call as
## the method form, `a.bit_and(b)`. A bit operator takes tight operands and never
## mixes with another operator without parentheses (expr.bit.4): the chain is one
## operator repeated (`a & b & c`, never `a | b & c`, `a << 1 << 2`), and nothing
## arithmetic or comparing touches it on either side.
fn Parser.bit_operand(mut self) ast.Expr?
    first := self.i
    mut lhs := self.unary()?
    sym := self.sym_at(0)
    if bit_method(sym) == ""
        return lhs
    if first > 0 and arith_or_cmp(self.sym_at(first - 1 - self.i))
        return self.bit_mix(self.sym_at(first - 1 - self.i), sym)
    mut count := 0
    while bit_method(self.sym_at(0)) != ""
        op := self.sym_at(0)
        if op != sym
            return self.bit_mix(sym, op)
        if (op == "<<" or op == ">>") and count > 0
            return self.bit_mix(op, op)
        pos := self.bump().pos
        rhs := self.unary()?
        arg := ast.Arg(label: none, mutable: false, moved: false, value: rhs, param: none)
        lhs = ast.Expr.Method(recv: lhs, name: bit_method(op), name_pos: pos, args: [arg])
        count += 1
    after := self.sym_at(0)
    if arith_or_cmp(after)
        return self.bit_mix(sym, after)
    lhs

## Report two operators that meet without parentheses and give up on the expression.
fn Parser.bit_mix(mut self, a str, b str) ast.Expr?
    msg := if a == b
        "`{a}` can't repeat without parentheses"
    else
        "`{a}` and `{b}` can't meet without parentheses"
    self.error_text(
        "expr.bit.4",
        self.here(),
        msg,
        "put parentheses around one side: `(x {a} y) {b} z` or `x {a} (y {b} z)`",
        "add parentheses",
    )
    none

fn Parser.unary(mut self) ast.Expr?
    if self.too_deep()
        return none
    self.nest += 1
    found := self.unary_inner()
    self.nest -= 1
    found

fn Parser.unary_inner(mut self) ast.Expr?
    # lex.num.3: `-9223372036854775808` is the minimum `int`, unless a
    # postfix operator binds the literal first.
    if self.at_sym("-") and self.tag_at(1) == "intmin"
        s := self.sym_at(2)
        if s != "." and s != "[" and s != "("
            pos := self.bump().pos
            self.i += 1
            return ast.Expr.Int(value: "-9223372036854775808", pos: pos)
    if self.at_sym("-")
        pos := self.bump().pos
        inner := self.unary()?
        return ast.Expr.Unary(op: ast.UnOp.Neg, operand: inner, pos: pos)
    # expr.bit.3: `~a` is `a.bit_not()`.
    if self.at_sym("~")
        pos := self.bump().pos
        inner := self.unary()?
        return ast.Expr.Method(recv: inner, name: "bit_not", name_pos: pos, args: List[ast.Arg]())
    if self.at_sym("&")
        self.error_text(
            "gram.foreign.1",
            self.here(),
            "AIL has no `&x` reference",
            "values are passed by value and `mut` marks changes at the call; `a & b` is the bitwise and of two values (expr.bit.3)",
            "",
        )
        return none
    # `ref e` (own.ref.1, ADR 0067).
    if self.at_kw("ref")
        pos := self.bump().pos
        value := self.unary()?
        return ast.Expr.NewRef(value: value, pos: pos)
    # conc.task.1: `spawn f(args)`.
    if self.at_kw("spawn")
        pos := self.bump().pos
        inner := self.postfix()?
        return ast.Expr.Unary(op: ast.UnOp.Spawn, operand: inner, pos: pos)
    self.postfix()

## The name of a plain name expression.
fn name_of(e ast.Expr) str?
    match e
        Name(n, _) => n
        Str(_, _) | Bytes(_, _) | Interp(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(_, _, _) | ListLit(_, _) | Call(_, _, _) | Method(_, _, _, _) | Member(_, _, _) | Index(_, _, _) | Unary(_, _, _) | Binary(_, _, _, _) | Range(_, _, _, _) | MapLit(_, _) | SetLit(_, _) | If(_, _, _, _) | Match(_, _, _) | Try(_, _, _) | Comp(
            _,
            _,
            _,
            _,
            _,
        ) | OrElse(_, _, _) | NewRef(_, _) | TupleLit(_, _) | Closure(_, _, _) => none

fn name_pos(e ast.Expr) ast.Pos
    match e
        Name(_, p) => p
        Str(_, _) | Bytes(_, _) | Interp(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(_, _, _) | ListLit(_, _) | Call(_, _, _) | Method(_, _, _, _) | Member(_, _, _) | Index(_, _, _) | Unary(_, _, _) | Binary(_, _, _, _) | Range(_, _, _, _) | MapLit(_, _) | SetLit(_, _) | If(_, _, _, _) | Match(_, _, _) | Try(_, _, _) | Comp(_, _, _, _, _) | OrElse(_, _, _) | NewRef(_, _) | TupleLit(_, _) | Closure(_, _, _) => ast.Pos(
            line: 0,
            col: 0,
        )

## A type argument, or a const argument: an int literal, kept as a `Named`
## whose name is the digits (`4`, never a type name; gen.const.1).
fn Parser.type_arg(mut self, rule str) ast.TypeRef?
    if self.tag_at(0) == "int"
        v := match self.peek()
            Int(x) => "{x}"
            Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""
        cpos := self.bump().pos
        return ast.TypeRef(
            shape: ast.TypeShape.Named(name: v, args: List[ast.TypeRef]()),
            pos: cpos,
        )
    self.type_ref("a type argument", rule)

## Type arguments after `[`, through `]` (gen.infer.2).
fn Parser.type_args(mut self) List[ast.TypeRef]?
    self.bump()
    mut args := List[ast.TypeRef]()
    while not self.at_sym("]")
        args.push(self.type_arg("gen.infer.2")?)
        if not self.eat_sym(",")
            break
    self.expect_sym("]", "`]` or `,` in the type arguments", "gen.infer.2")?
    args

## Calls, fields, methods and indexing (expr.prec.1 level 1).
fn Parser.postfix(mut self) ast.Expr?
    mut e := self.primary()?
    # `f[int](x)`, `Stack[int].new()`: type arguments after a generic name (gen.infer.2).
    if n := name_of(e)
        if self.at_sym("[") and self.generic_names.contains(n)
            pos := name_pos(e)
            args := self.type_args()?
            e = ast.Expr.TypeArgs(name: n, args: args, pos: pos)
    while true
        if self.at_sym("(")
            pos := self.bump().pos
            args := self.call_args()?
            e = call_or_old(e, args, pos)
        elif self.eat_sym(".")
            # type.tuple.3: `t.0`, an element of a tuple.
            if self.tag_at(0) == "int"
                k := match self.peek()
                    Int(v) => "{v}"
                    Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => ""
                kpos := self.bump().pos
                e = ast.Expr.Member(recv: e, name: k, name_pos: kpos)
                continue
            # `o.error`, `xs.any(f)`: any keyword after `.` is a name (lex.kw.3, ADR 1085).
            m := self.member_name("a field or method name after `.`", "gram.syntax.1")?
            recv_name := name_of(e) else ""
            # `m.Stack[int]` after an import `m` (gen.infer.2, mod.use.2).
            if recv_name != ""
                and self.aliases.contains(recv_name)
                and self.at_sym("[")
                and self.generic_names.contains(m.name)
                pos := name_pos(e)
                args := self.type_args()?
                e = ast.Expr.TypeArgs(name: "{recv_name}.{m.name}", args: args, pos: pos)
            elif self.eat_sym("(")
                args := self.call_args()?
                e = ast.Expr.Method(recv: e, name: m.name, name_pos: m.pos, args: args)
            else
                e = ast.Expr.Member(recv: e, name: m.name, name_pos: m.pos)
        elif self.at_sym("[")
            pos := self.bump().pos
            mut index := self.range()?
            # type.grid.3: `g[i, j]` indexes with the tuple `(i, j)`.
            if self.at_sym(",")
                mut elems := [index]
                while self.eat_sym(",") and not self.at_sym("]")
                    elems.push(self.expression()?)
                index = ast.Expr.TupleLit(items: elems, pos: pos)
            if self.at_sym(":")
                self.error_fix(
                    "type.coll.4",
                    self.here(),
                    "a slice is written with `..`, not `:`",
                    "write `xs[a..b]`, `xs[a..]` or `xs[..b]`",
                    "write `..`",
                    [fix.span(
                        self.here(),
                        ast.Pos(line: self.here().line, col: self.here().col + 1),
                        "..",
                    )],
                )
                return none
            if self.at_kw("else")
                # `xs[a else d]`: the fallback binds the whole index, so it is written in parentheses (ADR 1172).
                else_at := self.here()
                self.unexpected("`]` after the index", "type.coll.4")
                self.attach("put the index in parentheses", [fix.paren_index(else_at)])
                self.diags[self.diags.len() - 1].help = "an `else` fallback inside an index goes in parentheses: `xs[(a else d)]`"
                return none
            self.expect_sym("]", "`]` after the index", "type.coll.4")?
            e = ast.Expr.Index(recv: e, index: index, pos: pos)
        elif self.at_sym("?") and self.sym_at(1) == "?" and touches(self.i + 1)
            pos := self.here()
            self.error_fix(
                "gram.foreign.1",
                pos,
                "AIL has no `??`",
                "the fallback of an optional is `else`: `x else d`, or `x?.field else d`",
                "write `else`",
                [fix.span(pos, ast.Pos(line: pos.line, col: pos.col + 2), "else")],
            )
            return none
        elif self.at_sym("?")
            # `e?` propagates; `e? "message"` also adds context (err.prop.1, err.ctx.2).
            pos := self.bump().pos
            mut context := none
            if self.tag_at(0) == "str" or self.tag_at(0) == "interp"
                context = self.primary()?
            e = ast.Expr.Try(expr: e, context: context, pos: pos)
        else
            return e
    none

## Arguments after `(`, through `)` (gram.list.1).
fn Parser.call_args(mut self) List[ast.Arg]?
    mut args := List[ast.Arg]()
    while not self.at_sym(")")
        mut label := none
        # `Outcome(error: "")`: a keyword before `:` is a label (lex.kw.3, ADR 1085).
        if (self.tag_at(0) == "id" or self.kw_name_at(0) != none) and self.sym_at(1) == ":"
            label = self.member_name("a field name", "type.struct.3")?
            self.i += 1
        mutable := self.eat_kw("mut")
        moved := not mutable and self.eat_kw("move")
        # expr.key.1: `by: |x| e`, a key function.
        mut param := none
        # `|x| e` with one untyped parameter is a function literal that also names its
        # parameter in `Arg.param`, the key-function form (expr.key.1, type.fn.4, ADR 1067):
        # `ast.key_body` reads `e` back.
        if self.at_sym("|") and self.tag_at(1) == "id" and self.sym_at(2) == "|"
            param = ast.Ident(name: tok_text(self.peek_at(1)), pos: self.tok_pos(self.i + 1))
        if self.at_sym("..")
            and (self.tag_at(1) == "id" or self.kw_at(1) == "self")
            and label == none
            self.error_text(
                "gram.foreign.1",
                self.here(),
                "AIL has no struct update `..base`",
                "values are independent copies: `b := a`, then `b.y = 5` (declare `mut b := a` to change it)",
                "",
            )
            return none
        value := self.expression()?
        # `a @ b` is a matrix product (ADR 0382); `name=value` is `name: value`.
        if self.at_sym("@")
            self.error_text(
                "gram.foreign.1",
                self.here(),
                "AIL has no `@` operator",
                "the matrix product is a method: `a.matmul(b)` (std.tensor.10)",
                "write `.matmul`",
            )
            self.attach("write `.matmul`", [fix.operands(self.here(), "@", "$l.matmul($r)")])
            return none
        if self.at_sym("=")
            self.error_text(
                "expr.call.1",
                self.here(),
                "a named argument is written `name: value`, not `name=value`",
                "write `f(dx: 1, dy: 2)`",
                "write `:`",
            )
            self.attach("write `:`", [fix.span(
                self.here(),
                ast.Pos(line: self.here().line, col: self.here().col + 1),
                ": ",
            )])
            return none
        if l := label
            if param == none and l.name == "by"
                param = typed_key_param(value)
        args.push(ast.Arg(label: label, mutable: mutable, moved: moved, value: value, param: param))
        if not self.eat_sym(",")
            break
    self.expect_sym(")", "`)` or `,` in the argument list", "expr.call.1")?
    args

## expr.key.1: the parameter of `by: |x T| e`, which names it as `by: |x| e`
## does; the checker compares `T` with the element type.
@allow("expr.match.3") fn typed_key_param(value ast.Expr) ast.Ident?
    match value
        Closure(ps, _, _) =>
            if ps.len() != 1
                return none
            return ast.Ident(name: ps[0].name, pos: ps[0].pos)
        _ => none

fn Parser.primary(mut self) ast.Expr?
    pos := self.here()
    t := self.peek()
    match t
        Str(s) =>
            self.i += 1
            return ast.Expr.Str(value: s, pos: pos)
        Bytes(hex) =>
            self.i += 1
            return ast.Expr.Bytes(hex: hex, pos: pos)
        Interp(parts) =>
            self.i += 1
            return self.interpolation(parts, pos)
        Int(v) =>
            self.i += 1
            return ast.Expr.Int(value: "{v}", pos: pos)
        IntMin =>
            self.i += 1
            self.int_too_big(pos)
            return ast.Expr.Int(value: "0", pos: pos)
        Float(v) =>
            self.i += 1
            return ast.Expr.Float(value: v, pos: pos)
        Char(c) =>
            self.i += 1
            return ast.Expr.Char(value: "{c}", pos: pos)
        Ident(n) =>
            self.i += 1
            return ast.Expr.Name(name: n, pos: pos)
        Kw(k) =>
            # `if error != ""` after `error := ...` was reported (lex.kw.1, ADR 1085).
            if self.misnamed.contains(k)
                self.i += 1
                return ast.Expr.Name(name: k, pos: pos)
            if k == "true" or k == "false"
                self.i += 1
                return ast.Expr.Bool(value: k == "true", pos: pos)
            if k == "none"
                self.i += 1
                return ast.Expr.NoneLit(pos)
            if k == "todo"
                self.i += 1
                return ast.Expr.Hole(pos)
            if k == "uhwhatnow?"
                self.i += 1
                self.asks.push(pos)
                return ast.Expr.Hole(pos)
            if k == "self"
                self.i += 1
                return ast.Expr.Name(name: "self", pos: pos)
            if k == "if"
                self.error_text(
                    "expr.if.8",
                    pos,
                    "an `if` operand needs parentheses",
                    "write `(if c then a else b)`, or bind the `if` to a name first",
                    "",
                )
                return none
            if k == "match"
                self.error_text(
                    "gram.syntax.1",
                    pos,
                    "`{k}` can't be part of a larger expression",
                    "bind the `{k}` to a name first, then use the name",
                    "",
                )
                return none
        Sym(s) =>
            if s == "("
                self.i += 1
                # expr.if.8: a parenthesised one-line `if` is an operand.
                inner := if self.at_kw("if") then self.if_expr()? else self.range()?
                inner2 := self.else_expr(inner)?
                # type.tuple.2: `(a, b, ...)` is a tuple.
                if self.at_sym(",")
                    mut elems := [inner2]
                    while self.eat_sym(",") and not self.at_sym(")")
                        elems.push(self.expression()?)
                    self.expect_sym(")", "`)` or `,` in the tuple", "type.tuple.2")?
                    if elems.len() < 2
                        self.error_text(
                            "type.tuple.2",
                            pos,
                            "a tuple has two or more elements",
                            "write the value alone, without `(` `,` `)`",
                            "",
                        )
                        return none
                    return ast.Expr.TupleLit(items: elems, pos: pos)
                if self.at_kw("in")
                    # gram.foreign.1 (fix.auto.1): `(x in xs)` is the membership test `xs.contains(x)`.
                    at_in := self.here()
                    self.error_fix(
                        "gram.foreign.1",
                        at_in,
                        "AIL has no `in` operator for membership",
                        "write the test as a method on the collection: `xs.contains(x)`, `m.contains(key)`, `s.contains(sub)`",
                        "write `.contains`",
                        [fix.operands(at_in, "in", "$r.contains($l)")],
                    )
                    return none
                self.expect_sym(")", "`)`", "gram.syntax.1")?
                return inner2
            if s == "["
                return self.list_literal(pos)
            if s == "\{"
                return self.brace_literal(pos)
            if s == "<" and self.sym_at(1) == "-" and touches(self.i + 1)
                self.error_text(
                    "gram.foreign.1",
                    pos,
                    "AIL has no channel arrow `<-`",
                    "receive with `v := ch.recv() else break` (`none` once the channel is closed and empty); send with `ch.send(x)` (conc.chan.1)",
                    "",
                )
                return none
            if s == "="
                and self.i > 0
                and (self.tokens[self.i - 1].tok == Tok.Sym("==") or self.tokens[self.i - 1].tok == Tok.Sym("!="))
                and touches(self.i)
                eqs := if self.tokens[self.i - 1].tok == Tok.Sym("==") then "===" else "!=="
                self.error_fix(
                    "gram.foreign.1",
                    pos,
                    "AIL has no `{eqs}`",
                    "`==` and `!=` compare values and never convert types",
                    "remove the extra `=`",
                    [fix.delete(pos, ast.Pos(line: pos.line, col: pos.col + 1))],
                )
                return none
        Newline | Indent | Dedent | Eof => self.i += 0
    self.unexpected("an expression", "gram.syntax.1")
    none

## `[a, b]` or `[e for x in xs]` (type.coll.2, expr.comp.1), at `[`.
fn Parser.list_literal(mut self, pos ast.Pos) ast.Expr?
    self.i += 1
    mut elems := List[ast.Expr]()
    while not self.at_sym("]")
        elems.push(self.expression()?)
        if elems.len() == 1 and self.at_comp_for()
            elem := elems[0]
            clauses := self.comp_clauses()?
            self.expect_sym("]", "`]` after the comprehension", "expr.comp.1")?
            return ast.Expr.Comp(
                form: ast.CompKind.ListComp,
                elem: elem,
                value: none,
                clauses: clauses,
                pos: pos,
            )
        if not self.eat_sym(",")
            break
    self.expect_sym("]", "`]` or `,` in the list", "type.coll.2")?
    ast.Expr.ListLit(items: elems, pos: pos)

## `{k: v, ...}`, `{a, b, ...}`, `{}`, or a comprehension (type.coll.2), at `{`.
fn Parser.brace_literal(mut self, pos ast.Pos) ast.Expr?
    self.i += 1
    if self.eat_sym("}")
        return ast.Expr.MapLit(entries: [], pos: pos)
    first := self.expression()?
    if self.eat_sym(":")
        value := self.expression()?
        if self.at_comp_for()
            clauses := self.comp_clauses()?
            self.expect_sym("}", "`}` after the comprehension", "expr.comp.1")?
            return ast.Expr.Comp(
                form: ast.CompKind.MapComp,
                elem: first,
                value: value,
                clauses: clauses,
                pos: pos,
            )
        mut entries := [ast.MapEntry(key: first, value: value)]
        while self.eat_sym(",") and not self.at_sym("}")
            k := self.expression()?
            self.expect_sym(":", "`:` after the key", "type.coll.2")?
            v := self.expression()?
            entries.push(ast.MapEntry(key: k, value: v))
        self.expect_sym("}", "`}` or `,` in the map", "type.coll.2")?
        return ast.Expr.MapLit(entries: entries, pos: pos)
    if self.at_comp_for()
        clauses := self.comp_clauses()?
        self.expect_sym("}", "`}` after the comprehension", "expr.comp.1")?
        return ast.Expr.Comp(
            form: ast.CompKind.SetComp,
            elem: first,
            value: none,
            clauses: clauses,
            pos: pos,
        )
    mut elems := [first]
    while self.eat_sym(",") and not self.at_sym("}")
        elems.push(self.expression()?)
    self.expect_sym("}", "`}` or `,` in the set", "type.coll.2")?
    ast.Expr.SetLit(items: elems, pos: pos)

## Parse each `{...}` part of an interpolated string (lex.str.2).
fn Parser.interpolation(mut self, parts List[Part], pos ast.Pos) ast.Expr?
    mut out := List[ast.InterpPart]()
    mut ok := true
    for part in parts
        match part
            Lit(text) => out.push(ast.InterpPart.Lit(text))
            Code(code) =>
                if code.len() > 0
                    and tok_tag(code[0].tok) == "sym"
                    and tok_text(code[0].tok) == "\{"
                    # lex.str.2: `{{` isn't an escape; `\{` is.
                    self.diags.push(Diag(
                        rule: "lex.str.2",
                        pos: code[0].pos,
                        msg: "`\{\{` in a string isn't an escaped brace",
                        fixed: true,
                        help: "write `\\\{` for a literal `\{`, or use a raw string `r\"...\"`",
                        fix: "escape the brace with a backslash",
                        edits: escape_brace_edits(code),
                    ))
                    ok = false
                elif e := self.sub_expression(code)
                    out.push(ast.InterpPart.Hole(e))
                else
                    ok = false
            Fmt(code, spec) =>
                if e := self.sub_expression(code)
                    out.push(ast.InterpPart.Fmt(value: e, spec: ast_spec(spec)))
                else
                    ok = false
    if ok then ast.Expr.Interp(parts: out, pos: pos) else none

## The expression of one interpolated part, parsed on its own; `none` if
## it has a mistake, which is reported.
fn Parser.sub_expression(mut self, code List[Token]) ast.Expr?
    mut sub := new_parser(code, [])
    sub.in_interp = true
    sub.generic_names = self.generic_names
    sub.aliases = self.aliases
    sub.misnamed = self.misnamed
    e := sub.expression()
    if e != none and sub.peek() != Tok.Eof
        sub.unexpected("`}` after the interpolated expression", "lex.str.2")
    clean := sub.diags.len() == 0
    self.diags.extend(sub.diags)
    self.asks.extend(sub.asks)
    self.else_ops.extend(sub.else_ops)
    if clean then e else none

## The none of any optional type, where nothing else names the type (a local
## that is read before its first assignment, type.opt.9).
fn absent[T]() T?
    none

fn ast_spec(f FormatSpec) ast.FormatSpec
    ast.FormatSpec(
        fill: if v := f.fill then "{v}" else none,
        align: if v := f.align then "{v}" else none,
        width: f.width,
        precision: f.precision,
        hex: f.hex,
        flags: f.flags,
    )

## `if c` block, any `elif c` blocks, optional `else` block (expr.if.1, expr.if.3).
fn Parser.if_expr(mut self) ast.Expr?
    pos := self.bump().pos
    cond := self.condition()?
    if n := self.ident()
        if n == "then"
            return self.if_then(cond, pos)
    body := self.block("the `if` condition", "expr.if.1")?
    mut branches := [ast.Branch(cond: cond, body: body)]
    mut els := none
    mut else_err := none
    while true
        if self.eat_kw("elif")
            c := self.condition()?
            b := self.block("the `elif` condition", "expr.if.1")?
            branches.push(ast.Branch(cond: c, body: b))
        elif self.at_kw("else")
            else_pos := self.bump().pos
            if self.at_kw("if")
                self.diags.push(Diag(
                    rule: "expr.if.1",
                    pos: else_pos,
                    msg: "AIL writes `else if` as `elif`",
                    fixed: true,
                    help: "write `elif`",
                    fix: "write `elif`",
                    edits: [fix.replace(else_pos, "else if", "elif")],
                ))
                return none
            # `else err` binds the error (expr.if.6).
            if n := self.ident()
                if self.tag_at(1) == "nl"
                    else_err = ast.Ident(name: n, pos: self.bump().pos)
            els = self.block("`else`", "expr.if.1")?
            break
        else
            break
    ast.Expr.If(branches: branches, els: els, else_err: else_err, pos: pos)

## expr.if.8: the one-line form `if c then a elif d then b else e`, after `c`.
## Any number of `elif d then b` arms, then one `else` (ADR 1120).
fn Parser.if_then(mut self, cond ast.Cond, pos ast.Pos) ast.Expr?
    self.bump()
    a := self.expression_plain()?
    mut branches := [ast.Branch(cond: cond, body: [ast.Stmt.Eval(a)])]
    while self.at_kw("elif")
        self.bump()
        c := self.condition()?
        if not self.at_then()
            self.error_text(
                "expr.if.8",
                self.here(),
                "a one-line `elif` needs `then` after its condition",
                "write `elif d then b`; for an `elif` with a block, write the whole `if` on separate lines",
                "",
            )
            return none
        self.bump()
        v := self.expression_plain()?
        branches.push(ast.Branch(cond: c, body: [ast.Stmt.Eval(v)]))
    if not self.eat_kw("else")
        self.missing_one_line_else(branches.len())
        return none
    b := self.expression_plain()?
    ast.Expr.If(branches: branches, els: [ast.Stmt.Eval(b)], else_err: none, pos: pos)

## At the contextual keyword `then` (expr.if.8).
fn Parser.at_then(self) bool
    if n := self.ident()
        return n == "then"
    false

## expr.if.8: the one-line `if` ended before its `else`; the message names the
## arms written so far and the missing part.
fn Parser.missing_one_line_else(mut self, arms int)
    shape := if arms == 1 then "if c then a" else "if c then a elif d then b"
    self.error_text(
        "expr.if.8",
        self.here(),
        "`{shape}` needs a final `else` and its value on the same line",
        "end it with `else` and the value for when no condition holds: `{shape} else e`; for a statement with no `else`, put each body on its own line",
        "",
    )

## A `bool` condition, or a binding `name := e` (expr.if.5).
fn Parser.condition(mut self) ast.Cond?
    if n := self.ident()
        if self.sym_at(1) == ":="
            pos := self.bump().pos
            self.i += 1
            value := self.range()?
            return ast.Cond.Bind(name: n, pos: pos, value: value)
    value := self.range()?
    ast.Cond.Test(value)

## `match e` and one `pattern => result` arm per line (expr.match.1).
fn Parser.match_expr(mut self) ast.Expr?
    pos := self.bump().pos
    if self.at_newline()
        self.error_text(
            "expr.match.1",
            pos,
            "a `match` needs a value to match on",
            "write `match x` and one `pattern => result` arm per line; for a chain of conditions write `if` / `elif` / `else`",
            "",
        )
        return none
    scrutinee := self.range()?
    if self.at_sym("\{")
        self.error_text(
            "expr.match.1",
            self.here(),
            "AIL doesn't use braces around the arms of a `match`",
            "end the line after the value and write one `pattern => result` arm per line, indented 4 spaces, with no closing brace",
            "",
        )
        return none
    if not self.eat_newline()
        self.unexpected("end of line after the `match` value", "expr.match.1")
        return none
    if not self.eat_indent()
        self.error_text(
            "expr.match.1",
            self.here(),
            "a `match` needs an indented block of arms",
            "write one `pattern => result` per line",
            "",
        )
        return none
    mut arms := List[ast.Arm]()
    while self.peek() != Tok.Dedent and self.peek() != Tok.Eof
        if self.eat_newline()
            continue
        if a := self.arm()
            arms.push(a)
        else
            self.skip_statement()
    self.eat_dedent()
    ast.Expr.Match(scrutinee: scrutinee, arms: arms, pos: pos)

fn Parser.arm(mut self) ast.Arm?
    pat := self.pattern()?
    # expr.match.11: `pattern if cond =>`.
    mut guard := absent[ast.Expr]()
    if self.eat_kw("if")
        guard = self.expression_plain()?
    if not self.eat_sym("=>")
        if self.at_sym(":") or self.at_sym("->")
            self.error_fix(
                "expr.match.1",
                self.here(),
                "arms are written `pattern => result`",
                "write `=>`",
                "write `=>`",
                [fix.span(
                    self.here(),
                    ast.Pos(
                        line: self.here().line,
                        col: self.here().col + (if self.at_sym(":") then 1 else 2),
                    ),
                    if self.attached_before(self.here()) then " =>" else "=>",
                )],
            )
            self.i += 1
        else
            match pat
                Variant(q, nm, _, cpos) if nm == "case" and q == none =>
                    # AIL has no `case`: an arm is `pattern => result`.
                    self.error_text(
                        "expr.match.1",
                        cpos,
                        "AIL has no `case`: an arm is `pattern => result`",
                        "drop `case`, e.g. `1 => \"one\"`",
                        "",
                    )
                    self.attach("drop `case`", [fix.delete(cpos, self.here())])
                _ =>
                    self.unexpected("`=>` after the pattern", "expr.match.1")
            return none
    if self.at_newline()
        body := self.block("`=>`", "expr.match.1")?
        return ast.Arm(pat: pat, guard: guard, body: body)
    # expr.match.9: one statement on the arm's line.
    s := self.statement_inner()?
    if not self.after_block() and not self.eat_newline()
        self.unexpected("end of line after the arm", "expr.match.1")
        return none
    ast.Arm(pat: pat, guard: guard, body: [s])

## A pattern, or several joined by `|` (expr.match.8).
fn Parser.pattern(mut self) ast.Pattern?
    pos := self.here()
    first := self.single_pattern()?
    if not self.at_sym("|")
        return first
    mut alts := [first]
    while self.eat_sym("|")
        alts.push(self.single_pattern()?)
    ast.Pattern.Alt(alts: alts, pos: pos)

## One alternative: a literal or a `lo..hi` / `lo..=hi` range of integer or
## character literals (expr.match.12), or see `plain_pattern`.
fn Parser.single_pattern(mut self) ast.Pattern?
    pos := self.here()
    lo := self.plain_pattern()?
    inclusive := self.at_sym("..=")
    if not inclusive and not self.at_sym("..")
        return lo
    mut lo_lit := ast.Literal.BoolLit(false)
    match lo
        Literal(value, _) =>
            match value
                IntLit(_) | CharLit(_) => lo_lit = value
                StrLit(_) | BoolLit(_) =>
                    self.range_start_error(pos)
                    return none
        Wildcard(_) | Alt(_, _) | Variant(_, _, _, _) | Range(_, _, _, _) | TuplePat(_, _) | BindName(_, _) | Nested(_, _, _, _) | StructPat(
            _,
            _,
            _,
            _,
            _,
        ) =>
            self.range_start_error(pos)
            return none
    self.i += 1
    hpos := self.here()
    # expr.match.12: a range needs both ends (`lo..=hi`).
    if self.at_sym("=>") or self.at_sym(".") or self.at_kw("if")
        self.error_text(
            "expr.match.12",
            hpos,
            "a range needs both ends, written with two dots",
            "write `lo..=hi` for both ends, e.g. `0..=9`; `_` covers the rest",
            "",
        )
        if self.at_sym(".")
            self.attach("write `..=`", [fix.span(
                hpos,
                ast.Pos(line: hpos.line, col: hpos.col + 1),
                "=",
            )])
        return none
    hi := self.plain_pattern()?
    match hi
        Literal(value, _) =>
            match value
                IntLit(_) | CharLit(_) =>
                    return ast.Pattern.Range(lo: lo_lit, hi: value, inclusive: inclusive, pos: pos)
                StrLit(_) | BoolLit(_) => self.i += 0
        Wildcard(_) | Alt(_, _) | Variant(_, _, _, _) | Range(_, _, _, _) | TuplePat(_, _) | BindName(_, _) | Nested(_, _, _, _) | StructPat(
            _,
            _,
            _,
            _,
            _,
        ) => self.i += 0
    self.error_text(
        "expr.match.12",
        hpos,
        "the end of a range pattern must be an integer or character literal",
        "write `lo..hi` or `lo..=hi` with literal ends",
        "",
    )
    none

## `_`, `Variant`, `Enum.Variant`, or a literal (expr.match.4, expr.match.7).
fn Parser.plain_pattern(mut self) ast.Pattern?
    pos := self.here()
    match self.peek()
        Ident(n) =>
            self.i += 1
            if n == "_"
                return ast.Pattern.Wildcard(pos)
            # `Enum.Variant`, or `m.Enum.Variant` for an imported enum (mod.use.2).
            mut path := [n]
            while self.eat_sym(".")
                path.push(self.take_name("a variant name after `.`", "expr.match.4")?.name)
            name := path[path.len() - 1]
            mut qualifier := none
            if path.len() > 1
                qualifier = path[0..path.len() - 1].join(".")
            # `Variant(a, _)`: one binding per field (expr.match.6), or a
            # pattern of its own in a field (expr.match.13).
            mut bindings := none
            if self.eat_sym("(")
                mut names := List[ast.Ident]()
                mut subs := List[ast.Pattern]()
                mut nested := false
                # expr.match.14: `name: pattern` matches a field by name.
                mut labels := List[str]()
                mut item_pos := List[ast.Pos]()
                mut labeled := false
                while not self.at_sym(")")
                    s := self.sym_at(1)
                    f := self.ident() else ""
                    lab := if f != "" then f else self.kw_at(0)
                    item_pos.push(self.here())
                    if lab != "" and s == ":"
                        self.i += 2
                        labels.push(lab)
                        subs.push(self.pattern()?)
                        labeled = true
                    elif f != "" and (s == "," or s == ")")
                        nm := self.take_name("a name or `_` for the field", "expr.match.6")?
                        names.push(nm)
                        labels.push(nm.name)
                        if nm.name == "_"
                            subs.push(ast.Pattern.Wildcard(nm.pos))
                        else
                            subs.push(ast.Pattern.BindName(name: nm.name, pos: nm.pos))
                    else
                        labels.push("")
                        subs.push(self.pattern()?)
                        nested = true
                    if not self.eat_sym(",")
                        break
                self.expect_sym(")", "`)` or `,` in the pattern", "expr.match.6")?
                if labeled
                    for k in 0..labels.len()
                        if labels[k] == "" or labels[k] == "_"
                            self.error_text(
                                "expr.match.14",
                                item_pos[k],
                                "a pattern with field names gives each field as `name: pattern` or a bare field name",
                                "write `field: pattern` here, or leave the field out to match any value",
                                "",
                            )
                            return none
                    return ast.Pattern.StructPat(
                        qualifier: qualifier,
                        name: name,
                        labels: labels,
                        fields: subs,
                        pos: pos,
                    )
                if nested
                    return ast.Pattern.Nested(
                        qualifier: qualifier,
                        name: name,
                        fields: subs,
                        pos: pos,
                    )
                bindings = names
            return ast.Pattern.Variant(
                qualifier: qualifier,
                name: name,
                bindings: bindings,
                pos: pos,
            )
        Int(v) =>
            self.i += 1
            return ast.Pattern.Literal(value: ast.Literal.IntLit("{v}"), pos: pos)
        Sym(s) =>
            if s == "("
                return self.tuple_pattern(pos)
            t := self.tag_at(1)
            if s == "-" and (t == "int" or t == "intmin")
                self.i += 1
                v := match self.bump().tok
                    Int(n) => "{-n}"
                    Ident(_) | Kw(_) | Sym(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => "-9223372036854775808"
                return ast.Pattern.Literal(value: ast.Literal.IntLit(v), pos: pos)
        IntMin =>
            self.i += 1
            self.int_too_big(pos)
            return ast.Pattern.Literal(value: ast.Literal.IntLit("0"), pos: pos)
        Char(c) =>
            self.i += 1
            return ast.Pattern.Literal(value: ast.Literal.CharLit("{c}"), pos: pos)
        Str(s) =>
            self.i += 1
            return ast.Pattern.Literal(value: ast.Literal.StrLit(s), pos: pos)
        Kw(k) =>
            if k == "true" or k == "false"
                self.i += 1
                return ast.Pattern.Literal(value: ast.Literal.BoolLit(k == "true"), pos: pos)
        Float(_) =>
            self.diags.push(Diag(
                rule: "expr.match.7",
                pos: pos,
                msg: "a pattern can be an integer, character, string or `bool` literal",
                fixed: true,
                help: "bind the value and test it in a guard: `x if x == 1.5 =>`, or `Lit(v) if v == 1.5 =>`",
                fix: fix.FLOAT_GUARD_FIX,
                edits: [fix.float_guard(pos)],
            ))
            return none
        Interp(_) =>
            self.error_text(
                "expr.match.7",
                pos,
                "a pattern can be an integer, character, string or `bool` literal",
                "bind the value and test it in a guard: `x if x == 1.5 =>`, or `Lit(v) if v == 1.5 =>`",
                "",
            )
            return none
        Bytes(_) | Newline | Indent | Dedent | Eof => self.i += 0
    self.unexpected("a pattern (a variant name or `_`)", "expr.match.4")
    none

## `(p, q, ...)` at `(` (type.tuple.6); a plain name in it binds the element.
fn Parser.tuple_pattern(mut self, pos ast.Pos) ast.Pattern?
    self.i += 1
    mut elems := List[ast.Pattern]()
    while not self.at_sym(")")
        s := self.sym_at(1)
        n := self.ident() else ""
        if n != "" and n != "_" and (s == "," or s == ")")
            npos := self.bump().pos
            elems.push(ast.Pattern.BindName(name: n, pos: npos))
        else
            elems.push(self.pattern()?)
        if not self.eat_sym(",")
            break
    self.expect_sym(")", "`)` or `,` in the tuple pattern", "type.tuple.6")?
    if elems.len() < 2
        self.error_text(
            "type.tuple.6",
            pos,
            "a tuple pattern has two or more elements",
            "write `(p, q)`",
            "",
        )
        return none
    ast.Pattern.TuplePat(elems: elems, pos: pos)
