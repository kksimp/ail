## The edits of the parser's fixes for other languages' constructs
## (gram.foreign.1, ADR 0145), as `77592931:bootstrap/src/parser/mistakes.rs` writes them.
use ast
use fix

## The start of the token after `k` when it is on the same line and not the end
## of the line, else the end of `k`: a span that removes `k` and the blank after it.
fn Parser.through_blank(self, k int) ast.Pos?
    if k + 1 < tokens.len()
        nx := tokens[k + 1]
        if nx.pos.line == tokens[k].pos.line and nx.tok != Tok.Newline and nx.tok != Tok.Eof
            return nx.pos
    tok_end(k)

## The index of the bracket that closes the one at `open`.
fn Parser.matching(self, open int) int?
    mut depth := 0
    mut k := open
    while k < tokens.len()
        t := tokens[k].tok
        if t == Tok.Sym("(") or t == Tok.Sym("[") or t == Tok.Sym("\{")
            depth += 1
        elif t == Tok.Sym(")") or t == Tok.Sym("]") or t == Tok.Sym("}")
            if depth == 0
                return none
            depth -= 1
            if depth == 0
                return k
        elif t == Tok.Eof
            return none
        k += 1
    none

## Whether the `{` at `k` ends a block header: its line starts with a keyword
## that opens a block, or with the `}` of the previous branch.
fn Parser.opens_block(self, k int) bool
    line := tokens[k].pos.line
    mut first := Tok.Eof
    for t in tokens
        if t.pos.line == line
            first = t.tok
            break
    if first == Tok.Sym("}") or first == Tok.Sym("@")
        return true
    match first
        Kw(w) => [
            "fn",
            "if",
            "elif",
            "else",
            "while",
            "for",
            "match",
            "struct",
            "enum",
            "impl",
            "trait",
            "error",
            "pub",
        ].contains(w)
        _ => false

## Braces around blocks: the edits that remove every brace pair, when each is
## on its own line (`fn f() {`, `if c {`, `} else {`).
fn Parser.brace_edits(self, open int) List[fix.Edit]
    mut edits := List[fix.Edit]()
    for k in open..tokens.len()
        if tokens[k].tok != Tok.Sym("\{") or not line_ends_at(k) or not self.opens_block(k)
            continue
        edits.push(fix.trim_before(tokens[k].pos))
        close := self.matching(k) else return []
        cp := tokens[close].pos
        alone := close > 0 and tokens[close - 1].pos.line < cp.line
        if close + 1 < tokens.len()
            n := tokens[close + 1]
            if n.pos.line == cp.line
                and (n.tok == Tok.Kw("else") or n.tok == Tok.Kw("elif"))
                and alone
                edits.push(fix.delete(cp, n.pos))
                continue
            if n.pos.line == cp.line and n.tok != Tok.Newline and n.tok != Tok.Eof
                return []
        if alone
            edits.push(fix.delete(
                ast.Pos(line: cp.line, col: 1),
                ast.Pos(line: cp.line + 1, col: 1),
            ))
        else
            return []
    edits

## `c ? a : b` as `if c then a else b`, when it is the whole value of a
## binding, assignment or `return`. `start` is the first token of the statement
## and `q` the `?`.
fn Parser.ternary_edits(self, start int, q int) List[fix.Edit]?
    mut lead := -1
    for k in start..q
        t := tokens[k].tok
        if lead < 0 and (t == Tok.Sym(":=") or t == Tok.Sym("=") or t == Tok.Kw("return"))
            lead = k
    if lead < 0
        return none
    for k in start..lead
        t := tokens[k].tok
        if t == Tok.Sym("(") or t == Tok.Sym("[") or t == Tok.Sym("\{")
            return none
    cond := lead + 1
    if cond >= q
        return none
    mut depth := 0
    mut colon := -1
    mut k := q + 1
    while k < tokens.len()
        t := tokens[k].tok
        if t == Tok.Newline or t == Tok.Eof or t == Tok.Indent or t == Tok.Dedent
            break
        if t == Tok.Sym("(") or t == Tok.Sym("[") or t == Tok.Sym("\{")
            depth += 1
        elif t == Tok.Sym(")") or t == Tok.Sym("]") or t == Tok.Sym("}")
            depth -= 1
        elif t == Tok.Sym("?") and depth == 0
            return none
        elif t == Tok.Sym(":") and depth == 0
            if colon >= 0
                return none
            colon = k
        k += 1
    if colon <= q + 1
        return none
    qp := tokens[q].pos
    cp := tokens[colon].pos
    sp := tokens[cond].pos
    [
        fix.insert(sp, "if "),
        fix.span(qp, ast.Pos(line: qp.line, col: qp.col + 1), "then"),
        fix.span(cp, ast.Pos(line: cp.line, col: cp.col + 1), "else"),
    ]

## The end of the span `if c:` removes: the colon and the blank after it, or
## just the colon when it ends the line.
fn Parser.colon_end(self, k int, pos ast.Pos, colon_only bool) ast.Pos
    if not colon_only
        if e := self.through_blank(k)
            if e.line == pos.line
                return e
    ast.Pos(line: pos.line, col: pos.col + 1)

## The edits that move the functions of `impl Owner` (no `for`) out of the block:
## each loses 4 columns of indent, and a top-level function gains `Owner.` before
## its name. `none` when something in the block isn't a plain method.
fn Parser.methods_out(self, from int, owner str) List[fix.Edit]?
    mut edits := List[fix.Edit]()
    mut depth := 0
    mut line := 0
    mut fresh := true
    mut j := from
    while j < tokens.len()
        t := tokens[j]
        if t.tok == Tok.Eof
            break
        if t.tok == Tok.Newline
            fresh = true
        elif t.tok == Tok.Indent
            depth += 1
        elif t.tok == Tok.Dedent
            depth -= 1
            if depth < 0
                break
            fresh = true
        else
            if fresh and t.pos.line != line
                if t.pos.col < 5
                    return none
                line = t.pos.line
                edits.push(fix.delete(ast.Pos(line: line, col: 1), ast.Pos(line: line, col: 5)))
                if depth == 0
                    mut k := j
                    if t.tok == Tok.Kw("pub")
                        k += 1
                    if k >= tokens.len() or tokens[k].tok != Tok.Kw("fn")
                        return none
                    if k + 1 >= tokens.len()
                        return none
                    name := tokens[k + 1]
                    if tok_tag(name.tok) != "id"
                        return none
                    if k + 2 < tokens.len() and tokens[k + 2].tok == Tok.Sym(".")
                        return none
                    edits.push(fix.insert(name.pos, "{owner}."))
            fresh = false
        j += 1
    if edits.len() == 0
        return none
    edits
