## The token listing of `ail api --tokens` (api.tok.1-3), written from the
## AIL lexer's tokens, so the selftest can compare the two byte for byte.

## One line per token, then one per comment, then one per diagnostic.
pub fn tokens_text(lexed Lexed) str
    mut out := List[str]()
    for t in lexed.tokens
        token_lines(t, mut out)
    for c in lexed.comments
        out.push("{c.pos.line}:{c.pos.col} comment {quote(c.text)}")
    diag_lines(lexed.diags, mut out)
    out.join("\n")

pub fn diag_lines(diags List[Diag], mut out List[str])
    for d in diags
        out.push("{d.pos.line}:{d.pos.col} diag {d.rule}")

## `LINE:COL KIND [VALUE]` (api.tok.2); an interpolated string lists its
## parts on the lines after it, each code part's tokens ending in `eof`,
## and then `end`.
fn token_lines(t Token, mut out List[str])
    here := "{t.pos.line}:{t.pos.col}"
    match t.tok
        Ident(name) => out.push("{here} id {name}")
        Kw(w) => out.push("{here} kw {w}")
        Sym(text) => out.push("{here} sym {text}")
        Str(value) => out.push("{here} str {quote(value)}")
        Bytes(hex) => out.push("{here} bytes {quote(hex)}")
        Char(value) => out.push("{here} char {quote("{value}")}")
        Int(value) => out.push("{here} int {value}")
        IntMin => out.push("{here} intmin")
        Float(value) => out.push("{here} float {value}")
        Newline => out.push("{here} nl")
        Indent => out.push("{here} indent")
        Dedent => out.push("{here} dedent")
        Eof => out.push("{here} eof")
        Interp(parts) =>
            out.push("{here} interp")
            for p in parts
                match p
                    Lit(text) => out.push("lit {quote(text)}")
                    Code(tokens) =>
                        out.push("code")
                        for c in tokens
                            token_lines(c, mut out)
                    Fmt(tokens, spec) =>
                        out.push("fmt {spec_text(spec)}")
                        for c in tokens
                            token_lines(c, mut out)
            out.push("end")

## A format specification as the derived JSON of `ast.FormatSpec` writes it.
fn spec_text(f FormatSpec) str
    fill := if c := f.fill then quote("{c}") else "null"
    align := if c := f.align then quote("{c}") else "null"
    width := if w := f.width then "{w.to_float()}" else "null"
    precision := if w := f.precision then "{w.to_float()}" else "null"
    "\{\"fill\":{fill},\"align\":{align},\"width\":{width},\"precision\":{precision},\"hex\":{f.hex}}"

## A string in JSON, as the prelude's `json_quote` writes it.
pub fn quote(s str) str
    Json.Str(s).to_text()

## The tree of `ail api --ast` (api.ast.1-2): the program as one line of
## JSON, then the lexer's diagnostics and the parser's, one per line.
pub fn ast_text(lexed Lexed, parsed Parsed) str
    mut out := [parsed.program.to_json().to_text()]
    diag_lines(lexed.diags, mut out)
    diag_lines(parsed.diags, mut out)
    out.join("\n")
