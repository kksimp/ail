## The AIL lexer, in AIL (Stage 3, ADR 0371): source text to tokens,
## including the layout tokens (indent, dedent, newline), as the
## bootstrap's `lexer.rs` makes them. `compiler/tokens.ail` prints the
## tokens in the form of `ail api --tokens` (api.tok.1-3), and the selftest
## compares the two on every `.ail` file in the repository.
##
## Spec rules: lex.block.1-4, lex.stmt.1-3, lex.kw.1, lex.comment.1-3,
## lex.str.1-7, lex.num.1-3, gram.foreign.1. A diagnostic carries its rule
## and position; the messages stay the bootstrap's for now (ADR 0371).
use ast
use fix

## Reserved words (lex.kw.1). `c` is deliberately absent (lex.kw.2).
KEYWORDS := {
    "and",
    "any",
    "as",
    "break",
    "continue",
    "defer",
    "elif",
    "else",
    "ensures",
    "enum",
    "error",
    "extern",
    "false",
    "fn",
    "for",
    "if",
    "impl",
    "in",
    "invariant",
    "match",
    "move",
    "mut",
    "none",
    "not",
    "or",
    "par",
    "pub",
    "ref",
    "requires",
    "return",
    "select",
    "self",
    "spawn",
    "struct",
    "todo",
    "trait",
    "true",
    "unique",
    "unsafe",
    "use",
    "while",
    "with",
    "yield",
}

## The reserved words, sorted: what `ail help --keywords` prints for editors (tool.help.3).
pub fn keywords() List[str]
    KEYWORDS.sorted()

## Symbols of two characters, and of one. `..=` is checked first, then `..`,
## then these, so the longest spelling wins (`..=` over `..` over `.`).
TWO_SYMBOLS := {
    "->",
    "=>",
    ":=",
    "==",
    "!=",
    "<=",
    ">=",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "&&",
    "||",
    "<<",
    ">>",
    "&=",
    "|=",
    "^=",
}

ONE_SYMBOLS := {
    ".",
    ":",
    ",",
    "(",
    ")",
    "[",
    "]",
    "\{",
    "}",
    "=",
    "<",
    ">",
    "+",
    "-",
    "*",
    "/",
    "%",
    "!",
    "?",
    "@",
    "|",
    "&",
    "^",
    "~",
}

## A line ending in one of these continues on the next line (lex.stmt.2).
## `|` is left out: it also closes a key function's `|x|` (expr.key.1), and a trailing
## `a |` does not continue (expr.bit.3).
BINARY_SYMBOLS := {
    "+",
    "-",
    "*",
    "/",
    "%",
    "==",
    "!=",
    "<",
    "<=",
    ">",
    ">=",
    "..",
    "..=",
    "&",
    "^",
    "<<",
    ">>",
}

## The indentation unit is exactly four spaces (lex.block.2, ADR 0040).
UNIT := 4

## Largest width or precision a format specification accepts (lex.str.7).
MAX_FORMAT_WIDTH := 1000

## A token's kind and value.
pub enum Tok
    Ident(name str)
    Kw(word str)
    Sym(text str)
    Str(value str)
    ## `b"..."`, its bytes as lowercase hex (lex.bytes.1).
    Bytes(hex str)
    ## A string literal containing `{expression}` parts (lex.str.2).
    Interp(parts List[Part])
    ## `'a'` (lex.str.4)
    Char(value char)
    Int(value int)
    ## `9223372036854775808`, which fits only after a `-` (lex.num.3).
    IntMin
    ## `1.5`, `1e3` (lex.num.2)
    Float(value float)
    Newline
    Indent
    Dedent
    Eof

## A piece of an interpolated string: literal text, or the tokens of one
## embedded expression (ending in `Eof`), with its format specification
## if it has one (lex.str.7).
pub enum Part
    Lit(text str)
    Code(tokens List[Token])
    Fmt(tokens List[Token], spec FormatSpec)

pub struct Token
    pub tok Tok
    pub pos ast.Pos

## `[[fill]align][+][0][width][,][.precision][x|b|e]` after the `:` in `{expression:spec}`
## (lex.str.7).
pub struct FormatSpec
    pub fill char?
    ## `<`, `>` or `^`.
    pub align char?
    pub width int?
    ## Decimal places of a float (`.N`).
    pub precision int?
    ## `x`: lowercase hexadecimal for an int.
    pub hex bool
    ## The other marks, each at most once: `+` (always a sign), `0` (zero padding), `,`
    ## (thousands separators), `b` (binary int), `e` (exponent form of a float).
    pub flags str

## A mistake: the rule it breaks and where. The parser keeps the message
## of a diagnostic with a fix, to join repeats on one line (gram.rec.1).
pub struct Diag
    pub rule str
    pub pos ast.Pos
    pub msg str
    pub fixed bool
    pub help str
    pub fix str
    ## The edits of the fix, when it has them (ADR 0145).
    pub edits List[fix.Edit]

## A comment (lex.comment.1): `text` runs from the `#` to the end of the line.
pub struct Comment
    pub pos ast.Pos
    pub text str

## The tokens of a file, its diagnostics in the order found, and its comments.
pub struct Lexed
    pub tokens List[Token]
    pub diags List[Diag]
    pub comments List[Comment]

## An unclosed `(`, `[` or `{`.
struct Open
    c char
    pos ast.Pos

## A statement-starting line: its number, the characters of its leading
## whitespace and their width (a tab counts as one unit).
struct Lead
    line int
    chars int
    width int

## Where a multi-line string starts on a line (lex.str.3): the column of
## its `"""` (or `r"""`), and whether it is raw.
struct Opening
    col int
    raw bool

## A line and column, 0-based, to carry on from.
struct Resume
    line int
    col int

## An escape's character, if it is valid, and the index after it.
struct Escaped
    ch char?
    next int

struct Lexer
    tokens List[Token]
    diags List[Diag]
    ## Unclosed brackets: newlines inside them don't end statements.
    open List[Open]
    ## Depth of string interpolation being lexed.
    in_interp int
    comments List[Comment]
    ## Spaces per indentation level in this run (1 = the standard 4).
    scale int
    logical List[Lead]
    ## The part of `logical` indented with a tab.
    tabs List[Lead]
    ## Empty `\{}` placeholders of the string being lexed (lex.str.2), reported once per string by `placeholders`.
    holes List[ast.Pos]

## The result of one run at one indentation unit, and the unit to run
## again with (0 for none).
struct Scaled
    lexed Lexed
    unit int

## Lex `src` (lex.*). A file that indents by 2 or 3 spaces is lexed again
## at that unit, so one diagnostic covers the whole file (lex.block.2, ADR 0263).
pub fn lex(src str) Lexed
    first := lex_scaled(src, 1)
    if first.unit > 0
        return lex_scaled(src, first.unit).lexed
    first.lexed

## `line[i]`, or `'\0'` past its end.
## Whether the word ending at `end` is followed by `:=`, `=` or `(`, as a
## name being declared, set or called is (lex.kw.1).
fn names_something(line List[char], end int) bool
    mut k := end
    while k < line.len() and line[k] == ' '
        k += 1
    if k >= line.len()
        return false
    c := line[k]
    c == '(' or (c == ':' and at(line, k + 1) == '=') or (c == '=' and at(line, k + 1) != '=')

fn at(line List[char], i int) char
    if i < line.len() then line[i] else '\0'

## A character of a name: a letter, a digit or `_`.
fn name_char(c char) bool
    c.is_alnum() or c == '_'

fn ascii_alnum(c char) bool
    k := c.code()
    k >= 48 and k <= 57 or k >= 65 and k <= 90 or k >= 97 and k <= 122

fn hex_digit(c char) bool
    c.is_digit() or c.code() >= 97 and c.code() <= 102 or c.code() >= 65 and c.code() <= 70

fn blank(line List[char], from int, to int) bool
    for k in from..to
        if line[k] != ' ' and line[k] != '\t'
            return false
    true

fn text_of(line List[char], from int, to int) str
    line[from..to].join("")

## Whether `w` is spelled at `line[at..]`, ending there as a word.
fn word_at(line List[char], start int, w str) bool
    ws := w.chars()
    if line.len() - start < ws.len()
        return false
    for k in 0..ws.len()
        if line[start + k] != ws[k]
            return false
    end := start + ws.len()
    end >= line.len() or not name_char(line[end])

## Whether a line starts with a binary operator that cannot begin a statement,
## so it continues the previous one (lex.stmt.2 (5)): `and`, `or`,
## `+ * / % == != < <= > >=`.
fn leading_operator(line List[char], start int) bool
    if word_at(line, start, "and") or word_at(line, start, "or")
        return true
    two := at(line, start + 1)
    match line[start]
        '=' | '!' => two == '='
        '<' | '>' => true
        '+' | '*' | '/' | '%' => two != '='
        _ => false

fn gcd(a int, b int) int
    if b == 0 then a else gcd(b, a % b)

fn is_newline(t Tok) bool
    t == Tok.Newline

fn is_layout(t Tok) bool
    t == Tok.Indent or t == Tok.Dedent

## Does a column-1 line start a declaration (gram.rec.5)?
fn starts_declaration(line List[char]) bool
    for word in ["fn ", "struct ", "enum ", "trait ", "impl ", "pub fn ", "pub struct ", "pub enum ", "pub trait ", "use "]
        if fix.starts_at(line, 0, word.chars())
            return true
    false

## Lex with one indentation unit of `scale` spaces.
fn lex_scaled(src str, scale int) Scaled
    mut lx := Lexer(
        tokens: [],
        diags: [],
        open: [],
        in_interp: 0,
        comments: [],
        scale: scale,
        logical: [],
        tabs: [],
        holes: [],
    )
    mut indents := [0]
    # The previous line ended in a way that continues the statement.
    mut continuing := false
    mut lines := List[List[char]]()
    for raw in src.split("\n")
        mut cs := raw.chars()
        if cs.len() > 0 and cs[cs.len() - 1] == '\r'
            cs.remove_at(cs.len() - 1)
        lines.push(cs)
    mut last_line := 1
    mut li := 0
    while li < lines.len()
        line_no := li + 1
        last_line = line_no
        line := lines[li]
        mut lead := 0
        while lead < line.len() and (line[lead] == ' ' or line[lead] == '\t')
            lead += 1
        if lead == line.len() or line[lead] == '#'
            # Blank and comment-only lines don't affect blocks (lex.block note).
            if lead < line.len() and at(line, lead + 1) == '[' and at(line, lead + 2).is_alpha()
                lx.rust_attribute(line, lead, line_no)
            lx.comment(line, lead, line_no)
            li += 1
            continue
        # gram.rec.5: a declaration keyword in column 1 ends the declaration above it, even with a bracket still open or a
        # line above that ends in an operator, so one unfinished declaration doesn't swallow the file.
        if lead == 0 and (lx.open.len() > 0 or continuing) and li > 0 and starts_declaration(line)
            mut above := li - 1
            while above > 0 and lines[above].len() == 0
                above -= 1
            stop := ast.Pos(line: above + 1, col: lines[above].len() + 1)
            if lx.open.len() > 0
                lx.unclosed(lines)
                mut k := lx.open.len() - 1
                while k >= 0
                    sym := match lx.open[k].c
                        '(' => ")"
                        '[' => "]"
                        _ => "}"
                    lx.push(Sym(sym), stop)
                    k -= 1
                lx.open = []
            lx.push(Newline, stop)
            continuing = false
        # lex.stmt.2 (4): a line starting with `.name` continues the previous
        # statement (a chained call); the statement's newline is taken back.
        dot_name := line[lead] == '.'
            and (at(line, lead + 1).is_alpha() or at(line, lead + 1) == '_')
        n := lx.tokens.len()
        if lx.open.len() == 0
            and not continuing
            and (dot_name or leading_operator(line, lead))
            and n >= 2
            and is_newline(lx.tokens[n - 1].tok)
            and not is_layout(lx.tokens[n - 2].tok)
            lx.tokens.remove_at(n - 1)
            continuing = true
        if lx.open.len() == 0 and not continuing
            width := lx.indent_width(line, lead, line_no)
            top := indents[indents.len() - 1]
            pos := ast.Pos(line: line_no, col: 1)
            if width > top
                if width != top + UNIT
                    lx.diag_msg(
                        "lex.block.3",
                        ast.Pos(line: line_no, col: width + 1),
                        "indentation increases by {width - top} spaces; a block is indented by exactly 4",
                        "indent this line by {top + UNIT} spaces",
                    )
                indents.push(width)
                lx.push(Indent, pos)
            else
                while width < indents[indents.len() - 1]
                    indents.remove_at(indents.len() - 1)
                    lx.push(Dedent, pos)
                if width != indents[indents.len() - 1]
                    lx.diag_msg(
                        "lex.block.1",
                        ast.Pos(line: line_no, col: width + 1),
                        "this line's indentation doesn't match any enclosing block",
                        "",
                    )
                    indents.push(width)
        # A multi-line string continues the line onto later lines (lex.str.3).
        before := lx.tokens.len()
        mut from := lead
        while true
            o := lx.lex_line(lines[li], from, li + 1) else break
            r := lx.multiline(lines, li, o.col, o.raw)
            li = r.line
            from = r.col
        produced := lx.tokens.len() > before
        end_col := lines[li].len() + 1
        last_line = li + 1
        if lx.open.len() == 0
            # lex.stmt.2: a line ending in a comma or a binary operator continues.
            mut continues := false
            if lx.tokens.len() > 0
                continues = match lx.tokens[lx.tokens.len() - 1].tok
                    Sym(s) => s == "," or BINARY_SYMBOLS.contains(s)
                    Kw(k) => k == "and" or k == "or"
                    Ident(_) | Str(_) | Bytes(_) | Interp(_) | Char(_) | Int(_) | IntMin | Float(_) | Newline | Indent | Dedent | Eof => false
            if produced and continues
                continuing = true
            else
                if produced or continuing
                    lx.push(Newline, ast.Pos(line: li + 1, col: end_col))
                continuing = false
        li += 1
    end := ast.Pos(line: last_line, col: 1)
    if lx.open.len() > 0
        lx.unclosed(lines)
        # Close them for the parser too, so one report isn't followed by another.
        mut k := lx.open.len() - 1
        while k >= 0
            sym := match lx.open[k].c
                '(' => ")"
                '[' => "]"
                _ => "}"
            lx.push(Sym(sym), end)
            k -= 1
        lx.push(Newline, end)
    while indents.len() > 1
        indents.remove_at(indents.len() - 1)
        lx.push(Dedent, end)
    lx.push(Eof, end)
    unit := lx.indent_diags()
    Scaled(lexed: Lexed(tokens: lx.tokens, diags: lx.diags, comments: lx.comments), unit: unit)

fn Lexer.push(mut self, tok Tok, pos ast.Pos)
    self.tokens.push(Token(tok: tok, pos: pos))

fn Lexer.diag(mut self, rule str, pos ast.Pos)
    self.diags.push(Diag(rule: rule, pos: pos, msg: "", fixed: false, help: "", fix: "", edits: []))

## A diagnostic with its message and a fix, as the Rust front end gives it.
fn Lexer.diag_msg(mut self, rule str, pos ast.Pos, msg str, help str)
    self.diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: false,
        help: help,
        fix: "",
        edits: [],
    ))

## lex.stmt.2: the innermost bracket left open at the end of the file. The fix
## closes them at the end of the line, when they all opened on it.
fn Lexer.unclosed(mut self, lines List[List[char]])
    last := self.open[self.open.len() - 1]
    mut one_line := true
    for o in self.open
        if o.pos.line != last.pos.line
            one_line = false
    # `if x \{`: a brace that ends a block header is C's block, which AIL writes by indenting (checkbench, ADR 1111).
    if one_line
        and self.open.len() == 1
        and last.c == '\{'
        and last.pos.line >= 1
        and last.pos.line <= lines.len()
        text := lines[last.pos.line - 1]
        mut e := text.len()
        while e > 0 and text[e - 1] == ' '
            e -= 1
        if e == last.pos.col
            mut b := last.pos.col - 1
            while b > 0 and text[b - 1] == ' '
                b -= 1
            self.diags.push(Diag(
                rule: "lex.stmt.2",
                pos: last.pos,
                msg: "this `\{` is never closed: AIL blocks are indented, not braced",
                fixed: true,
                help: "end the header line without `\{`; the block is the lines indented 4 spaces below it, and no `}` closes it",
                fix: "remove the `\{`",
                edits: [fix.delete(
                    ast.Pos(line: last.pos.line, col: b + 1),
                    ast.Pos(line: last.pos.line, col: e + 1),
                )],
            ))
            return
    # One `[` left open: the `]` goes after the index or type argument when the line goes on (checkbench, ADR 1111).
    if one_line
        and self.open.len() == 1
        and last.c == '['
        and last.pos.line >= 1
        and last.pos.line <= lines.len()
        k := bracket_close_at(lines[last.pos.line - 1], last.pos.col - 1)
        if k >= 0
            self.diags.push(Diag(
                rule: "lex.stmt.2",
                pos: last.pos,
                msg: "this `[` is never closed",
                fixed: true,
                help: "",
                fix: "close it after the index",
                edits: [fix.insert(ast.Pos(line: last.pos.line, col: k + 1), "]")],
            ))
            return
    self.diags.push(Diag(
        rule: "lex.stmt.2",
        pos: last.pos,
        msg: "this `{last.c}` is never closed",
        fixed: one_line,
        help: "",
        fix: "close the brackets at the end of the line",
        edits: if one_line then [fix.at_line_end(last.pos, self.closers())] else [],
    ))

## Where a `]` most likely belongs when the only bracket left open on a line is the `[` at `k`: after the name
## that follows it, when the line goes on with `(` after a type argument (`List[str()`) or with `else`, `=`, `)`,
## `,`, `and`, `or`, `then` after an index (`counts[w else 0`). -1 for the end of the line.
fn bracket_close_at(line List[char], k int) int
    mut j := k + 1
    while j < line.len() and (name_char(line[j]) or line[j] == '.')
        j += 1
    if j == k + 1 or j >= line.len()
        return -1
    mut w := k - 1
    while w >= 0 and name_char(line[w])
        w -= 1
    typed := w + 1 < k and line[w + 1].is_upper()
    if line[j] == '('
        return if typed then j else -1
    mut r := j
    while r < line.len() and line[r] == ' '
        r += 1
    if r >= line.len()
        return -1
    c := line[r]
    if c == '=' or c == ')' or c == ',' or c == ':'
        return j
    for word in ["else", "then", "and", "or", "if"]
        if word_at(line, r, word)
            return j
    -1

## The brackets still open, innermost first, as the characters that close them.
fn Lexer.closers(self) str
    mut out := ""
    mut k := self.open.len() - 1
    while k >= 0
        c := self.open[k].c
        if c == '('
            out = "{out})"
        elif c == '['
            out = "{out}]"
        else
            out = "{out}}"
        k -= 1
    out

## Give the diagnostic just reported the edits of its fix.
fn Lexer.attach(mut self, edits List[fix.Edit])
    self.diags[self.diags.len() - 1].edits = edits

fn Lexer.diag_help_fix(mut self, rule str, pos ast.Pos, msg str, help str, fixed bool, title str)
    self.diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: fixed,
        help: help,
        fix: title,
        edits: [],
    ))

fn Lexer.diag_fix(mut self, rule str, pos ast.Pos, msg str, help str, title str)
    self.diags.push(Diag(
        rule: rule,
        pos: pos,
        msg: msg,
        fixed: true,
        help: help,
        fix: title,
        edits: [],
    ))

## Record the comment at `line[start..]`, if there is one.
fn Lexer.comment(mut self, line List[char], start int, line_no int)
    if at(line, start) == '#' and start < line.len()
        mut end := line.len()
        while end > start and line[end - 1].is_space()
            end -= 1
        self.comments.push(Comment(
            pos: ast.Pos(line: line_no, col: start + 1),
            text: text_of(line, start, end),
        ))

## gram.foreign.1: `#[derive(Debug)]`, `#[test]`: a Rust attribute is a comment in AIL and would do nothing, so it
## is reported, not silently ignored (checkbench, ADR 1111). The fix deletes it.
fn Lexer.rust_attribute(mut self, line List[char], lead int, line_no int)
    pos := ast.Pos(line: line_no, col: lead + 1)
    mut end := line.len()
    while end > lead and line[end - 1] == ' '
        end -= 1
    shown := text_of(line, lead, end)
    self.diag_fix(
        "gram.foreign.1",
        pos,
        "`{shown}` is a Rust attribute; in AIL `#` starts a comment, so it would do nothing",
        "delete it: `==`, `print`, copying and map keys work on every value with no derive, a test is `@test fn name()`, and a warning is allowed with `@allow(\"rule\")` before the `fn`",
        "delete the attribute",
    )
    self.attach([fix.delete(pos, ast.Pos(line: line_no, col: end + 1))])

## Stand-in for a literal that was reported as an error, so the parser
## doesn't report the same mistake again.
fn Lexer.placeholder(mut self, pos ast.Pos)
    self.push(Int(0), pos)

## Width of leading whitespace in indentation units of four. Tabs and
## other units are collected and reported once per file (`indent_diags`).
fn Lexer.indent_width(mut self, line List[char], lead int, line_no int) int
    mut tabbed := false
    mut width := 0
    for k in 0..lead
        if line[k] == '\t'
            tabbed = true
            width += UNIT
        else
            width += 1
    self.logical.push(Lead(line: line_no, chars: lead, width: width))
    if tabbed
        self.tabs.push(Lead(line: line_no, chars: lead, width: width))
    elif self.scale > 1
        return width / self.scale * UNIT
    if not tabbed and width % UNIT != 0 and self.scale == 1
        self.diag_msg(
            "lex.block.2",
            ast.Pos(line: line_no, col: 1),
            "indentation of {width} spaces is not a multiple of 4",
            "use {width / UNIT * UNIT} spaces",
        )
    width / UNIT * UNIT

## The indentation unit of a file that doesn't use 4: the common divisor
## of its statements' indentation, when that is 2 or 3 spaces; 0 otherwise.
fn Lexer.unit_guess(self) int
    mut g := 0
    mut odd := false
    mut first := 0
    for l in self.logical
        if l.width > 0
            g = gcd(g, l.width)
            if first == 0 or l.width < first
                first = l.width
        if l.width % UNIT != 0
            odd = true
    if (g == 2 or g == 3) and odd and first == g and self.tabs.len() == 0 then g else 0

## The file-level indentation diagnostics (lex.block.2, lex.block.4): one
## per file. Returns the unit to lex again with when the file doesn't
## indent by 4, or 0.
fn Lexer.indent_diags(mut self) int
    if self.tabs.len() > 0
        self.diag_fix(
            "lex.block.4",
            ast.Pos(line: self.tabs[0].line, col: 1),
            "tab character in indentation",
            "indent with 4 spaces per level",
            "replace the tabs with 4 spaces per level",
        )
        self.attach([
            fix.span(
                ast.Pos(line: t.line, col: 1),
                ast.Pos(line: t.line, col: t.chars + 1),
                " ".repeat(t.width / UNIT * UNIT),
            )
            for t in self.tabs
        ])
    if self.scale == 1
        return self.unit_guess()
    for l in self.logical
        if l.width > 0
            self.diag_fix(
                "lex.block.2",
                ast.Pos(line: l.line, col: 1),
                "this file indents by {self.scale} spaces; a block is indented by exactly 4",
                "use 4 spaces per level",
                "re-indent the file from {self.scale} to 4 spaces per level",
            )
            self.attach([
                fix.span(
                    ast.Pos(line: x.line, col: 1),
                    ast.Pos(line: x.line, col: x.chars + 1),
                    " ".repeat(x.width / self.scale * UNIT),
                )
                for x in self.logical if x.width > 0
            ])
            return 0
    0

## Lex `line[start..]`. Stops at a multi-line string's opening `"""`
## (lex.str.3), giving its column and whether it is raw, so the caller can
## read the following lines.
fn Lexer.lex_line(mut self, line List[char], start int, line_no int) Opening?
    mut i := start
    while i < line.len()
        c := line[i]
        pos := ast.Pos(line: line_no, col: i + 1)
        if c == ' ' or c == '\t'
            i += 1
        elif c == '#' and self.in_interp > 0
            self.diag_msg(
                "lex.str.2",
                pos,
                "a comment can't appear inside `\{...}` in a string",
                "",
            )
            i += 1
        elif c == '#'
            # Comment to the end of the line (lex.comment.1, lex.comment.2).
            self.comment(line, i, line_no)
            break
        elif c == '"' and starts_triple(line, i)
            if self.in_interp > 0
                self.diag_msg(
                    "lex.str.3",
                    pos,
                    "a multi-line string can't appear inside `\{...}` in a string",
                    "",
                )
                return none
            return Opening(col: i, raw: false)
        elif c == '"'
            i = self.string(line, i, line_no)
        elif c == 'r' and at(line, i + 1) == '"'
            # lex.str.6: `r"..."` and `r"""..."""` are raw strings.
            if starts_triple(line, i + 1) and self.in_interp == 0
                return Opening(col: i, raw: true)
            i = self.raw_string(line, i, line_no)
        elif c == 'b' and at(line, i + 1) == '"'
            # lex.bytes.1: `b"..."` is a `bytes` literal.
            i = self.bytes_literal(line, i, line_no)
        elif c == '\''
            after := self.lifetime(line, i, line_no)
            i = if after >= 0 then after else self.char_literal(line, i, line_no)
        elif c == ';'
            self.diag_fix(
                "lex.stmt.3",
                pos,
                "AIL has no `;`; a statement ends at the end of its line",
                "remove the `;` and put the next statement on its own line",
                "end the statement here, without the `;`",
            )
            self.attach([semicolon_edit(line, i, pos)])
            # Recover as if the line ended here, so the parser doesn't report it again.
            if self.open.len() == 0 and self.in_interp == 0
                self.push(Newline, pos)
            i += 1
        elif c == '/' and at(line, i + 1) == '/'
            if blank_before(line, i)
                self.diag_fix(
                    "gram.foreign.1",
                    pos,
                    "`//` isn't a comment or an operator in AIL",
                    "comments start with `#`",
                    "write `#`",
                )
                self.attach([fix.span(pos, ast.Pos(line: line_no, col: i + 3), "#")])
            else
                self.diag_fix(
                    "gram.foreign.1",
                    pos,
                    "`//` isn't a comment or an operator in AIL",
                    "write `#` for a comment; `/` is integer division and rounds toward zero",
                    "",
                )
            break
        elif c == '/' and at(line, i + 1) == '*'
            self.diag_fix(
                "gram.foreign.1",
                pos,
                "`/*` doesn't start a comment in AIL",
                "comments start with `#` and run to the end of the line",
                "",
            )
            break
        elif c == '\\' and rest_is_space(line, i + 1)
            self.diag_fix(
                "gram.foreign.1",
                pos,
                "AIL doesn't use `\\` to continue a line",
                "end the line with an operator or a comma, or wrap the expression in parentheses",
                "remove the `\\`",
            )
            self.attach([fix.trim_before(pos)])
            i += 1
        elif c.is_digit()
            i = self.number(line, i, line_no)
        elif c.is_alpha() or c == '_'
            mut end := i
            while end < line.len() and name_char(line[end])
                end += 1
            word := text_of(line, i, end)
            if word == "uhwhatnow"
                # `uhwhatnow?` is one token, the hole that asks (lex.kw.1, expr.hole.3).
                if at(line, end) == '?'
                    end += 1
                elif names_something(line, end)
                    self.diag_fix(
                        "lex.kw.1",
                        pos,
                        "`uhwhatnow` is reserved and can't be used as a name",
                        "choose a different name, such as `what_next`",
                        "rename `uhwhatnow` to `what_next` here",
                    )
                    self.attach([fix.span(pos, ast.Pos(line: line_no, col: end + 1), "what_next")])
                else
                    self.diag_fix(
                        "lex.kw.1",
                        pos,
                        "`uhwhatnow` is written with its `?`",
                        "`uhwhatnow?` is the hole that asks what fits here (expr.hole.3); the word alone is reserved",
                        "write `uhwhatnow?`",
                    )
                    self.attach([fix.insert(ast.Pos(line: line_no, col: end + 1), "?")])
                self.push(Kw("uhwhatnow?"), pos)
            elif KEYWORDS.contains(word)
                self.push(Kw(word), pos)
            elif (word == "f" or word == "u") and at(line, end) == '"'
                self.diag_fix(
                    "gram.foreign.1",
                    pos,
                    "`{word}\"...\"` isn't a string prefix in AIL",
                    "every string interpolates `\{expression}`; write the string without the prefix",
                    "remove the `{word}`",
                )
                self.attach([fix.delete(pos, ast.Pos(line: line_no, col: i + 2))])
            else
                self.push(Ident(word), pos)
            i = end
        else
            sym := symbol_at(line, i) else ""
            if sym == ""
                self.diag_msg(
                    "bootstrap.unsupported",
                    pos,
                    "the character `{c}` isn't part of AIL",
                    "remove it; source uses ASCII symbols, with UTF-8 text only in strings, chars and comments (lex.*)",
                )
                i += 1
            else
                self.symbol(sym, pos)
                i += sym.len()
    none

## True when only blanks come before `at` on the line.
## The edit of lex.stmt.3: the `;` at `line[i]` goes, and what follows it on the
## line moves to a line of its own.
fn semicolon_edit(line List[char], i int, pos ast.Pos) fix.Edit
    mut k := i + 1
    while k < line.len() and (line[k] == ' ' or line[k] == '\t')
        k += 1
    if k >= line.len() or line[k] == '#'
        return fix.trim_before(pos)
    mut indent := ""
    for c in line
        if c != ' '
            break
        indent = "{indent} "
    fix.span(pos, ast.Pos(line: pos.line, col: k + 1), "\n{indent}")

fn blank_before(line List[char], stop int) bool
    for k in 0..stop
        if not line[k].is_space()
            return false
    true

fn rest_is_space(line List[char], from int) bool
    for k in from..line.len()
        if not line[k].is_space()
            return false
    true

## The longest symbol spelled at `line[i..]`.
fn symbol_at(line List[char], i int) str?
    if i + 1 < line.len()
        two := text_of(line, i, i + 2)
        if two == ".."
            if i + 2 < line.len() and line[i + 2] == '='
                return "..="
            return ".."
        # `<<=` and `>>=` (expr.bit.5).
        if (two == "<<" or two == ">>") and i + 2 < line.len() and line[i + 2] == '='
            return "{two}="
        if TWO_SYMBOLS.contains(two)
            return two
    one := text_of(line, i, i + 1)
    if ONE_SYMBOLS.contains(one)
        return one
    none

fn Lexer.symbol(mut self, sym str, pos ast.Pos)
    if sym == "(" or sym == "[" or sym == "\{"
        self.open.push(Open(c: sym.chars()[0], pos: pos))
    elif sym == ")" or sym == "]" or sym == "}"
        if self.open.len() > 0
            self.open.remove_at(self.open.len() - 1)
    self.push(Sym(sym), pos)

## String literal starting at `line[start] == '"'`; returns the index after it.
fn Lexer.string(mut self, line List[char], start int, line_no int) int
    pos := ast.Pos(line: line_no, col: start + 1)
    mut value := List[char]()
    mut parts := List[Part]()
    mark := self.holes.len()
    if close := self.content(line, start + 1, line.len(), line_no, true, mut value, mut parts)
        if self.holes.len() > mark
            found := self.holes[mark..self.holes.len()]
            while self.holes.len() > mark
                self.holes.remove_at(self.holes.len() - 1)
            self.placeholders(line, start, close, line_no, found)
        self.push(string_token(value, parts), pos)
        return close + 1
    while self.holes.len() > mark
        self.holes.remove_at(self.holes.len() - 1)
    self.diag_fix(
        "lex.str.1",
        pos,
        "unterminated string literal",
        "close the string with `\"`",
        "close the string",
    )
    self.attach([fix.insert(ast.Pos(line: line_no, col: string_end(line, start) + 1), "\"")])
    self.forget_brackets(line_no)
    line.len()

## Where the `"` of a string left open at `line[start]` most likely goes: before the brackets at the end of the
## line that close the call around it, `print("total: \{n})` (lex.str.1, checkbench ADR 1111).
fn string_end(line List[char], start int) int
    mut depth := 0
    for k in 0..start
        if line[k] == '(' or line[k] == '['
            depth += 1
        elif (line[k] == ')' or line[k] == ']') and depth > 0
            depth -= 1
    mut e := line.len()
    while e > start + 1 and line[e - 1] == ' '
        e -= 1
    while e > start + 1 and depth > 0 and (line[e - 1] == ')' or line[e - 1] == ']')
        e -= 1
        depth -= 1
    e

## Whether the text of a `\{...}` in a string is plainly not an expression: JSON (`"key": 1`), a statement
## (`return 1`, `int x;`), so the `\{` was meant as a literal brace (lex.str.2).
fn literal_brace(line List[char], from int, to int) bool
    inner := text_of(line, from, to).trim()
    if inner.is_empty()
        return false
    # String literals inside an interpolation are ordinary (`\{" ".repeat(n)}`, `\{xs.join("; ")}`): judge the rest.
    rest := outside_strings(inner)
    # JSON: a quoted key, then `:` and something that is not a format specification (`\{"name":<10}` is one).
    if inner.starts_with("\"")
        if after_key := rest.trim_start().strip_prefix(":")
            if parse_spec(after_key.chars()) == none
                return true
    if rest.contains(";")
        return true
    for w in ["return ", "fn ", "let ", "var ", "const ", "int ", "void ", "func ", "def "]
        if inner.starts_with(w)
            return true
    false

## `s` with every string literal in it (quotes and contents, `\\"` escapes kept inside) left out.
fn outside_strings(s str) str
    mut kept := List[char]()
    mut inq := false
    mut escaped := false
    for c in s.chars()
        if inq
            if escaped
                escaped = false
            elif c == '\\'
                escaped = true
            elif c == '"'
                inq = false
        elif c == '"'
            inq = true
        else
            kept.push(c)
    kept.join("")

## The arguments after a string that is a call's first argument: `, a, b)`. `close` is the index of the
## call's `)`, or -1 when the rest isn't plain arguments (a string, a brace or a char in it).
struct TrailingArgs
    texts List[str]
    close int

fn trailing_args(line List[char], from int) TrailingArgs
    nothing := TrailingArgs(texts: [], close: -1)
    mut k := from
    while at(line, k) == ' '
        k += 1
    if at(line, k) != ','
        return nothing
    mut texts := List[str]()
    mut depth := 0
    mut begin := k + 1
    k += 1
    while k < line.len()
        c := line[k]
        if c == '"' or c == '\'' or c == '{' or c == '}' or c == '#'
            return nothing
        if c == '(' or c == '['
            depth += 1
        elif (c == ')' or c == ']') and depth > 0
            depth -= 1
        elif c == ')' or (c == ',' and depth == 0)
            t := text_of(line, begin, k).trim()
            if t.is_empty()
                return nothing
            texts.push(t)
            if c == ')'
                return TrailingArgs(texts: texts, close: k)
            begin = k + 1
        k += 1
    nothing

## lex.str.2: `\{}` placeholders (Rust's `format!`, Python's `.format`, printf habits), reported once per string,
## not once per `\{}`. When the string is a call's first argument followed by one plain argument per `\{}`, the fix
## moves each argument into its braces: `print("\{} and \{}", a, b)` becomes `print("\{a} and \{b}")`, and
## `format!("\{}-\{}", x, y)` becomes `"\{x}-\{y}"` (checkbench, ADR 1111). `q` and `close` index the quotes.
fn Lexer.placeholders(mut self, line List[char], q int, close int, line_no int, found List[ast.Pos])
    args := trailing_args(line, close + 1)
    hole := found[0]
    if args.texts.len() != found.len()
        self.diag_fix(
            "lex.str.2",
            hole,
            "empty `\{}` in a string: AIL puts the value inside the braces",
            "write the expression inside, `\"total: \{n}\"`, or `\\\{` for a literal brace",
            "write `\\\{` for a literal brace",
        )
        self.attach([fix.insert(h, "\\") for h in found])
        return
    mut out := List[str]()
    mut n := 0
    for k in q..close + 1
        if n < found.len() and k + 1 == found[n].col
            out.push("\{")
            out.push(args.texts[n])
            n += 1
        else
            out.push("{line[k]}")
    filled := out.join("")
    end := ast.Pos(line: line_no, col: args.close + 1)
    # `format!(` just before the string: the string replaces the whole macro call.
    t := self.tokens.len()
    if t >= 3
        and self.tokens[t - 1].tok == Tok.Sym("(")
        and self.tokens[t - 2].tok == Tok.Sym("!")
        and self.tokens[t - 3].tok == Tok.Ident("format")
        and self.tokens[t - 1].pos.col == q
        at_macro := self.tokens[t - 3].pos
        self.diag_fix(
            "gram.foreign.1",
            at_macro,
            "AIL has no `format!`: a string interpolates, with each value inside its braces",
            "write `{filled}`; a width or precision goes after a colon: `\{x:>6}`, `\{x:.2}`",
            "move the values into the braces",
        )
        self.attach([fix.span(at_macro, ast.Pos(line: line_no, col: args.close + 2), filled)])
        return
    self.diag_fix(
        "lex.str.2",
        hole,
        "empty `\{}` in a string: AIL puts the value inside the braces",
        "write `{filled}`; a width or precision goes after a colon: `\{x:>6}`, `\{x:.2}`",
        "move the values into the braces",
    )
    self.attach([fix.span(ast.Pos(line: line_no, col: q + 1), end, filled)])

## `b"..."`: ASCII text with the escapes `\n \t \r \0 \\ \" \xHH` and no
## interpolation (lex.bytes.1). `line[start]` is the `b`. The token keeps the
## bytes as hex.
fn Lexer.bytes_literal(mut self, line List[char], start int, line_no int) int
    pos := ast.Pos(line: line_no, col: start + 1)
    mut hex := List[str]()
    mut i := start + 2
    while i < line.len()
        here := ast.Pos(line: line_no, col: i + 1)
        c := line[i]
        if c == '"'
            self.push(Bytes(hex.join("")), pos)
            return i + 1
        elif c == '\\'
            simple := match at(line, i + 1)
                'n' => 10
                't' => 9
                'r' => 13
                '0' => 0
                '\\' => 92
                '"' => 34
                _ => -1
            hi := at(line, i + 2).to_digit(16)
            lo := at(line, i + 3).to_digit(16)
            if simple >= 0 and i + 1 < line.len()
                hex.push(hex_byte(simple))
                i += 2
            elif at(line, i + 1) == 'x' and hi != none and lo != none
                hex.push(hex_byte((hi else 0) * 16 + (lo else 0)))
                i += 4
            else
                fixed := bytes_unicode(line, i)
                self.diag_help_fix(
                    "lex.bytes.1",
                    here,
                    "invalid escape in a `bytes` literal",
                    "valid escapes: \\n \\t \\r \\0 \\\\ \\\" \\xHH",
                    fixed,
                    "write its UTF-8 bytes",
                )
                if fixed
                    close := close_brace(line, i + 3)
                    if cp := hex_char(line, i + 3, close)
                        self.attach([fix.span(
                            here,
                            ast.Pos(line: here.line, col: here.col + close - i + 1),
                            utf8_escapes(cp),
                        )])
                i += 2
        elif c.code() < 128
            hex.push(hex_byte(c.code()))
            i += 1
        else
            self.diag_msg(
                "lex.bytes.1",
                here,
                "`{c}` is not ASCII, so it can't be in a `bytes` literal",
                "write its UTF-8 bytes as `\\xHH` escapes, or use `\"...\".to_bytes()`",
            )
            i += 1
    self.diag_msg("lex.bytes.1", pos, "unterminated `bytes` literal", "close the literal with `\"`")
    self.forget_brackets(line_no)
    line.len()

## `n`, a byte, as two lowercase hex digits.
fn hex_byte(n int) str
    digits := "0123456789abcdef"
    "{digits.char_at(n / 16) else '0'}{digits.char_at(n % 16) else '0'}"

## After a string error, the brackets opened on its line don't continue
## the statement, so the error isn't followed by others about them.
fn Lexer.forget_brackets(mut self, line_no int)
    self.open = [o for o in self.open if o.pos.line != line_no]

## `r"..."`: no escapes and no interpolation (lex.str.6). `line[start]` is the `r`.
fn Lexer.raw_string(mut self, line List[char], start int, line_no int) int
    pos := ast.Pos(line: line_no, col: start + 1)
    for k in start + 2..line.len()
        if line[k] == '"'
            self.push(Str(text_of(line, start + 2, k)), pos)
            return k + 1
    self.diag_fix(
        "lex.str.1",
        pos,
        "unterminated string literal",
        "close the string with `\"`",
        "close the string",
    )
    self.attach([fix.insert(ast.Pos(line: line_no, col: string_end(line, start) + 1), "\"")])
    self.forget_brackets(line_no)
    line.len()

## The text of a string in `line[from..to]`, with escapes and `{...}`
## interpolation (lex.str.1-2), appended to `value` and `parts`. When
## `quoted`, it stops at an unescaped `"` and gives its index.
fn Lexer.content(
    mut self,
    line List[char],
    from int,
    to int,
    line_no int,
    quoted bool,
    mut value List[char],
    mut parts List[Part],
) int?
    mut i := from
    # One `empty \{}` report per multi-line string part.
    mut said := false
    while i < to
        here := ast.Pos(line: line_no, col: i + 1)
        c := line[i]
        if c == '"' and quoted
            return i
        if c == '\\'
            e := self.escape(line, i, line_no)
            if ch := e.ch
                value.push(ch)
            i = e.next
        elif c == '{'
            # lex.str.2: `{expression}` interpolates.
            close := find_close(line, to, i)
            if close < 0
                self.diag_fix(
                    "lex.str.2",
                    here,
                    "this `\{` in a string is never closed",
                    "close it with `}`, or write `\\\{` for a literal brace",
                    "write `\\\{` for a literal brace",
                )
                self.attach([fix.insert(here, "\\")])
                self.forget_brackets(line_no)
                if quoted
                    return to
                return none
            if literal_brace(line, i + 1, close)
                # JSON or C code in a string: the brace was meant as text. One report and one fix for the whole
                # `\{...}`, kept as text, so its inner braces and code aren't reported again (checkbench, ADR 1111).
                inner := text_of(line, i + 1, close).trim()
                self.diag_fix(
                    "lex.str.2",
                    here,
                    "this `\{` starts an interpolation, but `{inner}` is not an expression",
                    "write `\\\{` for a literal brace: text such as JSON or C code in a string escapes each `\{`",
                    "escape the braces",
                )
                self.attach([
                    fix.insert(ast.Pos(line: line_no, col: b + 1), "\\")
                    for b in i..close if line[b] == '{'
                ])
                for ci in i..close + 1
                    value.push(line[ci])
                i = close + 1
                continue
            if value.len() > 0 and value[value.len() - 1] == '$'
                # lex.str.8: `${n}` is not interpolation in AIL.
                self.diag_fix(
                    "lex.str.8",
                    here,
                    "`$\{...}` is not interpolation in AIL: the `$` stays in the text",
                    "write `\{name}` without the `$`; for the literal text `$\{` write `$\\\{`",
                    "remove the `$`",
                )
                self.attach([fix.delete(ast.Pos(line: line_no, col: i), here)])
            colon := spec_colon(line, close, i + 1)
            code := self.sub_lex(line, i + 1, if colon >= 0 then colon else close, line_no)
            spec := if colon >= 0 then parse_spec(line[colon + 1..close]) else none
            if colon >= 0 and spec == none
                shown := line[colon + 1..close].join("")
                self.diag_msg(
                    "lex.str.7",
                    ast.Pos(line: line_no, col: colon + 2),
                    "invalid format specification `{shown}`: {spec_why(line[colon + 1..close])}",
                    "a specification is `[[fill]align][+][0][width][,][.decimals][x|b|e]`, e.g. `\{n:>8}`, `\{n:08}`, `\{r:.2}`, `\{n:,}`, `\{n:b}`",
                )
            if code.len() == 1 and quoted
                # Reported once for the whole string, after it closes (`placeholders`).
                self.holes.push(here)
            elif code.len() == 1
                if not said
                    self.diag_fix(
                        "lex.str.2",
                        here,
                        "empty `\{}` in a string",
                        "put an expression inside, or write `\\\{` for a literal brace",
                        "write `\\\{` for a literal brace",
                    )
                    self.attach([fix.insert(here, "\\")])
                said = true
            else
                if value.len() > 0
                    parts.push(Lit(value.join("")))
                    value.clear()
                if f := spec
                    parts.push(Fmt(code, f))
                else
                    parts.push(Code(code))
            i = close + 1
        else
            value.push(c)
            i += 1
    none

## A multi-line string whose opening `"""` (or `r"""`) is at
## `lines[first][col]` (lex.str.3, lex.str.6). Gives the line and column
## just after the closing `"""`.
fn Lexer.multiline(mut self, lines List[List[char]], first int, col int, raw bool) Resume
    pos := ast.Pos(line: first + 1, col: col + 1)
    open_end := if raw then col + 4 else col + 3
    opening := lines[first]
    # `"""text"""` on one line: no dedenting (lex.str.3).
    one := find_triple(opening, open_end, raw)
    if one >= 0
        mut value := List[char]()
        mut parts := List[Part]()
        if raw
            value.extend(opening[open_end..one])
        else
            _ := self.content(opening, open_end, one, first + 1, false, mut value, mut parts)
        self.push(string_token(value, parts), pos)
        return Resume(line: first, col: one + 3)
    for k in open_end..opening.len()
        if opening[k] != ' '
            self.diag_msg(
                "lex.str.3",
                ast.Pos(line: first + 1, col: open_end + 1),
                "text after the opening `\"\"\"`",
                "start the string's text on the next line, or close it on this line",
            )
            break
    # Find the closing `"""`.
    mut li := first + 1
    mut close := -1
    while close < 0
        if li >= lines.len()
            self.diag_msg(
                "lex.str.3",
                pos,
                "unterminated multi-line string",
                "close it with `\"\"\"`",
            )
            self.push(Str(""), pos)
            return Resume(line: lines.len() - 1, col: lines[lines.len() - 1].len())
        close = find_triple(lines[li], 0, raw)
        if close < 0
            li += 1
    last := li
    closing := lines[last]
    alone := blank_spaces(closing, 0, close)
    # Only spaces indent a multi-line string's text (lex.str.3).
    for k in first + 1..last + 1
        whole := lines[k]
        upto := if k == last then close else whole.len()
        mut lead := 0
        while lead < upto and (whole[lead] == ' ' or whole[lead] == '\t')
            lead += 1
        if (k == last or not blank(whole, 0, upto)) and has_tab(whole, lead)
            self.diag_msg(
                "lex.str.3",
                ast.Pos(line: k + 1, col: 1),
                "tab in a multi-line string's indentation",
                "indent with spaces; write `\\t` for a tab in the text",
            )
    # The common indentation of the text lines (and of the closing line when
    # it holds only the delimiter) is removed.
    mut common := if alone then close else spaces(closing, close)
    for k in first + 1..last
        if not blank(lines[k], 0, lines[k].len())
            common = common.min(spaces(lines[k], lines[k].len()))
    mut value := List[char]()
    mut parts := List[Part]()
    mut text_lines := [
        Lead(line: k, chars: common.min(lines[k].len()), width: lines[k].len())
        for k in first + 1..last
    ]
    if not alone
        text_lines.push(Lead(line: last, chars: common.min(close), width: close))
    n := text_lines.len()
    for j in 0..n
        t := text_lines[j]
        line := lines[t.line]
        if blank(line, t.chars, t.width) and t.line != last
            # A line of only whitespace is an empty line of text.
            value.extend([])
        elif raw
            value.extend(line[t.chars..t.width])
        else
            _ := self.content(line, t.chars, t.width, t.line + 1, false, mut value, mut parts)
        # The text ends with its last line: a closing delimiter on a line of
        # its own adds no newline (lex.str.3).
        if j + 1 < n
            value.push('\n')
    self.push(string_token(value, parts), pos)
    Resume(line: last, col: close + 3)

## Whether `line[from..to]` is only spaces.
fn blank_spaces(line List[char], from int, to int) bool
    for k in from..to
        if line[k] != ' '
            return false
    true

## The number of spaces starting `line[..to]`.
fn spaces(line List[char], to int) int
    mut n := 0
    while n < to and line[n] == ' '
        n += 1
    n

fn has_tab(line List[char], to int) bool
    for k in 0..to
        if line[k] == '\t'
            return true
    false

## gram.foreign.1: `'a` after `<`, `&` or `<..., ` with no closing `'` is a Rust lifetime. AIL has none, so it is
## reported once per line, with one fix deleting every lifetime on the line (and `<'a>` whole), and lexed as if it
## was never written: `fn f<'a>(s &'a str)` gives one diagnostic, not three (checkbench, ADR 1111). Gives the index
## after it, or -1 when `line[start]` starts a character literal.
fn Lexer.lifetime(mut self, line List[char], start int, line_no int) int
    first := at(line, start + 1)
    if not first.is_alpha() and first != '_'
        return -1
    mut j := start + 1
    while j < line.len() and name_char(line[j])
        j += 1
    if at(line, j) == '\''
        return -1
    mut b := start - 1
    while b >= 0 and line[b] == ' '
        b -= 1
    before := if b >= 0 then line[b] else '\0'
    if before != '<'
        and before != '&'
        and not (before == ',' and text_of(line, 0, start).contains("<"))
        return -1
    mut from := start
    mut to := j
    while at(line, to) == ' '
        to += 1
    if at(line, to) == ','
        to += 1
        while at(line, to) == ' '
            to += 1
    elif at(line, to) == '>' and before == '<' and b == start - 1 and self.tokens.len() > 0
        opened := match self.tokens[self.tokens.len() - 1].tok
            Sym(s) => s == "<"
            _ => false
        if opened
            self.tokens.remove_at(self.tokens.len() - 1)
            from = start - 1
            to += 1
    name := text_of(line, start, j)
    edit := fix.delete(ast.Pos(line: line_no, col: from + 1), ast.Pos(line: line_no, col: to + 1))
    n := self.diags.len()
    if n > 0
        and self.diags[n - 1].rule == "gram.foreign.1"
        and self.diags[n - 1].pos.line == line_no
        and self.diags[n - 1].msg.starts_with("AIL has no lifetimes")
        mut edits := self.diags[n - 1].edits
        edits.push(edit)
        self.diags[n - 1].edits = edits
    else
        self.diag_fix(
            "gram.foreign.1",
            ast.Pos(line: line_no, col: start + 1),
            "AIL has no lifetimes: `{name}` and `<{name}>` are Rust's",
            "delete them: values are passed by value and a borrow never outlives its call (own.val.2), so there is nothing to name; a type parameter is `fn f[T](x T)`",
            "delete the lifetimes",
        )
        self.attach([edit])
    to

## `'a'` or `'\n'` (lex.str.4); gives the index after it.
fn Lexer.char_literal(mut self, line List[char], start int, line_no int) int
    pos := ast.Pos(line: line_no, col: start + 1)
    e := if start + 1 < line.len() and line[start + 1] == '\\'
        self.escape(line, start + 1, line_no)
    elif start + 1 < line.len() and line[start + 1] != '\''
        Escaped(ch: line[start + 1], next: start + 2)
    else
        Escaped(ch: none, next: start + 1)
    ch := e.ch
    next := e.next
    if next < line.len() and line[next] == '\'' and next > start + 1
        if c := ch
            self.push(Char(c), pos)
        else
            self.placeholder(pos)
        return next + 1
    if start + 2 < line.len() and line[start + 1] == '\'' and line[start + 2] == '\''
        self.diag_msg(
            "lex.str.4",
            pos,
            "a `'` in a character literal must be escaped",
            "write '\\''",
        )
        self.placeholder(pos)
        return start + 3
    mut end := line.len()
    for k in start + 1..line.len()
        if line[k] == '\''
            end = k + 1
            break
    body := line[(start + 1).min(end)..(end - 1).max(start + 1).min(end)]
    closed := end <= line.len() and line[end - 1] == '\'' and end > start + 1
    stringy := closed and not has_special(body)
    self.diag_help_fix(
        "lex.str.4",
        pos,
        "a character literal holds exactly one character",
        "write a string in double quotes: \"...\"",
        stringy,
        "write it as a string",
    )
    if stringy
        self.attach([fix.span(pos, ast.Pos(line: line_no, col: start + 2), "\""), fix.span(
            ast.Pos(line: line_no, col: end),
            ast.Pos(line: line_no, col: end + 1),
            "\"",
        )])
    self.placeholder(pos)
    end

## Tokens of the expression in `line[start..end]`, keeping real columns.
fn Lexer.sub_lex(mut self, line List[char], start int, end int, line_no int) List[Token]
    # Lex onto the end of `tokens` and cut the new tail off, rather than
    # swapping the whole list out (a copy of every token so far per interpolation).
    base := self.tokens.len()
    saved_open := self.open
    self.open = []
    self.in_interp += 1
    _ := self.lex_line(line[0..end], start, line_no)
    self.in_interp -= 1
    self.open = saved_open
    mut code := self.tokens[base..]
    while self.tokens.len() > base
        self.tokens.pop()
    code.push(Token(tok: Eof, pos: ast.Pos(line: line_no, col: end + 1)))
    code

## Escape sequence at `line[i] == '\\'` (lex.str.1): its character and the index after it.
fn Lexer.escape(mut self, line List[char], i int, line_no int) Escaped
    pos := ast.Pos(line: line_no, col: i + 1)
    if i + 1 < line.len()
        simple := match line[i + 1]
            'n' => '\n'
            't' => '\t'
            'r' => '\r'
            '0' => '\0'
            '\\' => '\\'
            '"' => '"'
            '\'' => '\''
            '{' => '{'
            _ => ' '
        if simple != ' '
            return Escaped(ch: simple, next: i + 2)
    if at(line, i + 1) == 'u' and at(line, i + 2) == '{' and i + 2 < line.len()
        for k in i + 3..line.len()
            if line[k] == '}'
                next := k + 1
                ch := hex_char(line, i + 3, k)
                if ch == none
                    self.diag_msg(
                        "lex.str.1",
                        pos,
                        "`\\u\{{text_of(line, i + 3, k)}}` is not a valid Unicode scalar value",
                        "",
                    )
                return Escaped(ch: ch, next: next)
    shown := if i + 1 < line.len() then text_of(line, i + 1, i + 2) else ""
    if shown == "}"
        self.diag_fix(
            "lex.str.1",
            pos,
            "unknown escape sequence `\\}`",
            "`}` needs no escape: write `}`; only `\\\{` is an escape, to keep `\{` from starting an interpolation",
            "remove the backslash",
        )
        self.attach([fix.delete(pos, ast.Pos(line: line_no, col: i + 2))])
        return Escaped(ch: '}', next: i + 2)
    help := "valid escapes: \\n \\t \\r \\0 \\\\ \\\" \\' \\\{ \\u\{hex}"
    if i + 1 < line.len() and not line[i + 1].is_alpha() and not line[i + 1].is_digit()
        # A punctuation character needs no escape: drop the backslash.
        self.diag_fix(
            "lex.str.1",
            pos,
            "unknown escape sequence `\\{shown}`",
            help,
            "remove the `\\`",
        )
        self.attach([fix.delete(pos, ast.Pos(line: line_no, col: i + 2))])
    else
        self.diag_msg("lex.str.1", pos, "unknown escape sequence `\\{shown}`", help)
    Escaped(ch: none, next: (i + 2).min(line.len()))

## The character whose hexadecimal code is `line[from..to]`, if it is one.
fn hex_char(line List[char], from int, to int) char?
    if from == to
        return none
    mut v := 0
    for k in from..to
        d := line[k].to_digit(16) else return none
        if v > 0x10FFFF
            return none
        v = v * 16 + d
    char.from_code(v)

## Integer or floating-point literal (lex.num.1-3).
fn Lexer.number(mut self, line List[char], start int, line_no int) int
    pos := ast.Pos(line: line_no, col: start + 1)
    # type.tuple.3: after a single `.`, digits are an element index, so
    # `t.0.1` is two accesses rather than `t` and the float `0.1`.
    if start > 0 and line[start - 1] == '.' and (start < 2 or line[start - 2] != '.')
        mut end := start
        while end < line.len() and line[end].is_digit()
            end += 1
        match parse_int(line[start..end], 10)
            IntOk(v) => self.push(Int(v), pos)
            TooBig | Overflow | Invalid =>
                self.diag_msg(
                    "lex.num.3",
                    pos,
                    "integer literal `{text_of(line, start, end)}` doesn't fit in `int` (64-bit signed)",
                    "",
                )
                self.placeholder(pos)
        return end
    fe := float_end(line, start)
    if fe >= 0
        text := [c for c in line[start..fe] if c != '_'].join("")
        v := text.to_float() else 1.0 / 0.0
        if v - v == 0.0
            self.push(Float(v), pos)
        else
            self.diag_msg(
                "lex.num.3",
                pos,
                "floating-point literal `{text_of(line, start, fe)}` doesn't fit in `float`",
                "",
            )
            self.placeholder(pos)
        return fe
    mut radix := 10
    mut digits_start := start
    if line[start] == '0'
        match at(line, start + 1)
            'x' => radix = 16
            'b' => radix = 2
            'o' => radix = 8
            _ => radix = 10
        if radix != 10
            digits_start = start + 2
    mut end := digits_start
    while end < line.len() and (ascii_alnum(line[end]) or line[end] == '_')
        end += 1
    digits := [c for c in line[digits_start..end] if c != '_']
    match parse_int(digits, radix)
        IntOk(v) => self.push(Int(v), pos)
        TooBig => self.push(IntMin, pos)
        Overflow =>
            self.diag_msg(
                "lex.num.3",
                pos,
                "integer literal `{text_of(line, start, end)}` doesn't fit in `int` (64-bit signed)",
                "",
            )
            self.placeholder(pos)
        Invalid =>
            self.diag_msg(
                "lex.num.1",
                pos,
                "invalid integer literal `{text_of(line, start, end)}`",
                "",
            )
            self.placeholder(pos)
    end

## How the digits of an integer literal read (lex.num.1, lex.num.3).
enum IntRead
    IntOk(v int)
    ## Exactly 2^63: the magnitude of the minimum `int`.
    TooBig
    Overflow
    Invalid

## Digits in `radix`, read left to right as the bootstrap does: the first
## digit that is invalid, or that overflows, decides.
fn parse_int(digits List[char], radix int) IntRead
    if digits.len() == 0
        return Invalid
    mut v := 0
    mut over := false
    # The value as a negative number, which reaches -2^63.
    mut neg := 0
    mut neg_over := false
    for c in digits
        d := c.to_digit(radix) else return if over then Overflow else Invalid
        if not over
            if w := v.checked_mul(radix)
                if x := w.checked_add(d)
                    v = x
                else
                    over = true
            else
                over = true
        if not neg_over
            if w := neg.checked_mul(radix)
                if x := w.checked_sub(d)
                    neg = x
                else
                    neg_over = true
            else
                neg_over = true
    if not over
        return IntOk(v)
    if not neg_over and neg == -9223372036854775807 - 1
        return TooBig
    Overflow

## The end of a decimal floating-point literal starting at `line[start]`,
## or -1 if it's an integer (lex.num.2): digits, then `.` and digits, an
## exponent, or both.
fn float_end(line List[char], start int) int
    if line[start] == '0'
        and (at(line, start + 1) == 'x' or at(line, start + 1) == 'b' or at(line, start + 1) == 'o')
        return -1
    mut end := digits_end(line, start)
    mut is_float := false
    if at(line, end) == '.' and at(line, end + 1).is_digit()
        end = digits_end(line, end + 1)
        is_float = true
    if at(line, end) == 'e' or at(line, end) == 'E'
        sign := if at(line, end + 1) == '+' or at(line, end + 1) == '-' then 1 else 0
        if at(line, end + 1 + sign).is_digit()
            end = digits_end(line, end + 1 + sign)
            is_float = true
    if is_float then end else -1

fn digits_end(line List[char], from int) int
    mut i := from
    while i < line.len() and (line[i].is_digit() or line[i] == '_')
        i += 1
    i

## The token for a string's text: plain, or with interpolated parts.
fn string_token(value List[char], parts List[Part]) Tok
    if parts.len() == 0
        return Str(value.join(""))
    mut all := parts
    if value.len() > 0
        all.push(Lit(value.join("")))
    Interp(all)

fn starts_triple(line List[char], i int) bool
    i + 2 < line.len() and line[i] == '"' and line[i + 1] == '"' and line[i + 2] == '"'

## Index of the closing `"""` of a multi-line string in `line[from..]`,
## skipping escapes and interpolations unless the string is raw; -1 if none.
fn find_triple(line List[char], from int, raw bool) int
    mut i := from
    while i < line.len()
        c := line[i]
        if c == '\\' and not raw
            i += 2
        elif c == '{' and not raw
            close := find_close(line, line.len(), i)
            i = if close < 0 then line.len() else close + 1
        elif c == '"' and starts_triple(line, i)
            # In a run of more than three quotes, the last three close it.
            mut end := i
            while at(line, end + 3) == '"'
                end += 1
            return end
        else
            i += 1
    -1

## The `:` that starts a format specification (lex.str.7) in the
## interpolation whose expression begins at `from`, within `line[..n]`: the
## first one outside brackets, strings and character literals; -1 if none.
fn spec_colon(line List[char], n int, from int) int
    mut depth := 0
    mut i := from
    while i < n
        c := line[i]
        if c == '(' or c == '[' or c == '{'
            depth += 1
        elif c == ')' or c == ']' or c == '}'
            depth -= 1
        elif c == '"'
            i = skip_string(line, n, i)
            if i < 0
                return -1
            continue
        elif c == '\'' and i + 1 < n and line[i + 1] == '\\'
            end := index_of(line, n, i + 3, '\'')
            if end >= 0
                i = end + 1
                continue
        elif c == '\'' and i + 2 < n and line[i + 2] == '\''
            i += 3
            continue
        elif c == ':' and depth == 0 and not (i + 1 < n and line[i + 1] == '=')
            return i
        i += 1
    -1

## The index of `c` in `line[from..n]`, or -1.
fn index_of(line List[char], n int, from int, c char) int
    for k in from..n
        if line[k] == c
            return k
    -1

## Index of the `}` matching the `{` at `line[open]`, within `line[..n]`,
## skipping nested strings; -1 if none.
fn find_close(line List[char], n int, open int) int
    mut depth := 0
    mut i := open
    while i < n
        c := line[i]
        if c == '{'
            depth += 1
        elif c == '}'
            depth -= 1
            if depth == 0
                return i
        elif c == '"'
            i = skip_string(line, n, i)
            if i < 0
                return -1
            continue
        elif c == '\'' and i + 1 < n and line[i + 1] == '\\'
            # A character literal such as '{' or '\'' (lex.str.4).
            end := index_of(line, n, i + 3, '\'')
            if end >= 0
                i = end + 1
                continue
        elif c == '\'' and i + 2 < n and line[i + 2] == '\''
            i += 3
            continue
        i += 1
    -1

## Index just after the string literal starting at `line[start] == '"'`,
## within `line[..n]`; -1 if it doesn't end.
fn skip_string(line List[char], n int, start int) int
    mut i := start + 1
    while i < n
        c := line[i]
        if c == '\\'
            i += 2
        elif c == '"'
            return i + 1
        elif c == '{'
            close := find_close(line, n, i)
            if close < 0
                return -1
            i = close + 1
        else
            i += 1
    -1

## A format specification, the text after the `:`, or `none` when it is
## invalid (lex.str.7).
fn parse_spec(c List[char]) FormatSpec?
    mut f := FormatSpec(
        fill: none,
        align: none,
        width: none,
        precision: none,
        hex: false,
        flags: "",
    )
    mut i := 0
    if c.len() >= 2 and is_align(c[1])
        f.fill = c[0]
        f.align = c[1]
        i = 2
    elif c.len() > 0 and is_align(c[0])
        f.align = c[0]
        i = 1
    if at(c, i) == '+' and i < c.len()
        f.flags = "{f.flags}+"
        i += 1
    if at(c, i) == '0' and at(c, i + 1).is_digit()
        if f.align != none
            return none
        f.flags = "{f.flags}0"
        i += 1
    start := i
    while i < c.len() and c[i].is_digit()
        i += 1
    if i > start
        f.width = spec_number(c, start, i)
        if f.width == none
            return none
    if at(c, i) == ',' and i < c.len()
        f.flags = "{f.flags},"
        i += 1
    if at(c, i) == '.' and i < c.len()
        i += 1
        from := i
        while i < c.len() and c[i].is_digit()
            i += 1
        if i == from
            return none
        f.precision = spec_number(c, from, i)
        if f.precision == none
            return none
    if at(c, i) == 'x' and i < c.len()
        f.hex = true
        i += 1
    elif (at(c, i) == 'b' or at(c, i) == 'e') and i < c.len()
        f.flags = "{f.flags}{c[i]}"
        i += 1
    if i < c.len()
        return none
    if spec_clash(f) != ""
        return none
    f

## Why the marks of `f` can't be combined, or "" when they can (lex.str.7).
fn spec_clash(f FormatSpec) str
    if (f.hex or f.flags.contains("b")) and f.precision != none
        return "`x` and `b` take no `.N`"
    if (f.hex or f.flags.contains("b") or f.flags.contains("e")) and f.flags.contains(",")
        return "`,` goes with a decimal number, not `x`, `b` or `e`"
    ""

fn is_align(c char) bool
    c == '<' or c == '>' or c == '^'

## The number in `c[from..to]`, if it is at most the largest width.
fn spec_number(c List[char], from int, to int) int?
    mut v := 0
    for k in from..to
        v = v * 10 + c[k].to_digit(10)?
        if v > MAX_FORMAT_WIDTH
            return none
    v

## Whether the invalid `bytes` escape at `line[i]` is `\u{...}` naming a code
## point, which has a fix: its UTF-8 bytes.
## The index of the `}` at or after `from`.
fn close_brace(line List[char], from int) int
    mut k := from
    while k < line.len() and line[k] != '}'
        k += 1
    k

## `c` as `\xHH` escapes of its UTF-8 bytes.
fn utf8_escapes(c char) str
    hex := "{c}".to_bytes().hex()
    mut out := ""
    mut k := 0
    while k < hex.len()
        out = "{out}\\x{hex.slice(k, k + 2)}"
        k += 2
    out

fn bytes_unicode(line List[char], i int) bool
    if at(line, i + 1) != 'u' or at(line, i + 2) != '{'
        return false
    for k in i + 3..line.len()
        if line[k] == '}'
            len := k - (i + 3)
            return len >= 1 and len <= 6 and hex_char(line, i + 3, k) != none
    false

## Why the format specification `c` is invalid (lex.str.7), as `FormatSpec::parse`
## words it in the Rust front end.
fn spec_why(c List[char]) str
    mut i := 0
    mut aligned := false
    if c.len() >= 2 and is_align(c[1])
        i = 2
        aligned = true
    elif c.len() > 0 and is_align(c[0])
        i = 1
        aligned = true
    if at(c, i) == '+' and i < c.len()
        i += 1
    if at(c, i) == '0' and at(c, i + 1).is_digit()
        if aligned
            return "`0` pads with zeros by itself; drop the alignment, or write the fill as `0>8`"
        i += 1
    start := i
    while i < c.len() and c[i].is_digit()
        i += 1
    if i - start > 19
        return "`{c[start..i].join("")}` is too large"
    mut width := 0
    if i > start
        width = spec_number(c, start, i) else MAX_FORMAT_WIDTH + 1
    if at(c, i) == ',' and i < c.len()
        i += 1
    mut precision := 0
    mut has_precision := false
    if at(c, i) == '.' and i < c.len()
        i += 1
        from := i
        while i < c.len() and c[i].is_digit()
            i += 1
        if i == from
            return "`.` needs the number of decimal places"
        if i - from > 19
            return "`{c[from..i].join("")}` is too large"
        has_precision = true
        precision = spec_number(c, from, i) else MAX_FORMAT_WIDTH + 1
    mut typed := ""
    if (at(c, i) == 'x' or at(c, i) == 'b' or at(c, i) == 'e') and i < c.len()
        typed = "{c[i]}"
        i += 1
    if i < c.len()
        return "unexpected `{c[i..].join("")}`"
    if width > MAX_FORMAT_WIDTH
        return "a width is at most {MAX_FORMAT_WIDTH}"
    if has_precision and precision > MAX_FORMAT_WIDTH
        return "decimal places are at most {MAX_FORMAT_WIDTH}"
    if typed == "x" or typed == "b"
        if has_precision
            return "`x` and `b` take no `.N`"
    "`,` goes with a decimal number, not `x`, `b` or `e`"

## Whether a character literal's text holds a `"`, `\` or `{`, which a string
## would need escaped (so no fix is offered).
fn has_special(body List[char]) bool
    for c in body
        if c == '"' or c == '\\' or c == '\{'
            return true
    false
