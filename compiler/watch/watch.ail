## The `ail run` attach shim (attach.run.1-3, ADR 0884): a program that runs
## a `std.app` app is built to serve the attach socket by rewriting its source
## text before it is lowered.

SERVE := "ail_serve"
GFX := "ail_gfx"

## A program that calls `host.run(` after `use std.gfx.host` gets `std.gfx.watch.run(`
## calls and an `impl attach.Observe` for each `impl gfx.Game for T` (attach.run.4,
## ADR 0979).
##
## `text` with `app.run(` and `app.run_with(` calls made `std.attach.serve.run(`
## and `std.attach.serve.run_with(` calls, and an
## `impl attach.Observe` added for each non-generic `impl app.App for T`, so
## the observed fields and the screen answer queries (attach.run.1). The two
## imports go on lines of their own at the top. A program that doesn't run an
## app comes back unchanged.
pub fn shim(text str) str
    calls := text.contains("app.run(") or text.contains("app.run_with(")
    apps := calls and text.contains("use std.app")
    # A game run with `host.run(` (attach.run.4).
    games := text.contains("host.run(") and text.contains("use std.gfx.host\n")
    if not (apps or games) or has_clash(text)
        return text
    # The generated `impl` names the module `attach`.
    mut out := List[str]()
    if apps
        out.push("use std.attach.serve as {SERVE}")
    if games
        out.push("use std.gfx.watch as {GFX}")
    if not text.contains("use std.attach\n")
        out.push("use std.attach")
    mut owners := List[str]()
    for line in text.lines()
        out.push(retarget(line, apps, games))
        mut rest := line.strip_prefix("impl app.App for ") else ""
        if games and rest == ""
            rest = line.strip_prefix("impl gfx.Game for ") else ""
        if rest != ""
            owner := rest.trim()
            if not owner.contains("[")
                and not text.contains("Observe for {owner}")
                and not owners.contains(owner)
                owners.push(owner)
    for o in owners
        out.push("impl attach.Observe for {o}")
    "{out.join("\n")}\n"

## A line with its `app.run(` and `app.run_with(` calls retargeted; comments stay as they are.
fn retarget(line str, apps bool, games bool) str
    if line.trim().starts_with("#")
        return line
    mut out := line
    if apps
        out = out.replace("app.run(", "{SERVE}.run(")
        out = out.replace("app.run_with(", "{SERVE}.run_with(")
    if games
        out = out.replace("host.run(", "{GFX}.run(")
    out

## Whether the program already uses the name `attach` or `ail_serve` for
## another module (Garlic's own `attach`): the generated `attach.Observed` and
## the shim's import would then mean something else, so the program is built as
## written (attach.run.2).
fn has_clash(text str) bool
    for line in text.lines()
        rest := line.strip_prefix("use ") else continue
        cut := rest.split(" as ")
        mut name := ""
        if cut.len() > 1
            name = cut[1].trim()
        else
            name = rest.trim().split(".").last() else ""
        if (name == "attach" and rest.trim() != "std.attach") or name == SERVE or name == GFX
            return true
    false
