## Edit impact (api.impact.1-5, ADR 0868 item 3): which declarations an edit
## changed, which functions and `@test` functions it can reach, and whose
## effects it changed. Reachability is the checker's own graph: a function is
## affected when it names a changed declaration (a call, a field, a type, a
## constant) or calls an affected function. It is conservative: it may name a
## test the edit can't change, never miss one.
use ast
use check
use load

## What an edit touches.
pub struct Impact
    ## Declarations whose text changed, or that are new.
    pub changed List[str]
    ## Functions that are, or reach, a changed declaration.
    pub affected List[str]
    ## The affected `@test` functions, in source order.
    pub tests List[str]
    ## Functions whose effects differ, with the effects before and after.
    pub effects List[EffectChange]
    ## Changed functions that no `@test` function reaches (ADR 1024), in source order.
    pub untested List[str]
    ## For each affected function, the declaration it names or calls on the way to
    ## a changed one (the next step of its path), in `affected` order.
    pub via List[(str, str)]
    ## For each affected test, the changed declarations it reaches.
    pub reaches List[(str, List[str])]
    ## The new version has check errors, so the impact is read from the graph as far as it resolves.
    pub partial bool

pub struct EffectChange
    pub id str
    pub old List[str]
    pub new List[str]

## One loaded and checked version of a program.
struct Snap
    prog ast.Program
    texts List[str]
    analysis check.Analysis
    api Api
    decls List[(ast.Pos, str)]

fn snapshot(loaded load.Loaded, analysis check.Analysis) Snap
    api := new_whole_api(loaded.program, Facts(
        effects: analysis.effects,
        errors: analysis.errors,
        symbols: analysis.symbols,
        weak_symbols: analysis.weak_symbols,
    ))
    mut decls := List[(ast.Pos, str)]()
    flatten_decls(api.items(), mut decls)
    Snap(prog: loaded.program, texts: loaded.texts, analysis: analysis, api: api, decls: decls)

fn indent_width(l str) int
    l.len() - l.trim_start().len()

fn skippable(l str) bool
    t := l.trim()
    t == "" or t.starts_with("#")

## `line` without its leading attributes: `@test fn f` is `fn f`, `@test` is empty.
fn without_attrs(line str) str
    mut rest := line.trim()
    while rest.starts_with("@")
        cut := rest.find(" ") else rest.len()
        rest = rest.slice(cut, rest.len()).trim_start()
    rest

## The declaration starting at `line` of `text`, as one string without blank
## and comment lines: its attributes and doc comments aren't part of it.
fn block_text(text str, line int) str
    lines := text.lines()
    mut i := line - 1
    if i < 0 or i >= lines.len()
        return ""
    while i < lines.len()
        and lines[i].trim_start().starts_with("@")
        and without_attrs(lines[i]) == ""
        i += 1
    if i >= lines.len()
        return ""
    base := indent_width(lines[i])
    # Attributes written on the declaration's line (`@test fn f`) aren't part of it either.
    head := "{lines[i].slice(0, base)}{without_attrs(lines[i])}"
    mut out := [head]
    for j in i + 1..lines.len()
        l := lines[j]
        if skippable(l)
            continue
        if indent_width(l) <= base
            break
        out.push(l.trim_end())
    out.join("\n")

fn is_top_decl(id str) bool
    id.starts_with("fn:")
        or id.starts_with("method:")
        or id.starts_with("type:")
        or id.starts_with("trait:")
        or id.starts_with("const:")

fn is_member(id str) bool
    id.starts_with("field:") or id.starts_with("variant:")

## The text of every function, type, trait and constant of a version, by id; with `members`, of every
## field and variant instead.
fn Snap.texts_by_id(self, members bool) Map[str, str]
    mut out := Map[str, str]()
    for d in self.decls
        if (if members then not is_member(d.1) else not is_top_decl(d.1)) or d.0.line >= 1073741824
            continue
        mut at := -1
        for i in 0..self.prog.files.len()
            if self.prog.files[i].base < d.0.line
                at = i
        if at < 0 or at >= self.texts.len()
            continue
        out[d.1] = block_text(self.texts[at], d.0.line - self.prog.files[at].base)
    out

## Every id a function names, by function id.
fn Snap.uses_of(self) Map[str, List[str]]
    found := collect_refs(self.prog, self.analysis.symbols, self.analysis.weak_symbols)
    mut out := Map[str, List[str]]()
    for r in found.refs
        if r.within < 0 or r.within >= self.api.fn_ids.len()
            continue
        f := self.api.fn_ids[r.within]
        mut list := out.get(f) else []
        list.push(r.id)
        out[f] = list
    out

fn Snap.is_test(self, i int) bool
    for a in self.prog.fns[i].attrs
        if a.name == "test"
            return true
    false

fn same_set(a List[str], b List[str]) bool
    a.sorted(by: |x| x) == b.sorted(by: |x| x)

## The ids that a change to `id` can reach beyond itself: a type's fields and
## variants, and the trait method an implementation fills in.
fn also_reaches(id str, known List[str]) List[str]
    mut out := List[str]()
    if id.starts_with("type:")
        owner := id.slice(5, id.len())
        for k in known
            if k.starts_with("field:{owner}.") or k.starts_with("variant:{owner}.")
                out.push(k)
    if id.starts_with("method:")
        parts := id.slice(7, id.len()).split(".")
        if parts.len() == 3
            out.push("method:{parts[1]}.{parts[2]}")
    out

## The ids a change to type `id` seeds (api.impact.6). When only existing fields or variants changed, just
## those: a function that reads another field is not affected. When one was added or removed, or the
## type's own line changed, the type and every member, as before.
fn id_and(id str, rest List[str]) List[str]
    mut out := [id]
    for x in rest
        out.push(x)
    out

fn type_seeds(
    id str,
    old_members Map[str, str],
    new_members Map[str, str],
    known List[str],
) List[str]
    owner := id.slice(5, id.len())
    mut touched := List[str]()
    mut shape := false
    for m in new_members.keys().sorted(by: |x| x)
        if not (m.starts_with("field:{owner}.") or m.starts_with("variant:{owner}."))
            continue
        if not old_members.contains(m)
            shape = true
        elif old_members.get(m) != new_members.get(m)
            touched.push(m)
    for m in old_members.keys()
        if (m.starts_with("field:{owner}.") or m.starts_with("variant:{owner}."))
            and not new_members.contains(m)
            shape = true
    if shape or touched.len() == 0
        return id_and(id, also_reaches(id, known))
    touched

## Whether a `@test` function (one of `tests`) is, or calls, `id` (ADR 1024, api.rev.11).
fn reaches_test(id str, users Map[str, List[str]], tests Set[str]) bool
    mut seen := Set[str]()
    mut queue := [id]
    mut at := 0
    while at < queue.len()
        cur := queue[at]
        at += 1
        if tests.contains(cur)
            return true
        for f in users.get(cur) else []
            if not seen.contains(f)
                seen.add(f)
                queue.push(f)
    false

## What changed between `old` and `new` can reach (api.impact.1-3).
pub fn impact_between(
    old load.Loaded,
    old_analysis check.Analysis,
    new load.Loaded,
    new_analysis check.Analysis,
) Impact
    before := snapshot(old, old_analysis)
    after := snapshot(new, new_analysis)
    old_text := before.texts_by_id(false)
    new_text := after.texts_by_id(false)
    old_members := before.texts_by_id(true)
    new_members := after.texts_by_id(true)
    mut changed := List[str]()
    for id in new_text.keys().sorted(by: |x| x)
        if old_text.get(id) != new_text.get(id)
            changed.push(id)
    uses := after.uses_of()
    mut users := Map[str, List[str]]()
    mut known := Set[str]()
    mut known_list := List[str]()
    for f in uses.keys()
        for u in uses[f]
            if not known.contains(u)
                known.add(u)
                known_list.push(u)
            mut list := users.get(u) else []
            if not list.contains(f)
                list.push(f)
            users[u] = list
    mut queue := List[str]()
    mut seeded := Set[str]()
    for id in changed
        for x in (if id.starts_with("type:") then type_seeds(id, old_members, new_members, known_list) else id_and(id, also_reaches(id, known_list)))
            if not seeded.contains(x)
                seeded.add(x)
                queue.push(x)
    mut affected := Set[str]()
    for id in changed
        if id.starts_with("fn:") or id.starts_with("method:")
            affected.add(id)
    # `next[f]`: the declaration `f` was reached from; `root[x]`: the first changed declaration that reached `x`.
    mut next := Map[str, str]()
    mut root := Map[str, str]()
    for id in changed
        root[id] = id
        for x in (if id.starts_with("type:") then type_seeds(id, old_members, new_members, known_list) else also_reaches(id, known_list))
            if not root.contains(x)
                root[x] = id
    mut at := 0
    while at < queue.len()
        id := queue[at]
        at += 1
        for f in users.get(id) else []
            if not affected.contains(f)
                affected.add(f)
                next[f] = id
                root[f] = root.get(id) else id
                queue.push(f)
    mut test_ids := Set[str]()
    for i in 0..after.api.fn_ids.len()
        if after.is_test(i)
            test_ids.add(after.api.fn_ids[i])
    # api.impact.4: every changed declaration each test reaches. A changed test reaches itself and
    # whatever else changed below it; the first-reached `root` alone would hide the rest.
    mut reached_by := Map[str, List[str]]()
    for c in changed
        mut seen := Set[str]()
        mut walk := List[str]()
        for x in (if c.starts_with("type:") then type_seeds(c, old_members, new_members, known_list) else id_and(c, also_reaches(c, known_list)))
            if not seen.contains(x)
                seen.add(x)
                walk.push(x)
        mut k := 0
        while k < walk.len()
            cur := walk[k]
            k += 1
            if test_ids.contains(cur)
                mut got := reached_by.get(cur) else []
                if not got.contains(c)
                    got.push(c)
                reached_by[cur] = got
            for f in users.get(cur) else []
                if not seen.contains(f)
                    seen.add(f)
                    walk.push(f)
    mut tests := List[str]()
    mut ordered := List[str]()
    mut via := List[(str, str)]()
    mut reaches := List[(str, List[str])]()
    for i in 0..after.api.fn_ids.len()
        id := after.api.fn_ids[i]
        if affected.contains(id) and after.prog.fns[i].pos.line < 1073741824
            ordered.push(id)
            if n := next.get(id)
                via.push((id, n))
            if after.is_test(i)
                tests.push(after.prog.fns[i].name)
                reaches.push((after.prog.fns[i].name, reached_by.get(id) else [root.get(id) else id]))
    mut effects := List[EffectChange]()
    mut old_fx := Map[str, List[str]]()
    for i in 0..before.api.fn_ids.len()
        if i < old_analysis.effects.len()
            old_fx[before.api.fn_ids[i]] = old_analysis.effects[i]
    for i in 0..after.api.fn_ids.len()
        id := after.api.fn_ids[i]
        now := if i < new_analysis.effects.len() then new_analysis.effects[i] else []
        if was := old_fx.get(id)
            if not same_set(was, now)
                effects.push(EffectChange(id: id, old: was, new: now))
        elif now.len() > 0 and after.prog.fns[i].pos.line < 1073741824
            effects.push(EffectChange(id: id, old: [], new: now))
    mut untested := List[str]()
    for i in 0..after.api.fn_ids.len()
        id := after.api.fn_ids[i]
        if not changed.contains(id) or id == "fn:main" or after.is_test(i)
            continue
        if after.prog.fns[i].pos.line >= 1073741824
            continue
        if not reaches_test(id, users, test_ids)
            untested.push(id)
    Impact(
        changed: changed,
        affected: ordered,
        tests: tests,
        untested: untested,
        effects: effects,
        via: via,
        reaches: reaches,
        partial: false,
    )

fn effect_list(xs List[str]) str
    if xs.len() == 0 then "(none)" else xs.join(", ")

## The impact as text lines (api.impact.4).
pub fn impact_text(i Impact) str
    mut out := List[str]()
    out.push("impact: {i.changed.len()} changed, {i.affected.len()} functions affected, {i.tests.len()} tests")
    if i.changed.len() > 0
        out.push("  changed: {i.changed.join(", ")}")
    if i.tests.len() > 0
        out.push("  tests: {i.tests.join(", ")}")
    for e in i.effects
        out.push("  effects: {e.id} {effect_list(e.old)} -> {effect_list(e.new)}")
    # Why each test is affected: its path to a changed declaration.
    mut next := Map[str, str]()
    for v in i.via
        next[v.0] = v.1
    for t in i.tests
        mut at := "fn:{t}"
        mut path := [at]
        while path.len() < 64
            n := next.get(at) else break
            at = n
            path.push(at)
        if path.len() > 1
            out.push("  via: {path.join(" > ")}")
    if i.partial
        out.push("  partial: the edited version has errors; callers shown are those that name a changed declaration")
    out.join("\n")

fn json_strs(xs List[str]) str
    "[{[quote(x) for x in xs].join(",")}]"

## The impact as a JSON object (api.impact.4).
pub fn impact_json(i Impact) str
    fx := [
        "\{\"id\":{quote(e.id)},\"old\":{json_strs(e.old)},\"new\":{json_strs(e.new)}}"
        for e in i.effects
    ]
    mut more := ""
    if i.via.len() > 0
        vs := ["{quote(v.0)}:{quote(v.1)}" for v in i.via]
        more = "{more},\"via\":\{{vs.join(",")}}"
    if i.reaches.len() > 0
        rs := ["{quote(r.0)}:{json_strs(r.1)}" for r in i.reaches]
        more = "{more},\"reaches\":\{{rs.join(",")}}"
    if i.partial
        more = "{more},\"partial\":true"
    "\{\"changed\":{json_strs(i.changed)},\"affected\":{json_strs(i.affected)},\"tests\":{json_strs(i.tests)},\"effects\":[{fx.join(",")}]{more}}"
