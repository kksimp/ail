## `ail ask std WORDS...`, `ail ask std --sig "(PARAMS) RET"` and `ail ask how WORDS...`
## (api.find.1-7, ADRs 1051 and 1083):
## ranked std functions, at most ten lines, with no grep. The index is the
## standard library's rules in `docs/spec/*.md`: a rule `**std.M.N**` whose
## text starts with a backticked signature `name(params) ret ! Err` is one
## function, and the rest of its paragraph is the doc the words are matched
## against. The spec is read from the repository, `AIL_ROOT` or the parent of
## `AIL_COMPILER`, as `ail explain` does.

FIND_USAGE := "usage: ail ask std WORDS...   e.g. ail ask std read a file by lines\n       ail ask std NAME...    e.g. ail ask std pad_left str.words is_alpha (each in full)\n       ail ask std --sig \"(str) List[str]\""

## Most lines `ail ask std` prints (api.find.1).
FIND_LIMIT := 10

## Words a query may have that say nothing.
FIND_FILLER := [
    "a",
    "an",
    "the",
    "of",
    "to",
    "by",
    "in",
    "from",
    "and",
    "or",
    "for",
    "with",
    "as",
    "is",
    "it",
    "how",
    "do",
    "i",
    "std",
]

## Words that name a type or a common noun: hitting a name with one of these
## never answers alone (api.find.2), so `sort list by key` is not answered by
## `fs.list_dir`.
FIND_GENERIC := [
    "list",
    "map",
    "set",
    "str",
    "string",
    "int",
    "float",
    "char",
    "bytes",
    "key",
    "value",
    "get",
    "file",
    "text",
    "data",
    "new",
    "make",
    "use",
]

struct StdFn
    ## `fs`, `time.date`, ...
    owner str
    ## `read_text(path str) str ! IoError`
    sig str
    rule str
    ## The function's name, lower case.
    name str
    ## The words of the rule's text, lower case.
    words List[str]
    ## A method's receiver type, the first parameter of its shape (api.find.3), else "".
    recv str
    ## One line on what it does (api.find.1), else "".
    desc str

fn find_root() str
    r := env.get("AIL_ROOT") else ""
    if r != ""
        return r
    c := env.get("AIL_COMPILER") else ""
    if c != ""
        d := path.dir(c)
        if d == ""
            return "."
        return d
    "."

fn find_is_ident(c char) bool
    k := c.code()
    (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57) or k == 95

## The lower-case words of `s`: runs of letters, digits and `_`.
fn find_words(s str) List[str]
    mut out := List[str]()
    mut cur := ""
    for c in s.to_lower().chars()
        if find_is_ident(c)
            cur = "{cur}{c}"
        else
            if cur != ""
                out.push(cur)
            cur = ""
    if cur != ""
        out.push(cur)
    out

## The first backticked text of a rule's paragraph when it is a signature
## (`name(...)` with a plain name), else "".
fn find_signature(text str) str
    a := text.find("`") else
        return ""
    rest := text.slice(a + 1, text.len())
    b := rest.find("`") else
        return ""
    code := rest.slice(0, b)
    p := code.find("(") else
        return ""
    if p == 0
        return ""
    for c in code.slice(0, p).chars()
        if not find_is_ident(c) and c != '.'
            return ""
    code

## The function name of a signature: after the last `.` of what precedes `(`.
fn find_name_of(sig str) str
    head := sig.slice(0, sig.find("(") else sig.len())
    mut name := head
    while true
        dot := name.find(".") else
            break
        name = name.slice(dot + 1, name.len())
    name.to_lower()

## The signatures a rule opens with: a run of backticked signatures joined by
## `, ` or ` and ` (`get(key) bytes?`, `has(key) bool`, ...). A rule that starts
## `use std.M` provides ... skips that lead-in (`std.yaml.1`).
fn find_provided(text str) List[str]
    mut out := List[str]()
    mut rest := text.trim()
    rest = (rest.strip_prefix("—") else rest).trim()
    if rest.starts_with("`use std.")
        tail := rest.slice(1, rest.len())
        close := tail.find("`") else
            return out
        rest = tail.slice(close + 1, tail.len()).trim()
        rest = rest.strip_prefix("provides ") else rest
    while rest.starts_with("`")
        after := rest.slice(1, rest.len())
        b := after.find("`") else
            break
        code := after.slice(0, b)
        if find_signature("`{code}`") == ""
            break
        out.push(code)
        rest = after.slice(b + 1, after.len())
        for sep in [", and ", ", ", " and "]
            if rest.starts_with(sep)
                rest = rest.slice(sep.len(), rest.len())
                break
    out

fn find_add(mut out List[StdFn], rule str, text str)
    mut sigs := find_provided(text)
    if sigs.is_empty()
        sig := find_signature(text)
        if sig == ""
            return
        sigs.push(sig)
    parts := rule.split(".")
    owner := parts[1..parts.len() - 1].join(".")
    for sig in sigs
        name := find_name_of(sig)
        out.push(StdFn(
            owner: owner,
            sig: sig,
            rule: rule,
            name: name,
            words: find_words(text),
            recv: "",
            desc: find_desc(text, name, true),
        ))

## The functions and methods a prelude family's rule opens with (api.find.10): `json.print.1` gives
## `Json.to_text() str`, found under the module name `json` and shown with no module, since the prelude needs no
## `use`. A method the rule writes on a value (`j.str(key)`) is shown on its type.
fn find_add_prelude(mut out List[StdFn], rule str, text str, owner str, ty str)
    mut sigs := find_provided(text)
    if sigs.is_empty()
        sig := find_signature(text)
        if sig == ""
            return
        sigs.push(sig)
    mut words := find_words(text)
    words.push(owner)
    for raw in sigs
        mut sig := raw
        if sig.starts_with("j.")
            sig = "{ty}.{sig.slice(2, sig.len())}"
        shaped := find_drop_self(sig)
        name := find_name_of(sig)
        out.push(StdFn(
            owner: owner,
            sig: shaped.0,
            rule: rule,
            name: name,
            words: words,
            recv: if sig.starts_with("{ty}.") then ty else "",
            desc: find_desc(text, name, true),
        ))

## Every std function: those the spec's `std.*` rules describe, then the `pub fn`s
## of the std modules written in AIL that no rule gave (api.find.2).
fn find_index_of(rules List[(str, str)]) List[StdFn]
    mut out := List[StdFn]()
    for r in rules
        if r.0.starts_with("std.")
            find_add(mut out, r.0, r.1)
        elif r.0.starts_with("json.")
            find_add_prelude(mut out, r.0, r.1, "json", "Json")
    find_source(mut out, rules)
    out

fn find_index() List[StdFn]
    find_index_of(find_rules())

## The rows of a table file under `docs/design`: the non-blank lines that do
## not start with `#`.
fn find_table(name str) List[str]
    text := fs.read_text(path.join(find_root(), "docs/design/{name}")) else
        return []
    mut out := List[str]()
    for line in text.lines()
        if line.trim() != "" and not line.starts_with("#")
            out.push(line)
    out

## The built-in methods (api.find.5): rows `SIGNATURE ; RULE ; WORDS` of
## `docs/design/builtin-methods.txt`, as `Type.name(params) Result`. A row with
## no `Type.` before its name (`zip(a, b) ...`) has no owner. The description
## is the sentence of its rule that names it.
fn find_methods(rules List[(str, str)]) List[StdFn]
    mut texts := Map[str, str]()
    for r in rules
        texts[r.0] = r.1
    mut out := List[StdFn]()
    for row in find_table("builtin-methods.txt")
        cells := row.split(" ; ")
        if cells.len() < 3
            continue
        head := cells[0].trim()
        dot := head.find(".") else -1
        paren := head.find("(") else head.len()
        mut owner := ""
        mut sig := head
        if dot >= 0 and dot < paren
            owner = head.slice(0, dot)
            sig = head.slice(dot + 1, head.len())
        mut name := ""
        for c in sig.chars()
            if not find_is_ident(c)
                break
            name = "{name}{c}"
        rule := cells[1].trim()
        out.push(StdFn(
            owner: owner,
            sig: sig,
            rule: rule,
            name: name.to_lower(),
            words: find_words(cells[2]),
            recv: owner.to_lower(),
            desc: find_desc(texts.get(rule) else "", name, false),
        ))
    out

## Does the doc hold `w`, or its plural or singular?
fn find_has_word(f StdFn, w str) bool
    if f.words.contains(w) or f.words.contains("{w}s")
        return true
    w.ends_with("s") and f.words.contains(w.slice(0, w.len() - 1))

## Does a piece of a name start with `w`?
fn find_piece_starts(pieces List[str], w str) bool
    for p in pieces
        if p.starts_with(w)
            return true
    false

## How well a function fits the words (api.find.2), as `(score, answers)`. A
## word that is the name, a `_` piece of it, or the start of one (`sort` for
## `sorted`) is worth 6, 5 or 4 and answers alone unless it is generic; a word
## the name contains is worth 3, the module 2 and the doc 1, and these answer
## only two words together. A single word that is the module answers alone.
fn find_score_words(f StdFn, query List[str])(int, bool)
    mut score := 0
    mut strong := false
    mut hit := 0
    pieces := f.name.split("_")
    for w in query
        mut got := false
        generic := FIND_GENERIC.contains(w)
        if f.name == w
            score += 6
            got = true
            strong = strong or not generic
        elif pieces.contains(w)
            score += 5
            got = true
            strong = strong or not generic
        elif w.len() >= 4 and find_piece_starts(pieces, w)
            score += 4
            got = true
            strong = strong or not generic
        elif w.len() >= 3 and f.name.contains(w)
            score += 3
            got = true
        if f.owner == w
            score += 2
            got = true
            if query.len() == 1
                strong = true
        if find_has_word(f, w)
            score += 1
            got = true
        if got
            hit += 1
    (score, strong or hit >= 2)

fn find_strip(s str) str
    s.replace(" ", "")

## The parameter types and the result type of a signature, spaces removed
## (api.find.3). `name(a str, b int) str ! E` and `(str, int) str` both work.
fn find_shape(sig str)(List[str], str)
    mut params := List[str]()
    start := sig.find("(") else
        return (params, "")
    mut depth := 0
    mut cur := ""
    mut close := sig.len()
    mut k := start + 1
    chars := sig.chars()
    while k < chars.len()
        c := chars[k]
        if c == '(' or c == '['
            depth += 1
        elif c == ']'
            depth -= 1
        if c == ')' and depth == 0
            close = k
            break
        if c == ')'
            depth -= 1
        if c == ',' and depth == 0
            params.push(find_param_type(cur))
            cur = ""
        else
            cur = "{cur}{c}"
        k += 1
    if cur.trim() != ""
        params.push(find_param_type(cur))
    mut tail := sig.slice(close + 1, sig.len()).trim()
    tail = tail.strip_prefix("->") else tail
    cut := tail.find("!") else tail.len()
    ret := find_strip(tail.slice(0, cut))
    (params, ret)

## `path str` is a `str`; `List[str]` and `fn(int) int` are themselves.
fn find_param_type(p str) str
    t := p.trim()
    sp := t.find(" ") else
        return find_strip(t)
    head := t.slice(0, sp)
    for c in head.chars()
        if not find_is_ident(c)
            return find_strip(t)
    find_strip(t.slice(sp + 1, t.len()))

## The shape of a function for `--sig`: a method takes its receiver as its first
## parameter, so `str.to_int() int?` is `(str) int?` and `BigInt.add(o BigInt)
## BigInt` is `(BigInt, BigInt) BigInt`.
fn find_fn_shape(f StdFn)(List[str], str)
    got := find_shape(f.sig.replace(" [mut self]", ""))
    if f.recv == ""
        return got
    mut params := [f.recv]
    params.extend(got.0)
    (params, got.1)

## How well a function's shape fits the asked one (api.find.3), as `(score,
## answers)`: equal parameter lists 6, else 1 per asked type the function takes;
## the result type 4. A function answers with equal parameter lists, or with the
## result type and at least one parameter type.
fn find_score_sig(f StdFn, want_params List[str], want_ret str)(int, bool)
    got := find_fn_shape(f)
    mut score := 0
    mut hits := 0
    mut same := false
    if got.0 == want_params
        score += 6
        same = true
    else
        for t in want_params
            if got.0.contains(t)
                score += 1
                hits += 1
    mut ret_ok := false
    if want_ret != "" and got.1 == want_ret
        score += 4
        ret_ok = true
    (score, (same and (want_ret == "" or ret_ok)) or (ret_ok and (same or hits > 0)))

## Does the query hold `w`, or its plural or singular?
fn find_query_has(query List[str], w str) bool
    if query.contains(w) or query.contains("{w}s")
        return true
    w.ends_with("s") and query.contains(w.slice(0, w.len() - 1))

## A line's text: the module and the signature, the module left out when the
## signature already starts with it (`net.open(...)`, not `net.net.open(...)`).
fn find_show(f StdFn) str
    # api.find.10: a prelude function is written with no module.
    if f.owner == "" or f.rule.starts_with("json.")
        return f.sig
    last := f.owner.split(".").last() else f.owner
    if f.sig.starts_with("{f.owner}.") or f.sig.starts_with("{last}.")
        return f.sig
    "{f.owner}.{f.sig}"

## The answer line of `docs/design/not-in-std.txt` for a query, else "" (api.find.5):
## the first row one of whose `|` alternatives has every word in the query.
fn find_hint(query List[str]) str
    for row in find_table("not-in-std.txt")
        cut := row.find(" -> ") else
            continue
        for alt in row.slice(0, cut).split("|")
            aw := find_words(alt)
            mut every := not aw.is_empty()
            for w in aw
                if not find_query_has(query, w)
                    every = false
            if every
                return row.slice(cut + 4, row.len()).trim()
    ""

## `ail ask std ...` (api.find.1-5).
pub fn find_command(args List[str]) int
    mut sig := false
    mut rest := List[str]()
    for a in args
        if a == "--sig"
            sig = true
        elif a.starts_with("--")
            io.eprint("error: unknown option `{a}`\n{FIND_USAGE}")
            return 2
        else
            rest.push(a)
    if rest.is_empty()
        io.eprint(FIND_USAGE)
        return 2
    rules := find_rules()
    mut index := find_index_of(rules)
    if index.is_empty()
        io.eprint("error: no std rules found under {path.join(find_root(), "docs/spec")} (api.find.4)")
        return 2
    index.extend(find_methods(rules))
    mut query := List[str]()
    for x in rest
        for w in find_words(x)
            if not FIND_FILLER.contains(w)
                query.push(w)
    # api.find.9: a query of names is answered in full, one function per name; a synonym row (api.find.8) is a phrase.
    if not sig and find_synonyms(query).is_empty()
        asked := find_asked(index, rest)
        if not asked.is_empty()
            return find_names_command(index, rules, asked, query)
    mut scores := List[int]()
    mut want_params := List[str]()
    mut want_ret := ""
    if sig
        shape := find_shape(rest.join(" "))
        want_params = shape.0
        want_ret = shape.1
    for f in index
        r := if sig then find_score_sig(f, want_params, want_ret) else find_score_words(f, query)
        if r.1
            scores.push(r.0)
        else
            scores.push(0)
    # api.find.8: the functions a synonym row names come first, in its order.
    if not sig
        targets := find_synonyms(query)
        for j in 0..targets.len()
            for i in 0..index.len()
                if find_is_target(index[i], targets[j])
                    scores[i] = scores[i] + 1000 - j
    mut used := List[int]()
    mut shown := 0
    while shown < FIND_LIMIT
        mut best := -1
        for i in 0..index.len()
            if scores[i] > 0 and not used.contains(i) and (best < 0 or scores[i] > scores[best])
                best = i
        if best < 0
            break
        used.push(best)
        find_print(index[best])
        shown += 1
    if shown == 0
        if sig
            print("nothing in std has the shape {rest.join(" ")}")
        else
            print("nothing in std matches {rest.join(" ")}")
            hint := find_hint(query)
            if hint != ""
                print(hint)
        return 1
    0

struct HowEntry
    title str
    ## The lower-case words of the title and its `Words:` line.
    words List[str]
    ## The title's own words.
    title_words List[str]
    ## The lines of the entry's text and code, as the file has them.
    body List[str]

## The entries of `docs/how-to.md`: each `##` section (api.find.6).
fn how_entries() List[HowEntry]
    text := fs.read_text(path.join(find_root(), "docs/how-to.md")) else
        return []
    mut out := List[HowEntry]()
    mut title := ""
    mut words := List[str]()
    mut tw := List[str]()
    mut body := List[str]()
    for line in text.lines()
        if line.starts_with("## ")
            if title != ""
                out.push(HowEntry(title: title, words: words, title_words: tw, body: body))
            title = line.slice(3, line.len()).trim()
            tw = find_words(title)
            words = find_words(title)
            body = []
        elif title != ""
            extra := line.strip_prefix("Words:") else
                body.push(line)
                continue
            words.extend(find_words(extra))
    if title != ""
        out.push(HowEntry(title: title, words: words, title_words: tw, body: body))
    out

## The text of an entry: its lines without blank edges and without the code fences.
fn how_text(e HowEntry) List[str]
    mut out := List[str]()
    for line in e.body
        if line.starts_with("```")
            continue
        if line.trim() == "" and (out.is_empty() or out[out.len() - 1] == "")
            continue
        out.push(line)
    while not out.is_empty() and out[out.len() - 1] == ""
        out.pop()
    out

## The entries that answer `query` (api.find.6), best first, at most three.
fn how_order(entries List[HowEntry], query List[str]) List[int]
    mut scores := List[int]()
    for e in entries
        mut score := 0
        mut hit := 0
        mut strong := false
        for w in query
            if e.title_words.contains(w) and not FIND_GENERIC.contains(w)
                score += 3
                hit += 1
                strong = true
            elif e.words.contains(w)
                or e.words.contains("{w}s")
                or (w.ends_with("s") and e.words.contains(w.slice(0, w.len() - 1)))
                score += 1
                hit += 1
        # api.find.6: a real match, not one stray word: a non-generic title word or two
        # words, and at least two thirds of the query's words.
        if (strong or hit >= 2) and hit * 3 >= query.len() * 2
            scores.push(score)
        else
            scores.push(0)
    mut order := List[int]()
    while order.len() < 3
        mut best := -1
        for i in 0..entries.len()
            if scores[i] > 0 and not order.contains(i) and (best < 0 or scores[i] > scores[best])
                best = i
        if best < 0
            break
        order.push(best)
    order

## Does `ail ask how WORDS` have an answer (api.ask.9)?
fn how_answers(args List[str]) bool
    mut query := List[str]()
    for x in args
        for w in find_words(x)
            if not FIND_FILLER.contains(w)
                query.push(w)
    not query.is_empty() and not how_order(how_entries(), query).is_empty()

## `ail ask WORDS...` with no program (api.ask.9): one name is `ail ask std NAME`; several words are the how-to
## that answers them, else `ail ask std WORDS`.
pub fn lookup_command(args List[str]) int
    mut nwords := 0
    for x in args
        if not x.starts_with("--")
            nwords += x.split(" ").len()
    if nwords > 1 and how_answers(args)
        return how_command(args)
    find_command(args)

## `ail ask how WORDS...` (api.find.6): the best-matching entry of `docs/how-to.md`
## with its checked code, then the titles of the next two. No words lists every title.
pub fn how_command(args List[str]) int
    entries := how_entries()
    if entries.is_empty()
        io.eprint("error: no how-to entries found under {path.join(find_root(), "docs/how-to.md")} (api.find.6)")
        return 2
    mut query := List[str]()
    for x in args
        for w in find_words(x)
            if not FIND_FILLER.contains(w)
                query.push(w)
    if query.is_empty()
        for e in entries
            print(e.title)
        return 0
    order := how_order(entries, query)
    if order.is_empty()
        print("no how-to matches {args.join(" ")}")
        print("titles: {[e.title for e in entries].join("; ")}")
        return 1
    best := entries[order[0]]
    print("{best.title}   (docs/how-to.md)")
    for line in how_text(best)
        print(line)
    if order.len() > 1
        print("also: {[entries[i].title for i in order[1..]].join("; ")}")
    0
