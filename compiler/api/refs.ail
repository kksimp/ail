## `ail api --symbols` (api.ref.1-2): every use of a declared name, as
## `77592931:bootstrap/src/api.rs` (`Refs`) finds them. What a value name, call, field
## or variant refers to comes from the checker's `symbols`; the type and
## trait names written in signatures, fields and bounds come from the
## declarations.
use ast

## One use: the id of the declaration and where the name is written.
pub struct Ref
    pub id str
    pub pos ast.Pos
    ## The index of the function whose body or signature has it, `-1` outside one.
    pub within int
    ## A field named by a label in a struct literal or variant (api.ask.2).
    pub label bool

struct Refs
    prog ast.Program
    symbols Map[int, str]
    weak Map[int, str]
    found List[Ref]
    ## Type parameter names in scope: they shadow no declaration.
    generics List[str]
    ## Value names that resolved to no declaration: locals, for `--refs`.
    names List[(ast.Pos, str)]
    ## The parameters of the function literals and the variables of the
    ## comprehensions being walked, innermost last (expr.bind.16).
    hiding List[(str, ast.Pos)]
    ## Each name bound by one of those: where it is used to where it is bound.
    literal_uses Map[int, int]
    ## Where each of those names is bound.
    literal_names Set[int]
    ## The function being walked (`Ref.within`).
    cur int

fn pk(p ast.Pos) int
    p.line * 65536 + p.col

## The id's owner path of the fields a struct literal or variant sets:
## `Point` for `type:Point`, `Shape.Rect` for `variant:Shape.Rect`.
fn fields_owner(id str) str?
    if id.starts_with("type:")
        return id.slice(5, id.len())
    if id.starts_with("variant:")
        return id.slice(8, id.len())
    none

## Every reference in `prog`, by position then id, without the prelude and
## the other files' (api.ref.1-2). `own_file` keeps only the first file's.
pub fn references(
    prog ast.Program,
    symbols Map[int, str],
    weak Map[int, str],
    own_file bool,
) List[Ref]
    mut r := Refs(
        prog: prog,
        symbols: symbols,
        weak: weak,
        found: [],
        generics: [],
        names: [],
        hiding: [],
        literal_uses: Map[int, int](),
        literal_names: Set[int](),
        cur: -1,
    )
    r.program()
    limit := if own_file then 1048576 else 1073741824
    kept := [x for x in r.found if x.pos.line <= limit]
    sorted := kept.sorted(by: |x| (x.pos.line, x.pos.col, x.id))
    mut out := List[Ref]()
    for x in sorted
        if out.len() > 0
            last := out[out.len() - 1]
            if last.pos == x.pos and last.id == x.id
                continue
        out.push(x)
    out

## Every reference of `prog` unsorted, without the prelude, and the value
## names that resolved to none (`--refs`, api.refs.1).
pub struct Found
    pub refs List[Ref]
    pub names List[(ast.Pos, str)]
    ## For a name in `names` that a function literal's parameter or a
    ## comprehension's variable binds (expr.bind.16): the key (`pos_key_of`)
    ## of the use to the key of the binding.
    pub literal_uses Map[int, int]
    ## The keys of those bindings.
    pub literal_names Set[int]

## The key `Found.literal_uses` and `Found.literal_names` hold for `p`.
pub fn pos_key_of(p ast.Pos) int
    pk(p)

pub fn collect_refs(prog ast.Program, symbols Map[int, str], weak Map[int, str]) Found
    mut r := Refs(
        prog: prog,
        symbols: symbols,
        weak: weak,
        found: [],
        generics: [],
        names: [],
        hiding: [],
        literal_uses: Map[int, int](),
        literal_names: Set[int](),
        cur: -1,
    )
    r.program()
    Found(
        refs: [x for x in r.found if x.pos.line < 1073741824],
        names: r.names,
        literal_uses: r.literal_uses,
        literal_names: r.literal_names,
    )

## `name`, bound at `at` by a function literal or a comprehension, is in scope.
fn Refs.hide(mut self, name str, at ast.Pos)
    self.hiding.push((name, at))
    self.literal_names.add(pk(at))

fn Refs.add(mut self, pos ast.Pos, id str)
    self.found.push(Ref(id: id, pos: pos, within: self.cur, label: false))

fn Refs.add_label(mut self, pos ast.Pos, id str)
    self.found.push(Ref(id: id, pos: pos, within: self.cur, label: true))

fn Refs.program(mut self)
    for s in self.prog.structs
        self.generics = [g.name for g in s.generics]
        self.generic_bounds(s.generics)
        for f in s.fields
            self.type_ref(f.ty)
        for c in s.invariants
            self.expr(c.cond)
    for e in self.prog.enums
        self.generics = [g.name for g in e.generics]
        self.generic_bounds(e.generics)
        for v in e.variants
            for f in v.fields
                self.type_ref(f.ty)
    self.generics = []
    for im in self.prog.impls
        self.add(im.trait_pos, "trait:{im.trait_name}")
        self.owner(im.target)
    for fi in 0..self.prog.fns.len()
        f := self.prog.fns[fi]
        self.cur = fi
        self.generics = []
        if i := impl_index(f.within)
            self.scope_owner(self.prog.impls[i].target)
        if o := f.owner
            if top_level(f)
                self.owner(o)
            else
                self.scope_owner(o)
        for g in f.generics
            self.generics.push(g.name)
        self.generic_bounds(f.generics)
        for p in f.params
            self.type_ref(p.ty)
        if t := f.ret
            self.type_ref(t)
        for c in f.contracts
            self.expr(c.cond)
            for o in c.olds
                self.expr(o.value)
        if body := f.body
            self.block(body)
    self.cur = -1
    for c in self.prog.consts
        self.expr(c.value)

@allow("expr.match.3") fn impl_index(w ast.Within) int?
    match w
        InImpl(i) => i
        _ => none

fn no_str() str?
    none

## A free function or a function declared as `fn Type.name` at the top.
@allow("expr.match.3") fn top_level(f ast.FnDecl) bool
    match f.within
        TopLevel => true
        _ => false

## The type parameters an owner brings into scope, from its declaration.
fn Refs.scope_owner(mut self, o ast.Owner)
    mut declared := List[ast.GenericParam]()
    mut found_decl := false
    for s in self.prog.structs
        if not found_decl and s.name == o.name
            declared = s.generics
            found_decl = true
    for e in self.prog.enums
        if not found_decl and e.name == o.name
            declared = e.generics
            found_decl = true
    for g in declared
        self.generics.push(g.name)
    if ps := o.params
        for g in ps
            self.generics.push(g.name)

## `Type` in `fn Type.name` or `impl Trait for Type`, with its bounds.
fn Refs.owner(mut self, o ast.Owner)
    if id := self.type_id(o.name)
        self.add(o.pos, id)
    self.scope_owner(o)
    if ps := o.params
        self.generic_bounds(ps)

fn Refs.generic_bounds(mut self, gs List[ast.GenericParam])
    for g in gs
        for b in g.bounds
            self.add(b.pos, "trait:{b.name}")

## The id of a declared type or trait called `name`, unless a type
## parameter in scope has that name.
fn Refs.type_id(self, name str) str?
    if self.generics.contains(name)
        return none
    for s in self.prog.structs
        if s.name == name
            return "type:{name}"
    for e in self.prog.enums
        if e.name == name
            return "type:{name}"
    for t in self.prog.traits
        if t.name == name
            return "trait:{name}"
    none

fn Refs.type_ref(mut self, t ast.TypeRef)
    match t.shape
        Named(name, args) =>
            if id := self.type_id(name)
                self.add(t.pos, id)
            for a in args
                self.type_ref(a)
        Optional(inner) => self.type_ref(inner)
        RefTo(inner) => self.type_ref(inner)
        PtrTo(inner) => self.type_ref(inner)
        TupleType(elems) =>
            for e in elems
                self.type_ref(e)
        FnType(params, ret) =>
            for p in params
                self.type_ref(p)
            if r := ret
                self.type_ref(r)
        AnyTrait(name) => self.add(t.pos, "trait:{name}")
        Fallible(ok, errors) =>
            if o := ok
                self.type_ref(o)
            if es := errors
                for e in es
                    self.type_ref(e)

fn Refs.block(mut self, b List[ast.Stmt])
    for s in b
        self.stmt(s)

@allow("expr.match.3") fn Refs.stmt(mut self, s ast.Stmt)
    match s
        Let(_, _, _, value, otherwise) =>
            self.expr(value)
            if o := otherwise
                self.else_part(o)
        LetTuple(_, value, _) => self.expr(value)
        LocalFn(d) =>
            for p in d.params
                self.type_ref(p.ty)
            if r := d.ret
                self.type_ref(r)
            if body := d.body
                self.block(body)
        Assign(target, _, value, _) =>
            self.expr(target)
            self.expr(value)
        While(cond, body, _) =>
            self.expr(cond)
            self.block(body)
        For(_, _, _, _, iter, body, _) =>
            self.expr(iter)
            self.block(body)
        With(mutex, _, _, body, _) =>
            self.expr(mutex)
            self.block(body)
        Unsafe(body, _) => self.block(body)
        Return(value, _) =>
            if v := value
                self.expr(v)
        Eval(value) => self.expr(value)
        Handle(value, otherwise) =>
            self.expr(value)
            self.else_part(otherwise)
        Defer(inner, _) => self.stmt(inner)
        Select(arms, _) =>
            for h in ast.select_heads(arms)
                self.expr(h)
            for body in ast.select_bodies(arms)
                self.block(body)
        _ => return

fn Refs.else_part(mut self, o ast.Else)
    match o
        Fallback(value) => self.expr(value)
        Leave(s) => self.stmt(s)
        Handler(_, body, _) => self.block(body)

## The id the checker recorded for the use at `pos`, if any.
fn Refs.resolved_at(self, pos ast.Pos) str?
    if id := self.symbols.get(pk(pos))
        return id
    self.weak.get(pk(pos))

## `Type` or `Trait` before `.name` in `Type.f(...)`, `Enum.Variant` or
## `Trait.f(x)`, when `.name` resolved through it.
@allow("expr.match.3") fn Refs.qualifier(mut self, recv ast.Expr, member str?)
    mut n := ""
    mut p := ast.Pos(line: 0, col: 0)
    match recv
        Name(name, pos) =>
            n = name
            p = pos
        TypeArgs(name, _, pos) =>
            n = name
            p = pos
        _ => return
    m := member else return
    parts := m.split(":")
    path := if parts.len() > 1 then parts[1..].join(":") else ""
    qowner := path.split(".")[0]
    if qowner == n
        if id := self.type_id(n)
            self.add(p, id)

fn Refs.args(mut self, args List[ast.Arg], fields_of str?)
    for a in args
        if l := a.label
            if owner := fields_of
                self.add_label(l.pos, "field:{owner}.{l.name}")
        self.expr(a.value)

@allow("expr.match.3") fn Refs.expr(mut self, e ast.Expr)
    match e
        Interp(parts, _) =>
            for p in parts
                match p
                    Hole(v) => self.expr(v)
                    Fmt(v, _) => self.expr(v)
                    Lit(_) => continue
        Name(n, p) =>
            if id := self.resolved_at(p)
                self.add(p, id)
            else
                self.names.push((p, n))
                for k in 0..self.hiding.len()
                    h := self.hiding[self.hiding.len() - 1 - k]
                    if h.0 == n
                        self.literal_uses[pk(p)] = pk(h.1)
                        break
        TypeArgs(_, targs, p) =>
            if id := self.resolved_at(p)
                self.add(p, id)
            for a in targs
                self.type_ref(a)
        ListLit(items, _) =>
            for x in items
                self.expr(x)
        SetLit(items, _) =>
            for x in items
                self.expr(x)
        TupleLit(items, _) =>
            for x in items
                self.expr(x)
        Comp(_, elem, value, clauses, _) =>
            depth := self.hiding.len()
            for c in clauses
                self.expr(c.iter)
                if c.unpack.len() == 0
                    self.hide(c.var, c.var_pos)
                for b in c.unpack
                    self.hide(b.name, b.pos)
                if cond := c.cond
                    self.expr(cond)
            self.expr(elem)
            if v := value
                self.expr(v)
            self.hiding = self.hiding[..depth]
        MapLit(entries, _) =>
            for ent in entries
                self.expr(ent.key)
                self.expr(ent.value)
        Call(callee, args, _) =>
            self.expr(callee)
            mut id := no_str()
            match callee
                Name(_, p) => id = self.resolved_at(p)
                TypeArgs(_, _, p) => id = self.resolved_at(p)
                _ => id = none
            mut owner := no_str()
            if i := id
                owner = fields_owner(i)
            self.args(args, owner)
        Method(recv, _, name_pos, args) =>
            id := self.resolved_at(name_pos)
            self.qualifier(recv, id)
            self.expr(recv)
            mut owner := no_str()
            if i := id
                owner = fields_owner(i)
                self.add(name_pos, i)
            self.args(args, owner)
        Member(recv, _, name_pos) =>
            id := self.resolved_at(name_pos)
            self.qualifier(recv, id)
            self.expr(recv)
            if i := id
                self.add(name_pos, i)
        Index(recv, index, _) =>
            self.expr(recv)
            self.expr(index)
        Unary(_, operand, _) => self.expr(operand)
        NewRef(value, _) => self.expr(value)
        Closure(params, body, _) =>
            depth := self.hiding.len()
            for p in params
                if t := p.ty
                    self.type_ref(t)
            for p in params
                self.hide(p.name, p.pos)
            self.expr(body)
            self.hiding = self.hiding[..depth]
        Binary(_, lhs, rhs, _) =>
            self.expr(lhs)
            self.expr(rhs)
        Range(lo, hi, _, _) =>
            if x := lo
                self.expr(x)
            if x := hi
                self.expr(x)
        If(branches, els, _, _) =>
            for b in branches
                match b.cond
                    Test(v) => self.expr(v)
                    Bind(_, _, v) => self.expr(v)
                self.block(b.body)
            if bs := els
                self.block(bs)
        Match(scrutinee, arms, _) =>
            self.expr(scrutinee)
            for arm in arms
                self.pattern(arm.pat)
                if g := arm.guard
                    self.expr(g)
                self.block(arm.body)
        Try(inner, context, _) =>
            self.expr(inner)
            if c := context
                self.expr(c)
        OrElse(value, otherwise, _) =>
            self.expr(value)
            self.else_part(otherwise)
        _ => return

@allow("expr.match.3") fn Refs.pattern(mut self, p ast.Pattern)
    match p
        Alt(alts, _) =>
            for x in alts
                self.pattern(x)
        TuplePat(elems, _) =>
            for x in elems
                self.pattern(x)
        Variant(qualifier, _, _, pos) =>
            if id := self.symbols.get(pk(pos))
                if q := qualifier
                    if tid := self.type_id(q)
                        self.add(pos, tid)
                self.add(pos, id)
        Nested(qualifier, _, fields, pos) =>
            if id := self.symbols.get(pk(pos))
                if q := qualifier
                    if tid := self.type_id(q)
                        self.add(pos, tid)
                self.add(pos, id)
            for x in fields
                self.pattern(x)
        StructPat(qualifier, _, _, sfields, pos) =>
            if id := self.symbols.get(pk(pos))
                if q := qualifier
                    if tid := self.type_id(q)
                        self.add(pos, tid)
                self.add(pos, id)
            for x in sfields
                self.pattern(x)
        _ => return
