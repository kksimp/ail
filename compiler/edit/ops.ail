## The edit operations (edit.op.1-7) and the compact input form (edit.in.3);
## the refactors (edit.op.8-10) are in refactor.ail.
## A port of the second half of `77592931:bootstrap/src/edit.rs`. An operation that
## fails leaves `Work.err` set; the caller stops at the first one.

## The working copy: each file's text, keyed by path (in path order).
pub struct Work
    pub root str
    pub package bool
    pub paths List[str]
    pub texts List[str]
    pub err str
    ## The directory of the standard modules, for the check a rename needs.
    pub std str

fn Work.index(self, file str) int
    for i in 0..self.paths.len()
        if self.paths[i] == file
            return i
    -1

pub fn Work.module(self, file str) str
    if self.package then module_of(self.root, file) else ""

## One declaration found by `find`: where, and which.
struct Hit
    file int
    decl Decl

fn Work.fail(mut self, msg str)
    if self.err == ""
        self.err = msg

## The file and declaration an id names (edit.id.1-2); `file` is -1 when none.
fn Work.find(mut self, id str) Hit
    mut hits := List[Hit]()
    for f in 0..self.paths.len()
        module := self.module(self.paths[f])
        for d in decls(self.texts[f])
            # edit.id.3: a bare name stands for `kind:name`.
            bare := not id.contains(":") and bare_name(d.id) == id
            qual := qualified(d.id, module)
            qbare := not id.contains(":") and bare_name(qual) == id
            if d.id == id or bare or (module != "" and (qual == id or qbare))
                hits.push(Hit(file: f, decl: d))
    if hits.len() == 1
        return hits[0]
    if hits.len() == 0
        self.fail("no declaration has the id `{id}` (edit.id.1)")
    else
        self.fail("`{id}` names {hits.len()} declarations; qualify it with its module, e.g. `fn:geo.origin` (edit.id.2)")
    Hit(file: -1, decl: Decl(id: "", name: "", start: 0, head: 0, sig_end: 0, end: 0))

fn bare_name(id str) str
    if c := id.find(":")
        return id.slice(c + 1, id.chars().len())
    ""

## The file an insert or import goes to (edit.op.3, edit.op.6); -1 on failure.
fn Work.target(mut self, op J) int
    if f := op.str_of("file")
        p := if self.package then "{self.root}/{f}" else f
        i := self.index(p)
        if i < 0
            self.fail("`{f}` is not a file of the program (edit.op.3)")
        return i
    if not self.package
        return 0
    # A package's root module: its first file at the top.
    for i in 0..self.paths.len()
        if parent_of(self.paths[i]) == self.root
            return i
    self.fail("say which file with \"file\" (edit.op.3)")
    -1

fn parent_of(path str) str
    parts := path.split("/")
    if parts.len() <= 1
        return ""
    parts[0..parts.len() - 1].join("/")

fn str_op(op J, key str) str
    op.str_of(key) else ""

## Apply a hunk (edit.op.7) to lines `from..to` of `src`: the `-` and context
## lines are found by their trimmed text, and `+` lines are indented like the
## first line found. One `-` and one `+` line that match no whole line
## replace a unique part of one. Gives the new text, or sets `err`.
pub struct Hunked
    pub text str
    pub err str

fn text_of(l str) str
    l.chars()[1..].join("")

pub fn hunk(src str, from int, to int, lines List[str]) Hunked
    file := src.split("\n")
    stop := if to < file.len() then to else file.len()
    scope := file[from..stop]
    mut minus := List[str]()
    mut plus := List[str]()
    mut old := List[str]()
    for l in lines
        if l.starts_with("-")
            minus.push(l)
        if l.starts_with("+")
            plus.push(l)
        else
            old.push(text_of(l).trim())
    if old.len() == 0
        return Hunked(text: "", err: "a hunk needs a `-` or context line to find its place")
    if minus.len() == 1 and plus.len() == 1 and lines.len() == 2
        mut whole := false
        for l in scope
            if l.trim() == old[0]
                whole = true
        if not whole
            part := text_of(minus[0]).trim()
            new := text_of(plus[0]).trim()
            pc := part.chars()
            mut hit_line := List[int]()
            mut hit_at := List[int]()
            for i in 0..scope.len()
                lc := scope[i].chars()
                # Non-overlapping matches, as `match_indices` finds them.
                mut at := 0
                while pc.len() > 0 and at + pc.len() <= lc.len()
                    if lc[at..at + pc.len()].join("") == part
                        hit_line.push(i)
                        hit_at.push(at)
                        at += pc.len()
                    else
                        at += 1
            if hit_line.len() == 1
                lc := scope[hit_line[0]].chars()
                changed := "{lc[0..hit_at[0]].join("")}{new}{lc[hit_at[0] + pc.len()..].join("")}"
                return Hunked(
                    text: splice(src, from + hit_line[0], from + hit_line[0] + 1, [changed]),
                    err: "",
                )
            if hit_line.len() == 0
                return Hunked(text: "", err: "`{part}` is not found")
            return Hunked(
                text: "",
                err: "`{part}` occurs {hit_line.len()} times; quote more of its line",
            )
    mut at := List[int]()
    if scope.len() >= old.len()
        for i in 0..scope.len() - old.len() + 1
            mut all := true
            for k in 0..old.len()
                if scope[i + k].trim() != old[k]
                    all = false
                    break
            if all
                at.push(i)
    if at.len() == 0
        return Hunked(text: "", err: "the lines `{old.join("` / `")}` are not found")
    if at.len() > 1
        return Hunked(
            text: "",
            err: "the `-` and context lines match {at.len()} places; add a context line",
        )
    i := at[0]
    mut first_old := ""
    for l in lines
        if not l.starts_with("+")
            first_old = text_of(l)
            break
    shift := indent_of(scope[i]) - indent_of(first_old)
    mut new := List[str]()
    mut k := i
    for l in lines
        t := text_of(l)
        if l.starts_with("+")
            if t.trim() == ""
                new.push("")
            else
                mut ind := indent_of(t) + shift
                if ind < 0
                    ind = 0
                new.push("{" ".repeat(ind)}{t.trim_start()}")
        elif l.starts_with("-")
            k += 1
        else
            new.push(scope[k])
            k += 1
    Hunked(text: splice(src, from + i, from + k, new), err: "")

## The compact form of the edits (edit.in.3): hunks under an id line, and
## `rename OLD NEW` lines. `err` is set when the input is malformed.
pub struct Compact
    pub ops List[J]
    pub err str

pub fn parse_compact(input str) Compact
    mut ops := List[J]()
    mut cur_id := ""
    mut has_id := false
    mut cur_lines := List[str]()
    mut open := false
    mut n := 0
    for line in input.lines()
        n += 1
        if line == ""
            continue
        c := line.chars()[0]
        if c == '-' or c == '+' or c == ' '
            open = true
            cur_lines.push(line)
            continue
        # Flush the hunk being built.
        if open
            if cur_lines.len() == 0
                return Compact(
                    ops: [],
                    err: "`{cur_id}` has no `-`, `+` or context lines (edit.in.3)",
                )
            ops.push(hunk_op(has_id, cur_id, cur_lines))
        open = false
        has_id = false
        cur_id = ""
        cur_lines = []
        words := line.words()
        if words.len() == 3 and words[0] == "rename"
            ops.push(J.Obj(["op", "id", "to"], [J.Str("rename"), J.Str(words[1]), J.Str(words[2])]))
        elif words.len() == 1
            cur_id = words[0]
            while cur_id.ends_with(":")
                cur_id = cur_id.slice(0, cur_id.chars().len() - 1)
            has_id = true
            open = true
        else
            return Compact(
                ops: [],
                err: "line {n}: expected an id, `rename OLD NEW`, or a line starting with `-`, `+` or a space (edit.in.3)",
            )
    if open
        if cur_lines.len() == 0
            return Compact(ops: [], err: "`{cur_id}` has no `-`, `+` or context lines (edit.in.3)")
        ops.push(hunk_op(has_id, cur_id, cur_lines))
    if ops.len() == 0
        return Compact(ops: [], err: "no edits (edit.in.3)")
    Compact(ops: ops, err: "")

fn hunk_op(has_id bool, id str, lines List[str]) J
    mut keys := ["op"]
    mut vals := [J.Str("hunk")]
    if has_id
        keys.push("id")
        vals.push(J.Str(id))
    keys.push("lines")
    vals.push(J.Arr([J.Str(l) for l in lines]))
    J.Obj(keys, vals)

fn starts_directive(s str) bool
    s == "requires" or s == "ensures"

fn first_word(l str) str
    t := l.trim_start()
    t.split(" ")[0]

## Apply one operation (edit.op.1-7); sets `work.err` on failure.
pub fn apply(mut work Work, op J, path str)
    kind := op.str_of("op") else
        work.fail("each edit needs an \"op\" (edit.in.1)")
        return
    if kind == "replace_body"
        id := need(mut work, op, kind, "id")
        body := need(mut work, op, kind, "body")
        if work.err != ""
            return
        h := work.find(id)
        if work.err != ""
            return
        src := work.texts[h.file]
        lines := src.split("\n")
        mut keep := h.decl.sig_end + 1
        mut new_has := false
        for l in body.lines()
            if starts_directive(first_word(l))
                new_has = true
        if not new_has
            while keep < h.decl.end and starts_directive(first_word(lines[keep]))
                keep += 1
        work.texts[h.file] = splice(src, keep, h.decl.end, reindent(body, 4))
    elif kind == "replace"
        id := need(mut work, op, kind, "id")
        text := need(mut work, op, kind, "text")
        if work.err != ""
            return
        h := work.find(id)
        if work.err != ""
            return
        work.texts[h.file] = splice(work.texts[h.file], h.decl.start, h.decl.end, reindent(text, 0))
    elif kind == "insert"
        text := reindent(need(mut work, op, kind, "text"), 0)
        if work.err != ""
            return
        mut f := -1
        mut at := 0
        mut pad_before := true
        if after := op.str_of("after")
            h := work.find(after)
            if work.err != ""
                return
            f = h.file
            at = h.decl.end
        elif before := op.str_of("before")
            h := work.find(before)
            if work.err != ""
                return
            f = h.file
            at = h.decl.start
            pad_before = false
        else
            f = work.target(op)
            if work.err != ""
                return
            mut t := work.texts[f]
            while t.ends_with("\n")
                t = t.slice(0, t.chars().len() - 1)
            at = t.split("\n").len()
        mut block := List[str]()
        if pad_before
            block.push("")
        block.extend(text)
        if not pad_before
            block.push("")
        work.texts[f] = splice(work.texts[f], at, at, block)
    elif kind == "delete"
        id := need(mut work, op, kind, "id")
        if work.err != ""
            return
        h := work.find(id)
        if work.err != ""
            return
        work.texts[h.file] = splice(work.texts[h.file], h.decl.start, h.decl.end, [])
    elif kind == "hunk"
        mut lines := List[str]()
        if lv := op.get("lines")
            match lv
                Arr(xs) =>
                    for x in xs
                        match x
                            Str(s) => lines.push(s)
                            _ => lines = lines
                _ => work.fail("`hunk` needs \"lines\" (edit.in.1)")
        else
            work.fail("`hunk` needs \"lines\" (edit.in.1)")
        if work.err != ""
            return
        mut f := -1
        mut from := 0
        mut to := 0
        mut place := ""
        if id := op.str_of("id")
            h := work.find(id)
            if work.err != ""
                return
            f = h.file
            from = h.decl.start
            to = h.decl.end
            place = "`{h.decl.id}`"
        else
            f = work.target(op)
            if work.err != ""
                return
            to = work.texts[f].split("\n").len()
            place = work.paths[f]
        r := hunk(work.texts[f], from, to, lines)
        if r.err != ""
            work.fail("{r.err} in {place} (edit.op.7)")
            return
        work.texts[f] = r.text
    elif kind == "rename"
        id := need(mut work, op, kind, "id")
        to := need(mut work, op, kind, "to")
        if work.err != ""
            return
        rename(mut work, id, to)
    elif kind == "import"
        module := need(mut work, op, kind, "module")
        if work.err != ""
            return
        f := work.target(op)
        if work.err != ""
            return
        work.texts[f] = with_use(work.texts[f], "use {module}")
    elif kind == "change_sig"
        change_sig(mut work, op)
    elif kind == "extract"
        extract(mut work, op)
    elif kind == "move"
        move_decl(mut work, op)
    else
        work.fail("unknown op `{kind}`; the ops are replace_body, replace, insert, delete, rename, import, change_sig, extract and move (edit.in.1)")

## `src` with the `use` line `line` after its last `use` line (or at the
## top), unless it is there (edit.op.6).
fn with_use(src str, line str) str
    lines := src.split("\n")
    for l in lines
        if l.trim_end() == line
            return src
    mut last_use := -1
    mut any_use := false
    for i in 0..lines.len()
        if lines[i].starts_with("use ")
            last_use = i
            any_use = true
    mut at := 0
    if any_use
        at = last_use + 1
    else
        mut first_code := 0
        for i in 0..lines.len()
            if not lines[i].starts_with("#")
                first_code = i
                break
        at = first_code
    mut block := [line]
    if not any_use and at < lines.len() and lines[at].trim() != ""
        block.push("")
    splice(src, at, at, block)

fn need(mut work Work, op J, kind str, key str) str
    v := op.str_of(key) else
        work.fail("`{kind}` needs \"{key}\" (edit.in.1)")
        return ""
    v

## Whether `s` is at character `i` of `cs`.
fn text_at(cs List[char], i int, s str) bool
    n := s.chars().len()
    i >= 0 and i + n <= cs.len() and cs[i..i + n].join("") == s

fn ident_char(c char) bool
    c.is_alpha() or c.is_digit() or c == '_'

fn is_ident(s str) bool
    cs := s.chars()
    if cs.len() == 0 or cs[0].is_digit()
        return false
    for c in cs
        if not (c.is_alpha() or c.is_digit() or c == '_')
            return false
    true

## The 1-based column of a declaration's name on its line, `0` when it isn't there.
fn name_column(head str, d Decl) int
    mut from := 0
    for k in ["fn ", "struct ", "enum ", "trait "]
        if i := head.find(k)
            from = i + k.chars().len()
            break
    rest := head.chars()[from..].join("")
    mut off := 0
    if d.id.starts_with("method:")
        dot := rest.find(".") else return 0
        off = dot + 1
    if text_at(head.chars(), from + off, d.name)
        return from + off + 1
    0

## Where `id` is declared: the file, 1-based line and column, and the name.
## Fields and variants are found inside their type (edit.op.5).
struct Spot
    file int
    line int
    col int
    name str

fn Work.declared_at(mut self, id str) Spot
    none_spot := Spot(file: -1, line: 0, col: 0, name: "")
    if id.starts_with("field:") or id.starts_with("variant:")
        c := id.find(":") else 0
        kind := id.slice(0, c)
        rest := id.slice(c + 1, id.chars().len())
        dot := rest.rfind(".") else
            self.fail("`{id}` names no member (edit.id.1)")
            return none_spot
        owner := rest.slice(0, dot)
        member := rest.slice(dot + 1, rest.chars().len())
        h := self.find("type:{owner}")
        if self.err != ""
            return none_spot
        lines := self.texts[h.file].split("\n")
        for i in h.decl.head + 1..h.decl.end
            if i >= lines.len()
                break
            t := lines[i].trim_start()
            mut head_word := ""
            for ch in t.chars()
                if ident_char(ch)
                    head_word = "{head_word}{ch}"
                else
                    break
            if head_word == member and lines[i].chars().len() - t.chars().len() == 4
                return Spot(file: h.file, line: i + 1, col: 5, name: member)
        self.fail("no {kind} `{member}` in `{owner}` (edit.id.1)")
        return none_spot
    h := self.find(id)
    if self.err != ""
        return none_spot
    head := self.texts[h.file].split("\n")[h.decl.head]
    col := name_column(head, h.decl)
    if col == 0
        self.fail("can't find `{h.decl.name}` on its declaration line (edit.op.5)")
        return none_spot
    Spot(file: h.file, line: h.decl.head + 1, col: col, name: h.decl.name)

## `{"op":"rename","id":ID,"to":NAME}` (edit.op.5): the declaration and every
## reference the checker reports, in every file of the program.
fn rename(mut work Work, id str, to str)
    if not is_ident(to)
        work.fail("`{to}` is not a name (edit.op.5)")
        return
    # edit.id.3: a bare name becomes the id it stands for.
    mut full := id
    if not id.contains(":")
        h := work.find(id)
        if work.err != ""
            return
        full = h.decl.id
    decl := work.declared_at(full)
    if work.err != ""
        return
    ck := checked(mut work, "rename", "edit.op.5") else return
    # References name a package's declarations with their module (api.pkg.1).
    want := want_id(work, full, decl.file)
    mut spots := [(p.file, p.line, p.col) for p in places(work, ck) if p.id == want]
    spots.push((decl.file, decl.line, decl.col))
    old := decl.name
    for f in 0..work.paths.len()
        mine := [(s.1, s.2) for s in spots if s.0 == f].sorted(by: |x| (x.0, x.1))
        if mine.len() == 0
            continue
        mut lines := work.texts[f].split("\n")
        mut last := (0, 0)
        for k in 0..mine.len()
            spot := mine[mine.len() - 1 - k]
            if spot == last
                continue
            last = spot
            if spot.0 < 1 or spot.0 > lines.len()
                continue
            cs := lines[spot.0 - 1].chars()
            mut i := spot.1 - 1
            # A qualified reference (`geo.origin`) points at its qualifier.
            while i >= 0 and i < cs.len() and not text_at(cs, i, old)
                mut wlen := 0
                while i + wlen < cs.len() and ident_char(cs[i + wlen])
                    wlen += 1
                if wlen == 0 or i + wlen >= cs.len() or cs[i + wlen] != '.'
                    break
                i += wlen + 1
            if not text_at(cs, i, old)
                work.fail("{work.paths[f]}:{spot.0}:{spot.1} doesn't hold `{old}`; nothing was renamed (edit.op.5)")
                return
            lines[spot.0 - 1] = "{cs[..i].join("")}{to}{cs[i + old.chars().len()..].join("")}"
        work.texts[f] = lines.join("\n")
