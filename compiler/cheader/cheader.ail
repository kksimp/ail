## `use c "header.h" as name` (spec ffi.decl.1, ADR 0926): the function prototypes of a C
## header as the source of an AIL module of `pub extern c fn` declarations. The header's own
## text only: no `#include`, no `#if`, no macros. What the FFI cannot carry (ffi.decl.3) is
## left out.

## Words that qualify a declaration and say nothing about its type.
QUALIFIERS := {
    "extern",
    "static",
    "inline",
    "__inline",
    "__inline__",
    "const",
    "__const",
    "volatile",
    "__volatile__",
    "restrict",
    "__restrict",
    "__restrict__",
    "__extension__",
    "register",
    "_Noreturn",
}

## Words followed by a parenthesised group that is no part of the type.
GROUPS := {"__attribute__", "__attribute", "__asm__", "__asm", "asm", "__declspec", "_Alignas"}

## The words of a C scalar type.
SCALARS := {
    "unsigned",
    "signed",
    "char",
    "short",
    "int",
    "long",
    "float",
    "double",
    "void",
    "_Bool",
}

## AIL's reserved words (the lexer's list): a function named so is left out.
RESERVED := {
    "and",
    "any",
    "as",
    "break",
    "continue",
    "defer",
    "elif",
    "else",
    "ensures",
    "enum",
    "error",
    "extern",
    "false",
    "fn",
    "for",
    "if",
    "impl",
    "in",
    "invariant",
    "match",
    "move",
    "mut",
    "none",
    "not",
    "or",
    "par",
    "pub",
    "ref",
    "requires",
    "return",
    "self",
    "spawn",
    "struct",
    "todo",
    "trait",
    "true",
    "unique",
    "unsafe",
    "use",
    "while",
    "with",
}

fn ident_start(c char) bool
    c.is_alpha() or c == '_'

fn ident_char(c char) bool
    c.is_alpha() or c.is_digit() or c == '_'

## The index just past the name of an object-like `#define NAME` that starts at `at` (a `#`),
## or 0 for any other directive (a function-like macro too).
fn define_name_end(cs List[char], at int) int
    n := cs.len()
    mut j := at + 1
    while j < n and (cs[j] == ' ' or cs[j] == '\t')
        j += 1
    word := ident_at(cs, j)
    if word != "define"
        return 0
    j += word.len()
    while j < n and (cs[j] == ' ' or cs[j] == '\t')
        j += 1
    name := ident_at(cs, j)
    if name.is_empty()
        return 0
    j += name.len()
    if j < n and cs[j] == '('
        return 0
    j

## The identifier that starts at `at` ("" for none).
fn ident_at(cs List[char], at int) str
    mut j := at
    mut word := ""
    while j < cs.len() and (ident_char(cs[j]) and (j > at or ident_start(cs[j])))
        word = "{word}{cs[j]}"
        j += 1
    word

## The macro name of the `#define` whose name ends just before `after`.
fn directive_word(cs List[char], after int) str
    mut j := after
    while j > 0 and ident_char(cs[j - 1])
        j -= 1
    ident_at(cs, j)

## The tokens of a `#define` body from `start` to the end of its line, pushed to `out`; a
## string or character literal is kept whole, with its quotes. Returns the index of the line end.
fn lex_define(cs List[char], start int, mut out List[str]) int
    n := cs.len()
    mut i := start
    while i < n
        c := cs[i]
        if c == '\n'
            return i
        elif c == '\\' and i + 1 < n and cs[i + 1] == '\n'
            i += 2
        elif c == '\\' and i + 2 < n and cs[i + 1] == '\r' and cs[i + 2] == '\n'
            i += 3
        elif c.is_space()
            i += 1
        elif c == '/' and i + 1 < n and cs[i + 1] == '*'
            i += 2
            while i + 1 < n and not (cs[i] == '*' and cs[i + 1] == '/')
                i += 1
            i += 2
        elif c == '/' and i + 1 < n and cs[i + 1] == '/'
            while i < n and cs[i] != '\n'
                i += 1
        elif c == '"' or c == '\''
            mut raw := "{c}"
            i += 1
            while i < n and cs[i] != c and cs[i] != '\n'
                if cs[i] == '\\' and i + 1 < n and cs[i + 1] != '\n'
                    raw = "{raw}{cs[i]}"
                    i += 1
                raw = "{raw}{cs[i]}"
                i += 1
            if i < n and cs[i] == c
                raw = "{raw}{c}"
                i += 1
            out.push(raw)
        elif c.is_digit()
            mut word := ""
            while i < n
                ch := cs[i]
                if ident_char(ch) or ch == '.'
                    word = "{word}{ch}"
                    i += 1
                elif (ch == '+' or ch == '-')
                    and (word.ends_with("e") or word.ends_with("E"))
                    and not (word.starts_with("0x") or word.starts_with("0X"))
                    word = "{word}{ch}"
                    i += 1
                else
                    break
            out.push(word)
        elif ident_start(c)
            word := ident_at(cs, i)
            out.push(word)
            i += word.len()
        else
            out.push("{c}")
            i += 1
    i

## The tokens of a header: identifiers, numbers and single symbols. Comments, preprocessor
## lines (with their continuations), string and character literals are dropped.
pub fn tokens(text str) List[str]
    cs := text.chars()
    n := cs.len()
    mut out := List[str]()
    mut i := 0
    mut fresh := true
    while i < n
        c := cs[i]
        if c == '\n'
            fresh = true
            i += 1
        elif c.is_space()
            i += 1
        elif c == '#' and fresh
            after := define_name_end(cs, i)
            if after > 0
                out.push("#define")
                out.push(directive_word(cs, after))
                i = lex_define(cs, after, mut out)
                out.push("#end")
            else
                while i < n and cs[i] != '\n'
                    if cs[i] == '\\' and i + 1 < n
                        i += 1
                    i += 1
        elif c == '/' and i + 1 < n and cs[i + 1] == '*'
            i += 2
            while i + 1 < n and not (cs[i] == '*' and cs[i + 1] == '/')
                i += 1
            i += 2
            fresh = false
        elif c == '/' and i + 1 < n and cs[i + 1] == '/'
            while i < n and cs[i] != '\n'
                i += 1
        elif c == '"' or c == '\''
            i += 1
            while i < n and cs[i] != c
                if cs[i] == '\\'
                    i += 1
                i += 1
            i += 1
            fresh = false
        elif ident_start(c) or c.is_digit()
            mut word := ""
            while i < n and (ident_char(cs[i]) or (c.is_digit() and cs[i] == '.'))
                word = "{word}{cs[i]}"
                i += 1
            out.push(word)
            fresh = false
        else
            out.push("{c}")
            i += 1
            fresh = false
    out

## The index just past the group that opens at `open` (a `(`, `[` or `\{`).
fn after_group(toks List[str], open int) int
    mut depth := 0
    mut i := open
    while i < toks.len()
        t := toks[i]
        if t == "(" or t == "[" or t == "\{"
            depth += 1
        elif t == ")" or t == "]" or t == "}"
            depth -= 1
            if depth == 0
                return i + 1
        i += 1
    toks.len()

## `toks` without qualifiers and without the groups that follow `__attribute__` and the like.
fn clean(toks List[str]) List[str]
    mut out := List[str]()
    mut i := 0
    while i < toks.len()
        t := toks[i]
        if GROUPS.contains(t) and i + 1 < toks.len() and toks[i + 1] == "("
            i = after_group(toks, i + 1)
        elif QUALIFIERS.contains(t)
            i += 1
        else
            out.push(t)
            i += 1
    out

## The AIL types of the standard typedefs a header names without defining.
fn base_aliases(windows bool) Map[str, str]
    mut m := Map[str, str]()
    for name in ["size_t", "uintptr_t", "uintmax_t", "uint64_t"]
        m[name] = "u64"
    for name in ["ssize_t", "ptrdiff_t", "intptr_t", "intmax_t", "int64_t", "time_t", "suseconds_t"]
        m[name] = "i64"
    m["int8_t"] = "i8"
    m["uint8_t"] = "u8"
    m["int16_t"] = "i16"
    m["uint16_t"] = "u16"
    m["int32_t"] = "i32"
    m["uint32_t"] = "u32"
    for name in ["pid_t", "wchar_t"]
        m[name] = "i32"
    for name in ["uid_t", "gid_t", "mode_t", "socklen_t", "useconds_t"]
        m[name] = "u32"
    m["bool"] = "bool"
    m["off_t"] = if windows then "i32" else "i64"
    m["clock_t"] = if windows then "i32" else "i64"
    if windows
        m["wchar_t"] = "u16"
    m

## A C type read as an AIL type: `text` is the AIL spelling, empty for plain `void`.
struct CType
    text str

fn stars_of(n int, base str) str
    mut out := base
    for _ in 0..n
        out = "*{out}"
    out

## The AIL type of a run of C scalar words (`unsigned long`, `char`, `long long`), `void` as "".
fn scalar_type(words List[str], stars int, windows bool) CType?
    mut unsigned := false
    mut longs := 0
    mut has_short := false
    mut has_char := false
    mut has_float := false
    mut has_double := false
    mut has_void := false
    mut has_bool := false
    for w in words
        if w == "unsigned"
            unsigned = true
        elif w == "long"
            longs += 1
        elif w == "short"
            has_short = true
        elif w == "char"
            has_char = true
        elif w == "float"
            has_float = true
        elif w == "double"
            has_double = true
        elif w == "void"
            has_void = true
        elif w == "_Bool"
            has_bool = true
    if has_void
        if stars == 0
            return CType(text: "")
        return CType(text: stars_of(stars, "u8"))
    mut name := "i32"
    if has_bool
        name = "bool"
    elif has_float
        name = "f32"
    elif has_double
        if longs > 0
            return none
        name = "float"
    elif has_char
        name = if unsigned or stars > 0 then "u8" else "i8"
    elif has_short
        name = if unsigned then "u16" else "i16"
    elif longs > 2
        return none
    elif longs == 2 or (longs == 1 and not windows)
        name = if unsigned then "u64" else "i64"
    elif longs == 1
        name = if unsigned then "u32" else "i32"
    elif unsigned
        name = "u32"
    CType(text: stars_of(stars, name))

## The type spelled by `toks` (no name among them), or none when the FFI cannot carry it.
fn parse_type(toks List[str], aliases Map[str, str], windows bool) CType?
    mut stars := 0
    mut base := List[str]()
    for t in toks
        if t == "*"
            stars += 1
        elif t.starts_with("__") and not aliases.contains(t)
            continue
        else
            base.push(t)
    if base.is_empty()
        return none
    if base[0] == "struct" or base[0] == "union"
        if base.len() != 2 or stars == 0
            return none
        return CType(text: stars_of(stars, "u8"))
    if base[0] == "enum"
        if base.len() != 2
            return none
        return CType(text: stars_of(stars, "i32"))
    if SCALARS.contains(base[0])
        for t in base
            if not SCALARS.contains(t)
                return none
        return scalar_type(base, stars, windows)
    if base.len() != 1
        return none
    if a := aliases.get(base[0])
        return CType(text: stars_of(stars, a))
    if stars == 0
        return none
    CType(text: stars_of(stars, "u8"))

## ---- Constants: object-like `#define` and enumerators (ffi.decl.4) ----

## No constant is larger than this, so that no sum or shift can overflow `int`.
LIMIT := 2305843009213693952

## The result of reading an expression: `pos` is the index of the next token.
struct Ev
    ok bool
    v int
    pos int

fn ev_fail() Ev
    Ev(ok: false, v: 0, pos: 0)

## The value of an integer literal such as `42`, `0x2A`, `052`, `0b101` or `42UL`.
fn number_value(word str) int?
    mut cs := word.chars()
    while cs.len() > 1
        and (cs[cs.len() - 1] == 'u' or cs[cs.len() - 1] == 'U' or cs[cs.len() - 1] == 'l' or cs[cs.len() - 1] == 'L')
        cs = cs[..(cs.len() - 1)]
    mut radix := 10
    mut k := 0
    if cs.len() > 2 and cs[0] == '0' and (cs[1] == 'x' or cs[1] == 'X')
        radix = 16
        k = 2
    elif cs.len() > 2 and cs[0] == '0' and (cs[1] == 'b' or cs[1] == 'B')
        radix = 2
        k = 2
    elif cs.len() > 1 and cs[0] == '0'
        radix = 8
        k = 1
    mut v := 0
    while k < cs.len()
        d := cs[k].to_digit(radix) else return none
        if v > 100000000000000000
            return none
        v = v * radix + d
        if v > LIMIT
            return none
        k += 1
    v

## The code of a character literal such as `'a'` or `'\n'`.
fn char_value(word str) int?
    cs := word.chars()
    if cs.len() == 3 and cs[1] != '\\' and cs[2] == '\''
        return cs[1].code()
    if cs.len() == 4 and cs[1] == '\\' and cs[3] == '\''
        e := cs[2]
        if e == 'n'
            return 10
        if e == 't'
            return 9
        if e == 'r'
            return 13
        if e == '0'
            return 0
        if e == '\\'
            return 92
        if e == '\''
            return 39
        if e == '"'
            return 34
    none

fn in_range(v int) bool
    v <= LIMIT and v >= 0 - LIMIT

## A unary expression: a literal, a known constant, a parenthesised expression, or `-`, `+`, `~` of one.
fn ev_unary(t List[str], pos int, ints Map[str, int]) Ev
    if pos >= t.len()
        return ev_fail()
    tok := t[pos]
    if tok == "-" or tok == "+" or tok == "~"
        r := ev_unary(t, pos + 1, ints)
        if not r.ok
            return r
        if tok == "-"
            return Ev(ok: true, v: 0 - r.v, pos: r.pos)
        if tok == "~"
            return Ev(ok: true, v: 0 - r.v - 1, pos: r.pos)
        return r
    if tok == "("
        r := ev_bin(t, pos + 1, 0, ints)
        if not r.ok or r.pos >= t.len() or t[r.pos] != ")"
            return ev_fail()
        return Ev(ok: true, v: r.v, pos: r.pos + 1)
    first := tok.char_at(0) else return ev_fail()
    if first.is_digit()
        v := number_value(tok) else return ev_fail()
        return Ev(ok: true, v: v, pos: pos + 1)
    if first == '\''
        v := char_value(tok) else return ev_fail()
        return Ev(ok: true, v: v, pos: pos + 1)
    if ident_start(first)
        v := ints.get(tok) else return ev_fail()
        return Ev(ok: true, v: v, pos: pos + 1)
    ev_fail()

## The binding power of the binary operator at `pos` and its width in tokens; power -1 for none.
fn ev_op(t List[str], pos int) Ev
    op := t[pos]
    nxt := if pos + 1 < t.len() then t[pos + 1] else ""
    if op == "*" or op == "/" or op == "%"
        return Ev(ok: true, v: 10, pos: 1)
    if op == "+" or op == "-"
        return Ev(ok: true, v: 9, pos: 1)
    if (op == "<" or op == ">") and nxt == op
        return Ev(ok: true, v: 8, pos: 2)
    if op == "&" and nxt != "&"
        return Ev(ok: true, v: 5, pos: 1)
    if op == "^"
        return Ev(ok: true, v: 4, pos: 1)
    if op == "|" and nxt != "|"
        return Ev(ok: true, v: 3, pos: 1)
    ev_fail()

## `a op b` for the operator `op`, or none when C would not give a plain `int`.
fn ev_apply(op str, a int, b int) int?
    if op == "+"
        return a + b
    if op == "-"
        return a - b
    if op == "*"
        if a > 2147483648 or a < -2147483648 or b > 2147483648 or b < -2147483648
            return none
        return a * b
    if op == "/" or op == "%"
        if a < 0 or b <= 0
            return none
        if op == "/"
            return a / b
        return a % b
    if op == "<"
        if b < 0 or b > 60 or a < 0
            return none
        mut v := a
        for _ in 0..b
            v = v * 2
            if v > LIMIT
                return none
        return v
    if op == ">"
        if b < 0 or b > 62 or a < 0
            return none
        return a.shr(b)
    if op == "&"
        return a.bit_and(b)
    if op == "|"
        return a.bit_or(b)
    if op == "^"
        return a.bit_xor(b)
    none

## A binary expression whose operators bind at least as tightly as `minp`.
fn ev_bin(t List[str], pos int, minp int, ints Map[str, int]) Ev
    first := ev_unary(t, pos, ints)
    if not first.ok
        return first
    mut cur := first
    while cur.pos < t.len()
        info := ev_op(t, cur.pos)
        if not info.ok or info.v < minp
            break
        rhs := ev_bin(t, cur.pos + info.pos, info.v + 1, ints)
        if not rhs.ok
            return ev_fail()
        v := ev_apply(t[cur.pos], cur.v, rhs.v) else return ev_fail()
        if not in_range(v)
            return ev_fail()
        cur = Ev(ok: true, v: v, pos: rhs.pos)
    cur

## The integer value of the whole token list `t`, or none.
fn eval_int(t List[str], ints Map[str, int]) int?
    if t.is_empty()
        return none
    r := ev_bin(t, 0, 0, ints)
    if r.ok and r.pos == t.len()
        return r.v
    none

## The body of a string literal token as an AIL string literal's contents, or none.
fn c_string(raw str) str?
    cs := raw.chars()
    if cs.len() < 2 or cs[0] != '"' or cs[cs.len() - 1] != '"'
        return none
    mut out := ""
    mut i := 1
    while i < cs.len() - 1
        c := cs[i]
        if c == '\\'
            i += 1
            if i >= cs.len() - 1
                return none
            e := cs[i]
            if e == 'n'
                out = "{out}\\n"
            elif e == 't'
                out = "{out}\\t"
            elif e == '\\'
                out = "{out}\\\\"
            elif e == '"'
                out = "{out}\\\""
            elif e == '\''
                out = "{out}'"
            else
                return none
        elif c == '{'
            out = "{out}\\\{"
        elif c == '"' or c.code() < 32
            return none
        else
            out = "{out}{c}"
        i += 1
    out

## `3.25` from `3.25`, `3.25f` or `3.25L`: a float literal the lexer reads back, or none.
fn float_text(word str) str?
    mut cs := word.chars()
    if cs.len() > 1
        and (cs[cs.len() - 1] == 'f' or cs[cs.len() - 1] == 'F' or cs[cs.len() - 1] == 'l' or cs[cs.len() - 1] == 'L')
        cs = cs[..(cs.len() - 1)]
    mut dots := 0
    mut before := 0
    mut after := 0
    for c in cs
        if c == '.'
            dots += 1
        elif c.is_digit()
            if dots == 0
                before += 1
            else
                after += 1
        else
            return none
    if dots != 1 or before == 0 or after == 0
        return none
    mut out := ""
    for c in cs
        out = "{out}{c}"
    out

## `body` without one pair of parentheses around the whole of a body that has no other.
fn unparen(body List[str]) List[str]
    if body.len() >= 3 and body[0] == "(" and body[body.len() - 1] == ")"
        inner := body[1..(body.len() - 1)]
        if not inner.contains("(") and not inner.contains(")")
            return inner
    body

## Whether `name` can be a module constant of the generated module.
fn const_name_ok(name str, seen Set[str]) bool
    first := name.char_at(0) else return false
    ident_start(first)
        and not RESERVED.contains(name)
        and not name.starts_with("__")
        and not seen.contains(name)

## Write `pub NAME := v` for an integer constant.
fn emit_int(name str, v int, mut ints Map[str, int], mut seen Set[str], mut lines List[str])
    if not const_name_ok(name, seen)
        return
    seen.add(name)
    ints[name] = v
    lines.push("pub {name} := {v}")

## One `#define NAME body`: an integer, float or string constant is kept, anything else is left out.
fn add_define(
    name str,
    body List[str],
    mut ints Map[str, int],
    mut seen Set[str],
    mut lines List[str],
)
    if body.is_empty() or not const_name_ok(name, seen)
        return
    b := unparen(body)
    if b.len() == 1 and b[0].starts_with("\"")
        text := c_string(b[0]) else return
        seen.add(name)
        lines.push("pub {name} := \"{text}\"")
        return
    mut sign := ""
    mut digits := b
    if b.len() == 2 and b[0] == "-"
        sign = "-"
        digits = b[1..]
    if digits.len() == 1
        first := digits[0].char_at(0) else return
        if first.is_digit() and digits[0].contains(".")
            text := float_text(digits[0]) else return
            seen.add(name)
            lines.push("pub {name} := {sign}{text}")
            return
    v := eval_int(body, ints) else return
    emit_int(name, v, mut ints, mut seen, mut lines)

## The enumerators of an `enum` whose body (between the braces) is `body`, each as a constant.
fn add_enum(body List[str], mut ints Map[str, int], mut seen Set[str], mut lines List[str])
    mut next := 0
    mut known := true
    for part in split_params(body)
        p := clean(part)
        if p.is_empty()
            continue
        name := p[0]
        if p.len() > 1
            if p[1] == "="
                if v := eval_int(p[2..], ints)
                    next = v
                    known = true
                else
                    known = false
            else
                known = false
        if known
            emit_int(name, next, mut ints, mut seen, mut lines)
            next += 1

## One function: the C name and its `pub extern c fn` line.
struct CFn
    name str
    line str

## The split of `toks` at the commas outside any group.
fn split_params(toks List[str]) List[List[str]]
    mut out := List[List[str]]()
    mut cur := List[str]()
    mut depth := 0
    for t in toks
        if t == "(" or t == "["
            depth += 1
        elif t == ")" or t == "]"
            depth -= 1
        if t == "," and depth == 0
            out.push(cur)
            cur = List[str]()
        else
            cur.push(t)
    out.push(cur)
    out

## The declarator name of a function-pointer declaration `R (*name)(params)` (the name may be
## absent, giving ""), or none when `toks` is not one (ffi.decl.5).
fn fn_pointer_name(toks List[str]) str?
    d := clean(toks)
    p := d.index_of("(") else return none
    if p + 2 >= d.len() or d[p + 1] != "*"
        return none
    close := after_group(d, p) - 1
    if close >= d.len() or d[close] != ")" or close + 1 >= d.len() or d[close + 1] != "("
        return none
    inner := d[(p + 2)..close]
    if inner.is_empty()
        return ""
    if inner.len() == 1
        first := inner[0].char_at(0) else return none
        if ident_start(first)
            return inner[0]
    none

## The type of one parameter, with or without a name after it; none for `void`.
fn param_type(toks List[str], aliases Map[str, str], windows bool) CType?
    if fn_pointer_name(toks) != none
        return CType(text: "*u8")
    if toks.contains("(")
        return none
    mut ts := toks
    mut extra := 0
    if ts.len() > 0 and ts[ts.len() - 1] == "]"
        mut k := ts.len() - 1
        while k > 0 and ts[k] != "["
            k -= 1
        ts = ts[..k]
        extra = 1
    mut found := parse_type(ts, aliases, windows)
    if found == none and ts.len() > 1
        found = parse_type(ts[..(ts.len() - 1)], aliases, windows)
    t := found else return none
    if t.text == ""
        return none
    CType(text: stars_of(extra, t.text))

## The function a declaration's tokens declare, if the FFI can carry it.
fn prototype(decl List[str], aliases Map[str, str], windows bool) CFn?
    d := clean(decl)
    p := d.index_of("(") else return none
    if p < 2
        return none
    name := d[p - 1]
    if RESERVED.contains(name) or name.starts_with("__")
        return none
    first := name.char_at(0) else return none
    if not ident_start(first)
        return none
    close := after_group(d, p) - 1
    if close <= p or d[close] != ")"
        return none
    ret := parse_type(d[..(p - 1)], aliases, windows) else return none
    inner := d[(p + 1)..close]
    mut params := List[str]()
    mut ints := 0
    mut floats := 0
    if not (inner.is_empty() or (inner.len() == 1 and inner[0] == "void"))
        for part in split_params(inner)
            if part.contains(".")
                return none
            t := param_type(part, aliases, windows) else return none
            if t.text == "f32" or t.text == "float"
                floats += 1
            else
                ints += 1
            params.push("a{params.len()} {t.text}")
    if ints > 6 or floats > 8
        return none
    tail := if ret.text == "" then "" else " {ret.text}"
    CFn(name: name, line: "pub extern c fn {name}({params.join(", ")}){tail}")

## Record `typedef T name;` when `T` is a type the FFI carries.
fn add_typedef(decl List[str], mut aliases Map[str, str], windows bool)
    d := clean(decl[1..])
    if name := fn_pointer_name(d)
        if name != ""
            aliases[name] = "*u8"
        return
    if d.len() < 2 or d.contains("(")
        return
    name := d[d.len() - 1]
    first := name.char_at(0) else return
    if not ident_start(first)
        return
    if t := parse_type(d[..(d.len() - 1)], aliases, windows)
        if t.text != ""
            aliases[name] = t.text

## The AIL source of the module for header text `src`: one `pub extern c fn` per prototype
## the FFI can carry, in the header's order. `windows` is whether `long` has 32 bits.
pub fn module_text(src str, windows bool) str
    toks := tokens(src)
    n := toks.len()
    mut aliases := base_aliases(windows)
    mut ints := Map[str, int]()
    mut seen := Set[str]()
    mut lines := List[str]()
    mut i := 0
    while i < n
        mut decl := List[str]()
        mut depth := 0
        while i < n
            t := toks[i]
            if t == "#define"
                end := directive_end(toks, i)
                add_define(toks[i + 1], toks[(i + 2)..end], mut ints, mut seen, mut lines)
                i = end + 1
                continue
            if depth == 0 and t == "}"
                i += 1
                break
            if t == "(" or t == "["
                depth += 1
            elif t == ")" or t == "]"
                depth -= 1
            if depth == 0 and t == ";"
                i += 1
                break
            if depth == 0 and t == "\{"
                if decl.len() == 1 and decl[0] == "extern"
                    # `extern "C" \{`: look through it.
                    i += 1
                    decl = List[str]()
                    continue
                close := after_group(toks, i)
                if is_enum_head(decl)
                    add_enum(toks[(i + 1)..(close - 1)], mut ints, mut seen, mut lines)
                    # The declarators after the body: `typedef enum \{ A } name;` names a type.
                    mut tail := List[str]()
                    i = close
                    while i < n and toks[i] != ";" and toks[i] != "\{" and toks[i] != "}"
                        if toks[i] == "#define"
                            i = directive_end(toks, i) + 1
                        else
                            tail.push(toks[i])
                            i += 1
                    if i < n and toks[i] == ";"
                        i += 1
                    if decl[0] == "typedef" and not tail.is_empty()
                        aliases[tail[tail.len() - 1]] = "i32"
                else
                    i = close
                break
            decl.push(t)
            i += 1
        if decl.is_empty()
            continue
        if decl[0] == "typedef"
            add_typedef(decl, mut aliases, windows)
        else
            if f := prototype(decl, aliases, windows)
                if not seen.contains(f.name)
                    seen.add(f.name)
                    lines.push(f.line)
    if lines.is_empty()
        return ""
    "{lines.join("\n")}\n"

## The index of the `#end` that closes the `#define` at `at`.
fn directive_end(toks List[str], at int) int
    mut j := at
    while j < toks.len() and toks[j] != "#end"
        j += 1
    j

## Whether `decl` (the tokens before a `\{`) is `enum`, `enum Name`, `typedef enum` or `typedef enum Name`.
fn is_enum_head(decl List[str]) bool
    d := clean(decl)
    if d.is_empty()
        return false
    if d[0] == "enum"
        return d.len() <= 2
    d[0] == "typedef" and d.len() >= 2 and d.len() <= 3 and d[1] == "enum"

## ---- The module a `use c "header.h" as name` stands for ----

## Every module of a header is named `__c_` and the header's spelling, each character that is
## not a letter or digit as `_` and two hex digits (`_u` and the code for a wide one), so the
## name holds no dot, is not a name a program writes, and the header can be read back from it.
pub fn module_name(header str) str
    mut out := "__c_"
    for c in header.chars()
        code := c.code()
        hex := "{code:x}"
        if code < 128 and (c.is_alpha() or c.is_digit())
            out = "{out}{c}"
        elif code < 256
            pair := hex.pad_left(2, '0')
            out = "{out}_{pair}"
        else
            out = "{out}_u{hex}_"
    out

## The character with code `code`, as text ("" for none).
fn code_char(code int) str
    c := char.from_code(code) else return ""
    "{c}"

fn hex_digit(cs List[char], i int) int
    if i >= cs.len()
        return 0
    cs[i].to_digit(16) else 0

## Whether the import path `parts` is the one `module_name` makes.
pub fn is_use(parts List[str]) bool
    parts.len() == 1 and parts[0].starts_with("__c_")

## The header a module name stands for.
pub fn header_of(name str) str
    cs := name.slice(4, name.len()).chars()
    mut out := ""
    mut i := 0
    while i < cs.len()
        if cs[i] != '_'
            out = "{out}{cs[i]}"
            i += 1
        elif i + 1 < cs.len() and cs[i + 1] == 'u'
            mut code := 0
            i += 2
            while i < cs.len() and cs[i] != '_'
                code = code * 16 + hex_digit(cs, i)
                i += 1
            out = "{out}{code_char(code)}"
            i += 1
        else
            code := hex_digit(cs, i + 1) * 16 + hex_digit(cs, i + 2)
            out = "{out}{code_char(code)}"
            i += 3
    out

## The directory part of a file path ("." for none).
pub fn dir_of(file str) str
    cut := file.split("/")
    if cut.len() > 1
        return cut[..(cut.len() - 1)].join("/")
    "."

## Where the system keeps C headers.
SYSTEM_DIRS := [
    "/usr/include",
    "/usr/local/include",
    "/usr/include/x86_64-linux-gnu",
    "/usr/include/aarch64-linux-gnu",
    "/opt/homebrew/include",
    "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include",
]

## The file of `header`: beside the importing file in `dir`, else the system's (ADR 0926).
pub fn find(header str, dir str) str?
    if header.starts_with("/")
        return if fs.exists(header) then header else none
    for d in cat_dirs(dir)
        p := "{d}/{header}"
        if fs.exists(p)
            return p
    none

fn cat_dirs(dir str) List[str]
    mut all := [dir]
    all.extend(SYSTEM_DIRS)
    all

## The module text for `header`, or none when no file of that name is found.
pub fn module_for(header str, dir str) str?
    file := find(header, dir) else return none
    text := fs.read_text(file) else return none
    module_text(text, (env.get("OS") else "") == "Windows_NT")

@test fn reads_scalars_and_pointers()
    src := "int abs(int x);\nsize_t strlen(const char *s);\ndouble hypot(double, double);\nvoid free(void *p);\n"
    out := module_text(src, false)
    assert(out.contains("pub extern c fn abs(a0 i32) i32\n"))
    assert(out.contains("pub extern c fn strlen(a0 *u8) u64\n"))
    assert(out.contains("pub extern c fn hypot(a0 float, a1 float) float\n"))
    assert(out.contains("pub extern c fn free(a0 *u8)\n"))

@test fn skips_what_the_ffi_cannot_carry()
    src := "int printf(const char *fmt, ...);\nstruct P \{ int x; };\nstruct P make(void);\nint (*get(void))(int);\nlong double f(void);\nint ok(void);\n"
    out := module_text(src, false)
    assert_eq(out, "pub extern c fn ok() i32\n")

@test fn looks_through_guards_and_attributes()
    src := "#ifndef H\n#define H\n#ifdef __cplusplus\nextern \"C\" \{\n#endif\n/* a comment */\nextern int atoi (const char *__nptr) __attribute__ ((__nothrow__)) __wur;\n// done\n#ifdef __cplusplus\n}\n#endif\nunsigned long strtoul(const char *s, char **end, int base);\n#endif\n"
    out := module_text(src, false)
    assert(out.contains("pub extern c fn atoi(a0 *u8) i32\n"))
    assert(out.contains("pub extern c fn strtoul(a0 *u8, a1 **u8, a2 i32) u64\n"))

@test fn long_follows_the_target()
    assert_eq(module_text("long f(unsigned long x);\n", true), "pub extern c fn f(a0 u32) i32\n")
    assert_eq(module_text("long f(unsigned long x);\n", false), "pub extern c fn f(a0 u64) i64\n")

@test fn follows_the_headers_own_typedefs()
    src := "typedef unsigned int id_t;\ntypedef struct node node_t;\nid_t get(node_t *n, id_t k);\n"
    assert_eq(module_text(src, false), "pub extern c fn get(a0 *u8, a1 u32) u32\n")

@test fn module_names_round_trip()
    for h in ["stdlib.h", "sys/stat.h", "my_lib-2.h", "caf\u{e9}.h"]
        name := module_name(h)
        assert(is_use([name]))
        assert(not name.contains("."))
        assert_eq(header_of(name), h)

@test fn defines_become_constants()
    src := "#define N 4\n#define MASK (1 << 3 | 0x10)\n#define NEG -2\n#define PI 3.5\n#define NAME \"lib\"\n#define SUM (N + MASK * 2)\n#define EMPTY\n#define F(x) ((x) + 1)\n#define NOPE (int)5\n"
    out := module_text(src, false)
    assert(out.contains("pub N := 4\n"))
    assert(out.contains("pub MASK := 24\n"))
    assert(out.contains("pub NEG := -2\n"))
    assert(out.contains("pub PI := 3.5\n"))
    assert(out.contains("pub NAME := \"lib\"\n"))
    assert(out.contains("pub SUM := 52\n"))
    assert(not out.contains("EMPTY"))
    assert(not out.contains("NOPE"))
    assert(not out.contains("pub F"))

@test fn enums_become_constants()
    src := "enum color \{ RED, GREEN = 5, BLUE, };\ntypedef enum \{ A = 1 << 2, B } mode_t2;\nint paint(enum color c, mode_t2 m);\n"
    out := module_text(src, false)
    assert(out.contains("pub RED := 0\n"))
    assert(out.contains("pub GREEN := 5\n"))
    assert(out.contains("pub BLUE := 6\n"))
    assert(out.contains("pub A := 4\n"))
    assert(out.contains("pub B := 5\n"))
    assert(out.contains("pub extern c fn paint(a0 i32, a1 i32) i32\n"))

@test fn function_pointers_are_opaque_pointers()
    src := "typedef int (*cmp_t)(const void *, const void *);\nvoid sort(void *base, int n, cmp_t cmp);\nvoid each(int (*cb)(int), void *user);\nint (*pick(void))(int);\n"
    out := module_text(src, false)
    assert(out.contains("pub extern c fn sort(a0 *u8, a1 i32, a2 *u8)\n"))
    assert(out.contains("pub extern c fn each(a0 *u8, a1 *u8)\n"))
    assert(not out.contains("pick"))

@test fn unions_stay_behind_pointers()
    src := "union u \{ int i; float f; };\ntypedef union u u_t;\nvoid put(union u *p, u_t *q);\nunion u make(void);\nstruct bits \{ unsigned a : 3; unsigned b : 5; };\nint use_bits(struct bits *b);\n"
    out := module_text(src, false)
    assert(out.contains("pub extern c fn put(a0 *u8, a1 *u8)\n"))
    assert(out.contains("pub extern c fn use_bits(a0 *u8) i32\n"))
    assert(not out.contains("make"))
