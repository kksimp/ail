            "Project",
            "check this toolchain and say how to fix what is missing",
            "ail doctor [--json] [--path]",
            "tool.doctor.1,tool.path.1",
        ),
        c("version", "Project", "print the version (also `ail --version`)", "ail version", ""),
        c(
            "help",
            "Project",
            "this list, or one command's usage (also `ail --help`, `ail -h`)",
            "ail help [COMMAND | --keywords] [--json]",
            "tool.help.1,tool.help.2,tool.help.3",
        ),
    ]

## The overview (tool.help.1): one line per command under its group's heading.
fn overview(cmds List[Cmd]) str
    mut width := 0
    for k in cmds
        width = width.max(k.name.len())
    mut out := ["ail: the AIL toolchain. usage: ail COMMAND [ARGS...]", ""]
    for g in GROUPS
        out.push(g)
        for k in cmds
            if k.group == g
                out.push("  {k.name.pad_right(width, ' ')}  {k.summary}")
        out.push("")
    out.push("`ail help COMMAND` shows one command's usage and the rule to give `ail explain`.")
    out.push("`ail help --json` is the same table as one JSON array.")
    out.join("\n")

## One command (tool.help.2): its usage line and its rules.
fn detail(k Cmd) str
    mut out := ["usage: {k.usage}", "{k.name}: {k.summary}"]
    for r in k.rules
        out.push("rule: {r} (ail explain {r})")
    out.join("\n")

## A JSON string.
fn q(s str) str
    Json.Str(s).to_text()

## One command as a JSON object (tool.help.3).
fn one_json(k Cmd) str
    rules := [q(r) for r in k.rules].join(",")
    "\{\"name\":{q(k.name)},\"group\":{q(k.group)},\"summary\":{q(k.summary)},\"usage\":{q(k.usage)},\"rules\":[{rules}]}"

## The whole table as one JSON array (tool.help.3).
fn table_json(cmds List[Cmd]) str
    "[{[ one_json(k) for k in cmds ].join(",")}]"

## The exit status of `ail help ARGS` (also `--help`, `-h`, and no command at all).
pub fn command(args List[str]) int
    mut json := false
    mut keywords := false
    mut words := List[str]()
    for a in args
        if a == "--json"
            json = true
        elif a == "--keywords"
            keywords = true
        else
            words.push(a)
    # tool.help.3: the reserved words, for editors: one JSON array with `--json`, else one per line.
    if keywords
        if json
            print("[{[ q(w) for w in syntax.keywords() ].join(",")}]")
        else
            print(syntax.keywords().join("\n"))
        return 0
    cmds := commands()
    if words.len() == 0
        if json
            print(table_json(cmds))
        else
            print(overview(cmds))
        return 0
    if words.len() > 1
        io.eprint("usage: ail help [COMMAND | --keywords] [--json]")
        return 2
    # `ail help --help` and `ail help -h` are the usage of `help` itself.
    want := if words[0] == "--help" or words[0] == "-h" then "help" else words[0]
    for k in cmds
        if k.name == want
            if json
                print(one_json(k))
            else
                print(detail(k))
            return 0
    io.eprint("unknown command {words[0]}; run `ail help`")
    2
