## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The HTTP server of `std.net` (std.net.9-11, 24): `net.serve`, `Server.accept`,
## `Server.shutdown`, `Request.stop`, `Exchange.respond` and `respond_bytes`.
## A `Server` is a listener's socket object (net.ail). `accept` takes one
## connection at a time and reads its request to the end, so a slow client
## holds the task that accepts it (a pool of tasks, as `http.serve` has, is
## not held up); a malformed request is answered here with its 4xx or 5xx and
## never shown. A connection that may carry another request stays open after
## its response (std.net.22): it waits, unclaimed, in the socket table with
## `NET_STREAM` its server's handle (negative while a request is on it) and
## `NET_TIMEOUT` its deadline, and `accept` polls it with the listener. The
## socket object of an `Exchange` has `NET_KIND` 2 and the request's method
## in `NET_ADDR`.

SERVE_MAX_BODY := 16777216
SERVE_REQUEST_MS := 10000
SERVE_EXCHANGE := 2
# A connection that kept alive waits this long for its next request (std.net.22).
SERVE_IDLE_MS := 15000
# A flag of a connection whose current request may be followed by another.
SERVE_KEEP := 4
# Flags of a parked connection: bytes of a request have arrived (so a stall
# is a 408, not a silent close), and its `100 Continue` has been sent.
SERVE_PENDING := 8
SERVE_CONT := 16
# A connection accepted that has sent nothing yet.
SERVE_FRESH := 32
## How long a graceful shutdown waits before closing idle connections.
SERVE_SHUT_GRACE_MS := 25
## How often `accept` sweeps parked connections for deadlines, and the longest
## it waits in the readiness set (so it notices a close or a cancel).
SERVE_SCAN_MS := 50

## Append `n` (not negative) in decimal to the text being built.
fn serve_num(n int)
    if n >= 10
        serve_num(n / 10)
    sb_byte(48 + n % 10)

fn serve_reason(status int) str
    if status == 100
        return "Continue"
    if status == 200
        return "OK"
    if status == 201
        return "Created"
    if status == 202
        return "Accepted"
    if status == 204
        return "No Content"
    if status == 206
        return "Partial Content"
    if status == 301
        return "Moved Permanently"
    if status == 302
        return "Found"
    if status == 303
        return "See Other"
    if status == 304
        return "Not Modified"
    if status == 307
        return "Temporary Redirect"
    if status == 308
        return "Permanent Redirect"
    if status == 400
        return "Bad Request"
    if status == 401
        return "Unauthorized"
    if status == 403
        return "Forbidden"
    if status == 404
        return "Not Found"
    if status == 405
        return "Method Not Allowed"
    if status == 408
        return "Request Timeout"
    if status == 409
        return "Conflict"
    if status == 410
        return "Gone"
    if status == 411
        return "Length Required"
    if status == 413
        return "Content Too Large"
    if status == 415
        return "Unsupported Media Type"
    if status == 418
        return "I'm a Teapot"
    if status == 422
        return "Unprocessable Content"
    if status == 429
        return "Too Many Requests"
    if status == 431
        return "Request Header Fields Too Large"
    if status == 500
        return "Internal Server Error"
    if status == 501
        return "Not Implemented"
    if status == 502
        return "Bad Gateway"
    if status == 503
        return "Service Unavailable"
    if status == 504
        return "Gateway Timeout"
    if status == 505
        return "HTTP Version Not Supported"
    ""

## Send `n` bytes at `p` on socket object `o`; 0, or a negative `errno`
## (-110 for a timeout).
fn serve_send(o int, p int, n int) int
    fd := load64(o + NET_FD)
    mut done := 0
    while done < n
        r := net_sys_send(fd, p + done, n - done)
        if r > 0
            done += r
            continue
        if r == -4
            continue
        if r != -11 and r != -35 and r != 0
            return r
        w := net_wait(fd, 4, load64(o + NET_TIMEOUT))
        if w == 0
            return -110
        if w < 0
            return w
    0

## Stop sending on `o` and close it.
fn serve_end(o int)
    fd := load64(o + NET_FD)
    net_sys_shutdown(fd)
    net_sys_close(fd)
    store64(o + NET_FD, -1)

## Answer a connection the server is dropping: best effort, then close.
fn serve_refuse(o int, status int, message str)
    sb_reset()
    sb_text("HTTP/1.1 ")
    serve_num(status)
    sb_byte(32)
    sb_text(serve_reason(status))
    sb_text("\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: ")
    serve_num(load64(str_addr(message)) + 1)
    sb_text("\r\nConnection: close\r\n\r\n")
    sb_text(message)
    sb_byte(10)
    t := sb_str()
    serve_send(o, str_addr(t) + 16, load64(str_addr(t)))
    serve_end(o)

## The index of `\r\n\r\n` in the `n` bytes at `p`, or -1.
fn serve_head_end(p int, n int) int
    mut i := 3
    while i < n
        if load8(p + i) == 10
            and load8(p + i - 1) == 13
            and load8(p + i - 2) == 10
            and load8(p + i - 3) == 13
            return i - 3
        i += 1
    -1

## The index of `\r\n` in the bytes `from` to `to` of `p`, or -1.
fn serve_crlf(p int, from int, to int) int
    mut i := from
    while i + 1 < to
        if load8(p + i) == 13 and load8(p + i + 1) == 10
            return i
        i += 1
    -1

fn serve_index(p int, from int, to int, c int) int
    mut i := from
    while i < to
        if load8(p + i) == c
            return i
        i += 1
    -1

## `%XX` and `+` decoded in a query component; a bad escape stays as written.
fn serve_decode(p int, n int) str
    b := hb_new()
    mut i := 0
    while i < n
        c := load8(p + i)
        if c == 43
            hb_byte(b, 32)
        elif c == 37
            and i + 2 < n
            and serve_hex(load8(p + i + 1)) >= 0
            and serve_hex(load8(p + i + 2)) >= 0
            hb_byte(b, serve_hex(load8(p + i + 1)) * 16 + serve_hex(load8(p + i + 2)))
            i += 2
        else
            hb_byte(b, c)
        i += 1
    net_text(load64(b), load64(b + 8))

fn hb_byte(b int, c int)
    q := alloc_raw(8, KIND_BYTES)
    store8(q, c)
    hb_add(b, q, 1)

fn serve_hex(c int) int
    if c >= 48 and c <= 57
        return c - 48
    if c >= 97 and c <= 102
        return c - 87
    if c >= 65 and c <= 70
        return c - 55
    -1

## `a=1&b=2` of the `n` bytes at `p` into the map `m`; a repeated key keeps its last value.
fn serve_query(p int, n int, m int)
    mut at := 0
    while at <= n
        mut e := serve_index(p, at, n, 38)
        if e < 0
            e = n
        if e > at
            eq := serve_index(p, at, e, 61)
            if eq < 0
                map_set(m, str_addr(serve_decode(p + at, e - at)), str_addr(""))
            else
                map_set(
                    m,
                    str_addr(serve_decode(p + at, eq - at)),
                    str_addr(serve_decode(p + eq + 1, e - eq - 1)),
                )
        at = e + 1

fn serve_bad(st int, status int, msg str) int
    store64(st, str_addr(msg))
    status

## The request line and headers in the `end` bytes at `p`, into `req` (method,
## path, query, headers) and `st`: word 1 the framing (0 length, 1 chunked),
## word 2 the length, word 3 whether `Expect: 100-continue`. 0, or a status
## with its message in word 0 of `st`.
## `s` in lower case.
fn http_lower_str(s str) str
    http_lower(str_addr(s) + 16, load64(str_addr(s)))

fn serve_head(p int, end int, req int, st int) int
    if os_utf8_chars(p, end) < 0
        return serve_bad(st, 400, "the request head is not UTF-8")
    le := serve_crlf(p, 0, end + 2)
    line_end := if le < 0 then end else le
    s1 := serve_index(p, 0, line_end, 32)
    if s1 < 0
        return serve_bad(st, 400, "a request line is `METHOD TARGET HTTP/1.1`")
    s2 := serve_index(p, s1 + 1, line_end, 32)
    if s2 < 0 or serve_index(p, s2 + 1, line_end, 32) >= 0
        return serve_bad(st, 400, "a request line is `METHOD TARGET HTTP/1.1`")
    if not http_token(p, s1)
        return serve_bad(st, 400, "the method is not a token")
    vn := line_end - s2 - 1
    mut http11 := false
    if vn == 8 and http_ieq(p + s2 + 1, 8, "http/1.1") and load8(p + s2 + 1) == 72
        http11 = true
    elif vn == 8 and http_ieq(p + s2 + 1, 8, "http/1.0") and load8(p + s2 + 1) == 72
        http11 = false
    else
        return serve_bad(st, 505, "only HTTP/1.0 and HTTP/1.1 are supported")
    method := os_str_from(p, s1)
    tn := s2 - s1 - 1
    tp := p + s1 + 1
    star := tn == 1 and load8(tp) == 42 and method == "OPTIONS"
    if tn == 0 or (load8(tp) != 47 and not star)
        return serve_bad(st, 400, "the request target must be an absolute path")
    for i in 0..tn
        c := load8(tp + i)
        if c < 33 or c == 127
            return serve_bad(st, 400, "the request target must be an absolute path")
    q := serve_index(tp, 0, tn, 63)
    query := map_new(1, 0, 0)
    mut path := os_str_from(tp, tn)
    if q >= 0
        path = os_str_from(tp, q)
        serve_query(tp + q + 1, tn - q - 1, query)
    headers := map_new(1, 0, 0)
    mut at := line_end + 2
    while line_end < end and at <= end
        le2 := serve_crlf(p, at, end + 2)
        e := if le2 < 0 or le2 > end then end else le2
        if e > at and (load8(p + at) == 32 or load8(p + at) == 9)
            return serve_bad(st, 400, "folded header lines are not allowed")
        colon := serve_index(p, at, e, 58)
        if colon < 0
            return serve_bad(st, 400, "a header line is `name: value`")
        if not http_token(p + at, colon - at)
            return serve_bad(
                st,
                400,
                "a header name must be a token with no space before the colon",
            )
        mut vs := colon + 1
        mut ve := e
        while vs < ve and (load8(p + vs) == 32 or load8(p + vs) == 9)
            vs += 1
        while ve > vs and (load8(p + ve - 1) == 32 or load8(p + ve - 1) == 9)
            ve -= 1
        for i in vs..ve
            c := load8(p + i)
            if c == 0 or (c < 32 and c != 9)
                return serve_bad(st, 400, "a header value has a control character")
        name := http_lower(p + at, colon - at)
        value := os_str_from(p + vs, ve - vs)
        old := map_find(headers, str_addr(name))
        if old == 0
            map_set(headers, str_addr(name), str_addr(value))
        else
            map_set(headers, str_addr(name), str_addr(str_cat3(
                str_at(load64(old + 16)),
                ", ",
                value,
            )))
        at = e + 2
        if e >= end
            break
    if http11 and map_find(headers, str_addr("host")) == 0
        return serve_bad(st, 400, "an HTTP/1.1 request needs a Host header")
    te := map_find(headers, str_addr("transfer-encoding"))
    cl := map_find(headers, str_addr("content-length"))
    mut chunked := false
    if te != 0
        tv := str_addr(str_at(load64(te + 16)))
        if http_ieq(tv + 16, load64(tv), "chunked")
            chunked = true
        else
            return serve_bad(st, 501, "only the chunked transfer coding is supported")
    store64(st + 8, 0)
    store64(st + 16, 0)
    if chunked
        if cl != 0
            return serve_bad(st, 400, "a request has both Transfer-Encoding and Content-Length")
        store64(st + 8, 1)
    elif cl != 0
        cv := str_addr(str_at(load64(cl + 16)))
        cn := load64(cv)
        if cn == 0
            return serve_bad(st, 400, "Content-Length must be one number")
        for i in 0..cn
            c := load8(cv + 16 + i)
            if c < 48 or c > 57
                return serve_bad(st, 400, "Content-Length must be one number")
        n := http_number(str_at(cv), false)
        if n < 0 or n > SERVE_MAX_BODY
            return serve_bad(st, 413, "the request body is too large")
        store64(st + 16, n)
    cn2 := map_find(headers, str_addr("connection"))
    store64(st + 32, 0)
    if http11 and (cn2 == 0 or not net_has(http_lower_str(str_at(load64(cn2 + 16))), "close"))
        store64(st + 32, 1)
    ex := map_find(headers, str_addr("expect"))
    store64(st + 24, 0)
    if ex != 0
        ev := str_addr(str_at(load64(ex + 16)))
        if http_ieq(ev + 16, load64(ev), "100-continue")
            store64(st + 24, 1)
    store64(req, str_addr(method))
    store64(req + 8, str_addr(path))
    store64(req + 16, query)
    store64(req + 24, headers)
    0

## The chunked body in the `n` bytes at `p` into `body`: 1 when complete (its
## length in `used`), 0 when more must arrive, or a status (message in `st`).
fn serve_chunks(p int, n int, body int, used int, st int) int
    store64(body + 8, 0)
    mut at := 0
    while true
        i := serve_crlf(p, at, n)
        if i < 0
            return 0
        mut e := serve_index(p, at, i, 59)
        if e < 0
            e = i
        mut s := at
        while s < e and (load8(p + s) == 32 or load8(p + s) == 9)
            s += 1
        while e > s and (load8(p + e - 1) == 32 or load8(p + e - 1) == 9)
            e -= 1
        size := http_number(os_str_from(p + s, e - s), true)
        if size < 0
            return serve_bad(st, 400, "a bad chunk size")
        at = i + 2
        if size == 0
            while true
                j := serve_crlf(p, at, n)
                if j < 0
                    return 0
                empty := j == at
                at = j + 2
                if empty
                    store64(used, at)
                    return 1
        if load64(body + 8) + size > SERVE_MAX_BODY
            return serve_bad(st, 413, "the request body is too large")
        if n < at + size + 2
            return 0
        hb_add(body, p + at, size)
        if load8(p + at + size) != 13 or load8(p + at + size + 1) != 10
            return serve_bad(st, 400, "a chunk is not followed by a line break")
        at += size + 2
    0

## Read the request on connection object `o` (handle `c`, listener `server`):
## the `net.Request`, or 0 after the connection was answered with an error or
## dropped.
## What the bytes buffered on connection `c` (object `o`, server `server`)
## make of a request: the request when it is complete, -1 when more must
## arrive, or 0 when the connection was refused or dropped.
fn serve_try(c int, o int, server int) int
    st := cz_words(5)
    req := obj_new(64, 4)
    len := load64(o + NET_LEN) - load64(o + NET_POS)
    base := load64(o + NET_BUF) + load64(o + NET_POS)
    mut end := -1
    if len > 0
        end = serve_head_end(base, len)
    if end < 0
        if len > HTTP_MAX_HEAD
            serve_refuse(o, 431, "the request head is too large")
            return 0
        if load64(o + NET_FLAGS).bit_and(NET_EOF) != 0
            serve_end(o)
            return 0
        return -1
    if end > HTTP_MAX_HEAD
        serve_refuse(o, 431, "the request head is too large")
        return 0
    status := serve_head(base, end, req, st)
    if status != 0
        serve_refuse(o, status, str_at(load64(st)))
        return 0
    if load64(st + 24) != 0 and load64(o + NET_FLAGS).bit_and(SERVE_CONT) == 0
        store64(o + NET_FLAGS, load64(o + NET_FLAGS).bit_or(SERVE_CONT))
        serve_send(o, str_addr("HTTP/1.1 100 Continue\r\n\r\n") + 16, 25)
    start := end + 4
    framing := load64(st + 8)
    want := load64(st + 16)
    body := hb_new()
    used := alloc_raw(8, KIND_BYTES)
    if framing == 0
        if len < start + want
            return serve_more(o)
        hb_add(body, base + start, want)
    else
        res := serve_chunks(base + start, len - start, body, used, st)
        if res > 1
            serve_refuse(o, res, str_at(load64(st)))
            return 0
        if res == 0
            return serve_more(o)
    # Another request may follow only when the client wants it and sent
    # nothing past this one.
    used_len := if framing == 0 then start + want else start + load64(used)
    keep := load64(st + 32) != 0 and len == used_len
    flags := load64(o + NET_FLAGS).bit_and(-61)
    store64(o + NET_FLAGS, if keep then flags.bit_or(SERVE_KEEP) else flags)
    bp := load64(body)
    bn := load64(body + 8)
    raw := str_new(bn, bn)
    copy_bytes(raw + 16, bp, bn)
    store64(req + 32, str_addr(net_text(bp, bn)))
    store64(req + 40, load64(o + NET_PEER))
    store64(req + 48, raw)
    store64(req + 56, server)
    store64(o + NET_TIMEOUT, NET_DEFAULT_MS)
    store64(o + NET_KIND, SERVE_EXCHANGE)
    store64(o + NET_ADDR, load64(req))
    req

## The request is incomplete: -1 to wait for more, or 0 if the client has
## already closed its side.
fn serve_more(o int) int
    if load64(o + NET_FLAGS).bit_and(NET_EOF) != 0
        serve_end(o)
        return 0
    -1

## Whether bytes have already arrived on connection `o`: a request on its
## way, which a graceful shutdown still answers (std.net.24).
fn serve_ready(o int) bool
    pf := alloc_raw(8, KIND_BYTES)
    store64(pf, load64(o + NET_FD).bit_and(4294967295).bit_or(1.shl(32)))
    serve_poll(pf, 1, 0) > 0 and load8(pf + 6) != 0

## Close the connections parked on server `h` that have no request under
## way (all of them when `all`, for `close`).
fn serve_idle_drop(h int, all bool)
    t := load64(global(NET_TAB))
    if t == 0
        return
    for i in 1..load64(t)
        o := net_obj(i)
        if o != 0 and load64(o + NET_KIND) == NET_CONN and load64(o + NET_STREAM) == h
            if all or (load64(o + NET_FLAGS).bit_and(SERVE_PENDING) == 0 and not serve_ready(o))
                if atomic_cas(o + NET_STREAM, h, 0) == h
                    serve_end(o)

## The handles of the connections parked on server `h` into `out` (a count,
## then the handles). One past its deadline is closed, with a 408 when a
## request was under way (std.net.10).
fn serve_idle_scan(h int, out int)
    store64(out, 0)
    t := load64(global(NET_TAB))
    if t == 0
        return
    now := time_mono_ms()
    for i in 1..load64(t)
        o := net_obj(i)
        if o != 0 and load64(o + NET_KIND) == NET_CONN and load64(o + NET_STREAM) == h
            if load64(o + NET_TIMEOUT) <= now
                if atomic_cas(o + NET_STREAM, h, 0) == h
                    if load64(o + NET_FLAGS).bit_and(SERVE_PENDING.bit_or(SERVE_FRESH)) != 0
                        store64(o + NET_TIMEOUT, 5000)
                        serve_refuse(o, 408, "the request took too long")
                    else
                        serve_end(o)
                continue
            n := load64(out)
            store64(out + 8 + 8 * n, i)
            store64(out, n + 1)

## Wait up to `ms` for any of the `n` poll entries at `pf`.
fn serve_poll(pf int, n int, ms int) int
    if not det_on()
        return serve_poll_blocked(pf, n, ms)
    # On a deterministic schedule the others run between polls (see `net_wait`).
    deadline := if ms < 0 then -1 else time_mono_ms() + ms
    while true
        r := serve_poll_raw(pf, n, 0)
        if r != 0 or ms == 0
            return r
        if deadline >= 0 and time_mono_ms() >= deadline
            return 0
        if det_relax()
            continue
        r2 := serve_poll_raw(pf, n, 1)
        if r2 != 0
            return r2
    0

## `serve_poll_raw` on a pool worker, counted as blocked (native.task.2, see
## `net_poll_blocked`): `accept` polls in slices, so a task queued while the
## worker is between slices gets its thread at the next one.
fn serve_poll_blocked(pf int, n int, ms int) int
    if ms == 0 or load64(global(MULTI)) == 0 or worker_index() < 0
        return serve_poll_raw(pf, n, ms)
    wait_enter()
    r := serve_poll_raw(pf, n, ms)
    wait_leave()
    r

fn serve_poll_raw(pf int, n int, ms int) int
    if target() == 3
        return wnet_poll(pf, n, ms)
    ts := alloc_raw(16, KIND_BYTES)
    park := net_park_wait(ms)
    while true
        mut r := 0
        if target() == 1
            store64(ts, ms / 1000)
            store64(ts + 8, ms % 1000 * 1000000)
        mut ps := 0
        if park
            ps = blocked_enter()
        if target() == 1
            r = syscall(73, pf, n, ts, 0, 0, 0)
        else
            r = syscall(if target() == 2 then 230 else 7, pf, n, ms, 0, 0, 0)
        if park
            blocked_leave(ps)
        if r != -4
            return r
    0

## Park connection `c` of server `h` until `ms` from now.
fn serve_park(h int, o int, ms int)
    store64(o + NET_KIND, NET_CONN)
    store64(o + NET_TIMEOUT, time_mono_ms() + ms)
    atomic_store(o + NET_STREAM, h)
    serve_arm(h, o)

## Arm parked connection `o` in its server's readiness set, if it has one
## (ADR 1009): `accept` is told when bytes arrive on it. A set is reported
## once per arming, so every way back to parked arms again.
fn serve_arm(h int, o int)
    so := net_obj(h)
    if so == 0
        return
    ep := load64(so + NET_POLLER)
    if ep > 0
        rdy_arm(ep, load64(o + NET_FD), load64(o + NET_HANDLE))

## The readiness set of server `h` (listener object `o`, descriptor `fd`),
## made on first use with the listener and every connection already parked
## on it: the set, or 0 when the system gave none.
fn serve_poller(h int, o int, fd int) int
    ep := load64(o + NET_POLLER)
    if ep != 0
        return if ep > 0 then ep else 0
    n := rdy_new()
    if n <= 0
        atomic_cas(o + NET_POLLER, 0, -1)
        return 0
    rdy_listen(n, fd, 0)
    if atomic_cas(o + NET_POLLER, 0, n) != 0
        rdy_close(n)
        ep2 := load64(o + NET_POLLER)
        return if ep2 > 0 then ep2 else 0
    t := load64(global(NET_TAB))
    for i in 1..load64(t)
        co := net_obj(i)
        if co != 0 and load64(co + NET_KIND) == NET_CONN and load64(co + NET_STREAM) == h
            rdy_arm(n, load64(co + NET_FD), i)
    n

## Read what has arrived on parked connection `c` of server `h`: the request
## as an exchange when it is complete, else 0 (it stays parked, or is gone).
fn serve_idle_take(h int, c int) int
    o := net_obj(c)
    if o == 0 or atomic_cas(o + NET_STREAM, h, 0 - h) != h
        return 0
    if net_wait(load64(o + NET_FD), 1, 0) <= 0
        atomic_store(o + NET_STREAM, h)
        serve_arm(h, o)
        return 0
    deadline := load64(o + NET_TIMEOUT)
    store64(o + NET_TIMEOUT, 5000)
    if net_fill(o) < 0
        serve_end(o)
        return 0
    flags := load64(o + NET_FLAGS).bit_and(-33)
    store64(o + NET_FLAGS, flags.bit_or(SERVE_PENDING))
    req := serve_try(c, o, h)
    if req == 0
        return 0
    if req < 0
        # Progress: the client has another SERVE_REQUEST_MS from now.
        serve_park(h, o, SERVE_REQUEST_MS)
        return 0
    ex := obj_new(16, 4)
    store64(ex, req)
    store64(ex + 8, c)
    ex

## Fail `accept` with `closed`.
fn serve_closed(at str) int
    net_closed("server", at)

## `srv.accept()` (std.net.9): the next complete request as a `net.Exchange`.
## A connection that has not sent a whole request is parked, so a slow client
## doesn't hold up the others (std.net.10).
fn serve_accept(h int, at str) int
    sa := alloc_raw(32, KIND_BYTES)
    lenp := alloc_raw(8, KIND_BYTES)
    mut shut_at := 0
    mut scan_at := 0
    while true
        o := net_obj(h)
        if o == 0
            serve_idle_drop(h, true)
            return serve_closed(at)
        fd := load64(o + NET_FD)
        shut := load64(o + NET_FLAGS).bit_and(NET_SHUT) != 0
        # Bytes a client sent just before the shutdown may not have reached
        # the socket yet: idle connections get SERVE_SHUT_GRACE_MS first.
        if shut and shut_at == 0
            shut_at = time_mono_ms()
        if shut and time_mono_ms() - shut_at >= SERVE_SHUT_GRACE_MS
            serve_idle_drop(h, false)
        store64(lenp, 16)
        r := net_sys_accept(fd, sa, lenp)
        if r >= 0
            net_sys_accepted(r)
            c := net_add(r, NET_CONN, net_addr_text(sa), "")
            co := net_obj(c)
            store64(co + NET_FLAGS, SERVE_FRESH)
            serve_park(h, co, SERVE_REQUEST_MS)
            continue
        if r == -4
            continue
        if r != -11 and r != -35
            # A server closed by another task under the accept (Windows reports the socket, not the server) is `closed`.
            if net_obj(h) == 0
                return serve_closed(at)
            return net_fail("", net_errno_kind(-r), "can't accept a connection", at)
        # A cancelled task ends its wait (std.net.9).
        if task_cancelled()
            return serve_closed(at)
        # Readiness set (ADR 1009): wait for the listener or any armed parked
        # connection without copying them all; parked connections past their
        # deadline are swept every SERVE_SCAN_MS.
        ep := if shut then 0 else serve_poller(h, o, fd)
        if ep > 0
            now := time_mono_ms()
            if now - scan_at >= SERVE_SCAN_MS
                scan_at = now
                serve_idle_scan(h, alloc_raw(16 + 8 * load64(load64(global(NET_TAB))), KIND_BYTES))
            tags := alloc_raw(8 * RDY_MAX, KIND_BYTES)
            w := rdy_wait(ep, tags, SERVE_SCAN_MS)
            if w < 0
                if net_obj(h) == 0
                    return serve_closed(at)
                return net_fail("", net_errno_kind(-w), "can't accept a connection", at)
            for k in 0..w
                tag := load64(tags + 8 * k)
                if tag != 0
                    ex := serve_idle_take(h, tag)
                    if ex != 0
                        # The tags not taken were disarmed by being reported: arm them again.
                        nx := k + 1
                        for j in nx..w
                            rj := net_obj(load64(tags + 8 * j))
                            if rj != 0 and load64(rj + NET_STREAM) == h
                                serve_arm(h, rj)
                        return ex
            continue
        t := load64(global(NET_TAB))
        ids := alloc_raw(16 + 8 * load64(t), KIND_BYTES)
        serve_idle_scan(h, ids)
        n := load64(ids)
        if shut and n == 0
            net_close(h)
            return serve_closed(at)
        # Wait for a new connection or bytes on a parked one.
        pf := alloc_raw(8 * (n + 1), KIND_BYTES)
        store64(pf, fd.bit_and(4294967295).bit_or(1.shl(32)))
        for k in 0..n
            po := net_obj(load64(ids + 8 + 8 * k))
            pfd := if po == 0 then -1 else load64(po + NET_FD)
            store64(pf + 8 * (k + 1), pfd.bit_and(4294967295).bit_or(1.shl(32)))
        w := serve_poll(pf, n + 1, 50)
        if w < 0
            if net_obj(h) == 0
                return serve_closed(at)
            return net_fail("", net_errno_kind(-w), "can't accept a connection", at)
        if w > 0
            for k in 0..n
                if load8(pf + 8 * (k + 1) + 6) != 0
                    ex := serve_idle_take(h, load64(ids + 8 + 8 * k))
                    if ex != 0
                        return ex
    0

## `srv.shutdown()` and `req.stop()` (std.net.24): stop listening once the
## requests already arriving are taken.
fn serve_shutdown(h int)
    o := net_obj(h)
    if o != 0
        store64(o + NET_FLAGS, load64(o + NET_FLAGS).bit_or(NET_SHUT))

## Whether the `n` bytes at `p` equal `q`'s `m` bytes, ignoring ASCII case.
fn serve_ieq(p int, n int, q int, m int) bool
    if n != m
        return false
    for i in 0..n
        a := load8(p + i)
        b := load8(q + i)
        if (if a >= 65 and a <= 90 then a + 32 else a)
            != (if b >= 65 and b <= 90 then b + 32 else b)
            return false
    true

## Whether `all` (a map of names) has a name equal to the `n` bytes at `p`.
fn serve_has(all int, p int, n int) bool
    for i in 0..http_slots(all)
        e := http_slot(all, i)
        if load64(e) != -1
            k := str_addr(str_at(load64(e + 8)))
            if serve_ieq(p, n, k + 16, load64(k))
                return true
    false

## One header line `name: value` into the response being built; false after
## a `bad_request` failure for a bad name or value.
fn serve_line(name str, value str, st int, at str) bool
    k := str_addr(name)
    kn := load64(k)
    if not http_token(k + 16, kn)
        net_fail("", "bad_request", "`{name}` is not a header name", at)
        return false
    v := str_addr(value)
    for j in 0..load64(v)
        c := load8(v + 16 + j)
        if c == 13 or c == 10 or c == 0
            net_fail("", "bad_request", "the value of header `{name}` has a line break", at)
            return false
    if serve_ieq(k + 16, kn, str_addr("connection") + 16, 10)
        if net_has(http_lower_str(value), "close")
            cz_wr(st, 1, 1)
        return true
    if serve_ieq(k + 16, kn, str_addr("content-length") + 16, 14) or serve_ieq(
        k + 16,
        kn,
        str_addr("transfer-encoding") + 16,
        17,
    )
        return true
    if serve_ieq(k + 16, kn, str_addr("content-type") + 16, 12)
        store64(st, 1)
    sb_text(name)
    sb_text(": ")
    sb_text(value)
    sb_text("\r\n")
    true

## `ex.respond(r)`, `ex.respond_bytes(...)` (std.net.11, 16, 17): send the
## response and close the connection. `all` is 0 or the `all_headers` map.
fn serve_answer(h int, status int, headers int, all int, body int, at str)
    o := net_obj(h)
    if o == 0 or load64(o + NET_KIND) != SERVE_EXCHANGE
        net_fail("", "other", "this exchange has already been answered or is closed", at)
        return
    if status < 100 or status > 599
        net_fail("", "bad_request", "{status} is not an HTTP status; use 100 to 599", at)
        return
    nobody := status / 100 == 1 or status == 204 or status == 304
    sb_reset()
    sb_text("HTTP/1.1 ")
    serve_num(status)
    sb_byte(32)
    sb_text(serve_reason(status))
    sb_text("\r\n")
    st := cz_words(2)
    for i in 0..http_slots(headers)
        e := http_slot(headers, i)
        if load64(e) != -1
            k := str_addr(str_at(load64(e + 8)))
            if all == 0 or not serve_has(all, k + 16, load64(k))
                if not serve_line(str_at(load64(e + 8)), str_at(load64(e + 16)), st, at)
                    return
    if all != 0
        for i in 0..http_slots(all)
            e := http_slot(all, i)
            if load64(e) != -1
                xs := list_addr(list_at(load64(e + 16)))
                items := load64(xs + 16)
                for j in 0..load64(xs)
                    if not serve_line(str_at(load64(e + 8)), str_at(load64(items + 8 * j)), st, at)
                        return
    bn := load64(body)
    if cz_rd(st, 0) == 0 and bn > 0 and not nobody
        sb_text("Content-Type: text/plain; charset=utf-8\r\n")
    if status / 100 != 1 and status != 204
        sb_text("Content-Length: ")
        serve_num(if nobody then 0 else bn)
        sb_text("\r\n")
    # Keep the connection for the next request (std.net.22) unless the client
    # or the response asked to close, the response is interim, or the server
    # is shutting down.
    sv := 0 - load64(o + NET_STREAM)
    so := net_obj(sv)
    keep := load64(o + NET_FLAGS).bit_and(SERVE_KEEP) != 0 and cz_rd(
        st,
        1,
    ) == 0 and status / 100 != 1 and so != 0 and load64(so + NET_FLAGS).bit_and(NET_SHUT) == 0
    sb_text(if keep then "Connection: keep-alive\r\n\r\n" else "Connection: close\r\n\r\n")
    if not nobody and str_at(load64(o + NET_ADDR)) != "HEAD"
        sb_bytes(body + 16, bn)
    out := sb_str()
    r := serve_send(o, str_addr(out) + 16, load64(str_addr(out)))
    if r < 0
        serve_end(o)
        net_io_fail(o, r, at)
        return
    if not keep
        serve_end(o)
        return
    # Park it: nothing is buffered, and `accept` finds it by `NET_STREAM`.
    store64(o + NET_POS, 0)
    store64(o + NET_LEN, 0)
    serve_park(sv, o, SERVE_IDLE_MS)

fn serve_respond(h int, r int, at str)
    serve_answer(h, load64(r), load64(r + 8), load64(r + 24), load64(r + 16), at)

fn serve_respond_bytes(h int, status int, headers int, data str, at str)
    serve_answer(h, status, headers, 0, str_addr(data), at)

# ---- bytes on a connection (std.net.16) and TLS (std.net.13) ----
