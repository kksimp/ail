## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Native instrumentation (ADR 0871, native.instr.1-3, test.cover.4). A program built
## with `AIL_INSTRUMENT=lines` calls `instr_hit(ID)` at the start of each
## statement; `ID` numbers the sites in the table the compiler writes
## (lower_instr.ail). The hits are one byte each in a table that global slot
## 56 points to, made at the first hit: the word at its start is one past the
## highest id hit, the bytes follow. `sys_exit` calls `instr_dump`, which
## appends the ids hit, one per line, to `$AIL_INSTRUMENT_OUT`, else `EXE.hits` (a `counts` build:
## `ID<TAB>COUNT`, native.instr.4). A
## program built without the flag never calls `instr_hit`, so the table is
## never made and `instr_dump` returns at once.

INSTR_TAB := 56

## The most sites a program can have; later ids are not recorded.
INSTR_CAP := 4194304

## The call trace (`AIL_INSTRUMENT=calls`, native.instr.3, trace.test.1-2) lives after the hit bytes in the
## same table: a word with the limit plus one (0 until read from `$AIL_TRACE_LIMIT`, default
## 1000), the events shown, the events dropped, whether the event being written is dropped,
## the text length, then the text. An event is a line `call<TAB>FN<TAB>LINE<TAB>COL` followed by
## `<TAB>NAME=VALUE` for each argument that is a number, a `bool` or a `str`.
TRACE_CAP := 1048576
TRACE_HEAD := 48

## The table, made if it is not there yet; 0 when it can't be.
fn instr_table() int
    mut t := load64(global(INSTR_TAB))
    if t == 0
        t = sys_mmap(INSTR_CAP + 8 + TRACE_HEAD + TRACE_CAP + 17024)
        if t < 0
            return 0
        store64(global(INSTR_TAB), t)
    t

fn instr_hit(id int)
    t := instr_table()
    if t > 0 and id < INSTR_CAP
        store8(t + 8 + id, 1)
        if id >= load64(t)
            store64(t, id + 1)

## The word of the state words that holds the address of the statement counters (0 until the first count).
INSTR_COUNTS := 16528

## A build with `AIL_INSTRUMENT=counts` (native.instr.4, tool.perf.3) calls this at the start of each
## statement in place of `instr_hit`: site `id` ran once more. The counters are one word a site in a
## table of their own, made at the first count. Tasks count without a lock, so a count may fall short
## when two threads run the same statement at once.
fn instr_count(id int)
    t := instr_table()
    if t <= 0 or id >= INSTR_CAP
        return
    w := t + 8 + INSTR_CAP + TRACE_HEAD + TRACE_CAP
    mut c := load64(w + INSTR_COUNTS)
    if c == 0
        c = sys_mmap(INSTR_CAP * 8)
        if c < 0
            return
        store64(w + INSTR_COUNTS, c)
    store64(c + 8 * id, load64(c + 8 * id) + 1)
    if id >= load64(t)
        store64(t, id + 1)

## The head of the call trace in the table `t`.
fn instr_trace(t int) int
    t + 8 + INSTR_CAP

## The start of a call event, unless the limit is reached.
fn instr_call(name str, line int, col int)
    t := instr_table()
    if t <= 0
        return
    h := instr_trace(t)
    if load64(h) == 0
        given := os_env_get("AIL_TRACE_LIMIT")
        store64(h, (if given == "" then 1000 else str_to_int(given)) + 1)
    if load64(h + 8) >= load64(h) - 1
        store64(h + 16, load64(h + 16) + 1)
        store64(h + 24, 1)
        return
    store64(h + 8, load64(h + 8) + 1)
    store64(h + 24, 0)
    instr_put("call\t")
    instr_put(name)
    instr_put("\t")
    instr_put_int(line)
    instr_put("\t")
    instr_put_int(col)

## The end of the event: its newline.
fn instr_call_end()
    t := load64(global(INSTR_TAB))
    if t > 0 and load64(instr_trace(t) + 24) == 0
        instr_put("\n")

fn instr_arg_int(name str, v int)
    instr_arg_start(name)
    instr_put_int(v)

fn instr_arg_bool(name str, v bool)
    instr_arg_start(name)
    instr_put(if v then "true" else "false")

## A `str` argument, quoted and cut at 60 bytes; control bytes show as spaces.
fn instr_arg_str(name str, v str)
    instr_arg_start(name)
    t := load64(global(INSTR_TAB))
    if t <= 0 or load64(instr_trace(t) + 24) != 0
        return
    p := str_addr(v)
    n := load64(p)
    instr_put("\"")
    for i in 0..(if n > 60 then 60 else n)
        c := load8(p + 16 + i)
        instr_byte(if c < 32 then 32 else c)
    instr_put("\"")

fn instr_arg_start(name str)
    t := load64(global(INSTR_TAB))
    if t > 0 and load64(instr_trace(t) + 24) == 0
        instr_put("\t")
        instr_put(name)
        instr_put("=")

fn instr_put(s str)
    p := str_addr(s)
    for i in 0..load64(p)
        instr_byte(load8(p + 16 + i))

fn instr_put_int(n int)
    scratch := instr_trace(load64(global(INSTR_TAB))) + TRACE_HEAD + TRACE_CAP - 8192
    for i in 0..(write_int(scratch, n))
        instr_byte(load8(scratch + i))

## Append a byte to the trace text, unless it is full (the last 4 KiB stay free).
fn instr_byte(b int)
    h := instr_trace(load64(global(INSTR_TAB)))
    n := load64(h + 32)
    if n < TRACE_CAP - 16384 and load64(h + 24) == 0
        store8(h + TRACE_HEAD + n, b)
        store64(h + 32, n + 1)

## The path of the file `suffix` beside the program (its `argv[0]`), made in `at`; 0 when
## `named` is not empty it is the path given.
fn instr_path(at int, named str, suffix str) int
    if named != ""
        return os_cstr(OS_PATH_A, named)
    a0 := load64(load64(global(ARGV)))
    n := os_c_len(a0)
    if n > 4000
        return 0
    for i in 0..n
        store8(at + i, load8(a0 + i))
    q := str_addr(suffix) + 16
    m := load64(str_addr(suffix))
    for i in 0..m
        store8(at + n + i, load8(q + i))
    store8(at + n + m, 0)
    at

## Write the hits and the trace (see the head of this file).
fn instr_dump()
    t := load64(global(INSTR_TAB))
    if t <= 0
        return
    store64(global(INSTR_TAB), 0)
    buf := sys_mmap(65536 + 8192)
    if buf < 0
        return
    h := instr_trace(t)
    n := load64(h + 32)
    if n > 0 or load64(h + 16) > 0
        p := instr_path(buf + 65536, os_env_get("AIL_TRACE_OUT"), ".trace")
        if p != 0
            fd := os_open(p, os_open_flags(1), 438)
            if fd >= 0
                os_write_all(fd, h + TRACE_HEAD, n)
                dropped := load64(h + 16)
                if dropped > 0
                    w := write_int(buf, dropped)
                    store8(buf + w, 10)
                    os_write_all(fd, buf, w + 1)
                os_close(fd)
    tr_summary(t + 8 + INSTR_CAP + TRACE_HEAD + TRACE_CAP)
    # No site was hit (a `steps` or `record` build): no hits file, and none beside the source.
    if load64(t) == 0
        return
    p := instr_path(buf + 65536, os_env_get("AIL_INSTRUMENT_OUT"), ".hits")
    if p == 0
        return
    fd := os_open(p, os_open_flags(2), 438)
    if fd < 0
        return
    # native.instr.4: a `counts` build writes `ID<TAB>COUNT` for each site that ran, in place of the ids hit.
    c := load64(t + 8 + INSTR_CAP + TRACE_HEAD + TRACE_CAP + INSTR_COUNTS)
    mut k := 0
    for id in 0..load64(t)
        n := if c != 0 then load64(c + 8 * id) else load8(t + 8 + id)
        if n != 0
            k += write_int(buf + k, id)
            if c != 0
                store8(buf + k, 9)
                k += 1
                k += write_int(buf + k, n)
            store8(buf + k, 10)
            k += 1
            if k > 65000
                os_write_all(fd, buf, k)
                k = 0
    os_write_all(fd, buf, k)
    os_close(fd)

## `--max-steps N` (run.limit.3, ADR 0883): a build with `AIL_INSTRUMENT=steps` calls this at the
## start of each statement of the program's own files. The count and the limit
## (`$AIL_MAX_STEPS`, read at the first step) follow the call trace in the table.
fn instr_step(path str, line int, col int)
    t := instr_table()
    if t <= 0
        return
    w := t + 8 + INSTR_CAP + TRACE_HEAD + TRACE_CAP
    n := load64(w) + 1
    store64(w, n)
    if n == 1
        given := os_env_get("AIL_MAX_STEPS")
        store64(w + 8, if given == "" then 0 else str_to_int(given))
    max := load64(w + 8)
    if max > 0 and n > max
        flush()
        out_str(path)
        out_byte(58)
        out_int(line)
        out_byte(58)
        out_int(col)
        out_str(": trap[run.limit.3]: run took more than --max-steps ")
        out_int(max)
        out_str(" steps (a step is one statement run; raise it, or find the loop)\n")
        flush_to(2)
        sys_exit(1)

## Events of `ail run --trace` and `--watch` (trace.run.1-4, trace.watch.1) go to standard error,
## live, one line each. The words after the step count in the table are: events shown,
## events dropped, the call depth, the count of each kind (7 words), the limit plus one.
KIND_CALL := 0
KIND_RETURN := 1
KIND_WATCH := 6

## The state words of the events.
fn tr_state() int
    t := instr_table()
    if t <= 0
        return 0
    t + 8 + INSTR_CAP + TRACE_HEAD + TRACE_CAP

## The start of an event of kind `kind`: it is counted; within the limit
## (`$AIL_TRACE_LIMIT`, default 1000) the text that follows goes to standard error,
## else it is written nowhere (output descriptor -1). `tr_close` ends it.
fn tr_open(kind int) bool
    w := tr_state()
    if w == 0
        return false
    # One event is one piece of the shared output buffer: no other thread writes in it.
    out_lock()
    if load64(w + 96) == 0
        given := os_env_get("AIL_TRACE_LIMIT")
        store64(w + 96, (if given == "" then 1000 else str_to_int(given)) + 1)
    store64(w + 40 + 8 * kind, load64(w + 40 + 8 * kind) + 1)
    flush()
    if load64(w + 16) >= load64(w + 96) - 1
        store64(w + 24, load64(w + 24) + 1)
        store64(global(OUT_FD), 0 - 1)
        return false
    store64(w + 16, load64(w + 16) + 1)
    store64(global(OUT_FD), 2)
    true

## Whether events are JSON objects (`--trace --json`, `$AIL_TRACE_JSON`).
fn tr_is_json() bool
    w := tr_state()
    if w == 0
        return false
    if load64(w + 104) == 0
        store64(w + 104, if os_env_get("AIL_TRACE_JSON") == "" then 1 else 2)
    load64(w + 104) == 2

## The end of an event: its text is written and output is back on standard output.
fn tr_close()
    if tr_state() == 0
        return
    fd := load64(global(OUT_FD))
    flush_to(if fd == 2 then 2 else 0 - 1)
    store64(global(OUT_FD), 1)
    out_unlock()

## `--watch NAME` (trace.watch.1, ADR 0868): a build with `watch=NAME` calls this before the
## text of each event; it says whether the event is within the limit.
fn watch_open() bool
    if tr_open(KIND_WATCH)
        return true
    tr_close()
    false

fn watch_close()
    tr_close()

## The identity of the watched variable for a callee that holds it through a `mut` parameter
## (trace.watch.3): the object of a struct, list or map, or the cell a scalar is passed in.
fn watch_set(id int)
    w := tr_state()
    if w != 0
        store64(w + 16520, id)

## `watch_open` for an event of a parameter: only when the parameter is the watched variable.
fn watch_open_alias(id int) bool
    w := tr_state()
    if w == 0 or id == 0
        return false
    if load64(w + 16520) != id
        return false
    watch_open()

## The last line of a run with events (trace.run.4).
fn tr_summary(w int)
    shown := load64(w + 16)
    dropped := load64(w + 24)
    if shown + dropped == 0
        return
    flush()
    json := tr_is_json()
    if json
        out_str("\{\"api\":1,\"trace\":\"summary\",\"shown\":")
        out_int(shown)
        out_str(",\"dropped\":")
        out_int(dropped)
        for k in 0..7
            n := load64(w + 40 + 8 * k)
            if n > 0
                out_str(",\"")
                out_str(tr_kind(k))
                out_str("\":")
                out_int(n)
        out_str("}\n")
    else
        out_str("trace: summary: ")
        out_int(shown)
        out_str(" events shown, ")
        out_int(dropped)
        out_str(" dropped (")
        mut first := true
        for k in 0..7
            n := load64(w + 40 + 8 * k)
            if n > 0
                if not first
                    out_str(", ")
                first = false
                out_str(tr_kind(k))
                out_byte(32)
                out_int(n)
        if first
            out_str("none")
        out_str(")\n")
    flush_to(2)

fn tr_kind(k int) str
    if k == 0
        return "call"
    if k == 1
        return "return"
    if k == 2
        return "effect"
    if k == 3
        return "spawn"
    if k == 4
        return "wait"
    if k == 5
        return "contract"
    "watch"
