## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The leak report (ADR 0969, san.leak.1-4). A garbage-collected program does not
## lose memory it can no longer reach; what it can leak is memory it still
## holds: a cache that is never trimmed, a list that only grows, a global that
## keeps a finished job. With `AIL_LEAK` set (`ail leak FILE`), every
## collection marks the roots one at a time and counts the bytes each one
## newly reaches, by object kind. The first and the latest collection are kept.
## At exit one more collection runs, and the report says whether live memory
## grew at every collection (san.leak.1) and which roots hold it (san.leak.2).
## Costs nothing when the variable is unset: the collector tests one word.
##
## The block (global state word 450 points to it, 0 when off) is words:

LK_STATE := 450
LK_SIZE := 65536
## 0 report written, 1 JSON lines, 2 list the roots even without growth.
LK_DONE := 0
LK_JSON := 1
LK_ALL := 2
## Collections sampled; the root being counted; bytes and objects it reaches so far.
LK_N := 3
LK_CUR := 4
LK_ACC_B := 5
LK_ACC_O := 6
## The live bytes after each of the last 64 collections.
LK_RING := 16
## Per object kind (64 slots each): bytes and objects at the first collection,
## at the latest, and the current root's bytes.
LK_KB_FIRST := 100
LK_KC_FIRST := 164
LK_KB_LAST := 228
LK_KC_LAST := 292
LK_KB_ROOT := 360
## Per root (1024 ids): bytes at the first collection, bytes, objects and the
## largest kind at the latest, and a scratch copy for sorting.
## Ids: 0 registers, 1 stack, 2 other threads, 8 + n global slot n.
LK_ROOTS := 1024
LK_RB_FIRST := 1024
LK_RB_LAST := 2048
LK_RO_LAST := 3072
LK_RK_LAST := 4096
LK_RB_SORT := 5120

## Collections needed before a growth finding, and the smallest growth.
LK_MIN_N := 4
LK_MIN_GROWTH := 1048576
LK_FLOOR := 4194304

fn lk() int
    hs(LK_STATE)

fn lk_get(i int) int
    load64(lk() + 8 * i)

fn lk_set(i int, v int)
    store64(lk() + 8 * i, v)

## `AIL_LEAK` is set (san.leak.3, san.leak.4): make the block, collect often enough to see a trend.
fn leak_setup(v str)
    p := sys_mmap(LK_SIZE)
    if p < 0
        return
    hset(LK_STATE, p)
    if v == "json" or v == "all,json" or v == "json,all"
        lk_set(LK_JSON, 1)
    if v == "all" or v == "all,json" or v == "json,all"
        lk_set(LK_ALL, 1)
    hset(H_THRESH, LK_FLOOR)
    if hs(26) == 0
        hset(H_FASTLIM, LK_FLOOR)

## The next collection point: half the live bytes, at least 4 MiB.
fn gc_thresh(live int) int
    if hs(LK_STATE) != 0
        return if live / 2 > LK_FLOOR then live / 2 else LK_FLOOR
    if live * 3 > MIN_THRESH
        return live * 3
    MIN_THRESH

## Count `n` bytes of an object of kind `kind` for the current root.
fn lk_add(kind int, n int)
    k := kind.bit_and(63)
    lk_set(LK_ACC_B, lk_get(LK_ACC_B) + n)
    lk_set(LK_ACC_O, lk_get(LK_ACC_O) + 1)
    lk_set(LK_KB_ROOT + k, lk_get(LK_KB_ROOT + k) + n)
    lk_set(LK_KB_LAST + k, lk_get(LK_KB_LAST + k) + n)
    lk_set(LK_KC_LAST + k, lk_get(LK_KC_LAST + k) + 1)

## Mark the object that holds `w` and count it, unless it is marked already.
fn lk_visit(w int)
    bs := gc_find(w)
    if bs == 0
        return
    h := load64(bs)
    kind := h.bit_and(255)
    if kind == 0 or h.bit_and(256) != 0
        return
    lk_add(kind, h.shr(16) + 8)
    if kind == KIND_STR or kind == KIND_BYTES or kind == KIND_ATOMIC
        store64(bs, h.bit_or(256))
    else
        gc_mark_in(gc_stack(), w)

## The words `from` to `to`, each taken as a pointer when it is inside the heap.
fn lk_scan(from int, to int)
    base := hs(H_BASE)
    top := hs(H_TOP)
    mut p := from
    while p < to
        w := load64(p)
        if w >= base and w < top
            lk_visit(w)
        p += 8

## A list's element block, with only the first `len` words scanned.
fn lk_list(w int, len int)
    bs := gc_find(w)
    if bs == 0
        return
    h := load64(bs)
    kind := h.bit_and(255)
    if kind == 0 or h.bit_and(256) != 0
        return
    lk_add(kind, h.shr(16) + 8)
    store64(bs, h.bit_or(256))
    if kind == KIND_LDATA
        lk_scan(bs + 8, bs + 8 + 8 * len)
    elif kind > KIND_FDATA and kind < 64
        lk_scan(bs + 8, bs + 8 + 8 * len * (kind - KIND_FDATA))

## `gc_drain` with counting.
fn lk_drain()
    c := gc_stack()
    mut top := load64(c + 16)
    while top > 0
        top -= 1
        store64(c + 16, top)
        bs := load64(load64(c) + 8 * top)
        h := load64(bs)
        if h.bit_and(255) == KIND_LIST
            lk_list(load64(bs + 24), load64(bs + 8))
        else
            lk_scan(bs + 8, bs + 8 + h.shr(16) / 8 * 8)
        top = load64(c + 16)

fn lk_begin(id int)
    lk_set(LK_CUR, id)
    lk_set(LK_ACC_B, 0)
    lk_set(LK_ACC_O, 0)

## Record what the root reached: bytes, objects and the kind with most bytes.
fn lk_end()
    id := lk_get(LK_CUR)
    mut best := 0
    mut best_n := 0
    for k in 0..64
        n := lk_get(LK_KB_ROOT + k)
        if n > best_n
            best_n = n
            best = k
        lk_set(LK_KB_ROOT + k, 0)
    b := lk_get(LK_ACC_B)
    if b > 0 and id < LK_ROOTS
        lk_set(LK_RB_LAST + id, b)
        lk_set(LK_RO_LAST + id, lk_get(LK_ACC_O))
        lk_set(LK_RK_LAST + id, best)

fn lk_range(id int, from int, to int)
    lk_begin(id)
    lk_scan(from, to)
    lk_drain()
    lk_end()

## The collector's marking in leak mode (san.leak.2) (replaces its root scans): the global
## slots first, one root each, then registers, stack and the other threads.
fn leak_mark(sp int, m int)
    for i in 0..512
        lk_set(LK_KB_LAST + i, 0)
    for i in 0..LK_ROOTS
        lk_set(LK_RB_LAST + i, 0)
        lk_set(LK_RO_LAST + i, 0)
        lk_set(LK_RK_LAST + i, 0)
    g0 := global(OUT_BUF)
    ge := globals_end()
    base := hs(H_BASE)
    top := hs(H_TOP)
    mut p := g0
    while p < ge
        w := load64(p)
        if w >= base and w < top
            n := (p - g0) / 8 + 8
            lk_begin(if n < LK_ROOTS then n else LK_ROOTS - 1)
            lk_visit(w)
            lk_drain()
            lk_end()
        p += 8
    lk_range(0, m + 8 * H_REGS, m + 8 * (H_REGS + 10))
    lk_range(1, sp, stack_end_self())
    lk_begin(2)
    gc_scan_threads()
    lk_drain()
    lk_end()
    leak_sample()

## After marking: the live bytes go in the ring, the first collection's tables are kept.
fn leak_sample()
    n := lk_get(LK_N)
    mut live := 0
    for k in 0..64
        live += lk_get(LK_KB_LAST + k)
    lk_set(LK_RING + n % 64, live)
    if n == 0
        for i in 0..128
            lk_set(LK_KB_FIRST + i, lk_get(LK_KB_LAST + i))
        for i in 0..LK_ROOTS
            lk_set(LK_RB_FIRST + i, lk_get(LK_RB_LAST + i))
    lk_set(LK_N, n + 1)

# ---- the report ----

fn lk_kind(k int)
    if k == KIND_STR
        out_str("str")
    elif k == KIND_LIST
        out_str("list")
    elif k == KIND_LDATA
        out_str("list data")
    elif k == KIND_BYTES
        out_str("bytes")
    elif k == KIND_ATOMIC
        out_str("atomic")
    elif k == 12
        out_str("task")
    elif k == 13
        out_str("env")
    elif k > KIND_FDATA and k < 64
        out_str("struct list data")
    else
        out_str("kind ")
        out_int(k)

fn lk_size(n int)
    if n >= 1048576
        out_int(n / 1048576)
        out_str(".")
        out_int(n % 1048576 * 10 / 1048576)
        out_str(" MiB")
    else
        out_int(n / 1024)
        out_str(" KiB")

fn lk_root_text(id int)
    if id == 0
        out_str("the registers")
    elif id == 1
        out_str("the stack")
    elif id == 2
        out_str("the other threads")
    else
        out_str("global slot ")
        out_int(id - 8)

fn lk_json_head(rule int)
    out_str("\{\"api\":1,\"severity\":\"warning\",\"rule\":\"san.leak.")
    out_int(rule)
    out_str("\"")

fn lk_json_kind(k int)
    out_str("\"")
    lk_kind(k)
    out_str("\"")

## san.leak.1: live bytes at the first collection, at the latest, and whether
## they fell by more than a twentieth at any collection of the last 64.
fn lk_grew() bool
    n := lk_get(LK_N)
    if n < LK_MIN_N
        return false
    mut first := 0
    mut last := 0
    for k in 0..64
        first += lk_get(LK_KB_FIRST + k)
        last += lk_get(LK_KB_LAST + k)
    if last < first + first / 2 + LK_MIN_GROWTH
        return false
    from := if n > 64 then n - 64 else 0
    mut prev := lk_get(LK_RING + from % 64)
    mut i := from + 1
    while i < n
        cur := lk_get(LK_RING + i % 64)
        if cur < prev - prev / 20
            return false
        prev = cur
        i += 1
    true

fn lk_report_growth()
    mut first := 0
    mut last := 0
    for k in 0..64
        first += lk_get(LK_KB_FIRST + k)
        last += lk_get(LK_KB_LAST + k)
    json := lk_get(LK_JSON) != 0
    if json
        lk_json_head(1)
        out_str(",\"collections\":")
        out_int(lk_get(LK_N))
        out_str(",\"first_bytes\":")
        out_int(first)
        out_str(",\"live_bytes\":")
        out_int(last)
        out_str(",\"kinds\":[")
    else
        out_str("leak[san.leak.1]: live memory grew at each of ")
        out_int(lk_get(LK_N))
        out_str(" collections: ")
        lk_size(first)
        out_str(" -> ")
        lk_size(last)
        out_str("\n")
    mut shown := 0
    for k in 0..64
        a := lk_get(LK_KB_FIRST + k)
        b := lk_get(LK_KB_LAST + k)
        if b - a >= 262144
            if json
                if shown > 0
                    out_str(",")
                out_str("\{\"kind\":")
                lk_json_kind(k)
                out_str(",\"first_bytes\":")
                out_int(a)
                out_str(",\"bytes\":")
                out_int(b)
                out_str(",\"objects\":")
                out_int(lk_get(LK_KC_LAST + k))
                out_str("}")
            else
                out_str("  ")
                lk_kind(k)
                out_str(": ")
                lk_size(a)
                out_str(" -> ")
                lk_size(b)
                out_str(" (")
                out_int(lk_get(LK_KC_LAST + k))
                out_str(" objects)\n")
            shown += 1
    if json
        out_str("]}\n")

## san.leak.2: the roots that hold the most, largest first, at most five.
fn lk_report_roots(min int)
    for i in 0..LK_ROOTS
        lk_set(LK_RB_SORT + i, lk_get(LK_RB_LAST + i))
    for _ in 0..5
        mut best := 0
        mut best_n := 0
        for i in 0..LK_ROOTS
            b := lk_get(LK_RB_SORT + i)
            if b > best_n
                best_n = b
                best = i
        if best_n < min
            return
        lk_set(LK_RB_SORT + best, 0)
        if lk_get(LK_JSON) != 0
            lk_json_head(2)
            if best < 8
                if best == 0
                    out_str(",\"root\":\"registers\"")
                elif best == 1
                    out_str(",\"root\":\"stack\"")
                else
                    out_str(",\"root\":\"threads\"")
            else
                out_str(",\"root\":\"global\",\"slot\":")
                out_int(best - 8)
            out_str(",\"first_bytes\":")
            out_int(lk_get(LK_RB_FIRST + best))
            out_str(",\"bytes\":")
            out_int(best_n)
            out_str(",\"objects\":")
            out_int(lk_get(LK_RO_LAST + best))
            out_str(",\"kind\":")
            lk_json_kind(lk_get(LK_RK_LAST + best))
            out_str("}\n")
        else
            out_str("leak[san.leak.2]: ")
            lk_root_text(best)
            out_str(" holds ")
            lk_size(best_n)
            out_str(" in ")
            out_int(lk_get(LK_RO_LAST + best))
            out_str(" objects, mostly ")
            lk_kind(lk_get(LK_RK_LAST + best))
            out_str("; ")
            lk_size(lk_get(LK_RB_FIRST + best))
            out_str(" at the first collection\n")

## The report, on standard error (san.leak.3, san.leak.4).
fn lk_report()
    flush()
    mut live := 0
    for k in 0..64
        live += lk_get(LK_KB_LAST + k)
    grew := lk_grew()
    if grew
        lk_report_growth()
    if grew or lk_get(LK_ALL) != 0
        lk_report_roots(if lk_get(LK_ALL) != 0 then 1 else LK_MIN_GROWTH)
    if lk_get(LK_JSON) != 0
        out_str("\{\"summary\":true,\"collections\":")
        out_int(lk_get(LK_N))
        out_str(",\"live_bytes\":")
        out_int(live)
        out_str(",\"grew\":")
        out_bool(grew)
        out_str("}\n")
    else
        out_str("leak: ")
        out_int(lk_get(LK_N))
        out_str(" collections, ")
        lk_size(live)
        out_str(" live at exit")
        out_str(if grew then ", growing\n" else ", no growth\n")
    flush_to(2)

## Called by `sys_exit`: after a normal exit with fewer than four collections,
## one more (the program's locals are gone, so what the globals still hold has
## leaked), then the report. A thread that already holds the allocation lock skips the
## collection.
fn leak_exit(code int)
    m := load64(global(HEAP))
    if m == 0 or load64(m + 8 * LK_STATE) == 0
        return
    if lk_get(LK_DONE) != 0
        return
    lk_set(LK_DONE, 1)
    if code == 0 and lk_get(LK_N) < LK_MIN_N
        mut ok := true
        if load64(global(MULTI)) != 0
            if atomic_load(global(ALLOC_OWNER)) == thread_id()
                ok = false
            else
                lock(global(ALLOC_LOCK))
                atomic_store(global(ALLOC_OWNER), thread_id())
        if ok
            gc_collect()
    if lk_get(LK_N) > 0
        lk_report()
