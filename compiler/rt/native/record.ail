fn rec_fs_read_range(path str, off int, len int, at str) str
    if rec_mode() == 2
        return rec_r_bytes("fs.read_range", at)
    r := fs_read_range(path, off, len, at)
    rec_w_bytes("fs.read_range", r)
    r

fn rec_fs_map(path str, at str) str
    if rec_mode() == 2
