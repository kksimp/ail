fn rec_fs_trash(path str, at str)
    if rec_mode() == 2
        rec_r_unit("fs.trash", at)
        return
    fs_trash(path, at)
    rec_w_unit("fs.trash", 1)

## `fs.scan` (std.fs.23): `{"struct":"fs.Scan","fields":[[ENTRY,...],[PATH,...]]}`
## with each entry the array of its nine fields.
fn rec_fs_scan(root str, same_device bool, at str) int
    if rec_mode() == 2
        p := rec_next("fs.scan")
        if rec_failed(p)
            rec_raise(p, at)
            return 0
        rec_cur_to(p)
        rec_c_fields()
        rec_c_open()
        mut es := List[int]()
        if rec_c_open()
            es.push(rec_c_scan_entry())
            while rec_c_next()
                es.push(rec_c_scan_entry())
        rec_c_next()
        sk := rec_c_strs()
        r := obj_new(16, 4)
        store64(r, list_addr(es))
        store64(r + 8, list_addr(sk))
        return r
    r := fs_scan(root, same_device, at)
    s := rec_begin("fs.scan", 1)
    if s != 0
        if failed()
            rec_fail(s)
        else
            rec_text(s, "\{\"struct\":\"fs.Scan\",\"fields\":[[")
            es := list_at(load64(r))
            for i in 0..es.len()
                e := es[i]
                if i > 0
                    rec_byte(s, 44)
                rec_byte(s, 91)
                rec_json(s, str_at(load64(e)))
                for k in 1..7
                    rec_byte(s, 44)
                    rec_int(s, load64(e + 8 * k))
                rec_text(s, if load64(e + 56) != 0 then ",true" else ",false")
                rec_text(s, if load64(e + 64) != 0 then ",true]" else ",false]")
            rec_text(s, "],")
            rec_w_strs_body(s, list_at(load64(r + 8)))
            rec_text(s, "]}")
        rec_end(s)
    r

## One entry of a recorded scan; the cursor is at its `[`.
fn rec_c_scan_entry() int
    rec_c_open()
    e := obj_new(72, 4)
    store64(e, str_addr(rec_c_str()))
    for k in 1..7
        rec_c_next()
        store64(e + 8 * k, rec_c_int())
    rec_c_next()
    store64(e + 56, if rec_c_bool() then 1 else 0)
    rec_c_next()
    store64(e + 64, if rec_c_bool() then 1 else 0)
    rec_c_next()
    e

fn rec_env_vars() int
    if rec_mode() == 2
        p := rec_next("env.vars")
        rec_cur_to(p)
        return rec_c_map_ss()
    m := env_vars()
    s := rec_begin("env.vars", 1)
    if s != 0
        rec_w_map_ss(s, m)
        rec_end(s)
    m

## The optional `int` of `tz.offset`: boxed, 0 for `none`.
fn rec_tz_offset(zone str, secs int) int
    if rec_mode() == 2
        p := rec_next("tz.offset")
        if load8(p) == 123
            return 0
        rec_cur_to(p)
        return box(rec_c_int())
    r := tz_offset(zone, secs)
    s := rec_begin("tz.offset", 1)
    if s != 0
        if r == 0
            rec_text(s, "\{\"none\":true}")
        else
            rec_int(s, unbox(r))
        rec_end(s)
    r

## `proc.run` and `proc.run_bytes`: a `[status, out, err]` struct.
fn rec_proc_result(name str, sname str, r int, raw bool)
    s := rec_begin(name, 1)
    if s != 0
        if failed()
            rec_fail(s)
        else
            rec_text(s, "\{\"struct\":")
            rec_json(s, sname)
            rec_text(s, ",\"fields\":[")
            rec_int(s, load64(r))
            for k in 1..3
                rec_byte(s, 44)
                v := str_at(load64(r + 8 * k))
                if raw
                    p := str_addr(v)
                    rec_text(s, "\{\"bytes\":\"")
                    for i in 0..load64(p)
                        c := load8(p + 16 + i)
                        rec_hex(s, c / 16)
                        rec_hex(s, c % 16)
                    rec_text(s, "\"}")
                else
                    rec_json(s, v)
            rec_text(s, "]}")
        rec_end(s)

fn rec_c_bytes() str
    rec_c_ws()
    s := rec_state()
    mut i := load64(s + REC_CUR) + 10
    sb_reset()
    while load8(i) != 34
        h := load8(i)
        l := load8(i + 1)
        sb_byte((if h <= 57 then h - 48 else h - 87) * 16 + (if l <= 57 then l - 48 else l - 87))
        i += 2
    store64(s + REC_CUR, i + 2)
    sb_str()

fn rec_r_proc_result(name str, at str, raw bool) int
    p := rec_next(name)
    if rec_failed(p)
        rec_raise_proc(p, at)
        return 0
    rec_cur_to(p)
    rec_c_fields()
    rec_c_open()
    r := obj_new(24, PROC_STRUCT)
    store64(r, rec_c_int())
    rec_c_next()
    store64(r + 8, str_addr(if raw then rec_c_bytes() else rec_c_str()))
    rec_c_next()
    store64(r + 16, str_addr(if raw then rec_c_bytes() else rec_c_str()))
    r

fn rec_proc_run(cmd str, args List[int], input int, timeout int, at str) int
    if rec_mode() == 2
        return rec_r_proc_result("proc.run", at, false)
    r := proc_run(cmd, args, input, timeout, at)
    rec_proc_result("proc.run", "proc.Output", r, false)
    r

fn rec_proc_run_bytes(cmd str, args List[int], input int, timeout int, at str) int
    if rec_mode() == 2
        return rec_r_proc_result("proc.run_bytes", at, true)
    r := proc_run_bytes(cmd, args, input, timeout, at)
    rec_proc_result("proc.run_bytes", "proc.RawOutput", r, true)
    r

# ---- child processes (replay.nat.1) ----

## A line (`k` 0 output, 1 error) or the end of a stream of the child `seq`, noted as the
## recording's own line, apart from the calls.
fn rec_stream_line(seq int, k int, line str)
    s := rec_open()
    if s != 0
        rec_text(s, "\{\"stream\":")
        rec_int(s, seq)
        rec_text(s, if k == 0 then ",\"out\":" else ",\"err\":")
        rec_json(s, line)
        rec_end(s)

fn rec_stream_end(seq int, k int)
    s := rec_open()
    if s != 0
        rec_text(s, "\{\"stream\":")
        rec_int(s, seq)
        rec_text(s, if k == 0 then ",\"end\":\"out\"" else ",\"end\":\"err\"")
        rec_end(s)

## The `Child` of a replayed `proc.start`: channels already holding what the recorded
## child wrote, closed; a stand-in process that takes whatever is sent to its input.
fn rec_child(pid int, seq int) int
    ps := alloc(PS_SIZE, PROC_STRUCT)
    store64(ps + PS_PID, pid)
    store64(ps + PS_IN, -1)
    store64(ps + PS_OUT, -1)
    store64(ps + PS_ERR, -1)
    store64(ps + PS_DONE, 1)
    c := alloc(32, PROC_STRUCT)
    store64(c, pid)
    for k in 0..3
        ch := chan_new()
        store64(ch + CH_SOURCE, ps)
        store64(c + 8 + 8 * k, ch)
        store64(ps + PS_INCH + 8 * k, ch)
    tp := load64(global(REC_TEXT))
    d := tp + 16
    n := load64(tp)
    mut i := 0
    while i < n
        if load8(d + i + 2) == 115 and load8(d + i + 3) == 116
            mut j := i + 10
            mut num := 0
            while load8(d + j) >= 48 and load8(d + j) <= 57
                num = num * 10 + load8(d + j) - 48
                j += 1
            if num == seq
                q := d + j + 1
                if load8(q + 2) == 117
                    chan_push(load64(c + 16), rec_string(q + 6))
                elif load8(q + 2) == 114
                    chan_push(load64(c + 24), rec_string(q + 6))
        while i < n and load8(d + i) != 10
            i += 1
        i += 1
    for k in 1..3
        chan_mark_closed(load64(c + 8 + 8 * k))
    c

fn rec_proc_start(cmd str, args List[int], timeout int, at str) int
    s := rec_state()
    if rec_mode() == 2
        p := rec_next("proc.start")
        if rec_failed(p)
            rec_raise_proc(p, at)
            return 0
        rec_cur_to(p)
        rec_c_fields()
        rec_c_open()
        pid := rec_c_int()
        seq := load64(s + REC_NCHILD) + 1
        store64(s + REC_NCHILD, seq)
        return rec_child(pid, seq)
    c := proc_start(cmd, args, timeout, at)
    if rec_mode() == 1 and c != 0
        seq := load64(s + REC_NCHILD) + 1
        store64(s + REC_NCHILD, seq)
        ps := load64(load64(c + 8) + CH_SOURCE)
        store64(ps + PS_SEQ, seq)
    r := rec_begin("proc.start", 1)
    if r != 0
        if c == 0
            rec_fail(r)
        else
            rec_text(r, "\{\"struct\":\"proc.Child\",\"fields\":[")
            rec_int(r, load64(c))
            rec_text(r, "]}")
        rec_end(r)
    c

fn rec_proc_int(name str, r int, fails int)
    s := rec_begin(name, 1)
    if s != 0
        if fails != 0 and failed()
            rec_fail(s)
        else
            rec_int(s, r)
        rec_end(s)

fn rec_proc_wait_child(c int, at str) int
    if rec_mode() == 2
        p := rec_next("proc.wait")
        if rec_failed(p)
            rec_raise_proc(p, at)
            return 0
        rec_cur_to(p)
        return rec_c_int()
    r := proc_wait_child(c, at)
    rec_proc_int("proc.wait", r, 1)
    r

fn rec_proc_kill_child(c int) int
    if rec_mode() == 2
        return rec_r_int("proc.kill")
    r := proc_kill_child(c)
    rec_proc_int("proc.kill", r, 0)
    r

# ---- maps of strings (replay.rec.3) ----

## `m` (a `Map[str, str]`) as `{"map":[[k,v],...]}`.
fn rec_w_map_ss(s int, m int)
    rec_text(s, "\{\"map\":[")
    keys := map_keys(m)
    q := list_addr(keys)
    data := load64(q + 16)
    for i in 0..load64(q)
        k := load64(data + 8 * i)
        if i > 0
            rec_byte(s, 44)
        rec_byte(s, 91)
        rec_json(s, str_at(k))
        rec_byte(s, 44)
        rec_json(s, str_at(load64(map_find(m, k) + 16)))
        rec_byte(s, 93)
    rec_text(s, "]}")

## A `Map[str, List[str]]`.
fn rec_w_map_sl(s int, m int)
    rec_text(s, "\{\"map\":[")
    keys := map_keys(m)
    q := list_addr(keys)
    data := load64(q + 16)
    for i in 0..load64(q)
        k := load64(data + 8 * i)
        if i > 0
            rec_byte(s, 44)
        rec_byte(s, 91)
        rec_json(s, str_at(k))
        rec_byte(s, 44)
        rec_w_strs_body(s, list_at(load64(map_find(m, k) + 16)))
        rec_byte(s, 93)
    rec_text(s, "]}")

## The map at the cursor, past its `{"map":` and up to its `}`.
fn rec_c_map_ss() int
    m := map_new(1, 0, 0)
    rec_c_ws()
    rec_cur_to(rec_cur() + 7)
    if rec_c_open()
        rec_c_open()
        k := rec_c_str()
        rec_c_next()
        v := rec_c_str()
        rec_c_close()
        map_set(m, str_addr(k), str_addr(v))
        while rec_c_next()
            rec_c_open()
            k2 := rec_c_str()
            rec_c_next()
            v2 := rec_c_str()
            rec_c_close()
            map_set(m, str_addr(k2), str_addr(v2))
    rec_c_close()
    m

fn rec_c_map_sl() int
    m := map_new(1, 1, 8)
    rec_c_ws()
    rec_cur_to(rec_cur() + 7)
    if rec_c_open()
        rec_c_open()
        k := rec_c_str()
        rec_c_next()
        xs := rec_c_strs()
        rec_c_close()
        map_set(m, str_addr(k), list_addr(xs))
        while rec_c_next()
            rec_c_open()
            k2 := rec_c_str()
            rec_c_next()
            ys := rec_c_strs()
            rec_c_close()
            map_set(m, str_addr(k2), list_addr(ys))
    rec_c_close()
    m
