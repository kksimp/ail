## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The native runtime's core (native-abi.md, ADRs 0404-0408, 0387): system
## calls, the allocator (`heap.ail`), buffered output, lists of numbers, and traps.
## Written in the native subset over the primitives of `prim.ail`, and
## compiled by the backend into every executable. The algorithms follow
## lane 122's machine model in `compiler/rt/rt.ail`.

# Global slots.
OUT_BUF := 0
OUT_LEN := 1
ARGC := 5
ARGV := 6
PARSE_OK := 7
# Windows: the byte count `WriteFile` reports (ADR 0608).
WIN_WRITTEN := 13
# Threads (ADR 0599): the pool block, a flag that is 1 once a second thread
# can exist, the allocator's and the output buffer's locks, and the
# reentrant output lock's owner and depth.
TASKS := 16
MULTI := 17
ALLOC_LOCK := 18
OUT_LOCK := 19
OUT_OWNER := 20
OUT_DEPTH := 21
STACKS := 22
# A collection is under way (threads park), and the thread holding the
# allocation lock (so a trap inside the allocator can release it).
GC_REQ := 23
ALLOC_OWNER := 24
## A trap's third number (a slice's list length); the program ends after
## it, so it shares `PARSE_OK`'s slot.
TRAP_LEN := 7
## The lowest stack address a program's call may start from (err.trap.1,
## ADR 0535).
STACK_LIMIT := 15
## The stack kept free below the limit for the trap's own calls.
STACK_RESERVE := 1048576
## The stack size assumed when the limit is unknown or unlimited.
STACK_DEFAULT := 8388608

OUT_CAP := 65536

# Worker threads run on 8 MiB stacks carved from one region, at most 64.
STACK_SZ := 8388608
MAXW := 64

# ---- system calls (native-abi.md §4) ----

fn sys_write(fd int, p int, n int)
    t := target()
    if t == 3
        # Windows output (ADR 0608): `WriteFile` (win.ail) on the standard handle until every byte is written.
        # A failed write ends the output, as on the other targets.
        mut sent := 0
        while sent < n
            w := win_write(fd, p + sent, n - sent)
            if w <= 0
                return
            sent += w
        return
    mut done := 0
    while done < n
        k := if t == 0 then 1 else if t == 1 then 64 else 4
        r := syscall(k, fd, p + done, n - done, 0, 0, 0)
        if r == -4
            continue
        if r <= 0
            return
        done += r

fn sys_exit(status int)
    leak_exit(status)
    instr_dump()
    code := race_exit(status)
    t := target()
    if t == 3
        import_call("ExitProcess", code, 0, 0, 0)
        return
    k := if t == 0 then 231 else if t == 1 then 94 else 1
    syscall(k, code, 0, 0, 0, 0, 0)

fn sys_mmap(n int) int
    t := target()
    # MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE (ADR 0608).
    if t == 3
        p := import_call("VirtualAlloc", 0, n, 12288, 4)
        return if p == 0 then -1 else p
    k := if t == 0 then 9 else if t == 1 then 222 else 197
    flags := if t == 2 then 4098 else 34
    syscall(k, 0, n, 3, flags, -1, 0)

## A thread-stack region: `n` bytes that need no commit up front.
fn sys_mmap_lazy(n int) int
    t := target()
    k := if t == 0 then 9 else if t == 1 then 222 else 197
    flags := if t == 2 then 4098 else 16418
    syscall(k, 0, n, 3, flags, -1, 0)

# ---- locks and threads (ADR 0599, 0600) ----

## macOS has no futex: `__ulock_wait` and `__ulock_wake` of libSystem do the
## same on a 32-bit word (UL_COMPARE_AND_WAIT is 1, ULF_WAKE_ALL 0x100).
fn futex_wait_raw(a int, v int)
    if target() == 3
        win_wait(a, v, -1)
        return
    if target() == 2
        import_call("___ulock_wait", 1, a, v, 0)
        return
    k := if target() == 0 then 202 else 98
    syscall(k, a, 128, v, 0, 0, 0)

## Sleep while `*a == v`. A sleeping thread is parked for the collector: its
## stack and registers are published first (task.ail), and it stays parked
## after waking while a collection runs.
fn futex_wait(a int, v int)
    if load64(global(MULTI)) == 0
        futex_wait_raw(a, v)
        return
    s := blocked_enter()
    futex_wait_raw(a, v)
    blocked_leave(s)

## The same for at most `ms` milliseconds: it returns when the word changed,
## when woken, or when the time ran out (the caller looks at the word).
fn futex_wait_timed(a int, v int, ms int)
    mut t := ms * 1000
    if target() == 3
        t = ms
    elif target() != 2
        t = alloc(16, KIND_BYTES)
        store64(t, ms / 1000)
        store64(t + 8, ms % 1000 * 1000000)
    if load64(global(MULTI)) == 0
        futex_wait_raw_t(a, v, t)
        return
    s := blocked_enter()
    futex_wait_raw_t(a, v, t)
    blocked_leave(s)

## `t` is the timeout: microseconds on macOS, else the address of a timespec.
fn futex_wait_raw_t(a int, v int, t int)
    if target() == 3
        win_wait(a, v, t)
        return
    if target() == 2
        import_call("___ulock_wait", 1, a, v, t)
        return
    k := if target() == 0 then 202 else 98
    syscall(k, a, 128, v, t, 0, 0)

fn futex_wake(a int, n int)
    if target() == 3
        # Waiters on Windows poll the word (`win_wait`), so there is nobody to wake.
        return
    if target() == 2
        op := if n > 1 then 257 else 1
        import_call("___ulock_wake", op, a, 0, 0)
        return
    k := if target() == 0 then 202 else 98
    syscall(k, a, 129, n, 0, 0, 0)

## A lock word: 0 free, 1 held, 2 held and someone waits (Drepper's mutex,
## "Futexes Are Tricky", written here from the description).
fn lock(a int)
    if load64(global(MULTI)) != 0 and atomic_load(global(GC_REQ)) != 0
        gc_park()
    mut c := atomic_cas(a, 0, 1)
    while c != 0
        mut wait := c == 2
        if not wait
            wait = atomic_cas(a, 1, 2) != 0
        if wait
            futex_wait(a, 2)
        c = atomic_cas(a, 0, 2)

fn unlock(a int)
    if atomic_add(a, -1) != 1
        atomic_store(a, 0)
        futex_wake(a, 1)

## The worker thread this code runs on (0 to 63), or -1 for the main thread
## or before any worker exists. A worker's stack lies in the `STACKS` region.
fn worker_index() int
    if target() == 3
        return win_worker_index()
    base := load64(global(STACKS))
    if base == 0
        return -1
    s := sp()
    if s >= base and s < base + MAXW * STACK_SZ
        return (s - base) / STACK_SZ
    -1

## This thread's slot: 0 for the main thread, `k + 1` for worker `k`.
fn thread_slot() int
    worker_index() + 1

## Where each thread's text builder lives in the pool block (fmt.ail).
P_SB := 9344

## Each worker's pending failure (err.ail): three words per thread slot.
P_ERR := 10944

## Each worker's `parse_ok` flag: one word per thread slot, so `to_int` and
## `to_float` in a parallel loop (conc.par.8) or a task see their own result.
## Free pool-block space between `P_ERRT` (err.ail, to 13832) and `P_DET`.
P_PARSE := 13840

## The address of this thread's `parse_ok` flag: the global slot on the main
## thread, the pool block's word for a worker.
fn parse_ok_addr() int
    if load64(global(MULTI)) != 0
        w := worker_index()
        if w >= 0
            return load64(global(TASKS)) + P_PARSE + 8 * (w + 1)
    global(PARSE_OK)

## A number for the running thread: 1 for the main thread, 2 and up for
## workers.
fn thread_id() int
    worker_index() + 2

## Hold the output buffer for one `print` (reentrant: an interpolated call
## may print).
fn out_lock()
    me := thread_id()
    if atomic_load(global(OUT_OWNER)) == me
        store64(global(OUT_DEPTH), load64(global(OUT_DEPTH)) + 1)
        return
    lock(global(OUT_LOCK))
    atomic_store(global(OUT_OWNER), me)
    store64(global(OUT_DEPTH), 1)

fn out_unlock()
    d := load64(global(OUT_DEPTH)) - 1
    store64(global(OUT_DEPTH), d)
    if d == 0
        atomic_store(global(OUT_OWNER), 0)
        unlock(global(OUT_LOCK))

# ---- memory (ADR 0562) ----

## Called by the entry with the process's argument count and vector.
fn init(argc int, argv int)
    store64(global(ARGC), argc)
    store64(global(ARGV), argv)
    store64(global(OUT_BUF), sys_mmap(OUT_CAP))
    store64(global(OUT_LEN), 0)
    heap_init(argv)
    box_init()
    # Windows has no argument vector on entry: read the command line.
    if target() == 3
        win_args_init()
    # After `win_args_init`: on Windows that builds the environment, so the
    # settings (`AIL_TIMEOUT_MS`, `AIL_MAX_MEMORY_MB`, `AIL_GC_STATS`, `AIL_GC_VERIFY`) are not seen before it.
    limits_init()
    # After the Windows environment is built, or `AIL_LEAK` is not seen there (san.leak.3).
    leak := os_env_get("AIL_LEAK")
    if leak != ""
        leak_setup(leak)
    # The argument vector sits at the top of the main stack. Windows
    # (target 3) has no argument vector there: the thread's own bounds say how far the stack goes.
    if target() != 3
        store64(global(STACK_LIMIT), argv - stack_use())
    else
        p := alloc(16, KIND_ATOMIC)
        import_call("GetCurrentThreadStackLimits", p, p + 8, 0, 0)
        low := load64(p)
        size := load64(p + 8) - low
        if low > 0 and size > 0
            store64(
                global(STACK_LIMIT),
                if size > 2 * STACK_RESERVE then low + STACK_RESERVE else low + size / 2,
            )

## Windows (target 3) hands the program no `argv` or `envp`: build them from
## `GetCommandLineW` (UTF-16, by the rules of `CommandLineToArgvW`, with `""` in a quoted part a literal quote, program
## name first) and `GetEnvironmentStringsW`. They live in pages that are
## never freed.
fn win_args_init()
    p := import_call("GetCommandLineW", 0, 0, 0, 0)
    if p == 0
        return
    mut n := 0
    while win_unit(p, n) != 0
        n += 1
    # The environment block: `NAME=VALUE` entries of UTF-16, each ended by a NUL, the block by a second one.
    e := import_call("GetEnvironmentStringsW", 0, 0, 0, 0)
    mut m := 0
    if e != 0
        while win_unit(e, m) != 0 or win_unit(e, m + 1) != 0
            m += 1
    # Words for `argv` (at most one argument per two units) and then `envp`;
    # then 3 UTF-8 bytes per unit plus a NUL for each string.
    vec := sys_mmap(8 * (n + 4) + 8 * (m / 2 + 4) + 4 * (n + m) + 64)
    mut out := vec + 8 * (n + 4) + 8 * (m / 2 + 4)
    mut argc := 0
    mut i := 0
    store64(vec, out)
    if win_unit(p, 0) == 34
        i = 1
        while win_unit(p, i) != 0 and win_unit(p, i) != 34
            cp := win_cp(p, i)
            out = win_put(out, cp)
            i += win_width(cp)
        if win_unit(p, i) == 34
            i += 1
    else
        while win_unit(p, i) != 0 and win_unit(p, i) != 32 and win_unit(p, i) != 9
            cp := win_cp(p, i)
            out = win_put(out, cp)
            i += win_width(cp)
    store8(out, 0)
    out += 1
    argc = 1
    while true
        while win_unit(p, i) == 32 or win_unit(p, i) == 9
            i += 1
        if win_unit(p, i) == 0
            break
        store64(vec + 8 * argc, out)
        mut quoted := false
        while win_unit(p, i) != 0
            c := win_unit(p, i)
            if c == 92
                mut b := 0
                while win_unit(p, i + b) == 92
                    b += 1
                i += b
                if win_unit(p, i) == 34
                    for k in 0..b / 2
                        store8(out, 92)
                        out += 1
                    if b % 2 == 1
                        store8(out, 34)
                        out += 1
                        i += 1
                else
                    for k in 0..b
                        store8(out, 92)
                        out += 1
            elif c == 34
                if quoted and win_unit(p, i + 1) == 34
                    # `""` inside a quoted part is one literal quote and the part goes on (as in the CRT since 2008).
                    store8(out, 34)
                    out += 1
                    i += 2
                else
                    quoted = not quoted
                    i += 1
            elif (c == 32 or c == 9) and not quoted
                break
            else
                cp := win_cp(p, i)
                out = win_put(out, cp)
                i += win_width(cp)
        store8(out, 0)
        out += 1
        argc += 1
    store64(vec + 8 * argc, 0)
    # `envp` follows `argv`'s NULL, as on Linux. The per-drive entries that
    # start with `=` are not variables and are left out.
    mut ne := 0
    mut q := 0
    while e != 0 and win_unit(e, q) != 0
        start := out
        first := win_unit(e, q)
        while win_unit(e, q) != 0
            cp := win_cp(e, q)
            out = win_put(out, cp)
            q += win_width(cp)
        store8(out, 0)
        out += 1
        q += 1
        if first == 61
            out = start
        else
            store64(vec + 8 * (argc + 1) + 8 * ne, start)
            ne += 1
    store64(vec + 8 * (argc + 1) + 8 * ne, 0)
    store64(global(ARGC), argc)
    store64(global(ARGV), vec)

## The UTF-16 unit `i` of the NUL-terminated string at `p`.
fn win_unit(p int, i int) int
    load8(p + 2 * i) + 256 * load8(p + 2 * i + 1)

## The code point at unit `i`: a surrogate pair is one, a lone surrogate is U+FFFD.
fn win_cp(p int, i int) int
    c := win_unit(p, i)
    if c >= 55296 and c < 56320
        d := win_unit(p, i + 1)
        if d >= 56320 and d < 57344
            return 65536 + (c - 55296) * 1024 + (d - 56320)
        return 65533
    if c >= 56320 and c < 57344
        return 65533
    c

## How many UTF-16 units a code point took.
fn win_width(cp int) int
    if cp >= 65536
        return 2
    1

## Write `cp` as UTF-8 at `out`; the address after it.
fn win_put(out int, cp int) int
    if cp < 128
        store8(out, cp)
        return out + 1
    if cp < 2048
        store8(out, 192 + cp / 64)
        store8(out + 1, 128 + cp % 64)
        return out + 2
    if cp < 65536
        store8(out, 224 + cp / 4096)
        store8(out + 1, 128 + cp / 64 % 64)
        store8(out + 2, 128 + cp % 64)
        return out + 3
    store8(out, 240 + cp / 262144)
    store8(out + 1, 128 + cp / 4096 % 64)
    store8(out + 2, 128 + cp / 64 % 64)
    store8(out + 3, 128 + cp % 64)
    out + 4

## How much of the main stack a program may use: its size limit
## (`RLIMIT_STACK`, 3) less the reserve, capped at 1 GiB.
fn stack_use() int
    p := alloc(16, KIND_ATOMIC)
    t := target()
    if t == 2
        syscall(194, 3, p, 0, 0, 0, 0)
    else
        syscall(if t == 0 then 302 else 261, 0, 3, 0, p, 0, 0)
    mut size := load64(p)
    if size <= 0 or size > 1073741824
        size = STACK_DEFAULT
    if size > 2 * STACK_RESERVE then size - STACK_RESERVE else size / 2

## `copy_bytes` for blocks of 256 bytes or more (list growth and extension):
## 64 bytes per round with two moving pointers, then the short rest. It is
## not inlined, so `copy_bytes` stays small enough to be inlined at the many
## string sites that copy a few bytes (ADR 0391).
fn copy_big(dst int, src int, n int)
    mut d := dst
    mut s := src
    end := src + n - 63
    while s < end
        store64(d, load64(s))
        store64(d + 8, load64(s + 8))
        store64(d + 16, load64(s + 16))
        store64(d + 24, load64(s + 24))
        store64(d + 32, load64(s + 32))
        store64(d + 40, load64(s + 40))
        store64(d + 48, load64(s + 48))
        store64(d + 56, load64(s + 56))
        d += 64
        s += 64
    copy_bytes(d, s, src + n - s)

fn copy_bytes(dst int, src int, n int)
    mut i := 0
    while i + 32 <= n
        store64(dst + i, load64(src + i))
        store64(dst + i + 8, load64(src + i + 8))
        store64(dst + i + 16, load64(src + i + 16))
        store64(dst + i + 24, load64(src + i + 24))
        i += 32
    if n >= 8
        # Short copies are mostly tail: the last word is loaded first, so the
        # copy stays correct when `dst` lies below `src`, and stored last,
        # overlapping what the word loop wrote, instead of a byte loop.
        t := load64(src + n - 8)
        while i + 8 <= n
            store64(dst + i, load64(src + i))
            i += 8
        store64(dst + n - 8, t)
        return
    while i < n
        store8(dst + i, load8(src + i))
        i += 1

# ---- output (ADR 0408) ----

fn flush_to(fd int)
    n := load64(global(OUT_LEN))
    if n > 0
        sys_write(fd, load64(global(OUT_BUF)), n)
        store64(global(OUT_LEN), 0)

fn flush()
    fd := load64(global(OUT_FD))
    if fd == 2 or fd == 0 - 1
        flush_to(fd)
    else
        flush_to(1)

## Flush, then end the process.
fn exit(code int)
    err_report()
    flush()
    sys_exit(code)

fn out_byte(b int)
    mut n := load64(global(OUT_LEN))
    if n == OUT_CAP
        flush()
        n = 0
    store8(load64(global(OUT_BUF)) + n, b)
    store64(global(OUT_LEN), n + 1)

## Copy into the buffer in as few pieces as fit, flushing when it fills.
fn out_bytes(p int, n int)
    mut from := p
    mut left := n
    while left > 0
        mut used := load64(global(OUT_LEN))
        if used == OUT_CAP
            flush()
            used = 0
        room := OUT_CAP - used
        k := if left < room then left else room
        copy_bytes(load64(global(OUT_BUF)) + used, from, k)
        store64(global(OUT_LEN), used + k)
        from += k
        left -= k

## A string object: +0 bytes, +8 chars, +16 UTF-8 (native-abi.md §2).
fn out_str(s str)
    p := str_addr(s)
    out_bytes(p + 16, load64(p))

# ---- strings (type.str.*) ----

## A string object of `n` bytes, uninitialised, with `chars` characters.
fn str_new(n int, chars int) int
    p := alloc_raw(16 + n, KIND_STR)
    store64(p, n)
    store64(p + 8, chars)
    p

## `s.len()`: its characters.
fn str_len(s str) int
    load64(str_addr(s) + 8)

## `xs.join(sep)` for a list of strings.
fn list_join(xs List[int], sep str) str
    q := list_addr(xs)
    k := load64(q)
    items := load64(q + 16)
    sp := str_addr(sep)
    mut n := 0
    mut chars := 0
    for i in 0..k
        e := load64(items + 8 * i)
        n += load64(e)
        chars += load64(e + 8)
    if k > 1
        n += (k - 1) * load64(sp)
        chars += (k - 1) * load64(sp + 8)
    r := str_new(n, chars)
    mut at := r + 16
    for i in 0..k
        if i > 0
            copy_bytes(at, sp + 16, load64(sp))
            at += load64(sp)
        e := load64(items + 8 * i)
        copy_bytes(at, e + 16, load64(e))
        at += load64(e)
    str_at(r)

## UTF-8 bytes of the scalar value `c`.
fn char_width(c int) int
    if c < 128
        return 1
    if c < 2048
        return 2
    if c < 65536
        return 3
    4

## Write the UTF-8 of `c` at `p`; the address after it.
fn char_put(p int, c int) int
    w := char_width(c)
    if w == 1
        store8(p, c)
    elif w == 2
        store8(p, 192 + c / 64)
        store8(p + 1, 128 + c % 64)
    elif w == 3
        store8(p, 224 + c / 4096)
        store8(p + 1, 128 + c / 64 % 64)
        store8(p + 2, 128 + c % 64)
    else
        store8(p, 240 + c / 262144)
        store8(p + 1, 128 + c / 4096 % 64)
        store8(p + 2, 128 + c / 64 % 64)
        store8(p + 3, 128 + c % 64)
    p + w

## `print(xs.join(sep))` for a list of characters: the same text as
## `list_join_chars`, written straight into the output buffer.
fn out_join_chars(xs List[int], sep str)
    q := list_addr(xs)
    k := load64(q)
    items := load64(q + 16)
    sp := str_addr(sep)
    sn := load64(sp)
    if sn == 0
        str_out_chars(items, k)
        return
    for i in 0..k
        if i > 0 and sn > 0
            out_bytes(sp + 16, sn)
        mut used := load64(global(OUT_LEN))
        if OUT_CAP - used < 4
            flush()
            used = 0
        at := load64(global(OUT_BUF)) + used
        store64(global(OUT_LEN), used + char_put(at, load64(items + 8 * i)) - at)

## `print(xs.join(sep))` for a list of strings, written into the output buffer.
fn out_join(xs List[int], sep str)
    q := list_addr(xs)
    k := load64(q)
    items := load64(q + 16)
    sp := str_addr(sep)
    for i in 0..k
        if i > 0
            out_bytes(sp + 16, load64(sp))
        e := load64(items + 8 * i)
        out_bytes(e + 16, load64(e))

## `xs.join(sep)` for a list of characters (type.coll.9).
fn list_join_chars(xs List[int], sep str) str
    q := list_addr(xs)
    k := load64(q)
    items := load64(q + 16)
    sp := str_addr(sep)
    # No separator: optimistically store each character as a byte while
    # collecting its bits, in one pass. If every one is below 128 (ASCII) the
    # string is done; otherwise it is built again below.
    if load64(sp) == 0
        t := str_new(k, k)
        mut seen := 0
        for i in 0..k
            c := load64(items + 8 * i)
            seen = seen.bit_or(c)
            store8(t + 16 + i, c)
        if seen < 128
            return str_at(t)
    # One pass for the bits of every character: below 128 means all ASCII,
    # one byte each, so the width pass and `char_put` are skipped.
    mut bits := 0
    for i in 0..k
        bits = bits.bit_or(load64(items + 8 * i))
    mut n := k
    if bits >= 128
        n = 0
        for i in 0..k
            n += char_width(load64(items + 8 * i))
    if k > 1
        n += (k - 1) * load64(sp)
    chars := if k > 1 then k + (k - 1) * load64(sp + 8) else k
    r := str_new(n, chars)
    mut at := r + 16
    if bits < 128 and load64(sp) == 0
        for i in 0..k
            store8(at + i, load64(items + 8 * i))
        return str_at(r)
    for i in 0..k
        if i > 0
            copy_bytes(at, sp + 16, load64(sp))
            at += load64(sp)
        at = char_put(at, load64(items + 8 * i))
    str_at(r)

fn out_nl()
    out_byte(10)
    if line_buffered()
        flush()

## Decimal `n` written at address `at`, which has 48 bytes to use (24 for the
## window, 24 read past it); the count of bytes. It works on negative remainders so the smallest `int` needs no
## negation. The digits are produced from the end of that window, one
## division by 10 each, then moved down to `at` in three 8-byte pieces (the
## bytes after the number are scratch).
fn write_int(at int, n int) int
    mut v := if n < 0 then n else 0 - n
    mut q := at + 23
    store8(q, 48 - v % 10)
    v = v / 10
    while v != 0
        q -= 1
        r := v / 10
        store8(q, 48 + r * 10 - v)
        v = r
    if n < 0
        q -= 1
        store8(q, 45)
    store64(at, load64(q))
    store64(at + 8, load64(q + 8))
    store64(at + 16, load64(q + 16))
    at + 24 - q

fn out_int(n int)
    mut used := load64(global(OUT_LEN))
    if OUT_CAP - used < 48
        flush()
        used = 0
    store64(global(OUT_LEN), used + write_int(load64(global(OUT_BUF)) + used, n))

fn out_bool(b bool)
    if b
        out_byte(116)
        out_byte(114)
        out_byte(117)
        out_byte(101)
    else
        out_byte(102)
        out_byte(97)
        out_byte(108)
        out_byte(115)
        out_byte(101)

fn out_sep(i int)
    if i > 0
        out_byte(44)
        out_byte(32)

fn out_list_int(xs List[int])
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    out_byte(91)
    for i in 0..n
        out_sep(i)
        out_int(load64(data + 8 * i))
    out_byte(93)

## A `List[u8]`, `List[u16]` or `List[u32]`: `size` bytes per element (ADRs 0907, 0912).
fn out_list_n(xs List[int], size int)
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    out_byte(91)
    for i in 0..n
        out_sep(i)
        out_int(list_get_word(data, size, i))
    out_byte(93)

fn out_list_u8(xs List[int])
    out_list_n(xs, 1)

fn out_list_u16(xs List[int])
    out_list_n(xs, 2)

fn out_list_u32(xs List[int])
    out_list_n(xs, 4)

fn out_list_bool(xs List[int])
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    out_byte(91)
    for i in 0..n
        out_sep(i)
        out_bool(load8(data + i) != 0)
    out_byte(93)

fn out_list_float(xs List[int])
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    out_byte(91)
    for i in 0..n
        out_sep(i)
        out_float(loadf(data + 8 * i))
    out_byte(93)

fn out_list_f32(xs List[int])
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    out_byte(91)
    for i in 0..n
        out_sep(i)
        out_f32(loadf(data + 8 * i))
    out_byte(93)

## A string inside a printed value, in quotes, with `\\`, `"` and control
## characters escaped (trait.auto.2).
fn out_quoted(s str)
    p := str_addr(s)
    n := load64(p)
    data := p + 16
    out_byte(34)
    mut i := 0
    while i < n
        b := load8(data + i)
        if b == 92 or b == 34
            out_byte(92)
            out_byte(b)
        elif b == 10
            out_escape(110)
        elif b == 9
            out_escape(116)
        elif b == 13
            out_escape(114)
        elif b == 0
            out_escape(48)
        elif b < 32 or b == 127
            out_code(b)
        elif b == 194 and i + 1 < n and load8(data + i + 1) >= 128 and load8(data + i + 1) < 160
            # U+0080 to U+009F, the C1 controls.
            out_code(load8(data + i + 1))
            i += 1
        else
            out_byte(b)
        i += 1
    out_byte(34)

fn out_escape(c int)
    out_byte(92)
    out_byte(c)

## `\u{H}`, lowercase hex without leading zeros.
fn out_code(c int)
    out_byte(92)
    out_byte(117)
    out_byte(123)
    if c >= 16
        out_byte(hex_digit(c / 16))
    out_byte(hex_digit(c % 16))
    out_byte(125)

fn hex_digit(d int) int
    if d < 10 then 48 + d else 87 + d

## A list of lists or strings: `depth` levels of lists around elements of
## kind `leaf` (0 int, 1 float, 2 bool, 3 str, 4 char, 5 f32, 6 u8, 7 u16, 8 u32).
fn out_list_deep(xs List[int], depth int, leaf int)
    if depth == 0
        if leaf == 0
            out_list_int(xs)
        elif leaf == 1
            out_list_float(xs)
        elif leaf == 2
            out_list_bool(xs)
        elif leaf == 4
            out_list_char(xs)
        elif leaf == 5
            out_list_f32(xs)
        elif leaf == 6
            out_list_u8(xs)
        elif leaf == 7
            out_list_u16(xs)
        elif leaf == 8
            out_list_u32(xs)
        else
            p := list_addr(xs)
            data := load64(p + 16)
            out_byte(91)
            for i in 0..load64(p)
                out_sep(i)
                out_quoted(str_at(load64(data + 8 * i)))
            out_byte(93)
        return
    p := list_addr(xs)
    data := load64(p + 16)
    out_byte(91)
    for i in 0..load64(p)
        out_sep(i)
        out_list_deep(list_at(load64(data + 8 * i)), depth - 1, leaf)
    out_byte(93)

## Record the length a slice trap reports (kind 7).
fn note_len(n int)
    store64(global(TRAP_LEN), n)

## `xs[lo..hi]`, checked by the caller: a new list of `size`-byte elements.
fn list_slice(xs List[int], lo int, hi int, size int) List[int]
    p := list_addr(xs)
    n := hi - lo
    q := list_addr(list_alloc(n, size))
    copy_bytes(load64(q + 16), load64(p + 16) + size * lo, size * n)
    store64(q, n)
    list_at(q)

## A heap object of `size` bytes with its header word (native-abi.md §2);
## the pointer is to the first byte after the header.
fn obj_new(size int, kind int) int
    alloc(size, kind)

# ---- lists (native-abi.md §2) ----

## The kind of a list's element block: a `List[bool]`'s holds no pointers.
fn data_kind(size int) int
    if size < 8
        KIND_ATOMIC
    else
        KIND_LDATA

## A list object with room for `cap` elements: +0 len, +8 cap, +16 data.
## Elements are 8 bytes, but a `List[bool]`'s are 1 (`size`).
fn list_alloc(cap int, size int) List[int]
    p := alloc(24, KIND_LIST)
    # Exactly `cap` (at least 1): a one-element list is a 16-byte block, not 48.
    c := if cap < 1 then 1 else cap
    store64(p + 8, c)
    store64(p + 16, alloc_raw(size * c, data_kind(size)))
    list_at(p)

fn list_new(cap int) List[int]
    list_alloc(cap, 8)

## The most elements `list_new_for` and `list_reserve` make room for: 256 MiB
## worth of them, whatever their size (ADR 1064; it was 8 MiB, so a 150 M
## `List[bool]` filled by pushes regrew five times, copying 248 MB).
fn list_most(size int) int
    if size == 8
        return 33554432
    if size == 1
        return 268435456
    if size == 2
        return 134217728
    67108864

## A list made with room for a loop's pushes (`list_reserve` would regrow
## it): `(hi - lo) * per` elements of `size` bytes, at most 256 MiB of
## iterations' worth (2^25 words, 2^28 bytes).
## `n` elements from `p` set to `v` (its low byte when `size` is 1): what the
## compiler turns a loop that stores one unchanging value into (ADR 0816).
## x86-64 assembles this as `rep stos` (x64/kernels.ail); this body is the
## reference and what ARM64 runs.
fn fill(p int, n int, v int, size int)
    if size == 8
        for i in 0..n
            store64(p + 8 * i, v)
        return
    b := v.bit_and(255)
    mut w := b.bit_or(b.shl(8))
    w = w.bit_or(w.shl(16))
    w = w.bit_or(w.shl(32))
    mut i := 0
    while i + 8 <= n
        store64(p + i, w)
        i += 8
    while i < n
        store8(p + i, b)
        i += 1

fn list_new_for(lo int, hi int, per int, size int) List[int]
    mut want := hi - lo
    most := list_most(size)
    if want > most
        want = most
    if want < 0
        want = 0
    list_alloc(want * per, size)

fn copy_list(dst int, src int, n int)
    if n >= 256
        copy_big(dst, src, n)
    else
        copy_bytes(dst, src, n)

fn list_grow(p int, size int)
    old := load64(p + 8)
    mut cap := old * 2
    if old < 4
        cap = 4
    elif old < 8
        cap = 16
    data := alloc_raw(size * cap, data_kind(size))
    copy_list(data, load64(p + 16), size * load64(p))
    store64(p + 8, cap)
    store64(p + 16, data)

## Room for `(hi - lo) * per` more elements of `size` bytes, at most
## 256 MiB worth of them, called before a loop that pushes that many (ADR 0578).
## Only the capacity changes. A list that is full grows to at least twice its
## capacity, so a reserve called once per iteration of an outer loop copies
## the list O(log n) times, not once per iteration (ADR 0890).
fn list_reserve(xs List[int], lo int, hi int, per int, size int)
    if hi <= lo
        return
    p := list_addr(xs)
    mut want := hi - lo
    most := list_most(size)
    if want > most
        want = most
    need := load64(p) + want * per
    if need <= load64(p + 8)
        return
    mut cap := need
    if cap < 2 * load64(p + 8)
        cap = 2 * load64(p + 8)
    data := alloc_raw(size * cap, data_kind(size))
    copy_list(data, load64(p + 16), size * load64(p))
    store64(p + 8, cap)
    store64(p + 16, data)

## The shortest length among the rows of a list of lists (2^62 if there are
## none), called before a loop nest that only reads them (ADR 0611).
fn list_rows_min(xs List[int]) int
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    mut least := 4611686018427387904
    for i in 0..n
        k := load64(load64(data + 8 * i))
        if k < least
            least = k
    least

## The slow paths of `push`: the code generator stores in place while the
## list has room, and calls these when it is full.
fn list_push(xs List[int], v int)
    p := list_addr(xs)
    n := load64(p)
    if n == load64(p + 8)
        list_grow(p, 8)
    store64(load64(p + 16) + 8 * n, v)
    store64(p, n + 1)

fn list_pushf(xs List[int], x float)
    list_push(xs, float_bits(x))

## `b` is a `bool` (0 or 1) or a `u8` (0 to 255): one byte either way. The code
## generators inline a push of `rt.list_pushb`, `rt.list_pushw` or
## `rt.list_pushd` by the callee's width (ADRs 0907, 0912), whatever the pushed
## value's type; these are the slow paths that grow the list.
fn list_pushb(xs List[int], b u8)
    p := list_addr(xs)
    n := load64(p)
    if n == load64(p + 8)
        list_grow(p, 1)
    store8(load64(p + 16) + n, b.to_int())
    store64(p, n + 1)

## `xs.push(b)` on a `List[u16]`.
fn list_pushw(xs List[int], b u16)
    p := list_addr(xs)
    n := load64(p)
    if n == load64(p + 8)
        list_grow(p, 2)
    narrow_set(load64(p + 16) + 2 * n, 2, b.to_int())
    store64(p, n + 1)

## `xs.push(b)` on a `List[u32]`.
fn list_pushd(xs List[int], b u32)
    p := list_addr(xs)
    n := load64(p)
    if n == load64(p + 8)
        list_grow(p, 4)
    narrow_set(load64(p + 16) + 4 * n, 4, b.to_int())
    store64(p, n + 1)

fn list_copy(xs List[int], size int) List[int]
    p := list_addr(xs)
    n := load64(p)
    q := list_addr(list_alloc(n, size))
    copy_bytes(load64(q + 16), load64(p + 16), size * n)
    store64(q, n)
    list_at(q)

## A copy of `xs` and of the lists in it, `depth` levels down; the innermost
## lists' elements are `size` bytes.
fn list_copy_deep(xs List[int], depth int, size int) List[int]
    ys := list_copy(xs, 8)
    q := list_addr(ys)
    items := load64(q + 16)
    for i in 0..load64(q)
        inner := list_at(load64(items + 8 * i))
        c := if depth > 1 then list_copy_deep(inner, depth - 1, size) else list_copy(inner, size)
        store64(items + 8 * i, list_addr(c))
    ys

# ---- arguments and parsing (std.env.1, type.str.*) ----

## `env.args()`: the words after the program's name, as string objects.
fn args() List[int]
    mut out := List[int]()
    argv := load64(global(ARGV))
    for i in 1..load64(global(ARGC))
        c := load64(argv + 8 * i)
        mut n := 0
        while load8(c + n) != 0
            n += 1
        mut chars := 0
        for k in 0..n
            if load8(c + k).bit_and(192) != 128
                chars += 1
        s := str_new(n, chars)
        copy_bytes(s + 16, c, n)
        out.push(s)
    out

## `s.to_int()`: an optional `-` then decimal digits that fit in `int`;
## `parse_ok()` says whether the last call succeeded.
fn str_to_int(s str) int
    p := str_addr(s)
    n := load64(p)
    store64(parse_ok_addr(), 0)
    neg := n > 0 and load8(p + 16) == 45
    mut i := if neg then 1 else 0
    if i >= n
        return 0
    # Accumulate the negative value, which reaches the smallest `int`.
    mut v := 0
    while i < n
        d := load8(p + 16 + i) - 48
        if d < 0 or d > 9
            return 0
        if v < -922337203685477580 or v == -922337203685477580 and d > 8
            return 0
        v = v * 10 - d
        i += 1
    if not neg
        if v == -9223372036854775807 - 1
            return 0
        v = 0 - v
    store64(parse_ok_addr(), 1)
    v

fn parse_ok() bool
    load64(parse_ok_addr()) != 0

# ---- traps (ADR 0405) ----

## Print a trap and exit 1. `head` is `PATH:LINE:COL: trap[RULE]: `, `tail`
## the source excerpt; `kind` picks the message, finished with `a`, `b`
## and the operator `op` (native-abi.md §7).
fn trap(kind int, a int, b int, head str, op str, tail str)
    # In a task a trap ends the task, not the process (conc.task.6).
    on_trap(kind, a, b, head, op, tail)
    # Cleanups first, not on an exhausted stack (unwind.ail).
    if kind != 11
        unwind_run()
    flush()
    out_str(head)
    trap_body(kind, a, b, op)
    out_byte(10)
    trap_tail(tail)
    trace_frames(tail)
    flush_to(2)
    sys_exit(1)

## The message of a trap, after `head`.
fn trap_body(kind int, a int, b int, op str)
    if kind == 0
        # `a OP b` overflows `int` (expr.arith.1)
        out_byte(96)
        out_int(a)
        out_byte(32)
        out_str(op)
        out_byte(32)
        out_int(b)
        out_str("` overflows `int`")
    elif kind == 1
        out_str("division by zero in `")
        out_int(a)
        out_byte(32)
        out_str(op)
        out_byte(32)
        out_int(b)
        out_byte(96)
    elif kind == 2
        out_str("`-(")
        out_int(a)
        out_str(")` overflows `int`")
    elif kind == 3
        out_str("index ")
        out_int(a)
        out_str(" is out of bounds for a list of length ")
        out_int(b)
    elif kind == 4
        out_byte(96)
        out_float(bits_float(a))
        out_str("` doesn't fit in `int`")
    elif kind == 5
        out_str("`(")
        out_int(a)
        out_str(").abs()` overflows `int`")
    elif kind == 6
        out_str("shift count `")
        out_int(a)
        out_str("` is outside `0..=63`")
    elif kind == 7
        # `xs[a..b]` (type.coll.4); `op` is `..` or `..=`.
        out_str("slice ")
        out_int(a)
        out_str(op)
        out_int(b)
        out_str(" is out of bounds for a list of length ")
        out_int(load64(global(TRAP_LEN)))
    elif kind == 8
        # `xs.insert(a, x)` on a list of length `b` (type.coll.4).
        out_str("insert index ")
        out_int(a)
        out_str(" is out of bounds for a list of length ")
        out_int(b)
    elif kind == 9
        # io.exit(a) outside 0 to 255 (std.io.4)
        out_str("exit status ")
        out_int(a)
        out_str(" is outside 0 to 255")
    elif kind == 15
        # A runtime-built message: `a` is a string object (std.tensor.*)
        out_str(str_at(a))
    elif kind == 10
        # time.sleep_ms(a) with a negative a (std.time.2)
        out_str("can't sleep for ")
        out_int(a)
        out_str(" milliseconds")
    elif kind == 11
        # A call with the stack nearly exhausted (err.trap.1); `op` is
        # the callee.
        out_str("call depth exceeded the native stack in `")
        out_str(op)
        out_byte(96)
    elif kind == 12
        # `b[a]` of `bytes` (type.bytes.3); `b` is the length.
        out_str("index ")
        out_int(a)
        out_str(" is out of bounds for bytes of length ")
        out_int(b)
    elif kind == 13
        out_str("slice ")
        out_int(a)
        out_str(op)
        out_int(b)
        out_str(" is out of bounds for bytes of length ")
        out_int(load64(global(TRAP_LEN)))
    elif kind == 14
        # `unreachable(message)` (err.model.2): `a` is the message
        out_str("unreachable: ")
        out_str(str_at(a))
    elif kind == 18
        # A contract or `assert` failure in a task: `a` is the message.
        out_str(str_at(a))
    elif kind == 17
        # `unreachable("RULE: why")` in a std module: `head` ends at `trap[`.
        trap_rule_message(str_at(a))
    elif kind == 16
        # `Atomic.add` leaves `int` (conc.atomic.5, ADR 0600)
        out_str("atomic add overflows: ")
        out_int(a)
        out_str(" + ")
        out_int(b)
        out_str(" is outside int")

## `RULE: why` as `RULE]: why`, after a head that ends at `trap[`; a message
## with no `: ` is `err.model.2`'s.
fn trap_rule_message(msg str)
    base := str_addr(msg)
    n := load64(base)
    mut at := -1
    mut k := 0
    while k + 1 < n and at < 0
        if load8(base + 16 + k) == 58 and load8(base + 16 + k + 1) == 32
            at = k
        k += 1
    if at < 0
        out_str("err.model.2]: unreachable: ")
        out_str(msg)
        return
    for j in 0..at
        out_byte(load8(base + 16 + j))
    out_str("]: ")
    for j in at + 2..n
        out_byte(load8(base + 16 + j))

## A contract trap is written in pieces (ADR 0612): `trap_begin` flushes
## the output and writes the head, the message follows with the `out_*`
## functions, and `trap_end` writes the excerpt and exits.
fn trap_begin(head str)
    if worker_index() >= 0
        # In a task the piece is kept, not written: the output lock is held
        # until `trap_end` records the whole text with the task (conc.task.6).
        out_lock()
        flush()
        out_str(head)
        return
    unwind_run()
    flush()
    out_str(head)

fn trap_end(tail str)
    if worker_index() >= 0
        trap_end_in_task(tail)
    out_byte(10)
    trap_tail(tail)
    trace_frames(tail)
    flush_to(2)
    sys_exit(1)

## `trap_end` in a task: the text since `trap_begin` is the head up to `]: `
## and the message; the task ends with it as a trap of kind 18.
fn trap_end_in_task(tail str)
    base := load64(global(OUT_BUF))
    n := load64(global(OUT_LEN))
    mut at := 0
    while at + 3 <= n
        and not (load8(base + at) == 93 and load8(base + at + 1) == 58 and load8(base + at + 2) == 32)
        at += 1
    head := os_str_from(base, at + 3)
    msg := os_str_from(base + at + 3, n - at - 3)
    store64(global(OUT_LEN), 0)
    on_trap(18, str_addr(msg), 0, head, "", tail)

## The end of a trap whose excerpt and `values:` line are already written (`--values`):
## `tail` is the trapping frame's line; `extra` the lines written since the message.
fn trap_rest(tail str, extra int)
    trap_tail(tail)
    trace_frames_n(1 + extra)
    flush_to(2)
    sys_exit(1)

## A failure of the runtime itself: out of memory (run.limit.2).
fn fail(kind int, a int, b int)
    flush()
    out_str("trap[run.limit.2]: out of memory\n")
    flush_to(2)
    sys_exit(1)
