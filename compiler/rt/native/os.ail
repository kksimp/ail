## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The operating-system layer of the native runtime (ADRs 0580-0582):
## `std.fs`, `std.env`, `std.io` and `std.time` by direct system calls, with
## no libc (native-abi.md §4). Each operation is `os_NAME`, which records its
## outcome in `os_ok()` and `os_kind()` (the `fs.IoError.kind` of std.err.1,
## the same on every platform), and a wrapper `NAME` the lowering calls: a
## failing `fs_*` sets the error slot to the display text of an
## `fs.IoError` (err.text.1) and returns zero; `env_get`, `env_home` and
## `io_read_line` return the string, or 0 for `none`.
##
## Linux x86-64, Linux ARM64 and macOS ARM64 (`target()` 0, 1, 2). On Windows
## (`target()` 3) the primitives below call `win.ail`, and `os_pick` gives the
## Linux x86-64 numbers and flag values that layer takes.

# Global slots 32-47 are this file's (native-abi.md §2 lists the ranges).
# Slots 32 and 33 held the status before it moved into the per-thread area.
OS_AREA := 34
OUT_FD := 35
IN_BUF := 36
IN_POS := 37
IN_LEN := 38
OUT_TTY := 39

# Offsets in the scratch area (OS_AREA), allocated on first use.
OS_PATH_A := 0
OS_PATH_B := 4096
OS_TMP := 8192
OS_DENTS := 12288
OS_DENTS_SIZE := 32768
OS_AREA_SIZE := 65536
# The status words of `os_ok` and `os_kind`, after win.ail's offsets.
OS_ST_OK := 65024
OS_ST_ERR := 65032
OS_PATH_MAX := 4095
OS_IN_SIZE := 65536

# `fs.IoError.kind` codes (std.err.1).
K_NOT_FOUND := 1
K_PERMISSION := 2
K_EXISTS := 3
K_IS_DIR := 4
K_NOT_DIR := 5
K_NOT_EMPTY := 6
K_INVALID_UTF8 := 7
K_OTHER := 10

# ---- system calls: one name per operation, three numbers (native-abi.md §4) ----

fn os_pick(x64 int, a64 int, mac int) int
    t := target()
    if t == 0 or t == 3
        return x64
    if t == 1
        return a64
    mac

## `-errno` or a non-negative result.
fn os_open(path int, flags int, mode int) int
    if target() == 3
        return win_open(path, flags, mode)
    if target() == 2
        return syscall(5, path, flags, mode, 0, 0, 0)
    syscall(os_pick(257, 56, 0), -100, path, flags, mode, 0, 0)

fn os_close(fd int) int
    if target() == 3
        return win_close(fd)
    syscall(os_pick(3, 57, 6), fd, 0, 0, 0, 0, 0)

fn os_read(fd int, p int, n int) int
    if target() == 3
        return win_read(fd, p, n)
    syscall(os_pick(0, 63, 3), fd, p, n, 0, 0, 0)

fn os_lseek(fd int, off int, whence int) int
    if target() == 3
        return win_lseek(fd, off, whence)
    syscall(os_pick(8, 62, 199), fd, off, whence, 0, 0, 0)

fn os_access(path int) int
    if target() == 3
        return win_access(path)
    if target() == 2
        return syscall(33, path, 0, 0, 0, 0, 0)
    syscall(os_pick(269, 48, 0), -100, path, 0, 0, 0, 0)

fn os_mkdir(path int) int
    if target() == 3
        return win_mkdir(path)
    if target() == 2
        return syscall(136, path, 511, 0, 0, 0, 0)
    syscall(os_pick(258, 34, 0), -100, path, 511, 0, 0, 0)

## A file, or with `dir` an empty directory.
fn os_unlink(path int, dir bool) int
    if target() == 3
        return win_unlink(path, dir)
    if target() == 2
        return syscall(if dir then 137 else 10, path, 0, 0, 0, 0, 0)
    syscall(os_pick(263, 35, 0), -100, path, if dir then 512 else 0, 0, 0, 0)

fn os_rename(from int, to int) int
    if target() == 3
        return win_rename(from, to)
    if target() == 2
        return syscall(128, from, to, 0, 0, 0, 0)
    syscall(os_pick(264, 38, 0), -100, from, -100, to, 0, 0)

## Directory entries into `buf`: Linux `getdents64`, macOS `getdirentries64`.
fn os_getdents(fd int, buf int, n int) int
    if target() == 3
        return win_getdents(fd, buf, n)
    if target() == 2
        return syscall(344, fd, buf, n, os_scratch(OS_TMP + 64), 0, 0)
    syscall(os_pick(217, 61, 0), fd, buf, n, 0, 0, 0)

## `fstat` of `fd` into `buf`; the fields the runtime reads are at the offsets
## `os_pick` names (Windows fills the Linux x86-64 ones).
fn os_fstat(fd int, buf int) int
    if target() == 3
        return win_fstat(fd, buf)
    syscall(os_pick(5, 80, 189), fd, buf, 0, 0, 0, 0)

## `open` flags: 0 read, 1 create and truncate for writing, 2 create and append.
fn os_open_flags(mode int) int
    if mode == 0
        return 0
    mac := target() == 2
    if mode == 1
        return if mac then 1537 else 577
    if mac then 521 else 1089

# ---- status ----

## The outcome of this thread's last operation (its scratch area holds it).
fn os_ok() bool
    load64(os_scratch(OS_ST_OK)) != 0

fn os_kind() int
    load64(os_scratch(OS_ST_ERR))

## `fs.IoError.kind` for an `errno`, the same on every platform.
fn os_errno_kind(e int) int
    if e == 2
        return K_NOT_FOUND
    if e == 13 or e == 1
        return K_PERMISSION
    if e == 17
        return K_EXISTS
    if e == 21
        return K_IS_DIR
    if e == 20
        return K_NOT_DIR
    if e == os_pick(39, 39, 66)
        return K_NOT_EMPTY
    K_OTHER

## The kind's name, for an `fs.IoError` value.
fn kind_name(k int) str
    if k == K_NOT_FOUND
        return "not_found"
    if k == K_PERMISSION
        return "permission"
    if k == K_EXISTS
        return "exists"
    if k == K_IS_DIR
        return "is_dir"
    if k == K_NOT_DIR
        return "not_dir"
    if k == K_NOT_EMPTY
        return "not_empty"
    if k == K_INVALID_UTF8
        return "invalid_utf8"
    "other"

fn os_succeed()
    store64(os_scratch(OS_ST_OK), 1)
    store64(os_scratch(OS_ST_ERR), 0)

fn os_fail_kind(k int)
    store64(os_scratch(OS_ST_OK), 0)
    store64(os_scratch(OS_ST_ERR), k)

## Record a failed call; `r` is its negative result.
fn os_fail_errno(r int)
    os_fail_kind(os_errno_kind(0 - r))

# ---- scratch memory and paths ----

## The address `off` bytes into this thread's scratch area (paths, directory
## entries, small results and the status words; no allocation per call).
## Every thread slot has its own area, mapped outside the heap on first use,
## so tasks on different workers never share a path or a status (conc.race.1:
## one shared area let a task open another task's file). `OS_AREA` holds the
## table of areas, one word per slot; a thread that loses the race to install
## the table leaves its copy unused.
fn os_scratch(off int) int
    mut tab := atomic_load(global(OS_AREA))
    if tab == 0
        mine := sys_mmap(8 * (MAXW + 1))
        prev := atomic_cas(global(OS_AREA), 0, mine)
        tab = if prev == 0 then mine else prev
    cell := tab + 8 * thread_slot()
    mut a := load64(cell)
    if a == 0
        a = sys_mmap(OS_AREA_SIZE)
        store64(cell, a)
    a + off

## `s` as a NUL-terminated path in the scratch slot at `off`, or 0 when it
## doesn't fit or holds a NUL.
fn os_cstr(off int, s str) int
    p := str_addr(s)
    n := load64(p)
    if n > OS_PATH_MAX or n == 0
        return 0
    d := os_scratch(off)
    copy_bytes(d, p + 16, n)
    store8(d + n, 0)
    for i in 0..n
        if load8(d + i) == 0
            return 0
    d

## The length of the C string at `p`.
fn os_c_len(p int) int
    mut n := 0
    while load8(p + n) != 0
        n += 1
    n

## A string object of `n` bytes copied from `p`, with its characters counted.
fn os_str_from(p int, n int) str
    mut chars := 0
    for i in 0..n
        if load8(p + i).bit_and(192) != 128
            chars += 1
    s := str_new(n, chars)
    copy_bytes(s + 16, p, n)
    str_at(s)

## The characters of `n` UTF-8 bytes at `p`, or -1 when they aren't UTF-8
## (the shortest encodings, no surrogates, nothing above U+10FFFF).
fn os_utf8_chars(p int, n int) int
    mut i := 0
    mut chars := 0
    while i < n
        # Eight ASCII bytes at a time.
        while i + 8 <= n and load64(p + i).bit_and(-9187201950435737472) == 0
            i += 8
            chars += 8
        if i >= n
            break
        c := load8(p + i)
        if c < 128
            i += 1
        elif c >= 194 and c <= 223
            if i + 1 >= n or load8(p + i + 1).bit_and(192) != 128
                return -1
            i += 2
        elif c >= 224 and c <= 239
            if i + 2 >= n
                return -1
            c1 := load8(p + i + 1)
            c2 := load8(p + i + 2)
            if c1.bit_and(192) != 128 or c2.bit_and(192) != 128
                return -1
            if (c == 224 and c1 < 160) or (c == 237 and c1 > 159)
                return -1
            i += 3
        elif c >= 240 and c <= 244
            if i + 3 >= n
                return -1
            c1 := load8(p + i + 1)
            if load8(p + i + 2).bit_and(192) != 128 or load8(p + i + 3).bit_and(192) != 128
                return -1
            if c1.bit_and(192) != 128 or (c == 240 and c1 < 144) or (c == 244 and c1 > 143)
                return -1
            i += 4
        else
            return -1
        chars += 1
    chars

## Bytes of `a` against `b`, by byte value: -1, 0 or 1.
fn os_str_cmp(a int, b int) int
    na := load64(a)
    nb := load64(b)
    n := if na < nb then na else nb
    for i in 0..n
        x := load8(a + 16 + i)
        y := load8(b + 16 + i)
        if x != y
            return if x < y then -1 else 1
    if na == nb
        return 0
    if na < nb then -1 else 1

# ---- std.fs ----

## `fs.exists(path)` (std.fs.4).
fn fs_exists(path str) bool
    if stub_file_has(path)
        return true
    pol_fs(path, false, "fs.exists")
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        return false
    os_access(p) == 0

## Everything readable from `fd`, as a string object whose `bytes` is its
## length (`chars` is left for the caller); a negative `errno` on failure.
fn os_read_fd(fd int) int
    mut cap := 65536
    size := os_lseek(fd, 0, 2)
    # A directory reports a huge size; trust only a plausible one.
    if size >= 0
        os_lseek(fd, 0, 0)
        if size > 0 and size < 1073741824
            cap = size + 1
    mut s := str_new(cap, 0)
    mut n := 0
    while true
        if n == cap
            cap = cap * 2
            t := str_new(cap, 0)
            copy_bytes(t + 16, s + 16, n)
            s = t
        r := os_read(fd, s + 16 + n, cap - n)
        if r == -4
            continue
        if r < 0
            return r
        if r == 0
            break
        n += r
    store64(s, n)
    s

## `fs.read_text(path)` (std.fs.1): the file, or "" with `os_ok()` false and
## the kind `not_found`, `is_dir`, `invalid_utf8`...
fn os_fs_read_text(path str) str
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        return ""
    fd := os_open(p, 0, 0)
    if fd < 0
        os_fail_errno(fd)
        return ""
    s := os_read_fd(fd)
    os_close(fd)
    if s < 0
        os_fail_errno(s)
        return ""
    chars := os_utf8_chars(s + 16, load64(s))
    if chars < 0
        os_fail_kind(K_INVALID_UTF8)
        return ""
    store64(s + 8, chars)
    os_succeed()
    str_at(s)

## `fs.read_bytes(path)` (std.fs.13): the file as it is, with no UTF-8 check.
fn os_fs_read_bytes(path str) str
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        return ""
    fd := os_open(p, 0, 0)
    if fd < 0
        os_fail_errno(fd)
        return ""
    s := os_read_fd(fd)
    os_close(fd)
    if s < 0
        os_fail_errno(s)
        return ""
    store64(s + 8, load64(s))
    os_succeed()
    str_at(s)

## Write all of `s` to `fd`; 0, or a negative `errno`.
fn os_write_all(fd int, p int, n int) int
    mut done := 0
    while done < n
        r := if target() == 3 then win_write(fd, p + done, n - done) else syscall(
            os_pick(1, 64, 4),
            fd,
            p + done,
            n - done,
            0,
            0,
            0,
        )
        if r == -4
            continue
        if r < 0
            return r
        done += r
    0

## `fs.write_text` (std.fs.2, mode 1) and `fs.append_text` (std.fs.3, mode 2).
fn os_write_file(path str, text str, mode int)
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        return
    fd := os_open(p, os_open_flags(mode), 438)
    if fd < 0
        os_fail_errno(fd)
        return
    t := str_addr(text)
    r := os_write_all(fd, t + 16, load64(t))
    os_close(fd)
    if r < 0
        os_fail_errno(r)
        return
    os_succeed()

fn os_fs_write_text(path str, text str)
    os_write_file(path, text, 1)

fn os_fs_append_text(path str, text str)
    os_write_file(path, text, 2)

## Shell sort of the string pointers in `data[0..n]` by bytes.
fn os_sort_names(data int, n int)
    mut gap := n / 2
    while gap > 0
        for i in gap..n
            v := load64(data + 8 * i)
            mut j := i
            while j >= gap and os_str_cmp(load64(data + 8 * (j - gap)), v) > 0
                store64(data + 8 * j, load64(data + 8 * (j - gap)))
                j -= gap
            store64(data + 8 * j, v)
        gap = gap / 2

## `fs.list_dir(path)` (std.fs.5): the entry names, sorted by their bytes.
fn os_fs_list_dir(path str) List[int]
    mut out := List[int]()
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        return out
    # O_DIRECTORY (Linux x86-64 0o200000, Linux ARM64 0o40000, macOS 0x100000), so a regular file fails here with ENOTDIR on every
    # platform (XNU's getdirentries64 would say EINVAL, which is `other`).
    fd := os_open(p, os_pick(65536, 16384, 1048576), 0)
    if fd < 0
        os_fail_errno(fd)
        return out
    buf := os_scratch(OS_DENTS)
    mac := target() == 2
    while true
        n := os_getdents(fd, buf, OS_DENTS_SIZE)
        if n == -4
            continue
        if n < 0
            os_close(fd)
            os_fail_errno(n)
            return out
        if n == 0
            break
        mut at := 0
        while at < n
            e := buf + at
            off := if mac then 21 else 19
            name := e + off
            len := os_c_len(name)
            dots := os_name_is_dots(name, len)
            if not dots
                s := os_str_from(name, len)
                out.push(str_addr(s))
            at += load8(e + 16) + load8(e + 17) * 256
    os_close(fd)
    os_succeed()
    q := list_addr(out)
    os_sort_names(load64(q + 16), load64(q))
    out

fn os_name_is_dots(name int, len int) bool
    if len == 1
        return load8(name) == 46
    len == 2 and load8(name) == 46 and load8(name + 1) == 46

## `fs.remove(path)` (std.fs.6): a file, or an empty directory.
fn os_fs_remove(path str)
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        return
    mut r := os_unlink(p, false)
    # A directory: Linux says EISDIR, macOS EPERM.
    if r == -21 or (r == -1 and target() == 2)
        r = os_unlink(p, true)
    if r < 0
        os_fail_errno(r)
        return
    os_succeed()

## Whether `p` names a directory: reading a directory fails with EISDIR.
fn os_is_dir_at(p int) bool
    fd := os_open(p, 0, 0)
    if fd < 0
        return false
    r := os_read(fd, os_scratch(OS_TMP), 1)
    os_close(fd)
    r == -21

## `fs.make_dir(path)` (std.fs.7): the directory and any missing parents; an
## existing directory is not a failure.
fn os_fs_make_dir(path str)
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        return
    n := os_c_len(p)
    for i in 1..n
        if load8(p + i) == 47
            store8(p + i, 0)
            os_mkdir(p)
            store8(p + i, 47)
    r := os_mkdir(p)
    if r == -17 and os_is_dir_at(p)
        os_succeed()
        return
    if r < 0
        os_fail_errno(r)
        return
    os_succeed()

## `fs.rename(from, to)` (std.fs.11). A failure's kind is `from`'s when
## `from` is missing; the path to report is the caller's (`rename_failed_on_from`).
fn os_fs_rename(from str, to str)
    a := os_cstr(OS_PATH_A, from)
    b := os_cstr(OS_PATH_B, to)
    if a == 0 or b == 0
        os_fail_kind(K_NOT_FOUND)
        return
    r := os_rename(a, b)
    if r < 0
        os_fail_errno(r)
        return
    os_succeed()

# ---- std.env ----

## The environment vector: after `argv`'s NULL (native-abi.md §3).
fn os_envp() int
    load64(global(ARGV)) + 8 * (load64(global(ARGC)) + 1)

## Windows variable names are case-insensitive (`Path` is `PATH`): fold ASCII
## capitals there; other targets compare bytes as they are.
fn os_env_fold(b int) int
    if target() == 3 and b >= 65 and b <= 90
        return b + 32
    b

## `env.get(name)` (std.env.2): "" with `os_ok()` false when unset or not UTF-8.
fn os_env_get(name str) str
    q := str_addr(name)
    n := load64(q)
    mut e := os_envp()
    while load64(e) != 0
        c := load64(e)
        mut same := true
        mut i := 0
        while same and i < n
            if os_env_fold(load8(c + i)) != os_env_fold(load8(q + 16 + i))
                same = false
            i += 1
        # Read the `=` last: a short variable at the top of the stack ends before `c + n`.
        if same and load8(c + n) == 61
            len := os_c_len(c + n + 1)
            if os_utf8_chars(c + n + 1, len) < 0
                break
            os_succeed()
            return os_str_from(c + n + 1, len)
        e += 8
    os_fail_kind(K_NOT_FOUND)
    ""

## `env.vars()` (std.env.5): the variables whose names and values are UTF-8,
## as a `Map[str, str]` in name order (byte order).
fn env_vars() int
    pol := pol_env_vars_begin()
    m := map_new(1, 0, 0)
    names := list_new(16)
    mut e := os_envp()
    while load64(e) != 0
        c := load64(e)
        len := os_c_len(c)
        mut eq := 0
        while eq < len and load8(c + eq) != 61
            eq += 1
        if eq < len and os_utf8_chars(c, eq) >= 0 and os_utf8_chars(c + eq + 1, len - eq - 1) >= 0
            nm := os_str_from(c, eq)
            if target() == 3
                # Windows names are case-insensitive (std.env.5): the map spells them in capitals, as Python's `os.environ` does.
                a := str_addr(nm) + 16
                for b in 0..eq
                    x := load8(a + b)
                    if x >= 97 and x <= 122
                        store8(a + b, x - 32)
            list_push(names, str_addr(nm))
        e += 8
    q := list_addr(names)
    data := load64(q + 16)
    n := load64(q)
    mut i := 1
    while i < n
        x := load64(data + 8 * i)
        mut j := i
        while j > 0 and str_cmp(str_at(load64(data + 8 * (j - 1))), str_at(x)) > 0
            store64(data + 8 * j, load64(data + 8 * (j - 1)))
            j -= 1
        store64(data + 8 * j, x)
        i += 1
    for k in 0..n
        name := str_at(load64(data + 8 * k))
        if not pol_env_visible(pol, name)
            continue
        v := os_env_get(name)
        map_set(m, str_addr(name), str_addr(v))
    os_succeed()
    m

## `env.home()` (std.env.6): `HOME`, else `USERPROFILE`, when not empty.
fn os_env_home() str
    h := os_env_get("HOME")
    if os_ok() and h.len() > 0
        return h
    u := os_env_get("USERPROFILE")
    if os_ok() and u.len() > 0
        return u
    os_fail_kind(K_NOT_FOUND)
    ""

## `env.program()` (std.env.4): the program's path as it was given.
fn env_program() str
    if target() == 3
        # Windows has no `exec -a`: `ail.ps1 run` names the source file in AIL_RUN_FILE, as ./ail does with argv[0].
        given := os_env_get("AIL_RUN_FILE")
        if os_ok() and given.len() > 0
            return given
    c := load64(load64(global(ARGV)))
    os_str_from(c, os_c_len(c))

## `env.cwd()` (std.env.3). Traps when it can't be read.
fn env_cwd() str
    buf := os_scratch(OS_TMP)
    mut r := 0
    if target() == 3
        r = win_getcwd(buf)
    elif target() == 2
        # No `getcwd` call: open "." and ask for its path (F_GETPATH).
        dot := os_scratch(OS_PATH_A)
        store8(dot, 46)
        store8(dot + 1, 0)
        fd := os_open(dot, 0, 0)
        if fd < 0
            r = fd
        else
            r = syscall(92, fd, 50, buf, 0, 0, 0)
            os_close(fd)
            # F_GETPATH still names a removed directory: check it exists.
            if r >= 0 and os_access(buf) == 0
                r = os_c_len(buf) + 1
            else
                r = -1
    else
        r = syscall(os_pick(79, 17, 0), buf, 4096, 0, 0, 0, 0)
    if r <= 0
        flush()
        out_str("trap[std.env.3]: can't read the working directory\n")
        flush_to(2)
        sys_exit(1)
    os_str_from(buf, r - 1)

# ---- std.time ----

## `time.now_ms()` (std.time.1): milliseconds since 1970-01-01T00:00:00Z.
fn time_now_ms() int
    stubbed := stub_clock()
    if stubbed >= 0
        return stubbed
    if target() == 3
        return win_now_ms()
    # The thread's own two words: the scratch area is shared by every
    # thread, and a deadline clock that read another thread's wall-clock
    # answer there saw every parked connection as expired.
    ts := alloc_raw(16, KIND_BYTES)
    if target() == 2
        # `gettimeofday`: seconds, then microseconds in 32 bits.
        syscall(116, ts, 0, 0, 0, 0, 0)
        return load64(ts) * 1000 + load64(ts + 8).bit_and(4294967295) / 1000
    syscall(os_pick(228, 113, 0), 0, ts, 0, 0, 0, 0)
    load64(ts) * 1000 + load64(ts + 8) / 1000000

## A monotonic clock for deadlines (a runtime entry point; `std.time` has no
## monotonic call): nanoseconds from `CLOCK_MONOTONIC` on Linux, unaffected by
## changes of the wall clock. NOT monotonic on macOS: there it reads the wall
## clock (`gettimeofday`), which can step backwards or jump, so a deadline built
## on it can fire early or late. Follow-up for the Mac gate: read
## `clock_gettime_nsec_np(CLOCK_UPTIME_RAW)` or `mach_continuous_time` through
## libSystem (ADR 0534, `import_call`) and drop this branch.
fn time_mono_ns() int
    if target() == 3
        return win_mono_ns()
    # Not the shared scratch area (see `time_now_ms`).
    ts := alloc_raw(16, KIND_BYTES)
    if target() == 2
        syscall(116, ts, 0, 0, 0, 0, 0)
        return load64(ts) * 1000000000 + load64(ts + 8).bit_and(4294967295) * 1000
    syscall(os_pick(228, 113, 0), 1, ts, 0, 0, 0, 0)
    load64(ts) * 1000000000 + load64(ts + 8)

## The same clock in milliseconds.
fn time_mono_ms() int
    time_mono_ns() / 1000000

## `time.sleep_ms(ms)` (std.time.2). A negative `ms` is reported without the
## source excerpt (the check's trap site comes with lane 120's next slice).
fn time_sleep_ms(ms int)
    if ms < 0
        os_usage_trap("std.time.2", "a negative sleep")
    if ms > 0 and stub_clock() >= 0
        stub_advance(ms)
        return
    if ms == 0 or task_cancelled()
        return
    # Parked for the collector (native-abi.md §10), as in a network wait
    # (native.task.2): a collection another thread asks for must not wait
    # for the sleep to end.
    multi := load64(global(MULTI)) != 0
    # The thread's own timespec, allocated before parking.
    ts := if target() == 3 then 0 else alloc_raw(16, KIND_BYTES)
    mut parked := 0
    if multi
        parked = blocked_enter()
    time_sleep_raw(ms, ts)
    if multi
        blocked_leave(parked)

## Sleep `ms` milliseconds (positive) with the two words at `ts` as the
## timeout's room. Nothing here allocates: the caller may be parked.
fn time_sleep_raw(ms int, ts int)
    if target() == 3
        win_sleep_ms(ms)
        return
    if target() == 2
        # `select` with no descriptors and a timeout: seconds, microseconds.
        store64(ts, ms / 1000)
        store64(ts + 8, ms % 1000 * 1000)
        syscall(93, 0, 0, 0, 0, ts, 0)
        return
    store64(ts, ms / 1000)
    store64(ts + 8, ms % 1000 * 1000000)
    syscall(os_pick(35, 101, 0), ts, 0, 0, 0, 0, 0)

# ---- std.io ----

## A misuse the interpreter traps on, with its rule; exit 1 (err.trap.3).
fn os_usage_trap(rule str, what str)
    flush()
    out_str("trap[")
    out_str(rule)
    out_str("]: ")
    out_str(what)
    out_byte(10)
    flush_to(2)
    sys_exit(1)

## `io.exit(code)` (std.io.4): flush, then end. A status outside 0 to 255 traps.
fn io_exit(code int)
    if code < 0 or code > 255
        flush()
        out_str("trap[std.io.4]: exit status ")
        out_int(code)
        out_str(" is outside 0 to 255\n")
        flush_to(2)
        sys_exit(1)
    exit(code)

## Whether standard output is a terminal, so each line is written when it is
## complete (a program that prints progress shows it as `ail run` does). The
## first call asks the terminal driver (`ioctl` TCGETS, or TIOCGETA on macOS)
## and remembers: 1 not a terminal, 2 a terminal.
fn line_buffered() bool
    mut k := load64(global(OUT_TTY))
    if k == 0 and target() == 3
        k = win_tty()
        store64(global(OUT_TTY), k)
    if k == 0
        buf := os_scratch(OS_TMP)
        r := if target() == 2 then syscall(54, 1, 1078490131, buf, 0, 0, 0) else syscall(
            os_pick(16, 29, 0),
            1,
            21505,
            buf,
            0,
            0,
            0,
        )
        k = if r == 0 then 2 else 1
        store64(global(OUT_TTY), k)
    k == 2

## `io.eprint(x)` (std.io.3): what `print` would write, to standard error;
## standard output is flushed first, so the two interleave as they ran.
fn err_begin()
    flush()
    store64(global(OUT_FD), 2)

fn err_end()
    flush_to(2)
    store64(global(OUT_FD), 1)

## Refill the standard-input buffer; false at the end of input.
fn os_in_fill(rule str) bool
    flush()
    mut b := load64(global(IN_BUF))
    if b == 0
        b = alloc(OS_IN_SIZE, KIND_BYTES)
        store64(global(IN_BUF), b)
    while true
        r := os_read(0, b, OS_IN_SIZE)
        if r == -4
            continue
        if r < 0 and r != -9
            # A read error that isn't a closed standard input (EBADF is the end of input): a directory, say.
            flush()
            out_str("trap[")
            out_str(rule)
            out_str("]: can't read standard input\n")
            flush_to(2)
            sys_exit(1)
        if r <= 0
            store64(global(IN_POS), 0)
            store64(global(IN_LEN), 0)
            return false
        store64(global(IN_POS), 0)
        store64(global(IN_LEN), r)
        return true
    false

## The offset of the first `\n` in bytes `from` up to `end` of the buffer at
## `b`, or `end`. Eight bytes at a time; a word with a `\n` is stepped bytewise.
fn os_find_nl(b int, from int, end int) int
    mut i := from
    while i + 8 <= end
        x := load64(b + i).bit_xor(723401728380766730)
        if (x - 72340172838076673).bit_and(x.bit_xor(-1)).bit_and(-9187201950435737472) != 0
            break
        i += 8
    while i < end and load8(b + i) != 10
        i += 1
    i

## Bytes of standard input up to and with the next `\n`, or to the end, as
## an unchecked string object; `os_ok()` is false at the end of input.
fn os_read_until_newline() int
    # Fast path: the whole line is in the buffer already. Find the newline
    # eight bytes at a time, then allocate exactly the line's size.
    if load64(global(IN_POS)) < load64(global(IN_LEN))
        b := load64(global(IN_BUF))
        pos := load64(global(IN_POS))
        end := load64(global(IN_LEN))
        i := os_find_nl(b, pos, end)
        if i < end
            r := str_new(i - pos, 0)
            copy_bytes(r + 16, b + pos, i - pos)
            store64(global(IN_POS), i + 1)
            os_succeed()
            return r
    mut out := str_new(256, 0)
    mut cap := 256
    mut n := 0
    mut seen := false
    while true
        if load64(global(IN_POS)) >= load64(global(IN_LEN))
            if not os_in_fill("std.io.1")
                break
        b := load64(global(IN_BUF))
        pos := load64(global(IN_POS))
        end := load64(global(IN_LEN))
        i := os_find_nl(b, pos, end)
        take := i - pos
        if n + take > cap
            while n + take > cap
                cap = cap * 2
            t := str_new(cap, 0)
            copy_bytes(t + 16, out + 16, n)
            out = t
        copy_bytes(out + 16 + n, b + pos, take)
        n += take
        seen = true
        if i < end
            store64(global(IN_POS), i + 1)
            break
        store64(global(IN_POS), end)
    if not seen
        os_fail_kind(K_NOT_FOUND)
        return out
    store64(out, n)
    os_succeed()
    out

## `s` as text, each maximal run of bytes that begin a UTF-8 sequence but
## don't finish a valid one replaced by U+FFFD (std.io.1).
fn os_lossy(s int) str
    n := load64(s)
    chars := os_utf8_chars(s + 16, n)
    if chars >= 0
        store64(s + 8, chars)
        return str_at(s)
    sb_reset()
    mut i := 0
    while i < n
        c := load8(s + 16 + i)
        if c < 128
            sb_byte(c)
            i += 1
            continue
        need := if c >= 194
            and c <= 223 then 2 else if c >= 224
            and c <= 239 then 3 else if c >= 240
            and c <= 244 then 4 else 0
        # How many bytes of a valid sequence start here.
        mut k := if need == 0 then 0 else 1
        mut ok := need > 0
        while ok and k < need
            if i + k >= n
                ok = false
            else
                b := load8(s + 16 + i + k)
                mut lo := 128
                mut hi := 191
                if k == 1
                    if c == 224
                        lo = 160
                    if c == 237
                        hi = 159
                    if c == 240
                        lo = 144
                    if c == 244
                        hi = 143
                if b < lo or b > hi
                    ok = false
                else
                    k += 1
        if ok
            for m in 0..need
                sb_byte(load8(s + 16 + i + m))
            i += need
        else
            sb_byte(239)
            sb_byte(191)
            sb_byte(189)
            i += if k == 0 then 1 else k
    sb_str()

## Copy `n` bytes and return their top bits ORed: 0 when all are ASCII.
fn os_copy_hi(dst int, src int, n int) int
    mut hi := 0
    mut j := 0
    while j + 8 <= n
        w := load64(src + j)
        store64(dst + j, w)
        hi = hi.bit_or(w)
        j += 8
    while j < n
        c := load8(src + j)
        store8(dst + j, c)
        hi = hi.bit_or(c.bit_and(128).shl(56))
        j += 1
    hi.bit_and(-9187201950435737472)

## `io.read_line()` (std.io.1): the next line without `\n` or `\r\n`;
## `os_ok()` is false at the end of input.
fn os_io_read_line() str
    # Fast path: the line is in the buffer. Find the newline, then copy the
    # line (less a `\r`) while checking for non-ASCII bytes in the same pass,
    # so an ASCII line needs no UTF-8 count (std.io.1).
    if load64(global(IN_POS)) < load64(global(IN_LEN))
        b := load64(global(IN_BUF))
        pos := load64(global(IN_POS))
        end := load64(global(IN_LEN))
        i := os_find_nl(b, pos, end)
        if i < end
            n := if i > pos and load8(b + i - 1) == 13 then i - pos - 1 else i - pos
            r := str_new(n, 0)
            hi := os_copy_hi(r + 16, b + pos, n)
            store64(global(IN_POS), i + 1)
            os_succeed()
            if hi == 0
                store64(r + 8, n)
                return str_at(r)
            return os_lossy(r)
    s := os_read_until_newline()
    if not os_ok()
        return ""
    n := load64(s)
    if n > 0 and load8(s + 15 + n) == 13
        store64(s, n - 1)
    os_lossy(s)

## `io.read_all()` (std.io.2): the rest of standard input.
fn io_read_all() str
    os_lossy(str_addr(io_read_bytes()))

## `io.write_bytes(b)` (std.io.6): the bytes of `b`, undecoded, on standard
## output, in order with what `print` wrote.
fn io_write_bytes(b str)
    out_lock()
    out_str(b)
    out_unlock()

## `io.read_bytes()`: the rest of standard input, undecoded (std.io.1).
fn io_read_bytes() str
    mut cap := 4096
    mut s := str_new(cap, 0)
    mut n := 0
    while true
        if load64(global(IN_POS)) >= load64(global(IN_LEN))
            if not os_in_fill("std.io.2")
                break
        b := load64(global(IN_BUF))
        pos := load64(global(IN_POS))
        take := load64(global(IN_LEN)) - pos
        if n + take > cap
            while n + take > cap
                cap = cap * 2
            t := str_new(cap, 0)
            copy_bytes(t + 16, s + 16, n)
            s = t
        copy_bytes(s + 16 + n, b + pos, take)
        n += take
        store64(global(IN_POS), pos + take)
    store64(s, n)
    os_succeed()
    str_at(s)

## `io.read_exact(n)` (std.io.7): exactly `n` bytes of standard input, undecoded,
## or `none` (zero) when the input ends first; what was read is consumed. A
## negative `n`, or one above 1 GiB, traps. It reads through the same buffer as
## `io.read_line` and `io.read_bytes`, so the calls mix in order.
fn io_read_exact(n int) str
    if n < 0 or n > 1073741824
        flush()
        out_str("trap[std.io.7]: byte count out of range\n")
        flush_to(2)
        sys_exit(1)
    r := bytes_new(n)
    mut got := 0
    while got < n
        if load64(global(IN_POS)) >= load64(global(IN_LEN))
            if not os_in_fill("std.io.7")
                return str_at(0)
        b := load64(global(IN_BUF))
        pos := load64(global(IN_POS))
        left := load64(global(IN_LEN)) - pos
        take := if left < n - got then left else n - got
        copy_bytes(r + 16 + got, b + pos, take)
        got += take
        store64(global(IN_POS), pos + take)
    str_at(r)

# ---- the lowering's entry points (lower_os.ail) ----

## `s` as the interpreter quotes it inside a value: `"`, `\`, `\n`, `\t`,
## `\r`, `\0` escaped, other control characters as `\u{X}`.
fn os_put_quoted(s str)
    p := str_addr(s)
    n := load64(p)
    sb_byte(34)
    mut i := 0
    while i < n
        c := load8(p + 16 + i)
        if c == 34 or c == 92
            sb_byte(92)
            sb_byte(c)
        elif c == 10
            sb_text("\\n")
        elif c == 9
            sb_text("\\t")
        elif c == 13
            sb_text("\\r")
        elif c == 0
            sb_text("\\0")
        elif c < 32 or c == 127
            os_put_u()
            put_hex(c)
            sb_byte(125)
        elif c == 194 and i + 1 < n and load8(p + 17 + i) >= 128 and load8(p + 17 + i) < 160
            os_put_u()
            put_hex(load8(p + 17 + i))
            sb_byte(125)
            i += 1
        else
            sb_byte(c)
        i += 1
    sb_byte(34)

## `\u{` of a Unicode escape.
fn os_put_u()
    sb_byte(92)
    sb_byte(117)
    sb_byte(123)

## Fail with `fs.IoError(path: "P", kind: "K")`; `at` is the call's trace line.
fn os_error(path str, kind int, at str)
    sb_reset()
    sb_text("fs.IoError(path: ")
    os_put_quoted(path)
    sb_text(", kind: ")
    kind_put("fs.IoKind", kind_name(kind))
    sb_byte(41)
    err_set(sb_str(), at)
    # The value, an `fs.IoError(path, kind)` struct (ADR 0804, ADR 1068).
    e := obj_new(16, 4)
    store64(e, str_addr(path))
    store64(e + 8, kind_word(io_kinds(), kind_name(kind)))
    err_value(e)
    err_tag(err_tag_of("fs.IoError"))

fn fs_read_text(path str, at str) str
    if stub_file_has(path)
        return stub_file_text(path)
    pol_fs(path, false, "fs.read_text")
    s := os_fs_read_text(path)
    if not os_ok()
        os_error(path, os_kind(), at)
    s

fn fs_read_bytes(path str, at str) str
    if stub_file_has(path)
        return stub_file_text(path)
    pol_fs(path, false, "fs.read_bytes")
    s := os_fs_read_bytes(path)
    if not os_ok()
        os_error(path, os_kind(), at)
    s

fn fs_write_text(path str, text str, at str)
    pol_fs(path, true, "fs.write_text")
    os_fs_write_text(path, text)
    if not os_ok()
        os_error(path, os_kind(), at)

## `fs.write_bytes(path, data)` (std.fs.14): a `bytes` object has a `str`'s
## layout, so the text writer takes it as it is.
fn fs_write_bytes(path str, data str, at str)
    pol_fs(path, true, "fs.write_bytes")
    os_fs_write_text(path, data)
    if not os_ok()
        os_error(path, os_kind(), at)

fn fs_append_text(path str, text str, at str)
    pol_fs(path, true, "fs.append_text")
    os_fs_append_text(path, text)
    if not os_ok()
        os_error(path, os_kind(), at)

fn fs_append_bytes(path str, data str, at str)
    pol_fs(path, true, "fs.append_bytes")
    os_fs_append_text(path, data)
    if not os_ok()
        os_error(path, os_kind(), at)

fn fs_list_dir(path str, at str) List[int]
    pol_fs(path, false, "fs.list_dir")
    xs := os_fs_list_dir(path)
    if not os_ok()
        os_error(path, os_kind(), at)
    xs

## Whether `path` is a directory itself, not a link to one: opening it with
## `O_DIRECTORY | O_NOFOLLOW` works. A directory that can't be opened for
## permission still counts, so listing it reports the failure (std.fs.8).
fn os_is_real_dir(path str) bool
    p := os_cstr(OS_PATH_B, path)
    if p == 0
        return false
    flags := os_pick(196608, 49152, 1048832)
    fd := os_open(p, flags, 0)
    if fd < 0
        return fd == -13
    os_close(fd)
    true

## `fs.walk(dir)` (std.fs.8): every file below `dir`, joined with `dir` and
## sorted by bytes; a directory that can't be read fails with its own path.
fn fs_walk(dir str, at str) List[int]
    pol_fs(dir, false, "fs.walk")
    mut out := List[int]()
    mut dirs := [dir]
    mut next := 0
    while next < dirs.len()
        d := dirs[next]
        next += 1
        names := os_fs_list_dir(d)
        if not os_ok()
            os_error(d, os_kind(), at)
            return List[int]()
        for i in 0..names.len()
            full := path_join(d, str_at(names[i]))
            if os_is_real_dir(full)
                dirs.push(full)
            else
                out.push(str_addr(full))
    os_succeed()
    q := list_addr(out)
    os_sort_names(load64(q + 16), load64(q))
    out

# ---- fs.metadata (std.fs.10) ----

## `fs.metadata(path)`: an `fs.Metadata` of `size`, `modified_ms` and
## `is_dir`; links are followed. The `fstat` layout of each target: size at 48
## (macOS 72), modification seconds at 88 (macOS 40) with nanoseconds 8 after.
fn fs_metadata(path str, at str) int
    pol_fs(path, false, "fs.metadata")
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        os_error(path, os_kind(), at)
        return 0
    fd := os_open(p, 0, 0)
    if fd < 0
        os_fail_errno(fd)
        os_error(path, os_kind(), at)
        return 0
    buf := os_scratch(OS_TMP)
    r := os_fstat(fd, buf)
    os_close(fd)
    if r < 0
        os_fail_errno(r)
        os_error(path, os_kind(), at)
        return 0
    moff := os_pick(24, 16, 8)
    mode := (load8(buf + moff) + load8(buf + moff + 1) * 256).bit_and(61440)
    is_dir := mode == 16384
    size := load64(buf + os_pick(48, 48, 72))
    secs := load64(buf + os_pick(88, 88, 40))
    nanos := load64(buf + os_pick(96, 96, 48))
    m := obj_new(24, 4)
    store64(m, if is_dir then 0 else size)
    store64(m + 8, secs * 1000 + nanos / 1000000)
    store64(m + 16, if is_dir then 1 else 0)
    os_succeed()
    m

# ---- fs.copy (std.fs.12) ----

## The permission bits of the open file `fd` (`st_mode` of `fstat`).
fn os_fd_mode(fd int) int
    buf := os_scratch(OS_TMP)
    r := os_fstat(fd, buf)
    if r < 0
        return 438
    # macOS syscall 189 fills the legacy `struct stat`: st_dev is 4 bytes and
    # st_ino 4 more, so st_mode sits at offset 8 (offset 4 is inode bits).
    off := os_pick(24, 16, 8)
    (load8(buf + off) + load8(buf + off + 1) * 256).bit_and(4095)

## Copy the file `src` over `dst`, keeping its permissions. Fails with the
## errno's kind in `os_kind()`.
fn os_copy_file(src str, dst str)
    a := os_cstr(OS_PATH_A, src)
    b := os_cstr(OS_PATH_B, dst)
    if a == 0 or b == 0
        os_fail_kind(K_NOT_FOUND)
        return
    sfd := os_open(a, 0, 0)
    if sfd < 0
        os_fail_errno(sfd)
        return
    mode := os_fd_mode(sfd)
    dfd := os_open(b, if target() == 2 then 1537 else 577, mode)
    if dfd < 0
        os_close(sfd)
        os_fail_errno(dfd)
        return
    if target() != 3
        syscall(os_pick(91, 52, 124), dfd, mode, 0, 0, 0, 0)
    buf := alloc_raw(65536, KIND_BYTES)
    mut failed := 0
    while failed == 0
        n := os_read(sfd, buf, 65536)
        if n == -4
            continue
        if n < 0
            failed = n
        elif n == 0
            break
        else
            w := os_write_all(dfd, buf, n)
            if w < 0
                failed = w
    os_close(sfd)
    os_close(dfd)
    if failed < 0
        os_fail_errno(failed)
        return
    os_succeed()

## `p` as an absolute path with `.` and `..` resolved by text.
fn os_abs_norm(p str) str
    full := if load64(str_addr(p)) > 0 and load8(str_addr(p) + 16) == 47 then p else path_join(
        env_cwd(),
        p,
    )
    q := str_addr(full) + 16
    n := load64(str_addr(full))
    mut parts := List[str]()
    mut start := 0
    for i in 0..n + 1
        if i == n or load8(q + i) == 47
            if i > start
                c := os_str_from(q + start, i - start)
                if c == "."
                    start = i + 1
                    continue
                if c == ".."
                    if parts.len() > 0
                        parts.pop()
                    start = i + 1
                    continue
                parts.push(c)
            start = i + 1
    mut out := ""
    for c in parts
        out = str_cat(str_cat(out, "/"), c)
    if out == ""
        return "/"
    out

## Copy the tree `from` to `to`; "" when done, else the path that failed
## (its kind in `os_kind()`).
fn os_copy_dir(from str, to str) str
    os_fs_make_dir(to)
    if not os_ok()
        return to
    names := os_fs_list_dir(from)
    if not os_ok()
        return from
    for i in 0..names.len()
        name := str_at(names[i])
        src := path_join(from, name)
        dst := path_join(to, name)
        if os_is_real_dir(src)
            bad := os_copy_dir(src, dst)
            if bad != ""
                return bad
        elif glob_is_dir(src)
            os_fail_kind(K_OTHER)
            return src
        else
            os_copy_file(src, dst)
            if not os_ok()
                if os_kind() != K_IS_DIR and glob_is_dir(dst)
                    os_fail_kind(K_IS_DIR)
                return dst
    os_succeed()
    ""

## `fs.copy(from, to)` (std.fs.12). The path of a failure: `from` when it is
## missing, else `to` (or the entry that failed inside a copied tree).
fn fs_copy(from str, to str, at str)
    pol_fs(from, false, "fs.copy")
    pol_fs(to, true, "fs.copy")
    p := os_cstr(OS_PATH_A, from)
    if p == 0 or os_access(p) < 0
        k := if p == 0 then -2 else os_access(p)
        os_fail_errno(k)
        os_error(from, os_kind(), at)
        return
    if glob_is_dir(from)
        src := os_abs_norm(from)
        dst := os_abs_norm(to)
        if str_eq(src, dst) or str_starts_with(dst, if src == "/" then "/" else str_cat(src, "/"))
            os_error(to, K_OTHER, at)
            return
        bad := os_copy_dir(from, to)
        if bad != ""
            os_error(bad, os_kind(), at)
        return
    os_copy_file(from, to)
    if not os_ok()
        if os_kind() != K_IS_DIR and glob_is_dir(to)
            os_fail_kind(K_IS_DIR)
        os_error(to, os_kind(), at)

fn fs_remove(path str, at str)
    pol_fs(path, true, "fs.remove")
    os_fs_remove(path)
    if not os_ok()
        os_error(path, os_kind(), at)

fn fs_make_dir(path str, at str)
    pol_fs(path, true, "fs.make_dir")
    os_fs_make_dir(path)
    if not os_ok()
        os_error(path, os_kind(), at)

## `fs.temp_dir()` (std.fs.35): `TMPDIR`, else `TEMP`, else `/tmp`; a variable
## that is empty counts as unset.
fn fs_temp_dir() str
    a := os_env_get("TMPDIR")
    if os_ok() and a.len() > 0
        return a
    b := os_env_get("TEMP")
    if os_ok() and b.len() > 0
        return b
    os_succeed()
    "/tmp"

## One new directory, no parents, for the owner only (mode 0700; Windows has
## no mode here). `-17` (exists) when the name is taken: the exclusive create.
fn os_mkdir_private(path int) int
    if target() == 3
        return win_mkdir(path)
    if target() == 2
        return syscall(136, path, 448, 0, 0, 0, 0)
    syscall(os_pick(258, 34, 0), -100, path, 448, 0, 0, 0)

## `fs.make_temp_dir(prefix)` (std.fs.37): a new empty directory in `fs.temp_dir()`
## named `prefix` and 12 random hex digits, made with an exclusive create, so
## two callers never share one. A name already taken is tried again with new
## digits. The failure's path is the directory it tried last.
fn fs_make_temp_dir(prefix str, at str) str
    pol_fs(fs_temp_dir(), true, "fs.make_temp_dir")
    base := fs_temp_dir()
    mut last := base
    mut tries := 0
    while tries < 64
        buf := os_scratch(OS_TMP)
        mut bits := time_now_ms() * 2862933555777941757 + tries
        if tc_random(buf, 8) == 0
            bits = load64(buf)
        sb_reset()
        sb_text(prefix)
        for i in 0..12
            d := bits.shr(4 * i).bit_and(15)
            sb_byte(if d < 10 then 48 + d else 87 + d)
        full := path_join(base, sb_str())
        last = full
        p := os_cstr(OS_PATH_A, full)
        if p == 0
            os_fail_kind(K_NOT_FOUND)
            os_error(full, K_NOT_FOUND, at)
            return ""
        r := os_mkdir_private(p)
        if r == 0
            os_succeed()
            return full
        if r != -17
            os_fail_errno(r)
            os_error(full, os_kind(), at)
            return ""
        tries += 1
    os_fail_kind(K_EXISTS)
    os_error(last, K_EXISTS, at)
    ""

## A failure's path is `from` when `from` is missing, else `to` (std.fs.12).
fn fs_rename(from str, to str, at str)
    pol_fs(from, true, "fs.rename")
    pol_fs(to, true, "fs.rename")
    os_fs_rename(from, to)
    if not os_ok()
        k := os_kind()
        os_error(if k == K_NOT_FOUND then from else to, k, at)

## `env.get(name)`. The runtime itself reads variables through `env_raw`, which asks no policy (eff.allow.6).
fn env_get(name str) str
    if stub_env_has(name)
        return stub_env_value(name)
    pol_env(name)
    env_raw(name)

fn env_raw(name str) str
    s := os_env_get(name)
    if os_ok()
        return s
    str_at(0)

fn env_home() str
    pol_env_home()
    s := os_env_home()
    if os_ok()
        return s
    str_at(0)

fn io_read_line() str
    s := os_io_read_line()
    if os_ok()
        return s
    str_at(0)

## `s.to_float()` as a `float?` (type.num.8): the number boxed, or 0.
fn str_float_opt(s str) int
    x := str_to_float(s)
    if parse_ok()
        return boxf(x)
    0

# ---- fs.volume, fs.read_range, fs.trash (std.fs.24-26, ADRs 0928 and 0929) ----

## `fs.volume(path)` (std.fs.24): an `fs.Volume` of `total` and `free` bytes.
## `statfs`: Linux `f_bsize` at 8, `f_blocks` 16, `f_bavail` 32; macOS
## `statfs64` (syscall 345) `f_bsize` (32 bits) at 0, `f_blocks` 8, `f_bavail` 24.
## Windows: GetDiskFreeSpaceExW (`win_volume`).
fn fs_volume(path str, at str) int
    pol_fs(path, false, "fs.volume")
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        os_error(path, K_NOT_FOUND, at)
        return 0
    buf := os_scratch(OS_TMP)
    if target() == 3
        w := win_volume(p, buf)
        if w < 0
            os_fail_errno(w)
            os_error(path, os_kind(), at)
            return 0
        v := obj_new(16, 4)
        store64(v, load64(buf))
        store64(v + 8, load64(buf + 8))
        os_succeed()
        return v
    mac := target() == 2
    r := syscall(if mac then 345 else os_pick(137, 43, 0), p, buf, 0, 0, 0, 0)
    if r < 0
        os_fail_errno(r)
        os_error(path, os_kind(), at)
        return 0
    bsize := if mac then load64(buf).bit_and(4294967295) else load64(buf + 8)
    blocks := load64(buf + (if mac then 8 else 16))
    avail := load64(buf + (if mac then 24 else 32))
    v := obj_new(16, 4)
    store64(v, blocks * bsize)
    store64(v + 8, avail * bsize)
    os_succeed()
    v

## `fs.read_range(path, offset, len)` (std.fs.25): up to `len` bytes from
## `offset`; fewer at the end of the file, none past it.
fn fs_read_range(path str, off int, len int, at str) str
    pol_fs(path, false, "fs.read_range")
    if off < 0 or len < 0
        flush()
        out_str("trap[std.fs.25]: negative offset or length\n")
        flush_to(2)
        sys_exit(1)
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        os_error(path, K_NOT_FOUND, at)
        return ""
    fd := os_open(p, 0, 0)
    if fd < 0
        os_fail_errno(fd)
        os_error(path, os_kind(), at)
        return ""
    # Never allocate more than the file can give; a directory reports a huge
    # size, and its read fails below with `is_dir`.
    mut want := len
    st := os_scratch(OS_TMP)
    if os_fstat(fd, st) >= 0
        size := load64(st + os_pick(48, 48, 72))
        if size >= 0 and size < 1099511627776
            want = if off >= size then 0 else (if len < size - off then len else size - off)
    if want > 1073741824
        want = 1073741824
    mut s := str_new(want + 1, 0)
    mut n := 0
    mut r := 0
    if want > 0 or off == 0
        r = os_lseek(fd, off, 0)
    while r >= 0 and n < want
        r = os_read(fd, s + 16 + n, want - n)
        if r == -4
            r = 0
            continue
        if r <= 0
            break
        n += r
    os_close(fd)
    if r < 0
        os_fail_errno(r)
        os_error(path, os_kind(), at)
        return ""
    store64(s, n)
    store64(s + 8, n)
    os_succeed()
    str_at(s)

## `fs.map(path)` (std.fs.36, ADR 1016): the file as a read-only `bytes` view
## onto its pages, with no copy. The view is a string object laid out in
## place: 16 header bytes (length, character count) sit at the end of an
## anonymous page block, and the file is mapped `MAP_PRIVATE | MAP_FIXED`
## right after it, so the data starts where `str + 16` points. The collector
## ignores it (the address is outside its heap) and the mapping lives to the
## end of the process. The block is 16384 bytes (a macOS page; a multiple of
## the 4096-byte Linux page). An empty file gives an ordinary `bytes` copy.
## Windows maps a view the same way (`fs_map_win`).
fn fs_map(path str, at str) str
    pol_fs(path, false, "fs.map")
    p := os_cstr(OS_PATH_A, path)
    if p == 0
        os_fail_kind(K_NOT_FOUND)
        os_error(path, K_NOT_FOUND, at)
        return ""
    fd := os_open(p, 0, 0)
    if fd < 0
        os_fail_errno(fd)
        os_error(path, os_kind(), at)
        return ""
    st := os_scratch(OS_TMP)
    r := os_fstat(fd, st)
    if r < 0
        os_close(fd)
        os_fail_errno(r)
        os_error(path, os_kind(), at)
        return ""
    moff := os_pick(24, 16, 8)
    mode := (load8(st + moff) + load8(st + moff + 1) * 256).bit_and(61440)
    size := load64(st + os_pick(48, 48, 72))
    if mode == 16384
        os_close(fd)
        os_fail_kind(K_IS_DIR)
        os_error(path, K_IS_DIR, at)
        return ""
    if size <= 0
        os_close(fd)
        return fs_read_bytes(path, at)
    if target() == 3
        wv := fs_map_win(fd, size)
        os_close(fd)
        if wv == 0
            return fs_read_bytes(path, at)
        os_succeed()
        return str_at(wv)
    head := 16384
    span := (size + 16383) / 16384 * 16384
    base := sys_mmap(head + span)
    if base < 0
        os_close(fd)
        os_fail_kind(K_OTHER)
        os_error(path, K_OTHER, at)
        return ""
    k := os_pick(9, 222, 197)
    # PROT_READ, MAP_PRIVATE | MAP_FIXED over the anonymous block.
    m := syscall(k, base + head, size, 1, 18, fd, 0)
    os_close(fd)
    if m < 0
        syscall(os_pick(11, 215, 73), base, head + span, 0, 0, 0, 0)
        os_fail_errno(m)
        os_error(path, os_kind(), at)
        return ""
    s := base + head - 16
    store64(s, size)
    store64(s + 8, size)
    os_succeed()
    str_at(s)

## `fs.map` on Windows (ADR 1016, amended 2026-11-10): a read-only view of
## the `size` bytes of the open file `fd`, as the address of a string object,
## or 0 when the system gave no view (the caller copies the file instead).
## Views start on a 65536-byte boundary, so the head block is that long.
## Windows has no `MAP_FIXED` over reserved memory: the block is reserved to
## find a free range, released, and the view (`MapViewOfFileEx`) and the head
## (`VirtualAlloc`) are placed in it. Another thread may take the range in
## between, so the placing is tried up to eight times.
fn fs_map_win(fd int, size int) int
    # PAGE_READONLY, the whole file.
    hm := import_call("CreateFileMappingW", win_h(fd), 0, 2, 0, 0, 0)
    if hm == 0
        return 0
    head := 65536
    span := (size + 65535) / 65536 * 65536
    mut s := 0
    mut tries := 0
    while s == 0 and tries < 8
        tries += 1
        # MEM_RESERVE, PAGE_NOACCESS; then MEM_RELEASE.
        base := import_call("VirtualAlloc", 0, head + span, 8192, 1)
        if base == 0
            break
        import_call("VirtualFree", base, 0, 32768, 0)
        # FILE_MAP_READ, from offset 0, to the end of the file.
        v := import_call("MapViewOfFileEx", hm, 4, 0, 0, 0, base + head)
        if v == 0
            continue
        # MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE.
        if import_call("VirtualAlloc", base, head, 12288, 4) == 0
            import_call("UnmapViewOfFile", v, 0, 0, 0)
            continue
        s = base + head - 16
        store64(s, size)
        store64(s + 8, size)
    # The view keeps the file open; the mapping handle is not needed again.
    import_call("CloseHandle", hm, 0, 0, 0)
    s

## The decimal digits of `n` (not negative), added to the string builder.
fn os_sb_dec(n int, width int)
    mut digits := 1
    mut t := n / 10
    while t > 0
        digits += 1
        t = t / 10
    mut z := width - digits
    while z > 0
        sb_byte(48)
        z -= 1
    mut div := 1
    for i in 1..digits
        div = div * 10
    while div > 0
        sb_byte(48 + n / div % 10)
        div = div / 10

## The trash-info text of freedesktop.org: `Path` percent-encoded, then the
## deletion time in UTC.
fn os_trashinfo(abs str) str
    sb_reset()
    sb_text("[Trash Info]\nPath=")
    n := abs.len()
    for i in 0..n
        b := load8(str_addr(abs) + 16 + i)
        keep := (b >= 48 and b <= 57)
            or (b >= 65 and b <= 90)
            or (b >= 97 and b <= 122)
            or b == 47
            or b == 45
            or b == 46
            or b == 95
            or b == 126
        if keep
            sb_byte(b)
        else
            sb_byte(37)
            h := b / 16
            l := b % 16
            sb_byte(if h < 10 then 48 + h else 55 + h)
            sb_byte(if l < 10 then 48 + l else 55 + l)
    # Civil date from days since 1970 (Howard Hinnant's algorithm).
    secs := time_now_ms() / 1000
    days := secs / 86400
    rem := secs % 86400
    z := days + 719468
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10 then mp + 3 else mp - 9
    y := yoe + era * 400 + (if m <= 2 then 1 else 0)
    sb_text("\nDeletionDate=")
    os_sb_dec(y, 4)
    sb_byte(45)
    os_sb_dec(m, 2)
    sb_byte(45)
    os_sb_dec(d, 2)
    sb_byte(84)
    os_sb_dec(rem / 3600, 2)
    sb_byte(58)
    os_sb_dec(rem % 3600 / 60, 2)
    sb_byte(58)
    os_sb_dec(rem % 60, 2)
    sb_byte(10)
    sb_str()

## `name` or `name N` (N from 2) inside `dir`: the first that is free, with
## `info` (when non-empty) free as `<that>.trashinfo` too.
fn os_trash_name(dir str, info str, name str) str
    mut n := 1
    while n < 100000
        sb_reset()
        sb_text(name)
        if n > 1
            sb_byte(32)
            os_sb_dec(n, 1)
        leaf := sb_str()
        full := path_join(dir, leaf)
        a := os_cstr(OS_PATH_A, full)
        mut taken := a != 0 and os_access(a) == 0
        if not taken and info.len() > 0
            sb_reset()
            sb_text(leaf)
            sb_text(".trashinfo")
            b := os_cstr(OS_PATH_B, path_join(info, sb_str()))
            taken = b != 0 and os_access(b) == 0
        if not taken
            return leaf
        n += 1
    name

## `fs.trash(path)` (std.fs.26): move `path` into the user's trash, never
## copying. macOS: `~/.Trash`. Linux: `$XDG_DATA_HOME/Trash` (default
## `~/.local/share/Trash`) with a `.trashinfo`. A trash on another volume
## makes the rename fail with kind `other`. Windows: the Recycle Bin, through
## `SHFileOperationW` (`win_trash`).
fn os_fs_trash(path str)
    p := os_cstr(OS_PATH_A, path)
    if p == 0 or os_access(p) < 0
        os_fail_kind(K_NOT_FOUND)
        return
    if target() == 3
        r := win_trash(p)
        if r < 0
            os_fail_errno(r)
        else
            os_succeed()
        return
    home := os_env_home()
    if not os_ok()
        os_fail_kind(K_OTHER)
        return
    mac := target() == 2
    mut files := path_join(home, ".Trash")
    mut info := ""
    if not mac
        xdg := os_env_get("XDG_DATA_HOME")
        data := if os_ok() and xdg.len() > 0 then xdg else path_join(home, ".local/share")
        files = path_join(path_join(data, "Trash"), "files")
        info = path_join(path_join(data, "Trash"), "info")
    os_fs_make_dir(files)
    if not os_ok()
        return
    if info.len() > 0
        os_fs_make_dir(info)
        if not os_ok()
            return
    leaf := os_trash_name(files, info, path_base(path))
    dest := path_join(files, leaf)
    if info.len() == 0
        os_fs_rename(path, dest)
        return
    abs := if str_starts_with(path, "/") then path else path_join(env_cwd(), path)
    sb_reset()
    sb_text(leaf)
    sb_text(".trashinfo")
    meta := path_join(info, sb_str())
    os_fs_write_text(meta, os_trashinfo(abs))
    if not os_ok()
        return
    os_fs_rename(path, dest)
    if not os_ok()
        k := os_kind()
        os_fs_remove(meta)
        os_fail_kind(k)

fn fs_trash(path str, at str)
    pol_fs(path, true, "fs.trash")
    os_fs_trash(path)
    if not os_ok()
        os_error(path, os_kind(), at)
