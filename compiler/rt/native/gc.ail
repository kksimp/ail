## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The native collector (ADR 0562, 0564): stop-the-world mark and sweep.
## Roots are found conservatively: every word of the stack from the current
## stack pointer up to the saved top, the callee-saved registers, and the
## runtime's global slots, taken as a pointer when it falls inside a live
## object (interior pointers count). Inside objects the kind says what to
## scan, and lists of scalars and strings hold no pointers.

## The object that contains address `w`: the address of its header word, or
## 0 when `w` is not inside the heap or lies in an unallocated block.
fn gc_find(w int) int
    base := hs(H_BASE)
    if w < base or w >= hs(H_TOP)
        return 0
    pi := (w - base) / PAGE
    t := load64(hs(H_PAGES) + 8 * pi)
    tag := t.bit_and(255)
    pb := base + pi * PAGE
    if tag == 1
        # The entry holds the block size and its reciprocal (heap.ail).
        csz := t.shr(16).bit_and(65535)
        bs := pb + ((w - pb) * t.shr(32)).shr(32) * csz
        if bs + csz > pb + PAGE
            return 0
        # Blocks of the page being filled that are not yet handed out may hold
        # an old object's words (a reused page is not zeroed): not objects.
        idx := t.shr(8).bit_and(255)
        if bs >= hs(H_BUMP + idx) and bs < hs(H_BEND + idx)
            return 0
        return bs
    if tag == 2
        return pb
    if tag == 3
        return base + t.shr(8) * PAGE
    0

## Mark the object containing `w`, if any, and queue it for scanning.
fn gc_mark(w int)
    bs := gc_find(w)
    if bs != 0
        h := load64(bs)
        kind := h.bit_and(255)
        if kind != 0 and h.bit_and(256) == 0
            store64(bs, h.bit_or(256))
            if kind != KIND_STR and kind != KIND_BYTES and kind != KIND_ATOMIC
                top := hs(H_MARKN)
                if top >= hs(H_MARKCAP)
                    fail(1, 0, 0)
                store64(hs(H_MARKS) + 8 * top, bs)
                hset(H_MARKN, top + 1)

## Mark a list's element block and scan its first `len` words; the rest is
## unused. A block already marked (another pointer reached it) was queued
## whole, so there is nothing to do.
fn gc_mark_list_data(w int, len int)
    bs := gc_find(w)
    if bs != 0
        h := load64(bs)
        kind := h.bit_and(255)
        if kind != 0 and h.bit_and(256) == 0
            store64(bs, h.bit_or(256))
            if kind == KIND_LDATA
                # Never past the block: a list's `len` read while the list is
                # being changed must not send the scan beyond its data.
                room := h.shr(16) / 8
                gc_scan_range(bs + 8, bs + 8 + 8 * (if len < room then len else room))

## Most words are not heap addresses (integers, characters, small values), so
## the range test is done here once per word, with the heap bounds read once,
## and only a word inside the heap is looked up.
fn gc_scan_range(from int, to int)
    base := hs(H_BASE)
    top := hs(H_TOP)
    mut p := from
    while p < to
        w := load64(p)
        if w >= base and w < top
            gc_mark(w)
        p += 8

## Scan the queued objects until none is left.
fn gc_drain()
    mut top := hs(H_MARKN)
    while top > 0
        top -= 1
        hset(H_MARKN, top)
        bs := load64(hs(H_MARKS) + 8 * top)
        h := load64(bs)
        n := h.shr(16)
        if h.bit_and(255) == KIND_LIST
            # +0 len, +8 cap, +16 data: only the first `len` elements are live
            gc_mark_list_data(load64(bs + 24), load64(bs + 8))
        else
            gc_scan_range(bs + 8, bs + 8 + n / 8 * 8)
        top = hs(H_MARKN)

## Free what is unmarked, clear the marks, and rebuild the free lists.
## A page with no live block goes back to the page pool.
fn gc_sweep()
    base := hs(H_BASE)
    pt := hs(H_PAGES)
    top_i := (hs(H_TOP) - base) / PAGE
    for c in 0..40
        hset(H_HEADS + c, 0)
        hset(H_BUMP + c, 0)
        hset(H_BEND + c, 0)
    mut live := 0
    mut pi := 0
    while pi < top_i
        t := load64(pt + 8 * pi)
        tag := t.bit_and(255)
        pb := base + pi * PAGE
        if tag == 1
            idx := t.shr(8).bit_and(255)
            csz := t.shr(16).bit_and(65535)
            per := PAGE / csz
            # One pass: clear marks, chain the free blocks (lowest address
            # first), count the live ones. A page with none goes back to the
            # page pool and its chain is dropped.
            mut marked := 0
            mut head := hs(H_HEADS + idx)
            mut k := per - 1
            while k >= 0
                bs := pb + k * csz
                h := load64(bs)
                if h.bit_and(256) != 0
                    store64(bs, h.bit_xor(256))
                    marked += 1
                else
                    store64(bs, 0)
                    store64(bs + 8, head)
                    head = bs
                k -= 1
            if marked == 0
                store64(pt + 8 * pi, 0)
            else
                live += marked * csz
                hset(H_HEADS + idx, head)
            pi += 1
        elif tag == 2
            np := t.shr(8)
            h := load64(pb)
            if h.bit_and(256) != 0
                store64(pb, h.bit_xor(256))
                live += np * PAGE
            else
                for k in 0..np
                    store64(pt + 8 * (pi + k), 0)
            pi += np
        else
            pi += 1
    hset(H_LIVE, live)
    hset(H_HINT, 0)
    hset(H_NOFIT, 0)
    hset(H_ALLOCD, 0)
    hset(H_THRESH, if live * 3 > MIN_THRESH then live * 3 else MIN_THRESH)
    hset(H_FASTLIM, if load64(global(MULTI)) == 0 and hs(26) == 0 then hs(H_THRESH) else 0)

## `AIL_GC_VERIFY` set: before marking, check every allocated block's header
## (a payload that fits the block, no stray flag bits) and say which block is
## wrong, with its neighbour, then exit 70. Finds heap corruption at the first
## collection after it happens. Costs nothing when the variable is unset.
fn gc_bad_header(bs int, prev int, csz int, what int)
    flush()
    out_str("gc verify: bad header ")
    out_int(what)
    out_str(" at block ")
    out_int(bs - hs(H_BASE))
    out_str(" size ")
    out_int(csz)
    out_str(" word ")
    out_int(load64(bs))
    out_str(" previous block word ")
    out_int(load64(prev))
    out_str(" previous block size ")
    out_int(csz)
    out_str(" allocations ")
    out_int(hs(27))
    out_str("\n")
    trace_frames_n(0)
    flush_to(2)
    sys_exit(70)

## `AIL_GC_VERIFY=lo,hi,stride`: besides every collection, check the heap at
## allocations lo, lo+stride, ... below hi (counted from the start), so a bad
## header is caught within `stride` allocations of the store that made it.
## The failing report names the allocation count and the callers.
fn gv_tick()
    c := hs(27) + 1
    hset(27, c)
    if hs(26) == 2 and c >= hs(28) and c < hs(29) and (c - hs(28)) % hs(30) == 0
        gc_verify()

fn gc_verify()
    base := hs(H_BASE)
    pt := hs(H_PAGES)
    top_i := (hs(H_TOP) - base) / PAGE
    mut pi := 0
    while pi < top_i
        t := load64(pt + 8 * pi)
        tag := t.bit_and(255)
        pb := base + pi * PAGE
        if tag == 1
            idx := t.shr(8).bit_and(255)
            csz := t.shr(16).bit_and(65535)
            per := PAGE / csz
            for k in 0..per
                bs := pb + k * csz
                h := load64(bs)
                fresh := bs >= hs(H_BUMP + idx) and bs < hs(H_BEND + idx)
                if h != 0 and not fresh
                    if h.shr(16) > csz - 8
                        gc_bad_header(bs, if k > 0 then bs - csz else bs, csz, 1)
                    if h.bit_and(65280) != 0
                        gc_bad_header(bs, if k > 0 then bs - csz else bs, csz, 2)
            pi += 1
        elif tag == 2
            np := t.shr(8)
            h := load64(pb)
            if h.shr(16) > np * PAGE - 8 or h.bit_and(65280) != 0
                gc_bad_header(pb, pb, np * PAGE, 3)
            pi += np
        else
            pi += 1

## `AIL_GC_STATS` set: before each sweep, the live bytes and blocks by object
## kind on standard error (the table is words 300-363 and 380-443 of the heap
## state block). Costs nothing when the variable is unset.
fn gc_census()
    base := hs(H_BASE)
    pt := hs(H_PAGES)
    top_i := (hs(H_TOP) - base) / PAGE
    for k in 0..64
        hset(300 + k, 0)
        hset(380 + k, 0)
    mut pi := 0
    while pi < top_i
        t := load64(pt + 8 * pi)
        tag := t.bit_and(255)
        pb := base + pi * PAGE
        if tag == 1
            csz := t.shr(16).bit_and(65535)
            per := PAGE / csz
            for k in 0..per
                h := load64(pb + k * csz)
                if h.bit_and(256) != 0
                    kind := h.bit_and(63)
                    hset(300 + kind, hs(300 + kind) + csz)
                    hset(380 + kind, hs(380 + kind) + 1)
            pi += 1
        elif tag == 2
            np := t.shr(8)
            h := load64(pb)
            if h.bit_and(256) != 0
                kind := h.bit_and(63)
                hset(300 + kind, hs(300 + kind) + np * PAGE)
                hset(380 + kind, hs(380 + kind) + 1)
            pi += np
        else
            pi += 1
    flush()
    out_str("gc census: heap ")
    out_int((hs(H_TOP) - base) / 1048576)
    out_str(" MB")
    for k in 0..64
        if hs(380 + k) != 0
            out_str(", kind ")
            out_int(k)
            out_str(" ")
            out_int(hs(300 + k) / 1048576)
            out_str(" MB/")
            out_int(hs(380 + k))
    out_str("\n")
    flush_to(2)

## Collect garbage. Called by `alloc` when enough has been allocated.
fn gc_collect()
    # With threads, every other one parks first (native-abi.md §10); the
    # collector holds the allocation lock, so none can allocate meanwhile.
    gc_stop_world()
    m := heap_state()
    if hs(26) != 0
        gc_verify()
    sp := gc_regs(m + 8 * H_REGS)
    hset(H_MARKN, 0)
    gc_scan_range(m + 8 * H_REGS, m + 8 * (H_REGS + 10))
    gc_scan_range(sp, stack_end_self())
    gc_scan_threads()
    gc_scan_range(global(OUT_BUF), globals_end())
    gc_drain()
    if hs(25) != 0
        gc_census()
    gc_sweep()
    gc_start_world()
