## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## String equality for `match` arms and `==` on enums (ADR 0603). Lane 172's
## `compiler/rt/native/str.ail` has the same function; this file goes when
## that one lands.

## Whether `a` and `b` hold the same bytes.
fn str_eq(a str, b str) bool
    p := str_addr(a)
    q := str_addr(b)
    n := load64(p)
    if n != load64(q)
        return false
    mut i := 0
    while i + 8 <= n
        if load64(p + 16 + i) != load64(q + 16 + i)
            return false
        i += 8
    while i < n
        if load8(p + 16 + i) != load8(q + 16 + i)
            return false
        i += 1
    true
