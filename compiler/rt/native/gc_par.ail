## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Parallel marking (ADR 0944). Once the collector has marked the roots, the
## threads parked for it help drain the mark stack: each takes a share of the
## shared stack (the state block's `H_MARKS` words) into its own (in its
## allocation cache, heap.ail), scans from it, and hands half of it back
## while the shared one is empty, so no thread idles while another has a long
## stack. Marking is done when the shared stack is empty and no thread holds
## work. The collector starts and ends the phase (`gc_par_mark`, task.ail).

# Words of the heap state block.
H_MLOCK := 17
H_MBUSY := 18
H_MDONE := 19
H_MIN := 20

## Entries of a helper's own mark stack.
GCP_LCAP := 32768
## A helper stack this long gives half to an empty shared stack.
GCP_SHARE := 256
## A smaller heap is marked by the collector alone: waking the helpers would
## cost more than it saves.
GCP_MIN_HEAP := 33554432

## The shared stack's lock: a spin, since `lock` would park for the
## collection that is running.
fn gcp_lock(m int)
    while atomic_cas(m + 8 * H_MLOCK, 0, 1) != 0
        gcp_yield()

fn gcp_unlock(m int)
    atomic_store(m + 8 * H_MLOCK, 0)

fn gcp_yield()
    t := target()
    if t == 3
        import_call("SwitchToThread", 0, 0, 0, 0)
        return
    if t == 2
        import_call("_sched_yield", 0, 0, 0, 0)
        return
    syscall(if t == 0 then 24 else 124, 0, 0, 0, 0, 0, 0)

## Move the top half of mark stack `c` to the shared one.
fn gc_par_spill(c int)
    m := heap_state()
    g := gc_stack()
    n := load64(c + 16)
    h := n / 2
    if h == 0
        return
    gcp_lock(m)
    gn := load64(g + 16)
    if gn + h > load64(g + 8)
        fail(1, 0, 0)
    src := load64(c) + 8 * (n - h)
    dst := load64(g) + 8 * gn
    for i in 0..h
        store64(dst + 8 * i, load64(src + 8 * i))
    atomic_store(g + 16, gn + h)
    gcp_unlock(m)
    store64(c + 16, n - h)

## Mark until the phase is done, on any thread taking part.
fn gc_par_work()
    m := heap_state()
    g := gc_stack()
    c := heap_tb(m) + 8 * H_MARKS
    if load64(c) == 0
        st := sys_mmap(8 * GCP_LCAP)
        if st < 0
            fail(1, 0, 0)
        store64(c, st)
        store64(c + 8, GCP_LCAP)
    store64(c + 16, 0)
    while true
        gcp_lock(m)
        n := load64(g + 16)
        if n > 0
            mut take := n / 4
            if take < 64
                take = if n < 64 then n else 64
            if take > GCP_LCAP / 2
                take = GCP_LCAP / 2
            from := load64(g) + 8 * (n - take)
            to := load64(c)
            for i in 0..take
                store64(to + 8 * i, load64(from + 8 * i))
            atomic_store(g + 16, n - take)
            # Counted while the lock is held, so nobody sees an empty stack
            # and no worker while this one has work.
            atomic_add(m + 8 * H_MBUSY, 1)
            gcp_unlock(m)
            store64(c + 16, take)
            gc_drain_in(c, true)
            atomic_add(m + 8 * H_MBUSY, -1)
        else
            if atomic_load(m + 8 * H_MBUSY) == 0
                atomic_store(m + 8 * H_MDONE, 1)
                gcp_unlock(m)
                return
            gcp_unlock(m)
            if atomic_load(m + 8 * H_MDONE) != 0
                return
            gcp_yield()

## A parked thread saw the mark phase start (`GC_REQ` 2): take part unless
## it is already over. The collector waits for `H_MIN` to reach 0 before it
## sweeps.
fn gc_par_help()
    m := heap_state()
    atomic_add(m + 8 * H_MIN, 1)
    if atomic_load(global(GC_REQ)) == 2 and atomic_load(m + 8 * H_MDONE) == 0
        gc_par_work()
    atomic_add(m + 8 * H_MIN, -1)
    gcp_yield()
