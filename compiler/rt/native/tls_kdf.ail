## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## HMAC-SHA-256 (RFC 2104), HKDF (RFC 5869) and TLS 1.3's HKDF-Expand-Label
## (RFC 8446 section 7.1) for the native TLS client (ADR 0836), over raw
## addresses like tls_chacha.ail. The same algorithms and vectors as
## bootstrap/src/net/crypto/hkdf.rs (ADR 0366). Only the SHA-256 suites are
## here: the native client offers TLS_CHACHA20_POLY1305_SHA256.

KDF_OUT := 32

## HMAC-SHA-256 of the `mn` bytes at `msg` under the `kn` bytes at `key`: the
## 32-byte tag goes to `out`.
fn kdf_hmac(key int, kn int, msg int, mn int, out int)
    block := alloc_raw(64, KIND_BYTES)
    for i in 0..8
        store64(block + 8 * i, 0)
    if kn > 64
        hash_sha256_raw(key, kn, block)
    else
        copy_bytes(block, key, kn)
    inner := alloc_raw(64 + mn, KIND_BYTES)
    for i in 0..64
        store8(inner + i, load8(block + i).bit_xor(54))
    copy_bytes(inner + 64, msg, mn)
    digest := alloc_raw(32, KIND_BYTES)
    hash_sha256_raw(inner, 64 + mn, digest)
    outer := alloc_raw(96, KIND_BYTES)
    for i in 0..64
        store8(outer + i, load8(block + i).bit_xor(92))
    copy_bytes(outer + 64, digest, 32)
    hash_sha256_raw(outer, 96, out)

## HKDF-Extract: the 32-byte pseudorandom key from `salt` and `ikm`; an empty
## salt is 32 zero bytes.
fn kdf_extract(salt int, sn int, ikm int, ikn int, out int)
    if sn == 0
        zeros := alloc_raw(32, KIND_BYTES)
        for i in 0..4
            store64(zeros + 8 * i, 0)
        kdf_hmac(zeros, 32, ikm, ikn, out)
        return
    kdf_hmac(salt, sn, ikm, ikn, out)

## HKDF-Expand: `len` (at most 8160) bytes from `prk` (32 bytes) and `info`.
fn kdf_expand(prk int, info int, infon int, len int, out int)
    blocks := (len + 31) / 32
    buf := alloc_raw(32 + infon + 1, KIND_BYTES)
    t := alloc_raw(32, KIND_BYTES)
    mut tn := 0
    for i in 1..blocks + 1
        copy_bytes(buf, t, tn)
        copy_bytes(buf + tn, info, infon)
        store8(buf + tn + infon, i)
        kdf_hmac(prk, 32, buf, tn + infon + 1, t)
        tn = 32
        k := if i * 32 > len then len - (i - 1) * 32 else 32
        copy_bytes(out + (i - 1) * 32, t, k)

## HKDF-Expand-Label: the label `label` gets the prefix `tls13 `.
fn kdf_expand_label(secret int, label str, ctx int, ctxn int, len int, out int)
    ln := load64(str_addr(label))
    info := alloc_raw(10 + ln + ctxn, KIND_BYTES)
    store8(info, len.shr(8).bit_and(255))
    store8(info + 1, len.bit_and(255))
    store8(info + 2, 6 + ln)
    copy_bytes(info + 3, str_addr("tls13 ") + 16, 6)
    copy_bytes(info + 9, str_addr(label) + 16, ln)
    store8(info + 9 + ln, ctxn)
    copy_bytes(info + 10 + ln, ctx, ctxn)
    kdf_expand(secret, info, 10 + ln + ctxn, len, out)

## Derive-Secret: the 32-byte expand-label of a transcript hash.
fn kdf_derive_secret(secret int, label str, transcript_hash int, out int)
    kdf_expand_label(secret, label, transcript_hash, 32, 32, out)
