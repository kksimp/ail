## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Optionals and results (ADRs 0574-0576). An optional is a pointer or 0; a
## scalar is boxed in 8 bytes. A fallible function reports failure through
## the error slot, which holds the error's display text and is 0 otherwise;
## the return trace is a list of ready-made `  at PATH:LINE:COL` lines. Its
## first element is the list of context messages (err.ctx.2).

ERR := 8
TRACE := 9
## The error value of a failure whose type is a struct or an enum (ADR 0804).
ERRV := 12
## The pending error's type tag (ADR 1078): `err_tag_of` its type's name, 0
## when unknown. A worker keeps its own at `P_ERRT` in the pool block, one
## word per thread slot.
ERR_TAG := 67
P_ERRT := 13312

## Where the pending failure's words are: 0 the display text, 1 the error
## value, 2 the trace. The main thread keeps them in the global slots; a
## worker has its own in the pool block (`P_ERR`), so tasks that fail at the
## same time don't take each other's failure.
fn err_addr(k int) int
    if load64(global(MULTI)) != 0
        w := worker_index()
        if w >= 0
            return load64(global(TASKS)) + P_ERR + 24 * (w + 1) + 8 * k
    if k == 0
        return global(ERR)
    if k == 1
        return global(ERRV)
    global(TRACE)

## The address of this thread's pending error tag.
fn err_tag_addr() int
    if load64(global(MULTI)) != 0
        w := worker_index()
        if w >= 0
            return load64(global(TASKS)) + P_ERRT + 8 * (w + 1)
    global(ERR_TAG)

## The tag of the error type named `name` (its key: `fs.IoError`, `ParseError`,
## `mod.E`); `compiler/mir/lower_errmatch.ail` computes the same number.
fn err_tag_of(name str) int
    p := str_addr(name)
    n := load64(p)
    mut h := 0
    mut i := 0
    while i < n
        h = (h * 31 + load8(p + 16 + i)) % 2147483647
        i += 1
    if h == 0 then 1 else h

## Record the pending error's type (ADR 1078).
fn err_tag(t int)
    store64(err_tag_addr(), t)

fn err_tag_get() int
    load64(err_tag_addr())

## The pending error's value, left in place for `err_take`.
fn err_peek_value() int
    load64(err_addr(1))

# ---- optionals ----

fn box(v int) int
    p := alloc(8, KIND_ATOMIC)
    store64(p, v)
    p

fn box_opt(v int) int
    p := alloc(8, 4)
    store64(p, v)
    p

fn box_bool(b bool) int
    p := alloc(8, KIND_ATOMIC)
    store64(p, if b then 1 else 0)
    p

fn boxf(x float) int
    p := alloc(8, KIND_ATOMIC)
    storef(p, x)
    p

fn unbox(p int) int
    load64(p)

fn unbox_bool(p int) bool
    load64(p) != 0

fn unboxf(p int) float
    loadf(p)

# ---- results ----

## Fail with `msg` (the error's display text); `at` is the first trace line.
fn err_set(msg str, at str)
    store64(err_addr(0), str_addr(msg))
    store64(err_tag_addr(), 0)
    xs := list_new(8)
    list_push(xs, list_addr(list_new(8)))
    list_push(xs, str_addr(at))
    store64(err_addr(2), list_addr(xs))

## A `?` passes the failure on: add its location to the trace.
fn err_trace(at str)
    list_push(list_at(load64(err_addr(2))), str_addr(at))

## `e? "msg"` passes the failure on with a context message (err.ctx.2).
fn err_context(msg str)
    xs := list_at(load64(err_addr(2)))
    list_push(list_at(load64(load64(list_addr(xs) + 16))), str_addr(msg))

## `?` in a function that fails with the standard `Fail` (err.fail.3, ADR 1140): the
## pending failure becomes a `Fail` whose `msg` is its display text; the text and the
## trace stay. `tag` is the `Fail`'s type tag.
fn err_as_fail(tag int)
    e := obj_new(8, 4)
    store64(e, load64(err_addr(0)))
    err_value(e)
    err_tag(tag)

## The error as a value, for a failure that has one.
fn err_value(v int)
    store64(err_addr(1), v)

## Handle the failure: the error value, and the slot is clear.
fn err_take_value() int
    v := load64(err_addr(1))
    store64(err_addr(0), 0)
    store64(err_addr(1), 0)
    v

fn failed() bool
    load64(err_addr(0)) != 0

## Handle the failure: the error's display text, and the slot is clear.
fn err_take() str
    p := load64(err_addr(0))
    store64(err_addr(0), 0)
    store64(err_addr(1), 0)
    str_at(p)

## A task that failed keeps its error in a box until `wait` takes it.
fn err_box() int
    b := obj_new(32, 4)
    store64(b, load64(err_addr(0)))
    store64(b + 8, load64(err_addr(1)))
    store64(b + 16, load64(err_addr(2)))
    store64(b + 24, load64(err_tag_addr()))
    store64(err_addr(0), 0)
    store64(err_addr(1), 0)
    b

fn err_restore(b int)
    store64(err_addr(0), load64(b))
    store64(err_addr(1), load64(b + 8))
    store64(err_addr(2), load64(b + 16))
    store64(err_tag_addr(), load64(b + 24))

fn err_clear()
    store64(err_addr(0), 0)
    store64(err_addr(1), 0)

## The entry's last step: a failure that reached `main` is reported
## (err.text.1, err.ctx.3) and ends the process with status 1.
fn err_report()
    p := load64(err_addr(0))
    if p == 0
        return
    flush()
    out_str("error: ")
    out_str(str_at(p))
    out_byte(10)
    xs := list_at(load64(err_addr(2)))
    n := load64(list_addr(xs))
    cs := list_at(load64(load64(list_addr(xs) + 16)))
    mut j := 0
    while j < load64(list_addr(cs))
        out_str("  context: ")
        out_str(str_at(load64(load64(list_addr(cs) + 16) + 8 * j)))
        out_byte(10)
        j += 1
    mut i := 1
    while i < n
        out_str(str_at(load64(load64(list_addr(xs) + 16) + 8 * i)))
        out_byte(10)
        i += 1
    flush_to(2)
    sys_exit(1)

## `s` as the interpreter shows a string inside a value: in quotes, escaped.
fn str_quoted(s str) str
    sb_reset()
    os_put_quoted(s)
    sb_str()

## `c` as the interpreter shows a character inside a value: in single quotes,
## escaped (`out_escaped` in str.ail, as text).
fn char_quoted(c int) str
    sb_reset()
    sb_byte(39)
    if c == 92 or c == 39
        sb_byte(92)
        sb_byte(c)
    elif c == 10
        sb_text("\\n")
    elif c == 9
        sb_text("\\t")
    elif c == 13
        sb_text("\\r")
    elif c == 0
        sb_text("\\0")
    elif c < 32 or c >= 127 and c < 160
        os_put_u()
        put_hex(c)
        sb_byte(125)
    else
        sb_add_char(c)
    sb_byte(39)
    sb_str()
