## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The HTTP/2 client (ADR 0913, std.net.31; RFC 9113, RFC 7541): one request on a fresh
## TLS connection whose ALPN choice was `h2` (`TS_ALPN` of tls_client.ail).
## The connection preface and SETTINGS go first, then the request's HEADERS
## (pseudo-headers in the order :method, :authority, :scheme, :path, then the
## regular headers in a stable browser-like order, `h2_rank`) and DATA, within
## the server's flow-control windows. The response's HEADERS (with HPACK, the
## dynamic table and Huffman coding), CONTINUATION, DATA, SETTINGS, PING,
## WINDOW_UPDATE, GOAWAY and RST_STREAM are handled until stream 1 ends. The
## connection is then closed, not pooled. A server that doesn't choose `h2`
## never gets here: `net_http.ail` sends HTTP/1.1 as before. Not built yet:
## server push (refused with ENABLE_PUSH 0), several streams, Huffman coding
## of what we send, pooling.

# The state of one connection: words of an object.
H2_O := 0
H2_H := 8
H2_URL := 16
H2_AT := 24
H2_RB := 32
H2_WB := 40
H2_SWIN := 48
H2_TWIN := 56
H2_IWIN := 64
H2_CRCV := 72
H2_TRCV := 80
H2_DYN := 88
H2_DN := 96
H2_DSZ := 104
H2_DMAX := 112
H2_SN := 120
H2_SV := 128
H2_TRIE := 136
H2_POS := 144
H2_ERR := 152
H2_STATUS := 160
H2_FINAL := 168
H2_KEEP := 176
H2_HEADERS := 184
H2_ALL := 192
H2_BODY := 200
H2_BLK := 208
H2_INBLK := 216
H2_ENDS := 224
H2_DONE := 232
H2_SEND := 240
H2_SENDPOS := 248
H2_FT := 256
H2_FF := 264
H2_FS := 272
H2_FL := 280
H2_SID := 288
H2_NEXT := 296
H2_NOREUSE := 304
H2_GOT := 312
H2_RETRY := 320
H2_BYTES := 328

# Our SETTINGS: INITIAL_WINDOW_SIZE, and the connection window we open.
H2_RWIN := 6291456
H2_CWIN := 16777216
H2_MAXF := 16384

## With `AIL_NET_DEBUG` set, a line on standard error naming the protocol a
## request used.
fn net_debug(msg str)
    if os_env_get("AIL_NET_DEBUG") != ""
        err_begin()
        out_str(msg)
        out_str("\n")
        err_end()

fn h2_pow2(bits int) int
    mut v := 1
    for _ in 0..bits
        v = v * 2
    v

fn h2_fail(c int, msg str) int
    net_fail(str_at(load64(c + H2_URL)), "protocol", msg, str_at(load64(c + H2_AT)))

## Remember the first decoding error.
fn h2_seterr(c int, msg str)
    if load64(c + H2_ERR) == 0
        store64(c + H2_ERR, str_addr(msg))

fn h2_put(b int, v int)
    t := alloc_raw(8, KIND_BYTES)
    store8(t, v)
    hb_add(b, t, 1)

fn h2_w32(p int, v int)
    store8(p, v.shr(24).bit_and(255))
    store8(p + 1, v.shr(16).bit_and(255))
    store8(p + 2, v.shr(8).bit_and(255))
    store8(p + 3, v.bit_and(255))

fn h2_r32(p int) int
    load8(p) * 16777216 + load8(p + 1) * 65536 + load8(p + 2) * 256 + load8(p + 3)

fn h2_err_name(code int) str
    names := [
        "NO_ERROR",
        "PROTOCOL_ERROR",
        "INTERNAL_ERROR",
        "FLOW_CONTROL_ERROR",
        "SETTINGS_TIMEOUT",
        "STREAM_CLOSED",
        "FRAME_SIZE_ERROR",
        "REFUSED_STREAM",
        "CANCEL",
        "COMPRESSION_ERROR",
        "CONNECT_ERROR",
        "ENHANCE_YOUR_CALM",
        "INADEQUATE_SECURITY",
        "HTTP_1_1_REQUIRED",
    ]
    if code >= 0 and code < 14
        return names[code]
    "error {code}"

# ---- HPACK: sending ----

## The prefixed integer of RFC 7541 5.1: `first` holds the bits above the
## `bits`-bit prefix.
fn h2_int_out(b int, first int, bits int, v int)
    mx := h2_pow2(bits) - 1
    if v < mx
        h2_put(b, first.bit_or(v))
        return
    h2_put(b, first.bit_or(mx))
    mut r := v - mx
    while r >= 128
        h2_put(b, r.bit_and(127).bit_or(128))
        r = r.shr(7)
    h2_put(b, r)

fn h2_str_out(b int, s str)
    n := load64(str_addr(s))
    h2_int_out(b, 0, 7, n)
    if n > 0
        hb_add(b, str_addr(s) + 16, n)

## The index in the static table of `name` (with `value` when `both`), or 0.
fn h2_static_find(c int, name str, value str, both bool) int
    sn := load64(c + H2_SN)
    sv := load64(c + H2_SV)
    for i in 1..62
        if str_at(load64(sn + 8 * i)) == name
            if not both or str_at(load64(sv + 8 * i)) == value
                return i
    0

## One header field: indexed when the table has the pair, else a literal
## without indexing (never indexed for credentials) naming a table entry.
fn h2_lit(c int, b int, name str, value str)
    ex := h2_static_find(c, name, value, true)
    if ex > 0
        h2_int_out(b, 128, 7, ex)
        return
    never := name == "authorization" or name == "cookie" or name == "proxy-authorization"
    first := if never then 16 else 0
    ni := h2_static_find(c, name, value, false)
    if ni > 0
        h2_int_out(b, first, 4, ni)
    else
        h2_put(b, first)
        h2_str_out(b, name)
    h2_str_out(b, value)

## Where a regular header goes among the others: the order browsers send
## them in, so that it is stable (insertion order within a rank).
fn h2_rank(name str) int
    if name == "content-length"
        return 2
    if name == "content-type"
        return 5
    if name == "sec-ch-ua"
        return 10
    if name == "sec-ch-ua-mobile"
        return 11
    if name == "sec-ch-ua-platform"
        return 12
    if name.starts_with("sec-ch-")
        return 13
    if name == "upgrade-insecure-requests"
        return 14
    if name == "user-agent"
        return 20
    if name == "accept"
        return 30
    if name == "sec-fetch-site"
        return 31
    if name == "sec-fetch-mode"
        return 32
    if name == "sec-fetch-user"
        return 33
    if name == "sec-fetch-dest"
        return 34
    if name == "referer"
        return 35
    if name == "accept-encoding"
        return 40
    if name == "accept-language"
        return 41
    if name == "cookie"
        return 50
    42

## Add a regular header to the sorted arrays; the new count.
fn h2_add(names int, vals int, ranks int, cnt int, name str, value str) int
    r := h2_rank(name)
    mut j := cnt
    while j > 0 and load64(ranks + 8 * (j - 1)) > r
        store64(ranks + 8 * j, load64(ranks + 8 * (j - 1)))
        store64(names + 8 * j, load64(names + 8 * (j - 1)))
        store64(vals + 8 * j, load64(vals + 8 * (j - 1)))
        j -= 1
    store64(ranks + 8 * j, r)
    store64(names + 8 * j, str_addr(name))
    store64(vals + 8 * j, str_addr(value))
    cnt + 1

## Headers the connection or the framing owns; not sent as given.
fn h2_owned(name str) bool
    name == "connection"
        or name == "keep-alive"
        or name == "proxy-connection"
        or name == "transfer-encoding"
        or name == "upgrade"
        or name == "te"
        or name == "content-length"
        or name == "host"

## The request's header block (RFC 7541) into `b`. `hdrs` is the headers
## map of the options (or 0); a `host` header there names the :authority.
fn h2_build(
    c int,
    b int,
    method str,
    authority str,
    path str,
    has_body bool,
    blen int,
    ctype str,
    hdrs int,
    strip bool,
)
    h2_lit(c, b, ":method", method)
    h2_lit(c, b, ":authority", authority)
    h2_lit(c, b, ":scheme", "https")
    h2_lit(c, b, ":path", path)
    cap := http_slots(hdrs) + 6
    names := obj_new(8 * cap, 4)
    vals := obj_new(8 * cap, 4)
    ranks := obj_new(8 * cap, 4)
    for i in 0..cap
        store64(names + 8 * i, 0)
        store64(vals + 8 * i, 0)
        store64(ranks + 8 * i, 0)
    mut cnt := 0
    if not http_given(hdrs, "user-agent")
        cnt = h2_add(names, vals, ranks, cnt, "user-agent", "ail")
    if not http_given(hdrs, "accept")
        cnt = h2_add(names, vals, ranks, cnt, "accept", "*/*")
    if not http_given(hdrs, "accept-encoding")
        cnt = h2_add(names, vals, ranks, cnt, "accept-encoding", "gzip, deflate, br")
    if load64(str_addr(ctype)) > 0 and not http_given(hdrs, "content-type")
        cnt = h2_add(names, vals, ranks, cnt, "content-type", ctype)
    if has_body
        cnt = h2_add(names, vals, ranks, cnt, "content-length", "{blen}")
    for i in 0..http_slots(hdrs)
        e := http_slot(hdrs, i)
        if load64(e) != -1
            k := str_addr(str_at(load64(e + 8)))
            name := http_lower(k + 16, load64(k))
            skip := h2_owned(name) or (strip and (name == "authorization" or name == "cookie"))
            if not skip
                cnt = h2_add(names, vals, ranks, cnt, name, str_at(load64(e + 16)))
    for i in 0..cnt
        h2_lit(c, b, str_at(load64(names + 8 * i)), str_at(load64(vals + 8 * i)))

## The value of the user's `host` header, or `dflt`.
fn h2_authority(hdrs int, dflt str) str
    for i in 0..http_slots(hdrs)
        e := http_slot(hdrs, i)
        if load64(e) != -1
            k := str_addr(str_at(load64(e + 8)))
            if http_ieq(k + 16, load64(k), "host")
                return str_at(load64(e + 16))
    dflt

# ---- HPACK: receiving ----

## The prefixed integer at the decode position of `c` in the `n` bytes at
## `p`, or -1.
fn h2_int_in(c int, p int, n int, bits int) int
    mut pos := load64(c + H2_POS)
    if pos >= n
        return -1
    mx := h2_pow2(bits) - 1
    mut v := load8(p + pos).bit_and(mx)
    pos += 1
    if v >= mx
        mut shift := 0
        while true
            if pos >= n or shift > 28
                return -1
            b := load8(p + pos)
            pos += 1
            v += b.bit_and(127).shl(shift)
            shift += 7
            if b < 128
                break
    store64(c + H2_POS, pos)
    v

fn h2_hex(p int, digits int) int
    mut v := 0
    for i in 0..digits
        v = v * 16 + tc_nib(load8(p + i))
    v

## The decoding tree of the Huffman code: nodes of two words (the 0 and the
## 1 child); a child is a node number, or 1000 plus the symbol, or 0.
fn h2_trie_build(c int) int
    t := alloc_raw(16 * 600, KIND_BYTES)
    for i in 0..1200
        store64(t + 8 * i, 0)
    mut count := 1
    mut sym := 0
    for chunk in h2_huff_table()
        cp := str_addr(chunk)
        for j in 0..load64(cp) / 10
            base := cp + 16 + 10 * j
            code := h2_hex(base, 8)
            len := h2_hex(base + 8, 2)
            mut cur := 0
            mut bit := len - 1
            while bit >= 0
                bv := code.shr(bit).bit_and(1)
                slot := t + 16 * cur + 8 * bv
                if bit == 0
                    store64(slot, 1000 + sym)
                else
                    mut nx := load64(slot)
                    if nx == 0
                        nx = count
                        count += 1
                        store64(slot, nx)
                    cur = nx
                bit -= 1
            sym += 1
    store64(c + H2_TRIE, t)
    t

## Huffman-decode `n` bytes at `p` into `out` (room for 2 * n): the length,
## or -1 for a bad code, the EOS symbol, or padding (RFC 7541 5.2).
fn h2_huff(c int, p int, n int, out int) int
    mut trie := load64(c + H2_TRIE)
    if trie == 0
        trie = h2_trie_build(c)
    mut cur := 0
    mut m := 0
    mut pad := 0
    mut ones := true
    for i in 0..n
        b := load8(p + i)
        mut k := 7
        while k >= 0
            bit := b.shr(k).bit_and(1)
            nx := load64(trie + 16 * cur + 8 * bit)
            if nx == 0
                return -1
            if nx >= 1000
                if nx == 1256
                    return -1
                store8(out + m, nx - 1000)
                m += 1
                cur = 0
                pad = 0
                ones = true
            else
                cur = nx
                pad += 1
                if bit == 0
                    ones = false
            k -= 1
    if cur != 0 and (pad > 7 or not ones)
        return -1
    m

## The string at the decode position (RFC 7541 5.2); an error is left in `c`.
fn h2_str_in(c int, p int, n int) str
    pos := load64(c + H2_POS)
    if pos >= n
        h2_seterr(c, "a header string runs past its block")
        return ""
    huff := load8(p + pos).bit_and(128) != 0
    ln := h2_int_in(c, p, n, 7)
    sp := load64(c + H2_POS)
    if ln < 0 or sp + ln > n
        h2_seterr(c, "a header string runs past its block")
        return ""
    store64(c + H2_POS, sp + ln)
    if not huff
        return os_str_from(p + sp, ln)
    out := alloc_raw(2 * ln + 8, KIND_BYTES)
    m := h2_huff(c, p + sp, ln, out)
    if m < 0
        h2_seterr(c, "a Huffman-coded header string is malformed")
        return ""
    os_str_from(out, m)

## The name, or the value, of table entry `idx` (static, then dynamic).
fn h2_entry(c int, idx int, value bool) str
    if idx <= 61
        base := load64(c + (if value then H2_SV else H2_SN))
        return str_at(load64(base + 8 * idx))
    d := idx - 62
    if d >= load64(c + H2_DN)
        h2_seterr(c, "a header refers to table entry {idx}, which doesn't exist")
        return ""
    str_at(load64(load64(c + H2_DYN) + 8 * (d + (if value then 130 else 0))))

## Evict the oldest dynamic entries until the table is at most `target`.
fn h2_dyn_evict(c int, target int)
    dyn := load64(c + H2_DYN)
    while load64(c + H2_DN) > 0 and load64(c + H2_DSZ) > target
        last := load64(c + H2_DN) - 1
        nm := str_addr(str_at(load64(dyn + 8 * last)))
        vl := str_addr(str_at(load64(dyn + 8 * (130 + last))))
        store64(c + H2_DSZ, load64(c + H2_DSZ) - (load64(nm) + load64(vl) + 32))
        store64(dyn + 8 * last, 0)
        store64(dyn + 8 * (130 + last), 0)
        store64(c + H2_DN, last)

fn h2_dyn_add(c int, name str, value str)
    sz := load64(str_addr(name)) + load64(str_addr(value)) + 32
    h2_dyn_evict(c, load64(c + H2_DMAX) - sz)
    if sz > load64(c + H2_DMAX)
        return
    dyn := load64(c + H2_DYN)
    n := load64(c + H2_DN)
    mut i := n
    while i > 0
        store64(dyn + 8 * i, load64(dyn + 8 * (i - 1)))
        store64(dyn + 8 * (130 + i), load64(dyn + 8 * (129 + i)))
        i -= 1
    store64(dyn, str_addr(name))
    store64(dyn + 8 * 130, str_addr(value))
    store64(c + H2_DN, n + 1)
    store64(c + H2_DSZ, load64(c + H2_DSZ) + sz)

## A decoded header field: `:status` sets the status, other fields of the
## response's head go to the maps; interim (1xx) heads and trailers are
## decoded for the table's sake and dropped.
fn h2_emit(c int, name str, value str)
    np := str_addr(name)
    if load64(np) == 0
        h2_seterr(c, "a header has an empty name")
        return
    if load8(np + 16) == 58
        if name == ":status"
            st := http_number(value, false)
            if st < 100
                h2_seterr(c, "the :status `{value}` is not a status")
                return
            if load64(c + H2_KEEP) != 0
                store64(c + H2_STATUS, st)
                if st >= 200
                    store64(c + H2_FINAL, 1)
                else
                    store64(c + H2_KEEP, 0)
        return
    if load64(c + H2_KEEP) != 0 and load64(c + H2_FINAL) != 0
        http_header(load64(c + H2_HEADERS), load64(c + H2_ALL), name, value)

## Decode the header block of `n` bytes at `p`: 1, or 0 with the error in `c`.
fn h2_decode(c int, p int, n int) int
    store64(c + H2_POS, 0)
    store64(c + H2_KEEP, if load64(c + H2_FINAL) == 0 then 1 else 0)
    while load64(c + H2_POS) < n and load64(c + H2_ERR) == 0
        b := load8(p + load64(c + H2_POS))
        if b.bit_and(128) != 0
            idx := h2_int_in(c, p, n, 7)
            if idx <= 0
                h2_seterr(c, "an indexed header field has index 0")
            else
                nm := h2_entry(c, idx, false)
                vl := h2_entry(c, idx, true)
                if load64(c + H2_ERR) == 0
                    h2_emit(c, nm, vl)
        elif b.bit_and(224) == 32
            sz := h2_int_in(c, p, n, 5)
            if sz < 0 or sz > 4096
                h2_seterr(c, "a dynamic table size update is over the 4096 we allow")
            else
                store64(c + H2_DMAX, sz)
                h2_dyn_evict(c, sz)
        else
            index := b.bit_and(192) == 64
            idx := h2_int_in(c, p, n, if index then 6 else 4)
            if idx < 0
                h2_seterr(c, "a header field's name index runs past its block")
            else
                nm := if idx == 0 then h2_str_in(c, p, n) else h2_entry(c, idx, false)
                vl := h2_str_in(c, p, n)
                if load64(c + H2_ERR) == 0
                    if index
                        h2_dyn_add(c, nm, vl)
                    h2_emit(c, nm, vl)
    if load64(c + H2_ERR) != 0
        return 0
    1

# ---- frames ----

## Send one frame of `n` payload bytes at `p` (at most `H2_MAXF`): 1, or 0
## with the error set.
fn h2_frame(c int, ty int, flags int, stream int, p int, n int) int
    w := load64(c + H2_WB)
    store8(w, n.shr(16).bit_and(255))
    store8(w + 1, n.shr(8).bit_and(255))
    store8(w + 2, n.bit_and(255))
    store8(w + 3, ty)
    store8(w + 4, flags)
    h2_w32(w + 5, stream)
    if n > 0
        copy_bytes(w + 9, p, n)
    o := load64(c + H2_O)
    e := tc_write(o, w, 9 + n)
    if e < 0
        net_io_fail(o, e, str_at(load64(c + H2_AT)))
        return 0
    1

fn h2_window_update(c int, stream int, inc int) int
    t := alloc_raw(8, KIND_BYTES)
    h2_w32(t, inc)
    h2_frame(c, 8, 0, stream, t, 4)

## Read one frame into the read buffer: its type, flags, stream and length
## go to the state; the payload is at `H2_RB` + 9. 1, or 0 with the error set.
fn h2_read(c int) int
    rb := load64(c + H2_RB)
    o := load64(c + H2_O)
    store64(rb + 8, 0)
    e := http_take(o, rb, 9)
    if e < 0
        http_read_fail(o, e, str_at(load64(c + H2_URL)), str_at(load64(c + H2_AT)))
        return 0
    p := load64(rb)
    n := load8(p) * 65536 + load8(p + 1) * 256 + load8(p + 2)
    if n > H2_MAXF
        h2_fail(
            c,
            "the server sent a frame of {n} bytes, over the 16384 allowed (FRAME_SIZE_ERROR)",
        )
        return 0
    store64(c + H2_GOT, 1)
    store64(c + H2_FT, load8(p + 3))
    store64(c + H2_FF, load8(p + 4))
    store64(c + H2_FS, h2_r32(p + 5).bit_and(2147483647))
    store64(c + H2_FL, n)
    if n > 0
        e2 := http_take(o, rb, n)
        if e2 < 0
            http_read_fail(o, e2, str_at(load64(c + H2_URL)), str_at(load64(c + H2_AT)))
            return 0
    1

## Send as much of the request body as the windows allow: 1, or 0 on a
## write failure.
fn h2_pump(c int) int
    s := load64(c + H2_SEND)
    if s == 0
        return 1
    total := load64(s)
    while load64(c + H2_SENDPOS) < total
        pos := load64(c + H2_SENDPOS)
        sw := load64(c + H2_SWIN)
        tw := load64(c + H2_TWIN)
        win := if sw < tw then sw else tw
        if win <= 0
            return 1
        mut k := total - pos
        if k > win
            k = win
        if k > H2_MAXF
            k = H2_MAXF
        last := pos + k == total
        if h2_frame(c, 0, if last then 1 else 0, load64(c + H2_SID), s + 16 + pos, k) == 0
            return 0
        store64(c + H2_SWIN, sw - k)
        store64(c + H2_TWIN, tw - k)
        store64(c + H2_SENDPOS, pos + k)
    1

## Send the header block `blk` as HEADERS and CONTINUATION frames.
fn h2_send_headers(c int, blk int, end_stream bool) int
    p := load64(blk)
    n := load64(blk + 8)
    mut off := 0
    mut first := true
    while first or off < n
        mut k := n - off
        if k > H2_MAXF
            k = H2_MAXF
        last := off + k >= n
        mut fl := if last then 4 else 0
        if first and end_stream
            fl += 1
        if h2_frame(c, if first then 1 else 9, fl, load64(c + H2_SID), p + off, k) == 0
            return 0
        off += k
        first = false
    1

## The header block is complete: decode it, and finish the stream if it
## carried END_STREAM.
fn h2_block_done(c int) int
    store64(c + H2_INBLK, 0)
    blk := load64(c + H2_BLK)
    if h2_decode(c, load64(blk), load64(blk + 8)) == 0
        return h2_fail(c, "a bad header block: {str_at(load64(c + H2_ERR))} (COMPRESSION_ERROR)")
    if load64(c + H2_ENDS) != 0
        if load64(c + H2_FINAL) == 0
            return h2_fail(c, "the stream ended before a final response status (PROTOCOL_ERROR)")
        store64(c + H2_DONE, 1)
    1

## Credit what was received, once a good part of a window is used.
fn h2_credit(c int) int
    if load64(c + H2_CRCV) >= H2_CWIN / 4
        if h2_window_update(c, 0, load64(c + H2_CRCV)) == 0
            return 0
        store64(c + H2_CRCV, 0)
    if load64(c + H2_TRCV) >= H2_RWIN / 4 and load64(c + H2_DONE) == 0
        if h2_window_update(c, load64(c + H2_SID), load64(c + H2_TRCV)) == 0
            return 0
        store64(c + H2_TRCV, 0)
    1

## Act on the frame just read: 1 to go on, 0 with the error set.
fn h2_handle(c int) int
    ty := load64(c + H2_FT)
    fl := load64(c + H2_FF)
    s := load64(c + H2_FS)
    n := load64(c + H2_FL)
    p := load64(load64(c + H2_RB)) + 9
    sid := load64(c + H2_SID)
    if load64(c + H2_INBLK) != 0 and ty != 9
        return h2_fail(
            c,
            "the server interrupted a header block with a frame of type {ty} (PROTOCOL_ERROR)",
        )
    if ty == 0
        if s == 0
            return h2_fail(c, "the server sent DATA on stream 0 (PROTOCOL_ERROR)")
        mut off := 0
        mut len := n
        if fl.bit_and(8) != 0
            if n < 1 or load8(p) >= n
                return h2_fail(c, "the server sent bad padding (PROTOCOL_ERROR)")
            off = 1
            len = n - 1 - load8(p)
        store64(c + H2_CRCV, load64(c + H2_CRCV) + n)
        if s == sid
            store64(c + H2_TRCV, load64(c + H2_TRCV) + n)
            if load64(c + H2_FINAL) == 0
                return h2_fail(
                    c,
                    "the server sent DATA before the response's headers (PROTOCOL_ERROR)",
                )
            body := load64(c + H2_BODY)
            if load64(body + 8) + len > 268435456
                return h2_fail(c, "the response body is over 256 MiB")
            hb_add(body, p + off, len)
            if fl.bit_and(1) != 0
                store64(c + H2_DONE, 1)
        return h2_credit(c)
    if ty == 1
        if s != sid
            return h2_fail(c, "the server sent HEADERS on stream {s} (PROTOCOL_ERROR)")
        mut off := 0
        mut len := n
        if fl.bit_and(8) != 0
            if n < 1 or load8(p) >= n
                return h2_fail(c, "the server sent bad padding (PROTOCOL_ERROR)")
            off = 1
            len = n - 1 - load8(p)
        if fl.bit_and(32) != 0
            off += 5
            len -= 5
        if len < 0
            return h2_fail(c, "a HEADERS frame is too short (FRAME_SIZE_ERROR)")
        blk := load64(c + H2_BLK)
        store64(blk + 8, 0)
        hb_add(blk, p + off, len)
        store64(c + H2_ENDS, fl.bit_and(1))
        if fl.bit_and(4) != 0
            return h2_block_done(c)
        store64(c + H2_INBLK, 1)
        return 1
    if ty == 9
        if load64(c + H2_INBLK) == 0 or s != sid
            return h2_fail(
                c,
                "the server sent a CONTINUATION without a header block (PROTOCOL_ERROR)",
            )
        blk := load64(c + H2_BLK)
        if load64(blk + 8) + n > HTTP_MAX_HEAD
            return h2_fail(c, "the response headers are too long")
        hb_add(blk, p, n)
        if fl.bit_and(4) != 0
            return h2_block_done(c)
        return 1
    if ty == 4
        if fl.bit_and(1) != 0
            return 1
        if n % 6 != 0
            return h2_fail(c, "the server sent a SETTINGS frame of {n} bytes (FRAME_SIZE_ERROR)")
        mut i := 0
        while i < n
            id := load8(p + i) * 256 + load8(p + i + 1)
            v := h2_r32(p + i + 2)
            if id == 4
                if v > 2147483647
                    return h2_fail(
                        c,
                        "the server's initial window is over 2^31 - 1 (FLOW_CONTROL_ERROR)",
                    )
                tw := load64(c + H2_TWIN) + v - load64(c + H2_IWIN)
                if tw > 2147483647
                    return h2_fail(c, "the server's window is over 2^31 - 1 (FLOW_CONTROL_ERROR)")
                store64(c + H2_TWIN, tw)
                store64(c + H2_IWIN, v)
            i += 6
        return h2_frame(c, 4, 1, 0, p, 0)
    if ty == 6
        if n != 8
            return h2_fail(c, "the server sent a PING of {n} bytes (FRAME_SIZE_ERROR)")
        if fl.bit_and(1) == 0
            return h2_frame(c, 6, 1, 0, p, 8)
        return 1
    if ty == 8
        if n != 4
            return h2_fail(c, "the server sent a WINDOW_UPDATE of {n} bytes (FRAME_SIZE_ERROR)")
        inc := h2_r32(p).bit_and(2147483647)
        if inc == 0
            return h2_fail(c, "the server sent a WINDOW_UPDATE of 0 (PROTOCOL_ERROR)")
        if s == 0
            w := load64(c + H2_SWIN) + inc
            if w > 2147483647
                return h2_fail(
                    c,
                    "the server's connection window is over 2^31 - 1 (FLOW_CONTROL_ERROR)",
                )
            store64(c + H2_SWIN, w)
        elif s == sid
            w := load64(c + H2_TWIN) + inc
            if w > 2147483647
                return h2_fail(
                    c,
                    "the server's stream window is over 2^31 - 1 (FLOW_CONTROL_ERROR)",
                )
            store64(c + H2_TWIN, w)
        return 1
    if ty == 7
        if n < 8
            return h2_fail(c, "the server sent a GOAWAY of {n} bytes (FRAME_SIZE_ERROR)")
        last := h2_r32(p).bit_and(2147483647)
        code := h2_r32(p + 4)
        store64(c + H2_NOREUSE, 1)
        if last < sid
            store64(c + H2_RETRY, 1)
            return h2_fail(
                c,
                "the server won't process the request: GOAWAY, {h2_err_name(code)} ({code})",
            )
        return 1
    if ty == 3
        if s == sid
            if n != 4
                return h2_fail(c, "the server sent a RST_STREAM of {n} bytes (FRAME_SIZE_ERROR)")
            code := h2_r32(p)
            return h2_fail(c, "the server reset the stream: {h2_err_name(code)} ({code})")
        return 1
    if ty == 5
        return h2_fail(c, "the server pushed a stream we refused (PROTOCOL_ERROR)")
    1

# ---- the exchange ----

## One request over HTTP/2 on the new TLS connection `h` (ALPN chose `h2`):
## the response object as `http_exchange_on` makes it, or 0 after a failure.
## The connection then waits in the pool under `key2` (see `h2_request`).
fn h2_exchange(
    h int,
    method str,
    url str,
    body str,
    ctype str,
    spec int,
    next int,
    u int,
    key2 str,
    at str,
) int
    c := h2_open(h, url, at)
    if c == 0
        return 0
    h2_request(c, method, body, ctype, spec, next, u, false, false, key2, at)

## The state of a connection `h`, with the preface and our SETTINGS sent; 0
## after a write failure (the connection is closed).
fn h2_open(h int, url str, at str) int
    o := net_obj(h)
    c := obj_new(H2_BYTES, 4)
    for i in 0..H2_BYTES / 8
        store64(c + 8 * i, 0)
    store64(c + H2_O, o)
    store64(c + H2_H, h)
    store64(c + H2_URL, str_addr(url))
    store64(c + H2_AT, str_addr(at))
    store64(c + H2_RB, hb_new())
    store64(c + H2_WB, alloc_raw(H2_MAXF + 64, KIND_BYTES))
    store64(c + H2_SWIN, 65535)
    store64(c + H2_TWIN, 65535)
    store64(c + H2_IWIN, 65535)
    store64(c + H2_DMAX, 4096)
    store64(c + H2_NEXT, 1)
    dyn := obj_new(8 * 260, 4)
    for i in 0..260
        store64(dyn + 8 * i, 0)
    store64(c + H2_DYN, dyn)
    sn := obj_new(8 * 62, 4)
    sv := obj_new(8 * 62, 4)
    mut ni := 0
    for s in h2_static_names()
        store64(sn + 8 * ni, str_addr(s))
        ni += 1
    ni = 0
    for s in h2_static_values()
        store64(sv + 8 * ni, str_addr(s))
        ni += 1
    store64(c + H2_SN, sn)
    store64(c + H2_SV, sv)
    store64(c + H2_BLK, hb_new())
    # The preface, our SETTINGS (no push; a large stream window; a header
    # list limit), and a larger connection window.
    pre := str_addr("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
    e := tc_write(o, pre + 16, 24)
    if e < 0
        net_io_fail(o, e, at)
        net_close(h)
        return 0
    st := alloc_raw(24, KIND_BYTES)
    store8(st, 0)
    store8(st + 1, 2)
    h2_w32(st + 2, 0)
    store8(st + 6, 0)
    store8(st + 7, 4)
    h2_w32(st + 8, H2_RWIN)
    store8(st + 12, 0)
    store8(st + 13, 6)
    h2_w32(st + 14, 262144)
    if h2_frame(c, 4, 0, 0, st, 18) == 0 or h2_window_update(c, 0, H2_CWIN - 65535) == 0
        net_close(h)
        return 0
    c

## A failed request on `c`: the connection is closed. A reused connection
## that the server had closed, or a request it says it did not process
## (GOAWAY), is -1, to be sent again on a new connection when `again`.
fn h2_abort(c int, again bool, reused bool) int
    net_close(load64(c + H2_H))
    if reused and again
        if load64(c + H2_RETRY) != 0 or (load64(c + H2_GOT) == 0 and http_conn_lost())
            err_clear()
            return -1
    0

## One request on the stream `H2_NEXT` of `c`, a new connection or one from
## the pool (`reused`). After a response that leaves the connection clean and
## open it waits in the pool under `key2` with its state.
fn h2_request(
    c int,
    method str,
    body str,
    ctype str,
    spec int,
    next int,
    u int,
    again bool,
    reused bool,
    key2 str,
    at str,
) int
    h := load64(c + H2_H)
    o := load64(c + H2_O)
    url := str_at(load64(c + H2_URL))
    store64(c + H2_AT, str_addr(at))
    for k in [
        H2_STATUS,
        H2_FINAL,
        H2_KEEP,
        H2_ENDS,
        H2_INBLK,
        H2_DONE,
        H2_SEND,
        H2_SENDPOS,
        H2_TRCV,
        H2_ERR,
        H2_GOT,
        H2_RETRY,
    ]
        store64(c + k, 0)
    headers := map_new(1, 0, 0)
    all := map_new(1, 1, 8)
    store64(c + H2_HEADERS, headers)
    store64(c + H2_ALL, all)
    store64(c + H2_BODY, hb_new())
    store64(c + H2_SID, load64(c + H2_NEXT))
    store64(c + H2_NEXT, load64(c + H2_NEXT) + 2)
    store64(c + H2_TWIN, load64(c + H2_IWIN))
    host := str_at(load64(u + 8))
    port := load64(u + 16)
    path := str_at(load64(u + 24))
    dflt := if port == 443 then host else "{host}:{port}"
    hdrs := if spec == 0 then 0 else load64(spec)
    strip := spec != 0 and load64(spec + 24) != 0
    blen := load64(str_addr(body))
    has_body := blen > 0 or method == "POST" or method == "PUT" or method == "PATCH"
    blk := hb_new()
    h2_build(c, blk, method, h2_authority(hdrs, dflt), path, has_body, blen, ctype, hdrs, strip)
    if h2_send_headers(c, blk, blen == 0) == 0
        return h2_abort(c, again, reused)
    if blen > 0
        store64(c + H2_SEND, str_addr(body))
    while load64(c + H2_DONE) == 0
        if h2_pump(c) == 0 or h2_read(c) == 0 or h2_handle(c) == 0
            return h2_abort(c, again, reused)
    status := load64(c + H2_STATUS)
    how := if reused then " (pooled connection)" else ""
    net_debug("net: h2 {method} {url} -> {status}{how}")
    b := load64(c + H2_BODY)
    text := net_text(load64(b), load64(b + 8))
    raw := str_new(load64(b + 8), load64(b + 8))
    copy_bytes(raw + 16, load64(b), load64(b + 8))
    resp := obj_new(40, 4)
    store64(resp, status)
    store64(resp + 8, headers)
    store64(resp + 16, str_addr(text))
    store64(resp + 24, all)
    store64(resp + 32, raw)
    loc := http_get_header(headers, "location")
    if (status == 301 or status == 302 or status == 303 or status == 307 or status == 308)
        and load64(str_addr(loc)) > 0
        store64(next, str_addr(http_resolve(url, loc)))
    else
        store64(next, 0)
    # Kept for the next request to this origin when nothing is half read:
    # no GOAWAY, the socket buffer and the TLS record drained, no end of
    # stream, and streams left to open.
    st := load64(o + NET_TLS)
    if load64(c + H2_NOREUSE) == 0
        and load64(c + H2_NEXT) < 2000000000
        and load64(o + NET_POS) == load64(o + NET_LEN)
        and load64(o + NET_FLAGS).bit_and(NET_EOF) == 0
        and load64(st + TS_PPOS) >= load64(st + TS_PLEN)
        and load64(st + TS_CLOSED) == 0
        and load64(c + H2_INBLK) == 0
        store64(o + NET_DEADLINE, 0)
        pool_put_h2(key2, h, POOL_IDLE_MS, c)
    else
        net_close(h)
    resp

# ---- tables ----

## The HPACK static table (RFC 7541 Appendix A): names, then values; index 0 is unused.
fn h2_static_names() List[str]
    xs := [
        "",
        ":authority",
        ":method",
        ":method",
        ":path",
        ":path",
        ":scheme",
        ":scheme",
        ":status",
        ":status",
        ":status",
        ":status",
        ":status",
        ":status",
        ":status",
        "accept-charset",
        "accept-encoding",
        "accept-language",
        "accept-ranges",
        "accept",
        "access-control-allow-origin",
        "age",
        "allow",
        "authorization",
        "cache-control",
        "content-disposition",
        "content-encoding",
        "content-language",
        "content-length",
        "content-location",
        "content-range",
        "content-type",
        "cookie",
        "date",
        "etag",
        "expect",
        "expires",
        "from",
        "host",
        "if-match",
        "if-modified-since",
        "if-none-match",
        "if-range",
        "if-unmodified-since",
        "last-modified",
        "link",
        "location",
        "max-forwards",
        "proxy-authenticate",
        "proxy-authorization",
        "range",
        "referer",
        "refresh",
        "retry-after",
        "server",
        "set-cookie",
        "strict-transport-security",
        "transfer-encoding",
        "user-agent",
        "vary",
        "via",
        "www-authenticate",
    ]
    xs

fn h2_static_values() List[str]
    xs := [
        "",
        "",
        "GET",
        "POST",
        "/",
        "/index.html",
        "http",
        "https",
        "200",
        "204",
        "206",
        "304",
        "400",
        "404",
        "500",
        "",
        "gzip, deflate",
        "",
        "",
