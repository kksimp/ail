## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Stands in for `task.ail` in a program that starts no tasks (ADR 0599):
## a trap there always ends the process.

fn on_trap(kind int, a int, b int, head str, op str, tail str)
    return

## No second thread exists, so there is nothing to park or scan.
fn blocked_enter() int
    0

fn blocked_leave(s int)
    return

fn wait_enter()
    return

fn wait_leave()
    return

fn gc_park()
    return

fn gc_stop_world()
    return

fn gc_start_world()
    return

fn gc_scan_threads()
    return

fn gc_par_mark() bool
    false

fn stack_end_self() int
    load64(global(STACK_TOP))

fn cur_task() int
    0

## No task exists, so the race detector sees only the main task.
fn cur_race_id() int
    0

fn task_cancelled() bool
    false

fn task_check(at str)
    return

fn task_block_on(ch int)
    return

fn task_wait_mark(a int, v int)
    return

fn woken_waiters() bool
    false

## Tensor kernels (ADR 0876) run on the calling thread.
fn tensor_env() int
    alloc(128, KIND_ATOMIC)

fn tensor_par(env int, lo int, hi int, work int) bool
    false

## Deterministic scheduling needs tasks (sched.ail).
fn det_on() bool
    false

fn det_wake(a int)
    return

fn det_yield()
    return

fn det_relax() bool
    false
