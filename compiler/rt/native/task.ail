## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Tasks (conc.task.*, native.task.1, ADRs 0599-0601): a pool of worker threads sized to the
## cores (at most 64, and each region uses only as many as its work repays,
## conc.par.9, conc.par.17) that take tasks from one queue; `spawn` puts
## a task record on the queue and `wait` sleeps on the record's state word.
## On Linux a thread is a `clone` with a stack from `mmap` and every sleep is
## a futex; on macOS it is a libSystem pthread and a `__ulock_wait`. Only linked into a program that spawns tasks or runs `par for`
## (`notask.ail` stands in otherwise). The locks, thread identity and the
## allocator's lock are in `core.ail`.
##
## A task record (heap, 8-byte words):
##   +0 state (0 queued or running, 2 done, 3 trapped, 4 failed with an error)   +8 task id (picks
##   the function in `dispatch`)   +16 result   +24 next in the queue
##   +32 trap kind   +40 a   +48 b   +56 head string   +64 operator string   +72 source excerpt
##   +80 arguments, 8 bytes each
## The pool block (mmap'd, 8-byte words):
##   +0 lock   +8 head   +16 tail   +24 seq (idle workers sleep on it)
##   +32 live workers   +40 workers blocked in `wait`   +48 idle workers
##   +56 target workers   +128 the task each worker runs, by worker index
##   +1024 macOS restart stack pointers   +2048 each thread's published stack
##   pointer (0 while it runs), +4096 each thread's saved registers (10 words)
## Thread slot 0 is the main thread, worker `k` is slot `k + 1`.

P_LOCK := 0
P_HEAD := 8
P_TAIL := 16
P_SEQ := 24
P_LIVE := 32
P_BLOCKED := 40
P_IDLE := 48
P_TARGET := 56
# `AIL_PAR_LOG` was set (conc.par.17): each parallel region says on standard error how many workers it used.
P_LOG := 64
# Parallel regions running now (`par_start` to the end of `par_wait`): `set_threads`
# traps while one runs (conc.par.18).
P_REGION := 72
# Windows: parallel regions in a row that ended within `WIN_SHORT_MS` (conc.par.19).
P_WSHORT := 80
P_CUR := 128
# macOS: each worker's restart stack pointer (workers run on pthreads there).
P_TOP := 1024
# A thread parked for the collector publishes its stack pointer here, with
# the callee-saved registers it had (native-abi.md §10).
P_PARK := 2048
# 80 bytes per thread slot, 65 slots (`MAXW` workers and the main thread), to 9296.
P_REGS := 4096
# The mutexes each thread holds from `lock` (a list through the mutex records).
# The text builders (`P_SB`, 9344) and failures (`P_ERR`, 10944) of core.ail lie
# between; each holds 24 bytes per slot (ADR 0946: the layout fits 64 workers).
P_HELD := 12544
POOL_SZ := 32768
# Heap kinds of the blocks tasks use: every word may be a pointer, except an
# atomic cell, which is `KIND_ATOMIC` (heap.ail).
KIND_TASK := 12
KIND_ENV := 13

T_STATE := 0
T_ID := 8
T_RESULT := 16
T_NEXT := 24
T_KIND := 32
T_A := 40
T_B := 48
T_HEAD := 56
T_OP := 64
T_TAIL := 72
T_ARGS := 80
# After the 14 argument words: cancelled, the task that started this one, the
# channel it sleeps on, its first child and its next sibling (conc.cancel.*).
T_CANC := 192
T_PAR := 200
T_BLK := 208
T_KIDS := 216
T_SIB := 224
# The race detector's id for the task (race.ail); 0 when it is off.
T_RACE := 232
# While the task sleeps in `prog_wait`: the word it sleeps on (0 when it
# isn't) and the value it sleeps while the word holds (conc.task.7).
T_WADDR := 240
T_WVAL := 248
T_SIZE := 256

## The cores this process may run on, 1 to `MAXW` (`sched_getaffinity`).
fn cores() int
    n := env_threads()
    if n > 0
        return n
    hw_cores()

## `AIL_THREADS` as a whole number of 1 to `MAXW` (conc.par.9, ADR 0272); 0 when it is
## unset or not a number, as in the interpreter, which then uses the hardware.
fn env_threads() int
    s := os_env_get("AIL_THREADS")
    if not os_ok()
        return 0
    p := str_addr(s)
    n := load64(p)
    mut v := 0
    mut i := 0
    while i < n
        c := load8(p + 16 + i)
        if c < 48 or c > 57
            return 0
        if v < 1000
            v = v * 10 + c - 48
        i += 1
    if n == 0
        return 0
    if v < 1
        return 1
    if v > MAXW
        return MAXW
    v

fn hw_cores() int
    if target() == 3
        c := import_call("GetActiveProcessorCount", 65535, 0, 0, 0)
        return if c < 1 then 1 else if c > MAXW then MAXW else c
    if target() == 2
        c := import_call("_sysconf", 58, 0, 0, 0)
        return if c < 1 then 1 else if c > MAXW then MAXW else c
    buf := alloc(128, KIND_BYTES)
    k := if target() == 0 then 204 else 123
    r := syscall(k, 0, 128, buf, 0, 0, 0)
    mut n := 0
    if r > 0
        for i in 0..r
            mut b := load8(buf + i)
            while b != 0
                n += b.bit_and(1)
                b = b.shr(1)
    if n < 1
        n = 1
    if n > MAXW
        n = MAXW
    n

## The pool block, made on first use. From then on the process has more
## than one thread (`MULTI`): each allocates from its own cache and takes the
## allocation lock only to refill it (ADR 0943).
fn pool() int
    p := load64(global(TASKS))
    if p != 0
        return p
    q := sys_mmap(POOL_SZ)
    if q < 0
        fail(1, 0, 0)
    store64(q + P_TARGET, cores())
    if os_env_get("AIL_PAR_LOG") != ""
        store64(q + P_LOG, 1)
    # Windows threads run on stacks the system makes (`start_thread`).
    stacks := if target() == 3 then 0 else sys_mmap_lazy(MAXW * STACK_SZ)
    if stacks < 0
        fail(1, 0, 0)
    store64(global(STACKS), stacks)
    det_init(q)
    store64(global(TASKS), q)
    # Each thread allocates from its own cache from now on (ADR 0943).
    tb_init()
    store64(global(MULTI), 1)
    # The stack check compares against the main stack's limit, and a worker's
    # stack lies below it, so every recursive call in a task would trap. With
    # threads there is no limit; deep recursion meets the guard page instead.
    store64(global(STACK_LIMIT), 0)
    q

## A task record for function `id` of `dispatch`; the caller stores the
## arguments from `T_ARGS` and calls `task_start`.
fn task_new(id int) int
    rec := alloc(T_SIZE, KIND_TASK)
    store64(rec + T_ID, id)
    store64(rec + T_RACE, race_spawn(cur_race_id()))
    parent := cur_task()
    if parent != 0
        store64(rec + T_PAR, parent)
        store64(rec + T_SIB, load64(parent + T_KIDS))
        # Publish the child, then look at the parent's cancel; `task_cancel`
        # sets the cancel, then walks the children. Both sides are
        # sequentially consistent, so either the walk finds the child or the
        # child sees the cancel (conc.cancel.1, conc.cancel.3). A plain store
        # here could pass the load (x86-64 store buffer, ARM64 `str`/`ldar`).
        atomic_store(parent + T_KIDS, rec)
        # A task started by a cancelled task starts cancelled. Only ever set:
        # a walk that already found the child may have cancelled it.
        if atomic_load(parent + T_CANC) != 0
            atomic_store(rec + T_CANC, 1)
    rec

## Queue the task and make sure a worker will take it: wake an idle one, or
## start one while fewer than the target are running.
fn task_start(rec int)
    p := pool()
    if load64(p + P_DET + D_MODE) != 0
        det_spawn(p, rec)
        return
    lock(p + P_LOCK)
    tail := load64(p + P_TAIL)
    if tail == 0
        store64(p + P_HEAD, rec)
    else
        store64(tail + T_NEXT, rec)
    store64(p + P_TAIL, rec)
    store64(p + P_SEQ, load64(p + P_SEQ) + 1)
    atomic_add(global(TASKS_LIVE), 1)
    idle := load64(p + P_IDLE)
    live := load64(p + P_LIVE)
    mut fresh := -1
    if idle == 0 and live - load64(p + P_BLOCKED) < load64(p + P_TARGET) and live < MAXW
        store64(p + P_LIVE, live + 1)
        fresh = live
    unlock(p + P_LOCK)
    if idle > 0
        futex_wake(p + P_SEQ, 1)
    if fresh >= 0
        start_thread(p, fresh)

## Worker `idx`: its stack's low page is a guard, then a new thread.
fn start_thread(p int, idx int)
    if target() == 3
        win_start_thread(p, idx)
        return
    base := load64(global(STACKS)) + idx * STACK_SZ
    k := if target() == 0 then 10 else if target() == 1 then 226 else 74
    guard := if target() == 2 then 16384 else 4096
    syscall(k, base, guard, 0, 0, 0, 0)
    if target() == 2
        start_pthread(base + guard, idx)
        return
    if clone(base + STACK_SZ - 64, idx) < 0
        fail(1, 0, 0)

## macOS: threads come from libSystem's pthreads (ADR 0599), on the same
## stack region; the guard is the stack's lowest page (16 KiB here).
## `low` is the first byte above the guard; macOS pages are 16 KiB, and
## `pthread_attr_setstack` refuses an address or size that isn't aligned.
fn start_pthread(low int, idx int)
    attr := alloc(80, KIND_BYTES)
    import_call("_pthread_attr_init", attr, 0, 0, 0)
    size := (load64(global(STACKS)) + (idx + 1) * STACK_SZ) - low
    if import_call("_pthread_attr_setstack", attr, low, size, 0) != 0
        fail(1, 0, 0)
    r := import_call("_pthread_create", attr + 64, attr, fn_addr("rt.thread_entry"), idx)
    if r != 0
        fail(1, 0, 0)

## The start routine of a pthread: note where `restart` may reuse the stack
## (the pthread keeps its own record at the top), then run as a worker.
fn thread_entry(idx int) int
    p := load64(global(TASKS))
    store64(p + P_TOP + 8 * idx, sp())
    worker_main(idx)
    0

## Where `restart` puts worker `k`'s stack pointer.
fn stack_top(p int, k int) int
    if target() == 2 or target() == 3
        return load64(p + P_TOP + 8 * k)
    load64(global(STACKS)) + (k + 1) * STACK_SZ - 64

## The loop of worker `idx`: run queued tasks, sleep on `seq` when there are
## none. Entered by `clone` and by `restart` after a trap.
fn worker_main(idx int)
    p := load64(global(TASKS))
    if load64(p + P_DET + D_MODE) != 0
        det_worker(idx)
        return
    while true
        # Between tasks is a safe point: park if a collection wants the world.
        if atomic_load(global(GC_REQ)) != 0
            gc_park()
        lock(p + P_LOCK)
        rec := load64(p + P_HEAD)
        # Past the cap `set_threads` lowered: take nothing, sleep (conc.par.18).
        running := load64(p + P_LIVE) - load64(p + P_IDLE) - load64(p + P_BLOCKED)
        if rec != 0 and running <= load64(p + P_TARGET)
            next := load64(rec + T_NEXT)
            store64(p + P_HEAD, next)
            if next == 0
                store64(p + P_TAIL, 0)
            unlock(p + P_LOCK)
            store64(p + P_CUR + 8 * idx, rec)
            dispatch(load64(rec + T_ID), rec)
            store64(p + P_CUR + 8 * idx, 0)
            held_release(idx + 1)
            if failed()
                # The task's own error (conc.task.6) waits for `wait`.
                store64(rec + T_RESULT, err_box())
                finish_task(rec, 4)
            else
                finish_task(rec, 2)
        else
            s := load64(p + P_SEQ)
            store64(p + P_IDLE, load64(p + P_IDLE) + 1)
            unlock(p + P_LOCK)
            futex_wait(p + P_SEQ, s.bit_and(4294967295))
            lock(p + P_LOCK)
            store64(p + P_IDLE, load64(p + P_IDLE) - 1)
            unlock(p + P_LOCK)

## Publish a task's end (its result is already stored) and wake its waiters.
fn finish_task(rec int, state int)
    atomic_xchg(rec + T_STATE, state)
    futex_wake(rec + T_STATE, 2147483647)
    det_wake(rec + T_STATE)
    atomic_add(global(TASKS_LIVE), -1)
    atomic_add(global(CHAN_EPOCH), 1)
    det_wake(global(CHAN_EPOCH))

## Called first by `trap`: on a worker, the trap ends the task and the
## worker goes on with the next one; on the main thread it returns and the
## process ends as usual.
fn on_trap(kind int, a int, b int, head str, op str, tail str)
    k := worker_index()
    if k < 0
        return
    p := load64(global(TASKS))
    rec := load64(p + P_CUR + 8 * k)
    store64(rec + T_KIND, kind)
    store64(rec + T_A, a)
    store64(rec + T_B, b)
    store64(rec + T_HEAD, str_addr(head))
    store64(rec + T_OP, str_addr(op))
    store64(rec + T_TAIL, str_addr(tail))
    held_release(k + 1)
    # A trap inside the allocator (a run limit) still holds its lock.
    if atomic_load(global(ALLOC_OWNER)) == k + 2
        atomic_store(global(ALLOC_OWNER), 0)
        unlock(global(ALLOC_LOCK))
    # A trap in the middle of a `print` still holds the output lock.
    if atomic_load(global(OUT_OWNER)) == k + 2
        store64(global(OUT_DEPTH), 0)
        atomic_store(global(OUT_OWNER), 0)
        unlock(global(OUT_LOCK))
    store64(p + P_CUR + 8 * k, 0)
    finish_task(rec, 3)
    if load64(p + P_DET + D_MODE) != 0
        det_end(p + P_DET, k + 1)
    restart(stack_top(p, k), k)

## `t.wait()?` in `main`: sleep until the task ends, then its result word; a
## trapped task ends the program as the interpreter's uncaught `Trapped`
## does (conc.task.6, native.task.1).
fn task_wait(rec int, at1 str, at2 str) int
    det_yield()
    if wait_done_dl(rec, true)
        return 0
    if atomic_load(rec + T_STATE) == 3
        report_trapped(rec, at1, at2)
    if atomic_load(rec + T_STATE) == 4
        err_restore(load64(rec + T_RESULT))
        return 0
    load64(rec + T_RESULT)

## `t.wait() else ...`: the result, or, when the task trapped, the failure
## `Trapped(rule, message)` in the error slot (conc.task.6) and 0.
fn task_try(rec int, at str, own int) int
    det_yield()
    if wait_done_dl(rec, true)
        return 0
    if atomic_load(rec + T_STATE) == 4
        err_restore(load64(rec + T_RESULT))
        return 0
    if atomic_load(rec + T_STATE) != 3
        return load64(rec + T_RESULT)
    # A function with an error type of its own can't hold a `Trapped`.
    if own != 0
        report_trapped(rec, at, at)
    trapped_error(rec, at)
    0

## The failure `Trapped(rule, message)` of the trapped task `rec`, in the error slot.
fn trapped_error(rec int, at str)
    h := load64(rec + T_HEAD)
    n := load64(h)
    d := h + 16
    mut t := 0
    while t + 5 <= n and not is_trap_mark(d + t)
        t += 1
    mut j := t - 3
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    j -= 1
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    mut e := t + 5
    while e < n and load8(d + e) != 93
        e += 1
    rule := os_str_from(d + t + 5, e - t - 5)
    # The message is written to the output buffer, then taken back out of it.
    out_lock()
    flush()
    out_bytes(d + j + 1, t - j - 2)
    out_byte(32)
    trap_body(
        load64(rec + T_KIND),
        load64(rec + T_A),
        load64(rec + T_B),
        str_at(load64(rec + T_OP)),
    )
    msg := os_str_from(load64(global(OUT_BUF)), load64(global(OUT_LEN)))
    store64(global(OUT_LEN), 0)
    out_unlock()
    sb_reset()
    sb_text("Trapped(rule: ")
    os_put_quoted(rule)
    sb_text(", message: ")
    os_put_quoted(msg)
    sb_byte(41)
    err_set(sb_str(), at)
    v := obj_new(16, 4)
    store64(v, str_addr(rule))
    store64(v + 8, str_addr(msg))
    err_value(v)
    err_tag(err_tag_of("Trapped"))

## Sleep until the task has ended, trapped or not.
fn wait_done(rec int)
    wait_done_dl(rec, false)

## `wait_done`; with `report` the main task gives up when every task is
## blocked (conc.task.7): true, with the message in `CHAN_FAULT`.
fn wait_done_dl(rec int, report bool) bool
    mut dead := false
    if atomic_load(rec + T_STATE) == 0
        k := worker_index()
        if k >= 0
            wait_enter()
        while atomic_load(rec + T_STATE) == 0 and not dead
            dead = prog_wait(rec + T_STATE, 0, "a task to finish", report)
        if k >= 0
            wait_leave()
    race_join(load64(rec + T_RACE))
    dead

## A worker is about to sleep in `wait`: it stops counting as running, so
## queued work may now run. An idle worker is woken: it may have gone idle
## past the cap (conc.par.18) while this one still ran, and nothing else
## would wake it. With none idle a replacement starts. `seq` changes under
## the lock, so a worker about to sleep on it sees the change.
fn wait_enter()
    p := load64(global(TASKS))
    lock(p + P_LOCK)
    store64(p + P_BLOCKED, load64(p + P_BLOCKED) + 1)
    live := load64(p + P_LIVE)
    mut fresh := -1
    mut wake := false
    if load64(p + P_HEAD) != 0
        if load64(p + P_IDLE) > 0
            store64(p + P_SEQ, load64(p + P_SEQ) + 1)
            wake = true
        elif live - load64(p + P_BLOCKED) < load64(p + P_TARGET) and live < MAXW
            store64(p + P_LIVE, live + 1)
            fresh = live
    unlock(p + P_LOCK)
    if wake
        futex_wake(p + P_SEQ, 1)
    if fresh >= 0
        start_thread(p, fresh)

fn wait_leave()
    p := load64(global(TASKS))
    lock(p + P_LOCK)
    store64(p + P_BLOCKED, load64(p + P_BLOCKED) - 1)
    unlock(p + P_LOCK)

## `error: Trapped(rule: "RULE", message: "LINE:COL: MESSAGE")` on standard
## error, then exit 1. The trap's head is `PATH:LINE:COL: trap[RULE]: `.
fn report_trapped(rec int, at1 str, at2 str)
    h := load64(rec + T_HEAD)
    n := load64(h)
    d := h + 16
    # `trap[`
    mut t := 0
    while t + 5 <= n and not is_trap_mark(d + t)
        t += 1
    # The location: the digits and colon before `: trap[`.
    mut j := t - 3
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    j -= 1
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    # The program ends here, so the main thread's cleanups run (own.defer.1).
    unwind_run()
    flush()
    out_str("error: Trapped(rule: \"")
    mut e := t + 5
    while e < n and load8(d + e) != 93
        e += 1
    out_bytes(d + t + 5, e - t - 5)
    out_str("\", message: \"")
    out_bytes(d + j + 1, t - j - 2)
    out_byte(32)
    trap_body(
        load64(rec + T_KIND),
        load64(rec + T_A),
        load64(rec + T_B),
        str_at(load64(rec + T_OP)),
    )
    out_str("\")\n")
    # The trace: the `wait` and the `?` that passed the trap on (err.ctx.1).
    out_str(at1)
    out_byte(10)
    out_str(at2)
    out_byte(10)
    flush_to(2)
    sys_exit(1)

fn is_trap_mark(a int) bool
    load8(a) == 116
        and load8(a + 1) == 114
        and load8(a + 2) == 97
        and load8(a + 3) == 112
        and load8(a + 4) == 91

## The function of task `id`: written by the compiler, one case per `spawn`
## site and parallel loop.
fn dispatch(id int, rec int)
    todo

# ---- tensor kernels on the pool (ADR 0876) ----

## The job of a tensor kernel: 16 words the caller fills (word 0 the job).
fn tensor_env() int
    alloc(128, KIND_ENV)

## Run the job `env` over the units `lo..hi` on the pool, in chunks, and wait.
## False (nothing run) when the job is small (`work`, about the element
## operations), the loop is short, or the run is deterministic (conc.par.9);
## the caller then runs it in order. The units are independent, so the result
## is bit for bit the sequential one (std.tensor.7, std.tensor.20).
fn tensor_par(env int, lo int, hi int, work int) bool
    if work < TENSOR_PAR_MIN or hi - lo < 2 or det_on()
        return false
    if load64(pool() + P_TARGET) < 2
        return false
    grp := par_start(TENSOR_TASK, env, lo, hi, work / (hi - lo) + 1)
    par_wait(grp)
    true

TENSOR_PAR_MIN := 262144
TENSOR_TASK := 1073741824

## One chunk (`rt.dispatch` of `TENSOR_TASK`): the job in the record's first
## argument, over the units of arguments 1 and 2.
fn tensor_chunk(rec int)
    env := load64(rec + T_ARGS)
    lo := load64(rec + T_ARGS + 8)
    hi := load64(rec + T_ARGS + 16)
    job := load64(env)
    kind := load64(env + 8)
    out := load64(env + 16)
    da := load64(env + 24)
    db := load64(env + 32)
    if job == 0
        # Rows `lo..hi` of a matrix product: n = word 5, k = word 6.
        n := load64(env + 40)
        k := load64(env + 48)
        for i in lo..hi
            if kind == 2
                vec_mm32(out + 4 * i * n, da + 4 * i * k, db, n, k)
            else
                vec_mm(out + 8 * i * n, da + 8 * i * k, db, n, k, 0)
    elif job == 1
        # Elements `lo..hi` of `a op b`: op = word 5.
        op := load64(env + 40)
        if kind == 2
            vec_zip32(op, out + 4 * lo, da + 4 * lo, db + 4 * lo, hi - lo)
        else
            vec_zip(op, out + 8 * lo, da + 8 * lo, db + 8 * lo, hi - lo, 0)
    elif job == 3
        # Chunks `lo..hi` of a fused chain: plan = word 3, root = 4, n = 5.
        fuse_range(da, db, out, kind, load64(env + 40), lo, hi)
    elif job == 4
        # Rows `lo..hi` of a softmax: row width = word 5.
        softmax_rows(kind, da, out, load64(env + 40), lo, hi)
    else
        # Elements `lo..hi` of `a op s`: op = word 5, left = word 6, s = word 7.
        op := load64(env + 40)
        left := load64(env + 48)
        s := loadf(env + 56)
        if kind == 2
            vec_scal32(op, out + 4 * lo, da + 4 * lo, hi - lo, left, s)
        else
            vec_scal(op, out + 8 * lo, da + 8 * lo, hi - lo, 0, left, s)

# ---- parallel loops (ADR 0601) ----

## Operations (`ParScan.work` per iteration) a compiler-chosen parallel loop
## needs in all, about 50 microseconds, so a pool dispatch repays itself.
PAR_MIN_WORK := 65536

## Operations a compiler-chosen loop needs in all when the count has every one
## of them (no loop, no call it can't price in the body): they are arithmetic
## and loads, a fraction of a nanosecond each, and a region costs 25 to 60
## microseconds to start (conc.par.14, ADR 1157).
PAR_COUNTED := 1048576

## The same for a counted loop whose body is one element-wise store of floats:
## in order it runs in vector lanes (native.vec.4, native.vec.5), a chunk does not.
PAR_LANES := 16777216

## Operations in one iteration past which any loop of two or more iterations
## goes to the pool (conc.par.14).
PAR_HEAVY := 4096

## Whether `par for lo..hi` goes to the pool: at least twice as many
## iterations as the workers the region uses (conc.par.8, conc.par.17). A chunk function takes the environment
## record, `lo` and `hi` from its task record's arguments 0 to 2, then
## 3 words (sum, lowest and highest running sum) per accumulator. `auto` is 0
## for a written `par for`, 1 for a loop the compiler chose, 2 for one whose
## work is all counted and 3 for one that also runs in vector lanes in order.
fn par_worth(lo int, hi int, work int, auto int, slow int) bool
    # conc.par.9: a deterministic run keeps every loop on one thread.
    if det_on()
        return false
    t := load64(pool() + P_TARGET)
    n := hi - lo
    # conc.par.9: with one thread the loop runs as if there were no pool.
    if n < 2 or t < 2
        return false
    # conc.par.14: heavy iterations (`PAR_HEAVY` operations each) repay the
    # pool even when there are fewer than twice as many as workers. A counted
    # loop is judged by its total alone.
    if work >= PAR_HEAVY and auto < 2
        return true
    # Twice as many iterations as the workers the region would use (conc.par.17),
    # so a big pool doesn't send a short heavy loop back in order.
    if n < 2 * par_width(n, work)
        return false
    if auto == 0
        return true
    # conc.par.19: on Windows short regions cost more than they save.
    if target() == 3 and load64(pool() + P_WSHORT) >= WIN_SHORT_RUN
        return false
    # A loop the compiler chose also needs enough work in all.
    # x86-64 divides by a value far slower than ARM64: `slow` more operations.
    priced := if target() == 0 or target() == 3 then work + slow else work
    if auto == 3
        return n >= (PAR_LANES + priced - 1) / priced
    if auto == 2
        return n >= (PAR_COUNTED + priced - 1) / priced
    n >= PAR_MIN_WORK / work

## Whether `n` more calls of a fork-join run may start as tasks (conc.par.15):
## not in a deterministic run, and while fewer than twice as many tasks as
## workers are alive.
fn fork_ok(n int) bool
    if det_on()
        return false
    t := load64(pool() + P_TARGET)
    t >= 2 and atomic_load(global(TASKS_LIVE)) + n <= 2 * t

## `n` zeroed words: the values a loop body reads and the accumulators.
fn env_new(n int) int
    alloc(8 * n + 8, KIND_ENV)

## Operations a worker must have to itself before it joins a region (about 50
## microseconds, the cost of waking it and joining its result).
PAR_GRAIN := 65536

## How many workers a region of `n` iterations of about `work` operations uses
## (conc.par.17): one per `PAR_GRAIN` operations, at least 2 and at most the
## pool's target, so a region that scales to 16 cores gets 16 and a small one
## stays on few. The work comes from the compiler's cost model (conc.par.14).
fn par_width(n int, work int) int
    t := load64(pool() + P_TARGET)
    per := if work < 1 then 1 else work
    each := (PAR_GRAIN + per - 1) / per
    mut w := n / each
    if w > t
        w = t
    if w < 2
        w = 2
    w

## `AIL_PAR_LOG` set: one line on standard error for a region (conc.par.17).
fn par_log(n int, work int, w int, chunks int)
    p := pool()
    if load64(p + P_LOG) == 0
        return
    out_lock()
    flush()
    out_str("par: ")
    out_int(n)
    out_str(" iterations of about ")
    out_int(work)
    out_str(" operations -> ")
    out_int(w)
    out_str(" of ")
    out_int(load64(p + P_TARGET))
    out_str(" workers, ")
    out_int(chunks)
    out_str(" chunks (conc.par.17)\n")
    flush_to(2)
    out_unlock()

## Split `lo..hi` into chunks, four per worker the region uses (`par_width`),
## queue them, and give back the group: word 0 the chunk count, then the
## task records in order. `work` is the operations of one iteration.
fn par_start(id int, env int, lo int, hi int, work int) int
    atomic_add(pool() + P_REGION, 1)
    n := hi - lo
    w := par_width(n, work)
    mut chunks := 4 * w
    if chunks > n
        chunks = n
    size := (n + chunks - 1) / chunks
    chunks = (n + size - 1) / size
    par_log(n, work, w, chunks)
    # One word past the records: when the region started (Windows, conc.par.19).
    grp := alloc(8 * chunks + 16, KIND_ENV)
    store64(grp, chunks)
    if target() == 3
        store64(grp + 8 + 8 * chunks, win_tick())
    for c in 0..chunks
        off := c * size
        len := if size < n - off then size else n - off
        rec := task_new(id)
        store64(rec + T_ARGS, env)
        store64(rec + T_ARGS + 8, lo + off)
        store64(rec + T_ARGS + 16, lo + off + len)
        store64(grp + 8 + 8 * c, rec)
        task_start(rec)
    grp

## Wait for every chunk; whether none trapped.
fn par_wait(grp int) bool
    mut ok := true
    for c in 0..load64(grp)
        rec := load64(grp + 8 + 8 * c)
        wait_done(rec)
        if atomic_load(rec + T_STATE) != 2
            ok = false
    atomic_add(pool() + P_REGION, -1)
    if target() == 3
        par_win_note(grp)
    ok

## A region that ends within this many milliseconds is short on Windows: two
## timer ticks (about 31 ms) go to waking the workers and noticing they are
## done, because waiters there poll (`win_wait`).
WIN_SHORT_MS := 40

## The most a `win_tick` difference can overstate an elapsed time by.
WIN_TICK_MS := 16

## Short regions in a row after which the loops the compiler chose run in order.
WIN_SHORT_RUN := 2

## conc.par.19: count the region `grp` if it was short, or start the count
## again. Two regions that end at once may count as one; the count only picks
## between two ways of running a loop that give the same result.
fn par_win_note(grp int)
    p := pool()
    took := win_tick() - load64(grp + 8 + 8 * load64(grp))
    # `win_tick` moves in timer ticks (about 15.6 ms), so a region of 31 ms can
    # read 47: allow one tick, or the count resets half the time and loops of
    # many short regions never fall back to running in order.
    store64(
        p + P_WSHORT,
        if took <= WIN_SHORT_MS + WIN_TICK_MS then load64(p + P_WSHORT) + 1 else 0
    )

## `task.threads()` (conc.par.18, ADR 1018): the pool's cap now, `AIL_THREADS`
## or the cores at the start, then what `set_threads` last set.
fn task_threads() int
    load64(pool() + P_TARGET)

## `task.set_threads(n)` (conc.par.18): the cap for the regions and tasks that
## start from now on, `n` clamped to 1 to `MAXW`. Workers past the cap finish
## what they run and then sleep; a raised cap wakes them. A parallel region
## that is running makes it trap.
fn task_set_threads(n int)
    p := pool()
    if atomic_load(p + P_REGION) > 0
        os_usage_trap("conc.par.18", "`task.set_threads` while a parallel loop runs")
    lock(p + P_LOCK)
    store64(p + P_TARGET, if n < 1 then 1 else if n > MAXW then MAXW else n)
    # A worker about to sleep sees the change; Windows waiters poll the word.
    store64(p + P_SEQ, load64(p + P_SEQ) + 1)
    unlock(p + P_LOCK)
    futex_wake(p + P_SEQ, MAXW)

## A chunk of a loop that can't be run again trapped: report the first
## such trap as `trap` does, and end the process (conc.atomic.6).
fn par_fail(grp int)
    for c in 0..load64(grp)
        rec := load64(grp + 8 + 8 * c)
        if atomic_load(rec + T_STATE) == 3
            flush()
            out_str(str_at(load64(rec + T_HEAD)))
            trap_body(
                load64(rec + T_KIND),
                load64(rec + T_A),
                load64(rec + T_B),
                str_at(load64(rec + T_OP)),
            )
            out_byte(10)
            out_str(str_at(load64(rec + T_TAIL)))
            flush_to(2)
            sys_exit(1)

## Combine the accumulators in chunk order, checking as the sequential sum
## would: a running sum that would leave `int` anywhere makes the loop run
## in order instead (conc.par.11). The totals go back into the environment.
fn par_combine(grp int, env int, nacc int, first int) bool
    least := -9223372036854775807 - 1
    most := 9223372036854775807
    for a in 0..nacc
        mut total := load64(env + 8 * (first + a))
        for c in 0..load64(grp)
            rec := load64(grp + 8 + 8 * c)
            w := rec + T_ARGS + 8 * (3 + 3 * a)
            if total < least - load64(w + 8) or total > most - load64(w + 16)
                return false
            total += load64(w)
        store64(env + 8 * (first + a), total)
    true

## Append each chunk's list for a built list (conc.par.16: task argument
## `word`) to `out`, in chunk order: the elements of the sequential loop, in
## its order. Room is made once for all of them.
fn par_gather(grp int, word int, out List[int], size int)
    p := list_addr(out)
    mut total := load64(p)
    for c in 0..load64(grp)
        rec := load64(grp + 8 + 8 * c)
        total += load64(list_addr(list_at(load64(rec + T_ARGS + 8 * word))))
    # The block's own size is the room: a list made before its elements were
    # known to sit in place (flat.ail) has a block of 8-byte elements.
    while total > load64(p + 8) or total * size > flat_room(load64(p + 16))
        list_grow(p, size)
    for c in 0..load64(grp)
        rec := load64(grp + 8 + 8 * c)
        q := list_addr(list_at(load64(rec + T_ARGS + 8 * word)))
        n := load64(p)
        k := load64(q)
        copy_list(load64(p + 16) + size * n, load64(q + 16), size * k)
        store64(p, n + k)

# ---- atomics (ADR 0600) ----

## `print` of an atomic: `Atomic(7)`, `Atomic(true)`.
fn out_atomic_int(cell int)
    out_str("Atomic(")
    out_int(atomic_load(cell))
    out_byte(41)

fn out_atomic_bool(cell int)
    out_str("Atomic(")
    out_bool(atomic_load(cell) != 0)
    out_byte(41)

# ---- stopping the world for the collector (native-abi.md §10) ----

## Give the CPU away while waiting for another thread.
fn yield_cpu()
    t := target()
    if t == 3
        import_call("SwitchToThread", 0, 0, 0, 0)
        return
    if t == 2
        import_call("_sched_yield", 0, 0, 0, 0)
        return
    syscall(if t == 0 then 24 else 124, 0, 0, 0, 0, 0, 0)

## Publish this thread's stack pointer and callee-saved registers, so the
## collector may scan the thread while it sleeps. Gives the stack pointer.
fn blocked_enter() int
    p := load64(global(TASKS))
    t := thread_slot()
    s := gc_regs(p + P_REGS + 80 * t)
    atomic_store(p + P_PARK + 8 * t, s)
    s

## Leave the parked state. While a collection runs the thread stays parked;
## it clears its mark first and looks again, so the collector never scans a
## thread that has started to run.
fn blocked_leave(s int)
    p := load64(global(TASKS))
    t := thread_slot()
    while true
        # `GC_REQ` 2 is the mark phase, which a parked thread helps with.
        mut g := atomic_load(global(GC_REQ))
        while g != 0
            if g == 2
                gc_par_help()
            else
                futex_wait_raw(global(GC_REQ), 1)
            g = atomic_load(global(GC_REQ))
        atomic_store(p + P_PARK + 8 * t, 0)
        if atomic_load(global(GC_REQ)) == 0
            return
        atomic_store(p + P_PARK + 8 * t, s)

## Park here until the collection that was asked for is over.
fn gc_park()
    blocked_leave(blocked_enter())

## Ask every other thread to park and wait until each has. A thread that
## computes without reaching the runtime delays the collection, nothing else.
fn gc_stop_world()
    if load64(global(MULTI)) == 0
        return
    p := load64(global(TASKS))
    me := thread_slot()
    atomic_store(global(GC_REQ), 1)
    n := 1 + load64(p + P_LIVE)
    for t in 0..n
        if t != me
            while atomic_load(p + P_PARK + 8 * t) == 0
                yield_cpu()

## Mark from the queued roots with the parked threads' help (ADR 0944),
## when the heap is large and other threads exist; false leaves the marking
## to `gc_drain` on this thread. Idle workers sleep on the pool's `seq`
## word, so they are woken too; they see the phase as they leave the wait.
fn gc_par_mark() bool
    if load64(global(MULTI)) == 0 or hs(26) != 0 or hs(H_TOP) - hs(H_BASE) < GCP_MIN_HEAP
        return false
    p := load64(global(TASKS))
    if load64(p + P_LIVE) == 0 or load64(p + P_DET + D_MODE) != 0
        return false
    m := heap_state()
    atomic_store(m + 8 * H_MDONE, 0)
    atomic_store(m + 8 * H_MBUSY, 0)
    atomic_store(global(GC_REQ), 2)
    futex_wake(global(GC_REQ), 2147483647)
    futex_wake(p + P_SEQ, 2147483647)
    gc_par_work()
    atomic_store(global(GC_REQ), 1)
    while atomic_load(m + 8 * H_MIN) != 0
        yield_cpu()
    true

fn gc_start_world()
    if load64(global(MULTI)) == 0
        return
    atomic_store(global(GC_REQ), 0)
    futex_wake(global(GC_REQ), 2147483647)

## The end of this thread's stack: the main thread's top (`rt.init`), or the
## top of the worker's slice of the stack region.
fn stack_end_self() int
    if load64(global(MULTI)) == 0 or worker_index() < 0
        return load64(global(STACK_TOP))
    if target() == 3
        return load64(load64(global(TASKS)) + P_TOP + 8 * worker_index())
    load64(global(STACKS)) + (worker_index() + 1) * STACK_SZ

## Mark from the other threads' published stacks and registers, and from
## the pool block (the queue and the running tasks' records).
fn gc_scan_threads()
    if load64(global(MULTI)) == 0
        return
    p := load64(global(TASKS))
    me := thread_slot()
    n := 1 + load64(p + P_LIVE)
    gc_scan_range(p, p + P_PARK)
    # Each thread's text builder (fmt.ail) points at a heap buffer.
    gc_scan_range(p + P_SB, p + P_SB + 24 * (n + 1))
    gc_scan_range(p + P_ERR, p + P_ERR + 24 * (n + 1))
    for t in 0..n
        if t != me
            s := load64(p + P_PARK + 8 * t)
            mut top := if t
                == 0 then load64(global(STACK_TOP)) else load64(global(STACKS)) + t * STACK_SZ
            if target() == 3 and t > 0
                top = load64(p + P_TOP + 8 * (t - 1))
            gc_scan_range(p + P_REGS + 80 * t, p + P_REGS + 80 * t + 80)
            gc_scan_range(s, top)

# ---- Mutex and TaskGroup (conc.share.5, conc.task.8) ----
#
# A mutex is a record: +0 lock word, +8 the value (as an optional holds it),
# +16 the holder's thread id or 0, +24 wake word. A group is a record: +0 the
# count, +8 whether `wait_all` has run, +16 the array of task records.

M_LOCK := 0
M_VAL := 8
M_OWN := 16
M_WAKE := 24
M_NEXT := 32

fn mutex_new(v int) int
    m := alloc(40, KIND_ENV)
    store64(m + M_VAL, v)
    m

fn mutex_fault(text str) int
    store64(global(CHAN_FAULT), str_addr(text))
    0

## Wait until nobody else holds `m`, then run with its lock word taken; the
## caller releases it with `mutex_leave`. With `take`, this thread becomes the
## holder. Returns 0 if this thread holds it already and `take` is set.
fn mutex_enter(m int, take bool) int
    me := thread_id()
    while true
        lock(m + M_LOCK)
        o := load64(m + M_OWN)
        if o == me and take
            unlock(m + M_LOCK)
            return 0
        if o == 0 or o == me
            if take
                store64(m + M_OWN, me)
                slot := pool() + P_HELD + 8 * (worker_index() + 1)
                store64(m + M_NEXT, load64(slot))
                store64(slot, m)
            race_acquire(m)
            return 1
        w := load64(m + M_WAKE)
        unlock(m + M_LOCK)
        k := worker_index()
        if k >= 0
            wait_enter()
        prog_wait(m + M_WAKE, w, "a mutex another task holds", false)
        if k >= 0
            wait_leave()
    0

fn mutex_leave(m int)
    race_release(m)
    unlock(m + M_LOCK)

## `m.get()`.
fn mutex_get(m int) int
    det_yield()
    mutex_enter(m, false)
    v := load64(m + M_VAL)
    mutex_leave(m)
    v

## `m.set(v)`.
fn mutex_set(m int, v int)
    det_yield()
    mutex_enter(m, false)
    store64(m + M_VAL, v)
    mutex_leave(m)

## `m.swap(v)`: the old value.
fn mutex_swap(m int, v int) int
    det_yield()
    mutex_enter(m, false)
    old := load64(m + M_VAL)
    store64(m + M_VAL, v)
    mutex_leave(m)
    old

## `m.lock()`: the value, or 0 with the trap message left in `CHAN_FAULT`.
fn mutex_lock(m int) int
    det_yield()
    if mutex_enter(m, true) == 0
        return mutex_fault("`lock` while already holding the mutex")
    v := load64(m + M_VAL)
    mutex_leave(m)
    v

## `m.unlock(v)`: 0, or the message of the trap.
fn mutex_unlock(m int, v int) int
    det_yield()
    lock(m + M_LOCK)
    if load64(m + M_OWN) != thread_id()
        unlock(m + M_LOCK)
        return str_addr("`unlock` without holding the mutex from `lock`")
    store64(m + M_VAL, v)
    held_drop(m)
    store64(m + M_OWN, 0)
    store64(m + M_WAKE, (load64(m + M_WAKE) + 1).bit_and(4294967295))
    futex_wake(m + M_WAKE, 1000000)
    det_wake(m + M_WAKE)
    atomic_add(global(CHAN_EPOCH), 1)
    race_release(m)
    unlock(m + M_LOCK)
    0

## A group record: the task count, whether `wait_all` reported, the tasks,
## whether it was cancelled, and its owner (`G_OWNER`).
fn group_new() int
    alloc(40, KIND_ENV)

## Who waits for a group's tasks (conc.task.10, ADR 0996): 0 the block that made
## it, 1 the `unique` struct whose field holds it, 2 nobody any more (released).
G_OWNER := 32

## The group became a field of a `unique` struct: the struct's release waits
## for its tasks, not the block that made the group.
fn group_own(g int)
    store64(g + G_OWNER, 1)

## The `unique` struct that holds the group is released: wait for its tasks.
fn group_release(g int)
    store64(g + G_OWNER, 2)
    group_finish(g)

## `g.add(t)`. A group whose owner is gone waits for the task at once, so no
## task is ever left unwaited (conc.task.5, conc.task.10).
fn group_add(g int, rec int)
    if load64(g + G_OWNER) == 2
        if not wait_done_dl(rec, true)
            group_trap(rec)
        return
    n := load64(g)
    arr := load64(g + 16)
    if arr == 0 or n % 8 == 0
        bigger := alloc(8 * (n + 8), KIND_ENV)
        for i in 0..n
            store64(bigger + 8 * i, load64(arr + 8 * i))
        store64(g + 16, bigger)
    store64(load64(g + 16) + 8 * n, rec)
    store64(g, n + 1)
    if load64(g + 24) != 0
        task_cancel(rec)

## `g.wait_all()`: waits for every task; the first trapped one is the failure
## `Trapped` in the error slot (conc.task.8).
fn group_wait(g int, at str)
    n := load64(g)
    mut bad := 0
    for i in 0..n
        rec := load64(load64(g + 16) + 8 * i)
        if wait_done_dl(rec, true)
            return
        if bad == 0 and atomic_load(rec + T_STATE) == 3
            bad = rec
    store64(g + 8, 1)
    if bad != 0
        trapped_error(bad, at)

## The block that holds the group ends: wait for the tasks, and a trap in one
## that `wait_all` didn't report ends this task too (conc.task.8).
fn group_end(g int)
    if load64(g + G_OWNER) == 1
        return
    store64(g + G_OWNER, 2)
    group_finish(g)

## Wait for every task of `g`; a trap that `wait_all` didn't report ends this task.
fn group_finish(g int)
    n := load64(g)
    mut bad := 0
    for i in 0..n
        rec := load64(load64(g + 16) + 8 * i)
        if wait_done_dl(rec, true)
            return
        if bad == 0 and atomic_load(rec + T_STATE) == 3
            bad = rec
    if bad != 0 and load64(g + 8) == 0
        group_trap(bad)

## End this task with the trap of task `rec`, if it trapped.
fn group_trap(rec int)
    if atomic_load(rec + T_STATE) == 3
        bad := rec
        trap(
            load64(bad + T_KIND),
            load64(bad + T_A),
            load64(bad + T_B),
            str_at(load64(bad + T_HEAD)),
            str_at(load64(bad + T_OP)),
            str_at(load64(bad + T_TAIL)),
        )

## `m` is no longer held by this thread: take it off the thread's list.
fn held_drop(m int)
    slot := pool() + P_HELD + 8 * (worker_index() + 1)
    mut at := slot
    while load64(at) != 0 and load64(at) != m
        at = load64(at) + M_NEXT
    if load64(at) == m
        store64(at, load64(m + M_NEXT))

## A task ended or trapped while holding mutexes: release them, keeping the
## values they had (conc.share.5, conc.share.6).
fn held_release(slot int)
    at := pool() + P_HELD + 8 * slot
    while load64(at) != 0
        m := load64(at)
        store64(at, load64(m + M_NEXT))
        lock(m + M_LOCK)
        store64(m + M_OWN, 0)
        store64(m + M_WAKE, (load64(m + M_WAKE) + 1).bit_and(4294967295))
        futex_wake(m + M_WAKE, 1000000)
        det_wake(m + M_WAKE)
        atomic_add(global(CHAN_EPOCH), 1)
        unlock(m + M_LOCK)

# ---- cancellation (conc.cancel.1-4) ----

## The race detector's id for the running task: 0 on the main thread.
fn cur_race_id() int
    rec := cur_task()
    if rec == 0
        return 0
    load64(rec + T_RACE)

## The task record this thread is running, or 0 on the main thread.
fn cur_task() int
    k := worker_index()
    if k < 0
        return 0
    load64(pool() + P_CUR + 8 * k)

## `task.cancelled()`.
fn task_cancelled() bool
    rec := cur_task()
    rec != 0 and atomic_load(rec + T_CANC) != 0

## `task.check()`: the failure `Cancelled` once the running task is cancelled.
fn task_check(at str)
    det_yield()
    if task_cancelled()
        err_set("the task was cancelled", at)

## The running task is about to sleep on channel `ch` (0: it has woken), so a
## cancel can wake it.
fn task_block_on(ch int)
    rec := cur_task()
    if rec != 0
        atomic_store(rec + T_BLK, ch)

## `t.cancel()`: the task and every task it started, however deep.
fn task_cancel(rec int)
    det_yield()
    atomic_xchg(rec + T_CANC, 1)
    b := atomic_load(rec + T_BLK)
    if b != 0
        chan_wake(b)
    mut kid := atomic_load(rec + T_KIDS)
    while kid != 0
        task_cancel(kid)
        kid = load64(kid + T_SIB)

## The running task is about to sleep in `prog_wait` while the word at `a`
## holds `v` (`a` 0: it has woken), so the deadlock check can tell a task the
## wake already reached from one still blocked.
fn task_wait_mark(a int, v int)
    rec := cur_task()
    if rec != 0
        atomic_store(rec + T_WVAL, v)
        atomic_store(rec + T_WADDR, a)

## Whether some task counted as blocked was already woken: the word it sleeps
## on changed, but its thread hasn't run since (a busy machine can hold it
## off the CPU for longer than the deadlock check waits). Such a task isn't
## blocked (conc.task.7). Called by the main task, which isn't parked, so no
## collection runs while it reads the records.
fn woken_waiters() bool
    p := load64(global(TASKS))
    if p == 0
        return false
    n := atomic_load(p + P_LIVE)
    for k in 0..n
        rec := atomic_load(p + P_CUR + 8 * k)
        if rec != 0
            a := atomic_load(rec + T_WADDR)
            if a != 0 and atomic_load(a).bit_and(4294967295) != atomic_load(rec + T_WVAL)
                return true
    false

## `g.cancel()`: every task of the group, and those added later.
fn group_cancel(g int)
    store64(g + 24, 1)
    for i in 0..load64(g)
        task_cancel(load64(load64(g + 16) + 8 * i))

# ---- Windows threads (win.ail) ----

## Start worker `idx`. The new thread learns its index from `P_NEWT + 8`,
## which it reads before it lets go of the word at `P_NEWT` (one start at a time).
fn win_start_thread(p int, idx int)
    while atomic_cas(p + P_NEWT, 0, 1) != 0
        import_call("SwitchToThread", 0, 0, 0, 0)
    store64(p + P_NEWT + 8, idx)
    # STACK_SIZE_PARAM_IS_A_RESERVATION: STACK_SZ bytes of address space, committed as used.
    h := import_call("CreateThread", 0, STACK_SZ, fn_addr("rt.win_thread_entry"), 0, 0, 0)
    if h == 0
        err_begin()
        out_str("CreateThread failed, error ")
        out_int(import_call("GetLastError", 0, 0, 0, 0))
        out_byte(10)
        err_end()
        fail(1, 0, 0)
    import_call("CloseHandle", h, 0, 0, 0)

## The start routine of a worker thread. Win64 hands it one argument in rcx,
## which this ignores, so it does not matter that the compiled code reads its
## arguments elsewhere; it never returns.
fn win_thread_entry() int
    p := load64(global(TASKS))
    idx := load64(p + P_NEWT + 8)
    store64(p + P_TID + 8 * idx, import_call("GetCurrentThreadId", 0, 0, 0, 0))
    store64(p + P_TOP + 8 * idx, sp())
    atomic_store(p + P_NEWT, 0)
    worker_main(idx)
    0
