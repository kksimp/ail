## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Tasks (conc.task.*, native.task.1, ADRs 0599-0601): a pool of worker threads sized to the
## cores (at most 8, conc.par.9) that take tasks from one queue; `spawn` puts
## a task record on the queue and `wait` sleeps on the record's state word.
## On Linux a thread is a `clone` with a stack from `mmap` and every sleep is
## a futex; on macOS it is a libSystem pthread and a `__ulock_wait`. Only linked into a program that spawns tasks or runs `par for`
## (`notask.ail` stands in otherwise). The locks, thread identity and the
## allocator's lock are in `core.ail`.
##
## A task record (heap, 8-byte words):
##   +0 state (0 queued or running, 2 done, 3 trapped, 4 failed with an error)   +8 task id (picks
##   the function in `dispatch`)   +16 result   +24 next in the queue
##   +32 trap kind   +40 a   +48 b   +56 head string   +64 operator string   +72 source excerpt
##   +80 arguments, 8 bytes each
## The pool block (mmap'd, 8-byte words):
##   +0 lock   +8 head   +16 tail   +24 seq (idle workers sleep on it)
##   +32 live workers   +40 workers blocked in `wait`   +48 idle workers
##   +56 target workers   +128 the task each worker runs, by worker index
##   +1024 macOS restart stack pointers   +2048 each thread's published stack
##   pointer (0 while it runs), +4096 each thread's saved registers (10 words)
## Thread slot 0 is the main thread, worker `k` is slot `k + 1`.

P_LOCK := 0
P_HEAD := 8
P_TAIL := 16
P_SEQ := 24
P_LIVE := 32
P_BLOCKED := 40
P_IDLE := 48
P_TARGET := 56
P_CUR := 128
# macOS: each worker's restart stack pointer (workers run on pthreads there).
P_TOP := 1024
# A thread parked for the collector publishes its stack pointer here, with
# the callee-saved registers it had (native-abi.md §10).
P_PARK := 2048
P_REGS := 4096
# The mutexes each thread holds from `lock` (a list through the mutex records).
P_HELD := 12288
POOL_SZ := 24576
# Heap kinds of the blocks tasks use: every word may be a pointer, except an
# atomic cell, which is `KIND_ATOMIC` (heap.ail).
KIND_TASK := 12
KIND_ENV := 13

T_STATE := 0
T_ID := 8
T_RESULT := 16
T_NEXT := 24
T_KIND := 32
T_A := 40
T_B := 48
T_HEAD := 56
T_OP := 64
T_TAIL := 72
T_ARGS := 80
# After the 14 argument words: cancelled, the task that started this one, the
# channel it sleeps on, its first child and its next sibling (conc.cancel.*).
T_CANC := 192
T_PAR := 200
T_BLK := 208
T_KIDS := 216
T_SIB := 224
T_SIZE := 232

## The cores this process may run on, 1 to 8 (`sched_getaffinity`).
fn cores() int
    n := env_threads()
    if n > 0
        return n
    hw_cores()

## `AIL_THREADS` as a whole number of 1 to `MAXW` (conc.par.9, ADR 0272); 0 when it is
## unset or not a number, as in the interpreter, which then uses the hardware.
fn env_threads() int
    s := os_env_get("AIL_THREADS")
    if not os_ok()
        return 0
    p := str_addr(s)
    n := load64(p)
    mut v := 0
    mut i := 0
    while i < n
        c := load8(p + 16 + i)
        if c < 48 or c > 57
            return 0
        if v < 1000
            v = v * 10 + c - 48
        i += 1
    if n == 0
        return 0
    if v < 1
        return 1
    if v > MAXW
        return MAXW
    v

fn hw_cores() int
    if target() == 3
        c := import_call("GetActiveProcessorCount", 65535, 0, 0, 0)
        return if c < 1 then 1 else if c > 8 then 8 else c
    if target() == 2
        c := import_call("_sysconf", 58, 0, 0, 0)
        return if c < 1 then 1 else if c > 8 then 8 else c
    buf := alloc(128, KIND_BYTES)
    k := if target() == 0 then 204 else 123
    r := syscall(k, 0, 128, buf, 0, 0, 0)
    mut n := 0
    if r > 0
        for i in 0..r
            mut b := load8(buf + i)
            while b != 0
                n += b.bit_and(1)
                b = b.shr(1)
    if n < 1
        n = 1
    if n > 8
        n = 8
    n

## The pool block, made on first use. From then on the process has more
## than one thread, so allocation takes its lock (`MULTI`).
fn pool() int
    p := load64(global(TASKS))
    if p != 0
        return p
    q := sys_mmap(POOL_SZ)
    if q < 0
        fail(1, 0, 0)
    store64(q + P_TARGET, cores())
    # Windows threads run on stacks the system makes (`start_thread`).
    stacks := if target() == 3 then 0 else sys_mmap_lazy(MAXW * STACK_SZ)
    if stacks < 0
        fail(1, 0, 0)
    store64(global(STACKS), stacks)
    det_init(q)
    store64(global(TASKS), q)
    hset(H_FASTLIM, 0)
    store64(global(MULTI), 1)
    # The stack check compares against the main stack's limit, and a worker's
    # stack lies below it, so every recursive call in a task would trap. With
    # threads there is no limit; deep recursion meets the guard page instead.
    store64(global(STACK_LIMIT), 0)
    q

## A task record for function `id` of `dispatch`; the caller stores the
## arguments from `T_ARGS` and calls `task_start`.
fn task_new(id int) int
    rec := alloc(T_SIZE, KIND_TASK)
    store64(rec + T_ID, id)
    parent := cur_task()
    if parent != 0
        store64(rec + T_PAR, parent)
        store64(rec + T_SIB, load64(parent + T_KIDS))
        store64(parent + T_KIDS, rec)
        # A task started by a cancelled task starts cancelled.
        store64(rec + T_CANC, atomic_load(parent + T_CANC))
    rec

## Queue the task and make sure a worker will take it: wake an idle one, or
## start one while fewer than the target are running.
fn task_start(rec int)
    p := pool()
    if load64(p + P_DET + D_MODE) != 0
        det_spawn(p, rec)
        return
    lock(p + P_LOCK)
    tail := load64(p + P_TAIL)
    if tail == 0
        store64(p + P_HEAD, rec)
    else
        store64(tail + T_NEXT, rec)
    store64(p + P_TAIL, rec)
    store64(p + P_SEQ, load64(p + P_SEQ) + 1)
    atomic_add(global(TASKS_LIVE), 1)
    idle := load64(p + P_IDLE)
    live := load64(p + P_LIVE)
    mut fresh := -1
    if idle == 0 and live - load64(p + P_BLOCKED) < load64(p + P_TARGET) and live < MAXW
        store64(p + P_LIVE, live + 1)
        fresh = live
    unlock(p + P_LOCK)
    if idle > 0
        futex_wake(p + P_SEQ, 1)
    if fresh >= 0
        start_thread(p, fresh)

## Worker `idx`: its stack's low page is a guard, then a new thread.
fn start_thread(p int, idx int)
    if target() == 3
        win_start_thread(p, idx)
        return
    base := load64(global(STACKS)) + idx * STACK_SZ
    k := if target() == 0 then 10 else if target() == 1 then 226 else 74
    guard := if target() == 2 then 16384 else 4096
    syscall(k, base, guard, 0, 0, 0, 0)
    if target() == 2
        start_pthread(base + guard, idx)
        return
    if clone(base + STACK_SZ - 64, idx) < 0
        fail(1, 0, 0)

## macOS: threads come from libSystem's pthreads (ADR 0599), on the same
## stack region; the guard is the stack's lowest page (16 KiB here).
## `low` is the first byte above the guard; macOS pages are 16 KiB, and
## `pthread_attr_setstack` refuses an address or size that isn't aligned.
fn start_pthread(low int, idx int)
    attr := alloc(80, KIND_BYTES)
    import_call("_pthread_attr_init", attr, 0, 0, 0)
    size := (load64(global(STACKS)) + (idx + 1) * STACK_SZ) - low
    if import_call("_pthread_attr_setstack", attr, low, size, 0) != 0
        fail(1, 0, 0)
    r := import_call("_pthread_create", attr + 64, attr, fn_addr("rt.thread_entry"), idx)
    if r != 0
        fail(1, 0, 0)

## The start routine of a pthread: note where `restart` may reuse the stack
## (the pthread keeps its own record at the top), then run as a worker.
fn thread_entry(idx int) int
    p := load64(global(TASKS))
    store64(p + P_TOP + 8 * idx, sp())
    worker_main(idx)
    0

## Where `restart` puts worker `k`'s stack pointer.
fn stack_top(p int, k int) int
    if target() == 2 or target() == 3
        return load64(p + P_TOP + 8 * k)
    load64(global(STACKS)) + (k + 1) * STACK_SZ - 64

## The loop of worker `idx`: run queued tasks, sleep on `seq` when there are
## none. Entered by `clone` and by `restart` after a trap.
fn worker_main(idx int)
    p := load64(global(TASKS))
    if load64(p + P_DET + D_MODE) != 0
        det_worker(idx)
        return
    while true
        # Between tasks is a safe point: park if a collection wants the world.
        if atomic_load(global(GC_REQ)) != 0
            gc_park()
        lock(p + P_LOCK)
        rec := load64(p + P_HEAD)
        if rec != 0
            next := load64(rec + T_NEXT)
            store64(p + P_HEAD, next)
            if next == 0
                store64(p + P_TAIL, 0)
            unlock(p + P_LOCK)
            store64(p + P_CUR + 8 * idx, rec)
            dispatch(load64(rec + T_ID), rec)
            store64(p + P_CUR + 8 * idx, 0)
            held_release(idx + 1)
            if failed()
                # The task's own error (conc.task.6) waits for `wait`.
                store64(rec + T_RESULT, err_box())
                finish_task(rec, 4)
            else
                finish_task(rec, 2)
        else
            s := load64(p + P_SEQ)
            store64(p + P_IDLE, load64(p + P_IDLE) + 1)
            unlock(p + P_LOCK)
            futex_wait(p + P_SEQ, s.bit_and(4294967295))
            lock(p + P_LOCK)
            store64(p + P_IDLE, load64(p + P_IDLE) - 1)
            unlock(p + P_LOCK)

## Publish a task's end (its result is already stored) and wake its waiters.
fn finish_task(rec int, state int)
    atomic_xchg(rec + T_STATE, state)
    futex_wake(rec + T_STATE, 2147483647)
    det_wake(rec + T_STATE)
    atomic_add(global(TASKS_LIVE), -1)
    atomic_add(global(CHAN_EPOCH), 1)
    det_wake(global(CHAN_EPOCH))

## Called first by `trap`: on a worker, the trap ends the task and the
## worker goes on with the next one; on the main thread it returns and the
## process ends as usual.
fn on_trap(kind int, a int, b int, head str, op str, tail str)
    k := worker_index()
    if k < 0
        return
    p := load64(global(TASKS))
    rec := load64(p + P_CUR + 8 * k)
    store64(rec + T_KIND, kind)
    store64(rec + T_A, a)
    store64(rec + T_B, b)
    store64(rec + T_HEAD, str_addr(head))
    store64(rec + T_OP, str_addr(op))
    store64(rec + T_TAIL, str_addr(tail))
    held_release(k + 1)
    # A trap inside the allocator (a run limit) still holds its lock.
    if atomic_load(global(ALLOC_OWNER)) == k + 2
        atomic_store(global(ALLOC_OWNER), 0)
        unlock(global(ALLOC_LOCK))
    # A trap in the middle of a `print` still holds the output lock.
    if atomic_load(global(OUT_OWNER)) == k + 2
        store64(global(OUT_DEPTH), 0)
        atomic_store(global(OUT_OWNER), 0)
        unlock(global(OUT_LOCK))
    store64(p + P_CUR + 8 * k, 0)
    finish_task(rec, 3)
    if load64(p + P_DET + D_MODE) != 0
        det_end(p + P_DET, k + 1)
    restart(stack_top(p, k), k)

## `t.wait()?` in `main`: sleep until the task ends, then its result word; a
## trapped task ends the program as the interpreter's uncaught `Trapped`
## does (conc.task.6, native.task.1).
fn task_wait(rec int, at1 str, at2 str) int
    det_yield()
    if wait_done_dl(rec, true)
        return 0
    if atomic_load(rec + T_STATE) == 3
        report_trapped(rec, at1, at2)
    if atomic_load(rec + T_STATE) == 4
        err_restore(load64(rec + T_RESULT))
        return 0
    load64(rec + T_RESULT)

## `t.wait() else ...`: the result, or, when the task trapped, the failure
## `Trapped(rule, message)` in the error slot (conc.task.6) and 0.
fn task_try(rec int, at str, own int) int
    det_yield()
    if wait_done_dl(rec, true)
        return 0
    if atomic_load(rec + T_STATE) == 4
        err_restore(load64(rec + T_RESULT))
        return 0
    if atomic_load(rec + T_STATE) != 3
        return load64(rec + T_RESULT)
    # A function with an error type of its own can't hold a `Trapped`.
    if own != 0
        report_trapped(rec, at, at)
    trapped_error(rec, at)
    0

## The failure `Trapped(rule, message)` of the trapped task `rec`, in the error slot.
fn trapped_error(rec int, at str)
    h := load64(rec + T_HEAD)
    n := load64(h)
    d := h + 16
    mut t := 0
    while t + 5 <= n and not is_trap_mark(d + t)
        t += 1
    mut j := t - 3
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    j -= 1
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    mut e := t + 5
    while e < n and load8(d + e) != 93
        e += 1
    rule := os_str_from(d + t + 5, e - t - 5)
    # The message is written to the output buffer, then taken back out of it.
    out_lock()
    flush()
    out_bytes(d + j + 1, t - j - 2)
    out_byte(32)
    trap_body(
        load64(rec + T_KIND),
        load64(rec + T_A),
        load64(rec + T_B),
        str_at(load64(rec + T_OP)),
    )
    msg := os_str_from(load64(global(OUT_BUF)), load64(global(OUT_LEN)))
    store64(global(OUT_LEN), 0)
    out_unlock()
    sb_reset()
    sb_text("Trapped(rule: ")
    os_put_quoted(rule)
    sb_text(", message: ")
    os_put_quoted(msg)
    sb_byte(41)
    err_set(sb_str(), at)
    v := obj_new(16, 4)
    store64(v, str_addr(rule))
    store64(v + 8, str_addr(msg))
    err_value(v)

## Sleep until the task has ended, trapped or not.
fn wait_done(rec int)
    wait_done_dl(rec, false)

## `wait_done`; with `report` the main task gives up when every task is
## blocked (conc.task.7): true, with the message in `CHAN_FAULT`.
fn wait_done_dl(rec int, report bool) bool
    mut dead := false
    if atomic_load(rec + T_STATE) == 0
        k := worker_index()
        if k >= 0
            wait_enter()
        while atomic_load(rec + T_STATE) == 0 and not dead
            dead = prog_wait(rec + T_STATE, 0, "a task to finish", report)
        if k >= 0
            wait_leave()
    dead

## A worker is about to sleep in `wait`: it stops counting as running, and
## a replacement starts if work is queued and nobody could take it.
fn wait_enter()
    p := load64(global(TASKS))
    lock(p + P_LOCK)
    store64(p + P_BLOCKED, load64(p + P_BLOCKED) + 1)
    live := load64(p + P_LIVE)
    mut fresh := -1
    if load64(p + P_HEAD) != 0 and load64(p + P_IDLE) == 0
        if live - load64(p + P_BLOCKED) < load64(p + P_TARGET) and live < MAXW
            store64(p + P_LIVE, live + 1)
            fresh = live
    unlock(p + P_LOCK)
    if fresh >= 0
        start_thread(p, fresh)

fn wait_leave()
    p := load64(global(TASKS))
    lock(p + P_LOCK)
    store64(p + P_BLOCKED, load64(p + P_BLOCKED) - 1)
    unlock(p + P_LOCK)

## `error: Trapped(rule: "RULE", message: "LINE:COL: MESSAGE")` on standard
## error, then exit 1. The trap's head is `PATH:LINE:COL: trap[RULE]: `.
fn report_trapped(rec int, at1 str, at2 str)
    h := load64(rec + T_HEAD)
    n := load64(h)
    d := h + 16
    # `trap[`
    mut t := 0
    while t + 5 <= n and not is_trap_mark(d + t)
        t += 1
    # The location: the digits and colon before `: trap[`.
    mut j := t - 3
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    j -= 1
    while j >= 0 and load8(d + j) >= 48 and load8(d + j) <= 57
        j -= 1
    flush()
    out_str("error: Trapped(rule: \"")
    mut e := t + 5
    while e < n and load8(d + e) != 93
        e += 1
    out_bytes(d + t + 5, e - t - 5)
    out_str("\", message: \"")
    out_bytes(d + j + 1, t - j - 2)
    out_byte(32)
    trap_body(
        load64(rec + T_KIND),
        load64(rec + T_A),
        load64(rec + T_B),
        str_at(load64(rec + T_OP)),
    )
    out_str("\")\n")
    # The trace: the `wait` and the `?` that passed the trap on (err.ctx.1).
    out_str(at1)
    out_byte(10)
    out_str(at2)
    out_byte(10)
    flush_to(2)
    sys_exit(1)

fn is_trap_mark(a int) bool
    load8(a) == 116
        and load8(a + 1) == 114
        and load8(a + 2) == 97
        and load8(a + 3) == 112
        and load8(a + 4) == 91

## The function of task `id`: written by the compiler, one case per `spawn`
## site and parallel loop.
fn dispatch(id int, rec int)
    todo

# ---- parallel loops (ADR 0601) ----

## Whether `par for lo..hi` goes to the pool: at least twice as many
## iterations as workers (conc.par.8). A chunk function takes the environment
## record, `lo` and `hi` from its task record's arguments 0 to 2, then
## 3 words (sum, lowest and highest running sum) per accumulator.
fn par_worth(lo int, hi int) bool
    # conc.par.9: a deterministic run keeps every loop on one thread.
    if det_on()
        return false
    t := load64(pool() + P_TARGET)
    hi > lo and hi - lo > 0 and hi - lo >= 2 * t

## `n` zeroed words: the values a loop body reads and the accumulators.
fn env_new(n int) int
    alloc(8 * n + 8, KIND_ENV)

## Split `lo..hi` into chunks, four per worker, queue them, and give back
## the group: word 0 the chunk count, then the task records in order.
fn par_start(id int, env int, lo int, hi int) int
    t := load64(pool() + P_TARGET)
    n := hi - lo
    mut chunks := 4 * t
    if chunks > n
        chunks = n
    size := (n + chunks - 1) / chunks
    chunks = (n + size - 1) / size
    grp := alloc(8 * chunks + 8, KIND_ENV)
    store64(grp, chunks)
    for c in 0..chunks
        off := c * size
        len := if size < n - off then size else n - off
        rec := task_new(id)
        store64(rec + T_ARGS, env)
        store64(rec + T_ARGS + 8, lo + off)
        store64(rec + T_ARGS + 16, lo + off + len)
        store64(grp + 8 + 8 * c, rec)
        task_start(rec)
    grp

## Wait for every chunk; whether none trapped.
fn par_wait(grp int) bool
    mut ok := true
    for c in 0..load64(grp)
        rec := load64(grp + 8 + 8 * c)
        wait_done(rec)
        if atomic_load(rec + T_STATE) != 2
            ok = false
    ok

## A chunk of a loop that can't be run again trapped: report the first
## such trap as `trap` does, and end the process (conc.atomic.6).
fn par_fail(grp int)
    for c in 0..load64(grp)
        rec := load64(grp + 8 + 8 * c)
        if atomic_load(rec + T_STATE) == 3
            flush()
            out_str(str_at(load64(rec + T_HEAD)))
            trap_body(
                load64(rec + T_KIND),
                load64(rec + T_A),
                load64(rec + T_B),
                str_at(load64(rec + T_OP)),
            )
            out_byte(10)
            out_str(str_at(load64(rec + T_TAIL)))
            flush_to(2)
            sys_exit(1)

## Combine the accumulators in chunk order, checking as the sequential sum
## would: a running sum that would leave `int` anywhere makes the loop run
## in order instead (conc.par.11). The totals go back into the environment.
fn par_combine(grp int, env int, nacc int, first int) bool
    least := -9223372036854775807 - 1
    most := 9223372036854775807
    for a in 0..nacc
        mut total := load64(env + 8 * (first + a))
        for c in 0..load64(grp)
            rec := load64(grp + 8 + 8 * c)
            w := rec + T_ARGS + 8 * (3 + 3 * a)
            if total < least - load64(w + 8) or total > most - load64(w + 16)
                return false
            total += load64(w)
        store64(env + 8 * (first + a), total)
    true

# ---- atomics (ADR 0600) ----

## `print` of an atomic: `Atomic(7)`, `Atomic(true)`.
fn out_atomic_int(cell int)
    out_str("Atomic(")
    out_int(atomic_load(cell))
    out_byte(41)

fn out_atomic_bool(cell int)
    out_str("Atomic(")
    out_bool(atomic_load(cell) != 0)
    out_byte(41)

# ---- stopping the world for the collector (native-abi.md §10) ----

## Give the CPU away while waiting for another thread.
fn yield_cpu()
    t := target()
    if t == 3
        import_call("SwitchToThread", 0, 0, 0, 0)
        return
    if t == 2
        import_call("_sched_yield", 0, 0, 0, 0)
        return
    syscall(if t == 0 then 24 else 124, 0, 0, 0, 0, 0, 0)

## Publish this thread's stack pointer and callee-saved registers, so the
## collector may scan the thread while it sleeps. Gives the stack pointer.
fn blocked_enter() int
    p := load64(global(TASKS))
    t := thread_slot()
    s := gc_regs(p + P_REGS + 80 * t)
    atomic_store(p + P_PARK + 8 * t, s)
    s

## Leave the parked state. While a collection runs the thread stays parked;
## it clears its mark first and looks again, so the collector never scans a
## thread that has started to run.
fn blocked_leave(s int)
    p := load64(global(TASKS))
    t := thread_slot()
    while true
        while atomic_load(global(GC_REQ)) != 0
            futex_wait_raw(global(GC_REQ), 1)
        atomic_store(p + P_PARK + 8 * t, 0)
        if atomic_load(global(GC_REQ)) == 0
            return
        atomic_store(p + P_PARK + 8 * t, s)

## Park here until the collection that was asked for is over.
fn gc_park()
    blocked_leave(blocked_enter())

## Ask every other thread to park and wait until each has. A thread that
## computes without reaching the runtime delays the collection, nothing else.
fn gc_stop_world()
    if load64(global(MULTI)) == 0
        return
    p := load64(global(TASKS))
    me := thread_slot()
    atomic_store(global(GC_REQ), 1)
    n := 1 + load64(p + P_LIVE)
    for t in 0..n
        if t != me
            while atomic_load(p + P_PARK + 8 * t) == 0
                yield_cpu()

fn gc_start_world()
    if load64(global(MULTI)) == 0
        return
    atomic_store(global(GC_REQ), 0)
    futex_wake(global(GC_REQ), 2147483647)

## The end of this thread's stack: the main thread's top (`rt.init`), or the
## top of the worker's slice of the stack region.
fn stack_end_self() int
    if load64(global(MULTI)) == 0 or worker_index() < 0
        return load64(global(STACK_TOP))
    if target() == 3
        return load64(load64(global(TASKS)) + P_TOP + 8 * worker_index())
    load64(global(STACKS)) + (worker_index() + 1) * STACK_SZ

## Mark from the other threads' published stacks and registers, and from
## the pool block (the queue and the running tasks' records).
fn gc_scan_threads()
    if load64(global(MULTI)) == 0
        return
    p := load64(global(TASKS))
    me := thread_slot()
    n := 1 + load64(p + P_LIVE)
    gc_scan_range(p, p + P_PARK)
    # Each thread's text builder (fmt.ail) points at a heap buffer.
    gc_scan_range(p + P_SB, p + P_SB + 24 * (n + 1))
    gc_scan_range(p + P_ERR, p + P_ERR + 24 * (n + 1))
    for t in 0..n
        if t != me
            s := load64(p + P_PARK + 8 * t)
            mut top := if t
                == 0 then load64(global(STACK_TOP)) else load64(global(STACKS)) + t * STACK_SZ
            if target() == 3 and t > 0
                top = load64(p + P_TOP + 8 * (t - 1))
            gc_scan_range(p + P_REGS + 80 * t, p + P_REGS + 80 * t + 80)
            gc_scan_range(s, top)

# ---- Mutex and TaskGroup (conc.share.5, conc.task.8) ----
#
# A mutex is a record: +0 lock word, +8 the value (as an optional holds it),
# +16 the holder's thread id or 0, +24 wake word. A group is a record: +0 the
# count, +8 whether `wait_all` has run, +16 the array of task records.

M_LOCK := 0
M_VAL := 8
M_OWN := 16
M_WAKE := 24
M_NEXT := 32

fn mutex_new(v int) int
    m := alloc(40, KIND_ENV)
    store64(m + M_VAL, v)
    m

fn mutex_fault(text str) int
    store64(global(CHAN_FAULT), str_addr(text))
    0

## Wait until nobody else holds `m`, then run with its lock word taken; the
## caller releases it with `mutex_leave`. With `take`, this thread becomes the
## holder. Returns 0 if this thread holds it already and `take` is set.
fn mutex_enter(m int, take bool) int
    me := thread_id()
    while true
        lock(m + M_LOCK)
        o := load64(m + M_OWN)
        if o == me and take
            unlock(m + M_LOCK)
            return 0
        if o == 0 or o == me
            if take
                store64(m + M_OWN, me)
                slot := pool() + P_HELD + 8 * (worker_index() + 1)
                store64(m + M_NEXT, load64(slot))
                store64(slot, m)
            return 1
        w := load64(m + M_WAKE)
        unlock(m + M_LOCK)
        k := worker_index()
        if k >= 0
            wait_enter()
        prog_wait(m + M_WAKE, w, "a mutex another task holds", false)
        if k >= 0
            wait_leave()
    0

fn mutex_leave(m int)
    unlock(m + M_LOCK)

## `m.get()`.
fn mutex_get(m int) int
    det_yield()
    mutex_enter(m, false)
    v := load64(m + M_VAL)
    mutex_leave(m)
    v

## `m.set(v)`.
fn mutex_set(m int, v int)
    det_yield()
    mutex_enter(m, false)
    store64(m + M_VAL, v)
    mutex_leave(m)

## `m.swap(v)`: the old value.
fn mutex_swap(m int, v int) int
    det_yield()
    mutex_enter(m, false)
    old := load64(m + M_VAL)
    store64(m + M_VAL, v)
    mutex_leave(m)
    old

## `m.lock()`: the value, or 0 with the trap message left in `CHAN_FAULT`.
fn mutex_lock(m int) int
    det_yield()
    if mutex_enter(m, true) == 0
        return mutex_fault("`lock` while already holding the mutex")
    v := load64(m + M_VAL)
    mutex_leave(m)
    v

## `m.unlock(v)`: 0, or the message of the trap.
fn mutex_unlock(m int, v int) int
    det_yield()
    lock(m + M_LOCK)
    if load64(m + M_OWN) != thread_id()
        unlock(m + M_LOCK)
        return str_addr("`unlock` without holding the mutex from `lock`")
    store64(m + M_VAL, v)
    held_drop(m)
    store64(m + M_OWN, 0)
    store64(m + M_WAKE, (load64(m + M_WAKE) + 1).bit_and(4294967295))
    futex_wake(m + M_WAKE, 1000000)
    det_wake(m + M_WAKE)
    atomic_add(global(CHAN_EPOCH), 1)
    unlock(m + M_LOCK)
    0

fn group_new() int
    alloc(32, KIND_ENV)

## `g.add(t)`.
fn group_add(g int, rec int)
    n := load64(g)
    arr := load64(g + 16)
    if arr == 0 or n % 8 == 0
        bigger := alloc(8 * (n + 8), KIND_ENV)
        for i in 0..n
            store64(bigger + 8 * i, load64(arr + 8 * i))
        store64(g + 16, bigger)
    store64(load64(g + 16) + 8 * n, rec)
    store64(g, n + 1)
    if load64(g + 24) != 0
        task_cancel(rec)

## `g.wait_all()`: waits for every task; the first trapped one is the failure
## `Trapped` in the error slot (conc.task.8).
fn group_wait(g int, at str)
    n := load64(g)
    mut bad := 0
    for i in 0..n
        rec := load64(load64(g + 16) + 8 * i)
        if wait_done_dl(rec, true)
            return
        if bad == 0 and atomic_load(rec + T_STATE) == 3
            bad = rec
    store64(g + 8, 1)
    if bad != 0
        trapped_error(bad, at)

## The block that holds the group ends: wait for the tasks, and a trap in one
## that `wait_all` didn't report ends this task too (conc.task.8).
fn group_end(g int)
    n := load64(g)
    mut bad := 0
    for i in 0..n
        rec := load64(load64(g + 16) + 8 * i)
        if wait_done_dl(rec, true)
            return
        if bad == 0 and atomic_load(rec + T_STATE) == 3
            bad = rec
    if bad != 0 and load64(g + 8) == 0
        trap(
            load64(bad + T_KIND),
            load64(bad + T_A),
            load64(bad + T_B),
            str_at(load64(bad + T_HEAD)),
            str_at(load64(bad + T_OP)),
            str_at(load64(bad + T_TAIL)),
        )

## `m` is no longer held by this thread: take it off the thread's list.
fn held_drop(m int)
    slot := pool() + P_HELD + 8 * (worker_index() + 1)
    mut at := slot
    while load64(at) != 0 and load64(at) != m
        at = load64(at) + M_NEXT
    if load64(at) == m
        store64(at, load64(m + M_NEXT))

## A task ended or trapped while holding mutexes: release them, keeping the
## values they had (conc.share.5, conc.share.6).
fn held_release(slot int)
    at := pool() + P_HELD + 8 * slot
    while load64(at) != 0
        m := load64(at)
        store64(at, load64(m + M_NEXT))
        lock(m + M_LOCK)
        store64(m + M_OWN, 0)
        store64(m + M_WAKE, (load64(m + M_WAKE) + 1).bit_and(4294967295))
        futex_wake(m + M_WAKE, 1000000)
        det_wake(m + M_WAKE)
        atomic_add(global(CHAN_EPOCH), 1)
        unlock(m + M_LOCK)

# ---- cancellation (conc.cancel.1-4) ----

## The task record this thread is running, or 0 on the main thread.
fn cur_task() int
    k := worker_index()
    if k < 0
        return 0
    load64(pool() + P_CUR + 8 * k)

## `task.cancelled()`.
fn task_cancelled() bool
    rec := cur_task()
    rec != 0 and atomic_load(rec + T_CANC) != 0

## `task.check()`: the failure `Cancelled` once the running task is cancelled.
fn task_check(at str)
    det_yield()
    if task_cancelled()
        err_set("the task was cancelled", at)

## The running task is about to sleep on channel `ch` (0: it has woken), so a
## cancel can wake it.
fn task_block_on(ch int)
    rec := cur_task()
    if rec != 0
        atomic_store(rec + T_BLK, ch)

## `t.cancel()`: the task and every task it started, however deep.
fn task_cancel(rec int)
    det_yield()
    atomic_xchg(rec + T_CANC, 1)
    b := atomic_load(rec + T_BLK)
    if b != 0
        chan_wake(b)
    mut kid := load64(rec + T_KIDS)
    while kid != 0
        task_cancel(kid)
        kid = load64(kid + T_SIB)

## `g.cancel()`: every task of the group, and those added later.
fn group_cancel(g int)
    store64(g + 24, 1)
    for i in 0..load64(g)
        task_cancel(load64(load64(g + 16) + 8 * i))

# ---- Windows threads (win.ail) ----

## Start worker `idx`. The new thread learns its index from `P_NEWT + 8`,
## which it reads before it lets go of the word at `P_NEWT` (one start at a time).
fn win_start_thread(p int, idx int)
    while atomic_cas(p + P_NEWT, 0, 1) != 0
        import_call("SwitchToThread", 0, 0, 0, 0)
    store64(p + P_NEWT + 8, idx)
    # STACK_SIZE_PARAM_IS_A_RESERVATION: STACK_SZ bytes of address space, committed as used.
    h := import_call("CreateThread", 0, STACK_SZ, fn_addr("rt.win_thread_entry"), 0, 0, 0)
    if h == 0
        err_begin()
        out_str("CreateThread failed, error ")
        out_int(import_call("GetLastError", 0, 0, 0, 0))
        out_byte(10)
        err_end()
        fail(1, 0, 0)
    import_call("CloseHandle", h, 0, 0, 0)

## The start routine of a worker thread. Win64 hands it one argument in rcx,
## which this ignores, so it does not matter that the compiled code reads its
## arguments elsewhere; it never returns.
fn win_thread_entry() int
    p := load64(global(TASKS))
    idx := load64(p + P_NEWT + 8)
    store64(p + P_TID + 8 * idx, import_call("GetCurrentThreadId", 0, 0, 0, 0))
    store64(p + P_TOP + 8 * idx, sp())
    atomic_store(p + P_NEWT, 0)
    worker_main(idx)
    0
