## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `Channel[str]` (native.chan.1, conc.share.3-4, conc.share.7-8, conc.select.1; ADR 0599,
## ADR 0996). A channel is a record of fourteen words (heap kind 13, scanned conservatively),
## and a value is the record's address; a copy of the handle is the same
## channel. The queue is a ring of string pointers. All fields are guarded by
## the record's lock word. A thread that must wait joins one of the record's
## two lines (the threads waiting for a value, and those waiting for room),
## releases the lock and sleeps on a word of its own; a value put wakes the
## oldest of the first line and a value taken the oldest of the second, so a
## change wakes one thread, not all of them (ADR 1188). The wake-up itself,
## a system call, is made after the lock is released (`chan_unlock`), and a
## thread looks at the channel for a short while before it joins a line, so a
## busy channel is passed between running threads with no system call at all.
## A close or a cancel wakes both lines. A thread of the pool that sleeps stops counting as
## running, as in `wait`, so a replacement starts when work is queued
## (task.ail). A deterministic run keeps no lines: its threads wait on the
## wake word, which every change bumps (sched.ail).
##
## A channel with a nonzero `source` is fed from outside, as a child's output
## streams are (std.proc.5): an empty, open one calls `chan_pump`, `send`
## calls `chan_source_send` and `close` calls `chan_source_close`. The runtime
## of the child process (`proc.ail`) defines those three.

C_LOCK := 0
C_CAP := 8
C_COUNT := 16
C_HEAD := 24
C_CLOSED := 32
C_RING := 40
C_SOURCE := 48
C_WAKE := 56
C_RCAP := 64
C_ID := 72
# The two lines of sleepers, oldest first: the first and last of those waiting
# for a value, then of those waiting for room (ADR 1188). A line's last word
# follows its first.
C_RLINE := 80
C_SLINE := 96
# The sleeper a put or a take took out of its line under the lock: `chan_unlock`
# wakes it once the lock is free.
C_PEND := 112
# How often a thread looks at a channel again before it joins a line: about
# as long as going to sleep and being woken costs the two threads, which
# measured longer than the gap between two jobs of a pool (ADR 1225).
CHAN_LOOKS := 50000
# A sleeper: the word it sleeps on while it is 0 (a wake stores 1), then the
# next in its line.
S_NEXT := 8

# Global slots 25 and 26: a counter every channel change bumps, and how many
# `select`s sleep on it.
CHAN_EPOCH := 25
CHAN_SEL := 26
# Global slot 27: channels made so far; a channel's id is its number in order,
# as the interpreter names it (`Channel#N`).
CHAN_COUNT := 27
# Global slots 28-30: the message of a deadlock the main task found (taken by
# `chan_fault`), the tasks not yet finished, and the threads sleeping on a
# change only the program can make (conc.task.7).
CHAN_FAULT := 28
TASKS_LIVE := 29
BLOCKED_N := 30

## A channel that holds up to `cap` values (the lowering has checked `cap >= 1`).
fn chan_new_cap(cap int) int
    ch := alloc(120, KIND_ENV)
    store64(ch + C_CAP, cap)
    store64(ch + C_ID, atomic_add(global(CHAN_COUNT), 1))
    ch

## A channel for a feeder (`chan_push`) with room for any number of values.
fn chan_new() int
    chan_new_cap(1152921504606846976)

## The message when `cap` is not a valid capacity, else 0 (conc.share.4).
fn chan_cap_fault(cap int) int
    if cap >= 1
        return 0
    sb_reset()
    sb_text("a channel's capacity must be at least 1, found ")
    put_int(cap)
    str_addr(sb_str())

## A trap message naming the channel as the interpreter does.
fn chan_msg(head str, ch int, tail str) int
    sb_reset()
    sb_text(head)
    sb_text("Channel#")
    put_int(load64(ch + C_ID))
    sb_text(tail)
    str_addr(sb_str())

## Holding the lock: a new sleeper at the end of the line `line` (`C_RLINE`
## or `C_SLINE`).
fn chan_line_add(ch int, line int) int
    w := alloc(16, KIND_ENV)
    last := load64(ch + line + 8)
    if last == 0
        store64(ch + line, w)
    else
        store64(last + S_NEXT, w)
    store64(ch + line + 8, w)
    w

## Holding the lock: the sleeper `w` has woken; it leaves the line if no wake
## took it out (its time ran out, or the sleep ended by itself).
fn chan_line_drop(ch int, line int, w int)
    if atomic_load(w) != 0
        return
    mut prev := 0
    mut at := load64(ch + line)
    while at != 0 and at != w
        prev = at
        at = load64(at + S_NEXT)
    if at == 0
        return
    rest := load64(w + S_NEXT)
    if prev == 0
        store64(ch + line, rest)
    else
        store64(prev + S_NEXT, rest)
    if rest == 0
        store64(ch + line + 8, prev)

## Holding the lock: take the oldest sleeper out of the line and mark it
## woken, so it no longer sleeps on its word; 0 when the line is empty. The
## caller wakes it.
fn chan_line_take(ch int, line int) int
    w := load64(ch + line)
    if w == 0
        return 0
    rest := load64(w + S_NEXT)
    store64(ch + line, rest)
    if rest == 0
        store64(ch + line + 8, 0)
    atomic_store(w, 1)
    w

## Holding the lock: wake the oldest sleeper of the line, if there is one.
fn chan_line_wake(ch int, line int)
    w := chan_line_take(ch, line)
    if w != 0
        futex_wake(w, 1)

## Release the channel's lock, then wake the sleeper a put or a take under
## this hold of the lock let go on. Every release of a channel's lock that
## may follow `chan_put` or `chan_take` is this one.
fn chan_unlock(ch int)
    w := load64(ch + C_PEND)
    store64(ch + C_PEND, 0)
    unlock(ch + C_LOCK)
    if w != 0
        futex_wake(w, 1)

## Whether a thread of the line `line` would have to wait now: no value for a
## receiver, no room for a sender, and the channel is open. Exact holding the
## lock; without it, a look that may be out of date.
fn chan_waits(ch int, line int) bool
    if atomic_load(ch + C_CLOSED) != 0
        return false
    n := atomic_load(ch + C_COUNT)
    if line == C_RLINE
        return n == 0
    n >= atomic_load(ch + C_CAP)

## Holding the lock, after a value was put (`line` is `C_RLINE`) or taken
## (`C_SLINE`): wake the one thread the change can let go on, and every
## `select`, which sleeps on the global counter.
fn chan_changed(ch int, line int)
    store64(ch + C_WAKE, (load64(ch + C_WAKE) + 1).bit_and(4294967295))
    w := chan_line_take(ch, line)
    if w != 0
        # A second change under one hold of the lock: wake the first sleeper now.
        first := load64(ch + C_PEND)
        if first != 0
            futex_wake(first, 1)
        store64(ch + C_PEND, w)
    det_wake(ch + C_WAKE)
    atomic_add(global(CHAN_EPOCH), 1)
    if atomic_load(global(CHAN_SEL)) != 0
        futex_wake(global(CHAN_EPOCH), 1000000)
        det_wake(global(CHAN_EPOCH))

## Holding the lock: wake every sleeper of both lines (a close, a cancel).
fn chan_wake_all(ch int)
    while load64(ch + C_RLINE) != 0
        chan_line_wake(ch, C_RLINE)
    while load64(ch + C_SLINE) != 0
        chan_line_wake(ch, C_SLINE)
    store64(ch + C_WAKE, (load64(ch + C_WAKE) + 1).bit_and(4294967295))
    det_wake(ch + C_WAKE)
    atomic_add(global(CHAN_EPOCH), 1)
    if atomic_load(global(CHAN_SEL)) != 0
        futex_wake(global(CHAN_EPOCH), 1000000)
        det_wake(global(CHAN_EPOCH))

## Wake every thread asleep on `ch`: a task that sleeps on it was cancelled
## (`task_cancel`). Not called holding the lock.
fn chan_wake(ch int)
    lock(ch + C_LOCK)
    chan_wake_all(ch)
    chan_unlock(ch)

## Called holding the lock: join the line `line`, release the lock, sleep
## until a wake, take the lock again. Whether the main task found a deadlock
## instead (`what` is what it waited for; the message waits in `CHAN_FAULT`).
fn chan_sleep(ch int, line int, what str) bool
    # A deterministic run waits on the wake word, in the order of sched.ail.
    turns := det_on()
    if not turns and load64(global(MULTI)) != 0
        # Other threads run: the change this one waits for is often a few
        # instructions away. Look for it without the lock before sleeping.
        chan_unlock(ch)
        mut looks := 0
        while looks < CHAN_LOOKS and chan_waits(ch, line) and atomic_load(global(GC_REQ)) == 0
            looks += 1
        lock(ch + C_LOCK)
        if not chan_waits(ch, line)
            return false
    task_block_on(ch)
    if task_cancelled()
        # The caller sees the cancel and leaves; the lock is still held.
        task_block_on(0)
        return false
    w := if turns then ch + C_WAKE else chan_line_add(ch, line)
    v := if turns then load64(ch + C_WAKE) else 0
    chan_unlock(ch)
    k := worker_index()
    if k >= 0
        wait_enter()
    dead := prog_wait(w, v, what, true)
    if k >= 0
        wait_leave()
    task_block_on(0)
    lock(ch + C_LOCK)
    if not turns
        chan_line_drop(ch, line, w)
    dead

## Sleep while `*a == v`, counted among the blocked threads. The main task
## sleeps in slices; when every unfinished task is blocked and nothing has
## changed for 100 ms it is a deadlock (conc.task.7): with `report` it returns
## true after storing the message, else it goes on waiting.
fn prog_wait(a int, v int, what str, report bool) bool
    if det_on()
        return det_block(a, v, what, report)
    task_wait_mark(a, v)
    atomic_add(global(BLOCKED_N), 1)
    mut dead := false
    if worker_index() >= 0
        futex_wait(a, v)
    else
        mut idle := 0
        while atomic_load(a).bit_and(4294967295) == v and not dead
            e := atomic_load(global(CHAN_EPOCH))
            futex_wait_timed(a, v, 25)
            blocked := atomic_load(global(BLOCKED_N))
            if atomic_load(global(CHAN_EPOCH)) == e
                and blocked == atomic_load(global(TASKS_LIVE)) + 1
                and not woken_waiters()
                idle += 1
            else
                idle = 0
            if idle >= 4 and report
                dead = true
                sb_reset()
                sb_text("deadlock: the main task waits for ")
                sb_text(what)
                sb_text(", and ")
                others := blocked - 1
                if others == 0
                    sb_text("no other tasks are")
                elif others == 1
                    sb_text("1 other task is")
                else
                    put_int(others)
                    sb_text(" other tasks are")
                sb_text(" blocked")
                store64(global(CHAN_FAULT), str_addr(sb_str()))
    atomic_add(global(BLOCKED_N), -1)
    # Unmarked after leaving the count, so a task is never counted blocked
    # while it looks awake to `woken_waiters` and isn't.
    task_wait_mark(0, 0)
    dead

## The deadlock message the last blocking operation found, or 0; clears it.
fn chan_fault() int
    m := load64(global(CHAN_FAULT))
    store64(global(CHAN_FAULT), 0)
    m

## Called holding the lock: add `v` at the tail, growing the ring if it is full.
fn chan_put(ch int, v int)
    n := load64(ch + C_COUNT)
    rc := load64(ch + C_RCAP)
    if n == rc
        nc := if rc == 0 then 8 else rc * 2
        ring := alloc(nc * 8, KIND_ENV)
        old := load64(ch + C_RING)
        head := load64(ch + C_HEAD)
        for i in 0..n
            store64(ring + 8 * i, load64(old + 8 * ((head + i) % rc)))
        store64(ch + C_RING, ring)
        store64(ch + C_RCAP, nc)
        store64(ch + C_HEAD, 0)
    rc2 := load64(ch + C_RCAP)
    store64(load64(ch + C_RING) + 8 * ((load64(ch + C_HEAD) + n) % rc2), v)
    store64(ch + C_COUNT, n + 1)
    chan_changed(ch, C_RLINE)

## Queue `s` without waiting for room: what a feeder does with a line it read.
fn chan_push(ch int, s str)
    lock(ch + C_LOCK)
    chan_put(ch, str_addr(s))
    chan_unlock(ch)

## The feeder has no more text: a receiver that finds the queue empty gets `none`.
fn chan_mark_closed(ch int)
    lock(ch + C_LOCK)
    store64(ch + C_CLOSED, 1)
    chan_wake_all(ch)
    chan_unlock(ch)

## `ch.send(v)`: 0, or the message of the trap (conc.share.4).
fn chan_send(ch int, v int) int
    det_yield()
    if load64(ch + C_SOURCE) != 0
        chan_source_send(ch, v)
        return 0
    lock(ch + C_LOCK)
    while true
        if load64(ch + C_CLOSED) != 0
            chan_unlock(ch)
            return chan_msg("send on a closed channel `", ch, "`")
        if load64(ch + C_COUNT) < load64(ch + C_CAP)
            race_release(ch)
            chan_put(ch, v)
            chan_unlock(ch)
            return 0
        if task_cancelled()
            # conc.cancel.4: no waiting for room; the value is dropped.
            chan_unlock(ch)
            return 0
        if chan_sleep(ch, C_SLINE, "room in a channel")
            chan_unlock(ch)
            return chan_fault()
    0

## Holding the lock: take the oldest value, or 0 when none is queued.
fn chan_take(ch int) int
    n := load64(ch + C_COUNT)
    if n == 0
        return 0
    head := load64(ch + C_HEAD)
    ring := load64(ch + C_RING)
    v := load64(ring + 8 * head)
    store64(ring + 8 * head, 0)
    store64(ch + C_HEAD, (head + 1) % load64(ch + C_RCAP))
    store64(ch + C_COUNT, n - 1)
    chan_changed(ch, C_SLINE)
    v

## `ch.recv()`: the oldest value, or 0 once the channel is closed and empty.
fn chan_recv(ch int) int
    det_yield()
    lock(ch + C_LOCK)
    while true
        v := chan_take(ch)
        if v != 0
            chan_unlock(ch)
            race_acquire(ch)
            return v
        if load64(ch + C_CLOSED) != 0 or task_cancelled()
            chan_unlock(ch)
            return 0
        if load64(ch + C_SOURCE) != 0
            chan_unlock(ch)
            chan_pump(ch)
            lock(ch + C_LOCK)
        elif chan_sleep(ch, C_RLINE, "a value from a channel")
            chan_unlock(ch)
            return 0
    0

## `ch.try_recv()` (conc.share.8, ADR 0996): the oldest value if one is queued
## now, else 0; it never waits. A child's output is read first, without waiting.
fn chan_try_recv(ch int) int
    det_yield()
    if load64(ch + C_SOURCE) != 0
        chan_ready(ch)
    lock(ch + C_LOCK)
    v := chan_take(ch)
    chan_unlock(ch)
    if v != 0
        race_acquire(ch)
    v

## `ch.recv_for(ms)` (conc.share.8): as `recv`, but 0 once `ms` milliseconds
## pass with no value. A timed wait is never a deadlock (conc.task.7), so it
## isn't counted among the blocked threads. Under `--deterministic` no time
## passes: it waits as `recv` does, and where `recv` would find a deadlock the
## time is up instead.
fn chan_recv_for(ch int, ms int) int
    det_yield()
    end := time_mono_ms() + (if ms < 0 then 0 else ms)
    lock(ch + C_LOCK)
    while true
        v := chan_take(ch)
        if v != 0
            chan_unlock(ch)
            race_acquire(ch)
            return v
        left := end - time_mono_ms()
        # A deterministic run has no clock: only a wait of no time is up at once.
        up := if det_on() then ms <= 0 else left <= 0
        if load64(ch + C_CLOSED) != 0 or task_cancelled() or up
            chan_unlock(ch)
            return 0
        if det_on() and load64(ch + C_SOURCE) == 0
            if chan_sleep(ch, C_RLINE, "a value from a channel")
                # Nothing else can run: the time is up, and no deadlock is reported.
                chan_fault()
                chan_unlock(ch)
                return 0
        elif load64(ch + C_SOURCE) != 0
            chan_unlock(ch)
            chan_pump_ms(ch, left)
            lock(ch + C_LOCK)
        else
            w := chan_line_add(ch, C_RLINE)
            task_block_on(ch)
            chan_unlock(ch)
            k := worker_index()
            if k >= 0
                wait_enter()
            futex_wait_timed(w, 0, left)
            if k >= 0
                wait_leave()
            task_block_on(0)
            lock(ch + C_LOCK)
            chan_line_drop(ch, C_RLINE, w)
    0

## `ch.close()`: 0, or the message of the trap when it was closed already.
fn chan_close(ch int) int
    if load64(ch + C_SOURCE) != 0
        chan_source_close(ch)
        return 0
    lock(ch + C_LOCK)
    if load64(ch + C_CLOSED) != 0
        chan_unlock(ch)
        return chan_msg("channel `", ch, "` is already closed")
    store64(ch + C_CLOSED, 1)
    chan_wake_all(ch)
    chan_unlock(ch)
    0

fn chan_slot(arr int, k int, ch int)
    store64(arr + 8 * k, ch)

## `task.select`: the index of the first of the `n` channels at `chans` that
## has a value waiting, as an `int?` (none when all are closed and empty).
fn chan_select(chans int, n int) int
    i := chan_select_index(chans, n)
    if i < 0
        return 0
    box(i)

fn chan_select_index(chans int, n int) int
    while true
        e := atomic_load(global(CHAN_EPOCH))
        mut open := 0
        mut feeder := 0
        for i in 0..n
            ch := load64(chans + 8 * i)
            lock(ch + C_LOCK)
            ready := load64(ch + C_COUNT) > 0
            closed := load64(ch + C_CLOSED) != 0
            src := load64(ch + C_SOURCE)
            chan_unlock(ch)
            if ready
                return i
            if not closed
                open += 1
                if src != 0 and feeder == 0
                    feeder = ch
        if open == 0
            return -1
        if feeder != 0
            chan_pump(feeder)
        else
            atomic_add(global(CHAN_SEL), 1)
            k := worker_index()
            if k >= 0
                wait_enter()
            dead := prog_wait(
                global(CHAN_EPOCH),
                e.bit_and(4294967295),
                "a value from one of several channels",
                true,
            )
            if k >= 0
                wait_leave()
            atomic_add(global(CHAN_SEL), -1)
            if dead
                return -1
    -1
