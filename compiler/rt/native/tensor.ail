## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `tensor.Tensor[T]` (ADR 0815, std.tensor.1-21). A tensor is an object of
## kind 4 (every word is scanned) with the layout
##
##   +0 element kind (0 int, 1 float, 2 f32: a float holding a value rounded
##      to f32, as the interpreter's packed 4-byte elements read back)  +8 rank  +16 element count
##   +24 pointer to the elements (kind 11: no pointers): 8 bytes each, or 4 bytes
##       (singles) when the element kind is 2 (ADR 0875)
##   +32 the sizes of the axes, one word each
##
## Tensors are never changed after they are built, so copying one shares it.
## The elements are in row-major order, as in the interpreter.

TENSOR_OBJ := 4

## Bytes per element: a `Tensor[f32]` packs four-byte singles (ADR 0875), the
## other kinds take a word.
fn esz(kind int) int
    if kind == 2
        return 4
    8

## A tensor of `rank` axes and `n` elements, zeroed; the sizes are the
## caller's to store.
fn tensor_new(kind int, rank int, n int) int
    t := alloc(32 + 8 * rank, TENSOR_OBJ)
    store64(t, kind)
    store64(t + 8, rank)
    store64(t + 16, n)
    store64(t + 24, alloc(esz(kind) * n + 8, KIND_ATOMIC))
    t

## `tensor_new` for a kernel that writes `float`s a word each, also for `f32`:
## `tensor_pack` narrows the result when it is done.
fn tensor_new_w(kind int, rank int, n int) int
    t := alloc(32 + 8 * rank, TENSOR_OBJ)
    store64(t, kind)
    store64(t + 8, rank)
    store64(t + 16, n)
    store64(t + 24, alloc(8 * n + 8, KIND_ATOMIC))
    t

## A tensor made by `tensor_new_w` with its elements packed: an `f32` one
## narrows its words in place (each is an `f32` value already), the rest
## are as they are.
fn tensor_pack(t int) int
    if load64(t) == 2
        d := tensor_data(t)
        vec_narrow(d, d, load64(t + 16))
    t

fn tensor_data(t int) int
    load64(t + 24)

## The elements a word each: the data itself, or for an `f32` tensor a widened
## copy (the kernels that read `float`s a word each take their input so).
fn tdata_w(t int) int
    d := tensor_data(t)
    if load64(t) != 2
        return d
    n := load64(t + 16)
    w := alloc(8 * n + 8, KIND_ATOMIC)
    vec_widen(w, d, n)
    w

## `[a, b, c]` of the words at `p`, as `Debug` prints a list of sizes.
fn put_sizes(p int, n int)
    sb_byte(91)
    for i in 0..n
        if i > 0
            sb_text(", ")
        put_int(load64(p + 8 * i))
    sb_byte(93)

fn tensor_copy_words(dst int, src int, n int)
    for i in 0..n
        store64(dst + 8 * i, load64(src + 8 * i))

## `tensor.from(xs)`: a 1-D tensor of the elements of `xs` (std.tensor.2).
fn tensor_from(xs List[int], kind int) int
    q := list_addr(xs)
    n := load64(q)
    t := tensor_new_w(kind, 1, n)
    store64(t + 32, n)
    tensor_copy_words(tensor_data(t), load64(q + 16), n)
    tensor_pack(t)

## The message of `tensor.from(xs, shape)` failing (std.tensor.2), a string
## object, or 0 when `shape` is fine for `xs`.
fn tensor_shape_fault(xs List[int], shape List[int]) int
    shape_fault_n(load64(list_addr(xs)), shape)

## `tensor_shape_fault` for `n` elements.
fn shape_fault_n(n int, shape List[int]) int
    sp := list_addr(shape)
    rank := load64(sp)
    d := load64(sp + 16)
    mut count := 1
    for i in 0..rank
        s := load64(d + 8 * i)
        if s < 0
            sb_reset()
            sb_text("a tensor's sizes can't be negative, and the shape is ")
            put_sizes(d, rank)
            return str_addr(sb_str())
        if s != 0 and count > 1099511627776 / s
            sb_reset()
            sb_text("the shape ")
            put_sizes(d, rank)
            sb_text(" has too many elements")
            return str_addr(sb_str())
        count = count * s
    if n != count
        sb_reset()
        put_int(n)
        sb_text(" elements don't fill the shape ")
        put_sizes(d, rank)
        sb_text(", which holds ")
        put_int(count)
        return str_addr(sb_str())
    0

## The message of `tensor.zeros(shape)` failing (std.tensor.2), or 0.
fn tensor_zeros_fault(shape List[int]) int
    sp := list_addr(shape)
    rank := load64(sp)
    d := load64(sp + 16)
    mut count := 1
    for i in 0..rank
        s := load64(d + 8 * i)
        if s < 0
            sb_reset()
            sb_text("a tensor's sizes can't be negative, and the shape is ")
            put_sizes(d, rank)
            return str_addr(sb_str())
        if s != 0 and count > 1099511627776 / s
            sb_reset()
            sb_text("the shape ")
            put_sizes(d, rank)
            sb_text(" has too many elements")
            return str_addr(sb_str())
        count = count * s
    0

## `tensor.zeros(shape)` of `kind` (0 int, 1 float) once `tensor_zeros_fault`
## found nothing wrong: the data is fresh memory, which is zero words.
fn tensor_zeros(shape List[int], kind int) int
    sp := list_addr(shape)
    rank := load64(sp)
    d := load64(sp + 16)
    mut count := 1
    for i in 0..rank
        count = count * load64(d + 8 * i)
    t := tensor_new_w(kind, rank, count)
    tensor_copy_words(t + 32, d, rank)
    for i in 0..count
        store64(tensor_data(t) + 8 * i, 0)
    tensor_pack(t)

## `tensor.from(xs, shape)` once `tensor_shape_fault` found nothing wrong.
fn tensor_from_shape(xs List[int], kind int, shape List[int]) int
    q := list_addr(xs)
    sp := list_addr(shape)
    rank := load64(sp)
    n := load64(q)
    t := tensor_new_w(kind, rank, n)
    tensor_copy_words(t + 32, load64(sp + 16), rank)
    tensor_copy_words(tensor_data(t), load64(q + 16), n)
    tensor_pack(t)

## `t.to_list()`: the elements as a list (the words are the same for `int`
## and `float`).
fn tensor_to_list(t int) List[int]
    n := load64(t + 16)
    xs := list_alloc(n, 8)
    q := list_addr(xs)
    store64(q, n)
    tensor_copy_words(load64(q + 16), tdata_w(t), n)
    xs

## `t.shape()`: the sizes of the axes.
fn tensor_shape(t int) List[int]
    rank := load64(t + 8)
    xs := list_alloc(rank, 8)
    q := list_addr(xs)
    store64(q, rank)
    tensor_copy_words(load64(q + 16), t + 32, rank)
    xs

## `a == b` (std.tensor.9): the same shape and equal elements, `float`
## elements compared as `==` does (NaN is unequal to itself).
fn tensor_eq(a int, b int) bool
    rank := load64(a + 8)
    n := load64(a + 16)
    if load64(b + 8) != rank or load64(b + 16) != n or load64(b) != load64(a)
        return false
    for i in 0..rank
        if load64(a + 32 + 8 * i) != load64(b + 32 + 8 * i)
            return false
    da := tdata_w(a)
    db := tdata_w(b)
    if load64(a) >= 1
        for i in 0..n
            if loadf(da + 8 * i) != loadf(db + 8 * i)
                return false
        return true
    for i in 0..n
        if load64(da + 8 * i) != load64(db + 8 * i)
            return false
    true

## The text of `t` (std.tensor.9): the call that rebuilds it.
fn tensor_text(t int) str
    n := load64(t + 16)
    rank := load64(t + 8)
    sb_reset()
    sb_text("tensor.from([")
    d := tdata_w(t)
    for i in 0..n
        if i > 0
            sb_text(", ")
        if load64(t) == 1
            put_float(loadf(d + 8 * i))
        elif load64(t) == 2
            put_float32(loadf(d + 8 * i))
        else
            put_int(load64(d + 8 * i))
    sb_byte(93)
    if rank != 1
        sb_text(", ")
        put_sizes(t + 32, rank)
    sb_byte(41)
    if load64(t) == 2
        sb_text(".to_f32()")
    sb_str()

fn out_tensor(t int)
    out_str(tensor_text(t))

# ---- vector kernels ----
#
# The backend replaces these three with assembled vector loops on targets that
# have them (compiler/x64/kernels.ail); the bodies are the scalar definitions
# and the reference. `r` non-zero rounds every result to `f32`.

## `c[i] = c[i] + x * b[i]` for `i < n`; the product and the sum each rounded.
fn vec_axpy(c int, b int, n int, r int, x float)
    for i in 0..n
        mut q := x * loadf(b + 8 * i)
        if r != 0
            q = f32_round(q)
        mut s := loadf(c + 8 * i) + q
        if r != 0
            s = f32_round(s)
        storef(c + 8 * i, s)

## One row of a matrix product (std.tensor.7): `c[j]` is the sum over `p < k`,
## in order from 0.0, of `a[p] * b[p * n + j]`, each product and sum rounded
## (`r` non-zero: to `f32`). ARM64 assembles it (`compiler/a64/kernels.ail`);
## elsewhere this is `k` calls of `vec_axpy` on a zeroed row.
fn vec_mm(c int, a int, b int, n int, k int, r int)
    for j in 0..n
        storef(c + 8 * j, 0.0)
    for p in 0..k
        vec_axpy(c, b + 8 * p * n, n, r, loadf(a + 8 * p))

## `out[i] = a[i] op b[i]` for `i < n` (`op` 0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn vec_zip(op int, out int, a int, b int, n int, r int)
    for i in 0..n
        mut y := float_op(op, loadf(a + 8 * i), loadf(b + 8 * i))
        if r != 0
            y = f32_round(y)
        storef(out + 8 * i, y)

# ---- packed `f32` kernels (ADR 0875) ----
#
# The same operations on four-byte singles. A `float` operation on two singles
# rounded once to `f32` is the single-precision operation (a double holds a
# product, sum, difference or quotient of two singles exactly enough that
# rounding twice equals rounding once), so these are bit for bit the `r` forms
# above. The backend replaces them with assembled loops where it has them.

## `out[i] = a[i]` widened to a double, for `i < n` (singles to words).
fn vec_widen(out int, a int, n int)
    for i in 0..n
        storef(out + 8 * i, loadf32(a + 4 * i))

## `out[i] = a[i]` narrowed to a single, for `i < n` (words to singles; `a`
## holds values of `f32` already, or they are rounded here).
fn vec_narrow(out int, a int, n int)
    for i in 0..n
        storef32(out + 4 * i, loadf(a + 8 * i))

## `out[i] = a[i] op b[i]` for `i < n`.
fn vec_zip32(op int, out int, a int, b int, n int)
    for i in 0..n
        storef32(out + 4 * i, float_op(op, loadf32(a + 4 * i), loadf32(b + 4 * i)))

## `out[i] = a[i] op s`, or `s op a[i]` when `left` is 1 (`s` is an `f32` value).
fn vec_scal32(op int, out int, a int, n int, left int, s float)
    for i in 0..n
        x := loadf32(a + 4 * i)
        if left == 1
            storef32(out + 4 * i, float_op(op, s, x))
        else
            storef32(out + 4 * i, float_op(op, x, s))

## `c[i] = c[i] + x * b[i]` for `i < n`; the product and the sum each rounded.
fn vec_axpy32(c int, b int, n int, x float)
    for i in 0..n
        q := f32_round(x * loadf32(b + 4 * i))
        storef32(c + 4 * i, loadf32(c + 4 * i) + q)

## One row of an `f32` matrix product: `c[j]` is the sum over `p < k`, in order
## from 0.0, of `a[p] * b[p * n + j]`, each product and sum rounded.
fn vec_mm32(c int, a int, b int, n int, k int)
    for j in 0..n
        storef32(c + 4 * j, 0.0)
    for p in 0..k
        vec_axpy32(c, b + 4 * p * n, n, loadf32(a + 4 * p))

## `out[i] = a[i] op s`, or `s op a[i]` when `left` is 1.
fn vec_scal(op int, out int, a int, n int, r int, left int, s float)
    for i in 0..n
        x := loadf(a + 8 * i)
        mut y := 0.0
        if left == 1
            y = float_op(op, s, x)
        else
            y = float_op(op, x, s)
        if r != 0
            y = f32_round(y)
        storef(out + 8 * i, y)

# ---- step 2: elementwise operators, reductions, transpose ----

# Operators (std.tensor.4): 0 `+` (add), 1 `-`, 2 `*` (mul), 3 `/`.

fn int_min() int
    1.shl(63)

## `x op y` on `int` without overflow, into `box` (one word); false on overflow.
fn int_op(op int, x int, y int, box int) bool
    r := 0
    if op == 0
        r = x + y
        if x.bit_xor(r).bit_and(y.bit_xor(r)) < 0
            return false
    elif op == 1
        r = x - y
        if x.bit_xor(y).bit_and(x.bit_xor(r)) < 0
            return false
    else
        r = x * y
        if x == -1
            if y == int_min()
                return false
        elif x != 0
            if r / x != y
                return false
    store64(box, r)
    true

## `x` as an element of a tensor of `kind`: rounded to `f32` for kind 2.
fn elem_round(kind int, x float) float
    if kind == 2
        return f32_round(x)
    x

fn float_op(op int, x float, y float) float
    if op == 0
        return x + y
    if op == 1
        return x - y
    if op == 2
        return x * y
    x / y

## The name an operator has in a fault message (the interpreter's `Op::name`).
fn op_name(op int) str
    if op == 0
        return "add"
    if op == 1
        return "-"
    if op == 2
        return "mul"
    "/"

fn same_shape(a int, b int) bool
    rank := load64(a + 8)
    if load64(b + 8) != rank
        return false
    for i in 0..rank
        if load64(a + 32 + 8 * i) != load64(b + 32 + 8 * i)
            return false
    true

## The size of axis `k` of the broadcast of `a` and `b` of `rank` axes, lined up
## from the right, or -1 when they don't fit.
fn bsize(t int, k int, rank int) int
    r := load64(t + 8)
    if k + r >= rank
        return load64(t + 32 + 8 * (k + r - rank))
    1

fn bdim(a int, b int, k int, rank int) int
    x := bsize(a, k, rank)
    y := bsize(b, k, rank)
    if x == y or y == 1
        return x
    if x == 1
        return y
    -1

fn bmax_rank(a int, b int) int
    ra := load64(a + 8)
    rb := load64(b + 8)
    if ra > rb then ra else rb

## The message for `a op b` whose shapes don't broadcast (std.tensor.4), or 0.
## `what` is the operator's name, or "dot" (which needs equal shapes).
fn tensor_zip_fault(a int, b int, op int) int
    if same_shape(a, b)
        return 0
    rank := bmax_rank(a, b)
    mut ok := true
    for k in 0..rank
        if bdim(a, b, k, rank) < 0
            ok = false
    if ok
        return 0
    sb_reset()
    sb_byte(96)
    sb_text(op_name(op))
    sb_text("` can't broadcast shapes ")
    put_sizes(a + 32, load64(a + 8))
    sb_text(" and ")
    put_sizes(b + 32, load64(b + 8))
    str_addr(sb_str())

## `a.dot(b)` needs equal shapes: the message, or 0.
fn tensor_dot_fault(a int, b int) int
    if same_shape(a, b)
        return 0
    sb_reset()
    sb_text("`dot` needs equal shapes, but they are ")
    put_sizes(a + 32, load64(a + 8))
    sb_text(" and ")
    put_sizes(b + 32, load64(b + 8))
    str_addr(sb_str())

## The elements of `t` stretched to the shape `dims` of `rank` axes and `n`
## elements (std.tensor.4), as a new block of words.
fn tensor_expand(t int, dims int, rank int, n int) int
    kind := load64(t)
    out := alloc(esz(kind) * n + 8, KIND_ATOMIC)
    stride := alloc(8 * rank + 8, KIND_ATOMIC)
    idx := alloc(8 * rank + 8, KIND_ATOMIC)
    src := tensor_data(t)
    mut s := 1
    mut k := rank - 1
    while k >= 0
        d := bsize(t, k, rank)
        store64(stride + 8 * k, if d == 1 then 0 else s)
        s = s * d
        k -= 1
    mut off := 0
    for i in 0..n
        if kind == 2
            storef32(out + 4 * i, loadf32(src + 4 * off))
        else
            store64(out + 8 * i, load64(src + 8 * off))
        mut j := rank - 1
        while j >= 0
            c := load64(idx + 8 * j) + 1
            store64(idx + 8 * j, c)
            off += load64(stride + 8 * j)
            if c < load64(dims + 8 * j)
                break
            off -= load64(stride + 8 * j) * c
            store64(idx + 8 * j, 0)
            j -= 1
    out

fn tensor_count(dims int, rank int) int
    mut n := 1
    for i in 0..rank
        n = n * load64(dims + 8 * i)
    n

## `a op b` elementwise with broadcasting (std.tensor.4, std.tensor.10); 0 when
## an `int` result overflows (std.tensor.6). The shapes were checked.
fn tensor_zip(a int, b int, op int) int
    kind := load64(a)
    mut da := tensor_data(a)
    mut db := tensor_data(b)
    mut rank := load64(a + 8)
    mut n := load64(a + 16)
    mut dims := a + 32
    if not same_shape(a, b)
        rank = bmax_rank(a, b)
        dims = alloc(8 * rank + 8, KIND_ATOMIC)
        for k in 0..rank
            store64(dims + 8 * k, bdim(a, b, k, rank))
        n = tensor_count(dims, rank)
        da = tensor_expand(a, dims, rank, n)
        db = tensor_expand(b, dims, rank, n)
    t := tensor_new(kind, rank, n)
    tensor_copy_words(t + 32, dims, rank)
    out := tensor_data(t)
    if kind >= 1
        if n >= 262144
            env := tensor_env()
            store64(env, 1)
            store64(env + 8, kind)
            store64(env + 16, out)
            store64(env + 24, da)
            store64(env + 32, db)
            store64(env + 40, op)
            if tensor_par(env, 0, n, n)
                return t
        if kind == 2
            vec_zip32(op, out, da, db, n)
        else
            vec_zip(op, out, da, db, n, 0)
        return t
    for i in 0..n
        if not int_op(op, load64(da + 8 * i), load64(db + 8 * i), out + 8 * i)
            return 0
    t

## `t op s`, or `s op t` when `left` (std.tensor.10), for a `float` scalar.
fn tensor_scalar_f(a int, s float, op int, left bool) int
    kind := load64(a)
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new(kind, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    da := tensor_data(a)
    out := tensor_data(t)
    lf := if left then 1 else 0
    sv := if kind == 2 then f32_round(s) else s
    if n >= 262144
        env := tensor_env()
        store64(env, 2)
        store64(env + 8, kind)
        store64(env + 16, out)
        store64(env + 24, da)
        store64(env + 40, op)
        store64(env + 48, lf)
        storef(env + 56, sv)
        if tensor_par(env, 0, n, n)
            return t
    if kind == 2
        vec_scal32(op, out, da, n, lf, sv)
        return t
    vec_scal(op, out, da, n, 0, lf, sv)
    t

## The same for an `int` scalar; 0 on overflow.
fn tensor_scalar_i(a int, s int, op int, left bool) int
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new(0, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    da := tensor_data(a)
    out := tensor_data(t)
    for i in 0..n
        x := load64(da + 8 * i)
        ok := if left then int_op(op, s, x, out + 8 * i) else int_op(op, x, s, out + 8 * i)
        if not ok
            return 0
    t

## `-t` (std.tensor.14); 0 when an `int` element is the smallest `int`.
fn tensor_neg(a int) int
    kind := load64(a)
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new(kind, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    da := tensor_data(a)
    out := tensor_data(t)
    for i in 0..n
        if kind == 2
            storef32(out + 4 * i, -loadf32(da + 4 * i))
        elif kind == 1
            storef(out + 8 * i, -loadf(da + 8 * i))
        else
            x := load64(da + 8 * i)
            if x == int_min()
                return 0
            store64(out + 8 * i, 0 - x)
    t

## The sum of the products or elements `p`, `stride` words apart, `n` of them,
## in std.tensor.5's order: element `i` goes to partial sum `i % 16` for the
## first `16 * (n / 16)`, the partial sums halve, and the tail goes to `s[0]`.
## With `q` non-zero the elements are the products of `p` and `q`.
fn sum16(p int, q int, n int, stride int, s int) float
    body := n / 16 * 16
    if stride == 1 and body > 0
        vec_sum16(p, q, body, s)
        return sum16_tail(s, p, q, body, n)
    sum16_ref(p, q, n, stride, s)

## The plain definition of `sum16`.
fn sum16_ref(p int, q int, n int, stride int, s int) float
    for l in 0..16
        storef(s + 8 * l, 0.0)
    body := n / 16 * 16
    for i in 0..body
        x := loadf(p + 8 * stride * i)
        if q != 0
            x = x * loadf(q + 8 * stride * i)
        l := i % 16
        storef(s + 8 * l, loadf(s + 8 * l) + x)
    mut h := 8
    while h > 0
        for l in 0..h
            storef(s + 8 * l, loadf(s + 8 * l) + loadf(s + 8 * (l + h)))
        h = h / 2
    mut acc := loadf(s)
    for i in body..n
        x := loadf(p + 8 * stride * i)
        if q != 0
            x = x * loadf(q + 8 * stride * i)
        acc = acc + x
    acc

## The sum of the first `n` (a multiple of 16) elements `p`, or products with
## `q` (all doubles), as the four sums `s[0..3]` left after the halvings of 8
## and 4 (an assembled kernel on targets that have one). `vec_sum16_32` is the
## same over singles with no `q`.
fn vec_sum16(p int, q int, n int, s int)
    for l in 0..16
        storef(s + 8 * l, 0.0)
    for i in 0..n
        x := loadf(p + 8 * i)
        if q != 0
            x = x * loadf(q + 8 * i)
        l := i % 16
        storef(s + 8 * l, loadf(s + 8 * l) + x)
    for l in 0..8
        storef(s + 8 * l, loadf(s + 8 * l) + loadf(s + 8 * (l + 8)))
    for l in 0..4
        storef(s + 8 * l, loadf(s + 8 * l) + loadf(s + 8 * (l + 4)))

fn vec_sum16_32(p int, n int, s int)
    for l in 0..16
        storef(s + 8 * l, 0.0)
    for i in 0..n
        l := i % 16
        storef(s + 8 * l, loadf(s + 8 * l) + loadf32(p + 4 * i))
    for l in 0..8
        storef(s + 8 * l, loadf(s + 8 * l) + loadf(s + 8 * (l + 8)))
    for l in 0..4
        storef(s + 8 * l, loadf(s + 8 * l) + loadf(s + 8 * (l + 4)))

## From `s[0..3]` (four sums left by `vec_sum16`): the halvings of 2 and 1, then
## the elements `body..n` of `p` (or products with `q`) added in order.
fn sum16_tail(s int, p int, q int, body int, n int) float
    storef(s, loadf(s) + loadf(s + 16))
    storef(s + 8, loadf(s + 8) + loadf(s + 24))
    mut acc := loadf(s) + loadf(s + 8)
    for i in body..n
        x := loadf(p + 8 * i)
        if q != 0
            x = x * loadf(q + 8 * i)
        acc = acc + x
    acc

## `sum16` over the `n` singles at `p`.
fn sum16_32(p int, n int, s int) float
    body := n / 16 * 16
    if body == 0
        mut acc := 0.0
        for i in 0..n
            acc = acc + loadf32(p + 4 * i)
        return acc
    vec_sum16_32(p, body, s)
    storef(s, loadf(s) + loadf(s + 16))
    storef(s + 8, loadf(s + 8) + loadf(s + 24))
    mut acc := loadf(s) + loadf(s + 8)
    for i in body..n
        acc = acc + loadf32(p + 4 * i)
    acc

## `t.sum()` of a `float` tensor (std.tensor.5).
fn tensor_sum_f(a int) float
    if load64(a) == 2
        return sum16_32(tensor_data(a), load64(a + 16), alloc(128, KIND_ATOMIC))
    sum16(tensor_data(a), 0, load64(a + 16), 1, alloc(128, KIND_ATOMIC))

## `a.dot(b)` of `float` tensors of one shape (std.tensor.5).
fn tensor_dot_f(a int, b int) float
    sum16(tdata_w(a), tdata_w(b), load64(a + 16), 1, alloc(128, KIND_ATOMIC))

## A 1-element `int` tensor holding `v`, as `sum` and `dot` of `int` tensors
## return it; 0 stands for an overflow.
fn tensor_one_i(v int) int
    t := tensor_new(0, 0, 1)
    store64(tensor_data(t), v)
    t

fn tensor_sum_i(a int) int
    n := load64(a + 16)
    d := tensor_data(a)
    s := alloc(8, KIND_ATOMIC)
    store64(s, 0)
    for i in 0..n
        if not int_op(0, load64(s), load64(d + 8 * i), s)
            return 0
    tensor_one_i(load64(s))

fn tensor_dot_i(a int, b int) int
    n := load64(a + 16)
    da := tensor_data(a)
    db := tensor_data(b)
    s := alloc(16, KIND_ATOMIC)
    store64(s, 0)
    for i in 0..n
        if not int_op(2, load64(da + 8 * i), load64(db + 8 * i), s + 8)
            return 0
        if not int_op(0, load64(s), load64(s + 8), s)
            return 0
    tensor_one_i(load64(s))

## `t.transpose()` of a 2-D tensor (std.tensor.12): the message, or 0.
fn tensor_transpose_fault(a int) int
    if load64(a + 8) == 2
        return 0
    sb_reset()
    sb_text("`transpose` needs a 2-D tensor, but the shape is ")
    put_sizes(a + 32, load64(a + 8))
    str_addr(sb_str())

fn tensor_transpose(a int) int
    m := load64(a + 32)
    n := load64(a + 40)
    t := tensor_new(load64(a), 2, m * n)
    store64(t + 32, n)
    store64(t + 40, m)
    da := tensor_data(a)
    out := tensor_data(t)
    if load64(a) == 2
        for i in 0..m
            for j in 0..n
                storef32(out + 4 * (j * m + i), loadf32(da + 4 * (i * n + j)))
        return t
    for i in 0..m
        for j in 0..n
            store64(out + 8 * (j * m + i), load64(da + 8 * (i * n + j)))
    t

## `a.matmul(b)` (std.tensor.7) needs two 2-D tensors with equal inner sizes:
## the message, or 0.
fn tensor_matmul_fault(a int, b int) int
    if load64(a + 8) != 2 or load64(b + 8) != 2
        sb_reset()
        sb_text("`matmul` needs two 2-D tensors, but the shapes are ")
        put_sizes(a + 32, load64(a + 8))
        sb_text(" and ")
        put_sizes(b + 32, load64(b + 8))
        return str_addr(sb_str())
    k := load64(a + 40)
    k2 := load64(b + 32)
    if k == k2
        return 0
    sb_reset()
    sb_text("`matmul` of ")
    put_int(load64(a + 32))
    sb_text("x")
    put_int(k)
    sb_text(" and ")
    put_int(k2)
    sb_text("x")
    put_int(load64(b + 40))
    sb_text(": the inner sizes ")
    put_int(k)
    sb_text(" and ")
    put_int(k2)
    sb_text(" differ")
    str_addr(sb_str())

## The plain triple loop of std.tensor.7: element `(i, j)` adds `a(i, p) * b(p, j)`
## for `p` in order from zero, each product and sum rounded (no fused
## multiply-add). 0 when an `int` product or sum overflows (std.tensor.6).
fn tensor_matmul(a int, b int) int
    m := load64(a + 32)
    k := load64(a + 40)
    n := load64(b + 40)
    kind := load64(a)
    t := tensor_new(kind, 2, m * n)
    store64(t + 32, m)
    store64(t + 40, n)
    da := tensor_data(a)
    db := tensor_data(b)
    out := tensor_data(t)
    if kind >= 1
        if m * n * k >= 262144 and m > 1
            env := tensor_env()
            store64(env, 0)
            store64(env + 8, kind)
            store64(env + 16, out)
            store64(env + 24, da)
            store64(env + 32, db)
            store64(env + 40, n)
            store64(env + 48, k)
            if tensor_par(env, 0, m, m * n * k)
                return t
        for i in 0..m
            if kind == 2
                vec_mm32(out + 4 * i * n, da + 4 * i * k, db, n, k)
            else
                vec_mm(out + 8 * i * n, da + 8 * i * k, db, n, k, 0)
        return t
    box := alloc(8, KIND_ATOMIC)
    for i in 0..m
        for p in 0..k
            x := load64(da + 8 * (i * k + p))
            for j in 0..n
                c := out + 8 * (i * n + j)
                if not int_op(2, x, load64(db + 8 * (p * n + j)), box)
                    return 0
                if not int_op(0, load64(c), load64(box), c)
                    return 0
    t

# Activations (std.tensor.13): kind 0 `relu`, 1 `sigmoid`, 2 `tanh`.

## `relu` keeps a positive element and makes the rest `0.0`, but a NaN stays
## NaN; `sigmoid` is `1 / (1 + exp(-x))`; `tanh` is fdlibm's.
fn tensor_activate(a int, kind int) int
    ek := load64(a)
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new_w(ek, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    da := tdata_w(a)
    out := tensor_data(t)
    r := ek == 2
    if kind == 1
        for i in 0..n
            y := 1.0 / (1.0 + float_exp(0.0 - loadf(da + 8 * i)))
            storef(out + 8 * i, if r then f32_round(y) else y)
        return tensor_pack(t)
    for i in 0..n
        x := loadf(da + 8 * i)
        mut y := 0.0
        if kind == 0
            if x != x
                y = x
            elif x > 0.0
                y = x
        else
            y = float_tanh(x)
        storef(out + 8 * i, if r then f32_round(y) else y)
    tensor_pack(t)

## The message of the fault `softmax` raises (std.tensor.24), or 0.
fn tensor_softmax_fault(a int) int
    if load64(a + 8) == 0
        sb_reset()
        sb_text("`softmax` needs a tensor with at least one axis")
        return str_addr(sb_str())
    if load64(a + 32 + 8 * (load64(a + 8) - 1)) == 0
        sb_reset()
        sb_text("`softmax` over an empty last axis")
        return str_addr(sb_str())
    0

## `t.softmax()` (std.tensor.24): per row of the last axis, `exp(x - top)`
## (top: the largest element, a NaN skipped) over their sum in element order,
## computed in `float` and rounded once for `f32`.
fn tensor_softmax(a int) int
    ek := load64(a)
    n := load64(a + 16)
    rank := load64(a + 8)
    w := load64(a + 32 + 8 * (rank - 1))
    t := tensor_new_w(ek, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    da := tdata_w(a)
    out := tensor_data(t)
    rows := if w == 0 then 0 else n / w
    if n >= 65536 and rows > 1
        env := tensor_env()
        store64(env, 4)
        store64(env + 8, ek)
        store64(env + 16, out)
        store64(env + 24, da)
        store64(env + 40, w)
        if tensor_par(env, 0, rows, 1048576)
            return tensor_pack(t)
    softmax_rows(ek, da, out, w, 0, rows)
    tensor_pack(t)

## `out[i] = exp(a[i])` for the leading `i` where every argument has `|x| < 700`,
## in quads (an AVX2 kernel on x86-64; the NEON pair kernel was slower than
## scalar `float_exp` on the Mac, so ARM64 runs this body); how many it did.
## `out` may be `a`.
fn vec_exp(out int, a int, n int) int
    for i in 0..n
        storef(out + 8 * i, float_exp(loadf(a + 8 * i)))
    n

## `exp` of the `n` doubles at `p`, in place: the kernel where it can, and
## `float_exp` for the rest.
fn exp_in_place(p int, n int)
    mut i := 0
    while i < n
        i += vec_exp(p + 8 * i, p + 8 * i, n - i)
        if i < n
            m := if n - i < 4 then n - i else 4
            for k in 0..m
                storef(p + 8 * (i + k), float_exp(loadf(p + 8 * (i + k))))
            i += m

## Rows `lo..hi` of `w` words each of a softmax (std.tensor.13): `exp(x - top)`
## summed in order, then each divided by the sum.
fn softmax_rows(ek int, da int, out int, w int, lo int, hi int)
    r := if ek == 2 then 1 else 0
    for row in lo..hi
        base := row * w
        mut top := 0.0 - fm_inf()
        for j in 0..w
            x := loadf(da + 8 * (base + j))
            if x > top
                top = x
        vec_scal(1, out + 8 * base, da + 8 * base, w, 0, 0, top)
        exp_in_place(out + 8 * base, w)
        mut total := 0.0
        for j in 0..w
            total += loadf(out + 8 * (base + j))
        vec_scal(3, out + 8 * base, out + 8 * base, w, r, 0, total)

## `t.to_f32()` (std.tensor.22): each element rounded to `f32`.
fn tensor_to_f32(a int) int
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new(2, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    vec_narrow(tensor_data(t), tensor_data(a), n)
    t

## `t.to_float()` on a `Tensor[f32]`: the elements, widened exactly.
fn tensor_to_float(a int) int
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new(1, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    vec_widen(tensor_data(t), tensor_data(a), n)
    t

# Reductions (std.tensor.11): kind 0 `sum`, 1 `max`, 2 `mean`.

fn reduce_name(kind int) str
    if kind == 0
        return "sum"
    if kind == 1
        return "max"
    if kind == 3
        return "argmax"
    if kind == 4
        return "argmin"
    if kind == 5
        return "top2"
    "mean"

## The faults of `t.sum(axis)`, `max` and `mean` (std.tensor.11): an axis out
## of range, or `max` and `mean` of an empty axis; `has` is 0 for no axis.
fn tensor_reduce_fault(a int, kind int, axis int, has int) int
    rank := load64(a + 8)
    mut before := 1
    mut n := load64(a + 16)
    mut after := 1
    if has != 0
        if axis < 0 or axis >= rank
            sb_reset()
            sb_byte(96)
            sb_text(reduce_name(kind))
            sb_byte(40)
            put_int(axis)
            sb_text(")` on a tensor of shape ")
            put_sizes(a + 32, rank)
            sb_text(": the axis must be from 0 to ")
            put_int(rank - 1)
            return str_addr(sb_str())
        n = load64(a + 32 + 8 * axis)
        for i in 0..axis
            before = before * load64(a + 32 + 8 * i)
        for i in axis + 1..rank
            after = after * load64(a + 32 + 8 * i)
    if n == 0 and kind != 0 and kind < 3 and before * after > 0
        sb_reset()
        sb_byte(96)
        sb_text(reduce_name(kind))
        sb_text("` of an empty axis of a tensor of shape ")
        put_sizes(a + 32, rank)
        return str_addr(sb_str())
    0

## `t.sum(axis)`, `t.max(axis)` or `t.mean(axis)`, or over every element with no
## axis (a tensor of shape `[]`); 0 when an `int` sum overflows. Faults were checked.
fn tensor_reduce(a int, kind int, axis int, has int) int
    rank := load64(a + 8)
    ek := load64(a)
    mut before := 1
    mut n := load64(a + 16)
    mut after := 1
    mut out_rank := 0
    if has != 0
        n = load64(a + 32 + 8 * axis)
        for i in 0..axis
            before = before * load64(a + 32 + 8 * i)
        for i in axis + 1..rank
            after = after * load64(a + 32 + 8 * i)
        out_rank = rank - 1
    t := tensor_new_w(ek, out_rank, before * after)
    if has != 0
        mut at := 0
        for i in 0..rank
            if i != axis
                store64(t + 32 + 8 * at, load64(a + 32 + 8 * i))
                at += 1
    da := tdata_w(a)
    out := tensor_data(t)
    s := alloc(128, KIND_ATOMIC)
    for b in 0..before
        for c in 0..after
            base := da + 8 * (b * n * after + c)
            r := out + 8 * (b * after + c)
            if ek >= 1
                if kind == 1
                    mut best := loadf(base)
                    for k in 1..n
                        x := loadf(base + 8 * k * after)
                        if x > best
                            best = x
                    storef(r, best)
                else
                    v := sum16(base, 0, n, after, s)
                    w := if kind == 2 then v / n.to_float() else v
                    storef(r, if ek == 2 then f32_round(w) else w)
            elif kind == 1
                mut best := load64(base)
                for k in 1..n
                    x := load64(base + 8 * k * after)
                    if x > best
                        best = x
                store64(r, best)
            else
                store64(r, 0)
                for k in 0..n
                    if not int_op(0, load64(r), load64(base + 8 * k * after), r)
                        return 0
    tensor_pack(t)

## The first element of a 1-element tensor, as `int` and as `float`.
fn tensor_first_i(t int) int
    load64(tensor_data(t))

fn tensor_first_f(t int) float
    if load64(t) == 2
        return loadf32(tensor_data(t))
    loadf(tensor_data(t))

## The message of a shape failing std.tensor.2 on its own (`tensor.zeros(shape)`,
## `tensor.from_fn(shape, f)`): a string object, or 0 when `shape` has only
## non-negative sizes and not too many elements.
fn tensor_dims_fault(shape List[int]) int
    sp := list_addr(shape)
    rank := load64(sp)
    d := load64(sp + 16)
    mut count := 1
    for i in 0..rank
        s := load64(d + 8 * i)
        if s < 0
            sb_reset()
            sb_text("a tensor's sizes can't be negative, and the shape is ")
            put_sizes(d, rank)
            return str_addr(sb_str())
        if s != 0 and count > 1099511627776 / s
            sb_reset()
            sb_text("the shape ")
            put_sizes(d, rank)
            sb_text(" has too many elements")
            return str_addr(sb_str())
        count = count * s
    0

## The element count of a shape `tensor_dims_fault` accepted.
fn tensor_dims_count(shape List[int]) int
    sp := list_addr(shape)
    d := load64(sp + 16)
    mut count := 1
    for i in 0..load64(sp)
        count = count * load64(d + 8 * i)
    count

## `[n]`, the shape of `tensor.from_fn(n, f)`.
fn tensor_shape_of_len(n int) List[int]
    xs := list_alloc(1, 8)
    q := list_addr(xs)
    store64(q, 1)
    store64(load64(q + 16), n)
    xs

## `t.reshape(shape)` failing (std.tensor.3), or 0.
fn tensor_reshape_fault(t int, shape List[int]) int
    shape_fault_n(load64(t + 16), shape)

## `t.reshape(shape)` once `tensor_reshape_fault` found nothing wrong: the same elements.
fn tensor_reshape(t int, shape List[int]) int
    sp := list_addr(shape)
    rank := load64(sp)
    n := load64(t + 16)
    r := tensor_new(load64(t), rank, n)
    tensor_copy_words(r + 32, load64(sp + 16), rank)
    copy_bytes(tensor_data(r), tensor_data(t), esz(load64(t)) * n)
    r

# ---- rows and items (std.tensor.15) ----

## The product of the sizes of axes `from` and up.
fn tensor_axes_product(t int, from int) int
    mut p := 1
    for k in from..load64(t + 8)
        p = p * load64(t + 32 + 8 * k)
    p

## The message for a tensor of shape `[]` asked for rows, or 0.
fn no_rows_fault(t int, what str) int
    if load64(t + 8) != 0
        return 0
    sb_reset()
    sb_byte(96)
    sb_text(what)
    sb_text("` of a tensor of shape [], which has no rows")
    str_addr(sb_str())

## `t[i]` failing (std.tensor.15), or 0.
fn tensor_row_fault(t int, i int) int
    m := no_rows_fault(t, "index")
    if m != 0
        return m
    n := load64(t + 32)
    if i >= 0 and i < n
        return 0
    sb_reset()
    sb_text("index ")
    put_int(i)
    sb_text(" is out of bounds for a tensor of ")
    put_int(n)
    sb_text(" rows")
    str_addr(sb_str())

## Rows `a..b` of `t`; with `drop` the first axis goes (`t[i]`).
fn tensor_rows_between(t int, a int, b int, drop int) int
    rank := load64(t + 8)
    row := tensor_axes_product(t, 1)
    r := tensor_new(load64(t), rank - drop, (b - a) * row)
    if drop == 0
        store64(r + 32, b - a)
    for k in 1..rank
        store64(r + 32 + 8 * (k - drop), load64(t + 32 + 8 * k))
    sz := esz(load64(t))
    copy_bytes(tensor_data(r), tensor_data(t) + sz * a * row, sz * (b - a) * row)
    r

## `t[i]` once `tensor_row_fault` found nothing wrong.
fn tensor_row(t int, i int) int
    tensor_rows_between(t, i, i + 1, 1)

## `t[lo..hi]` (`incl` for `..=`; `has_hi` 0 for an open end) failing, or 0.
fn tensor_slice_fault(t int, lo int, hi int, incl int, has_hi int) int
    m := no_rows_fault(t, "slice")
    if m != 0
        return m
    n := load64(t + 32)
    mut h := hi
    if has_hi == 0
        h = n
    mut end := h
    if incl != 0
        end = h + 1
    if lo >= 0 and lo <= end and end <= n and (incl == 0 or h < 9223372036854775807)
        return 0
    sb_reset()
    sb_text("rows ")
    put_int(lo)
    sb_text("..")
    put_int(h)
    sb_text(" are out of bounds for a tensor of ")
    put_int(n)
    sb_text(" rows")
    str_addr(sb_str())

## `t[lo..hi]` once `tensor_slice_fault` found nothing wrong.
fn tensor_slice(t int, lo int, hi int, incl int, has_hi int) int
    mut end := hi
    if has_hi == 0
        end = load64(t + 32)
    elif incl != 0
        end = hi + 1
    tensor_rows_between(t, lo, end, 0)

## `t.item()` failing (std.tensor.15), or 0.
fn tensor_item_fault(t int) int
    if load64(t + 16) == 1
        return 0
    sb_reset()
    sb_text("`item` needs one element, but the shape is ")
    put_sizes(t + 32, load64(t + 8))
    str_addr(sb_str())

# ---- argmax, clamp, round, conv2d (std.tensor.16-19) ----

## `t.argmax(axis)` of an empty axis (std.tensor.17), or 0; `has` is 0 for no axis. The
## message names `argmax` for `argmin` too, as the interpreter's does.
fn tensor_arg_empty_fault(a int, axis int, has int) int
    mut n := load64(a + 16)
    mut other := 1
    if has != 0
        n = load64(a + 32 + 8 * axis)
        for i in 0..load64(a + 8)
            if i != axis
                other = other * load64(a + 32 + 8 * i)
    if n != 0 or other == 0
        return 0
    sb_reset()
    sb_text("`argmax` of an empty axis of a tensor of shape ")
    put_sizes(a + 32, load64(a + 8))
    str_addr(sb_str())

## `t.argmax(axis)` and `t.argmin(axis)` (`max` 1 or 0), or over every element with no
## axis: the first best index, a `Tensor[int]` without that axis. Faults were checked.
fn tensor_arg(a int, max int, axis int, has int) int
    rank := load64(a + 8)
    ek := load64(a)
    mut before := 1
    mut n := load64(a + 16)
    mut after := 1
    mut out_rank := 0
    if has != 0
        n = load64(a + 32 + 8 * axis)
        for i in 0..axis
            before = before * load64(a + 32 + 8 * i)
        for i in axis + 1..rank
            after = after * load64(a + 32 + 8 * i)
        out_rank = rank - 1
    t := tensor_new(0, out_rank, before * after)
    if has != 0
        mut at := 0
        for i in 0..rank
            if i != axis
                store64(t + 32 + 8 * at, load64(a + 32 + 8 * i))
                at += 1
    da := tdata_w(a)
    out := tensor_data(t)
    for b in 0..before
        for c in 0..after
            base := da + 8 * (b * n * after + c)
            store64(out + 8 * (b * after + c), arg_scan(base, n, 8 * after, ek, max))
    t

## The index of the first largest (`max` non-zero) or smallest of `n` elements
## `step` bytes apart from `p`: `int` when `ek` is 0, else `float` (a NaN never
## replaces the best so far, and a NaN first element is never replaced).
fn arg_scan(p int, n int, step int, ek int, max int) int
    mut best := 0
    mut q := p + step
    if ek == 0
        mut bv := load64(p)
        if max != 0
            for k in 1..n
                x := load64(q)
                if x > bv
                    bv = x
                    best = k
                q += step
        else
            for k in 1..n
                x := load64(q)
                if x < bv
                    bv = x
                    best = k
                q += step
        return best
    mut fv := loadf(p)
    if max != 0
        for k in 1..n
            x := loadf(q)
            if x > fv
                fv = x
                best = k
            q += step
    else
        for k in 1..n
            x := loadf(q)
            if x < fv
                fv = x
                best = k
            q += step
    best

## A float as Rust's `Display` writes it, for a fault message: `1` for `1.0`.
fn put_display_float(x float)
    if x != x
        sb_text("NaN")
    elif x > 1.7976931348623157e308 or x < -1.7976931348623157e308
        put_float(x)
    elif x == x.floor() and x < 1e15 and x > -1e15
        put_int(x.to_int())
    else
        put_float(x)

## `t.clamp(lo, hi)` failing (std.tensor.18), or 0.
fn tensor_clamp_fault(lo float, hi float) int
    if lo == lo and hi == hi and lo <= hi
        return 0
    sb_reset()
    sb_text("`clamp(")
    put_display_float(lo)
    sb_text(", ")
    put_display_float(hi)
    sb_text(")`: the bounds must satisfy lo <= hi")
    str_addr(sb_str())

## `t.clamp(lo, hi)` on a `float` or `f32` tensor; a NaN stays NaN. The bounds of an `f32`
## tensor are rounded to `f32` first.
fn tensor_clamp(a int, lo float, hi float) int
    n := load64(a + 16)
    rank := load64(a + 8)
    ek := load64(a)
    t := tensor_new_w(ek, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    mut l := lo
    mut h := hi
    if ek == 2
        l = f32_round(lo)
        h = f32_round(hi)
    da := tdata_w(a)
    out := tensor_data(t)
    for i in 0..n
        x := loadf(da + 8 * i)
        mut r := x
        if x == x
            if r < l
                r = l
            if r > h
                r = h
        storef(out + 8 * i, r)
    tensor_pack(t)

## `t.round()` failing (std.tensor.19): the first element that is not a finite `int`
## value, or 0.
fn tensor_round_fault(a int) int
    n := load64(a + 16)
    da := tdata_w(a)
    for i in 0..n
        x := loadf(da + 8 * i)
        r := x.round()
        if not (r >= -9.223372036854776e18 and r < 9.223372036854776e18)
            sb_reset()
            sb_text("`round` of ")
            put_display_float(x)
            sb_text(", which isn't a finite `int` value")
            return str_addr(sb_str())
    0

## `t.round()`: each element rounded half away from zero, as a `Tensor[int]`.
fn tensor_round(a int) int
    n := load64(a + 16)
    rank := load64(a + 8)
    t := tensor_new(0, rank, n)
    tensor_copy_words(t + 32, a + 32, rank)
    da := tdata_w(a)
    out := tensor_data(t)
    for i in 0..n
        store64(out + 8 * i, loadf(da + 8 * i).round().to_int())
    t

## `img.conv2d(k)` failing (std.tensor.16), or 0.
fn tensor_conv2d_fault(a int, k int) int
    if load64(a + 8) == 2 and load64(k + 8) == 2
        h := load64(a + 32)
        w := load64(a + 40)
        kh := load64(k + 32)
        kw := load64(k + 40)
        if kh <= h and kw <= w
            return 0
        sb_reset()
        sb_text("`conv2d`: a ")
        put_int(kh)
        sb_byte(120)
        put_int(kw)
        sb_text(" kernel doesn't fit a ")
        put_int(h)
        sb_byte(120)
        put_int(w)
        sb_text(" image")
        return str_addr(sb_str())
    sb_reset()
    sb_text("`conv2d` needs two 2-D tensors, but the shapes are ")
    put_sizes(a + 32, load64(a + 8))
    sb_text(" and ")
    put_sizes(k + 32, load64(k + 8))
    str_addr(sb_str())

## `img.conv2d(k)`: the valid convolution, each output adding its products in the kernel's
## row-major order, one at a time (rounded to `f32` at each step on `f32` tensors).
fn tensor_conv2d(a int, k int) int
    h := load64(a + 32)
    w := load64(a + 40)
    kh := load64(k + 32)
    kw := load64(k + 40)
    oh := h - kh + 1
    ow := w - kw + 1
    ek := load64(a)
    t := tensor_new_w(ek, 2, oh * ow)
    store64(t + 32, oh)
    store64(t + 40, ow)
    di := tdata_w(a)
    dk := tdata_w(k)
    out := tensor_data(t)
    for oy in 0..oh
        for ox in 0..ow
            mut s := 0.0
            for ky in 0..kh
                for kx in 0..kw
                    p := loadf(di + 8 * ((oy + ky) * w + ox + kx)) * loadf(dk + 8 * (ky * kw + kx))
                    if ek == 2
                        s = f32_round(s + f32_round(p))
                    else
                        s = s + p
            storef(out + 8 * (oy * ow + ox), s)
    tensor_pack(t)

# ---- top2 (std.tensor.23) ----

## The best and second-best index of the row of `n` elements `after` apart at `base`, as
## Both go to the two words at `slot`; false when the row
## has no second value or its best is NaN.
fn top2_row(base int, n int, after int, slot int) bool
    mut best := 0
    mut second := -1
    for k in 1..n
        x := loadf(base + 8 * k * after)
        if x > loadf(base + 8 * best * after)
            second = best
            best = k
        elif (second < 0 and x == x) or (second >= 0 and x > loadf(base + 8 * second * after))
            second = k
    store64(slot, best)
    store64(slot + 8, second)
    b := loadf(base + 8 * best * after)
    second >= 0 and b == b

## `t.top2(axis)` failing past the axis check (std.tensor.23), or 0.
fn tensor_top2_fault(a int, axis int) int
    rank := load64(a + 8)
    n := load64(a + 32 + 8 * axis)
    if n < 2
        sb_reset()
        sb_text("`top2(")
        put_int(axis)
        sb_text(")` needs two elements along the axis, but the shape is ")
        put_sizes(a + 32, rank)
        return str_addr(sb_str())
    mut before := 1
    mut after := 1
    for i in 0..axis
        before = before * load64(a + 32 + 8 * i)
    for i in axis + 1..rank
        after = after * load64(a + 32 + 8 * i)
    slot := alloc(16, KIND_ATOMIC)
    da := tdata_w(a)
    for b in 0..before
        for c in 0..after
            if not top2_row(da + 8 * (b * n * after + c), n, after, slot)
                sb_reset()
                sb_text("`top2` of a row with no second value, or with a NaN best")
                return str_addr(sb_str())
    0

## One of the three results of `t.top2(axis)`: `which` 0 the best indices, 1 the second
## indices (`Tensor[int]`), 2 the margins (the element type; rounded to `f32` on `f32`).
fn tensor_top2(a int, axis int, which int) int
    rank := load64(a + 8)
    n := load64(a + 32 + 8 * axis)
    mut before := 1
    mut after := 1
    for i in 0..axis
        before = before * load64(a + 32 + 8 * i)
    for i in axis + 1..rank
        after = after * load64(a + 32 + 8 * i)
    ek := load64(a)
    t := tensor_new_w(if which == 2 then ek else 0, rank - 1, before * after)
    mut at := 0
    for i in 0..rank
        if i != axis
            store64(t + 32 + 8 * at, load64(a + 32 + 8 * i))
            at += 1
    slot := alloc(16, KIND_ATOMIC)
    da := tdata_w(a)
    out := tensor_data(t)
    for b in 0..before
        for c in 0..after
            base := da + 8 * (b * n * after + c)
            top2_row(base, n, after, slot)
            best := load64(slot)
            second := load64(slot + 8)
            r := out + 8 * (b * after + c)
            if which == 0
                store64(r, best)
            elif which == 1
                store64(r, second)
            else
                m := loadf(base + 8 * best * after) - loadf(base + 8 * second * after)
                storef(r, if ek == 2 then f32_round(m) else m)
    tensor_pack(t)
