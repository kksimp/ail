## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `std.random` (std.random.1-4, ADR 0614): one splitmix64 generator for the
## program, in global slots 62 (state) and 63 (set once seeded). Without a
## seed it starts from the clock (std.random.3); the sequence for a seed is
## not specified across releases. A call `random.NAME(...)` is a call of
## `random_NAME` here; the lowering checks `lo <= hi` (std.random.2).

RAND_STATE := 62
RAND_SEEDED := 63

fn random_seed(s int)
    store64(global(RAND_STATE), s)
    store64(global(RAND_SEEDED), 1)

## The next 64 random bits.
fn random_next() int
    if load64(global(RAND_SEEDED)) == 0
        random_seed(time_now_ms() * 2862933555777941757 + 1)
    s := load64(global(RAND_STATE)) + -7046029254386353131
    store64(global(RAND_STATE), s)
    mut z := s
    z = z.bit_xor(z.shr(30).bit_and(17179869183)) * -4658895280553007687
    z = z.bit_xor(z.shr(27).bit_and(137438953471)) * -7723592293110705685
    z.bit_xor(z.shr(31).bit_and(8589934591))

## std.random.2: uniform in `lo..=hi`, by rejection from the smallest
## covering mask so every value is equally likely.
fn random_int(lo int, hi int) int
    span := hi - lo
    mut mask := -1
    if span >= 0
        mut m := span
        m = m.bit_or(m.shr(1))
        m = m.bit_or(m.shr(2))
        m = m.bit_or(m.shr(4))
        m = m.bit_or(m.shr(8))
        m = m.bit_or(m.shr(16))
        m = m.bit_or(m.shr(32))
        mask = m
    top := 1.shl(63)
    limit := span.bit_xor(top)
    while true
        x := random_next().bit_and(mask)
        if x.bit_xor(top) <= limit
            return lo + x
    0

## std.random.2: uniform in `[0, 1)` from 53 random bits.
fn random_float() float
    random_next().shr(11).bit_and(9007199254740991).to_float() / 9007199254740992.0

## std.random.4: Fisher-Yates on the list's elements, `size` bytes each.
fn random_shuffle(xs List[int], size int)
    q := list_addr(xs)
    items := load64(q + 16)
    mut i := load64(q) - 1
    while i > 0
        j := random_int(0, i)
        if size == 1
            t := load8(items + i)
            store8(items + i, load8(items + j))
            store8(items + j, t)
        else
            t := load64(items + 8 * i)
            store64(items + 8 * i, load64(items + 8 * j))
            store64(items + 8 * j, t)
        i -= 1
