## Keccak-f[1600] on the 25 lanes at `st` (FIPS 202); `b` is 200 bytes of scratch.
fn hash_keccak_f(st int, b int, rc List[int], rot List[int])
    mut r := 0
    while r < 24
        mut x := 0
        while x < 5
            c0 := load64(st + 8 * x)
                .bit_xor(load64(st + 8 * (x + 5)))
                .bit_xor(load64(st + 8 * (x + 10)))
                .bit_xor(load64(st + 8 * (x + 15)))
                .bit_xor(load64(st + 8 * (x + 20)))
            store64(b + 8 * x, c0)
            x += 1
        x = 0
        while x < 5
            d := load64(b + 8 * ((x + 4) % 5)).bit_xor(hash_rotl64(
                load64(b + 8 * ((x + 1) % 5)),
                1,
            ))
            mut y := 0
            while y < 25
                store64(st + 8 * (x + y), load64(st + 8 * (x + y)).bit_xor(d))
                y += 5
            x += 1
        # rho and pi into the scratch lanes 5..29
        mut y := 0
        while y < 5
            x = 0
            while x < 5
                v := hash_rotl64(load64(st + 8 * (x + 5 * y)), rot[x + 5 * y])
                store64(b + 40 + 8 * (y + 5 * ((2 * x + 3 * y) % 5)), v)
                x += 1
            y += 1
        # chi
        y = 0
        while y < 5
            x = 0
            while x < 5
                p := load64(b + 40 + 8 * (x + 5 * y))
                q := load64(b + 40 + 8 * ((x + 1) % 5 + 5 * y))
                s := load64(b + 40 + 8 * ((x + 2) % 5 + 5 * y))
                store64(st + 8 * (x + 5 * y), p.bit_xor(q.bit_not().bit_and(s)))
                x += 1
            y += 1
        store64(st, load64(st).bit_xor(rc[r]))
        r += 1

## SHA-3 with rate `rate` bytes and an `hl`-byte digest, as lower-case hex.
fn hash_sha3(s str, rate int, hl int) int
    rc := [
        1,
        32898,
        -9223372036854742902,
        -9223372034707259392,
        32907,
        2147483649,
        -9223372034707259263,
        -9223372036854743031,
        138,
        136,
        2147516425,
        2147483658,
        2147516555,
        -9223372036854775669,
        -9223372036854742903,
        -9223372036854743037,
        -9223372036854743038,
        -9223372036854775680,
        32778,
        -9223372034707292150,
        -9223372034707259263,
        -9223372036854742912,
        2147483649,
        -9223372034707259384,
    ]
    rot := [
        0,
        1,
        62,
        28,
        27,
        36,
        44,
        6,
        55,
        20,
        3,
        10,
        43,
        25,
        39,
        41,
        45,
        15,
        21,
        8,
        18,
        2,
        61,
        56,
        14,
    ]
    a := str_addr(s)
    src := a + 16
    n := load64(a)
    st := hash_zeros(200)
    b := alloc(240, KIND_BYTES)
    full := n - n % rate
    mut off := 0
    while off < full
        mut i := 0
        while i < rate / 8
            store64(st + 8 * i, load64(st + 8 * i).bit_xor(load64(src + off + 8 * i)))
            i += 1
        hash_keccak_f(st, b, rc, rot)
        off += rate
    rest := n - full
    tail := hash_zeros(rate)
    copy_bytes(tail, src + full, rest)
    store8(tail + rest, load8(tail + rest).bit_xor(6))
    store8(tail + rate - 1, load8(tail + rate - 1).bit_xor(128))
    mut j := 0
    while j < rate / 8
        store64(st + 8 * j, load64(st + 8 * j).bit_xor(load64(tail + 8 * j)))
        j += 1
    hash_keccak_f(st, b, rc, rot)
    st

## std.hash.6: SHA3-256 and SHA3-512 (FIPS 202).
fn hash_sha3_256(s str) str
    hash_hex(hash_sha3(s, 136, 32), 32)

fn hash_sha3_512(s str) str
    hash_hex(hash_sha3(s, 72, 64), 64)

fn hash_sha3_256_bytes(s str) str
    crypto_bytes_of(hash_sha3(s, 136, 32), 32)

fn hash_sha3_512_bytes(s str) str
    crypto_bytes_of(hash_sha3(s, 72, 64), 64)
