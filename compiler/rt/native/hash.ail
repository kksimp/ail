## std.hash.2: `sha256`, `sha384` and `sha512` as lower-case hex.
fn hash_sha256(s str) str
    a := str_addr(s)
    out := alloc(32, KIND_BYTES)
    hash_sha256_raw(a + 16, load64(a), out)
    hash_hex(out, 32)

fn hash_sha384(s str) str
    a := str_addr(s)
    out := alloc(64, KIND_BYTES)
    hash_sha512_raw(a + 16, load64(a), out, false)
    hash_hex(out, 48)

fn hash_sha512(s str) str
    a := str_addr(s)
    out := alloc(64, KIND_BYTES)
    hash_sha512_raw(a + 16, load64(a), out, true)
    hash_hex(out, 64)

## std.hash.2: HMAC-SHA-256 (RFC 2104) as lower-case hex.
fn hash_hmac_sha256(key str, s str) str
    kp := str_addr(key)
    kn := load64(kp)
    block := hash_zeros(64)
    if kn > 64
        hash_sha256_raw(kp + 16, kn, block)
    else
        copy_bytes(block, kp + 16, kn)
    sp := str_addr(s)
    n := load64(sp)
    inner := alloc(64 + n, KIND_BYTES)
    mut i := 0
    while i < 64
        store8(inner + i, load8(block + i).bit_xor(54))
        i += 1
    copy_bytes(inner + 64, sp + 16, n)
    digest := alloc(32, KIND_BYTES)
    hash_sha256_raw(inner, 64 + n, digest)
    outer := alloc(96, KIND_BYTES)
    i = 0
    while i < 64
        store8(outer + i, load8(block + i).bit_xor(92))
        i += 1
    copy_bytes(outer + 64, digest, 32)
    mac := alloc(32, KIND_BYTES)
    hash_sha256_raw(outer, 96, mac)
    hash_hex(mac, 32)
