## std.hash.2: `sha256`, `sha384` and `sha512` as lower-case hex.
fn hash_sha256_digest(s str) int
    a := str_addr(s)
    out := alloc(32, KIND_BYTES)
    hash_sha256_raw(a + 16, load64(a), out)
    out

fn hash_sha256(s str) str
    hash_hex(hash_sha256_digest(s), 32)

fn hash_sha256_bytes(s str) str
    crypto_bytes_of(hash_sha256_digest(s), 32)

fn hash_sha384_digest(s str) int
    a := str_addr(s)
    out := alloc(64, KIND_BYTES)
    hash_sha512_raw(a + 16, load64(a), out, false)
    out

fn hash_sha384(s str) str
    hash_hex(hash_sha384_digest(s), 48)

fn hash_sha384_bytes(s str) str
    crypto_bytes_of(hash_sha384_digest(s), 48)

fn hash_sha512_digest(s str) int
    a := str_addr(s)
    out := alloc(64, KIND_BYTES)
    hash_sha512_raw(a + 16, load64(a), out, true)
    out

fn hash_sha512(s str) str
    hash_hex(hash_sha512_digest(s), 64)

fn hash_sha512_bytes(s str) str
    crypto_bytes_of(hash_sha512_digest(s), 64)

## std.hash.2: HMAC-SHA-256 (RFC 2104) as lower-case hex.
fn hash_hmac_sha256_digest(key str, s str) int
    kp := str_addr(key)
    kn := load64(kp)
    block := hash_zeros(64)
    if kn > 64
        hash_sha256_raw(kp + 16, kn, block)
    else
        copy_bytes(block, kp + 16, kn)
    sp := str_addr(s)
    n := load64(sp)
    inner := alloc(64 + n, KIND_BYTES)
    mut i := 0
    while i < 64
        store8(inner + i, load8(block + i).bit_xor(54))
        i += 1
    copy_bytes(inner + 64, sp + 16, n)
    digest := alloc(32, KIND_BYTES)
    hash_sha256_raw(inner, 64 + n, digest)
    outer := alloc(96, KIND_BYTES)
    i = 0
    while i < 64
        store8(outer + i, load8(block + i).bit_xor(92))
        i += 1
    copy_bytes(outer + 64, digest, 32)
    mac := alloc(32, KIND_BYTES)
    hash_sha256_raw(outer, 96, mac)
    mac

fn hash_hmac_sha256(key str, s str) str
    hash_hex(hash_hmac_sha256_digest(key, s), 32)

fn hash_hmac_sha256_bytes(key str, s str) str
    crypto_bytes_of(hash_hmac_sha256_digest(key, s), 32)

## std.hash.5: HMAC-SHA-384 and HMAC-SHA-512 (RFC 2104, RFC 4231), 128-byte
## blocks. `wide` picks SHA-512; the tag is `hl` bytes (64 or 48) as hex.
fn hash_hmac_wide(key str, s str, wide bool) int
    hl := if wide then 64 else 48
    kp := str_addr(key)
    kn := load64(kp)
    block := hash_zeros(128)
    if kn > 128
        hash_sha512_raw(kp + 16, kn, block, wide)
        # The raw digest writes all eight words; SHA-384's tag is the first 48 bytes, so clear the rest (RFC 2104).
        mut z := hl
        while z < 64
            store8(block + z, 0)
            z += 1
    else
        copy_bytes(block, kp + 16, kn)
    sp := str_addr(s)
    n := load64(sp)
    inner := alloc(128 + n, KIND_BYTES)
    mut i := 0
    while i < 128
        store8(inner + i, load8(block + i).bit_xor(54))
        i += 1
    copy_bytes(inner + 128, sp + 16, n)
    digest := alloc(64, KIND_BYTES)
    hash_sha512_raw(inner, 128 + n, digest, wide)
    outer := alloc(128 + 64, KIND_BYTES)
    i = 0
    while i < 128
        store8(outer + i, load8(block + i).bit_xor(92))
        i += 1
    copy_bytes(outer + 128, digest, hl)
    mac := alloc(64, KIND_BYTES)
    hash_sha512_raw(outer, 128 + hl, mac, wide)
    mac

fn hash_hmac_sha384(key str, s str) str
    hash_hex(hash_hmac_wide(key, s, false), 48)

fn hash_hmac_sha512(key str, s str) str
    hash_hex(hash_hmac_wide(key, s, true), 64)

fn hash_hmac_sha384_bytes(key str, s str) str
    crypto_bytes_of(hash_hmac_wide(key, s, false), 48)

fn hash_hmac_sha512_bytes(key str, s str) str
    crypto_bytes_of(hash_hmac_wide(key, s, true), 64)

# ---- SHA-1, MD5 and SHA-3 (std.hash.6, ADR 0959). Not for new security uses:
# SHA-1 and MD5 are broken for collisions and exist for formats and protocols. ----

fn hash_rotl32(x int, n int) int
    x.shl(n).bit_or(x.shr(32 - n)).bit_and(M32)

fn hash_rotl64(x int, n int) int
    if n == 0
        return x
    x.shl(n).bit_or(hash_lsr(x, 64 - n))

## The little-endian word of `w` bytes at `p`.
fn hash_le(p int, w int) int
    mut v := 0
    mut i := w - 1
    while i >= 0
        v = v.shl(8).bit_or(load8(p + i))
        i -= 1
    v

## The `w`-byte little-endian bytes of `v` at `p`.
fn hash_put_le(p int, v int, w int)
    mut i := 0
    while i < w
        store8(p + i, v.shr(8 * i).bit_and(255))
        i += 1

## One 64-byte SHA-1 block at `blk` into the five words at `h`.
fn hash_sha1_block(h int, blk int, w int)
    mut t := 0
    while t < 16
        store64(w + 8 * t, hash_be(blk + 4 * t, 4))
        t += 1
    while t < 80
        x := load64(w + 8 * (t - 3))
            .bit_xor(load64(w + 8 * (t - 8)))
            .bit_xor(load64(w + 8 * (t - 14)))
            .bit_xor(load64(w + 8 * (t - 16)))
        store64(w + 8 * t, hash_rotl32(x, 1))
        t += 1
    mut a := load64(h)
    mut b := load64(h + 8)
    mut c := load64(h + 16)
    mut d := load64(h + 24)
    mut e := load64(h + 32)
    t = 0
    while t < 80
        mut f := 0
        mut k := 0
        if t < 20
            f = b.bit_and(c).bit_or(b.bit_not().bit_and(M32).bit_and(d))
            k = 1518500249
        elif t < 40
            f = b.bit_xor(c).bit_xor(d)
            k = 1859775393
        elif t < 60
            f = b.bit_and(c).bit_or(b.bit_and(d)).bit_or(c.bit_and(d))
            k = 2400959708
        else
            f = b.bit_xor(c).bit_xor(d)
            k = 3395469782
        tmp := (hash_rotl32(a, 5) + f + e + k + load64(w + 8 * t)).bit_and(M32)
        e = d
        d = c
        c = hash_rotl32(b, 30)
        b = a
        a = tmp
        t += 1
    store64(h, (load64(h) + a).bit_and(M32))
    store64(h + 8, (load64(h + 8) + b).bit_and(M32))
    store64(h + 16, (load64(h + 16) + c).bit_and(M32))
    store64(h + 24, (load64(h + 24) + d).bit_and(M32))
    store64(h + 32, (load64(h + 32) + e).bit_and(M32))

## std.hash.6: SHA-1 (FIPS 180-4) as lower-case hex. Broken against collisions:
## not for security, so the public name is `sha1_legacy`.
fn hash_sha1_legacy_digest(s str) int
    a := str_addr(s)
    src := a + 16
    n := load64(a)
    h := alloc(40, KIND_BYTES)
    store64(h, 1732584193)
    store64(h + 8, 4023233417)
    store64(h + 16, 2562383102)
    store64(h + 24, 271733878)
    store64(h + 32, 3285377520)
    w := alloc(640, KIND_BYTES)
    full := n - n % 64
    mut off := 0
    while off < full
        hash_sha1_block(h, src + off, w)
        off += 64
    rest := n - full
    blocks := if rest < 56 then 1 else 2
    tail := hash_zeros(128)
    copy_bytes(tail, src + full, rest)
    store8(tail + rest, 128)
    hash_put_be(tail + 64 * blocks - 8, n * 8, 8)
    hash_sha1_block(h, tail, w)
    if blocks == 2
        hash_sha1_block(h, tail + 64, w)
    out := alloc(20, KIND_BYTES)
    mut i := 0
    while i < 5
        hash_put_be(out + 4 * i, load64(h + 8 * i), 4)
        i += 1
    out

fn hash_sha1_legacy(s str) str
    hash_hex(hash_sha1_legacy_digest(s), 20)

fn hash_sha1_legacy_bytes(s str) str
    crypto_bytes_of(hash_sha1_legacy_digest(s), 20)

## One 64-byte MD5 block at `blk` into the four words at `h` (RFC 1321).
fn hash_md5_block(h int, blk int, k List[int], sh List[int])
    mut a := load64(h)
    mut b := load64(h + 8)
    mut c := load64(h + 16)
    mut d := load64(h + 24)
    mut i := 0
    while i < 64
        mut f := 0
        mut g := 0
        if i < 16
            f = b.bit_and(c).bit_or(b.bit_not().bit_and(M32).bit_and(d))
            g = i
        elif i < 32
            f = d.bit_and(b).bit_or(d.bit_not().bit_and(M32).bit_and(c))
            g = (5 * i + 1) % 16
        elif i < 48
            f = b.bit_xor(c).bit_xor(d)
            g = (3 * i + 5) % 16
        else
            f = c.bit_xor(b.bit_or(d.bit_not().bit_and(M32)))
            g = (7 * i) % 16
        sum := (a + f + k[i] + hash_le(blk + 4 * g, 4)).bit_and(M32)
        a = d
        d = c
        c = b
        b = (b + hash_rotl32(sum, sh[i])).bit_and(M32)
        i += 1
    store64(h, (load64(h) + a).bit_and(M32))
    store64(h + 8, (load64(h + 8) + b).bit_and(M32))
    store64(h + 16, (load64(h + 16) + c).bit_and(M32))
    store64(h + 24, (load64(h + 24) + d).bit_and(M32))

