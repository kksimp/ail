## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## The native heap (native-abi.md §5, ADRs 0562-0563): one reserved region
## of 16 KiB pages, size classes with free lists for small objects, page
## spans for large ones. Every object has an 8-byte header word at pointer
## minus 8: bits 0-7 kind, bit 8 mark, bits 16-63 payload bytes.
## The collector is in `gc.ail`.

# Global slots 10 and 11: the heap state block, and the stack top.
HEAP := 10
STACK_TOP := 11

# Words of the state block (`HEAP`'s target).
H_BASE := 0
H_LIMIT := 1
H_TOP := 2
H_ALLOCD := 3
H_THRESH := 4
H_LIVE := 5
H_PAGES := 6
H_HINT := 7
H_MARKS := 8
H_MARKCAP := 9
H_MARKN := 10
H_NOFIT := 13
H_REUSED := 12
H_REGS := 14
## The limit the allocation fast path tests against: `H_THRESH` while the
## process has one thread. Once it has threads this word is 0, and the fast
## path falls to the running thread's cache (`H_TBLK`, ADR 0943).
H_FASTLIM := 24
## The threads' allocation caches, one `TB_SIZE` block per thread slot, made
## by `pool` (ADR 0943). Words 281-284 are the parallel marker's
## (`gc_par.ail`). Words 14-23 are taken: the collector saves registers there.
H_TBLK := 280
H_HEADS := 32
H_BUMP := 72
H_BEND := 112
H_DIRTY := 152
## Windows only: the end of the committed part of the heap region. Not in 300-443
## (the `AIL_GC_STATS` census tables) or 450 (the leak report's block): the census
## once zeroed it, and the next commit then started from address 0.
H_COMMIT := 500

# Not a power of two: 257 cache lines, so each page starts one cache set
# later than the one before (ADR 0562). With 16384, every page of a size class
# had the same layout and the rows of a table all fell in a few sets.
PAGE := 16448
MAX_SMALL := 8192
MIN_THRESH := 33554432
## A thread's allocation cache: words laid out as the state block's
## `H_HEADS`, `H_BUMP`, `H_BEND`, `H_DIRTY` (and
## `H_MARKS` for its mark stack), so the fast path reads either one. 24 cache
## lines, so two threads' caches never share one.
TB_SIZE := 1536
## About this many bytes of a class's shared free list move to a thread's
## cache at a time.
TB_TAKE := 4096

# Page table tags (low byte): 0 free, 1 small page (bits 8-15 class, 16-31
# block size, 32-63 reciprocal),
# 2 first page of a large span (page count), 3 later page of one (the
# first page's index).
KIND_STR := 1
KIND_LIST := 2
KIND_LDATA := 3
KIND_BYTES := 9
KIND_ATOMIC := 11

## Reserve `n` bytes of address space, read-write and not counted against
## memory until touched. A negative result is the error.
fn heap_reserve(n int) int
    t := target()
    if t == 4
        return none_mmap(n)
    # Windows has no overcommit: MEM_COMMIT | MEM_RESERVE counts against the
    # commit limit, and a refusal (0) is the error the size loop halves on
    # (ADR 0608).
    if t == 3
        p := import_call("VirtualAlloc", 0, n, 12288, 4)
        return if p == 0 then -1 else p
    k := if t == 0 then 9 else if t == 1 then 222 else 197
    flags := if t == 2 then 4162 else 16418
    syscall(k, 0, n, 3, flags, -1, 0)

## The heap region itself. Windows reserves address space only and commits
## it as the heap grows (`heap_commit`): committing all of it up front took
## the whole commit limit, so a child process of a program (`ail test`
## building) could not start (run.limit.2).
fn heap_reserve_region(n int) int
    if target() == 3
        p := import_call("VirtualAlloc", 0, n, 8192, 4)
        return if p == 0 then -1 else p
    heap_reserve(n)

## Commit the heap up to `end`, in steps of 4 MiB (Windows; elsewhere pages
## are committed by touching them).
fn heap_commit(end int)
    if target() != 3 or end <= hs(H_COMMIT)
        return
    mut to := end + 4194304
    if to > hs(H_LIMIT)
        to = hs(H_LIMIT)
    from := hs(H_COMMIT)
    if import_call("VirtualAlloc", from, to - from, 4096, 4) == 0
        fail(1, 0, 0)
    hset(H_COMMIT, to)

fn heap_state() int
    load64(global(HEAP))

fn hs(k int) int
    load64(load64(global(HEAP)) + 8 * k)

fn hset(k int, v int)
    store64(load64(global(HEAP)) + 8 * k, v)

## Set up the heap; `top` is the stack address above every frame.
fn heap_init(top int)
    m := sys_mmap(4096)
    if mem_failed(m)
        fail(1, 0, 0)
    store64(global(HEAP), m)
    store64(global(STACK_TOP), top)
    mut size := 17179869184
    mut base := heap_reserve_region(size + PAGE)
    while mem_failed(base) and size > 67108864
        size = size / 2
        base = heap_reserve_region(size + PAGE)
    if mem_failed(base)
        fail(1, 0, 0)
    # Round up to a multiple of PAGE. `%` keeps the dividend's sign, so this
    # also holds for a higher-half (negative) address (ADR 0953), where
    # `(base + PAGE - 1) / PAGE * PAGE` would round past the region's slack.
    rem := base % PAGE
    aligned := if rem > 0 then base + PAGE - rem else base - rem
    hset(H_BASE, aligned)
    hset(H_TOP, aligned)
    hset(H_COMMIT, aligned)
    hset(H_LIMIT, aligned + size)
    pages := heap_reserve(size / PAGE * 8)
    if mem_failed(pages)
        fail(1, 0, 0)
    hset(H_PAGES, pages)
    # Windows commits it all now, so the queue starts smaller there.
    mut cap := if target() == 3 then 33554432 else 536870912
    mut marks := heap_reserve(cap)
    while mem_failed(marks) and cap > 1048576
        cap = cap / 2
        marks = heap_reserve(cap)
    if mem_failed(marks)
        fail(1, 0, 0)
    hset(H_MARKS, marks)
    hset(H_MARKCAP, cap / 8)
    hset(H_THRESH, MIN_THRESH)
    hset(H_FASTLIM, MIN_THRESH)

# ---- size classes ----
#
# Block sizes (header included): 16 to 256 in steps of 16 (classes 1-16),
# then four per doubling up to 8192 (classes 17-36).

fn class_size(idx int) int
    if idx <= 16
        return idx * 16
    g := (idx - 17) / 4
    j := idx - 17 - 4 * g
    one := 256
    base := one.shl(g)
    base + (j + 1) * (base / 4)

fn class_of(need int) int
    if need <= 256
        return need / 16
    mut base := 256
    mut g := 0
    while need > base * 2
        base = base * 2
        g += 1
    step := base / 4
    17 + 4 * g + (need - base + step - 1) / step - 1

fn zero_words(p int, n int)
    mut i := 0
    while i + 32 <= n
        store64(p + i, 0)
        store64(p + i + 8, 0)
        store64(p + i + 16, 0)
        store64(p + i + 24, 0)
        i += 32
    while i < n
        store64(p + i, 0)
        i += 8

## `np` zeroed, contiguous, unused pages: the lowest run that fits, else
## new pages at the top (which the kernel has zeroed).
fn heap_pages(np int, zero int) int
    heap_pages_try(np, 0, zero)

## `tried` is 1 after a collection made room for a memory cap; `zero` 0 lets
## reused pages keep their old contents.
fn heap_pages_try(np int, tried int, zero int) int
    base := hs(H_BASE)
    top := hs(H_TOP)
    pt := hs(H_PAGES)
    top_i := (top - base) / PAGE
    hint := hs(H_HINT)
    nofit := hs(H_NOFIT)
    mut i := hint
    mut run := 0
    mut start := 0
    if nofit == 0 or np < nofit
        # Whole spans are stepped over by their first page's count.
        mut lowest := -1
        while i < top_i and run < np
            t := load64(pt + 8 * i)
            if t == 0
                if run == 0
                    start = i
                if lowest < 0
                    lowest = i
                run += 1
                i += 1
            else
                run = 0
                i += if t.bit_and(255) == 2 then t.shr(8) else 1
        # Every page below the lowest free one seen is in use.
        hset(H_HINT, if lowest >= 0 then lowest else top_i)
        if run < np
            hset(H_NOFIT, np)
    else
        # No free run this long exists below the top until the next sweep.
        i = top_i
        while i > 0 and run < np and load64(pt + 8 * (i - 1)) == 0
            i -= 1
            run += 1
    if run == np
        p := base + start * PAGE
        hset(H_REUSED, 1)
        if zero != 0
            zero_words(p, np * PAGE)
        return p
    # A free run at the end continues into new pages.
    mut first := top_i
    if run > 0
        first = top_i - run
    p := base + first * PAGE
    end := p + np * PAGE
    if end > hs(H_LIMIT) or end < p
        fail(1, 0, 0)
    if limits_over(end - hs(H_BASE))
        if tried == 0
            gc_collect()
            return heap_pages_try(np, 1, zero)
        limits_trap()
    limits_pages()
    hset(H_REUSED, if run > 0 then 1 else 0)
    if run > 0 and zero != 0
        zero_words(p, run * PAGE)
    heap_commit(end)
    hset(H_TOP, end)
    p

## Count `bytes` against the collection trigger and collect when due.
fn heap_account(bytes int)
    mut a := hs(H_ALLOCD) + bytes
    if a > hs(H_THRESH)
        gc_collect()
        a = hs(H_ALLOCD) + bytes
    hset(H_ALLOCD, a)

fn alloc_large(n int, kind int, zero int) int
    np := (n + 8 + PAGE - 1) / PAGE
    heap_account(np * PAGE)
    p := heap_pages(np, zero)
    first := (p - hs(H_BASE)) / PAGE
    pt := hs(H_PAGES)
    store64(pt + 8 * first, 2 + np * 256)
    for k in 1..np
        store64(pt + 8 * (first + k), 3 + first * 256)
    store64(p, kind + n * 65536)
    p + 8

## A zeroed object of `n` payload bytes and kind `kind`, 8-byte aligned
## (native-abi.md §5). Collects first when enough has been allocated.
fn alloc(n int, kind int) int
    alloc_z(n, kind, 1)

## The same with contents unspecified, for blocks the caller fills before
## reading (list element blocks, strings, buffers): it skips the zeroing.
## Stale words in it are read as possible pointers by the collector, which
## can only keep a dead block alive a little longer, and a list's scan stops
## at its length (ADR 0564).
fn alloc_raw(n int, kind int) int
    if n <= 232 and load64(global(LIM_TICK)) == 0
        idx := (n + 23).shr(4)
        csz := idx.shl(4)
        m := load64(global(HEAP))
        a := load64(m + 8 * H_ALLOCD) + csz
        if a <= load64(m + 8 * H_FASTLIM)
            s := m + idx.shl(3)
            b := load64(s + 8 * H_HEADS)
            if b != 0
                store64(s + 8 * H_HEADS, load64(b + 8))
                store64(m + 8 * H_ALLOCD, a)
                store64(b, kind + n.shl(16))
                return b + 8
            c := load64(s + 8 * H_BUMP)
            if c != 0 and c + csz <= load64(s + 8 * H_BEND)
                store64(s + 8 * H_BUMP, c + csz)
                store64(m + 8 * H_ALLOCD, a)
                store64(c, kind + n.shl(16))
                return c + 8
        elif load64(global(MULTI)) != 0
            # With threads `H_FASTLIM` is 0 and the running thread's cache
            # serves, with no lock and no counting (ADR 0943). The slot is
            # worked out here, with no call, so neither path holds values
            # across one; Windows finds it from the thread id (`tb_fast`).
            if target() == 3
                return tb_fast(n, kind, 0)
            d := sp() - load64(global(STACKS))
            mut k := 0
            if d >= 0 and d < MAXW * STACK_SZ
                k = d.shr(23) + 1
            t := load64(m + 8 * H_TBLK) + k * TB_SIZE + idx.shl(3)
            b := load64(t + 8 * H_HEADS)
            if b != 0
                store64(t + 8 * H_HEADS, load64(b + 8))
                store64(b, kind + n.shl(16))
                return b + 8
            c := load64(t + 8 * H_BUMP)
            if c != 0 and c + csz <= load64(t + 8 * H_BEND)
                store64(t + 8 * H_BUMP, c + csz)
                store64(c, kind + n.shl(16))
                return c + 8
    alloc_slow(n, kind, 0)

## The common case, a small object served from a free list or the page being
## filled while no collection or time check is due, is straight-line code
## with no calls; everything else is `alloc_slow`. With threads, the lists
## and the page are the running thread's own (ADR 0943), so no lock is taken.
fn alloc_z(n int, kind int, zero int) int
    if n <= 232 and load64(global(LIM_TICK)) == 0
        idx := (n + 23).shr(4)
        csz := idx.shl(4)
        m := load64(global(HEAP))
        a := load64(m + 8 * H_ALLOCD) + csz
        if a <= load64(m + 8 * H_FASTLIM)
            # This class's slots, 8 bytes apart in each table.
            s := m + idx.shl(3)
            b := load64(s + 8 * H_HEADS)
            if b != 0
                store64(s + 8 * H_HEADS, load64(b + 8))
                store64(m + 8 * H_ALLOCD, a)
                if zero != 0
                    zero_words(b + 8, csz - 8)
                store64(b, kind + n.shl(16))
                return b + 8
            c := load64(s + 8 * H_BUMP)
            if c != 0 and c + csz <= load64(s + 8 * H_BEND)
                store64(s + 8 * H_BUMP, c + csz)
                store64(m + 8 * H_ALLOCD, a)
                if zero != 0 and load64(s + 8 * H_DIRTY) != 0
                    zero_words(c + 8, csz - 8)
                store64(c, kind + n.shl(16))
                return c + 8
        elif load64(global(MULTI)) != 0
            # With threads `H_FASTLIM` is 0 and the running thread's cache
            # serves, with no lock and no counting (ADR 0943). The slot is
            # worked out here, with no call, so neither path holds values
            # across one; Windows finds it from the thread id (`tb_fast`).
            if target() == 3
                return tb_fast(n, kind, zero)
            d := sp() - load64(global(STACKS))
            mut k := 0
            if d >= 0 and d < MAXW * STACK_SZ
                k = d.shr(23) + 1
            t := load64(m + 8 * H_TBLK) + k * TB_SIZE + idx.shl(3)
            b := load64(t + 8 * H_HEADS)
            if b != 0
                store64(t + 8 * H_HEADS, load64(b + 8))
                if zero != 0
                    zero_words(b + 8, csz - 8)
                store64(b, kind + n.shl(16))
                return b + 8
            c := load64(t + 8 * H_BUMP)
            if c != 0 and c + csz <= load64(t + 8 * H_BEND)
                store64(t + 8 * H_BUMP, c + csz)
                if zero != 0 and load64(t + 8 * H_DIRTY) != 0
                    zero_words(c + 8, csz - 8)
                store64(c, kind + n.shl(16))
                return c + 8
    alloc_slow(n, kind, zero)

## `alloc_z` for everything the fast path does not take: large objects, a
## class with no block ready, a collection or time check due.
fn alloc_slow(n int, kind int, zero int) int
    # With threads, the shared heap state is guarded by one lock; each thread
    # refills its own cache under it (ADR 0599, ADR 0943).
    if load64(global(MULTI)) == 0
        return alloc_locked(n, kind, zero)
    lock(global(ALLOC_LOCK))
    atomic_store(global(ALLOC_OWNER), thread_id())
    mut p := 0
    if (n + 23) / 16 * 16 > MAX_SMALL or hs(26) != 0
        p = alloc_locked(n, kind, zero)
    else
        p = tb_alloc(n, kind, zero)
    atomic_store(global(ALLOC_OWNER), 0)
    unlock(global(ALLOC_LOCK))
    p

fn alloc_locked(n int, kind int, zero int) int
    if hs(26) != 0
        gv_tick()
    tick := load64(global(LIM_TICK))
    if tick != 0
        limits_tick(tick)
    need := (n + 23) / 16 * 16
    if need > MAX_SMALL
        return alloc_large(n, kind, zero)
    idx := class_of(need)
    csz := class_size(idx)
    heap_account(csz)
    mut b := hs(H_HEADS + idx)
    if b != 0
        hset(H_HEADS + idx, load64(b + 8))
        if zero != 0
            zero_words(b + 8, csz - 8)
    else
        b = hs(H_BUMP + idx)
        if b == 0 or b + csz > hs(H_BEND + idx)
            # The page is not zeroed here; blocks carved from a reused page
            # are zeroed one by one when a zeroed block is asked for.
            b = heap_pages(1, 0)
            hset(H_DIRTY + idx, hs(H_REUSED))
            first := (b - hs(H_BASE)) / PAGE
            # tag, class, block size, and ceil(2^32 / size) so the collector
            # finds a block start without dividing (exact below 2^14 bytes)
            store64(
                hs(H_PAGES) + 8 * first,
                1 + idx * 256 + csz * 65536 + (4294967296 / csz + 1) * 4294967296,
            )
            hset(H_BEND + idx, b + PAGE / csz * csz)
        hset(H_BUMP + idx, b + csz)
        if zero != 0 and hs(H_DIRTY + idx) != 0
            zero_words(b + 8, csz - 8)
    store64(b, kind + n * 65536)
    b + 8

# ---- per-thread caches (ADR 0943) ----

## The running thread's allocation cache: slot 0 the main thread, `k + 1`
## worker `k` (as `thread_slot`, computed here without a call on Linux and
## macOS: a worker's stack lies in the `STACKS` region, `STACK_SZ` = 2^23).
fn heap_tb(m int) int
    mut k := 0
    if target() == 3
        k = win_worker_index() + 1
    else
        d := sp() - load64(global(STACKS))
        if d >= 0 and d < MAXW * STACK_SZ
            k = d.shr(23) + 1
    load64(m + 8 * H_TBLK) + k * TB_SIZE

## The threaded fast path on Windows, where the slot comes from the thread id
## (`heap_tb`): a block from the running thread's cache, or `alloc_slow` to
## refill it. `n` is at most 232.
fn tb_fast(n int, kind int, zero int) int
    idx := (n + 23).shr(4)
    csz := idx.shl(4)
    t := heap_tb(load64(global(HEAP))) + idx.shl(3)
    b := load64(t + 8 * H_HEADS)
    if b != 0
        store64(t + 8 * H_HEADS, load64(b + 8))
        if zero != 0
            zero_words(b + 8, csz - 8)
        store64(b, kind + n.shl(16))
        return b + 8
    c := load64(t + 8 * H_BUMP)
    if c != 0 and c + csz <= load64(t + 8 * H_BEND)
        store64(t + 8 * H_BUMP, c + csz)
        if zero != 0 and load64(t + 8 * H_DIRTY) != 0
            zero_words(c + 8, csz - 8)
        store64(c, kind + n.shl(16))
        return c + 8
    alloc_slow(n, kind, zero)

## Make the caches, before the process gets its second thread (`pool`).
## With AIL_GC_VERIFY they stay empty (`alloc_slow` never fills them), so
## every allocation takes the counted, locked path.
fn tb_init()
    t := sys_mmap((MAXW + 1) * TB_SIZE)
    if mem_failed(t)
        fail(1, 0, 0)
    hset(H_TBLK, t)
    hset(H_FASTLIM, 0)

## A small object from this thread's cache, refilled first when the class has
## nothing ready; the caller holds the allocation lock.
fn tb_alloc(n int, kind int, zero int) int
    tick := load64(global(LIM_TICK))
    if tick != 0
        limits_tick(tick)
    idx := class_of((n + 23) / 16 * 16)
    csz := class_size(idx)
    m := heap_state()
    s := heap_tb(m) + 8 * idx
    # A refill may collect, which empties every cache: look again after it.
    while not tb_ready(s, csz)
        tb_refill(m, s, idx, csz)
    mut b := load64(s + 8 * H_HEADS)
    if b != 0
        store64(s + 8 * H_HEADS, load64(b + 8))
        if zero != 0
            zero_words(b + 8, csz - 8)
    else
        b = load64(s + 8 * H_BUMP)
        store64(s + 8 * H_BUMP, b + csz)
        if zero != 0 and load64(s + 8 * H_DIRTY) != 0
            zero_words(b + 8, csz - 8)
    store64(b, kind + n * 65536)
    b + 8

## Whether the cache's class words at `s` hold a block of `csz` bytes.
fn tb_ready(s int, csz int) bool
    if load64(s + 8 * H_HEADS) != 0
        return true
    b := load64(s + 8 * H_BUMP)
    b != 0 and b + csz <= load64(s + 8 * H_BEND)

## Give class `idx` of the cache whose class words are at `s` some blocks: a
## run of the shared free list, else the shared page being filled, else a new
## page. The blocks are counted toward the next collection as they move.
fn tb_refill(m int, s int, idx int, csz int)
    g := m + 8 * idx
    head := load64(g + 8 * H_HEADS)
    if head != 0
        want := if csz < TB_TAKE then TB_TAKE / csz else 1
        mut last := head
        mut next := load64(head + 8)
        mut k := 1
        while k < want and next != 0
            last = next
            next = load64(next + 8)
            k += 1
        store64(g + 8 * H_HEADS, next)
        store64(last + 8, 0)
        store64(s + 8 * H_HEADS, head)
        heap_account(k * csz)
        return
    gb := load64(g + 8 * H_BUMP)
    ge := load64(g + 8 * H_BEND)
    if gb != 0 and gb + csz <= ge
        store64(g + 8 * H_BUMP, 0)
        store64(g + 8 * H_BEND, 0)
        store64(s + 8 * H_DIRTY, load64(g + 8 * H_DIRTY))
        store64(s + 8 * H_BUMP, gb)
        store64(s + 8 * H_BEND, ge)
        heap_account(ge - gb)
        return
    b := heap_pages(1, 0)
    first := (b - hs(H_BASE)) / PAGE
    store64(
        hs(H_PAGES) + 8 * first,
        1 + idx * 256 + csz * 65536 + (4294967296 / csz + 1) * 4294967296,
    )
    store64(s + 8 * H_DIRTY, hs(H_REUSED))
    store64(s + 8 * H_BUMP, b)
    store64(s + 8 * H_BEND, b + PAGE / csz * csz)
    heap_account(PAGE / csz * csz)

## Before a collection marks (the world is stopped): every cache's blocks go
## back to the heap. A block not yet handed out from a cache's page may hold
## an old object's words, so its header is cleared; the sweep then chains it
## with the other free blocks, and blocks on a cache's free list already have
## a zero header.
fn tb_flush()
    if load64(global(MULTI)) == 0
        return
    t := hs(H_TBLK)
    for k in 0..MAXW + 1
        for c in 1..37
            s := t + k * TB_SIZE + 8 * c
            mut b := load64(s + 8 * H_BUMP)
            e := load64(s + 8 * H_BEND)
            if b != 0
                csz := class_size(c)
                while b < e
                    store64(b, 0)
                    b += csz
            store64(s + 8 * H_HEADS, 0)
            store64(s + 8 * H_BUMP, 0)
            store64(s + 8 * H_BEND, 0)
