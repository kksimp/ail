## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## List methods that edit or search a list (type.coll.9, type.coll.11,
## type.coll.14; ADR 0605). Lists are the objects of native-abi.md §2:
## +0 len, +8 cap, +16 data. `size` is an element's bytes: 8, or 1 for a
## `List[bool]` or `List[u8]`, 2 for a `List[u16]`, 4 for a `List[u32]`.

fn list_get_word(data int, size int, i int) int
    if size == 1
        return load8(data + i)
    if size == 8
        return load64(data + 8 * i)
    narrow_get(data + size * i, size)

fn list_set_word(data int, size int, i int, w int)
    if size == 1
        store8(data + i, w)
    elif size == 8
        store64(data + 8 * i, w)
    else
        narrow_set(data + size * i, size, w)

## The unsigned little-endian `size` bytes (2 or 4) at `p`.
fn narrow_get(p int, size int) int
    mut w := 0
    for k in 0..size
        w = w.bit_or(load8(p + k).shl(8 * k))
    w

## The low `size` bytes (2 or 4) of `w` at `p`, little-endian.
fn narrow_set(p int, size int, w int)
    for k in 0..size
        store8(p + k, w.shr(8 * k).bit_and(255))

## A list of `size`-byte elements (a `List[u8]`, `List[u16]` or `List[u32]`) as
## a list of words: for the operations that read 8-byte elements (sort, sum,
## min, max, ordering; ADRs 0907, 0912).
fn list_widen(xs List[int], size int) List[int]
    p := list_addr(xs)
    n := load64(p)
    out := list_alloc(n, 8)
    q := list_addr(out)
    src := load64(p + 16)
    dst := load64(q + 16)
    for i in 0..n
        store64(dst + 8 * i, list_get_word(src, size, i))
    store64(q, n)
    out

## Writes the words of `wide` back into the `size`-byte elements of `xs`, as
## many as `xs` has.
fn list_narrow_into(xs List[int], wide List[int], size int)
    p := list_addr(xs)
    dst := load64(p + 16)
    src := load64(list_addr(wide) + 16)
    for i in 0..load64(p)
        list_set_word(dst, size, i, load64(src + 8 * i))

## `xs.extend(ys)`.
fn list_extend(xs List[int], ys List[int], size int)
    p := list_addr(xs)
    q := list_addr(ys)
    n := load64(p)
    k := load64(q)
    while n + k > load64(p + 8)
        list_grow(p, size)
    copy_list(load64(p + 16) + size * n, load64(q + 16), size * k)
    store64(p, n + k)

## `xs.remove_at(i)`, the index already checked.
fn list_remove_at(xs List[int], i int, size int)
    p := list_addr(xs)
    n := load64(p)
    data := load64(p + 16)
    for j in i..n - 1
        list_set_word(data, size, j, list_get_word(data, size, j + 1))
    store64(p, n - 1)

## `xs.insert(i, w)`, the index already checked (`0 <= i <= len`).
fn list_insert(xs List[int], i int, w int, size int)
    p := list_addr(xs)
    n := load64(p)
    if n == load64(p + 8)
        list_grow(p, size)
    data := load64(p + 16)
    mut j := n
    while j > i
        list_set_word(data, size, j, list_get_word(data, size, j - 1))
        j -= 1
    list_set_word(data, size, i, w)
    store64(p, n + 1)

fn list_clear(xs List[int])
    store64(list_addr(xs), 0)

## `xs.pop()` after the caller has seen the list is not empty.
fn list_drop_last(xs List[int])
    p := list_addr(xs)
    store64(p, load64(p) - 1)

fn list_reverse(xs List[int], size int)
    p := list_addr(xs)
    data := load64(p + 16)
    mut i := 0
    mut j := load64(p) - 1
    while i < j
        a := list_get_word(data, size, i)
        list_set_word(data, size, i, list_get_word(data, size, j))
        list_set_word(data, size, j, a)
        i += 1
        j -= 1

fn list_str_eq(a int, b int) bool
    if a == b
        return true
    n := load64(a)
    if n != load64(b)
        return false
    bytes_eq_at(a + 16, b + 16, n)

## Equality of two stored words: `kind` 0 integers and bools, 1 strings,
## 2 floats (IEEE: `nan` is unequal to itself, `-0.0` equals `0.0`); 8 more
## is a list of words of the kind below.
fn list_word_eq(kind int, a int, b int) bool
    if kind >= 8
        p := list_addr(list_at(a))
        q := list_addr(list_at(b))
        n := load64(p)
        if n != load64(q)
            return false
        for i in 0..n
            if not list_word_eq(
                kind - 8,
                load64(load64(p + 16) + 8 * i),
                load64(load64(q + 16) + 8 * i),
            )
                return false
        return true
    if kind == 1
        return list_str_eq(a, b)
    if kind == 2
        return bits_float(a) == bits_float(b)
    a == b

## `xs.contains(w)`.
fn list_contains(xs List[int], w int, kind int, size int) bool
    p := list_addr(xs)
    data := load64(p + 16)
    n := load64(p)
    if kind == 0 and size == 8
        for i in 0..n
            if load64(data + 8 * i) == w
                return true
        return false
    for i in 0..n
        if list_word_eq(kind, list_get_word(data, size, i), w)
            return true
    false

## Whether `a` sorts before `b`: `kind` 0 integers, 1 strings (bytes), 2 floats
## (type.num.11: `nan` last).
fn list_word_lt(kind int, a int, b int) bool
    if kind >= 8
        return list_cmp(list_at(a), list_at(b), kind - 8) < 0
    if kind == 1
        na := load64(a)
        nb := load64(b)
        n := if na < nb then na else nb
        for i in 0..n
            x := load8(a + 16 + i)
            y := load8(b + 16 + i)
            if x != y
                return x < y
        return na < nb
    if kind == 2
        x := bits_float(a)
        y := bits_float(b)
        if x != x
            return false
        if y != y
            return true
        return x < y
    a < b

## `xs.cmp(ys)` and `xs < ys`: -1, 0 or 1 by the first element that differs
## (`kind` as for `list_word_lt`, 8-byte elements), else by length.
fn list_cmp(xs List[int], ys List[int], kind int) int
    p := list_addr(xs)
    q := list_addr(ys)
    n := load64(p)
    m := load64(q)
    a := load64(p + 16)
    b := load64(q + 16)
    lim := if n < m then n else m
    for i in 0..lim
        x := load64(a + 8 * i)
        y := load64(b + 8 * i)
        if list_word_lt(kind, x, y)
            return -1
        if list_word_lt(kind, y, x)
            return 1
    if n < m
        return -1
    if n > m
        return 1
    0

## `xs.sort()`: a stable sort of the words: from 64 elements radix for
## integers and floats (sort_radix.ail) and keyed pairs for strings
## (sort_str.ail), else a merge sort.
fn list_sort(xs List[int], kind int)
    p := list_addr(xs)
    n := load64(p)
    if n < 2
        return
    if n >= 64 and (kind == 0 or kind == 2) and sort_radix(load64(p + 16), n, kind)
        return
    if n >= 64 and kind == 1
        sort_str(load64(p + 16), n)
        return
    mut src := load64(p + 16)
    mut dst := alloc_raw(8 * n, KIND_LDATA)
    mut width := 1
    while width < n
        mut lo := 0
        while lo < n
            mid := if lo + width < n then lo + width else n
            hi := if lo + 2 * width < n then lo + 2 * width else n
            mut a := lo
            mut b := mid
            mut k := lo
            while a < mid and b < hi
                if list_word_lt(kind, load64(src + 8 * b), load64(src + 8 * a))
                    store64(dst + 8 * k, load64(src + 8 * b))
                    b += 1
                else
                    store64(dst + 8 * k, load64(src + 8 * a))
                    a += 1
                k += 1
            while a < mid
                store64(dst + 8 * k, load64(src + 8 * a))
                a += 1
                k += 1
            while b < hi
                store64(dst + 8 * k, load64(src + 8 * b))
                b += 1
                k += 1
            lo += 2 * width
        t := src
        src = dst
        dst = t
        width *= 2
    # The sorted words are in `src`; the list's own data may be `dst`.
    if src != load64(p + 16)
        copy_bytes(load64(p + 16), src, 8 * n)

## `xs == ys`: the same length and equal elements (`kind` as for `list_contains`).
fn list_eq(xs List[int], ys List[int], kind int, size int) bool
    p := list_addr(xs)
    q := list_addr(ys)
    n := load64(p)
    if n != load64(q)
        return false
    a := load64(p + 16)
    b := load64(q + 16)
    # Integer, bool and char elements are plain words (or bytes): compare
    # memory, no call per element.
    if kind == 0
        return bytes_eq_at(a, b, n * size)
    for i in 0..n
        if not list_word_eq(kind, list_get_word(a, size, i), list_get_word(b, size, i))
            return false
    true

## `xs.index_of(x)`: the index of the first equal element, or -1 (type.coll.9).
fn list_index_of(xs List[int], w int, kind int, size int) int
    p := list_addr(xs)
    data := load64(p + 16)
    n := load64(p)
    if kind == 0 and size == 8
        for i in 0..n
            if load64(data + 8 * i) == w
                return i
        return -1
    for i in 0..n
        if list_word_eq(kind, list_get_word(data, size, i), w)
            return i
    -1

## `xs.min()` and `xs.max()` (type.coll.11): the index of the first least
## (`greatest` 0) or first greatest element, or -1 for an empty list.
fn list_extreme(xs List[int], kind int, greatest int) int
    p := list_addr(xs)
    n := load64(p)
    if n == 0
        return -1
    data := load64(p + 16)
    mut best := 0
    for i in 1..n
        a := load64(data + 8 * i)
        b := load64(data + 8 * best)
        if greatest == 0
            if list_word_lt(kind, a, b)
                best = i
        elif list_word_lt(kind, b, a)
            best = i
    best

## `xs.swap(i, j)` for indexes already checked (type.coll.7).
fn list_swap(xs List[int], i int, j int, size int)
    data := load64(list_addr(xs) + 16)
    a := list_get_word(data, size, i)
    list_set_word(data, size, i, list_get_word(data, size, j))
    list_set_word(data, size, j, a)

## `xs.sum()` of integers (type.coll.12): left to right, trapping on overflow.
## `head` and `tail` are the trap's first line and excerpt.
## `xs.take(n)` (type.coll.15): the first `n` elements, or all of them; a
## negative `n` traps.
fn list_take(xs List[int], n int, size int, head str, tail str) List[int]
    if n < 0
        flush()
        out_str(head)
        out_str("`take` needs a count of at least 0, not ")
        out_int(n)
        out_str("\n")
        trap_tail(tail)
        trace_frames(tail)
        flush_to(2)
        sys_exit(1)
    len := load64(list_addr(xs))
    list_slice(xs, 0, if n < len then n else len, size)

fn list_sum_int(xs List[int], head str, tail str) int
    p := list_addr(xs)
    data := load64(p + 16)
    mut s := 0
    for i in 0..load64(p)
        v := load64(data + 8 * i)
        t := s + v
        if (v >= 0 and t < s) or (v < 0 and t > s)
            flush()
            out_str(head)
            out_str("`sum` overflows `int`\n")
            trap_tail(tail)
            trace_frames(tail)
            flush_to(2)
            sys_exit(1)
        s = t
    s

## The fixed summation tree of a float list (type.coll.12), over `lo..hi`.
fn list_sum_tree(data int, lo int, hi int) float
    n := hi - lo
    if n <= 32
        mut p0 := 0.0
        mut p1 := 0.0
        mut p2 := 0.0
        mut p3 := 0.0
        for i in 0..n
            v := bits_float(load64(data + 8 * (lo + i)))
            k := i % 4
            if k == 0
                p0 += v
            elif k == 1
                p1 += v
            elif k == 2
                p2 += v
            else
                p3 += v
        return (p0 + p1) + (p2 + p3)
    m := 32 * ((n + 63) / 64)
    list_sum_tree(data, lo, lo + m) + list_sum_tree(data, lo + m, hi)

## Sum of a `List[f32]`: one `f32` addition after another, as the interpreter.
fn list_sum_f32(xs List[int]) float
    p := list_addr(xs)
    data := load64(p + 16)
    mut t := 0.0.to_f32()
    for i in 0..load64(p)
        t = t + loadf(data + 8 * i).to_f32()
    t.to_float()

fn list_sum_float(xs List[int]) float
    p := list_addr(xs)
    list_sum_tree(load64(p + 16), 0, load64(p))

## `xs.chunks(n)` (`win` 0) and `xs.windows(n)` (`win` 1), type.coll.17: a
## list of fresh lists of `n` elements (`size` bytes each); the last chunk may
## be shorter. `n < 1` traps. `head` and `tail` are the trap's first line and
## excerpt.
fn list_runs(xs List[int], n int, win int, size int, head str, tail str) List[int]
    if n < 1
        flush()
        out_str(head)
        out_str(if win == 1 then "`windows`" else "`chunks`")
        out_str(" needs a size of at least 1, not ")
        out_int(n)
        out_str("\n")
        trap_tail(tail)
        flush_to(2)
        sys_exit(1)
    len := load64(list_addr(xs))
    out := list_new(0)
    mut i := 0
    if win == 1
        while i + n <= len
            list_push(out, list_addr(list_slice(xs, i, i + n, size)))
            i += 1
    else
        while i < len
            hi := if i + n < len then i + n else len
            list_push(out, list_addr(list_slice(xs, i, hi, size)))
            i += n
    out

## `xs.flatten()` (type.coll.19): the elements of the inner lists, in order.
## `size` is the inner element's byte size.
fn list_flatten(xs List[int], size int) List[int]
    p := list_addr(xs)
    data := load64(p + 16)
    mut total := 0
    for i in 0..load64(p)
        total += load64(load64(data + 8 * i))
    q := list_addr(list_alloc(total, size))
    mut at := 0
    for i in 0..load64(p)
        inner := load64(data + 8 * i)
        n := load64(inner)
        copy_bytes(load64(q + 16) + size * at, load64(inner + 16), size * n)
        at += n
    store64(q, total)
    list_at(q)
