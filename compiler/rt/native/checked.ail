## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `checked_*` on an `int` (type.num.12): whether the operation has a result.
## The compiler emits the operation only where this says yes.

## Whether `a * b` is outside `int`.
fn mul_overflows(a int, b int) bool
    if a == 0 or b == 0
        return false
    least := -9223372036854775807 - 1
    if a == -1
        return b == least
    if b == -1
        return a == least
    if b > 0
        return a > 9223372036854775807 / b or a < least / b
    a > least / b or a < 9223372036854775807 / b

## Whether the operation `code` (2 `*`, 3 `/`, 4 `%` of lower_checked.ail)
## on `a` and `b` has a result: not on overflow, nor on a zero divisor.
## `a % -1` is 0 for every `a` (expr.arith.5).
fn checked_ok(code int, a int, b int) bool
    if code == 2
        return not mul_overflows(a, b)
    if b == 0
        return false
    if code == 3
        return not (a == -9223372036854775807 - 1 and b == -1)
    true

## `a % b` for a non-zero `b`, where `a % -1` never overflows.
fn rem_safe(a int, b int) int
    if b == -1
        return 0
    a % b

## `saturating_add`, `saturating_sub`, `saturating_mul` (codes 0, 1, 2) on an
## `int`: the result clamped to the `int` range.
fn saturating(code int, a int, b int) int
    most := 9223372036854775807
    least := -9223372036854775807 - 1
    if code == 0
        if b > 0 and a > most - b
            return most
        if b < 0 and a < least - b
            return least
        return a + b
    if code == 1
        if b > 0 and a < least + b
            return least
        if b < 0 and a > most + b
            return most
        return a - b
    if mul_overflows(a, b)
        return if (a < 0) != (b < 0) then least else most
    a * b
