## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## ECDSA P-256 signing and private-key loading for the native TLS server (ADR
## 1013, std.net.33): a PEM `PRIVATE KEY` (PKCS#8) or `EC PRIVATE KEY` (SEC 1)
## becomes a 32-byte scalar, and a message becomes a DER `ECDSA-Sig-Value`
## (SEC 1 4.1.3) over SHA-256. The nonce comes from the OS generator. All
## arithmetic on the key and the nonce is constant time (tls_p256.ail, ADR
## 0959 rule 2); tls_sig.ail's variable-time code is used for public values
## only (the curve constants, the generator set-up).

## The point `[x, y, z]` chosen by `bit`: `a` when 1, `b` when 0, by masks.
fn tsg_sel(bit int, a List[List[int]], b List[List[int]]) List[List[int]]
    m := 0 - bit
    mut out := List[List[int]]()
    for c in 0..3
        mut v := tbig_zero(a[c].len())
        for i in 0..a[c].len()
            v[i] = b[c][i].bit_xor(a[c][i].bit_xor(b[c][i]).bit_and(m))
        out.push(v)
    out

## The P-256 field context and generator: `[f, g, [b]]` where `g` is
## `[x, y, z]` and `b` the curve constant, all as residues.
fn tsg_curve() List[List[List[int]]]
    k := tbig_limbs(32)
    f := mont_new(sig_big_hex(sig_curve_p(0), k))
    g := [
        mont_to(f, sig_big_hex(sig_curve_gx(0), k)),
        mont_to(f, sig_big_hex(sig_curve_gy(0), k)),
        f[3],
    ]
    [f, g, [mont_to(f, sig_big_hex(sig_curve_b(0), k))]]

## Whether the 32 bytes at `d` are a valid private scalar: 0 < d < n.
fn tsg_scalar_ok(d int) bool
    k := tbig_limbs(32)
    n := sig_big_hex(sig_curve_n(0), k)
    v := tbig_from_be(d, 32, k)
    not tbig_is_zero(v) and tbig_cmp(v, n) < 0

## The public key `04 || x || y` (65 bytes at `out`) of the scalar at `d`.
fn tsg_public(d int, out int) bool
    k := tbig_limbs(32)
    c := tsg_curve()
    pt := ctp_mul(c[0], c[2][0], c[1], tbig_from_be(d, 32, k))
    store8(out, 4)
    ctp_affine(c[0], pt, out + 1, out + 33)

## Sign the `mn` bytes at `msg` with the scalar at `d` (ECDSA, SHA-256). The
## DER signature goes to `out` (room for 80); its length is returned, or 0 if
## the system has no random numbers. Everything that touches `d` or the nonce
## runs through tls_p256.ail, which has no secret-dependent branch or index;
## the only branches on secret-derived values are the rejections below, which
## happen with probability about 2^-32 and reveal nothing about d.
fn tsg_sign(d int, msg int, mn int, out int) int
    k := tbig_limbs(32)
    n := sig_big_hex(sig_curve_n(0), k)
    c := tsg_curve()
    f := c[0]
    nm := mont_new(n)
    digest := alloc_raw(64, KIND_BYTES)
    hash_sha256_raw(msg, mn, digest)
    e := ctm_reduce(tbig_from_be(digest, 32, k), 0, n)
    dm := ctm_to(nm, tbig_from_be(d, 32, k))
    em := ctm_to(nm, e)
    rnd := alloc_raw(40, KIND_BYTES)
    xb := alloc_raw(40, KIND_BYTES)
    yb := alloc_raw(40, KIND_BYTES)
    for _ in 0..64
        if tc_random(rnd, 32) < 0
            return 0
        kv := tbig_from_be(rnd, 32, k)
        if tbig_is_zero(kv) or tbig_cmp(kv, n) >= 0
            continue
        pt := ctp_mul(f, c[2][0], c[1], kv)
        if not ctp_affine(f, pt, xb, yb)
            continue
        r := ctm_reduce(tbig_from_be(xb, 32, k), 0, n)
        if tbig_is_zero(r)
            continue
        rm := ctm_to(nm, r)
        t := ctm_add(nm, em, ctm_mul(nm, rm, dm))
        kinv := ctm_inv(nm, ctm_to(nm, kv))
        s := ctm_from(nm, ctm_mul(nm, kinv, t))
        if tbig_is_zero(s)
            continue
        rb := alloc_raw(40, KIND_BYTES)
        sb := alloc_raw(40, KIND_BYTES)
        tbig_to_be(r, rb, 32)
        tbig_to_be(s, sb, 32)
        return tsg_der(rb, sb, out)
    0

## Append the DER INTEGER of the 32-byte number at `v` at `o`; the new end.
fn tsg_int(v int, out int, o int) int
    mut skip := 0
    while skip < 31 and load8(v + skip) == 0
        skip += 1
    pad := if load8(v + skip) >= 128 then 1 else 0
    len := 32 - skip + pad
    store8(out + o, 2)
    store8(out + o + 1, len)
    mut at := o + 2
    if pad == 1
        store8(out + at, 0)
        at += 1
    copy_bytes(out + at, v + skip, 32 - skip)
    at + 32 - skip

## `SEQUENCE { INTEGER r, INTEGER s }` at `out`; its length.
fn tsg_der(r int, s int, out int) int
    e := tsg_int(r, out, 2)
    e2 := tsg_int(s, out, e)
    store8(out, 48)
    store8(out + 1, e2 - 2)
    e2

# ---- loading a private key ----

## The scalar in the OCTET STRING at `off` of the SEC 1 body `[off, end)` of
## `der`: 32 bytes at the returned address, or 0.
fn tsg_octets(der int, off int, end int) int
    os := der_expect(der, off, end, DER_OCTET_STRING)
    if os.len() == 0 or os[2] < 1 or os[2] > 32
        return 0
    d := alloc_raw(40, KIND_BYTES)
    for i in 0..40
        store8(d + i, 0)
    copy_bytes(d + 32 - os[2], der + os[1], os[2])
    d

## The scalar of one DER private key (PKCS#8 or SEC 1), or 0.
fn tsg_der_key(der int, n int) int
    top := der_expect(der, 0, n, DER_SEQUENCE)
    if top.len() == 0 or top[3] != n
        return 0
    bend := top[1] + top[2]
    v := der_expect(der, top[1], bend, DER_INTEGER)
    if v.len() == 0 or v[2] != 1
        return 0
    ver := load8(der + v[1])
    if ver == 1
        return tsg_octets(der, v[3], bend)
    if ver != 0
        return 0
    alg := der_expect(der, v[3], bend, DER_SEQUENCE)
    if alg.len() == 0
        return 0
    aend := alg[1] + alg[2]
    o1 := der_expect(der, alg[1], aend, DER_OID)
    if o1.len() == 0 or not der_is(der, o1[1], o1[2], "2a8648ce3d0201")
        return 0
    o2 := der_expect(der, o1[3], aend, DER_OID)
    if o2.len() == 0 or not der_is(der, o2[1], o2[2], "2a8648ce3d030107")
        return 0
    inner := der_expect(der, alg[3], bend, DER_OCTET_STRING)
    if inner.len() == 0
        return 0
    ec := der_expect(der, inner[1], inner[1] + inner[2], DER_SEQUENCE)
    if ec.len() == 0
        return 0
    eend := ec[1] + ec[2]
    ev := der_expect(der, ec[1], eend, DER_INTEGER)
    if ev.len() == 0 or ev[2] != 1 or load8(der + ev[1]) != 1
        return 0
    tsg_octets(der, ev[3], eend)

## The 32-byte scalar of the private key in `pem` at the address in `out` (a
## word), or the text of why not.
fn tsg_load(pem str, out int) str
    if pem.contains("ENCRYPTED PRIVATE KEY")
        return "the private key is encrypted; decrypt it first (ADR 1013)"
    if pem.contains("BEGIN RSA PRIVATE KEY")
        return "the private key is RSA; the TLS server signs with ECDSA P-256 keys only (ADR 1013)"
    mut ders := der_pem_label(pem, "PRIVATE KEY")
    for extra in der_pem_label(pem, "EC PRIVATE KEY")
        ders.push(extra)
    if ders.len() != 1
        return "key_pem must hold exactly one PRIVATE KEY or EC PRIVATE KEY block"
    d := tsg_der_key(ders[0][0], ders[0][1])
    if d == 0
        return "the private key is not an ECDSA P-256 key (prime256v1)"
    if not tsg_scalar_ok(d)
        return "the private key's scalar is out of range"
    store64(out, d)
    ""
