## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## On Windows (`target()` 3) `run` and `which` are `win.ail`'s (CreateProcessW on
## three pipes); `start` is not built there yet.
##
## `std.proc.run`, `which` and `start` (std.proc.1-7, ADR 0770): the program is
## found on `PATH`, run by `clone` (Linux) or libSystem's `fork` (macOS) and
## `execve` with its three standard streams on pipes, and fed and drained with
## `ppoll` (`poll` on macOS) so a full pipe can't deadlock. A close-on-exec
## pipe tells the parent that the `execve` failed (only that case is a
## `ProcError`, std.proc.1). No global slots: the state is locals and one
## scratch block. macOS uses `fork`, `pipe` and `signal` from libSystem
## (ADR 0534) and BSD system calls for the rest.

# Kinds of the heap objects used here: a struct's words are scanned.
PROC_STRUCT := 4
PROC_CHUNK := 65536

# ---- finding the program (std.proc.3) ----

## `s` as NUL-terminated bytes in a new object, or 0 when it holds a NUL.
fn proc_cstr(s str) int
    p := str_addr(s)
    n := load64(p)
    d := alloc(n + 1, KIND_BYTES)
    copy_bytes(d, p + 16, n)
    store8(d + n, 0)
    for i in 0..n
        if load8(d + i) == 0
            return 0
    d

## Whether the C string `p` is an executable file.
fn proc_exec_ok(p int) bool
    r := if target() == 2 then syscall(33, p, 1, 0, 0, 0, 0) else syscall(
        os_pick(269, 48, 0),
        -100,
        p,
        1,
        0,
        0,
        0,
    )
    r == 0 and not os_is_dir_at(p)

## `DIR/NAME` as a C string: `n` bytes of `dir` at `d`, a `/` unless `dir`
## ends with one, then `name`. An empty `dir` gives `name` alone.
fn proc_join(d int, dn int, name str) int
    np := str_addr(name)
    n := load64(np)
    c := alloc(dn + n + 2, KIND_BYTES)
    mut at := 0
    if dn > 0
        copy_bytes(c, d, dn)
        at = dn
        if load8(d + dn - 1) != 47
            store8(c + at, 47)
            at += 1
    copy_bytes(c + at, np + 16, n)
    store8(c + at + n, 0)
    c

## The C string of the file `run(name, ...)` would start: `name` itself when
## it has a `/`, else the first `DIR/name` on `PATH` that is executable.
## 0 when there is none, -1 when only a file that isn't executable exists.
fn proc_find(name str) int
    if target() == 3
        return win_find(name)
    np := str_addr(name)
    n := load64(np)
    if n == 0 or os_has_nul(name)
        return 0
    mut perm := false
    mut slash := false
    for i in 0..n
        if load8(np + 16 + i) == 47
            slash = true
    if slash
        c := proc_cstr(name)
        if c == 0
            return 0
        if proc_exec_ok(c)
            return c
        return if os_access(c) == 0 then -1 else 0
    mut path := os_env_get("PATH")
    if not os_ok()
        path = "/usr/local/bin:/usr/bin:/bin"
    pp := str_addr(path)
    pn := load64(pp)
    mut start := 0
    while start <= pn
        mut end := start
        while end < pn and load8(pp + 16 + end) != 58
            end += 1
        c := proc_join(pp + 16 + start, end - start, name)
        if proc_exec_ok(c)
            return c
        if os_access(c) == 0
            perm = true
        start = end + 1
    return if perm then -1 else 0

## Whether `s` holds a NUL byte, which no program or argument may.
fn os_has_nul(s str) bool
    p := str_addr(s)
    for i in 0..load64(p)
        if load8(p + 16 + i) == 0
            return true
    false

## `which(name)` (std.proc.3): the path as a string, or 0 for `none`.
fn proc_which(name str) int
    pol_proc(name, "proc.which")
    c := proc_find(name)
    if c <= 0
        return 0
    str_addr(os_str_from(c, os_c_len(c)))

# ---- running it (std.proc.1-2) ----

## Fail with `proc.ProcError(cmd: "C", kind: "K")` (err.text.1); 0.
fn proc_fail(cmd str, kind str, at str) int
    sb_reset()
    sb_text("proc.ProcError(cmd: ")
    os_put_quoted(cmd)
    sb_text(", kind: ")
    kind_put("proc.ProcKind", kind)
    sb_byte(41)
    err_set(sb_str(), at)
    # The value, a `proc.ProcError(cmd, kind)` struct (ADR 0804, ADR 1068).
    e := obj_new(16, PROC_STRUCT)
    store64(e, str_addr(cmd))
    store64(e + 8, kind_word(proc_kinds(), kind))
    err_value(e)
    err_tag(err_tag_of("proc.ProcError"))
    0

fn proc_pipe(at int) int
    if target() == 2
        # No `pipe2`: `pipe`, then close-on-exec on both ends.
        r := import_call("_pipe", at, 0, 0, 0)
        if r < 0
            return -1
        w := load64(at)
        syscall(92, w.bit_and(4294967295), 2, 1, 0, 0, 0)
        syscall(92, w.shr(32), 2, 1, 0, 0, 0)
        return 0
    syscall(os_pick(293, 59, 0), at, 524288, 0, 0, 0, 0)

## Ignore SIGPIPE (a write to a gone reader is an error, not a signal); the
## old action.
fn proc_sigpipe_ignore(st int) int
    if target() == 2
        return import_call("_signal", 13, 1, 0, 0)
    store64(st + 96, 1)
    store64(st + 104, 0)
    store64(st + 112, 0)
    store64(st + 120, 0)
    syscall(os_pick(13, 134, 0), 13, st + 96, st + 128, 8, 0, 0)
    0

fn proc_sigpipe_restore(st int, old int)
    if target() == 2
        import_call("_signal", 13, old, 0, 0)
        return
    syscall(os_pick(13, 134, 0), 13, st + 128, 0, 8, 0, 0)

## Poll the three descriptors at `pfd` for `ms` milliseconds (negative: no
## limit). `ts` is 16 bytes of scratch for the timeout.
fn proc_poll(pfd int, ms int, ts int) int
    if target() == 2
        return syscall(230, pfd, 3, ms, 0, 0, 0)
    mut tp := 0
    if ms >= 0
        store64(ts, ms / 1000)
        store64(ts + 8, ms % 1000 * 1000000)
        tp = ts
    syscall(os_pick(271, 73, 0), pfd, 3, tp, 0, 8, 0)

fn proc_close(fd int)
    if fd >= 0
        os_close(fd)

## The buffer `s` (a string object holding `n` bytes) in a new one twice as big.
fn proc_widen(s int, n int, cap int) int
    t := str_new(cap * 2, 0)
    copy_bytes(t + 16, s + 16, n)
    t

## Reap `pid`; its wait status. With `deadline` (milliseconds on the
## `time.now_ms` clock) it polls and gives -1 when the time is up first.
fn proc_wait(pid int, st int, deadline int) int
    store64(st, 0)
    if deadline < 0
        while true
            r := syscall(os_pick(61, 260, 7), pid, st, 0, 0, 0, 0)
            if r != -4
                break
        return load64(st)
    mut nap := 1
    while true
        r := syscall(os_pick(61, 260, 7), pid, st, 1, 0, 0, 0)
        if r == pid or r < -4 or r == -10
            return load64(st)
        if r == 0 and time_now_ms() >= deadline
            return -1
        if r == 0
            time_sleep_ms(nap)
            if nap < 10
                nap += 1
    0

## Start `cmd` with `args` on three pipes (std.proc.1, ADR 0770): the child's
## process id, with the parent's ends of its standard input, output and error
## at `st + 32`, `+ 40` and `+ 48` (`st` is a 256-byte scratch block). 0 with
## the error slot set when it can't start. `opts` is a `proc.RunOptions` or 0
## (std.proc.11-13): the child changes to its `cwd` and gets the environment
## `proc_envp` builds.
fn proc_launch(cmd str, args List[int], at str, st int, opts int) int
    exe := proc_find(proc_opt_cmd(cmd, opts))
    if exe <= 0
        return proc_fail(cmd, if exe < 0 then "permission" else "not_found", at)
    # The argument vector, in an object whose words are scanned.
    al := list_addr(args)
    nargs := load64(al)
    data := load64(al + 16)
    argv := alloc(8 * (nargs + 2), PROC_STRUCT)
    c0 := proc_cstr(cmd)
    if c0 == 0
        return proc_fail(cmd, "other", at)
    store64(argv, c0)
    for i in 0..nargs
        c := proc_cstr(str_at(load64(data + 8 * i)))
        if c == 0
            return proc_fail(cmd, "other", at)
        store64(argv + 8 * (i + 1), c)
    store64(argv + 8 * (nargs + 1), 0)
    mut envp := os_envp()
    mut wd := 0
    if opts != 0
        envp = proc_envp(cmd, opts, at)
        if envp == 0
            return 0
        if load64(opts) != 0
            wd = proc_cstr(str_at(load64(opts)))
            if wd == 0
                return proc_fail(str_at(load64(opts)), "other", at)
    # st: pipes at 0 (stdin), 8 (stdout), 16 (stderr), 24 (exec status); the
    # rest is scratch for the loop.
    for k in 0..4
        if proc_pipe(st + 8 * k) < 0
            for j in 0..k
                w := load64(st + 8 * j)
                os_close(w.bit_and(4294967295))
                os_close(w.shr(32))
            return proc_fail(cmd, "other", at)
    in_w := load64(st).shr(32)
    in_r := load64(st).bit_and(4294967295)
    out_r := load64(st + 8).bit_and(4294967295)
    out_w := load64(st + 8).shr(32)
    err_r := load64(st + 16).bit_and(4294967295)
    err_w := load64(st + 16).shr(32)
    sta_r := load64(st + 24).bit_and(4294967295)
    sta_w := load64(st + 24).shr(32)
    flush()
    pid := if target() == 2 then import_call("_fork", 0, 0, 0, 0) else syscall(
        os_pick(56, 220, 0),
        17,
        0,
        0,
        0,
        0,
        0,
    )
    if pid == 0
        # PR_SET_PDEATHSIG, SIGKILL: no child outlives its parent (std.proc.7).
        if target() != 2
            syscall(os_pick(157, 167, 0), 1, 9, 0, 0, 0, 0)
        syscall(os_pick(292, 24, 90), in_r, 0, 0, 0, 0, 0)
        syscall(os_pick(292, 24, 90), out_w, 1, 0, 0, 0)
        syscall(os_pick(292, 24, 90), err_w, 2, 0, 0, 0)
        # std.proc.12: a `cwd` that can't be entered is reported with bit 32 set.
        if wd != 0
            c := syscall(os_pick(80, 49, 12), wd, 0, 0, 0, 0, 0)
            if c < 0
                store64(st + 64, (0 - c).bit_or(4294967296))
                syscall(os_pick(1, 64, 4), sta_w, st + 64, 8, 0, 0, 0)
                syscall(os_pick(231, 94, 1), 127, 0, 0, 0, 0, 0)
        r := syscall(os_pick(59, 221, 59), exe, argv, envp, 0, 0, 0)
        store64(st + 64, 0 - r)
        syscall(os_pick(1, 64, 4), sta_w, st + 64, 8, 0, 0, 0)
        syscall(os_pick(231, 94, 1), 127, 0, 0, 0, 0, 0)
    os_close(in_r)
    os_close(out_w)
    os_close(err_w)
    os_close(sta_w)
    if pid < 0
        os_close(in_w)
        os_close(out_r)
        os_close(err_r)
        os_close(sta_r)
        return proc_fail(cmd, kind_name(os_errno_kind(0 - pid)), at)
    # An `execve` that failed writes its `errno`; one that worked closes the pipe.
    store64(st + 72, 0)
    mut got := 0
    while true
        got = os_read(sta_r, st + 72, 8)
        if got != -4
            break
    os_close(sta_r)
    if got == 8
        proc_wait(pid, st + 200, -1)
        os_close(in_w)
        os_close(out_r)
        os_close(err_r)
        code := load64(st + 72)
        if code.shr(32) == 1
            # std.proc.12: the error names the directory, not the program.
            why := kind_name(os_errno_kind(code.bit_and(4294967295)))
            return proc_fail(str_at(load64(opts)), why, at)
        return proc_fail(cmd, kind_name(os_errno_kind(code)), at)
    store64(st + 32, in_w)
    store64(st + 40, out_r)
    store64(st + 48, err_r)
    pid

## `run(cmd, args, input, timeout_ms)` (std.proc.1-2): the `Output` object,
## or 0 with the error slot set. `input` is a string or 0, `timeout` a boxed
## integer or 0.
fn proc_run(cmd str, args List[int], input int, timeout int, at str) int
    proc_run_core(cmd, args, input, timeout, at, false, 0)

## `run_bytes(cmd, args, input, timeout_ms)` (std.proc.8): `run` with `bytes`
## in and out, a `RawOutput` with the streams undecoded.
fn proc_run_bytes(cmd str, args List[int], input int, timeout int, at str) int
    proc_run_core(cmd, args, input, timeout, at, true, 0)

## `run`, `run_bytes` and their `_with` forms: `opts` is a `proc.RunOptions` or 0.
fn proc_run_core(cmd str, args List[int], input int, timeout int, at str, raw bool, opts int) int
    pol_proc(cmd, "proc.run")
    if target() == 3
        return win_proc_run(cmd, args, input, timeout, at, raw, opts)
    mut limit := -1
    if timeout != 0
        limit = unbox(timeout)
        if limit < 0
            os_usage_trap("std.proc.2", str_cat(
                str_cat("can't time out after ", fmt_int(limit)),
                " milliseconds",
            ))
    st := alloc(256, KIND_BYTES)
    pid := proc_launch(cmd, args, at, st, opts)
    if pid == 0
        return 0
    in_w := load64(st + 32)
    out_r := load64(st + 40)
    err_r := load64(st + 48)
    # Writing to a pipe whose reader is gone must be an error, not SIGPIPE;
    # the old action comes back at the end.
    old_pipe := proc_sigpipe_ignore(st)
    mut ifd := in_w
    mut ofd := out_r
    mut efd := err_r
    mut inpos := 0
    mut ilen := 0
    if input != 0
        ilen = load64(input)
    if ilen == 0
        os_close(ifd)
        ifd = -1
    else
        # F_SETFL, O_NONBLOCK
        syscall(os_pick(72, 25, 92), ifd, 4, os_pick(2048, 2048, 4), 0, 0, 0)
    mut ob := str_new(PROC_CHUNK, 0)
    mut oc := PROC_CHUNK
    mut on := 0
    mut eb := str_new(PROC_CHUNK, 0)
    mut ec := PROC_CHUNK
    mut en := 0
    mut deadline := -1
    if limit >= 0
        deadline = time_now_ms() + limit
    mut timed_out := false
    pfd := st + 160
    ts := st + 184
    while ifd >= 0 or ofd >= 0 or efd >= 0
        store64(pfd, ifd.bit_and(4294967295).bit_or(17179869184))
        store64(pfd + 8, ofd.bit_and(4294967295).bit_or(4294967296))
        store64(pfd + 16, efd.bit_and(4294967295).bit_or(4294967296))
        mut left := -1
        if deadline >= 0
            left = deadline - time_now_ms()
            if left <= 0
                timed_out = true
                break
        r := proc_poll(pfd, left, ts)
        if r == -4 or r == 0
            continue
        if r < 0
            break
        wi := load64(pfd).shr(48).bit_and(65535)
        if ifd >= 0 and wi != 0
            if wi.bit_and(24) != 0
                os_close(ifd)
                ifd = -1
            else
                mut want := ilen - inpos
                if want > PROC_CHUNK
                    want = PROC_CHUNK
                w := syscall(os_pick(1, 64, 4), ifd, input + 16 + inpos, want, 0, 0, 0)
                if w > 0
                    inpos += w
                if inpos >= ilen or (w < 0 and w != -4 and w != 0 - os_pick(11, 11, 35))
                    os_close(ifd)
                    ifd = -1
        ro := load64(pfd + 8).shr(48).bit_and(65535)
        if ofd >= 0 and ro != 0
            if on == oc
                ob = proc_widen(ob, on, oc)
                oc = oc * 2
            n := os_read(ofd, ob + 16 + on, oc - on)
            if n == 0 or (n < 0 and n != -4 and n != 0 - os_pick(11, 11, 35))
                os_close(ofd)
                ofd = -1
            elif n > 0
                on += n
        re := load64(pfd + 16).shr(48).bit_and(65535)
        if efd >= 0 and re != 0
            if en == ec
                eb = proc_widen(eb, en, ec)
                ec = ec * 2
            n := os_read(efd, eb + 16 + en, ec - en)
            if n == 0 or (n < 0 and n != -4 and n != 0 - os_pick(11, 11, 35))
                os_close(efd)
                efd = -1
            elif n > 0
                en += n
    proc_close(ifd)
    proc_close(ofd)
    proc_close(efd)
    proc_sigpipe_restore(st, old_pipe)
    mut status := 0
    if not timed_out
        status = proc_wait(pid, st + 200, deadline)
    if timed_out or status < 0
        syscall(os_pick(62, 129, 37), pid, 9, 0, 0, 0, 0)
        proc_wait(pid, st + 200, -1)
        return proc_fail(cmd, "timed_out", at)
    mut code := 128 + status.bit_and(127)
    if status.bit_and(127) == 0
        code = status.shr(8).bit_and(255)
    store64(ob, on)
    store64(eb, en)
    if raw
        store64(ob + 8, on)
        store64(eb + 8, en)
    out := if raw then str_at(ob) else os_lossy(ob)
    err := if raw then str_at(eb) else os_lossy(eb)
    r := obj_new(24, PROC_STRUCT)
    store64(r, code)
    store64(r + 8, str_addr(out))
    store64(r + 16, str_addr(err))
    r

# ---- a started child (std.proc.4-7) ----
#
# `start` gives a child whose three streams are `Channel[str]`s whose `source`
# word points at one state object, so a receiver that finds its queue empty
# calls `chan_pump` (chan.ail), which polls the child's pipes and queues what
# arrives on both streams: a child is never blocked by a stream nobody reads,
# and no thread is needed for it. The state object's words:
PS_LOCK := 0
PS_PID := 8
PS_IN := 16
PS_OUT := 24
PS_ERR := 32
PS_INCH := 40
PS_OUTCH := 48
PS_ERRCH := 56
PS_OBUF := 64
PS_ON := 72
PS_EBUF := 80
PS_EN := 88
PS_DEAD := 96
PS_TIMED := 104
PS_DONE := 112
PS_STATUS := 120
PS_PROG := 128
PS_CMD := 136
PS_INLOCK := 144
PS_RAW := 152
## The child's number in a recording, 0 when none is made (record.ail).
PS_SEQ := 168
PS_SIZE := 184
# The `source` word of a channel record (chan.ail).
CH_SOURCE := 48

## Queue the `n` bytes at `p` as a line of channel `ch`.
fn ps_push(ps int, ch int, p int, n int)
    s := str_new(n, 0)
    copy_bytes(s + 16, p, n)
    line := os_lossy(s)
    chan_push(ch, line)
    if load64(ps + PS_SEQ) != 0
        rec_stream_line(load64(ps + PS_SEQ), if ch == load64(ps + PS_OUTCH) then 0 else 1, line)
    store64(ps + PS_PROG, load64(ps + PS_PROG) + 1)

## Queue the complete lines of stream `k` (0 output, 1 error), and with `last`
## a final one with no end too. A line ends at `\n` or `\r\n` (std.proc.5).
fn ps_lines(ps int, k int, last bool)
    buf := load64(ps + PS_OBUF + 16 * k)
    n := load64(ps + PS_ON + 16 * k)
    ch := load64(ps + PS_OUTCH + 8 * k)
    mut from := 0
    mut i := 0
    while i < n
        if load8(buf + 16 + i) == 10
            mut end := i
            if end > from and load8(buf + 16 + end - 1) == 13
                end -= 1
            ps_push(ps, ch, buf + 16 + from, end - from)
            from = i + 1
        i += 1
    if last and from < n
        ps_push(ps, ch, buf + 16 + from, n - from)
        from = n
    if from > 0
        copy_bytes(buf + 16, buf + 16 + from, n - from)
        store64(ps + PS_ON + 16 * k, n - from)

## The end of stream `k`: its last line, then the channel is closed.
fn ps_eof(ps int, k int)
    ps_lines(ps, k, true)
    store64(ps + PS_OUT + 8 * k, -1)
    chan_mark_closed(load64(ps + PS_OUTCH + 8 * k))
    if load64(ps + PS_SEQ) != 0
        rec_stream_end(load64(ps + PS_SEQ), k)
    store64(ps + PS_PROG, load64(ps + PS_PROG) + 1)

## One nonblocking read of stream `k`, under the lock: 1 when it read, 0 when
## nothing is there yet, -1 at the end of the stream.
fn ps_read(ps int, k int) int
    fd := load64(ps + PS_OUT + 8 * k)
    if fd < 0
        return -1
    mut buf := load64(ps + PS_OBUF + 16 * k)
    n := load64(ps + PS_ON + 16 * k)
    mut cap := load64(buf)
    if n == cap
        buf = proc_widen(buf, n, cap)
        store64(ps + PS_OBUF + 16 * k, buf)
        cap = cap * 2
    r := if target() == 3 then win_read_nb(
        fd,
        buf + 16 + n,
        cap - n,
    ) else os_read(fd, buf + 16 + n, cap - n)
    if r > 0
        store64(ps + PS_ON + 16 * k, n + r)
        ps_lines(ps, k, false)
        return 1
    if r == -4 or r == 0 - os_pick(11, 11, 35)
        return 0
    ps_eof(ps, k)
    -1

## Read what is there on both streams until nothing more is, then end any
## stream still open: the child has been reaped, so no more comes.
fn ps_drain(ps int)
    lock(ps + PS_LOCK)
    for k in 0..2
        while ps_read(ps, k) == 1
            continue
        if load64(ps + PS_OUT + 8 * k) >= 0
            ps_eof(ps, k)
    unlock(ps + PS_LOCK)

## One poll of the child's streams (and of its input with `want_in`), for at
## most `ms` milliseconds (negative: until something is ready), then a read
## of each stream that is ready.
fn ps_round(ps int, want_in bool, ms int)
    if target() == 3
        win_ps_round(ps, ms)
        return
    pf := alloc(48, KIND_BYTES)
    mut ifd := -1
    if want_in
        ifd = load64(ps + PS_IN)
    store64(pf, ifd.bit_and(4294967295).bit_or(17179869184))
    store64(pf + 8, load64(ps + PS_OUT).bit_and(4294967295).bit_or(4294967296))
    store64(pf + 16, load64(ps + PS_ERR).bit_and(4294967295).bit_or(4294967296))
    multi := load64(global(MULTI)) != 0
    mut parked := 0
    if multi
        parked = blocked_enter()
    r := proc_poll(pf, ms, pf + 24)
    if multi
        blocked_leave(parked)
    if r <= 0
        return
    ro := load64(pf + 8).shr(48)
    re := load64(pf + 16).shr(48)
    if ro != 0 or re != 0
        lock(ps + PS_LOCK)
        if ro != 0
            ps_read(ps, 0)
        if re != 0
            ps_read(ps, 1)
        unlock(ps + PS_LOCK)

## Reap the child if it has exited, without waiting; true once it is reaped.
fn ps_reap(ps int) bool
    lock(ps + PS_LOCK)
    if load64(ps + PS_DONE) == 0 and target() == 3
        raw := win_exit_raw(load64(ps + PS_PID))
        if raw >= 0
            store64(ps + PS_STATUS, raw)
            store64(ps + PS_DONE, 1)
    elif load64(ps + PS_DONE) == 0
        w := alloc(8, KIND_BYTES)
        r := syscall(os_pick(61, 260, 7), load64(ps + PS_PID), w, 1, 0, 0, 0)
        if r == load64(ps + PS_PID) or r < -4
            store64(ps + PS_STATUS, if r < 0 then 0 else load64(w))
            store64(ps + PS_DONE, 1)
    done := load64(ps + PS_DONE) != 0
    unlock(ps + PS_LOCK)
    if done
        ps_drain(ps)
    done

## End the child `id` (a process id; on Windows a process handle) at once.
fn proc_kill9(id int)
    if target() == 3
        win_kill(id)
        return
    syscall(os_pick(62, 129, 37), id, 9, 0, 0, 0, 0)

## Kill the child once its time limit has passed (std.proc.4).
fn ps_check_deadline(ps int)
    d := load64(ps + PS_DEAD)
    if d >= 0 and load64(ps + PS_TIMED) == 0 and load64(ps + PS_DONE) == 0
        if time_now_ms() >= d
            store64(ps + PS_TIMED, 1)
            proc_kill9(load64(ps + PS_PID))

## How long one poll may last: until the time limit, and at most 100 ms so a
## child that exited with its pipes still held open is noticed.
fn ps_poll_ms(ps int) int
    d := load64(ps + PS_DEAD)
    if d < 0 or load64(ps + PS_TIMED) != 0
        return 100
    left := d - time_now_ms()
    if left < 0
        return 0
    if left > 100
        return 100
    left

## `chan_pump` (chan.ail): block until a line has been queued on or a stream
## has ended on either stream of the child that channel `ch` belongs to.
fn chan_pump(ch int)
    ps := load64(ch + CH_SOURCE)
    if sig_is(ps)
        sig_pump(ch, -1)
        return
    seen := load64(ps + PS_PROG)
    while load64(ps + PS_PROG) == seen
        if ps_reap(ps)
            return
        ps_check_deadline(ps)
        ps_round(ps, false, ps_poll_ms(ps))

## One round of `chan_pump` that waits at most `ms` milliseconds
## (`recv_for`, conc.share.8, ADR 0996).
fn chan_pump_ms(ch int, ms int)
    ps := load64(ch + CH_SOURCE)
    if sig_is(ps)
        sig_pump(ch, ms)
        return
    if ps_reap(ps)
        return
    ps_check_deadline(ps)
    p := ps_poll_ms(ps)
    ps_round(ps, false, if ms < p then ms else p)

## Whether `recv` on `ch` would return at once (std.ui, ADR 0863): a value is
## queued or the channel is closed. A child's output is read first, without
## waiting.
fn chan_ready(ch int) bool
    lock(ch + C_LOCK)
    mut ready := load64(ch + C_COUNT) > 0 or load64(ch + C_CLOSED) != 0
    unlock(ch + C_LOCK)
    if ready or load64(ch + CH_SOURCE) == 0
        return ready
    if sig_is(load64(ch + CH_SOURCE))
        sig_poll(load64(ch + CH_SOURCE), ch)
    else
        ps_round(load64(ch + CH_SOURCE), false, 0)
    lock(ch + C_LOCK)
    ready = load64(ch + C_COUNT) > 0 or load64(ch + C_CLOSED) != 0
    unlock(ch + C_LOCK)
    ready

## `c.stdin.send(text)` (std.proc.5): write it all, polling the output
## meanwhile so a child that writes as it reads is never stuck. A child that
## has gone is not an error.
fn chan_source_send(ch int, s int)
    ps := load64(ch + CH_SOURCE)
    if sig_is(ps)
        return
    p := s
    n := load64(p)
    lock(ps + PS_INLOCK)
    mut off := 0
    while off < n
        fd := load64(ps + PS_IN)
        if fd < 0
            break
        w := if target() == 3 then win_write(fd, p + 16 + off, n - off) else syscall(
            os_pick(1, 64, 4),
            fd,
            p + 16 + off,
            n - off,
            0,
            0,
            0,
        )
        if w > 0
            off += w
        elif w == 0 - os_pick(11, 11, 35)
            ps_round(ps, true, 100)
        elif w != -4
            os_close(fd)
            store64(ps + PS_IN, -1)
    unlock(ps + PS_INLOCK)

## `c.stdin.close()`: end the child's input.
fn chan_source_close(ch int)
    ps := load64(ch + CH_SOURCE)
    if sig_is(ps)
        sig_close(ch)
        return
    if ch != load64(ps + PS_INCH)
        return
    lock(ps + PS_INLOCK)
    fd := load64(ps + PS_IN)
    if fd >= 0
        os_close(fd)
        store64(ps + PS_IN, -1)
    unlock(ps + PS_INLOCK)

## `start(cmd, args, timeout_ms)` (std.proc.4): the `Child` object (pid, then
## the channels `stdin`, `out` and `err`), or 0 with the error slot set.
## `timeout` is a boxed integer or 0.
fn proc_start(cmd str, args List[int], timeout int, at str) int
    proc_start_core(cmd, args, timeout, at, 0)

## `start` and `start_with`: `opts` is a `proc.RunOptions` or 0.
fn proc_start_core(cmd str, args List[int], timeout int, at str, opts int) int
    pol_proc(cmd, "proc.start")
    mut limit := -1
    if timeout != 0
        limit = unbox(timeout)
        if limit < 0
            os_usage_trap("std.proc.4", str_cat(
                str_cat("can't time out after ", fmt_int(limit)),
                " milliseconds",
            ))
    st := alloc(256, KIND_BYTES)
    pid := if target() == 3 then win_launch(
        cmd,
        args,
        at,
        st,
        1048576,
        opts,
    ) else proc_launch(cmd, args, at, st, opts)
    if pid == 0
        return 0
    # A write to a child that has gone is an error, not SIGPIPE; every end
    # of ours is nonblocking (on Windows the reads peek first instead).
    if target() != 3
        proc_sigpipe_ignore(st)
        for k in 0..3
            syscall(
                os_pick(72, 25, 92),
                load64(st + 32 + 8 * k),
                4,
                os_pick(2048, 2048, 4),
                0,
                0,
                0,
            )
    ps := alloc(PS_SIZE, PROC_STRUCT)
    store64(ps + PS_PID, pid)
    store64(ps + PS_IN, load64(st + 32))
    store64(ps + PS_OUT, load64(st + 40))
    store64(ps + PS_ERR, load64(st + 48))
    store64(ps + PS_RAW, load64(st + 40))
    store64(ps + PS_RAW + 8, load64(st + 48))
    store64(ps + PS_OBUF, str_new(4096, 0))
    store64(ps + PS_EBUF, str_new(4096, 0))
    store64(ps + PS_DEAD, if limit >= 0 then time_now_ms() + limit else -1)
    store64(ps + PS_CMD, str_addr(cmd))
    c := alloc(32, PROC_STRUCT)
    # The process id the program sees; on Windows `pid` is the process handle.
    store64(c, if target() == 3 then load64(st + 56) else pid)
    for k in 0..3
        ch := chan_new()
        store64(ch + CH_SOURCE, ps)
        store64(c + 8 + 8 * k, ch)
        store64(ps + PS_INCH + 8 * k, ch)
    c

## The status of a reaped child as `run` reports it (std.proc.1).
fn ps_code(raw int) int
    if raw.bit_and(127) == 0
        return raw.shr(8).bit_and(255)
    128 + raw.bit_and(127)

## Close the child's pipes once it is reaped.
fn ps_close(ps int)
    for k in 0..2
        os_close(load64(ps + PS_RAW + 8 * k))
        store64(ps + PS_RAW + 8 * k, -1)
    fd := load64(ps + PS_IN)
    if fd >= 0
        os_close(fd)
        store64(ps + PS_IN, -1)
    if target() == 3 and load64(ps + PS_PID) > 0
        win_close_h(load64(ps + PS_PID))
        store64(ps + PS_PID, -1)

## `wait(move c)` (std.proc.6): the status, or 0 with the error slot set when
## the time limit killed the child. Other tasks run while it waits, and what
## the child wrote stays readable from `out` and `err`.
fn proc_wait_child(c int, at str) int
    ps := load64(load64(c + 8) + CH_SOURCE)
    while not ps_reap(ps)
        ps_check_deadline(ps)
        ps_round(ps, false, ps_poll_ms(ps))
    ps_close(ps)
    if load64(ps + PS_TIMED) != 0
        return proc_fail(str_at(load64(ps + PS_CMD)), "timed_out", at)
    ps_code(load64(ps + PS_STATUS))

## `kill(move c)` (std.proc.7): end the child at once, reap it, and give its
## status (137 on Unix).
fn proc_kill_child(c int) int
    ps := load64(load64(c + 8) + CH_SOURCE)
    if load64(ps + PS_DONE) == 0
        proc_kill9(load64(ps + PS_PID))
    while not ps_reap(ps)
        ps_round(ps, false, 10)
    ps_close(ps)
    ps_code(load64(ps + PS_STATUS))

# ---- options (std.proc.11-15, ADR 1213) ----
#
# A `proc.RunOptions` is a struct object of six words: `cwd` (a string or 0),
# `env` (a `Map[str, str]`), `clear_env`, `input` (a string or 0), `data`
# (bytes or 0) and `timeout_ms` (a boxed integer or 0).
PO_CWD := 0
PO_ENV := 8
PO_CLEAR := 16
PO_INPUT := 24
PO_DATA := 32
PO_TIMEOUT := 40

## `proc.options()` (std.proc.11): no directory, no added variables, the
## environment inherited, no input and no time limit.
fn proc_options() int
    o := obj_new(48, PROC_STRUCT)
    store64(o + PO_ENV, map_new(1, 0, 0))
    o

## The input the options give (std.proc.11): `input` or `data`, whichever is
## set (`str` and `bytes` have one layout), or 0. Both set traps.
fn proc_opt_input(opts int, what str) int
    i := load64(opts + PO_INPUT)
    d := load64(opts + PO_DATA)
    if i != 0 and d != 0
        os_usage_trap("std.proc.11", str_cat(what, " has both `input` and `data`; set one"))
    if i != 0 then i else d

## `run_with(cmd, args, opts)` (std.proc.11): `run` with the options.
fn proc_run_with(cmd str, args List[int], opts int, at str) int
    input := proc_opt_input(opts, "`proc.run_with`")
    proc_run_core(cmd, args, input, load64(opts + PO_TIMEOUT), at, false, opts)

## `run_bytes_with(cmd, args, opts)` (std.proc.11): `run_bytes` with the options.
fn proc_run_bytes_with(cmd str, args List[int], opts int, at str) int
    input := proc_opt_input(opts, "`proc.run_bytes_with`")
    proc_run_core(cmd, args, input, load64(opts + PO_TIMEOUT), at, true, opts)

## `start_with(cmd, args, opts)` (std.proc.14): `start` with the options; a
## child's input goes through `c.stdin`, so `input` and `data` trap.
fn proc_start_with(cmd str, args List[int], opts int, at str) int
    if load64(opts + PO_INPUT) != 0 or load64(opts + PO_DATA) != 0
        os_usage_trap(
            "std.proc.14",
            "`proc.start_with` takes no `input` or `data`; send it with `c.stdin.send`",
        )
    proc_start_core(cmd, args, load64(opts + PO_TIMEOUT), at, opts)

## Whether the `n` bytes at `p` are an absolute path.
fn proc_abs(p int, n int) bool
    b := load8(p)
    if b == 47
        return true
    target() == 3 and (b == 92 or (n > 1 and load8(p + 1) == 58))

## The name `run_with` looks up (std.proc.12): `cmd`, or `cmd` under the
## options' `cwd` when it is a relative path (it has a separator).
fn proc_opt_cmd(cmd str, opts int) str
    if opts == 0 or load64(opts + PO_CWD) == 0
        return cmd
    p := str_addr(cmd)
    n := load64(p)
    if n == 0 or proc_abs(p + 16, n)
        return cmd
    mut sep := false
    for i in 0..n
        b := load8(p + 16 + i)
        if b == 47 or (target() == 3 and b == 92)
            sep = true
    if not sep
        return cmd
    path_join(str_at(load64(opts + PO_CWD)), cmd)

## Whether the map `m` has a key equal to the `n` bytes at `c` (letters folded on
## Windows, std.env.5).
fn proc_env_named(m int, c int, n int) bool
    for i in 0..load64(m + 8)
        e := map_ent(m, i)
        if e != 0
            k := load64(e + 8)
            if load64(k) == n
                mut same := true
                mut j := 0
                while same and j < n
                    if os_env_fold(load8(c + j)) != os_env_fold(load8(k + 16 + j))
                        same = false
                    j += 1
                if same
                    return true
    false

## The child's environment (std.proc.13): a scanned block of `NAME=VALUE` C
## strings ended by 0, the inherited variables first (none with `clear_env`)
## less those `env` names, then `env`'s. The program's own block when nothing
## changes; 0 with the error slot set when a variable holds a NUL.
fn proc_envp(cmd str, opts int, at str) int
    m := load64(opts + PO_ENV)
    cleared := load8(opts + PO_CLEAR) != 0
    added := if m == 0 then 0 else load64(m)
    if added == 0 and not cleared
        return os_envp()
    mut inherited := 0
    if not cleared
        mut q := os_envp()
        while load64(q) != 0
            inherited += 1
            q += 8
    envb := alloc(8 * (inherited + added + 1), PROC_STRUCT)
    mut k := 0
    if not cleared
        mut w := os_envp()
        while load64(w) != 0
            c := load64(w)
            len := os_c_len(c)
            mut eq := 0
            while eq < len and load8(c + eq) != 61
                eq += 1
            if added == 0 or not proc_env_named(m, c, eq)
                d := alloc(len + 1, KIND_BYTES)
                copy_bytes(d, c, len)
                store8(d + len, 0)
                store64(envb + 8 * k, d)
                k += 1
            w += 8
    if m != 0
        for i in 0..load64(m + 8)
            ent := map_ent(m, i)
            if ent != 0
                name := load64(ent + 8)
                value := load64(ent + 16)
                nn := load64(name)
                vn := load64(value)
                if nn == 0
                    os_usage_trap("std.proc.13", "an environment variable needs a name")
                for j in 0..nn
                    if load8(name + 16 + j) == 61
                        os_usage_trap("std.proc.13", str_cat3(
                            "the environment variable name `",
                            str_at(name),
                            "` holds `=`",
                        ))
                d := alloc(nn + vn + 2, KIND_BYTES)
                copy_bytes(d, name + 16, nn)
                store8(d + nn, 61)
                copy_bytes(d + nn + 1, value + 16, vn)
                store8(d + nn + 1 + vn, 0)
                for j in 0..(nn + vn + 1)
                    if load8(d + j) == 0
                        return proc_fail(cmd, "other", at)
                store64(envb + 8 * k, d)
                k += 1
    store64(envb + 8 * k, 0)
    envb

## `proc.pid()` (std.proc.15): this program's process id.
fn proc_pid() int
    if target() == 3
        return import_call("GetCurrentProcessId", 0, 0, 0, 0).bit_and(4294967295)
    syscall(os_pick(39, 172, 20), 0, 0, 0, 0, 0, 0)

## `os.hostname()` (std.os.5): the machine's host name, "" when the system
## gives none.
fn os_hostname() str
    buf := alloc(1024, KIND_BYTES)
    if target() == 3
        t := win_tmp()
        store64(t, 256)
        # ComputerNameDnsHostname
        if import_call("GetComputerNameExW", 1, buf, t, 0) == 0
            return ""
        dst := alloc(1024, KIND_BYTES)
        return os_str_from(dst, win_narrow(buf, dst))
    if target() == 2
        if import_call("_gethostname", buf, 256, 0, 0) != 0
            return ""
        store8(buf + 255, 0)
        return os_str_from(buf, os_c_len(buf))
    # uname: `nodename` is the second field of 65 bytes.
    if syscall(os_pick(63, 160, 0), buf, 0, 0, 0, 0, 0) < 0
        return ""
    os_str_from(buf + 65, os_c_len(buf + 65))
