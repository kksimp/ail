## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Sized integers (ADR 0834, type.num.15): the message of a conversion that
## doesn't fit. The compiler checks the range inline and calls this only on
## the failing path; the trap prints the string object it returns.

## The name of the kind with code `k` (`SIZED_KINDS` in lower_sized.ail).
fn sb_kind(k int)
    if k == 0
        sb_text("i8")
    elif k == 1
        sb_text("i16")
    elif k == 2
        sb_text("i32")
    elif k == 3
        sb_text("u8")
    elif k == 4
        sb_text("u16")
    elif k == 5
        sb_text("u32")
    elif k == 6
        sb_text("u64")
    else
        sb_text("int")

## A value of kind `k` in a message: unsigned for `u64`.
fn sb_value(v int, k int)
    if k == 6
        put_u64(v)
    else
        put_int(v)

## `a OP b`: `op` is the code of lower_sized.ail's `arith_code`.
fn sb_expr(a int, b int, op int, k int)
    sb_text("`")
    sb_value(a, k)
    if op == 0
        sb_text(" + ")
    elif op == 1
        sb_text(" - ")
    elif op == 2
        sb_text(" * ")
    elif op == 3
        sb_text(" / ")
    else
        sb_text(" % ")
    sb_value(b, k)
    sb_text("`")

## `300` doesn't fit in `u8`: `v` is the value, `k` the target's code.
fn sized_msg(v int, k int) int
    sb_reset()
    sb_text("`")
    # A kind of 16 or more says the value is a `u64`; the target is `k - 16`.
    sb_value(v, if k >= 16 then 6 else 0)
    sb_text("` doesn't fit in `")
    sb_kind(if k >= 16 then k - 16 else k)
    sb_text("`")
    str_addr(sb_str())

# ---- raw pointers and std.hw (ADR 0835) ----

## `hw.at` of the negative address -8 (unsafe.hw.2).
fn hw_negative_msg(a int) int
    sb_reset()
    sb_text("`hw.at` of the negative address ")
    put_int(a)
    str_addr(sb_str())

## access through a null pointer (address 8) (unsafe.ptr.4).
fn ptr_null_msg(a int) int
    sb_reset()
    sb_text("access through a null pointer (address ")
    put_int(a)
    sb_text(")")
    str_addr(sb_str())

## `read_volatile` of 4 bytes at an address that is not a multiple of 4
## (unsafe.hw.3); `w` is 1 for `write_volatile`.
fn ptr_align_msg(a int, width int, write int) int
    sb_reset()
    sb_text("`")
    sb_text(if write == 1 then "write_volatile" else "read_volatile")
    sb_text("` of ")
    put_int(width)
    sb_text(" bytes at an address that is not a multiple of ")
    put_int(width)
    str_addr(sb_str())

## `200 + 100` overflows `u8` (expr.arith.1, expr.arith.3).
fn sized_over_msg(a int, b int, op int, k int) int
    sb_reset()
    sb_expr(a, b, op, k)
    sb_text(" overflows `")
    sb_kind(k)
    sb_text("`")
    str_addr(sb_str())

## division by zero in `5 / 0` (expr.arith.3).
fn sized_zero_msg(a int, b int, op int, k int) int
    sb_reset()
    sb_text("division by zero in ")
    sb_expr(a, b, op, k)
    str_addr(sb_str())

## `-(-128)` overflows `i8` (type.num.14).
fn sized_neg_msg(a int, k int) int
    sb_reset()
    sb_text("`-(")
    put_int(a)
    sb_text(")` overflows `")
    sb_kind(k)
    sb_text("`")
    str_addr(sb_str())

## `(-128).abs()` overflows `i8` (type.num.14).
fn sized_abs_msg(a int, k int) int
    sb_reset()
    sb_text("`(")
    put_int(a)
    sb_text(").abs()` overflows `")
    sb_kind(k)
    sb_text("`")
    str_addr(sb_str())

## `to_f32` of an `int` (type.num.15): rounded to the nearest `f32` once, ties
## to even. Going through a `float` first would round twice, so a value of 54
## bits or more has its low bits folded into one sticky bit (round to odd)
## before the first conversion, which then cannot change the second.
fn int_to_f32(v int) float
    if v == -9223372036854775807 - 1
        return f32_round(v.to_float())
    neg := v < 0
    mut u := if neg then 0 - v else v
    mut shift := 0
    while u >= 9007199254740992
        sticky := if u % 2 == 1 then 1 else 0
        u = u.shr(1).bit_or(sticky)
        shift += 1
    mut x := u.to_float()
    for _ in 0..shift
        x = x * 2.0
    f32_round(if neg then 0.0 - x else x)

## `xs.sum()` of a list of a sized integer of kind `k` between `lo` and `hi` (type.coll.12):
## a partial sum outside the type traps.
fn list_sum_sized(xs List[int], lo int, hi int, k int, head str, tail str) int
    p := list_addr(xs)
    data := load64(p + 16)
    mut s := 0
    for i in 0..load64(p)
        s += load64(data + 8 * i)
        if s < lo or s > hi
            flush()
            out_str(head)
            sb_reset()
            sb_text("`sum` overflows `")
            sb_kind(k)
            sb_text("`\n")
            out_str(sb_str())
            out_str(tail)
            trace_frames(tail)
            flush_to(2)
            sys_exit(1)
    s
