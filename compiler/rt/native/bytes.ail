## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `bytes` (type.bytes.*, ADR 0702). A bytes object has a string object's
## layout, +0 length in bytes, +8 the same length, +16 the data, so `len`,
## the allocator and the collector treat it like a string. A `bytes` literal
## is built from its hex digits at the point of use.

fn hex_val(c int) int
    if c >= 97
        return c - 87
    if c >= 65
        return c - 55
    c - 48

## The `bytes` of a literal's hex digits (lex.bytes.1).
fn bytes_from_hex(h str) str
    q := str_addr(h)
    n := load64(q) / 2
    p := str_new(n, n)
    mut i := 0
    while i < n
        store8(p + 16 + i, hex_val(load8(q + 16 + 2 * i)) * 16 + hex_val(load8(q + 17 + 2 * i)))
        i += 1
    str_at(p)

## `for b in bytes`: the bytes as a list of `u8` (one byte each, ADR 0907).
fn bytes_list(b str) List[int]
    p := str_addr(b)
    n := load64(p)
    xs := list_alloc(n, 1)
    q := list_addr(xs)
    copy_bytes(load64(q + 16), p + 16, n)
    store64(q, n)
    xs

## `bytes.from_list(xs)` (type.bytes.7): the bytes of a `List[u8]`.
fn bytes_from_list(xs List[int]) str
    q := list_addr(xs)
    n := load64(q)
    p := str_new(n, n)
    copy_bytes(p + 16, load64(q + 16), n)
    str_at(p)

## `b[i]`, after the caller checked the bounds (type.bytes.3).
fn bytes_at(b str, i int) int
    load8(str_addr(b) + 16 + i)

## `b[lo..hi]`, after the caller checked the bounds (type.bytes.4).
fn bytes_slice(b str, lo int, hi int) str
    n := hi - lo
    p := str_new(n, n)
    copy_bytes(p + 16, str_addr(b) + 16 + lo, n)
    str_at(p)

## `a == b`, and `a != b` (type.bytes.2).
fn bytes_eq(a str, b str) bool
    p := str_addr(a)
    q := str_addr(b)
    n := load64(p)
    if n != load64(q)
        return false
    mut i := 0
    while i < n
        if load8(p + 16 + i) != load8(q + 16 + i)
            return false
        i += 1
    true

## `a < b` and the rest (type.bytes.2): -1, 0 or 1, comparing byte by byte,
## the shorter first when one is a prefix of the other.
fn bytes_cmp(a str, b str) int
    p := str_addr(a)
    q := str_addr(b)
    n := load64(p)
    m := load64(q)
    k := if n < m then n else m
    mut i := 0
    while i < k
        x := load8(p + 16 + i)
        y := load8(q + 16 + i)
        if x != y
            return if x < y then -1 else 1
        i += 1
    if n == m
        return 0
    if n < m then -1 else 1

## `bytes.zeros(n)` (type.bytes.13): `n` zero bytes, 0 to 2^32.
fn bytes_zeros(n int, head str, tail str) str
    if n < 0 or n > 4294967296
        str_trap(8, n, 0, 0, head, tail)
    p := str_new(n, n)
    mut i := 0
    while i < n
        store8(p + 16 + i, 0)
        i += 1
    str_at(p)

## `b.hex(sep)` (type.bytes.14): the two digits of each byte, `sep` between.
fn bytes_hex_sep(b str, sep str) str
    p := str_addr(b)
    n := load64(p)
    sb_reset()
    mut i := 0
    while i < n
        if i > 0
            sb_text(sep)
        c := load8(p + 16 + i)
        sb_byte(hex_digit(c / 16))
        sb_byte(hex_digit(c % 16))
        i += 1
    sb_str()

## `b` as the interpreter shows bytes inside a value: `b"hi\n"`.
fn bytes_quoted(b str) str
    p := str_addr(b)
    n := load64(p)
    sb_reset()
    sb_byte(98)
    sb_byte(34)
    mut i := 0
    while i < n
        c := load8(p + 16 + i)
        if c == 34 or c == 92
            sb_byte(92)
            sb_byte(c)
        elif c == 10
            sb_text("\\n")
        elif c == 9
            sb_text("\\t")
        elif c == 13
            sb_text("\\r")
        elif c < 32 or c >= 127
            sb_text("\\x")
            sb_byte(hex_digit(c / 16))
            sb_byte(hex_digit(c % 16))
        else
            sb_byte(c)
        i += 1
    sb_byte(34)
    sb_str()

## `print(b)` for bytes.
fn out_bytes_lit(b str)
    out_str(bytes_quoted(b))

## `b.hex()` (type.bytes.11): lowercase, two digits a byte.
fn bytes_hex(b str) str
    p := str_addr(b)
    n := load64(p)
    s := str_new(2 * n, 2 * n)
    mut i := 0
    while i < n
        c := load8(p + 16 + i)
        store8(s + 16 + 2 * i, hex_digit(c / 16))
        store8(s + 17 + 2 * i, hex_digit(c % 16))
        i += 1
    str_at(s)

## Whether byte `c` is a continuation byte between `lo` and `hi`.
fn utf8_in(c int, lo int, hi int) bool
    c >= lo and c <= hi

## The scalar starting at `i`: its length in bytes, or minus the length of
## the invalid prefix that `text` replaces with one U+FFFD (as Rust does).
fn utf8_step(p int, i int, n int) int
    c := load8(p + 16 + i)
    if c < 128
        return 1
    mut need := 0
    mut lo := 128
    mut hi := 191
    if c >= 194 and c <= 223
        need = 1
    elif c >= 224 and c <= 239
        need = 2
        if c == 224
            lo = 160
        if c == 237
            hi = 159
    elif c >= 240 and c <= 244
        need = 3
        if c == 240
            lo = 144
        if c == 244
            hi = 143
    else
        return -1
    mut k := 1
    while k <= need
        if i + k >= n
            return -k
        d := load8(p + 16 + i + k)
        if not utf8_in(d, lo, hi)
            return -k
        lo = 128
        hi = 191
        k += 1
    need + 1

## `b.text()` (type.bytes.8): UTF-8, each invalid sequence as U+FFFD.
fn bytes_text(b str) str
    p := str_addr(b)
    n := load64(p)
    mut out := 0
    mut chars := 0
    mut i := 0
    while i < n
        k := utf8_step(p, i, n)
        if k > 0
            out += k
            i += k
        else
            out += 3
            i -= k
        chars += 1
    s := str_new(out, chars)
    mut o := s + 16
    i = 0
    while i < n
        k := utf8_step(p, i, n)
        if k > 0
            copy_bytes(o, p + 16 + i, k)
            o += k
            i += k
        else
            store8(o, 239)
            store8(o + 1, 191)
            store8(o + 2, 189)
            o += 3
            i -= k
    str_at(s)

## The literal form `b"..."` of `b` (type.bytes.2): printable ASCII as itself, `\" \\ \n \t \r`
## as escapes, every other byte as `\xHH`.
fn bytes_show(b str) str
    p := str_addr(b)
    n := load64(p)
    mut size := 3
    mut i := 0
    while i < n
        size += bytes_show_width(load8(p + 16 + i))
        i += 1
    s := str_new(size, size)
    store8(s + 16, 98)
    store8(s + 17, 34)
    mut at := s + 18
    i = 0
    while i < n
        c := load8(p + 16 + i)
        w := bytes_show_width(c)
        if w == 1
            store8(at, c)
        elif w == 2
            store8(at, 92)
            store8(at + 1, bytes_show_escape(c))
        else
            store8(at, 92)
            store8(at + 1, 120)
            store8(at + 2, hex_digit(c / 16))
            store8(at + 3, hex_digit(c % 16))
        at += w
        i += 1
    store8(at, 34)
    str_at(s)

## Characters one byte takes in the literal form: 1, 2 (an escape) or 4 (`\xHH`).
fn bytes_show_width(c int) int
    if c == 34 or c == 92 or c == 10 or c == 9 or c == 13
        return 2
    if c >= 32 and c <= 126
        return 1
    4

fn bytes_show_escape(c int) int
    if c == 10
        return 110
    if c == 9
        return 116
    if c == 13
        return 114
    c

## `a < b` on `bytes` (type.bytes.2), for sorting and `min`.
fn bytes_lt(a str, b str) bool
    bytes_cmp(a, b) < 0
