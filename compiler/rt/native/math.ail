## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Float methods the native backend doesn't lower to one instruction
## (ADR 0591). Written in the native subset over `floor` and `ceil`.

## `x.round()` (type.num.9): the nearest integer, halves away from zero, as
## Rust's `f64::round`. The truncation is exact, and so is `x - trunc`, so
## the sign of zero, NaN and the infinities come out as type.num.9 says.
fn float_round(x float) float
    t := if x >= 0.0 then x.floor() else x.ceil()
    d := x - t
    if d >= 0.5
        return t + 1.0
    if d <= -0.5
        return t - 1.0
    t

## `a.cmp(b)` on `int` (trait.std.2) as the index of `Less`, `Equal` or
## `Greater` in `enum Ordering`.
fn int_cmp(a int, b int) int
    if a < b
        return 0
    if a > b
        return 2
    1

## `a.cmp(b)` on `float` (type.num.11): the total order, where NaN is the
## greatest value and equal to itself, and `-0.0` equals `0.0`.
fn float_cmp(a float, b float) int
    if a < b
        return 0
    if a > b
        return 2
    if a == b
        return 1
    # A NaN is involved: it is greater than any number and equal to itself.
    a_nan := a != a
    b_nan := b != b
    if a_nan and b_nan
        return 1
    if a_nan then 2 else 0
