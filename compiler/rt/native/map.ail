## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `Map[K, V]` and `Set[T]` (type.map.*, ADRs 0568-0570, native-abi.md §2).
## One object serves both. Entries sit in an array in insertion order, which
## is the iteration order (type.map.1); an open-addressing index of entry
## numbers finds them. A removed entry stays in the array with hash -1 until
## the next rebuild, so the index never needs tombstones of its own.
##
## Object (a Set uses the same layout and ignores the value word):
##   +0 len     live entries        +8 used     array slots used, live or dead
##   +16 ecap   array capacity      +24 mask    index size - 1 (a power of two)
##   +32 kind   0 int, 1 str, 2 bool, 4 char keys
##   +40 ents   ecap * 24 bytes: hash (-1 when dead), key, value
##   +48 index  (mask + 1) * 8 bytes: 0 empty, else entry number + 1
##   +56 vmode  0 plain values, 1 lists (copied on copy), 2 maps and sets
##   +64 vinfo  vmode 1: nesting depth * 256 + element bytes
##   +72 lastkey, +80 laste: the last key found or added and its entry (0: none)
##   +88 misskey, +96 misshash: the last key a probe missed and its hash, so
##       the insert that follows does not hash it again (ADR 0936)
##   +104 str keys only: 32 words, entry addresses by key object (ADR 0936)
## The index has twice the array's capacity, so it is at most half full.

MAP_BYTES := 104
## A `str`-keyed table also holds the key cache.
MAP_BYTES_STR := 360
MAP_KCACHE := 104

## The table object's size for key kind `kind`.
fn map_bytes(kind int) int
    if kind == 1 then MAP_BYTES_STR else MAP_BYTES

## Heap kinds (native-abi.md): 7 table, 3 entries (scanned word by word),
## 11 index (no pointers). `alloc(n, kind)`.
fn map_alloc(n int, kind int) int
    alloc(n, kind)

fn map_zero(p int, words int)
    for i in 0..words
        store64(p + 8 * i, 0)

# ---- hashing and equality ----

fn map_hash_int(k int) int
    mut h := k * -7046029254386353131
    h = h.bit_xor(h.shr(29).bit_and(34359738367))
    h.bit_and(4611686018427387903)

## A string object's bytes hashed eight at a time: each word is xored in and
## multiplied, the last partial word is masked to its bytes, and the high half
## is folded into the low bits at the end (the index uses the low bits). Reading
## the whole last word is safe: an object's block is 16-byte rounded, which
## leaves at least seven readable bytes past any data end (ADR 0766). The hash
## only places keys in the index; iteration order is insertion order.
fn map_hash_str(s int) int
    n := load64(s)
    if n == 0
        return 0
    if n <= 8
        w := load64(s + 16)
        mut h := (n.bit_xor(if n == 8 then w else w.bit_and(1.shl(8 * n) - 1)))
            * -7046029254386353131
        h = h.bit_xor(h.shr(32)) * -7046029254386353131
        return h.bit_xor(h.shr(29)).bit_and(4611686018427387903)
    mut h := n
    mut i := 0
    while i + 8 <= n
        h = h.bit_xor(load64(s + 16 + i)) * -7046029254386353131
        i += 8
    if i < n
        h = h.bit_xor(load64(s + 16 + i).bit_and(1.shl(8 * (n - i)) - 1)) * -7046029254386353131
    h = h.bit_xor(h.shr(32)) * -7046029254386353131
    h.bit_xor(h.shr(29)).bit_and(4611686018427387903)

fn map_hash(kind int, k int) int
    if kind == 1
        return map_hash_str(k)
    if kind > 15
        return shape_hash(kind, 0, k, 0).bit_and(4611686018427387903)
    map_hash_int(k)

# ---- composite keys (ADR 0866) ----
#
# A key kind above 15 is a string object that says how a key is laid out:
# `i` a word (int, char, bool), `f` a float, `s` a string, `L` and the shape
# of its elements (a list; `b` elements are single bytes), `S` n `;` and n
# shapes (a struct or tuple, one word per field), `E` n `;` and n variants
# `V` m `;` and m shapes (an enum whose first word is the variant), `O` and
# a shape (an optional: 0 is `none`, and a word, float or optional inside is
# boxed), `@` n `;` (the shape at offset n: a type that holds itself), `_` (a
# struct field that `impl Hash ... uses` leaves out: neither hashed nor compared).

fn shape_at(sh int, p int) int
    load8(sh + 16 + p)

## The number written at `p`, up to the `;`.
fn shape_num(sh int, p int) int
    mut n := 0
    mut i := p
    while shape_at(sh, i) != 59
        n = n * 10 + shape_at(sh, i) - 48
        i += 1
    n

## The index after the `;` that ends the number at `p`.
fn shape_semi(sh int, p int) int
    mut i := p
    while shape_at(sh, i) != 59
        i += 1
    i + 1

## The index after the shape that starts at `p`.
fn shape_end(sh int, p int) int
    c := shape_at(sh, p)
    if c == 76 or c == 79
        return shape_end(sh, p + 1)
    if c == 64
        return shape_semi(sh, p + 1)
    if c == 83 or c == 69 or c == 86
        n := shape_num(sh, p + 1)
        mut i := shape_semi(sh, p + 1)
        for _ in 0..n
            i = shape_end(sh, i)
        return i
    p + 1

## The index of the `V` of variant `tag`, for the enum shape at `p`.
fn shape_vpos(sh int, p int, tag int) int
    mut i := shape_semi(sh, p + 1)
    for _ in 0..tag
        i = shape_end(sh, i)
    i

fn shape_mix(h int, x int) int
    y := (h + x) * -7046029254386353131
    y.bit_xor(y.shr(29))

## A float's bits, with -0.0 as 0.0 (they are equal).
fn shape_float(v int) int
    if v == -9223372036854775808
        return 0
    v

## The value inside optional `v` of shape `O` at `p`: unboxed when boxed.
fn shape_some(sh int, p int, v int) int
    c := shape_at(sh, p + 1)
    if c == 105 or c == 98 or c == 102 or c == 79
        return load64(v)
    v

fn shape_hash(sh int, p int, v int, h int) int
    c := shape_at(sh, p)
    if c == 95
        return h
    if c == 64
        return shape_hash(sh, shape_num(sh, p + 1), v, h)
    if c == 79
        if v == 0
            return shape_mix(h, 0)
        return shape_hash(sh, p + 1, shape_some(sh, p, v), shape_mix(h, 1))
    if c == 105 or c == 98
        return shape_mix(h, v)
    if c == 102
        return shape_mix(h, shape_float(v))
    if c == 115
        return shape_mix(h, map_hash_str(v))
    if c == 76
        n := load64(v)
        data := load64(v + 16)
        bytes := shape_at(sh, p + 1) == 98
        mut r := shape_mix(h, n)
        for i in 0..n
            x := if bytes then load8(data + i) else load64(data + 8 * i)
            r = shape_hash(sh, p + 1, x, r)
        return r
    if c == 83
        n := shape_num(sh, p + 1)
        mut i := shape_semi(sh, p + 1)
        mut r := h
        for k in 0..n
            r = shape_hash(sh, i, load64(v + 8 * k), r)
            i = shape_end(sh, i)
        return r
    tag := load64(v)
    vp := shape_vpos(sh, p, tag)
    m := shape_num(sh, vp + 1)
    mut r := shape_mix(h, tag)
    mut i := shape_semi(sh, vp + 1)
    for k in 0..m
        r = shape_hash(sh, i, load64(v + 8 * (k + 1)), r)
        i = shape_end(sh, i)
    r

fn shape_eq(sh int, p int, a int, b int) bool
    c := shape_at(sh, p)
    if c == 95
        return true
    if c == 64
        return shape_eq(sh, shape_num(sh, p + 1), a, b)
    if c == 79
        if a == 0 or b == 0
            return a == b
        return shape_eq(sh, p + 1, shape_some(sh, p, a), shape_some(sh, p, b))
    if c == 105 or c == 98
        return a == b
    if c == 102
        return shape_float(a) == shape_float(b)
    if c == 115
        return map_key_eq(1, a, b)
    if c == 76
        n := load64(a)
        if n != load64(b)
            return false
        da := load64(a + 16)
        db := load64(b + 16)
        bytes := shape_at(sh, p + 1) == 98
        for i in 0..n
            x := if bytes then load8(da + i) else load64(da + 8 * i)
            y := if bytes then load8(db + i) else load64(db + 8 * i)
            if not shape_eq(sh, p + 1, x, y)
                return false
        return true
    if c == 83
        n := shape_num(sh, p + 1)
        mut i := shape_semi(sh, p + 1)
        for k in 0..n
            if not shape_eq(sh, i, load64(a + 8 * k), load64(b + 8 * k))
                return false
            i = shape_end(sh, i)
        return true
    tag := load64(a)
    if tag != load64(b)
        return false
    vp := shape_vpos(sh, p, tag)
    m := shape_num(sh, vp + 1)
    mut i := shape_semi(sh, vp + 1)
    for k in 0..m
        if not shape_eq(sh, i, load64(a + 8 * (k + 1)), load64(b + 8 * (k + 1)))
            return false
        i = shape_end(sh, i)
    true

fn map_key_eq(kind int, a int, b int) bool
    if a == b
        return true
    if kind > 15
        return shape_eq(kind, 0, a, b)
    if kind != 1
        return false
    n := load64(a)
    if n != load64(b)
        return false
    mut i := 0
    while i + 8 <= n
        if load64(a + 16 + i) != load64(b + 16 + i)
            return false
        i += 8
    while i < n
        if load8(a + 16 + i) != load8(b + 16 + i)
            return false
        i += 1
    true

# ---- tables ----

## Fresh tables of capacity `ecap` (a power of two); `used` is not changed.
fn map_tables(m int, ecap int)
    if load64(m + 32) == 1
        map_zero(m + MAP_KCACHE, 32)
    store64(m + 16, ecap)
    store64(m + 24, ecap * 2 - 1)
    store64(m + 40, map_alloc(ecap * 24, 3))
    idx := map_alloc(ecap * 16, 11)
    map_zero(idx, ecap * 2)
    store64(m + 48, idx)

## An empty map or set. `kind` is the key kind; `vmode` and `vinfo` say how
## a copy treats values.
fn map_new(kind int, vmode int, vinfo int) int
    m := map_alloc(map_bytes(kind), 7)
    store64(m, 0)
    store64(m + 8, 0)
    store64(m + 32, kind)
    store64(m + 56, vmode)
    store64(m + 64, vinfo)
    store64(m + 80, 0)
    store64(m + 88, 0)
    store64(m + 96, if kind == 1 or kind > 15 then 0 else map_hash_int(0))
    map_tables(m, 8)
    m

## `get` then assignment on one key is the common pattern: the entry of the
## last key found or added is remembered, so the second lookup skips the
## hash and the probe. A rebuild or a removal forgets it.
fn map_find(m int, k int) int
    if load64(m + 80) != 0 and load64(m + 72) == k
        return load64(m + 80)
    kind := load64(m + 32)
    if kind == 1
        # The key cache (ADR 0936), written out here so that the hit makes no
        # call once `map_find` is inlined into the caller.
        e := load64(m + MAP_KCACHE + 8 * k.shr(5).bit_and(31))
        if e != 0 and load64(e + 8) == k
            store64(m + 72, k)
            store64(m + 80, e)
            return e
        return map_probe(m, k, map_hash_str(k))
    if kind > 15
        return map_probe(m, k, map_hash(kind, k))
    map_probe(m, k, map_hash_int(k))

## The key cache slot of string object `k` (ADR 0936): the address in
## 32-byte units, modulo 32 (`map_find` and `map_probe` write it out). String
## objects are 16-byte aligned and, unless empty, at least 32 bytes long, so
## keys made one after another (a vocabulary's literals, strings split from
## one text) get different slots until together they span 1 KB, wherever the
## program's code and data sit. A hash of the address left the collisions to
## layout: wordfreq's 12 words ran 11.7% more instructions after an unrelated
## change moved them. A program looks up the same string objects again and
## again (literals, the words of a vocabulary, names held in a tree), so a key
## object's entry is remembered and found without hashing its bytes. A slot is
## trusted only when its entry holds this very object: the entry keeps the
## object alive, so no other string can have its address, and strings never
## change. A removal clears the entry's key; a rebuild or copy clears the cache.
fn map_kslot(m int, k int) int
    m + MAP_KCACHE + 8 * k.shr(5).bit_and(31)

## The probe of `map_find`, apart from the hash so that only `m` and `k` live
## across the hash call. A hit in the first slot, the usual case, makes no
## call, so it saves no registers (ADR 0625); a collision or a key that is
## equal but not the same string goes on in `map_probe_from`.
fn map_probe(m int, k int, h int) int
    j := h.bit_and(load64(m + 24))
    s := load64(load64(m + 48) + 8 * j)
    if s == 0
        store64(m + 88, k)
        store64(m + 96, h)
        return 0
    e := load64(m + 40) + 24 * (s - 1)
    if load64(e) == h and load64(e + 8) == k
        store64(m + 72, k)
        store64(m + 80, e)
        if load64(m + 32) == 1
            store64(m + MAP_KCACHE + 8 * k.shr(5).bit_and(31), e)
        return e
    map_probe_from(m, k, h, j)

## Remember entry `e` of key `k`: the last key, and the key cache of a
## `str`-keyed table.
fn map_found(m int, k int, e int)
    store64(m + 72, k)
    store64(m + 80, e)
    if load64(m + 32) == 1
        store64(map_kslot(m, k), e)

## The hash of `k`, a key a probe has just missed: kept from that probe
## (ADR 0936), else computed. The table holds `misskey`, so the object stays
## alive and its address names it.
fn map_hash_missed(m int, k int) int
    kind := load64(m + 32)
    if load64(m + 88) == k and kind <= 15
        return load64(m + 96)
    map_hash(kind, k)

## The probe from slot `j` on. What a step needs of `m` is read again, not kept.
fn map_probe_from(m int, k int, h int, from int) int
    mut j := from
    mut s := load64(load64(m + 48) + 8 * j)
    while s != 0
        e := load64(m + 40) + 24 * (s - 1)
        if load64(e) == h and (load64(e + 8) == k or map_key_eq(load64(m + 32), load64(e + 8), k))
            map_found(m, k, e)
            return e
        j = (j + 1).bit_and(load64(m + 24))
        s = load64(load64(m + 48) + 8 * j)
    store64(m + 88, k)
    store64(m + 96, h)
    0

fn map_index_put(m int, h int, number int)
    mask := load64(m + 24)
    idx := load64(m + 48)
    mut i := h.bit_and(mask)
    while load64(idx + 8 * i) != 0
        i = (i + 1).bit_and(mask)
    store64(idx + 8 * i, number)

## Make room for one more entry: compact when at least half the slots are
## dead, else double.
fn map_rebuild(m int)
    used := load64(m + 8)
    ecap := load64(m + 16)
    ncap := if load64(m) * 2 >= ecap then ecap * 2 else ecap
    old := load64(m + 40)
    store64(m + 80, 0)
    map_tables(m, ncap)
    ents := load64(m + 40)
    mut j := 0
    for i in 0..used
        e := old + 24 * i
        h := load64(e)
        if h >= 0
            d := ents + 24 * j
            store64(d, h)
            store64(d + 8, load64(e + 8))
            store64(d + 16, load64(e + 16))
            j += 1
            map_index_put(m, h, j)
    store64(m + 8, j)

## Append an entry for a key known to be absent; its address.
fn map_append(m int, h int, k int, v int) int
    if load64(m + 8) == load64(m + 16)
        map_rebuild(m)
    used := load64(m + 8)
    e := load64(m + 40) + 24 * used
    store64(e, h)
    store64(e + 8, k)
    store64(e + 16, v)
    store64(m + 8, used + 1)
    store64(m, load64(m) + 1)
    map_index_put(m, h, used + 1)
    map_found(m, k, e)
    e

## The live entry in slot `i` of the entries array (`i` below `used`), or 0
## for a removed one; `==` on maps and sets walks the slots with it.
fn map_ent(m int, i int) int
    e := load64(m + 40) + i * 24
    if load64(e) == -1
        return 0
    e

## `m[k] = v`: replace in place, or insert last (type.map.1, type.map.3).
fn map_set(m int, k int, v int)
    # The key just found by `get` is remembered: store without a call.
    c := load64(m + 80)
    if c != 0 and load64(m + 72) == k
        store64(c + 16, v)
        return
    e := map_find(m, k)
    if e != 0
        store64(e + 16, v)
        return
    map_append(m, map_hash_missed(m, k), k, v)

## `s.add(x)`: whether `x` was new.
fn map_add(m int, k int) bool
    if map_find(m, k) != 0
        return false
    map_append(m, map_hash_missed(m, k), k, 0)
    true

fn map_has(m int, k int) bool
    map_find(m, k) != 0

## `m.remove(k)` and `s.remove(x)`: whether the key was there.
fn map_remove(m int, k int) bool
    e := map_find(m, k)
    if e == 0
        return false
    store64(m + 80, 0)
    store64(e, -1)
    store64(e + 8, 0)
    store64(e + 16, 0)
    store64(m, load64(m) - 1)
    true

# ---- lists out of a map ----

fn map_keys(m int) List[int]
    out := list_new(load64(m))
    ents := load64(m + 40)
    for i in 0..load64(m + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            list_push(out, load64(e + 8))
    out

## The keys of a table of `bool`, `u8`, `u16` or `u32` as a list of `size`-byte
## elements.
fn map_keys_n(m int, size int) List[int]
    map_words_n(m, 8, size)

fn map_values(m int) List[int]
    out := list_new(load64(m))
    ents := load64(m + 40)
    for i in 0..load64(m + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            list_push(out, load64(e + 16))
    out

fn map_values_n(m int, size int) List[int]
    map_words_n(m, 16, size)

## The words at offset `off` of each live entry, `size` bytes each.
fn map_words_n(m int, off int, size int) List[int]
    out := list_alloc(load64(m), size)
    q := list_addr(out)
    data := load64(q + 16)
    ents := load64(m + 40)
    mut n := 0
    for i in 0..load64(m + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            list_set_word(data, size, n, load64(e + off))
            n += 1
    store64(q, n)
    out

# ---- value semantics (own.val.1) ----

## A copy that shares nothing with `m`: tables, and the lists and maps in it.
fn map_copy(m int) int
    obj := map_bytes(load64(m + 32))
    n := map_alloc(obj, 7)
    copy_bytes(n, m, obj)
    store64(n + 80, 0)
    if obj == MAP_BYTES_STR
        map_zero(n + MAP_KCACHE, 32)
    used := load64(m + 8)
    ents := map_alloc(load64(m + 16) * 24, 3)
    copy_bytes(ents, load64(m + 40), 24 * used)
    store64(n + 40, ents)
    size := load64(m + 24) + 1
    idx := map_alloc(size * 8, 11)
    copy_bytes(idx, load64(m + 48), size * 8)
    store64(n + 48, idx)
    vmode := load64(m + 56)
    if vmode != 0
        info := load64(m + 64)
        for i in 0..used
            e := ents + 24 * i
            if load64(e) >= 0
                v := load64(e + 16)
                if vmode == 2
                    store64(e + 16, map_copy(v))
                else
                    depth := info / 256
                    bytes := info.bit_and(255)
                    c := if depth == 0 then list_copy(list_at(v), bytes) else list_copy_deep(
                        list_at(v),
                        depth,
                        bytes,
                    )
                    store64(e + 16, list_addr(c))
    n

# ---- traps and text ----

fn map_out_hex(n int)
    if n >= 16
        map_out_hex(n / 16)
    d := n % 16
    out_byte(if d < 10 then 48 + d else 87 + d)

## A string as it appears inside another value: quoted, with `\`, the quote
## and control characters escaped (trait.auto.2).
fn map_out_quoted(s int)
    out_byte(34)
    n := load64(s)
    for i in 0..n
        c := load8(s + 16 + i)
        if c == 92 or c == 34
            out_byte(92)
            out_byte(c)
        elif c == 10
            out_byte(92)
            out_byte(110)
        elif c == 9
            out_byte(92)
            out_byte(116)
        elif c == 13
            out_byte(92)
            out_byte(114)
        elif c == 0
            out_byte(92)
            out_byte(48)
        elif c < 32 or c == 127
            out_str("\\u\{")
            map_out_hex(c)
            out_byte(125)
        else
            out_byte(c)
    out_byte(34)

## A key or value for the text form: `kind` 0 int, 1 str, 2 bool, 3 float,
## 4 char, 5 bytes.
fn out_scalar(kind int, v int)
    if kind == 1
        map_out_quoted(v)
    elif kind == 5
        out_str(bytes_show(str_at(v)))
    elif kind == 4
        out_byte(39)
        out_escaped(v, 39)
        out_byte(39)
    elif kind == 2
        out_bool(v != 0)
    elif kind == 3
        out_float(bits_float(v))
    else
        out_int(v)

## `print(m)` for a map: `{"a": 1, "b": 2}`, or `{}` (type.map.4).
fn out_map(m int, kk int, vk int)
    ents := load64(m + 40)
    out_byte(123)
    mut first := true
    for i in 0..load64(m + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            if not first
                out_sep(1)
            first = false
            out_scalar(kk, load64(e + 8))
            out_byte(58)
            out_byte(32)
            out_scalar(vk, load64(e + 16))
    out_byte(125)

## `print(s)` for a set: `{1, 2}`.
fn out_set(m int, kk int)
    ents := load64(m + 40)
    out_byte(123)
    mut first := true
    for i in 0..load64(m + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            if not first
                out_sep(1)
            first = false
            out_scalar(kk, load64(e + 8))
    out_byte(125)

## `m[k]`: the value, or the interpreter's trap when `k` is missing
## (type.map.3). `head` and `tail` are the trap's first line and excerpt.
fn map_at(m int, k int, head str, tail str) int
    e := map_find(m, k)
    if e != 0
        return load64(e + 16)
    flush()
    out_str(head)
    out_str("the map has no key ")
    out_scalar(load64(m + 32), k)
    out_byte(10)
    trap_tail(tail)
    trace_frames(tail)
    flush_to(2)
    sys_exit(1)
    0

## The trap of `m[k]` on a missing key whose text `text` the program built
## (composite keys, ADR 0866).
fn map_gone(head str, text str, tail str)
    flush()
    out_str(head)
    out_str("the map has no key ")
    out_str(text)
    out_byte(10)
    trap_tail(tail)
    trace_frames(tail)
    flush_to(2)
    sys_exit(1)

# ---- counting and set algebra (std.count.2, type.coll.16) ----

## Entry numbers `lo..hi` of `idx` merged into `dst`, largest value first;
## equal values keep their order.
fn map_top_sort(ents int, idx int, n int)
    mut src := idx
    mut dst := alloc_raw(8 * n, 11)
    mut width := 1
    while width < n
        mut lo := 0
        while lo < n
            mid := if lo + width < n then lo + width else n
            hi := if lo + 2 * width < n then lo + 2 * width else n
            mut a := lo
            mut b := mid
            mut k := lo
            while a < mid and b < hi
                va := load64(ents + 24 * load64(src + 8 * a) + 16)
                vb := load64(ents + 24 * load64(src + 8 * b) + 16)
                if vb > va
                    store64(dst + 8 * k, load64(src + 8 * b))
                    b += 1
                else
                    store64(dst + 8 * k, load64(src + 8 * a))
                    a += 1
                k += 1
            while a < mid
                store64(dst + 8 * k, load64(src + 8 * a))
                a += 1
                k += 1
            while b < hi
                store64(dst + 8 * k, load64(src + 8 * b))
                b += 1
                k += 1
            lo += 2 * width
        t := src
        src = dst
        dst = t
        width *= 2
    if src != idx
        copy_bytes(idx, src, 8 * n)

## `m.top(n)` on a `Map[K, int]`: the `n` keys with the largest counts.
fn map_top(m int, n int) List[int]
    live := load64(m)
    k := if n < live then n else live
    out := list_new(if k > 0 then k else 0)
    if k <= 0
        return out
    ents := load64(m + 40)
    idx := alloc_raw(8 * live, 11)
    mut j := 0
    for i in 0..load64(m + 8)
        if load64(ents + 24 * i) >= 0
            store64(idx + 8 * j, i)
            j += 1
    map_top_sort(ents, idx, live)
    for i in 0..k
        list_push(out, load64(ents + 24 * load64(idx + 8 * i) + 8))
    out

## A set of the elements of a list of `int` or `str`.
fn set_from_list(kind int, xs List[int]) int
    s := map_new(kind, 0, 0)
    q := list_addr(xs)
    data := load64(q + 16)
    for i in 0..load64(q)
        map_add(s, load64(data + 8 * i))
    s

## `a.union(b)`: `a`'s elements, then `b`'s new ones.
fn set_union(a int, b int) int
    r := map_copy(a)
    ents := load64(b + 40)
    for i in 0..load64(b + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            map_add(r, load64(e + 8))
    r

## `a.intersect(b)` (`keep` 1) and `a.difference(b)` (`keep` 0): the elements
## of `a` that are, or are not, in `b`.
fn set_filter(a int, b int, keep int) int
    r := map_new(load64(a + 32), 0, 0)
    ents := load64(a + 40)
    for i in 0..load64(a + 8)
        e := ents + 24 * i
        if load64(e) >= 0
            if map_has(b, load64(e + 8)) == (keep != 0)
                map_add(r, load64(e + 8))
    r

# ---- copies of tables of structs ----

## The slots in use, live or dead.
fn map_used(m int) int
    load64(m + 8)

## The address of entry `i` when it is live, else 0.
fn map_live(m int, i int) int
    e := load64(m + 40) + 24 * i
    if load64(e) >= 0
        return e
    0

## `xs.counts()` (type.coll.18): how often each element of a list of `int`,
## `str` or `char` occurs, keys in order of first appearance.
fn map_counts(kind int, xs List[int]) int
    m := map_new(kind, 0, 0)
    q := list_addr(xs)
    data := load64(q + 16)
    for i in 0..load64(q)
        k := load64(data + 8 * i)
        e := map_find(m, k)
        if e != 0
            store64(e + 16, load64(e + 16) + 1)
        else
            map_append(m, map_hash_missed(m, k), k, 1)
    m
