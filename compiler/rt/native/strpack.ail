## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## Packed pieces (native.str.1, ADR 1193): the strings that `split`, `lines`
## and `words` give share blocks. A pack is one `KIND_STR` block holding string
## objects one after another, each +0 bytes, +8 chars, +16 UTF-8 padded to
## 16 bytes, so a piece is an ordinary string at an address inside the block.
## A piece's address is a multiple of 16, where a string with a block of its
## own is 8 past one: the test `lower_own.ail` makes before it calls
## `spk_own`.
## The collector finds a block from an address inside it (`gc_find`) and does
## not scan a string block, so nothing else in the runtime changes. One live
## piece keeps its pack: a pack is at most `SPK_CAP` bytes, and a piece over
## `SPK_OWN` bytes gets a block of its own, so a kept piece holds at most
## `SPK_CAP` bytes that way.
##
## The cursor `cur` is the address of the pack's next free piece, whose first
## word holds the bytes left from there to the pack's end; 0 when there is no
## pack or no room is left. Every function here takes it and gives the new one.

## The most bytes in a pack: 8 to bring the first piece to a multiple of 16
## and 1008 of pieces. With its header it fills the 1024-byte class.
SPK_CAP := 1016
## A piece of more bytes than this gets its own block.
SPK_OWN := 128

## Push bytes `from` up to `to` of the string at `p`, `chars` characters,
## onto the list at `lp` as a new string; `cur` is the cursor. A new pack has
## room for the rest of the parent cut into pieces the size of this one, up
## to `SPK_CAP`: one block for the fields of a line, about thirty short
## pieces a block for a long text. A piece of up to 16 bytes is copied as one
## or two whole words: its room is whole words, and reading the parent's last
## word whole is safe (ADR 0766).
fn spk_put(lp int, cur int, p int, from int, to int, chars int) int
    m := to - from
    mut r := 0
    mut next := cur
    if m > SPK_OWN
        r = alloc_raw(16 + m, KIND_STR)
    else
        sz := (m + 31).bit_and(-16)
        mut room := 0
        if cur != 0
            room = load64(cur)
        if sz <= room
            r = cur
        else
            room = ((load64(p) - from) / (m + 1) + 1) * sz
            if room > SPK_CAP - 8
                room = SPK_CAP - 8
            r = alloc_raw(room + 8, KIND_STR) + 8
        room -= sz
        next = 0
        if room >= 16
            next = r + sz
            store64(next, room)
    store64(r, m)
    store64(r + 8, chars)
    src := p + 16 + from
    if m > 16
        copy_bytes(r + 16, src, m)
    elif m > 8
        store64(r + 16, load64(src))
        store64(r + 8 + m, load64(src + m - 8))
    elif m > 0
        store64(r + 16, load64(src))
    k := load64(lp)
    if k == load64(lp + 8)
        list_grow(lp, 8)
    store64(load64(lp + 16) + 8 * k, r)
    store64(lp, k + 1)
    next

## The same, counting the characters: when the parent is all ASCII (bytes
## equal characters) the count is the length.
fn spk_sub(lp int, cur int, p int, from int, to int) int
    chars := if load64(p) == load64(p + 8) then to - from else u8_count(p, from, to)
    spk_put(lp, cur, p, from, to, chars)

## The string object at `p`, or a copy in a block of its own when `p` is a
## piece inside a pack: what a long-lived holder keeps (a list pushed onto, a
## table's key), so one kept piece does not keep its pack. A string outside
## the heap (a literal) or at the start of its block is given back. The block
## is found as `gc_find` finds it, without that function's page mark.
fn spk_own_at(p int) int
    base := hs(H_BASE)
    if p < base or p >= hs(H_TOP)
        return p
    pi := (p - base) / PAGE
    t := load64(hs(H_PAGES) + 8 * pi)
    if t.bit_and(255) != 1
        return p
    pb := base + pi * PAGE
    bs := pb + ((p - pb) * t.shr(32)).shr(32) * t.shr(16).bit_and(65535)
    if bs + 8 == p
        return p
    n := load64(p)
    r := str_new(n, load64(p + 8))
    copy_bytes(r + 16, p + 16, n)
    r

## The same for a string value (lower_own.ail).
fn spk_own(s str) str
    str_at(spk_own_at(str_addr(s)))
