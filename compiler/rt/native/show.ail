## Runtime: part of the AIL native runtime; linked into user executables
## under the Runtime Exception (see LICENSE).
##
## `print(x)` of a collection whose elements are themselves collections or
## optionals (`List[str?]`, `List[Map[str, str]]`, `Map[str, List[int]]`;
## trait.auto.2, type.map.4). The compiler passes the element type as a
## descriptor string: `i` int, `f` float, `b` bool, `s` str, `c` char,
## `[X` list, `<X` set, `{KV` map, `?X` optional (boxed for `i f b c`).
## Every value arrives as one word, as stored in a list or table.

## The index just past the type that starts at `i`.
fn show_end(d int, i int) int
    c := load8(d + i)
    if c == 91 or c == 60 or c == 63
        return show_end(d, i + 1)
    if c == 123
        return show_end(d, show_end(d, i + 1))
    i + 1

## One value of the type at `i`, in the quoted text form of a nested value.
fn show_val(d int, i int, v int)
    c := load8(d + i)
    if c == 105
        out_int(v)
    elif c == 102
        out_float(bits_float(v))
    elif c == 98
        out_bool(v != 0)
    elif c == 115
        out_quoted(str_at(v))
    elif c == 99
        out_byte(39)
        out_escaped(v, 39)
        out_byte(39)
    elif c == 63
        if v == 0
            out_str("none")
        else
            k := load8(d + i + 1)
            if k == 105 or k == 99 or k == 102 or k == 98
                show_val(d, i + 1, load64(v))
            else
                show_val(d, i + 1, v)
    elif c == 91
        p := list_addr(list_at(v))
        data := load64(p + 16)
        one := load8(d + i + 1) == 98
        out_byte(91)
        for k in 0..load64(p)
            out_sep(k)
            if one
                show_val(d, i + 1, load8(data + k))
            else
                show_val(d, i + 1, load64(data + 8 * k))
        out_byte(93)
    elif c == 123
        vi := show_end(d, i + 1)
        ents := load64(v + 40)
        out_byte(123)
        mut first := true
        for k in 0..load64(v + 8)
            e := ents + 24 * k
            if load64(e) >= 0
                if not first
                    out_sep(1)
                first = false
                show_val(d, i + 1, load64(e + 8))
                out_byte(58)
                out_byte(32)
                show_val(d, vi, load64(e + 16))
        out_byte(125)
    else
        ents := load64(v + 40)
        out_byte(123)
        mut first := true
        for k in 0..load64(v + 8)
            e := ents + 24 * k
            if load64(e) >= 0
                if not first
                    out_sep(1)
                first = false
                show_val(d, i + 1, load64(e + 8))
        out_byte(125)

## `print` of a nested collection `v` whose type is described by `desc`.
fn show_out(v int, desc str)
    show_val(str_addr(desc) + 16, 0, v)
