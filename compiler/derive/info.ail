## The built-in derive generators run by the native compiler (ct.derive.1-4,
## refl.info.1-3, ADR 0850): for each `impl Trait for T` with no methods, of
## a prelude trait with a generator, the `TypeInfo` of `T` is built from the
## syntax tree and the generator of `gens.ail` writes the methods, as the
## bootstrap's `derive.rs` does through the interpreter.
use ast

## The text a generator wrote for one `impl`.
pub struct Expansion
    ## The `impl`'s module, empty for the root.
    pub module str
    ## `TYPE.TRAIT`
    pub label str
    ## The file of the `impl` and where it is, for a message.
    pub file int
    pub pos ast.Pos
    pub text str
    ## Why the generator refused the type; empty when `text` is the methods.
    pub problem str

## The prelude traits whose generators are built in.
fn generator_of(trait_name str) str
    match trait_name
        "ToJson" => "derive_to_json"
        "FromJson" => "derive_from_json"
        "Default" => "derive_default"
        "FromArgs" => "derive_from_args"
        "Observe" => "derive_observe"
        _ => ""

fn last(name str) str
    name.split(".").last() else name

## Every deriving `impl` of the program: `modules[k]` is the module of
## `progs[k]`, one file each. An `impl` of a trait the program declares
## itself, or of a type it doesn't declare, is left to the checker.
pub fn expand(modules List[str], progs List[ast.Program]) List[Expansion]
    mut declared := Set[str]()
    for p in progs
        for t in p.traits
            declared.add(t.name)
    mut out := List[Expansion]()
    for k in 0..progs.len()
        for imp in progs[k].impls
            trait_name := last(imp.trait_name)
            gen := generator_of(trait_name)
            if gen == ""
                or imp.methods.len() > 0
                or (declared.contains(trait_name) and gen != "derive_observe")
                continue
            type_name := last(imp.target.name)
            info := type_info(modules, progs, type_name, modules[k]) else continue
            mut e := Expansion(
                module: modules[k],
                label: "{type_name}.{trait_name}",
                file: k,
                pos: imp.pos,
                text: "",
                problem: "",
            )
            facts := observe_facts(progs, type_name)
            text := run(gen, info, facts, defaulted_fields(progs, type_name)) else err
                e.problem = err.message
                out.push(e)
                continue
            e.text = text
            out.push(e)
    out

fn run(gen str, info TypeInfo, facts ObserveFacts, defaulted List[str]) str ! DeriveError
    match gen
        "derive_observe" => derive_observe(info, facts)
        "derive_to_json" => derive_to_json(info)
        "derive_from_json" => derive_from_json(info)
        "derive_default" => derive_default_skipping(info, defaulted)
        _ => derive_from_args(info)

## The names of the fields of struct `name` that declare a default (type.struct.8).
fn defaulted_fields(progs List[ast.Program], name str) List[str]
    for p in progs
        for s in p.structs
            if last(s.name) == name
                return [f.name for f in s.fields if f.default != none]
    []

## `derive_default` for a struct whose fields may declare defaults
## (type.struct.8, trait.assoc.1): the derived `default()` leaves those out of
## the literal, so each gets its declared default, not its type's.
pub fn derive_default_skipping(t TypeInfo, defaulted List[str]) str ! DeriveError
    if defaulted.len() == 0
        return derive_default(t)
    args := [
        "{f.name}: {default_of(f.type_text)}"
        for f in t.fields if not defaulted.contains(f.name)
    ]
    "fn default() Self\n    {t.name}({args.join(", ")})\n"

## `text` with the module's own prefix `a.b.` removed from its names: the
## generated code is read inside that module (mod.unit.2).
fn unqualify(text str, module str) str
    if module == ""
        return text
    text.replace("{module}.", "")

## The `TypeInfo` of the struct or enum `name`, preferring one declared in
## `module` (refl.info.1, refl.info.3).
fn type_info(modules List[str], progs List[ast.Program], name str, module str) TypeInfo?
    # The file and index of the declaration, the module's own first.
    mut sk := -1
    mut si := -1
    mut ek := -1
    mut ei := -1
    for k in 0..progs.len()
        for i in 0..progs[k].structs.len()
            if last(progs[k].structs[i].name) == name
                and (sk < 0 or modules[k] == module and modules[sk] != module)
                sk = k
                si = i
        for i in 0..progs[k].enums.len()
            if last(progs[k].enums[i].name) == name
                and (ek < 0 or modules[k] == module and modules[ek] != module)
                ek = k
                ei = i
    if sk >= 0
        d := progs[sk].structs[si]
        return TypeInfo(
            name: name,
            id: "type:{name}",
            module: modules[sk],
            kind: TypeKind.Struct,
            is_error: d.is_error,
            params: [g.name for g in d.generics],
            fields: field_infos(progs[sk], d.fields, modules[sk]),
            variants: [],
        )
    if ek < 0
        return none
    d := progs[ek].enums[ei]
    TypeInfo(
        name: name,
        id: "type:{name}",
        module: modules[ek],
        kind: TypeKind.Enum,
        is_error: d.is_error,
        params: [g.name for g in d.generics],
        fields: [],
        variants: [
            VariantInfo(name: v.name, fields: field_infos(progs[ek], v.fields, modules[ek]))
            for v in d.variants
        ],
    )

fn field_infos(prog ast.Program, fields List[ast.Field], module str) List[FieldInfo]
    [
        FieldInfo(
            name: f.name,
            type_text: unqualify(show_type(f.ty), module),
            public: prog.public.contains(f.pos.line),
            doc: f.doc else "",
        )
        for f in fields
    ]

## A type as written, as `ail api` prints it.
pub fn show_type(t ast.TypeRef) str
    match t.shape
        Named(name, args) =>
            if args.len() == 0
                return name
            "{name}[{[show_type(a) for a in args].join(", ")}]"
        Optional(inner) => "{show_type(inner)}?"
        AnyTrait(name) => "any {name}"
        RefTo(inner) => "ref {show_type(inner)}"
        PtrTo(inner) => "*{show_type(inner)}"
        FnType(params, ret) =>
            ps := [show_type(p) for p in params].join(", ")
            if r := ret
                return "fn({ps}) {show_type(r)}"
            "fn({ps})"
        TupleType(elems) => "({[show_type(x) for x in elems].join(", ")})"
        Fallible(ok, errors) =>
            errs := if es := errors then [show_type(x) for x in es].join(" | ") else ""
            if o := ok
                if errors != none
                    return "{show_type(o)} ! {errs}"
                return "!{show_type(o)}"
            if errors != none then "! {errs}" else "!"

## One deriving `impl` of a trait the program declares with `@derive(f)`
## (ct.derive.1-2): the generator `f` runs on the type's `TypeInfo` in a
## program of its own, because `f` is the program's code (ADR 0856).
pub struct Job
    ## The `impl`'s module, empty for the root.
    pub module str
    ## `TYPE.TRAIT`
    pub label str
    ## The file of the `impl` and where it is, for a message.
    pub file int
    pub pos ast.Pos
    pub generator str
    ## The module of the trait, where the generator is called from.
    pub trait_module str
    ## The `TypeInfo(...)` expression for the type (refl.info.1).
    pub info str

## The deriving `impl`s of user traits. An `impl` whose trait has no
## generator, whose generator isn't declared, or whose type isn't a struct or
## enum of the program is left to the checker.
pub fn user_jobs(modules List[str], progs List[ast.Program]) List[Job]
    mut out := List[Job]()
    for k in 0..progs.len()
        for imp in progs[k].impls
            if imp.methods.len() > 0
                continue
            trait_name := last(imp.trait_name)
            mut gen := ""
            mut tm := ""
            for j in 0..progs.len()
                for t in progs[j].traits
                    if t.name == trait_name and gen == ""
                        if g := t.derive
                            gen = g.name
                            tm = modules[j]
            if gen == "" or not declares_fn(modules, progs, tm, gen)
                continue
            type_name := last(imp.target.name)
            info := type_info(modules, progs, type_name, modules[k]) else continue
            out.push(Job(
                module: modules[k],
                label: "{type_name}.{trait_name}",
                file: k,
                pos: imp.pos,
                generator: gen,
                trait_module: tm,
                info: info_expr(info),
            ))
    out

fn declares_fn(modules List[str], progs List[ast.Program], module str, name str) bool
    for k in 0..progs.len()
        if modules[k] == module
            for f in progs[k].fns
                if f.name == name and f.owner == none
                    return true
    false

## An AIL string literal holding `s` exactly.
fn quote(s str) str
    mut out := List[str]()
    for c in s.chars()
        if c == '"' or c == '\\' or c == '{'
            out.push("\\")
            out.push("{c}")
        elif c == '\n'
            out.push("\\n")
        else
            out.push("{c}")
    "\"{out.join("")}\""

fn list_of(items List[str], elem str) str
    if items.len() == 0
        return "List[{elem}]()"
    "[{items.join(", ")}]"

fn field_expr(f FieldInfo) str
    "FieldInfo(name: {quote(f.name)}, type_text: {quote(f.type_text)}, public: {f.public}, doc: {quote(f.doc)})"

## The `TypeInfo(...)` expression for `t`, as the bootstrap writes it.
fn info_expr(t TypeInfo) str
    kind := if t.kind == TypeKind.Struct then "Struct" else "Enum"
    params := list_of([quote(p) for p in t.params], "str")
    fields := list_of([field_expr(f) for f in t.fields], "FieldInfo")
    variants := list_of(
        [
            "VariantInfo(name: {quote(v.name)}, fields: {list_of([field_expr(f) for f in v.fields], "FieldInfo")})"
            for v in t.variants
        ],
        "VariantInfo",
    )
    "TypeInfo(name: {quote(t.name)}, id: {quote(t.id)}, module: {quote(t.module)}, kind: TypeKind.{kind}, is_error: {t.is_error}, params: {params}, fields: {fields}, variants: {variants})"

## Longest line the formatter leaves alone (ADR 0857).
MAX_WIDTH := 100

## `text` as the bootstrap's formatter leaves it for the shapes generators
## write: a statement `[return|x :=] Name(a, b, ...)` longer than 100
## columns has one argument per line and a trailing comma. Other lines are
## kept; the real formatter replaces this when it is written in AIL.
pub fn tidy(text str) str
    mut out := List[str]()
    for line in text.lines()
        for l in wrap_call(line)
            out.push(l)
    "{out.join("\n")}\n"

fn wrap_call(line str) List[str]
    if line.chars().len() <= MAX_WIDTH or not line.ends_with(")")
        return [line]
    open := line.find("(") else return [line]
    head := line.slice(0, open)
    if head.contains("\"") or head.contains("[") or head.contains("\{")
        return [line]
    chars := line.chars()
    mut depth := 0
    mut in_str := false
    mut args := List[str]()
    mut cur := List[char]()
    mut k := open + 1
    while k < chars.len() - 1
        c := chars[k]
        if in_str
            cur.push(c)
            if c == '\\'
                k += 1
                cur.push(chars[k])
            elif c == '"'
                in_str = false
        elif c == '"'
            in_str = true
            cur.push(c)
        elif c == '(' or c == '[' or c == '{'
            depth += 1
            cur.push(c)
        elif c == ')' or c == ']' or c == '}'
            depth -= 1
            cur.push(c)
        elif c == ',' and depth == 0
            args.push(cur.join("").trim())
            cur = []
        else
            cur.push(c)
        k += 1
    tail := cur.join("").trim()
    if tail != ""
        args.push(tail)
    if args.len() < 2 or depth != 0
        return [line]
    indent := line.slice(0, line.chars().len() - line.trim_start().chars().len())
    mut out := ["{head}("]
    for a in args
        out.push("{indent}    {a},")
    out.push("{indent})")
    out
