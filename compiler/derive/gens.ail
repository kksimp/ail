## The element types of a tuple type text `(A, B)`, split at the commas
## outside brackets (type.tuple.8), or `none` for another type.
pub fn json_tuple_parts(type_text str) List[str]?
    if not type_text.starts_with("(") or not type_text.ends_with(")")
        return none
    cs := type_text.chars()
    mut parts := List[str]()
    mut depth := 0
    mut start := 1
    for i in 1..cs.len() - 1
        c := cs[i]
        if c == '[' or c == '('
            depth += 1
        elif c == ']' or c == ')'
            depth -= 1
        elif c == ',' and depth == 0
            parts.push(type_text.slice(start, i).trim())
            start = i + 1
    parts.push(type_text.slice(start, cs.len() - 1).trim())
    parts

## Statements reading an optional `inner?` from the `Json?` expression `src`.
pub fn json_optional(
    inner str,
    src str,
    dest str,
    path str,
    indent str,
    depth int,
) str ! DeriveError
    l := "{dest}_l"
    x := "{dest}_x"
    y := "{dest}_y"
    deeper := "{indent}    "
    body := json_read(inner, x, y, path, deeper, depth + 1)?
    "{indent}mut {l} := List[{inner}]()\n{indent}if {x} := {src}\n{body}{deeper}{l}.push({y})\n{indent}{dest} := {l}.first()\n"

## A struct of each field's default (trait.assoc.1); an enum has no
## default variant to pick, so it writes its own.
pub fn derive_default(t TypeInfo) str ! DeriveError
    if t.kind == TypeKind.Enum
        return DeriveError("an enum has no default variant to pick; write `fn default() Self` in the `impl`")
    args := ["{f.name}: {default_of(f.type_text)}" for f in t.fields]
    "fn default() Self\n    {t.name}({args.join(", ")})\n"

## The default value of a field's `type_text`.
pub fn default_of(type_text str) str
    if type_text.ends_with("?")
        return "none"
    if type_text.starts_with("List[")
        or type_text.starts_with("Map[")
        or type_text.starts_with("Set[")
        return "{type_text}()"
    match type_text
        "int" => "0"
        "float" => "0.0"
        "str" => "\"\""
        "bool" => "false"
        _ => "{type_text}.default()"

## A `bool` field is a switch, `T?` of `str`, `int` or `float` an option, a
## `List[str]` the rest, any other field a positional; the field's `##`
## comment is its help, and a switch or option gets the short name of its
## first letter unless another field or `-h` has it (std.args.7).
pub fn derive_from_args(t TypeInfo) str ! DeriveError
    mut specs := List[str]()
    mut reads := List[str]()
    mut used := Set[str]()
    used.add("h")
    fail := " else e\n        return ArgsFailure(why: e.why, usage: e.usage)\n"
    for f in t.fields
        n := f.name
        help := f.doc.replace("\n", " ").replace("\\", "\\\\").replace("\"", "\\\"")
        first := n.slice(0, 1)
        short := if used.contains(first) then "" else first
        ty := f.type_text
        if ty == "bool"
            used.add(first)
            specs.push("args.flag(\"{n}\", \"{short}\", \"{help}\")")
            reads.push("    v_{n} := a.flag(\"{n}\")\n")
        elif ty == "str?" or ty == "int?" or ty == "float?"
            used.add(first)
            specs.push("args.opt(\"{n}\", \"{short}\", \"{help}\", \"\")")
            kind := ty.slice(0, ty.len() - 1)
            call := if kind == "str" then "opt" else "opt_{kind}"
            if kind != "str"
                reads.push("    if a.has(\"{n}\")\n        _ := a.{kind}(\"{n}\"){fail.replace("\n    ", "\n        ")}")
            reads.push("    v_{n} := a.{call}(\"{n}\")\n")
        elif ty == "List[str]"
            specs.push("args.rest(\"{n}\", \"{help}\")")
            reads.push("    v_{n} := a.rest\n")
        elif ty == "str"
            specs.push("args.pos(\"{n}\", \"{help}\")")
            reads.push("    v_{n} := a.get(\"{n}\")\n")
        elif ty == "int" or ty == "float"
            specs.push("args.pos(\"{n}\", \"{help}\")")
            reads.push("    v_{n} := a.{ty}(\"{n}\"){fail}")
        else
            return DeriveError("field `{n}` has the type `{ty}`; FromArgs reads `bool`, `str`, `int`, `float`, `str?`, `int?`, `float?` and `List[str]`")
    if t.kind != TypeKind.Struct
        return DeriveError("`FromArgs` needs a struct; `{t.name}` is an enum")
    ctor := ["{f.name}: v_{f.name}" for f in t.fields]
    head := "fn parse(name str, about str, words List[str]) Self ! ArgsFailure\n"
    call := "    a := args.parse(name, about, [{specs.join(", ")}], words){fail}"
    "{head}{call}{reads.join("")}    {t.name}({ctor.join(", ")})\n"

## Derive generators (ct.derive.1-4, refl.info.1-3, ADRs 0227, 0229, 0306):
## the compiler passes a generator the `TypeInfo` of the deriving type.

## One struct or enum as declared (refl.info.1).
pub struct TypeInfo
    pub name str
    pub id str
    pub module str
    pub kind TypeKind
    pub is_error bool
    pub params List[str]
    pub fields List[FieldInfo]
    pub variants List[VariantInfo]

pub enum TypeKind
    Struct
    Enum

pub struct FieldInfo
    pub name str
    pub type_text str
    pub public bool
    pub doc str

pub struct VariantInfo
    pub name str
    pub fields List[FieldInfo]

## Why a generator can't derive its trait for a type (ct.derive.4).
pub error struct DeriveError
    pub message str
