## Lowering the syntax tree of the native subset to MIR (ADR 0384).
##
## SSA is built on the fly as Braun et al. describe ("Simple and efficient
## construction of static single assignment form", 2013): a local's value
## is looked up through the predecessors of the current block; a block
## that may still gain predecessors (a loop header) gets a placeholder
## parameter that is completed when the block is sealed. Parameters that
## turn out to receive one value are removed afterwards (`simplify`).
##
## A construct outside the subset is reported as `native.subset.1` with its
## position; nothing is lowered for a program with problems.
use ast

## A function's parameter and result types, as the lowering needs them.
pub struct Sig
    pub params List[Ty]
    pub ret Ty

pub struct Problem
    pub rule str
    pub pos ast.Pos
    pub message str

pub error struct Problems "the program is outside the native subset"
    pub items List[Problem]

## Where `continue` and `break` go in the innermost loop.
struct Loop
    cont int
    exit int

## A value and its type, as an expression produces it. `id` is -1 for an
## expression without a value (a call of a function returning nothing).
struct Val
    id int
    ty Ty

struct Lower
    sigs Map[str, Sig]
    ## Functions outside the subset, already reported: calls of them are
    ## not reported again.
    bad Set[str]
    ## Constants whose value is a number or `bool` literal, inlined at
    ## each use (mod.const.1).
    consts Map[str, ast.Expr]
    strs List[str]
    str_index Map[str, int]
    sites List[Site]
    problems List[Problem]
    funcs List[Func]
    ## "rt." while lowering the runtime, "" for the program.
    prefix str
    is_rt bool
    ## The function being lowered.
    fname str
    ret Ty
    blocks List[Block]
    vals List[Ty]
    names List[str]
    sealed List[bool]
    closed List[bool]
    preds List[List[int]]
    defs List[Map[str, int]]
    incomplete List[Map[str, int]]
    cur int
    ## Source names in scope, innermost last, to unique variable keys.
    scopes List[Map[str, str]]
    var_ty Map[str, Ty]
    ## Every value a variable has had, so typing an empty list by its first
    ## `push` reaches them all.
    var_vals Map[str, List[int]]
    nvars int
    loops List[Loop]

## The primitives of the runtime (native-abi.md §6), with their result types.
PRIMS := {
    "load64": "int",
    "store64": "unit",
    "load8": "int",
    "store8": "unit",
    "loadf": "float",
    "storef": "unit",
    "syscall": "int",
    "global": "int",
    "str_addr": "int",
    "list_addr": "int",
    "list_at": "list",
    "float_bits": "int",
    "bits_float": "float",
    "target": "int",
}

## The `int` methods of two operands that are one instruction (expr.bit.1).
BIT_OPS := {"bit_and": "band", "bit_or": "bor", "bit_xor": "bxor", "shl": "shl", "shr": "shr"}

## Lower a program and, when given, the runtime; `Problems` lists what is
## outside the subset.
pub fn lower_module(path str, text str, prog ast.Program, rt ast.Program?) Module ! Problems
    mut l := Lower(
        sigs: {},
        bad: Set[str](),
        consts: {},
        strs: [],
        str_index: {},
        sites: [],
        problems: [],
        funcs: [],
        prefix: "",
        is_rt: false,
        fname: "",
        ret: Ty.Unit,
        blocks: [],
        vals: [],
        names: [],
        sealed: [],
        closed: [],
        preds: [],
        defs: [],
        incomplete: [],
        cur: 0,
        scopes: [],
        var_ty: {},
        var_vals: {},
        nvars: 0,
        loops: [],
    )
    if r := rt
        l.declare_all(r, "rt.")
    l.declare_all(prog, "")
    if r := rt
        l.prefix = "rt."
        l.is_rt = true
        for f in r.fns
            if not PRIMS.contains(f.name)
                l.lower_fn(f)
    l.prefix = ""
    l.is_rt = false
    for f in prog.fns
        l.lower_fn(f)
    if l.problems.len() > 0
        return Problems(items: l.problems.sorted(by: |p| p.pos.line * 100000 + p.pos.col))
    Module(path: path, funcs: l.funcs, strs: l.strs, sites: l.sites, lines: text.lines())

fn Lower.problem(mut self, pos ast.Pos, message str)
    problems.push(Problem(rule: "native.subset.1", pos: pos, message: message))

fn Lower.declare_all(mut self, prog ast.Program, pre str)
    for s in prog.structs
        problem(s.pos, "struct `{s.name}` isn't in the native subset yet")
    for e in prog.enums
        problem(e.pos, "enum `{e.name}` isn't in the native subset yet")
    for t in prog.traits
        problem(t.pos, "trait `{t.name}` isn't in the native subset yet")
    for c in prog.consts
        if is_literal(c.value)
            consts["{pre}{c.name}"] = c.value
        else
            problem(
                c.pos,
                "constant `{c.name}`: only number and `bool` literals are in the native subset yet",
            )
    for f in prog.fns
        before := problems.len()
        declare_fn(f, pre)
        if problems.len() > before
            bad.add("{pre}{f.name}")
            sigs.remove("{pre}{f.name}")

fn Lower.declare_fn(mut self, f ast.FnDecl, pre str)
    if f.owner != none or f.generics.len() > 0 or f.receiver != none
        problem(f.pos, "`{f.name}`: methods and generic functions aren't in the native subset yet")
        return
    if f.contracts.len() > 0
        problem(f.pos, "`{f.name}`: contracts aren't in the native subset yet")
    for a in f.attrs
        if a.name != "inline" and a.name != "pure"
            problem(a.pos, "attribute `@{a.name}` isn't in the native subset yet")
    mut params := List[Ty]()
    mut ints := 0
    mut floats := 0
    for p in f.params
        t := type_of(p.ty) else
            problem(p.pos, "parameter `{p.name}`: its type isn't in the native subset yet")
            Ty.Unknown
        if p.mutable and t.elem() == none
            problem(
                p.pos,
                "`mut` parameter `{p.name}` of a number type isn't in the native subset yet",
            )
        if t.is_float()
            floats += 1
        else
            ints += 1
        params.push(t)
    # Primitives are not called through the ABI.
    if (ints > 6 or floats > 8) and not (pre == "rt." and PRIMS.contains(f.name))
        problem(f.pos, "`{f.name}` has more than 6 integer or 8 float parameters")
    mut rty := Ty.Unit
    if r := f.ret
        t := type_of(r) else
            problem(r.pos, "`{f.name}`: its result type isn't in the native subset yet")
            Ty.Unknown
        rty = t
    sigs["{pre}{f.name}"] = Sig(params: params, ret: rty)

## The MIR type of a written type, if it is in the subset.
fn type_of(t ast.TypeRef) Ty?
    match t.shape
        Named(name, args) =>
            match name
                "int" => Ty.Int
                "float" => Ty.Float
                "bool" => Ty.Bool
                "str" => Ty.Str
                "List" =>
                    if args.len() != 1
                        return none
                    e := type_of(args[0])?
                    if is_number(e)
                        return Ty.List(e)
                    none
                _ => none
        _ => none

fn is_literal(e ast.Expr) bool
    match e
        Int | Float | Bool => true
        Unary(o, x, _) =>
            match o
                Neg => is_literal(x)
                _ => false
        _ => false

fn is_number(t Ty) bool
    match t
        Int | Float | Bool => true
        _ => false

# ---- building blocks and values ----

fn Lower.new_value(mut self, ty Ty, name str) int
    vals.push(ty)
    names.push(name)
    vals.len() - 1

fn Lower.new_block(mut self) int
    blocks.push(Block(params: [], insts: [], term: unreachable_term()))
    sealed.push(false)
    closed.push(false)
    preds.push([])
    defs.push(Map[str, int]())
    incomplete.push(Map[str, int]())
    blocks.len() - 1

## Append an instruction defining a new value of type `ty`.
fn Lower.emit(mut self, i Inst, ty Ty) int
    v := new_value(ty, "")
    mut x := i
    x.dst = v
    blocks[cur].insts.push(x)
    v

fn Lower.emit_void(mut self, i Inst)
    blocks[cur].insts.push(i)

fn Lower.op(mut self, op str, args List[int], ty Ty) int
    emit(inst(-1, op, args), ty)

## A checked operation: it traps at `site`.
fn Lower.checked(mut self, op str, args List[int], site int, ty Ty) int
    mut i := inst(-1, op, args)
    i.site = site
    emit(i, ty)

fn Lower.call(mut self, name str, args List[int], ty Ty) int
    mut i := inst(-1, "call", args)
    i.name = name
    if ty.is_unit()
        emit_void(i)
        return -1
    emit(i, ty)

fn Lower.konst(mut self, n int, ty Ty) int
    mut i := inst(-1, "const", [])
    i.imm = n
    emit(i, ty)

fn Lower.fconst(mut self, x float) int
    mut i := inst(-1, "fconst", [])
    i.fimm = x
    emit(i, Ty.Float)

fn Lower.str_value(mut self, s str) int
    mut i := inst(-1, "str", [])
    i.imm = str_lit(s)
    emit(i, Ty.Str)

## Whether the current block already ends (after `return`, `break`...).
fn Lower.done(self) bool
    closed[cur]

fn Lower.finish(mut self, term Term)
    if done()
        return
    for s in term.targets
        preds[s].push(cur)
    blocks[cur].term = term
    closed[cur] = true

## Start lowering into a block that nothing reaches: code after a jump.
fn Lower.dead_block(mut self)
    b := new_block()
    sealed[b] = true
    cur = b

fn Lower.jump(mut self, to int, args List[int])
    finish(jump_to(to, args))

## End the current block with a branch whose edges pass `yes_args` and
## `no_args`. The two targets must differ.
fn Lower.branch(mut self, cond int, yes int, yes_args List[int], no int, no_args List[int])
    mut t := branch_on(cond, yes, no)
    t.args = [yes_args, no_args]
    finish(t)

fn Lower.seal(mut self, b int)
    pending := incomplete[b]
    for key in pending.keys()
        add_edge_args(key, pending[key], b)
    sealed[b] = true

## Give every edge into `b` the value of `key` for its new parameter.
fn Lower.add_edge_args(mut self, key str, param int, b int)
    for p in preds[b]
        v := read_var(key, p)
        for e in 0..blocks[p].term.targets.len()
            if blocks[p].term.targets[e] == b
                blocks[p].term.args[e].push(v)

fn Lower.write_var(mut self, key str, b int, v int)
    defs[b][key] = v
    var_vals.push(key, v)

fn Lower.read_var(mut self, key str, b int) int
    if v := defs[b].get(key)
        return v
    mut v := -1
    if not sealed[b]
        v = new_value(var_ty[key], key.split("#")[0])
        blocks[b].params.push(v)
        incomplete[b][key] = v
    elif preds[b].len() == 1
        v = read_var(key, preds[b][0])
    else
        v = new_value(var_ty[key], key.split("#")[0])
        blocks[b].params.push(v)
        write_var(key, b, v)
        add_edge_args(key, v, b)
    write_var(key, b, v)
    v

## Declare a source name in the innermost scope and give it a value.
fn Lower.declare(mut self, name str, ty Ty, v int)
    nvars += 1
    key := "{name}#{nvars}"
    scopes[scopes.len() - 1][name] = key
    var_ty[key] = ty
    if v >= 0 and names[v] == ""
        names[v] = name
    write_var(key, cur, v)

fn Lower.lookup(self, name str) str?
    mut i := scopes.len() - 1
    while i >= 0
        if k := scopes[i].get(name)
            return k
        i -= 1
    none

## A check's trap site, or -1 in the runtime, whose arithmetic wraps and
## whose indexing is unchecked (native-abi.md §7).
fn Lower.site(mut self, rule str, kind str, op str, pos ast.Pos) int
    if is_rt
        return -1
    sites.push(Site(rule: rule, kind: kind, op: op, line: pos.line, col: pos.col, func: fname))
    sites.len() - 1

fn Lower.str_lit(mut self, s str) int
    if i := str_index.get(s)
        return i
    strs.push(s)
    str_index[s] = strs.len() - 1
    strs.len() - 1

# ---- functions ----

fn Lower.lower_fn(mut self, f ast.FnDecl)
    fname = "{prefix}{f.name}"
    sig := sigs.get(fname) else return
    ret = sig.ret
    blocks = []
    vals = []
    names = []
    sealed = []
    closed = []
    preds = []
    defs = []
    incomplete = []
    scopes = [Map[str, str]()]
    var_ty = {}
    var_vals = {}
    nvars = 0
    loops = []
    cur = new_block()
    sealed[cur] = true
    mut params := List[int]()
    for i in 0..f.params.len()
        p := f.params[i]
        v := new_value(sig.params[i], p.name)
        blocks[cur].params.push(v)
        params.push(v)
        declare(p.name, sig.params[i], v)
    body := f.body else return
    want := not ret.is_unit()
    result := lower_block(body, want)
    if not done()
        if want
            if r := result
                finish(return_of(convert(r, ret, f.pos)))
            else
                problem(f.pos, "`{f.name}` must end with its result")
        else
            finish(return_of(-1))
    func := simplify(Func(
        name: fname,
        params: params,
        ret: ret,
        blocks: blocks,
        vals: vals,
        names: names,
    ))
    for err in verify(func)
        problems.push(Problem(
            rule: "native.build.2",
            pos: f.pos,
            message: "internal error: invalid MIR: {err}",
        ))
    funcs.push(func)

## The value as the type the context expects: an `int` literal already
## became a `float` where one was expected; anything else must match.
fn Lower.convert(mut self, v Val, want Ty, pos ast.Pos) int
    if not same_ty(v.ty, want)
        problem(pos, "expected `{want.name()}`, found `{v.ty.name()}`")
    v.id

fn same_ty(a Ty, b Ty) bool
    x := a.elem() else return a.name() == b.name()
    y := b.elem() else return false
    same_ty(x, y) or x.is_unknown() or y.is_unknown()

## Lower statements in a new scope. With `want`, a final expression
## statement is the block's value.
fn Lower.lower_block(mut self, body List[ast.Stmt], want bool) Val?
    scopes.push(Map[str, str]())
    mut result := Val(id: -2, ty: Ty.Unit)
    for i in 0..body.len()
        s := body[i]
        if done()
            dead_block()
        if want and i == body.len() - 1
            if e := final_expr(s)
                result = lower_expr(e, none) else Val(id: -2, ty: Ty.Unit)
                continue
        lower_stmt(s)
    scopes.pop()
    if result.id == -2
        return none
    result

fn final_expr(s ast.Stmt) ast.Expr?
    match s
        Eval(e) => e
        _ => none

# ---- statements ----

fn Lower.lower_stmt(mut self, s ast.Stmt)
    match s
        Let(name, pos, _, value, otherwise) =>
            if otherwise != none
                problem(pos, "`else` on a binding isn't in the native subset yet")
                return
            v := lower_value(value, none) else
                # Reported; uses of the name stay quiet.
                declare(name, Ty.Unknown, -1)
                return
            declare(name, v.ty, copy_if_place(value, v))
        Assign(target, op, value, pos) => lower_assign(target, op, value, pos)
        While(cond, body, _) => lower_while(cond, body)
        For(_, var, _, mutable, iter, body, pos) =>
            if mutable
                problem(pos, "`for mut` isn't in the native subset yet")
                return
            lower_for(var, iter, body)
        Break(pos) =>
            if loops.len() == 0
                problem(pos, "`break` outside a loop")
                return
            jump(loops[loops.len() - 1].exit, [])
        Continue(pos) =>
            if loops.len() == 0
                problem(pos, "`continue` outside a loop")
                return
            jump(loops[loops.len() - 1].cont, [])
        Return(value, pos) =>
            if e := value
                v := lower_value(e, ret) else return
                finish(return_of(convert(v, ret, pos)))
            else
                finish(return_of(-1))
        Eval(e) =>
            lower_expr(e, Ty.Unit)
        Handle(value, _) => problem(
            expr_pos(value),
            "`else` handlers aren't in the native subset yet",
        )
        Defer(_, pos) => problem(pos, "`defer` isn't in the native subset yet")
        With(_, _, _, _, pos) => problem(pos, "`with` isn't in the native subset yet")
        Unsafe(_, pos) => problem(pos, "`unsafe` blocks aren't in the native subset yet")

## A list read from a variable or an element is copied when it is bound
## or assigned, so the two stay independent (own.val.1, native-abi.md §4).
fn Lower.copy_if_place(mut self, e ast.Expr, v Val) int
    if v.ty.elem() == none or not is_place(e)
        return v.id
    call("rt.list_copy", [v.id], v.ty)

fn is_place(e ast.Expr) bool
    match e
        Name | Index => true
        _ => false

fn Lower.lower_assign(mut self, target ast.Expr, op ast.BinOp?, value ast.Expr, pos ast.Pos)
    match target
        Name(name, npos) =>
            key := lookup(name) else
                problem(npos, "unknown name `{name}`")
                return
            ty := var_ty[key]
            mut v := -1
            if o := op
                old := Val(id: read_var(key, cur), ty: ty)
                r := lower_value(value, ty) else return
                v = binary(o, old, r, pos).id
            else
                r := lower_value(value, ty) else return
                v = copy_if_place(value, Val(id: convert(r, ty, pos), ty: ty))
            write_var(key, cur, v)
        Index(recv, index, ipos) =>
            l := lower_value(recv, none) else return
            elem := l.ty.elem() else
                problem(ipos, "indexing a `{l.ty.name()}` isn't in the native subset yet")
                return
            i := lower_value(index, Ty.Int) else return
            mut v := -1
            if o := op
                old := Val(id: checked("get", [l.id, i.id], bounds_site(ipos), elem), ty: elem)
                r := lower_value(value, elem) else return
                v = binary(o, old, r, pos).id
            else
                r := lower_value(value, elem) else return
                v = convert(r, elem, pos)
            mut set := inst(-1, "set", [l.id, i.id, v])
            set.site = bounds_site(ipos)
            emit_void(set)
        _ => problem(pos, "this assignment target isn't in the native subset yet")

fn Lower.bounds_site(mut self, pos ast.Pos) int
    site("type.coll.4", "bounds", "", pos)

fn Lower.lower_while(mut self, cond ast.Expr, body List[ast.Stmt])
    head := new_block()
    jump(head, [])
    cur = head
    c := lower_value(cond, Ty.Bool) else return
    inner := new_block()
    exit := new_block()
    branch(c.id, inner, [], exit, [])
    seal(inner)
    cur = inner
    loops.push(Loop(cont: head, exit: exit))
    lower_block(body, false)
    loops.pop()
    jump(head, [])
    seal(head)
    seal(exit)
    cur = exit

## `for x in a..b`, `a..=b` or a list (expr.loop.2-3). The index is a hidden
## variable; `continue` goes to the latch, which steps it.
fn Lower.lower_for(mut self, var str, iter ast.Expr, body List[ast.Stmt])
    scopes.push(Map[str, str]())
    mut lo := -1
    mut hi := -1
    mut inclusive := false
    mut list := -1
    mut elem := Ty.Int
    match iter
        Range(a, b, incl, rpos) =>
            if a == none or b == none
                problem(rpos, "a `for` over an open range isn't in the native subset")
                return
            x := lower_value(a else iter, Ty.Int) else return
            y := lower_value(b else iter, Ty.Int) else return
            lo = x.id
            hi = y.id
            inclusive = incl
        _ =>
            l := lower_value(iter, none) else return
            e := l.ty.elem() else
                problem(
                    expr_pos(iter),
                    "a `for` over a `{l.ty.name()}` isn't in the native subset yet",
                )
                return
            elem = e
            list = l.id
            if mutates(body, iter)
                list = call("rt.list_copy", [l.id], l.ty)
            lo = konst(0, Ty.Int)
            hi = op("len", [list], Ty.Int)
    nvars += 1
    ikey := "#i{nvars}"
    var_ty[ikey] = Ty.Int
    write_var(ikey, cur, lo)
    head := new_block()
    jump(head, [])
    cur = head
    i := read_var(ikey, head)
    c := op(if inclusive then "le" else "lt", [i, hi], Ty.Bool)
    inner := new_block()
    exit := new_block()
    latch := new_block()
    branch(c, inner, [], exit, [])
    seal(inner)
    cur = inner
    if list >= 0
        declare(var, elem, op("get", [list, i], elem))
    else
        declare(var, Ty.Int, i)
    loops.push(Loop(cont: latch, exit: exit))
    lower_block(body, false)
    loops.pop()
    jump(latch, [])
    seal(latch)
    cur = latch
    j := read_var(ikey, latch)
    if inclusive
        # `i + 1` would overflow when `hi` is the largest `int`.
        last := op("eq", [j, hi], Ty.Bool)
        step := new_block()
        branch(last, exit, [], step, [])
        seal(step)
        cur = step
    write_var(ikey, cur, op("add", [j, konst(1, Ty.Int)], Ty.Int))
    jump(head, [])
    seal(head)
    seal(exit)
    cur = exit
    scopes.pop()

## Whether a loop body may change the list it iterates (so the loop needs
## a copy: `for x in xs` sees the list as it was, expr.loop.3).
fn mutates(body List[ast.Stmt], iter ast.Expr) bool
    name := match iter
        Name(n, _) => n
        _ => return false
    block_mutates(body, name)

fn block_mutates(body List[ast.Stmt], name str) bool
    for s in body
        if stmt_mutates(s, name)
            return true
    false

fn stmt_mutates(s ast.Stmt, name str) bool
    match s
        Let(_, _, _, value, _) => expr_mutates(value, name)
        Assign(target, _, value, _) => root_is(target, name) or expr_mutates(value, name)
        While(cond, body, _) => expr_mutates(cond, name) or block_mutates(body, name)
        For(_, _, _, _, it, body, _) => expr_mutates(it, name) or block_mutates(body, name)
        Return(v, _) =>
            e := v else return false
            expr_mutates(e, name)
        Eval(e) => expr_mutates(e, name)
        _ => true

fn root_is(e ast.Expr, name str) bool
    match e
        Name(n, _) => n == name
        Index(r, _, _) => root_is(r, name)
        Member(r, _, _) => root_is(r, name)
        _ => false

fn args_mutate(args List[ast.Arg], name str) bool
    for a in args
        if a.mutable and root_is(a.value, name) or expr_mutates(a.value, name)
            return true
    false

## Conservative: any method call on the list but `len`, or a `mut`
## argument naming it, counts as a change.
fn expr_mutates(e ast.Expr, name str) bool
    match e
        Method(recv, m, _, args) => root_is(recv, name) and m != "len"
            or args_mutate(args, name)
            or expr_mutates(recv, name)
        Call(_, args, _) => args_mutate(args, name)
        Binary(_, a, b, _) => expr_mutates(a, name) or expr_mutates(b, name)
        Unary(_, a, _) => expr_mutates(a, name)
        Index(r, i, _) => expr_mutates(r, name) or expr_mutates(i, name)
        If(branches, els, _, _) =>
            for b in branches
                c := match b.cond
                    Test(x) => x
                    Bind(_, _, x) => x
                if expr_mutates(c, name) or block_mutates(b.body, name)
                    return true
            body := els else return false
            block_mutates(body, name)
        Interp(parts, _) =>
            for p in parts
                x := match p
                    Hole(x) => x
                    Fmt(x, _) => x
                    Lit => continue
                if expr_mutates(x, name)
                    return true
            false
        ListLit(items, _) =>
            for x in items
                if expr_mutates(x, name)
                    return true
            false
        _ => false

# ---- expressions ----

## An expression that must have a value.
fn Lower.lower_value(mut self, e ast.Expr, want Ty?) Val?
    v := lower_expr(e, want)?
    if v.id < 0
        problem(expr_pos(e), "this expression has no value")
        return none
    v

## Lower an expression; `want` is the type the context expects, which lets
## an `int` literal stand for a `float` (expr.lit.3), and is `unit` for an
## expression statement. `none` after a problem.
fn Lower.lower_expr(mut self, e ast.Expr, want Ty?) Val?
    match e
        Int(text, pos) =>
            n := text.to_int() else
                problem(pos, "integer literal `{text}` out of range")
                return none
            if wants_float(want)
                return Val(id: fconst(n.to_float()), ty: Ty.Float)
            Val(id: konst(n, Ty.Int), ty: Ty.Int)
        Float(x, _) => Val(id: fconst(x), ty: Ty.Float)
        Bool(b, _) => Val(id: konst(if b then 1 else 0, Ty.Bool), ty: Ty.Bool)
        Str(s, _) => Val(id: str_value(s), ty: Ty.Str)
        Bytes(_, pos) =>
            problem(pos, "`bytes` literals aren't in the native subset yet")
            none
        Name(name, pos) =>
            key := lookup(name) else
                if c := consts.get("{prefix}{name}")
                    return lower_expr(c, want)
                problem(
                    pos,
                    "`{name}` isn't in the native subset yet (only locals, parameters and constants)",
                )
                return none
            if var_ty[key].is_unknown()
                return none
            Val(id: read_var(key, cur), ty: var_ty[key])
        Unary(o, operand, pos) => lower_unary(o, operand, pos, want)
        Binary(o, lhs, rhs, pos) =>
            match o
                And => short_circuit(true, lhs, rhs)
                Or => short_circuit(false, lhs, rhs)
                _ =>
                    if is_int_lit(lhs)
                        # Lower the other side first to learn the type: a literal has no effects.
                        b := lower_value(rhs, operand_want(o, want))?
                        a := lower_value(lhs, b.ty)?
                        return binary(o, a, b, pos)
                    a := lower_value(lhs, operand_want(o, want))?
                    b := lower_value(rhs, a.ty)?
                    binary(o, a, b, pos)
        Call(callee, args, pos) => lower_call(callee, args, pos)
        Method(recv, name, npos, args) => lower_method(recv, name, npos, args)
        Index(recv, index, pos) =>
            l := lower_value(recv, none)?
            elem := l.ty.elem() else return unsupported(pos, "indexing a `{l.ty.name()}`")
            if is_range(index)
                return unsupported(pos, "list slices")
            i := lower_value(index, Ty.Int)?
            Val(id: checked("get", [l.id, i.id], bounds_site(pos), elem), ty: elem)
        ListLit(items, pos) => lower_list(items, pos, want)
        If(branches, els, _, pos) => lower_if(branches, els, pos, want)
        Interp(_, pos) => unsupported(pos, "string interpolation outside `print`")
        Char(_, pos) => unsupported(pos, "`char`")
        NoneLit(pos) => unsupported(pos, "`none`")
        Hole(pos) => unsupported(pos, "`todo`")
        TypeArgs(_, _, pos) => unsupported(pos, "this expression")
        Member(_, _, pos) => unsupported(pos, "fields")
        Range(_, _, _, pos) => unsupported(pos, "a range outside `for`")
        MapLit(_, pos) => unsupported(pos, "maps")
        SetLit(_, pos) => unsupported(pos, "sets")
        Match(_, _, pos) => unsupported(pos, "`match`")
        Try(_, _, pos) => unsupported(pos, "`?`")
        Comp(_, _, _, _, pos) => unsupported(pos, "comprehensions")
        OrElse(_, _, pos) => unsupported(pos, "`else`")
        NewRef(_, pos) => unsupported(pos, "`ref`")

fn Lower.unsupported(mut self, pos ast.Pos, what str) Val?
    problem(pos, "not in the native subset yet: {what}")
    none

fn wants_float(want Ty?) bool
    w := want else return false
    w.is_float()

fn is_int_lit(e ast.Expr) bool
    match e
        Int => true
        _ => false

fn is_range(e ast.Expr) bool
    match e
        Range => true
        _ => false

## What an operator's first operand should be: arithmetic passes the
## context's type on; a comparison's operands decide their own.
fn operand_want(o ast.BinOp, want Ty?) Ty?
    match o
        Add | Sub | Mul | Div | Rem => want
        _ => none

fn Lower.lower_unary(mut self, o ast.UnOp, operand ast.Expr, pos ast.Pos, want Ty?) Val?
    match o
        Neg =>
            if int_text(operand) == "9223372036854775808"
                # The smallest `int` is written `-9223372036854775808` (lex.num.3).
                if wants_float(want)
                    return Val(id: fconst(-9223372036854775807.0 - 1.0), ty: Ty.Float)
                return Val(id: konst(-9223372036854775807 - 1, Ty.Int), ty: Ty.Int)
            a := lower_value(operand, want)?
            match a.ty
                Int => Val(
                    id: checked("neg", [a.id], site("expr.arith.1", "neg", "-", pos), Ty.Int),
                    ty: Ty.Int,
                )
                Float => Val(id: op("fneg", [a.id], Ty.Float), ty: Ty.Float)
                _ => unsupported(pos, "`-` on `{a.ty.name()}`")
        Not =>
            a := lower_value(operand, Ty.Bool)?
            Val(id: op("not", [a.id], Ty.Bool), ty: Ty.Bool)
        Spawn => unsupported(pos, "`spawn`")

fn int_text(e ast.Expr) str
    match e
        Int(t, _) => t
        _ => ""

fn op_name(o ast.BinOp) str
    match o
        Add => "add"
        Sub => "sub"
        Mul => "mul"
        Div => "div"
        Rem => "rem"
        Eq => "eq"
        Ne => "ne"
        Lt => "lt"
        Le => "le"
        Gt => "gt"
        Ge => "ge"
        And => "and"
        Or => "or"

fn op_symbol(o ast.BinOp) str
    match o
        Add => "+"
        Sub => "-"
        Mul => "*"
        Div => "/"
        Rem => "%"
        Eq => "=="
        Ne => "!="
        Lt => "<"
        Le => "<="
        Gt => ">"
        Ge => ">="
        And => "and"
        Or => "or"

fn is_comparison(o ast.BinOp) bool
    match o
        Eq | Ne | Lt | Le | Gt | Ge => true
        _ => false

fn Lower.binary(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val
    name := op_name(o)
    if not same_ty(a.ty, b.ty)
        problem(pos, "`{op_symbol(o)}` on `{a.ty.name()}` and `{b.ty.name()}`")
        return a
    cmp := is_comparison(o)
    match a.ty
        Int =>
            if cmp
                return Val(id: op(name, [a.id, b.id], Ty.Bool), ty: Ty.Bool)
            divides := name == "div" or name == "rem"
            rule := if divides then "expr.arith.3" else "expr.arith.1"
            kind := if divides then "div" else "arith"
            s := site(rule, kind, op_symbol(o), pos)
            Val(id: checked(name, [a.id, b.id], s, Ty.Int), ty: Ty.Int)
        Float =>
            if cmp
                return Val(id: op("f{name}", [a.id, b.id], Ty.Bool), ty: Ty.Bool)
            if name == "rem"
                problem(pos, "`%` on `float`")
                return a
            Val(id: op("f{name}", [a.id, b.id], Ty.Float), ty: Ty.Float)
        Bool =>
            if name == "eq" or name == "ne"
                return Val(id: op(name, [a.id, b.id], Ty.Bool), ty: Ty.Bool)
            problem(pos, "`{op_symbol(o)}` on `bool` isn't in the native subset yet")
            a
        _ =>
            problem(pos, "`{op_symbol(o)}` on `{a.ty.name()}` isn't in the native subset yet")
            a

## `a and b` (`is_and`) or `a or b`: `b` runs only when it decides.
fn Lower.short_circuit(mut self, is_and bool, lhs ast.Expr, rhs ast.Expr) Val?
    a := lower_value(lhs, Ty.Bool)?
    join := new_block()
    r := new_value(Ty.Bool, "")
    blocks[join].params.push(r)
    rhs_b := new_block()
    k := konst(if is_and then 0 else 1, Ty.Bool)
    if is_and
        branch(a.id, rhs_b, [], join, [k])
    else
        branch(a.id, join, [k], rhs_b, [])
    seal(rhs_b)
    cur = rhs_b
    b := lower_value(rhs, Ty.Bool)?
    jump(join, [b.id])
    seal(join)
    cur = join
    Val(id: r, ty: Ty.Bool)

## `if`, as a statement or a value (expr.if.1-4). The arms of a value `if`
## pass their results to the join block's first parameter.
fn Lower.lower_if(
    mut self,
    branches List[ast.Branch],
    els List[ast.Stmt]?,
    pos ast.Pos,
    want Ty?,
) Val?
    join := new_block()
    value := els != none and want_value(want)
    mut result := -1
    mut rty := Ty.Unknown
    if value
        result = new_value(Ty.Unknown, "")
        blocks[join].params.push(result)
    for br in branches
        c := match br.cond
            Test(x) => lower_value(x, Ty.Bool)?
            Bind(_, bpos, _) => return unsupported(bpos, "`if x := e`")
        yes := new_block()
        no := new_block()
        branch(c.id, yes, [], no, [])
        seal(yes)
        seal(no)
        cur = yes
        v := lower_block(br.body, value)
        rty = arm_end(join, value, v, pos, rty)
        cur = no
    if body := els
        v := lower_block(body, value)
        rty = arm_end(join, value, v, pos, rty)
    else
        jump(join, [])
    seal(join)
    cur = join
    if value
        vals[result] = rty
        return Val(id: result, ty: rty)
    Val(id: -1, ty: Ty.Unit)

## A statement-level `if` is lowered with `want` unit.
fn want_value(want Ty?) bool
    w := want else return true
    not w.is_unit()

## Finish an arm of an `if`; gives the `if`'s type as known so far.
fn Lower.arm_end(mut self, join int, value bool, v Val?, pos ast.Pos, rty Ty) Ty
    if done()
        return rty
    if not value
        jump(join, [])
        return rty
    x := v else
        problem(pos, "this `if` needs a value in every branch")
        jump(join, [])
        return rty
    mut t := rty
    if t.is_unknown()
        t = x.ty
    jump(join, [convert(x, t, pos)])
    t

fn Lower.lower_list(mut self, items List[ast.Expr], pos ast.Pos, want Ty?) Val?
    mut elem := Ty.Unknown
    if w := want
        elem = w.elem() else Ty.Unknown
    n := konst(items.len(), Ty.Int)
    mut vs := List[int]()
    for x in items
        v := lower_value(x, if elem.is_unknown() then none else elem)?
        if elem.is_unknown()
            elem = v.ty
        if not is_number(elem)
            return unsupported(pos, "a list of `{elem.name()}`")
        vs.push(convert(v, elem, pos))
    l := call("rt.list_new", [n], Ty.List(elem))
    for v in vs
        call(push_fn(elem), [l, v], Ty.Unit)
    Val(id: l, ty: Ty.List(elem))

fn push_fn(elem Ty) str
    if elem.is_float() then "rt.list_pushf" else "rt.list_push"

fn Lower.lower_call(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos) Val?
    match callee
        Name(name, npos) =>
            if name == "print" and not is_rt
                return lower_print(args, pos)
            if is_rt and PRIMS.contains(name)
                return lower_prim(name, args)
            key := "{prefix}{name}"
            if bad.contains(key)
                return none
            sig := sigs.get(key) else return unsupported(npos, "calling `{name}`")
            if args.len() != sig.params.len()
                return unsupported(pos, "this call")
            mut vs := List[int]()
            for i in 0..args.len()
                a := args[i]
                if a.label != none
                    return unsupported(pos, "labelled arguments")
                v := lower_value(a.value, sig.params[i])?
                vs.push(convert(v, sig.params[i], expr_pos(a.value)))
            Val(id: call(key, vs, sig.ret), ty: sig.ret)
        TypeArgs(name, targs, tpos) =>
            if name == "List" and targs.len() == 1 and args.len() == 0
                t := type_of(ast.TypeRef(shape: Named("List", targs), pos: tpos)) else
                    return unsupported(tpos, "this list type")
                return Val(id: call("rt.list_new", [konst(0, Ty.Int)], t), ty: t)
            unsupported(tpos, "`{name}[...]`")
        _ => unsupported(pos, "this call")

fn Lower.lower_prim(mut self, name str, args List[ast.Arg]) Val?
    mut vs := List[int]()
    for a in args
        v := lower_value(a.value, none)?
        vs.push(v.id)
    t := match PRIMS[name]
        "int" => Ty.Int
        "float" => Ty.Float
        "list" => Ty.List(Ty.Int)
        _ => Ty.Unit
    mut i := inst(-1, "prim", vs)
    i.name = name
    if t.is_unit()
        emit_void(i)
        return Val(id: -1, ty: t)
    Val(id: emit(i, t), ty: t)

## `print(x)`: a number, `bool`, string literal, list of numbers, or an
## interpolation of those (17-std, native-abi.md §8).
fn Lower.lower_print(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1
        return unsupported(pos, "this `print`")
    match args[0].value
        Interp(parts, ipos) =>
            for p in parts
                match p
                    Lit(text) => call("rt.out_str", [str_value(text)], Ty.Unit)
                    Hole(x) =>
                        v := lower_value(x, none)?
                        out(v, ipos)?
                    Fmt(_, _) => return unsupported(ipos, "format specifications")
        _ =>
            v := lower_value(args[0].value, none)?
            out(v, pos)?
    call("rt.out_nl", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

fn out_fn(t Ty) str
    match t
        Int => "rt.out_int"
        Float => "rt.out_float"
        Bool => "rt.out_bool"
        Str => "rt.out_str"
        List(e) =>
            match e
                Float => "rt.out_list_float"
                Bool => "rt.out_list_bool"
                _ => "rt.out_list_int"
        _ => ""

fn Lower.out(mut self, v Val, pos ast.Pos) Val?
    f := out_fn(v.ty)
    if f == ""
        return unsupported(pos, "printing a `{v.ty.name()}`")
    call(f, [v.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

fn Lower.lower_method(mut self, recv ast.Expr, name str, npos ast.Pos, args List[ast.Arg]) Val?
    r := lower_value(recv, none)?
    mut vs := List[Val]()
    for a in args
        if a.label != none or a.mutable
            return unsupported(npos, "this method call")
        mut arg_want := r.ty
        if e := r.ty.elem()
            arg_want = if name == "push" then e else Ty.Int
        vs.push(lower_value(a.value, if arg_want.is_unknown() then none else arg_want)?)
    match r.ty
        Int =>
            if name == "to_float" and vs.len() == 0
                return Val(id: op("itof", [r.id], Ty.Float), ty: Ty.Float)
            if name == "abs" and vs.len() == 0
                return Val(id: int_abs(r.id, npos), ty: Ty.Int)
            if (name == "min" or name == "max") and vs.len() == 1
                return Val(id: int_minmax(name, r.id, vs[0].id), ty: Ty.Int)
            # expr.bit.1-2
            if BIT_OPS.contains(name) and vs.len() == 1
                mut s := -1
                if name == "shl" or name == "shr"
                    s = site("expr.bit.2", "shift", name, npos)
                return Val(id: checked(BIT_OPS[name], [r.id, vs[0].id], s, Ty.Int), ty: Ty.Int)
            if name == "bit_not" and vs.len() == 0
                return Val(id: op("bnot", [r.id], Ty.Int), ty: Ty.Int)
        Float =>
            if name == "to_int" and vs.len() == 0
                s := site("type.num.9", "float_int", "", npos)
                return Val(id: checked("ftoi", [r.id], s, Ty.Int), ty: Ty.Int)
            if (name == "sqrt" or name == "abs" or name == "floor" or name == "ceil")
                and vs.len() == 0
                return Val(id: op(name, [r.id], Ty.Float), ty: Ty.Float)
        List(e) =>
            if name == "len" and vs.len() == 0
                return Val(id: op("len", [r.id], Ty.Int), ty: Ty.Int)
            if name == "push" and vs.len() == 1
                mut el := e
                if e.is_unknown()
                    el = vs[0].ty
                    retype(recv, Ty.List(el))
                call(push_fn(el), [r.id, convert(vs[0], el, npos)], Ty.Unit)
                return Val(id: -1, ty: Ty.Unit)
        _ => return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## An empty list typed by its first `push` (type.coll.6): the variable takes
## the element type from here on.
fn Lower.retype(mut self, recv ast.Expr, t Ty)
    n := match recv
        Name(n, _) => n
        _ => return
    key := lookup(n) else return
    var_ty[key] = t
    for v in var_vals[key]
        vals[v] = t

fn Lower.int_abs(mut self, a int, pos ast.Pos) int
    # |a| is `-a` when `a < 0`, which traps on the smallest `int` (expr.arith.1).
    neg := op("lt", [a, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    yes := new_block()
    branch(neg, yes, [], join, [a])
    seal(yes)
    cur = yes
    jump(join, [checked("neg", [a], site("expr.arith.1", "abs", "abs", pos), Ty.Int)])
    seal(join)
    cur = join
    r

fn Lower.int_minmax(mut self, name str, a int, b int) int
    pick_a := op(if name == "min" then "le" else "ge", [a, b], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    other := new_block()
    branch(pick_a, join, [a], other, [])
    seal(other)
    cur = other
    jump(join, [b])
    seal(join)
    cur = join
    r

pub fn expr_pos(e ast.Expr) ast.Pos
    match e
        Str(_, p) => p
        Bytes(_, p) => p
        Interp(_, p) => p
        Int(_, p) => p
        Float(_, p) => p
        Char(_, p) => p
        Bool(_, p) => p
        NoneLit(p) => p
        Hole(p) => p
        Name(_, p) => p
        TypeArgs(_, _, p) => p
        ListLit(_, p) => p
        Call(_, _, p) => p
        Method(_, _, p, _) => p
        Member(_, _, p) => p
        Index(_, _, p) => p
        Unary(_, _, p) => p
        Binary(_, _, _, p) => p
        Range(_, _, _, p) => p
        MapLit(_, p) => p
        SetLit(_, p) => p
        If(_, _, _, p) => p
        Match(_, _, p) => p
        Try(_, _, p) => p
        Comp(_, _, _, _, p) => p
        OrElse(_, _, p) => p
        NewRef(_, p) => p
