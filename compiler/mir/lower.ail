## Lowering the syntax tree of the native subset to MIR (ADR 0384).
##
## SSA is built on the fly as Braun et al. describe ("Simple and efficient
## construction of static single assignment form", 2013): a local's value
## is looked up through the predecessors of the current block; a block
## that may still gain predecessors (a loop header) gets a placeholder
## parameter that is completed when the block is sealed. Parameters that
## turn out to receive one value are removed afterwards (`simplify`).
##
## A construct outside the subset is reported as `native.subset.1` with its
## position; nothing is lowered for a program with problems.
use ast

## A function's parameter and result types, as the lowering needs them.
pub struct Sig
    pub params List[Ty]
    pub ret Ty
    ## The function can fail: `ret` is its success type (lower_err.ail).
    pub fails bool

pub struct Problem
    pub rule str
    pub pos ast.Pos
    pub message str

pub error struct Problems "the program is outside the native subset"
    pub items List[Problem]
    ## The file of each problem.
    pub files List[str]

## Where `continue` and `break` go in a loop, and the loop's position, which
## `break outer` names (expr.loop.10).
struct Loop
    cont int
    exit int
    at ast.Pos

## A value and its type, as an expression produces it. `id` is -1 for an
## expression without a value (a call of a function returning nothing).
struct Val
    id int
    ty Ty

struct Lower
    ## The source file being lowered (for error traces) and every file's.
    path str
    file_paths List[str]
    ## Zero-field `error struct`s to their messages (lower_err.ail).
    err_msgs Map[str, str]
    ## The error type of each function that can fail, when it names one.
    fn_errs Map[str, Ty]
    ## Functions whose error set is inferred (`fn f() !`), to the error type their `?` calls give so far (lower_err.ail).
    infer_errs Map[str, Ty]
    ## The type the next block's final expression should have (consumed by `lower_block`).
    tail_want Ty?
    ## Where the function's last expression begins: the trace line of an error it ends in.
    tail_pos ast.Pos
    ## The function being lowered can fail.
    fails bool
    sigs Map[str, Sig]
    ## Functions outside the subset, already reported: calls of them are
    ## not reported again.
    bad Set[str]
    ## Constants whose value is a number or `bool` literal, inlined at
    ## each use (mod.const.1).
    consts Map[str, ast.Expr]
    strs List[str]
    str_index Map[str, int]
    ## The source path and lines, for the trap texts of `lower_str.ail`.
    src_paths List[str]
    src_lines List[List[str]]
    sites List[Site]
    problems List[Problem]
    funcs List[Func]
    ## "rt." while lowering the runtime, "" for the program.
    prefix str
    is_rt bool
    ## The function being lowered.
    fname str
    ## Facts about the function being lowered (lower_param.ail).
    facts Facts
    ret Ty
    blocks List[Block]
    vals List[Ty]
    names List[str]
    sealed List[bool]
    closed List[bool]
    preds List[List[int]]
    defs List[Map[str, int]]
    incomplete List[Map[str, int]]
    cur int
    ## Source names in scope, innermost last, to unique variable keys.
    scopes List[Map[str, str]]
    var_ty Map[str, Ty]
    ## Every value a variable has had, so typing an empty list by its first
    ## `push` reaches them all.
    var_vals Map[str, List[int]]
    nvars int
    loops List[Loop]
    ## Tasks (lower_task.ail, ADR 0599).
    tk TaskState
    ## Set while the one-at-a-time arm of a fused tensor chain is lowered.
    nofuse bool
    ## The structs' fields (ADR 0392).
    structs Map[str, List[Slot]]
    ## Each struct's field defaults, in field order (type.struct.8, lower_fielddef.ail).
    field_defaults Map[str, List[ast.Expr?]]
    ## The fields an `impl Hash ... uses` names, by struct (lower_keys.ail).
    hash_uses_of Map[str, List[str]]
    ## The struct whose method is being lowered, else "".
    self_ty str
    ## Variables whose list or struct belongs to someone else (parameters,
    ## `for` variables): returning one copies it.
    borrowed Set[str]
    ## The generated `copy.T` functions asked for, by name.
    copy_tys Map[str, Ty]
    ## Unique types and their releases (lower_unique.ail).
    uniq UniqState
    unw Unwind
    ## Where each `uhwhatnow?` hole is, `FILE:LINE:COL` (expr.hole.3).
    asks Set[str]
    ## The `.ct` copies of the functions constants call (ct.eval.3, lower_ctsteps.ail).
    ctsteps CtSteps
    ## `any T` implementations and dispatchers (ADR 0616).
    traits Traits
    ## `problems.len()` when the current function began.
    fn_problems int
    ## Set when the function used something already reported elsewhere (a
    ## function or variable outside the subset): its MIR is incomplete.
    fn_failed bool
    ## The source file being lowered, its imports (name to module) and
    ## those of every file, and each file's key prefix (ADR 0393).
    file int
    aliases Map[str, str]
    file_aliases List[Map[str, str]]
    file_prefix List[str]
    ## The file that declares each constant, whose names its value uses.
    const_home Map[str, int]
    ## The file of each problem, filled in by `stamp_problems`.
    problem_files List[int]
    ## The functions with contracts, by key, and the file of every function.
    contracted Map[str, ast.FnDecl]
    ## What an impl method inherits from its trait's method (contract.inh.1-3).
    inh Inherit
    ## Contracts proved per file (contract.prove.1, lower_contract.ail).
    proofs ProofCache
    ## The structs with `invariant` lines, and the file of each.
    invariants Map[str, List[ast.Contract]]
    inv_file Map[str, int]
    ## The struct whose invariants the current `mut self` method must keep.
    inv_key str
    fn_decl Map[str, ast.FnDecl]
    fn_file Map[str, int]
    ## Lowering code that checks no contracts: a condition, or the `.nc`
    ## copy of a function a condition calls (contract.run.2, ADR 0612).
    unchecked bool
    unchecked_list List[str]
    unchecked_seen Set[str]
    auto_par Set[str]
    ## The `ensures` of the function being lowered, its label, and the keys
    ## of its receiver, parameters and `old(e)` values.
    ens List[ast.Contract]
    ens_label str
    ens_vars List[NameKey]
    ens_nargs int
    ## The enums' variants (ADR 0602), the `eq.E` functions asked for, and
    ## the variants without fields that have a shared object.
    enums Map[str, List[Case]]
    eq_tys Map[str, Ty]
    ## The types whose default text is being expanded (ADR 0864).
    text_open List[str]
    singletons List[VariantRef]
    ## Program globals by key (ADR 0604), and the constants computed into
    ## them at start-up.
    globals Map[str, Global]
    global_consts List[GlobalConst]
    ## Generic declarations and their instances (ADR 0536).
    gen Gen
    lazy Lazy
    ## The next cell of `rt.ffi_addr` (ADR 0870).
    ffi_k int
    ## The failure blocks of the `else` parts being lowered, innermost last:
    ## a `?` on an optional inside an `else` value goes there (err.prop.4).
    else_targets List[int]
    ## Instrumentation sites, when asked for (lower_instr.ail).
    instr Instr
    ## The generator being lowered (lower_gen.ail, ADR 1073, expr.yield.1).
    gen_lower GenLower
    ## Function literals (type.fn.4, lower_fnlit.ail).
    fl FnLitState
    ## The map entry the last lookup found (native.map.1, lower_mapfast.ail).
    map_memo MapMemo
    ## Which structs lists keep in place (native.flat.1, lower_flat.ail).
    flat FlatState

## The primitives of the runtime (native-abi.md §6), with their result types.
PRIMS := {
    "load64": "int",
    "store64": "unit",
    "load8": "int",
    "store8": "unit",
    "loadf": "float",
    "storef": "unit",
    "loadf32": "float",
    "storef32": "unit",
    "syscall": "int",
    "global": "int",
    "str_addr": "int",
    "list_addr": "int",
    "list_at": "list",
    "str_at": "str",
    "float_bits": "int",
    "bits_float": "float",
    "f32_round": "float",
    "target": "int",
    "code_tab": "int",
    "frame_ptr": "int",
    "atomic_load": "int",
    "atomic_store": "unit",
    "atomic_xchg": "int",
    "atomic_add": "int",
    "atomic_cas": "int",
    "sp": "int",
    "clone": "int",
    "restart": "unit",
    "sigreturn": "unit",
    "win_arg0": "int",
    "import_call": "int",
    "fn_addr": "int",
    "gc_regs": "int",
    "globals_end": "int",
}

## Lower a program and, when given, the runtime; `Problems` lists what is
## outside the subset.
pub fn lower_module(path str, text str, prog ast.Program, rt ast.Program?) Module ! Problems
    lower_package([Source(module: "", path: path, text: text, prog: prog)], rt)

## One source file of a package: the module it belongs to (its import path,
## "" for the root module), its path and text, and its syntax tree.
pub struct Source
    pub module str
    pub path str
    pub text str
    pub prog ast.Program

## Lower the files of a package (mod.unit.1-5, ADR 0393) and, when given,
## the runtime. The first source is the root module's file holding `main`;
## problems name the file they are in (`Problems.files`).
pub fn lower_package(input List[Source], rt ast.Program?) Module ! Problems
    lower_package_with(input, rt, input.len())

## `lower_package` with the sources from `lazy` on the prelude's, lowered
## as the program reaches them (ADR 0808).
pub fn lower_package_with(input List[Source], rt ast.Program?, lazy int) Module ! Problems
    lower_package_par(input, rt, lazy, Set[str]())

## One round of `lower_package_par` (lower_flat.ail): `flat0` says which structs
## lists hold as objects. A round that finds more of them stops before the
## runtime is lowered and returns no module.
fn lower_round(
    input List[Source],
    rt ast.Program?,
    lazy int,
    pooled Set[str],
    flat0 FlatState,
) FlatRound ! Problems
    # type.distinct.7: distinct types are their bases in native code (lower_distinct.ail).
    srcs := with_error_owners(shadow_free(erase_distinct(input), lazy))
    mut l := Lower(
        path: srcs[0].path,
        file_paths: [src.path for src in srcs],
        err_msgs: {"fs.IoError": "", "IoError": ""},
        fn_errs: {},
        infer_errs: {},
        tail_want: none,
        tail_pos: ast.Pos(line: 1, col: 1),
        fails: false,
        sigs: {},
        bad: Set[str](),
        consts: {},
        strs: [],
        str_index: {},
        src_paths: [src.path for src in srcs],
        src_lines: [src.text.lines() for src in srcs],
        sites: [],
        problems: [],
        funcs: [],
        prefix: "",
        is_rt: false,
        fname: "",
        facts: new_facts(),
        ret: Ty.Unit,
        blocks: [],
        vals: [],
        names: [],
        sealed: [],
        closed: [],
        preds: [],
        defs: [],
        incomplete: [],
        cur: 0,
        scopes: [],
        var_ty: {},
        var_vals: {},
        nvars: 0,
        loops: [],
        tk: new_task_state(),
        nofuse: false,
        structs: {},
        field_defaults: {},
        hash_uses_of: {},
        self_ty: "",
        borrowed: Set[str](),
        copy_tys: {},
        uniq: new_uniq(),
        unw: new_unwind(),
        asks: ask_keys(srcs),
        ctsteps: new_ct_steps(),
        traits: new_traits(),
        fn_problems: 0,
        fn_failed: false,
        file: 0,
        aliases: {},
        file_aliases: [],
        file_prefix: [],
        const_home: {},
        problem_files: [],
        contracted: {},
        inh: Inherit(of: {}, label: {}, ens_from: none, ens_n: 0, ens_origin: ""),
        proofs: ProofCache(done: {}),
        invariants: {},
        inv_file: {},
        inv_key: "",
        fn_decl: {},
        fn_file: {},
        unchecked: false,
        unchecked_list: [],
        unchecked_seen: Set[str](),
        auto_par: pooled,
        ens: [],
        ens_label: "",
        ens_vars: [],
        ens_nargs: 0,
        enums: {},
        eq_tys: {},
        text_open: [],
        singletons: [],
        globals: {},
        global_consts: [],
        gen: new_gen(),
        lazy: new_lazy(lazy),
        ffi_k: 0,
        else_targets: [],
        instr: new_instr(),
        gen_lower: new_gen_lower(),
        fl: new_fn_lit_state(),
        map_memo: no_map_memo(),
        flat: flat0,
    )
    l.note_lazy_names(srcs)
    for src in srcs
        l.file_aliases.push(aliases_of(src.prog))
        l.file_prefix.push(if src.module == "" then "" else "{src.module}.")
    l.share_gen_aliases(srcs)
    if r := rt
        l.declare_all(r, "rt.")
    l.tk.on = l.sigs.contains("rt.task_new")
    l.tk.auto_only = l.tk.on
    for src in srcs
        if uses_tasks(src.text) or src.text.contains("std.ui") or src.text.contains("std.app")
            l.tk.auto_only = false
    l.problem_files = [0 for _ in l.problems]
    for k in 0..srcs.len()
        before := l.problems.len()
        l.declare_errors(srcs[k].prog)
        l.quiet_lazy(k, before)
    for k in 0..srcs.len()
        l.enter_file(k)
        before := l.problems.len()
        l.declare_errors(srcs[k].prog)
        l.declare_struct_names(srcs[k].prog)
        l.declare_enum_names(srcs[k].prog)
        l.declare_traits(srcs[k].prog)
        l.quiet_lazy(k, before)
    l.declare_prelude_enums()
    for k in 0..srcs.len()
        l.enter_file(k)
        before := l.problems.len()
        l.declare_struct_fields(srcs[k].prog)
        l.declare_enums(srcs[k].prog)
        l.quiet_lazy(k, before)
    for k in 0..srcs.len()
        l.enter_file(k)
        before := l.problems.len()
        l.declare_all(srcs[k].prog, l.prefix)
        l.quiet_lazy(k, before)
    l.stamp_problems()
    l.gen_const_init()
    l.settle_inferred(srcs, lazy)
    for k in 0..lazy.min(srcs.len())
        l.enter_file(k)
        l.path = srcs[k].path
        for f in inferred_first(l, program_fns(srcs[k].prog), l.prefix)
            if not is_test(f)
                l.lower_fn(f)
        l.stamp_problems()
    l.gen_instances()
    l.lower_lazy(srcs)
    # Before the generators below, so a task or chunk body's copies, drops and
    # instances are made too (conc.par.8); the second pass takes the sites the
    # instances it asked for hold.
    l.build_task_fns()
    l.gen_instances()
    l.build_task_fns()
    l.gen_ct_copies()
    l.enter_file(0)
    l.gen_unchecked()
    l.enter_file(0)
    l.gen_dispatch()
    l.instr_finish()
    l.gen_drops()
    l.gen_copies()
    l.gen_enum_eqs()
    l.gen_init_enums()
    l.call_inits()
    l.build_task_fns()
    l.gen_task_dispatch()
    l.stamp_problems()
    if l.flat.grew
        return FlatRound(m: none, boxed: l.flat.boxed)
    if r := rt
        l.lower_rt(r)
        l.stamp_problems()
    if l.problems.len() > 0
        mut order := [k for k in 0..l.problems.len()]
        order = order.sorted(by: |k| (l.problem_files[k] * 1000000 + l.problems[k].pos.line) * 1000 + l.problems[k].pos.col)
        return Problems(
            items: [l.problems[k] for k in order],
            files: [srcs[l.problem_files[k]].path for k in order],
        )
    mut m := Module(
        path: srcs[0].path,
        funcs: l.funcs,
        strs: l.strs,
        sites: l.sites,
        lines: srcs[0].text.lines(),
        files: [src.path for src in srcs],
        file_lines: [src.text.lines() for src in srcs],
        notes: l.tk.notes,
    )
    inline_module(mut m)
    mark_recursion(mut m)
    mut errs := List[Problem]()
    for f in m.funcs
        for err in verify(f)
            errs.push(Problem(
                rule: "native.build.2",
                pos: ast.Pos(line: 1, col: 1),
                message: "internal error: invalid MIR after inlining: {f.name}: {err}",
            ))
    if errs.len() > 0
        return Problems(items: errs, files: [srcs[0].path for _ in errs])
    FlatRound(m: m, boxed: l.flat.boxed)

## The runtime functions the code generators call by name, besides those
## the MIR calls.
RT_ROOTS := [
    "rt.init",
    "rt.exit",
    "rt.trap",
    "rt.list_push",
    "rt.list_pushf",
    "rt.list_pushb",
    "rt.list_reserve",
    "rt.flat_reserve",
    "rt.list_rows_min",
    "rt.datarange_absmax",
    "rt.vec_axpyi",
    "rt.vec_axpyf",
    "rt.vec_escape",
    "rt.list_new_for",
    "rt.fill",
]

## Lower the runtime functions the program reaches, and those they reach
## (ADR 0393): a program pays only for the runtime it uses.
fn Lower.lower_rt(mut self, r ast.Program)
    self.prefix = "rt."
    self.aliases = {}
    self.is_rt = true
    mut decls := Map[str, ast.FnDecl]()
    for f in r.fns
        # `dispatch` is generated from the program's tasks (lower_task.ail).
        if not PRIMS.contains(f.name) and not (f.name == "dispatch" and self.tk.on)
            decls["rt.{f.name}"] = f
    mut done := Set[str]()
    mut queue := RT_ROOTS
    mut scanned := 0
    while true
        while scanned < self.funcs.len()
            for blk in self.funcs[scanned].blocks
                for i in blk.insts
                    if (i.op == "call" or i.op == "fnaddr") and decls.contains(i.name)
                        queue.push(i.name)
                    # Code the generator calls or takes the address of: the
                    # thread entry points (native-abi.md §10, §11).
                    if i.op == "prim" and (i.name == "clone" or i.name == "restart")
                        queue.push("rt.worker_main")
                    if i.op == "prim" and i.name.starts_with("fn_addr:")
                        queue.push(i.name.replace("fn_addr:", ""))
            scanned += 1
        if queue.len() == 0
            break
        name := queue.pop() else ""
        if done.contains(name) or not decls.contains(name)
            continue
        done.add(name)
        self.lower_fn(decls[name])
    self.is_rt = false

fn Lower.problem(mut self, pos ast.Pos, message str)
    self.problems.push(Problem(rule: "native.subset.1", pos: pos, message: message))

fn Lower.declare_all(mut self, prog ast.Program, pre str)
    for c in prog.consts
        if is_const_expr(c.value)
            if pre == "rt." and self.consts.contains("rt.{c.name}")
                self.problem(c.pos, "runtime constant `{c.name}` is defined in two runtime files")
            self.consts["{pre}{c.name}"] = c.value
            self.const_home["{pre}{c.name}"] = self.file
        elif pre != "rt."
            self.global_consts.push(GlobalConst(key: "{pre}{c.name}", decl: c, file: self.file))
        else
            self.problem(c.pos, "runtime constant `{c.name}` must be a constant expression")
    note_hash_uses(prog, pre)
    for f in program_fns(prog)
        if is_test(f)
            continue
        before := self.problems.len()
        self.declare_fn(f, pre)
        note_inherited(f, prog, pre)
        if self.problems.len() > before
            self.bad.add(fn_key(f, pre))
            self.sigs.remove(fn_key(f, pre))
            hold_lazy(fn_key(f, pre), before)
    self.self_ty = ""

fn Lower.declare_fn(mut self, f ast.FnDecl, pre str)
    if declare_generic_fn(anon_generic(f), pre)
        return
    mut params := List[Ty]()
    self.self_ty = if o := f.owner then owner_key(o.name, pre) else ""
    if o := f.owner
        owner := owner_key(o.name, pre)
        prim := ["int", "float", "bool", "str"].contains(owner)
        if o.params != none
            or not (self.structs.contains(owner) or self.enums.contains(owner) or prim)
            self.problem(
                f.pos,
                "`{o.name}.{f.name}`: methods of `{o.name}` aren't in the native subset yet",
            )
            return
        if f.receiver != none
            params.push(self_param_ty(f, owner))
    elif f.receiver != none
        self.problem(
            f.pos,
            "`{f.name}`: methods of traits and `impl` blocks aren't in the native subset yet",
        )
        return
    for a in f.attrs
        # `@allow` and `@deprecated` only steer diagnostics (gram.attr.5); `@tool` only feeds the attach derive (attach.tool.1).
        if a.name != "inline"
            and a.name != "pure"
            and a.name != "caps"
            and a.name != "allow"
            and a.name != "deprecated"
            and a.name != "test"
            and a.name != "export c"
            and a.name != "tool"
            and a.name != "fixture"
            and a.name != "needs"
            and a.name != "variadic c"
            self.problem(a.pos, "attribute `@{a.name}` isn't in the native subset yet")
    mut floats := 0
    for p in f.params
        t := self.type_of(p.ty) else
            self.problem(p.pos, "parameter `{p.name}`: its type isn't in the native subset yet")
            Ty.Unknown
        if p.mutable and cell_param(t) != none
            params.push(cell_param(t) else t)
            continue
        if p.mutable and not needs_copy(t) and not t.is_unknown() and not t.is_coll()
            self.problem(
                p.pos,
                "`mut` parameter `{p.name}` of a number type isn't in the native subset yet",
            )
        if t.is_float()
            floats += 1
        params.push(t)
    # Primitives are not called through the ABI. Integer arguments past the
    # registers go on the stack; float ones don't yet.
    if floats > 8 and not (pre == "rt." and PRIMS.contains(f.name))
        self.problem(f.pos, "`{f.name}` has more than 8 float parameters")
    mut rty := Ty.Unit
    mut can_fail := false
    if r := f.ret
        can_fail = is_fallible(r)
        t := (if can_fail then ok_type(r) else self.type_of(r)) else
            self.problem(r.pos, "`{f.name}`: its result type isn't in the native subset yet")
            Ty.Unknown
        rty = t
    # Codegen keys functions by name, so a second runtime definition would
    # silently replace the first, whatever its types (#771, `win_write`).
    if pre == "rt." and self.sigs.contains(fn_key(f, pre))
        self.problem(f.pos, "runtime function `{f.name}` is defined in two runtime files")
    self.sigs[fn_key(f, pre)] = Sig(params: params, ret: rty, fails: can_fail)
    note_mut_self(f, fn_key(f, pre))
    if can_fail
        if r := f.ret
            self.fn_errs[fn_key(f, pre)] = error_ty_of(r)
            note_inferred_set(fn_key(f, pre), r)
    if pre != "rt."
        self.fn_decl[fn_key(f, pre)] = f
        self.fn_file[fn_key(f, pre)] = self.file
        if f.contracts.len() > 0
            self.contracted[fn_key(f, pre)] = f

## Whether `f` is a `@test` function (test.attr.2): `ail build` leaves it out,
## so it may use what the native subset lacks (ADR 0613).
fn is_test(f ast.FnDecl) bool
    for a in f.attrs
        if a.name == "test"
            return true
    false

## A function's name in MIR: `T.m` for a method of `T`.
fn fn_key(f ast.FnDecl, pre str) str
    if o := f.owner
        return "{owner_key(o.name, pre)}.{f.name}"
    "{pre}{f.name}"

## The MIR type of a written type, if it is in the subset.
fn Lower.type_of(mut self, t ast.TypeRef) Ty?
    match t.shape
        Optional(inner) => opt_of(self.type_of(inner)?)
        PtrTo(inner) => ptr_type_of(inner)
        Named(name, args) =>
            match name
                "int" => Ty.Int
                "float" => Ty.Float
                "bool" => Ty.Bool
                "str" => Ty.Str
                "bytes" => Ty.Bytes
                "char" => Ty.Char
                "never" => Ty.Unit
                "i8" | "i16" | "i32" | "u8" | "u16" | "u32" | "u64" | "f32" => scalar_ty(name)
                "List" =>
                    if args.len() != 1
                        return none
                    e := self.type_of(args[0])?
                    if is_number(e)
                        or e.is_sized()
                        or e == Ty.Str
                        or e == Ty.Bytes
                        or needs_copy(e)
                        or is_enum(e)
                        or is_shared_opt(e)
                        or e.is_coll()
                        or e.is_tensor()
                        or e.is_ref()
                        or e.is_fn()
                        or is_shared_handle(e)
                        return Ty.List(e)
                    none
                "Atomic" =>
                    if args.len() != 1
                        return none
                    e := self.type_of(args[0])?
                    if e == Ty.Int or e == Ty.Bool
                        return Ty.Atomic(e)
                    none
                "Channel" => chan_type_of(args)
                "Mutex" => mutex_type_of(args)
                "TaskGroup" => group_type_of(args)
                "Map" | "Set" => coll_type_of(name, args)
                "tensor.Tensor" | "Tensor" => tensor_type_of(args)
                _ =>
                    if name == "Self" and self.self_ty != ""
                        # A method's own type (trait.self.1), as derived
                        # methods write it (ADR 0807).
                        return owner_ty(self.self_ty)
                    if g := generic_type(name, args)
                        return g
                    if args.len() == 0
                        if k := type_key(name)
                            return Ty.Struct(k)
                        if k := enum_key(name)
                            return Ty.Enum(k)
                    none
        AnyTrait(name) => any_type(name)
        RefTo(inner) => ref_type(inner)
        TupleType(elems) => tuple_type_of(elems)
        FnType(fparams, fret) =>
            mut ps := List[Ty]()
            for p in fparams
                ps.push(self.type_of(p)?)
            mut r := Ty.Unit
            if rt := fret
                r = fn_ret_type(rt)?
            Ty.Fn(params: ps, ret: r, err: fn_err_type(fret))
        _ => none

fn is_literal(e ast.Expr) bool
    match e
        Int | Float | Bool => true
        Unary(o, x, _) =>
            match o
                Neg => is_literal(x)
                _ => false
        _ => false

## A constant's value that is inlined at each use: literals, names of other
## constants, and arithmetic on them (no calls, so no effects). A list is not:
## inlining it rebuilds it at every use, so it gets a program global (ADR 0604).
fn is_const_expr(e ast.Expr) bool
    match e
        Int | Float | Bool | Str | Name => true
        ListLit(_, _) => false
        Unary(_, x, _) => is_const_expr(x)
        Binary(_, a, b, _) => is_const_expr(a) and is_const_expr(b)
        _ => false

## An optional shared when copied: it can be a list element, map value or
## field. A boxed number, string or enum is immutable; a struct, tuple, list
## or map inside an optional is never written in place either, since only a
## variable or a field or element of one is a place (expr.bind.6) and
## unwrapping it into a `mut` binding copies it (own.val.1).
fn is_shared_opt(t Ty) bool
    inner := t.opt_inner() else return false
    if needs_copy(inner)
        return true
    is_number(inner) or inner == Ty.Str or is_enum(inner) or is_shared_opt(inner)

fn is_number(t Ty) bool
    match t
        Int | Float | F32 | Bool | Char | Sized(_) => true
        _ => false

# ---- building blocks and values ----

fn Lower.new_value(mut self, ty Ty, name str) int
    self.vals.push(ty)
    self.names.push(name)
    self.vals.len() - 1

fn Lower.new_block(mut self) int
    self.blocks.push(Block(params: [], insts: [], term: unreachable_term()))
    self.sealed.push(false)
    self.closed.push(false)
    self.preds.push([])
    self.defs.push(Map[str, int]())
    self.incomplete.push(Map[str, int]())
    self.blocks.len() - 1

## Append an instruction defining a new value of type `ty`.
fn Lower.emit(mut self, i Inst, ty Ty) int
    v := self.new_value(ty, "")
    mut x := i
    x.dst = v
    self.blocks[self.cur].insts.push(x)
    v

fn Lower.emit_void(mut self, i Inst)
    self.blocks[self.cur].insts.push(i)

fn Lower.op(mut self, op str, args List[int], ty Ty) int
    self.emit(inst(-1, op, args), ty)

## A checked operation: it traps at `site`.
fn Lower.checked(mut self, op str, args List[int], site int, ty Ty) int
    mut i := inst(-1, op, args)
    i.site = site
    self.emit(i, ty)

fn Lower.call(mut self, name str, args List[int], ty Ty) int
    mut i := inst(-1, "call", args)
    i.name = name
    if ty.is_unit()
        self.emit_void(i)
        return -1
    self.emit(i, ty)

## A call of a program's function: it traps at its site when the stack is
## nearly exhausted (err.trap.1, ADR 0535). `shown` names the callee.
fn Lower.user_call(mut self, name str, args List[int], ty Ty, pos ast.Pos, shown str) int
    mut i := inst(-1, "call", args)
    i.name = ct_call(name, pos)
    i.site = self.site("err.trap.1", "call", shown, pos)
    # The call position for a trap's stack (trace.frame.1). A constant's
    # initialiser runs before `main` here, but is lazy in the interpreter,
    # whose stack has no frame for it.
    if not self.is_rt and not self.fname.starts_with("init.")
        i.imm = call_pos(self.file, pos.line, pos.col)
    if ty.is_unit()
        self.emit_void(i)
        self.never_end(name)
        return -1
    self.emit(i, ty)

fn Lower.konst(mut self, n int, ty Ty) int
    mut i := inst(-1, "const", [])
    i.imm = n
    self.emit(i, ty)

fn Lower.fconst(mut self, x float) int
    mut i := inst(-1, "fconst", [])
    i.fimm = x
    self.emit(i, Ty.Float)

fn Lower.str_value(mut self, s str) int
    mut i := inst(-1, "str", [])
    i.imm = self.str_lit(s)
    self.emit(i, Ty.Str)

## Whether the current block already ends (after `return`, `break`...).
fn Lower.done(self) bool
    self.closed[self.cur]

fn Lower.finish(mut self, term Term)
    if self.done()
        return
    if term.kind == "return" and self.tk.exits.len() > 0
        unwind_exits()
    for s in term.targets
        self.preds[s].push(self.cur)
    self.blocks[self.cur].term = term
    self.closed[self.cur] = true

## Start lowering into a block that nothing reaches: code after a jump.
fn Lower.dead_block(mut self)
    b := self.new_block()
    self.sealed[b] = true
    self.cur = b

fn Lower.jump(mut self, to int, args List[int])
    self.finish(jump_to(to, args))

## End the current block with a branch whose edges pass `yes_args` and
## `no_args`. The two targets must differ.
fn Lower.branch(mut self, cond int, yes int, yes_args List[int], no int, no_args List[int])
    mut t := branch_on(cond, yes, no)
    t.args = [yes_args, no_args]
    self.finish(t)

fn Lower.seal(mut self, b int)
    pending := self.incomplete[b]
    for key in pending.keys()
        self.add_edge_args(key, pending[key], b)
    self.sealed[b] = true

## Give every edge into `b` the value of `key` for its new parameter.
fn Lower.add_edge_args(mut self, key str, param int, b int)
    for p in self.preds[b]
        v := self.read_var(key, p)
        for e in 0..self.blocks[p].term.targets.len()
            if self.blocks[p].term.targets[e] == b
                self.blocks[p].term.args[e].push(v)

fn Lower.write_var(mut self, key str, b int, v int)
    self.defs[b][key] = v
    self.var_vals.push(key, v)

fn Lower.read_var(mut self, key str, b int) int
    if v := self.defs[b].get(key)
        return v
    mut v := -1
    if not self.sealed[b]
        v = self.new_value(self.var_ty[key], key.split("#")[0])
        self.blocks[b].params.push(v)
        self.incomplete[b][key] = v
    elif self.preds[b].len() == 1
        v = self.read_var(key, self.preds[b][0])
    else
        v = self.new_value(self.var_ty[key], key.split("#")[0])
        self.blocks[b].params.push(v)
        self.write_var(key, b, v)
        self.add_edge_args(key, v, b)
    self.write_var(key, b, v)
    v

## Declare a source name in the innermost scope and give it a value.
fn Lower.declare(mut self, name str, ty Ty, v int)
    self.nvars += 1
    key := "{name}#{self.nvars}"
    self.scopes[self.scopes.len() - 1][name] = key
    self.var_ty[key] = ty
    if v >= 0 and self.names[v] == ""
        self.names[v] = name
    self.write_var(key, self.cur, v)
    uniq_declared(name)

fn Lower.lookup(self, name str) str?
    mut i := self.scopes.len() - 1
    while i >= 0
        if k := self.scopes[i].get(name)
            return k
        i -= 1
    none

## A check's trap site, or -1 in the runtime, whose arithmetic wraps and
## whose indexing is unchecked (native-abi.md §7).
fn Lower.site(mut self, rule str, kind str, op str, pos ast.Pos) int
    if self.is_rt
        return -1
    self.sites.push(Site(
        rule: rule,
        kind: kind,
        op: op,
        line: pos.line,
        col: pos.col,
        func: if self.tk.owner != "" then self.tk.owner else self.fname,
        file: self.file,
        from: -1,
    ))
    self.sites.len() - 1

fn Lower.str_lit(mut self, s str) int
    if i := self.str_index.get(s)
        return i
    self.strs.push(s)
    self.str_index[s] = self.strs.len() - 1
    self.strs.len() - 1

# ---- functions ----

fn Lower.lower_fn(mut self, f ast.FnDecl)
    owner := if o := f.owner then owner_key(o.name, self.prefix) else ""
    self.lower_fn_as(f, fn_key(f, self.prefix), fn_key(f, self.prefix), owner)

## The type a method belongs to, as its key: `Tag` or `mod.Tag`; "" for a
## free function.
fn Lower.fn_owner(self, f ast.FnDecl) str
    if o := f.owner then owner_key(o.name, self.prefix) else ""

## `f` under the MIR name `name`, with the signature of `key`: the function
## itself, or its `.nc` copy, which checks no contracts (contract.run.2). It is
## a method of type `owner` (ADR 0536: an instance of a generic function or
## method has its own key and owner).
fn Lower.lower_fn_as(mut self, f ast.FnDecl, name str, key str, owner str)
    sig := self.sigs.get(key) else return
    if lower_gen_fn(f, name, key, owner)
        return
    params := self.begin_fn(name, sig.ret, sig.params)
    self.fails = sig.fails
    self.self_ty = ""
    mut k := 0
    if f.owner != none
        self.self_ty = owner
        if recv := f.receiver
            self.self_ty = owner
            declare_self(recv, sig.params[0], params[0])
            self.borrowed.add(self.lookup("self") else "")
            note_stable_param("self", recv.mutable)
            k = 1
    for i in 0..f.params.len()
        p := f.params[i]
        declare_param(p, sig.params[k + i], params[k + i])
        note_mut_param(p, self.lookup(p.name) else "", params[k + i])
        note_stable_param(p.name, p.mutable)
        self.borrowed.add(self.lookup(p.name) else "")
    body := f.body else
        lower_extern(f, name, params)
        return
    if lower_ui_intrinsic(f, key, name, params) or lower_rt_flag(key, name, f.pos)
        return
    if not self.unchecked
        enter_contracts(f, key)
    uniq_params(f)
    instr_call(f, sig.params, params)
    race_enter()
    want := not self.ret.is_unit()
    if want
        self.tail_want = self.ret
        if body.len() > 0
            if e := final_expr(body[body.len() - 1])
                self.tail_pos = expr_pos(e)
    result := self.lower_block(body, want)
    if not self.done()
        if want
            if r := result
                v := Val(id: self.convert(r, self.ret, f.pos), ty: r.ty)
                e := final_expr(body[body.len() - 1]) else ast.Expr.NoneLit(f.pos)
                rv := self.copy_if_borrowed(e, v)
                check_ensures(rv, tail_pos(f, body))
                self.finish(return_of(rv))
            elif not self.failing()
                self.problem(f.pos, "`{f.name}` must end with its result")
        else
            check_ensures(-1, tail_pos(f, body))
            self.finish(return_of(-1))
    self.end_fn(name, f.pos)

## Start a function: fresh state, and an entry block whose parameters are
## the function's.
fn Lower.begin_fn(mut self, name str, rty Ty, ptys List[Ty]) List[int]
    self.fname = name
    self.ret = rty
    self.fn_problems = self.problems.len()
    self.fn_failed = false
    self.blocks = []
    self.vals = []
    self.names = []
    self.sealed = []
    self.closed = []
    self.preds = []
    self.defs = []
    self.incomplete = []
    self.scopes = [Map[str, str]()]
    self.var_ty = {}
    self.var_vals = {}
    self.nvars = 0
    self.loops = []
    self.ens = []
    self.inv_key = ""
    self.borrowed = Set[str]()
    self.cur = self.new_block()
    self.sealed[self.cur] = true
    for t in ptys
        self.blocks[self.cur].params.push(self.new_value(t, ""))
    self.blocks[self.cur].params

## Whether the current function already failed: later problems in it
## would only repeat the first.
fn Lower.failing(self) bool
    self.problems.len() > self.fn_problems or self.fn_failed

## Finish the function begun with `begin_fn`: simplify, fold, verify.
fn Lower.end_fn(mut self, name str, pos ast.Pos)
    # After a problem the MIR may be inconsistent; it is never built.
    if self.problems.len() > self.fn_problems or self.fn_failed
        self.facts.moves = []
        return
    instr_end()
    self.flat_scan()
    mut func := elide_moves(
        Func(
            name: name,
            params: self.blocks[0].params,
            ret: self.ret,
            blocks: self.blocks,
            vals: self.vals,
            names: self.names,
        ),
        self.facts.moves,
    )
    simplify_in(mut func)
    fold_in(mut func)
    simplify_in(mut func)
    self.facts.moves = []
    for err in verify(func)
        self.problems.push(Problem(
            rule: "native.build.2",
            pos: pos,
            message: "internal error: invalid MIR: {err}",
        ))
    self.funcs.push(func)

## The value as the type the context expects: an `int` literal already
## became a `float` where one was expected; anything else must match.
fn Lower.convert(mut self, v Val, want Ty, pos ast.Pos) int
    if want.opt_inner() != none and not v.ty.is_unknown()
        return convert_opt(v, want, pos)
    if settle_by_want(v, want)
        return v.id
    if want.is_unknown() or v.ty.is_unknown()
        # A type outside the subset, already reported.
        self.fn_failed = true
    elif not self.fits_want(v.ty, want)
        # The runtime calls a function address it kept as an `int` (unwind.ail).
        self.problem(pos, "expected `{want.name()}`, found `{v.ty.name()}`")
    v.id

## Whether a value of type `got` fits `want`: the same type, a function value
## that fits (type.fn.6), or a function address the runtime keeps as an `int`.
fn Lower.fits_want(self, got Ty, want Ty) bool
    same_ty(got, want) or fn_fits(got, want) or (self.is_rt and want.is_fn() and got == Ty.Int)

fn same_ty(a Ty, b Ty) bool
    if p := a.opt_inner()
        q := b.opt_inner() else return false
        return same_ty(p, q) or p.is_unknown() or q.is_unknown()
    x := a.elem() else return a.name() == b.name()
    y := b.elem() else return false
    same_ty(x, y) or x.is_unknown() or y.is_unknown()

## Lower statements in a new scope. With `want`, a final expression
## statement is the block's value.
fn Lower.lower_block(mut self, body List[ast.Stmt], want bool) Val?
    tail := self.tail_want
    self.tail_want = none
    top_unit_fails := self.scopes.len() == 1 and unit_fails()
    self.scopes.push(Map[str, str]())
    defer_enter()
    mut result := Val(id: -2, ty: Ty.Unit)
    for i in 0..body.len()
        s := body[i]
        if self.done()
            self.dead_block()
        if fork_stmt(body, i)
            continue
        instr_stmt(s)
        ct_stmt(s)
        if (want or top_unit_fails) and i == body.len() - 1
            if e := final_expr(s)
                if tail_error(e)
                    continue
                if want
                    result = self.lower_expr(e, tail) else Val(id: -2, ty: Ty.Unit)
                    uniq_take(e)
                    continue
            # An `unsafe` block gives its last expression's value.
            if want
                if inner := unsafe_body(s)
                    result = self.lower_block(inner, true) else Val(id: -2, ty: Ty.Unit)
                    continue
        note_let_rest(body, i)
        self.lower_stmt(s)
        instr_after(s)
    defer_exit()
    end_scope_exits(if body.len() > 0 then group_end_at(body[body.len() - 1]) else none)
    self.scopes.pop()
    if result.id == -2
        return none
    result

fn unsafe_body(s ast.Stmt) List[ast.Stmt]?
    match s
        Unsafe(body, _) => body
        _ => none

fn final_expr(s ast.Stmt) ast.Expr?
    match s
        Eval(e) => e
        Handle(value, other) => ast.tail_else(value, other)
        _ => none

# ---- statements ----

## `n := s.to_int() else ...` (err.else.1-2): the parse, then the `else`
## when it fails, a fallback value or a statement that leaves.
fn Lower.lower_let_else(mut self, name str, pos ast.Pos, value ast.Expr, other ast.Else)
    if is_list_pop(value)
        got := lower_pop_else(value, other, pos) else
            self.declare(name, Ty.Unknown, -1)
            return
        self.declare(name, got.ty, got.id)
        return
    if self.is_get_call(value)
        got := lower_get_else(value, other, pos) else
            self.declare(name, Ty.Unknown, -1)
            return
        # `get` hands out the stored value; the binding owns a copy (own.val.1).
        self.declare(name, got.ty, self.copy_if_place(value, got))
        return
    recv := match value
        Method(r, m, _, margs) => if m == "to_int" and margs.len() == 0 then r else none
        _ => none
    if recv == none
        lower_bind_else(name, pos, value, other)
        return
    got := self.lower_str_to_int_else(recv?, other, pos) else
        self.declare(name, Ty.Unknown, -1)
        return
    self.declare(name, got.ty, got.id)

## An `else` fallback value, jumped to `join`; a fallback that leaves, such as
## `unreachable(...)` (err.model.2), ends the block and has no value to join.
fn Lower.fallback_jump(mut self, x ast.Expr, t Ty, join int, pos ast.Pos)
    v := self.lower_expr(x, t) else return
    if self.done()
        return
    if v.id < 0
        self.problem(expr_pos(x), "this expression has no value")
        return
    self.jump(join, [self.convert(v, t, pos)])

## The receiver of `s.to_int()` when `e` is that call.
fn str_to_int_recv(e ast.Expr) ast.Expr?
    match e
        Method(r, m, _, margs) => if m == "to_int" and margs.len() == 0 then r else none
        _ => none

## `s.to_int() else ...` (err.else.1-2) in any position: the parse, then the
## `else` when it fails, a fallback value or a statement that leaves.
fn Lower.lower_str_to_int_else(mut self, recv ast.Expr, other ast.Else, pos ast.Pos) Val?
    # A `?` in `recv` (`env.get("PORT")?.to_int()`) also runs the `else` (err.prop.4).
    fail := self.new_block()
    self.else_targets.push(fail)
    got := self.lower_value(recv, Ty.Str)
    self.else_targets.pop()
    s := got?
    if not (s.ty == Ty.Str)
        self.problem(pos, "`.to_int()` on `{s.ty.name()}`")
        return none
    n := self.call("rt.str_to_int", [s.id], Ty.Int)
    ok := self.call("rt.parse_ok", [], Ty.Bool)
    join := self.new_block()
    r := self.new_value(Ty.Int, "")
    self.blocks[join].params.push(r)
    self.branch(ok, join, [n], fail, [])
    self.seal(fail)
    self.cur = fail
    match other
        Fallback(x) => self.fallback_jump(x, Ty.Int, join, pos)
        Leave(st) =>
            self.lower_stmt(st)
            if not self.done()
                self.problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(name, body, hpos) => handler_jump(name, body, hpos, Ty.Int, join)
    self.seal(join)
    self.cur = join
    Val(id: r, ty: Ty.Int)

fn Lower.lower_stmt(mut self, s ast.Stmt)
    match s
        Let(name, pos, mutable, value, otherwise) =>
            if is_spawn(value)
                lower_spawn_let(name, pos, value)
                return
            if other := otherwise
                self.lower_let_else(name, pos, value, other)
                return
            v := self.lower_value(value, none) else
                # Reported; uses of the name stay quiet.
                self.declare(name, Ty.Unknown, -1)
                return
            bind_let(name, mutable, value, v)
        Assign(target, op, value, pos) => lower_assign(target, op, value, pos)
        While(cond, body, wpos) => self.lower_while(cond, body, wpos)
        For(is_par, var, _, mutable, iter, body, pos) =>
            auto := not is_par
            # A loop the compiler chose may sit inside a loop run in order; there it
            # tests its work inline before it asks the pool (conc.par.14, lower_task.ail).
            if is_par or self.auto_par.contains("{self.file_paths[self.file]}:{pos.line}:{pos.col}")
                if mutable
                    self.problem(pos, "`for mut` isn't in the native subset yet")
                    return
                lower_par_for(var, iter, body, pos, auto)
                return
            self.lower_for(var, iter, body, mutable, pos)
        Break(pos, target) => lower_leave(pos, target, true)
        Continue(pos, target) => lower_leave(pos, target, false)
        Return(value, pos) =>
            if lower_fail_return(value, pos)
                return
            if e := value
                if self.ret.is_unit()
                    # `return f()` of a call that fails, in a function with no result:
                    # the failure travels in the error slot.
                    self.lower_expr(e, Ty.Unit)
                    check_ensures(-1, pos)
                    self.finish(return_of(-1))
                    return
                v := self.lower_value(e, self.ret) else return
                rv := self.copy_if_borrowed(e, Val(id: self.convert(v, self.ret, pos), ty: v.ty))
                check_ensures(rv, pos)
                self.finish(return_of(rv))
            else
                check_ensures(-1, pos)
                self.finish(return_of(-1))
        Eval(e) =>
            note_statement(e)
            if is_list_pop(e) and lower_pop_stmt(e) != none
                return
            uniq_discard(e, self.lower_expr(e, Ty.Unit))
        Handle(value, other) => lower_handle(value, other)
        Defer(st, _) => defer_note(st)
        With(m, var, _, body, pos) => lower_with(m, var, body, pos)
        Unsafe(body, _) => self.lower_block(body, false)
        LetTuple(binders, value, pos) => lower_let_tuple(binders, value, pos)
        LocalFn(d) => lower_local_fn(d)
        Select(arms, pos) => lower_select(arms, pos)

## A list read from a variable or an element is copied when it is bound
## or assigned, so the two stay independent (own.val.1, native-abi.md §4).
fn Lower.copy_if_place(mut self, e ast.Expr, v Val) int
    if is_uniq(v.ty)
        return uniq_move(e, v)
    if is_branchy(e) and place_tail(e, true)
        if v.ty.is_coll()
            return copy_coll(v)
        return if needs_copy(v.ty) then copy_value(v) else v.id
    if v.ty.is_coll() and aliases_place(e)
        return note_move(e, v, copy_coll(v))
    if not needs_copy(v.ty) or not aliases_place(e)
        return v.id
    note_move(e, v, copy_value(v))

## A returned list or struct is copied when it belongs to someone else: a
## field, an element, a parameter or a `for` variable (own.val.1).
fn Lower.copy_if_borrowed(mut self, e ast.Expr, v Val) int
    if is_uniq(v.ty)
        return uniq_move(e, v)
    if not needs_copy(v.ty)
        return v.id
    match e
        Member | Index => copy_value(v)
        Name(n, _) =>
            key := self.lookup(n) else return copy_value(v)
            if self.borrowed.contains(key) then copy_value(v) else v.id
        If | Match => if place_tail(e, false) then copy_value(v) else v.id
        _ => v.id

## A copy of the list `v`, deep through nested lists (own.val.1).
fn Lower.copy_list(mut self, v Val) int
    if c := self.flat_snapshot(v)
        return c
    mut depth := 0
    mut t := v.ty.elem() else Ty.Unknown
    while t.elem() != none
        depth += 1
        t = t.elem() else Ty.Unknown
    # A `List[bool]` holds bytes (native-abi.md §2).
    bytes := self.konst(t.elem_bytes(), Ty.Int)
    if depth == 0
        return self.call("rt.list_copy", [v.id, bytes], v.ty)
    self.call("rt.list_copy_deep", [v.id, self.konst(depth, Ty.Int), bytes], v.ty)

fn is_place(e ast.Expr) bool
    match e
        Name | Index | Member => true
        _ => false

fn Lower.lower_assign_body(mut self, target ast.Expr, op ast.BinOp?, value ast.Expr, pos ast.Pos)
    match target
        Name(name, npos) =>
            key := self.lookup(name) else
                k := self_slot(name)
                if k < 0
                    self.problem(npos, "unknown name `{name}`")
                    return
                assign_slot(self_value(), self.self_ty, k, op, value, pos)
                return
            ty := self.var_ty[key]
            mut v := -1
            if o := op
                old := Val(id: self.read_var(key, self.cur), ty: ty)
                r := self.lower_value(value, ty) else return
                v = binary(o, old, r, pos).id
            else
                r := self.lower_value(value, ty) else return
                ty2 := settle_var(target, ty, r)
                v = self.copy_if_place(value, Val(id: self.convert(r, ty2, pos), ty: ty2))
            note_assigned(key, value)
            uniq_replace(key)
            self.write_var(key, self.cur, assign_param(key, ty, v, pos))
        Index(recv, index, ipos) =>
            if g := grid_place(recv, index, ipos)
                self.lower_assign_body(g, op, value, pos)
                return
            if assign_after_rhs(target, op, value, pos)
                return
            l := self.lower_value(recv, none) else return
            if l.ty.is_coll()
                lower_map_assign(l, index, op, value, pos, ipos)
                return
            elem := l.ty.elem() else
                self.problem(ipos, "indexing a `{l.ty.name()}` isn't in the native subset yet")
                return
            if self.flat_assign(l, elem, index, op, value, pos, ipos)
                return
            i := self.lower_value(index, Ty.Int) else return
            mut v := -1
            if o := op
                old := Val(
                    id: self.checked("get", [l.id, i.id], self.bounds_site(ipos), elem),
                    ty: elem,
                )
                r := self.lower_value(value, elem) else return
                v = binary(o, old, r, pos).id
            else
                r := self.lower_value(value, elem) else return
                v = self.copy_if_place(value, Val(id: self.convert(r, elem, pos), ty: elem))
            uniq_drop_elem(l.id, i.id, elem, ipos)
            v = slot_val(v, elem)
            mut set := inst(-1, "set", [l.id, i.id, v])
            set.site = self.bounds_site(ipos)
            self.emit_void(set)
            watch_note(pos, l, "set", Val(id: v, ty: elem), "index", i)
        Member(recv, name, mpos) => assign_member(recv, name, op, value, mpos, pos)
        _ => self.problem(pos, "this assignment target isn't in the native subset yet")

fn Lower.bounds_site(mut self, pos ast.Pos) int
    self.site("type.coll.4", "bounds", "", pos)

## The runtime's `LIM_TICK` slot (rt/native/limits.ail): zero unless a time
## limit is on.
LIM_TICK_SLOT := 45

## A `while` loop's safepoint (run.limit.6): while a time limit is on, each
## turn calls the runtime, which reads the clock every 256 turns. It is
## emitted only when `ail build --timeout` baked a limit in.
fn Lower.poll_limits(mut self, pos ast.Pos)
    # Only a build with a baked time limit pays for it (ADR 0727).
    if not self.sigs.contains("rt.lim_loop_polls")
        return
    t := load(global_addr(LIM_TICK_SLOT), 0, Ty.Int)
    on := self.op("ne", [t, self.konst(0, Ty.Int)], Ty.Bool)
    slow := self.new_block()
    rest := self.new_block()
    self.branch(on, slow, [], rest, [])
    self.seal(slow)
    self.cur = slow
    # The call position puts the loop in the trap's stack (run.limit.1, trace.snap.1).
    call_at("rt.limits_poll", [], Ty.Unit, pos)
    self.jump(rest, [])
    self.seal(rest)
    self.cur = rest

fn Lower.lower_while(mut self, cond ast.Expr, body List[ast.Stmt], wpos ast.Pos)
    head := self.new_block()
    self.jump(head, [])
    self.cur = head
    self.poll_limits(expr_pos(cond))
    forever := match cond
        Bool(v, _) => v
        _ => false
    inner := self.new_block()
    exit := self.new_block()
    if forever
        self.jump(inner, [])
    else
        c := self.lower_value(cond, Ty.Bool) else return
        self.branch(c.id, inner, [], exit, [])
    self.seal(inner)
    self.cur = inner
    self.loops.push(Loop(cont: head, exit: exit, at: wpos))
    self.lower_block(body, false)
    self.loops.pop()
    self.jump(head, [])
    self.seal(head)
    self.seal(exit)
    self.cur = exit
    # `while true` with no `break` never falls out (expr.loop.1).
    if forever and self.preds[exit].len() == 0
        self.finish(unreachable_term())

## `for x in a..b`, `a..=b` or a list (expr.loop.2-3). The index is a hidden
## variable; `continue` goes to the latch, which steps it.
fn Lower.lower_for(
    mut self,
    var str,
    iter ast.Expr,
    body List[ast.Stmt],
    mutable bool,
    fpos ast.Pos,
)
    if self.lower_chars_for(var, iter, body, mutable, fpos)
        return
    self.scopes.push(Map[str, str]())
    mut lo := -1
    mut hi := -1
    mut inclusive := false
    mut list := -1
    mut copied := false
    mut elem := Ty.Int
    match iter
        Range(a, b, incl, rpos) =>
            if a == none or b == none
                self.problem(rpos, "a `for` over an open range isn't in the native subset")
                return
            x := self.lower_value(a else iter, Ty.Int) else return
            y := self.lower_value(b else iter, Ty.Int) else return
            lo = x.id
            hi = y.id
            inclusive = incl
        _ =>
            l0 := self.lower_value(iter, none) else return
            if chan_elem(l0.ty) != none
                lower_chan_for(var, l0, body, expr_pos(iter), fpos)
                return
            if lower_iter_for(var, iter, l0, body, fpos)
                return
            if is_pair_loop(var, l0, body)
                self.scopes.pop()
                for_pairs(var, iter, l0, body, fpos)
                return
            l := iter_coll(l0)
            e := l.ty.elem() else
                self.problem(
                    expr_pos(iter),
                    "a `for` over a `{l.ty.name()}` isn't in the native subset yet",
                )
                return
            if mutable and not for_mut_ok(e, fpos)
                return
            elem = e
            list = l.id
            copied = l.id != l0.id
            if mutates(body, iter) and l.id == l0.id and not mutable and not self.fixed_place(iter)
                list = self.copy_list(l)
                copied = true
            lo = self.konst(0, Ty.Int)
            hi = self.op("len", [list], Ty.Int)
    self.nvars += 1
    ikey := "#i{self.nvars}"
    self.var_ty[ikey] = Ty.Int
    self.write_var(ikey, self.cur, lo)
    head := self.new_block()
    self.jump(head, [])
    self.cur = head
    i := self.read_var(ikey, head)
    c := self.op(if inclusive then "le" else "lt", [i, hi], Ty.Bool)
    inner := self.new_block()
    exit := self.new_block()
    latch := self.new_block()
    self.branch(c, inner, [], exit, [])
    self.seal(inner)
    self.cur = inner
    if list >= 0
        self.declare(var, elem, self.elem_get(list, i, elem))
        self.borrowed.add(self.lookup(var) else "")
        if mutable
            note_elem(var, elem, list, i, fpos)
        else
            note_for_var(var, iter, elem, copied, body)
    else
        self.declare(var, Ty.Int, i)
    self.loops.push(Loop(cont: latch, exit: exit, at: fpos))
    self.lower_block(body, false)
    self.loops.pop()
    self.jump(latch, [])
    self.seal(latch)
    self.cur = latch
    j := self.read_var(ikey, latch)
    if inclusive
        # `i + 1` would overflow when `hi` is the largest `int`.
        last := self.op("eq", [j, hi], Ty.Bool)
        step := self.new_block()
        self.branch(last, exit, [], step, [])
        self.seal(step)
        self.cur = step
    self.write_var(ikey, self.cur, self.op("add", [j, self.konst(1, Ty.Int)], Ty.Int))
    self.jump(head, [])
    self.seal(head)
    self.seal(exit)
    self.cur = exit
    self.scopes.pop()

## Whether a loop body may change the list it iterates (so the loop needs
## a copy: `for x in xs` sees the list as it was, expr.loop.3).
## A path such as `dom[id].children` may be a field of `self`, which any
## call in the body can change through an implicit `mut self`, so for a
## path every call counts too ("#call").
fn mutates(body List[ast.Stmt], iter ast.Expr) bool
    match iter
        Name(n, _) => block_mutates(body, n)
        Index(_, _, _) | Member(_, _, _) =>
            root := path_root(iter) else return false
            block_mutates(body, root) or block_mutates(body, "#call")
        _ => false

fn path_root(e ast.Expr) str?
    match e
        Name(n, _) => n
        Index(r, _, _) => path_root(r)
        Member(r, _, _) => path_root(r)
        _ => none

fn block_mutates(body List[ast.Stmt], name str) bool
    for s in body
        if stmt_mutates(s, name)
            return true
    false

fn stmt_mutates(s ast.Stmt, name str) bool
    match s
        Let(_, _, _, value, other) =>
            if expr_mutates(value, name)
                return true
            o := other else return false
            else_mutates(o, name)
        Assign(target, _, value, _) => root_is(target, name) or expr_mutates(value, name)
        While(cond, body, _) => expr_mutates(cond, name) or block_mutates(body, name)
        For(_, _, _, mutable, it, body, _) => for_mutates(mutable, it, body, name)
        Return(v, _) =>
            e := v else return false
            expr_mutates(e, name)
        Eval(e) => expr_mutates(e, name)
        Break | Continue => false
        LetTuple(_, value, _) => expr_mutates(value, name)
        Handle(value, other) => expr_mutates(value, name) or else_mutates(other, name)
        Defer(st, _) => stmt_mutates(st, name)
        With(m, _, _, body, _) => expr_mutates(m, name) or block_mutates(body, name)
        # `unsafe` may write through a pointer; a local function or `select`
        # isn't followed.
        _ => true

## A `for mut` changes its list through the variable.
fn for_mutates(mutable bool, it ast.Expr, body List[ast.Stmt], name str) bool
    mutable and root_is(it, name) or expr_mutates(it, name) or block_mutates(body, name)

fn root_is(e ast.Expr, name str) bool
    match e
        Name(n, _) => n == name
        Index(r, _, _) => root_is(r, name)
        Member(r, _, _) => root_is(r, name)
        _ => false

fn args_mutate(args List[ast.Arg], name str) bool
    for a in args
        if a.mutable and root_is(a.value, name) or expr_mutates(a.value, name)
            return true
    false

## Conservative: any method call on the list but `len`, or a `mut`
## argument naming it, counts as a change.
fn expr_mutates(e ast.Expr, name str) bool
    match e
        Method(recv, m, _, args) => name == "#call"
            or root_is(recv, name) and m != "len"
            or args_mutate(args, name)
            or expr_mutates(recv, name)
        Call(f, args, _) => name == "#call" or args_mutate(args, name) or expr_mutates(f, name)
        Binary(_, a, b, _) => expr_mutates(a, name) or expr_mutates(b, name)
        Unary(_, a, _) => expr_mutates(a, name)
        Index(r, i, _) => expr_mutates(r, name) or expr_mutates(i, name)
        If(branches, els, _, _) =>
            for b in branches
                c := match b.cond
                    Test(x) => x
                    Bind(_, _, x) => x
                if expr_mutates(c, name) or block_mutates(b.body, name)
                    return true
            body := els else return false
            block_mutates(body, name)
        Interp(parts, _) =>
            for p in parts
                x := match p
                    Hole(x) => x
                    Fmt(x, _) => x
                    Lit => continue
                if expr_mutates(x, name)
                    return true
            false
        ListLit(items, _) =>
            for x in items
                if expr_mutates(x, name)
                    return true
            false
        Match(scrut, arms, _) =>
            if expr_mutates(scrut, name)
                return true
            for a in arms
                if opt_expr_mutates(a.guard, name)
                    return true
                if block_mutates(a.body, name)
                    return true
            false
        Try(x, cx, _) => expr_mutates(x, name) or opt_expr_mutates(cx, name)
        OrElse(x, o, _) => expr_mutates(x, name) or else_mutates(o, name)
        Member(r, _, _) => expr_mutates(r, name)
        Range(a, b, _, _) => opt_expr_mutates(a, name) or opt_expr_mutates(b, name)
        SetLit(items, _) => any_mutates(items, name)
        TupleLit(items, _) => any_mutates(items, name)
        MapLit(entries, _) =>
            for me in entries
                if expr_mutates(me.key, name) or expr_mutates(me.value, name)
                    return true
            false
        Comp(_, e1, e2, clauses, _) =>
            if expr_mutates(e1, name) or opt_expr_mutates(e2, name)
                return true
            for c in clauses
                if expr_mutates(c.iter, name) or opt_expr_mutates(c.cond, name)
                    return true
            false
        NewRef(x, _) => expr_mutates(x, name)
        Closure(_, body, _) => expr_mutates(body, name)
        _ => false

fn any_mutates(items List[ast.Expr], name str) bool
    for x in items
        if expr_mutates(x, name)
            return true
    false

fn opt_expr_mutates(e ast.Expr?, name str) bool
    x := e else return false
    expr_mutates(x, name)

fn else_mutates(o ast.Else, name str) bool
    match o
        Fallback(v) => expr_mutates(v, name)
        Leave(s) => stmt_mutates(s, name)
        Handler(_, body, _) => block_mutates(body, name)

# ---- expressions ----

## An expression that must have a value.
fn Lower.lower_value(mut self, e ast.Expr, want Ty?) Val?
    v := self.lower_expr(e, want)?
    if v.id < 0
        self.problem(expr_pos(e), "this expression has no value")
        return none
    if t := any_of(want)
        if any_of(v.ty) == none and not v.ty.is_unknown()
            return box_any(v, t, expr_pos(e))
    v

## Lower an expression; `want` is the type the context expects, which lets
## an `int` literal stand for a `float` (type.num.10), and is `unit` for an
## expression statement. `none` after a problem.
fn Lower.lower_expr(mut self, e ast.Expr, want Ty?) Val?
    match e
        Int(text, pos) => lower_int_lit(text, pos, want)
        Float(x, _) => float_lit(x, want)
        Bool(b, _) => Val(id: self.konst(if b then 1 else 0, Ty.Bool), ty: Ty.Bool)
        Bytes(hex, pos) => lower_bytes_lit(hex, pos)
        Str(s, _) => Val(id: self.str_value(s), ty: Ty.Str)
        Name(name, pos) => self.lower_name(name, pos, want)
        Unary(o, operand, pos) => lower_unary(o, operand, pos, want)
        Binary(o, lhs, rhs, pos) => lower_binary_expr(o, lhs, rhs, pos, want)
        Call(callee, args, pos) => self.lower_call_expr(callee, args, pos, want)
        Method(recv, name, npos, args) => self.lower_method(recv, name, npos, args, want)
        Index(recv, index, pos) => lower_index(recv, index, pos)
        ListLit(items, pos) => self.lower_list(items, pos, want)
        If(branches, els, else_err, pos) => self.lower_if(branches, els, else_err, pos, want)
        Interp(parts, pos) => lower_interp_value(parts, pos)
        Char(text, _) => lower_char(text)
        NoneLit(pos) => lower_none(want, pos)
        Hole(pos) => lower_hole(pos, want)
        TypeArgs(_, _, pos) => self.unsupported(pos, "this expression")
        Member(recv, name, pos) => lower_member_expr(recv, name, pos, e, want)
        Range(_, _, _, pos) => self.unsupported(pos, "a range outside `for`")
        MapLit(entries, pos) => lower_map_lit(entries, pos, want)
        SetLit(items, pos) => lower_set_lit(items, pos, want)
        Match(scrutinee, arms, pos) => lower_match(scrutinee, arms, pos, want)
        Try(x, context, pos) => lower_try(x, context, pos)
        Comp(form, elem, body_val, clauses, pos) => lower_comp(
            form,
            elem,
            body_val,
            clauses,
            pos,
            want,
        )
        OrElse(x, other, pos) => lower_or_else(x, other, pos)
        NewRef(x, pos) => lower_new_ref(x, pos, want)
        TupleLit(items, pos) => lower_tuple_lit(items, pos, want)
        Closure(ps, body, pos) => lower_closure_lit(ps, body, pos, want)

## A name: a local, a constant, a field of `self`, a function, a global or a bare variant.
fn Lower.lower_name(mut self, name str, pos ast.Pos, want Ty?) Val?
    key := self.lookup(name) else
        if v := const_param_value(name)
            return v
        if self.consts.contains("{self.prefix}{name}")
            return lower_const("{self.prefix}{name}", want)
        k := self_slot(name)
        if k >= 0
            t := self.structs[self.self_ty][k].ty
            return Val(id: load(self_value(), k, t), ty: t)
        if v := fn_value(name, pos)
            return v
        if self.globals.contains("{self.prefix}{name}")
            return global_const("{self.prefix}{name}")
        if v := bare_variant(name, want)
            return new_variant(v, none, pos)
        self.problem(
            pos,
            "`{name}` isn't in the native subset yet (only locals, parameters and constants)",
        )
        return none
    if self.var_ty[key].is_unknown()
        self.fn_failed = true
        return none
    Val(id: self.read_var(key, self.cur), ty: self.var_ty[key])

## A call `f(...)`, or a variant built by calling it.
fn Lower.lower_call_expr(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos, want Ty?) Val?
    if ordered := label_ordered(callee, args)
        return self.lower_call_expr(callee, ordered, pos, want)
    if is_generic_callee(callee)
        return lower_generic_callee(callee, args, pos, want)
    if v := call_variant(callee, want)
        return new_variant(v, args, pos)
    self.lower_call(callee, args, pos)

fn Lower.unsupported(mut self, pos ast.Pos, what str) Val?
    self.problem(pos, "not in the native subset yet: {what}")
    none

fn is_range(e ast.Expr) bool
    match e
        Range => true
        _ => false

## `if`, as a statement or a value (expr.if.1-4). The arms of a value `if`
## pass their results to the join block's first parameter.
fn Lower.lower_if(
    mut self,
    branches List[ast.Branch],
    els List[ast.Stmt]?,
    else_err ast.Ident?,
    pos ast.Pos,
    want Ty?,
) Val?
    join := self.new_block()
    mut taken := false
    mut taken_ty := Ty.Unknown
    value := els != none and want_value(want)
    mut result := -1
    mut rty := Ty.Unknown
    if value
        result = self.new_value(Ty.Unknown, "")
        self.blocks[join].params.push(result)
        rty = arms_start(want, [br.body for br in branches], els)
    for br in branches
        mut bound := ""
        mut bval := Val(id: -1, ty: Ty.Unit)
        mut failable := false
        c := match br.cond
            Test(x) => self.lower_value(x, Ty.Bool)?
            Bind(bname, bpos, x) =>
                # `if v := f(i)` on a call that can fail binds its value on success.
                if fallible_call(x)
                    m := lower_maybe(x)?
                    bound = bname
                    bval = m.val
                    failable = true
                    taken_ty = m.err
                    Val(id: m.present, ty: Ty.Bool)
                else
                    o := self.lower_value(x, none)?
                    if o.ty.opt_inner() == none
                        return self.unsupported(bpos, "`if {bname} := e` on a `{o.ty.name()}`")
                    bound = bname
                    bval = o
                    Val(id: self.op("ne", [o.id, self.konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
        yes := self.new_block()
        no := self.new_block()
        self.branch(c.id, yes, [], no, [])
        self.seal(yes)
        self.seal(no)
        if failable
            # The failure is handled by taking the `else` side, which may name it.
            self.cur = no
            if else_err == none
                self.call("rt.err_clear", [], Ty.Unit)
            else
                taken = true
        self.cur = yes
        self.scopes.push(Map[str, str]())
        if bound != ""
            u := if failable then bval else unwrap(bval)
            self.declare(bound, u.ty, u.id)
        self.tail_want = if value and not rty.is_unknown() then rty else none
        v := self.lower_block(br.body, value)
        self.scopes.pop()
        rty = self.arm_end(join, value, v, pos, rty)
        self.cur = no
    if body := els
        self.scopes.push(Map[str, str]())
        if taken
            if n := else_err
                bind_taken_error(n.name, taken_ty)
        self.tail_want = if value and not rty.is_unknown() then rty else none
        v := self.lower_block(body, value)
        self.scopes.pop()
        rty = self.arm_end(join, value, v, pos, rty)
    else
        self.jump(join, [])
    self.seal(join)
    self.cur = join
    if value
        self.vals[result] = rty
        return Val(id: result, ty: rty)
    Val(id: -1, ty: Ty.Unit)

## A statement-level `if` is lowered with `want` unit.
fn want_value(want Ty?) bool
    w := want else return true
    not w.is_unit()

## Finish an arm of an `if`; gives the `if`'s type as known so far.
fn Lower.arm_end(mut self, join int, value bool, v Val?, pos ast.Pos, rty Ty) Ty
    if self.done()
        return rty
    if not value
        self.jump(join, [])
        return rty
    x := v else
        if not self.failing()
            self.problem(pos, "this `if` needs a value in every branch")
        self.jump(join, [])
        return rty
    mut t := rty
    if t.is_unknown() or is_pending_opt(t)
        t = settle_arm_ty(t, x.ty)
    self.jump(join, [self.convert(x, t, pos)])
    t

fn Lower.lower_list(mut self, items List[ast.Expr], pos ast.Pos, want Ty?) Val?
    mut elem := Ty.Unknown
    if w := want
        elem = w.elem() else Ty.Unknown
    n := self.konst(items.len(), Ty.Int)
    mut has_none := false
    for x in items
        if is_none_lit(x)
            has_none = true
    mut vs := List[int]()
    for x in items
        v := self.lower_value(x, if elem.is_unknown() then none else elem)?
        if elem.is_unknown() or is_pending_opt(elem)
            # A `none` among the items makes the element type optional.
            elem = if has_none and v.ty.opt_inner() == none then (opt_of(v.ty) else v.ty) else v.ty
        if not is_number(elem)
            and not elem.is_sized()
            and elem != Ty.Str
            and elem != Ty.Bytes
            and not needs_copy(elem)
            and not is_enum(elem)
            and not is_shared_opt(elem)
            and not is_pending_opt(elem)
            and not elem.is_coll()
            and not elem.is_ref()
            and not elem.is_fn()
            and not elem.is_tensor()
            and not is_shared_handle(elem)
            return self.unsupported(pos, "a list of `{elem.name()}`")
        vs.push(self.convert(Val(id: self.copy_if_place(x, v), ty: v.ty), elem, pos))
    l := self.call("rt.list_new", [n], Ty.List(elem))
    for v in vs
        self.push_with_room(l, v, elem)
    Val(id: l, ty: Ty.List(elem))

fn push_fn(elem Ty) str
    match elem
        Float | F32 => "rt.list_pushf"
        _ => push_fn_of(elem.elem_bytes())

fn Lower.lower_call(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos) Val?
    match callee
        Name(name, npos) =>
            if name == "print" and not self.is_rt
                return lower_print(args, pos)
            if name == ast.YIELD and not self.is_rt
                return lower_yield(args, pos)
            if ASSERT_FNS.contains(name) and not self.is_rt and self.lookup(name) == none
                return lower_assert(name, args, pos)
            if name == "Atomic" and self.tk.on and not self.is_rt
                return lower_atomic_new(none, args, pos)
            if self.is_rt and PRIMS.contains(name)
                return self.lower_prim(name, args)
            if name == "unreachable" and not self.is_rt and self.lookup(name) == none
                return lower_unreachable(args, pos)
            # A local that isn't a function value doesn't shadow a function or method.
            if k := self.lookup(name)
                if self.var_ty[k].is_fn()
                    return call_value(
                        Val(id: self.read_var(k, self.cur), ty: self.var_ty[k]),
                        args,
                        npos,
                    )
            if (name == "TaskGroup" or name == "Mutex")
                and self.tk.on
                and not self.is_rt
                and self.lookup(name) == none
                return lower_sync_new(name, args, pos)
            if self.lookup(name) == none
                if k := type_key(name)
                    return new_struct(k, args, pos)
            if self.self_ty != "" and not self.sigs.contains("{self.self_ty}.{name}")
                instance_method("{self.self_ty}.{name}")
            if self.self_ty != "" and self.sigs.contains("{self.self_ty}.{name}")
                return struct_call(
                    "{self.self_ty}.{name}",
                    Val(id: self_value(), ty: owner_ty(self.self_ty)),
                    args,
                    npos,
                )
            if self.self_ty != "" and self.bad.contains("{self.self_ty}.{name}")
                release("{self.self_ty}.{name}")
                self.fn_failed = true
                return none
            mut key := "{self.prefix}{name}"
            if not self.sigs.contains(key) and not self.bad.contains(key)
                key = prelude_key(name) else key
            if self.bad.contains(key)
                release(key)
                self.fn_failed = true
                return none
            if name == "zip" and not self.sigs.contains(key)
                return lower_zip(args, pos)
            sig := self.sigs.get(key) else return self.unsupported(npos, "calling `{name}`")
            if c_call_site(key)
                return lower_variadic(key, sig, args, pos, npos)
            if args.len() != sig.params.len()
                return self.unsupported(pos, "this call")
            mut vs := List[int]()
            mut cells := List[Cell]()
            for i in 0..args.len()
                a := args[i]
                if a.label != none
                    return self.unsupported(pos, "labelled arguments")
                if t := cell_ty(sig.params[i])
                    vs.push(cell_arg(a, t, mut cells)?)
                    continue
                v := self.lower_value(a.value, sig.params[i])?
                retype_arg(a.value, v, sig.params[i])
                uniq_arg(a)
                vs.push(shield_arg(args, i, Val(
                    id: self.convert(v, sig.params[i], expr_pos(a.value)),
                    ty: v.ty,
                )))
            check_mut_overlap(args, npos)
            check_requires(key, vs, npos)
            instr_watch_cells(cells)
            res := Val(id: self.user_call(contract_key(key), vs, sig.ret, npos, name), ty: sig.ret)
            instr_watch_cells_end(cells)
            cells_back(cells)
            res
        Member =>
            if k := self.type_name(callee)
                return new_struct(k, args, pos)
            call_member_value(callee, args, pos)
        TypeArgs(name, targs, tpos) =>
            if name == "Atomic" and self.tk.on and not self.is_rt
                return lower_atomic_new(targs, args, pos)
            if name == "Channel" and self.tk.on and not self.is_rt
                return lower_chan_new(targs, args, pos)
            if name == "Mutex" and self.tk.on and not self.is_rt
                return lower_mutex_new(targs, args, pos)
            if (name == "Map" or name == "Set") and args.len() == 0
                return coll_ctor(name, targs, tpos)
            if name == "List" and targs.len() == 1 and args.len() == 0
                t := self.type_of(ast.TypeRef(shape: Named("List", targs), pos: tpos)) else
                    return self.unsupported(tpos, "this list type")
                return Val(id: self.call("rt.list_new", [self.konst(0, Ty.Int)], t), ty: t)
            self.unsupported(tpos, "`{name}[...]`")
        _ =>
            f := self.lower_value(callee, none)?
            call_value(f, args, expr_pos(callee))

fn Lower.lower_prim(mut self, name str, args List[ast.Arg]) Val?
    mut vs := List[int]()
    mut sym := ""
    for k in 0..args.len()
        # `import_call` and `fn_addr` name a symbol in their first argument,
        # which must be a string literal (native-abi.md §11).
        if k == 0 and (name == "import_call" or name == "fn_addr")
            match args[0].value
                Str(s, _) => sym = s
                _ => return self.unsupported(expr_pos(args[0].value), "a computed symbol name")
            continue
        v := self.lower_value(args[k].value, none)?
        vs.push(v.id)
    # An import is an ordinary call whose name carries the `libsys.` prefix
    # (native-abi.md §11); the code generator calls it through its GOT slot.
    if name == "import_call"
        return Val(id: self.call("libsys.{sym}", vs, Ty.Int), ty: Ty.Int)
    t := match PRIMS[name]
        "int" => Ty.Int
        "float" => Ty.Float
        "list" => Ty.List(Ty.Int)
        "str" => Ty.Str
        _ => Ty.Unit
    mut i := inst(-1, "prim", vs)
    # The symbol rides in the name: `fn_addr:rt.f`.
    i.name = if sym == "" then name else "{name}:{sym}"
    if t.is_unit()
        self.emit_void(i)
        return Val(id: -1, ty: t)
    Val(id: self.emit(i, t), ty: t)

## `print(x)`: a number, `bool`, string literal, list of numbers, or an
## interpolation of those (17-std, native-abi.md §8).
fn Lower.lower_print_body(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1
        return self.unsupported(pos, "this `print`")
    match args[0].value
        Interp(parts, ipos) =>
            for p in parts
                match p
                    Lit(text) => self.call("rt.out_str", [self.str_value(text)], Ty.Unit)
                    Hole(x) =>
                        v := self.lower_value(x, none)?
                        self.out(v, ipos)?
                    Fmt(x, spec) =>
                        v := self.lower_value(x, none)?
                        lower_fmt_print(v, spec, ipos)?
        _ =>
            v := self.lower_value(args[0].value, none)?
            if not print_join_direct(args[0].value, v)
                self.out(v, pos)?
    self.call("rt.out_nl", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

fn out_fn(t Ty) str
    if t == Ty.Sized("u64")
        return "rt.out_u64"
    match t
        Int | Sized(_) => "rt.out_int"
        Float | F32 => float_out_fn(t)
        Bool => "rt.out_bool"
        Str => "rt.out_str"
        Atomic(e) => if e == Ty.Bool then "rt.out_atomic_bool" else "rt.out_atomic_int"
        Char => "rt.out_char"
        Tensor(_) => "rt.out_tensor"
        Bytes => "rt.out_bytes_lit"
        List(e) =>
            if e.is_sized() and e.elem_bytes() < 8
                return narrow_out_fn(e.elem_bytes())
            match e
                Int | Sized(_) => "rt.out_list_int"
                Float => "rt.out_list_float"
                Bool => "rt.out_list_bool"
                # Lists of strings and of lists: `rt.out_list_deep`.
                _ => ""
        _ => ""

fn Lower.out(mut self, v Val, pos ast.Pos) Val?
    if v.ty == Ty.List(Ty.Sized("u64"))
        return out_text(v, pos)
    if v.ty.opt_inner() != none
        return out_opt(v, pos)
    if v.ty.is_coll()
        return out_coll(v, pos)
    if e := v.ty.elem()
        mut depth := 0
        mut leaf := e
        while leaf.elem() != none
            depth += 1
            leaf = leaf.elem() else Ty.Unknown
        mut k := match leaf
            Int | Sized(_) => 0
            Float => 1
            Bool => 2
            Str => 3
            Char => 4
            F32 => 5
            _ => -1
        if leaf.is_sized() and leaf.elem_bytes() < 8
            k = narrow_leaf(leaf.elem_bytes())
        if k >= 0 and (depth > 0 or k >= 3)
            self.call(
                "rt.out_list_deep",
                [v.id, self.konst(depth, Ty.Int), self.konst(k, Ty.Int)],
                Ty.Unit,
            )
            return Val(id: -1, ty: Ty.Unit)
    if s := display_call(v)
        self.call("rt.out_str", [s], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    f := out_fn(v.ty)
    if f == ""
        return self.unsupported(pos, "printing a `{v.ty.name()}`")
    self.call(f, [v.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

fn Lower.lower_method(
    mut self,
    recv ast.Expr,
    name str,
    npos ast.Pos,
    args List[ast.Arg],
    want Ty?,
) Val?
    if rest := trait_call_args(recv, args)
        return self.lower_method(args[0].value, name, npos, rest, want)
    if ta := module_type_args(recv)
        return self.lower_method(ta, name, npos, args, want)
    # std.env.1
    if name == "args" and args.len() == 0 and self.is_module(recv, "env")
        t := Ty.List(Ty.Str)
        return Val(id: self.call("rt.args", [], t), ty: t)
    if name == "select" and self.tk.on and self.is_module(recv, "task")
        return lower_chan_select(args, npos)
    om := os_module(recv)
    if om != ""
        return lower_os_method(om, name, npos, args)
    sm := std_module(recv)
    if sm != ""
        return lower_std_call(sm, name, npos, args)
    if name == "from_code" and self.is_module(recv, "char")
        return lower_char_from_code(args, npos)
    if self.is_module(recv, "tensor")
        return lower_tensor_call(name, args, npos, want)
    if name == "select" and self.tk.on and self.is_module(recv, "task")
        return lower_chan_select(args, npos)
    if self.is_module(recv, "mem")
        return lower_mem_call(name, npos, args)
    if g := generic_member_ref(recv)
        return generic_member(g, recv, name, args, npos, none)
    if en := enum_ref(recv)
        if case_index(en, name) >= 0
            return new_variant(VariantRef(en: en, k: case_index(en, name)), args, npos)
        if is_enum_static(en, name)
            return lower_enum_static(en, name, args, npos)
        return struct_call("{en}.{name}", none, args, expr_pos(recv))
    if a := assoc_owner(recv)
        assoc_instance(recv, name)
        return struct_call("{a}.{name}", none, args, expr_pos(recv))
    if n := self.type_name(recv)
        return struct_call("{n}.{name}", none, args, expr_pos(recv))
    if cal := qualified_generic_callee(recv, name, npos)
        return lower_generic_callee(cal, args, npos, want)
    if m := self.module_name(recv)
        if self.structs.contains("{m}.{name}")
            return new_struct("{m}.{name}", args, npos)
        return struct_call("{m}.{name}", none, args, expr_pos(recv))
    if name == "sum" and args.len() == 0
        if ws := tensor_widen_sum(recv)
            return ws
    r := deref_use(self.lower_value(recv, none)?, expr_pos(recv))
    if e := atomic_elem(r.ty)
        return lower_atomic_method(r.id, e, name, npos, args)
    if chan_elem(r.ty) != none
        return lower_chan_method(r, name, npos, args)
    if is_sync(r.ty) or is_task_cancel(recv, name)
        return lower_sync_method(r, name, npos, args)
    if is_vocab_call(r.ty, name)
        return lower_vocab(r, name, args, npos)
    if name == "enumerate" and args.len() == 0 and r.ty.elem() != none
        return lower_enumerate(r)
    if is_sorting(name, args) and r.ty.elem() != none
        return lower_sorted(r, name, args, npos)
    if k := builtin_method(r.ty, name)
        return struct_call(k, r, args, npos)
    if r.ty.is_coll()
        return lower_coll_method(r, name, npos, args)
    if r.ty.is_tensor()
        return lower_tensor_method(r, name, npos, args)
    if s := struct_name(r.ty)
        set_receiver(recv, "{s}.{name}")
        return struct_call("{s}.{name}", r, args, npos)
    if is_enum_name(r.ty, name, args)
        return lower_enum_name(r, npos)
    if s := enum_name(r.ty)
        set_receiver(recv, "{s}.{name}")
        return struct_call("{s}.{name}", r, args, npos)
    if t := any_of(r.ty)
        return any_call(t, r, name, args, npos)
    mut vs := List[Val]()
    for a in args
        if a.label != none or a.mutable
            return self.unsupported(npos, "this method call")
        mut arg_want := str_arg_want(r.ty, name)
        if e := r.ty.elem()
            arg_want = if name == "push" then e else Ty.Int
            if name == "join"
                arg_want = Ty.Str
        vs.push(self.lower_value(a.value, if arg_want.is_unknown() then none else arg_want)?)
    if name == "to_str" and vs.len() == 0 and r.ty != Ty.Bytes
        # type.str.3
        text := text_of(r, npos)?
        return Val(id: text, ty: Ty.Str)
    match r.ty
        Bytes | Byte => return bytes_method(r, name, vs, npos)
        Int | Sized(_) => return int_method(r, name, npos, vs)
        Float | F32 => return float_method(r, name, npos, vs)
        Str => return str_method(r, name, npos, vs)
        Ptr(_) => return ptr_method(r, name, npos, vs)
        Char => return lower_char_method(r, name, npos, vs)
        List(e) => return list_method(e, r, name, npos, vs, args, recv)
        _ => return self.unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    self.unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## The struct `e` names, when it names one and no local: `T.f(...)`.
fn Lower.type_name(self, e ast.Expr) str?
    match e
        Name(n, _) => if self.lookup(n) == none then type_key(n) else none
        Member =>
            p := path_of(e)?
            type_key(p)
        _ => none

## The import path of the module `e` names in this file, if it names one.
fn Lower.module_name(self, e ast.Expr) str?
    match e
        Name(n, _) => module_of(n)
        _ => none

## Whether `e` names module `m` (not a local or a field of that name).
fn Lower.is_module(self, e ast.Expr, m str) bool
    match e
        Name(n, _) => (n == m or std_alias(n) == m) and self.lookup(n) == none and self_slot(n) < 0
        _ => false

## An empty list typed by its first `push` (type.coll.6): the variable takes
## the element type from here on.
fn Lower.retype(mut self, recv ast.Expr, t Ty)
    n := match recv
        Name(n, _) => n
        _ => return
    key := self.lookup(n) else return
    self.var_ty[key] = t
    for v in self.var_vals[key]
        self.vals[v] = t

pub fn expr_pos(e ast.Expr) ast.Pos
    match e
        Str(_, p) => p
        Bytes(_, p) => p
        Interp(_, p) => p
        Int(_, p) => p
        Float(_, p) => p
        Char(_, p) => p
        Bool(_, p) => p
        NoneLit(p) => p
        Hole(p) => p
        Name(_, p) => p
        TypeArgs(_, _, p) => p
        ListLit(_, p) => p
        Call(_, _, p) => p
        Method(_, _, p, _) => p
        Member(_, _, p) => p
        Index(_, _, p) => p
        Unary(_, _, p) => p
        Binary(_, _, _, p) => p
        Range(_, _, _, p) => p
        MapLit(_, p) => p
        SetLit(_, p) => p
        If(_, _, _, p) => p
        Match(_, _, p) => p
        Try(_, _, p) => p
        Comp(_, _, _, _, p) => p
        OrElse(_, _, p) => p
        NewRef(_, p) => p
        TupleLit(_, p) => p
        Closure(_, _, p) => p
