## Lowering the syntax tree of the native subset to MIR (ADR 0384).
##
## SSA is built on the fly as Braun et al. describe ("Simple and efficient
## construction of static single assignment form", 2013): a local's value
## is looked up through the predecessors of the current block; a block
## that may still gain predecessors (a loop header) gets a placeholder
## parameter that is completed when the block is sealed. Parameters that
## turn out to receive one value are removed afterwards (`simplify`).
##
## A construct outside the subset is reported as `native.subset.1` with its
## position; nothing is lowered for a program with problems.
use ast

## A function's parameter and result types, as the lowering needs them.
pub struct Sig
    pub params List[Ty]
    pub ret Ty
    ## The function can fail: `ret` is its success type (lower_err.ail).
    pub fails bool

pub struct Problem
    pub rule str
    pub pos ast.Pos
    pub message str

pub error struct Problems "the program is outside the native subset"
    pub items List[Problem]
    ## The file of each problem.
    pub files List[str]

## Where `continue` and `break` go in the innermost loop.
struct Loop
    cont int
    exit int

## A value and its type, as an expression produces it. `id` is -1 for an
## expression without a value (a call of a function returning nothing).
struct Val
    id int
    ty Ty

struct Lower
    ## The source file being lowered (for error traces) and every file's.
    path str
    file_paths List[str]
    ## Zero-field `error struct`s to their messages (lower_err.ail).
    err_msgs Map[str, str]
    ## The error type of each function that can fail, when it names one.
    fn_errs Map[str, Ty]
    ## The type the next block's final expression should have (consumed by `lower_block`).
    tail_want Ty?
    ## Where the function's last expression begins: the trace line of an error it ends in.
    tail_pos ast.Pos
    ## The function being lowered can fail.
    fails bool
    sigs Map[str, Sig]
    ## Functions outside the subset, already reported: calls of them are
    ## not reported again.
    bad Set[str]
    ## Constants whose value is a number or `bool` literal, inlined at
    ## each use (mod.const.1).
    consts Map[str, ast.Expr]
    strs List[str]
    str_index Map[str, int]
    ## The source path and lines, for the trap texts of `lower_str.ail`.
    src_paths List[str]
    src_lines List[List[str]]
    sites List[Site]
    problems List[Problem]
    funcs List[Func]
    ## "rt." while lowering the runtime, "" for the program.
    prefix str
    is_rt bool
    ## The function being lowered.
    fname str
    ret Ty
    blocks List[Block]
    vals List[Ty]
    names List[str]
    sealed List[bool]
    closed List[bool]
    preds List[List[int]]
    defs List[Map[str, int]]
    incomplete List[Map[str, int]]
    cur int
    ## Source names in scope, innermost last, to unique variable keys.
    scopes List[Map[str, str]]
    var_ty Map[str, Ty]
    ## Every value a variable has had, so typing an empty list by its first
    ## `push` reaches them all.
    var_vals Map[str, List[int]]
    nvars int
    loops List[Loop]
    ## The structs' fields (ADR 0392).
    structs Map[str, List[Slot]]
    ## The struct whose method is being lowered, else "".
    self_ty str
    ## Variables whose list or struct belongs to someone else (parameters,
    ## `for` variables): returning one copies it.
    borrowed Set[str]
    ## The generated `copy.T` functions asked for, by name.
    copy_tys Map[str, Ty]
    ## `problems.len()` when the current function began.
    fn_problems int
    ## Set when the function used something already reported elsewhere (a
    ## function or variable outside the subset): its MIR is incomplete.
    fn_failed bool
    ## The source file being lowered, its imports (name to module) and
    ## those of every file, and each file's key prefix (ADR 0393).
    file int
    aliases Map[str, str]
    file_aliases List[Map[str, str]]
    file_prefix List[str]
    ## The file that declares each constant, whose names its value uses.
    const_home Map[str, int]
    ## The file of each problem, filled in by `stamp_problems`.
    problem_files List[int]
    ## The enums' variants (ADR 0602), the `eq.E` functions asked for, and
    ## the variants without fields that have a shared object.
    enums Map[str, List[Case]]
    eq_tys Map[str, Ty]
    singletons List[VariantRef]
    ## Program globals by key (ADR 0604), and the constants computed into
    ## them at start-up.
    globals Map[str, Global]
    global_consts List[GlobalConst]

## The primitives of the runtime (native-abi.md §6), with their result types.
PRIMS := {
    "load64": "int",
    "store64": "unit",
    "load8": "int",
    "store8": "unit",
    "loadf": "float",
    "storef": "unit",
    "syscall": "int",
    "global": "int",
    "str_addr": "int",
    "list_addr": "int",
    "list_at": "list",
    "str_at": "str",
    "float_bits": "int",
    "bits_float": "float",
    "target": "int",
    "gc_regs": "int",
    "globals_end": "int",
}

## Lower a program and, when given, the runtime; `Problems` lists what is
## outside the subset.
pub fn lower_module(path str, text str, prog ast.Program, rt ast.Program?) Module ! Problems
    lower_package([Source(module: "", path: path, text: text, prog: prog)], rt)

## One source file of a package: the module it belongs to (its import path,
## "" for the root module), its path and text, and its syntax tree.
pub struct Source
    pub module str
    pub path str
    pub text str
    pub prog ast.Program

## Lower the files of a package (mod.unit.1-5, ADR 0393) and, when given,
## the runtime. The first source is the root module's file holding `main`;
## problems name the file they are in (`Problems.files`).
pub fn lower_package(input List[Source], rt ast.Program?) Module ! Problems
    srcs := with_error_owners(input)
    mut l := Lower(
        path: srcs[0].path,
        file_paths: [src.path for src in srcs],
        err_msgs: {"fs.IoError": "", "IoError": ""},
        fn_errs: {},
        tail_want: none,
        tail_pos: ast.Pos(line: 1, col: 1),
        fails: false,
        sigs: {},
        bad: Set[str](),
        consts: {},
        strs: [],
        str_index: {},
        src_paths: [src.path for src in srcs],
        src_lines: [src.text.lines() for src in srcs],
        sites: [],
        problems: [],
        funcs: [],
        prefix: "",
        is_rt: false,
        fname: "",
        ret: Ty.Unit,
        blocks: [],
        vals: [],
        names: [],
        sealed: [],
        closed: [],
        preds: [],
        defs: [],
        incomplete: [],
        cur: 0,
        scopes: [],
        var_ty: {},
        var_vals: {},
        nvars: 0,
        loops: [],
        structs: {},
        self_ty: "",
        borrowed: Set[str](),
        copy_tys: {},
        fn_problems: 0,
        fn_failed: false,
        file: 0,
        aliases: {},
        file_aliases: [],
        file_prefix: [],
        const_home: {},
        problem_files: [],
        enums: {},
        eq_tys: {},
        singletons: [],
        globals: {},
        global_consts: [],
    )
    for src in srcs
        l.file_aliases.push(aliases_of(src.prog))
        l.file_prefix.push(if src.module == "" then "" else "{src.module}.")
    if r := rt
        l.declare_all(r, "rt.")
    l.problem_files = [0 for _ in l.problems]
    for src in srcs
        l.declare_errors(src.prog)
    for k in 0..srcs.len()
        l.enter_file(k)
        l.declare_errors(srcs[k].prog)
        l.declare_struct_names(srcs[k].prog)
        l.declare_enum_names(srcs[k].prog)
    l.declare_prelude_enums()
    for k in 0..srcs.len()
        l.enter_file(k)
        l.declare_struct_fields(srcs[k].prog)
        l.declare_enums(srcs[k].prog)
    for k in 0..srcs.len()
        l.enter_file(k)
        l.declare_all(srcs[k].prog, l.prefix)
    l.stamp_problems()
    l.gen_const_init()
    for k in 0..srcs.len()
        l.enter_file(k)
        l.path = srcs[k].path
        for f in srcs[k].prog.fns
            l.lower_fn(f)
        l.stamp_problems()
    l.enter_file(0)
    l.gen_copies()
    l.gen_enum_eqs()
    l.gen_init_enums()
    l.call_inits()
    l.stamp_problems()
    if r := rt
        l.lower_rt(r)
        l.stamp_problems()
    if l.problems.len() > 0
        mut order := [k for k in 0..l.problems.len()]
        order = order.sorted(by: |k| (l.problem_files[k] * 1000000 + l.problems[k].pos.line) * 1000 + l.problems[k].pos.col)
        return Problems(
            items: [l.problems[k] for k in order],
            files: [srcs[l.problem_files[k]].path for k in order],
        )
    m := inline_module(Module(
        path: srcs[0].path,
        funcs: l.funcs,
        strs: l.strs,
        sites: l.sites,
        lines: srcs[0].text.lines(),
        files: [src.path for src in srcs],
        file_lines: [src.text.lines() for src in srcs],
    ))
    mut errs := List[Problem]()
    for f in m.funcs
        for err in verify(f)
            errs.push(Problem(
                rule: "native.build.2",
                pos: ast.Pos(line: 1, col: 1),
                message: "internal error: invalid MIR after inlining: {f.name}: {err}",
            ))
    if errs.len() > 0
        return Problems(items: errs, files: [srcs[0].path for _ in errs])
    m

## The runtime functions the code generators call by name, besides those
## the MIR calls.
RT_ROOTS := [
    "rt.init",
    "rt.exit",
    "rt.trap",
    "rt.list_push",
    "rt.list_pushf",
    "rt.list_pushb",
    "rt.list_reserve",
    "rt.list_rows_min",
    "rt.list_new_for",
]

## Lower the runtime functions the program reaches, and those they reach
## (ADR 0393): a program pays only for the runtime it uses.
fn Lower.lower_rt(mut self, r ast.Program)
    prefix = "rt."
    aliases = {}
    is_rt = true
    mut decls := Map[str, ast.FnDecl]()
    for f in r.fns
        if not PRIMS.contains(f.name)
            decls["rt.{f.name}"] = f
    mut done := Set[str]()
    mut queue := RT_ROOTS
    mut scanned := 0
    while true
        while scanned < funcs.len()
            for blk in funcs[scanned].blocks
                for i in blk.insts
                    if i.op == "call" and decls.contains(i.name)
                        queue.push(i.name)
            scanned += 1
        if queue.len() == 0
            break
        name := queue.pop() else ""
        if done.contains(name) or not decls.contains(name)
            continue
        done.add(name)
        lower_fn(decls[name])
    is_rt = false

fn Lower.problem(mut self, pos ast.Pos, message str)
    problems.push(Problem(rule: "native.subset.1", pos: pos, message: message))

fn Lower.declare_all(mut self, prog ast.Program, pre str)
    for t in prog.traits
        problem(t.pos, "trait `{t.name}` isn't in the native subset yet")
    for c in prog.consts
        if is_const_expr(c.value)
            consts["{pre}{c.name}"] = c.value
            const_home["{pre}{c.name}"] = file
        elif pre != "rt."
            global_consts.push(GlobalConst(key: "{pre}{c.name}", decl: c, file: file))
        else
            problem(c.pos, "runtime constant `{c.name}` must be a constant expression")
    for f in prog.fns
        before := problems.len()
        declare_fn(f, pre)
        if problems.len() > before
            bad.add(fn_key(f, pre))
            sigs.remove(fn_key(f, pre))

fn Lower.declare_fn(mut self, f ast.FnDecl, pre str)
    if f.ext != none
        problems.push(Problem(
            rule: "ffi.native.1",
            pos: f.pos,
            message: "`extern c fn {f.name}`: `ail build` can't link a C library yet (`ail run` can)",
        ))
        return
    if f.generics.len() > 0
        problem(f.pos, "`{f.name}`: generic functions aren't in the native subset yet")
        return
    mut params := List[Ty]()
    if o := f.owner
        owner := "{pre}{o.name}"
        if o.params != none or not (structs.contains(owner) or enums.contains(owner))
            problem(
                f.pos,
                "`{o.name}.{f.name}`: methods of `{o.name}` aren't in the native subset yet",
            )
            return
        if f.receiver != none
            params.push(owner_ty(owner))
    elif f.receiver != none
        problem(
            f.pos,
            "`{f.name}`: methods of traits and `impl` blocks aren't in the native subset yet",
        )
        return
    if f.contracts.len() > 0
        problem(f.pos, "`{f.name}`: contracts aren't in the native subset yet")
    for a in f.attrs
        if a.name != "inline" and a.name != "pure"
            problem(a.pos, "attribute `@{a.name}` isn't in the native subset yet")
    mut floats := 0
    for p in f.params
        t := type_of(p.ty) else
            problem(p.pos, "parameter `{p.name}`: its type isn't in the native subset yet")
            Ty.Unknown
        if p.mutable and not needs_copy(t) and not t.is_unknown() and not t.is_coll()
            problem(
                p.pos,
                "`mut` parameter `{p.name}` of a number type isn't in the native subset yet",
            )
        if t.is_float()
            floats += 1
        params.push(t)
    # Primitives are not called through the ABI. Integer arguments past the
    # registers go on the stack; float ones don't yet.
    if floats > 8 and not (pre == "rt." and PRIMS.contains(f.name))
        problem(f.pos, "`{f.name}` has more than 8 float parameters")
    mut rty := Ty.Unit
    mut can_fail := false
    if r := f.ret
        can_fail = is_fallible(r)
        t := (if can_fail then ok_type(r) else type_of(r)) else
            problem(r.pos, "`{f.name}`: its result type isn't in the native subset yet")
            Ty.Unknown
        rty = t
    sigs[fn_key(f, pre)] = Sig(params: params, ret: rty, fails: can_fail)
    if can_fail
        if r := f.ret
            fn_errs[fn_key(f, pre)] = error_ty_of(r)

## A function's name in MIR: `T.m` for a method of `T`.
fn fn_key(f ast.FnDecl, pre str) str
    if o := f.owner
        return "{pre}{o.name}.{f.name}"
    "{pre}{f.name}"

## The MIR type of a written type, if it is in the subset.
fn Lower.type_of(self, t ast.TypeRef) Ty?
    match t.shape
        Optional(inner) => opt_of(type_of(inner)?)
        Named(name, args) =>
            match name
                "int" => Ty.Int
                "float" => Ty.Float
                "bool" => Ty.Bool
                "str" => Ty.Str
                "char" => Ty.Char
                "List" =>
                    if args.len() != 1
                        return none
                    e := type_of(args[0])?
                    if is_number(e) or e == Ty.Str or needs_copy(e) or is_enum(e)
                        return Ty.List(e)
                    none
                "Map" | "Set" => coll_type_of(name, args)
                "tensor.Tensor" | "Tensor" => tensor_type_of(args)
                _ =>
                    if args.len() == 0
                        if k := type_key(name)
                            return Ty.Struct(k)
                        if k := enum_key(name)
                            return Ty.Enum(k)
                    none
        FnType(fparams, fret) =>
            mut ps := List[Ty]()
            for p in fparams
                ps.push(type_of(p)?)
            mut r := Ty.Unit
            if rt := fret
                r = type_of(rt)?
            Ty.Fn(params: ps, ret: r)
        _ => none

fn is_literal(e ast.Expr) bool
    match e
        Int | Float | Bool => true
        Unary(o, x, _) =>
            match o
                Neg => is_literal(x)
                _ => false
        _ => false

## A constant's value that is inlined at each use: literals, names of other
## constants, and arithmetic on them (no calls, so no effects). A list is not:
## inlining it rebuilds it at every use, so it gets a program global (ADR 0604).
fn is_const_expr(e ast.Expr) bool
    match e
        Int | Float | Bool | Str | Name => true
        ListLit(_, _) => false
        Unary(_, x, _) => is_const_expr(x)
        Binary(_, a, b, _) => is_const_expr(a) and is_const_expr(b)
        _ => false

fn is_number(t Ty) bool
    match t
        Int | Float | Bool | Char => true
        _ => false

# ---- building blocks and values ----

fn Lower.new_value(mut self, ty Ty, name str) int
    vals.push(ty)
    names.push(name)
    vals.len() - 1

fn Lower.new_block(mut self) int
    blocks.push(Block(params: [], insts: [], term: unreachable_term()))
    sealed.push(false)
    closed.push(false)
    preds.push([])
    defs.push(Map[str, int]())
    incomplete.push(Map[str, int]())
    blocks.len() - 1

## Append an instruction defining a new value of type `ty`.
fn Lower.emit(mut self, i Inst, ty Ty) int
    v := new_value(ty, "")
    mut x := i
    x.dst = v
    blocks[cur].insts.push(x)
    v

fn Lower.emit_void(mut self, i Inst)
    blocks[cur].insts.push(i)

fn Lower.op(mut self, op str, args List[int], ty Ty) int
    emit(inst(-1, op, args), ty)

## A checked operation: it traps at `site`.
fn Lower.checked(mut self, op str, args List[int], site int, ty Ty) int
    mut i := inst(-1, op, args)
    i.site = site
    emit(i, ty)

fn Lower.call(mut self, name str, args List[int], ty Ty) int
    mut i := inst(-1, "call", args)
    i.name = name
    if ty.is_unit()
        emit_void(i)
        return -1
    emit(i, ty)

fn Lower.konst(mut self, n int, ty Ty) int
    mut i := inst(-1, "const", [])
    i.imm = n
    emit(i, ty)

fn Lower.fconst(mut self, x float) int
    mut i := inst(-1, "fconst", [])
    i.fimm = x
    emit(i, Ty.Float)

fn Lower.str_value(mut self, s str) int
    mut i := inst(-1, "str", [])
    i.imm = str_lit(s)
    emit(i, Ty.Str)

## Whether the current block already ends (after `return`, `break`...).
fn Lower.done(self) bool
    closed[cur]

fn Lower.finish(mut self, term Term)
    if done()
        return
    for s in term.targets
        preds[s].push(cur)
    blocks[cur].term = term
    closed[cur] = true

## Start lowering into a block that nothing reaches: code after a jump.
fn Lower.dead_block(mut self)
    b := new_block()
    sealed[b] = true
    cur = b

fn Lower.jump(mut self, to int, args List[int])
    finish(jump_to(to, args))

## End the current block with a branch whose edges pass `yes_args` and
## `no_args`. The two targets must differ.
fn Lower.branch(mut self, cond int, yes int, yes_args List[int], no int, no_args List[int])
    mut t := branch_on(cond, yes, no)
    t.args = [yes_args, no_args]
    finish(t)

fn Lower.seal(mut self, b int)
    pending := incomplete[b]
    for key in pending.keys()
        add_edge_args(key, pending[key], b)
    sealed[b] = true

## Give every edge into `b` the value of `key` for its new parameter.
fn Lower.add_edge_args(mut self, key str, param int, b int)
    for p in preds[b]
        v := read_var(key, p)
        for e in 0..blocks[p].term.targets.len()
            if blocks[p].term.targets[e] == b
                blocks[p].term.args[e].push(v)

fn Lower.write_var(mut self, key str, b int, v int)
    defs[b][key] = v
    var_vals.push(key, v)

fn Lower.read_var(mut self, key str, b int) int
    if v := defs[b].get(key)
        return v
    mut v := -1
    if not sealed[b]
        v = new_value(var_ty[key], key.split("#")[0])
        blocks[b].params.push(v)
        incomplete[b][key] = v
    elif preds[b].len() == 1
        v = read_var(key, preds[b][0])
    else
        v = new_value(var_ty[key], key.split("#")[0])
        blocks[b].params.push(v)
        write_var(key, b, v)
        add_edge_args(key, v, b)
    write_var(key, b, v)
    v

## Declare a source name in the innermost scope and give it a value.
fn Lower.declare(mut self, name str, ty Ty, v int)
    nvars += 1
    key := "{name}#{nvars}"
    scopes[scopes.len() - 1][name] = key
    var_ty[key] = ty
    if v >= 0 and names[v] == ""
        names[v] = name
    write_var(key, cur, v)

fn Lower.lookup(self, name str) str?
    mut i := scopes.len() - 1
    while i >= 0
        if k := scopes[i].get(name)
            return k
        i -= 1
    none

## A check's trap site, or -1 in the runtime, whose arithmetic wraps and
## whose indexing is unchecked (native-abi.md §7).
fn Lower.site(mut self, rule str, kind str, op str, pos ast.Pos) int
    if is_rt
        return -1
    sites.push(Site(
        rule: rule,
        kind: kind,
        op: op,
        line: pos.line,
        col: pos.col,
        func: fname,
        file: file,
    ))
    sites.len() - 1

fn Lower.str_lit(mut self, s str) int
    if i := str_index.get(s)
        return i
    strs.push(s)
    str_index[s] = strs.len() - 1
    strs.len() - 1

# ---- functions ----

fn Lower.lower_fn(mut self, f ast.FnDecl)
    key := fn_key(f, prefix)
    sig := sigs.get(key) else return
    params := begin_fn(key, sig.ret, sig.params)
    fails = sig.fails
    self_ty = ""
    mut k := 0
    if o := f.owner
        if f.receiver != none
            self_ty = "{prefix}{o.name}"
            declare("self", sig.params[0], params[0])
            borrowed.add(lookup("self") else "")
            k = 1
    for i in 0..f.params.len()
        p := f.params[i]
        declare(p.name, sig.params[k + i], params[k + i])
        borrowed.add(lookup(p.name) else "")
    body := f.body else return
    want := not ret.is_unit()
    if want
        tail_want = ret
        if body.len() > 0
            if e := final_expr(body[body.len() - 1])
                tail_pos = expr_pos(e)
    result := lower_block(body, want)
    if not done()
        if want
            if r := result
                v := Val(id: convert(r, ret, f.pos), ty: r.ty)
                e := final_expr(body[body.len() - 1]) else ast.Expr.NoneLit(f.pos)
                finish(return_of(copy_if_borrowed(e, v)))
            elif not failing()
                problem(f.pos, "`{f.name}` must end with its result")
        else
            finish(return_of(-1))
    end_fn(key, f.pos)

## Start a function: fresh state, and an entry block whose parameters are
## the function's.
fn Lower.begin_fn(mut self, name str, rty Ty, ptys List[Ty]) List[int]
    fname = name
    ret = rty
    fn_problems = problems.len()
    fn_failed = false
    blocks = []
    vals = []
    names = []
    sealed = []
    closed = []
    preds = []
    defs = []
    incomplete = []
    scopes = [Map[str, str]()]
    var_ty = {}
    var_vals = {}
    nvars = 0
    loops = []
    borrowed = Set[str]()
    cur = new_block()
    sealed[cur] = true
    for t in ptys
        blocks[cur].params.push(new_value(t, ""))
    blocks[cur].params

## Whether the current function already failed: later problems in it
## would only repeat the first.
fn Lower.failing(self) bool
    problems.len() > fn_problems or fn_failed

## Finish the function begun with `begin_fn`: simplify, fold, verify.
fn Lower.end_fn(mut self, name str, pos ast.Pos)
    # After a problem the MIR may be inconsistent; it is never built.
    if problems.len() > fn_problems or fn_failed
        return
    func := simplify(fold(simplify(Func(
        name: name,
        params: blocks[0].params,
        ret: ret,
        blocks: blocks,
        vals: vals,
        names: names,
    ))))
    for err in verify(func)
        problems.push(Problem(
            rule: "native.build.2",
            pos: pos,
            message: "internal error: invalid MIR: {err}",
        ))
    funcs.push(func)

## The value as the type the context expects: an `int` literal already
## became a `float` where one was expected; anything else must match.
fn Lower.convert(mut self, v Val, want Ty, pos ast.Pos) int
    if want.opt_inner() != none and not v.ty.is_unknown()
        return convert_opt(v, want, pos)
    if want.is_unknown() or v.ty.is_unknown()
        # A type outside the subset, already reported.
        fn_failed = true
    elif not same_ty(v.ty, want)
        problem(pos, "expected `{want.name()}`, found `{v.ty.name()}`")
    v.id

fn same_ty(a Ty, b Ty) bool
    if p := a.opt_inner()
        q := b.opt_inner() else return false
        return same_ty(p, q) or p.is_unknown() or q.is_unknown()
    x := a.elem() else return a.name() == b.name()
    y := b.elem() else return false
    same_ty(x, y) or x.is_unknown() or y.is_unknown()

## Lower statements in a new scope. With `want`, a final expression
## statement is the block's value.
fn Lower.lower_block(mut self, body List[ast.Stmt], want bool) Val?
    tail := tail_want
    tail_want = none
    scopes.push(Map[str, str]())
    mut result := Val(id: -2, ty: Ty.Unit)
    for i in 0..body.len()
        s := body[i]
        if done()
            dead_block()
        if want and i == body.len() - 1
            if e := final_expr(s)
                if tail_error(e)
                    continue
                result = lower_expr(e, tail) else Val(id: -2, ty: Ty.Unit)
                continue
        lower_stmt(s)
    scopes.pop()
    if result.id == -2
        return none
    result

fn final_expr(s ast.Stmt) ast.Expr?
    match s
        Eval(e) => e
        _ => none

# ---- statements ----

## `n := s.to_int() else ...` (err.else.1-2): the parse, then the `else`
## when it fails, a fallback value or a statement that leaves.
fn Lower.lower_let_else(mut self, name str, pos ast.Pos, value ast.Expr, other ast.Else)
    if is_pop_call(value)
        got := lower_pop_else(value, other, pos) else
            declare(name, Ty.Unknown, -1)
            return
        declare(name, got.ty, got.id)
        return
    if self.is_get_call(value)
        got := lower_get_else(value, other, pos) else
            declare(name, Ty.Unknown, -1)
            return
        declare(name, got.ty, got.id)
        return
    recv := match value
        Method(r, m, _, margs) => if m == "to_int" and margs.len() == 0 then r else none
        _ => none
    if recv == none
        lower_bind_else(name, pos, value, other)
        return
    got := lower_str_to_int_else(recv?, other, pos) else
        declare(name, Ty.Unknown, -1)
        return
    declare(name, got.ty, got.id)

## An `else` fallback value, jumped to `join`; a fallback that leaves, such as
## `unreachable(...)` (err.model.2), ends the block and has no value to join.
fn Lower.fallback_jump(mut self, x ast.Expr, t Ty, join int, pos ast.Pos)
    v := lower_expr(x, t) else return
    if done()
        return
    if v.id < 0
        problem(expr_pos(x), "this expression has no value")
        return
    jump(join, [convert(v, t, pos)])

## The receiver of `s.to_int()` when `e` is that call.
fn str_to_int_recv(e ast.Expr) ast.Expr?
    match e
        Method(r, m, _, margs) => if m == "to_int" and margs.len() == 0 then r else none
        _ => none

## `s.to_int() else ...` (err.else.1-2) in any position: the parse, then the
## `else` when it fails, a fallback value or a statement that leaves.
fn Lower.lower_str_to_int_else(mut self, recv ast.Expr, other ast.Else, pos ast.Pos) Val?
    s := lower_value(recv, Ty.Str)?
    if not (s.ty == Ty.Str)
        problem(pos, "`.to_int()` on `{s.ty.name()}`")
        return none
    n := call("rt.str_to_int", [s.id], Ty.Int)
    ok := call("rt.parse_ok", [], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    fail := new_block()
    branch(ok, join, [n], fail, [])
    seal(fail)
    cur = fail
    match other
        Fallback(x) => fallback_jump(x, Ty.Int, join, pos)
        Leave(st) =>
            lower_stmt(st)
            if not done()
                problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(_, _, hpos) => problem(hpos, "`else` with a handler isn't in the native subset yet")
    seal(join)
    cur = join
    Val(id: r, ty: Ty.Int)

fn Lower.lower_stmt(mut self, s ast.Stmt)
    match s
        Let(name, pos, _, value, otherwise) =>
            if other := otherwise
                lower_let_else(name, pos, value, other)
                return
            v := lower_value(value, none) else
                # Reported; uses of the name stay quiet.
                declare(name, Ty.Unknown, -1)
                return
            declare(name, v.ty, copy_if_place(value, v))
        Assign(target, op, value, pos) => lower_assign(target, op, value, pos)
        While(cond, body, _) => lower_while(cond, body)
        For(_, var, _, mutable, iter, body, pos) =>
            if mutable
                problem(pos, "`for mut` isn't in the native subset yet")
                return
            lower_for(var, iter, body)
        Break(pos) =>
            if loops.len() == 0
                problem(pos, "`break` outside a loop")
                return
            jump(loops[loops.len() - 1].exit, [])
        Continue(pos) =>
            if loops.len() == 0
                problem(pos, "`continue` outside a loop")
                return
            jump(loops[loops.len() - 1].cont, [])
        Return(value, pos) =>
            if lower_fail_return(value, pos)
                return
            if e := value
                v := lower_value(e, ret) else return
                finish(return_of(copy_if_borrowed(e, Val(id: convert(v, ret, pos), ty: v.ty))))
            else
                finish(return_of(-1))
        Eval(e) =>
            lower_expr(e, Ty.Unit)
        Handle(value, other) => lower_handle(value, other)
        Defer(_, pos) => problem(pos, "`defer` isn't in the native subset yet")
        With(_, _, _, _, pos) => problem(pos, "`with` isn't in the native subset yet")
        Unsafe(_, pos) => problem(pos, "`unsafe` blocks aren't in the native subset yet")
        LetTuple(_, _, pos) => problem(pos, "tuples aren't in the native subset yet")

## A list read from a variable or an element is copied when it is bound
## or assigned, so the two stay independent (own.val.1, native-abi.md §4).
fn Lower.copy_if_place(mut self, e ast.Expr, v Val) int
    if v.ty.is_coll() and is_place(e)
        return copy_coll(v)
    if not needs_copy(v.ty) or not is_place(e)
        return v.id
    copy_value(v)

## A returned list or struct is copied when it belongs to someone else: a
## field, an element, a parameter or a `for` variable (own.val.1).
fn Lower.copy_if_borrowed(mut self, e ast.Expr, v Val) int
    if not needs_copy(v.ty)
        return v.id
    match e
        Member | Index => copy_value(v)
        Name(n, _) =>
            key := lookup(n) else return copy_value(v)
            if borrowed.contains(key) then copy_value(v) else v.id
        _ => v.id

## A copy of the list `v`, deep through nested lists (own.val.1).
fn Lower.copy_list(mut self, v Val) int
    mut depth := 0
    mut t := v.ty.elem() else Ty.Unknown
    while t.elem() != none
        depth += 1
        t = t.elem() else Ty.Unknown
    # A `List[bool]` holds bytes (native-abi.md §2).
    bytes := konst(if t == Ty.Bool then 1 else 8, Ty.Int)
    if depth == 0
        return call("rt.list_copy", [v.id, bytes], v.ty)
    call("rt.list_copy_deep", [v.id, konst(depth, Ty.Int), bytes], v.ty)

fn is_place(e ast.Expr) bool
    match e
        Name | Index | Member => true
        _ => false

fn Lower.lower_assign(mut self, target ast.Expr, op ast.BinOp?, value ast.Expr, pos ast.Pos)
    match target
        Name(name, npos) =>
            key := lookup(name) else
                k := self_slot(name)
                if k < 0
                    problem(npos, "unknown name `{name}`")
                    return
                assign_slot(self_value(), self_ty, k, op, value, pos)
                return
            ty := var_ty[key]
            mut v := -1
            if o := op
                old := Val(id: read_var(key, cur), ty: ty)
                r := lower_value(value, ty) else return
                v = binary(o, old, r, pos).id
            else
                r := lower_value(value, ty) else return
                ty2 := settle_var(target, ty, r)
                v = copy_if_place(value, Val(id: convert(r, ty2, pos), ty: ty2))
            write_var(key, cur, v)
        Index(recv, index, ipos) =>
            l := lower_value(recv, none) else return
            if l.ty.is_coll()
                lower_map_assign(l, index, op, value, pos, ipos)
                return
            elem := l.ty.elem() else
                problem(ipos, "indexing a `{l.ty.name()}` isn't in the native subset yet")
                return
            i := lower_value(index, Ty.Int) else return
            mut v := -1
            if o := op
                old := Val(id: checked("get", [l.id, i.id], bounds_site(ipos), elem), ty: elem)
                r := lower_value(value, elem) else return
                v = binary(o, old, r, pos).id
            else
                r := lower_value(value, elem) else return
                v = copy_if_place(value, Val(id: convert(r, elem, pos), ty: elem))
            mut set := inst(-1, "set", [l.id, i.id, v])
            set.site = bounds_site(ipos)
            emit_void(set)
        Member(recv, name, mpos) => assign_member(recv, name, op, value, mpos, pos)
        _ => problem(pos, "this assignment target isn't in the native subset yet")

fn Lower.bounds_site(mut self, pos ast.Pos) int
    site("type.coll.4", "bounds", "", pos)

fn Lower.lower_while(mut self, cond ast.Expr, body List[ast.Stmt])
    head := new_block()
    jump(head, [])
    cur = head
    forever := match cond
        Bool(v, _) => v
        _ => false
    inner := new_block()
    exit := new_block()
    if forever
        jump(inner, [])
    else
        c := lower_value(cond, Ty.Bool) else return
        branch(c.id, inner, [], exit, [])
    seal(inner)
    cur = inner
    loops.push(Loop(cont: head, exit: exit))
    lower_block(body, false)
    loops.pop()
    jump(head, [])
    seal(head)
    seal(exit)
    cur = exit
    # `while true` with no `break` never falls out (expr.loop.1).
    if forever and preds[exit].len() == 0
        finish(unreachable_term())

## `for x in a..b`, `a..=b` or a list (expr.loop.2-3). The index is a hidden
## variable; `continue` goes to the latch, which steps it.
fn Lower.lower_for(mut self, var str, iter ast.Expr, body List[ast.Stmt])
    scopes.push(Map[str, str]())
    mut lo := -1
    mut hi := -1
    mut inclusive := false
    mut list := -1
    mut elem := Ty.Int
    match iter
        Range(a, b, incl, rpos) =>
            if a == none or b == none
                problem(rpos, "a `for` over an open range isn't in the native subset")
                return
            x := lower_value(a else iter, Ty.Int) else return
            y := lower_value(b else iter, Ty.Int) else return
            lo = x.id
            hi = y.id
            inclusive = incl
        _ =>
            l0 := lower_value(iter, none) else return
            l := iter_coll(l0)
            e := l.ty.elem() else
                problem(
                    expr_pos(iter),
                    "a `for` over a `{l.ty.name()}` isn't in the native subset yet",
                )
                return
            elem = e
            list = l.id
            if mutates(body, iter) and l.id == l0.id
                list = copy_list(l)
            lo = konst(0, Ty.Int)
            hi = op("len", [list], Ty.Int)
    nvars += 1
    ikey := "#i{nvars}"
    var_ty[ikey] = Ty.Int
    write_var(ikey, cur, lo)
    head := new_block()
    jump(head, [])
    cur = head
    i := read_var(ikey, head)
    c := op(if inclusive then "le" else "lt", [i, hi], Ty.Bool)
    inner := new_block()
    exit := new_block()
    latch := new_block()
    branch(c, inner, [], exit, [])
    seal(inner)
    cur = inner
    if list >= 0
        declare(var, elem, op("get", [list, i], elem))
        borrowed.add(lookup(var) else "")
    else
        declare(var, Ty.Int, i)
    loops.push(Loop(cont: latch, exit: exit))
    lower_block(body, false)
    loops.pop()
    jump(latch, [])
    seal(latch)
    cur = latch
    j := read_var(ikey, latch)
    if inclusive
        # `i + 1` would overflow when `hi` is the largest `int`.
        last := op("eq", [j, hi], Ty.Bool)
        step := new_block()
        branch(last, exit, [], step, [])
        seal(step)
        cur = step
    write_var(ikey, cur, op("add", [j, konst(1, Ty.Int)], Ty.Int))
    jump(head, [])
    seal(head)
    seal(exit)
    cur = exit
    scopes.pop()

## Whether a loop body may change the list it iterates (so the loop needs
## a copy: `for x in xs` sees the list as it was, expr.loop.3).
fn mutates(body List[ast.Stmt], iter ast.Expr) bool
    name := match iter
        Name(n, _) => n
        _ => return false
    block_mutates(body, name)

fn block_mutates(body List[ast.Stmt], name str) bool
    for s in body
        if stmt_mutates(s, name)
            return true
    false

fn stmt_mutates(s ast.Stmt, name str) bool
    match s
        Let(_, _, _, value, _) => expr_mutates(value, name)
        Assign(target, _, value, _) => root_is(target, name) or expr_mutates(value, name)
        While(cond, body, _) => expr_mutates(cond, name) or block_mutates(body, name)
        For(_, _, _, _, it, body, _) => expr_mutates(it, name) or block_mutates(body, name)
        Return(v, _) =>
            e := v else return false
            expr_mutates(e, name)
        Eval(e) => expr_mutates(e, name)
        _ => true

fn root_is(e ast.Expr, name str) bool
    match e
        Name(n, _) => n == name
        Index(r, _, _) => root_is(r, name)
        Member(r, _, _) => root_is(r, name)
        _ => false

fn args_mutate(args List[ast.Arg], name str) bool
    for a in args
        if a.mutable and root_is(a.value, name) or expr_mutates(a.value, name)
            return true
    false

## Conservative: any method call on the list but `len`, or a `mut`
## argument naming it, counts as a change.
fn expr_mutates(e ast.Expr, name str) bool
    match e
        Method(recv, m, _, args) => root_is(recv, name) and m != "len"
            or args_mutate(args, name)
            or expr_mutates(recv, name)
        Call(_, args, _) => args_mutate(args, name)
        Binary(_, a, b, _) => expr_mutates(a, name) or expr_mutates(b, name)
        Unary(_, a, _) => expr_mutates(a, name)
        Index(r, i, _) => expr_mutates(r, name) or expr_mutates(i, name)
        If(branches, els, _, _) =>
            for b in branches
                c := match b.cond
                    Test(x) => x
                    Bind(_, _, x) => x
                if expr_mutates(c, name) or block_mutates(b.body, name)
                    return true
            body := els else return false
            block_mutates(body, name)
        Interp(parts, _) =>
            for p in parts
                x := match p
                    Hole(x) => x
                    Fmt(x, _) => x
                    Lit => continue
                if expr_mutates(x, name)
                    return true
            false
        ListLit(items, _) =>
            for x in items
                if expr_mutates(x, name)
                    return true
            false
        _ => false

# ---- expressions ----

## An expression that must have a value.
fn Lower.lower_value(mut self, e ast.Expr, want Ty?) Val?
    v := lower_expr(e, want)?
    if v.id < 0
        problem(expr_pos(e), "this expression has no value")
        return none
    v

## Lower an expression; `want` is the type the context expects, which lets
## an `int` literal stand for a `float` (type.num.10), and is `unit` for an
## expression statement. `none` after a problem.
fn Lower.lower_expr(mut self, e ast.Expr, want Ty?) Val?
    match e
        Int(text, pos) => lower_int_lit(text, pos, want)
        Float(x, _) => Val(id: fconst(x), ty: Ty.Float)
        Bool(b, _) => Val(id: konst(if b then 1 else 0, Ty.Bool), ty: Ty.Bool)
        Bytes(_, pos) => unsupported(pos, "`bytes` literals")
        Str(s, _) => Val(id: str_value(s), ty: Ty.Str)
        Name(name, pos) => lower_name(name, pos, want)
        Unary(o, operand, pos) => lower_unary(o, operand, pos, want)
        Binary(o, lhs, rhs, pos) => lower_binary_expr(o, lhs, rhs, pos, want)
        Call(callee, args, pos) => lower_call_expr(callee, args, pos, want)
        Method(recv, name, npos, args) => lower_method(recv, name, npos, args)
        Index(recv, index, pos) => lower_index(recv, index, pos)
        ListLit(items, pos) => lower_list(items, pos, want)
        If(branches, els, _, pos) => lower_if(branches, els, pos, want)
        Interp(parts, pos) => lower_interp_value(parts, pos)
        Char(text, _) => lower_char(text)
        NoneLit(pos) => lower_none(want, pos)
        Hole(pos) => unsupported(pos, "`todo`")
        TypeArgs(_, _, pos) => unsupported(pos, "this expression")
        Member(recv, name, pos) => lower_member_expr(recv, name, pos, e, want)
        Range(_, _, _, pos) => unsupported(pos, "a range outside `for`")
        MapLit(entries, pos) => lower_map_lit(entries, pos, want)
        SetLit(items, pos) => lower_set_lit(items, pos, want)
        Match(scrutinee, arms, pos) => lower_match(scrutinee, arms, pos, want)
        Try(x, context, pos) => lower_try(x, context, pos)
        Comp(form, elem, body_val, clauses, pos) => lower_comp(
            form,
            elem,
            body_val,
            clauses,
            pos,
            want,
        )
        OrElse(x, other, pos) => lower_or_else(x, other, pos)
        NewRef(_, pos) => unsupported(pos, "`ref`")
        TupleLit(_, pos) => unsupported(pos, "a tuple")

## An integer literal, as a `float` where one is wanted.
fn Lower.lower_int_lit(mut self, text str, pos ast.Pos, want Ty?) Val?
    n := text.to_int() else
        problem(pos, "integer literal `{text}` out of range")
        return none
    if wants_float(want)
        return Val(id: fconst(n.to_float()), ty: Ty.Float)
    Val(id: konst(n, Ty.Int), ty: Ty.Int)

## A name: a local, a constant, a field of `self`, a function, a global or a bare variant.
fn Lower.lower_name(mut self, name str, pos ast.Pos, want Ty?) Val?
    key := lookup(name) else
        if consts.contains("{prefix}{name}")
            return lower_const("{prefix}{name}", want)
        k := self_slot(name)
        if k >= 0
            t := structs[self_ty][k].ty
            return Val(id: load(self_value(), k, t), ty: t)
        if v := fn_value(name)
            return v
        if globals.contains("{prefix}{name}")
            return global_const("{prefix}{name}")
        if v := bare_variant(name, want)
            return new_variant(v, none, pos)
        problem(
            pos,
            "`{name}` isn't in the native subset yet (only locals, parameters and constants)",
        )
        return none
    if var_ty[key].is_unknown()
        fn_failed = true
        return none
    Val(id: read_var(key, cur), ty: var_ty[key])

## A call `f(...)`, or a variant built by calling it.
fn Lower.lower_call_expr(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos, want Ty?) Val?
    if v := call_variant(callee, want)
        return new_variant(v, args, pos)
    lower_call(callee, args, pos)

fn Lower.unsupported(mut self, pos ast.Pos, what str) Val?
    problem(pos, "not in the native subset yet: {what}")
    none

fn is_range(e ast.Expr) bool
    match e
        Range => true
        _ => false

## `if`, as a statement or a value (expr.if.1-4). The arms of a value `if`
## pass their results to the join block's first parameter.
fn Lower.lower_if(
    mut self,
    branches List[ast.Branch],
    els List[ast.Stmt]?,
    pos ast.Pos,
    want Ty?,
) Val?
    join := new_block()
    value := els != none and want_value(want)
    mut result := -1
    mut rty := Ty.Unknown
    if value
        result = new_value(Ty.Unknown, "")
        blocks[join].params.push(result)
        rty = arms_start(want, [br.body for br in branches], els)
    for br in branches
        mut bound := ""
        mut bval := Val(id: -1, ty: Ty.Unit)
        c := match br.cond
            Test(x) => lower_value(x, Ty.Bool)?
            Bind(bname, bpos, x) =>
                o := lower_value(x, none)?
                if o.ty.opt_inner() == none
                    return unsupported(bpos, "`if {bname} := e` on a `{o.ty.name()}`")
                bound = bname
                bval = o
                Val(id: op("ne", [o.id, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
        yes := new_block()
        no := new_block()
        branch(c.id, yes, [], no, [])
        seal(yes)
        seal(no)
        cur = yes
        scopes.push(Map[str, str]())
        if bound != ""
            u := unwrap(bval)
            declare(bound, u.ty, u.id)
        tail_want = if value and not rty.is_unknown() then rty else none
        v := lower_block(br.body, value)
        scopes.pop()
        rty = arm_end(join, value, v, pos, rty)
        cur = no
    if body := els
        tail_want = if value and not rty.is_unknown() then rty else none
        v := lower_block(body, value)
        rty = arm_end(join, value, v, pos, rty)
    else
        jump(join, [])
    seal(join)
    cur = join
    if value
        vals[result] = rty
        return Val(id: result, ty: rty)
    Val(id: -1, ty: Ty.Unit)

## A statement-level `if` is lowered with `want` unit.
fn want_value(want Ty?) bool
    w := want else return true
    not w.is_unit()

## Finish an arm of an `if`; gives the `if`'s type as known so far.
fn Lower.arm_end(mut self, join int, value bool, v Val?, pos ast.Pos, rty Ty) Ty
    if done()
        return rty
    if not value
        jump(join, [])
        return rty
    x := v else
        if not failing()
            problem(pos, "this `if` needs a value in every branch")
        jump(join, [])
        return rty
    mut t := rty
    if t.is_unknown() or is_pending_opt(t)
        t = settle_arm_ty(t, x.ty)
    jump(join, [convert(x, t, pos)])
    t

fn Lower.lower_list(mut self, items List[ast.Expr], pos ast.Pos, want Ty?) Val?
    mut elem := Ty.Unknown
    if w := want
        elem = w.elem() else Ty.Unknown
    n := konst(items.len(), Ty.Int)
    mut vs := List[int]()
    for x in items
        v := lower_value(x, if elem.is_unknown() then none else elem)?
        if elem.is_unknown()
            elem = v.ty
        if not is_number(elem) and elem != Ty.Str and not needs_copy(elem) and not is_enum(elem)
            return unsupported(pos, "a list of `{elem.name()}`")
        vs.push(convert(Val(id: copy_if_place(x, v), ty: v.ty), elem, pos))
    l := call("rt.list_new", [n], Ty.List(elem))
    for v in vs
        call(push_fn(elem), [l, v], Ty.Unit)
    Val(id: l, ty: Ty.List(elem))

fn push_fn(elem Ty) str
    match elem
        Float => "rt.list_pushf"
        Bool => "rt.list_pushb"
        _ => "rt.list_push"

fn Lower.lower_call(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos) Val?
    match callee
        Name(name, npos) =>
            if name == "print" and not is_rt
                return lower_print(args, pos)
            if is_rt and PRIMS.contains(name)
                return lower_prim(name, args)
            if name == "unreachable" and not is_rt and lookup(name) == none
                return lower_unreachable(args, pos)
            if k := lookup(name)
                return call_value(Val(id: read_var(k, cur), ty: var_ty[k]), args, pos)
            if lookup(name) == none
                if k := type_key(name)
                    return new_struct(k, args, pos)
            if self_ty != "" and sigs.contains("{self_ty}.{name}")
                return struct_call(
                    "{self_ty}.{name}",
                    Val(id: self_value(), ty: owner_ty(self_ty)),
                    args,
                    pos,
                )
            if self_ty != "" and bad.contains("{self_ty}.{name}")
                fn_failed = true
                return none
            key := "{prefix}{name}"
            if bad.contains(key)
                fn_failed = true
                return none
            sig := sigs.get(key) else return unsupported(npos, "calling `{name}`")
            if args.len() != sig.params.len()
                return unsupported(pos, "this call")
            mut vs := List[int]()
            for i in 0..args.len()
                a := args[i]
                if a.label != none
                    return unsupported(pos, "labelled arguments")
                v := lower_value(a.value, sig.params[i])?
                vs.push(convert(v, sig.params[i], expr_pos(a.value)))
            Val(id: call(key, vs, sig.ret), ty: sig.ret)
        Member =>
            if k := type_name(callee)
                return new_struct(k, args, pos)
            unsupported(pos, "this call")
        TypeArgs(name, targs, tpos) =>
            if (name == "Map" or name == "Set") and args.len() == 0
                return coll_ctor(name, targs, tpos)
            if name == "List" and targs.len() == 1 and args.len() == 0
                t := type_of(ast.TypeRef(shape: Named("List", targs), pos: tpos)) else
                    return unsupported(tpos, "this list type")
                return Val(id: call("rt.list_new", [konst(0, Ty.Int)], t), ty: t)
            unsupported(tpos, "`{name}[...]`")
        _ =>
            f := lower_value(callee, none)?
            call_value(f, args, pos)

fn Lower.lower_prim(mut self, name str, args List[ast.Arg]) Val?
    mut vs := List[int]()
    for a in args
        v := lower_value(a.value, none)?
        vs.push(v.id)
    t := match PRIMS[name]
        "int" => Ty.Int
        "float" => Ty.Float
        "list" => Ty.List(Ty.Int)
        "str" => Ty.Str
        _ => Ty.Unit
    mut i := inst(-1, "prim", vs)
    i.name = name
    if t.is_unit()
        emit_void(i)
        return Val(id: -1, ty: t)
    Val(id: emit(i, t), ty: t)

## `print(x)`: a number, `bool`, string literal, list of numbers, or an
## interpolation of those (17-std, native-abi.md §8).
fn Lower.lower_print(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1
        return unsupported(pos, "this `print`")
    match args[0].value
        Interp(parts, ipos) =>
            for p in parts
                match p
                    Lit(text) => call("rt.out_str", [str_value(text)], Ty.Unit)
                    Hole(x) =>
                        v := lower_value(x, none)?
                        out(v, ipos)?
                    Fmt(x, spec) =>
                        v := lower_value(x, none)?
                        lower_fmt_print(v, spec, ipos)?
        _ =>
            v := lower_value(args[0].value, none)?
            out(v, pos)?
    call("rt.out_nl", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

fn out_fn(t Ty) str
    match t
        Int => "rt.out_int"
        Float => "rt.out_float"
        Bool => "rt.out_bool"
        Str => "rt.out_str"
        Char => "rt.out_char"
        Tensor(_) => "rt.out_tensor"
        List(e) =>
            match e
                Int => "rt.out_list_int"
                Float => "rt.out_list_float"
                Bool => "rt.out_list_bool"
                # Lists of strings and of lists: `rt.out_list_deep`.
                _ => ""
        _ => ""

fn Lower.out(mut self, v Val, pos ast.Pos) Val?
    if v.ty.is_coll()
        return out_coll(v, pos)
    if e := v.ty.elem()
        mut depth := 0
        mut leaf := e
        while leaf.elem() != none
            depth += 1
            leaf = leaf.elem() else Ty.Unknown
        k := match leaf
            Int => 0
            Float => 1
            Bool => 2
            Str => 3
            Char => 4
            _ => -1
        if k >= 0 and (depth > 0 or k >= 3)
            call("rt.out_list_deep", [v.id, konst(depth, Ty.Int), konst(k, Ty.Int)], Ty.Unit)
            return Val(id: -1, ty: Ty.Unit)
    if s := display_call(v)
        call("rt.out_str", [s], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    f := out_fn(v.ty)
    if f == ""
        return unsupported(pos, "printing a `{v.ty.name()}`")
    call(f, [v.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

fn Lower.lower_method(mut self, recv ast.Expr, name str, npos ast.Pos, args List[ast.Arg]) Val?
    # std.env.1
    if name == "args" and args.len() == 0 and is_module(recv, "env")
        t := Ty.List(Ty.Str)
        return Val(id: call("rt.args", [], t), ty: t)
    om := os_module(recv)
    if om != ""
        return lower_os_method(om, name, npos, args)
    if name == "from_code" and is_module(recv, "char")
        return lower_char_from_code(args, npos)
    if name == "from" and is_module(recv, "tensor")
        return lower_tensor_from(args, npos)
    if is_module(recv, "mem")
        problems.push(Problem(
            rule: "ffi.native.1",
            pos: npos,
            message: "`mem.{name}`: `ail build` can't link the C allocator yet (`ail run` can)",
        ))
        return none
    if en := enum_ref(recv)
        if case_index(en, name) >= 0
            return new_variant(VariantRef(en: en, k: case_index(en, name)), args, npos)
        return struct_call("{en}.{name}", none, args, npos)
    if n := type_name(recv)
        return struct_call("{n}.{name}", none, args, npos)
    if m := module_name(recv)
        if structs.contains("{m}.{name}")
            return new_struct("{m}.{name}", args, npos)
        return struct_call("{m}.{name}", none, args, npos)
    r := lower_value(recv, none)?
    if is_sorting(name, args) and r.ty.elem() != none
        return lower_sorted(r, name, args, npos)
    if r.ty.is_coll()
        return lower_coll_method(r, name, npos, args)
    if r.ty.is_tensor()
        return lower_tensor_method(r, name, npos, args)
    if s := struct_name(r.ty)
        return struct_call("{s}.{name}", r, args, npos)
    if s := enum_name(r.ty)
        return struct_call("{s}.{name}", r, args, npos)
    mut vs := List[Val]()
    for a in args
        if a.label != none or a.mutable
            return unsupported(npos, "this method call")
        mut arg_want := r.ty
        if e := r.ty.elem()
            arg_want = if name == "push" then e else Ty.Int
            if name == "join"
                arg_want = Ty.Str
        vs.push(lower_value(a.value, if arg_want.is_unknown() then none else arg_want)?)
    if name == "to_str" and vs.len() == 0
        # type.str.3
        text := text_of(r, npos)?
        return Val(id: text, ty: Ty.Str)
    match r.ty
        Int =>
            if name == "to_float" and vs.len() == 0
                return Val(id: op("itof", [r.id], Ty.Float), ty: Ty.Float)
            if name == "abs" and vs.len() == 0
                return Val(id: int_abs(r.id, npos), ty: Ty.Int)
            if name == "cmp" and vs.len() == 1 and vs[0].ty == Ty.Int and enums.contains("Ordering")
                return ordering(call("rt.int_cmp", [r.id, vs[0].id], Ty.Int))
            if (name == "min" or name == "max") and vs.len() == 1
                return Val(id: int_minmax(name, r.id, vs[0].id), ty: Ty.Int)
            # expr.bit.1-2
            if BIT_OPS.contains(name) and vs.len() == 1
                mut s := -1
                if name == "shl" or name == "shr"
                    s = site("expr.bit.2", "shift", name, npos)
                return Val(id: checked(BIT_OPS[name], [r.id, vs[0].id], s, Ty.Int), ty: Ty.Int)
            if name == "bit_not" and vs.len() == 0
                return Val(id: op("bnot", [r.id], Ty.Int), ty: Ty.Int)
        Float =>
            if name == "to_int" and vs.len() == 0
                s := site("type.num.9", "float_int", "", npos)
                return Val(id: checked("ftoi", [r.id], s, Ty.Int), ty: Ty.Int)
            if (name == "sqrt" or name == "abs" or name == "floor" or name == "ceil")
                and vs.len() == 0
                return Val(id: op(name, [r.id], Ty.Float), ty: Ty.Float)
            if name == "cmp"
                and vs.len() == 1
                and vs[0].ty == Ty.Float
                and enums.contains("Ordering")
                return ordering(call("rt.float_cmp", [r.id, vs[0].id], Ty.Int))
            # type.num.9
            if name == "round" and vs.len() == 0
                return Val(id: call("rt.float_round", [r.id], Ty.Float), ty: Ty.Float)
            # type.num.16: std.math's float functions, in rt/native/math.ail
            if MATH1.contains(name) and vs.len() == 0
                return Val(id: call("rt.float_{name}", [r.id], Ty.Float), ty: Ty.Float)
            if MATH2.contains(name) and vs.len() == 1
                return Val(id: call("rt.float_{name}", [r.id, vs[0].id], Ty.Float), ty: Ty.Float)
        Str =>
            if name == "to_float" and vs.len() == 0
                return lower_to_float(r)
            return lower_str_method(r, name, npos, vs)
        Int => return int_method(r, name, npos, vs)
        Float => return float_method(r, name, npos, vs)
        Str => return str_method(r, name, npos, vs)
        Char => return lower_char_method(r, name, npos, vs)
        List(e) => return list_method(e, r, name, npos, vs, args, recv)
        _ => return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## The struct `e` names, when it names one and no local: `T.f(...)`.
fn Lower.type_name(self, e ast.Expr) str?
    match e
        Name(n, _) => if lookup(n) == none then type_key(n) else none
        Member =>
            p := path_of(e)?
            type_key(p)
        _ => none

## The import path of the module `e` names in this file, if it names one.
fn Lower.module_name(self, e ast.Expr) str?
    match e
        Name(n, _) => module_of(n)
        _ => none

## Whether `e` names module `m` (not a local of that name).
fn Lower.is_module(self, e ast.Expr, m str) bool
    match e
        Name(n, _) => n == m and lookup(n) == none
        _ => false

## An empty list typed by its first `push` (type.coll.6): the variable takes
## the element type from here on.
fn Lower.retype(mut self, recv ast.Expr, t Ty)
    n := match recv
        Name(n, _) => n
        _ => return
    key := lookup(n) else return
    var_ty[key] = t
    for v in var_vals[key]
        vals[v] = t

fn Lower.int_abs(mut self, a int, pos ast.Pos) int
    # |a| is `-a` when `a < 0`, which traps on the smallest `int` (expr.arith.1).
    neg := op("lt", [a, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    yes := new_block()
    branch(neg, yes, [], join, [a])
    seal(yes)
    cur = yes
    jump(join, [checked("neg", [a], site("expr.arith.1", "abs", "abs", pos), Ty.Int)])
    seal(join)
    cur = join
    r

## The `Ordering` value of index `k`, as `rt.int_cmp` returns it.
fn Lower.ordering(mut self, k int) Val
    t := Ty.Enum("Ordering")
    Val(id: op("copy", [k], t), ty: t)

fn Lower.int_minmax(mut self, name str, a int, b int) int
    pick_a := op(if name == "min" then "le" else "ge", [a, b], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    other := new_block()
    branch(pick_a, join, [a], other, [])
    seal(other)
    cur = other
    jump(join, [b])
    seal(join)
    cur = join
    r

pub fn expr_pos(e ast.Expr) ast.Pos
    match e
        Str(_, p) => p
        Bytes(_, p) => p
        Interp(_, p) => p
        Int(_, p) => p
        Float(_, p) => p
        Char(_, p) => p
        Bool(_, p) => p
        NoneLit(p) => p
        Hole(p) => p
        Name(_, p) => p
        TypeArgs(_, _, p) => p
        ListLit(_, p) => p
        Call(_, _, p) => p
        Method(_, _, p, _) => p
        Member(_, _, p) => p
        Index(_, _, p) => p
        Unary(_, _, p) => p
        Binary(_, _, _, p) => p
        Range(_, _, _, p) => p
        MapLit(_, p) => p
        SetLit(_, p) => p
        If(_, _, _, p) => p
        Match(_, _, p) => p
        Try(_, _, p) => p
        Comp(_, _, _, _, p) => p
        OrElse(_, _, p) => p
        NewRef(_, p) => p
        TupleLit(_, p) => p
