## Contracts (contract.req.1, contract.ens.1-3, contract.run.1-2, ADR 0612).
## A `requires` is checked in the caller, just before the call, so a failure
## traps at the call; the condition is lowered there with the parameters
## bound to the arguments. An `ensures` is checked in the function, at each
## return, with `result` and the `old(e)` values taken on entry. A failed
## check writes the interpreter's message piece by piece with the `out_*`
## functions between `rt.trap_begin` and `rt.trap_end`.
##
## A condition calls functions without checking their contracts
## (contract.run.2): it calls their `.nc` copies, which are lowered with no
## checks and call `.nc` copies in turn (`gen_unchecked`).
##
## A check the prover settled (contract.prove.1, ADR 1055, `compiler/check/prove.ail`) is
## left out, except under `--trace` and with `AIL_OPT_OFF=prove`.
use ast
use check

## A name and the variable key it stands for.
struct NameKey
    name str
    key str

## What impl methods inherit from the trait's methods (contract.inh.1-3): the trait method
## and its name, by the impl method's key, and the trait's `ensures` of the method being lowered.
struct Inherit
    of Map[str, ast.FnDecl]
    label Map[str, str]
    ens_from ast.FnDecl?
    ens_n int
    ens_origin str

## Record that `f` (declared in `prog`) inherits the contracts of its trait's method of the
## same name (contract.inh.1). The source is read without `link_contracts`, so find it here.
@allow("expr.match.3") fn Lower.note_inherited(mut self, f ast.FnDecl, prog ast.Program, pre str)
    k := match f.within
        InImpl(i) => i
        _ => return
    key := fn_key(f, pre)
    for t in prog.traits
        if t.name != prog.impls[k].trait_name
            continue
        for m in t.methods
            tf := prog.fns[m]
            if tf.name == f.name and tf.contracts.len() > 0
                inh.label[key] = "{t.name}.{tf.name}"
                inh.of[key] = tf
                contracted[key] = f
                return

# ---- proved contracts ----

## The contracts proved in each file, by file index, computed the first time a check there asks.
struct ProofCache
    done Map[int, check.Proofs]

## Whether proved checks may be left out: not under `--trace`, whose contract events would
## change, nor with `AIL_OPT_OFF=prove`, which keeps every check to compare against.
fn Lower.proving(self) bool
    not instr.trace and not is_rt and not opt_off("prove")

fn Lower.proofs_here(mut self) check.Proofs
    if p := proofs.done.get(file)
        return p
    mut fns := List[ast.FnDecl]()
    for k in fn_decl.keys()
        if (fn_file.get(k) else -1) == file
            fns.push(fn_decl[k])
    found := check.prove_fns(fns)
    proofs.done[file] = found
    found

## contract.prove.1: the `requires` `c` of `key` holds at the call at `pos`, so it isn't checked.
fn Lower.req_proved(mut self, key str, c ast.Contract, pos ast.Pos) bool
    if not proving() or (fn_file.get(key) else -1) != file or inh.of.contains(key)
        return false
    f := fn_decl.get(key) else return false
    proofs_here().req.contains(check.site_key(f.name, pos, c.pos))

## contract.prove.1: the `ensures` `c` of the function being lowered holds at every return.
fn Lower.ens_proved(mut self, c ast.Contract) bool
    if not proving() or (fn_file.get(ens_label) else -1) != file
        return false
    f := fn_decl.get(ens_label) else return false
    proofs_here().ens.contains(check.ens_key(f.name, c.pos))

# ---- positions ----

## Where `e` starts, as the interpreter reports it.
fn start_pos(e ast.Expr) ast.Pos
    match e
        Call(c, _, _) => start_pos(c)
        Method(r, _, _, _) => start_pos(r)
        Member(r, _, _) => start_pos(r)
        Index(r, _, _) => start_pos(r)
        Binary(_, l, _, _) => start_pos(l)
        Try(x, _, _) => start_pos(x)
        OrElse(x, _, _) => start_pos(x)
        Range(lo, _, _, p) =>
            if x := lo
                return start_pos(x)
            p
        _ => expr_pos(e)

fn stmt_start(s ast.Stmt) ast.Pos
    match s
        Let(_, p, _, _, _) => p
        Assign(t, _, _, _) => start_pos(t)
        While(_, _, p) => p
        For(_, _, _, _, _, _, p) => p
        Break(p) => p
        Continue(p) => p
        Return(_, p) => p
        Eval(e) => start_pos(e)
        Handle(v, _) => start_pos(v)
        Defer(_, p) => p
        With(_, _, _, _, p) => p
        Unsafe(_, p) => p
        LetTuple(_, _, p) => p
        Select(_, p) => p

## Where a function falling off its end returns: its last statement.
fn tail_pos(f ast.FnDecl, body List[ast.Stmt]) ast.Pos
    if body.len() == 0
        return f.pos
    stmt_start(body[body.len() - 1])

# ---- unchecked copies ----

## The function a call in the current code goes to: itself, or its `.nc`
## copy inside a condition (contract.run.2).
fn Lower.contract_key(mut self, key str) str
    if not unchecked or key.starts_with("rt.") or key.starts_with("copy.")
        return key
    if not fn_decl.contains(key)
        return key
    if not unchecked_seen.contains(key)
        unchecked_seen.add(key)
        unchecked_list.push(key)
        sigs["{key}.nc"] = sigs[key]
    "{key}.nc"

## Lower the `.nc` copies asked for, and those they ask for. Their problems
## are the originals', already reported.
fn Lower.gen_unchecked(mut self)
    mut i := 0
    while i < unchecked_list.len()
        key := unchecked_list[i]
        i += 1
        f := fn_decl.get(key) else continue
        enter_file(fn_file[key])
        before := problems.len()
        unchecked = true
        lower_fn_as(f, "{key}.nc", key, fn_owner(f))
        unchecked = false
        stamp_problems()
        while problems.len() > before
            problems.pop()
            problem_files.pop()

# ---- messages ----

fn Lower.say(mut self, s str)
    call("rt.out_str", [str_value(s)], Ty.Unit)

## The text form of `v` in a message: what `describe` shows.
fn Lower.describe(mut self, v Val, pos ast.Pos)
    match v.ty
        Str => call("rt.out_quoted", [v.id], Ty.Unit)
        Struct(n) =>
            slots := structs[n]
            say("{n}(")
            for k in 0..slots.len()
                if k > 0
                    say(", ")
                say("{slots[k].name}: ")
                describe(Val(id: load(v.id, k, slots[k].ty), ty: slots[k].ty), pos)
            say(")")
        _ => out(v, pos)

## `a = 7, b = 0`: the receiver and parameters with their values.
fn Lower.describe_args(mut self, args List[NameKey], pos ast.Pos)
    if args.len() == 0
        say("no arguments")
        return
    for k in 0..args.len()
        if k > 0
            say(", ")
        say("{args[k].name} = ")
        describe(Val(id: read_var(args[k].key, cur), ty: var_ty[args[k].key]), pos)

## Start a contract trap: the head line is written, the message follows.
fn Lower.trap_open(mut self, rule str, pos ast.Pos)
    head := "{src_paths[file]}:{pos.line}:{pos.col}: trap[{rule}]: "
    call("rt.trap_begin", [str_value(head)], Ty.Unit)

## Finish it: the source excerpt, then exit.
fn Lower.trap_close(mut self, pos ast.Pos)
    src := src_lines[file]
    line := if pos.line >= 1 and pos.line <= src.len() then src[pos.line - 1] else ""
    call("rt.trap_end", [str_value("{excerpt(line, pos.line, pos.col)}{trap_frame(pos)}")], Ty.Unit)
    finish(unreachable_term())

## `trap_close` for `--values` (trace.frame.3): after the excerpt, `  values: a = 1, b = 2`, the
## arguments the condition `text` names, in name order.
fn Lower.trap_close_values(mut self, pos ast.Pos, text str, args List[NameKey])
    mut named := List[NameKey]()
    for a in args
        if word_in(text, a.name)
            mut at := named.len()
            while at > 0 and named[at - 1].name > a.name
                at -= 1
            named.insert(at, a)
    trap_close_listed(pos, [a.name for a in named], named)

## `trap_close_values` with the values given: `labels[k]` names the value of `keys[k]`.
fn Lower.trap_close_listed(mut self, pos ast.Pos, labels List[str], keys List[NameKey])
    src := src_lines[file]
    line := if pos.line >= 1 and pos.line <= src.len() then src[pos.line - 1] else ""
    call("rt.out_byte", [konst(10, Ty.Int)], Ty.Unit)
    call("rt.out_str", [str_value(excerpt(line, pos.line, pos.col))], Ty.Unit)
    mut extra := 0
    if keys.len() > 0
        say("  values: ")
        for k in 0..keys.len()
            if k > 0
                say(", ")
            say("{labels[k]} = ")
            describe(Val(id: read_var(keys[k].key, cur), ty: var_ty[keys[k].key]), pos)
        say("\n")
        extra = 1
    call("rt.trap_rest", [str_value(trap_frame(pos)), konst(extra, Ty.Int)], Ty.Unit)
    finish(unreachable_term())

## The `old(..)` texts of a condition, in the order they are written.
fn old_texts(text str) List[str]
    mut out := List[str]()
    parts := text.split("old(")
    for i in 1..parts.len()
        mut depth := 1
        mut inner := ""
        for c in parts[i].chars()
            if c == '('
                depth += 1
            elif c == ')'
                depth -= 1
            if depth == 0
                break
            inner = "{inner}{c}"
        out.push("old({inner})")
    out

## The values a failed `ensures` shows with `--values`, as the interpreter does: `self` when the
## condition reads one of its fields, then each `old(..)`, the arguments it names, then `result`.
fn Lower.ens_values(mut self, c ast.Contract)(List[str], List[NameKey])
    mut labels := List[str]()
    mut keys := List[NameKey]()
    first := if ens_vars.len() > 0 and ens_vars[0].name == "self" then 1 else 0
    if first == 1
        mut mentioned := word_in(c.text, "self")
        if slots := structs.get(self_ty)
            for sl in slots
                if word_in(c.text, sl.name)
                    mentioned = true
        if mentioned
            labels.push("self")
            keys.push(ens_vars[0])
    texts := old_texts(c.text)
    for j in 0..c.olds.len()
        for v in ens_vars
            if v.name == c.olds[j].name
                labels.push(if texts.len() == c.olds.len() then texts[j] else v.name)
                keys.push(v)
    for k in first..ens_nargs
        if word_in(c.text, ens_vars[k].name)
            labels.push(ens_vars[k].name)
            keys.push(ens_vars[k])
    if word_in(c.text, "result")
        if rk := scopes[0].get("result")
            labels.push("result")
            keys.push(NameKey(name: "result", key: rk))
    (labels, keys)

## Whether `w` is a whole word of `text`.
fn word_in(text str, w str) bool
    mut cur := ""
    for c in "{text} ".chars()
        if c == '_' or c.is_alnum()
            cur = "{cur}{c}"
        else
            if cur == w
                return true
            cur = ""
    false

## Branch on `cond`: the current block continues when it holds; the
## returned block is the failure, which the caller fills and ends.
fn Lower.check_branch(mut self, cond int) int
    ok := new_block()
    fail := new_block()
    branch(cond, ok, [], fail, [])
    seal(ok)
    seal(fail)
    cur = fail
    ok

# ---- requires ----

## `c`'s condition, lowered in the callee's module under the names bound in `scope`.
fn Lower.req_cond(
    mut self,
    c ast.Contract,
    scope List[Map[str, str]],
    callee_file int,
    caller_file int,
) Val?
    scopes = scope
    if callee_file != caller_file
        enter_file(callee_file)
    v := lower_value(c.cond, Ty.Bool)
    if callee_file != caller_file
        enter_file(caller_file)
    v

## The trap of a `requires` that failed: `label` is the function, `origin` says where an
## inherited condition came from, `also` that the function's own lines failed too.
fn Lower.req_trap(
    mut self,
    c ast.Contract,
    label str,
    origin str,
    also bool,
    args List[NameKey],
    pos ast.Pos,
    callee_file int,
    caller_file int,
)
    trace_contract(label, "requires", c, konst(0, Ty.Bool))
    trap_open("contract.req.1", pos)
    say("`{label}` requires `{c.text}`{origin}, but it was called with ")
    describe_args(args, pos)
    if also
        say(", and neither do its own `requires` lines")
    where := if callee_file != caller_file then "{src_paths[callee_file]}:" else ""
    say(" (contract at {where}{c.pos.line}:{c.pos.col})")
    if instr.vals
        trap_close_values(pos, c.text, args)
        return
    trap_close(pos)

## contract.req.1: before a call of `key` with the arguments `args_v`, each
## `requires` holds, or the program traps at the call, `pos`. An implementation's own
## lines weaken the trait's (contract.inh.1): the call is fine when all of the
## trait's hold or all of its own do.
fn Lower.check_requires(mut self, key str, args_v List[int], pos ast.Pos)
    if unchecked or instr.nocontracts or any_requires(key, args_v, pos)
        return
    f := contracted.get(key) else return
    mut reqs := List[ast.Contract]()
    for c in f.contracts
        if not c.is_ensures and not req_proved(key, c, pos)
            reqs.push(c)
    mut theirs := List[ast.Contract]()
    tf := inh.of.get(key)
    if t := tf
        for c in t.contracts
            if not c.is_ensures
                theirs.push(c)
    if reqs.len() == 0 and theirs.len() == 0
        return
    callee_file := fn_file[key]
    caller_file := file
    sig := sigs[key]
    saved := scopes
    saved_self := self_ty
    scopes = [Map[str, str]()]
    self_ty = ""
    mut args := List[NameKey]()
    mut k := 0
    if f.owner != none and f.receiver != none
        self_ty = struct_name(sig.params[0]) else ""
        declare("self", sig.params[0], args_v[0])
        args.push(NameKey(name: "self", key: lookup("self") else ""))
        k = 1
    for i in 0..f.params.len()
        declare(f.params[i].name, sig.params[k + i], args_v[k + i])
        args.push(NameKey(name: f.params[i].name, key: lookup(f.params[i].name) else ""))
    own_scope := scopes
    # The trait method's parameter names, for its conditions (contract.inh.3).
    mut their_scope := own_scope
    if t := tf
        their_scope = [Map[str, str]()]
        scopes = their_scope
        if t.receiver != none and k == 1
            declare("self", sig.params[0], args_v[0])
        for i in 0..t.params.len()
            declare(t.params[i].name, sig.params[k + i], args_v[k + i])
        their_scope = scopes
    label := inh.label.get(key) else key
    origin := " (inherited from `{label}`)"
    unchecked = true
    if reqs.len() > 0 and theirs.len() > 0
        pass := new_block()
        for c in theirs
            v := req_cond(c, their_scope, callee_file, caller_file) else break
            ok := check_branch(v.id)
            for oc in reqs
                w := req_cond(oc, own_scope, callee_file, caller_file) else break
                held := check_branch(w.id)
                req_trap(c, key, origin, true, args, pos, callee_file, caller_file)
                cur = held
            jump(pass, [])
            cur = ok
        jump(pass, [])
        seal(pass)
        cur = pass
    else
        for c in theirs
            v := req_cond(c, their_scope, callee_file, caller_file) else break
            ok := check_branch(v.id)
            req_trap(c, key, origin, false, args, pos, callee_file, caller_file)
            cur = ok
        for c in reqs
            v := req_cond(c, own_scope, callee_file, caller_file) else break
            ok := check_branch(v.id)
            req_trap(c, key, "", false, args, pos, callee_file, caller_file)
            cur = ok
    unchecked = false
    scopes = saved
    self_ty = saved_self

## The `requires` of `f` that held, traced on entry so they follow the call event:
## the checks themselves run at the call site, and a failing one traps there.
fn Lower.trace_requires(mut self, f ast.FnDecl, key str)
    if instr.nocontracts
        return
    unchecked = true
    for c in f.contracts
        if not c.is_ensures
            v := lower_value(c.cond, Ty.Bool) else continue
            trace_contract(key, "requires", c, v.id)
    unchecked = false

# ---- ensures ----

## On entry to `f`: take the `old(e)` values of its `ensures` lines
## (contract.ens.3) and remember what the checks at each return need.
fn Lower.enter_contracts(mut self, f ast.FnDecl, key str)
    if instr.nocontracts
        return
    if r := f.receiver
        if r.mutable and self_ty != "" and invariants.contains(self_ty)
            inv_key = self_ty
            ens_label = key
            ens_vars = []
    mut list := List[ast.Contract]()
    inh.ens_n = 0
    inh.ens_from = inh.of.get(key)
    if t := inh.ens_from
        inh.ens_origin = " (inherited from `{inh.label.get(key) else key}`)"
        for c in t.contracts
            if c.is_ensures
                if c.olds.len() > 0
                    problem(
                        c.pos,
                        "`old(..)` in an inherited `ensures` isn't in the native subset yet",
                    )
                list.push(c)
        inh.ens_n = list.len()
    for c in f.contracts
        if c.is_ensures
            list.push(c)
    if list.len() == 0
        return
    ens = list
    ens_label = key
    ens_vars = []
    if f.owner != none and f.receiver != none
        ens_vars.push(NameKey(name: "self", key: lookup("self") else ""))
    for p in f.params
        ens_vars.push(NameKey(name: p.name, key: lookup(p.name) else ""))
    ens_nargs = ens_vars.len()
    unchecked = true
    for c in list
        for o in c.olds
            v := lower_value(o.value, none) else continue
            declare(o.name, v.ty, copy_if_place(o.value, v))
            ens_vars.push(NameKey(name: o.name, key: lookup(o.name) else ""))
    unchecked = false

## contract.ens.1: at a return of `rv` (-1 for none) at `at`, each
## `ensures` holds, or the program traps at its line.
fn Lower.check_ensures(mut self, rv int, at ast.Pos)
    # The return value is computed; the `defer`red statements run before the
    # function leaves (own.defer.1).
    defer_all()
    if (ens.len() == 0 and inv_key == "") or unchecked or instr.nocontracts
        return
    saved := scopes
    scopes = [Map[str, str]()]
    for b in ens_vars
        scopes[0][b.name] = b.key
    unit := ret.is_unit()
    if not unit
        declare("result", ret, rv)
    own_scope := scopes
    # An inherited condition reads the arguments under the trait method's names (contract.inh.3).
    mut their_scope := own_scope
    if t := inh.ens_from
        mut m := Map[str, str]()
        skip := if ens_vars.len() > 0 and ens_vars[0].name == "self" then 1 else 0
        if t.receiver != none and skip == 1
            m["self"] = ens_vars[0].key
        for i in 0..t.params.len()
            m[t.params[i].name] = ens_vars[skip + i].key
        if rk := own_scope[0].get("result")
            m["result"] = rk
        their_scope = [m]
    unchecked = true
    for i in 0..ens.len()
        c := ens[i]
        if i >= inh.ens_n and ens_proved(c)
            continue
        scopes = if i < inh.ens_n then their_scope else own_scope
        v := lower_value(c.cond, Ty.Bool) else break
        trace_contract(ens_label, "ensures", c, v.id)
        ok := check_branch(v.id)
        trap_open("contract.ens.1", c.pos)
        origin := if i < inh.ens_n then inh.ens_origin else ""
        say("`{ens_label}` ensures `{c.text}`{origin}, but it returned")
        if not unit
            say(" ")
            describe(Val(id: rv, ty: ret), c.pos)
        say(" at {at.line}:{at.col} with ")
        describe_args([ens_vars[k] for k in 0..ens_nargs], c.pos)
        if instr.vals
            shown := ens_values(c)
            trap_close_listed(c.pos, shown.0, shown.1)
        else
            trap_close(c.pos)
        cur = ok
    unchecked = false
    scopes = saved
    if inv_key != ""
        me := lookup("self") else return
        check_invariants(inv_key, read_var(me, cur), at, ens_label, at)

# ---- invariants ----

## contract.inv.2-3: the struct `key` value `obj` keeps its `invariant`
## lines. `by` is "" for a value just built at `pos`, else the method that
## returned at `at` and changed it.
fn Lower.check_invariants(mut self, key str, obj int, pos ast.Pos, by str, at ast.Pos)
    if unchecked or instr.nocontracts
        return
    list := invariants.get(key) else return
    if inv_file[key] != file
        problem(
            pos,
            "`{key}`: invariants of a struct in another module aren't in the native subset yet",
        )
        return
    saved := scopes
    saved_self := self_ty
    scopes = [Map[str, str]()]
    self_ty = key
    t := Ty.Struct(key)
    declare("self", t, obj)
    parts := key.split(".")
    name := parts[parts.len() - 1]
    unchecked = true
    for c in list
        v := lower_value(c.cond, Ty.Bool) else break
        trace_contract(name, "invariant", c, v.id)
        ok := check_branch(v.id)
        if by == ""
            trap_open("contract.inv.2", c.pos)
            say("`{name}` invariant `{c.text}` doesn't hold for ")
            describe(Val(id: obj, ty: t), c.pos)
            say(", built at {pos.line}:{pos.col} (invariant at {c.pos.line}:{c.pos.col})")
        else
            trap_open("contract.inv.3", c.pos)
            say("`{name}` invariant `{c.text}` was broken by `{by}`, which returned at {at.line}:{at.col} with self = ")
            describe(Val(id: obj, ty: t), c.pos)
            say(" (invariant at {c.pos.line}:{c.pos.col})")
        trap_close(c.pos)
        cur = ok
    unchecked = false
    scopes = saved
    self_ty = saved_self
