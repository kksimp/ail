## Element-wise loops four and two at a time (native.vec.4, native.vec.5). A counted loop whose body is one
## block of `float` element loads, `float` arithmetic (`+ - * /`) and `float` element stores, every access at a
## loop counter with no offset, as in
##
##     for i in 0..n
##         c[i] = a[i] * k + b[i]
##
## or a comprehension once its pushes write `data[length]` (pushes.ail), gets two loops in front of it: one
## that does four iterations per pass with `Vec4` operations (one 256-bit register on x86-64, two 128-bit ones
## on ARM64, vec4.ail), then one that does two per pass with the `Vec2` operations of native.vec.3. The
## original loop then does what is left, and every iteration when the count is below two.
##
## No overlap test is needed, which is where AIL is ahead of C. Two lists never share part of their elements:
## a list's elements are a block of its own, so two element addresses `base_a + 8i` and `base_b + 8i` at the same
## counter are the same element or elements of different lists. A later lane's access to element `i + 1`
## therefore never meets lane 0's access to element `i`, whatever the lists are. Accesses at two different
## counters (`out[len] = a[i]`) are only taken when the two lists are known to be different lists (alias.ail).
##
## Each lane does its scalar operation with the operands in the written order, never fused, so every element gets
## the bits of the scalar loop. A loop that carries a `float` from one iteration to the next (a sum) is left
## alone, so no float reduction is reassociated. Nothing in the body can trap: the loop is the check-free copy
## that bounds-check versioning made (native.bce.1), and the counters step by 1 below a bound, so `i + 4` can't
## overflow once `i + 3 < bound` held. `AIL_OPT_OFF=vmap` turns the pass off.
##
## `int` elements run in lanes too (native.vec.6): `add`, `sub` and the bitwise three. A checked `add` or `sub`
## keeps its trap: each pass builds a mask of the lanes that overflowed and tests it before its first store; a
## pass with an overflow writes nothing and leaves the vector loops, and the original loop runs from that
## iteration and traps where the scalar loop would, with the same message.

## The most instructions in a body that is paired.
VMAP_LIMIT := 64

## Pair every loop of `g` that has the shape, each once.
pub fn vec_maps(mut g Func)
    if opt_off("vmap") or g.name.starts_with("rt.")
        return
    loops := find_loops(g)
    if loops.len() == 0
        return
    defs := defs_of(g)
    # The loops found are disjoint innermost loops; each change adds blocks and values and retargets one
    # preheader's jump, so what was found for the others still holds.
    for lp in loops
        vmap_loop(mut g, defs, loops, lp)

fn vmap_loop(mut g Func, defs List[Def], loops List[LoopInfo], lp LoopInfo) bool
    if lp.blocks.len() != 2 or not is_innermost(loops, lp)
        return false
    c := counted(g, defs, lp) else return false
    if c.step >= 0 or c.q >= 0 or lp.pre < 0 or g.blocks[lp.pre].term.kind != "jump"
        return false
    h := lp.header
    hb := g.blocks[h]
    bb := g.blocks[c.body]
    if bb.params.len() > 0 or bb.term.kind != "jump" or bb.term.targets[0] != h
        return false
    if hb.insts.len() != 1 or hb.insts[0].dst != hb.term.cond
        return false
    if bb.insts.len() > VMAP_LIMIT or defs[c.bound].block < 0 or lp.member[defs[c.bound].block]
        return false
    back := bb.term.args[0]
    if back.len() != hb.params.len()
        return false
    # Where each value of the body is defined, and how often the body and its jump read it.
    mut here := Map[int, int]()
    for at in 0..bb.insts.len()
        d := bb.insts[at].dst
        if d >= 0
            here[d] = at
    mut uses := Map[int, int]()
    for i in bb.insts
        for u in i.operands()
            uses[u] = (uses.get(u) else 0) + 1
    for u in back
        uses[u] = (uses.get(u) else 0) + 1
    # The header's parameters: counters (`steps` 1, the next value is `x + 1`) and values passed through (0).
    mut steps := List[int]()
    for j in 0..hb.params.len()
        p := hb.params[j]
        nxt := back[j]
        if nxt == p
            steps.push(0)
            continue
        at := here.get(nxt) else return false
        ad := bb.insts[at]
        if ad.op != "add" or ad.arg(0) != p or (uses.get(nxt) else 0) != 1
            return false
        if const_of(g, defs, ad.arg(1)) != 1 or g.vals[p] != Ty.Int
            return false
        # The loop's own counter can't overflow (it stays below the bound); another counter is only taken
        # when its step has no check.
        if ad.site >= 0 and p != c.p
            return false
        steps.push(1)
    mut counters := Set[int]()
    for j in 0..hb.params.len()
        if steps[j] == 1
            counters.add(hb.params[j])
    if not counters.contains(c.p)
        return false
    # Every instruction of the body: one the vector loops can do in lanes. `lane` holds the values that
    # become a vector: loads, arithmetic and copies of them. The first load says whether the lanes are
    # `float`s or `int`s (native.vec.6); a body has one kind.
    mut lane := Set[int]()
    mut access := List[Inst]()
    mut stores := 0
    mut kind := Ty.Unit
    for i in bb.insts
        if i.op == "ldx" or i.op == "stx"
            if i.imm != 8 or i.elem_off() != 0 or not counters.contains(i.arg(1))
                return false
            base := i.arg(0)
            if defs[base].block < 0 or lp.member[defs[base].block] or alias_list(g, defs, base) < 0
                return false
            if i.op == "ldx"
                if i.dst < 0 or (g.vals[i.dst] != Ty.Float and g.vals[i.dst] != Ty.Int)
                    return false
                if kind != Ty.Unit and kind != g.vals[i.dst]
                    return false
                kind = g.vals[i.dst]
                lane.add(i.dst)
            else
                if not lane.contains(i.arg(2))
                    return false
                stores += 1
            access.push(i)
        elif slp_arith(i.op)
            if g.vals[i.dst] != Ty.Float or kind != Ty.Float
                return false
            lane.add(i.dst)
        elif i.op == "copy"
            if not lane.contains(i.arg(0))
                return false
            lane.add(i.dst)
        elif i.op == "add" and vmap_counter_add(steps, hb.params, back, i)
            continue
        elif vmap_int_op(i.op)
            if kind != Ty.Int or g.vals[i.dst] != Ty.Int or i.argc() != 2
                return false
            if not lane.contains(i.arg(0)) and not lane.contains(i.arg(1))
                return false
            # The other operand: a lane, a value from before the loop or a constant, never a counter.
            for u in i.operands()
                if lane.contains(u)
                    continue
                if counters.contains(u)
                    return false
                if at := here.get(u)
                    if bb.insts[at].op != "const"
                        return false
            # A checked operation after a store: the pass could not be left with nothing written.
            if i.site >= 0 and (stores > 0 or (i.op != "add" and i.op != "sub"))
                return false
            lane.add(i.dst)
        elif i.op != "const" and i.op != "fconst"
            return false
    if stores == 0
        return false
    # Accesses at two different counters need lists that are apart.
    for x in access
        if x.op != "stx"
            continue
        for y in access
            if x.arg(1) != y.arg(1) and not alias_apart(g, defs, x.arg(0), y.arg(0))
                return false
    vmap_build(mut g, lp, c, steps)
    true

## The `int` operations done in lanes (native.vec.6): `add` and `sub` (checked or not) and the bitwise three.
## There is no 64-bit lane multiply on either instruction set.
fn vmap_int_op(op str) bool
    op == "add" or op == "sub" or op == "band" or op == "bor" or op == "bxor"

## Whether `i` is the step of one of the counters: the value the jump back passes for it.
fn vmap_counter_add(steps List[int], params List[int], back List[int], i Inst) bool
    for j in 0..params.len()
        if params[j] == i.arg(0) and steps[j] == 1 and back[j] == i.dst
            return true
    false

## Add the vector loops in front of the loop `lp`. While `p < bound` and the first store's element is not on a
## 32-byte boundary (a list's elements start 8 bytes past a 16-byte one), a scalar iteration runs first (`peel`,
## at most three), so no 16- or 32-byte store straddles a cache line. The vector loops then count in bytes: `p`
## and each counter used as an index is carried as `8 * x`, read by `vldx`/`vstx` directly (no address arithmetic
## per access, which halves the loop's speed on Apple cores). The four-lane loop (native.vec.5) steps by 32 and
## runs while `8 * p < 8 * (bound - 3)`, that is while four iterations remain; the two-lane loop steps by 16 and
## runs while `8 * p < 8 * (bound - 1)`, at most once after the four-lane one. A join turns the counters back
## into elements and enters the original loop, which does what is left.
fn vmap_build(mut g Func, lp LoopInfo, c Counted, steps List[int])
    h := lp.header
    hb := g.blocks[h]
    bb := g.blocks[c.body]
    np := hb.params.len()
    # Which parameters the vector loops carry in bytes: the loop's counter and every counter used as an index.
    mut wide := [false for _ in 0..np]
    wide[c.k] = true
    for i in bb.insts
        if i.op == "ldx" or i.op == "stx"
            for j in 0..np
                if hb.params[j] == i.arg(1)
                    wide[j] = true
    first := g.blocks.len()
    pt := first
    pa := first + 1
    pe := first + 2
    pb := first + 3
    pc := first + 4
    wh := first + 5
    wb := first + 6
    vh := first + 7
    vb := first + 8
    vx := first + 9
    vj := first + 10
    mut tparams := List[int]()
    mut bparams := List[int]()
    mut wparams := List[int]()
    mut vparams := List[int]()
    mut xparams := List[int]()
    mut jparams := List[int]()
    for p in hb.params
        tparams.push(new_val(mut g, g.vals[p]))
        bparams.push(new_val(mut g, g.vals[p]))
        wparams.push(new_val(mut g, g.vals[p]))
        vparams.push(new_val(mut g, g.vals[p]))
        xparams.push(new_val(mut g, g.vals[p]))
        jparams.push(new_val(mut g, g.vals[p]))
    # `p < bound`, then bits 3 and 4 of the first store's address.
    tp := tparams[c.k]
    c0 := new_val(mut g, Ty.Bool)
    pt_insts := [inst(c0, "lt", [tp, c.bound])]
    pt_term := Term(kind: "branch", cond: c0, targets: [pa, vj], args: [[], tparams], value: -1)
    mut store := bb.insts[0]
    for i in bb.insts
        if i.op == "stx"
            store = i
            break
    mut sidx := tp
    for j in 0..np
        if hb.params[j] == store.arg(1)
            sidx = tparams[j]
    three := new_val(mut g, Ty.Int)
    mask := new_val(mut g, Ty.Int)
    nought := new_val(mut g, Ty.Int)
    sh := new_val(mut g, Ty.Int)
    addr := new_val(mut g, Ty.Int)
    low := new_val(mut g, Ty.Int)
    odd := new_val(mut g, Ty.Bool)
    pa_insts := [
        vmap_const(three, 3),
        vmap_const(mask, 24),
        vmap_const(nought, 0),
        inst(sh, "shl", [sidx, three]),
        inst(addr, "add", [store.arg(0), sh]),
        inst(low, "band", [addr, mask]),
        inst(odd, "ne", [low, nought]),
    ]
    pa_term := Term(kind: "branch", cond: odd, targets: [pe, pb], args: [[], tparams], value: -1)
    # A peeled iteration: the body as it is, with the counters stepped by 1 (`p + 1` can't overflow: `p < bound`),
    # then the test again.
    mut pe_insts := List[Inst]()
    narrow := [false for _ in 0..np]
    mut unused := List[Inst]()
    pe_body := vmap_body(mut g, bb, hb.params, tparams, steps, narrow, 1, mut unused, mut pe_insts)
    pe_next := pe_body.nexts
    # The limits `8 * (bound - 1)` and `8 * (bound - 3)`: `bound >= 1` here (`0 <= p < bound` held), and a bound
    # past 2^59 (no list is that long) skips the vector loops rather than overflow.
    one := new_val(mut g, Ty.Int)
    bm1 := new_val(mut g, Ty.Int)
    tri := new_val(mut g, Ty.Int)
    bm3 := new_val(mut g, Ty.Int)
    top := new_val(mut g, Ty.Int)
    fits := new_val(mut g, Ty.Bool)
    pb_insts := [
        vmap_const(one, 1),
        inst(bm1, "sub", [c.bound, one]),
        vmap_const(tri, 3),
        inst(bm3, "sub", [c.bound, tri]),
        vmap_const(top, 576460752303423488),
        inst(fits, "lt", [c.bound, top]),
    ]
    pb_term := Term(kind: "branch", cond: fits, targets: [pc, vj], args: [[], bparams], value: -1)
    # Into bytes: every counter of the vector loops is an index or `p`, so it is at least 0 and below 2^59.
    # `8 * (bound - 3)` may be below 0; the four-lane loop then never runs.
    lim := new_val(mut g, Ty.Int)
    lim4 := new_val(mut g, Ty.Int)
    k3 := new_val(mut g, Ty.Int)
    mut pc_insts := [vmap_const(k3, 3), inst(lim, "shl", [bm1, k3]), inst(lim4, "shl", [bm3, k3])]
    mut starts := List[int]()
    for j in 0..np
        if wide[j]
            bv := new_val(mut g, Ty.Int)
            pc_insts.push(inst(bv, "shl", [bparams[j], k3]))
            starts.push(bv)
        else
            starts.push(bparams[j])
    # The four-lane loop: while `8 * p < 8 * (bound - 3)`. What does not change in the loops (constants and
    # splats of values from before the loop) is made once, in `pre`.
    mut pre := List[Inst]()
    cw := new_val(mut g, Ty.Bool)
    wh_insts := [inst(cw, "lt", [wparams[c.k], lim4])]
    wh_term := Term(kind: "branch", cond: cw, targets: [wb, vh], args: [[], wparams], value: -1)
    mut wb_insts := List[Inst]()
    wbody := vmap_body(mut g, bb, hb.params, wparams, steps, wide, 4, mut pre, mut wb_insts)
    # The two-lane loop: while `8 * p < 8 * (bound - 1)`.
    c1 := new_val(mut g, Ty.Bool)
    vh_insts := [inst(c1, "lt", [vparams[c.k], lim])]
    vh_term := Term(kind: "branch", cond: c1, targets: [vb, vx], args: [[], vparams], value: -1)
    mut vb_insts := List[Inst]()
    vbody := vmap_body(mut g, bb, hb.params, vparams, steps, wide, 2, mut pre, mut vb_insts)
    pc_insts.extend(pre)
    # A body with checked operations is two blocks; the second ones follow the join.
    wc := first + 11
    vc := if wbody.cut >= 0 then first + 12 else first + 11
    wblocks := vmap_blocks(mut g, wbody, wb_insts, wh, wc, vx, wparams)
    vblocks := vmap_blocks(mut g, vbody, vb_insts, vh, vc, vx, vparams)
    # Out of the vector loops (`vend`), and back to elements.
    k3x := new_val(mut g, Ty.Int)
    mut vx_insts := [inst(-1, "vend", []), vmap_const(k3x, 3)]
    mut ends := List[int]()
    for j in 0..np
        if wide[j]
            ev := new_val(mut g, Ty.Int)
            vx_insts.push(inst(ev, "shr", [xparams[j], k3x]))
            ends.push(ev)
        else
            ends.push(xparams[j])
    g.blocks.push(Block(params: tparams, insts: pt_insts, term: pt_term))
    g.blocks.push(Block(params: [], insts: pa_insts, term: pa_term))
    g.blocks.push(Block(params: [], insts: pe_insts, term: jump_to(pt, pe_next)))
    g.blocks.push(Block(params: bparams, insts: pb_insts, term: pb_term))
    g.blocks.push(Block(params: [], insts: pc_insts, term: jump_to(wh, starts)))
    g.blocks.push(Block(params: wparams, insts: wh_insts, term: wh_term))
    g.blocks.push(wblocks[0])
    g.blocks.push(Block(params: vparams, insts: vh_insts, term: vh_term))
    g.blocks.push(vblocks[0])
    g.blocks.push(Block(params: xparams, insts: vx_insts, term: jump_to(vj, ends)))
    g.blocks.push(Block(params: jparams, insts: [], term: jump_to(h, jparams)))
    if wblocks.len() > 1
        g.blocks.push(wblocks[1])
    if vblocks.len() > 1
        g.blocks.push(vblocks[1])
    # The preheader's values now start the alignment test.
    g.blocks[lp.pre].term.targets[0] = pt

## The body of one vector loop as blocks. Without checked operations (`vb.cut` < 0) it is one block that jumps
## back to `head`. With them (native.vec.6) it is two: the first computes every lane and the overflow mask
## `vb.guard`, and leaves to `leave` with the pass's counters `now` untouched when a lane overflowed, so that
## the original loop runs those iterations again and traps at the one that overflows; the second (block
## `after`) holds the stores and jumps back.
fn vmap_blocks(
    mut g Func,
    vb VBody,
    insts List[Inst],
    head int,
    after int,
    leave int,
    now List[int],
) List[Block]
    if vb.cut < 0
        return [Block(params: [], insts: insts, term: jump_to(head, vb.nexts))]
    mut front := [insts[k] for k in 0..vb.cut]
    rest := [insts[k] for k in vb.cut..insts.len()]
    signs := new_val(mut g, Ty.Int)
    nought := new_val(mut g, Ty.Int)
    no_over := new_val(mut g, Ty.Bool)
    front.push(inst(signs, "vsign", [vb.guard]))
    front.push(vmap_const(nought, 0))
    front.push(inst(no_over, "eq", [signs, nought]))
    two_way := Term(
        kind: "branch",
        cond: no_over,
        targets: [after, leave],
        args: [[], now],
        value: -1,
    )
    [
        Block(params: [], insts: front, term: two_way),
        Block(params: [], insts: rest, term: jump_to(head, vb.nexts)),
    ]

fn vmap_const(d int, n int) Inst
    mut k := inst(d, "const", [])
    k.imm = n
    k

## What `vmap_body` made: the counters' next values, the vector whose lanes' sign bits say which lanes
## overflowed (-1: the body has no checked operation), and where in the instructions the first store is
## (-1 without checked operations).
struct VBody
    nexts List[int]
    guard int
    cut int

## The body `bb` once more into `out`, with the header's parameters `params` read as `now`: in `width` lanes
## (2 or 4; a parameter marked in `bytes8` is a counter in bytes, stepped by `8 * width`, and the others by
## `width`) or as written (`width` 1, the counters stepped by 1, checked operations still checked). In lanes,
## constants and the splats of values that do not change in the loop go to `pre`, which runs once before the
## vector loops (a vector may be read in a block its definition dominates), and each checked `add` or `sub`
## adds its overflow to the mask: lane `a + b = r` overflowed when `(a ^ r) & (b ^ r)` is negative, lane
## `a - b = r` when `(a ^ b) & (a ^ r)` is.
fn vmap_body(
    mut g Func,
    bb Block,
    params List[int],
    now List[int],
    steps List[int],
    bytes8 List[bool],
    width int,
    mut pre List[Inst],
    mut out List[Inst],
) VBody
    # Each old value's new one: `lanes` for a vector (or a scalar in the peeled copy), `scal` for a scalar of the
    # new block. `stays` holds the new constants made in `pre`.
    lanes2 := width > 1
    mut lanes := Map[int, int]()
    mut scal := Map[int, int]()
    for j in 0..params.len()
        scal[params[j]] = now[j]
    mut splats := Map[int, int]()
    mut stays := Set[int]()
    mut guard := -1
    mut cut := -1
    for i in bb.insts
        if i.op == "const" or i.op == "fconst"
            d := new_val(mut g, g.vals[i.dst])
            mut k := i
            k.dst = d
            if lanes2
                pre.push(k)
                stays.add(d)
            else
                out.push(k)
            scal[i.dst] = d
        elif i.op == "copy"
            lanes[i.dst] = lanes.get(i.arg(0)) else -1
        elif i.op == "add"
            and (lanes.get(i.arg(0)) else -1) < 0
            and (lanes.get(i.arg(1)) else -1) < 0
            # A counter's step: made below.
            continue
        elif i.op == "ldx"
            d := new_val(mut g, vmap_ty(width, g.vals[i.dst]))
            idx := vmap_scalar(scal, i.arg(1))
            mut ld := inst(d, if lanes2 then "vldx" else "ldx", [i.arg(0), idx])
            # In lanes the index is the counter in bytes (`imm` 1).
            ld.imm = if lanes2 then 1 else 8
            out.push(ld)
            lanes[i.dst] = d
        elif i.op == "stx"
            if lanes2 and guard >= 0 and cut < 0
                cut = out.len()
            val := lanes.get(i.arg(2)) else -1
            idx := vmap_scalar(scal, i.arg(1))
            mut st := inst(-1, if lanes2 then "vstx" else "stx", [i.arg(0), idx, val])
            st.imm = if lanes2 then 1 else 8
            out.push(st)
        else
            vt := vmap_ty(width, g.vals[i.dst])
            mut ops := List[int]()
            for u in i.operands()
                if lv := lanes.get(u)
                    ops.push(lv)
                    continue
                s := vmap_scalar(scal, u)
                if not lanes2
                    ops.push(s)
                    continue
                if sp := splats.get(s)
                    ops.push(sp)
                    continue
                sd := new_val(mut g, vt)
                if stays.contains(s) or (scal.get(u) else -1) < 0
                    pre.push(inst(sd, "vsplat", [s]))
                else
                    out.push(inst(sd, "vsplat", [s]))
                splats[s] = sd
                ops.push(sd)
            d := new_val(mut g, vt)
            if not lanes2
                mut same := i.with_args(ops)
                same.dst = d
                out.push(same)
            else
                out.push(inst(d, vmap_lane_op(i.op), ops))
                if i.site >= 0 and vmap_int_op(i.op)
                    x1 := new_val(mut g, vt)
                    x2 := new_val(mut g, vt)
                    over := new_val(mut g, vt)
                    if i.op == "add"
                        out.push(inst(x1, "vxor", [ops[0], d]))
                        out.push(inst(x2, "vxor", [ops[1], d]))
                    else
                        out.push(inst(x1, "vxor", [ops[0], ops[1]]))
                        out.push(inst(x2, "vxor", [ops[0], d]))
                    out.push(inst(over, "vand", [x1, x2]))
                    if guard < 0
                        guard = over
                    else
                        both := new_val(mut g, vt)
                        out.push(inst(both, "vor", [guard, over]))
                        guard = both
            lanes[i.dst] = d
    inc := new_val(mut g, Ty.Int)
    out.push(vmap_const(inc, width))
    inc16 := new_val(mut g, Ty.Int)
    out.push(vmap_const(inc16, 8 * width))
    mut nexts := List[int]()
    for j in 0..params.len()
        if steps[j] == 0
            nexts.push(now[j])
            continue
        # No step overflows: `8 * p` stays below `8 * (bound - 1)` < 2^62, and another counter's step had no check.
        d := new_val(mut g, Ty.Int)
        out.push(inst(d, "add", [now[j], if bytes8[j] then inc16 else inc]))
        nexts.push(d)
    VBody(nexts: nexts, guard: guard, cut: cut)

## What an element of type `elem` (`float` or `int`) is in a copy of the body with `width` lanes. The vector
## types hold either kind: 64 bits a lane.
fn vmap_ty(width int, elem Ty) Ty
    if width == 4
        return Ty.Vec4
    if width == 2
        return Ty.Vec2
    elem

## The lane operation for the scalar `op`.
fn vmap_lane_op(op str) str
    match op
        "add" => "viadd"
        "sub" => "visub"
        "band" => "vand"
        "bor" => "vor"
        "bxor" => "vxor"
        _ => "v{op}"

## The new block's value for `v`: its own for a header parameter or a constant of the body, else `v` (defined
## before the loop).
fn vmap_scalar(scal Map[int, int], v int) int
    scal.get(v) else v
