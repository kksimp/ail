## Generics in the native subset (ADR 0536), by monomorphisation:
## every use of a generic function, struct or enum with concrete types is
## its own instance, named with the types (`max_of[int]`, `Box[str]`,
## `Box[str].get`) and lowered as a plain function or type with each type
## parameter replaced (gen.decl.1-2, gen.infer.1). A function's type
## arguments come from the explicit `f[T](...)`, else from its arguments'
## types, else from the type the context expects. Instances are declared
## when first used and their bodies lowered after the program's functions,
## so an instance may ask for more. A trait bound needs nothing more: the
## method a body calls on `T` is the concrete type's (gen.bound.2).

use ast

## A generic function or method of a generic type, and its file.
struct GenFn
    decl ast.FnDecl
    file int

## A generic struct or enum: its type parameters, file and declaration.
struct GenType
    params List[str]
    file int
    sdecl ast.StructDecl?
    edecl ast.EnumDecl?

## A function instance whose body is still to be lowered.
struct Instance
    key str
    decl ast.FnDecl
    binds Map[str, Ty]
    ## The type instance whose method this is, else "".
    owner str
    file int

struct Gen
    ## Generic functions by key (`f`, `m.f`), methods of generic types by
    ## `T.m`.
    fns Map[str, GenFn]
    types Map[str, GenType]
    ## Each type instance's generic key and type arguments.
    bases Map[str, str]
    targs Map[str, List[Ty]]
    queue List[Instance]
    ## The type parameters' types while lowering an instance.
    tsubst Map[str, Ty]
    ## The types of `List[...]` owners of `impl` instances (`List[int]`).
    owner_tys Map[str, Ty]

fn new_gen() Gen
    Gen(fns: {}, types: {}, bases: {}, targs: {}, queue: [], tsubst: {}, owner_tys: {})

fn generic_names(ps List[ast.GenericParam]) List[str]
    [p.name for p in ps]

## Record a generic struct or enum of the current file.
fn Lower.declare_generic_struct(mut self, s ast.StructDecl)
    gen.types["{prefix}{s.name}"] = GenType(
        params: generic_names(s.generics),
        file: file,
        sdecl: s,
        edecl: none,
    )

fn Lower.declare_generic_enum(mut self, e ast.EnumDecl)
    gen.types["{prefix}{e.name}"] = GenType(
        params: generic_names(e.generics),
        file: file,
        sdecl: none,
        edecl: e,
    )

## Record a generic function, or a method of a generic type; true when `f`
## is one (it is declared per instance, not now).
fn Lower.declare_generic_fn(mut self, f ast.FnDecl, pre str) bool
    if o := f.owner
        if gen.types.contains("{pre}{o.name}")
            gen.fns[fn_key(f, pre)] = GenFn(decl: f, file: file)
            return true
        if f.generics.len() > 0
            if ["int", "float", "bool", "str", "List"].contains(o.name)
                problem(
                    f.pos,
                    "`{o.name}.{f.name}`: generic methods aren't in the native subset yet",
                )
                return true
            # A generic method of a plain struct or enum: an instance per call's type arguments (gen.method.3).
            gen.fns[fn_key(f, pre)] = GenFn(decl: f, file: file)
            return true
        if o.name == "List" and o.params != none
            # `impl Trait for List[T]`: an instance per element type.
            gen.fns["List.{f.name}"] = GenFn(decl: f, file: file)
            return true
        return false
    if f.generics.len() == 0
        return false
    gen.fns[fn_key(f, pre)] = GenFn(decl: f, file: file)
    note_generic_errs(f, fn_key(f, pre))
    true

## The key of the generic struct or enum a written name means here.
fn Lower.generic_type_key(self, name str) str?
    parts := name.split(".")
    if parts.len() > 1
        m := aliases.get(parts[0])?
        key := "{m}.{parts[1..].join(".")}"
        return if gen.types.contains(key) then key else none
    key := "{prefix}{name}"
    if gen.types.contains(key) then key else none

## The key of the generic function a name means here, unless a local or a
## method of `self` hides it.
fn Lower.generic_fn_key(self, name str) str?
    if lookup(name) != none
        return none
    parts := name.split(".")
    if parts.len() > 1
        m := aliases.get(parts[0])?
        key := "{m}.{parts[1..].join(".")}"
        return if gen.fns.contains(key) then key else none
    if self_ty != "" and sigs.contains("{self_ty}.{name}")
        return none
    key := "{prefix}{name}"
    if gen.fns.contains(key) then key else none

## The type a written type means while lowering an instance: a type
## parameter's type, or `G[A, B]` instantiated.
fn Lower.generic_type(mut self, name str, args List[ast.TypeRef]) Ty?
    if args.len() == 0
        if t := gen.tsubst.get(name)
            return t
        if is_const_arg(name)
            return Ty.Struct(name)
        # A trait written as a type means `any Trait` (trait.any.1).
        return any_type(name)
    g := generic_type_key(name)?
    mut tys := List[Ty]()
    for a in args
        tys.push(type_of(a)?)
    instance_type(g, tys)

## Instance `G[A, B]` of generic type `g`, declared on first use.
fn Lower.instance_type(mut self, g str, tys List[Ty]) Ty?
    gt := gen.types[g]
    if tys.len() != gt.params.len()
        return none
    key := "{g}[{[t.name() for t in tys].join(", ")}]"
    if structs.contains(key)
        return Ty.Struct(key)
    if enums.contains(key)
        return Ty.Enum(key)
    gen.bases[key] = g
    gen.targs[key] = tys
    mut binds := Map[str, Ty]()
    for k in 0..tys.len()
        binds[gt.params[k]] = tys[k]
    saved := enter_decl(gt.file, binds)
    if s := gt.sdecl
        structs[key] = []
        mut slots := List[Slot]()
        for fd in s.fields
            t := type_of(fd.ty) else
                problem(fd.pos, "field `{fd.name}`: its type isn't in the native subset yet")
                Ty.Unknown
            slots.push(Slot(name: fd.name, ty: t))
        structs[key] = slots
    if e := gt.edecl
        enums[key] = []
        mut cases := List[Case]()
        for v in e.variants
            mut slots := List[Slot]()
            for fd in v.fields
                t := type_of(fd.ty) else
                    problem(fd.pos, "field `{fd.name}`: its type isn't in the native subset yet")
                    Ty.Unknown
                slots.push(Slot(name: fd.name, ty: t))
            cases.push(Case(name: v.name, fields: slots))
        enums[key] = cases
    leave_decl(saved)
    if structs.contains(key) then Ty.Struct(key) else Ty.Enum(key)

## The lowering's place before `enter_decl`.
struct Place
    file int
    prefix str
    aliases Map[str, str]
    tsubst Map[str, Ty]

## Read names as file `k` does, with type parameters `binds`, until
## `leave_decl`.
fn Lower.enter_decl(mut self, k int, binds Map[str, Ty]) Place
    saved := Place(file: file, prefix: prefix, aliases: aliases, tsubst: gen.tsubst)
    if not is_rt
        file = k
        prefix = file_prefix[k]
        aliases = file_aliases[k]
    gen.tsubst = binds
    saved

fn Lower.leave_decl(mut self, p Place)
    file = p.file
    prefix = p.prefix
    aliases = p.aliases
    gen.tsubst = p.tsubst

## A written type of a generic declaration in file `k` under `binds`, or
## `none` while it names a parameter not yet bound.
fn Lower.decl_type(mut self, t ast.TypeRef, binds Map[str, Ty], params List[str], k int) Ty?
    if names_unbound(t, binds, params)
        return none
    saved := enter_decl(k, binds)
    r := type_of(t)
    leave_decl(saved)
    r

fn names_unbound(t ast.TypeRef, binds Map[str, Ty], params List[str]) bool
    match t.shape
        Named(n, args) =>
            if args.len() == 0 and params.contains(n) and not binds.contains(n)
                return true
            for a in args
                if names_unbound(a, binds, params)
                    return true
            false
        Optional(inner) => names_unbound(inner, binds, params)
        FnType(ps, r) =>
            for p in ps
                if names_unbound(p, binds, params)
                    return true
            if x := r
                return names_unbound(x, binds, params)
            false
        Fallible(ok, _) =>
            if o := ok
                return names_unbound(o, binds, params)
            false
        _ => false

## Bind the type parameters `t` names from the type `ty` of a value given
## for it (gen.infer.1): `T` from `int`, `List[T]` from `List[str]`,
## `Box[T]` from an instance of `Box`.
fn Lower.unify(self, t ast.TypeRef, ty Ty, params List[str], mut binds Map[str, Ty])
    match t.shape
        Named(n, args) =>
            if args.len() == 0
                if params.contains(n) and not binds.contains(n) and not ty.is_unknown()
                    binds[n] = ty
                return
            if n == "List" and args.len() == 1
                e := ty.elem() else return
                unify(args[0], e, params, mut binds)
                return
            if n == "Map" and args.len() == 2
                match ty
                    Map(kt, vt) =>
                        unify(args[0], kt, params, mut binds)
                        unify(args[1], vt, params, mut binds)
                    _ => return
                return
            if n == "Set" and args.len() == 1
                match ty
                    Set(et) => unify(args[0], et, params, mut binds)
                    _ => return
                return
            key := match ty
                Struct(k) => k
                Enum(k) => k
                _ => return
            tys := gen.targs.get(key) else return
            if tys.len() != args.len()
                return
            for k in 0..args.len()
                unify(args[k], tys[k], params, mut binds)
        Optional(inner) =>
            i := ty.opt_inner() else return
            unify(inner, i, params, mut binds)
        FnType(ps, r) =>
            match ty
                Fn(tps, tr, _) =>
                    if tps.len() != ps.len()
                        return
                    for k in 0..ps.len()
                        unify(ps[k], tps[k], params, mut binds)
                    if rt := r
                        match rt.shape
                            Fallible(ok, _) =>
                                if o := ok
                                    unify(o, tr, params, mut binds)
                            _ => unify(rt, tr, params, mut binds)
                _ => return
        TupleType(elems) =>
            xs := tuple_elems(ty) else return
            if xs.len() != elems.len()
                return
            for k in 0..elems.len()
                unify(elems[k], xs[k], params, mut binds)
        _ => return

## Whether a call's callee is a generic function or a generic struct.
fn Lower.is_generic_callee(self, callee ast.Expr) bool
    name := match callee
        Name(n, _) => n
        TypeArgs(n, _, _) => n
        Member => if p := path_of(callee) then p else ""
        _ => return false
    if name == ""
        return false
    if generic_fn_key(name) != none
        return true
    lookup(name) == none and generic_type_key(name) != none

## `f(...)`, `f[T](...)`, `G(...)` or `G[T](...)` of a generic function or
## struct.
fn Lower.lower_generic_callee(
    mut self,
    callee ast.Expr,
    args List[ast.Arg],
    pos ast.Pos,
    want Ty?,
) Val?
    mut name := ""
    mut targs := List[ast.TypeRef]()
    # A call's frame is at the function's name, as for other calls (trace.frame.1).
    mut at := pos
    match callee
        Name(n, p) =>
            name = n
            at = p
        TypeArgs(n, ts, p) =>
            name = n
            targs = ts
            at = p
        Member(_, _, p) =>
            name = path_of(callee) else return unsupported(pos, "this call")
            at = p
        _ => return unsupported(pos, "this call")
    if g := generic_fn_key(name)
        return generic_call(g, name, targs, args, at, want)
    g := generic_type_key(name) else return unsupported(pos, "this call")
    generic_struct(g, targs, args, pos, want)

## The type arguments written in `f[A, B]`, bound to `params`.
fn Lower.explicit_binds(
    mut self,
    params List[str],
    targs List[ast.TypeRef],
    pos ast.Pos,
) Map[str, Ty]?
    mut binds := Map[str, Ty]()
    if targs.len() == 0
        return binds
    if targs.len() != params.len()
        problem(pos, "expected {params.len()} type arguments, found {targs.len()}")
        return none
    for k in 0..targs.len()
        t := type_of(targs[k]) else
            problem(targs[k].pos, "this type isn't in the native subset yet")
            return none
        binds[params[k]] = t
    binds

## Bind from the expected type `want` when it is an instance of `g`.
fn Lower.binds_from_want(self, g str, params List[str], want Ty?, mut binds Map[str, Ty])
    w := want else return
    key := match w
        Struct(k) => k
        Enum(k) => k
        _ => return
    if gen.bases.get(key) != g
        return
    tys := gen.targs[key]
    for k in 0..params.len()
        if not binds.contains(params[k])
            binds[params[k]] = tys[k]

## Report each parameter of `params` not in `binds`; true when all are.
fn Lower.all_bound(mut self, params List[str], binds Map[str, Ty], what str, pos ast.Pos) bool
    for n in params
        if not binds.contains(n)
            problem(pos, "can't tell `{n}` of `{what}` here: give it, as in `{what}[T](...)`")
            return false
    true

## A call of generic function `g` (gen.infer.1): bind its type parameters,
## then call the instance.
fn Lower.generic_call(
    mut self,
    g str,
    shown str,
    targs List[ast.TypeRef],
    args List[ast.Arg],
    pos ast.Pos,
    want Ty?,
) Val?
    gf := gen.fns[g]
    f := gf.decl
    params := generic_names(f.generics)
    mut binds := explicit_binds(params, targs, pos)?
    if args.len() != f.params.len()
        return unsupported(pos, "this call")
    mut vs := List[Val]()
    for k in 0..args.len()
        a := args[k]
        if a.label != none
            return unsupported(pos, "labelled arguments")
        pt := f.params[k].ty
        mut aw := decl_type(pt, binds, params, gf.file)
        if aw == none
            # A function literal before its result type parameter is bound (type.fn.8).
            aw = partial_fn_want(pt, binds, params, gf.file)
        v := lower_value(a.value, aw)?
        unify(pt, v.ty, params, mut binds)
        vs.push(Val(id: shield_arg(args, k, v), ty: v.ty))
    check_mut_overlap(args, pos)
    if r := f.ret
        if w := want
            if not w.is_unit()
                unify(r, w, params, mut binds)
    if not all_bound(params, binds, shown, pos)
        return none
    key := "{g}[{[binds[n].name() for n in params].join(", ")}]"
    sig := instance(key, f, binds, "", gf.file)?
    if e := fn_errs.get(key)
        fn_errs[g] = e
    mut cells := List[Cell]()
    ids := generic_arg_ids(args, vs, sig.params, 0, mut cells)
    res := Val(id: user_call(key, ids, sig.ret, pos, shown), ty: sig.ret)
    cells_back(cells)
    res

## The signature of function instance `key`, declared and queued on first
## use.
fn Lower.instance(mut self, key str, f ast.FnDecl, binds Map[str, Ty], owner str, k int) Sig?
    # `Self` in the signature of a method of an instance is the instance.
    saved := self_ty
    if owner != ""
        self_ty = owner
    sig := instance_sig(key, f, binds, owner, k)
    self_ty = saved
    sig

fn Lower.instance_sig(mut self, key str, f ast.FnDecl, binds Map[str, Ty], owner str, k int) Sig?
    if s := sigs.get(key)
        return s
    if bad.contains(key)
        fn_failed = true
        return none
    mut ps := List[Ty]()
    if owner != "" and f.receiver != none
        ps.push(owner_ty(owner))
    no := List[str]()
    for p in f.params
        t := decl_type(p.ty, binds, no, k) else
            problem(p.pos, "parameter `{p.name}`: its type isn't in the native subset yet")
            bad.add(key)
            return none
        ps.push(if p.mutable then (cell_param(t) else t) else t)
    mut rty := Ty.Unit
    mut can_fail := false
    if r := f.ret
        can_fail = is_fallible(r)
        # `AppError` means the declaring file's: look it up from there.
        here := prefix
        here_aliases := aliases
        prefix = file_prefix[k]
        aliases = file_aliases[k]
        t := (if can_fail then instance_ok(r, binds, k) else decl_type(r, binds, no, k)) else
            prefix = here
            aliases = here_aliases
            problem(r.pos, "`{f.name}`: its result type isn't in the native subset yet")
            bad.add(key)
            return none
        rty = t
        if can_fail
            fn_errs[key] = error_ty_of(r)
        prefix = here
        aliases = here_aliases
    sig := Sig(params: ps, ret: rty, fails: can_fail)
    sigs[key] = sig
    gen.queue.push(Instance(key: key, decl: f, binds: binds, owner: owner, file: k))
    sig

## The success type of a written `T ! E` in an instance: `Unit` for `! E`.
fn Lower.instance_ok(mut self, t ast.TypeRef, binds Map[str, Ty], k int) Ty?
    match t.shape
        Fallible(ok, _) =>
            o := ok else return Ty.Unit
            if n := written_name(o)
                if names_error(n)
                    return Ty.Unit
            decl_type(o, binds, List[str](), k)
        _ => none

## Whether the generic function `key` can fail (its declaration says so).
fn Lower.generic_fails(self, key str) bool
    gf := gen.fns.get(key) else return false
    r := gf.decl.ret else return false
    is_fallible(r)

## Declare method instance `key` (`Box[int].get`) of a generic type's
## instance, if it is one.
fn Lower.instance_method(mut self, key str)
    cut := key.split("].")
    if cut.len() < 2
        return
    tkey := "{cut[..cut.len() - 1].join("].")}]"
    m := cut[cut.len() - 1]
    base := gen.bases.get(tkey) else return
    if bad.contains("{base}.{m}")
        # Reported at its declaration.
        bad.add(key)
        return
    gf := gen.fns.get("{base}.{m}") else return
    if gf.decl.generics.len() > 0
        # Instantiated per call, with the method's own type arguments.
        return
    o := gf.decl.owner else return
    pnames := if ops := o.params then generic_names(ops) else gen.types[base].params
    tys := gen.targs[tkey]
    if pnames.len() != tys.len()
        return
    mut binds := Map[str, Ty]()
    for k in 0..pnames.len()
        binds[pnames[k]] = tys[k]
    instance(key, gf.decl, binds, tkey, gf.file)

## Whether `key` (`Pair[int, str].with_first`) is a method of a generic
## type's instance that has type parameters of its own.
fn Lower.is_generic_method(self, key str) bool
    cut := key.split("].")
    if cut.len() < 2
        return false
    tkey := "{cut[..cut.len() - 1].join("].")}]"
    base := gen.bases.get(tkey) else return false
    gf := gen.fns.get("{base}.{cut[cut.len() - 1]}") else return false
    gf.decl.generics.len() > 0

## `r.m(...)` where method `m` of the instance `tkey` has its own type
## parameters: bind them from the arguments (gen.method.3) and call the
## instance of the method for those types.
fn Lower.generic_method_call(mut self, key str, recv Val, args List[ast.Arg], pos ast.Pos) Val?
    cut := key.split("].")
    tkey := "{cut[..cut.len() - 1].join("].")}]"
    m := cut[cut.len() - 1]
    base := gen.bases[tkey]
    gf := gen.fns["{base}.{m}"]
    f := gf.decl
    o := f.owner else return unsupported(pos, "calling `{key}`")
    tnames := if ops := o.params then generic_names(ops) else gen.types[base].params
    tys := gen.targs[tkey]
    mut binds := Map[str, Ty]()
    for k in 0..tnames.len()
        binds[tnames[k]] = tys[k]
    mnames := generic_names(f.generics)
    if args.len() != f.params.len()
        return unsupported(
            pos,
            "calling `{key}` with {args.len()} arguments instead of {f.params.len()}",
        )
    mut vs := List[Val]()
    for k in 0..args.len()
        a := args[k]
        if a.label != none
            return unsupported(pos, "calling `{key}` with a labelled argument")
        pt := f.params[k].ty
        mut aw := decl_type(pt, binds, mnames, gf.file)
        if aw == none
            aw = partial_fn_want(pt, binds, mnames, gf.file)
        v := lower_value(a.value, aw)?
        unify(pt, v.ty, mnames, mut binds)
        vs.push(Val(id: shield_arg(args, k, v), ty: v.ty))
    check_mut_overlap(args, pos)
    if not all_bound(mnames, binds, m, pos)
        return none
    full := "{key}[{[binds[n].name() for n in mnames].join(", ")}]"
    sig := instance(full, f, binds, tkey, gf.file)?
    mut cells := List[Cell]()
    mut ids := [recv.id]
    ids.extend(generic_arg_ids(args, vs, sig.params, 1, mut cells))
    res := Val(id: user_call(full, ids, sig.ret, pos, full), ty: sig.ret)
    cells_back(cells)
    res

## `r.m(...)` where `m` is a generic method of the plain struct or enum `key` names
## (`Box.twice[T]`): bind its type parameters from the arguments (gen.method.3)
## and call the instance for those types.
fn Lower.owner_method_call(mut self, key str, recv Val, args List[ast.Arg], pos ast.Pos) Val?
    gf := gen.fns[key]
    f := gf.decl
    m := f.name
    owner := key.slice(0, key.len() - m.len() - 1)
    mnames := generic_names(f.generics)
    if args.len() != f.params.len()
        return unsupported(
            pos,
            "calling `{key}` with {args.len()} arguments instead of {f.params.len()}",
        )
    mut binds := Map[str, Ty]()
    mut vs := List[Val]()
    for k in 0..args.len()
        a := args[k]
        if a.label != none
            return unsupported(pos, "calling `{key}` with a labelled argument")
        pt := f.params[k].ty
        mut aw := decl_type(pt, binds, mnames, gf.file)
        if aw == none
            aw = partial_fn_want(pt, binds, mnames, gf.file)
        v := lower_value(a.value, aw)?
        unify(pt, v.ty, mnames, mut binds)
        vs.push(Val(id: shield_arg(args, k, v), ty: v.ty))
    check_mut_overlap(args, pos)
    if not all_bound(mnames, binds, m, pos)
        return none
    full := "{key}[{[binds[n].name() for n in mnames].join(", ")}]"
    sig := instance(full, f, binds, owner, gf.file)?
    mut cells := List[Cell]()
    mut ids := [recv.id]
    ids.extend(generic_arg_ids(args, vs, sig.params, 1, mut cells))
    res := Val(id: user_call(full, ids, sig.ret, pos, full), ty: sig.ret)
    cells_back(cells)
    res

## `G(...)` or `G[T](...)` of a generic struct: bind its type parameters
## from the written types, the expected type or the fields' values.
fn Lower.generic_struct(
    mut self,
    g str,
    targs List[ast.TypeRef],
    args List[ast.Arg],
    pos ast.Pos,
    want Ty?,
) Val?
    gt := gen.types[g]
    s := gt.sdecl else return unsupported(pos, "this call")
    mut binds := explicit_binds(gt.params, targs, pos)?
    binds_from_want(g, gt.params, want, mut binds)
    if args.len() != s.fields.len()
        return unsupported(pos, "`{s.name}(...)` without every field")
    mut at := List[int]()
    mut vs := List[Val]()
    ats := arg_fields([f.name for f in s.fields], args)
    for k in 0..args.len()
        a := args[k]
        j := ats[k]
        if j < 0
            if l := a.label
                return unsupported(l.pos, "field `{l.name}` of `{s.name}`")
            return unsupported(expr_pos(a.value), "too many arguments for `{s.name}(...)`")
        ft := s.fields[j].ty
        v := lower_value(a.value, decl_type(ft, binds, gt.params, gt.file))?
        unify(ft, v.ty, gt.params, mut binds)
        at.push(j)
        vs.push(Val(id: copy_if_place(a.value, v), ty: v.ty))
    if not all_bound(gt.params, binds, s.name, pos)
        return none
    t := instance_type(g, [binds[n] for n in gt.params]) else return unsupported(pos, "this struct")
    key := struct_name(t) else ""
    slots := structs[key]
    mut ids := [-1 for _ in slots]
    for k in 0..vs.len()
        ids[at[k]] = convert(vs[k], slots[at[k]].ty, expr_pos(args[k].value))
    obj := call("rt.obj_new", [konst(8 * slots.len(), Ty.Int), konst(OBJ_STRUCT, Ty.Int)], t)
    for k in 0..ids.len()
        store(obj, k, ids[k])
    Val(id: obj, ty: t)

## The generic enum `e` names, when it names one and no local.
fn Lower.generic_enum_ref(self, e ast.Expr) str?
    p := path_of(e)?
    if lookup(p.split(".")[0]) != none
        return none
    g := generic_type_key(p)?
    if gen.types[g].edecl != none then g else none

## The generic type a `E`, `E.V` receiver or a written `G[A]` names: an enum
## written bare, or a struct or enum with its type arguments written.
fn Lower.generic_member_ref(self, e ast.Expr) str?
    match e
        TypeArgs(n, _, _) =>
            if lookup(n) != none
                return none
            if n == "List"
                # `List[U].from_json(...)`: a function of a built-in type.
                return "#list"
            generic_type_key(n)
        Name(n, _) =>
            if lookup(n) == none and traits.impls.contains(trait_key(n))
                return trait_key(n)
            if lookup(n) == none
                if t := gen.tsubst.get(n)
                    if t.elem() != none and not t.is_coll()
                        # A type parameter bound to a list (`T.default()`, T = `List[str]`).
                        return "#tparam:{n}"
            if lookup(n) == none
                if g := generic_type_key(n)
                    return g
            generic_enum_ref(e)
        _ => generic_enum_ref(e)

## `E.V(...)`, `E.V`, `G[A].f(...)` or `G[A].V`: a variant of a generic enum
## (its type arguments from the expected type, or written), or a function of
## a generic struct's instance.
fn Lower.generic_member(
    mut self,
    g str,
    recv ast.Expr,
    name str,
    args List[ast.Arg]?,
    pos ast.Pos,
    want Ty?,
) Val?
    if g == "#list"
        match recv
            TypeArgs(_, targs, tpos) =>
                t := type_of(ast.TypeRef(shape: Named("List", targs), pos: tpos)) else
                    return unsupported(tpos, "this list type")
                key := builtin_method(t, name) else return unsupported(
                    pos,
                    "`.{name}()` on `{t.name()}`",
                )
                call_args := args else return unsupported(pos, "`{name}` without a call")
                if e := fn_errs.get(key)
                    fn_errs["List.{name}"] = e
                return struct_call(key, none, call_args, pos)
            _ => return none
    if g.starts_with("#tparam:")
        t := gen.tsubst[g.slice(8, g.len())]
        key := builtin_method(t, name) else return unsupported(pos, "`.{name}()` on `{t.name()}`")
        call_args := args else return unsupported(pos, "`{name}` without a call")
        if e := fn_errs.get(key)
            fn_errs["List.{name}"] = e
        return struct_call(key, none, call_args, pos)
    if traits.impls.contains(g) and gen.types.get(g) == none
        # `Trait.method(x, ...)` (trait.res.1): the method of `x`'s type.
        call_args := args else return unsupported(pos, "`{g}.{name}` without a call")
        if call_args.len() == 0
            return unsupported(pos, "`{g}.{name}` without a receiver")
        first := lower_value(call_args[0].value, none)?
        rest := call_args[1..]
        if t := any_of(first.ty)
            return any_call(t, first, name, rest, pos)
        s := struct_name(first.ty) else return unsupported(
            pos,
            "`{g}.{name}` on `{first.ty.name()}`",
        )
        return struct_call("{s}.{name}", first, rest, pos)
    match recv
        TypeArgs(_, targs, _) =>
            gt := gen.types[g]
            binds := explicit_binds(gt.params, targs, pos)?
            if not all_bound(gt.params, binds, gt.params.join(", "), pos)
                return none
            t := instance_type(g, [binds[n] for n in gt.params]) else
                return unsupported(pos, "`{g}` with these type arguments")
            if gt.edecl != none
                return generic_variant(g, name, args, pos, some_ty(t))
            key := struct_name(t) else return unsupported(pos, "`{g}.{name}`")
            call_args := args else return unsupported(pos, "`{g}.{name}` without a call")
            instance_method("{key}.{name}")
            if e := fn_errs.get("{key}.{name}")
                fn_errs["{g}.{name}"] = e
            struct_call("{key}.{name}", none, call_args, pos)
        _ =>
            if gen.fns.contains("{g}.{name}")
                return generic_static(g, name, args, pos, want)
            generic_variant(g, name, args, pos, want)

## `G.f(args)` of a generic type written with no type arguments: a function of
## the type without `self`. The type arguments come from the arguments and the
## expected type (gen.infer.1).
fn Lower.generic_static(mut self, g str, name str, args List[ast.Arg]?, pos ast.Pos, want Ty?) Val?
    gf := gen.fns["{g}.{name}"]
    f := gf.decl
    gt := gen.types[g]
    given := args else return unsupported(pos, "`{g}.{name}` without a call")
    if f.receiver != none or f.generics.len() > 0 or given.len() != f.params.len()
        return unsupported(pos, "`{g}.{name}`")
    mut binds := Map[str, Ty]()
    mut vs := List[Val]()
    for k in 0..given.len()
        a := given[k]
        if a.label != none
            return unsupported(pos, "labelled arguments")
        pt := f.params[k].ty
        v := lower_value(a.value, decl_type(pt, binds, gt.params, gf.file))?
        unify(pt, v.ty, gt.params, mut binds)
        vs.push(Val(id: shield_arg(given, k, v), ty: v.ty))
    check_mut_overlap(given, pos)
    binds_from_want(g, gt.params, want, mut binds)
    if not all_bound(gt.params, binds, g, pos)
        return none
    t := instance_type(g, [
        binds[n]
        for n in gt.params
    ]) else return unsupported(pos, "`{g}` with these type arguments")
    key := "{t.name()}.{name}"
    instance_method(key)
    sig := sigs.get(key) else return unsupported(pos, "`{g}.{name}`")
    mut cells := List[Cell]()
    ids := generic_arg_ids(given, vs, sig.params, 0, mut cells)
    check_requires(key, ids, pos)
    res := Val(id: user_call(key, ids, sig.ret, pos, key), ty: sig.ret)
    cells_back(cells)
    res

fn some_ty(t Ty) Ty?
    t

## `E.V(...)` or `E.V` of a generic enum: bind its type parameters from the
## expected type or the variant's field values.
fn Lower.generic_variant(mut self, g str, name str, args List[ast.Arg]?, pos ast.Pos, want Ty?) Val?
    gt := gen.types[g]
    e := gt.edecl else return unsupported(pos, "this variant")
    mut k := -1
    for i in 0..e.variants.len()
        if e.variants[i].name == name
            k = i
    if k < 0
        return unsupported(pos, "`{e.name}` has no variant `{name}`")
    fields := e.variants[k].fields
    mut binds := Map[str, Ty]()
    binds_from_want(g, gt.params, want, mut binds)
    given := args else []
    if given.len() != fields.len()
        return unsupported(pos, "`{name}(...)` without every field")
    mut at := List[int]()
    mut vs := List[Val]()
    for i in 0..given.len()
        a := given[i]
        mut j := i
        if l := a.label
            j = -1
            for x in 0..fields.len()
                if fields[x].name == l.name
                    j = x
            if j < 0
                return unsupported(l.pos, "field `{l.name}` of `{name}`")
        ft := fields[j].ty
        v := lower_value(a.value, decl_type(ft, binds, gt.params, gt.file))?
        unify(ft, v.ty, gt.params, mut binds)
        at.push(j)
        vs.push(Val(id: copy_if_place(a.value, v), ty: v.ty))
    if not all_bound(gt.params, binds, e.name, pos)
        return none
    t := instance_type(g, [binds[n] for n in gt.params]) else return unsupported(pos, "this enum")
    key := enum_name(t) else ""
    v := VariantRef(en: key, k: k)
    if fields.len() == 0
        return new_variant(v, none, pos)
    slots := enums[key][k].fields
    mut ids := [-1 for _ in slots]
    for i in 0..vs.len()
        ids[at[i]] = convert(vs[i], slots[at[i]].ty, expr_pos(given[i].value))
    build_variant(v, ids)

## Lower the bodies of the function instances asked for, including those
## they ask for.
fn Lower.gen_instances(mut self)
    while gen.queue.len() > 0
        job := gen.queue.pop() else break
        enter_file(job.file)
        gen.tsubst = job.binds
        lower_fn_as(job.decl, job.key, job.key, job.owner)
        gen.tsubst = {}
    enter_file(0)

## A file's functions as the native backend lowers them: the free functions
## and methods, and the methods of its `impl` blocks as methods of their
## types (trait.impl.1), with the trait's default methods a block doesn't
## define (trait.decl.2). A trait's own functions aren't lowered: each type
## that implements the trait has its copy (ADR 0536).
fn program_fns(prog ast.Program) List[ast.FnDecl]
    mut out := List[ast.FnDecl]()
    for f in prog.fns
        match f.within
            TopLevel => out.push(f)
            _ => continue
    for im in prog.impls
        mut defined := Set[str]()
        for m in im.methods
            mut f := prog.fns[m]
            f.owner = im.target
            defined.add(f.name)
            out.push(f)
        for t in prog.traits
            if t.name != im.trait_name
                continue
            for m in t.methods
                mut f := prog.fns[m]
                if f.body != none and not defined.contains(f.name)
                    f.owner = im.target
                    out.push(f)
    out

## The default methods of a trait declared in another file (`impl app.App
## for Todo`) become methods of the impl's own program, so `program_fns`
## finds them (trait.decl.2). A default is lowered in the impl's file, so it
## sees the names of that file.
fn share_trait_defaults(srcs List[Source]) List[Source]
    mut out := List[Source]()
    for k in 0..srcs.len()
        mut prog := srcs[k].prog
        mut fns := prog.fns
        mut impls := prog.impls
        for ii in 0..impls.len()
            im := impls[ii]
            tname := im.trait_name.split(".").last() else im.trait_name
            mut local := false
            for t in prog.traits
                if t.name == tname
                    local = true
            if local
                continue
            mut defined := Set[str]()
            for m in im.methods
                defined.add(fns[m].name)
            mut methods := im.methods
            for j in 0..srcs.len()
                if j == k
                    continue
                for t in srcs[j].prog.traits
                    if t.name != tname
                        continue
                    alias := use_alias(prog, srcs[j].module)
                    tys := decl_type_names(srcs[j].prog)
                    for m in t.methods
                        mut f := srcs[j].prog.fns[m]
                        if f.body != none and not defined.contains(f.name)
                            defined.add(f.name)
                            # Its signature names the trait file's types
                            # (`List[Measure]`): qualify them for this file.
                            f.params = [qualify_param(p, tys, alias) for p in f.params]
                            if r := f.ret
                                f.ret = qualify_ty(r, tys, alias)
                            fns.push(f)
                            methods.push(fns.len() - 1)
            mut im2 := im
            im2.methods = methods
            impls[ii] = im2
        prog.fns = fns
        prog.impls = impls
        out.push(Source(module: srcs[k].module, path: srcs[k].path, text: srcs[k].text, prog: prog))
    out

## The name `prog` calls module `module` by: its `use` alias, else the
## last part of its path.
fn use_alias(prog ast.Program, module str) str
    last := module.split(".").last() else module
    for u in prog.uses
        tail := u.path.last() else continue
        if tail.name == last
            if a := u.alias
                return a.name
    last

## The structs and enums `prog` declares.
fn decl_type_names(prog ast.Program) Set[str]
    mut out := Set[str]()
    for d in prog.structs
        out.add(d.name)
    for d in prog.enums
        out.add(d.name)
    out

fn qualify_param(p ast.Param, tys Set[str], alias str) ast.Param
    mut q := p
    q.ty = qualify_ty(p.ty, tys, alias)
    q

## `t` with each type of `tys` it names written `alias.Name`.
fn qualify_ty(t ast.TypeRef, tys Set[str], alias str) ast.TypeRef
    mut q := t
    match t.shape
        Named(n, args) =>
            name := if tys.contains(n) then "{alias}.{n}" else n
            q.shape = ast.TypeShape.Named(name, [qualify_ty(a, tys, alias) for a in args])
        Optional(inner) => q.shape = ast.TypeShape.Optional(qualify_ty(inner, tys, alias))
        _ => return t
    q

## The built-in types an `impl` may be for (trait.impl.1): their methods
## are keyed `int.m`, `List.m`, without a module prefix.
BUILTIN_OWNERS := ["int", "float", "bool", "str", "List"]

## The key of type `name`'s methods, declared in a module with prefix `pre`.
fn owner_key(name str, pre str) str
    if BUILTIN_OWNERS.contains(name) then name else "{pre}{name}"

## The key of method `name` of a built-in type `t` from an `impl`, if it
## has one; a `List[T]` method's instance is declared on first use.
fn Lower.builtin_method(mut self, t Ty, name str) str?
    match t
        Int | Float | Bool | Str =>
            key := "{t.name()}.{name}"
            if sigs.contains(key) or bad.contains(key)
                return key
            none
        List(e) =>
            key := "{t.name()}.{name}"
            if sigs.contains(key) or bad.contains(key)
                return key
            gf := gen.fns.get("List.{name}")?
            o := gf.decl.owner?
            ps := o.params?
            if ps.len() != 1
                return none
            gen.owner_tys[t.name()] = t
            instance(key, gf.decl, {ps[0].name: e}, t.name(), gf.file)?
            key
        _ => none

## The type an associated call `T.f(...)` names when `T` is a type
## parameter of the instance being lowered (trait.assoc.1-2).
fn Lower.assoc_owner(self, e ast.Expr) str?
    match e
        Name(n, _) =>
            if lookup(n) != none
                return none
            if n == "Self" and self_ty != ""
                return self_ty
            t := gen.tsubst.get(n)?
            match t
                Struct(k) => k
                Enum(k) => k
                Int | Float | Bool | Str => t.name()
                List(_) => t.name()
                _ => none
        _ => none

## Declare the instance of `impl Trait for List[T]`'s `name` that `T.name(...)` calls when `T`
## is a list type, as `builtin_method` does for a method call on a list.
fn Lower.assoc_instance(mut self, recv ast.Expr, name str)
    match recv
        Name(n, _) =>
            t := gen.tsubst.get(n) else return
            match t
                List(_) =>
                    if k := builtin_method(t, name)
                        return
                _ => return
        _ => return

## `m.f(...)` or `m.G(...)` through an import, where `f` or `G` is generic:
## the written name as one callee.
fn Lower.qualified_generic_callee(self, recv ast.Expr, name str, pos ast.Pos) ast.Expr?
    n := match recv
        Name(r, _) => "{r}.{name}"
        _ => return none
    if generic_fn_key(n) != none or (lookup(n) == none and generic_type_key(n) != none)
        return ast.Expr.Name(name: n, pos: pos)
    none
