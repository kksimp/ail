## Cleanups on a trap (own.uniq.3, own.defer.1): a trap ends the program, but
## first the `defer`s and the releases of unique locals of every open block
## run, innermost first. The lowering emits them at each normal exit
## (lower_defer.ail); for a trap it also registers each one with the runtime
## as it is set up (rt/native/unwind.ail): the release of a unique local as
## `drop.T` and its value, a `defer` as a generated function `unwind.F.N` and
## the block's locals at that point. A block left normally pops what it
## registered (the count is known here), a release or a move disarms its
## entry. Code without `defer` or unique values registers nothing.
##
## Known gaps: a `defer` sees its locals' values as they were when it was
## reached, a unique local assigned a new value isn't released by a trap, a
## `defer` that can't be lowered on its own does nothing on a trap, and
## nothing is registered in a program with tasks.
use ast

struct Unwind
    ## The entries each open block registered so far.
    counts List[int]
    ## The variable holding the entry index of each owned local, `FUNCTION|KEY`.
    idx Map[str, str]
    ## The `defer` functions to generate.
    jobs List[UnwindJob]

struct UnwindJob
    name str
    st ast.Stmt
    names List[str]
    tys List[Ty]
    file int
    self_ty str

fn new_unwind() Unwind
    Unwind(counts: [], idx: {}, jobs: [])

fn Lower.unwind_live(self) bool
    not is_rt

## A block begins.
fn Lower.unwind_enter(mut self)
    unw.counts.push(0)

## The block ends.
fn Lower.unwind_exit(mut self)
    unw.counts.pop()

## The blocks from index `first` are left normally: pop their entries.
fn Lower.unwind_cut(mut self, first int)
    mut n := 0
    mut i := if first < 0 then 0 else first
    while i < unw.counts.len()
        n += unw.counts[i]
        i += 1
    if n > 0
        call("rt.unwind_pop", [konst(n, Ty.Int)], Ty.Unit)

fn Lower.unwind_count(mut self)
    if unw.counts.len() > 0
        unw.counts[unw.counts.len() - 1] += 1

## The owned local `key` is released by `drop.T` on a trap too.
fn Lower.unwind_own(mut self, key str)
    if not self.unwind_live() or unw.counts.len() == 0
        return
    t := var_ty[key]
    name := "drop.{t.name()}"
    if not sigs.contains(name)
        sigs[name] = Sig(params: [t], ret: Ty.Unit, fails: false)
        uniq.wanted[name] = t
    f := self.fn_word(name)
    i := call("rt.unwind_push", [f, read_var(key, cur)], Ty.Int)
    nvars += 1
    vk := "unwind#{nvars}"
    var_ty[vk] = Ty.Int
    write_var(vk, cur, i)
    unw.idx["{fname}|{key}"] = vk
    self.unwind_count()

## The value of `key` moved away or was released: a trap won't release it.
fn Lower.unwind_disarm(mut self, key str)
    vk := unw.idx.get("{fname}|{key}") else return
    call("rt.unwind_disarm", [read_var(vk, cur)], Ty.Unit)

## The address of function `name`, as an `int` for the runtime.
fn Lower.fn_word(mut self, name str) int
    mut i := inst(-1, "fnaddr", [])
    i.name = name
    emit(i, Ty.Int)

## `defer st` runs on a trap too: as `unwind.F.N` of the locals in scope.
fn Lower.unwind_defer(mut self, st ast.Stmt)
    if not self.unwind_live() or unw.counts.len() == 0
        return
    mut held := List[str]()
    mut tys := List[Ty]()
    mut ids := List[int]()
    mut seen := Set[str]()
    mut s := scopes.len() - 1
    while s >= 0
        for n in scopes[s].keys()
            key := scopes[s][n]
            if seen.contains(n) or n.starts_with("$")
                continue
            seen.add(n)
            t := var_ty.get(key) else continue
            if t.is_unit() or t.is_unknown()
                continue
            held.push(n)
            tys.push(t)
            ids.push(read_var(key, cur))
        s -= 1
    env := call(
        "rt.obj_new",
        [konst(8 * (if ids.len() > 0 then ids.len() else 1), Ty.Int), konst(OBJ_STRUCT, Ty.Int)],
        Ty.Int,
    )
    for k in 0..ids.len()
        store(env, k, ids[k])
    name := "unwind.{fname}.{unw.jobs.len()}"
    sigs[name] = Sig(params: [Ty.Int], ret: Ty.Unit, fails: false)
    unw.jobs.push(UnwindJob(
        name: name,
        st: st,
        names: held,
        tys: tys,
        file: file,
        self_ty: self_ty,
    ))
    call("rt.unwind_push", [self.fn_word(name), env], Ty.Int)
    self.unwind_count()

## Generate the `unwind.F.N` functions (a body may ask for more).
fn Lower.gen_unwinds(mut self)
    mut k := 0
    while k < unw.jobs.len()
        self.gen_unwind(unw.jobs[k])
        k += 1

fn Lower.gen_unwind(mut self, job UnwindJob)
    enter_file(job.file)
    self_ty = job.self_ty
    saved := unw.counts
    unw.counts = []
    env := begin_fn(job.name, Ty.Unit, [Ty.Int])[0]
    for k in 0..job.names.len()
        declare(job.names[k], job.tys[k], load(env, k, job.tys[k]))
    lower_stmt(job.st)
    if failing()
        # It can't be lowered on its own: nothing runs on a trap.
        while problems.len() > fn_problems
            problems.pop()
        begin_fn(job.name, Ty.Unit, [Ty.Int])
    if not done()
        finish(return_of(-1))
    for b in 0..blocks.len()
        sealed[b] = true
    end_fn(job.name, ast.Pos(line: 1, col: 1))
    unw.counts = saved
