## The race detector's instrumentation (ADR 0967 stage 3, san.race.1-3). With
## `AIL_SANITIZE=race` in the environment, `main` starts with `rt.race_init()`,
## each non-volatile raw-pointer `read` and `write` of the program's own code
## is preceded by `rt.race_access(addr, width, is_write, site)`, and each
## `Atomic` operation publishes or takes the clock of its cell
## (`rt.race_release`, `rt.race_acquire`). The runtime is `rt/native/race.ail`.
## Without the variable nothing is emitted, so a normal build is unchanged.
use ast

## Whether this build is instrumented for races.
fn race_on() bool
    (env.get("AIL_SANITIZE") else "") == "race"

## Whether the code being lowered is the program's own and instrumented.
fn Lower.race_here(self) bool
    race_on() and not is_rt and not unchecked

## The start of `main`: turn the detector on before anything runs.
fn Lower.race_enter(mut self)
    if self.race_here() and fname == "main"
        call("rt.race_init", [], Ty.Unit)

## Before a raw-pointer access of `w` bytes at `addr` (san.race.1). A volatile
## access is a device register's, not shared memory.
fn Lower.race_access(mut self, addr int, w int, is_write bool, volatile bool, pos ast.Pos)
    if volatile or not self.race_here()
        return
    site := str_value("{path}:{pos.line}:{pos.col} in {fname}")
    call(
        "rt.race_access",
        [addr, konst(w, Ty.Int), konst(if is_write then 1 else 0, Ty.Int), site],
        Ty.Unit,
    )

## An `Atomic` operation on `cell`: it publishes what the task did before it
## when `rel`, and takes what other tasks published when `acq`. The publish
## comes first, so an acquirer that sees the new value also sees the clock.
fn Lower.race_sync(mut self, cell int, acq bool, rel bool)
    if not self.race_here()
        return
    if rel
        call("rt.race_release", [cell], Ty.Unit)
    if acq
        call("rt.race_acquire", [cell], Ty.Unit)
