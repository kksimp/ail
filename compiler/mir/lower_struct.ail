## Structs and methods in the native subset (ADR 0392). A struct value is
## a pointer to an object with one 8-byte slot per field, in declaration
## order (native-abi.md §2). Structs are values (own.val.1): reading one
## from a place to bind, store, push or return it copies it, deeply through
## the lists and structs it holds, with a generated `copy.T` function.
## Fields change in place, which is safe because every place holds its own
## object.

use ast

## A field of a struct: its name and slot type.
struct Slot
    name str
    ty Ty

## The result of `proc.run` (std.proc.1), a struct of the standard library
## that no source declares; its key can't clash with a program's own name.
PROC_OUTPUT := "proc.Output"

## The result of `proc.run_bytes` (std.proc.8): the streams undecoded.
PROC_RAW := "proc.RawOutput"

## The result of `fs.metadata` (std.fs.10).
FS_METADATA := "fs.Metadata"

## The result of `fs.volume` (std.fs.24).
FS_VOLUME := "fs.Volume"
## The result of `fs.scan` (std.fs.23) and its entries.
FS_SCAN := "fs.Scan"
FS_ENTRY := "fs.Entry"
## The result of `fs.scan_count` (std.fs.27).
FS_SCAN_COUNT := "fs.ScanCount"

## The child of `proc.start` (std.proc.4): pid and the three streams.
PROC_CHILD := "proc.Child"

## The errors of the OS layer (std.err.1): `fs.IoError` and `proc.ProcError`,
## error structs of the standard library that no source declares. The
## runtime builds them where a call fails (ADR 0804).
IO_ERROR := "fs.IoError"
PROC_ERROR := "proc.ProcError"

## What `Task.wait()` fails with when the task trapped (conc.task.6).
TRAPPED := "Trapped"

## The raw TCP types of `std.net` (std.net.12) and its error (std.net.4):
## structs of the standard library that no source declares.
NET_ERROR := "net.NetError"
NET_CONN := "net.Conn"
NET_LISTENER := "net.Listener"
NET_RESPONSE := "net.Response"
NET_SERVER := "net.Server"
NET_EXCHANGE := "net.Exchange"
NET_REQUEST := "net.Request"
NET_RAW := "net.RawResponse"
NET_BODY := "net.Body"
NET_OPTIONS := "net.Options"

## The error of `std.compress` (std.compress.2).
COMPRESS_ERROR := "compress.CompressError"

## Record the names of the structs of `prog` (all files first, so fields
## may name any struct) and report what isn't in the subset.
fn Lower.declare_struct_names(mut self, prog ast.Program)
    structs[PROC_OUTPUT] = []
    structs[PROC_RAW] = []
    structs[FS_METADATA] = []
    structs[FS_VOLUME] = []
    structs[FS_SCAN] = []
    structs[FS_ENTRY] = []
    structs[FS_SCAN_COUNT] = []
    structs[PROC_CHILD] = []
    structs[IO_ERROR] = []
    structs[PROC_ERROR] = []
    structs[TRAPPED] = []
    structs[NET_ERROR] = []
    structs[COMPRESS_ERROR] = []
    structs[NET_CONN] = []
    structs[NET_SERVER] = []
    structs[NET_EXCHANGE] = []
    structs[NET_REQUEST] = []
    structs[NET_LISTENER] = []
    structs[NET_RAW] = [
        Slot(name: "status", ty: Ty.Int),
        Slot(name: "headers", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "data", ty: Ty.Bytes),
        Slot(name: "all_headers", ty: Ty.Map(key: Ty.Str, val: Ty.List(Ty.Str))),
    ]
    structs[NET_BODY] = [
        Slot(name: "status", ty: Ty.Int),
        Slot(name: "headers", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "all_headers", ty: Ty.Map(key: Ty.Str, val: Ty.List(Ty.Str))),
        Slot(name: "handle", ty: Ty.Int),
    ]
    structs[NET_RESPONSE] = []
    structs[NET_OPTIONS] = []
    for s in prog.structs
        note_field_defaults(s)
        if s.generics.len() > 0
            declare_generic_struct(s)
        elif s.is_unique
            declare_unique(s, prog, "{prefix}{s.name}")
        else
            structs["{prefix}{s.name}"] = []
            if s.invariants.len() > 0
                invariants["{prefix}{s.name}"] = s.invariants
                inv_file["{prefix}{s.name}"] = file

fn Lower.declare_struct_fields(mut self, prog ast.Program)
    structs[IO_ERROR] = [Slot(name: "path", ty: Ty.Str), Slot(name: "kind", ty: Ty.Enum(IO_KIND))]
    structs[TRAPPED] = [Slot(name: "rule", ty: Ty.Str), Slot(name: "message", ty: Ty.Str)]
    structs[PROC_ERROR] = [
        Slot(name: "cmd", ty: Ty.Str),
        Slot(name: "kind", ty: Ty.Enum(PROC_KIND)),
    ]
    structs[NET_ERROR] = [
        Slot(name: "url", ty: Ty.Str),
        Slot(name: "kind", ty: Ty.Enum(NET_KIND)),
        Slot(name: "message", ty: Ty.Str),
    ]
    structs[COMPRESS_ERROR] = [
        Slot(name: "kind", ty: Ty.Enum(COMPRESS_KIND)),
        Slot(name: "message", ty: Ty.Str),
    ]
    structs[NET_CONN] = [Slot(name: "handle", ty: Ty.Int)]
    structs[NET_SERVER] = [Slot(name: "handle", ty: Ty.Int)]
    structs[NET_REQUEST] = [
        Slot(name: "method", ty: Ty.Str),
        Slot(name: "path", ty: Ty.Str),
        Slot(name: "query", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "headers", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "body", ty: Ty.Str),
        Slot(name: "peer", ty: Ty.Str),
        Slot(name: "data", ty: Ty.Bytes),
        Slot(name: "server", ty: Ty.Int),
    ]
    structs[NET_EXCHANGE] = [
        Slot(name: "request", ty: Ty.Struct(NET_REQUEST)),
        Slot(name: "handle", ty: Ty.Int),
    ]
    structs[NET_LISTENER] = [Slot(name: "handle", ty: Ty.Int)]
    structs[NET_RESPONSE] = [
        Slot(name: "status", ty: Ty.Int),
        Slot(name: "headers", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "body", ty: Ty.Str),
        Slot(name: "all_headers", ty: Ty.Map(key: Ty.Str, val: Ty.List(Ty.Str))),
    ]
    structs[NET_OPTIONS] = [
        Slot(name: "headers", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "query", ty: Ty.Map(key: Ty.Str, val: Ty.Str)),
        Slot(name: "body", ty: Ty.Str),
        Slot(name: "timeout_ms", ty: Ty.Int),
        Slot(name: "max_redirects", ty: Ty.Int),
        Slot(name: "data", ty: Ty.Bytes),
        Slot(name: "connect_ms", ty: Ty.Int),
        Slot(name: "total_ms", ty: Ty.Int),
    ]
    structs[PROC_CHILD] = [
        Slot(name: "pid", ty: Ty.Int),
        Slot(name: "stdin", ty: Ty.Chan(Ty.Str)),
        Slot(name: "out", ty: Ty.Chan(Ty.Str)),
        Slot(name: "err", ty: Ty.Chan(Ty.Str)),
    ]
    structs[FS_METADATA] = [
        Slot(name: "size", ty: Ty.Int),
        Slot(name: "modified_ms", ty: Ty.Int),
        Slot(name: "is_dir", ty: Ty.Bool),
    ]
    structs[FS_ENTRY] = [
        Slot(name: "path", ty: Ty.Str),
        Slot(name: "size", ty: Ty.Int),
        Slot(name: "alloc", ty: Ty.Int),
        Slot(name: "modified_ms", ty: Ty.Int),
        Slot(name: "inode", ty: Ty.Int),
        Slot(name: "device", ty: Ty.Int),
        Slot(name: "links", ty: Ty.Int),
        Slot(name: "is_dir", ty: Ty.Bool),
        Slot(name: "is_link", ty: Ty.Bool),
    ]
    structs[FS_SCAN] = [
        Slot(name: "entries", ty: Ty.List(Ty.Struct(FS_ENTRY))),
        Slot(name: "skipped", ty: Ty.List(Ty.Str)),
    ]
    structs[FS_VOLUME] = [Slot(name: "total", ty: Ty.Int), Slot(name: "free", ty: Ty.Int)]
    structs[FS_SCAN_COUNT] = [Slot(name: "entries", ty: Ty.Int), Slot(name: "bytes", ty: Ty.Int)]
    structs[PROC_RAW] = [
        Slot(name: "status", ty: Ty.Int),
        Slot(name: "out", ty: Ty.Bytes),
        Slot(name: "err", ty: Ty.Bytes),
    ]
    structs[PROC_OUTPUT] = [
        Slot(name: "status", ty: Ty.Int),
        Slot(name: "out", ty: Ty.Str),
        Slot(name: "err", ty: Ty.Str),
    ]
    for s in prog.structs
        key := "{prefix}{s.name}"
        if not structs.contains(key)
            continue
        mut slots := List[Slot]()
        for fd in s.fields
            t := type_of(fd.ty) else
                problem(fd.pos, "field `{fd.name}`: its type isn't in the native subset yet")
                Ty.Unknown
            slots.push(Slot(name: fd.name, ty: t))
        structs[key] = slots

## The slot of field `name` in struct `n`, or -1.
fn Lower.slot_of(self, n str, name str) int
    slots := structs.get(n) else return -1
    for k in 0..slots.len()
        if slots[k].name == name
            return k
    -1

## The field each argument of a struct literal or variant sets, as the checker's `field_slots`
## (type.struct.3-4): a labelled one by its name, a bare name that is a field's by that field,
## and any other by position, in the fields no argument names. -1 for none.
fn arg_fields(names List[str], args List[ast.Arg]) List[int]
    mut at := List[int]()
    mut bare := List[bool]()
    for a in args
        mut k := -1
        mut free := false
        if l := a.label
            k = field_at(names, l.name)
        else
            k = shorthand_slot(names, a.value)
            free = k < 0
        at.push(k)
        bare.push(free)
    mut next := 0
    for j in 0..at.len()
        if bare[j]
            while next < names.len() and at.contains(next)
                next += 1
            if next < names.len()
                at[j] = next
                next += 1
    at

fn field_at(names List[str], n str) int
    for k in 0..names.len()
        if names[k] == n
            return k
    -1

## The field a bare name, or a bare member made `self.n`, sets.
fn shorthand_slot(names List[str], value ast.Expr) int
    match value
        Name(n, _) => field_at(names, n)
        Member(recv, n, np) =>
            match recv
                Name(s, p) => if s == "self" and p == np then field_at(names, n) else -1
                _ => -1
        _ => -1

## `T(a: x, b: y)` or `T(x, y)`: a new object with every field set.
fn Lower.new_struct(mut self, n str, args List[ast.Arg], pos ast.Pos) Val?
    slots := structs[n]
    # std.net.17: `net.Response(...)` may leave `all_headers` out; it is empty.
    left_out := n == NET_RESPONSE and args.len() + 1 == slots.len()
    partial := std_partial(n, args)
    if args.len() != slots.len() and not left_out and not partial and not has_defaults(n)
        return unsupported(pos, "`{n}(...)` without every field")
    mut vs := [-1 for _ in slots]
    ats := arg_fields([sl.name for sl in slots], args)
    for k in 0..args.len()
        a := args[k]
        at := ats[k]
        if at < 0
            if l := a.label
                return unsupported(l.pos, "field `{l.name}` of `{n}`")
            return unsupported(expr_pos(a.value), "too many arguments for `{n}(...)`")
        t := slots[at].ty
        v := lower_value(a.value, t)?
        vs[at] = copy_if_place(a.value, Val(id: convert(v, t, expr_pos(a.value)), ty: t))
    if partial and not fill_private(slots, mut vs, pos)
        return none
    if not fill_defaults(n, slots, mut vs)
        return none
    if left_out
        for k in 0..vs.len()
            if vs[k] < 0
                vs[k] = new_table(slots[k].ty)
    own_groups(slots, vs)
    t := Ty.Struct(n)
    obj := call("rt.obj_new", [konst(8 * slots.len(), Ty.Int), konst(OBJ_STRUCT, Ty.Int)], t)
    for k in 0..vs.len()
        self.store(obj, k, vs[k])
    check_invariants(n, obj, pos, "", pos)
    Val(id: obj, ty: t)

## The heap object kinds (native-abi.md §2).
OBJ_STRUCT := 4

fn Lower.load(mut self, obj int, k int, t Ty) int
    mut i := inst(-1, "load", [obj])
    i.imm = 8 * k
    emit(i, t)

fn Lower.store(mut self, obj int, k int, v int)
    mut i := inst(-1, "store", [obj, v])
    i.imm = 8 * k
    emit_void(i)

## `x.f` on a struct.
fn Lower.lower_member(mut self, recv ast.Expr, name str, pos ast.Pos) Val?
    r := deref_use(lower_value(recv, none)?, pos)
    if xs := tuple_elems(r.ty)
        return tuple_member(r, xs, name, pos)
    n := struct_name(r.ty) else return unsupported(pos, "`.{name}` on `{r.ty.name()}`")
    k := self.slot_of(n, name)
    if k < 0
        return unsupported(pos, "`{n}` has no field `{name}`")
    t := structs[n][k].ty
    Val(id: self.load(r.id, k, t), ty: t)

fn struct_name(t Ty) str?
    match t
        Struct(n) => n
        _ => none

## `x.f = v` or `x.f op= v`.
fn Lower.assign_member(
    mut self,
    recv ast.Expr,
    name str,
    op ast.BinOp?,
    value ast.Expr,
    pos ast.Pos,
    at ast.Pos,
)
    held := lower_value(recv, none) else return
    r := deref_use(held, pos)
    if xs := tuple_elems(r.ty)
        assign_tuple_elem(r, xs, name, op, value, pos, at)
        return
    n := struct_name(r.ty) else
        problem(pos, "assigning `.{name}` on `{r.ty.name()}` isn't in the native subset yet")
        return
    k := self.slot_of(n, name)
    if k < 0
        problem(pos, "`{n}` has no field `{name}`")
        return
    self.assign_slot(r.id, n, k, op, value, at)

fn Lower.assign_slot(mut self, obj int, n str, k int, op ast.BinOp?, value ast.Expr, pos ast.Pos)
    t := structs[n][k].ty
    if o := op
        old := Val(id: self.load(obj, k, t), ty: t)
        v := lower_value(value, t) else return
        self.store(obj, k, binary(o, old, v, pos).id)
    else
        v := lower_value(value, t) else return
        uniq_drop_field(obj, k, t)
        self.store(obj, k, copy_if_place(value, Val(id: convert(v, t, pos), ty: t)))

## Inside a method, a field of `self` named without `self.`.
fn Lower.self_slot(self, name str) int
    if self_ty == ""
        return -1
    self.slot_of(self_ty, name)

fn Lower.self_value(mut self) int
    key := lookup("self") else return -1
    read_var(key, cur)

## A method call `x.m(...)` on a struct, or `T.f(...)` on its type.
fn Lower.struct_call(mut self, key str, recv Val?, args List[ast.Arg], pos ast.Pos) Val?
    if ordered := label_ordered_method(key, args)
        return self.struct_call(key, recv, ordered, pos)
    mut rcv := take_receiver()
    rcv.ref_obj = ref_of(rcv.ref_obj, recv)
    if not sigs.contains(key)
        instance_method(key)
    if bad.contains(key)
        release(key)
        fn_failed = true
        return none
    if gen.fns.contains(key) and recv == none
        return generic_call(key, key, [], args, pos, none)
    if r := recv
        if is_generic_method(key)
            return generic_method_call(key, r, args, pos)
        if g := gen.fns.get(key)
            if g.decl.generics.len() > 0
                return owner_method_call(key, r, args, pos)
        if key.ends_with(".cmp") and args.len() == 1 and not sigs.contains(key)
            # The derived `cmp` of `impl Ord for T` with no body (trait.std.2).
            other := lower_value(args[0].value, r.ty)?
            return lower_cmp(r, other, pos)
        if key.ends_with(".to_str") and args.len() == 0 and not sigs.contains(key)
            # The default text of a struct or enum with no `to_str` (trait.auto.2).
            t := display_call(r) else return unsupported(pos, "`.to_str()` on `{r.ty.name()}`")
            return Val(id: t, ty: Ty.Str)
    if key == "{PROC_OUTPUT}.ok" or key == "{PROC_OUTPUT}.text"
        return self.proc_output_method(key, recv, args, pos)
    if key.starts_with("net.")
        return lower_net_method(key, recv, args, pos)
    if key.ends_with(".cmp") and args.len() == 1 and not sigs.contains(key)
        if r := recv
            return derived_cmp(r, args[0], pos)
    if r := recv
        if is_ord_minmax(key, r.ty, args)
            return ord_minmax(key, r, args[0], pos)
    sig := sigs.get(key) else return unsupported(pos, "calling `{key}`")
    uniq_recv(key, rcv.expr)
    mut vs := List[int]()
    mut cells := List[Cell]()
    if r := recv
        if ct := cell_ty(sig.params[0])
            e := rcv.expr else
                problem(pos, "this `mut self` receiver isn't a variable, field or element")
                return none
            if rcv.path.len() == 0
                problem(pos, "this `mut self` receiver isn't a variable, field or element")
                return none
            vs.push(new_cell(r.id))
            cells.push(Cell(key: "", place: e, cell: vs[0], ty: ct, pos: pos))
        else
            vs.push(shield_recv(rcv, args, r))
    if args.len() + vs.len() != sig.params.len()
        return unsupported(
            pos,
            "calling `{key}` with {args.len() + vs.len()} arguments instead of {sig.params.len()}",
        )
    for i in 0..args.len()
        a := args[i]
        if a.label != none
            return unsupported(pos, "calling `{key}` with a labelled argument")
        t := sig.params[vs.len()]
        if ct := cell_ty(t)
            vs.push(cell_arg(a, ct, mut cells)?)
            continue
        v := lower_value(a.value, t)?
        vs.push(shield_arg_on(rcv, args, i, Val(id: convert(v, t, expr_pos(a.value)), ty: v.ty)))
    check_requires(key, vs, pos)
    busy := ref_enter(rcv, key)
    instr_watch_cells(cells)
    res := Val(id: user_call(key, vs, sig.ret, pos, key), ty: sig.ret)
    instr_watch_cells_end(cells)
    ref_leave(rcv, busy)
    cells_back(cells)
    res

## `o.ok()` and `o.text()` of a `proc.Output` (std.proc.9, std.proc.10): the
## status is zero; the standard output followed by the standard error.
fn Lower.proc_output_method(mut self, key str, recv Val?, args List[ast.Arg], pos ast.Pos) Val?
    r := recv else return unsupported(pos, "calling `{key}`")
    if args.len() > 0
        return unsupported(pos, "`{key}` takes no arguments")
    if key == "{PROC_OUTPUT}.ok"
        status := self.load(r.id, 0, Ty.Int)
        return Val(id: op("eq", [status, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
    out := self.load(r.id, 1, Ty.Str)
    err := self.load(r.id, 2, Ty.Str)
    Val(id: call("rt.str_cat", [out, err], Ty.Str), ty: Ty.Str)

## Whether a value of type `t` read from a place must be copied to stay
## independent (own.val.1).
fn needs_copy(t Ty) bool
    match t
        List(_) | Struct(_) | Tuple(_) | Any(_) | Map(_, _) | Set(_) => true
        _ => false

## Whether copying `t` needs a generated function: it holds a struct.
fn holds_struct(t Ty) bool
    match t
        Struct(_) | Tuple(_) | Any(_) => true
        List(e) => e.is_coll() or holds_struct(e)
        Map(_, v) => holds_struct(v)
        _ => false

## A copy of `v`, deep through lists and structs.
fn Lower.copy_value(mut self, v Val) int
    if v.ty.is_coll()
        return copy_coll(v)
    if not holds_struct(v.ty)
        return copy_list(v)
    if c := self.flat_copy(v)
        return c
    name := "copy.{v.ty.name()}"
    if not sigs.contains(name)
        sigs[name] = Sig(params: [v.ty], ret: v.ty, fails: false)
        copy_tys[name] = v.ty
    call(name, [v.id], v.ty)

## Generate each `copy.T` asked for, including those they ask for.
fn Lower.gen_copies(mut self)
    mut done := Set[str]()
    mut more := true
    while more
        more = false
        for name in copy_tys.keys()
            if done.contains(name)
                continue
            done.add(name)
            more = true
            self.gen_copy(name, copy_tys[name])

fn Lower.gen_copy(mut self, name str, t Ty)
    x := begin_fn(name, t, [t])[0]
    match t
        Any(tr) => gen_any_copy(x, tr)
        Struct(n) =>
            slots := structs[n]
            obj := call(
                "rt.obj_new",
                [konst(8 * slots.len(), Ty.Int), konst(OBJ_STRUCT, Ty.Int)],
                t,
            )
            for k in 0..slots.len()
                st := slots[k].ty
                mut v := self.load(x, k, st)
                if needs_copy(st)
                    v = self.copy_value(Val(id: v, ty: st))
                self.store(obj, k, v)
            finish(return_of(obj))
        Tuple(xs) =>
            obj := call("rt.obj_new", [konst(8 * xs.len(), Ty.Int), konst(OBJ_STRUCT, Ty.Int)], t)
            for k in 0..xs.len()
                mut v := self.load(x, k, xs[k])
                if needs_copy(xs[k])
                    v = self.copy_value(Val(id: v, ty: xs[k]))
                self.store(obj, k, v)
            finish(return_of(obj))
        List(e) =>
            n := op("len", [x], Ty.Int)
            out := call("rt.list_new", [n], t)
            head := new_block()
            i := new_value(Ty.Int, "")
            blocks[head].params.push(i)
            jump(head, [konst(0, Ty.Int)])
            cur = head
            body := new_block()
            exit := new_block()
            branch(op("lt", [i, n], Ty.Bool), body, [], exit, [])
            cur = body
            item := self.copy_value(Val(id: op("get", [x, i], e), ty: e))
            call(push_fn(e), [out, item], Ty.Unit)
            jump(head, [op("add", [i, konst(1, Ty.Int)], Ty.Int)])
            cur = exit
            finish(return_of(out))
        Map(_, vt) =>
            # The runtime copies the table and shares the structs; each live
            # entry's value is then replaced by its copy (own.val.1).
            out := call("rt.map_copy", [x], t)
            raw := op("copy", [out], Ty.Int)
            used := call("rt.map_used", [raw], Ty.Int)
            head := new_block()
            i := new_value(Ty.Int, "")
            blocks[head].params.push(i)
            jump(head, [konst(0, Ty.Int)])
            cur = head
            body := new_block()
            step := new_block()
            exit := new_block()
            branch(op("lt", [i, used], Ty.Bool), body, [], exit, [])
            cur = body
            e := call("rt.map_live", [raw, i], Ty.Int)
            live := new_block()
            branch(op("ne", [e, konst(0, Ty.Int)], Ty.Bool), live, [], step, [])
            cur = live
            c := self.copy_value(Val(id: entry_value(e, vt), ty: vt))
            rawop("store64", [op("add", [e, konst(16, Ty.Int)], Ty.Int), c], Ty.Unit)
            jump(step, [])
            cur = step
            jump(head, [op("add", [i, konst(1, Ty.Int)], Ty.Int)])
            cur = exit
            finish(return_of(out))
        _ => finish(return_of(x))
    for b in 0..blocks.len()
        sealed[b] = true
    end_fn(name, ast.Pos(line: 1, col: 1))

## `x.f`, `E.V`, or a qualified constant.
fn Lower.lower_member_expr(
    mut self,
    recv ast.Expr,
    name str,
    pos ast.Pos,
    e ast.Expr,
    want Ty?,
) Val?
    if g := generic_member_ref(recv)
        return generic_member(g, recv, name, none, pos, want)
    if en := enum_ref(recv)
        return variant_member(en, name, pos)
    if key := qualified(e)
        if consts.contains(key)
            return lower_const(key, want)
        if globals.contains(key)
            return global_const(key)
        return unsupported(pos, "`{key}` as a value")
    self.lower_member(recv, name, pos)
