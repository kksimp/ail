## `std.mem` and the fixed libc subset in native builds (ADR 0844, ffi.native.1,
## unsafe.mem.1-3). Blocks come from the runtime's own page allocator, not the
## collected heap, and `free` returns them. Out-of-block and freed accesses
## trap through the table of `memtab.ail` (unsafe.ptr.5-6, unsafe.mem.2).
## `extern c fn` of a name in `FFI_NAMES` with the declared C signature is a
## function whose body calls the runtime's `rt.ffi_NAME`; any other symbol
## stays `ffi.native.1`.
use ast

## The C functions the runtime provides, with their declared parameter and
## result types as `examples/ffi_*.ail` write them.
FFI_NAMES := [
    "hypot:float,float:float",
    "abs:i32:i32",
    "toupper:i32:i32",
    "strlen:*u8:int",
    "atoi:*u8:i32",
    "memset:*u8,i32,int:*u8",
    "memcpy:*int,*int,int:*int",
    "strtod:*u8,**u8:float",
]

## The written type of a parameter or result, for comparison with `FFI_NAMES`.
fn ffi_type_text(t ast.TypeRef) str
    match t.shape
        Named(n, _) => n
        PtrTo(inner) => "*{ffi_type_text(inner)}"
        _ => "?"

## `name:params:result` of an `extern c fn`.
fn ffi_signature(f ast.FnDecl) str
    mut ps := ""
    for i in 0..f.params.len()
        if i > 0
            ps = "{ps},"
        ps = "{ps}{ffi_type_text(f.params[i].ty)}"
    r := if t := f.ret then ffi_type_text(t) else ""
    "{f.name}:{ps}:{r}"

## Whether `f` is an `extern c fn` the runtime provides.
fn ffi_known(f ast.FnDecl) bool
    FFI_NAMES.contains(ffi_signature(f))

## The body of a known `extern c fn`: a call of its runtime function.
fn Lower.lower_extern(mut self, f ast.FnDecl, name str, params List[int])
    if is_cb_decl(f)
        lower_cb_body(f, name, params)
        return
    if f.ext == none
        return
    if ffi_known(f)
        r := call("rt.ffi_{f.name}", params, ret)
        finish(return_of(if ret.is_unit() then -1 else r))
        end_fn(name, f.pos)
    else
        lower_extern_dyn(f, name, params)

## `mem.NAME(args)` (unsafe.mem.1-3).
fn Lower.lower_mem_call(mut self, name str, npos ast.Pos, args List[ast.Arg]) Val?
    u8 := Ty.Sized("u8")
    if name == "null" and args.len() == 0
        return Val(id: konst(0, Ty.Ptr(u8)), ty: Ty.Ptr(u8))
    # ffi.cb.3: the C entry of a declared function, as a pointer.
    if name == "c_fn" and args.len() == 1
        a := cb_arg(args[0].value)?
        return Val(id: op("copy", [a.id], Ty.Ptr(u8)), ty: Ty.Ptr(u8))
    if args.len() == 0
        return unsupported(npos, "`mem.{name}`")
    a := lower_value(args[0].value, if name == "alloc" then Ty.Int else none)?
    if name == "cstr" and args.len() == 1 and a.ty == Ty.Str
        return Val(id: call("rt.mem_cstr", [a.id], Ty.Ptr(u8)), ty: Ty.Ptr(u8))
    if name == "from_cstr" and args.len() == 1 and a.ty == Ty.Ptr(u8)
        ptr_trap_unless(
            op("ne", [a.id, konst(0, Ty.Int)], Ty.Bool),
            "unsafe.mem.1",
            "rt.mem_from_null_msg",
            [],
            npos,
        )
        return Val(id: call("rt.mem_from_cstr", [a.id], Ty.Str), ty: Ty.Str)
    if name == "free" and args.len() == 1
        if ptr_target(a.ty) == Ty.Unknown
            return unsupported(npos, "`mem.free` of a `{a.ty.name()}`")
        ptr_trap_unless(
            op("ne", [a.id, konst(0, Ty.Int)], Ty.Bool),
            "unsafe.mem.2",
            "rt.mem_free_null_msg",
            [],
            npos,
        )
        # unsafe.mem.2: a block of the program's own is freed once.
        st := call("rt.memtab_free", [a.id], Ty.Int)
        ptr_trap_unless(
            op("ne", [st, konst(2, Ty.Int)], Ty.Bool),
            "unsafe.mem.2",
            "rt.memtab_double_msg",
            [],
            npos,
        )
        call("rt.mem_free", [a.id], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    if args.len() != 2
        return unsupported(npos, "`mem.{name}`")
    ex := lower_value(args[1].value, none)?
    if not ptr_target_ok(ex.ty)
        return unsupported(npos, "`mem.{name}` with an example of type `{ex.ty.name()}`")
    pt := Ty.Ptr(ex.ty)
    if name == "cast" and ptr_target(a.ty) != Ty.Unknown
        return Val(id: a.id, ty: pt)
    if name != "alloc" or a.ty != Ty.Int
        return unsupported(npos, "`mem.{name}` of a `{a.ty.name()}`")
    size := ptr_size(ex.ty)
    # unsafe.mem.3: a negative count, or one no address space can hold.
    ptr_trap_unless(
        op("ge", [a.id, konst(0, Ty.Int)], Ty.Bool),
        "unsafe.mem.3",
        "rt.mem_range_msg",
        [a.id, konst(size, Ty.Int)],
        npos,
    )
    ptr_trap_unless(
        op("le", [a.id, konst(140737488355328 / size, Ty.Int)], Ty.Bool),
        "unsafe.mem.3",
        "rt.mem_range_msg",
        [a.id, konst(size, Ty.Int)],
        npos,
    )
    p := call("rt.mem_alloc", [op("mul", [a.id, konst(size, Ty.Int)], Ty.Int)], pt)
    if ex.ty == Ty.Bool
        call("rt.mem_fill_bool", [p, a.id, ex.id], Ty.Unit)
        return Val(id: p, ty: pt)
    mut bits := ex.id
    if ex.ty == Ty.Float
        mut f := inst(-1, "prim", [ex.id])
        f.name = "float_bits"
        bits = emit(f, Ty.Int)
    call("rt.mem_fill", [p, a.id, konst(size, Ty.Int), bits], Ty.Unit)
    Val(id: p, ty: pt)
