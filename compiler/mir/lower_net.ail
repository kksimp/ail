## Lowering the raw TCP calls of `std.net` (std.net.12): `net.listen`,
## `net.connect`, and the methods of `net.Listener` and `net.Conn`; and UDP
## (std.net.73-76): `net.udp`, `net.lookup`, the methods of `net.Udp`. Each is a
## call of the runtime in `compiler/rt/native/net.ail`. A call that can fail
## is a fallible function (lower_err.ail): it returns its success value, or
## sets the error slot to a `net.NetError` and returns zero. A `Listener` and
## a `Conn` are structs of one `int` field, a handle the runtime made; the
## runtime builds them, so a failed call returns 0 for the struct as for any
## other value.
use ast

## A runtime function standing for a `std.net` function or method.
struct NetFn
    rt str
    ## Parameters after the receiver.
    params List[Ty]
    ret Ty
    fails bool

fn net_fn(rt str, params List[Ty], ret Ty, fails bool) NetFn
    NetFn(rt: rt, params: params, ret: ret, fails: fails)

## `net.NAME` as a module function, if the native subset has it.
fn net_module_lookup(name str) NetFn?
    match name
        "listen" => net_fn("rt.net_listen", [Ty.Str], Ty.Struct(NET_LISTENER), true)
        "serve" => net_fn("rt.net_listen", [Ty.Str], Ty.Struct(NET_SERVER), true)
        # std.net.46: the TLS forms take the certificate and key files.
        "listen_tls" => net_fn(
            "rt.net_listen_tls",
            [Ty.Str, Ty.Str, Ty.Str],
            Ty.Struct(NET_LISTENER),
            true,
        )
        "listen_tls_alpn" => net_fn(
            "rt.net_listen_tls_alpn",
            [Ty.Str, Ty.Str, Ty.Str, Ty.List(Ty.Str)],
            Ty.Struct(NET_LISTENER),
            true,
        )
        "serve_tls" => net_fn(
            "rt.net_serve_tls",
            [Ty.Str, Ty.Str, Ty.Str],
            Ty.Struct(NET_SERVER),
            true,
        )
        "connect_tls" => net_fn("rt.net_connect_tls", [Ty.Str, Ty.Int], Ty.Struct(NET_CONN), true)
        "connect" => net_fn("rt.net_connect", [Ty.Str, Ty.Int], Ty.Struct(NET_CONN), true)
        "get" => net_fn("rt.net_get", [Ty.Str], Ty.Struct(NET_RESPONSE), true)
        "post" => net_fn("rt.net_post", [Ty.Str, Ty.Str, Ty.Str], Ty.Struct(NET_RESPONSE), true)
        "request" => net_fn(
            "rt.net_request",
            [Ty.Str, Ty.Str, Ty.Struct(NET_OPTIONS)],
            Ty.Struct(NET_RESPONSE),
            true,
        )
        "open" => net_fn(
            "rt.net_open",
            [Ty.Str, Ty.Str, Ty.Struct(NET_OPTIONS)],
            Ty.Struct(NET_BODY),
            true,
        )
        "get_bytes" => net_fn("rt.net_get_bytes", [Ty.Str], Ty.Struct(NET_RAW), true)
        "post_bytes" => net_fn(
            "rt.net_post_bytes",
            [Ty.Str, Ty.Bytes, Ty.Str],
            Ty.Struct(NET_RAW),
            true,
        )
        "request_bytes" => net_fn(
            "rt.net_request_bytes",
            [Ty.Str, Ty.Str, Ty.Struct(NET_OPTIONS)],
            Ty.Struct(NET_RAW),
            true,
        )
        "options" => net_fn("rt.net_options", [], Ty.Struct(NET_OPTIONS), false)
        # std.net.73, std.net.76 (ADR 1239), net_udp.ail.
        "udp" => net_fn("rt.net_udp", [Ty.Str], Ty.Struct(NET_UDP), true)
        "lookup" => net_fn("rt.net_lookup", [Ty.Str], Ty.List(Ty.Str), true)
        _ => none

## `T.NAME` for a method of `net.Conn` or `net.Listener`.
fn net_method_lookup(key str) NetFn?
    s := Ty.Str
    match key
        "net.Conn.read" => net_fn("rt.net_read", [Ty.Int], s, true)
        "net.Conn.read_bytes" => net_fn("rt.net_read_bytes", [Ty.Int], Ty.Bytes, true)
        "net.Conn.write_bytes" => net_fn("rt.net_write", [Ty.Bytes], Ty.Unit, true)
        "net.Conn.read_line" => net_fn("rt.net_read_line", [], Ty.Opt(s), true)
        "net.Conn.write" => net_fn("rt.net_write", [s], Ty.Unit, true)
        "net.Conn.set_timeout" => net_fn("rt.net_set_timeout", [Ty.Int], Ty.Unit, true)
        "net.Conn.start_tls" => net_fn("rt.net_start_tls", [Ty.Str], Ty.Unit, true)
        "net.Conn.peer" => net_fn("rt.net_peer", [], s, false)
        "net.Conn.alpn" => net_fn("rt.net_alpn", [], s, false)
        "net.Conn.close" => net_fn("rt.net_close", [], Ty.Unit, false)
        "net.Server.accept" => net_fn("rt.serve_accept", [], Ty.Struct(NET_EXCHANGE), true)
        "net.Server.addr" => net_fn("rt.net_addr", [], s, false)
        "net.Server.close" => net_fn("rt.net_close", [], Ty.Unit, false)
        "net.Server.shutdown" => net_fn("rt.serve_shutdown", [], Ty.Unit, false)
        "net.Request.stop" => net_fn("rt.serve_shutdown", [], Ty.Unit, false)
        "net.Exchange.hijack" => net_fn("rt.serve_hijack", [], Ty.Struct(NET_CONN), true)
        "net.Exchange.respond" => net_fn(
            "rt.serve_respond",
            [Ty.Struct(NET_RESPONSE)],
            Ty.Unit,
            true,
        )
        "net.Exchange.respond_bytes" => net_fn(
            "rt.serve_respond_bytes",
            [Ty.Int, Ty.Map(key: s, val: s), Ty.Bytes],
            Ty.Unit,
            true,
        )
        "net.Body.read_bytes" => net_fn("rt.open_read", [Ty.Int], Ty.Bytes, true)
        "net.Body.close" => net_fn("rt.open_close", [], Ty.Unit, false)
        "net.Listener.accept" => net_fn("rt.net_accept", [], Ty.Struct(NET_CONN), true)
        "net.Listener.addr" => net_fn("rt.net_addr", [], s, false)
        "net.Listener.close" => net_fn("rt.net_close", [], Ty.Unit, false)
        "net.Udp.send_to" => net_fn("rt.net_udp_send_to", [s, Ty.Bytes], Ty.Unit, true)
        "net.Udp.recv" => net_fn(
            "rt.net_udp_recv",
            [Ty.Int],
            Ty.Opt(Ty.Struct(NET_DATAGRAM)),
            true,
        )
        "net.Udp.addr" => net_fn("rt.net_addr", [], s, false)
        "net.Udp.close" => net_fn("rt.net_close", [], Ty.Unit, false)
        _ => none

## Whether the method `key` can fail with a `net.NetError`.
fn net_method_fails(key str) bool
    f := net_method_lookup(key) else return false
    f.fails

## Whether the module function `net.name` can fail.
fn net_module_fails(name str) bool
    f := net_module_lookup(name) else return false
    f.fails

## `net.NAME(...)`, from `lower_os_method`. `none` after a report.
fn Lower.lower_net_module(mut self, name str, npos ast.Pos, args List[ast.Arg]) Val?
    if structs.contains("net.{name}")
        return new_struct("net.{name}", args, npos)
    f := net_module_lookup(name) else
        return unsupported(npos, "`net.{name}`")
    if name == "request" or name == "request_bytes" or name == "open"
        # The traps of its options (std.net.6, std.net.19) print the call's
        # position, so the runtime gets their texts.
        t6 := trap_texts("std.net.6", npos)
        t19 := trap_texts("std.net.19", npos)
        return self.net_call(f, [], args, npos, [t6[0], t19[0], t6[1]])
    self.net_call(f, [], args, npos, [])

## `x.NAME(...)` on a `net.Conn` or `net.Listener`, from `struct_call`.
fn Lower.lower_net_method(mut self, key str, recv Val?, args List[ast.Arg], pos ast.Pos) Val?
    f := net_method_lookup(key) else
        return unsupported(pos, "calling `{key}`")
    r := recv else return unsupported(pos, "calling `{key}`")
    # The handle is the struct's one field; an `Exchange`'s is its second, and
    # a `Request` names its server in the last.
    word := if key.starts_with("net.Exchange.") then 1 else if key
        == "net.Request.stop" then 7 else if key.starts_with("net.Body.") then 3 else 0
    self.net_call(f, [load(r.id, word, Ty.Int)], args, pos, [])

## Emit the call of `f` with the leading values `lead`, `args`, and the
## trailing values `after`.
fn Lower.net_call(
    mut self,
    f NetFn,
    lead List[int],
    args List[ast.Arg],
    pos ast.Pos,
    after List[int],
) Val?
    if args.len() != f.params.len()
        return unsupported(pos, "this call")
    mut vs := lead
    for i in 0..args.len()
        a := args[i]
        if a.label != none or a.mutable
            return unsupported(pos, "labelled arguments")
        v := lower_value(a.value, f.params[i])?
        vs.push(convert(v, f.params[i], expr_pos(a.value)))
    for v in after
        vs.push(v)
    trace_effect(f.rt, f.params, [vs[k] for k in lead.len()..lead.len() + f.params.len()], pos)
    if f.fails
        vs.push(trace_line(pos))
    if instr.rec
        return rec_net_call(f, vs, pos)
    Val(id: call(f.rt, vs, f.ret), ty: f.ret)
