## `g[i, j]` on the prelude's `Grid[T]` (type.grid.3, ADR 0937): the element
## `i * cols + j` of `g.cells` after a bounds check of each index, and the rest
## (reads, `=`, `op=`, copies, the optimiser's passes) is a list element's.
use ast

## Whether `t` is an instance of the prelude's `Grid`.
fn Lower.is_grid_ty(self, t Ty) bool
    match t
        Struct(n) => (gen.bases.get(n) else "") == "Grid" and lazy.names.contains("Grid")
        _ => false

## A receiver that names one place and calls nothing, so reading it twice is
## reading it once.
fn plain_place(e ast.Expr) bool
    match e
        Name => true
        Member(r, _, _) => plain_place(r)
        _ => false

## `g.cells[~k]` for `g[i, j]` when `recv` is a grid, with `~k` a hidden
## variable holding `i * g.cols + j`, computed now behind two bounds checks
## (`i` against `rows`, `j` against `cols`; type.grid.3), so the product can't
## overflow and the element access is a plain list element's. `none` when
## `recv` isn't a grid.
fn Lower.grid_place(mut self, recv ast.Expr, index ast.Expr, pos ast.Pos) ast.Expr?
    items := match index
        TupleLit(xs, _) => xs
        _ => return none
    if items.len() != 2 or not self.is_grid_ty(recv_ty(recv)?)
        return none
    if not plain_place(recv)
        problem(
            pos,
            "`g[i, j]` on a grid that isn't a variable or a field isn't in the native subset yet",
        )
        return none
    i := lower_value(items[0], Ty.Int)?
    j := lower_value(items[1], Ty.Int)?
    rows := lower_value(ast.Expr.Member(recv: recv, name: "rows", name_pos: pos), Ty.Int)?
    cols := lower_value(ast.Expr.Member(recv: recv, name: "cols", name_pos: pos), Ty.Int)?
    self.grid_bound(i.id, rows.id, pos)
    self.grid_bound(j.id, cols.id, pos)
    at := op("add", [op("mul", [i.id, cols.id], Ty.Int), j.id], Ty.Int)
    name := "~g{nvars}"
    declare(name, Ty.Int, at)
    ast.Expr.Index(
        recv: ast.Expr.Member(recv: recv, name: "cells", name_pos: pos),
        index: ast.Expr.Name(name: name, pos: pos),
        pos: pos,
    )

## Trap (type.coll.4) unless `0 <= x < n`.
fn Lower.grid_bound(mut self, x int, n int, pos ast.Pos)
    mut b := inst(-1, "bounds", [x, n])
    b.site = bounds_site(pos)
    emit_void(b)

## The type of `x[...]` where `x` is a `t`: a grid's element, else a list's.
fn Lower.index_ty(self, t Ty) Ty?
    if self.is_grid_ty(t)
        match t
            Struct(n) => return gen.targs.get(n)?[0]
            _ => return none
    t.elem()
