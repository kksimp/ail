## Cleaning up freshly lowered MIR (ADR 0384): parameters that receive one
## value everywhere are replaced by it (Braun et al.'s trivial phis), blocks
## nothing reaches are dropped, and pure instructions whose values nobody
## reads are removed.

pub fn simplify(f Func) Func
    mut g := f
    simplify_in(mut g)
    g

## `simplify` in place, for a caller that has no use for the old function.
## The passes edit `g` instead of each making a copy of it.
pub fn simplify_in(mut g Func)
    fold_const_branches(mut g)
    drop_unreachable(mut g)
    remove_trivial_params(mut g)
    branch_on_inner(mut g)
    thread_bools(mut g)
    drop_unreachable(mut g)
    remove_dead(mut g)

## A branch on a constant (a test a range fact settled, or the arm of an
## inlined callee that can't run) becomes a jump to the edge it takes.
fn fold_const_branches(mut g Func)
    mut consts := Map[int, int]()
    for blk in g.blocks
        for i in blk.insts
            if i.op == "const" and i.dst >= 0
                consts[i.dst] = i.imm
    for b in 0..g.blocks.len()
        t := g.blocks[b].term
        if t.kind != "branch" or t.targets.len() != 2
            continue
        c := consts.get(t.cond) else continue
        e := if c != 0 then 0 else 1
        g.blocks[b].term = jump_to(t.targets[e], t.args[e])

fn resolve(repl List[int], v int) int
    mut x := v
    while repl[x] != x
        x = repl[x]
    x

## Parameters that receive one value on every edge are replaced by it. The
## edges into each block are listed once (`from_block`, `from_edge`): only
## their arguments are removed, never the edges.
fn remove_trivial_params(mut g Func)
    n := g.blocks.len()
    mut from_block := [List[int]() for _ in 0..n]
    mut from_edge := [List[int]() for _ in 0..n]
    for q in 0..n
        for e in 0..g.blocks[q].term.targets.len()
            t := g.blocks[q].term.targets[e]
            from_block[t].push(q)
            from_edge[t].push(e)
    mut repl := [i for i in 0..g.vals.len()]
    mut changed := true
    while changed
        changed = false
        for b in 1..n
            mut k := 0
            while k < g.blocks[b].params.len()
                p := g.blocks[b].params[k]
                mut only := -1
                mut many := false
                for j in 0..from_block[b].len()
                    x := resolve(repl, g.blocks[from_block[b][j]].term.args[from_edge[b][j]][k])
                    if x == p or x == only
                        continue
                    if only < 0
                        only = x
                    else
                        many = true
                        break
                if many or only < 0
                    k += 1
                    continue
                repl[p] = only
                g.blocks[b].params.remove_at(k)
                for j in 0..from_block[b].len()
                    g.blocks[from_block[b][j]].term.args[from_edge[b][j]].remove_at(k)
                changed = true
    final := [resolve(repl, v) for v in 0..repl.len()]
    for b in 0..g.blocks.len()
        for i in 0..g.blocks[b].insts.len()
            g.blocks[b].insts[i] = g.blocks[b].insts[i].with_args([
                final[a]
                for a in g.blocks[b].insts[i].operands()
            ])
        mut t := g.blocks[b].term
        if t.cond >= 0
            t.cond = final[t.cond]
        if t.value >= 0
            t.value = final[t.value]
        t.args = [[final[a] for a in edge] for edge in t.args]
        g.blocks[b].term = t

## A branch on `not c` branches on `c` with its two edges swapped (ADR 0623),
## so `while not done` costs a test and a jump, not a flip and a test.
fn branch_on_inner(mut g Func)
    mut negated := Map[int, int]()
    for blk in g.blocks
        for i in blk.insts
            if i.op == "not" and i.dst >= 0
                negated[i.dst] = i.arg(0)
    for b in 0..g.blocks.len()
        mut t := g.blocks[b].term
        if t.kind != "branch" or not negated.contains(t.cond)
            continue
        t.cond = negated[t.cond]
        t.targets = [t.targets[1], t.targets[0]]
        t.args = [t.args[1], t.args[0]]
        g.blocks[b].term = t

## A block that only branches on its one `bool` parameter (what `a or b` and
## `a and b` lower to) is bypassed (ADR 0623): an edge that passes a constant
## goes straight to the matching target, and a jump that passes removed other
## value branches on it, so a comparison feeds a branch and not a flag that
## is made, tested and thrown away.
fn thread_bools(mut g Func)
    n := g.blocks.len()
    mut uses := [0 for _ in 0..g.vals.len()]
    mut consts := Map[int, int]()
    for blk in g.blocks
        for i in blk.insts
            for u in i.operands()
                uses[u] += 1
            if i.op == "const" and i.dst >= 0
                consts[i.dst] = i.imm
        for u in blk.term.uses()
            uses[u] += 1
    for b in 1..n
        if g.blocks[b].params.len() != 1
            or g.blocks[b].insts.len() != 0
            or g.blocks[b].term.kind != "branch"
            continue
        p := g.blocks[b].params[0]
        t := g.blocks[b].term
        if t.cond != p or uses[p] != 1 or g.vals[p] != Ty.Bool
            continue
        if t.args[0].len() != 0 or t.args[1].len() != 0 or t.targets[0] == b or t.targets[1] == b
            continue
        for q in 0..n
            if q == b
                continue
            mut qt := g.blocks[q].term
            mut changed := false
            for e in 0..qt.targets.len()
                if qt.targets[e] != b
                    continue
                arg := qt.args[e][0]
                if v := consts.get(arg)
                    qt.targets[e] = if v != 0 then t.targets[0] else t.targets[1]
                    qt.args[e] = []
                    changed = true
                elif qt.kind == "jump"
                    qt = Term(
                        kind: "branch",
                        cond: arg,
                        targets: [t.targets[0], t.targets[1]],
                        args: [[], []],
                        value: -1,
                    )
                    changed = true
                    break
            if changed
                g.blocks[q].term = qt

fn drop_unreachable(mut g Func)
    mut seen := [false for _ in 0..g.blocks.len()]
    mut work := [0]
    seen[0] = true
    while work.len() > 0
        w := work.pop() else 0
        for s in g.blocks[w].term.targets
            if not seen[s]
                seen[s] = true
                work.push(s)
    mut map := [-1 for _ in 0..g.blocks.len()]
    mut n := 0
    for b in 0..g.blocks.len()
        if seen[b]
            map[b] = n
            n += 1
    if n == g.blocks.len()
        return
    mut blocks := List[Block]()
    for b in 0..g.blocks.len()
        if seen[b]
            mut blk := g.blocks[b]
            blk.term.targets = [map[t] for t in blk.term.targets]
            blocks.push(blk)
    g.blocks = blocks

## Pure instructions whose value nobody reads are removed, and so, in turn,
## those that only fed them: a use count per value and a stack of the values
## that reached zero, instead of a pass over the function per layer.
fn remove_dead(mut g Func)
    nb := g.blocks.len()
    mut uses := [0 for _ in 0..g.vals.len()]
    mut def_block := [-1 for _ in 0..g.vals.len()]
    mut def_inst := [-1 for _ in 0..g.vals.len()]
    mut work := List[int]()
    for b in 0..nb
        for i in 0..g.blocks[b].insts.len()
            for u in g.blocks[b].insts[i].operands()
                uses[u] += 1
            d := g.blocks[b].insts[i].dst
            if d >= 0
                def_block[d] = b
                def_inst[d] = i
        for u in g.blocks[b].term.uses()
            uses[u] += 1
    for v in 0..uses.len()
        if uses[v] == 0 and def_block[v] >= 0
            work.push(v)
    mut dead := [[false for _ in g.blocks[b].insts] for b in 0..nb]
    mut removed := false
    while work.len() > 0
        v := work.pop() else 0
        b := def_block[v]
        i := def_inst[v]
        if dead[b][i] or uses[v] != 0
            continue
        ins := g.blocks[b].insts[i]
        if not ins.is_pure()
            continue
        dead[b][i] = true
        removed = true
        for u in ins.operands()
            uses[u] -= 1
            if uses[u] == 0 and def_block[u] >= 0
                work.push(u)
    if not removed
        return
    for b in 0..nb
        mut keep := List[Inst]()
        for i in 0..g.blocks[b].insts.len()
            if not dead[b][i]
                keep.push(g.blocks[b].insts[i])
        g.blocks[b].insts = keep
