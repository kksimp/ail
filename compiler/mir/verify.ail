## The MIR verifier (ADR 0384, ADR 0018's miscompilation defence): run after
## lowering and after every pass. It checks that each value is defined
## once, every use is dominated by its definition, every edge passes as many
## arguments as its target has parameters, of the same types, and that
## operands have the types their operations need.

## The problems found, as `FUNC: message`; empty when the function is sound.
pub fn verify(f Func) List[str]
    mut errs := List[str]()
    n := f.blocks.len()
    mut def_block := [-1 for _ in 0..f.vals.len()]
    mut def_index := [-1 for _ in 0..f.vals.len()]
    for b in 0..n
        for p in f.blocks[b].params
            if def_block[p] >= 0
                errs.push("{f.name}: v{p} is defined twice")
            def_block[p] = b
            def_index[p] = -1
        insts := f.blocks[b].insts
        for k in 0..insts.len()
            d := insts[k].dst
            if d >= 0
                if def_block[d] >= 0
                    errs.push("{f.name}: v{d} is defined twice")
                def_block[d] = b
                def_index[d] = k
    if f.params != f.blocks[0].params
        errs.push("{f.name}: the entry block's parameters aren't the function's")
    dom := dominators(f)
    for b in 0..n
        blk := f.blocks[b]
        for k in 0..blk.insts.len()
            i := blk.insts[k]
            for u in i.operands()
                check_use(f, dom, def_block, def_index, u, b, k, mut errs)
            check_types(f, i, mut errs)
        for u in blk.term.uses()
            check_use(f, dom, def_block, def_index, u, b, blk.insts.len(), mut errs)
        for e in 0..blk.term.targets.len()
            t := blk.term.targets[e]
            args := blk.term.args[e]
            params := f.blocks[t].params
            if args.len() != params.len()
                errs.push("{f.name}: b{b} passes {args.len()} values to b{t}, which has {params.len()} parameters")
                continue
            for j in 0..args.len()
                if register_kind(f.vals[args[j]]) != register_kind(f.vals[params[j]])
                    errs.push("{f.name}: b{b} passes a {f.vals[args[j]].name()} to b{t}'s {f.vals[params[j]].name()}")
        if blk.term.kind == "branch" and blk.term.targets[0] == blk.term.targets[1]
            errs.push("{f.name}: b{b} branches twice to b{blk.term.targets[0]}")
        if blk.term.kind == "return"
            if f.ret.is_unit() != (blk.term.value < 0)
                errs.push("{f.name}: b{b} returns the wrong kind of value")
    errs

## The kind of register a value lives in: a `char` is an `int` (type.char.1).
fn register_kind(t Ty) str
    if t == Ty.Char or t.is_sized() or t.name().starts_with("*")
        return "int"
    # Every `T?` is one pointer-or-0 register; a `none` still typed `??` passes to any of them.
    if t.opt_inner() != none
        return "opt"
    if t == Ty.F32
        return "float"
    t.name()

fn check_use(
    f Func,
    dom List[List[bool]],
    db List[int],
    di List[int],
    u int,
    b int,
    k int,
    mut errs List[str],
)
    if u < 0 or u >= f.vals.len() or db[u] < 0
        errs.push("{f.name}: b{b} uses v{u}, which is never defined")
        return
    if db[u] == b
        if di[u] >= k
            errs.push("{f.name}: b{b} uses v{u} before defining it")
        return
    if not dom[b][db[u]]
        errs.push("{f.name}: v{u} (defined in b{db[u]}) doesn't dominate its use in b{b}")

fn check_types(f Func, i Inst, mut errs List[str])
    want := match i.op
        "add" | "sub" | "mul" | "div" | "rem" | "neg" | "itof" | "lt" | "le" | "gt" | "ge" => "int"
        "band" | "bor" | "bxor" | "bnot" | "shl" | "shr" => "int"
        "fadd" | "fsub" | "fmul" | "fdiv" | "fneg" | "ftoi" | "sqrt" | "abs" | "floor" | "ceil" => "float"
        "feq" | "fne" | "flt" | "fle" | "fgt" | "fge" => "float"
        "not" => "bool"
        "vfadd" | "vfsub" | "vfmul" | "vfdiv" | "vlane" | "vhadd" => "float2"
        "vsplat" | "vpack" => "float"
        _ => ""
    if want == ""
        return
    for a in i.operands()
        # A `char` is an `int` in a register (type.char.1).
        have := register_kind(f.vals[a])
        # The lane operations take a `Vec4` too (native.vec.5).
        if have != want and not (want == "float2" and have == "float4")
            errs.push("{f.name}: `{i.op}` on a {f.vals[a].name()} (v{a})")

## `dom[b][d]`: block `d` dominates block `b` (native.build.1, ADR 0656). Immediate dominators come
## from the Cooper-Harvey-Kennedy iteration over the reverse postorder, then
## each row is its immediate dominator's row plus the block itself, so a
## function costs a few passes over its blocks and one list copy per block.
## A block the entry can't reach has every `d` true, as the plain data-flow
## formulation leaves it.
pub fn dominators(f Func) List[List[bool]]
    n := f.blocks.len()
    mut preds := [List[int]() for _ in 0..n]
    for b in 0..n
        for t in f.blocks[b].term.targets
            preds[t].push(b)
    # Postorder numbers by a depth-first walk from the entry.
    mut post := [-1 for _ in 0..n]
    mut order := List[int]()
    mut seen := [false for _ in 0..n]
    mut taken := [0 for _ in 0..n]
    mut stack := [0]
    seen[0] = true
    while stack.len() > 0
        b := stack[stack.len() - 1]
        ts := f.blocks[b].term.targets
        if taken[b] < ts.len()
            t := ts[taken[b]]
            taken[b] += 1
            if not seen[t]
                seen[t] = true
                stack.push(t)
        else
            post[b] = order.len()
            order.push(b)
            stack.pop()
    mut idom := [-1 for _ in 0..n]
    idom[0] = 0
    mut changed := true
    while changed
        changed = false
        for j in 1..order.len()
            b := order[order.len() - 1 - j]
            mut pick := -1
            for p in preds[b]
                if idom[p] >= 0
                    if pick < 0
                        pick = p
                    else
                        mut x := p
                        mut y := pick
                        while x != y
                            while post[x] < post[y]
                                x = idom[x]
                            while post[y] < post[x]
                                y = idom[y]
                        pick = x
            if idom[b] != pick
                idom[b] = pick
                changed = true
    mut dom := [[true for _c in 0..n] for _r in 0..n]
    dom[0] = [d == 0 for d in 0..n]
    for j in 1..order.len()
        b := order[order.len() - 1 - j]
        mut row := dom[idom[b]]
        row[b] = true
        dom[b] = row
    dom
