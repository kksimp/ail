## Inlining beyond leaves (ADR 0940, rule native.inline.1): a function that
## calls others may be copied into its callers too, by a cost model over the
## call graph, within a size budget. A function with one call in the whole
## program goes inline there up to `SINGLE_LIMIT` instructions when that
## call is inside a loop of the caller (a hot site): the copy replaces the
## only use, and the function is dropped. Any other goes up to `WIDE_LIMIT`,
## also only at a hot site. A call made once (`size()` at the top of `main`)
## gains nothing copied, and measured slower (collatz, sieve +7%).
## Those copies may grow a caller by at most its own size (2x) and
## `CALLER_GROWTH`, and the program by at most `PROGRAM_GROWTH` percent. A
## function on a cycle of the call graph never goes (its body could copy
## itself without end), nor one with a loop (measured slower copied). The
## calls a copy brings with it keep the frames they stand for (trace.frame.2).
## `AIL_OPT_OFF=wide` turns it off.

## A function called from one place goes inline up to this many instructions.
SINGLE_LIMIT := 200

## Any other function that calls others goes inline up to this many.
WIDE_LIMIT := 12

## How many instructions one caller may grow by through these copies.
CALLER_GROWTH := 200

## How much, in percent of its instructions, the program may grow by them.
PROGRAM_GROWTH := 10

## The candidates: each one's instruction count, and those called from one
## place (whose copy replaces the call).
pub struct Wide
    pub sizes Map[str, int]
    pub single Set[str]

pub fn wide_candidates(m Module, leaves Set[str]) Wide
    mut out := Wide(sizes: Map[str, int](), single: Set[str]())
    # `--values` and `--trace` builds keep one frame per call.
    instr := env.get("AIL_INSTRUMENT") else ""
    if opt_off("wide") or opt_off("inline") or instr != ""
        return out
    rec := recursive_names(m)
    mut calls := Map[str, int]()
    mut taken := Set[str]()
    for f in m.funcs
        for blk in f.blocks
            for i in blk.insts
                if i.op == "call"
                    c := calls.get(i.name) else 0
                    calls[i.name] = c + 1
                elif i.op == "fnaddr"
                    taken.add(i.name)
    for f in m.funcs
        if leaves.contains(f.name) or rec.contains(f.name)
            continue
        n := wide_size(f)
        if n < 0
            continue
        c := calls.get(f.name) else 0
        single := c == 1 and not taken.contains(f.name)
        # A function with a loop stays a call: the call costs little beside the
        # loop, and copied into a caller the loop measured slower (matmul 2x,
        # spectralnorm 1.7x on ail-linux), so only straight-line code goes.
        if (n <= WIDE_LIMIT or single and n <= SINGLE_LIMIT) and find_loops(f).len() == 0
            out.sizes[f.name] = n
            if single
                out.single.add(f.name)
    out

## The instructions the program may grow by through wide copies.
pub fn wide_allowance(m Module) int
    mut n := 0
    for f in m.funcs
        for blk in f.blocks
            n += blk.insts.len()
    n * PROGRAM_GROWTH / 100

## A function's instruction count, or -1 when it may not be copied: the
## runtime's own functions and `main`, an indirect call, a primitive that
## reads its own frame or makes a thread, a jump back to its entry, or a loop.
fn wide_size(f Func) int
    if f.name.starts_with("rt.") or f.name == "main"
        return -1
    mut n := 0
    for blk in f.blocks
        n += blk.insts.len()
        for i in blk.insts
            if i.op == "icall"
                return -1
            if i.op == "prim" and frame_prim(i.name)
                return -1
        for t in blk.term.targets
            if t == 0
                return -1
    n

fn frame_prim(name str) bool
    match name
        "syscall" | "clone" | "sp" | "frame_ptr" | "restart" | "gc_regs" | "code_tab" => true
        _ => false

## Inline the calls of `f` that name a function in `leaves`, or in `wide`
## under the cost model, at a hot call (in a loop of `f`): the one call of a
## single-call function, written in `f` itself, or any other while `f` may
## still grow and `left`, the program's allowance, lasts. At most `INLINE_BUDGET` calls;
## returns the call budget left.
fn expand_wide(
    mut f Func,
    leaves Set[str],
    wide Wide,
    bodies Map[str, Func],
    mut sites List[Site],
    mut left int,
) int
    mut budget := INLINE_BUDGET
    mut size := 0
    for blk in f.blocks
        size += blk.insts.len()
    mut room := CALLER_GROWTH.min(size)
    mut hot := [false for _ in 0..f.blocks.len()]
    if calls_wide(f, wide)
        for lp in find_loops(f)
            for b in 0..f.blocks.len()
                if lp.member[b]
                    hot[b] = true
    mut changed := true
    while changed and budget > 0
        changed = false
        for b in 0..f.blocks.len()
            at := first_wide_call(f.blocks[b], leaves, wide, f.name, room.min(left), hot[b], sites)
            if at >= 0
                name := f.blocks[b].insts[at].name
                before := f.blocks.len()
                inline_call(mut f, b, at, bodies[name], mut sites)
                # The callee's blocks and the rest of `b` are as hot as `b`.
                for _ in before..f.blocks.len()
                    hot.push(hot[b])
                if n := wide.sizes.get(name)
                    if not wide.single.contains(name)
                        room -= n
                        left -= n
                budget -= 1
                changed = true
                break
    budget

## Whether `f` calls a candidate, which only a hot site takes (finding the
## loops costs a dominator tree, so only then).
fn calls_wide(f Func, wide Wide) bool
    if f.name.starts_with("rt.")
        return false
    for blk in f.blocks
        for i in blk.insts
            if i.op == "call" and wide.sizes.contains(i.name)
                return true
    false

fn first_wide_call(
    blk Block,
    leaves Set[str],
    wide Wide,
    self_name str,
    room int,
    hot bool,
    sites List[Site],
) int
    for k in 0..blk.insts.len()
        i := blk.insts[k]
        if i.op == "call" and i.name != self_name
            if leaves.contains(i.name)
                return k
            if n := wide.sizes.get(i.name)
                # Copies of the one call (brought in by another copy) count as
                # any other call, so the function still goes inline once.
                written := i.site < 0 or sites[i.site].from < 0
                if wide.single.contains(i.name) and written and hot
                    return k
                if hot and n <= WIDE_LIMIT and n <= room
                    return k
    -1

## Remove the functions of `wide` that nothing calls or names any more (each
## of their calls went inline), so a function inlined at its one call is not
## also kept whole.
fn drop_unused(mut m Module, wide Map[str, int])
    if wide.len() == 0
        return
    mut named := Set[str]()
    for f in m.funcs
        for blk in f.blocks
            for i in blk.insts
                if i.op == "call" or i.op == "fnaddr"
                    named.add(i.name)
                elif i.op == "prim" and i.name.starts_with("fn_addr:")
                    named.add(i.name.replace("fn_addr:", ""))
    mut kept := List[Func]()
    for f in m.funcs
        if not wide.contains(f.name) or named.contains(f.name)
            kept.push(f)
    m.funcs = kept
