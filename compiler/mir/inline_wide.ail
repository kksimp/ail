## Inlining beyond leaves (ADR 0940, rule native.inline.1): a function that
## calls others may be copied into its callers too, by a cost model over the
## call graph. A function with one call in the whole program goes inline up
## to `SINGLE_LIMIT` instructions, since the copy replaces the only use; any
## other up to `WIDE_LIMIT`; and each caller may grow by at most
## `CALLER_GROWTH` instructions through these copies. A function on a cycle
## of the call graph never goes (its body could copy itself without end), nor
## one whose address is taken when only its single call would justify it.
## The calls a copy brings with it keep the frames they stand for
## (trace.frame.2). `AIL_OPT_OFF=wide` turns it off.

## A function called from one place goes inline up to this many instructions.
SINGLE_LIMIT := 200

## Any other function that calls others goes inline up to this many.
WIDE_LIMIT := 30

## How many instructions one caller may grow by through these copies.
CALLER_GROWTH := 400

## The functions that may go inline although they call others, by name, with
## their instruction counts.
pub fn wide_candidates(m Module, leaves Set[str]) Map[str, int]
    mut out := Map[str, int]()
    # `--values` and `--trace` builds keep one frame per call.
    instr := env.get("AIL_INSTRUMENT") else ""
    if opt_off("wide") or opt_off("inline") or instr != ""
        return out
    rec := recursive_names(m)
    mut calls := Map[str, int]()
    mut taken := Set[str]()
    for f in m.funcs
        for blk in f.blocks
            for i in blk.insts
                if i.op == "call"
                    c := calls.get(i.name) else 0
                    calls[i.name] = c + 1
                elif i.op == "fnaddr"
                    taken.add(i.name)
    for f in m.funcs
        if leaves.contains(f.name) or rec.contains(f.name)
            continue
        n := wide_size(f)
        if n < 0
            continue
        c := calls.get(f.name) else 0
        single := c == 1 and not taken.contains(f.name)
        if n <= WIDE_LIMIT or single and n <= SINGLE_LIMIT
            out[f.name] = n
    out

## A function's instruction count, or -1 when it may not be copied: the
## runtime's own functions and `main`, an indirect call, a primitive that
## reads its own frame or makes a thread, or a jump back to its entry.
fn wide_size(f Func) int
    if f.name.starts_with("rt.") or f.name == "main"
        return -1
    mut n := 0
    for blk in f.blocks
        n += blk.insts.len()
        for i in blk.insts
            if i.op == "icall"
                return -1
            if i.op == "prim" and frame_prim(i.name)
                return -1
        for t in blk.term.targets
            if t == 0
                return -1
    n

fn frame_prim(name str) bool
    match name
        "syscall" | "clone" | "sp" | "frame_ptr" | "restart" | "gc_regs" | "code_tab" => true
        _ => false

## Inline the calls of `f` that name a function in `leaves` or in `wide`
## (with its size), at most `INLINE_BUDGET` calls and `CALLER_GROWTH`
## instructions from `wide`; returns the call budget left.
fn expand_wide(
    mut f Func,
    leaves Set[str],
    wide Map[str, int],
    bodies Map[str, Func],
    mut sites List[Site],
) int
    mut budget := INLINE_BUDGET
    mut grown := 0
    mut changed := true
    while changed and budget > 0
        changed = false
        for b in 0..f.blocks.len()
            at := first_wide_call(f.blocks[b], leaves, wide, f.name, CALLER_GROWTH - grown)
            if at >= 0
                name := f.blocks[b].insts[at].name
                inline_call(mut f, b, at, bodies[name], mut sites)
                if n := wide.get(name)
                    grown += n
                budget -= 1
                changed = true
                break
    budget

fn first_wide_call(blk Block, leaves Set[str], wide Map[str, int], self_name str, room int) int
    for k in 0..blk.insts.len()
        i := blk.insts[k]
        if i.op == "call" and i.name != self_name
            if leaves.contains(i.name)
                return k
            if n := wide.get(i.name)
                if n <= room
                    return k
    -1

## Remove the functions of `wide` that nothing calls or names any more (each
## of their calls went inline), so a function inlined at its one call is not
## also kept whole.
fn drop_unused(mut m Module, wide Map[str, int])
    if wide.len() == 0
        return
    mut named := Set[str]()
    for f in m.funcs
        for blk in f.blocks
            for i in blk.insts
                if i.op == "call" or i.op == "fnaddr"
                    named.add(i.name)
                elif i.op == "prim" and i.name.starts_with("fn_addr:")
                    named.add(i.name.replace("fn_addr:", ""))
    mut kept := List[Func]()
    for f in m.funcs
        if not wide.contains(f.name) or named.contains(f.name)
            kept.push(f)
    m.funcs = kept
