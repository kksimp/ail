## Optionals, results and error propagation (ADRs 0574-0576).
##
## `T?` is one register: a pointer, or 0 for `none`. A string or a list is
## its own pointer; an `int`, `float` or `bool` is boxed in 8 bytes
## (`rt.box*`). A function that can fail (`T ! E`, `! E`, `!`) returns its
## success value, and signals failure through the runtime's error slot,
## which holds the error's display text and is 0 otherwise. A call of such
## a function is followed by `rt.failed()`; `?` and `else` branch on it.
## The error types of this slice are `error struct`s with a message and no
## fields: the error is its message (a `str`).
use ast

pub fn Ty.opt_inner(self) Ty?
    match self
        Opt(t) => t
        _ => none

## `T?` for a type the subset can hold in an optional. A `T??` boxes the inner
## optional in a pointer-holding cell, so `some(none)` differs from `none`.
fn opt_of(t Ty) Ty?
    match t
        Int | Float | F32 | Bool | Char | Sized(_) | Str | Bytes | List | Map | Set | Struct | Enum | Tuple | Tensor | Ref | Opt(_) => Ty.Opt(t)
        _ => none

fn is_boxed(t Ty) bool
    match t
        Int | Float | F32 | Bool | Char | Sized(_) => true
        _ => false

## The zero of a type: the value a failing function returns, and `none`.
fn Lower.zero_of(mut self, t Ty) int
    match t
        Unit => -1
        Float | F32 => fconst(0.0)
        _ => konst(0, t)

fn written_name(t ast.TypeRef) str?
    match t.shape
        Named(n, _) => n
        _ => none

fn is_fallible(t ast.TypeRef) bool
    match t.shape
        Fallible => true
        _ => false

## The success type of a written return type `T ! E`: `Unit` without one.
fn Lower.ok_type(mut self, t ast.TypeRef) Ty?
    match t.shape
        Fallible(ok, _) =>
            o := ok else return Ty.Unit
            # `! E` is written like `!T`; an error type there is the error (err.type.7).
            if n := written_name(o)
                if self.names_error(n)
                    return Ty.Unit
            type_of(o)
        _ => none

# ---- optionals ----

## `some(v)`: the value as a `T?`.
fn Lower.some(mut self, v Val) Val
    t := opt_of(v.ty) else return v
    match v.ty
        Int | Char | Sized(_) => Val(id: call("rt.box", [v.id], t), ty: t)
        Float | F32 => Val(id: call("rt.boxf", [v.id], t), ty: t)
        Bool => Val(id: call("rt.box_bool", [v.id], t), ty: t)
        Opt(_) =>
            raw := call("rt.box_opt", [v.id], Ty.Int)
            Val(id: op("copy", [raw], t), ty: t)
        Enum(n) =>
            # A fieldless enum is an `int` tag, and tag 0 is a value: box it.
            if is_flat(n)
                return Val(id: call("rt.box", [v.id], t), ty: t)
            Val(id: op("copy", [v.id], t), ty: t)
        _ => Val(id: op("copy", [v.id], t), ty: t)

## The value inside a present optional.
fn Lower.unwrap(mut self, o Val) Val
    t := o.ty.opt_inner() else return o
    match t
        Int | Char | Sized(_) => Val(id: call("rt.unbox", [o.id], t), ty: t)
        Float | F32 => Val(id: call("rt.unboxf", [o.id], t), ty: t)
        Bool => Val(id: call("rt.unbox_bool", [o.id], t), ty: t)
        Opt(_) =>
            raw := call("rt.unbox", [o.id], Ty.Int)
            Val(id: op("copy", [raw], t), ty: t)
        Enum(n) =>
            if is_flat(n)
                tag := call("rt.unbox", [o.id], Ty.Int)
                return Val(id: op("copy", [tag], t), ty: t)
            Val(id: op("copy", [o.id], t), ty: t)
        _ => Val(id: op("copy", [o.id], t), ty: t)

## `v` where an optional of type `want` is expected (a plain value is `some`).
fn Lower.convert_opt(mut self, v Val, want Ty, pos ast.Pos) int
    inner := want.opt_inner() else return v.id
    if v.ty.opt_inner() != none
        if inner.opt_inner() != none and same_ty(v.ty, inner)
            return self.some(v).id
        if not same_ty(v.ty, want)
            problem(pos, "expected `{want.name()}`, found `{v.ty.name()}`")
        return v.id
    if inner.opt_inner() != none and same_ty(v.ty, inner.opt_inner() else Ty.Unknown)
        return self.convert_opt(self.some(v), want, pos)
    if not same_ty(v.ty, inner)
        problem(pos, "expected `{want.name()}`, found `{v.ty.name()}`")
        return v.id
    self.some(v).id

fn Lower.lower_none(mut self, want Ty?, pos ast.Pos) Val?
    w := want else Ty.Opt(Ty.Unknown)
    if w.opt_inner() == none
        return unsupported(pos, "`none` where no optional is expected")
    Val(id: konst(0, w), ty: w)

fn is_none_lit(e ast.Expr) bool
    match e
        NoneLit => true
        _ => false

## `x == none` and `x != none`.
fn Lower.lower_none_cmp(mut self, o ast.BinOp, lhs ast.Expr, rhs ast.Expr, pos ast.Pos) Val?
    other := if is_none_lit(rhs) then lhs else rhs
    if is_none_lit(other)
        return unsupported(pos, "`none == none`")
    name := match o
        Eq => "eq"
        Ne => "ne"
        _ => return unsupported(pos, "this operator on `none`")
    a := lower_value(other, none)?
    if a.ty.opt_inner() == none
        return unsupported(pos, "comparing a `{a.ty.name()}` with `none`")
    Val(id: op(name, [a.id, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)

## Whether `a == b` is the comparison of an optional with an optional or with
## a plain value of its type (`x == 'h'`, `a == b` on two `str?`).
fn opt_comparable(a Ty, b Ty) bool
    x := a.opt_inner() else a
    y := b.opt_inner() else b
    same_ty(x, y)

## Printing a `T?`: `none`, or the value as a plain `T`.
fn Lower.out_opt(mut self, v Val, pos ast.Pos) Val?
    inner := v.ty.opt_inner() else return unsupported(pos, "printing a `{v.ty.name()}`")
    if inner.is_unknown()
        return unsupported(pos, "printing a `{v.ty.name()}`")
    absent := new_block()
    present := new_block()
    join := new_block()
    branch(op("eq", [v.id, konst(0, Ty.Int)], Ty.Bool), absent, [], present, [])
    seal(absent)
    cur = absent
    call("rt.out_str", [str_value("none")], Ty.Unit)
    jump(join, [])
    seal(present)
    cur = present
    u := self.unwrap(v)
    if inner.opt_inner() != none
        # `some(none)` of an `int??` prints as such; a present inner prints as itself.
        hollow := new_block()
        full := new_block()
        branch(op("eq", [u.id, konst(0, Ty.Int)], Ty.Bool), hollow, [], full, [])
        seal(hollow)
        cur = hollow
        call("rt.out_str", [str_value("some(none)")], Ty.Unit)
        jump(join, [])
        seal(full)
        cur = full
        self.out_opt(u, pos)?
        jump(join, [])
    else
        out(u, pos)?
        jump(join, [])
    seal(join)
    cur = join
    Val(id: -1, ty: Ty.Unit)

## `a == b` (`negate` false) or `a != b` where one side or both are optionals:
## a `none` equals only a `none`, and two present values compare as plain ones.
fn Lower.opt_compare(mut self, negate bool, a Val, b Val, pos ast.Pos) Val
    r := new_value(Ty.Bool, "")
    join := new_block()
    blocks[join].params.push(r)
    no := konst(0, Ty.Bool)
    if a.ty.opt_inner() == none or b.ty.opt_inner() == none
        # One side is plain: a `none` on the other is not equal to it.
        o := if a.ty.opt_inner() == none then b else a
        other := if a.ty.opt_inner() == none then a else b
        present := new_block()
        branch(op("ne", [o.id, konst(0, Ty.Int)], Ty.Bool), present, [], join, [no])
        seal(present)
        cur = present
        v := self.unwrap(o)
        e := if a.ty.opt_inner() == none then binary(
            Eq,
            other,
            v,
            pos,
        ) else binary(Eq, v, other, pos)
        jump(join, [e.id])
    else
        a_none := new_block()
        a_some := new_block()
        branch(op("eq", [a.id, konst(0, Ty.Int)], Ty.Bool), a_none, [], a_some, [])
        seal(a_none)
        cur = a_none
        jump(join, [op("eq", [b.id, konst(0, Ty.Int)], Ty.Bool)])
        seal(a_some)
        cur = a_some
        both := new_block()
        branch(op("ne", [b.id, konst(0, Ty.Int)], Ty.Bool), both, [], join, [no])
        seal(both)
        cur = both
        e := binary(Eq, self.unwrap(a), self.unwrap(b), pos)
        jump(join, [e.id])
    seal(join)
    cur = join
    if negate
        return Val(id: op("not", [r], Ty.Bool), ty: Ty.Bool)
    Val(id: r, ty: Ty.Bool)

# ---- results ----

fn Lower.trace_line(mut self, pos ast.Pos) int
    str_value("  at {path}:{pos.line}:{pos.col}")

## Whether `e` builds a value of an error type: `E(...)`, `E.V`, `E.V(...)`
## or a bare variant of an error enum (err.ret.1).
fn Lower.is_error_expr(self, e ast.Expr) bool
    match e
        Call(callee, _, _) => self.is_error_callee(callee)
        Member(recv, _, _) => self.is_error_type_name(recv)
        Method(recv, name, _, _) => self.is_error_type_name(recv)
            or self.is_module_error(recv, name)
            or self.is_net_error(recv, name)
            or self.method_returns_error(recv, name)
        Name(n, _) => self.is_error_variant(n) or self.local_is_error(n)
        _ => false

## `net.NAME(...)` building a std.net error.
fn Lower.is_net_error(self, recv ast.Expr, name str) bool
    match recv
        Name(m, _) => m == "net" and err_msgs.contains("net.{name}")
        _ => false

## A local variable or parameter that holds an error value (`return e`).
fn Lower.local_is_error(self, n str) bool
    k := lookup(n) else return false
    self.is_error_ty(var_ty[k])

fn Lower.is_error_callee(self, callee ast.Expr) bool
    match callee
        Name(n, _) =>
            if err_msgs.contains(n) or self.is_error_variant(n)
                return true
            s := self.callee_sig(n) else return false
            self.returns_error(s)
        Member(recv, name, _) => self.is_error_type_name(recv) or self.net_error_ctor(recv, name)
        _ => false

## `net.NetError`, the one error struct of a module the subset knows.
fn Lower.net_error_ctor(self, recv ast.Expr, name str) bool
    match recv
        Name(n, _) => n == "net" and name == "NetError"
        _ => false

fn Lower.is_error_ty(self, t Ty) bool
    match t
        Struct(k) => err_msgs.contains(k)
        Enum(k) => err_msgs.contains(k)
        _ => false

## The signature a call of `n` reaches: a method of the enclosing type
## (an implicit `self` call), else a function of this module.
fn Lower.callee_key(self, n str) str
    if self_ty != "" and sigs.contains("{self_ty}.{n}")
        return "{self_ty}.{n}"
    if not sigs.contains("{prefix}{n}")
        if k := prelude_key(n)
            return k
    "{prefix}{n}"

fn Lower.callee_sig(self, n str) Sig?
    sigs.get(self.callee_key(n))

## Whether a function's result is an error value it builds (not a failure).
fn Lower.returns_error(self, s Sig) bool
    if s.fails
        return false
    self.is_error_ty(s.ret)

fn Lower.is_error_type_name(self, e ast.Expr) bool
    match e
        Name(n, _) => err_msgs.contains(n)
        Member(recv, n, _) => self.is_module_error(recv, n)
        _ => false

## `m.E`: an error type of imported module `m`.
fn Lower.is_module_error(self, recv ast.Expr, n str) bool
    match recv
        Name(m, _) => module_of(m) != none and self.names_error("{m}.{n}")
        _ => false

## A bare variant name that only error enums have (it names an error enum's variant).
fn Lower.is_error_variant(self, name str) bool
    v := bare_variant(name, none) else return false
    err_msgs.contains(v.en.split(".").last() else v.en)

## Whether `e` calls a function that can fail.
fn Lower.fallible_call(self, e ast.Expr) bool
    match e
        Call(callee, _, _) =>
            match callee
                Name(n, _) =>
                    # A local holding a function value that can fail (type.fn.6) hides a function.
                    if lookup(n) != none
                        return fn_value_fails(callee)
                    s := self.callee_sig(n) else return generic_fails(self.callee_key(n))
                    s.fails
                TypeArgs(n, _, _) => generic_fails(self.callee_key(n))
                _ => fn_value_fails(callee)
        Method(recv, name, _, _) => os_fails(recv, name)
            or self.method_fails(recv, name)
            or self.net_fails(recv, name)
            or self.generic_member_fails(recv, name)
        _ => false

## `G[A].f(...)` of a generic type whose function `f` can fail.
fn Lower.generic_member_fails(self, recv ast.Expr, name str) bool
    match recv
        TypeArgs(n, _, _) =>
            if n == "List"
                return generic_fails("List.{name}")
            g := generic_type_key(n) else return false
            generic_fails("{g}.{name}")
        Name(n, _) =>
            if lookup(n) != none
                return false
            t := gen.tsubst.get(n) else return false
            t.elem() != none and generic_fails("List.{name}")
        _ => false

## The signature key of `x.name(...)` when `x` is an imported module or a local
## struct or enum value.
fn Lower.method_key(self, recv ast.Expr, name str) str?
    if m := module_name(recv)
        return "{m}.{name}"
    # `Type.f(...)`, a function of a type (an associated one such as `from_json`).
    if a := assoc_owner(recv)
        return "{a}.{name}"
    if t := type_name(recv)
        return "{t}.{name}"
    if en := enum_ref(recv)
        return "{en}.{name}"
    # `S(...).f(...)`: a method of the struct a constructor call builds.
    match recv
        Call(c, _, _) =>
            match c
                Name(n, _) =>
                    if k := type_key(n)
                        return "{k}.{name}"
                _ => name
        _ => name
    match self.recv_ty(recv)?
        Struct(s) => "{s}.{name}"
        Enum(s) => "{s}.{name}"
        # `x.m()` on an `any T` (trait.any.1): every implementation has the trait's
        # signature, so the first one says whether the call can fail (ADR 1109).
        Any(t) =>
            owners := traits.impls.get(t)?
            one := owners.first()?
            "{one}.{name}"
        _ => none

## The type of a receiver written as a local, an element `xs[i]` of a list
## local, or a field `x.f` of one, without lowering it.
fn Lower.recv_ty(self, e ast.Expr) Ty?
    match e
        Name(n, _) =>
            k := lookup(n) else
                # A bare field name in a method.
                s := self_slot(n)
                if s >= 0
                    return structs[self_ty][s].ty
                return none
            t := var_ty[k]
            if t.is_unknown() then none else t
        Index(r, _, _) => index_ty(self.recv_ty(r)?)
        Member(r, f, _) =>
            match self.recv_ty(r)?
                Struct(s) =>
                    for slot in structs.get(s)?
                        if slot.name == f
                            return slot.ty
                    none
                _ => none
        Try(x, _, _) => self.recv_ty(x)?.opt_inner()
        Method(r, n, _, _) =>
            key := self.method_key(r, n)?
            sigs.get(key)?.ret
        _ => none

fn Lower.method_returns_error(self, recv ast.Expr, name str) bool
    key := self.method_key(recv, name) else return false
    s := sigs.get(key) else return false
    self.returns_error(s)

## Whether `x.name(...)` is a method of a `net.Conn` or `net.Listener` that
## can fail.
fn Lower.net_fails(self, recv ast.Expr, name str) bool
    key := self.method_key(recv, name) else return false
    net_method_fails(key)

fn Lower.method_fails(self, recv ast.Expr, name str) bool
    if m := module_name(recv)
        s := sigs.get("{m}.{name}") else return generic_fails("{m}.{name}")
        return s.fails
    key := self.method_key(recv, name) else return false
    s := sigs.get(key) else
        # `T.from_json(x)` with `T` a list: the instance is declared when it is called.
        return key.starts_with("List[") and generic_fails("List.{name}")
    s.fails

## Whether the function being lowered can fail and has no success value: its
## last expression may still be an error value (err.decl.3).
fn Lower.unit_fails(self) bool
    fails and ret.is_unit()

## An error value as the last expression of a function that can fail is its
## error (err.decl.3): leave with it. False when `e` isn't one.
fn Lower.tail_error(mut self, e ast.Expr) bool
    # A failing call as the result passes its errors on (err.type.6).
    if fails and self.fallible_call(e)
        self.note_inferred_err(self.error_type_of_call(e))
    # The trace names where the error expression starts, not its `(`.
    start := match e
        Call(callee, _, _) => expr_pos(callee)
        _ => tail_pos
    fails and self.is_error_expr(e) and self.lower_fail_return(e, start)

## `return E(...)` in a function that can fail: build the error, record its
## display text and the value, and leave (ADR 0804).
fn Lower.lower_fail_return(mut self, value ast.Expr?, pos ast.Pos) bool
    e := value else return false
    if fails and self.fallible_call(e)
        return self.return_fallible_call(e, pos)
    if not self.is_error_expr(e)
        return false
    if not fails
        if self.is_error_ty(ret) or self.is_error_ty(ret.opt_inner() else Ty.Unknown)
            return false
        problem(pos, "returning an error from a function that can't fail")
        return true
    v := lower_value(e, none) else return true
    self.note_inferred_err(v.ty)
    msg := self.display_call(v) else
        problem(pos, "an error type needs a message in the native subset (err.msg.1)")
        return true
    call("rt.err_set", [msg, self.trace_line(pos)], Ty.Unit)
    call("rt.err_value", [v.id], Ty.Unit)
    tag_error(v.ty)
    defer_all()
    finish(return_of(self.zero_of(ret)))
    true

## `return f(...)` where `f` can fail, in a function that can: the callee's
## failure (left in the error slot) or its value is this function's result.
fn Lower.return_fallible_call(mut self, e ast.Expr, pos ast.Pos) bool
    v := lower_expr(e, ret) else return true
    self.note_inferred_err(self.error_type_of_call(e))
    defer_all()
    if ret.is_unit()
        finish(return_of(-1))
    else
        finish(return_of(convert(v, ret, pos)))
    true

## After a call of a function that can fail: leave with the failure.
fn Lower.propagate_result(mut self, v Val, context ast.Expr?, pos ast.Pos) Val
    failure := call("rt.failed", [], Ty.Bool)
    leave := new_block()
    good := new_block()
    branch(failure, leave, [], good, [])
    seal(leave)
    seal(good)
    cur = leave
    if not fails
        problem(pos, "`?` in a function that can't fail")
    self.add_context(context)
    call("rt.err_trace", [self.trace_line(pos)], Ty.Unit)
    defer_all()
    finish(return_of(self.zero_of(ret)))
    cur = good
    v

## `e? "msg"`: evaluated only on the failing path (err.ctx.2).
fn Lower.add_context(mut self, context ast.Expr?)
    c := context else return
    m := lower_value(c, none) else return
    call("rt.err_context", [m.id], Ty.Unit)

## `e?` (err.prop.1, err.prop.2, err.prop.5).
fn Lower.lower_try(mut self, e ast.Expr, context ast.Expr?, pos ast.Pos) Val?
    # `t.wait()?` on a task: a trapped task ends the program (lower_task.ail).
    if tk.on and is_wait_call(e)
        return lower_wait(e, pos)
    if tk.on and is_wait_all(e)
        m := wait_all_maybe(e)?
        return self.propagate_result(m.val, context, pos)
    if self.fallible_call(e)
        v := lower_expr(e, none)?
        self.note_inferred_err(self.error_type_of_call(e))
        return self.propagate_result(v, context, pos)
    o := lower_value(e, none)?
    if o.ty.opt_inner() == none
        return unsupported(pos, "`?` on a `{o.ty.name()}`")
    absent := op("eq", [o.id, konst(0, Ty.Int)], Ty.Bool)
    if else_targets.len() > 0
        # Inside an `else` value: an absent value runs the `else` (err.prop.4).
        present := new_block()
        branch(absent, else_targets[else_targets.len() - 1], [], present, [])
        seal(present)
        cur = present
        return self.unwrap(o)
    leave := new_block()
    good := new_block()
    branch(absent, leave, [], good, [])
    seal(leave)
    seal(good)
    cur = leave
    if ret.opt_inner() != none
        defer_all()
        finish(return_of(konst(0, ret)))
    elif fails
        call("rt.err_set", [str_value("a value is absent"), self.trace_line(pos)], Ty.Unit)
        tag_absent()
        self.add_context(context)
        defer_all()
        finish(return_of(self.zero_of(ret)))
    else
        problem(
            pos,
            "`?` on an optional in a function that returns neither an optional nor an error",
        )
    cur = good
    self.unwrap(o)

# ---- else ----

## A value that may be absent or failed: `present` is a `bool` value.
struct Maybe
    val Val
    present int
    opt bool
    ## The error type of a call that can fail, when it names one.
    err Ty

fn Lower.lower_maybe(mut self, e ast.Expr) Maybe?
    if tk.on and is_wait_call(e)
        if m := lower_wait_try(e)
            return m
    if tk.on and is_wait_all(e)
        return wait_all_maybe(e)
    if self.fallible_call(e)
        v := lower_expr(e, none)?
        failure := call("rt.failed", [], Ty.Bool)
        return Maybe(
            val: v,
            present: op("not", [failure], Ty.Bool),
            opt: false,
            err: self.error_type_of_call(e),
        )
    o := lower_value(e, none)?
    if o.ty.opt_inner() == none
        problem(expr_pos(e), "`else` on a `{o.ty.name()}`, which is neither optional nor can fail")
        return none
    Maybe(val: o, present: op("ne", [o.id, konst(0, Ty.Int)], Ty.Bool), opt: true, err: Ty.Unknown)

## Bind `name` to the error being handled: its typed value when the call names
## one, else its display text.
fn Lower.bind_taken_error(mut self, name str, ty Ty)
    if ty == Ty.Unknown
        bind_text_error(name)
    else
        raw := call("rt.err_take_value", [], Ty.Int)
        declare(name, ty, op("copy", [raw], ty))

## `e else ...` (err.else.1-6): the success value, or the `else` part.
## A value of type `Unit` when `e` has no success value.
fn Lower.lower_else(mut self, e ast.Expr, other ast.Else, pos ast.Pos) Val?
    if r := str_to_int_recv(e)
        return lower_str_to_int_else(r, other, pos)
    if self.chain_try(e)
        return self.lower_else_chain(e, other, pos)
    m := self.lower_maybe(e)?
    mut t := m.val.ty
    if m.opt
        t = m.val.ty.opt_inner() else Ty.Unknown
    join := new_block()
    mut r := -1
    if not t.is_unit()
        r = new_value(t, "")
        blocks[join].params.push(r)
    good := new_block()
    failure := new_block()
    branch(m.present, good, [], failure, [])
    seal(good)
    seal(failure)
    cur = good
    if r >= 0
        s := if m.opt then self.unwrap(m.val) else m.val
        jump(join, [s.id])
    else
        jump(join, [])
    cur = failure
    self.else_part(other, m.opt, m.err, join, r, t, pos)

## The `else` part of `e else ...`, lowered in the failure block: it jumps
## to `join` with a value when `r` (of type `t`) is one, or leaves.
fn Lower.else_part(
    mut self,
    other ast.Else,
    opt bool,
    err Ty,
    join int,
    r int,
    t Ty,
    pos ast.Pos,
) Val?
    match other
        Fallback(x) =>
            if not opt
                call("rt.err_clear", [], Ty.Unit)
            if r < 0
                problem(pos, "`else` with a value, but there is no value to replace")
                jump(join, [])
            else
                fallback_jump(x, t, join, pos)
        Leave(st) =>
            if not opt
                call("rt.err_clear", [], Ty.Unit)
            lower_stmt(st)
            if not done()
                if r < 0
                    jump(join, [])
                else
                    problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(name, body, hpos) =>
            scopes.push(Map[str, str]())
            if n := name
                if opt
                    problem(n.pos, "an absent value has no error to bind")
                elif err == Ty.Unknown
                    bind_text_error(n.name)
                else
                    raw := call("rt.err_take_value", [], Ty.Int)
                    declare(n.name, err, op("copy", [raw], err))
            elif not opt
                call("rt.err_clear", [], Ty.Unit)
            tail_want = if r >= 0 and not t.is_unknown() then t else none
            v := lower_block(body, r >= 0)
            if not done()
                if r >= 0
                    x := v else
                        problem(hpos, "this `else` block needs a value")
                        scopes.pop()
                        return none
                    jump(join, [convert(x, t, hpos)])
                else
                    jump(join, [])
            scopes.pop()
    seal(join)
    cur = join
    Val(id: r, ty: t)

## Whether a `?` on a value inside `e`'s receivers can send `e` to its
## `else` (err.prop.4): `a?.b`, `a?.m()`, `a?[i]`.
fn Lower.chain_try(self, e ast.Expr) bool
    match e
        Try(x, _, _) => self.receiver_try(x)
        Member(r, _, _) => self.receiver_try(r)
        Method(r, _, _, args) => self.receiver_try(r) or self.args_try(args)
        Index(r, i, _) => self.receiver_try(r) or self.receiver_try(i)
        Call(_, args, _) => self.args_try(args)
        Binary(_, l, r, _) => self.receiver_try(l) or self.receiver_try(r)
        Unary(_, x, _) => self.receiver_try(x)
        _ => false

fn Lower.receiver_try(self, e ast.Expr) bool
    match e
        Try(x, _, _) => not self.fallible_call(x) or self.receiver_try(x)
        _ => self.chain_try(e)

fn Lower.args_try(self, args List[ast.Arg]) bool
    for a in args
        if self.receiver_try(a.value)
            return true
    false

## `e else ...` where a `?` inside `e` meets an absent value: that `?`
## jumps to the `else` part, and `e` has type `T?` if it isn't optional
## already (err.prop.4).
fn Lower.lower_else_chain(mut self, e ast.Expr, other ast.Else, pos ast.Pos) Val?
    failure := new_block()
    else_targets.push(failure)
    got := lower_value(e, none)
    else_targets.pop()
    v := got else return none
    mut t := v.ty
    opt := v.ty.opt_inner() != none
    if opt
        t = v.ty.opt_inner() else Ty.Unknown
    join := new_block()
    mut r := -1
    if not t.is_unit()
        r = new_value(t, "")
        blocks[join].params.push(r)
    good := new_block()
    if opt
        branch(op("ne", [v.id, konst(0, Ty.Int)], Ty.Bool), good, [], failure, [])
    else
        jump(good, [])
    seal(good)
    seal(failure)
    cur = good
    if r >= 0
        s := if opt then self.unwrap(v) else v
        jump(join, [s.id])
    else
        jump(join, [])
    cur = failure
    self.else_part(other, true, Ty.Unknown, join, r, t, pos)

## `x := e else ...`
fn Lower.lower_bind_else(mut self, name str, pos ast.Pos, value ast.Expr, other ast.Else)
    v := self.lower_else(value, other, pos) else
        declare(name, Ty.Unknown, -1)
        return
    declare(name, v.ty, copy_if_place(value, v))

## The statement `f() else ...` (err.else.5).
fn Lower.lower_handle(mut self, value ast.Expr, other ast.Else)
    self.lower_else(value, other, expr_pos(value))

## Record the names of the error structs and enums (err.decl.1). They are
## ordinary structs and enums; `err_msgs` marks them as error types.
fn Lower.declare_errors(mut self, prog ast.Program)
    err_msgs[IO_ERROR] = ""
    err_msgs[PROC_ERROR] = ""
    err_msgs[TRAPPED] = ""
    err_msgs[NET_ERROR] = ""
    err_msgs[COMPRESS_ERROR] = ""
    declare_std_kinds()
    # What `Task.wait()` fails with (conc.task.6), named in `! Trapped`.
    err_msgs["Trapped"] = ""
    for s in prog.structs
        if s.is_error
            err_msgs[s.name] = ""
            err_msgs["{prefix}{s.name}"] = ""
    for e in prog.enums
        if e.is_error
            err_msgs[e.name] = ""
            err_msgs["{prefix}{e.name}"] = ""

## Whether a written type name (`E`, `m.E`) names an error type here.
fn Lower.names_error(self, name str) bool
    if err_msgs.contains("{prefix}{name}")
        return true
    # The built-in `Trapped` is named the same in every module.
    if name == "Trapped"
        return true
    if k := type_key(name)
        return err_msgs.contains(k)
    if k := enum_key(name)
        return err_msgs.contains(k)
    false

## The message an error type defines (err.msg.1) is the parser's generated
## `impl ToStr`; make its `to_str` a method of the type, so it lowers like
## any other method (ADR 0804).
fn with_error_owners(srcs List[Source]) List[Source]
    mut out := List[Source]()
    for src in srcs
        mut prog := src.prog
        mut errs := Set[str]()
        for s in prog.structs
            if s.is_error
                errs.add(s.name)
        for e in prog.enums
            if e.is_error
                errs.add(e.name)
        mut fns := prog.fns
        for im in prog.impls
            if im.trait_name != "ToStr" or not errs.contains(im.target.name)
                continue
            for k in im.methods
                fns[k].owner = im.target
        prog.fns = fns
        out.push(Source(module: src.module, path: src.path, text: src.text, prog: prog))
    share_trait_defaults(out)

## The error type a function that can fail names, when it names one: `E` in
## `T ! E` and `! E`. Unions and inferred sets give `Unknown`.
fn Lower.error_ty_of(mut self, t ast.TypeRef) Ty
    match t.shape
        Fallible(ok, errors) =>
            if es := errors
                if es.len() == 1
                    return type_of(es[0]) else Ty.Unknown
                return Ty.Unknown
            o := ok else return Ty.Unknown
            if n := written_name(o)
                if self.names_error(n)
                    return type_of(o) else Ty.Unknown
            Ty.Unknown
        _ => Ty.Unknown

# ---- the type of an `if` or `match` that may give `none` ----

fn ends_in_none(body List[ast.Stmt]) bool
    if body.len() == 0
        return false
    match body[body.len() - 1]
        Eval(e) => is_none_lit(e)
        _ => false

fn is_pending_opt(t Ty) bool
    inner := t.opt_inner() else return false
    inner.is_unknown()

## The type the arms of a value `if` or `match` start with: the expected
## type, else `T?` for an arm that is `none` (settled by the first arm
## that has a value), else unknown.
fn arms_start(want Ty?, bodies List[List[ast.Stmt]], els List[ast.Stmt]?) Ty
    if w := want
        # A pending `[]` or `{}` (type.coll.13) is typed by the arms instead.
        if not is_pending_coll(w)
            return w
    mut has_none := false
    for b in bodies
        has_none = has_none or ends_in_none(b)
    if e := els
        has_none = has_none or ends_in_none(e)
    if has_none
        return Ty.Opt(Ty.Unknown)
    Ty.Unknown

## The arms' type once an arm with a value (type `xt`) is seen.
fn settle_arm_ty(t Ty, xt Ty) Ty
    if not is_pending_opt(t)
        return xt
    if inner := xt.opt_inner()
        if inner.is_unknown()
            return t
        return xt
    opt_of(xt) else xt

## `mut x := none` has no type until it is assigned a value: type the
## variable (and every value it has had) by that value.
fn Lower.settle_var(mut self, target ast.Expr, ty Ty, r Val) Ty
    if not is_pending_opt(ty)
        return settle_coll(target, ty, r)
    t := settle_arm_ty(ty, r.ty)
    if is_pending_opt(t)
        return ty
    retype(target, t)
    t

## The error type the called function names (`Unknown` when it names none).
fn Lower.error_type_of_call(self, e ast.Expr) Ty
    match e
        Call(callee, _, _) =>
            match callee
                Name(n, _) =>
                    if lookup(n) != none
                        return fn_value_err(callee)
                    fn_errs.get(self.callee_key(n)) else Ty.Unknown
                TypeArgs(n, _, _) => fn_errs.get(self.callee_key(n)) else Ty.Unknown
                _ => fn_value_err(callee)
        Method(recv, name, _, _) =>
            match recv
                TypeArgs(n, _, _) =>
                    if n == "List"
                        return fn_errs.get("List.{name}") else Ty.Unknown
                    if g := generic_type_key(n)
                        return fn_errs.get("{g}.{name}") else Ty.Unknown
                Name(n, _) =>
                    if lookup(n) == none and gen.tsubst.get(n) != none
                        if et := fn_errs.get("List.{name}")
                            return et
                _ => name
            if os_fails(recv, name)
                m := os_module(recv)
                if m == "task"
                    return Ty.Unknown
                if m == "net"
                    return Ty.Struct(NET_ERROR)
                if m == "compress"
                    return Ty.Struct(COMPRESS_ERROR)
                return Ty.Struct(if m == "proc" then PROC_ERROR else IO_ERROR)
            if m := module_name(recv)
                return fn_errs.get("{m}.{name}") else Ty.Unknown
            key := self.method_key(recv, name) else return Ty.Unknown
            if net_method_fails(key)
                return Ty.Struct(NET_ERROR)
            fn_errs.get(key) else Ty.Unknown
        _ => Ty.Unknown

## The text of a struct or enum value (its `to_str`, the display text of an
## error type, err.msg.1, or the default form), as a `str` value.
fn Lower.display_call(mut self, v Val) int?
    key := match v.ty
        Struct(k) => k
        Enum(k) => k
        Tuple => return tuple_text(v)
        Bytes => return call("rt.bytes_show", [v.id], Ty.Str)
        Ref => return if text_ok(v.ty) then ref_text(v.ty, v.id) else none
        Any(t) => return any_text(t, v)
        List(_) => return if has_tuple(v.ty) then tuple_text(v) else none
        _ => return none
    if sigs.contains("{key}.to_str")
        return call("{key}.to_str", [v.id], Ty.Str)
    # No `to_str` and no message: the default text of trait.auto.2.
    # A type of displayable fields gets one text function; a recursive one the
    # nested default of ADR 0864.
    mut seen := Set[str]()
    if displayable(v.ty, mut seen)
        return text_fn_call(key, v)
    nested_default(key, v)

## The text of an error type with no message: its default form,
## `Name(field: value, ...)` for a struct and `Enum.Variant(field: value)`
## for an enum (trait.auto.2), for fields of `int`, `float`, `bool`, `str`, and structs and enums of those.
## The name a default text shows for type `key`: a generic instance as its
## generic's name (`Pair[int, str]` shows `Pair`), a standard module's type
## without `std.`, except a module written in AIL (`std.ui.widgets.Action`,
## as the interpreter shows it).
SHOWN_STD_AIL := [
    "std.app.",
    "std.args.",
    "std.audio.",
    "std.bigint.",
    "std.csv.",
    "std.file.",
    "std.gfx.",
    "std.kv.",
    "std.log.",
    "std.mcp.",
    "std.media.webm.",
    "std.net.http.",
    "std.screen.",
    "std.strerr.",
    "std.term.",
    "std.net.jar.",
    "std.time.date.",
    "std.test.",
    "std.toml.",
    "std.ui.widgets.",
    "std.video.",
    "std.yaml.",
]

fn shown_type(key str) str
    base := key.split("[")[0]
    for m in SHOWN_STD_AIL
        if base.starts_with(m)
            return base
    base.strip_prefix("std.") else base

fn Lower.default_error_text(mut self, key str, v Val) int?
    if cases := enums.get(key)
        return self.default_enum_text(key, cases, v)
    slots := structs.get(key) else return none
    self.fields_text("{shown_type(shown_key(key))}(", slots, v.id, 0)

## `head` then each of `slots` read from `obj` (the first at slot `skip`),
## as `name: value` pairs, then `)`.
fn Lower.fields_text(mut self, head str, slots List[Slot], obj int, skip int) int?
    mut acc := str_value(head)
    for k in 0..slots.len()
        piece := str_value("{if k > 0 then ", " else ""}{slots[k].name}: ")
        acc = call("rt.str_cat", [acc, piece], Ty.Str)
        f := load(obj, k + skip, slots[k].ty)
        text := match slots[k].ty
            Sized(kk) => call(if kk == "u64" then "rt.fmt_u64" else "rt.fmt_int", [f], Ty.Str)
            Int => call("rt.fmt_int", [f], Ty.Str)
            Float => call("rt.fmt_float", [f], Ty.Str)
            F32 => call("rt.fmt_f32", [f], Ty.Str)
            Bool => call("rt.fmt_bool", [f], Ty.Str)
            Str => call("rt.str_quoted", [f], Ty.Str)
            Bytes => call("rt.bytes_show", [f], Ty.Str)
            Struct | Enum => self.display_call(Val(id: f, ty: slots[k].ty)) else -1
            _ => if text_ok(slots[k].ty) then value_text(slots[k].ty, f) else -1
        if text < 0
            return none
        acc = call("rt.str_cat", [acc, text], Ty.Str)
    call("rt.str_cat", [acc, str_value(")")], Ty.Str)

## The name a type is shown by: a std module such as `std.ui` is written in AIL
## here but is the runtime's `ui` module under `ail run`, so its types print as
## `ui.Event` and `regex.Match`.
fn shown_key(key str) str
    if key.starts_with("std.") and key.slice(4, key.len()).split(".").len() == 2
        return key.slice(4, key.len())
    key

## A plain struct field's `Name(field: value, ...)`, else -1.
fn Lower.nested_text(mut self, key str, obj int) int
    slots := structs.get(key) else return -1
    if err_msgs.contains(key) or sigs.contains("{key}.to_str")
        return -1
    self.fields_text("{shown_type(shown_key(key))}(", slots, obj, 0) else -1

## The default text of an enum value: a chain of tests on the variant index.
fn Lower.default_enum_text(mut self, key str, cases List[Case], v Val) int?
    join := new_block()
    result := new_value(Ty.Str, "")
    blocks[join].params.push(result)
    tag := tag_of(key, v.id)
    for k in 0..cases.len()
        mut no := -1
        if k + 1 < cases.len()
            yes := new_block()
            no = new_block()
            branch(op("eq", [tag, konst(k, Ty.Int)], Ty.Bool), yes, [], no, [])
            seal(yes)
            seal(no)
            cur = yes
        text := if cases[k].fields.len()
            == 0 then str_value("{shown_type(shown_key(key))}.{cases[k].name}") else (self.fields_text("{shown_type(shown_key(key))}.{cases[k].name}(", cases[k].fields, v.id, 1) else return none)
        jump(join, [text])
        if no >= 0
            cur = no
    seal(join)
    cur = join
    result

## `e else ...` (err.else.1-6).
fn Lower.lower_or_else(mut self, x ast.Expr, other ast.Else, pos ast.Pos) Val?
    if is_list_pop(x)
        return lower_pop_else(x, other, pos)
    if self.is_get_call(x)
        return lower_get_else(x, other, pos)
    self.lower_else(x, other, pos)

# ---- inferred error sets (`fn f() !`, err.type.6) ----

## Record that function `key` has an inferred error set, when its return type says so.
fn Lower.note_inferred_set(mut self, key str, r ast.TypeRef)
    match r.shape
        Fallible(ok, errors) =>
            if errors != none
                return
            e := fn_errs.get(key) else return
            if e.is_unknown()
                infer_errs[key] = Ty.Unknown
        _ => return

## `?` on a call that gives error type `t` in the function being lowered: while all
## of them agree, that is the function's error type, so `else err` can read its fields.
fn Lower.note_inferred_err(mut self, t Ty)
    cur_t := infer_errs.get(fname) else return
    # `Unit`: a callee whose set isn't known yet (lower_gtd_infer.ail).
    if cur_t == Ty.Unit or t == Ty.Unit
        return
    if t.is_unknown() or (not cur_t.is_unknown() and cur_t != t)
        infer_errs[fname] = Ty.Unit
        fn_errs[fname] = Ty.Unknown
        return
    infer_errs[fname] = t
    fn_errs[fname] = t

## The functions with an inferred error set first, so their callers lower knowing the type.
fn inferred_first(l Lower, fns List[ast.FnDecl], pre str) List[ast.FnDecl]
    mut first := List[ast.FnDecl]()
    mut rest := List[ast.FnDecl]()
    for f in fns
        if l.infer_errs.contains(fn_key(f, pre))
            first.push(f)
        else
            rest.push(f)
    first.extend(rest)
    first
