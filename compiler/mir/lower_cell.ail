## `mut` parameters of `int`, `bool` and `char` (own.param.2). The caller
## passes a cell of one word holding the argument's value, the sig says
## `*(T)`, a one-element tuple that no program can write, and the callee binds the name to the value read from the cell and
## writes every assignment back to it (`assign_param`). After the call the
## caller reads the cell back into the variable it passed with `mut`. A
## sig of `*(T)` rejects every other call path (`expected *int, found int`),
## so a path that doesn't know cells reports a problem, not a wrong call.
use ast

## A cell passed to a call, to read back into `key` after it.
struct Cell
    key str
    ## Set for an argument or receiver that is a field or an element, not a local.
    place ast.Expr?
    cell int
    ty Ty
    pos ast.Pos

## The sig type of a `mut` parameter of scalar type `t`; none for others.
fn cell_param(t Ty) Ty?
    match t
        Int | Bool | Char | Float | Str | Enum(_) | Opt(_) => Ty.Ptr(Ty.Tuple([t]))
        _ => none

## The scalar a cell parameter holds.
fn cell_ty(t Ty) Ty?
    match t
        Ptr(inner) =>
            match inner
                Tuple(xs) => if xs.len() == 1 then xs[0] else none
                _ => none
        _ => none

## Declare parameter `p` of sig type `ty`, value `v`: a cell is read once.
fn Lower.declare_param(mut self, p ast.Param, ty Ty, v int)
    if t := cell_ty(ty)
        declare(p.name, t, load(v, 0, t))
        return
    declare(p.name, ty, v)

## The argument `a` for a cell parameter of scalar type `t`: a fresh cell
## holding its value, remembered in `cells` to read back after the call.
@allow("expr.match.3") fn Lower.cell_arg(mut self, a ast.Arg, t Ty, mut cells List[Cell]) int?
    at := expr_pos(a.value)
    if not a.mutable
        problem(at, "an argument for a `mut` parameter without `mut`")
        return none
    mut name := ""
    match a.value
        Name(n, _) => name = n
        _ => name = ""
    mut key := lookup(name) else ""
    mut place := none
    if key == ""
        if place_path(a.value) == none
            problem(at, "this `mut` argument isn't a variable, field or element")
            return none
        place = a.value
    v := lower_value(a.value, t)?
    cell := self.new_cell(convert(v, t, at))
    cells.push(Cell(key: key, place: place, cell: cell, ty: t, pos: at))
    cell

## After the call: each local passed as a cell takes the callee's last value.
## A name that is itself a `mut` parameter (or a `for mut` variable) also
## writes it through to its own cell or element (`assign_param`), as an
## assignment does, so forwarding it with `mut` reaches the caller.
fn Lower.cells_back(mut self, cells List[Cell])
    for c in cells
        back := load(c.cell, 0, c.ty)
        if p := c.place
            # A field or element: bind the value to a hidden local and assign it.
            nvars += 1
            tmp := "#cell{nvars}"
            declare(tmp, c.ty, back)
            lower_assign_body(p, none, ast.Expr.Name(tmp, c.pos), c.pos)
        else
            write_var(c.key, cur, assign_param(c.key, c.ty, back, c.pos))

## A cell of one word holding `v`.
fn Lower.new_cell(mut self, v int) int
    cell := call("rt.alloc", [konst(8, Ty.Int), konst(11, Ty.Int)], Ty.Int)
    store(cell, 0, v)
    cell

## The type of the `self` parameter of `f`, a method of `owner`: a cell for a
## `mut self` that is a shared value (an enum), which the callee can't change in place.
fn Lower.self_param_ty(self, f ast.FnDecl, owner str) Ty
    t := owner_ty(owner)
    if r := f.receiver
        if r.mutable and enums.contains(owner)
            return cell_param(t) else t
    t

## Declare `self`: a cell is read once, and `self = e` is written through.
fn Lower.declare_self(mut self, recv ast.Receiver, ty Ty, v int)
    if t := cell_ty(ty)
        declare("self", t, load(v, 0, t))
    else
        declare("self", ty, v)
    if recv.mutable
        key := lookup("self") else return
        facts.mut_ptr["{fname}|{key}"] = v
