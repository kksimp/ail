## Operators and number methods in the native subset: unary and binary
## operators, short-circuit `and`/`or`, and the methods of `int` and `float`
## (split from lower.ail, ADR 0823).
use ast

## The `int` methods of two operands that are one instruction (expr.bit.1).
BIT_OPS := {"bit_and": "band", "bit_or": "bor", "bit_xor": "bxor", "shl": "shl", "shr": "shr"}

## std.math's float methods that are runtime functions (type.num.16): one
## argument (`x.sin()`), or the receiver and one more (`x.pow(y)`).
MATH1 := ["sin", "cos", "tan", "atan", "exp", "ln", "log10", "cbrt"]

MATH2 := ["atan2", "pow", "hypot", "min", "max"]

fn wants_float(want Ty?) bool
    w := want else return false
    w.is_float()

fn is_int_lit(e ast.Expr) bool
    match e
        Int => true
        Unary(o, x, _) => o == ast.UnOp.Neg and is_int_lit(x)
        _ => false

## What an operator's first operand should be: arithmetic passes the
## context's type on; a comparison's operands decide their own.
fn operand_want(o ast.BinOp, want Ty?) Ty?
    match o
        Add | Sub | Mul | Div | Rem => want
        _ => none

fn Lower.lower_unary(mut self, o ast.UnOp, operand ast.Expr, pos ast.Pos, want Ty?) Val?
    match o
        Neg =>
            if int_text(operand) == "9223372036854775808"
                # The smallest `int` is written `-9223372036854775808` (lex.num.3).
                if wants_float(want)
                    return Val(id: fconst(-9223372036854775807.0 - 1.0), ty: Ty.Float)
                return Val(id: konst(-9223372036854775807 - 1, Ty.Int), ty: Ty.Int)
            if lit := negative_sized_lit(operand, want)
                return lit
            a := lower_value(operand, want)?
            match a.ty
                Int => Val(
                    id: checked("neg", [a.id], site("expr.arith.1", "neg", "-", pos), Ty.Int),
                    ty: Ty.Int,
                )
                Float => Val(id: op("fneg", [a.id], Ty.Float), ty: Ty.Float)
                Tensor(_) => tensor_neg(a, pos)
                Sized(_) => sized_neg(a, pos)
                F32 => Val(id: op("fneg", [a.id], Ty.Float), ty: Ty.F32)
                _ =>
                    # trait.op.1: a type's own `Neg` (ADR 1124).
                    if t := self.neg_trait_call(a)
                        return t
                    unsupported(pos, "`-` on `{a.ty.name()}`")
        Not =>
            a := lower_value(operand, Ty.Bool)?
            Val(id: op("not", [a.id], Ty.Bool), ty: Ty.Bool)
        Spawn => unsupported(pos, "`spawn`")

fn int_text(e ast.Expr) str
    match e
        Int(t, _) => t
        _ => ""

fn op_name(o ast.BinOp) str
    match o
        Add => "add"
        Sub => "sub"
        Mul => "mul"
        Div => "div"
        Rem => "rem"
        Eq => "eq"
        Ne => "ne"
        Lt => "lt"
        Le => "le"
        Gt => "gt"
        Ge => "ge"
        And => "and"
        Or => "or"

fn op_symbol(o ast.BinOp) str
    match o
        Add => "+"
        Sub => "-"
        Mul => "*"
        Div => "/"
        Rem => "%"
        Eq => "=="
        Ne => "!="
        Lt => "<"
        Le => "<="
        Gt => ">"
        Ge => ">="
        And => "and"
        Or => "or"

fn is_comparison(o ast.BinOp) bool
    match o
        Eq | Ne | Lt | Le | Gt | Ge => true
        _ => false

fn Lower.binary(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val
    name := op_name(o)
    if a.ty.is_tensor() or b.ty.is_tensor()
        return tensor_binary(o, a, b, pos)
    if (name == "eq" or name == "ne") and (a.ty.opt_inner() != none or b.ty.opt_inner() != none)
        if opt_comparable(a.ty, b.ty)
            return opt_compare(name == "ne", a, b, pos)
    if not same_ty(a.ty, b.ty)
        problem(pos, "`{op_symbol(o)}` on `{a.ty.name()}` and `{b.ty.name()}`")
        return a
    if a.ty.is_ref() and (name == "eq" or name == "ne")
        return Val(id: op(name, [a.id, b.id], Ty.Bool), ty: Ty.Bool)
    if k := own_cmp(a.ty)
        if name == "lt" or name == "gt" or name == "le" or name == "ge"
            return cmp_order(name, k, a, b)
    # trait.op.1: a type's own `Add` and the like (ADR 1124).
    if t := self.op_trait_call(name, a, b)
        return t
    if is_enum(a.ty)
        return enum_compare(o, a, b, pos)
    if a.ty == Ty.Bytes
        return bytes_compare(o, a, b, pos)
    if holds_record(a.ty)
        return value_compare(o, a, b, pos)
    cmp := is_comparison(o)
    match a.ty
        Int =>
            if cmp
                return Val(id: op(name, [a.id, b.id], Ty.Bool), ty: Ty.Bool)
            divides := name == "div" or name == "rem"
            rule := if divides then "expr.arith.3" else "expr.arith.1"
            kind := if divides then "div" else "arith"
            s := site(rule, kind, op_symbol(o), pos)
            Val(id: checked(name, [a.id, b.id], s, Ty.Int), ty: Ty.Int)
        Float =>
            if cmp
                return Val(id: op("f{name}", [a.id, b.id], Ty.Bool), ty: Ty.Bool)
            if name == "rem"
                problem(pos, "`%` on `float`")
                return a
            Val(id: op("f{name}", [a.id, b.id], Ty.Float), ty: Ty.Float)
        Bool =>
            if name == "eq" or name == "ne"
                return Val(id: op(name, [a.id, b.id], Ty.Bool), ty: Ty.Bool)
            problem(pos, "`{op_symbol(o)}` on `bool` isn't in the native subset yet")
            a
        Str => str_binary(o, a, b, pos) else a
        Char => char_binary(o, a, b, pos) else a
        Sized(_) => sized_binary(o, a, b, pos) else a
        Ptr(_) => ptr_binary(o, a, b, pos)
        F32 => f32_binary(o, a, b, pos)

        _ =>
            if eq := self.list_equal(o, a, b)
                return eq
            if ord := self.list_order(o, a, b)
                return ord
            if cmp and a.ty.elem() != none and can_order(a.ty)
                return tuple_compare(o, a, b, pos)
            problem(pos, "`{op_symbol(o)}` on `{a.ty.name()}` isn't in the native subset yet")
            a

## `a and b` (`is_and`) or `a or b`: `b` runs only when it decides.
fn Lower.short_circuit(mut self, is_and bool, lhs ast.Expr, rhs ast.Expr) Val?
    a := lower_value(lhs, Ty.Bool)?
    join := new_block()
    r := new_value(Ty.Bool, "")
    blocks[join].params.push(r)
    rhs_b := new_block()
    k := konst(if is_and then 0 else 1, Ty.Bool)
    if is_and
        branch(a.id, rhs_b, [], join, [k])
    else
        branch(a.id, join, [k], rhs_b, [])
    seal(rhs_b)
    cur = rhs_b
    b := lower_value(rhs, Ty.Bool)?
    jump(join, [b.id])
    seal(join)
    cur = join
    Val(id: r, ty: Ty.Bool)

fn Lower.int_abs(mut self, a int, pos ast.Pos) int
    # |a| is `-a` when `a < 0`, which traps on the smallest `int` (expr.arith.1).
    neg := op("lt", [a, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    yes := new_block()
    branch(neg, yes, [], join, [a])
    seal(yes)
    cur = yes
    jump(join, [checked("neg", [a], site("expr.arith.1", "abs", "abs", pos), Ty.Int)])
    seal(join)
    cur = join
    r

fn Lower.int_minmax(mut self, name str, a int, b int) int
    pick_a := op(if name == "min" then "le" else "ge", [a, b], Ty.Bool)
    join := new_block()
    r := new_value(Ty.Int, "")
    blocks[join].params.push(r)
    other := new_block()
    branch(pick_a, join, [a], other, [])
    seal(other)
    cur = other
    jump(join, [b])
    seal(join)
    cur = join
    r

## A binary operation (`and` and `or` short-circuit).
fn Lower.lower_binary_expr(
    mut self,
    o ast.BinOp,
    lhs ast.Expr,
    rhs ast.Expr,
    pos ast.Pos,
    want Ty?,
) Val?
    match o
        And => self.short_circuit(true, lhs, rhs)
        Or => self.short_circuit(false, lhs, rhs)
        _ =>
            if fused := try_fuse(o, lhs, rhs, pos, want)
                return fused
            self.lower_binary_plain(o, lhs, rhs, pos, want)

fn Lower.lower_binary_plain(
    mut self,
    o ast.BinOp,
    lhs ast.Expr,
    rhs ast.Expr,
    pos ast.Pos,
    want Ty?,
) Val?
    if is_none_lit(lhs) or is_none_lit(rhs)
        return lower_none_cmp(o, lhs, rhs, pos)
    if is_int_lit(lhs)
        # Lower the other side first to learn the type: a literal has no effects.
        b := lower_value(rhs, operand_want(o, want))?
        a := lower_value(lhs, b.ty)?
        return self.binary(o, a, b, pos)
    a := lower_value(lhs, operand_want(o, want))?
    b := lower_value(rhs, a.ty)?
    self.binary(o, a, b, pos)

## A method of an `int`: `to_float`, `abs`, `min`, `max`, the bit operations.
fn Lower.int_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    if conv := sized_conversion(r, name, npos, vs)
        return conv
    if m := sized_method(r, name, npos, vs)
        return m
    if c := int_checked(r, name, npos, vs)
        return c
    if name == "to_float" and vs.len() == 0 and r.ty.is_sized()
        return Val(id: op("itof", [r.id], Ty.Float), ty: Ty.Float)
    # type.str.20: `n.to_str()` and `n.to_str(radix)`.
    if name == "to_str" and vs.len() <= 1 and (r.ty == Ty.Int or r.ty.is_sized())
        if vs.len() == 0
            f := if r.ty == Ty.Sized("u64") then "rt.fmt_u64" else "rt.fmt_int"
            return Val(id: call(f, [r.id], Ty.Str), ty: Ty.Str)
        k := int_arg(vs[0], name, npos)?
        check_radix(k, npos)
        f := if r.ty == Ty.Sized("u64") then "rt.fmt_radix_u" else "rt.fmt_radix"
        return Val(id: call(f, [r.id, k], Ty.Str), ty: Ty.Str)
    # type.num.14: the digits of an unsigned value are the `int` ones.
    if name == "to_hex" and vs.len() == 0 and r.ty.is_sized() and sized_lo(sized_kind(r.ty)) == 0
        return Val(id: call("rt.fmt_hex", [r.id], Ty.Str), ty: Ty.Str)
    if r.ty != Ty.Int
        return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if name == "to_float" and vs.len() == 0
        return Val(id: op("itof", [r.id], Ty.Float), ty: Ty.Float)
    if name == "abs" and vs.len() == 0
        return Val(id: self.int_abs(r.id, npos), ty: Ty.Int)
    # type.num.12: `b.pow(e)`; the runtime traps on a negative `e` or a result that does not fit.
    if name == "pow" and vs.len() == 1
        k := int_arg(vs[0], name, npos)?
        h := self.trap_head("expr.arith.1", npos)
        return Val(id: call("rt.int_pow", [r.id, k, h, self.trap_tail(npos)], Ty.Int), ty: Ty.Int)
    # type.str.8
    if name == "to_hex" and vs.len() == 0
        return Val(id: call("rt.fmt_hex", [r.id], Ty.Str), ty: Ty.Str)
    # type.num.11
    if name == "cmp" and vs.len() == 1 and vs[0].ty == Ty.Int and enums.contains("Ordering")
        return self.ordering(call("rt.int_cmp", [r.id, vs[0].id], Ty.Int))
    if (name == "min" or name == "max") and vs.len() == 1
        return Val(id: self.int_minmax(name, r.id, vs[0].id), ty: Ty.Int)
    # expr.bit.1-2
    if BIT_OPS.contains(name) and vs.len() == 1
        mut s := -1
        if name == "shl" or name == "shr"
            s = site("expr.bit.2", "shift", name, npos)
        return Val(id: checked(BIT_OPS[name], [r.id, vs[0].id], s, Ty.Int), ty: Ty.Int)
    if name == "bit_not" and vs.len() == 0
        return Val(id: op("bnot", [r.id], Ty.Int), ty: Ty.Int)
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## The `Ordering` value of index `k`, as `rt.int_cmp` returns it.
fn Lower.ordering(mut self, k int) Val
    t := Ty.Enum("Ordering")
    Val(id: op("copy", [k], t), ty: t)

## A method of a `float` (type.num.9, type.num.16).
fn Lower.float_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    if r.ty == Ty.F32
        return f32_method(r, name, npos, vs)
    if name == "to_int" and vs.len() == 0
        s := site("type.num.9", "float_int", "", npos)
        return Val(id: checked("ftoi", [r.id], s, Ty.Int), ty: Ty.Int)
    if (name == "sqrt" or name == "abs" or name == "floor" or name == "ceil") and vs.len() == 0
        return Val(id: op(name, [r.id], Ty.Float), ty: Ty.Float)
    # type.num.11
    if name == "cmp" and vs.len() == 1 and vs[0].ty == Ty.Float and enums.contains("Ordering")
        return self.ordering(call("rt.float_cmp", [r.id, vs[0].id], Ty.Int))
    # type.num.9
    if name == "round" and vs.len() == 0
        return Val(id: call("rt.float_round", [r.id], Ty.Float), ty: Ty.Float)
    if name == "to_f32" and vs.len() == 0
        return Val(id: f32_round(r.id), ty: Ty.F32)
    # type.num.16: std.math's float functions, in rt/native/math.ail
    if MATH1.contains(name) and vs.len() == 0
        return Val(id: call("rt.float_{name}", [r.id], Ty.Float), ty: Ty.Float)
    if MATH2.contains(name) and vs.len() == 1
        return Val(id: call("rt.float_{name}", [r.id, vs[0].id], Ty.Float), ty: Ty.Float)
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
