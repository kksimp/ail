## Assigning a whole `mut` parameter (own.param.2): the caller's argument is
## the object the parameter points to, so `p = other` writes the new value
## into that object instead of rebinding the name. A struct or tuple is
## stored slot by slot, a list by its three header words, a map or set by its
## table header (the entries and index come with the new table). The name
## then stays the parameter, so later changes reach the caller too.

use ast

## What lowering notes about the function it is on (lower_param.ail,
## lower_move.ail): the object of each `mut` parameter, and the copies of an
## owned local's last use that `elide_moves` may drop.
struct Facts
    mut_ptr Map[str, int]
    moves List[int]
    ## The locals whose every value is their own: set by a plain `x := e`
    ## whose `e` is a place (copied), a literal or a call, and dropped by an
    ## assignment of anything else (lower_move.ail).
    owned Set[str]
    ## The bindings that read straight from a parameter nobody can change
    ## during the call: a parameter without `mut`, and the immutable locals
    ## bound to a place inside one (lower_move.ail).
    stable Set[str]

fn new_facts() Facts
    Facts(mut_ptr: {}, moves: [], owned: Set[str](), stable: Set[str]())

## A `mut` parameter's object, as `FUNCTION|KEY`.
fn Lower.note_mut_param(mut self, p ast.Param, key str, v int)
    if p.mutable and v >= 0
        facts.mut_ptr["{fname}|{key}"] = v

## The value to bind to `key` after `key = v` of type `ty`.
fn Lower.assign_param(mut self, key str, ty Ty, v int) int
    p := facts.mut_ptr.get("{fname}|{key}") else return v
    if p == v
        return v
    if xs := tuple_elems(ty)
        for k in 0..xs.len()
            store(p, k, load(v, k, xs[k]))
        return p
    match ty
        Struct(n) =>
            slots := structs[n]
            for k in 0..slots.len()
                store(p, k, load(v, k, slots[k].ty))
        List(_) =>
            for k in 0..3
                store(p, k, load(v, k, Ty.Int))
        Map(_, _) | Set(_) =>
            for k in 0..11
                store(p, k, load(v, k, Ty.Int))
            # The remembered entry belongs to the old table.
            store(p, 10, konst(0, Ty.Int))
        _ => return v
    p
