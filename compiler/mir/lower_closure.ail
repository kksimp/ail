## Key functions: `xs.sorted(by: |x| e)` and `xs.sort(by: |x| e)` (expr.key.1-4,
## ADR 0571). A key function isn't a value, so there is no closure object and
## no indirect call: `e` is lowered inline in a loop over the elements, in
## the enclosing function, where it sees the enclosing locals. The keys go to
## `rt.sort_perm`, which returns the stable order as indices (ADR 0572).
use ast

## A counted loop `for i in 0..hi` under construction.
struct KeyLoop
    key str
    head int
    exit int
    ## The index inside the body.
    i int

fn Lower.count_open(mut self, hi int) KeyLoop
    nvars += 1
    key := "#k{nvars}"
    var_ty[key] = Ty.Int
    write_var(key, cur, konst(0, Ty.Int))
    head := new_block()
    jump(head, [])
    cur = head
    i := read_var(key, head)
    inner := new_block()
    exit := new_block()
    branch(op("lt", [i, hi], Ty.Bool), inner, [], exit, [])
    seal(inner)
    cur = inner
    KeyLoop(key: key, head: head, exit: exit, i: i)

fn Lower.count_close(mut self, c KeyLoop)
    j := read_var(c.key, cur)
    write_var(c.key, cur, op("add", [j, konst(1, Ty.Int)], Ty.Int))
    jump(c.head, [])
    seal(c.head)
    seal(c.exit)
    cur = c.exit

## Whether `name` with these arguments is one of `sorted` and `sort`, with
## or without a key function.
fn is_sorting(name str, args List[ast.Arg]) bool
    name == "sorted" or name == "sort"

## `r.sorted()`, `r.sorted(by: |x| e)`, `r.sort()`, `r.sort(by: |x| e)`.
fn Lower.lower_sorted(mut self, r Val, name str, args List[ast.Arg], npos ast.Pos) Val?
    e := r.ty.elem() else return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if e.is_unknown() or not (e == Ty.Int or e == Ty.Float or e == Ty.Str)
        return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if args.len() > 1
        return unsupported(npos, "`.{name}()` with {args.len()} arguments")
    n := op("len", [r.id], Ty.Int)
    mut keys := r.id
    if args.len() == 0
        if e != Ty.Int
            return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    else
        a := args[0]
        by := a.label else return unsupported(npos, "`.{name}()` with this argument")
        x := a.param else return unsupported(npos, "`.{name}()` with this argument")
        if by.name != "by" or a.mutable or a.moved
            return unsupported(npos, "`.{name}()` with this argument")
        keys = call("rt.list_new", [n], Ty.List(Ty.Int))
        c := count_open(n)
        scopes.push(Map[str, str]())
        declare(x.name, e, op("get", [r.id, c.i], e))
        k := lower_value(a.value, Ty.Int)
        scopes.pop()
        # A problem still closes the loop, so the half-built function stays well formed.
        if kv := k
            if kv.ty == Ty.Int
                call("rt.list_push", [keys, kv.id], Ty.Unit)
            else
                problem(
                    expr_pos(a.value),
                    "not in the native subset yet: a key of type `{kv.ty.name()}`",
                )
        count_close(c)
    perm := call("rt.sort_perm", [keys], Ty.List(Ty.Int))
    out := call("rt.list_new", [n], r.ty)
    c := count_open(n)
    idx := op("get", [perm, c.i], Ty.Int)
    call(push_fn(e), [out, op("get", [r.id, idx], e)], Ty.Unit)
    count_close(c)
    if name == "sorted"
        return Val(id: out, ty: r.ty)
    # `sort` puts the sorted elements back into the list itself.
    c2 := count_open(n)
    emit_void(inst(-1, "set", [r.id, c2.i, op("get", [out, c2.i], e)]))
    count_close(c2)
    Val(id: -1, ty: Ty.Unit)

## A declared function used as a value (type.fn.2): its address. `none` if
## `name` isn't a function of the program.
fn Lower.fn_value(mut self, name str) Val?
    key := "{prefix}{name}"
    sig := sigs.get(key) else return none
    mut i := inst(-1, "fnaddr", [])
    i.name = key
    t := Ty.Fn(params: sig.params, ret: sig.ret)
    Val(id: emit(i, t), ty: t)

## `f(args)` where `f` is a function value (type.fn.3): an indirect call.
fn Lower.call_value(mut self, f Val, args List[ast.Arg], pos ast.Pos) Val?
    sig := match f.ty
        Fn(ps, r) => Sig(params: ps, ret: r)
        _ => return unsupported(pos, "calling a `{f.ty.name()}`")
    if args.len() != sig.params.len()
        return unsupported(pos, "this call")
    mut vs := [f.id]
    for k in 0..args.len()
        a := args[k]
        if a.label != none
            return unsupported(pos, "labelled arguments")
        v := lower_value(a.value, sig.params[k])?
        vs.push(convert(v, sig.params[k], expr_pos(a.value)))
    mut i := inst(-1, "icall", vs)
    if sig.ret.is_unit()
        emit_void(i)
        return Val(id: -1, ty: Ty.Unit)
    Val(id: emit(i, sig.ret), ty: sig.ret)

## `unreachable(message)` (err.model.2): a trap that ends the block.
fn Lower.lower_unreachable(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1 or args[0].label != none
        return unsupported(pos, "this call of `unreachable`")
    m := lower_value(args[0].value, Ty.Str)?
    if m.ty != Ty.Str
        return unsupported(expr_pos(args[0].value), "`unreachable` of a `{m.ty.name()}`")
    mut i := inst(-1, "trap", [m.id])
    i.site = site("err.model.2", "unreachable", "", pos)
    emit_void(i)
    finish(unreachable_term())
    Val(id: -1, ty: Ty.Unit)
