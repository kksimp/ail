## Key functions: `xs.sorted(by: |x| e)` and `xs.sort(by: |x| e)` (expr.key.1-4,
## ADR 0571). A key function isn't a value, so there is no closure object and
## no indirect call: `e` is lowered inline in a loop over the elements, in
## the enclosing function, where it sees the enclosing locals. The keys go to
## `rt.sort_perm`, which returns the stable order as indices (ADR 0572).
use ast

## A counted loop `for i in 0..hi` under construction.
struct KeyLoop
    key str
    head int
    exit int
    ## The index inside the body.
    i int

fn Lower.count_open(mut self, hi int) KeyLoop
    nvars += 1
    key := "#k{nvars}"
    var_ty[key] = Ty.Int
    write_var(key, cur, konst(0, Ty.Int))
    head := new_block()
    jump(head, [])
    cur = head
    i := read_var(key, head)
    inner := new_block()
    exit := new_block()
    branch(op("lt", [i, hi], Ty.Bool), inner, [], exit, [])
    seal(inner)
    cur = inner
    KeyLoop(key: key, head: head, exit: exit, i: i)

fn Lower.count_close(mut self, c KeyLoop)
    j := read_var(c.key, cur)
    write_var(c.key, cur, op("add", [j, konst(1, Ty.Int)], Ty.Int))
    jump(c.head, [])
    seal(c.head)
    seal(c.exit)
    cur = c.exit

## Whether `name` with these arguments is `sorted` or `sort` with a key
## function; the plain forms are in lower_list.ail.
fn is_sorting(name str, args List[ast.Arg]) bool
    ((name == "sorted" or name == "sort") and args.len() > 0) or is_extreme_by(name, args) or is_list_fn_call(name, args)

## `r.sorted()`, `r.sorted(by: |x| e)`, `r.sort()`, `r.sort(by: |x| e)`.
fn Lower.lower_sorted(mut self, r Val, name str, args List[ast.Arg], npos ast.Pos) Val?
    if is_extreme_by(name, args)
        return lower_extreme_by(r, name, args, npos)
    # type.coll.21-26: `any`, `all`, `find`, `filter`, `map`, `group_by` (lower_fnlit.ail).
    if is_list_fn_call(name, args)
        return lower_list_fn(r, name, args, npos)
    e := r.ty.elem() else return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if e.is_unknown() or not (e == Ty.Int or e == Ty.Float or e == Ty.Str or structural(e))
        return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if args.len() > 1
        return unsupported(npos, "`.{name}()` with {args.len()} arguments")
    n := op("len", [r.id], Ty.Int)
    mut keys := r.id
    mut kt := Ty.Int
    if args.len() == 0
        if e != Ty.Int
            return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    else
        a := args[0]
        by := a.label else return unsupported(npos, "`.{name}()` with this argument")
        x := a.param else return unsupported(npos, "`.{name}()` with this argument")
        if by.name != "by" or a.mutable or a.moved
            return unsupported(npos, "`.{name}()` with this argument")
        keys = call("rt.list_new", [n], Ty.List(Ty.Int))
        c := count_open(n)
        scopes.push(Map[str, str]())
        declare(x.name, e, op("get", [r.id, c.i], e))
        k := lower_value(ast.key_body(a), Ty.Int)
        scopes.pop()
        # A problem still closes the loop, so the half-built function stays well formed.
        if kv := k
            if kv.ty == Ty.Int or kv.ty == Ty.Float or kv.ty == Ty.Str or orderable_record(kv.ty)
                kt = kv.ty
                call(push_fn(kt), [keys, kv.id], Ty.Unit)
            else
                problem(
                    expr_pos(a.value),
                    "not in the native subset yet: a key of type `{kv.ty.name()}`",
                )
        count_close(c)
    perm := if kt == Ty.Int then call(
        "rt.sort_perm",
        [keys],
        Ty.List(Ty.Int),
    ) else if kt == Ty.Float
        or kt == Ty.Str then call(
            "rt.sort_perm_by",
            [keys, compare_fn(if kt == Ty.Str then "rt.word_lt_str" else "rt.word_lt_float")],
            Ty.List(Ty.Int),
        ) else tuple_sort_perm(keys, kt)
    out := call("rt.list_new", [n], r.ty)
    c := count_open(n)
    idx := op("get", [perm, c.i], Ty.Int)
    mut item := op("get", [r.id, idx], e)
    if name == "sorted" and needs_copy(e)
        item = copy_value(Val(id: item, ty: e))
    call(push_fn(e), [out, item], Ty.Unit)
    count_close(c)
    if name == "sorted"
        return Val(id: out, ty: r.ty)
    # `sort` puts the sorted elements back into the list itself.
    c2 := count_open(n)
    emit_void(inst(-1, "set", [r.id, c2.i, op("get", [out, c2.i], e)]))
    count_close(c2)
    Val(id: -1, ty: Ty.Unit)

## Whether `name` with these arguments is `min` or `max` with a key function.
fn is_extreme_by(name str, args List[ast.Arg]) bool
    (name == "min" or name == "max") and args.len() == 1 and args[0].param != none

## `r.min(by: |x| e)`, `r.max(by: |x| e)` (expr.key.4): the first element with
## the least (greatest) key as a `T?`. The keys are made as in `sorted`.
fn Lower.lower_extreme_by(mut self, r Val, name str, args List[ast.Arg], npos ast.Pos) Val?
    e := r.ty.elem() else return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if e.is_unknown()
        return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    a := args[0]
    by := a.label else return unsupported(npos, "`.{name}()` with this argument")
    x := a.param else return unsupported(npos, "`.{name}()` with this argument")
    if by.name != "by" or a.mutable or a.moved
        return unsupported(npos, "`.{name}()` with this argument")
    n := op("len", [r.id], Ty.Int)
    keys := call("rt.list_new", [n], Ty.List(Ty.Int))
    mut kt := Ty.Int
    c := count_open(n)
    scopes.push(Map[str, str]())
    declare(x.name, e, op("get", [r.id, c.i], e))
    k := lower_value(ast.key_body(a), Ty.Int)
    scopes.pop()
    if kv := k
        if kv.ty == Ty.Int or kv.ty == Ty.Float or kv.ty == Ty.Str or orderable_record(kv.ty)
            kt = kv.ty
            call(push_fn(kt), [keys, kv.id], Ty.Unit)
        else
            problem(
                expr_pos(a.value),
                "not in the native subset yet: a key of type `{kv.ty.name()}`",
            )
    count_close(c)
    greatest := konst(if name == "max" then 1 else 0, Ty.Int)
    idx := if kt == Ty.Int then call(
        "rt.list_extreme",
        [keys, konst(0, Ty.Int), greatest],
        Ty.Int,
    ) else if kt == Ty.Float
        or kt == Ty.Str then call(
            "rt.list_extreme",
            [keys, konst(if kt == Ty.Str then 1 else 2, Ty.Int), greatest],
            Ty.Int,
        ) else call("rt.list_extreme_by", [keys, compare_fn(lt_fn(kt)), greatest], Ty.Int)
    found := op("le", [konst(0, Ty.Int), idx], Ty.Bool)
    opt_at(r, found, idx, e, false, npos)

## A declared function used as a value (type.fn.2): its address. `none` if
## `name` isn't a function of the program.
fn Lower.fn_value(mut self, name str, pos ast.Pos) Val?
    key := "{prefix}{name}"
    sig := sigs.get(key) else return none
    if contracted.contains(key)
        problem(
            pos,
            "`{name}` has contracts: a function value of it isn't in the native subset yet",
        )
        return Val(id: konst(0, Ty.Int), ty: Ty.Int)
    mut err := Ty.Unit
    if sig.fails
        err = fn_errs.get(key) else Ty.Unknown
    t := Ty.Fn(params: sig.params, ret: sig.ret, err: err)
    if is_rt
        mut i := inst(-1, "fnaddr", [])
        i.name = key
        return Val(id: emit(i, t), ty: t)
    # In user code a function value is a closure object (ADR 1067, lower_fnlit.ail).
    named_fn_value(key, sig, t)

fn Ty.is_fn(self) bool
    match self
        Fn(_, _, _) => true
        _ => false

## `f(args)` where `f` is a function value (type.fn.3): an indirect call.
fn Lower.call_value(mut self, f Val, args List[ast.Arg], pos ast.Pos) Val?
    sig := match f.ty
        Fn(ps, r, e) => Sig(params: ps, ret: r, fails: not e.is_unit())
        _ => return unsupported(pos, "calling a `{f.ty.name()}`")
    if args.len() != sig.params.len()
        return unsupported(
            pos,
            "calling a `fn` value with {args.len()} arguments instead of {sig.params.len()}",
        )
    mut vs := fn_value_head(f.id)
    for k in 0..args.len()
        a := args[k]
        if a.label != none
            return unsupported(pos, "a labelled argument in a call of a `fn` value")
        v := lower_value(a.value, sig.params[k])?
        vs.push(convert(v, sig.params[k], expr_pos(a.value)))
    mut i := inst(-1, "icall", vs)
    # The call's position, for a trap's stack (trace.frame.1, ADR 0641).
    if not is_rt and not fname.starts_with("init.")
        i.imm = call_pos(file, pos.line, pos.col)
    if sig.ret.is_unit()
        emit_void(i)
        return Val(id: -1, ty: Ty.Unit)
    Val(id: emit(i, sig.ret), ty: sig.ret)

## `(x.f)(args)` where the field `f` holds a function value (type.fn.3).
fn Lower.call_member_value(mut self, callee ast.Expr, args List[ast.Arg], pos ast.Pos) Val?
    f := lower_value(callee, none)?
    if not f.ty.is_fn()
        return unsupported(pos, "this call")
    call_value(f, args, expr_pos(callee))

## The rule a message names at its start, `std.regex.2: ...`: dotted lowercase words ending in a number.
fn message_rule(head str) str
    i := head.find(": ") else return ""
    id := head.slice(0, i)
    parts := id.split(".")
    if parts.len() < 3 or (parts[parts.len() - 1].to_int() else -1) < 0
        return ""
    for c in id.chars()
        if not (c.is_digit() or c == '.' or c == '_' or (c.is_alpha() and c.code() < 128 and c == c.to_lower()))
            return ""
    id

## The rule of `unreachable(message)`: the one the message's literal start names (std traps are
## written `unreachable("std.regex.2: ...")`), else err.model.2.
fn unreachable_rule(e ast.Expr) str
    mut lead := ""
    match e
        Str(t, _) => lead = t
        Interp(parts, _) =>
            if parts.len() > 0
                match parts[0]
                    Lit(t) => lead = t
                    Hole | Fmt => lead = ""
        Bytes | Int | Float | Char | Bool | NoneLit | Hole | Name | TypeArgs | Unary | If | Match | MapLit | SetLit | TupleLit | NewRef | Comp | Range | ListLit | Call | Method | Member | Index | Binary | Try | OrElse => lead = ""
    r := message_rule(lead)
    if r.is_empty() then "err.model.2" else r

## `unreachable(message)` (err.model.2): a trap that ends the block.
fn Lower.lower_unreachable(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1 or args[0].label != none
        return unsupported(pos, "this call of `unreachable`")
    m := lower_value(args[0].value, Ty.Str)?
    if m.ty != Ty.Str
        return unsupported(expr_pos(args[0].value), "`unreachable` of a `{m.ty.name()}`")
    mut i := inst(-1, "utrap", [m.id])
    # In a std module a literal `unreachable("RULE: why")` traps as RULE (#759) and any other
    # message gets its rule read at run time (std.unreachable, std.regex.7, 24; #764). Elsewhere,
    # the prelude included, it is err.model.2 (json_fields).
    mut rule := "err.model.2"
    if fname.starts_with("std.")
        rule = unreachable_rule(args[0].value)
        if rule == "err.model.2"
            rule = "std.unreachable"
    i.site = site(rule, "unreachable", "", pos)
    emit_void(i)
    finish(unreachable_term())
    Val(id: -1, ty: Ty.Unit)
