## Composite map and set keys (ADR 0866): a struct, tuple, enum or list of
## keys. The table's key kind is then a string object, the key's shape, which
## `compiler/rt/native/map.ail` walks to hash and compare keys. `i` is a word
## (int, char, bool), `f` a float, `s` a string, `L` and the shape of its
## elements a list (`b` elements are bytes), `S` n `;` and n shapes a struct
## or tuple, `E` n `;` and n variants `V` m `;` and m shapes an enum, `O` and
## a shape an optional, `@` n `;` the shape at offset n (a recursive type),
## `_` a field that `impl Hash ... uses` leaves out (trait.hash.1).
use ast

## The shape of `t` as a key, or "" when it can't be one.
fn Lower.shape_of(self, t Ty, seen List[str]) str
    self.shape_from(t, [], [], 0)

## The shape of `t`, written at offset `base` of the whole shape. `outer`
## and `offs` are the structs and enums being described and where their
## shapes start: a type met again inside itself is `@` and that offset.
fn Lower.shape_from(self, t Ty, outer List[str], offs List[int], base int) str
    if inner := t.opt_inner()
        # `O`: 0 is `none`; a number inside is boxed (rt/native/map.ail).
        s := self.shape_from(inner, outer, offs, base + 1)
        return if s == "" then "" else "O{s}"
    match t
        Int | Char | Sized(_) => "i"
        Bool => "b"
        Float => "f"
        Str | Bytes => "s"
        List(e) =>
            inner := self.shape_from(e, outer, offs, base + 1)
            if inner == ""
                return ""
            "L{inner}"
        Tuple(xs) => self.shapes_from(xs, outer, offs, base)
        Struct(n) =>
            k := name_at(outer, n)
            if k >= 0
                return "@{offs[k]};"
            if not structs.contains(n)
                return ""
            used := self.hash_uses(n)
            if used.len() > 0
                return self.used_struct_shape(n, used, outer, offs, base)
            mut ts := List[Ty]()
            for sl in structs[n]
                ts.push(sl.ty)
            self.shapes_from(ts, with_name(outer, n), with_off(offs, base), base)
        Enum(n) =>
            if is_flat(n)
                return "i"
            k := name_at(outer, n)
            if k >= 0
                return "@{offs[k]};"
            if not enums.contains(n)
                return ""
            ns := with_name(outer, n)
            os := with_off(offs, base)
            mut out := "E{enums[n].len()};"
            for c in enums[n]
                mut ts := List[Ty]()
                for f in c.fields
                    ts.push(f.ty)
                head := "V{ts.len()};"
                inner := self.field_shapes(ts, ns, os, base + out.len() + head.len())
                if inner == "!"
                    return ""
                out = "{out}{head}{inner}"
            out
        _ => ""

## The field names of `impl Hash for n` with a `uses` line (trait.hash.1), or
## none: the table then hashes and compares only those fields.
fn Lower.hash_uses(self, n str) List[str]
    hash_uses_of.get(n) else []

## Record the `uses` lines of `prog`'s `impl Hash` blocks, by struct key.
fn Lower.note_hash_uses(mut self, prog ast.Program, pre str)
    for im in prog.impls
        if im.trait_name == "Hash" and im.uses.len() > 0
            hash_uses_of[owner_key(im.target.name, pre)] = [u.name for u in im.uses]

## `S n ; shapes` for struct `n` where a field not in `used` is `_`: skipped
## when hashing and comparing (trait.hash.1).
fn Lower.used_struct_shape(
    self,
    n str,
    used List[str],
    outer List[str],
    offs List[int],
    base int,
) str
    slots := structs[n]
    head := "S{slots.len()};"
    ns := with_name(outer, n)
    os := with_off(offs, base)
    mut out := ""
    for sl in slots
        if not used.contains(sl.name)
            out = "{out}_"
            continue
        s := self.shape_from(sl.ty, ns, os, base + head.len() + out.len())
        if s == ""
            return ""
        out = "{out}{s}"
    "{head}{out}"

## The shapes of the field types `ts` one after the other from offset `base`,
## or "!" when one can't be a key.
fn Lower.field_shapes(self, ts List[Ty], outer List[str], offs List[int], base int) str
    mut out := ""
    for t in ts
        s := self.shape_from(t, outer, offs, base + out.len())
        if s == ""
            return "!"
        out = "{out}{s}"
    out

## `S n ; shapes` for the field types `ts`, or "" when one can't be a key.
fn Lower.shapes_from(self, ts List[Ty], outer List[str], offs List[int], base int) str
    head := "S{ts.len()};"
    inner := self.field_shapes(ts, outer, offs, base + head.len())
    if inner == "!"
        return ""
    "{head}{inner}"

fn name_at(names List[str], n str) int
    for k in 0..names.len()
        if names[k] == n
            return k
    -1

fn with_off(offs List[int], k int) List[int]
    mut out := offs
    out.push(k)
    out

## Whether `t` can be the key of a table.
fn Lower.key_ok(self, t Ty) bool
    if is_key_ty(t)
        return true
    t != Ty.Bool and self.shape_of(t, []) != ""

## The key kind for tables of `t` keys: a small integer, or the shape.
fn Lower.kind_val(mut self, t Ty) int
    if is_key_ty(t)
        return konst(key_kind(t), Ty.Int)
    str_value(self.shape_of(t, []))

## A key about to be stored: converted, and copied when it is a composite
## value somebody else holds (own.val.1).
fn Lower.stored_key(mut self, e ast.Expr, k Val, kt Ty, pos ast.Pos) int
    id := convert(k, kt, pos)
    if is_key_ty(kt)
        return id
    copy_if_place(e, Val(id: id, ty: kt))

fn with_name(seen List[str], n str) List[str]
    mut out := seen
    out.push(n)
    out

## `m[k]` for a composite key: the value, or the trap that names the key by
## its text (type.map.3).
fn Lower.composite_at(mut self, m Val, kid int, kt Ty, vt Ty, texts List[int]) Val?
    e := call("rt.map_find", [m.id, kid], Ty.Int)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(missing)
    cur = missing
    call("rt.map_gone", [texts[0], value_text(kt, kid), texts[1]], Ty.Unit)
    finish(unreachable_term())
    seal(found)
    cur = found
    Val(id: entry_value(e, vt), ty: vt)

## A new empty table of type `t`, whose key may be composite.
fn Lower.keyed_table(mut self, t Ty) int
    match t
        Map(k, v) =>
            if is_key_ty(k)
                return new_table(t)
            m := value_mode(v)
            call("rt.map_new", [self.kind_val(k), konst(m[0], Ty.Int), konst(m[1], Ty.Int)], t)
        Set(e) =>
            if is_key_ty(e)
                return new_table(t)
            call("rt.map_new", [self.kind_val(e), konst(0, Ty.Int), konst(0, Ty.Int)], t)
        _ => new_table(t)
