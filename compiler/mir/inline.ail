## Inlining (ADR 0391): a call to a leaves function that calls nothing is
## replaced by a copy of its blocks, so arithmetic helpers such as
## `eval_a(i, j)` cost no call, and folding then sees through them. The
## callee's trap sites are kept, so a trap still names the callee's line.

## Functions with at most this many instructions are inlined.
INLINE_LIMIT := 40

## How many calls one function may have inlined into it.
INLINE_BUDGET := 64

pub fn inline_module(mut out Module)
    mut by_name := Map[str, int]()
    for k in 0..out.funcs.len()
        by_name[out.funcs[k].name] = k
    # The small functions as they are before any pass edits them: the body a
    # call gets is the original, whichever function was finished first.
    mut leaves := Set[str]()
    mut bodies := Map[str, Func]()
    for f in out.funcs
        if inlinable(f) and not opt_off("inline")
            leaves.add(f.name)
            bodies[f.name] = f
    reserve := by_name.contains("rt.list_reserve")
        and by_name.contains("rt.list_rows_min")
        and by_name.contains("rt.list_new_for")
    grow_only := lists_only_grow(out)
    fills := by_name.contains("rt.fill")
    if not opt_off("sroa")
        for _ in 0..2
            expand_allocating(mut out)
    for k in 0..out.funcs.len()
        mut f := out.funcs[k]
        budget := expand_calls(mut f, leaves, bodies, mut out.sites)
        unrolled := unroll_self(mut f, mut out.sites)
        mut scalar := false
        if not f.name.starts_with("rt.") and not opt_off("sroa")
            # The join blocks of inlined calls first: a value that crosses a
            # jump's argument counts as escaping.
            merge_blocks_in(mut f)
            scalar = sroa_in(mut f)
        if budget < INLINE_BUDGET or unrolled or scalar
            simplify_in(mut f)
            fold_in(mut f)
            simplify_in(mut f)
        merge_blocks_in(mut f)
        out.funcs[k] = f
    if not opt_off("sroa")
        late_inline(mut out)
    if not opt_off("stack") and not opt_off("sret")
        sret_convert(mut out)
    if not opt_off("stack")
        stackify(mut out)
    for k in 0..out.funcs.len()
        mut f := out.funcs[k]
        if f.name.starts_with("rt.")
            f = forwarded(f)
        else
            f = forwarded(hoist_headers(fill_loops(
                kept_lengths(
                    iv_sums(bce(mark_nonneg(interchange(vec_loops(f))), reserve, grow_only)),
                    reserve and grow_only,
                ),
                fills and not opt_off("fill"),
            )))
            if not opt_off("fold")
                fold_addresses(mut f)
        if not opt_off("fold")
            fold_prim_addresses(mut f)
        out.funcs[k] = f
        if not f.name.starts_with("rt.")
            out.funcs[k] = rewrite_nonneg(out.funcs[k])
    if not opt_off("pure")
        pure_calls(mut out)
    if not opt_off("memo")
        memoize(mut out)
    if not opt_off("reuse")
        reuse_lists(mut out)

fn forwarded(f Func) Func
    if opt_off("forward") then f else forward_loads(f)

## Inline the calls of `f` that name a function in `leaves`, at most
## `INLINE_BUDGET` of them; returns the budget left.
fn expand_calls(mut f Func, leaves Set[str], bodies Map[str, Func], mut sites List[Site]) int
    mut budget := INLINE_BUDGET
    mut changed := true
    while changed and budget > 0
        changed = false
        for b in 0..f.blocks.len()
            at := first_call(f.blocks[b], leaves, f.name)
            if at >= 0
                callee := bodies[f.blocks[b].insts[at].name]
                inline_call(mut f, b, at, callee, mut sites)
                budget -= 1
                changed = true
                break
    budget

## One round of inlining small functions that call nothing but `rt.obj_new`
## (a struct constructor such as `Vec.add`), so that `sroa_in` can see the
## object a chain of them builds. Callee bodies are those at the start of the
## round; two rounds reach `a.sub(b).unit()`.
fn expand_allocating(mut out Module)
    mut leaves := Set[str]()
    mut bodies := Map[str, Func]()
    for f in out.funcs
        if not f.name.starts_with("rt.") and inlinable_with(f, true)
            leaves.add(f.name)
            bodies[f.name] = f
    for k in 0..out.funcs.len()
        mut f := out.funcs[k]
        if f.name.starts_with("rt.")
            continue
        budget := expand_calls(mut f, leaves, bodies, mut out.sites)
        if budget < INLINE_BUDGET
            # As after any inlining, so the constants of the copies are shared.
            simplify_in(mut f)
            fold_in(mut f)
            simplify_in(mut f)
            merge_blocks_in(mut f)
        out.funcs[k] = f

## After scalar replacement, a function that calls nothing and takes a struct
## is up to this long for `late_inline`.
LATE_LIMIT := 100

## The most calls `late_inline` expands in one function.
LATE_BUDGET := 8

## A function that passes a fresh object to its own call is unrolled up to
## this long (`late_inline`).
UNROLL_FRESH := 400

## Second inlining, after every function has been through scalar replacement:
## a call that is given an object the caller just built goes inline when the
## callee reads fields and calls nothing (`hit(s, p, light)` in a ray
## tracer), so the object can go. A self-recursive function that hands a fresh
## object to itself is unrolled once for the same reason.
fn late_inline(mut out Module)
    mut leaves := Set[str]()
    mut bodies := Map[str, Func]()
    for f in out.funcs
        if not f.name.starts_with("rt.") and f.name != "main"
            if takes_struct(f) and inlinable_upto(f, false, LATE_LIMIT)
                leaves.add(f.name)
                bodies[f.name] = f
    for k in 0..out.funcs.len()
        mut f := out.funcs[k]
        if f.name.starts_with("rt.")
            continue
        fresh := fresh_objects(f)
        if fresh.len() == 0
            continue
        # Unrolling needs a body with no other calls (it keeps one frame per
        # call), so a function that will be unrolled has every callee inlined.
        every := gives_fresh_to_self(f, fresh)
        mut done := 0
        mut again := true
        while again and done < LATE_BUDGET
            again = false
            for b in 0..f.blocks.len()
                at := first_fresh_call(f.blocks[b], leaves, f.name, fresh, every)
                if at >= 0
                    callee := bodies[f.blocks[b].insts[at].name]
                    inline_call(mut f, b, at, callee, mut out.sites)
                    done += 1
                    again = true
                    break
        mut changed := done > 0
        if every and unroll_self_upto(mut f, mut out.sites, UNROLL_FRESH)
            changed = true
        if changed
            merge_blocks_in(mut f)
            changed = sroa_in(mut f)
            simplify_in(mut f)
            fold_in(mut f)
            simplify_in(mut f)
            merge_blocks_in(mut f)
        out.funcs[k] = f

fn takes_struct(f Func) bool
    for p in f.blocks[0].params
        if ty_is_struct(f.vals[p])
            return true
    false

fn ty_is_struct(t Ty) bool
    match t
        Struct(_) => true
        _ => false

## The values `f` builds with `rt.obj_new`.
fn fresh_objects(f Func) Set[int]
    mut fresh := Set[int]()
    for blk in f.blocks
        for i in blk.insts
            if i.op == "call" and i.name == "rt.obj_new" and i.dst >= 0
                fresh.add(i.dst)
    fresh

fn first_fresh_call(blk Block, leaves Set[str], self_name str, fresh Set[int], every bool) int
    for k in 0..blk.insts.len()
        i := blk.insts[k]
        if i.op == "call" and i.name != self_name and leaves.contains(i.name)
            if every
                return k
            for j in 0..i.argc()
                if fresh.contains(i.arg(j))
                    return k
    -1

fn gives_fresh_to_self(f Func, fresh Set[int]) bool
    for blk in f.blocks
        for i in blk.insts
            if i.op == "call" and i.name == f.name
                for j in 0..i.argc()
                    if fresh.contains(i.arg(j))
                        return true
    false

## Small, calls nothing, and nothing jumps back to its entry.
fn inlinable(f Func) bool
    inlinable_with(f, false)

## `inlinable`, optionally letting `rt.obj_new` calls stay in the body.
fn inlinable_with(f Func, allocs bool) bool
    inlinable_upto(f, allocs, INLINE_LIMIT)

fn inlinable_upto(f Func, allocs bool, limit int) bool
    # `rt.vec_*` are replaced by assembled kernels where the target has them.
    if f.name.starts_with("rt.vec_") or f.name == "rt.fill" or f.name.starts_with("rt.aes_hw_")
        return false
    mut n := 0
    for blk in f.blocks
        n += blk.insts.len()
        for i in blk.insts
            if i.op == "call" and allocs and i.name == "rt.obj_new"
                continue
            if i.op == "call"
                or i.op == "icall"
                or i.op == "prim" and (i.name == "syscall" or i.name == "clone")
                return false
        for t in blk.term.targets
            if t == 0
                return false
    n <= limit

fn first_call(blk Block, leaves Set[str], self_name str) int
    for k in 0..blk.insts.len()
        i := blk.insts[k]
        if i.op == "call" and i.name != self_name and leaves.contains(i.name)
            return k
    -1

## `f` with the call at `blocks[b].insts[at]` replaced by `callee`'s blocks:
## the block jumps to the copy of the callee's entry with the arguments, and
## each `return` jumps to a new block, holding the rest of `b`, whose
## parameter is the call's value. The callee's checks are copied with a
## link to the call, a frame of the stack a trap prints (trace.frame.2).
pub fn inline_call(mut g Func, b int, at int, callee Func, mut sites List[Site])
    nv := g.vals.len()
    nb := g.blocks.len()
    rest := nb + callee.blocks.len()
    for k in 0..callee.vals.len()
        g.vals.push(callee.vals[k])
        g.names.push(callee.names[k])
    call := g.blocks[b].insts[at]
    mut frame := -1
    if call.imm != 0
        frame = sites.len()
        sites.push(Site(
            rule: "",
            kind: "call",
            op: "",
            line: call_line(call.imm),
            col: call_col(call.imm),
            func: g.name,
            file: call_file(call.imm),
            from: -1,
        ))
    mut cloned := Map[int, int]()
    mut tail := List[Inst]()
    for k in at + 1..g.blocks[b].insts.len()
        tail.push(g.blocks[b].insts[k])
    mut cont_params := if call.dst >= 0 then [call.dst] else []
    if call.dst >= 0 and callee.ret.name() != g.vals[call.dst].name()
        # `rt.obj_new` returns an `int` that its caller sees as a struct, a
        # string or an enum: the block takes the `int` and a `copy` retypes it.
        raw := g.vals.len()
        g.vals.push(callee.ret)
        g.names.push("")
        tail.insert(0, inst(call.dst, "copy", [raw]))
        cont_params = [raw]
    cont := Block(params: cont_params, insts: tail, term: g.blocks[b].term)
    mut head := List[Inst]()
    for k in 0..at
        head.push(g.blocks[b].insts[k])
    g.blocks[b].insts = head
    g.blocks[b].term = jump_to(nb, call.operands())
    for blk in callee.blocks
        mut insts := List[Inst]()
        for i in blk.insts
            mut c := i
            c.dst = if i.dst >= 0 then i.dst + nv else -1
            c = c.with_args([a + nv for a in i.operands()])
            if frame >= 0 and i.site >= 0
                if not cloned.contains(i.site)
                    mut s := sites[i.site]
                    s.from = frame
                    cloned[i.site] = sites.len()
                    sites.push(s)
                c.site = cloned[i.site]
            insts.push(c)
        t := blk.term
        mut nt := t
        if t.kind == "return"
            mut rv := if t.value >= 0 then t.value + nv else -1
            if rv >= 0
                and cont_params.len() == 1
                and g.vals[rv].name() != g.vals[cont_params[0]].name()
                # `T` returned where the function says `T?` (or the reverse):
                # the join block's parameter has the declared type.
                cv := g.vals.len()
                g.vals.push(g.vals[cont_params[0]])
                g.names.push("")
                insts.push(inst(cv, "copy", [rv]))
                rv = cv
            nt = jump_to(rest, if rv >= 0 then [rv] else [])
        else
            nt.cond = if t.cond >= 0 then t.cond + nv else -1
            nt.targets = [x + nb for x in t.targets]
            nt.args = [[a + nv for a in edge] for edge in t.args]
        g.blocks.push(Block(params: [p + nv for p in blk.params], insts: insts, term: nt))
    g.blocks.push(cont)

## Join each block to the one it jumps to when it is that block's only
## predecessor: the jump's arguments replace the parameters, renamed once at
## the end.
pub fn merge_blocks(f Func) Func
    mut g := f
    merge_blocks_in(mut g)
    g

## `merge_blocks` in place.
pub fn merge_blocks_in(mut g Func)
    n := g.blocks.len()
    mut preds := [0 for _ in 0..n]
    for blk in g.blocks
        for t in blk.term.targets
            preds[t] += 1
    mut repl := [v for v in 0..g.vals.len()]
    mut merged := false
    for b in 0..n
        while g.blocks[b].term.kind == "jump"
            t := g.blocks[b].term
            s := t.targets[0]
            if s == b or s == 0 or preds[s] != 1
                break
            ps := g.blocks[s].params
            for j in 0..ps.len()
                repl[ps[j]] = t.args[0][j]
            g.blocks[b].insts.extend(g.blocks[s].insts)
            g.blocks[b].term = g.blocks[s].term
            # `s` is left unreachable, for `simplify` to drop.
            g.blocks[s].params = []
            g.blocks[s].insts = []
            g.blocks[s].term = unreachable_term()
            merged = true
    if not merged
        return
    # A parameter's argument may itself be a merged parameter.
    for v in 0..repl.len()
        mut r := repl[v]
        while repl[r] != r
            r = repl[r]
        repl[v] = r
    rename(mut g, repl)
    simplify_in(mut g)

fn rename(mut g Func, repl List[int])
    for b in 0..g.blocks.len()
        for k in 0..g.blocks[b].insts.len()
            g.blocks[b].insts[k] = g.blocks[b].insts[k].with_args([
                repl[a]
                for a in g.blocks[b].insts[k].operands()
            ])
        mut t := g.blocks[b].term
        if t.cond >= 0
            t.cond = repl[t.cond]
        if t.value >= 0
            t.value = repl[t.value]
        t.args = [[repl[a] for a in edge] for edge in t.args]
        g.blocks[b].term = t

fn kept_lengths(f Func, on bool) Func
    if on and not opt_off("keep") then keep_lengths(f) else f
