## Exclusive arguments (own.excl.4, native.subset.3, ADR 0119): a read-only argument that
## may overlap a `mut` argument of the same call is passed as a copy made
## before the call. A struct or list is a pointer, so without the copy the
## callee would see its own changes through the read-only parameter.

use ast

## The path of a place: its root variable, then a field name per `.f` and
## `[]` per index. `none` for anything that isn't a place.
fn place_path(e ast.Expr) List[str]?
    match e
        Name(n, _) => [n]
        Member(r, f, _) =>
            mut p := place_path(r)?
            p.push(f)
            p
        Index(r, _, _) =>
            mut p := place_path(r)?
            p.push("[]")
            p
        _ => none

## Whether two places can overlap: the same root, and fields that agree as
## far as both go. An index may equal any other index, so `[]` matches.
fn paths_overlap(a List[str], b List[str]) bool
    for k in 0..a.len().min(b.len())
        if a[k] != b[k] and a[k] != "[]" and b[k] != "[]"
            return false
    true

## Whether argument `i` is read-only and may overlap a `mut` argument.
fn overlaps_mut(args List[ast.Arg], i int) bool
    if args[i].mutable
        return false
    mine := place_path(args[i].value) else return false
    for j in 0..args.len()
        if j != i and args[j].mutable
            if theirs := place_path(args[j].value)
                if paths_overlap(mine, theirs)
                    return true
    false

## The argument's value, copied first when it may overlap a `mut` argument.
fn Lower.shield_arg(mut self, args List[ast.Arg], i int, v Val) int
    if needs_copy(v.ty) or v.ty.is_coll()
        if overlaps_mut(args, i)
            return copy_value(v)
    v.id

## Note that statement `e` is a call whose value nobody uses, when it is a
## method call.
fn Lower.note_statement(mut self, e ast.Expr)
    match e
        Method(_, _, p, _) => traits.stmt_pos = p
        _ => traits.stmt_pos = none

## Whether the method call at `p` is a whole statement.
fn Lower.is_statement(self, p ast.Pos) bool
    q := traits.stmt_pos else return false
    q.line == p.line and q.col == p.col

## A method call's receiver, as `struct_call` sees it.
struct Recv
    path List[str]
    mutable bool
    ## The receiver expression, to assign a `mut self` cell back to (lower_cell.ail).
    expr ast.Expr?
    ## The object of a `ref` receiver, or -1 (own.ref.7).
    ref_obj int

## Record that `f`, declared as `key`, takes `mut self`.
fn Lower.note_mut_self(mut self, f ast.FnDecl, key str)
    if r := f.receiver
        if r.mutable
            traits.mut_self.add(key)

## Note the receiver expression of the call of method `key` about to be lowered.
fn Lower.set_receiver(mut self, recv ast.Expr, key str)
    traits.recv_path = place_path(recv) else []
    traits.recv_mut = traits.mut_self.contains(key)
    traits.recv_expr = recv

## The noted receiver, cleared so a call nested in an argument doesn't see it.
fn Lower.take_receiver(mut self) Recv
    r := Recv(
        path: traits.recv_path,
        mutable: traits.recv_mut,
        expr: traits.recv_expr,
        ref_obj: traits.ref_obj,
    )
    traits.ref_obj = -1
    traits.recv_expr = none
    traits.recv_path = []
    traits.recv_mut = false
    r

## The receiver's value, copied first when it is read-only and a `mut`
## argument may overlap it.
fn Lower.shield_recv(mut self, rcv Recv, args List[ast.Arg], v Val) int
    if rcv.mutable or rcv.path.len() == 0
        return v.id
    if needs_copy(v.ty) or v.ty.is_coll()
        for a in args
            if a.mutable
                if theirs := place_path(a.value)
                    if paths_overlap(rcv.path, theirs)
                        return copy_value(v)
    v.id

## `shield_arg` for a call with a receiver: a read-only argument is also
## copied when it may overlap a `mut self` receiver.
fn Lower.shield_arg_on(mut self, rcv Recv, args List[ast.Arg], i int, v Val) int
    if rcv.mutable and rcv.path.len() > 0 and not args[i].mutable
        if needs_copy(v.ty) or v.ty.is_coll()
            if mine := place_path(args[i].value)
                if paths_overlap(rcv.path, mine)
                    return copy_value(v)
    self.shield_arg(args, i, v)
