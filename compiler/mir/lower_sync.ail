## `Mutex[T]`, `with` and `TaskGroup` (conc.share.5, conc.share.6, conc.task.8):
## the runtime is `compiler/rt/native/task.ail`. A mutex holds its value as an
## optional holds one (a pointer to a box or to the value), so `T` is any
## type that can be optional. A `with` block and a group end with their scope:
## `ExitAct`s kept in `tk.exits` run on every way out of it (the end, `break`,
## `continue`, `return`, `?`).
use ast

## Something to do when a scope ends: unlock the mutex of a `with` (storing
## the variable back), or wait for the tasks of a group.
struct ExitAct
    group bool
    ## Where a group was made: a deadlock at its end traps here (conc.task.7).
    pos ast.Pos
    ## `scopes.len()` and `loops.len()` where it was opened.
    depth int
    loopn int
    obj int
    var str
    elem Ty

fn mutex_elem(t Ty) Ty?
    match t
        Mutex(e) => e
        _ => none

fn is_sync(t Ty) bool
    match t
        Mutex => true
        Group => true
        _ => false

## `Mutex[T]`.
fn Lower.mutex_type_of(mut self, args List[ast.TypeRef]) Ty?
    if args.len() != 1
        return none
    e := type_of(args[0])?
    if opt_of(e) == none or e.opt_inner() != none
        return none
    Ty.Mutex(e)

## `TaskGroup` written as a type: a field of a `unique` struct (conc.task.10).
fn group_type_of(args List[ast.TypeRef]) Ty?
    if args.len() != 0
        return none
    Ty.Group

## A struct is built with `TaskGroup` fields (conc.task.10, ADR 0996): each group
## is the struct's now, so its release waits for the tasks, not the block that
## made the group (`rt.group_own`, `rt.group_release`).
fn Lower.own_groups(mut self, slots List[Slot], vs List[int])
    for k in 0..slots.len()
        if slots[k].ty == Ty.Group and vs[k] >= 0
            call("rt.group_own", [vs[k]], Ty.Unit)

## `Mutex(v)`, `Mutex[T](v)` and `TaskGroup()`.
fn Lower.lower_sync_new(mut self, name str, args List[ast.Arg], pos ast.Pos) Val?
    if name == "Mutex"
        return lower_mutex_new(none, args, pos)
    if args.len() != 0
        return unsupported(pos, "this `TaskGroup`")
    g := call("rt.group_new", [], Ty.Group)
    tk.exits.push(ExitAct(
        group: true,
        pos: pos,
        depth: scopes.len(),
        loopn: loops.len(),
        obj: g,
        var: "",
        elem: Ty.Unit,
    ))
    Val(id: g, ty: Ty.Group)

fn Lower.lower_mutex_new(mut self, targs List[ast.TypeRef]?, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1 or args[0].label != none
        return unsupported(pos, "this `Mutex`")
    mut want := Ty.Unknown
    if ts := targs
        if ts.len() != 1
            return unsupported(pos, "this `Mutex`")
        want = type_of(ts[0]) else return unsupported(pos, "a `Mutex` of this type")
    v := lower_value(args[0].value, if want.is_unknown() then none else want)?
    elem := if want.is_unknown() then v.ty else want
    if opt_of(elem) == none or elem.opt_inner() != none
        return unsupported(pos, "a `Mutex` of `{elem.name()}`")
    w := some(Val(id: copy_if_place(args[0].value, v), ty: elem))
    Val(id: call("rt.mutex_new", [w.id], Ty.Mutex(elem)), ty: Ty.Mutex(elem))

## The value of an optional word as a fresh value.
fn Lower.fresh_unwrap(mut self, w int, elem Ty) Val
    v := unwrap(Val(id: w, ty: Ty.Opt(elem)))
    if needs_copy(elem)
        return Val(id: copy_value(v), ty: elem)
    v

fn Lower.stored(mut self, e ast.Expr, v Val) Val
    some(Val(id: copy_if_place(e, v), ty: v.ty))

## Trap with the runtime's message when `r` is 0 (`lock` on a held mutex).
fn Lower.mutex_lock_check(mut self, r int, pos ast.Pos)
    found := new_block()
    cont := new_block()
    branch(op("eq", [r, konst(0, Ty.Int)], Ty.Bool), found, [], cont, [])
    seal(found)
    cur = found
    tensor_trap_if(call("rt.chan_fault", [], Ty.Int), "conc.share.5", pos)
    jump(cont, [])
    seal(cont)
    cur = cont

fn Lower.lower_sync_method(mut self, r Val, name str, npos ast.Pos, args List[ast.Arg]) Val?
    for a in args
        if a.mutable or a.label != none
            return unsupported(npos, "this method call")
    if r.ty == Ty.Int and name == "cancel" and args.len() == 0
        call("rt.task_cancel", [r.id], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    if r.ty == Ty.Group
        if name == "cancel" and args.len() == 0
            call("rt.group_cancel", [r.id], Ty.Unit)
            return Val(id: -1, ty: Ty.Unit)
        if name == "add" and args.len() == 1
            rec := group_member(args[0].value)?
            call("rt.group_add", [r.id, rec], Ty.Unit)
            return Val(id: -1, ty: Ty.Unit)
        return unsupported(npos, "`.{name}()` on `TaskGroup`")
    elem := mutex_elem(r.ty) else return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
    if name == "get" and args.len() == 0
        return fresh_unwrap(call("rt.mutex_get", [r.id], Ty.Opt(elem)), elem)
    if name == "lock" and args.len() == 0
        w := call("rt.mutex_lock", [r.id], Ty.Opt(elem))
        mutex_lock_check(w, npos)
        return fresh_unwrap(w, elem)
    if args.len() == 1 and (name == "set" or name == "swap" or name == "unlock")
        v := lower_value(args[0].value, elem)?
        if not same_ty(v.ty, elem)
            return unsupported(npos, "`.{name}()` of `{v.ty.name()}` on `{r.ty.name()}`")
        w := stored(args[0].value, v)
        if name == "set"
            call("rt.mutex_set", [r.id, w.id], Ty.Unit)
            return Val(id: -1, ty: Ty.Unit)
        if name == "swap"
            return fresh_unwrap(call("rt.mutex_swap", [r.id, w.id], Ty.Opt(elem)), elem)
        tensor_trap_if(call("rt.mutex_unlock", [r.id, w.id], Ty.Int), "conc.share.5", npos)
        return Val(id: -1, ty: Ty.Unit)
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## The task record `g.add(...)` moves into a group: a `spawn` or a handle.
fn Lower.group_member(mut self, e ast.Expr) int?
    if is_spawn(e)
        inner := match e
            Unary(_, x, _) => x
            _ => e
        t := lower_spawn(inner, expr_pos(e))?
        return t.id
    match e
        Name(n, npos) =>
            k := lookup(n) else
                unsupported(npos, "this task handle")
                return none
            read_var(k, cur)
        _ =>
            unsupported(expr_pos(e), "`add` of anything but a task")
            none

fn is_wait_all(e ast.Expr) bool
    match e
        Method(_, name, _, margs) => name == "wait_all" and margs.len() == 0
        _ => false

## `g.wait_all()`: unit, or the failure `Trapped` of the first task that trapped.
fn Lower.wait_all_maybe(mut self, e ast.Expr) Maybe?
    match e
        Method(recv, _, npos, _) =>
            g := lower_value(recv, none)?
            if g.ty != Ty.Group
                return none
            call("rt.group_wait", [g.id, trace_line(npos)], Ty.Unit)
            chan_deadlock_trap(npos)
            failure := call("rt.failed", [], Ty.Bool)
            Maybe(
                val: Val(id: -1, ty: Ty.Unit),
                present: op("not", [failure], Ty.Bool),
                opt: false,
                err: Ty.Struct(TRAPPED),
            )
        _ => none

## `with m as mut x` (conc.share.6): `x` is a copy of the value while the
## block holds the lock; the value of `x` goes back when the block ends.
fn Lower.lower_with(mut self, mex ast.Expr, var str, body List[ast.Stmt], pos ast.Pos)
    mv := lower_value(mex, none) else return
    m := deref(mv)
    elem := mutex_elem(m.ty) else
        problem(pos, "`with` of a `{m.ty.name()}`")
        return
    w := call("rt.mutex_lock", [m.id], Ty.Opt(elem))
    mutex_lock_check(w, pos)
    x := fresh_unwrap(w, elem)
    scopes.push(Map[str, str]())
    declare(var, elem, x.id)
    key := lookup(var) else
        scopes.pop()
        return
    act := ExitAct(
        group: false,
        pos: pos,
        depth: scopes.len(),
        loopn: loops.len(),
        obj: m.id,
        var: key,
        elem: elem,
    )
    tk.exits.push(act)
    lower_block(body, false)
    if not done()
        run_exit(act)
    tk.exits.pop()
    scopes.pop()

fn Lower.run_exit(mut self, a ExitAct)
    if a.group
        call("rt.group_end", [a.obj], Ty.Unit)
        chan_deadlock_trap(a.pos)
        return
    v := Val(id: read_var(a.var, cur), ty: a.elem)
    w := some(v)
    call("rt.mutex_unlock", [a.obj, w.id], Ty.Int)

## Every open scope ends (a `return`): innermost first.
fn Lower.unwind_exits(mut self)
    mut i := tk.exits.len() - 1
    while i >= 0
        run_exit(tk.exits[i])
        i -= 1

## `break` and `continue` leave the scopes opened inside the innermost loop.
fn Lower.unwind_loop(mut self)
    mut i := tk.exits.len() - 1
    while i >= 0 and tk.exits[i].loopn >= loops.len()
        run_exit(tk.exits[i])
        i -= 1

## Where an expression starts: its leftmost operand.
@allow("expr.match.3") fn group_end_expr(e ast.Expr) ast.Pos
    match e
        Call(callee, _, _) => group_end_expr(callee)
        Method(recv, _, _, _) => group_end_expr(recv)
        Member(recv, _, _) => group_end_expr(recv)
        Index(recv, _, _) => group_end_expr(recv)
        Binary(_, lhs, _, _) => group_end_expr(lhs)
        _ => expr_pos(e)

## Where a statement starts, for the statements that can end a block.
@allow("expr.match.3") fn group_end_at(s ast.Stmt) ast.Pos?
    match s
        Let(_, p, _, _, _) => p
        LetTuple(_, _, p) => p
        LocalFn(d) => d.pos
        Eval(e) => group_end_expr(e)
        Assign(target, _, _, _) => group_end_expr(target)
        Handle(e, _) => group_end_expr(e)
        While(_, _, p) => p
        For(_, _, _, _, _, _, p) => p
        With(_, _, _, _, p) => p
        Unsafe(_, p) => p
        Select(_, p) => p
        Return(_, p) => p
        _ => none

## A block ends: the groups it opened wait for their tasks. A deadlock there
## traps at the block's last statement, the end of the wait (conc.task.7).
fn Lower.end_scope_exits(mut self, last ast.Pos?)
    while tk.exits.len() > 0 and tk.exits[tk.exits.len() - 1].depth == scopes.len()
        mut act := tk.exits[tk.exits.len() - 1]
        tk.exits.pop()
        if act.group
            if at := last
                act.pos = at
        if not done()
            run_exit(act)

## `t.cancel()` on a task handle variable.
fn Lower.is_task_cancel(self, recv ast.Expr, name str) bool
    if name != "cancel"
        return false
    match recv
        Name(n, _) =>
            k := lookup(n) else return false
            tk.rets.contains(k)
        _ => false
