## List methods that edit, search or order a list (type.coll.9, 11, 14;
## ADR 0605): `extend`, `remove_at`, `insert`, `clear`, `reverse`, `pop`,
## `contains`, `sort`, `sorted` and `take` (type.coll.15). Each is a runtime call
## (`compiler/rt/native/list.ail`); the index checks are MIR checks, so a
## trap names the interpreter's rule and position.
##
## Reported as outside the subset: `contains` and `sort` on elements that
## are not `int`, `bool`, `float` or `str`; `sort` of a `List[bool]`;
## `by:` key functions; `pop()` used as a value other than with `else`.
use ast

## The methods this file lowers.
fn is_list_edit(name str) bool
    name == "extend"
        or name == "remove_at"
        or name == "insert"
        or name == "clear"
        or name == "reverse"
        or name == "reversed"
        or name == "pop"
        or name == "contains"
        or name == "sort"
        or name == "sorted"
        or name == "swap"
        or name == "take"
        or name == "sum"
        or name == "min"
        or name == "max"
        or name == "first"
        or name == "last"
        or name == "index_of"
        or is_list_build(name)
        or is_set_op(name)

## Bytes of one element of a list of `e`.
fn elem_bytes(e Ty) int
    e.elem_bytes()

## The list `r` of `e` as 8-byte words, for a runtime function that reads them
## so: a `List[u8]`, `List[u16]` or `List[u32]` is widened into a copy (ADRs 0907, 0912).
fn Lower.words_of(mut self, r Val, e Ty) int
    if e.elem_bytes() < 8
        return call("rt.list_widen", [r.id, konst(e.elem_bytes(), Ty.Int)], r.ty)
    r.id

## The value `v` for a narrow list slot: the code generators size a store by
## the value's own type, and a converted value (`x.to_u8()`) keeps its source's,
## so it is copied into a value of the element type (ADRs 0907, 0912).
fn Lower.slot_val(mut self, v int, elem Ty) int
    if elem.elem_bytes() < 8 and elem != Ty.Bool
        return op("copy", [v], elem)
    v

## The push, the whole-list output and the `rt.out_list_deep` leaf kind of a list
## whose elements take `n` bytes: 1 (`bool`, `u8`), 2 (`u16`) or 4 (`u32`); 8
## is a plain word.
fn push_fn_of(n int) str
    if n == 1
        return "rt.list_pushb"
    if n == 2
        return "rt.list_pushw"
    if n == 4
        return "rt.list_pushd"
    "rt.list_push"

fn narrow_out_fn(n int) str
    if n == 1
        return "rt.out_list_u8"
    if n == 2
        return "rt.out_list_u16"
    "rt.out_list_u32"

fn narrow_leaf(n int) int
    if n == 1
        return 6
    if n == 2
        return 7
    8

## How `contains` compares: 0 integers and bools, 1 strings, 2 floats; -1 if
## the element type has no native equality yet.
fn eq_kind(e Ty) int
    match e
        Int | Bool | Char | Sized(_) => 0
        Str => 1
        Float | F32 => 2
        List(_) => ord_kind(e)
        _ => -1

## `xs.NAME(args)` for the methods above. `vs` are the lowered arguments.
fn Lower.lower_list_edit(
    mut self,
    r Val,
    e Ty,
    name str,
    npos ast.Pos,
    args List[ast.Arg],
    vs List[Val],
) Val?
    size := konst(elem_bytes(e), Ty.Int)
    unit := Val(id: -1, ty: Ty.Unit)
    if is_list_build(name)
        return lower_list_build(r, e, name, npos, vs)
    if (structural(e) or e == Ty.Bytes or deep_list_order(e, name)) and tuple_list_method(name)
        return tuple_list_edit(r, e, name, npos, vs)
    if name == "extend" and vs.len() == 1
        if not same_ty(vs[0].ty, r.ty)
            return unsupported(npos, "`.extend()` of a `{vs[0].ty.name()}` onto a `{r.ty.name()}`")
        ys := copy_if_place(args[0].value, vs[0])
        call("rt.list_extend", [r.id, ys, size], Ty.Unit)
        watch_plain(npos, r, "extend")
        return unit
    if name == "clear" and vs.len() == 0
        uniq_clear(r)
        call("rt.list_clear", [r.id], Ty.Unit)
        watch_plain(npos, r, "clear")
        return unit
    if name == "reversed" and vs.len() == 0
        copy := call("rt.list_copy", [r.id, size], r.ty)
        call("rt.list_reverse", [copy, size], Ty.Unit)
        return Val(id: copy, ty: r.ty)
    if name == "reverse" and vs.len() == 0
        call("rt.list_reverse", [r.id, size], Ty.Unit)
        watch_plain(npos, r, "reverse")
        return unit
    if name == "remove_at" and vs.len() == 1
        # The read checks the index (type.coll.4); the call then removes it.
        v := checked("get", [r.id, vs[0].id], bounds_site(npos), e)
        call("rt.list_remove_at", [r.id, vs[0].id, size], Ty.Unit)
        watch_note(npos, r, "remove_at", Val(id: v, ty: e), "index", vs[0])
        return Val(id: v, ty: e)
    if name == "insert" and vs.len() == 2
        item := Val(id: copy_if_place(args[1].value, vs[1]), ty: vs[1].ty)
        x := convert(item, e, npos)
        n := op("len", [r.id], Ty.Int)
        i := vs[0].id
        fail := new_block()
        check(op("le", [konst(0, Ty.Int), i], Ty.Bool), fail)
        check(op("le", [i, n], Ty.Bool), fail)
        good := cur
        seal(fail)
        cur = fail
        mut t := inst(-1, "trap", [i, n])
        t.imm = 8
        t.site = site("type.coll.4", "insert", "", npos)
        emit_void(t)
        finish(unreachable_term())
        cur = good
        mut w := x
        if e.is_float()
            w = list_prim("float_bits", [x], Ty.Int)
        call("rt.list_insert", [r.id, i, w, size], Ty.Unit)
        watch_note(npos, r, "insert", Val(id: x, ty: e), "index", vs[0])
        return unit
    if name == "pop" and vs.len() == 0
        # As a value: the removed last element as a `T?`. The statement form
        # is `lower_pop_stmt`; `pop() else ...` is `lower_pop_else`.
        t := opt_of(e) else return unsupported(npos, "an optional `{e.name()}`")
        n := op("len", [r.id], Ty.Int)
        has := op("lt", [konst(0, Ty.Int), n], Ty.Bool)
        join := new_block()
        got := new_value(t, "")
        blocks[join].params.push(got)
        yes := new_block()
        no := new_block()
        branch(has, yes, [], no, [])
        seal(yes)
        cur = yes
        v := op("get", [r.id, op("sub", [n, konst(1, Ty.Int)], Ty.Int)], e)
        call("rt.list_drop_last", [r.id], Ty.Unit)
        jump(join, [some(Val(id: v, ty: e)).id])
        seal(no)
        cur = no
        jump(join, [konst(0, t)])
        seal(join)
        cur = join
        return Val(id: got, ty: t)
    if name == "contains" and vs.len() == 1
        k := eq_kind(e)
        if k < 0
            if found := list_contains_eq(r, e, convert(vs[0], e, npos))
                return found
            return unsupported(npos, "`.contains()` on `{r.ty.name()}`")
        mut w := convert(vs[0], e, npos)
        if e.is_float()
            w = list_prim("float_bits", [w], Ty.Int)
        return Val(
            id: call("rt.list_contains", [r.id, w, konst(k, Ty.Int), size], Ty.Bool),
            ty: Ty.Bool,
        )
    if (name == "sort" or name == "sorted") and vs.len() == 0
        k := ord_kind(e)
        if k < 0
            return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
        mut target := r.id
        if name == "sorted"
            target = call("rt.list_copy", [r.id, size], r.ty)
        if e.elem_bytes() < 8
            wide := words_of(Val(id: target, ty: r.ty), e)
            call("rt.list_sort", [wide, konst(k, Ty.Int)], Ty.Unit)
            call("rt.list_narrow_into", [target, wide, size], Ty.Unit)
        else
            call("rt.list_sort", [target, konst(k, Ty.Int)], Ty.Unit)
        if name == "sorted"
            return Val(id: target, ty: r.ty)
        watch_plain(npos, r, "sort")
        return unit
    if is_set_op(name) and vs.len() == 1
        return set_op(r, name, vs[0], npos)
    if name == "swap" and vs.len() == 2
        # Both reads check their index (type.coll.7); the call then swaps.
        checked("get", [r.id, vs[0].id], bounds_site(npos), e)
        checked("get", [r.id, vs[1].id], bounds_site(npos), e)
        call("rt.list_swap", [r.id, vs[0].id, vs[1].id, size], Ty.Unit)
        sw := WNote(kind: "swap", elem: none, label: "index", at: vs[0], at2: vs[1])
        watch_note_if(npos, 0 - 1, r, sw)
        return unit
    if name == "take" and vs.len() == 1
        n := convert(vs[0], Ty.Int, npos)
        texts := trap_texts("type.coll.15", npos)
        return Val(id: call("rt.list_take", [r.id, n, size, texts[0], texts[1]], r.ty), ty: r.ty)
    if name == "sum" and vs.len() == 0
        if e == Ty.Float
            return Val(id: call("rt.list_sum_float", [r.id], Ty.Float), ty: Ty.Float)
        if e == Ty.F32
            return Val(id: call("rt.list_sum_f32", [r.id], Ty.Float), ty: Ty.F32)
        if e.is_sized() and sized_kind(e) != "u64"
            k := sized_kind(e)
            texts := trap_texts("expr.arith.1", npos)
            sargs := [
                words_of(r, e),
                konst(sized_lo(k), Ty.Int),
                konst(sized_hi(k), Ty.Int),
                konst(sized_code(k), Ty.Int),
                texts[0],
                texts[1],
            ]
            return Val(id: call("rt.list_sum_sized", sargs, Ty.Int), ty: e)
        if e != Ty.Int
            return unsupported(npos, "`.sum()` on `{r.ty.name()}`")
        texts := trap_texts("expr.arith.1", npos)
        return Val(id: call("rt.list_sum_int", [r.id, texts[0], texts[1]], Ty.Int), ty: Ty.Int)
    n := op("len", [r.id], Ty.Int)
    nonempty := op("lt", [konst(0, Ty.Int), n], Ty.Bool)
    if name == "first" and vs.len() == 0
        return opt_at(r, nonempty, konst(0, Ty.Int), e, false, npos)
    if name == "last" and vs.len() == 0
        last := op("sub", [n, konst(1, Ty.Int)], Ty.Int)
        return opt_at(r, nonempty, last, e, false, npos)
    if (name == "min" or name == "max") and vs.len() == 0
        k := ord_kind(e)
        if k < 0
            return unsupported(npos, "`.{name}()` on `{r.ty.name()}`")
        greatest := konst(if name == "max" then 1 else 0, Ty.Int)
        idx := call("rt.list_extreme", [words_of(r, e), konst(k, Ty.Int), greatest], Ty.Int)
        found := op("le", [konst(0, Ty.Int), idx], Ty.Bool)
        return opt_at(r, found, idx, e, false, npos)
    if name == "index_of" and vs.len() == 1
        k := eq_kind(e)
        if k < 0
            idx := list_index_eq(r, e, convert(vs[0], e, npos)) else
                return unsupported(npos, "`.index_of()` on `{r.ty.name()}`")
            return opt_at(r, op("le", [konst(0, Ty.Int), idx], Ty.Bool), idx, Ty.Int, true, npos)
        mut w := convert(vs[0], e, npos)
        if e.is_float()
            w = list_prim("float_bits", [w], Ty.Int)
        idx := call("rt.list_index_of", [r.id, w, konst(k, Ty.Int), size], Ty.Int)
        found := op("le", [konst(0, Ty.Int), idx], Ty.Bool)
        return opt_at(r, found, idx, Ty.Int, true, npos)
    unsupported(npos, "`.{name}()` with these arguments")

## `T?` for a list read: the element at `idx` (or `idx` itself when `index` is
## set) when `has`, else `none`.
fn Lower.opt_at(mut self, xs Val, has int, idx int, e Ty, index bool, pos ast.Pos) Val?
    t := opt_of(e) else return unsupported(pos, "an optional `{e.name()}`")
    join := new_block()
    r := new_value(t, "")
    blocks[join].params.push(r)
    yes := new_block()
    no := new_block()
    branch(has, yes, [], no, [])
    seal(yes)
    cur = yes
    v := if index then idx else op("get", [xs.id, idx], e)
    jump(join, [some(Val(id: v, ty: e)).id])
    seal(no)
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: r, ty: t)

## A runtime primitive used by the lowering itself.
fn Lower.list_prim(mut self, name str, args List[int], ty Ty) int
    mut i := inst(-1, "prim", args)
    i.name = name
    emit(i, ty)

## `xs.pop() else ...` as a binding or an operand (err.else.1-2): the last
## element, else the fallback or a statement that leaves.
fn Lower.lower_pop_else(mut self, value ast.Expr, other ast.Else, pos ast.Pos) Val?
    recv := match value
        Method(r, _, _, _) => r
        _ => return none
    l := lower_value(recv, none)?
    e := l.ty.elem() else return unsupported(pos, "`.pop() else` on a `{l.ty.name()}`")
    n := op("len", [l.id], Ty.Int)
    has := op("lt", [konst(0, Ty.Int), n], Ty.Bool)
    join := new_block()
    r := new_value(e, "")
    blocks[join].params.push(r)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(found)
    cur = found
    last := op("sub", [n, konst(1, Ty.Int)], Ty.Int)
    v := op("get", [l.id, last], e)
    call("rt.list_drop_last", [l.id], Ty.Unit)
    jump(join, [v])
    seal(missing)
    cur = missing
    match other
        Fallback(x) => fallback_jump(x, e, join, pos)
        Leave(st) =>
            lower_stmt(st)
            if not done()
                problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(name, body, hpos) => handler_jump(name, body, hpos, e, join)
    seal(join)
    cur = join
    Val(id: r, ty: e)

## `xs.pop()` as a statement: the last element is dropped, nothing is boxed.
fn Lower.lower_pop_stmt(mut self, e ast.Expr) Val?
    recv := match e
        Method(r, _, _, _) => r
        _ => return none
    npos := match e
        Method(_, _, p, _) => p
        _ => return none
    l := lower_value(recv, none)?
    elem := l.ty.elem() else return none
    n := op("len", [l.id], Ty.Int)
    has := op("lt", [konst(0, Ty.Int), n], Ty.Bool)
    yes := new_block()
    join := new_block()
    branch(has, yes, [], join, [])
    seal(yes)
    cur = yes
    if watch_here(npos)
        last := op("sub", [n, konst(1, Ty.Int)], Ty.Int)
        gone := Val(id: op("get", [l.id, last], elem), ty: elem)
        call("rt.list_drop_last", [l.id], Ty.Unit)
        watch_note(npos, l, "pop", gone, "index", Val(id: last, ty: Ty.Int))
    else
        call("rt.list_drop_last", [l.id], Ty.Unit)
    jump(join, [])
    seal(join)
    cur = join
    Val(id: -1, ty: Ty.Unit)

fn is_pop_call(e ast.Expr) bool
    match e
        Method(_, n, _, a) => n == "pop" and a.len() == 0
        _ => false

## `xs.pop()` where `xs` may be a list: not a method of a user struct such as
## the prelude's `Heap`, which is an ordinary call (type.heap.3).
@allow("expr.match.3") fn Lower.is_list_pop(self, e ast.Expr) bool
    if not is_pop_call(e)
        return false
    match e
        Method(r, _, _, _) =>
            t := recv_ty(r) else return true
            match t
                Struct(_) => false
                _ => true
        _ => false

## `xs == ys` and `xs != ys` on lists of `int`, `float`, `bool` or `str`
## (type.coll.*, trait.auto.1): the same length and equal elements.
fn Lower.list_equal(mut self, o ast.BinOp, a Val, b Val) Val?
    e := a.ty.elem()?
    k := eq_kind(e)
    if k < 0 or not (op_name(o) == "eq" or op_name(o) == "ne")
        return none
    same := call(
        "rt.list_eq",
        [a.id, b.id, konst(k, Ty.Int), konst(elem_bytes(e), Ty.Int)],
        Ty.Bool,
    )
    if op_name(o) == "ne"
        return Val(id: op("not", [same], Ty.Bool), ty: Ty.Bool)
    Val(id: same, ty: Ty.Bool)

## `xs[i]`, `xs[a..b]`, and `m[k]` on a map.
fn Lower.lower_index(mut self, recv ast.Expr, index ast.Expr, pos ast.Pos) Val?
    if g := grid_place(recv, index, pos)
        return lower_value(g, none)
    if d := deque_index(recv, index, pos)
        return d
    l := lower_value(recv, none)?
    if l.ty == Ty.Bytes
        return bytes_index(l, index, pos)
    if l.ty.is_coll()
        return lower_coll_index(l, index, pos)
    if l.ty.is_tensor()
        return lower_tensor_index(l, index, pos)
    elem := l.ty.elem() else return unsupported(pos, "indexing a `{l.ty.name()}`")
    if is_range(index)
        return match index
            Range(lo, hi, incl, rpos) => lower_slice(l, lo, hi, incl, rpos)
            _ => none
    i := lower_value(index, Ty.Int)?
    Val(id: checked("get", [l.id, i.id], bounds_site(pos), elem), ty: elem)

## A method of a list: `len`, `join`, `push` and the edits.
fn Lower.list_method(
    mut self,
    e Ty,
    r Val,
    name str,
    npos ast.Pos,
    vs List[Val],
    args List[ast.Arg],
    recv ast.Expr,
) Val?
    if name == "len" and vs.len() == 0
        return Val(id: op("len", [r.id], Ty.Int), ty: Ty.Int)
    if name == "is_empty" and vs.len() == 0
        return Val(
            id: op("eq", [op("len", [r.id], Ty.Int), konst(0, Ty.Int)], Ty.Bool),
            ty: Ty.Bool,
        )
    # type.coll.9
    if name == "join" and vs.len() == 1 and e == Ty.Str and vs[0].ty == Ty.Str
        return Val(id: call("rt.list_join", [r.id, vs[0].id], Ty.Str), ty: Ty.Str)
    if name == "join" and vs.len() == 1 and e == Ty.Char and vs[0].ty == Ty.Str
        return Val(id: call("rt.list_join_chars", [r.id, vs[0].id], Ty.Str), ty: Ty.Str)
    if name == "join"
        and vs.len() == 1
        and vs[0].ty == Ty.Str
        and (e == Ty.Int or e == Ty.Float or e == Ty.Bool)
        kind := konst(if e == Ty.Bool then 2 else if e == Ty.Float then 1 else 0, Ty.Int)
        return Val(id: call("rt.list_join_text", [r.id, vs[0].id, kind], Ty.Str), ty: Ty.Str)
    if name == "join" and vs.len() == 1 and vs[0].ty == Ty.Str
        if j := join_shown(r, e, vs[0].id)
            return j
        return join_texts(r, e, vs[0].id, npos)
    if name == "cmp" and vs.len() == 1
        return list_cmp_method(r, vs[0], npos)
    if is_list_edit(name)
        return lower_list_edit(r, e, name, npos, args, vs)
    if name == "push" and vs.len() == 1
        mut el := e
        if e.is_unknown()
            el = vs[0].ty
            retype(recv, Ty.List(el))
        # A list pushed from a place is copied: lists are values (ADR 0060).
        item := Val(id: copy_if_place(args[0].value, vs[0]), ty: vs[0].ty)
        pushed := convert(item, el, npos)
        call(push_fn(el), [r.id, pushed], Ty.Unit)
        if watch_here(npos)
            last := op("sub", [op("len", [r.id], Ty.Int), konst(1, Ty.Int)], Ty.Int)
            watch_note(npos, r, "push", Val(id: pushed, ty: el), "index", Val(id: last, ty: Ty.Int))
        return Val(id: -1, ty: Ty.Unit)
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## An empty list passed to a typed parameter takes its element type (type.coll.6).
fn Lower.retype_arg(mut self, arg ast.Expr, v Val, param Ty)
    pe := param.elem() else return
    ve := v.ty.elem() else return
    if ve.is_unknown() and not pe.is_unknown()
        retype(arg, param)
