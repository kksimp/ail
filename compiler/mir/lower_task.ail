## Lowering tasks (conc.task.1-6, native.task.1, ADRs 0599-0601): `t := spawn f(x)` builds a
## task record and queues it with the runtime (`compiler/rt/native/task.ail`),
## `t.wait()?` waits for it, and a function per `spawn` site, with one
## `rt.dispatch` that picks it by the record's id, lets a worker run the call.
## The runtime links only when the program uses tasks (`uses_tasks`).
use ast

## Word offsets of a task record (task.ail).
T_RESULT := 16
T_ARGS := 80

## One `spawn` site (`loop` -1): the function it calls and that function's
## types; or a `par for` (`loop` indexes `TaskState.pars`), whose chunk
## function `task.K` the compiler writes.
struct TaskSite
    func str
    params List[Ty]
    ret Ty
    loop int

## A variable a parallel loop's body uses: the chunk gets its value.
struct Cap
    name str
    ty Ty

## A `par for` the compiler runs on the pool (conc.par.8).
struct ParSite
    var str
    by_list bool
    caps List[Cap]
    ## `int` accumulators, each updated by one `+=` (conc.par.4).
    accs List[str]
    ## The body updates an atomic: iterations that ran can't be undone, so a
    ## trap is reported as it is instead of running the loop again.
    atomic bool
    body List[ast.Stmt]
    pos ast.Pos
    ## The function that holds the loop (a stack names it, not the chunk).
    owner str
    ## The module state of the function that holds the loop: the chunk is
    ## lowered after the module, so it needs them to resolve names.
    prefix str
    file int
    aliases Map[str, str]
    self_ty str
    ## Static work of one iteration in operations (`ParScan.work`), for the
    ## cost model of a loop the compiler chose to run in parallel (conc.par.14).
    work int
    ## `work` is only a floor: the body has a loop or calls a heavy function, so
    ## the region uses the whole pool rather than one worker per 65536 (conc.par.17).
    open bool
    ## Every operation of the body is in `work` (no loop, no call the count
    ## can't price): the loop needs `PAR_COUNTED` operations in all, since such
    ## operations are a fraction of a nanosecond each (conc.par.14, ADR 1157).
    priced bool
    ## The body is one element-wise store to a list of floats (`ast.lanes_target`),
    ## which runs in vector lanes in order: a priced loop of this shape needs `PAR_LANES`.
    lanes bool
    ## The body calls a function (`ParScan.calls`): a written `par for` over
    ## such a body goes to the pool from two iterations (conc.par.14).
    calls bool
    ## Outer lists pushed once per iteration (conc.par.16, lower_build.ail).
    builds List[Cap]

pub struct TaskState
    ## Whether the task runtime is linked (so `print` takes the output lock).
    on bool
    sites List[TaskSite]
    pars List[ParSite]
    ## The result type of the task a handle variable holds, by variable key.
    rets Map[str, Ty]
    ## The error type of the task a handle variable holds, when its function can fail.
    errs Map[str, Ty]
    fails Set[str]
    ## While lowering a chunk function: no loop inside it goes parallel again,
    ## and `+=` on these names also tracks the running sum's extremes.
    in_chunk bool
    ## While a chunk function is built, its `par for`'s enclosing function.
    owner str
    accs Set[str]
    ## The `with` blocks and task groups whose scope is open (lower_sync.ail).
    exits List[ExitAct]
    ## How many of `sites` have their function: `build_task_fns` runs again
    ## after the instances a chunk body asked for are made.
    built int
    ## The task runtime is linked only for loops the compiler runs on the
    ## pool: no `spawn`, atomics, channels or UI in the program, so ordinary
    ## code still runs its trap cleanups (the runtime skips them on workers).
    auto_only bool
    ## Cost of each function called from a loop body, and those being costed.
    fcost Map[str, int]
    fbusy Set[str]
    ## Functions whose cost is only a floor (a loop, recursion, or something
    ## the count can't price), and whether the costing under way met one.
    fvague Set[str]
    vague bool
    ## Fork-join (conc.par.15): calls to `redirect` go to its `.seq` copy, which
    ## `no_fork` keeps from forking; `seq_list` holds the copies still to make.
    redirect str
    no_fork bool
    seq_list List[str]
    seq_built int
    ## Why the last `par_plan` ran the loop in order, and the warnings of the build.
    why str
    notes List[str]

pub fn new_task_state() TaskState
    TaskState(
        on: false,
        sites: [],
        pars: [],
        rets: {},
        errs: {},
        fails: Set[str](),
        in_chunk: false,
        owner: "",
        accs: Set[str](),
        exits: [],
        built: 0,
        auto_only: false,
        fcost: {},
        fvague: Set[str](),
        vague: false,
        fbusy: Set[str](),
        redirect: "",
        no_fork: false,
        seq_list: [],
        seq_built: 0,
        why: "",
        notes: [],
    )

## Whether a program's source may use tasks, `par for` or atomics, so the
## task runtime is linked. A false positive only costs compile time.
pub fn uses_tasks(text str) bool
    text.contains("spawn ")
        or text.contains("par for")
        or text.contains("Atomic")
        or text.contains("Channel")
        or text.contains("Mutex")
        or text.contains("TaskGroup")
        or text.contains("task.threads")
        or text.contains("task.set_threads")
        or text.contains("proc.start")
        or text.contains("std.app")
        or text.contains("tensor.")
        or text.contains("fs.scan")

## `fn main() !`: no result and no error type of its own. The only `?` the
## subset knows is `t.wait()?`, which ends the program on a trap.
fn bare_fallible(t ast.TypeRef) bool
    match t.shape
        Fallible(ok, errors) => ok == none and errors == none
        _ => false

fn is_spawn(e ast.Expr) bool
    match e
        Unary(o, _, _) =>
            match o
                Spawn => true
                Neg | Not => false
        _ => false

## A primitive call from lowered program code: `store64` and the like.
fn Lower.prim_op(mut self, name str, args List[int], ty Ty) int
    mut i := inst(-1, "prim", args)
    i.name = name
    if ty.is_unit()
        emit_void(i)
        return -1
    emit(i, ty)

## `name := spawn f(args)`: lower the call's arguments into a task record,
## queue it, and bind the record as the handle.
fn Lower.lower_spawn_let(mut self, name str, pos ast.Pos, value ast.Expr)
    inner := match value
        Unary(_, x, _) => x
        _ => value
    # The trace names the `spawn` keyword, not the start of the statement.
    at := match value
        Unary(_, _, p) => p
        _ => pos
    h := self.lower_spawn(inner, at) else
        declare(name, Ty.Unknown, -1)
        return
    declare(name, Ty.Int, h.id)
    key := lookup(name) else return
    site := tk.sites[tk.sites.len() - 1]
    tk.rets[key] = site.ret
    if s := sigs.get(site.func)
        if s.fails
            tk.fails.add(key)
            tk.errs[key] = fn_errs.get(site.func) else Ty.Unknown

fn Lower.lower_spawn(mut self, e ast.Expr, pos ast.Pos) Val?
    match e
        Call(callee, args, cpos) =>
            match callee
                Name(name, npos) => self.spawn_call("{prefix}{name}", name, npos, args, cpos, pos)
                _ => unsupported(cpos, "`spawn` of anything but a function")
        # `spawn m.f(..)`: a function of an imported module (mod.use.2).
        Method(recv, name, npos, args) =>
            m := module_name(recv) else return unsupported(
                pos,
                "`spawn` of anything but a function call",
            )
            self.spawn_call("{m}.{name}", name, npos, args, npos, pos)
        _ => unsupported(pos, "`spawn` of anything but a function call")

## Queues the task `key(args)` and returns its record.
fn Lower.spawn_call(
    mut self,
    key str,
    name str,
    npos ast.Pos,
    args List[ast.Arg],
    cpos ast.Pos,
    pos ast.Pos,
) Val?
    if bad.contains(key)
        return none
    sig := sigs.get(key) else return unsupported(npos, "calling `{name}`")
    if not tk.on
        return unsupported(pos, "`spawn`")
    if args.len() != sig.params.len()
        return unsupported(cpos, "this call")
    rec := call("rt.task_new", [konst(tk.sites.len(), Ty.Int)], Ty.Int)
    mut traced := List[int]()
    for k in 0..args.len()
        a := args[k]
        if a.label != none
            return unsupported(cpos, "labelled arguments")
        v := lower_value(a.value, sig.params[k])?
        id := convert(v, sig.params[k], expr_pos(a.value))
        # A task works on its own copy of a list (conc.share.1).
        w := copy_if_place(a.value, Val(id: id, ty: sig.params[k]))
        traced.push(w)
        at := op("add", [rec, konst(T_ARGS + 8 * k, Ty.Int)], Ty.Int)
        self.prim_op(if sig.params[k].is_float() then "storef" else "store64", [at, w], Ty.Unit)
    trace_spawn(key, sig.params, traced, rec, pos)
    call("rt.task_start", [rec], Ty.Unit)
    tk.sites.push(TaskSite(func: key, params: sig.params, ret: sig.ret, loop: -1))
    Val(id: rec, ty: Ty.Int)

## `t.wait()?`: the task's result, or the program ends with the trap.
pub fn is_wait_call(e ast.Expr) bool
    match e
        Method(_, name, _, margs) => name == "wait" and margs.len() == 0
        _ => false

fn Lower.lower_wait(mut self, inner ast.Expr, pos ast.Pos) Val?
    match inner
        Method(recv, name, npos, margs) =>
            if name == "wait" and margs.len() == 0
                match recv
                    Name(tname, _) =>
                        key := lookup(tname) else return unsupported(pos, "`?`")
                        res := tk.rets.get(key) else return unsupported(pos, "`?`")
                        h := read_var(key, cur)
                        at1 := trace_line(npos)
                        at2 := trace_line(pos)
                        trace_wait(h, npos)
                        w := call("rt.task_wait", [h, at1, at2], Ty.Int)
                        chan_deadlock_trap(npos)
                        mut v := Val(id: w, ty: res)
                        if res.is_unit()
                            v = Val(id: -1, ty: Ty.Unit)
                        elif res.is_float()
                            v = Val(id: self.prim_op("bits_float", [w], Ty.Float), ty: Ty.Float)
                        # The task's own error passes through `?` (conc.task.6).
                        if fails
                            return propagate_result(v, none, pos)
                        return v
                    _ => return unsupported(pos, "`wait` on anything but a task variable")
            unsupported(pos, "`?`")
        _ => unsupported(pos, "`?`")

## `t.wait() else ...`: the result, or the failure `Trapped` (conc.task.6).
fn Lower.lower_wait_try(mut self, e ast.Expr) Maybe?
    match e
        Method(recv, _, npos, _) =>
            match recv
                Name(tname, _) => self.wait_try_var(tname, npos)
                _ => none
        _ => none

fn Lower.wait_try_var(mut self, tname str, npos ast.Pos) Maybe?
    key := lookup(tname)?
    res := tk.rets.get(key)?
    h := read_var(key, cur)
    own := tk.fails.contains(key)
    trace_wait(h, npos)
    wt := if res.is_unit() or res.is_float() then Ty.Int else res
    w := call("rt.task_try", [h, trace_line(npos), konst(if own then 1 else 0, Ty.Int)], wt)
    chan_deadlock_trap(npos)
    failure := call("rt.failed", [], Ty.Bool)
    mut v := Val(id: w, ty: res)
    if res.is_unit()
        v = Val(id: -1, ty: Ty.Unit)
    elif res.is_float()
        v = Val(id: self.prim_op("bits_float", [w], Ty.Float), ty: Ty.Float)
    Maybe(
        val: v,
        present: op("not", [failure], Ty.Bool),
        opt: false,
        err: if own then (tk.errs.get(key) else Ty.Unknown) else Ty.Struct(TRAPPED),
    )

## `print` holds the output buffer's lock while a program runs tasks, so a
## line from one task isn't split by another's. The values are worked out
## first: `print(t.wait()?)` must not hold the lock while it waits for a task
## that prints or traps.
fn Lower.lower_print(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if not tk.on
        return lower_print_body(args, pos)
    if args.len() != 1
        return unsupported(pos, "this `print`")
    mut shown := List[Val]()
    mut ipos := pos
    match args[0].value
        Interp(parts, at) =>
            ipos = at
            for p in parts
                match p
                    Lit(_) => shown.push(Val(id: -1, ty: Ty.Unit))
                    Hole(x) => shown.push(lower_value(x, none)?)
                    Fmt(x, _) => shown.push(lower_value(x, none)?)
        _ => shown.push(lower_value(args[0].value, none)?)
    call("rt.out_lock", [], Ty.Unit)
    match args[0].value
        Interp(parts, _) =>
            for k in 0..parts.len()
                match parts[k]
                    Lit(text) => call("rt.out_str", [str_value(text)], Ty.Unit)
                    Hole(_) => out(shown[k], ipos)?
                    Fmt(_, spec) => lower_fmt_print(shown[k], spec, ipos)?
        _ => out(shown[0], pos)?
    call("rt.out_nl", [], Ty.Unit)
    call("rt.out_unlock", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

# ---- the functions that run tasks ----

## Start a function made by the compiler: the state `lower_fn` resets.
fn Lower.synth_begin(mut self, name str, params List[Ty]) List[int]
    fname = name
    ret = Ty.Unit
    blocks = []
    vals = []
    names = []
    sealed = []
    closed = []
    preds = []
    defs = []
    incomplete = []
    scopes = [Map[str, str]()]
    var_ty = {}
    var_vals = {}
    nvars = 0
    loops = []
    ens = []
    inv_key = ""
    borrowed = Set[str]()
    facts.moves = []
    cur = new_block()
    sealed[cur] = true
    mut ps := List[int]()
    for t in params
        v := new_value(t, "")
        blocks[cur].params.push(v)
        ps.push(v)
    ps

fn Lower.synth_end(mut self, params List[int])
    self.flat_scan()
    mut func := Func(
        name: fname,
        params: params,
        ret: Ty.Unit,
        blocks: blocks,
        vals: vals,
        names: names,
    )
    simplify_in(mut func)
    fold_in(mut func)
    simplify_in(mut func)
    for err in verify(func)
        problems.push(Problem(
            rule: "native.build.2",
            pos: ast.Pos(line: 1, col: 1),
            message: "internal error: invalid MIR: {err}",
        ))
    facts.moves = []
    funcs.push(func)

## For each `spawn` site a function `task.K(rec)` that loads the arguments
## from the record, makes the call and stores the result, and the chunk
## function of each `par for`; sites made since the last call (ADR 0911).
fn Lower.build_task_fns(mut self)
    if not tk.on
        return
    gen_fork_seqs()
    first := tk.built
    tk.built = tk.sites.len()
    for k in first..tk.sites.len()
        s := tk.sites[k]
        if s.loop >= 0
            self.build_par_fn(k, tk.pars[s.loop])
            continue
        ps := self.synth_begin("task.{k}", [Ty.Int])
        rec := ps[0]
        mut vs := List[int]()
        for j in 0..s.params.len()
            at := op("add", [rec, konst(T_ARGS + 8 * j, Ty.Int)], Ty.Int)
            vs.push(self.prim_op(
                if s.params[j].is_float() then "loadf" else "load64",
                [at],
                s.params[j],
            ))
        r := call(s.func, vs, s.ret)
        if not s.ret.is_unit()
            at := op("add", [rec, konst(T_RESULT, Ty.Int)], Ty.Int)
            self.prim_op(if s.ret.is_float() then "storef" else "store64", [at, r], Ty.Unit)
        finish(return_of(-1))
        self.synth_end(ps)

## `rt.dispatch`: the task function for a site number, once every site has one.
fn Lower.gen_task_dispatch(mut self)
    if not tk.on
        return
    ps := self.synth_begin("rt.dispatch", [Ty.Int, Ty.Int])
    # The tensor kernels' chunks (task.ail, ADR 0876).
    tyes := new_block()
    tno := new_block()
    sealed[tyes] = true
    sealed[tno] = true
    branch(op("eq", [ps[0], konst(1073741824, Ty.Int)], Ty.Bool), tyes, [], tno, [])
    cur = tyes
    call("rt.tensor_chunk", [ps[1]], Ty.Unit)
    finish(return_of(-1))
    cur = tno
    # The subtrees of an `fs.scan` (scan.ail, ADR 0927).
    syes := new_block()
    sno := new_block()
    sealed[syes] = true
    sealed[sno] = true
    branch(op("eq", [ps[0], konst(1073741825, Ty.Int)], Ty.Bool), syes, [], sno, [])
    cur = syes
    call("rt.scan_chunk", [ps[1]], Ty.Unit)
    finish(return_of(-1))
    cur = sno
    for k in 0..tk.sites.len()
        yes := new_block()
        no := new_block()
        sealed[yes] = true
        sealed[no] = true
        branch(op("eq", [ps[0], konst(k, Ty.Int)], Ty.Bool), yes, [], no, [])
        cur = yes
        call("task.{k}", [ps[1]], Ty.Unit)
        finish(return_of(-1))
        cur = no
    finish(return_of(-1))
    self.synth_end(ps)

# ---- parallel loops (conc.par.*, ADR 0601) ----

## Run the loop in order, and say why (`tk.why`, shown for a written `par for`).
fn Lower.decline(mut self, why str) ParSite?
    tk.why = why
    none

## Whether a `par for` can run its iterations in chunks on the pool, and
## what its chunks need (conc.par.8): it writes only list elements and `int`
## accumulators, each updated by one `+=` outside nested loops.
fn Lower.par_plan(mut self, var str, iter ast.Expr, body List[ast.Stmt], pos ast.Pos) ParSite?
    tk.why = ""
    if not tk.on or tk.in_chunk
        return none
    mut by_list := false
    match iter
        Range(a, b, incl, _) =>
            if a == none or b == none or incl
                return self.decline("the loop is not `lo..hi` (an open or inclusive range)")
        Name(n, _) =>
            key := lookup(n) else return self.decline("the loop is over `{n}`, which is not a local list")
            e := var_ty[key].elem() else return self.decline("`{n}` is not a list")
            if e.elem() != none or mutates(body, iter)
                return self.decline("the list `{n}` is nested or changed in the body")
            by_list = true
        _ => return self.decline("the loop is not over `lo..hi` or a list variable")
    mut sc := ast.new_scan()
    ast.scan_block(mut sc, body, 0)
    if sc.bad
        return self.decline("the body has {sc.why}")
    # A bare call of a method of `self` (`glyph(x, y)` inside a method) needs `self` itself, which a
    # chunk doesn't capture (only the fields the body names bare): left sequential.
    # As the call's lowering does, a method of a generic `self` is instantiated first, so it is in `sigs`.
    if self_ty != "" and sc.callees.len() >= 64
        return self.decline("the body makes too many calls to check for methods of `self`")
    if self_ty != ""
        for c in sc.callees
            if lookup(c) != none
                continue
            if not sigs.contains("{self_ty}.{c}")
                instance_method("{self_ty}.{c}")
            if sigs.contains("{self_ty}.{c}") or bad.contains("{self_ty}.{c}")
                return self.decline("the body calls `{c}`, a method of `self`")
    mut caps := List[Cap]()
    mut accs := List[str]()
    mut atomic := false
    builds := par_builds(var, body, sc)
    for n in sc.names.sorted()
        if n == var or has_build(builds, n)
            continue
        mut ty := Ty.Unknown
        mut field := false
        if key := lookup(n)
            ty = var_ty[key]
            if tk.rets.contains(key)
                return self.decline("the body uses `{n}`, whose type or kind a chunk can't capture")
        else
            # A field of `self` the body names bare: the chunk gets its value,
            # read when the loop starts, as it gets a local's (`cap_value`).
            k := self_slot(n)
            if k < 0
                continue
            ty = structs[self_ty][k].ty
            field = true
        if sc.decls.contains(n)
            return self.decline("the body declares `{n}`, which an outer variable also has")
        if ty.is_unknown() or ty.is_unit()
            return self.decline("the body uses `{n}`, whose type or kind a chunk can't capture")
        if field and (sc.adds.contains(n) or sc.other.contains(n))
            return self.decline("the body assigns the field `{n}` of `self`")
        if sc.mutated.contains(n) and ty.elem() != none
            return self.decline("the body changes the captured list `{n}` (`push` or a `mut` argument)")
        n_adds := sc.adds.get(n) else 0
        n_reads := sc.reads.get(n) else 0
        if n_adds > 0
            if ty != Ty.Int or n_adds != 1 or n_reads > 0 or sc.other.contains(n)
                return self.decline("`{n}` is updated by more than one `+=`, is read, or is not an `int`")
            accs.push(n)
        elif sc.other.contains(n)
            return self.decline("the body assigns the outer variable `{n}`")
        if ty.elem() == none and atomic_elem(ty) != none
            atomic = true
        caps.push(Cap(name: n, ty: ty))
    if accs.len() > 3 or atomic and accs.len() > 0
        return self.decline("more than three `+=` accumulators, or an atomic with one")
    if by_list
        key := lookup(root_of(iter)) else return self.decline("the list is not a local")
        caps.push(Cap(name: "__plist", ty: var_ty[key]))
    tk.vague = false
    cw := self.callee_work(sc, prefix, 0)
    ParSite(
        var: var,
        by_list: by_list,
        caps: caps,
        accs: accs,
        atomic: atomic,
        body: body,
        pos: pos,
        owner: fname,
        prefix: prefix,
        file: file,
        aliases: aliases,
        self_ty: self_ty,
        work: sc.work + 1 + cw,
        open: sc.looped or cw >= 4096,
        priced: not sc.looped and not sc.opaque and not tk.vague,
        lanes: not by_list and self.lanes_store(body, var),
        # A built list's `push` is not a call that makes an iteration heavy (conc.par.14).
        calls: sc.calls and (sc.callees.len() > 0 or builds.len() == 0),
        builds: builds,
    )

fn root_of(e ast.Expr) str
    match e
        Name(n, _) => n
        _ => ""

## `par for`: chunks of the iterations on the pool when the loop is long
## enough and nothing in a chunk traps; else the loop in order, which is its
## meaning (conc.par.5) and, after a trap or an accumulator that would
## overflow, the only way to report the sequential trap (conc.par.11).
fn Lower.lower_par_for(
    mut self,
    var str,
    iter ast.Expr,
    body List[ast.Stmt],
    pos ast.Pos,
    auto bool,
)
    if auto and self.lower_split(var, iter, body, pos)
        return
    plan := self.par_plan(var, iter, body, pos) else
        # A written `par for` is a promise of speed: say when it isn't kept.
        # `ail check` already warned about what the shared scan refuses.
        shared := tk.why.starts_with("the body has") or tk.why.starts_with("the loop is not over")
        if not auto and tk.why != "" and not tk.in_chunk and not shared
            note := "{file_paths[file]}:{pos.line}:{pos.col}: warning[conc.par.13]: `par for {var}` runs in order: {tk.why}"
            if not tk.notes.contains(note)
                tk.notes.push(note)
        lower_for(var, iter, body, false, pos)
        return
    if auto
        and (cheap_build(plan) or loops.len() > 0 and short_range(iter, plan.work, par_total(plan)))
        lower_for(var, iter, body, false, pos)
        return
    scopes.push(Map[str, str]())
    mut lo := -1
    mut hi := -1
    mut seq_iter := iter
    if plan.by_list
        l := lower_value(iter, none) else
            scopes.pop()
            return
        declare("__plist", l.ty, l.id)
        lo = konst(0, Ty.Int)
        hi = op("len", [l.id], Ty.Int)
        seq_iter = ast.Expr.Name(name: "__plist", pos: pos)
    else
        match iter
            Range(a, b, _, _) =>
                x := lower_value(a else iter, Ty.Int) else
                    scopes.pop()
                    return
                y := lower_value(b else iter, Ty.Int) else
                    scopes.pop()
                    return
                lo = x.id
                hi = y.id
                declare("__plo", Ty.Int, lo)
                declare("__phi", Ty.Int, hi)
                seq_iter = ast.Expr.Range(
                    lo: ast.Expr.Name(name: "__plo", pos: pos),
                    hi: ast.Expr.Name(name: "__phi", pos: pos),
                    inclusive: false,
                    pos: pos,
                )
            _ => return
    id := tk.sites.len()
    pi := tk.pars.len()
    tk.sites.push(TaskSite(func: "task.{id}", params: [], ret: Ty.Unit, loop: pi))
    tk.pars.push(plan)
    ncaps := plan.caps.len()
    par_blk := new_block()
    comb := new_block()
    done := new_block()
    seq := new_block()
    join := new_block()
    # A written `par for` needs only the iteration count (conc.par.8); a loop the
    # compiler chose also needs enough work to repay the pool (conc.par.14).
    # 4096 is `PAR_HEAVY` in rt/native/task.ail.
    weight := konst(if not auto and plan.calls then 4096 else plan.work, Ty.Int)
    if auto and loops.len() > 0
        self.nested_par_test(
            lo,
            hi,
            if build_open(plan) then NESTED_BUILD_NEED else par_need(plan.work, par_total(plan)),
            seq,
        )
    # A chosen loop whose work is all counted needs `PAR_COUNTED` operations (2),
    # or `PAR_LANES` when it runs in vector lanes in order (3).
    mut mode := 0
    if auto
        mode = 1
        if plan.priced
            mode = if plan.lanes then 3 else 2
    chosen := konst(mode, Ty.Int)
    branch(call("rt.par_worth", [lo, hi, weight, chosen], Ty.Bool), par_blk, [], seq, [])
    seal(par_blk)
    cur = par_blk
    env := call("rt.env_new", [konst(ncaps + plan.accs.len(), Ty.Int)], Ty.Int)
    for i in 0..ncaps
        c := plan.caps[i]
        v := self.cap_value(c, pos) else continue
        at := op("add", [env, konst(8 * i, Ty.Int)], Ty.Int)
        self.prim_op(if c.ty.is_float() then "storef" else "store64", [at, v], Ty.Unit)
    for a in 0..plan.accs.len()
        key := lookup(plan.accs[a]) else continue
        at := op("add", [env, konst(8 * (ncaps + a), Ty.Int)], Ty.Int)
        self.prim_op("store64", [at, read_var(key, cur)], Ty.Unit)
    # A floor of the work (a loop or a heavy call inside) spreads over the whole pool.
    width := if plan.open then konst(65536, Ty.Int) else weight
    grp := call("rt.par_start", [konst(id, Ty.Int), env, lo, hi, width], Ty.Int)
    waited := call("rt.par_wait", [grp], Ty.Bool)
    if plan.atomic
        broke := new_block()
        branch(waited, comb, [], broke, [])
        seal(broke)
        cur = broke
        call("rt.par_fail", [grp], Ty.Unit)
        finish(unreachable_term())
    else
        branch(waited, comb, [], seq, [])
    seal(comb)
    cur = comb
    all_ok := call(
        "rt.par_combine",
        [grp, env, konst(plan.accs.len(), Ty.Int), konst(ncaps, Ty.Int)],
        Ty.Bool,
    )
    branch(all_ok, done, [], seq, [])
    seal(done)
    seal(seq)
    # The loop in order first: it finds the element type of a built list (conc.par.16).
    cur = seq
    lower_for(var, seq_iter, body, false, pos)
    jump(join, [])
    cur = done
    for a in 0..plan.accs.len()
        key := lookup(plan.accs[a]) else continue
        at := op("add", [env, konst(8 * (ncaps + a), Ty.Int)], Ty.Int)
        write_var(key, cur, self.prim_op("load64", [at], Ty.Int))
    gather_builds(pi, grp)
    jump(join, [])
    seal(join)
    cur = join
    scopes.pop()

## A loop the compiler chose inside a loop run in order (conc.par.14): compare
## its iteration count with the count its work needs inline, so a short inner
## run costs one compare and no call on each run of the outer body. The numbers
## are `PAR_MIN_WORK`, `PAR_COUNTED`, `PAR_LANES` and `PAR_HEAVY` of rt/native/task.ail; `rt.par_worth`
## still decides past this test.
fn Lower.nested_par_test(mut self, lo int, hi int, need int, seq int)
    test := new_block()
    n := op("sub", [hi, lo], Ty.Int)
    branch(op("ge", [n, konst(need, Ty.Int)], Ty.Bool), test, [], seq, [])
    seal(test)
    cur = test

## Iterations a builder loop of unknown work needs to go to the pool from inside
## a loop run in order (conc.par.14): each run of the outer body pays a dispatch
## and a gather, so a callee's loop is counted as 64 operations, not 4096, and
## 1048576 operations must be in sight. mandelbrot's 6800-pixel rows stay in order.
NESTED_BUILD_NEED := 16384

## A builder loop whose work is a callee's loop or recursion, not counted ops.
fn build_open(p ParSite) bool
    p.builds.len() > 0 and p.open and p.work >= 4096

## Operations a loop the compiler chose needs in all when every one is counted,
## and when its body also runs in vector lanes in order (`PAR_COUNTED` and
## `PAR_LANES` of rt/native/task.ail; conc.par.14, ADR 1157).
PAR_COUNTED := 1048576
PAR_LANES := 16777216

## Whether a loop body is one element-wise store to a list of floats, the
## shape native.vec.4 and native.vec.5 run in vector lanes (conc.par.14).
fn Lower.lanes_store(mut self, body List[ast.Stmt], var str) bool
    name := ast.lanes_target(body, var)
    if name == ""
        return false
    key := lookup(name) else return false
    e := var_ty[key].elem() else return false
    e.is_float()

## The operations a counted loop needs in all, or 0 for a loop whose count is a floor.
fn par_total(p ParSite) int
    if not p.priced
        return 0
    if p.lanes then PAR_LANES else PAR_COUNTED

## The iterations a loop the compiler chose needs before it goes to the pool;
## `total` is `par_total` of the loop.
fn par_need(work int, total int) int
    per := if work < 1 then 1 else work
    if total > 0
        need := (total + per - 1) / per
        return if need < 2 then 2 else need
    if per >= 4096 then 2 else (65536 + per - 1) / per

## A range of literal bounds too short to repay the pool (conc.par.14): an inner
## loop like `0..4` stays a plain loop, with no test and no call in the outer body.
@allow("expr.match.3") fn short_range(iter ast.Expr, work int, total int) bool
    match iter
        Range(a, b, _, _) =>
            x := a else return false
            y := b else return false
            match x
                Int(u, _) =>
                    lo := u.to_int() else return false
                    match y
                        Int(v, _) =>
                            hi := v.to_int() else return false
                            hi - lo < par_need(work, total)
                        _ => false
                _ => false
        _ => false

## The value a chunk captures for `c`: a local's, or a bare field of `self`
## read from its slot when the loop starts (conc.par.8).
fn Lower.cap_value(mut self, c Cap, pos ast.Pos) int?
    if key := lookup(c.name)
        return read_var(key, cur)
    k := self_slot(c.name)
    if k < 0
        problem(pos, "internal error: lost `{c.name}`")
        return none
    load(self_value(), k, c.ty)

## Word `n` of the arguments of the task record `rec`.
fn Lower.rec_word(mut self, rec int, n int) int
    at := op("add", [rec, konst(T_ARGS + 8 * n, Ty.Int)], Ty.Int)
    self.prim_op("load64", [at], Ty.Int)

## The chunk function of a parallel loop: `task.K(rec)` runs iterations
## `lo` to `hi` of the body over the captured values and leaves each
## accumulator's sum and the lowest and highest running sum in the record.
fn Lower.build_par_fn(mut self, k int, p ParSite)
    ps := self.synth_begin("task.{k}", [Ty.Int])
    rec := ps[0]
    tk.in_chunk = true
    tk.owner = p.owner
    was := ParSite(
        var: "",
        by_list: false,
        caps: [],
        accs: [],
        atomic: false,
        body: [],
        pos: p.pos,
        owner: "",
        prefix: prefix,
        file: file,
        aliases: aliases,
        self_ty: self_ty,
        work: 0,
        open: false,
        priced: false,
        lanes: false,
        calls: false,
        builds: [],
    )
    # Problems of the loop's body belong to its own file, not the one lowered before or after.
    stamp_problems()
    prefix = p.prefix
    file = p.file
    aliases = p.aliases
    self_ty = p.self_ty
    pos := p.pos
    env := self.rec_word(rec, 0)
    for i in 0..p.caps.len()
        c := p.caps[i]
        at := op("add", [env, konst(8 * i, Ty.Int)], Ty.Int)
        declare(c.name, c.ty, self.prim_op(
            if c.ty.is_float() then "loadf" else "load64",
            [at],
            c.ty,
        ))
    declare("__lo", Ty.Int, self.rec_word(rec, 1))
    declare("__hi", Ty.Int, self.rec_word(rec, 2))
    chunk_builds_begin(p)
    for a in p.accs
        declare(a, Ty.Int, konst(0, Ty.Int))
        declare("{a}#min", Ty.Int, konst(0, Ty.Int))
        declare("{a}#max", Ty.Int, konst(0, Ty.Int))
        tk.accs.add(a)
    range := ast.Expr.Range(
        lo: ast.Expr.Name(name: "__lo", pos: pos),
        hi: ast.Expr.Name(name: "__hi", pos: pos),
        inclusive: false,
        pos: pos,
    )
    if p.by_list
        take := ast.Stmt.Let(
            name: p.var,
            pos: pos,
            mutable: false,
            value: ast.Expr.Index(
                recv: ast.Expr.Name(name: "__plist", pos: pos),
                index: ast.Expr.Name(name: "__k", pos: pos),
                pos: pos,
            ),
            otherwise: none,
        )
        mut body := [take]
        body.extend(p.body)
        lower_for("__k", range, body, false, pos)
    else
        lower_for(p.var, range, p.body, false, pos)
    for a in 0..p.accs.len()
        base := T_ARGS + 8 * (3 + 3 * a)
        for part in 0..3
            name := if part
                == 0 then p.accs[a] else if part
                == 1 then "{p.accs[a]}#min" else "{p.accs[a]}#max"
            key := lookup(name) else continue
            at := op("add", [rec, konst(base + 8 * part, Ty.Int)], Ty.Int)
            self.prim_op("store64", [at, read_var(key, cur)], Ty.Unit)
    chunk_builds_end(rec, p)
    finish(return_of(-1))
    tk.in_chunk = false
    tk.owner = ""
    tk.accs = Set[str]()
    stamp_problems()
    prefix = was.prefix
    file = was.file
    aliases = was.aliases
    self_ty = was.self_ty
    self.synth_end(ps)

## After `acc += e` in a chunk: keep the lowest and highest running sum, so
## the sums of the chunks combine with the overflow checks the sequential
## loop would make (conc.par.4).
fn Lower.track_sum(mut self, target ast.Expr)
    n := match target
        Name(n, _) => n
        _ => return
    if not tk.accs.contains(n)
        return
    key := lookup(n) else return
    v := read_var(key, cur)
    for hi in [false, true]
        suffix := if hi then "max" else "min"
        ext := lookup("{n}#{suffix}") else return
        old := read_var(ext, cur)
        c := op(if hi then "gt" else "lt", [v, old], Ty.Bool)
        upd := new_block()
        join := new_block()
        branch(c, upd, [], join, [])
        seal(upd)
        cur = upd
        write_var(ext, cur, v)
        jump(join, [])
        seal(join)
        cur = join

## `lower_assign`, then the sum tracking of a chunk.
fn Lower.lower_assign(mut self, target ast.Expr, op ast.BinOp?, value ast.Expr, pos ast.Pos)
    lower_assign_body(target, op, value, pos)
    if tk.in_chunk
        self.track_sum(target)

# ---- atomics (conc.atomic.*, ADR 0600) ----

fn atomic_elem(t Ty) Ty?
    match t
        Atomic(e) => e
        _ => none

## `Atomic(v)` or `Atomic[T](v)`: an 8-byte cell holding `v`. A copy of the
## handle is the same cell (conc.atomic.3).
fn Lower.lower_atomic_new(mut self, targs List[ast.TypeRef]?, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1 or args[0].label != none
        return unsupported(pos, "this `Atomic`")
    mut want := Ty.Unknown
    if ts := targs
        if ts.len() != 1
            return unsupported(pos, "this `Atomic`")
        want = type_of(ts[0]) else return unsupported(pos, "this `Atomic`")
    v := lower_value(args[0].value, if want.is_unknown() then none else want)?
    if v.ty != Ty.Int and v.ty != Ty.Bool
        return unsupported(pos, "`Atomic` of `{v.ty.name()}`")
    if not want.is_unknown() and want != v.ty
        return unsupported(pos, "expected `{want.name()}`, found `{v.ty.name()}`")
    cell := call("rt.alloc", [konst(8, Ty.Int), konst(11, Ty.Int)], Ty.Int)
    self.prim_op("atomic_store", [cell, v.id], Ty.Unit)
    Val(id: cell, ty: Ty.Atomic(v.ty))

## `load`, `store`, `cas` and `add` on an atomic; an `order:` argument is
## accepted and every operation is sequentially consistent, which is at
## least as strong (conc.atomic.2, conc.atomic.7).
fn Lower.lower_atomic_method(
    mut self,
    cell int,
    elem Ty,
    name str,
    npos ast.Pos,
    args List[ast.Arg],
) Val?
    mut vs := List[int]()
    for a in args
        if a.mutable
            return unsupported(npos, "this method call")
        if l := a.label
            if l.name == "order"
                continue
            return unsupported(npos, "this method call")
        v := lower_value(a.value, elem)?
        vs.push(convert(v, elem, expr_pos(a.value)))
    # conc.sched.1: a random schedule may switch tasks at every atomic operation.
    if (env.get("AIL_SCHEDULE") else "").starts_with("random")
        call("rt.det_yield", [], Ty.Unit)
    if name == "load" and vs.len() == 0
        v := self.prim_op("atomic_load", [cell], elem)
        race_sync(cell, true, false)
        return Val(id: v, ty: elem)
    if name == "store" and vs.len() == 1
        race_sync(cell, false, true)
        self.prim_op("atomic_store", [cell, vs[0]], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    if name == "cas" and vs.len() == 2
        race_sync(cell, false, true)
        got := self.prim_op("atomic_cas", [cell, vs[0], vs[1]], Ty.Int)
        race_sync(cell, true, false)
        return Val(id: op("eq", [got, vs[0]], Ty.Bool), ty: Ty.Bool)
    if name == "add" and vs.len() == 1 and elem == Ty.Int
        # Retry until no other thread changed the cell between the read and
        # the swap; an overflow traps before the swap, leaving the cell as
        # it was (conc.atomic.5).
        race_sync(cell, false, true)
        head := new_block()
        exit := new_block()
        jump(head, [])
        cur = head
        old := self.prim_op("atomic_load", [cell], Ty.Int)
        site := site("conc.atomic.5", "arith", "+", npos)
        next := checked("add", [old, vs[0]], site, Ty.Int)
        got := self.prim_op("atomic_cas", [cell, old, next], Ty.Int)
        branch(op("eq", [got, old], Ty.Bool), exit, [], head, [])
        seal(head)
        seal(exit)
        cur = exit
        race_sync(cell, true, false)
        return Val(id: old, ty: Ty.Int)
    unsupported(npos, "`.{name}()` on `{Ty.Atomic(elem).name()}`")

## Operations the functions `sc` calls cost, each times its loop multiplier
## (conc.par.14). A function that reaches itself counts as `PAR_HEAVY` (4096),
## and the sum stays far from `int`.
fn Lower.callee_work(mut self, sc ast.ParScan, pre str, depth int) int
    mut total := 0
    for i in 0..sc.callees.len()
        total += self.fn_cost("{pre}{sc.callees[i]}", depth) * sc.callee_mult[i]
        if total > 1000000000
            return 1000000000
    total

## Operations one call of function `key` costs, by the same count as a loop body.
fn Lower.fn_cost(mut self, key str, depth int) int
    if c := tk.fcost.get(key)
        if tk.fvague.contains(key)
            tk.vague = true
        return c
    # Recursion, a deep chain, or a callee with no body here: the cost is a floor.
    if tk.fbusy.contains(key) or depth > 3
        tk.vague = true
        return 4096
    f := fn_decl.get(key) else
        tk.vague = true
        return 0
    body := f.body else
        tk.vague = true
        return 0
    tk.fbusy.add(key)
    mut sc := ast.new_scan()
    ast.scan_block(mut sc, body, 0)
    pre := key.slice(0, key.len() - f.name.len())
    outer_vague := tk.vague
    tk.vague = false
    mut w := sc.work + self.callee_work(sc, pre, depth + 1)
    if tk.vague or sc.looped or sc.opaque
        tk.fvague.add(key)
        tk.vague = true
    else
        tk.vague = outer_vague
    # A loop in the callee may run any number of times: count it as heavy.
    if sc.looped and w < 4096
        w = 4096
    tk.fbusy.remove(key)
    c := if w > 1000000000 then 1000000000 else w
    tk.fcost[key] = c
    c
