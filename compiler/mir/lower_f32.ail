## Scalar `f32` in the native subset (ADR 0834, type.num.13-15): a `float`
## register that always holds a value rounded to `f32`, typed `Ty.F32`. Each
## `+ - * /` is the `float` operation followed by the `f32_round` primitive
## (x86-64 `vcvtsd2ss` + `vcvtss2sd`, ARM64 `fcvt` pair), which gives the
## correctly rounded `f32` result because a `float` has more than twice an
## `f32`'s precision. Lists, maps, `Opt` and tuples of `f32` hold the rounded
## `float` as is and print with `rt.fmt_f32` (ADR 0834 part 4).
use ast

## The scalar number type a written name stands for.
fn scalar_ty(name str) Ty
    if name == "f32"
        return Ty.F32
    Ty.Sized(name)

## The runtime function that prints a `float` or an `f32`.
fn float_out_fn(t Ty) str
    if t == Ty.F32
        return "rt.out_f32"
    "rt.out_float"

## A float literal: an `f32` where one is wanted (rounded now, as the
## interpreter rounds it), else a `float`.
fn Lower.float_lit(mut self, x float, want Ty?) Val
    if want == Ty.F32
        return Val(id: fconst(x.to_f32().to_float()), ty: Ty.F32)
    Val(id: fconst(x), ty: Ty.Float)

## `x` rounded to the nearest `f32` (ties to even), by the primitive that
## compiles to the machine's two conversions.
fn Lower.f32_round(mut self, x int) int
    mut i := inst(-1, "prim", [x])
    i.name = "f32_round"
    emit(i, Ty.Float)

## `to_f32` of an integer. A sized integer is exact in a `float`, so its
## rounding to `f32` is the only one; an `int` is rounded once, by the
## runtime, because going through a `float` would round twice.
fn Lower.int_to_f32(mut self, r Val) Val
    if r.ty.is_sized()
        return Val(id: self.f32_round(op("itof", [r.id], Ty.Float)), ty: Ty.F32)
    Val(id: call("rt.int_to_f32", [r.id], Ty.Float), ty: Ty.F32)

## `a OP b` on two `f32`.
fn Lower.f32_binary(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val
    name := op_name(o)
    if is_comparison(o)
        return Val(id: op("f{name}", [a.id, b.id], Ty.Bool), ty: Ty.Bool)
    if name == "rem"
        problem(pos, "`%` on `f32`")
        return a
    Val(id: self.f32_round(op("f{name}", [a.id, b.id], Ty.Float)), ty: Ty.F32)

## The methods of an `f32` (type.num.14-15).
fn Lower.f32_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    if vs.len() != 0
        return unsupported(npos, "`.{name}()` on `f32`")
    f := Val(id: r.id, ty: Ty.Float)
    if name == "to_float"
        return f
    if name == "to_int"
        return float_method(f, name, npos, vs)
    if name == "abs" or name == "floor" or name == "ceil" or name == "round"
        # Exact on an `f32`: the result is an `f32` too.
        x := float_method(f, name, npos, vs)?
        return Val(id: x.id, ty: Ty.F32)
    if name == "sqrt"
        return Val(id: self.f32_round(op("sqrt", [r.id], Ty.Float)), ty: Ty.F32)
    unsupported(npos, "`.{name}()` on `f32`")
