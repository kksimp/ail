## Lowering `Map` and `Set` (type.map.*, ADRs 0568-0570). The table is a
## pointer to an object that `compiler/rt/native/map.ail` manages; every
## operation is a runtime call, apart from `len` and reading a value out of
## an entry, which are loads. A value is stored as one 8-byte word: a
## `float` as its bits, a `bool` as 0 or 1, anything else as itself.
##
## Not here (reported as outside the subset): `m.get(k)` and `m.remove(k)`
## used as a value (optionals), `==` on tables, `sorted`, `union`, set
## algebra, and keys other than `int`, `bool` and `str`.
use ast

# ---- types ----

fn is_key_ty(t Ty) bool
    t == Ty.Int or t == Ty.Bool or t == Ty.Str or t == Ty.Bytes or t == Ty.Char or t.is_sized()

fn is_value_ty(t Ty) bool
    is_number(t)
        or t == Ty.Char
        or t == Ty.Str
        or t == Ty.Bytes
        or needs_copy(t)
        or t.is_coll()
        or t.is_tensor()
        or is_enum(t)
        or is_shared_opt(t)
        or t.is_ref()
        or t.is_fn()

## `Map[K, V]` and `Set[T]` written as types, if they are in the subset.
fn Lower.coll_type_of(mut self, name str, args List[ast.TypeRef]) Ty?
    if name == "Map" and args.len() == 2
        k := type_of(args[0])?
        v := type_of(args[1])?
        if key_ok(k) and is_value_ty(v)
            return Ty.Map(key: k, val: v)
        return none
    if name == "Set" and args.len() == 1
        e := type_of(args[0])?
        if key_ok(e)
            return Ty.Set(e)
    none

## How the runtime prints and hashes a key: 0 `int`, 1 `str` (and `bytes`, which has a
## string object's layout), 2 `bool`, 4 `char`.
fn key_kind(t Ty) int
    match t
        Str | Bytes => 1
        Bool => 2
        Char => 4
        _ => 0

## How the runtime prints a scalar: 0 `int`, 1 `str`, 2 `bool`, 3 `float`,
## 4 `char`, 5 `bytes`, -1 for anything else.
fn scalar_kind(t Ty) int
    match t
        Int | Sized(_) => 0
        Str => 1
        Bool => 2
        Float => 3
        Char => 4
        Bytes => 5
        _ => -1

## How a copy of a table treats its values: `[mode, info]`, with mode 1 for
## lists (info: nesting depth * 256 + element bytes) and 2 for tables.
fn value_mode(v Ty) List[int]
    if holds_struct(v)
        # A copy of the table copies the structs (`copy.Map[...]`).
        return [0, 0]
    if v.is_coll()
        return [2, 0]
    mut t := v.elem() else return [0, 0]
    mut depth := 0
    while t.elem() != none
        depth += 1
        t = t.elem() else Ty.Unknown
    [1, depth * 256 + t.elem_bytes()]

# ---- building blocks ----

## A runtime primitive (native-abi.md §6) used by the lowering itself.
fn Lower.rawop(mut self, name str, args List[int], ty Ty) int
    mut i := inst(-1, "prim", args)
    i.name = name
    if ty.is_unit()
        emit_void(i)
        return -1
    emit(i, ty)

## A value as the word a table stores.
fn Lower.to_word(mut self, v int, t Ty) int
    if t.is_float()
        return self.rawop("float_bits", [v], Ty.Int)
    v

## The value of type `t` in the entry at address `e`.
fn Lower.entry_value(mut self, e int, t Ty) int
    addr := op("add", [e, konst(16, Ty.Int)], Ty.Int)
    if t.is_float()
        word := self.rawop("load64", [addr], Ty.Int)
        return self.rawop("bits_float", [word], Ty.Float)
    self.rawop("load64", [addr], t)

## `m.get(k)` as a `V?` (type.map.6): the entry's value, or `none`.
fn Lower.map_get(mut self, m Val, k int, vt Ty, pos ast.Pos) Val?
    t := opt_of(vt) else return unsupported(pos, "`.get(k)` on a map of `{vt.name()}`")
    e := self.map_lookup(m, k, true)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(t, "")
    blocks[join].params.push(r)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(found)
    cur = found
    jump(join, [some(Val(id: self.entry_value(e, vt), ty: vt)).id])
    seal(missing)
    cur = missing
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: r, ty: t)

## `m.get_or(k, d)` (type.map.12): the value stored under `k`, else `d`, which is always evaluated.
fn Lower.map_get_or(mut self, m Val, k int, d int, vt Ty) Val?
    e := self.map_lookup(m, k, true)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(vt, "")
    blocks[join].params.push(r)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(found)
    cur = found
    jump(join, [self.entry_value(e, vt)])
    seal(missing)
    cur = missing
    jump(join, [d])
    seal(join)
    cur = join
    Val(id: r, ty: vt)

## `m.remove(k)` as a value: the removed value, or `none` (type.map.5).
fn Lower.map_remove_value(mut self, m Val, k int, vt Ty, pos ast.Pos) Val?
    t := opt_of(vt) else return unsupported(pos, "`.remove(k)` on a map of `{vt.name()}`")
    e := call("rt.map_find", [m.id, k], Ty.Int)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(t, "")
    blocks[join].params.push(r)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(found)
    cur = found
    held := some(Val(id: self.entry_value(e, vt), ty: vt)).id
    call("rt.map_remove", [m.id, k], Ty.Unit)
    jump(join, [held])
    seal(missing)
    cur = missing
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: r, ty: t)

## `m.remove(k)` as a statement of the watched map (trace.watch.4): the entry is read, removed, and
## shown as `[remove OLD at key K]`; a missing key changes nothing and is not shown.
fn Lower.watch_map_remove(mut self, m Val, kid int, kt Ty, vt Ty, npos ast.Pos)
    e := call("rt.map_find", [m.id, kid], Ty.Int)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    found := new_block()
    done_b := new_block()
    branch(has, found, [], done_b, [])
    seal(found)
    cur = found
    old := Val(id: self.entry_value(e, vt), ty: vt)
    call("rt.map_remove", [m.id, kid], Ty.Unit)
    watch_note(npos, m, "remove", old, "key", Val(id: kid, ty: kt))
    jump(done_b, [])
    seal(done_b)
    cur = done_b

## A call that returns a stored word, as a value of type `t`.
fn Lower.word_call(mut self, name str, args List[int], t Ty) int
    if t.is_float()
        word := call(name, args, Ty.Int)
        return self.rawop("bits_float", [word], Ty.Float)
    call(name, args, t)

fn Lower.new_table(mut self, ty Ty) int
    match ty
        Map(k, v) =>
            m := value_mode(v)
            call("rt.map_new", [kind_val(k), konst(m[0], Ty.Int), konst(m[1], Ty.Int)], ty)
        Set(e) => call("rt.map_new", [kind_val(e), konst(0, Ty.Int), konst(0, Ty.Int)], ty)
        _ => -1

## A copy of the table `v` (own.val.1).
fn Lower.copy_coll(mut self, v Val) int
    x := match v.ty
        Map(_, x) => x
        _ => Ty.Unknown
    if holds_struct(x)
        name := "copy.{v.ty.name()}"
        if not sigs.contains(name)
            sigs[name] = Sig(params: [v.ty], ret: v.ty, fails: false)
            copy_tys[name] = v.ty
        return call(name, [v.id], v.ty)
    call("rt.map_copy", [v.id], v.ty)

## The trap's first line and source excerpt as string values, as the code
## generator builds them for a checked operation.
fn Lower.trap_texts(mut self, rule str, pos ast.Pos) List[int]
    where := if file < file_paths.len() then file_paths[file] else ""
    text := if file < src_lines.len() then src_lines[file] else []
    head := "{where}:{pos.line}:{pos.col}: trap[{rule}]: "
    line := if pos.line >= 1 and pos.line <= text.len() then text[pos.line - 1] else ""
    gutter := "{pos.line}"
    mut pad := List[str]()
    chars := line.chars()
    for c in 0..pos.col - 1
        pad.push(if c < chars.len() and chars[c] == '\t' then "\t" else " ")
    tail := "  {gutter} | {line}\n  {" ".repeat(gutter.chars().len())} | {pad.join("")}^\n{trap_frame(pos)}"
    [str_value(head), str_value(tail)]

## The entry's value when `e` isn't 0, else `zero`, joined.
fn Lower.entry_or(mut self, e int, t Ty, zero int) int
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(t, "")
    blocks[join].params.push(r)
    found := new_block()
    branch(has, found, [], join, [zero])
    seal(found)
    cur = found
    jump(join, [self.entry_value(e, t)])
    seal(join)
    cur = join
    r

# ---- constructors and literals ----

## `Map[K, V]()` and `Set[T]()` (type.coll.8).
fn Lower.coll_ctor(mut self, name str, targs List[ast.TypeRef], pos ast.Pos) Val?
    t := self.coll_type_of(name, targs) else
        return unsupported(pos, "`{name}` with these type arguments")
    Val(id: self.new_table(t), ty: t)

fn Lower.lower_map_lit(mut self, entries List[ast.MapEntry], pos ast.Pos, want Ty?) Val?
    mut kt := Ty.Unknown
    mut vt := Ty.Unknown
    if wanted := want
        # `{}` where a `Map[K, V]?` is expected is that map (type.coll.3).
        w := wanted.opt_inner() else wanted
        match w
            Map(k, v) =>
                kt = k
                vt = v
            Set(_) =>
                if entries.len() == 0
                    return Val(id: self.new_table(w), ty: w)
            _ => kt = kt
    if entries.len() == 0 and kt.is_unknown()
        return pending_table()
    mut ks := List[int]()
    mut vs := List[int]()
    for e in entries
        k := lower_value(e.key, if kt.is_unknown() then none else kt)?
        if kt.is_unknown()
            kt = k.ty
        v := lower_value(e.value, if vt.is_unknown() then none else vt)?
        if vt.is_unknown()
            vt = v.ty
        if not key_ok(kt) or not is_value_ty(vt)
            return unsupported(pos, "a map of `{kt.name()}` to `{vt.name()}`")
        ks.push(stored_key(e.key, k, kt, expr_pos(e.key)))
        vs.push(self.to_word(
            convert(Val(id: copy_if_place(e.value, v), ty: v.ty), vt, expr_pos(e.value)),
            vt,
        ))
    t := Ty.Map(key: kt, val: vt)
    m := self.new_table(t)
    for i in 0..ks.len()
        call("rt.map_set", [m, ks[i], vs[i]], Ty.Unit)
    Val(id: m, ty: t)

fn Lower.lower_set_lit(mut self, items List[ast.Expr], pos ast.Pos, want Ty?) Val?
    mut et := Ty.Unknown
    if w := want
        match w
            Set(e) => et = e
            _ => et = et
    if items.len() == 0 and et.is_unknown()
        return unsupported(pos, "an empty set whose type isn't known")
    mut xs := List[int]()
    for x in items
        v := lower_value(x, if et.is_unknown() then none else et)?
        if et.is_unknown()
            et = v.ty
        if not key_ok(et)
            return unsupported(pos, "a set of `{et.name()}`")
        xs.push(stored_key(x, v, et, expr_pos(x)))
    t := Ty.Set(et)
    s := self.new_table(t)
    for x in xs
        call("rt.map_add", [s, x], Ty.Unit)
    Val(id: s, ty: t)

# ---- reading and writing ----

## `m[k]` (type.map.3): traps when `k` is missing.
fn Lower.lower_coll_index(mut self, m Val, index ast.Expr, pos ast.Pos) Val?
    if is_pending_table(m.ty)
        return unsupported(pos, "an empty `\{}` whose type isn't known")
    match m.ty
        Map(kt, vt) =>
            k := self.join_key(m, lower_value(index, kt)?)
            kid := convert(k, kt, expr_pos(index))
            texts := self.trap_texts("type.map.3", pos)
            if not is_key_ty(kt)
                return composite_at(m, kid, kt, vt, texts)
            self.map_at_fast(m, kid, vt, texts)
        _ => unsupported(pos, "indexing a `{m.ty.name()}`")

## `m[k] = v` and `m[k] op= v` (type.map.3, type.map.7). `k` is evaluated
## before the right-hand side; a missing key under `op=` starts from zero.
fn Lower.lower_map_assign(
    mut self,
    m Val,
    index ast.Expr,
    op ast.BinOp?,
    value ast.Expr,
    pos ast.Pos,
    ipos ast.Pos,
)
    match m.ty
        Map(kt0, vt0) =>
            mut kt := kt0
            mut vt := vt0
            k := lower_value(index, if kt.is_unknown() then none else kt) else return
            mut r := Val(id: -1, ty: Ty.Unknown)
            if kt.is_unknown()
                # A pending `{}` (type.coll.13): this assignment types it; a value that
                # reads the table is typed from its other part first (ADR 1135).
                if g := self.self_read_value_ty(m, value)
                    if not settle_map(m, k.ty, g, ipos)
                        return
                    vt = g
                else
                    r = lower_value(value, none) else return
                    if not settle_map(m, k.ty, r.ty, ipos)
                        return
                    vt = r.ty
                kt = k.ty
            kid := stored_key(index, self.join_key(m, k), kt, ipos)
            if r.id < 0
                r = lower_value(value, vt) else return
            mut stored := -1
            if o := op
                zero := match vt
                    Float => fconst(0.0)
                    Int => konst(0, Ty.Int)
                    _ =>
                        problem(pos, "`{vt.name()}` has no `op=` for a missing key")
                        return
                # The value is a number: nothing between the lookup and the store calls.
                e := self.map_entry(m.id, kid, kt, false)
                old := self.entry_or(e, vt, zero)
                stored = binary(o, Val(id: old, ty: vt), r, pos).id
                self.map_put_found(m.id, kid, e, self.to_word(stored, vt))
            else
                stored = copy_if_place(value, Val(id: convert(r, vt, pos), ty: vt))
                uniq_drop_entry(m.id, kid, vt)
                self.map_put(m.id, kid, self.to_word(stored, vt))
            watch_note(pos, m, "set", Val(id: stored, ty: vt), "key", Val(id: kid, ty: kt))
        _ => problem(ipos, "assigning into a `{m.ty.name()}`")

## `m.get(k) else ...` (err.else.1-2): the value, else a fallback or a
## statement that leaves.
fn Lower.lower_get_else(mut self, value ast.Expr, other ast.Else, pos ast.Pos) Val?
    recv := match value
        Method(r, _, _, _) => r
        _ => return none
    key := match value
        Method(_, _, _, a) => a[0].value
        _ => return none
    removes := match value
        Method(_, n, _, _) => n == "remove"
        _ => false
    m := lower_value(recv, none)?
    # type.coll.34: `xs.get(i) else ...` on a list (lower_listget.ail).
    if le := list_elem(m.ty)
        if not removes
            return self.list_get_else(m, key, le, other, pos)
    kt := match m.ty
        Map(k, _) => k
        _ => return unsupported(
            pos,
            "`.{if removes then "remove" else "get"}(k) else` on a `{m.ty.name()}`",
        )
    vt := match m.ty
        Map(_, v) => v
        _ => Ty.Unknown
    k := self.join_key(m, lower_value(key, kt)?)
    kid := convert(k, kt, expr_pos(key))
    e := self.map_entry(m.id, kid, kt, true)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    r := new_value(vt, "")
    blocks[join].params.push(r)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(found)
    cur = found
    got := self.entry_value(e, vt)
    if removes
        call("rt.map_remove", [m.id, kid], Ty.Unit)
    jump(join, [got])
    seal(missing)
    cur = missing
    match other
        Fallback(x) => fallback_jump(x, vt, join, pos)
        Leave(st) =>
            lower_stmt(st)
            if not done()
                problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(name, body, hpos) => handler_jump(name, body, hpos, vt, join)
    seal(join)
    cur = join
    if not removes
        self.note_entry(recv, key, other, m.id, k.id, kid, e)
    Val(id: r, ty: vt)

## Whether `r.n(...)` calls a method of a struct, enum or module, not a built-in.
fn Lower.user_method(self, r ast.Expr, n str) bool
    key := method_key(r, n) else return false
    sigs.contains(key)

## `r.get(k)`, or `r.remove(k)` on a local: a map call that `else` can follow.
fn Lower.is_table_call(self, r ast.Expr, n str) bool
    if n == "get"
        return not (self.is_module(r, "env") or self.is_module(r, "net")) and not self.user_method(
            r,
            n,
        )
    match r
        Name(nm, _) => n == "remove" and lookup(nm) != none
        _ => false

fn Lower.is_get_call(self, e ast.Expr) bool
    match e
        Method(r, n, _, a) => a.len() == 1 and self.is_table_call(r, n)
        _ => false

# ---- methods ----

fn set_elem(t Ty) Ty?
    match t
        Set(e) => e
        _ => none

## The keys of table `t` as a list of `e`: one byte, two or four for a `bool`,
## `u8`, `u16` or `u32` (ADRs 0907, 0912).
fn Lower.table_keys(mut self, t int, e Ty) int
    if e.elem_bytes() < 8
        return call("rt.map_keys_n", [t, konst(e.elem_bytes(), Ty.Int)], Ty.List(e))
    call("rt.map_keys", [t], Ty.List(e))

fn Lower.lower_coll_method(mut self, r Val, name str, npos ast.Pos, args List[ast.Arg]) Val?
    # `s.sorted(by: |x| e)` sorts the set's elements as a list (expr.key.1).
    if name == "sorted" and args.len() == 1 and not is_pending_table(r.ty)
        if et := set_elem(r.ty)
            keys := self.table_keys(r.id, et)
            return lower_sorted(Val(id: keys, ty: Ty.List(et)), name, args, npos)
    # `s.sorted()` of composite elements: as a list of them, by their order.
    if name == "sorted" and args.len() == 0 and not is_pending_table(r.ty)
        if et := set_elem(r.ty)
            if not is_key_ty(et)
                keys := call("rt.map_keys", [r.id], Ty.List(et))
                return tuple_list_edit(Val(id: keys, ty: Ty.List(et)), et, name, npos, [])
    for a in args
        if a.label != none or a.mutable
            return unsupported(npos, "`.{name}()` with a labelled or `mut` argument")
    if is_pending_table(r.ty)
        if name == "add" and args.len() == 1
            return settle_set_add(r, args, npos)
        if name == "push" and args.len() == 2
            return settle_map_push(r, args, npos)
        if name == "get_or" and args.len() == 2
            return settle_map_get_or(r, args, npos)
        if name == "contains" and args.len() == 1
            return pending_contains(r, args, npos)
        if name != "len"
            return unsupported(npos, "an empty `\{}` whose type isn't known")
    mut vs := List[Val]()
    match r.ty
        Map(kt, vt) =>
            if name == "push" and args.len() == 2
                return self.map_push(r, kt, vt, args, npos)
            want := if name == "contains"
                or name == "remove"
                or name == "get_or"
                or name == "get" then kt else if name == "top" then Ty.Int else Ty.Unknown
            for ai in 0..args.len()
                w := if name == "get_or" and ai == 1 then vt else want
                vs.push(lower_value(args[ai].value, if w.is_unknown() then none else w)?)
            if name == "len" and vs.len() == 0
                return Val(id: self.rawop("load64", [r.id], Ty.Int), ty: Ty.Int)
            if name == "is_empty" and vs.len() == 0
                n0 := self.rawop("load64", [r.id], Ty.Int)
                return Val(id: op("eq", [n0, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
            if name == "contains" and vs.len() == 1
                return self.map_has_fast(r, convert(vs[0], kt, npos), true)
            if name == "remove" and vs.len() == 1
                kid := convert(vs[0], kt, npos)
                if not is_statement(npos)
                    return self.map_remove_value(r, kid, vt, npos)
                if watch_here(npos)
                    self.watch_map_remove(r, kid, kt, vt, npos)
                    return Val(id: -1, ty: Ty.Unit)
                call("rt.map_remove", [r.id, kid], Ty.Unit)
                return Val(id: -1, ty: Ty.Unit)
            if name == "top" and vs.len() == 1 and vt == Ty.Int and kt.elem_bytes() == 8
                n := convert(vs[0], Ty.Int, npos)
                return Val(id: call("rt.map_top", [r.id, n], Ty.List(kt)), ty: Ty.List(kt))
            if name == "top" and vs.len() == 1 and vt == Ty.Int
                return narrow_top(r, kt, convert(vs[0], Ty.Int, npos))
            if name == "keys" and vs.len() == 0
                return Val(id: self.table_keys(r.id, kt), ty: Ty.List(kt))
            if name == "values" and vs.len() == 0
                if vt.elem_bytes() < 8
                    narrow := call(
                        "rt.map_values_n",
                        [r.id, konst(vt.elem_bytes(), Ty.Int)],
                        Ty.List(vt),
                    )
                    return Val(id: narrow, ty: Ty.List(vt))
                return Val(id: call("rt.map_values", [r.id], Ty.List(vt)), ty: Ty.List(vt))
            if name == "get" and vs.len() == 1
                return self.map_get(r, convert(vs[0], kt, npos), vt, npos)
            if name == "get_or" and vs.len() == 2
                return self.map_get_or(r, convert(vs[0], kt, npos), convert(vs[1], vt, npos), vt)
        Set(et) =>
            if name == "is_subset" and args.len() == 1
                b := lower_value(args[0].value, none)?
                rest := self.set_op(r, "difference", b, npos)?
                n0 := self.rawop("load64", [rest.id], Ty.Int)
                return Val(id: op("eq", [n0, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
            if is_set_op(name) and args.len() == 1
                b := lower_value(args[0].value, none)?
                return self.set_op(r, name, b, npos)
            for a in args
                vs.push(lower_value(a.value, et)?)
            if name == "len" and vs.len() == 0
                return Val(id: self.rawop("load64", [r.id], Ty.Int), ty: Ty.Int)
            if name == "is_empty" and vs.len() == 0
                n0 := self.rawop("load64", [r.id], Ty.Int)
                return Val(id: op("eq", [n0, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
            if name == "add" and vs.len() == 1
                kid := stored_key(args[0].value, vs[0], et, npos)
                added := call("rt.map_add", [r.id, kid], Ty.Bool)
                ev := Val(id: kid, ty: et)
                note := WNote(kind: "add", elem: ev, label: "", at: none, at2: none)
                watch_note_if(npos, added, r, note)
                return Val(id: added, ty: Ty.Bool)
            if name == "sorted"
                and vs.len() == 0
                and (et == Ty.Int or et == Ty.Str or et == Ty.Char)
                keys := call("rt.map_keys", [r.id], Ty.List(et))
                call("rt.list_sort", [keys, konst(if et == Ty.Str then 1 else 0, Ty.Int)], Ty.Unit)
                return Val(id: keys, ty: Ty.List(et))
            if name == "sorted" and vs.len() == 0
                return set_sorted_any(r, et, npos)
            if name == "contains" and vs.len() == 1
                return self.map_has_fast(r, convert(vs[0], et, npos), false)
            if name == "remove" and vs.len() == 1
                kid := convert(vs[0], et, npos)
                gone := call("rt.map_remove", [r.id, kid], Ty.Bool)
                ev := Val(id: kid, ty: et)
                note := WNote(kind: "remove", elem: ev, label: "", at: none, at2: none)
                watch_note_if(npos, gone, r, note)
                return Val(id: gone, ty: Ty.Bool)
        _ => return none
    unsupported(npos, "`.{name}()` on `{r.ty.name()}`")

## `m.push(k, x)` on a `Map[K, List[T]]` (type.map.8): append to the list
## at `k`, starting an empty one when `k` is missing.
fn Lower.map_push(mut self, m Val, kt Ty, vt Ty, args List[ast.Arg], npos ast.Pos) Val?
    et := vt.elem() else return unsupported(npos, "`.push(k, x)` on `{m.ty.name()}`")
    k := lower_value(args[0].value, kt)?
    kid := stored_key(args[0].value, k, kt, npos)
    x := lower_value(args[1].value, et)?
    self.map_push_vals(m, vt, kid, x, args[1].value, npos)

## The rest of `m.push(k, x)` once `k` (as `kid`) and `x` are lowered.
fn Lower.map_push_vals(mut self, m Val, vt Ty, kid int, x Val, xe ast.Expr, npos ast.Pos) Val?
    et := vt.elem() else return unsupported(npos, "`.push(k, x)` on `{m.ty.name()}`")
    item := Val(id: copy_if_place(xe, x), ty: x.ty)
    e := self.map_lookup(m, kid, false)
    has := op("ne", [e, konst(0, Ty.Int)], Ty.Bool)
    join := new_block()
    l := new_value(vt, "")
    blocks[join].params.push(l)
    found := new_block()
    missing := new_block()
    branch(has, found, [], missing, [])
    seal(found)
    cur = found
    jump(join, [self.entry_value(e, vt)])
    seal(missing)
    cur = missing
    fresh := call("rt.list_new", [konst(0, Ty.Int)], vt)
    call("rt.map_set", [m.id, kid, fresh], Ty.Unit)
    jump(join, [fresh])
    seal(join)
    cur = join
    call(push_fn(et), [l, convert(item, et, npos)], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

# ---- iteration and text ----

## `for x in s` over a set walks a snapshot of its elements in order
## (type.map.5); other values are returned as they are.
fn Lower.iter_coll(mut self, v Val) Val
    match v.ty
        Set(e) =>
            Val(id: self.table_keys(v.id, e), ty: Ty.List(e))
        # `for b in bytes` walks a list of the bytes as `u8`.
        Bytes =>
            t := Ty.List(Ty.Sized("u8"))
            Val(id: call("rt.bytes_list", [v.id], t), ty: t)
        _ => v

## `print(m)` and `print(s)` (type.map.4): `{"a": 1}`, `{1, 2}`.
fn Lower.out_coll(mut self, v Val, pos ast.Pos) Val?
    if is_pending_table(v.ty)
        return unsupported(pos, "an empty `\{}` whose type isn't known")
    match v.ty
        Map(k, x) =>
            kk := scalar_kind(k)
            vk := scalar_kind(x)
            if vk < 0 or kk < 0
                return out_text(v, pos)
            call("rt.out_map", [v.id, konst(kk, Ty.Int), konst(vk, Ty.Int)], Ty.Unit)
        Set(e) =>
            if scalar_kind(e) < 0
                return out_text(v, pos)
            call("rt.out_set", [v.id, konst(scalar_kind(e), Ty.Int)], Ty.Unit)
        _ => return unsupported(pos, "printing a `{v.ty.name()}`")
    Val(id: -1, ty: Ty.Unit)

# ---- set algebra (type.coll.16) ----

fn is_set_op(name str) bool
    name == "union" or name == "intersect" or name == "difference"

## `a.union(b)`, `a.intersect(b)` and `a.difference(b)`. `a` is a set or a
## list, `b` a set or a list of the same element type; the result is a set.
fn Lower.set_op(mut self, a Val, name str, b Val, pos ast.Pos) Val?
    e := match a.ty
        Set(x) => x
        List(x) => x
        _ => return unsupported(pos, "`.{name}()` on a `{a.ty.name()}`")
    if not key_ok(e)
        return unsupported(pos, "`.{name}()` on a `{a.ty.name()}`")
    want := Ty.Set(e)
    sa := self.as_set(a, e, pos)?
    sb := self.as_set(b, e, pos)?
    if name == "union"
        return Val(id: call("rt.set_union", [sa, sb], want), ty: want)
    keep := konst(if name == "intersect" then 1 else 0, Ty.Int)
    Val(id: call("rt.set_filter", [sa, sb, keep], want), ty: want)

## A set, or a list of `e`, as a set.
fn Lower.as_set(mut self, v Val, e Ty, pos ast.Pos) int?
    if v.ty == Ty.Set(e)
        return v.id
    if v.ty == Ty.List(e)
        words := words_of(v, e)
        return call("rt.set_from_list", [kind_val(e), words], Ty.Set(e))
    problem(pos, "expected a set or list of `{e.name()}`, found `{v.ty.name()}`")
    none

## The two names of the `LetTuple` that starts a `for a, b in xs` body, or
## none when `stmt` is anything else.
fn pair_binders(var str, stmt ast.Stmt) List[ast.Binder]
    match stmt
        LetTuple(ns, value, _) =>
            match value
                Name(nm, _) => if nm == var and ns.len() == 2 then ns else []
                _ => []
        _ => []

## Whether `for var in <iter>` over the lowered `m` is `for k, v in m` over a
## map (type.tuple.5): the body starts with the `LetTuple` over `var`.
fn Lower.is_pair_loop(self, var str, m Val, body List[ast.Stmt]) bool
    body.len() > 0 and is_map_ty(m.ty) and pair_binders(var, body[0]).len() > 0

## `for k, v in m` over the map `m`: the keys and values are taken as two
## lists when the loop starts, so the body may change `m`, and the loop runs
## over their indexes. `for a, b in xs` starts its body with a `LetTuple`
## over the hidden loop variable `var`. Any other `for a, b in xs` is a loop
## over tuples and takes the general path.
fn Lower.for_pairs(mut self, var str, iter ast.Expr, m Val, body List[ast.Stmt], fpos ast.Pos)
    pair := pair_binders(var, body[0])
    pos := expr_pos(iter)
    nvars += 1
    id := nvars
    me := "#fm{id}"
    declare(me, m.ty, m.id)
    mut stmts := List[ast.Stmt]()
    for part in ["keys", "values"]
        call_expr := ast.Expr.Method(
            recv: ast.Expr.Name(name: me, pos: pos),
            name: part,
            name_pos: pos,
            args: [],
        )
        lower_stmt(ast.Stmt.Let(
            name: "#f{part}{id}",
            pos: pos,
            mutable: false,
            value: call_expr,
            otherwise: none,
        ))
    at := ast.Expr.Name(name: "#fi{id}", pos: pos)
    mut inner := List[ast.Stmt]()
    mut k := 0
    for b in pair
        if b.name != "_"
            list := ast.Expr.Name(name: "#f{if k == 0 then "keys" else "values"}{id}", pos: pos)
            inner.push(ast.Stmt.Let(
                name: b.name,
                pos: b.pos,
                mutable: b.mutable,
                value: ast.Expr.Index(recv: list, index: at, pos: pos),
                otherwise: none,
            ))
        k += 1
    for rest in body[1..]
        inner.push(rest)
    count := ast.Expr.Method(
        recv: ast.Expr.Name(name: "#fkeys{id}", pos: pos),
        name: "len",
        name_pos: pos,
        args: [],
    )
    lower_stmt(ast.Stmt.For(
        is_par: false,
        var: "#fi{id}",
        var_pos: pos,
        mutable: false,
        iter: ast.Expr.Range(
            lo: ast.Expr.Int(value: "0", pos: pos),
            hi: count,
            inclusive: false,
            pos: pos,
        ),
        body: inner,
        pos: fpos,
    ))
