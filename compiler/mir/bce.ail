## Bounds checks in counted loops (ADR 0577) and list pre-sizing
## (ADR 0578). A loop `while i < hi` that steps `i` by 1 from a constant
## indexes lists with `xs[i]`, `xs[i + 1]` and `xs[k]` for a `k` that doesn't
## change. If each such list is long enough, none of those checks can fire,
## so the loop is versioned (as in loop versioning, Allen and Cocke 1971):
## a few guard blocks test the lengths once, and a copy of the loop runs
## without the checks when they hold. The original loop runs otherwise, so a
## trap names the same line, with the same message, as before. Loads of
## `xs[k]` that no store or call can change are hoisted into the guard.
##
## Rules: native.bce.1-3 (the removed checks and the unobservable capacity),
## native.bce.7-9 (computed starts and steps, and index arithmetic bounded by a
## constant; ADR 0622). native.bce.5-6 are cited where they are tested below.
## native.bce.16: loops that also leave from blocks other than the header,
## and `xs[a + i]` with `a` fixed (`AIL_OPT_OFF=mexit` keeps the first out).
##
## What may change a list's length or elements inside the loop is a call
## that gets the list (or one that holds it: a list of lists), a `push`, and
## a `set` on it. A value fetched from a list is treated as a part of that
## list, so changing the part changes the whole.

## What a loop needs for one list access to be in bounds.
struct Need
    ## `index` (the access is `xs[i]`), `off` (`xs[i + arg]`), `inv`
    ## (`xs[arg]`, a value that doesn't change), `invoff` (`xs[arg + off]`
    ## for such a value), `ivoff` (`xs[arg + i]`, or `xs[arg + j]` for the
    ## falling `j` of a two-pointer loop when `off` is 1) or `const` (`xs[arg]`).
    kind str
    x int
    arg int
    ## For `invoff` (`xs[arg + off]`, `arg` fixed in the loop).
    off int

## A load that the guard does once for the loop: `dst` is what the loop
## computes, `fresh` the guard's copy.
struct Hoist
    dst int
    y int
    c int
    fresh int

pub struct Versioned
    pub f Func
    ## The header of the copy that runs without the checks.
    pub header int
    ## The row-length floors by "list|block" (`rows`), with the new ones.
    pub floors Map[str, int]

## Calls above this many `push`es of a list per iteration aren't sized for.
MAX_PER := 8

## Indexes that arithmetic bounds are only tested against a list's length up
## to this value.
MAX_REACH := 16777216

## `AIL_OPT_OFF=bce,mexit,reserve,keep,inline,fill,fold,forward,fwdjoin,fwdjoinmem,fwdslot,fwdcheck,pure,memo,reuse,unroll,datarange,slp` (comma list) turns the named
## optimizations off in the compiler's output, to bisect a miscompile.
pub fn opt_off(name str) bool
    off := env.get("AIL_OPT_OFF") else ""
    off.split(",").contains(name)

pub fn bce(f Func, reserve0 bool, grow_only bool) Func
    mut sink := List[RkNote]()
    bce_noting(f, reserve0, grow_only, false, mut sink)

## `bce`, and when `want` is set (`ail perf --explain`, ADR 1021) a note per
## innermost loop of what the pass decided and why.
pub fn bce_noting(f Func, reserve0 bool, grow_only bool, want bool, mut notes List[RkNote]) Func
    if opt_off("bce")
        return f
    reserve := reserve0 and not opt_off("reserve")
    mut g := f
    if grow_only
        g = dominated(g)
    if reserve
        g = reserve_lists(g)
    mut done := Set[int]()
    mut floors := Map[str, int]()
    mut again := true
    while again
        again = false
        loops := find_loops(g)
        mut defs := defs_of(g)
        for lp in loops
            if done.contains(lp.header) or not is_innermost(loops, lp)
                continue
            done.add(lp.header)
            if not opt_off("mexit")
                if lifted := bound_out(g, defs, lp)
                    g = lifted
                    defs = defs_of(g)
            c := counted_multi(g, defs, lp) else
                if want
                    notes.push(RkNote(
                        rk_key: rk_key(g, lp),
                        rk_counted: false,
                        rk_fast: false,
                        rk_why: rk_uncounted(lp),
                        rk_blockers: [],
                    ))
                continue
            if lp.exits != 1 and opt_off("mexit")
                if want
                    notes.push(RkNote(
                        rk_key: rk_key(g, lp),
                        rk_counted: false,
                        rk_fast: false,
                        rk_why: rk_uncounted(lp),
                        rk_blockers: [],
                    ))
                continue
            r := version(g, defs, lp, c, loops, reserve and grow_only, floors) else
                if want
                    notes.push(RkNote(
                        rk_key: rk_key(g, lp),
                        rk_counted: true,
                        rk_fast: false,
                        rk_why: "",
                        rk_blockers: rk_blockers(g, defs, lp),
                    ))
                continue
            if want
                notes.push(RkNote(
                    rk_key: rk_key(g, lp),
                    rk_counted: true,
                    rk_fast: true,
                    rk_why: "",
                    rk_blockers: [],
                ))
            g = r.f
            floors = r.floors
            done.add(r.header)
            again = true
            break
    g

fn is_list(t Ty) bool
    match t
        List(_) => true
        _ => false

fn holds_lists(t Ty) bool
    match t
        List(e) => is_list(e)
        _ => false

## The list `v` was fetched from, else -1.
fn parent(f Func, defs List[Def], v int) int
    i := inst_of(f, defs, v) else return -1
    if i.op == "get" and is_list(f.vals[v]) then i.arg(0) else -1

## Mark `v` and every list it is part of.
fn taint(f Func, defs List[Def], v int, mut marks List[bool])
    mut x := v
    while x >= 0
        marks[x] = true
        x = parent(f, defs, x)

## Whether neither `v` nor a list it is part of is marked.
fn clean(f Func, defs List[Def], v int, marks List[bool]) bool
    mut x := v
    while x >= 0
        if marks[x]
            return false
        x = parent(f, defs, x)
    true

fn is_push(i Inst) bool
    i.op == "call" and is_push_name(i.name)

# ---- accesses an earlier access or push already vouches for ----

## A place in a function: block, and instruction in it.
struct At
    b int
    k int

fn earlier(dom List[List[bool]], a At, c At) bool
    if a.b == c.b
        return a.k < c.k
    dom[c.b][a.b]

## Whether no operation in the module makes a list shorter (native.subset.1
## has `push` and no `pop`, `clear` or `remove`). Any other `rt.list_`
## function a program calls is assumed to, which turns the next pass off: a new
## runtime helper that only reads or grows (`list_most`) belongs in `GROWS`, or
## push loops stop keeping their length and filling (ADR 0816).
pub fn lists_only_grow(m Module) bool
    for f in m.funcs
        for blk in f.blocks
            for i in blk.insts
                if i.op == "call" and i.name.starts_with("rt.list_") and not GROWS.contains(i.name)
                    return false
    true

GROWS := [
    "rt.list_new",
    "rt.list_push",
    "rt.list_pushf",
    "rt.list_pushb",
    "rt.list_pushw",
    "rt.list_pushd",
    "rt.list_copy",
    "rt.list_copy_deep",
    "rt.list_join",
    "rt.list_join_chars",
    "rt.out_join_chars",
    "rt.out_join",
    "rt.list_reserve",
    "rt.list_rows_min",
    "rt.list_new_for",
    "rt.list_alloc",
    "rt.list_grow",
    "rt.list_most",
]

## Where lists never shrink, `xs[i]` can't fail if an access to `xs[i]` came
## before it on every path (the same values: it was in bounds then), or if
## `i` is `xs.len()` from before a `push` to `xs` that came before it.
fn dominated(f Func) Func
    dom := dominators(f)
    defs := defs_of(f)
    passed := passed_constants(f, defs)
    mut seen := Map[str, List[At]]()
    mut pushes := Map[int, List[At]]()
    for b in 0..f.blocks.len()
        for k in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[k]
            if i.op == "get" or i.op == "set"
                key := "{i.arg(0)}|{i.arg(1)}"
                if not seen.contains(key)
                    seen[key] = []
                seen[key].push(At(b: b, k: k))
            elif is_push(i)
                if not pushes.contains(i.arg(0))
                    pushes[i.arg(0)] = []
                pushes[i.arg(0)].push(At(b: b, k: k))
    mut g := f
    for b in 0..f.blocks.len()
        for k in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[k]
            if (i.op != "get" and i.op != "set") or i.site < 0
                continue
            here := At(b: b, k: k)
            mut proven := false
            if prior := seen.get("{i.arg(0)}|{i.arg(1)}")
                for p in prior
                    if earlier(dom, p, here)
                        proven = true
            if not proven
                if l := inst_of(f, defs, i.arg(1))
                    if l.op == "len" and l.arg(0) == i.arg(0)
                        born := At(b: defs[i.arg(1)].block, k: defs[i.arg(1)].at)
                        if ps := pushes.get(i.arg(0))
                            for p in ps
                                if earlier(dom, born, p) and earlier(dom, p, here)
                                    proven = true
            if not proven
                # A constant index, or a parameter every edge passes a
                # constant to (`base := 3` then `if ..: base = 0`), is below
                # the number of pushes that came first: the list has at
                # least that many elements and never shrinks.
                if ceiling := highest(f, defs, passed, i.arg(1))
                    mut count := 0
                    if ps := pushes.get(i.arg(0))
                        for p in ps
                            if earlier(dom, p, here)
                                count += 1
                    proven = count > ceiling
            if proven
                g.blocks[b].insts[k].site = -1
    g

## The constants passed to each block parameter, over all edges into it.
fn passed_constants(f Func, defs List[Def]) Map[int, List[int]]
    mut out := Map[int, List[int]]()
    for blk in f.blocks
        for e in 0..blk.term.targets.len()
            to := f.blocks[blk.term.targets[e]]
            for j in 0..blk.term.args[e].len()
                if not out.contains(to.params[j])
                    out[to.params[j]] = []
                if c := const_of(f, defs, blk.term.args[e][j])
                    out[to.params[j]].push(c)
                else
                    out[to.params[j]].push(-1)
    out

## The largest value `v` can have when it is a non-negative constant, or a
## block parameter all of whose passed values are such constants.
fn highest(f Func, defs List[Def], passed Map[int, List[int]], v int) int?
    if c := const_of(f, defs, v)
        if c >= 0
            return c
        return none
    vals := passed.get(v)?
    if vals.len() == 0
        return none
    mut ceiling := 0
    for c in vals
        if c < 0
            return none
        if c > ceiling
            ceiling = c
    ceiling

# ---- list pre-sizing ----

## Before a counted loop that pushes to a list once or more per iteration,
## make room for all of it (`rt.list_reserve`), so the list doesn't regrow
## by doubling. Only an allocation, so it can't change what the program does.
fn reserve_lists(f Func) Func
    loops := find_loops(f)
    defs := defs_of(f)
    dom := dominators(f)
    mut g := f
    mut patches := List[Sized]()
    mut sized := Set[int]()
    for lp in loops
        c := counted(f, defs, lp) else continue
        if c.step >= 0
            continue
        if c.q >= 0
            continue
        mut lists := List[int]()
        mut per := List[int]()
        mut size := List[int]()
        mut in_place := List[bool]()
        for b in lp.blocks
            if b == lp.header
                continue
            mut every := true
            for l in lp.latches
                if not dom[l][b]
                    every = false
            for o in loops
                if o.header != lp.header and lp.member[o.header] and o.member[b]
                    every = false
            if not every
                continue
            for i in f.blocks[b].insts
                width := reserve_width(f, defs, i) else continue
                if lp.member[defs[i.arg(0)].block]
                    continue
                x := i.arg(0)
                mut at := -1
                for k in 0..lists.len()
                    if lists[k] == x
                        at = k
                if at < 0
                    lists.push(x)
                    per.push(0)
                    size.push(width)
                    in_place.push(not is_push(i))
                    at = lists.len() - 1
                per[at] += 1
        for k in 0..lists.len()
            if per[k] > MAX_PER
                continue
            p := lp.pre
            if not in_place[k] and made_for(
                f,
                defs,
                dom,
                lp,
                c,
                lists[k],
                per[k],
                size[k],
                mut patches,
                mut sized,
            )
                continue
            n1 := konst_in(mut g, p, per[k])
            n2 := konst_in(mut g, p, size[k])
            g.blocks[p].insts.push(inst(-1, "call", [lists[k], c.lo, c.hi, n1, n2]))
            g.blocks[p].insts[g.blocks[p].insts.len() - 1].name = if in_place[k] then "rt.flat_reserve" else "rt.list_reserve"
    # Largest position first, so the earlier ones keep theirs.
    mut done := [false for _ in 0..patches.len()]
    for _ in 0..patches.len()
        mut best := -1
        for k in 0..patches.len()
            if done[k]
                continue
            if best < 0 or patches[k].b > patches[best].b
                best = k
            elif patches[k].b == patches[best].b and patches[k].at > patches[best].at
                best = k
        done[best] = true
        pt := patches[best]
        konst_in(mut g, pt.b, pt.lo)
        konst_in(mut g, pt.b, pt.per)
        konst_in(mut g, pt.b, pt.size)
        mut made := g.blocks[pt.b].insts
        c3 := made.pop() else break
        c2 := made.pop() else break
        c1 := made.pop() else break
        mut call := made[pt.at]
        call.name = "rt.list_new_for"
        call = call.with_args([c1.dst, pt.hi, c2.dst, c3.dst])
        mut out := [made[k] for k in 0..pt.at]
        out.push(c1)
        out.push(c2)
        out.push(c3)
        out.push(call)
        for k in pt.at + 1..made.len()
            out.push(made[k])
        g.blocks[pt.b].insts = out
    g

## The bytes of one element a push `i` adds, when `i` is a push the list can
## be sized for: a plain one, or one into a list that keeps its structs in
## place (native.flat.1), whose element size is the call's second operand.
fn reserve_width(f Func, defs List[Def], i Inst) int?
    if is_push(i)
        return push_bytes(i.name)
    if i.op == "call" and (i.name == "rt.flat_push" or i.name == "rt.flat_push_refs")
        return const_of(f, defs, i.arg(1))
    none

## A list to be sized at creation (`list_new_for`) instead of reserved.
struct Sized
    b int
    at int
    lo int
    hi int
    per int
    size int

## Whether the list `x`, made empty by `list_new(0)` before a counted loop
## whose bound `hi` is known there, is sized where it is made. True when
## the loop's `list_reserve` is then not needed: the list is made in the
## loop's preheader and nothing there touches it after.
fn made_for(
    f Func,
    defs List[Def],
    dom List[List[bool]],
    lp LoopInfo,
    c Counted,
    x int,
    per int,
    size int,
    mut patches List[Sized],
    mut sized Set[int],
) bool
    nw := inst_of(f, defs, x) else return false
    if nw.op != "call" or nw.name != "rt.list_new" or const_of(f, defs, nw.arg(0)) != 0
        return false
    start := const_of(f, defs, c.lo) else return false
    d := defs[x]
    h := defs[c.hi]
    if not earlier(dom, At(b: h.block, k: h.at), At(b: d.block, k: d.at))
        return false
    if not sized.contains(x)
        sized.add(x)
        patches.push(Sized(b: d.block, at: d.at, lo: start, hi: c.hi, per: per, size: size))
    if d.block != lp.pre
        return false
    for k in d.at + 1..f.blocks[d.block].insts.len()
        if f.blocks[d.block].insts[k].operands().contains(x)
            return false
    not f.blocks[d.block].term.uses().contains(x)

fn konst_in(mut g Func, block int, n int) int
    g.vals.push(Ty.Int)
    g.names.push("")
    v := g.vals.len() - 1
    mut i := inst(v, "const", [])
    i.imm = n
    g.blocks[block].insts.push(i)
    v

# ---- loop versioning ----

## The guard blocks being built: a check ends a block with a branch to the
## next one, or to the original loop (`slow`) if it fails.
struct Guard
    f Func
    blocks List[Block]
    cur List[Inst]
    base int
    slow int
    slow_args List[int]
    lens Map[int, int]
    zero int
    ranged Set[int]
    ## Values already checked to be at least 0.
    nonneg Set[int]

fn Guard.value(mut self, t Ty) int
    self.f.vals.push(t)
    self.f.names.push("")
    self.f.vals.len() - 1

fn Guard.emit(mut self, op str, args List[int], t Ty) int
    v := self.value(t)
    self.cur.push(inst(v, op, args))
    v

fn Guard.konst(mut self, n int) int
    v := self.value(Ty.Int)
    mut i := inst(v, "const", [])
    i.imm = n
    self.cur.push(i)
    v

fn Guard.len_of(mut self, x int) int
    if known := self.lens.get(x)
        return known
    v := self.emit("len", [x], Ty.Int)
    self.lens[x] = v
    v

fn Guard.check(mut self, cond int)
    next := self.base + self.blocks.len() + 1
    self.blocks.push(Block(params: [], insts: self.cur, term: Term(
        kind: "branch",
        cond: cond,
        targets: [next, self.slow],
        args: [[], self.slow_args],
        value: -1,
    )))
    self.cur = []

## `0 <= idx < len x`, with `idx` the constant `k` if known.
fn Guard.in_bounds(mut self, x int, idx int, k int?)
    l := self.len_of(x)
    mut known := -1
    if kk := k
        known = kk
    if known >= 0
        self.check(self.emit("lt", [self.konst(known), l], Ty.Bool))
    else
        self.non_negative(idx)
        self.check(self.emit("lt", [idx, l], Ty.Bool))

## `0 <= v`, once per value.
fn Guard.non_negative(mut self, v int)
    if self.nonneg.contains(v)
        return
    self.nonneg.add(v)
    if self.zero < 0
        self.zero = self.konst(0)
    self.check(self.emit("ge", [v, self.zero], Ty.Bool))

## `-LIMIT <= x <= LIMIT`.
fn Guard.within(mut self, x int)
    if self.ranged.contains(x)
        return
    self.ranged.add(x)
    self.check(self.emit("ge", [x, self.konst(0 - LIMIT)], Ty.Bool))
    self.check(self.emit("le", [x, self.konst(LIMIT)], Ty.Bool))

fn Guard.emit_need(mut self, nd Need, x int, idx int, hi int, hi_is_len bool)
    match nd.kind
        "index" =>
            if hi_is_len
                return
            l := self.len_of(x)
            self.check(self.emit("le", [hi, l], Ty.Bool))
        "off" =>
            l := self.len_of(x)
            room := self.emit("sub", [l, self.konst(nd.arg)], Ty.Int)
            self.check(self.emit("le", [hi, room], Ty.Bool))
        "const" => self.in_bounds(x, -1, nd.arg)
        "invoff" =>
            l := self.len_of(x)
            self.non_negative(idx)
            self.check(self.emit(
                "lt",
                [idx, self.emit("sub", [l, self.konst(nd.off)], Ty.Int)],
                Ty.Bool,
            ))
        "ivoff" =>
            # `0 <= a` and `hi <= len - a - off`: `len - a` can't wrap with
            # both at least 0, and `a + i < len` then holds for every `i` below
            # `hi` (native.bce.16).
            l := self.len_of(x)
            self.non_negative(idx)
            mut room := self.emit("sub", [l, idx], Ty.Int)
            if nd.off > 0
                room = self.emit("sub", [room, self.konst(nd.off)], Ty.Int)
            self.check(self.emit("le", [hi, room], Ty.Bool))
        _ => self.in_bounds(x, idx, none)

## A value's range from the loops around it, when the loops are counted from
## and to constants (or values with such ranges): `ok` says whether it is known.
struct Iv
    ok bool
    lo int
    hi int

fn no_iv() Iv
    Iv(ok: false, lo: 0, hi: 0)

## Past this magnitude a bound isn't tracked, so products stay far from 2^63.
IV_BIG := 2147483648

fn iv_of(f Func, defs List[Def], loops List[LoopInfo], v int, depth int) Iv
    if depth > 6
        return no_iv()
    if defs[v].at >= 0
        i := inst_of(f, defs, v) else return no_iv()
        if i.op == "const"
            return Iv(ok: i.imm > 0 - IV_BIG and i.imm < IV_BIG, lo: i.imm, hi: i.imm)
        if i.op != "add" and i.op != "sub" and i.op != "mul"
            return no_iv()
        a := iv_of(f, defs, loops, i.arg(0), depth + 1)
        b := iv_of(f, defs, loops, i.arg(1), depth + 1)
        if not a.ok or not b.ok
            return no_iv()
        if i.op == "add"
            return iv_clamp(a.lo + b.lo, a.hi + b.hi)
        if i.op == "sub"
            return iv_clamp(a.lo - b.hi, a.hi - b.lo)
        ps := [a.lo * b.lo, a.lo * b.hi, a.hi * b.lo, a.hi * b.hi]
        mut lo := ps[0]
        mut hi := ps[0]
        for x in ps
            if x < lo
                lo = x
            if x > hi
                hi = x
        return iv_clamp(lo, hi)
    for lp in loops
        c := counted(f, defs, lp) else continue
        if c.p != v
            continue
        if c.step >= 0
            return no_iv()
        cmp := inst_of(f, defs, f.blocks[lp.header].term.cond) else return no_iv()
        if cmp.op != "lt" or cmp.arg(0) != v
            return no_iv()
        a := iv_of(f, defs, loops, c.lo, depth + 1)
        b := iv_of(f, defs, loops, c.hi, depth + 1)
        if a.ok and b.ok
            return iv_clamp(a.lo, if b.hi > a.lo then b.hi else a.lo)
        return no_iv()
    no_iv()

## `iv_of` as seen from block `at`: the counter `p` of a counted loop is below its bound in
## every block of the loop but the header, which alone leaves it (native.bce.10).
fn iv_from(f Func, defs List[Def], loops List[LoopInfo], v int, at int, depth int) Iv
    if depth > 6
        return no_iv()
    if defs[v].at >= 0
        i := inst_of(f, defs, v) else return no_iv()
        if i.op == "const"
            return iv_of(f, defs, loops, v, depth)
        if i.op != "add" and i.op != "sub" and i.op != "mul"
            return no_iv()
        a := iv_from(f, defs, loops, i.arg(0), defs[v].block, depth + 1)
        b := iv_from(f, defs, loops, i.arg(1), defs[v].block, depth + 1)
        if not a.ok or not b.ok
            return no_iv()
        if i.op == "add"
            return iv_clamp(a.lo + b.lo, a.hi + b.hi)
        if i.op == "sub"
            return iv_clamp(a.lo - b.hi, a.hi - b.lo)
        ps := [a.lo * b.lo, a.lo * b.hi, a.hi * b.lo, a.hi * b.hi]
        mut lo := ps[0]
        mut hi := ps[0]
        for x in ps
            if x < lo
                lo = x
            if x > hi
                hi = x
        return iv_clamp(lo, hi)
    r := iv_of(f, defs, loops, v, depth)
    if not r.ok or at < 0
        return r
    for lp in loops
        if lp.header == defs[v].block and lp.member[at] and at != lp.header and lp.exits == 1
            # Only the header leaves, so the loop's other blocks run with `p < hi`.
            if r.hi > r.lo
                return Iv(ok: true, lo: r.lo, hi: r.hi - 1)
    r

fn iv_clamp(lo int, hi int) Iv
    Iv(ok: lo > 0 - IV_BIG and hi < IV_BIG, lo: lo, hi: hi)

fn cst(f Func, defs List[Def], v int) int?
    if v < defs.len() then const_of(f, defs, v) else none

## The loop around `lp` where the rows of the list of lists `b` can't change
## (nothing in it gets `b`, pushes to it or sets its elements) and `b` is
## defined before it: its rows' shortest length, taken once before that
## loop, bounds the rows' lengths for as long as lists only grow. The
## outermost such loop, else -1 (native.bce.5).
fn floor_loop(f Func, defs List[Def], loops List[LoopInfo], lp LoopInfo, b int) int
    mut best := -1
    for k in 0..loops.len()
        o := loops[k]
        if o.header == lp.header or not o.member[lp.header] or o.pre < 0
            continue
        if defs[b].block < 0 or o.member[defs[b].block]
            continue
        mut marks := [false for _ in 0..f.vals.len()]
        for blk in o.blocks
            for i in f.blocks[blk].insts
                if i.op == "call" or i.op == "prim"
                    for a in i.operands()
                        if is_list(f.vals[a])
                            taint(f, defs, a, mut marks)
                elif i.op == "set" and holds_lists(f.vals[i.arg(0)])
                    taint(f, defs, i.arg(0), mut marks)
        if not clean(f, defs, b, marks)
            continue
        if best < 0 or o.member[loops[best].header]
            best = k
    best

## How deep `t` holds `int`s: 1 for a `List[int]`, 2 for a
## `List[List[int]]`, else 0.
fn int_rows(t Ty) int
    match t
        List(e) => if e == Ty.Int then 1 else 2 * int_list(e)
        _ => 0

fn int_list(t Ty) int
    match t
        List(e) => if e == Ty.Int then 1 else 0
        _ => 0

## The lists the loop `lp` reads `int` elements from whose elements, and
## those of the list they are rows of, can't change in a loop two or more
## levels around `lp`: each list and the list the scan before that loop
## covers (native.bce.12). Scanning only there makes the scan's cost small
## against the nest's.
fn data_lists(f Func, defs List[Def], loops List[LoopInfo], lp LoopInfo) Map[int, int]
    mut out := Map[int, int]()
    if opt_off("datarange")
        return out
    mut tried := Map[int, bool]()
    for b in lp.blocks
        if b == lp.header
            continue
        for i in f.blocks[b].insts
            if i.op != "get" or i.dst < 0 or f.vals[i.dst] != Ty.Int
                continue
            x := i.arg(0)
            if out.contains(x)
                continue
            pb := parent(f, defs, x)
            mut r := x
            if pb >= 0
                if parent(f, defs, pb) >= 0 or int_rows(f.vals[pb]) != 2
                    continue
                r = pb
            elif int_rows(f.vals[x]) != 1
                continue
            if not tried.contains(r)
                tried[r] = data_loop(f, defs, loops, lp, r, 2) >= 0
            if tried[r]
                out[x] = r
    out

## The outermost loop at least `depth` levels around `lp` with `r` defined
## before it, in which no call, `set` or `push` can change `r` or its rows
## (the scans and row floors the guards add are not counted), else -1.
fn data_loop(f Func, defs List[Def], loops List[LoopInfo], lp LoopInfo, r int, depth int) int
    mut best := -1
    for k in 0..loops.len()
        o := loops[k]
        if o.header == lp.header or not o.member[lp.header] or o.pre < 0
            continue
        if defs[r].block < 0 or o.member[defs[r].block]
            continue
        # Levels: the loops around `lp` inside `o`, `o` included.
        mut levels := 0
        for q in loops
            if q.header != lp.header and q.member[lp.header] and o.member[q.header]
                levels += 1
        if levels < depth
            continue
        mut marks := [false for _ in 0..f.vals.len()]
        for blk in o.blocks
            for i in f.blocks[blk].insts
                if i.op == "call" or i.op == "prim"
                    if i.name == "rt.datarange_absmax" or i.name == "rt.list_rows_min"
                        continue
                    for a in i.operands()
                        if is_list(f.vals[a])
                            taint(f, defs, a, mut marks)
                elif i.op == "set"
                    taint(f, defs, i.arg(0), mut marks)
                elif i.op == "stx"
                    # A store through a list's element address, from a loop
                    # versioned earlier.
                    if d := inst_of(f, defs, i.arg(0))
                        if d.op == "data"
                            taint(f, defs, d.arg(0), mut marks)
                        else
                            return -1
                    else
                        return -1
        if not clean(f, defs, r, marks)
            continue
        if best < 0 or o.member[loops[best].header]
            best = k
    best

fn version(
    f Func,
    defs List[Def],
    lp LoopInfo,
    c Counted,
    loops List[LoopInfo],
    rows bool,
    known Map[str, int],
) Versioned?
    n := f.blocks.len()
    nv := f.vals.len()
    inl := lp.member
    # Lists a call, `push` or `set` in the loop may resize (`lt`) or change (`et`).
    mut lt := [false for _ in 0..nv]
    mut et := [false for _ in 0..nv]
    for b in lp.blocks
        for i in f.blocks[b].insts
            if i.op == "call" or i.op == "prim"
                for a in i.operands()
                    if is_list(f.vals[a])
                        taint(f, defs, a, mut lt)
                        taint(f, defs, a, mut et)
            elif i.op == "set"
                taint(f, defs, i.arg(0), mut et)
                if holds_lists(f.vals[i.arg(0)])
                    taint(f, defs, i.arg(0), mut lt)
    # Lists the loop pushes to once or more per iteration and does nothing
    # else to: the guard checks their room for the whole loop, and the
    # pushes lose the check that the list is full (native.bce.6).
    mut roomy := List[int]()
    mut per := List[int]()
    mut roomy_keys := Set[str]()
    if c.q < 0
        dom := dominators(f)
        mut nl := [false for _ in 0..nv]
        mut bad := Set[int]()
        for b in lp.blocks
            for i in f.blocks[b].insts
                if (i.op == "call" or i.op == "prim") and not is_push(i)
                    for a in i.operands()
                        if is_list(f.vals[a])
                            taint(f, defs, a, mut nl)
        mut counted_at := Map[int, int]()
        for b in lp.blocks
            mut every := b != lp.header
            for l in lp.latches
                if not dom[l][b]
                    every = false
            for i in f.blocks[b].insts
                if not is_push(i) or inl[defs[i.arg(0)].block]
                    continue
                x := i.arg(0)
                if not every
                    bad.add(x)
                    continue
                if not counted_at.contains(x)
                    counted_at[x] = roomy.len()
                    roomy.push(x)
                    per.push(0)
                per[counted_at[x]] += 1
        mut keep := List[int]()
        for k in 0..roomy.len()
            if bad.contains(roomy[k]) or not clean(f, defs, roomy[k], nl) or per[k] > MAX_PER
                continue
            keep.push(k)
        mut r2 := List[int]()
        mut p2 := List[int]()
        for k in keep
            r2.push(roomy[k])
            p2.push(per[k])
        roomy = r2
        per = p2
        for b in lp.blocks
            for k in 0..f.blocks[b].insts.len()
                i := f.blocks[b].insts[k]
                if is_push(i) and roomy.contains(i.arg(0)) and not bad.contains(i.arg(0))
                    roomy_keys.add(k_of(b, k))
    # Loads of an unchanging element, which the guard does once.
    mut hoists := List[Hoist]()
    mut hidx := Map[int, int]()
    mut grew := true
    while grew
        grew = false
        for b in lp.blocks
            if b == lp.header
                continue
            for i in f.blocks[b].insts
                if i.op != "get" or hidx.contains(i.dst) or not is_list(f.vals[i.arg(0)])
                    continue
                y := i.arg(0)
                ci := i.arg(1)
                if not (fixed(defs, inl, hidx, y) and fixed(defs, inl, hidx, ci))
                    continue
                if clean(f, defs, y, et)
                    hoists.push(Hoist(dst: i.dst, y: y, c: ci, fresh: -1))
                    hidx[i.dst] = hoists.len() - 1
                    grew = true
    # Checked arithmetic that can't overflow if the fixed operands are small.
    mut fx := [false for _ in 0..nv]
    for v in 0..nv
        fx[v] = defs[v].block >= 0 and fixed(defs, inl, hidx, v)
    for a in room_only(f, defs, lp, c, lt, hidx)
        fx[a] = false
    elems := data_lists(f, defs, loops, lp)
    pr := prove(f, defs, lp, c, rpo(f), fx, elems)
    # The highest index that the loop's arithmetic bounds, per list.
    mut reach := Map[int, int]()
    # The accesses that can lose their checks, and what that takes.
    mut needs := List[Need]()
    mut relax := Set[str]()
    # The fixed list each access in the copy goes through.
    mut via := Map[str, int]()
    for b in lp.blocks
        if b == lp.header
            continue
        for k in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[k]
            if i.op != "get" and i.op != "set" or hidx.contains(i.dst)
                continue
            x := i.arg(0)
            if rows and i.site >= 0 and is_list(f.vals[x]) and not fixed(defs, inl, hidx, x)
                # A row of a list of lists whose rows are all longer than the index.
                pb := parent(f, defs, x)
                still := fixed(defs, inl, hidx, i.arg(1)) and clean(f, defs, x, lt)
                if pb >= 0 and still and floor_loop(f, defs, loops, lp, pb) >= 0
                    needs.push(Need(kind: "row", x: pb, arg: i.arg(1), off: 0))
                    relax.add("{b}:{k}")
                continue
            if not (is_list(f.vals[x]) and fixed(defs, inl, hidx, x) and clean(f, defs, x, lt))
                continue
            # Its elements' address is the same on every iteration.
            via[k_of(b, k)] = x
            if i.site < 0
                continue
            idx := i.arg(1)
            if idx == c.p
                needs.push(Need(kind: "index", x: x, arg: 0, off: 0))
                relax.add("{b}:{k}")
                continue
            if c.q >= 0 and idx == c.q
                needs.push(Need(kind: "off", x: x, arg: 1, off: 0))
                relax.add("{b}:{k}")
                continue
            if kc := cst(f, defs, idx)
                if kc >= 0
                    needs.push(Need(kind: "const", x: x, arg: kc, off: 0))
                    relax.add("{b}:{k}")
                continue
            if fixed(defs, inl, hidx, idx)
                needs.push(Need(kind: "inv", x: x, arg: idx, off: 0))
                relax.add("{b}:{k}")
                continue
            # `xs[y + k]` with `y` fixed in the loop and `k` a small constant: the
            # guard tests `0 <= y < len - k` once (native.bce.10).
            if ad := inst_of(f, defs, idx)
                if ad.op == "add" and inl[defs[idx].block] and fixed(defs, inl, hidx, ad.arg(0))
                    if ko := cst(f, defs, ad.arg(1))
                        if ko >= 0 and ko <= 64
                            needs.push(Need(kind: "invoff", x: x, arg: ad.arg(0), off: ko))
                            relax.add("{b}:{k}")
                            relax.add("{defs[idx].block}:{defs[idx].at}")
                            continue
            # `xs[a + i]` with `a` fixed in the loop and `i` the counter (or
            # the falling `j` of a two-pointer loop): the guard tests `0 <= a`
            # and `hi <= len - a` once, and `a + i` can't overflow either
            # (native.bce.16).
            if ad := inst_of(f, defs, idx)
                if ad.op == "add" and inl[defs[idx].block]
                    mut fixed_side := -1
                    mut moving := -1
                    for s in 0..2
                        o := ad.arg(s)
                        if fixed_side < 0 and fixed(defs, inl, hidx, o) and cst(f, defs, o) == none
                            fixed_side = o
                            moving = ad.arg(1 - s)
                    if fixed_side >= 0 and (moving == c.p or (c.q >= 0 and moving == c.q))
                        needs.push(Need(
                            kind: "ivoff",
                            x: x,
                            arg: fixed_side,
                            off: if moving == c.p then 0 else 1,
                        ))
                        relax.add("{b}:{k}")
                        relax.add("{defs[idx].block}:{defs[idx].at}")
                        continue
            if lw := pr.lows.get(idx)
                hg := pr.highs[idx]
                if lw >= 0 and hg <= MAX_REACH and inl[defs[idx].block]
                    # `xs[b * 7 + k]` with `b` below a constant: the list
                    # needs to be longer than the largest index (ADR 0622).
                    if not reach.contains(x) or reach[x] < hg
                        reach[x] = hg
                    relax.add("{b}:{k}")
                    continue
            a := inst_of(f, defs, idx) else continue
            if a.op != "add" or a.arg(0) != c.p or not inl[defs[idx].block]
                continue
            off := cst(f, defs, a.arg(1)) else continue
            if off >= 1 and off <= 16
                needs.push(Need(kind: "off", x: x, arg: off, off: 0))
                relax.add("{b}:{k}")
                relax.add("{defs[idx].block}:{defs[idx].at}")
    # `xs[y]` and `xs[y + k]` with `y` fixed here but bounded by the counted loops around
    # it: one test of the highest index per list, with the arithmetic bounds'
    # (native.bce.10).
    mut kept := List[Need]()
    for nd in needs
        if (nd.kind == "inv" or nd.kind == "invoff") and not hidx.contains(nd.arg)
            r := iv_from(f, defs, loops, nd.arg, defs[nd.arg].block, 0)
            if r.ok and r.lo >= 0 and r.hi + nd.off <= MAX_REACH
                if not reach.contains(nd.x) or reach[nd.x] < r.hi + nd.off
                    reach[nd.x] = r.hi + nd.off
                continue
        kept.push(nd)
    needs = kept
    for x in reach.keys()
        needs.push(Need(kind: "const", x: x, arg: reach[x], off: 0))
    # Worth the guard on the operands: two checks, or one in a loop that is
    # versioned anyway.
    versioned := needs.len() > 0 or hoists.len() > 0 or roomy.len() > 0
    # Sites the needs above already make safe don't need the operand tests.
    mut more_sites := 0
    for key in pr.sites
        if not relax.contains(key)
            more_sites += 1
    use_ranges := more_sites >= 2 or (more_sites == 1 and versioned) or reach.len() > 0
    if use_ranges
        for key in pr.sites
            relax.add(key)
    if not versioned and not use_ranges
        return none
    # The blocks the loop leaves to (`outs`): only the loop enters each, so
    # each dominates every use after the loop that it leads to, and a value
    # the loop defines dominates it. Each value that such a use reads gets a
    # parameter there, which both copies pass (native.bce.16).
    mut outs := List[int]()
    for b in lp.blocks
        for t in f.blocks[b].term.targets
            if not inl[t] and not outs.contains(t)
                outs.push(t)
    for b in 0..n
        if inl[b]
            continue
        for t in f.blocks[b].term.targets
            if outs.contains(t)
                return none
    doms := dominators(f)
    # Per block after the loop, the index in `outs` of the block that
    # dominates it, else -1.
    mut out_of := [-1 for _ in 0..n]
    for b in 0..n
        if inl[b]
            continue
        for j in 0..outs.len()
            if out_of[b] < 0 and doms[b][outs[j]]
                out_of[b] = j
    mut live := [List[int]() for _ in outs]
    for b in 0..n
        if inl[b]
            continue
        mut used := List[int]()
        for i in f.blocks[b].insts
            used.extend(i.operands())
        used.extend(f.blocks[b].term.uses())
        for u in used
            if not inl[defs[u].block]
                continue
            j := out_of[b]
            if j < 0
                return none
            if not live[j].contains(u)
                live[j].push(u)
    pre_args := f.blocks[lp.pre].term.args[0]
    mut gd := Guard(
        f: f,
        blocks: [],
        cur: [],
        base: n,
        slow: lp.header,
        slow_args: pre_args,
        lens: Map[int, int](),
        zero: -1,
        ranged: Set[int](),
        nonneg: Set[int](),
    )
    hd := inst_of(f, defs, c.bound)
    if cst(f, defs, c.lo) == none
        # The start was computed before the loop: not negative, and small,
        # unless the loops around it already say so.
        lo_iv := iv_of(f, defs, loops, c.lo, 0)
        if not (lo_iv.ok and lo_iv.lo >= 0)
            if gd.zero < 0
                gd.zero = gd.konst(0)
            gd.check(gd.emit("ge", [c.lo, gd.zero], Ty.Bool))
        if not (lo_iv.ok and lo_iv.hi <= LIMIT and lo_iv.lo >= 0 - LIMIT)
            gd.within(c.lo)
    if c.step >= 0
        # A step computed before the loop: at least 1, and small.
        gd.check(gd.emit("ge", [c.step, gd.konst(1)], Ty.Bool))
        gd.within(c.step)
    for h in 0..hoists.len()
        y := fresh_of(hoists, hidx, hoists[h].y)
        ci := fresh_of(hoists, hidx, hoists[h].c)
        gd.in_bounds(y, ci, cst(f, defs, hoists[h].c))
        d := gd.emit("get", [y, ci], f.vals[hoists[h].dst])
        hoists[h].fresh = d
    if use_ranges
        if pr.limited.len() > 8
            return none
        for v in pr.limited
            vi := iv_of(f, defs, loops, v, 0)
            if vi.ok and vi.hi <= LIMIT and vi.lo >= 0 - LIMIT
                continue
            gd.within(fresh_of(hoists, hidx, v))
    mut seen := Set[str]()
    mut floors := known
    mut floor_pre := List[int]()
    mut floor_call := List[Inst]()
    if use_ranges
        # Elements the nest only reads are within +-DATA, from one scan per
        # list before the loop the list doesn't change in (native.bce.12).
        for r in pr.scanned
            pre := loops[data_loop(f, defs, loops, lp, r, 2)].pre
            fkey := "abs|{r}|{pre}"
            mut m := -1
            if kn := floors.get(fkey)
                m = kn
            else
                dv := gd.value(Ty.Int)
                mut dk := inst(dv, "const", [])
                dk.imm = int_rows(f.vals[r])
                floor_pre.push(pre)
                floor_call.push(dk)
                m = gd.value(Ty.Int)
                mut fc := inst(m, "call", [r, dv])
                fc.name = "rt.datarange_absmax"
                floor_pre.push(pre)
                floor_call.push(fc)
                floors[fkey] = m
            gd.check(gd.emit("le", [m, gd.konst(DATA)], Ty.Bool))
        if pr.trip > 0
            gd.check(gd.emit("le", [fresh_of(hoists, hidx, c.bound), gd.konst(pr.trip)], Ty.Bool))
    # `hi <= len - off` is stronger than `hi <= len`.
    mut shifted := Set[int]()
    # `y < len - k` is stronger than `y < len - j` for j <= k.
    mut deepest := Map[str, int]()
    for nd in needs
        if nd.kind == "off"
            shifted.add(nd.x)
        if nd.kind == "invoff"
            dk := "{nd.x}|{nd.arg}"
            if not deepest.contains(dk) or deepest[dk] < nd.off
                deepest[dk] = nd.off
    for nd in needs
        key := "{nd.kind}|{nd.x}|{nd.arg}|{nd.off}"
        if seen.contains(key) or (nd.kind == "index" and shifted.contains(nd.x))
            continue
        seen.add(key)
        if nd.kind == "invoff" and deepest["{nd.x}|{nd.arg}"] != nd.off
            continue
        if nd.kind == "row"
            pre := loops[floor_loop(f, defs, loops, lp, nd.x)].pre
            fkey := "{nd.x}|{pre}"
            mut m := -1
            if kn := floors.get(fkey)
                m = kn
            else
                m = gd.value(Ty.Int)
                mut fc := inst(m, "call", [nd.x])
                fc.name = "rt.list_rows_min"
                floor_pre.push(pre)
                floor_call.push(fc)
                floors[fkey] = m
            ix := fresh_of(hoists, hidx, nd.arg)
            if gd.zero < 0
                gd.zero = gd.konst(0)
            gd.check(gd.emit("ge", [ix, gd.zero], Ty.Bool))
            gd.check(gd.emit("lt", [ix, m], Ty.Bool))
            continue
        if nd.kind == "ivoff"
            if kb := cst(f, defs, c.bound)
                if kb > 0 - IV_BIG and kb < IV_BIG
                    # One test for `xs[a + i]` under a constant bound: `a | (len
                    # - hi - off - a)` is not negative exactly when both halves
                    # hold, and the sum can't wrap once `a >= 0`. It runs before
                    # the outermost loop that keeps `a` and `len` (native.bce.16).
                    mut o := -1
                    if not hidx.contains(nd.arg) and not hidx.contains(nd.x)
                        o = room_loop(f, defs, loops, lp, nd.x, nd.arg)
                    mut m := -1
                    if o >= 0
                        pre := loops[o].pre
                        fkey := "room|{nd.x}|{nd.arg}|{kb + nd.off}|{pre}"
                        if kn := floors.get(fkey)
                            m = kn
                        else
                            lv := gd.value(Ty.Int)
                            kv := gd.value(Ty.Int)
                            mut ki := inst(kv, "const", [])
                            ki.imm = kb + nd.off
                            s1 := gd.value(Ty.Int)
                            s2 := gd.value(Ty.Int)
                            m = gd.value(Ty.Int)
                            for one in [
                                inst(lv, "len", [nd.x]),
                                ki,
                                inst(s1, "sub", [lv, kv]),
                                inst(s2, "sub", [s1, nd.arg]),
                                inst(m, "bor", [nd.arg, s2]),
                            ]
                                floor_pre.push(pre)
                                floor_call.push(one)
                            floors[fkey] = m
                    else
                        ix := fresh_of(hoists, hidx, nd.arg)
                        l := gd.len_of(fresh_of(hoists, hidx, nd.x))
                        s1 := gd.emit("sub", [l, gd.konst(kb + nd.off)], Ty.Int)
                        m = gd.emit("bor", [ix, gd.emit("sub", [s1, ix], Ty.Int)], Ty.Int)
                    if gd.zero < 0
                        gd.zero = gd.konst(0)
                    gd.check(gd.emit("ge", [m, gd.zero], Ty.Bool))
                    continue
        mut hi_is_len := false
        if d := hd
            hi_is_len = d.op == "len" and d.arg(0) == nd.x
        idx := if nd.kind == "inv" or nd.kind == "invoff" or nd.kind == "ivoff" then fresh_of(
            hoists,
            hidx,
            nd.arg,
        ) else nd.arg
        gd.emit_need(nd, fresh_of(hoists, hidx, nd.x), idx, c.bound, hi_is_len)
    if roomy.len() > 0
        # Room for every push of the loop: `(hi - lo) * per` more elements.
        # `hi` is within +-2^30 and `per` at ceiling 8, so nothing here wraps.
        gd.within(fresh_of(hoists, hidx, c.bound))
        for k in 0..roomy.len()
            x := roomy[k]
            held := gd.len_of(x)
            cp := gd.emit("cap", [x], Ty.Int)
            free := gd.emit("sub", [cp, held], Ty.Int)
            mut want := c.bound
            if cst(f, defs, c.lo) != 0
                want = gd.emit("sub", [want, c.lo], Ty.Int)
            if per[k] > 1
                want = gd.emit("mul", [want, gd.konst(per[k])], Ty.Int)
            gd.check(gd.emit("le", [want, free], Ty.Bool))
    # The address of each fixed list's elements, taken once.
    mut data := Map[int, int]()
    for key in via.keys()
        x := fresh_of(hoists, hidx, via[key])
        if not data.contains(x)
            data[x] = gd.emit("data", [x], Ty.Int)
    # The last guard block enters the copy, which follows the guard blocks.
    clone_base := n + gd.blocks.len() + 1
    gd.blocks.push(Block(params: [], insts: gd.cur, term: jump_to(clone_base, pre_args)))
    mut cb := [-1 for _ in 0..n]
    mut pos := 0
    for b in lp.blocks
        cb[b] = clone_base + pos
        pos += 1
    mut vals := gd.f.vals
    mut names := gd.f.names
    mut vm := [v for v in 0..nv]
    for b in lp.blocks
        for p in f.blocks[b].params
            vals.push(vals[p])
            names.push(names[p])
            vm[p] = vals.len() - 1
        for i in f.blocks[b].insts
            if i.dst >= 0 and not hidx.contains(i.dst)
                vals.push(vals[i.dst])
                names.push(names[i.dst])
                vm[i.dst] = vals.len() - 1
    for h in hoists
        vm[h.dst] = h.fresh
    mut blocks := f.blocks
    for k in 0..floor_pre.len()
        blocks[floor_pre[k]].insts.push(floor_call[k])
    # Each block the loop leaves to takes the values that are live after it.
    mut qmaps := List[Map[int, int]]()
    mut extra_orig := Map[int, List[int]]()
    mut extra_copy := Map[int, List[int]]()
    for j in 0..outs.len()
        mut qm := Map[int, int]()
        mut eo := List[int]()
        mut ec := List[int]()
        for u in live[j]
            vals.push(vals[u])
            names.push(names[u])
            q := vals.len() - 1
            qm[u] = q
            blocks[outs[j]].params.push(q)
            eo.push(u)
            ec.push(vm[u])
        qmaps.push(qm)
        extra_orig[outs[j]] = eo
        extra_copy[outs[j]] = ec
    for b in 0..n
        if inl[b]
            continue
        qmap := if out_of[b] >= 0 then qmaps[out_of[b]] else Map[int, int]()
        for k in 0..blocks[b].insts.len()
            blocks[b].insts[k] = blocks[b].insts[k].with_args([
                renamed(qmap, a)
                for a in blocks[b].insts[k].operands()
            ])
        mut t := blocks[b].term
        t.cond = renamed(qmap, t.cond)
        t.value = renamed(qmap, t.value)
        t.args = [[renamed(qmap, a) for a in edge] for edge in t.args]
        blocks[b].term = t
    for b in lp.blocks
        for e in 0..blocks[b].term.targets.len()
            dest := blocks[b].term.targets[e]
            if not inl[dest]
                blocks[b].term.args[e].extend(extra_orig[dest])
    blocks[lp.pre].term = jump_to(n, [])
    for b in gd.blocks
        blocks.push(b)
    for b in lp.blocks
        blk := f.blocks[b]
        mut insts := List[Inst]()
        for k in 0..blk.insts.len()
            i := blk.insts[k]
            if i.dst >= 0 and hidx.contains(i.dst)
                continue
            mut r := i
            r.dst = if i.dst >= 0 then vm[i.dst] else -1
            r = r.with_args([vm[a] for a in i.operands()])
            if relax.contains("{b}:{k}")
                r.site = -1
            if roomy_keys.contains(k_of(b, k))
                r.imm = 1
            if r.site < 0 and (i.op == "get" or i.op == "set") and via.contains(k_of(b, k))
                base := data[fresh_of(hoists, hidx, via[k_of(b, k)])]
                if i.op == "get"
                    r.op = "ldx"
                    r = r.with_args([base, vm[i.arg(1)]])
                    r.imm = f.vals[i.dst].elem_bytes()
                else
                    r.op = "stx"
                    r = r.with_args([base, vm[i.arg(1)], vm[i.arg(2)]])
                    r.imm = f.vals[i.arg(2)].elem_bytes()
            insts.push(r)
        t := blk.term
        mut nt := t
        nt.cond = if t.cond >= 0 then vm[t.cond] else -1
        nt.value = if t.value >= 0 then vm[t.value] else -1
        nt.targets = [if inl[x] then cb[x] else x for x in t.targets]
        nt.args = [[vm[a] for a in edge] for edge in t.args]
        for e in 0..t.targets.len()
            if not inl[t.targets[e]]
                nt.args[e].extend(extra_copy[t.targets[e]])
        blocks.push(Block(params: [vm[p] for p in blk.params], insts: insts, term: nt))
    Versioned(
        f: Func(
            name: f.name,
            params: f.params,
            ret: f.ret,
            blocks: blocks,
            vals: vals,
            names: names,
        ),
        header: cb[lp.header],
        floors: floors,
    )

## The outermost loop around `lp` that `x` and `a` are defined before and in
## which no call, `push` or row `set` can change `x`'s length, else -1: the
## guard's test of `xs[a + i]` can run once, before that loop (native.bce.16).
fn room_loop(f Func, defs List[Def], loops List[LoopInfo], lp LoopInfo, x int, a int) int
    mut best := -1
    for k in 0..loops.len()
        o := loops[k]
        if o.header == lp.header or not o.member[lp.header] or o.pre < 0
            continue
        if (defs[x].block >= 0 and o.member[defs[x].block])
            or (defs[a].block >= 0 and o.member[defs[a].block])
            continue
        mut marks := [false for _ in 0..f.vals.len()]
        for blk in o.blocks
            for i in f.blocks[blk].insts
                if i.op == "call" or i.op == "prim"
                    for v in i.operands()
                        if is_list(f.vals[v])
                            taint(f, defs, v, mut marks)
                elif i.op == "set" and holds_lists(f.vals[i.arg(0)])
                    taint(f, defs, i.arg(0), mut marks)
        if not clean(f, defs, x, marks)
            continue
        if best < 0 or o.member[loops[best].header]
            best = k
    best

## The fixed `a`s that the loop `lp` uses only in sums `a + i` (`i` the
## counter, or the falling `j` of a two-pointer loop) that index a fixed list
## the loop doesn't resize: the guard's test of each such index (native.bce.16)
## makes the sums safe, so `a` needs no range test of its own.
fn room_only(
    f Func,
    defs List[Def],
    lp LoopInfo,
    c Counted,
    lt List[bool],
    hidx Map[int, int],
) List[int]
    inl := lp.member
    # Sums that index such a list, and every use of each fixed operand.
    mut sums := Set[int]()
    for b in lp.blocks
        if b == lp.header
            continue
        for i in f.blocks[b].insts
            if (i.op != "get" and i.op != "set") or i.site < 0 or hidx.contains(i.dst)
                continue
            x := i.arg(0)
            if not (is_list(f.vals[x]) and fixed(defs, inl, hidx, x) and clean(f, defs, x, lt))
                continue
            ad := inst_of(f, defs, i.arg(1)) else continue
            if ad.op == "add" and inl[defs[i.arg(1)].block]
                sums.add(i.arg(1))
    mut good := Set[int]()
    mut bad := Set[int]()
    for b in lp.blocks
        for i in f.blocks[b].insts
            for u in i.operands()
                if not room_candidate(f, defs, inl, hidx, u)
                    continue
                mut ok := false
                if sums.contains(i.dst) and i.arg(0) != i.arg(1)
                    other := if i.arg(0) == u then i.arg(1) else i.arg(0)
                    ok = other == c.p or (c.q >= 0 and other == c.q)
                if ok
                    good.add(u)
                else
                    bad.add(u)
        for u in f.blocks[b].term.uses()
            if room_candidate(f, defs, inl, hidx, u)
                bad.add(u)
    mut out := List[int]()
    for u in good
        if not bad.contains(u)
            out.push(u)
    out

fn room_candidate(f Func, defs List[Def], inl List[bool], hidx Map[int, int], u int) bool
    if u < 0 or defs[u].block < 0
        return false
    not inl[defs[u].block] and not hidx.contains(u) and cst(f, defs, u) == none

## `while l < 66` lowers the constant 66 into the loop's header, where
## `counted` takes it for a value the loop changes. A copy of it made in the
## preheader, which the header's test then reads, is the same value defined
## outside the loop; constants are rematerialised at each use, so it costs no
## register (native.bce.16).
fn bound_out(f Func, defs List[Def], lp LoopInfo) Func?
    if lp.pre < 0
        return none
    t := f.blocks[lp.header].term
    if t.kind != "branch" or t.cond < 0 or defs[t.cond].block != lp.header
        return none
    cmp := inst_of(f, defs, t.cond)?
    if cmp.op != "lt" and cmp.op != "gt"
        return none
    for s in 0..2
        v := cmp.arg(s)
        k := const_of(f, defs, v) else continue
        if not lp.member[defs[v].block]
            continue
        mut g := f
        g.vals.push(f.vals[v])
        g.names.push("")
        nv := g.vals.len() - 1
        mut ki := inst(nv, "const", [])
        ki.imm = k
        g.blocks[lp.pre].insts.push(ki)
        d := defs[t.cond]
        g.blocks[d.block].insts[d.at] = cmp.with_args([
            if a == v then nv else a
            for a in cmp.operands()
        ])
        return g
    none

## Whether `v` has the same value on every iteration.
fn fixed(defs List[Def], inl List[bool], hidx Map[int, int], v int) bool
    not inl[defs[v].block] or hidx.contains(v)

fn k_of(b int, k int) str
    "{b}:{k}"

fn renamed(m Map[int, int], v int) int
    if to := m.get(v)
        return to
    v

## The guard's copy of `v` if it is hoisted, else `v`.
fn fresh_of(hoists List[Hoist], hidx Map[int, int], v int) int
    if k := hidx.get(v)
        return hoists[k].fresh
    v
