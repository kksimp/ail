## Bounds checks in counted loops (ADR 0577) and list pre-sizing
## (ADR 0578). A loop `while i < hi` that steps `i` by 1 from a constant
## indexes lists with `xs[i]`, `xs[i + 1]` and `xs[k]` for a `k` that doesn't
## change. If each such list is long enough, none of those checks can fire,
## so the loop is versioned (as in loop versioning, Allen and Cocke 1971):
## a few guard blocks test the lengths once, and a copy of the loop runs
## without the checks when they hold. The original loop runs otherwise, so a
## trap names the same line, with the same message, as before. Loads of
## `xs[k]` that no store or call can change are hoisted into the guard.
##
## What may change a list's length or elements inside the loop is a call
## that gets the list (or one that holds it: a list of lists), a `push`, and
## a `set` on it. A value fetched from a list is treated as a part of that
## list, so changing the part changes the whole.

## What a loop needs for one list access to be in bounds.
struct Need
    ## `index` (the access is `xs[i]`), `off` (`xs[i + arg]`), `inv`
    ## (`xs[arg]`, a value that doesn't change) or `const` (`xs[arg]`).
    kind str
    x int
    arg int

## A load that the guard does once for the loop: `dst` is what the loop
## computes, `fresh` the guard's copy.
struct Hoist
    dst int
    y int
    c int
    fresh int

pub struct Versioned
    pub f Func
    ## The header of the copy that runs without the checks.
    pub header int

## Calls above this many `push`es of a list per iteration aren't sized for.
MAX_PER := 8

pub fn bce(f Func, reserve bool, grow_only bool) Func
    mut g := f
    if grow_only
        g = dominated(g)
    if reserve
        g = reserve_lists(g)
    mut done := Set[int]()
    mut again := true
    while again
        again = false
        loops := find_loops(g)
        defs := defs_of(g)
        for lp in loops
            if done.contains(lp.header) or not is_innermost(loops, lp)
                continue
            done.add(lp.header)
            c := counted(g, defs, lp) else continue
            r := version(g, defs, lp, c) else continue
            g = r.f
            done.add(r.header)
            again = true
            break
    g

fn is_list(t Ty) bool
    match t
        List(_) => true
        _ => false

fn holds_lists(t Ty) bool
    match t
        List(e) => is_list(e)
        _ => false

## The list `v` was fetched from, else -1.
fn parent(f Func, defs List[Def], v int) int
    i := inst_of(f, defs, v) else return -1
    if i.op == "get" and is_list(f.vals[v]) then i.args[0] else -1

## Mark `v` and every list it is part of.
fn taint(f Func, defs List[Def], v int, mut marks List[bool])
    mut x := v
    while x >= 0
        marks[x] = true
        x = parent(f, defs, x)

## Whether neither `v` nor a list it is part of is marked.
fn clean(f Func, defs List[Def], v int, marks List[bool]) bool
    mut x := v
    while x >= 0
        if marks[x]
            return false
        x = parent(f, defs, x)
    true

fn is_push(i Inst) bool
    i.op == "call"
        and (i.name == "rt.list_push" or i.name == "rt.list_pushf" or i.name == "rt.list_pushb")

# ---- accesses an earlier access or push already vouches for ----

## A place in a function: block, and instruction in it.
struct At
    b int
    k int

fn earlier(dom List[List[bool]], a At, c At) bool
    if a.b == c.b
        return a.k < c.k
    dom[c.b][a.b]

## Whether no operation in the module makes a list shorter (native.subset.1
## has `push` and no `pop`, `clear` or `remove`). Any other `rt.list_`
## function a program calls is assumed to, which turns the next pass off.
pub fn lists_only_grow(m Module) bool
    for f in m.funcs
        for blk in f.blocks
            for i in blk.insts
                if i.op == "call" and i.name.starts_with("rt.list_") and not GROWS.contains(i.name)
                    return false
    true

GROWS := [
    "rt.list_new",
    "rt.list_push",
    "rt.list_pushf",
    "rt.list_pushb",
    "rt.list_copy",
    "rt.list_copy_deep",
    "rt.list_join",
    "rt.list_reserve",
    "rt.list_alloc",
    "rt.list_grow",
]

## Where lists never shrink, `xs[i]` can't fail if an access to `xs[i]` came
## before it on every path (the same values: it was in bounds then), or if
## `i` is `xs.len()` from before a `push` to `xs` that came before it.
fn dominated(f Func) Func
    dom := dominators(f)
    defs := defs_of(f)
    mut seen := Map[str, List[At]]()
    mut pushes := Map[int, List[At]]()
    for b in 0..f.blocks.len()
        for k in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[k]
            if i.op == "get" or i.op == "set"
                key := "{i.args[0]}|{i.args[1]}"
                if not seen.contains(key)
                    seen[key] = []
                seen[key].push(At(b: b, k: k))
            elif is_push(i)
                if not pushes.contains(i.args[0])
                    pushes[i.args[0]] = []
                pushes[i.args[0]].push(At(b: b, k: k))
    mut g := f
    for b in 0..f.blocks.len()
        for k in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[k]
            if (i.op != "get" and i.op != "set") or i.site < 0
                continue
            here := At(b: b, k: k)
            mut proven := false
            if prior := seen.get("{i.args[0]}|{i.args[1]}")
                for p in prior
                    if earlier(dom, p, here)
                        proven = true
            if not proven
                if l := inst_of(f, defs, i.args[1])
                    if l.op == "len" and l.args[0] == i.args[0]
                        born := At(b: defs[i.args[1]].block, k: defs[i.args[1]].at)
                        if ps := pushes.get(i.args[0])
                            for p in ps
                                if earlier(dom, born, p) and earlier(dom, p, here)
                                    proven = true
            if proven
                g.blocks[b].insts[k].site = -1
    g

# ---- list pre-sizing ----

## Before a counted loop that pushes to a list once or more per iteration,
## make room for all of it (`rt.list_reserve`), so the list doesn't regrow
## by doubling. Only an allocation, so it can't change what the program does.
fn reserve_lists(f Func) Func
    loops := find_loops(f)
    defs := defs_of(f)
    dom := dominators(f)
    mut g := f
    for lp in loops
        c := counted(f, defs, lp) else continue
        mut lists := List[int]()
        mut per := List[int]()
        mut size := List[int]()
        for b in lp.blocks
            if b == lp.header
                continue
            mut every := true
            for l in lp.latches
                if not dom[l][b]
                    every = false
            for o in loops
                if o.header != lp.header and lp.member[o.header] and o.member[b]
                    every = false
            if not every
                continue
            for i in f.blocks[b].insts
                if not is_push(i) or lp.member[defs[i.args[0]].block]
                    continue
                x := i.args[0]
                mut at := -1
                for k in 0..lists.len()
                    if lists[k] == x
                        at = k
                if at < 0
                    lists.push(x)
                    per.push(0)
                    size.push(if i.name == "rt.list_pushb" then 1 else 8)
                    at = lists.len() - 1
                per[at] += 1
        for k in 0..lists.len()
            if per[k] > MAX_PER
                continue
            p := lp.pre
            n1 := konst_in(mut g, p, per[k])
            n2 := konst_in(mut g, p, size[k])
            g.blocks[p].insts.push(inst(-1, "call", [lists[k], c.lo, c.hi, n1, n2]))
            g.blocks[p].insts[g.blocks[p].insts.len() - 1].name = "rt.list_reserve"
    g

fn konst_in(mut g Func, block int, n int) int
    g.vals.push(Ty.Int)
    g.names.push("")
    v := g.vals.len() - 1
    mut i := inst(v, "const", [])
    i.imm = n
    g.blocks[block].insts.push(i)
    v

# ---- loop versioning ----

## The guard blocks being built: a check ends a block with a branch to the
## next one, or to the original loop (`slow`) if it fails.
struct Guard
    f Func
    blocks List[Block]
    cur List[Inst]
    base int
    slow int
    slow_args List[int]
    lens Map[int, int]
    zero int

fn Guard.value(mut self, t Ty) int
    f.vals.push(t)
    f.names.push("")
    f.vals.len() - 1

fn Guard.emit(mut self, op str, args List[int], t Ty) int
    v := value(t)
    cur.push(inst(v, op, args))
    v

fn Guard.konst(mut self, n int) int
    v := value(Ty.Int)
    mut i := inst(v, "const", [])
    i.imm = n
    cur.push(i)
    v

fn Guard.len_of(mut self, x int) int
    if known := lens.get(x)
        return known
    v := emit("len", [x], Ty.Int)
    lens[x] = v
    v

fn Guard.check(mut self, cond int)
    next := base + blocks.len() + 1
    blocks.push(Block(
        params: [],
        insts: cur,
        term: Term(
            kind: "branch",
            cond: cond,
            targets: [next, slow],
            args: [[], slow_args],
            value: -1,
        ),
    ))
    cur = []

## `0 <= idx < len x`, with `idx` the constant `k` if known.
fn Guard.in_bounds(mut self, x int, idx int, k int?)
    l := len_of(x)
    mut known := -1
    if kk := k
        known = kk
    if known >= 0
        check(emit("lt", [konst(known), l], Ty.Bool))
    else
        if zero < 0
            zero = konst(0)
        check(emit("ge", [idx, zero], Ty.Bool))
        check(emit("lt", [idx, l], Ty.Bool))

fn Guard.emit_need(mut self, nd Need, x int, idx int, hi int, hi_is_len bool)
    match nd.kind
        "index" =>
            if hi_is_len
                return
            l := len_of(x)
            check(emit("le", [hi, l], Ty.Bool))
        "off" =>
            l := len_of(x)
            room := emit("sub", [l, konst(nd.arg)], Ty.Int)
            check(emit("le", [hi, room], Ty.Bool))
        "const" => in_bounds(x, -1, nd.arg)
        _ => in_bounds(x, idx, none)

fn cst(f Func, defs List[Def], v int) int?
    if v < defs.len() then const_of(f, defs, v) else none

fn version(f Func, defs List[Def], lp LoopInfo, c Counted) Versioned?
    n := f.blocks.len()
    nv := f.vals.len()
    inl := lp.member
    # Lists a call, `push` or `set` in the loop may resize (`lt`) or change (`et`).
    mut lt := [false for _ in 0..nv]
    mut et := [false for _ in 0..nv]
    for b in lp.blocks
        for i in f.blocks[b].insts
            if i.op == "call" or i.op == "prim"
                for a in i.args
                    if is_list(f.vals[a])
                        taint(f, defs, a, mut lt)
                        taint(f, defs, a, mut et)
            elif i.op == "set"
                taint(f, defs, i.args[0], mut et)
                if holds_lists(f.vals[i.args[0]])
                    taint(f, defs, i.args[0], mut lt)
    # Loads of an unchanging element, which the guard does once.
    mut hoists := List[Hoist]()
    mut hidx := Map[int, int]()
    mut grew := true
    while grew
        grew = false
        for b in lp.blocks
            if b == lp.header
                continue
            for i in f.blocks[b].insts
                if i.op != "get" or hidx.contains(i.dst) or not is_list(f.vals[i.args[0]])
                    continue
                y := i.args[0]
                ci := i.args[1]
                if not (fixed(defs, inl, hidx, y) and fixed(defs, inl, hidx, ci))
                    continue
                if clean(f, defs, y, et)
                    hoists.push(Hoist(dst: i.dst, y: y, c: ci, fresh: -1))
                    hidx[i.dst] = hoists.len() - 1
                    grew = true
    # The accesses that can lose their checks, and what that takes.
    mut needs := List[Need]()
    mut relax := Set[str]()
    for b in lp.blocks
        if b == lp.header
            continue
        for k in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[k]
            if i.op != "get" and i.op != "set" or i.site < 0 or hidx.contains(i.dst)
                continue
            x := i.args[0]
            if not (is_list(f.vals[x]) and fixed(defs, inl, hidx, x) and clean(f, defs, x, lt))
                continue
            idx := i.args[1]
            if idx == c.p
                needs.push(Need(kind: "index", x: x, arg: 0))
                relax.add("{b}:{k}")
                continue
            if kc := cst(f, defs, idx)
                if kc >= 0
                    needs.push(Need(kind: "const", x: x, arg: kc))
                    relax.add("{b}:{k}")
                continue
            if fixed(defs, inl, hidx, idx)
                needs.push(Need(kind: "inv", x: x, arg: idx))
                relax.add("{b}:{k}")
                continue
            a := inst_of(f, defs, idx) else continue
            if a.op != "add" or a.args[0] != c.p or not inl[defs[idx].block]
                continue
            off := cst(f, defs, a.args[1]) else continue
            if off >= 1 and off <= 16
                needs.push(Need(kind: "off", x: x, arg: off))
                relax.add("{b}:{k}")
                relax.add("{defs[idx].block}:{defs[idx].at}")
    if needs.len() == 0 and hoists.len() == 0
        return none
    # Everything defined in the loop and used after it is defined in the
    # header (the loop has one exit, from the header), and gets a parameter
    # on the exit block.
    ex := c.exit
    mut entering := 0
    for blk in f.blocks
        for t in blk.term.targets
            if t == ex
                entering += 1
    if entering != 1
        return none
    mut live := List[int]()
    for b in 0..n
        if inl[b]
            continue
        for i in f.blocks[b].insts
            for u in i.args
                if inl[defs[u].block]
                    if defs[u].block != lp.header
                        return none
                    if not live.contains(u)
                        live.push(u)
        for u in f.blocks[b].term.uses()
            if inl[defs[u].block]
                if defs[u].block != lp.header
                    return none
                if not live.contains(u)
                    live.push(u)
    pre_args := f.blocks[lp.pre].term.args[0]
    mut gd := Guard(
        f: f,
        blocks: [],
        cur: [],
        base: n,
        slow: lp.header,
        slow_args: pre_args,
        lens: Map[int, int](),
        zero: -1,
    )
    hd := inst_of(f, defs, c.hi)
    for h in 0..hoists.len()
        y := fresh_of(hoists, hidx, hoists[h].y)
        ci := fresh_of(hoists, hidx, hoists[h].c)
        gd.in_bounds(y, ci, cst(f, defs, hoists[h].c))
        d := gd.emit("get", [y, ci], f.vals[hoists[h].dst])
        hoists[h].fresh = d
    mut seen := Set[str]()
    for nd in needs
        key := "{nd.kind}|{nd.x}|{nd.arg}"
        if seen.contains(key)
            continue
        seen.add(key)
        mut hi_is_len := false
        if d := hd
            hi_is_len = d.op == "len" and d.args[0] == nd.x
        idx := if nd.kind == "inv" then fresh_of(hoists, hidx, nd.arg) else nd.arg
        gd.emit_need(nd, fresh_of(hoists, hidx, nd.x), idx, c.hi, hi_is_len)
    # The last guard block enters the copy, which follows the guard blocks.
    clone_base := n + gd.blocks.len() + 1
    gd.blocks.push(Block(params: [], insts: gd.cur, term: jump_to(clone_base, pre_args)))
    mut cb := [-1 for _ in 0..n]
    mut pos := 0
    for b in lp.blocks
        cb[b] = clone_base + pos
        pos += 1
    mut vals := gd.f.vals
    mut names := gd.f.names
    mut vm := [v for v in 0..nv]
    for b in lp.blocks
        for p in f.blocks[b].params
            vals.push(vals[p])
            names.push(names[p])
            vm[p] = vals.len() - 1
        for i in f.blocks[b].insts
            if i.dst >= 0 and not hidx.contains(i.dst)
                vals.push(vals[i.dst])
                names.push(names[i.dst])
                vm[i.dst] = vals.len() - 1
    for h in hoists
        vm[h.dst] = h.fresh
    mut blocks := f.blocks
    # The exit block takes the values that are live after the loop.
    mut qmap := Map[int, int]()
    mut extra_orig := List[int]()
    mut extra_copy := List[int]()
    for u in live
        vals.push(vals[u])
        names.push(names[u])
        q := vals.len() - 1
        qmap[u] = q
        blocks[ex].params.push(q)
        extra_orig.push(u)
        extra_copy.push(vm[u])
    for b in 0..n
        if inl[b]
            continue
        for k in 0..blocks[b].insts.len()
            blocks[b].insts[k].args = [renamed(qmap, a) for a in blocks[b].insts[k].args]
        mut t := blocks[b].term
        t.cond = renamed(qmap, t.cond)
        t.value = renamed(qmap, t.value)
        t.args = [[renamed(qmap, a) for a in edge] for edge in t.args]
        blocks[b].term = t
    blocks[lp.header].term.args[c.exit_edge].extend(extra_orig)
    blocks[lp.pre].term = jump_to(n, [])
    for b in gd.blocks
        blocks.push(b)
    for b in lp.blocks
        blk := f.blocks[b]
        mut insts := List[Inst]()
        for k in 0..blk.insts.len()
            i := blk.insts[k]
            if i.dst >= 0 and hidx.contains(i.dst)
                continue
            mut r := i
            r.dst = if i.dst >= 0 then vm[i.dst] else -1
            r.args = [vm[a] for a in i.args]
            if relax.contains("{b}:{k}")
                r.site = -1
            insts.push(r)
        t := blk.term
        mut nt := t
        nt.cond = if t.cond >= 0 then vm[t.cond] else -1
        nt.value = if t.value >= 0 then vm[t.value] else -1
        nt.targets = [if inl[x] then cb[x] else x for x in t.targets]
        nt.args = [[vm[a] for a in edge] for edge in t.args]
        if b == lp.header
            nt.args[c.exit_edge].extend(extra_copy)
        blocks.push(Block(params: [vm[p] for p in blk.params], insts: insts, term: nt))
    Versioned(
        f: Func(
            name: f.name,
            params: f.params,
            ret: f.ret,
            blocks: blocks,
            vals: vals,
            names: names,
        ),
        header: cb[lp.header],
    )

## Whether `v` has the same value on every iteration.
fn fixed(defs List[Def], inl List[bool], hidx Map[int, int], v int) bool
    not inl[defs[v].block] or hidx.contains(v)

fn renamed(m Map[int, int], v int) int
    if to := m.get(v)
        return to
    v

## The guard's copy of `v` if it is hoisted, else `v`.
fn fresh_of(hoists List[Hoist], hidx Map[int, int], v int) int
    if k := hidx.get(v)
        return hoists[k].fresh
    v
