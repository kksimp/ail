## Self-recursive calls inlined once (ADR 0890, pass 3): a small function
## that calls itself gets a copy of its own body at each of those calls, so
## a recursion of depth d makes about d / 2 calls and each pair shares the
## callee-saved saves, the frame and the stack check. The copy's own
## recursive calls stay calls, and carry the frame they were inlined into, so a
## trap's stack still lists every source frame (trace.frame.2): the code
## generators give such a call one call-table row per frame, and
## `trace_frames` prints them all. `AIL_OPT_OFF=unroll` turns it off.

## Functions with at most this many instructions are unrolled.
UNROLL_LIMIT := 60

## The most self calls a function may have to be unrolled.
UNROLL_CALLS := 3

## Inline the body of `f` into each of its own direct calls, once. Returns
## whether anything changed.
pub fn unroll_self(mut f Func, mut sites List[Site]) bool
    unroll_self_upto(mut f, mut sites, UNROLL_LIMIT)

## `unroll_self` for a function of up to `limit` instructions.
pub fn unroll_self_upto(mut f Func, mut sites List[Site], limit int) bool
    # `AIL_INSTRUMENT` builds (`--values`, `--trace`) keep one frame per call.
    instr := env.get("AIL_INSTRUMENT") else ""
    if f.name.starts_with("rt.") or opt_off("unroll") or instr != ""
        return false
    mut n := 0
    mut calls := Set[int]()
    for blk in f.blocks
        n += blk.insts.len()
        for t in blk.term.targets
            if t == 0
                return false
        for i in blk.insts
            if i.op == "icall" or i.op == "prim" and (i.name == "syscall" or i.name == "clone")
                return false
            if i.op == "call" and i.name == f.name
                if i.dst < 0
                    return false
                calls.add(i.dst)
            elif i.op == "call" and i.imm != 0
                # A call to another function would lose its site when
                # `mark_recursion` clears it, and with it the extra frame.
                return false
    if calls.len() == 0 or calls.len() > UNROLL_CALLS or n > limit
        return false
    body := f
    mut changed := false
    mut again := true
    while again
        again = false
        for b in 0..f.blocks.len()
            for at in 0..f.blocks[b].insts.len()
                i := f.blocks[b].insts[at]
                if i.op == "call" and i.name == f.name and calls.contains(i.dst)
                    calls.remove(i.dst)
                    inline_call(mut f, b, at, body, mut sites)
                    changed = true
                    again = true
                    break
            if again
                break
    changed
