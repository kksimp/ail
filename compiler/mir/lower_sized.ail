## Sized integers in the native subset (ADR 0834, type.num.13-15): `i8 i16
## i32 u8 u16 u32` as `Ty.Sized(kind)`. A value lives in a register like an
## `int`, sign- or zero-extended from its width, so it is always inside its
## type's range; comparison and printing are the `int` ones. This file has
## literals, the conversions, comparison and arithmetic (checked `+ - * / %`,
## negation, `abs`, `wrapping_*` and `saturating_*`). `u64` is the same with the
## 64 bits as they are: comparison flips the top bit first, division and text are
## in `rt/native/u64.ail`, and every check is its own (`u64_arith`, `u64_checked`).
use ast

## The kinds, in the order of the codes `rt.sized_msg` knows.
SIZED_KINDS := ["i8", "i16", "i32", "u8", "u16", "u32", "u64"]

U64_TOP := -9223372036854775807 - 1

fn sized_lo(kind str) int
    match kind
        "i8" => -128
        "i16" => -32768
        "i32" => -2147483648
        _ => 0

fn sized_hi(kind str) int
    match kind
        "i8" => 127
        "i16" => 32767
        "i32" => 2147483647
        "u8" => 255
        "u16" => 65535
        "u64" => -1
        _ => 4294967295

fn sized_code(kind str) int
    for k in 0..SIZED_KINDS.len()
        if SIZED_KINDS[k] == kind
            return k
    -1

fn sized_kind(t Ty) str
    match t
        Sized(k) => k
        _ => ""

## The sized type a context wants, if it wants one.
fn want_sized(want Ty?) str
    w := want else return ""
    sized_kind(w)

## An integer literal: a sized integer where one is wanted (type.num.13; the
## checker has already made sure it fits), a `float` where one is wanted.
fn Lower.lower_int_lit(mut self, text str, pos ast.Pos, want Ty?) Val?
    n := text.to_int() else
        problem(pos, "integer literal `{text}` out of range")
        return none
    if wants_float(want)
        return float_lit(n.to_float(), want)
    k := want_sized(want)
    if k != ""
        if k != "u64" and n > sized_hi(k)
            problem(pos, "integer literal `{text}` doesn't fit in `{k}`")
            return none
        return Val(id: konst(n, Ty.Sized(k)), ty: Ty.Sized(k))
    Val(id: konst(n, Ty.Int), ty: Ty.Int)

## `-N` where a sized integer is wanted: the `-` belongs to the literal, so
## `-128` is an `i8` (type.num.13).
fn Lower.negative_sized_lit(mut self, operand ast.Expr, want Ty?) Val?
    k := want_sized(want)
    if k == ""
        return none
    text := int_text(operand)
    if text == "" or text.len() > 10
        return none
    n := text.to_int()?
    if 0 - n < sized_lo(k)
        problem(expr_pos(operand), "integer literal `-{text}` doesn't fit in `{k}`")
        return none
    Val(id: konst(0 - n, Ty.Sized(k)), ty: Ty.Sized(k))

## `a OP b` on two sized integers of one type. Comparison is the register
## order. `+ - * / %` compute in 64 bits, where no 32-bit operand pair can
## overflow (an unsigned product that passes 2^63 wraps negative, which the
## range check below still rejects), then trap with `expr.arith.1` when the
## result is outside the type (type.num.14); `/` and `%` by zero and
## `MIN / -1` trap with `expr.arith.3`.
fn Lower.sized_binary(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val?
    k := sized_kind(a.ty)
    if is_comparison(o)
        if k == "u64" and op_name(o) != "eq" and op_name(o) != "ne"
            return Val(id: op(op_name(o), [flip_top(a.id), flip_top(b.id)], Ty.Bool), ty: Ty.Bool)
        return Val(id: op(op_name(o), [a.id, b.id], Ty.Bool), ty: Ty.Bool)
    name := op_name(o)
    if arith_code(name) < 0
        return unsupported(pos, "`{op_symbol(o)}` on `{a.ty.name()}`")
    r := self.sized_arith(name, k, a.id, b.id, pos)
    Val(id: r, ty: a.ty)

## `v` with its top bit flipped: signed order on the result is unsigned order on `v`.
fn Lower.flip_top(mut self, v int) int
    op("bxor", [v, konst(U64_TOP, Ty.Int)], Ty.Int)

## `a < b` (`strict`) or `a <= b` of two `u64`.
fn Lower.u64_le(mut self, a int, b int) int
    op("le", [flip_top(a), flip_top(b)], Ty.Bool)

## The checked result of `a OP b` on `u64`: 64 bits wrap, so each operation checks its own way.
fn Lower.u64_arith(mut self, name str, a int, b int, args List[int], pos ast.Pos) int
    divides := name == "div" or name == "rem"
    if divides
        nz := op("ne", [b, konst(0, Ty.Int)], Ty.Bool)
        sized_trap_unless(nz, "expr.arith.3", "rt.sized_zero_msg", args, pos)
        return call(if name == "div" then "rt.u64_div" else "rt.u64_rem", [a, b], Ty.Int)
    r := op(name, [a, b], Ty.Int)
    ok := match name
        "add" => u64_le(a, r)
        "sub" => u64_le(b, a)
        _ => call("rt.u64_mul_ok", [a, b], Ty.Bool)
    sized_trap_unless(ok, "expr.arith.1", "rt.sized_over_msg", args, pos)
    r

fn arith_code(name str) int
    match name
        "add" => 0
        "sub" => 1
        "mul" => 2
        "div" => 3
        "rem" => 4
        _ => -1

## The checked result of `a name b` on sized integers of kind `k`.
fn Lower.sized_arith(mut self, name str, k str, a int, b int, pos ast.Pos) int
    code := arith_code(name)
    kc := konst(sized_code(k), Ty.Int)
    args := [a, b, konst(code, Ty.Int), kc]
    if k == "u64"
        return u64_arith(name, a, b, args, pos)
    divides := name == "div" or name == "rem"
    if divides
        nz := op("ne", [b, konst(0, Ty.Int)], Ty.Bool)
        sized_trap_unless(nz, "expr.arith.3", "rt.sized_zero_msg", args, pos)
    r := op(name, [a, b], Ty.Int)
    if name == "rem"
        return r
    rule := if divides then "expr.arith.3" else "expr.arith.1"
    signed := sized_lo(k) < 0
    if name != "div" and (signed or name != "add")
        sized_trap_unless(
            op("ge", [r, konst(sized_lo(k), Ty.Int)], Ty.Bool),
            rule,
            "rt.sized_over_msg",
            args,
            pos,
        )
    if name != "div" or signed
        sized_trap_unless(
            op("le", [r, konst(sized_hi(k), Ty.Int)], Ty.Bool),
            rule,
            "rt.sized_over_msg",
            args,
            pos,
        )
    r

## `-x` on a sized integer: traps with `type.num.14` when `x` is the smallest
## value of a signed type, and on any non-zero unsigned `x`.
fn Lower.sized_neg(mut self, a Val, pos ast.Pos) Val?
    k := sized_kind(a.ty)
    r := op("neg", [a.id], Ty.Int)
    args := [a.id, konst(sized_code(k), Ty.Int)]
    sized_trap_unless(
        op("ge", [r, konst(sized_lo(k), Ty.Int)], Ty.Bool),
        "type.num.14",
        "rt.sized_neg_msg",
        args,
        pos,
    )
    sized_trap_unless(
        op("le", [r, konst(sized_hi(k), Ty.Int)], Ty.Bool),
        "type.num.14",
        "rt.sized_neg_msg",
        args,
        pos,
    )
    Val(id: r, ty: a.ty)

## The value `v` wrapped into kind `k`: sign- or zero-extended from its width.
fn Lower.sized_wrap(mut self, k str, v int) int
    if k == "u64"
        return v
    if sized_lo(k) < 0
        sh := konst(64 - sized_bits(k), Ty.Int)
        return op("shr", [op("shl", [v, sh], Ty.Int), sh], Ty.Int)
    op("band", [v, konst(sized_hi(k), Ty.Int)], Ty.Int)

fn sized_bits(k str) int
    match k
        "i8" | "u8" => 8
        "i16" | "u16" => 16
        "u64" => 64
        _ => 32

## `wrapping_*` (on `int` too, where 64-bit arithmetic already wraps),
## `saturating_*` and `abs` of a sized integer (type.num.14). `None` for any
## other method.
fn Lower.sized_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    is_int := r.ty == Ty.Int
    if not (is_int or r.ty.is_sized())
        return none
    if name == "wrapping_neg" and vs.len() == 0
        v := op("neg", [r.id], Ty.Int)
        if is_int
            return Val(id: v, ty: Ty.Int)
        return Val(id: sized_wrap(sized_kind(r.ty), v), ty: r.ty)
    if name == "abs" and vs.len() == 0 and not is_int
        k := sized_kind(r.ty)
        if sized_lo(k) == 0
            return Val(id: r.id, ty: r.ty)
        # `abs` of the smallest value of a signed type doesn't fit.
        neg := op("neg", [r.id], Ty.Int)
        ok := op("le", [neg, konst(sized_hi(k), Ty.Int)], Ty.Bool)
        sized_trap_unless(
            ok,
            "type.num.14",
            "rt.sized_abs_msg",
            [r.id, konst(sized_code(k), Ty.Int)],
            npos,
        )
        pos_b := new_block()
        join := new_block()
        res := new_value(Ty.Int, "")
        blocks[join].params.push(res)
        neg_b := new_block()
        branch(op("lt", [r.id, konst(0, Ty.Int)], Ty.Bool), neg_b, [], pos_b, [])
        seal(neg_b)
        seal(pos_b)
        cur = neg_b
        jump(join, [neg])
        cur = pos_b
        jump(join, [r.id])
        seal(join)
        cur = join
        return Val(id: res, ty: r.ty)
    if vs.len() != 1 or not same_ty(vs[0].ty, r.ty)
        return none
    if name.starts_with("wrapping_")
        base := name.slice(9, name.len())
        if base == "add" or base == "sub" or base == "mul"
            v := op(base, [r.id, vs[0].id], Ty.Int)
            if is_int
                return Val(id: v, ty: Ty.Int)
            return Val(id: sized_wrap(sized_kind(r.ty), v), ty: r.ty)
        return none
    if name.starts_with("saturating_") and not is_int
        base := name.slice(11, name.len())
        k := sized_kind(r.ty)
        if base != "add" and base != "sub" and base != "mul"
            return none
        if k == "u64"
            return u64_saturating(base, r, vs[0])
        if base == "mul" and k == "u32"
            return unsupported(npos, "`.saturating_mul()` on `u32`")
        v := op(base, [r.id, vs[0].id], Ty.Int)
        capped := int_minmax("min", v, konst(sized_hi(k), Ty.Int))
        return Val(id: int_minmax("max", capped, konst(sized_lo(k), Ty.Int)), ty: r.ty)
    none

## `saturating_add`, `saturating_sub` and `saturating_mul` on `u64`: the result, or the
## type's limit (0 below, all ones above) when it doesn't fit.
fn Lower.u64_saturating(mut self, base str, r Val, b Val) Val?
    s := op(base, [r.id, b.id], Ty.Int)
    ok := match base
        "add" => u64_le(r.id, s)
        "sub" => u64_le(b.id, r.id)
        _ => call("rt.u64_mul_ok", [r.id, b.id], Ty.Bool)
    limit := konst(if base == "sub" then 0 else -1, Ty.Int)
    join := new_block()
    res := new_value(Ty.Int, "")
    blocks[join].params.push(res)
    over := new_block()
    branch(ok, join, [s], over, [])
    seal(over)
    cur = over
    jump(join, [limit])
    seal(join)
    cur = join
    Val(id: res, ty: r.ty)

## The conversions of type.num.15 between `int` and the sized integers:
## `to_i8` ... `to_u32` on any of them, and `to_int` back. A conversion that
## doesn't fit traps with `type.num.15`. `None` for any other method.
fn Lower.sized_conversion(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    if vs.len() != 0 or not name.starts_with("to_")
        return none
    target := name.slice(3, name.len())
    from_u64 := r.ty == Ty.Sized("u64")
    if from_u64 and (target == "float" or target == "hex")
        if target == "float"
            return Val(id: call("rt.u64_float", [r.id], Ty.Float), ty: Ty.Float)
        return Val(id: call("rt.fmt_hex_u", [r.id], Ty.Str), ty: Ty.Str)
    if target == "int"
        if from_u64
            sized_trap_unless(
                op("ge", [r.id, konst(0, Ty.Int)], Ty.Bool),
                "type.num.15",
                "rt.sized_msg",
                [r.id, konst(16 + 7, Ty.Int)],
                npos,
            )
            return Val(id: op("copy", [r.id], Ty.Int), ty: Ty.Int)
        if r.ty.is_sized()
            # A new `int` value, as for `u8.to_int()` in lower_bytes.ail.
            return Val(id: op("copy", [r.id], Ty.Int), ty: Ty.Int)
        return none
    if target == "f32"
        if from_u64
            return unsupported(npos, "`.to_f32()` on `u64`")
        return int_to_f32(r)
    code := sized_code(target)
    if code < 0
        return none
    t := Ty.Sized(target)
    if target == "u64"
        # Every value of an unsigned type fits; a signed one must not be negative.
        if r.ty.is_sized() and sized_lo(sized_kind(r.ty)) == 0
            return Val(id: op("copy", [r.id], t), ty: t)
        sized_trap_unless(
            op("ge", [r.id, konst(0, Ty.Int)], Ty.Bool),
            "type.num.15",
            "rt.sized_msg",
            [r.id, konst(code, Ty.Int)],
            npos,
        )
        return Val(id: r.id, ty: t)
    if from_u64
        # Above the top bit the register is negative: the value is too large.
        msg := [r.id, konst(16 + code, Ty.Int)]
        sized_trap_unless(
            op("ge", [r.id, konst(0, Ty.Int)], Ty.Bool),
            "type.num.15",
            "rt.sized_msg",
            msg,
            npos,
        )
        sized_trap_unless(
            op("le", [r.id, konst(sized_hi(target), Ty.Int)], Ty.Bool),
            "type.num.15",
            "rt.sized_msg",
            msg,
            npos,
        )
        return Val(id: r.id, ty: t)
    if r.ty.is_sized()
        and sized_lo(sized_kind(r.ty)) >= sized_lo(target)
        and sized_hi(sized_kind(r.ty)) <= sized_hi(target)
        # Every value of the source type is in range: only the type changes.
        return Val(id: op("copy", [r.id], t), ty: t)
    sized_trap_unless(
        op("ge", [r.id, konst(sized_lo(target), Ty.Int)], Ty.Bool),
        "type.num.15",
        "rt.sized_msg",
        [r.id, konst(code, Ty.Int)],
        npos,
    )
    sized_trap_unless(
        op("le", [r.id, konst(sized_hi(target), Ty.Int)], Ty.Bool),
        "type.num.15",
        "rt.sized_msg",
        [r.id, konst(code, Ty.Int)],
        npos,
    )
    Val(id: r.id, ty: t)

## Trap at `pos` with `rule` unless `ok` holds. The runtime function `msg_fn`
## builds the message from `args` on the failing path (runtime message kind 15).
fn Lower.sized_trap_unless(mut self, ok int, rule str, msg_fn str, args List[int], pos ast.Pos)
    fail := new_block()
    check(ok, fail)
    good := cur
    seal(fail)
    cur = fail
    msg := call(msg_fn, args, Ty.Int)
    mut t := inst(-1, "trap", [msg, msg])
    t.imm = 15
    t.site = site(rule, "tensor", "", pos)
    emit_void(t)
    finish(unreachable_term())
    cur = good

## `checked_add` ... `checked_neg` on `u64` (codes as in lower_checked.ail): `none` when the
## result doesn't fit or the divisor is zero.
fn Lower.u64_checked(mut self, r Val, code int, vs List[Val]) Val?
    a := r.id
    b := if vs.len() == 1 then vs[0].id else a
    t := Ty.Opt(r.ty)
    join := new_block()
    res := new_value(t, "")
    blocks[join].params.push(res)
    yes := new_block()
    no := new_block()
    if code == 3 or code == 4
        branch(op("ne", [b, konst(0, Ty.Int)], Ty.Bool), yes, [], no, [])
    elif code == 5
        branch(op("eq", [a, konst(0, Ty.Int)], Ty.Bool), yes, [], no, [])
    else
        jump(yes, [])
    seal(yes)
    seal(no)
    cur = yes
    mut s := a
    mut ok := -1
    match code
        0 =>
            s = op("add", [a, b], Ty.Int)
            ok = u64_le(a, s)
        1 =>
            s = op("sub", [a, b], Ty.Int)
            ok = u64_le(b, a)
        2 =>
            s = op("mul", [a, b], Ty.Int)
            ok = call("rt.u64_mul_ok", [a, b], Ty.Bool)
        3 =>
            s = call("rt.u64_div", [a, b], Ty.Int)
            ok = konst(1, Ty.Bool)
        4 =>
            s = call("rt.u64_rem", [a, b], Ty.Int)
            ok = konst(1, Ty.Bool)
        _ => ok = konst(1, Ty.Bool)
    good := new_block()
    branch(ok, good, [], no, [])
    seal(good)
    cur = good
    jump(join, [some(Val(id: s, ty: r.ty)).id])
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: res, ty: t)
