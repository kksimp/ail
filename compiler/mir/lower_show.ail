## Printing collections of collections and of optionals (trait.auto.2,
## type.map.4): `List[str?]`, `List[Map[str, str]]`, `Map[str, List[int]]`.
## The type goes to `compiler/rt/native/show.ail` as a descriptor string.

use ast

## The descriptor of `t` (`i f b s c`, `[X`, `<X`, `{KV`, `?X`), or "" when
## the runtime cannot print it.
fn show_desc(t Ty) str
    if inner := t.opt_inner()
        d := show_desc(inner)
        if d == "" or d.starts_with("?")
            return ""
        return "?{d}"
    match t
        Int | Sized(_) => "i"
        Float => "f"
        Bool => "b"
        Str => "s"
        Char => "c"
        List(e) =>
            d := show_desc(e)
            if d == "" then "" else "[{d}"
        Set(e) =>
            d := show_desc(e)
            if d == "" then "" else "<{d}"
        Map(k, x) =>
            a := show_desc(k)
            b := show_desc(x)
            if a == "" or b == "" then "" else "\{{a}{b}"
        _ => ""

## `print(v)` for a collection of collections or optionals; a type the
## runtime does not print is not in the native subset yet.
fn Lower.out_shown(mut self, v Val, pos ast.Pos) Val?
    d := show_desc(v.ty)
    if d == ""
        return unsupported(pos, "printing a `{v.ty.name()}`")
    call("rt.show_out", [v.id, str_value(d)], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)
