## Generators and user iteration in the native backend (expr.yield.1-5,
## expr.iter.1-2, ADR 1073).
##
## A generator `fn count(n int) Seq[int]` becomes two functions:
## - `gen.count(frame) int?`, the resume function: the body lowered as an
##   ordinary function in which each `yield v` is a `yield` instruction, then
##   turned into a state machine over its frame by `gen_frame` (genframe.ail);
## - `count(n) Seq[int]`, the constructor: it allocates the frame (a closure
##   object, kind 13: word 0 the resume function, word 1 the state, then the
##   slots), stores a copy of each argument in the first slots, and returns a
##   `Seq` whose `step` field is the frame. `Seq.next()` calls `step`, which
##   is a call of the resume function with the frame (closure call, ADR 1067).
##
## `for x in e` over a type with `next(mut self) T?`, `Seq` included, is the
## loop `mut it := e; while true { x := it.next() else break; body }`.
use ast

## The heap kind of a frame: an environment record, scanned word by word
## (native-abi.md §2).
GEN_FRAME_KIND := 13

pub struct GenLower
    ## The element type of the generator whose body is being lowered.
    pub elem Ty?

fn new_gen_lower() GenLower
    GenLower(elem: none)

## Lower `f` if it is a generator (its body has a `yield`); false otherwise.
fn Lower.lower_gen_fn(mut self, f ast.FnDecl, name str, key str, owner str) bool
    if is_rt
        return false
    body := f.body else return false
    if not ast.has_yield(body)
        return false
    sig := sigs.get(key) else return false
    step := seq_step(sig.ret) else
        problem(f.pos, "a generator must return `Seq[T]`")
        return true
    elem := step_elem(step) else
        problem(f.pos, "a generator must return `Seq[T]`")
        return true
    resume := "gen.{name}"
    # The body, with `yield` instructions.
    params := begin_fn(resume, Ty.Unit, sig.params)
    fails = false
    gen_params(f, sig, params, owner)
    gens.elem = elem
    lower_block(body, false)
    gens.elem = none
    if not done()
        finish(return_of(-1))
    end_fn(resume, f.pos)
    if failing()
        return true
    k := funcs.len() - 1
    g := gen_frame(funcs[k], Ty.Opt(elem))
    for err in verify(g.func)
        problems.push(Problem(
            rule: "native.build.2",
            pos: f.pos,
            message: "internal error: invalid generator MIR: {err}",
        ))
    funcs[k] = g.func
    # The constructor.
    ps := begin_fn(name, sig.ret, sig.params)
    fails = false
    self_ty = owner
    mut a := inst(-1, "fnaddr", [])
    a.name = resume
    code := emit(a, Ty.Int)
    frame := call(
        "rt.obj_new",
        [konst(8 * (GEN_SLOT0 + g.slots), Ty.Int), konst(GEN_FRAME_KIND, Ty.Int)],
        step,
    )
    store(frame, 0, code)
    store(frame, 1, konst(0, Ty.Int))
    for j in 0..ps.len()
        moved := gen_param_moved(f, j)
        store(frame, GEN_SLOT0 + j, gen_own(Val(id: ps[j], ty: sig.params[j]), moved))
    seq := call("rt.obj_new", [konst(8, Ty.Int), konst(OBJ_STRUCT, Ty.Int)], sig.ret)
    store(seq, 0, frame)
    finish(return_of(seq))
    end_fn(name, f.pos)
    true

## Declare the receiver and parameters of the generator `f` in its resume
## function, as `lower_fn_as` does for any function.
fn Lower.gen_params(mut self, f ast.FnDecl, sig Sig, params List[int], owner str)
    self_ty = ""
    mut k := 0
    if f.owner != none
        self_ty = owner
        if recv := f.receiver
            declare_self(recv, sig.params[0], params[0])
            borrowed.add(lookup("self") else "")
            note_stable_param("self", false)
            k = 1
    for i in 0..f.params.len()
        p := f.params[i]
        declare_param(p, sig.params[k + i], params[k + i])
        note_stable_param(p.name, false)
        borrowed.add(lookup(p.name) else "")

## Whether argument `j` of `f` (the receiver first) is moved in.
fn gen_param_moved(f ast.FnDecl, j int) bool
    mut k := j
    if recv := f.receiver
        if k == 0
            return recv.moved
        k -= 1
    k < f.params.len() and f.params[k].moved

## The generator's own copy of an argument, which the caller may change
## later (own.val.1, expr.yield.4); a moved or unique value is taken over.
fn Lower.gen_own(mut self, v Val, moved bool) int
    if moved or is_uniq(v.ty)
        return v.id
    if v.ty.is_coll()
        return copy_coll(v)
    if needs_copy(v.ty) then copy_value(v) else v.id

## The type of the `step` field of a `Seq` instance: `fn() T?`.
fn Lower.seq_step(self, t Ty) Ty?
    n := match t
        Struct(x) => x
        _ => return none
    if not n.starts_with("Seq[")
        return none
    slots := structs.get(n)?
    if slots.len() != 1 or not slots[0].ty.is_fn()
        return none
    slots[0].ty

fn step_elem(step Ty) Ty?
    match step
        Fn(_, r, _) => r.opt_inner()
        _ => none

## `yield e` (expr.yield.2): the element, as a copy that the generator can't
## change any more, wrapped in its optional.
fn Lower.lower_yield(mut self, args List[ast.Arg], pos ast.Pos) Val?
    elem := gens.elem else return unsupported(pos, "`yield` outside a generator")
    if args.len() != 1
        return unsupported(pos, "this `yield`")
    e := args[0].value
    v := lower_value(e, elem)?
    own := copy_if_place(e, Val(id: convert(v, elem, pos), ty: elem))
    o := convert_opt(Val(id: own, ty: elem), Ty.Opt(elem), pos)
    emit_void(inst(-1, "yield", [o]))
    Val(id: -1, ty: Ty.Unit)

## `for x in e` where `e`'s type has `next(mut self) T?` (expr.iter.1-2):
## false for any other `e`. The loop's own copy of `e` (or `e` itself, when
## it is unique) is a hidden variable.
fn Lower.lower_iter_for(
    mut self,
    var str,
    iter ast.Expr,
    l Val,
    body List[ast.Stmt],
    pos ast.Pos,
) bool
    n := match l.ty
        Struct(x) => x
        Enum(x) => x
        _ => return false
    m := "{n}.next"
    if not sigs.contains(m)
        instance_method(m)
    if not sigs.contains(m)
        return false
    nvars += 1
    it := "#it{nvars}"
    declare(it, l.ty, copy_if_place(iter, l))
    recv := ast.Expr.Name(name: it, pos: pos)
    step := ast.Stmt.Let(
        name: var,
        pos: pos,
        mutable: false,
        value: ast.Expr.Method(recv: recv, name: "next", name_pos: pos, args: []),
        otherwise: ast.Else.Leave(ast.Stmt.Break(pos)),
    )
    mut inner := [step]
    inner.extend(body)
    lower_while(ast.Expr.Bool(value: true, pos: pos), inner)
    scopes.pop()
    true
