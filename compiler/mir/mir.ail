## MIR: the backend's typed SSA form (ADR 0384, ir-architecture.md §4).
## A function is a list of basic blocks; each value is defined once, by a
## block parameter or an instruction, and an edge passes arguments to its
## target's parameters (no phi nodes). Checks that can trap carry a trap
## site (`Site`), which the code generator turns into a branch to a stub.
## `ail run compiler mir FILE` prints a module with `module_text`.

## A value's machine type. Strings, lists and structs are pointers.
pub enum Ty
    Int
    Float
    Bool
    Str
    ## `bytes` (ADR 0702): a string object's layout; `Byte` is a `u8` taken
    ## from one, which only `to_int()` accepts.
    Bytes
    Byte
    ## A Unicode scalar value, in a register like an `int` (type.char.1).
    Char
    ## A list of numbers; `elem` is `Unknown` until the first use types it.
    List(elem Ty)
    ## `Map[K, V]` and `Set[T]` (ADR 0568); `K` is `int`, `bool` or `str`.
    Map(key Ty, val Ty)
    Set(elem Ty)
    ## `T?`: a pointer, or 0 for `none`; a number is boxed (ADR 0574).
    Opt(inner Ty)
    ## A struct object (native-abi.md §2): one 8-byte slot per field.
    Struct(name str)
    ## An enum (ADR 0602): an `int` when no variant has fields, else a
    ## pointer to a kind-5 object.
    Enum(name str)
    ## `tensor.Tensor[T]` (ADR 0815): a pointer to a tensor object, `T` being
    ## `int`, `float` or `F32`. A tensor is never changed in place, so a copy of the
    ## value shares the object.
    Tensor(elem Ty)
    ## `f32` (ADR 0815, ADR 0834): the element type of a `Tensor[f32]`, and a
    ## scalar held in a float register already rounded to `f32`.
    F32
    ## `(A, B, ...)` (ADR 0829): a struct object (kind 4) with one 8-byte slot
    ## per element, in order.
    Tuple(elems List[Ty])
    ## `*T` (ADR 0835): an address in an integer register; `T` is `int`,
    ## `float`, `bool`, a sized integer or another pointer.
    Ptr(inner Ty)
    ## `any T`: a box with a tag and a value (ADR 0616).
    Any(trait_name str)
    ## `ref S` of a struct: the struct object itself, shared and never copied
    ## (own.ref.1, ADR 0067).
    Ref(inner Ty)
    Unknown
    Unit
    ## A pointer to an 8-byte cell: `Atomic[int]` or `Atomic[bool]` (ADR 0600).
    Atomic(elem Ty)
    ## `Channel[str]`: a pointer to the channel's record (ADR 0599).
    Chan(elem Ty)
    ## `Mutex[T]`: a pointer to the mutex record (conc.share.5).
    Mutex(elem Ty)
    ## A `TaskGroup`: a pointer to the group record (conc.task.8).
    Group
    ## A function value (ADR 0573): in user code a pointer to a closure object
    ## whose word 0 is the code address (ADR 1067); in the runtime a code address.
    ## `err` is `Unit` when calling it can't fail, else its error type (`Unknown`
    ## when that isn't one struct, type.fn.6).
    Fn(params List[Ty], ret Ty, err Ty)
    ## A sized integer `i8 i16 i32 u8 u16 u32` (ADR 0834): in a register like
    ## an `int`, sign- or zero-extended from its width, so its value is
    ## always inside the type's range. `kind` is the type's name.
    Sized(kind str)
    ## Two `float`s in one 128-bit vector register, lane 0 in the low half (native.vec.3, ADR 1066). Only the
    ## pairing pass (`slp.ail`) makes one, and it lives inside one block: never a block parameter, never across
    ## a call, never a constant.
    Vec2

pub fn Ty.is_ref(self) bool
    match self
        Ref => true
        _ => false

pub fn Ty.is_float(self) bool
    match self
        Float | F32 => true
        _ => false

## A two-lane vector (`Vec2`).
pub fn Ty.is_vec(self) bool
    match self
        Vec2 => true
        _ => false

## Held in a float or vector register: a `float`, an `f32` or a `Vec2`.
pub fn Ty.in_float_reg(self) bool
    match self
        Float | F32 | Vec2 => true
        _ => false

pub fn Ty.is_unit(self) bool
    match self
        Unit => true
        _ => false

pub fn Ty.is_unknown(self) bool
    match self
        Unknown => true
        _ => false

## The element type of a list type, else `none`.
pub fn Ty.elem(self) Ty?
    match self
        List(e) => e
        _ => none

## A sized integer (ADR 0834).
pub fn Ty.is_sized(self) bool
    match self
        Sized(_) => true
        _ => false

## Bytes one element of a list of `self` takes: 1 for a `bool` or a `u8`, 2 for
## a `u16`, 4 for a `u32` (native-abi.md §2, ADRs 0907 and 0912), else 8.
pub fn Ty.elem_bytes(self) int
    match self
        Bool => 1
        Sized(n) => sized_elem_bytes(n)
        _ => 8

fn sized_elem_bytes(name str) int
    if name == "u8"
        return 1
    if name == "u16"
        return 2
    if name == "u32"
        return 4
    8

pub fn Ty.is_tensor(self) bool
    match self
        Tensor(_) => true
        _ => false

## A `Map` or a `Set`: a pointer to a table object (ADR 0568).
pub fn Ty.is_coll(self) bool
    match self
        Map(_, _) | Set(_) => true
        _ => false

pub fn Ty.name(self) str
    match self
        Int => "int"
        Float => "float"
        Bool => "bool"
        Str => "str"
        Bytes => "bytes"
        Byte => "u8"
        Char => "char"
        Sized(k) => k
        List(e) => "List[{e.name()}]"
        Map(k, v) => "Map[{k.name()}, {v.name()}]"
        Set(e) => "Set[{e.name()}]"
        Opt(t) => "{t.name()}?"
        Tensor(e) => "Tensor[{e.name()}]"
        F32 => "f32"
        Vec2 => "float2"
        Ptr(t) => "*{t.name()}"
        Tuple(es) => "({[e.name() for e in es].join(", ")})"
        Struct(n) => n
        Enum(n) => n
        Any(t) => "any {t}"
        Ref(t) => "ref {t.name()}"
        Unknown => "?"
        Unit => "unit"
        Atomic(e) => "Atomic[{e.name()}]"
        Chan(e) => "Channel[{e.name()}]"
        Mutex(e) => "Mutex[{e.name()}]"
        Group => "TaskGroup"
        Fn(ps, r, e) =>
            mut names := List[str]()
            for p in ps
                names.push(p.name())
            mut text := "fn({names.join(", ")})"
            if not r.is_unit()
                text = "{text} {r.name()}"
            if not e.is_unit()
                text = "{text} ! {e.name()}"
            text

## One instruction: `dst` is the value it defines (-1 for none), `args`
## the values it reads. The operations (`op`):
##
## | op | args | meaning |
## |---|---|---|
## | `const` | | `imm`, an `int` or `bool` (0, 1) |
## | `fconst` | | `fimm` |
## | `str` | | the address of string literal `imm` (`Module.strs`) |
## | `add sub mul div rem` | a, b | `int` arithmetic; traps at `site` on overflow and, for `div` and `rem`, a zero divisor (expr.arith.1-3); `site` -1: can't overflow |
## | `fadd fsub fmul fdiv` | a, b | `float` arithmetic |
## | `eq ne lt le gt ge` | a, b | `int`/`bool` comparison, a `bool` |
## | `feq fne flt fle fgt fge` | a, b | `float` comparison; NaN is unequal to everything |
## | `neg` / `fneg` / `not` | a | negation (`neg` traps on the smallest `int`) |
## | `itof` / `ftoi` | a | `n.to_float()`, `x.to_int()` (truncates; traps on NaN and out of range) |
## | `sqrt abs floor ceil` | a | on `float` |
## | `call` | arguments | function `name`; `dst` -1 when it returns nothing |
## | `fnaddr` | | the address of function `name` (a function value) |
## | `utrap` | message | `unreachable(message)` (err.model.2): flushes output, prints the trap at `site` and exits 1 |
## | `icall` | callee, arguments | call through a function value; `dst` -1 when it returns nothing |
## | `prim` | arguments | runtime primitive `name` (native-abi.md §6) |
## | `get` | list, index | `xs[i]`, bounds-checked at `site` (type.coll.4); `site` -1: known in bounds |
## | `set` | list, index, value | `xs[i] = v`, bounds-checked at `site` |
## | `bounds` | index, len | traps at `site` unless `0 <= index < len`; the check of a `get` or `set` whose list header was hoisted (ADR 0890) |
## | `len` | list | `xs.len()` |
## | `cap` | list | how many elements `xs` has room for before `push` regrows it |
## | `copy` | a | the same value |
## | `data` | list | the address of `xs`'s elements (the word at +16); `push` can move them |
## | `ldx` | base, index | the element `index + fimm` of the elements at `base`, `imm` bytes each (8, or 1 for a `List[bool]`); not checked; `fimm` is a whole number of elements, 0 unless address folding set it |
## | `stx` | base, index, value | writes that element (`index + fimm`); not checked |
## | `load` | object | the 8-byte slot at byte offset `imm` (a struct field) |
## | `store` | object, value | writes the slot at byte offset `imm` |
## | `salloc` | | the address of the second word of `imm / 8 + 1` words in the function's frame (native.stack.1); the first word is the object header; written by the `stackify` pass, never by lowering |
## | `vldx` | base, index | a `Vec2` of the elements `index + fimm` (lane 0) and `index + fimm + 1` (lane 1) of the 8-byte elements at `base`; not checked, not aligned (native.vec.3); `imm` 1: `index` is a byte offset (`8 * i`, vecmap.ail), `fimm` 0 |
## | `vstx` | base, index, value | writes a `Vec2` to those two elements |
## | `vfadd vfsub vfmul vfdiv` | a, b | `float` arithmetic on each lane of two `Vec2`s, operands in this order, never fused |
## | `vsplat` | a | a `Vec2` with the `float` `a` in both lanes |
## | `vpack` | a, b | a `Vec2` with the `float` `a` in lane 0 and `b` in lane 1 |
## | `vlane` | a | lane `imm` (0 or 1) of a `Vec2`, a `float` |
## | `vhadd` | a | lane 0 + lane 1 of a `Vec2`, a `float` |
## | `trap` | a, b | traps at `site`: the runtime's message `imm` (native-abi.md §7) on `a`, `b` and the text `name`; ends its block |
pub struct Inst
    pub dst int
    pub op str
    ## How many operands, and the first three inline; `more` holds the rest
    ## (`none`, no allocation, up to three). Read them with `arg`, `operands`.
    pub n int
    pub a int
    pub b int
    pub c int
    pub more List[int]?
    pub imm int
    pub fimm float
    pub name str
    pub site int

## The elements `ldx`/`stx` add to their index (carried in `fimm`, which no
## integer instruction uses, so that `Inst` keeps its fields; ADR 0625).
pub fn Inst.elem_off(self) int
    self.fimm.to_int()

## The operands of an instruction go through these accessors, so that how
## `Inst` stores them can change (see docs/design/compact-inst.md).
pub fn Inst.arg(self, k int) int
    if k == 0
        return self.a
    if k == 1
        return self.b
    if k == 2
        return self.c
    ms := self.more else return -1
    ms[k - 3]

pub fn Inst.argc(self) int
    self.n

pub fn Inst.operands(self) List[int]
    [self.arg(k) for k in 0..self.n]

pub fn Inst.with_args(self, xs List[int]) Inst
    packed(self.dst, self.op, xs, self.imm, self.fimm, self.name, self.site)

pub fn Inst.with_arg(self, k int, v int) Inst
    mut r := self
    if k == 0
        r.a = v
    elif k == 1
        r.b = v
    elif k == 2
        r.c = v
    else
        mut ms := self.more else return self
        ms[k - 3] = v
        r.more = ms
    r

fn tail_of(xs List[int]) List[int]?
    if xs.len() <= 3
        return none
    [xs[k] for k in 3..xs.len()]

fn nth(xs List[int], k int) int
    if k < xs.len()
        return xs[k]
    -1

fn packed(dst int, op str, xs List[int], imm int, fimm float, name str, site int) Inst
    Inst(
        dst: dst,
        op: op,
        n: xs.len(),
        a: nth(xs, 0),
        b: nth(xs, 1),
        c: nth(xs, 2),
        more: tail_of(xs),
        imm: imm,
        fimm: fimm,
        name: name,
        site: site,
    )

## The bytes per element of the list that push callee `name` fills: a
## `List[u8]` or `List[bool]` 1, a `List[u16]` 2, a `List[u32]` 4, else 8.
pub fn is_push_name(name str) bool
    name == "rt.list_push" or name == "rt.list_pushf" or push_bytes(name) < 8

pub fn push_bytes(name str) int
    match name
        "rt.list_pushb" => 1
        "rt.list_pushw" => 2
        "rt.list_pushd" => 4
        _ => 8

pub fn inst(dst int, op str, args List[int]) Inst
    packed(dst, op, args, 0, 0.0, "", -1)

## How a block ends: `jump` (one target), `branch` on `cond` (targets: if
## true, if false), `switch` on the `int` `cond` (targets: one per index
## 0..n-1, then the target for any other value, compared unsigned; a jump
## table, native.match.2), `return` (`value`, -1 for none), or `unreachable`
## (after a trap). `args[k]` are the values edge `k` passes to
## `targets[k]`'s parameters.
pub struct Term
    pub kind str
    pub cond int
    pub targets List[int]
    pub args List[List[int]]
    pub value int

pub fn jump_to(target int, args List[int]) Term
    Term(kind: "jump", cond: -1, targets: [target], args: [args], value: -1)

pub fn branch_on(cond int, yes int, no int) Term
    Term(kind: "branch", cond: cond, targets: [yes, no], args: [[], []], value: -1)

## A jump table: index `k` goes to `cases[k]`, any other value to `other`.
pub fn switch_on(cond int, cases List[int], other int) Term
    mut ts := cases
    ts.push(other)
    Term(
        kind: "switch",
        cond: cond,
        targets: ts,
        args: [List[int]() for _ in 0..ts.len()],
        value: -1,
    )

pub fn return_of(value int) Term
    Term(kind: "return", cond: -1, targets: [], args: [], value: value)

pub fn unreachable_term() Term
    Term(kind: "unreachable", cond: -1, targets: [], args: [], value: -1)

## The values a terminator reads, including edge arguments.
pub fn Term.uses(self) List[int]
    mut out := List[int]()
    if self.cond >= 0
        out.push(self.cond)
    for a in self.args
        out.extend(a)
    if self.value >= 0
        out.push(self.value)
    out

pub struct Block
    pub params List[int]
    pub insts List[Inst]
    pub term Term

pub struct Func
    pub name str
    ## The entry block's parameters are the function's parameters.
    pub params List[int]
    pub ret Ty
    pub blocks List[Block]
    ## The type of each value.
    pub vals List[Ty]
    ## A source name for each value that has one, else "".
    pub names List[str]

## A check that can trap (run.trap.*): the rule, and where. `kind` says how
## the runtime builds the message from the operands: `arith` (`a OP b`
## overflows), `div` (division by zero), `bounds`, `neg`, `float_int`.
pub struct Site
    pub rule str
    pub kind str
    pub op str
    pub line int
    pub col int
    pub func str
    ## The source file, an index into `Module.files` (ADR 0393).
    pub file int
    ## For a check copied in by inlining: the site of the call it came from
    ## (a stack frame of its own, trace.frame.2), else -1.
    pub from int

## The source excerpt under a trap: the line with its number, and a caret
## under column `col` (native-abi.md §7).
pub fn excerpt(line str, n int, col int) str
    gutter := "{n}"
    mut pad := List[str]()
    chars := line.chars()
    for c in 0..col - 1
        pad.push(if c < chars.len() and chars[c] == '\t' then "\t" else " ")
    "  {gutter} | {line}\n  {" ".repeat(gutter.chars().len())} | {pad.join("")}^\n"

pub struct Module
    pub path str
    pub funcs List[Func]
    pub strs List[str]
    pub sites List[Site]
    ## The source text's lines, for trap excerpts.
    pub lines List[str]
    ## Every source file of the program and its lines; file 0 is `path`.
    pub files List[str]
    pub file_lines List[List[str]]
    ## Warnings of the build, `FILE:LINE:COL: warning[RULE]: TEXT`, printed to standard error.
    pub notes List[str]

## Whether an instruction may be removed when its value is unused.
pub fn Inst.is_pure(self) bool
    match self.op
        "const" | "fconst" | "str" | "fnaddr" | "fadd" | "fsub" | "fmul" | "fdiv" => true
        "eq" | "ne" | "lt" | "le" | "gt" | "ge" => true
        "feq" | "fne" | "flt" | "fle" | "fgt" | "fge" => true
        "fneg" | "not" | "itof" | "sqrt" | "abs" | "floor" | "ceil" | "len" | "cap" | "copy" => true
        "band" | "bor" | "bxor" | "bnot" => true
        "vfadd" | "vfsub" | "vfmul" | "vfdiv" | "vsplat" | "vpack" | "vlane" | "vhadd" => true
        "add" | "sub" | "mul" | "neg" | "shl" | "shr" | "div" | "rem" => self.site < 0
        _ => false

## A call's position as one number (trace.frame.1): file 44.., line 20..43,
## column 0..19. Never 0, since lines start at 1.
pub fn call_pos(file int, line int, col int) int
    file.shl(44).bit_or(line.shl(20)).bit_or(col)

pub fn call_file(pos int) int
    pos.shr(44)

pub fn call_line(pos int) int
    pos.shr(20).bit_and(16777215)

pub fn call_col(pos int) int
    pos.bit_and(1048575)
