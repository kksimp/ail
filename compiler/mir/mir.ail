## MIR: the backend's typed SSA form (ADR 0384, ir-architecture.md §4).
## A function is a list of basic blocks; each value is defined once, by a
## block parameter or an instruction, and an edge passes arguments to its
## target's parameters (no phi nodes). Checks that can trap carry a trap
## site (`Site`), which the code generator turns into a branch to a stub.
## `ail run compiler mir FILE` prints a module with `module_text`.

## A value's machine type. Strings, lists and structs are pointers.
pub enum Ty
    Int
    Float
    Bool
    Str
    ## `bytes` (ADR 0702): a string object's layout; `Byte` is a `u8` taken
    ## from one, which only `to_int()` accepts.
    Bytes
    Byte
    ## A Unicode scalar value, in a register like an `int` (type.char.1).
    Char
    ## A list of numbers; `elem` is `Unknown` until the first use types it.
    List(elem Ty)
    ## `Map[K, V]` and `Set[T]` (ADR 0568); `K` is `int`, `bool` or `str`.
    Map(key Ty, val Ty)
    Set(elem Ty)
    ## `T?`: a pointer, or 0 for `none`; a number is boxed (ADR 0574).
    Opt(inner Ty)
    ## A struct object (native-abi.md §2): one 8-byte slot per field.
    Struct(name str)
    ## An enum (ADR 0602): an `int` when no variant has fields, else a
    ## pointer to a kind-5 object.
    Enum(name str)
    ## `tensor.Tensor[T]` (ADR 0815): a pointer to a tensor object, `T` being
    ## `int`, `float` or `F32`. A tensor is never changed in place, so a copy of the
    ## value shares the object.
    Tensor(elem Ty)
    ## The element type of a `Tensor[f32]` (ADR 0815); there is no scalar `f32`
    ## value in the native subset yet.
    F32
    ## `(A, B, ...)` (ADR 0829): a struct object (kind 4) with one 8-byte slot
    ## per element, in order.
    Tuple(elems List[Ty])
    ## `any T`: a box with a tag and a value (ADR 0616).
    Any(trait_name str)
    Unknown
    Unit
    ## A pointer to an 8-byte cell: `Atomic[int]` or `Atomic[bool]` (ADR 0600).
    Atomic(elem Ty)
    ## A function value: the address of a declared function (ADR 0573).
    Fn(params List[Ty], ret Ty)
    ## A sized integer `i8 i16 i32 u8 u16 u32` (ADR 0834): in a register like
    ## an `int`, sign- or zero-extended from its width, so its value is
    ## always inside the type's range. `kind` is the type's name.
    Sized(kind str)

pub fn Ty.is_float(self) bool
    match self
        Float => true
        _ => false

pub fn Ty.is_unit(self) bool
    match self
        Unit => true
        _ => false

pub fn Ty.is_unknown(self) bool
    match self
        Unknown => true
        _ => false

## The element type of a list type, else `none`.
pub fn Ty.elem(self) Ty?
    match self
        List(e) => e
        _ => none

## A sized integer (ADR 0834).
pub fn Ty.is_sized(self) bool
    match self
        Sized(_) => true
        _ => false

pub fn Ty.is_tensor(self) bool
    match self
        Tensor(_) => true
        _ => false

## A `Map` or a `Set`: a pointer to a table object (ADR 0568).
pub fn Ty.is_coll(self) bool
    match self
        Map(_, _) | Set(_) => true
        _ => false

pub fn Ty.name(self) str
    match self
        Int => "int"
        Float => "float"
        Bool => "bool"
        Str => "str"
        Bytes => "bytes"
        Byte => "u8"
        Char => "char"
        Sized(k) => k
        List(e) => "List[{e.name()}]"
        Map(k, v) => "Map[{k.name()}, {v.name()}]"
        Set(e) => "Set[{e.name()}]"
        Opt(t) => "{t.name()}?"
        Tensor(e) => "Tensor[{e.name()}]"
        F32 => "f32"
        Tuple(es) => "({[e.name() for e in es].join(", ")})"
        Struct(n) => n
        Enum(n) => n
        Any(t) => "any {t}"
        Unknown => "?"
        Unit => "unit"
        Atomic(e) => "Atomic[{e.name()}]"
        Fn(ps, r) =>
            mut names := List[str]()
            for p in ps
                names.push(p.name())
            if r.is_unit()
                "fn({names.join(", ")})"
            else
                "fn({names.join(", ")}) {r.name()}"

## One instruction: `dst` is the value it defines (-1 for none), `args`
## the values it reads. The operations (`op`):
##
## | op | args | meaning |
## |---|---|---|
## | `const` | | `imm`, an `int` or `bool` (0, 1) |
## | `fconst` | | `fimm` |
## | `str` | | the address of string literal `imm` (`Module.strs`) |
## | `add sub mul div rem` | a, b | `int` arithmetic; traps at `site` on overflow and, for `div` and `rem`, a zero divisor (expr.arith.1-3); `site` -1: can't overflow |
## | `fadd fsub fmul fdiv` | a, b | `float` arithmetic |
## | `eq ne lt le gt ge` | a, b | `int`/`bool` comparison, a `bool` |
## | `feq fne flt fle fgt fge` | a, b | `float` comparison; NaN is unequal to everything |
## | `neg` / `fneg` / `not` | a | negation (`neg` traps on the smallest `int`) |
## | `itof` / `ftoi` | a | `n.to_float()`, `x.to_int()` (truncates; traps on NaN and out of range) |
## | `sqrt abs floor ceil` | a | on `float` |
## | `call` | arguments | function `name`; `dst` -1 when it returns nothing |
## | `fnaddr` | | the address of function `name` (a function value) |
## | `utrap` | message | `unreachable(message)` (err.model.2): flushes output, prints the trap at `site` and exits 1 |
## | `icall` | callee, arguments | call through a function value; `dst` -1 when it returns nothing |
## | `prim` | arguments | runtime primitive `name` (native-abi.md §6) |
## | `get` | list, index | `xs[i]`, bounds-checked at `site` (type.coll.4); `site` -1: known in bounds |
## | `set` | list, index, value | `xs[i] = v`, bounds-checked at `site` |
## | `len` | list | `xs.len()` |
## | `cap` | list | how many elements `xs` has room for before `push` regrows it |
## | `copy` | a | the same value |
## | `data` | list | the address of `xs`'s elements (the word at +16); `push` can move them |
## | `ldx` | base, index | the element `index + fimm` of the elements at `base`, `imm` bytes each (8, or 1 for a `List[bool]`); not checked; `fimm` is a whole number of elements, 0 unless address folding set it |
## | `stx` | base, index, value | writes that element (`index + fimm`); not checked |
## | `load` | object | the 8-byte slot at byte offset `imm` (a struct field) |
## | `store` | object, value | writes the slot at byte offset `imm` |
## | `trap` | a, b | traps at `site`: the runtime's message `imm` (native-abi.md §7) on `a`, `b` and the text `name`; ends its block |
pub struct Inst
    pub dst int
    pub op str
    pub args List[int]
    pub imm int
    pub fimm float
    pub name str
    pub site int

## The elements `ldx`/`stx` add to their index (carried in `fimm`, which no
## integer instruction uses, so that `Inst` keeps its fields; ADR 0625).
pub fn Inst.elem_off(self) int
    fimm.to_int()

pub fn inst(dst int, op str, args List[int]) Inst
    Inst(dst: dst, op: op, args: args, imm: 0, fimm: 0.0, name: "", site: -1)

## How a block ends: `jump` (one target), `branch` on `cond` (targets: if
## true, if false), `return` (`value`, -1 for none), or `unreachable`
## (after a trap). `args[k]` are the values edge `k` passes to
## `targets[k]`'s parameters.
pub struct Term
    pub kind str
    pub cond int
    pub targets List[int]
    pub args List[List[int]]
    pub value int

pub fn jump_to(target int, args List[int]) Term
    Term(kind: "jump", cond: -1, targets: [target], args: [args], value: -1)

pub fn branch_on(cond int, yes int, no int) Term
    Term(kind: "branch", cond: cond, targets: [yes, no], args: [[], []], value: -1)

pub fn return_of(value int) Term
    Term(kind: "return", cond: -1, targets: [], args: [], value: value)

pub fn unreachable_term() Term
    Term(kind: "unreachable", cond: -1, targets: [], args: [], value: -1)

## The values a terminator reads, including edge arguments.
pub fn Term.uses(self) List[int]
    mut out := List[int]()
    if cond >= 0
        out.push(cond)
    for a in args
        out.extend(a)
    if value >= 0
        out.push(value)
    out

pub struct Block
    pub params List[int]
    pub insts List[Inst]
    pub term Term

pub struct Func
    pub name str
    ## The entry block's parameters are the function's parameters.
    pub params List[int]
    pub ret Ty
    pub blocks List[Block]
    ## The type of each value.
    pub vals List[Ty]
    ## A source name for each value that has one, else "".
    pub names List[str]

## A check that can trap (run.trap.*): the rule, and where. `kind` says how
## the runtime builds the message from the operands: `arith` (`a OP b`
## overflows), `div` (division by zero), `bounds`, `neg`, `float_int`.
pub struct Site
    pub rule str
    pub kind str
    pub op str
    pub line int
    pub col int
    pub func str
    ## The source file, an index into `Module.files` (ADR 0393).
    pub file int
    ## For a check copied in by inlining: the site of the call it came from
    ## (a stack frame of its own, trace.frame.2), else -1.
    pub from int

## The source excerpt under a trap: the line with its number, and a caret
## under column `col` (native-abi.md §7).
pub fn excerpt(line str, n int, col int) str
    gutter := "{n}"
    mut pad := List[str]()
    chars := line.chars()
    for c in 0..col - 1
        pad.push(if c < chars.len() and chars[c] == '\t' then "\t" else " ")
    "  {gutter} | {line}\n  {" ".repeat(gutter.chars().len())} | {pad.join("")}^\n"

pub struct Module
    pub path str
    pub funcs List[Func]
    pub strs List[str]
    pub sites List[Site]
    ## The source text's lines, for trap excerpts.
    pub lines List[str]
    ## Every source file of the program and its lines; file 0 is `path`.
    pub files List[str]
    pub file_lines List[List[str]]

## Whether an instruction may be removed when its value is unused.
pub fn Inst.is_pure(self) bool
    match op
        "const" | "fconst" | "str" | "fnaddr" | "fadd" | "fsub" | "fmul" | "fdiv" => true
        "eq" | "ne" | "lt" | "le" | "gt" | "ge" => true
        "feq" | "fne" | "flt" | "fle" | "fgt" | "fge" => true
        "fneg" | "not" | "itof" | "sqrt" | "abs" | "floor" | "ceil" | "len" | "cap" | "copy" => true
        "band" | "bor" | "bxor" | "bnot" => true
        "add" | "sub" | "mul" | "neg" | "shl" | "shr" | "div" | "rem" => site < 0
        _ => false

## A call's position as one number (trace.frame.1): file 44.., line 20..43,
## column 0..19. Never 0, since lines start at 1.
pub fn call_pos(file int, line int, col int) int
    file.shl(44).bit_or(line.shl(20)).bit_or(col)

pub fn call_file(pos int) int
    pos.shr(44)

pub fn call_line(pos int) int
    pos.shr(20).bit_and(16777215)

pub fn call_col(pos int) int
    pos.bit_and(1048575)
