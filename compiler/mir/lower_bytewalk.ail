## `for b in bs` over a `bytes` walks the bytes in place (type.bytes.5,
## expr.loop.3): no `List[u8]` copy of them is built. `bytes` is an immutable
## value, so the loop sees it as it was even when the body assigns to the
## variable it came from. `for mut` keeps the copy, which its writes go to.
## `AIL_OPT_OFF=bytewalk` keeps the copy for every loop.
use ast

## Lower the loop when `l` is a `bytes` and the loop variable is not `mut`;
## false (nothing emitted) otherwise. The caller's scope is popped here.
fn Lower.lower_bytes_for(
    mut self,
    var str,
    l Val,
    body List[ast.Stmt],
    mutable bool,
    fpos ast.Pos,
) bool
    if mutable or l.ty != Ty.Bytes or opt_off("bytewalk")
        return false
    n := self.op("len", [l.id], Ty.Int)
    base := self.op("add", [self.rawop("str_addr", [l.id], Ty.Int), self.konst(16, Ty.Int)], Ty.Int)
    self.nvars += 1
    ikey := "#i{self.nvars}"
    self.var_ty[ikey] = Ty.Int
    self.write_var(ikey, self.cur, self.konst(0, Ty.Int))
    head := self.new_block()
    self.jump(head, [])
    self.cur = head
    i := self.read_var(ikey, head)
    inner := self.new_block()
    exit := self.new_block()
    latch := self.new_block()
    self.branch(self.op("lt", [i, n], Ty.Bool), inner, [], exit, [])
    self.seal(inner)
    self.cur = inner
    byte := self.rawop("load8", [self.op("add", [base, i], Ty.Int)], Ty.Int)
    self.declare(var, Ty.Sized("u8"), byte)
    self.loops.push(Loop(cont: latch, exit: exit, at: fpos))
    self.lower_block(body, false)
    self.loops.pop()
    self.jump(latch, [])
    self.seal(latch)
    self.cur = latch
    j := self.read_var(ikey, latch)
    self.write_var(ikey, self.cur, self.op("add", [j, self.konst(1, Ty.Int)], Ty.Int))
    self.jump(head, [])
    self.seal(head)
    self.seal(exit)
    self.cur = exit
    self.scopes.pop()
    true
