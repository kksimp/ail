## LoopInfo analysis for the optimiser (ADR 0577): natural loops from the
## dominators (`dominators` in verify.ail), and the counted loops the
## bounds-check pass (bce.ail) works on: `i` starts at a constant and
## steps by 1 while `i < hi`.

## Where a value is defined: its block, and the index of its instruction
## there, or -1 for a block parameter.
pub struct Def
    pub block int
    pub at int

pub fn defs_of(f Func) List[Def]
    mut out := [Def(block: -1, at: -1) for _ in 0..f.vals.len()]
    for b in 0..f.blocks.len()
        for p in f.blocks[b].params
            out[p] = Def(block: b, at: -1)
        for k in 0..f.blocks[b].insts.len()
            d := f.blocks[b].insts[k].dst
            if d >= 0
                out[d] = Def(block: b, at: k)
    out

## The instruction that defines `v`, or `none` for a block parameter.
pub fn inst_of(f Func, defs List[Def], v int) Inst?
    d := defs[v]
    if d.at < 0
        return none
    f.blocks[d.block].insts[d.at]

## The value of a constant `int`.
pub fn const_of(f Func, defs List[Def], v int) int?
    i := inst_of(f, defs, v)?
    if i.op == "const" then i.imm else none

pub struct LoopInfo
    pub header int
    ## `member[b]`: block `b` is in the loop.
    pub member List[bool]
    pub blocks List[int]
    ## The one block outside the loop that jumps to the header, else -1.
    pub pre int
    ## The blocks that jump back to the header.
    pub latches List[int]
    ## How many edges leave the loop.
    pub exits int

pub fn find_loops(f Func) List[LoopInfo]
    n := f.blocks.len()
    dom := dominators(f)
    mut preds := [List[int]() for _ in 0..n]
    for b in 0..n
        for t in f.blocks[b].term.targets
            preds[t].push(b)
    mut out := List[LoopInfo]()
    mut at := Map[int, int]()
    for b in 0..n
        for h in f.blocks[b].term.targets
            if not dom[b][h]
                continue
            mut k := out.len()
            if seen := at.get(h)
                k = seen
            else
                at[h] = k
                mut m := [false for _ in 0..n]
                m[h] = true
                out.push(LoopInfo(header: h, member: m, blocks: [], pre: -1, latches: [], exits: 0))
            out[k].latches.push(b)
            mut stack := [b]
            while stack.len() > 0
                x := stack.pop() else break
                if out[k].member[x]
                    continue
                out[k].member[x] = true
                for p in preds[x]
                    stack.push(p)
    for k in 0..out.len()
        h := out[k].header
        out[k].blocks = [b for b in 0..n if out[k].member[b]]
        mut outside := List[int]()
        for p in preds[h]
            if not out[k].member[p]
                outside.push(p)
        if outside.len() == 1 and f.blocks[outside[0]].term.kind == "jump"
            out[k].pre = outside[0]
        mut exits := 0
        for b in out[k].blocks
            for t in f.blocks[b].term.targets
                if not out[k].member[t]
                    exits += 1
        out[k].exits = exits
    out

## Whether `lp` has no loop inside it.
pub fn is_innermost(loops List[LoopInfo], lp LoopInfo) bool
    for other in loops
        if other.header != lp.header and lp.member[other.header]
            return false
    true

## A loop `while p < hi` that adds 1 to `p` on every path back, and leaves
## only from its header, on the false edge. The bound `hi` is defined
## outside the loop, or is a second header parameter `q` that subtracts 1 on
## every path back (`while i < j` with `i += 1` and `j -= 1`), so that
## `0 <= p < q <= start of q` inside the body.
pub struct Counted
    ## The header parameter, its index, and its start (a constant >= 0).
    pub p int
    pub k int
    pub lo int
    pub hi int
    ## The second parameter, or -1.
    pub q int
    ## A value defined outside the loop that `p` stays below in the body:
    ## `hi`, or `q`'s start.
    pub bound int
    pub body int
    pub exit int
    ## The edge of the header's branch that leaves.
    pub exit_edge int
    ## What `p` steps by on every path back: a value defined outside the loop
    ## (the guard tests that it is at least 1), or -1 for the constant 1.
    pub step int

pub fn counted(f Func, defs List[Def], lp LoopInfo) Counted?
    if lp.exits != 1
        return none
    counted_multi(f, defs, lp)

## `counted` for a loop that may also leave from blocks other than its
## header (`break`, `return`, a failing `and` term): `p < hi` still holds in
## every block of the body, since each pass enters it from the header's true
## edge (native.bce.16).
pub fn counted_multi(f Func, defs List[Def], lp LoopInfo) Counted?
    if lp.pre < 0
        return none
    h := f.blocks[lp.header]
    t := h.term
    if t.kind != "branch" or not lp.member[t.targets[0]] or lp.member[t.targets[1]]
        return none
    cmp := inst_of(f, defs, t.cond)?
    if (cmp.op != "lt" and cmp.op != "gt") or defs[t.cond].block != lp.header
        return none
    p := if cmp.op == "lt" then cmp.arg(0) else cmp.arg(1)
    hi := if cmp.op == "lt" then cmp.arg(1) else cmp.arg(0)
    k := param_index(h, p)
    if k < 0
        return none
    mut q := -1
    mut bound := hi
    if lp.member[defs[hi].block]
        kq := param_index(h, hi)
        if kq < 0 or hi == p
            return none
        q = hi
        bound = f.blocks[lp.pre].term.args[0][kq]
        if lp.member[defs[bound].block]
            return none
        for l in lp.latches
            lt := f.blocks[l].term
            for e in 0..lt.targets.len()
                if lt.targets[e] != lp.header
                    continue
                dec := inst_of(f, defs, lt.args[e][kq])?
                if dec.op != "sub" or dec.arg(0) != q or const_of(f, defs, dec.arg(1)) != 1
                    return none
    lo := f.blocks[lp.pre].term.args[0][k]
    if start := const_of(f, defs, lo)
        if start < 0
            return none
    elif lp.member[defs[lo].block] or f.vals[lo] != Ty.Int
        # A start computed before the loop (`for j in i + 1..n`): the guard
        # tests that it is not negative (ADR 0622).
        return none
    mut stride := -1
    mut strided := false
    for l in lp.latches
        lt := f.blocks[l].term
        for e in 0..lt.targets.len()
            if lt.targets[e] != lp.header
                continue
            step := inst_of(f, defs, lt.args[e][k])?
            if step.op != "add" or step.arg(0) != p
                return none
            by := step.arg(1)
            if const_of(f, defs, by) == 1
                if strided
                    return none
                continue
            # `j += s` for an `s` that doesn't change (ADR 0622); not with a
            # second induction variable, which needs steps of exactly 1.
            if q >= 0 or lp.member[defs[by].block] or f.vals[by] != Ty.Int
                return none
            if strided and stride != by
                return none
            stride = by
            strided = true
    Counted(
        p: p,
        k: k,
        lo: lo,
        hi: hi,
        q: q,
        bound: bound,
        body: t.targets[0],
        exit: t.targets[1],
        exit_edge: 1,
        step: stride,
    )

fn param_index(h Block, v int) int
    for j in 0..h.params.len()
        if h.params[j] == v
            return j
    -1
