## Native instrumentation (ADR 0871, native.instr.1-3): with
## `AIL_INSTRUMENT=lines` in the environment, each statement of the
## program's own files starts with a call of `rt.instr_hit(ID)`
## (rt/native/instr.ail). The site table goes to the file
## `$AIL_INSTRUMENT_SITES`, one `ID<TAB>PATH<TAB>LINE<TAB>FN<TAB>FIRST` line
## per site (FIRST is 1 for a function's first statement). Without the
## variable nothing is emitted: no call, no table.
use ast

## What one `vd.N` describer prints: the names and types of the spilled slots, the first
## `np` being the arguments.
pub struct ValDesc
    names List[str]
    tys List[Ty]
    np int

pub struct Instr
    on bool
    calls bool
    ## `record`: captured calls go through the recorder (lower_record.ail).
    rec bool
    ## `steps`: each statement counts toward `--max-steps` (run.limit.3).
    steps bool
    ## `tests`: calls, but not those of the test runner's own `main` and `ail_*` helpers.
    tests bool
    ## `values`: each function keeps its arguments and locals where a trap's stack can print
    ## them (`--values`, trace.frame.3; rt/native/vals.ail).
    vals bool
    ## `verbose`: `--verbose` (trace.snap.3): every frame, each local on its own line.
    verbose bool
    ## The spill object of the function being lowered (-1 for none), its name, and how many
    ## of the names declared by then are its parameters.
    sp int
    owner str
    np int
    descs List[ValDesc]
    ## `trace`: `ail run --trace` (trace.run.1-4, trace.run.6): call and return events on standard error.
    trace bool
    ## `nocontracts`: `ail run --no-contracts` (contract.run.3): no condition is evaluated.
    nocontracts bool
    ## `traceeffects`: effect, spawn and wait events (trace.run.3); `tracejson`: events as JSON objects.
    effects bool
    tjson bool
    ## `watch=NAME`: the variable whose assignments are events (`--watch`, trace.watch.1).
    watch str
    ## `probe=FILE:LINE:a|b`: the values shown at the start of a line (`--at`, `--show`, lower_probe.ail).
    probe Probe
    ## The element write of the statement being lowered that is shown with a note
    ## (trace.watch.4): `wpos` identifies the operation (the method name's or the assignment's
    ## position, line 0 for none) and `wat` is the position the event shows. `noted` is set
    ## once the event was written, so `instr_after` does not write it twice.
    wpos ast.Pos
    wat ast.Pos
    noted bool
    ids Map[str, int]
    sites List[str]
    started Set[str]

## `NAME` of the `watch=NAME` mode, or "".
fn watch_name(modes str) str
    for m in modes.split(",")
        if m.starts_with("watch=")
            return m.replace("watch=", "")
    ""

## The variable an assignment target is rooted in, and where its text starts.
fn watch_root(e ast.Expr) ast.Expr
    match e
        Index(r, _, _) => watch_root(r)
        Member(r, _, _) => watch_root(r)
        _ => e

## Whether statement `s` writes one element of the watched variable (trace.watch.4): `NAME[i] = e`,
## or a method call on it. Sets `wpos` and `wat` for the lowering of the operation.
fn Lower.watch_stmt(mut self, s ast.Stmt)
    instr.noted = false
    instr.wpos = ast.Pos(line: 0, col: 0)
    if is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path)
        return
    match s
        Assign(target, _, _, pos) =>
            match target
                Index(recv, _, _) =>
                    match recv
                        Name(n, np) =>
                            if n == instr.watch
                                instr.wpos = pos
                                instr.wat = np
                        _ => instr.wpos = instr.wpos
                _ => instr.wpos = instr.wpos
        Eval(e) =>
            match e
                Method(recv, _, npos, _) =>
                    match recv
                        Name(n, _) =>
                            if n == instr.watch
                                instr.wpos = npos
                                instr.wat = npos
                        _ => instr.wpos = instr.wpos
                _ => instr.wpos = instr.wpos
        _ => instr.wpos = instr.wpos

## Whether the operation at `pos` is the one `watch_stmt` found.
fn Lower.watch_here(self, pos ast.Pos) bool
    instr.wpos.line != 0 and instr.wpos.line == pos.line and instr.wpos.col == pos.col

## What an element write adds to a watch event (trace.watch.4): `OP ELEM at LABEL AT, AT2`.
struct WNote
    kind str
    elem Val?
    label str
    at Val?
    at2 Val?

## `watch: NAME = VALUE at POS`, or as JSON, when `opened` (the runtime's answer for the event
## budget): `frame` is the function that wrote and `via` the name it holds the variable under,
## each empty for none (trace.watch.1-4). Text and JSON follow the interpreter's.
fn Lower.watch_event(mut self, opened int, r Val, pos ast.Pos, frame str, via str, note WNote?)
    on := new_block()
    cont := new_block()
    branch(opened, on, [], cont, [])
    seal(on)
    cur = on
    if instr.tjson
        say("\{\"api\":1,\"trace\":\"watch\",\"name\":\"{jq(instr.watch)}\",\"value\":\"")
        watch_value(r, pos)
        say("\"")
        if frame != ""
            say(",\"frame\":\"{jq(frame)}\"")
        if via != ""
            say(",\"via\":\"{jq(via)}\"")
        if n := note
            say(",\"op\":\"{n.kind}\"")
            if e := n.elem
                say(",\"element\":\"")
                watch_value(e, pos)
                say("\"")
            if a := n.at
                say(",\"{n.label}\":\"")
                watch_value(a, pos)
                if b := n.at2
                    say(", ")
                    watch_value(b, pos)
                say("\"")
        say(",{trace_at(pos)}")
        say("}\n")
    else
        say("watch: {instr.watch} = ")
        describe(r, pos)
        say(" at {trace_at(pos)}")
        if frame != ""
            say(" in {frame}")
        if via != ""
            say(" (as `{via}`)")
        if n := note
            say(" [{n.kind}")
            if e := n.elem
                say(" ")
                describe(e, pos)
            if a := n.at
                say(" at {n.label} ")
                describe(a, pos)
                if b := n.at2
                    say(", ")
                    describe(b, pos)
            say("]")
        say("\n")
    call("rt.watch_close", [], Ty.Unit)
    jump(cont, [])
    seal(cont)
    cur = cont

## A value of a JSON watch event: escaped as the inside of a string, cut at 1000 bytes.
fn Lower.watch_value(mut self, v Val, pos ast.Pos)
    call("rt.tr_mark", [], Ty.Unit)
    describe(v, pos)
    call("rt.tr_vend_long", [], Ty.Unit)

## The element write of the watched statement at `pos` on `r` (trace.watch.4), written when `when`
## (a Bool value; -1 for always) holds.
fn Lower.watch_note_if(mut self, pos ast.Pos, when int, r Val, note WNote)
    if not watch_here(pos) or not vals_printable(r.ty, structs)
        return
    yes := new_block()
    join := new_block()
    if when >= 0
        branch(when, yes, [], join, [])
    else
        jump(yes, [])
    seal(yes)
    cur = yes
    watch_event(call("rt.watch_open", [], Ty.Bool), r, instr.wat, "", "", note)
    instr.noted = true
    jump(join, [])
    seal(join)
    cur = join

## `watch_note_if` for a write that always happens.
fn Lower.watch_note(mut self, pos ast.Pos, r Val, kind str, elem Val, label str, at Val)
    watch_note_if(pos, 0 - 1, r, WNote(kind: kind, elem: elem, label: label, at: at, at2: none))

## An element write with no element, such as `reverse`.
fn Lower.watch_plain(mut self, pos ast.Pos, r Val, kind str)
    watch_note_if(pos, 0 - 1, r, WNote(kind: kind, elem: none, label: "", at: none, at2: none))

## After the statement `s`, an assignment to the watched variable is an event:
## `watch: NAME = VALUE at LINE:COL`, on standard error (trace.watch.1, trace.watch.5).
fn Lower.instr_after(mut self, s ast.Stmt)
    if instr.watch == "" or is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path)
        return
    mut pos := ast.Pos(line: 0, col: 0)
    mut rn := ""
    match s
        Let(n, p, m, _, _) =>
            if n == instr.watch and m
                pos = p
                rn = n
        Assign(target, _, _, _) =>
            r := watch_root(target)
            match r
                Name(n, p) =>
                    pos = p
                    rn = n
                _ => pos = pos
        _ => pos = pos
    if pos.line == 0 or instr.noted
        return
    key := lookup(rn) else return
    ty := var_ty.get(key) else return
    if not vals_printable(ty, structs)
        return
    # A `mut` parameter follows the watched variable only while the call passed it (trace.watch.3).
    object := facts.mut_ptr.get("{fname}|{key}") else 0 - 1
    if object < 0 and rn != instr.watch
        return
    if object < 0 and watch_object(ty)
        call("rt.watch_set", [read_var(key, cur)], Ty.Unit)
    mut opened := 0
    mut frame := ""
    mut via := ""
    if object >= 0
        opened = call("rt.watch_open_alias", [object], Ty.Bool)
        frame = plain_name(fname)
        if rn != instr.watch
            via = rn
    else
        opened = call("rt.watch_open", [], Ty.Bool)
        if instr.tjson
            frame = plain_name(fname)
    watch_event(opened, Val(id: read_var(key, cur), ty: ty), pos, frame, via, none)

## Whether a value of type `t` is one object a callee can reach through a `mut` parameter.
fn watch_object(t Ty) bool
    match t
        Struct(_) | List(_) | Map(_, _) | Set(_) => true
        _ => false

## Before a call with scalar cells: the cell the watched variable is passed in is the one a callee
## follows (trace.watch.3). `instr_watch_cells_end` clears it after the call.
fn Lower.instr_watch_cells(mut self, cells List[Cell])
    if instr.watch == "" or is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path)
        return
    wk := lookup(instr.watch) else return
    for c in cells
        if c.key == wk
            call("rt.watch_set", [c.cell], Ty.Unit)

fn Lower.instr_watch_cells_end(mut self, cells List[Cell])
    if instr.watch == "" or is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path)
        return
    wk := lookup(instr.watch) else return
    for c in cells
        if c.key == wk
            call("rt.watch_set", [konst(0, Ty.Int)], Ty.Unit)

## A name in scope, with its declaration number.
struct Pair
    n int
    key str
    name str

## How many names a spill holds.
VALS_SLOTS := 32

fn new_instr() Instr
    modes := env.get("AIL_INSTRUMENT") else ""
    Instr(
        on: modes.split(",").contains("lines"),
        calls: modes.split(",").contains("calls") or modes.split(",").contains("tests"),
        tests: modes.split(",").contains("tests"),
        rec: modes.split(",").contains("record"),
        steps: modes.split(",").contains("steps"),
        vals: modes.split(",").contains("values") or modes.split(",").contains("verbose"),
        verbose: modes.split(",").contains("verbose"),
        sp: -1,
        owner: "",
        np: 0,
        descs: [],
        trace: modes.split(",").contains("trace"),
        nocontracts: modes.split(",").contains("nocontracts"),
        effects: modes.split(",").contains("traceeffects"),
        tjson: modes.split(",").contains("tracejson"),
        watch: watch_name(modes),
        probe: probe_spec(modes),
        wpos: ast.Pos(line: 0, col: 0),
        wat: ast.Pos(line: 0, col: 0),
        noted: false,
        ids: {},
        sites: [],
        started: Set[str](),
    )

## A file the program owns: not the prelude, a generated file or the std.
fn instr_owned(p str) bool
    not p.starts_with("<")
        and not p.starts_with("gen:")
        and not p.starts_with("std/")
        and not p.contains("/std/")

## The start of statement `s` is a site.
fn Lower.instr_stmt(mut self, s ast.Stmt)
    if instr.watch != ""
        watch_stmt(s)
    probe_stmt(s)
    if instr.sp >= 0 and instr.owner == fname
        vals_spill()
    if not (instr.on or instr.steps)
        or is_rt
        or unchecked
        or fname.ends_with(".nc")
        or not instr_owned(path)
        return
    line := instr_line(s)
    if instr.steps
        col := instr_col(s)
        call("rt.instr_step", [str_value(path), konst(line, Ty.Int), konst(col, Ty.Int)], Ty.Unit)
    if not instr.on
        return
    key := "{path}:{line}"
    id := instr.ids.get(key) else instr.sites.len()
    first := not instr.started.contains(fname)
    if id == instr.sites.len()
        instr.ids[key] = id
        instr.sites.push("{id}\t{path}\t{line}\t{fname}\t{if first then 1 else 0}")
    elif first
        instr.sites.push("{id}\t{path}\t{line}\t{fname}\t1")
    instr.started.add(fname)
    call("rt.instr_hit", [konst(id, Ty.Int)], Ty.Unit)

## The start of function `f`, whose parameters `params` hold (with `self` first for a method):
## a call event with the arguments that are numbers, `bool`s or `str`s (rt/native/instr.ail).
fn Lower.instr_call(mut self, f ast.FnDecl, tys List[Ty], params List[int])
    if instr.tests and (fname == "main" or fname.starts_with("ail_"))
        return
    if instr.vals and not (is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path))
        enter := if instr.verbose then "rt.vals_enter_verbose" else "rt.vals_enter"
        instr.sp = call(enter, [], Ty.Int)
        instr.owner = fname
        instr.np = nvars
    if instr.trace and not (is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path))
        trace_call(f, tys, params)
        trace_requires(f, fname)
    if not instr.calls or is_rt or unchecked or fname.ends_with(".nc") or not instr_owned(path)
        return
    call(
        "rt.instr_call",
        [str_value(fname), konst(f.pos.line, Ty.Int), konst(f.pos.col, Ty.Int)],
        Ty.Unit,
    )
    mut labels := List[str]()
    if f.receiver != none
        labels.push("self")
    for p in f.params
        labels.push(p.name)
    for i in 0..params.len().min(labels.len())
        helper := match tys[i]
            Int | Char | Byte => "int"
            Bool => "bool"
            Str => "str"
            _ => ""
        if helper != ""
            call("rt.instr_arg_{helper}", [str_value(labels[i]), params[i]], Ty.Unit)
    call("rt.instr_call_end", [], Ty.Unit)

## Whether a describer can print a value of type `t`.
fn vals_printable(t Ty, structs Map[str, List[Slot]]) bool
    match t
        Int | Float | Bool | Str | Char | Enum(_) => true
        Map(k, v) => vals_printable(k, structs) and vals_printable(v, structs)
        Struct(n) =>
            slots := structs.get(n) else return false
            for sl in slots
                if not vals_printable(sl.ty, structs)
                    return false
            true
        List(e) => vals_printable(e, structs)
        _ => false

## The start of a statement of a function with a spill: store the describer for the names in
## scope, and their values.
fn Lower.vals_spill(mut self)
    mut best := Map[str, str]()
    for sc in scopes
        for name in sc.keys()
            best[name] = sc[name]
    mut order := List[Pair]()
    for name in best.keys()
        if name == "_" or name.contains(" ") or name.contains("$") or name.contains(".")
            continue
        key := best[name]
        ty := var_ty.get(key) else continue
        if not vals_printable(ty, structs)
            continue
        n := key.split("#")[1].to_int() else 0
        mut at := order.len()
        while at > 0 and order[at - 1].n > n
            at -= 1
        order.insert(at, Pair(n: n, key: key, name: name))
    mut d := ValDesc(names: [], tys: [], np: 0)
    for o in order
        if d.names.len() >= VALS_SLOTS
            break
        if o.n <= instr.np
            d.np += 1
        d.names.push(o.name)
        d.tys.push(var_ty[o.key])
    id := instr.descs.len()
    instr.descs.push(d)
    mut a := inst(-1, "fnaddr", [])
    a.name = "vd.{id}"
    store(instr.sp, 0, emit(a, Ty.Int))
    for k in 0..d.names.len()
        store(instr.sp, k + 1, read_var(order[k].key, cur))

## Before each `return` of a function with a spill: drop it from the table; of a traced one: the
## return event.
fn Lower.instr_end(mut self)
    if instr.owner != fname
        return
    if instr.trace
        instr.owner = ""
        trace_returns()
    if instr.sp < 0
        return
    instr.sp = -1
    for b in 0..blocks.len()
        if blocks[b].term.kind == "return"
            cur = b
            call("rt.vals_leave", [], Ty.Unit)

## A value in an event: cut to 60 bytes, escaped in JSON (trace.val.1-2).
fn Lower.trace_value(mut self, v Val, pos ast.Pos)
    call("rt.tr_mark", [], Ty.Unit)
    describe(v, pos)
    call("rt.tr_vend", [], Ty.Unit)

## `s` as the inside of a JSON string.
fn jq(s str) str
    s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")

## Where `pos` is: `LINE:COL`, or `FILE:LINE:COL` outside the first file; as JSON `"line":L,"col":C`.
fn Lower.trace_at(self, pos ast.Pos) str
    if instr.tjson
        f := if file == 0 then "" else "\"file\":\"{jq(src_paths[file])}\","
        return "{f}\"line\":{pos.line},\"col\":{pos.col}"
    root := if file == 0 then "" else "{src_paths[file]}:"
    "{root}{pos.line}:{pos.col}"

## `trace: call NAME(a = 1) at LINE:COL`, on standard error (trace.run.2).
fn Lower.trace_call(mut self, f ast.FnDecl, tys List[Ty], params List[int])
    instr.owner = fname
    call("rt.tr_call_open", [], Ty.Unit)
    mut labels := List[str]()
    if f.receiver != none
        labels.push("self")
    for p in f.params
        labels.push(p.name)
    mut first := true
    if instr.tjson
        say("\{\"api\":1,\"trace\":\"call\",\"fn\":\"{plain_name(fname)}\",\"depth\":")
        call("rt.tr_depth_out", [], Ty.Unit)
        say(",\"args\":\{")
    else
        say("call {plain_name(fname)}(")
    for i in 0..params.len().min(labels.len())
        if not vals_printable(tys[i], structs)
            continue
        if not first
            say(if instr.tjson then "," else ", ")
        first = false
        if instr.tjson
            say("\"{labels[i]}\":\"")
            trace_value(Val(id: params[i], ty: tys[i]), f.pos)
            say("\"")
        else
            say("{labels[i]} = ")
            trace_value(Val(id: params[i], ty: tys[i]), f.pos)
    say(if instr.tjson then "}," else ") at ")
    call("rt.tr_site", [konst(f.pos.line, Ty.Int), konst(f.pos.col, Ty.Int)], Ty.Unit)
    say(if instr.tjson then "}\n" else "\n")
    call("rt.tr_close", [], Ty.Unit)

## Before each `return` of a traced function: `trace: NAME returned VALUE`. Only values
## that print without a loop are shown; a list or map shows as `…`.
fn Lower.trace_returns(mut self)
    for b in 0..blocks.len()
        t := blocks[b].term
        if t.kind != "return"
            continue
        cur = b
        call("rt.tr_ret_open", [], Ty.Unit)
        if instr.tjson
            say("\{\"api\":1,\"trace\":\"return\",\"fn\":\"{plain_name(fname)}\",\"depth\":")
            call("rt.tr_depth_out", [], Ty.Unit)
            say(",\"value\":\"")
        else
            say("{plain_name(fname)} returned ")
        if t.value < 0 or ret.is_unit()
            say("()")
        elif flat_printable(ret, structs)
            trace_value(Val(id: t.value, ty: ret), ast.Pos(line: 1, col: 1))
        else
            say("…")
        say(if instr.tjson then "\"}\n" else "\n")
        call("rt.tr_ret_done", [], Ty.Unit)

## trace.run.3: `trace: effect fs.read_text("x") at L:C`, before the call `rt` (`rt.fs_read_text`)
## of the OS module runs with the values `vs`.
fn Lower.trace_effect(mut self, rtname str, tys List[Ty], vs List[int], pos ast.Pos)
    if not instr.effects or is_rt or unchecked or not instr_owned(path)
        return
    name := rtname.slice(3, rtname.len())
    parts := name.split("_")
    if not CAPTURED.contains(parts[0])
        and parts[0] != "net"
        and parts[0] != "serve"
        and parts[0] != "open"
        return
    what := "{parts[0]}.{parts[1..].join("_")}"
    call("rt.tr_event_open", [konst(2, Ty.Int), konst(0, Ty.Int)], Ty.Unit)
    if instr.tjson
        say("\{\"api\":1,\"trace\":\"effect\",\"call\":\"{what}\",\"args\":[")
    else
        say("effect {what}(")
    for i in 0..vs.len().min(tys.len())
        if i > 0
            say(if instr.tjson then "," else ", ")
        if instr.tjson
            say("\"")
        if vals_printable(tys[i], structs)
            trace_value(Val(id: vs[i], ty: tys[i]), pos)
        else
            say("…")
        if instr.tjson
            say("\"")
    say(if instr.tjson then "]," else ") at ")
    say(trace_at(pos))
    say(if instr.tjson then "}\n" else "\n")
    call("rt.tr_close", [], Ty.Unit)

## trace.run.3: `trace: spawn NAME(args) at L:C` before the task starts, `wait Task#N` when it is waited.
fn Lower.trace_spawn(mut self, key str, tys List[Ty], vs List[int], rec int, pos ast.Pos)
    if not instr.effects or is_rt or unchecked or not instr_owned(path)
        return
    call("rt.tr_task_new", [rec], Ty.Unit)
    call("rt.tr_event_open", [konst(3, Ty.Int), konst(0, Ty.Int)], Ty.Unit)
    if instr.tjson
        say("\{\"api\":1,\"trace\":\"spawn\",\"task\":\"{plain_name(key)}(")
    else
        say("spawn {plain_name(key)}(")
    for i in 0..vs.len().min(tys.len())
        if i > 0
            say(", ")
        if vals_printable(tys[i], structs)
            trace_value(Val(id: vs[i], ty: tys[i]), pos)
        else
            say("…")
    say(if instr.tjson then ")\"," else ") at ")
    say(trace_at(pos))
    say(if instr.tjson then "}\n" else "\n")
    call("rt.tr_close", [], Ty.Unit)

fn Lower.trace_wait(mut self, rec int, pos ast.Pos)
    if not instr.effects or is_rt or unchecked or not instr_owned(path)
        return
    call("rt.tr_event_open", [konst(4, Ty.Int), konst(0, Ty.Int)], Ty.Unit)
    say(if instr.tjson then "\{\"api\":1,\"trace\":\"wait\",\"task\":\"Task#" else "wait Task#")
    call("rt.tr_task_no", [rec], Ty.Unit)
    say(if instr.tjson then "\"," else " at ")
    say(trace_at(pos))
    say(if instr.tjson then "}\n" else "\n")
    call("rt.tr_close", [], Ty.Unit)

## trace.run.3: `trace: contract NAME requires `COND`: held` for a condition just evaluated to `v`.
fn Lower.trace_contract(mut self, label str, kind str, c ast.Contract, v int)
    if not instr.trace or is_rt or not instr_owned(path)
        return
    call("rt.tr_event_open", [konst(5, Ty.Int), konst(1, Ty.Int)], Ty.Unit)
    if instr.tjson
        say("\{\"api\":1,\"trace\":\"contract\",\"fn\":\"{plain_name(label)}\",\"kind\":\"{kind}\",\"cond\":\"{jq(c.text)}\",\"held\":")
        call("rt.tr_verdict", [v], Ty.Unit)
        say(",")
        say(trace_at(c.pos))
        say("}\n")
    else
        say("contract {plain_name(label)} {kind} `{c.text}`: ")
        call("rt.tr_verdict", [v], Ty.Unit)
        say("\n")
    call("rt.tr_close", [], Ty.Unit)

fn flat_printable(t Ty, structs Map[str, List[Slot]]) bool
    match t
        Int | Float | Bool | Str | Char | Enum(_) => true
        Struct(n) =>
            slots := structs.get(n) else return false
            for sl in slots
                if not flat_printable(sl.ty, structs)
                    return false
            true
        _ => false

## The `vd.N` describers: print `(a = 1, b = 2); c = 3`.
fn Lower.gen_describers(mut self)
    mut n := 0
    while n < instr.descs.len()
        d := instr.descs[n]
        x := begin_fn("vd.{n}", Ty.Unit, [Ty.Int])[0]
        pos := ast.Pos(line: 1, col: 1)
        say("(")
        for k in 0..d.np
            if k > 0
                say(", ")
            say("{d.names[k]} = ")
            describe(Val(id: load(x, k + 1, d.tys[k]), ty: d.tys[k]), pos)
        say(")")
        for k in d.np..d.names.len()
            if instr.verbose
                say("\n      ")
            else
                say(if k == d.np then "; " else ", ")
            say("{d.names[k]} = ")
            describe(Val(id: load(x, k + 1, d.tys[k]), ty: d.tys[k]), pos)
        finish(return_of(-1))
        end_fn("vd.{n}", pos)
        n += 1

## Write the site table.
fn Lower.instr_finish(mut self)
    gen_describers()
    out := env.get("AIL_INSTRUMENT_SITES") else ""
    if instr.on and out != ""
        fs.write_text(out, "{instr.sites.join("\n")}\n") else err
            problem(ast.Pos(line: 1, col: 1), "can't write {out}")

fn instr_line(s ast.Stmt) int
    match s
        Let(_, pos, _, _, _) => pos.line
        Assign(_, _, _, pos) => pos.line
        While(_, _, pos) => pos.line
        For(_, _, _, _, _, _, pos) => pos.line
        Break(pos, _) => pos.line
        Continue(pos, _) => pos.line
        Return(_, pos) => pos.line
        Eval(value) => expr_pos(value).line
        Handle(value, _) => expr_pos(value).line
        Defer(_, pos) => pos.line
        With(_, _, _, _, pos) => pos.line
        Unsafe(_, pos) => pos.line
        LetTuple(_, _, pos) => pos.line
        LocalFn(d) => d.pos.line
        Select(_, pos) => pos.line

fn instr_col(s ast.Stmt) int
    match s
        Let(_, pos, _, _, _) => pos.col
        Assign(_, _, _, pos) => pos.col
        While(_, _, pos) => pos.col
        For(_, _, _, _, _, _, pos) => pos.col
        Break(pos, _) => pos.col
        Continue(pos, _) => pos.col
        Return(_, pos) => pos.col
        Eval(value) => expr_pos(value).col
        Handle(value, _) => expr_pos(value).col
        Defer(_, pos) => pos.col
        With(_, _, _, _, pos) => pos.col
        Unsafe(_, pos) => pos.col
        LetTuple(_, _, pos) => pos.col
        LocalFn(d) => d.pos.col
        Select(_, pos) => pos.col
