## `for b in bs` over a `bytes` walks the bytes in place: no list of them is
## built for the loop (expr.loop.3, ADR 0907, ADR 1188). The loop keeps an
## index and loads one byte a turn. The caller has checked that the body
## cannot change the bytes it walks (`mutates`); a loop whose body can, or
## whose variable is `mut`, walks a list of the bytes as before.
use ast

## Lower the loop over the `bytes` value `b` in the scope `lower_for` opened;
## false (nothing emitted) when `b` is not a `bytes` or the variable is `mut`.
fn Lower.bytes_walk(mut self, var str, b Val, body List[ast.Stmt], mutable bool, fpos ast.Pos) bool
    if mutable or b.ty != Ty.Bytes
        return false
    n := self.op("len", [b.id], Ty.Int)
    base := self.op("add", [self.rawop("str_addr", [b.id], Ty.Int), self.konst(16, Ty.Int)], Ty.Int)
    self.nvars += 1
    ikey := "#i{self.nvars}"
    self.var_ty[ikey] = Ty.Int
    self.write_var(ikey, self.cur, self.konst(0, Ty.Int))
    head := self.new_block()
    self.jump(head, [])
    self.cur = head
    i := self.read_var(ikey, head)
    c := self.op("lt", [i, n], Ty.Bool)
    inner := self.new_block()
    exit := self.new_block()
    latch := self.new_block()
    self.branch(c, inner, [], exit, [])
    self.seal(inner)
    self.cur = inner
    byte := self.rawop("load8", [self.op("add", [base, i], Ty.Int)], Ty.Int)
    self.declare(var, Ty.Sized("u8"), byte)
    self.loops.push(Loop(cont: latch, exit: exit, at: fpos))
    self.lower_block(body, false)
    self.loops.pop()
    self.jump(latch, [])
    self.seal(latch)
    self.cur = latch
    j := self.read_var(ikey, latch)
    self.write_var(ikey, self.cur, self.op("add", [j, self.konst(1, Ty.Int)], Ty.Int))
    self.jump(head, [])
    self.seal(head)
    self.seal(exit)
    self.cur = exit
    self.scopes.pop()
    true
