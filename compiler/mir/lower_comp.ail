## List comprehensions in the native subset (ADR 0532): `[e for x in xs if
## c]` is lowered as the loops it means, pushing onto a new list, so it
## gets the `for` loop's code (ranges, lists, `break`-free) and `push`'s
## fast path.
use ast

fn is_set_ty(t Ty) bool
    match t
        Set(_) => true
        _ => false

fn is_map_ty(t Ty) bool
    match t
        Map(_, _) => true
        _ => false

## `body` inside the comprehension's `for` loops and `if` tests.
fn comp_loops(inner List[ast.Stmt], clauses List[ast.CompFor], pos ast.Pos) List[ast.Stmt]
    mut body := inner
    mut k := clauses.len() - 1
    while k >= 0
        c := clauses[k]
        if cond := c.cond
            br := ast.Branch(cond: ast.Cond.Test(value: cond), body: body)
            body = [ast.Stmt.Eval(value: ast.Expr.If(
                branches: [br],
                els: none,
                else_err: none,
                pos: pos,
            ))]
        if c.unpack.len() > 0
            # `for a, b in xs` takes each element apart first (type.tuple.5).
            mut unpacked := [ast.Stmt.LetTuple(
                names: c.unpack,
                value: ast.Expr.Name(name: c.var, pos: pos),
                pos: pos,
            )]
            unpacked.extend(body)
            body = unpacked
        # `[e par for x in xs]` builds its list on the pool (conc.par.12, conc.par.16).
        body = [ast.Stmt.For(
            is_par: c.is_par and clauses.len() == 1 and c.cond == none and c.unpack.len() == 0,
            var: c.var,
            var_pos: c.var_pos,
            mutable: false,
            iter: c.iter,
            body: body,
            pos: pos,
        )]
        k -= 1
    body

fn Lower.lower_comp(
    mut self,
    form ast.CompKind,
    elem ast.Expr,
    value_expr ast.Expr?,
    clauses List[ast.CompFor],
    pos ast.Pos,
    want Ty?,
) Val?
    if form == ast.CompKind.ListComp
        if v := self.try_gpu_comp(elem, clauses, pos, want)
            return v
    nvars += 1
    name := "#comp{nvars}"
    me := ast.Expr.Name(name: name, pos: pos)
    mut push := ast.Stmt.Eval(value: ast.Expr.Method(recv: me, name: "push", name_pos: pos, args: [
        ast.Arg(label: none, mutable: false, moved: false, value: elem, param: none),
    ]))
    match form
        ListComp =>
            mut et := Ty.Unknown
            if w := want
                et = w.elem() else Ty.Unknown
            t := Ty.List(et)
            declare(name, t, call("rt.list_new", [konst(0, Ty.Int)], t))
        SetComp =>
            known := want else return self.lower_comp_untyped(form, elem, value_expr, clauses, pos)
            t := known
            if not is_set_ty(t)
                return self.lower_comp_untyped(form, elem, value_expr, clauses, pos)
            declare(name, t, new_table(t))
            push = ast.Stmt.Eval(value: ast.Expr.Method(
                recv: me,
                name: "add",
                name_pos: pos,
                args: [ast.Arg(label: none, mutable: false, moved: false, value: elem, param: none)],
            ))
        MapComp =>
            v := value_expr else return none
            known := want else return self.lower_comp_untyped(form, elem, value_expr, clauses, pos)
            t := known
            if not is_map_ty(t)
                return self.lower_comp_untyped(form, elem, value_expr, clauses, pos)
            declare(name, t, new_table(t))
            push = ast.Stmt.Assign(
                target: ast.Expr.Index(recv: me, index: elem, pos: pos),
                op: none,
                value: v,
                pos: pos,
            )
    body := comp_loops([push], clauses, pos)
    lower_stmt(body[0])
    key := lookup(name) else return none
    if form == ast.CompKind.ListComp
        and (var_ty[key].elem() == none or (var_ty[key].elem() else Ty.Unknown).is_unknown())
        # An earlier problem in this function (an unsupported call whose result
        # is untyped) is the cause; report that one alone.
        if problems.len() > fn_problems
            return none
        return unsupported(pos, "a comprehension whose element type isn't known")
    Val(id: read_var(key, cur), ty: var_ty[key])

## A set or map comprehension whose type isn't given: the elements (and the
## values) are collected in lists, whose element types the loop finds, and the
## table is built from them.
fn Lower.lower_comp_untyped(
    mut self,
    form ast.CompKind,
    elem ast.Expr,
    value_expr ast.Expr?,
    clauses List[ast.CompFor],
    pos ast.Pos,
) Val?
    what := if form == ast.CompKind.SetComp then "a set" else "a map"
    if form == ast.CompKind.SetComp
        xs := self.lower_comp(ast.CompKind.ListComp, elem, none, clauses, pos, none)?
        e := xs.ty.elem() else Ty.Unknown
        if not key_ok(e)
            return unsupported(pos, "{what} comprehension whose type isn't known")
        words := words_of(xs, e)
        return Val(id: call("rt.set_from_list", [kind_val(e), words], Ty.Set(e)), ty: Ty.Set(e))
    v := value_expr else return none
    nvars += 1
    kname := "#comp{nvars}"
    comp_var := "#comp{nvars}v"
    mname := "#comp{nvars}m"
    ks := ast.Expr.Name(name: kname, pos: pos)
    vs := ast.Expr.Name(name: comp_var, pos: pos)
    push_k := ast.Stmt.Eval(value: ast.Expr.Method(recv: ks, name: "push", name_pos: pos, args: [
        ast.Arg(label: none, mutable: false, moved: false, value: elem, param: none),
    ]))
    push_v := ast.Stmt.Eval(value: ast.Expr.Method(recv: vs, name: "push", name_pos: pos, args: [
        ast.Arg(label: none, mutable: false, moved: false, value: v, param: none),
    ]))
    declare(kname, Ty.List(Ty.Unknown), call(
        "rt.list_new",
        [konst(0, Ty.Int)],
        Ty.List(Ty.Unknown),
    ))
    declare(comp_var, Ty.List(Ty.Unknown), call(
        "rt.list_new",
        [konst(0, Ty.Int)],
        Ty.List(Ty.Unknown),
    ))
    lower_stmt(comp_loops([push_k, push_v], clauses, pos)[0])
    kkey := lookup(kname)?
    vkey := lookup(comp_var)?
    kt := var_ty[kkey].elem() else Ty.Unknown
    vt := var_ty[vkey].elem() else Ty.Unknown
    if not key_ok(kt) or not is_value_ty(vt)
        return unsupported(pos, "{what} comprehension whose type isn't known")
    t := Ty.Map(key: kt, val: vt)
    declare(mname, t, keyed_table(t))
    me := ast.Expr.Name(name: mname, pos: pos)
    zero := ast.Expr.Int(value: "0", pos: pos)
    at := ast.Expr.Name(name: "#i", pos: pos)
    n := ast.Expr.Method(recv: ks, name: "len", name_pos: pos, args: [])
    fill := ast.Stmt.Assign(
        target: ast.Expr.Index(
            recv: me,
            index: ast.Expr.Index(recv: ks, index: at, pos: pos),
            pos: pos,
        ),
        op: none,
        value: ast.Expr.Index(recv: vs, index: at, pos: pos),
        pos: pos,
    )
    lower_stmt(ast.Stmt.For(
        is_par: false,
        var: "#i",
        var_pos: pos,
        mutable: false,
        iter: ast.Expr.Range(lo: zero, hi: n, inclusive: false, pos: pos),
        body: [fill],
        pos: pos,
    ))
    mkey := lookup(mname)?
    Val(id: read_var(mkey, cur), ty: var_ty[mkey])

## `xs[a..b]`, `xs[a..=b]`, `xs[a..]`, `xs[..b]`: a new list, after a check
## that traps as the interpreter does (type.coll.4, ADR 0532).
fn Lower.lower_slice(mut self, l Val, lo ast.Expr?, hi ast.Expr?, inclusive bool, rpos ast.Pos) Val?
    elem := l.ty.elem() else return none
    n := op("len", [l.id], Ty.Int)
    zero := konst(0, Ty.Int)
    mut a := zero
    if x := lo
        a = lower_value(x, Ty.Int)?.id
    mut b := n
    mut end := n
    if y := hi
        b = lower_value(y, Ty.Int)?.id
        end = b
        if inclusive
            # Wraps only for the largest `int`, which the check below rejects.
            end = op("add", [b, konst(1, Ty.Int)], Ty.Int)
    fail := new_block()
    self.check(op("le", [zero, a], Ty.Bool), fail)
    if inclusive and hi != none
        self.check(op("ne", [b, konst(9223372036854775807, Ty.Int)], Ty.Bool), fail)
    self.check(op("le", [a, end], Ty.Bool), fail)
    self.check(op("le", [end, n], Ty.Bool), fail)
    good := cur
    seal(fail)
    cur = fail
    call("rt.note_len", [n], Ty.Unit)
    dots := if inclusive and hi != none then "..=" else ".."
    mut t := inst(-1, "trap", [a, b])
    t.imm = 7
    t.name = dots
    t.site = site("type.coll.4", "slice", dots, rpos)
    emit_void(t)
    finish(unreachable_term())
    cur = good
    size := konst(elem.elem_bytes(), Ty.Int)
    v := Val(id: call("rt.list_slice", [l.id, a, end, size], l.ty), ty: l.ty)
    if needs_copy(elem)
        return Val(id: copy_value(v), ty: l.ty)
    v

## Continue in a new block when `c` holds; otherwise go to `fail`.
fn Lower.check(mut self, c int, fail int)
    next := new_block()
    branch(c, next, [], fail, [])
    seal(next)
    cur = next
