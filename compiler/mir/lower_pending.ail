## Empty `[]` and `{}` typed by later use (type.coll.13). A local declared
## from `{}` with no expected type is made as a table whose kinds are
## placeholders (key kind -1); its first `m[k] = v`, `m[k] op= v`,
## `m.add(x)` or `m = e` gives the type. The kinds of the `rt.map_new` that
## made it are then patched and every value of its variable is retyped, as
## `push` does for a `[]` (`Lower.retype`). Any other use first is reported.
use ast

## A `{}` with no expected type: `Map[?, ?]` until a use settles it.
fn Lower.pending_table(mut self) Val
    t := Ty.Map(key: Ty.Unknown, val: Ty.Unknown)
    args := [konst(-1, Ty.Int), konst(0, Ty.Int), konst(0, Ty.Int)]
    Val(id: call("rt.map_new", args, t), ty: t)

fn is_pending_table(t Ty) bool
    match t
        Map(k, _) => k.is_unknown()
        _ => false

## A `[]` or `{}` whose type a later use still has to give.
fn is_pending_coll(t Ty) bool
    if e := t.elem()
        return e.is_unknown()
    is_pending_table(t)

## The variable that has had the value `v`.
fn Lower.var_of(self, v int) str?
    for key in var_vals.keys()
        if var_vals[key].contains(v)
            return key
    none

## Give the pending value `v` (and every value of its variable) the type
## `t`; a table made by `pending_table` gets the kinds of `t`.
fn Lower.settle_pending(mut self, v int, t Ty)
    key := self.var_of(v) else
        vals[v] = t
        return
    for x in var_vals[key]
        self.patch_table(x, t)
    var_ty[key] = t
    for x in var_vals[key]
        vals[x] = t

## Patch the kinds of the `rt.map_new` that made `v`, if `pending_table`
## made it, to those `new_table` gives a table of type `t`.
fn Lower.patch_table(mut self, v int, t Ty)
    if v < 0
        return
    mut kinds := List[int]()
    mut kt := Ty.Unknown
    match t
        Map(k, x) =>
            m := value_mode(x)
            kinds = [key_kind(k), m[0], m[1]]
            kt = k
        Set(e) =>
            kinds = [key_kind(e), 0, 0]
            kt = e
        _ => return
    for b in 0..blocks.len()
        for i in 0..blocks[b].insts.len()
            x := blocks[b].insts[i]
            if x.dst == v and x.op == "call" and x.name == "rt.map_new"
                if self.const_at(x.arg(0)) != -1
                    return
                for a in 0..3
                    self.set_const(x.arg(a), kinds[a])
                # A composite key's kind is its shape, a string (lower_keys.ail).
                if not is_key_ty(kt)
                    self.set_str(x.arg(0), shape_of(kt, []))
                return

## The value of the `const` that defines `v`, else -2.
fn Lower.const_at(self, v int) int
    for b in blocks
        for x in b.insts
            if x.dst == v and x.op == "const"
                return x.imm
    -2

fn Lower.set_str(mut self, v int, s str)
    for b in 0..blocks.len()
        for i in 0..blocks[b].insts.len()
            if blocks[b].insts[i].dst == v and blocks[b].insts[i].op == "const"
                blocks[b].insts[i].op = "str"
                blocks[b].insts[i].imm = str_lit(s)
                vals[v] = Ty.Str
                return

fn Lower.set_const(mut self, v int, n int)
    for b in 0..blocks.len()
        for i in 0..blocks[b].insts.len()
            if blocks[b].insts[i].dst == v and blocks[b].insts[i].op == "const"
                blocks[b].insts[i].imm = n
                return

## `m[k] = v` or `m[k] op= v` on a pending table: the key's and the
## value's types give its type (type.coll.13). False after a problem.
fn Lower.settle_map(mut self, m Val, kt Ty, vt Ty, pos ast.Pos) bool
    if not key_ok(kt) or not is_value_ty(vt)
        problem(pos, "not in the native subset yet: a map of `{kt.name()}` to `{vt.name()}`")
        return false
    self.settle_pending(m.id, Ty.Map(key: kt, val: vt))
    true

## `s.add(x)` on a pending table: it is a `Set` of `x`'s type.
fn Lower.settle_set_add(mut self, s Val, args List[ast.Arg], npos ast.Pos) Val?
    x := lower_value(args[0].value, none)?
    if not key_ok(x.ty)
        return unsupported(npos, "a set of `{x.ty.name()}`")
    t := Ty.Set(x.ty)
    self.settle_pending(s.id, t)
    Val(id: call("rt.map_add", [s.id, convert(x, x.ty, npos)], Ty.Bool), ty: Ty.Bool)

## `m.push(k, x)` on a pending table: it is a `Map` of `k`'s type to a
## list of `x`'s type.
fn Lower.settle_map_push(mut self, m Val, args List[ast.Arg], npos ast.Pos) Val?
    k := lower_value(args[0].value, none)?
    x := lower_value(args[1].value, none)?
    vt := Ty.List(x.ty)
    if not key_ok(k.ty) or not is_value_ty(vt)
        return unsupported(npos, "a map of `{k.ty.name()}` to `{vt.name()}`")
    t := Ty.Map(key: k.ty, val: vt)
    self.settle_pending(m.id, t)
    map_push_vals(Val(id: m.id, ty: t), vt, convert(k, k.ty, npos), x, args[1].value, npos)

## `m.get_or(k, d)` on a pending table: it is a `Map` of `k`'s type to `d`'s (ADR 1133).
fn Lower.settle_map_get_or(mut self, m Val, args List[ast.Arg], npos ast.Pos) Val?
    k := lower_value(args[0].value, none)?
    d := lower_value(args[1].value, none)?
    if not key_ok(k.ty) or not is_value_ty(d.ty)
        return unsupported(npos, "a map of `{k.ty.name()}` to `{d.ty.name()}`")
    t := Ty.Map(key: k.ty, val: d.ty)
    self.settle_pending(m.id, t)
    self.map_get_or(Val(id: m.id, ty: t), convert(k, k.ty, npos), convert(d, d.ty, npos), d.ty)

## `m.contains(k)` on a pending table, before the store that types it (ADR 1133): the key
## kinds of the `rt.map_new` are patched when the store settles the table.
fn Lower.pending_contains(mut self, m Val, args List[ast.Arg], npos ast.Pos) Val?
    k := lower_value(args[0].value, none)?
    if not is_key_ty(k.ty)
        return unsupported(npos, "`.contains(k)` on an empty `\{}` with a `{k.ty.name()}` key")
    Val(id: call("rt.map_has", [m.id, k.id], Ty.Bool), ty: Ty.Bool)

## `x = e` on a pending `[]` or `{}`: `e`'s type, when it gives one.
fn Lower.settle_coll(mut self, target ast.Expr, ty Ty, r Val) Ty
    if not is_pending_coll(ty) or is_pending_coll(r.ty) or not same_shape(ty, r.ty)
        return ty
    match target
        Name(n, _) =>
            key := lookup(n) else return ty
            for x in var_vals[key]
                self.patch_table(x, r.ty)
            var_ty[key] = r.ty
            for x in var_vals[key]
                vals[x] = r.ty
            r.ty
        _ => ty

fn same_shape(a Ty, b Ty) bool
    if a.elem() != none
        return b.elem() != none
    b.is_coll()

## A pending `[]` or `{}` passed where a collection type is expected (a
## parameter, a `mut` argument): that type settles it (type.coll.13).
fn Lower.settle_by_want(mut self, v Val, want Ty) bool
    if not is_pending_coll(v.ty) or is_pending_coll(want) or not same_shape(v.ty, want)
        return false
    ok := match want
        Map(k, _) => key_ok(k)
        Set(e) => key_ok(e)
        _ => true
    if not ok
        return false
    self.settle_pending(v.id, want)
    true
