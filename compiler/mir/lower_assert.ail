## `assert_err(call)`, `assert_err(call, Variant)` and `assert_near(a, b, eps)`
## (test.assert.3, ADR 1087). Both trap like `assert` (test.assert.1).
use ast

fn Lower.lower_assert_more(mut self, name str, args List[ast.Arg], pos ast.Pos) Val?
    if name == "assert_near"
        return lower_assert_near(args, pos)
    lower_assert_err(args, pos)

## The call must fail; with a second argument, it must fail with that error.
fn Lower.lower_assert_err(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() < 1 or args.len() > 2
        return unsupported(pos, "this call of `assert_err`")
    m := lower_maybe(args[0].value)?
    if m.opt
        return unsupported(pos, "`assert_err` of an optional")
    good := new_block()
    failure := new_block()
    branch(m.present, good, [], failure, [])
    seal(good)
    seal(failure)
    cur = good
    trap_open("test.assert.1", pos)
    say("assertion failed: expected the call to fail, but it returned a value")
    trap_close(pos)
    cur = failure
    if args.len() == 1
        call("rt.err_clear", [], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    if m.err == Ty.Unknown
        return unsupported(pos, "`assert_err` with an error whose type isn't known here")
    raw := call("rt.err_take_value", [], Ty.Int)
    got := Val(id: op("copy", [raw], m.err), ty: m.err)
    mut same := -1
    if k := bare_data_variant(args[1].value, m.err)
        # `E.V` for a variant with data: the kind alone is compared.
        en := enum_name(m.err) else ""
        same = op("eq", [tag_of(en, got.id), konst(k, Ty.Int)], Ty.Bool)
    else
        want := lower_value(args[1].value, m.err)?
        same = binary(ast.BinOp.Eq, got, want, pos).id
    ok := check_branch(same)
    trap_open("test.assert.1", pos)
    say("assertion failed: the call failed with a different error than the one expected")
    trap_close(pos)
    cur = ok
    Val(id: -1, ty: Ty.Unit)

## The index of variant `V` in `E.V` when `E` is the enum of `err` and `V` carries data.
fn Lower.bare_data_variant(self, e ast.Expr, err Ty) int?
    match e
        Member(recv, name, _) =>
            en := enum_ref(recv)?
            own := enum_name(err)?
            if own != en
                return none
            k := case_index(en, name)
            if k >= 0 and enums[en][k].fields.len() > 0
                return k
            none
        _ => none

## `|a - b| <= eps`, false when any is NaN.
fn Lower.lower_assert_near(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 3
        return unsupported(pos, "this call of `assert_near`")
    a := lower_value(args[0].value, Ty.Float)?
    b := lower_value(args[1].value, Ty.Float)?
    e := lower_value(args[2].value, Ty.Float)?
    d1 := binary(ast.BinOp.Sub, a, b, pos)
    ok1 := check_branch(binary(ast.BinOp.Le, d1, e, pos).id)
    near_trap(a, b, e, pos)
    cur = ok1
    d2 := binary(ast.BinOp.Sub, b, a, pos)
    ok2 := check_branch(binary(ast.BinOp.Le, d2, e, pos).id)
    near_trap(a, b, e, pos)
    cur = ok2
    Val(id: -1, ty: Ty.Unit)

fn Lower.near_trap(mut self, a Val, b Val, e Val, pos ast.Pos)
    trap_open("test.assert.1", pos)
    say("assertion failed: ")
    describe(a, pos)
    say(" and ")
    describe(b, pos)
    say(" differ by more than ")
    describe(e, pos)
    trap_close(pos)
