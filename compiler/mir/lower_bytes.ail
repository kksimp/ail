## Lowering `bytes` (type.bytes.*, ADR 0702): literals, `b[i]`, `b[lo..hi]`,
## `==`, the orderings, and the methods `len`, `text` and `hex`. The runtime is
## `compiler/rt/native/bytes.ail`. A byte read from a `bytes` has the type
## `Byte`, which only `.to_int()` accepts: `u8` arithmetic (it traps past 255)
## isn't in the native subset yet.
use ast

## `b"..."` (lex.bytes.1): `hex` holds the two digits of every byte.
fn Lower.lower_bytes_lit(mut self, hex str, pos ast.Pos) Val?
    Val(id: call("rt.bytes_from_hex", [str_value(hex)], Ty.Bytes), ty: Ty.Bytes)

## `b[i]` and `b[lo..hi]` (type.bytes.3, type.bytes.4).
fn Lower.bytes_index(mut self, l Val, index ast.Expr, pos ast.Pos) Val?
    if is_range(index)
        return match index
            Range(lo, hi, incl, rpos) => self.bytes_slice(l, lo, hi, incl, rpos)
            _ => none
    i := lower_value(index, Ty.Int)?
    n := op("len", [l.id], Ty.Int)
    fail := new_block()
    check(op("le", [konst(0, Ty.Int), i.id], Ty.Bool), fail)
    check(op("lt", [i.id, n], Ty.Bool), fail)
    good := cur
    seal(fail)
    cur = fail
    mut t := inst(-1, "trap", [i.id, n])
    t.imm = 12
    t.site = site("type.bytes.3", "bounds", "", pos)
    emit_void(t)
    finish(unreachable_term())
    cur = good
    Val(id: call("rt.bytes_at", [l.id, i.id], Ty.Int), ty: Ty.Sized("u8"))

fn Lower.bytes_slice(mut self, l Val, lo ast.Expr?, hi ast.Expr?, inclusive bool, rpos ast.Pos) Val?
    n := op("len", [l.id], Ty.Int)
    zero := konst(0, Ty.Int)
    mut a := zero
    if x := lo
        a = lower_value(x, Ty.Int)?.id
    mut b := n
    mut end := n
    if y := hi
        b = lower_value(y, Ty.Int)?.id
        end = b
        if inclusive
            end = op("add", [b, konst(1, Ty.Int)], Ty.Int)
    fail := new_block()
    check(op("le", [zero, a], Ty.Bool), fail)
    if inclusive and hi != none
        check(op("ne", [b, konst(9223372036854775807, Ty.Int)], Ty.Bool), fail)
    check(op("le", [a, end], Ty.Bool), fail)
    check(op("le", [end, n], Ty.Bool), fail)
    good := cur
    seal(fail)
    cur = fail
    call("rt.note_len", [n], Ty.Unit)
    dots := if inclusive and hi != none then "..=" else ".."
    mut t := inst(-1, "trap", [a, b])
    t.imm = 13
    t.name = dots
    t.site = site("type.bytes.4", "slice", dots, rpos)
    emit_void(t)
    finish(unreachable_term())
    cur = good
    Val(id: call("rt.bytes_slice", [l.id, a, end], Ty.Bytes), ty: Ty.Bytes)

## `a == b`, `a != b` and the orderings on `bytes` (type.bytes.2).
fn Lower.bytes_compare(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val
    name := op_name(o)
    if name == "add"
        return self.bytes_concat(a, b)
    if name == "lt" or name == "le" or name == "gt" or name == "ge"
        # Byte-wise order, shorter first when one is a prefix (type.bytes.2).
        c := call("rt.bytes_cmp", [a.id, b.id], Ty.Int)
        return Val(id: op(name, [c, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
    if name != "eq" and name != "ne"
        problem(pos, "`{op_symbol(o)}` on `bytes` isn't in the native subset yet")
        return a
    same := call("rt.bytes_eq", [a.id, b.id], Ty.Bool)
    if name == "eq"
        return Val(id: same, ty: Ty.Bool)
    Val(id: op("not", [same], Ty.Bool), ty: Ty.Bool)

## `a + b` on `bytes` (type.bytes.6).
fn Lower.bytes_concat(mut self, a Val, b Val) Val
    Val(id: call("rt.bytes_concat", [a.id, b.id], Ty.Bytes), ty: Ty.Bytes)

## `bytes.from_hex(s)` and `bytes.from_base64(s)` are in `lower_os.ail`'s table.

## A method of `bytes`, or of a byte (`to_int`).
fn Lower.bytes_method(mut self, r Val, name str, vs List[Val], npos ast.Pos) Val?
    nargs := vs.len()
    if r.ty == Ty.Byte
        if name == "to_int" and nargs == 0
            return Val(id: r.id, ty: Ty.Int)
        return unsupported(npos, "`.{name}()` on `u8`")
    if bytesint_read_name(name)
        return self.bytesint_read(r, name, vs, npos)
    if nargs == 0
        if name == "len"
            return Val(id: op("len", [r.id], Ty.Int), ty: Ty.Int)
        if name == "text"
            return Val(id: call("rt.bytes_text", [r.id], Ty.Str), ty: Ty.Str)
        if name == "hex"
            return Val(id: call("rt.bytes_hex", [r.id], Ty.Str), ty: Ty.Str)
        if name == "to_list"
            t := Ty.List(Ty.Sized("u8"))
            return Val(id: call("rt.bytes_list", [r.id], t), ty: t)
        if name == "base64"
            return Val(id: call("rt.bytes_base64", [r.id], Ty.Str), ty: Ty.Str)
        if name == "to_list"
            t := Ty.List(Ty.Sized("u8"))
            return Val(id: call("rt.bytes_list", [r.id], t), ty: t)
        if name == "to_str"
            t := Ty.Opt(Ty.Str)
            return Val(id: call("rt.bytes_to_str", [r.id], t), ty: t)
    if nargs == 1 and (name == "dot_i8" or name == "dot_u8i8") and vs[0].ty == Ty.Bytes
        return self.bdot_whole_call(r, vs[0], name, npos)
    if nargs == 1 and name == "hex" and vs[0].ty == Ty.Str
        return Val(id: call("rt.bytes_hex_sep", [r.id, vs[0].id], Ty.Str), ty: Ty.Str)
    if nargs == 1 and vs[0].ty == Ty.Bytes
        if name == "concat"
            return self.bytes_concat(r, vs[0])
        if name == "contains" or name == "starts_with" or name == "ends_with"
            return Val(id: call("rt.bytes_{name}", [r.id, vs[0].id], Ty.Bool), ty: Ty.Bool)
        if name == "find"
            t := Ty.Opt(Ty.Int)
            return Val(id: call("rt.bytes_index_of", [r.id, vs[0].id], t), ty: t)
    unsupported(npos, "`.{name}()` on `bytes`")

## `bytes.zeros(n)` (type.bytes.13).
fn Lower.lower_bytes_zeros(mut self, args List[ast.Arg], npos ast.Pos) Val?
    if args.len() != 1
        return unsupported(npos, "`bytes.zeros` with these arguments")
    n := lower_value(args[0].value, Ty.Int)?
    h := trap_head("type.bytes.13", npos)
    Val(id: call("rt.bytes_zeros", [n.id, h, trap_tail(npos)], Ty.Bytes), ty: Ty.Bytes)
