## Copies of a local's last use (own.val.1, own.val.2): `b := a` copies the
## object `a` holds so the two stay independent, but when `a` is never read
## again the copy only costs time. `copy_if_place` notes each copy it makes
## of an owned local (not a parameter or a `for` variable, which belong to
## someone else); `elide_moves` then drops the ones whose source has no other
## use and is not read again by a later turn of a loop.

use ast

## Whether `e` makes a value nobody else holds: a place (copied on binding),
## a list or map literal, or a call of a function or constructor.
fn owns_fresh(e ast.Expr) bool
    match e
        Name | Index | Member | ListLit | MapLit | Call => true
        _ => false

## Whether `e` lies inside a stable binding: a parameter or local without
## `mut`, a `for` variable, or a binding read in place from one. A path that
## goes through a shared object (`ref`, a pointer) is never stable: another
## holder can change what lies behind it (own.ref.1).
fn Lower.stable_place(self, e ast.Expr) bool
    self.rooted_in(e, facts.stable)

## Whether `e` lies inside a fixed binding: stable, and holding an object
## no parameter shares. A parameter may be the contents of a `ref` cell that
## a call changes through another copy (own.ref.4); a local's own object
## can't be.
fn Lower.fixed_place(self, e ast.Expr) bool
    self.rooted_in(e, facts.fixed)

fn Lower.rooted_in(self, e ast.Expr, set Set[str]) bool
    match e
        Name(n, _) =>
            key := lookup(n) else return false
            set.contains("{fname}|{key}")
        Index(r, _, _) => self.rooted_in(r, set) and self.path_ty(e) != none
        Member(r, _, _) => self.rooted_in(r, set) and self.path_ty(e) != none
        _ => false

## A parameter without `mut` can't change while the function runs.
fn Lower.note_stable_param(mut self, name str, mutable bool)
    key := lookup(name) else return
    if not mutable
        facts.stable.add("{fname}|{key}")

## `name := value`. An immutable binding of a place inside a stable
## parameter reads it in place instead of copying: neither side can change
## while the binding lives, and the binding isn't owned, so no later copy of
## it is dropped and a returned or stored one is still copied.
## The same holds for a place inside a local that nothing in the rest of
## the binding's block changes (`note_let_rest`). The root then lends its
## object: a later `b := root` is copied, not moved (`lend`).
fn Lower.bind_let(mut self, name str, mutable bool, value ast.Expr, v Val)
    if not mutable
        and is_place(value)
        and (v.ty.is_coll() or needs_copy(v.ty))
        and not is_uniq(v.ty)
        and (self.stable_place(value) or self.unchanged_rest(value))
        fixed := self.fixed_place(value) or self.unchanged_rest(value)
        declare(name, v.ty, v.id)
        key := lookup(name) else return
        borrowed.add(key)
        facts.stable.add("{fname}|{key}")
        if fixed
            facts.fixed.add("{fname}|{key}")
        self.lend(value)
        return
    declare(name, v.ty, copy_if_place(value, v))
    self.note_owned(name, value)
    key := lookup(name) else return
    if is_uniq(v.ty)
        return
    # The local holds its own object: a copy, a new value, or one moved from
    # a local nobody reads again (own.val.1).
    facts.locals.add("{fname}|{key}")
    if not mutable
        facts.stable.add("{fname}|{key}")
        facts.fixed.add("{fname}|{key}")

## The root of the place `e` is read in place by a binding that outlives
## this statement. It may no longer give its object away: `elide_moves`
## would turn a later `mut b := root` into a move, and a change through `b`
## would show in the binding.
fn Lower.lend(mut self, e ast.Expr)
    root := path_root(e) else return
    key := lookup(root) else return
    facts.owned.remove("{fname}|{key}")

## Whether the binding `x := value` is the one `note_let_rest` found
## unchanged for the rest of its block.
fn Lower.unchanged_rest(self, value ast.Expr) bool
    p := expr_pos(value)
    facts.rest_ok != "" and facts.rest_ok == "{fname}|{p.line}:{p.col}"

## Before statement `at` of `body`: when it is `x := place` without `mut`,
## the place isn't already stable, and its root is a local holding its own
## object (`facts.locals`) that no later statement of the block changes,
## note it so `bind_let` reads the place in place. The binding lives only to
## the end of the block, so those statements are every change it could see;
## `stmt_mutates` answers yes to anything it can't follow.
fn Lower.note_let_rest(mut self, body List[ast.Stmt], at int)
    facts.rest_ok = ""
    match body[at]
        Let(_, _, mutable, value, other) =>
            if mutable or other != none or not is_place(value) or self.stable_place(value)
                return
            root := path_root(value) else return
            key := lookup(root) else return
            if not facts.locals.contains("{fname}|{key}") or self.path_ty(value) == none
                return
            for k in at + 1..body.len()
                if stmt_mutates(body[k], root)
                    return
            p := expr_pos(value)
            facts.rest_ok = "{fname}|{p.line}:{p.col}"
        _ => return

## The loop variable `var` of `for var in iter` over elements of type
## `elem`, not `mut`. When the loop reads its own copy, or a list nothing
## changes while it runs (a fixed place, or a local's own object the body
## leaves alone), the variable is fixed too, and an uncopied list lends its
## object.
fn Lower.note_for_var(mut self, var str, iter ast.Expr, elem Ty, copied bool, body List[ast.Stmt])
    if is_uniq(elem) or not (elem.is_coll() or needs_copy(elem))
        return
    if not copied
        self.lend(iter)
    if not copied and not self.fixed_place(iter)
        root := path_root(iter) else return
        rkey := lookup(root) else return
        if not facts.locals.contains("{fname}|{rkey}") or self.path_ty(iter) == none
            return
        if mutates(body, iter)
            return
    key := lookup(var) else return
    facts.stable.add("{fname}|{key}")
    facts.fixed.add("{fname}|{key}")

## The type of the place `e` (a name, field or element path) when no step
## of the path reads through a shared object, else none.
fn Lower.path_ty(self, e ast.Expr) Ty?
    match e
        Name(n, _) =>
            key := lookup(n) else return none
            t := var_ty.get(key) else return none
            if shared_ty(t)
                return none
            t
        Member(r, f, _) =>
            base := self.path_ty(r) else return none
            t := self.field_ty(base, f) else return none
            if shared_ty(t)
                return none
            t
        Index(r, _, _) =>
            base := self.path_ty(r) else return none
            t := match base
                List(x) => x
                Map(_, x) => x
                _ => return none
            if shared_ty(t)
                return none
            t
        _ => none

## The type of field `f` of a struct or tuple type `t`.
fn Lower.field_ty(self, t Ty, f str) Ty?
    match t
        Struct(n) =>
            slots := structs.get(n) else return none
            for s in slots
                if s.name == f
                    return s.ty
            none
        Tuple(es) =>
            k := f.to_int() else return none
            if k < 0 or k >= es.len()
                return none
            es[k]
        _ => none

## Whether a value of type `t` is a handle to an object others may hold and
## change: a `ref`, a pointer, or a type lowering doesn't know.
fn shared_ty(t Ty) bool
    match t
        Ref(_) | Ptr(_) | Unknown => true
        _ => false

## A plain `name := value` makes the local owned when `value` is fresh.
fn Lower.note_owned(mut self, name str, value ast.Expr)
    key := lookup(name) else return
    if owns_fresh(value)
        facts.owned.add("{fname}|{key}")

## An assignment of a value that isn't fresh ends the local's ownership.
fn Lower.note_assigned(mut self, key str, value ast.Expr)
    if not owns_fresh(value)
        facts.owned.remove("{fname}|{key}")

## Note the copy `copied` of the place `e` when `e` is an owned local.
fn Lower.note_move(mut self, e ast.Expr, v Val, copied int) int
    if copied == v.id
        return copied
    match e
        Name(n, _) =>
            key := lookup(n) else return copied
            if not borrowed.contains(key) and facts.owned.contains("{fname}|{key}")
                facts.moves.push(copied)
        _ => return copied
    copied

## `f` without the noted copies after which the source is not read again.
fn elide_moves(f Func, moves List[int]) Func
    if moves.len() == 0
        return f
    n := f.vals.len()
    nb := f.blocks.len()
    mut noted := [false for _ in 0..n]
    for m in moves
        noted[m] = true
    mut cand := [false for _ in 0..n]
    for blk in f.blocks
        for i in blk.insts
            if i.dst >= 0 and noted[i.dst] and i.op == "call" and i.argc() > 0
                cand[i.arg(0)] = true
    mut def_block := [0 for _ in 0..n]
    # The blocks that read each candidate, in any position.
    mut readers := [List[int]() for _ in 0..n]
    for b in 0..nb
        blk := f.blocks[b]
        for p in blk.params
            def_block[p] = b
        for i in blk.insts
            if i.dst >= 0
                def_block[i.dst] = b
            for a in i.operands()
                if cand[a] and not readers[a].contains(b)
                    readers[a].push(b)
        for u in blk.term.uses()
            if cand[u] and not readers[u].contains(b)
                readers[u].push(b)
        for e in blk.term.args
            for a in e
                if cand[a] and not readers[a].contains(b)
                    readers[a].push(b)
    mut repl := [v for v in 0..n]
    mut gone := [[false for _ in blk.insts] for blk in f.blocks]
    mut touched := false
    for b in 0..nb
        for at in 0..f.blocks[b].insts.len()
            i := f.blocks[b].insts[at]
            if i.dst < 0 or not noted[i.dst] or i.op != "call" or i.argc() == 0
                continue
            x := i.arg(0)
            if f.vals[x] != f.vals[i.dst] or read_later(f, readers[x], def_block[x], x, b, at)
                continue
            repl[i.dst] = x
            gone[b][at] = true
            touched = true
    if not touched
        return f
    mut g := f
    for b in 0..nb
        for at in 0..g.blocks[b].insts.len()
            g.blocks[b].insts[at] = g.blocks[b].insts[at].with_args([
                moved(repl, a)
                for a in g.blocks[b].insts[at].operands()
            ])
        g.blocks[b].insts = [
            g.blocks[b].insts[at]
            for at in 0..g.blocks[b].insts.len() if not gone[b][at]
        ]
        mut t := g.blocks[b].term
        if t.cond >= 0
            t.cond = moved(repl, t.cond)
        if t.value >= 0
            t.value = moved(repl, t.value)
        t.args = [[moved(repl, a) for a in edge] for edge in t.args]
        g.blocks[b].term = t
    g

## Whether `x` is read after instruction `at` of block `b`: later in the
## block, in its terminator, or in a block reachable from it before `x`'s own
## definition block starts over (a loop-carried value is defined anew there).
fn read_later(f Func, readers List[int], def int, x int, b int, at int) bool
    blk := f.blocks[b]
    for k in at + 1..blk.insts.len()
        if blk.insts[k].operands().contains(x)
            return true
    if blk.term.uses().contains(x)
        return true
    for e in blk.term.args
        if e.contains(x)
            return true
    mut seen := [false for _ in f.blocks]
    mut stack := List[int]()
    for t in blk.term.targets
        stack.push(t)
    while stack.len() > 0
        s := stack.pop() else break
        if seen[s] or s == def
            continue
        seen[s] = true
        if readers.contains(s)
            return true
        for t in f.blocks[s].term.targets
            stack.push(t)
    false

fn moved(repl List[int], v int) int
    mut x := v
    while repl[x] != x
        x = repl[x]
    x

## Whether the value of `e`, an `if` or `match`, may be a place somebody else
## holds (a field, an element, a parameter, or a name bound in an arm): the
## merged result is then copied where it is returned (own.val.1).
fn Lower.place_tail(self, e ast.Expr, any_name bool) bool
    match e
        Member | Index => true
        Name(n, _) =>
            key := lookup(n) else return true
            any_name or borrowed.contains(key)
        If(branches, els, _, _) =>
            for br in branches
                if self.body_place_tail(br.body, any_name)
                    return true
            if b := els
                return self.body_place_tail(b, any_name)
            false
        Match(_, arms, _) =>
            for a in arms
                if self.body_place_tail(a.body, any_name)
                    return true
            false
        _ => false

fn Lower.body_place_tail(self, body List[ast.Stmt], any_name bool) bool
    if body.len() == 0
        return false
    match body[body.len() - 1]
        Eval(x) => self.place_tail(x, any_name)
        _ => false

## Whether the value of `e` can be an object that something else still holds: a place, or the
## stored element `get`, `first` or `last` hands out, through `?` or `else` (own.val.1).
fn aliases_place(e ast.Expr) bool
    match e
        Name | Index | Member => true
        Try(x, _, _) => aliases_place(x)
        OrElse(x, _, _) => aliases_place(x)
        Method(_, name, _, _) => name == "get" or name == "first" or name == "last"
        _ => false

fn is_branchy(e ast.Expr) bool
    match e
        If | Match => true
        _ => false
