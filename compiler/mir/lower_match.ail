## `match` in the native subset (ADR 0603), as a statement or a value
## (expr.match.1-12). The arms are tried in order: each pattern is a chain
## of comparisons that ends in a branch to the arm's body or to the next
## arm; an enum's variant index is loaded once. Bindings (expr.match.6)
## load the variant's fields; a guard (expr.match.11) that is false goes on
## with the next arm. The checker makes a `match` exhaustive
## (expr.match.2), so falling out of the last arm is unreachable, as in the
## interpreter.

use ast

fn Lower.lower_match(mut self, scrutinee ast.Expr, arms List[ast.Arm], pos ast.Pos, want Ty?) Val?
    if n := union_scrutinee(scrutinee)
        return lower_union_match(n, arms, pos, want)
    s := lower_value(scrutinee, none)?
    mut en := ""
    match s.ty
        Int | Sized(_) | Bool | Str | Char | Tuple | Struct => en = ""
        Enum(n) => en = n
        _ => return unsupported(pos, "`match` on `{s.ty.name()}`")
    tag := if en == "" then s.id else tag_of(en, s.id)
    value := want_value(want)
    join := new_block()
    mut result := -1
    mut rty := Ty.Unknown
    if value
        result = new_value(Ty.Unknown, "")
        blocks[join].params.push(result)
        rty = arms_start(want, [arm.body for arm in arms], none)
    tree := match_tree(arms, s, tag, en)
    for idx in 0..arms.len()
        arm := arms[idx]
        if tree.len() > 0 and tree[idx] < 0
            continue
        if tree.len() == 0 and done()
            # An earlier `_` took every value: the rest can't match.
            break
        body := if tree.len() > 0 then tree[idx] else new_block()
        mut next := -1
        if tree.len() == 0
            next = new_block()
            if not test_pattern(arm.pat, s, tag, body, next)
                return none
        seal(body)
        cur = body
        scopes.push(Map[str, str]())
        bind_fields(arm.pat, s)
        if g := arm.guard
            c := lower_value(g, Ty.Bool)?
            pass := new_block()
            branch(c.id, pass, [], next, [])
            seal(pass)
            cur = pass
        before := problems.len()
        v := lower_arm(arm.body, value, rty)
        if value and v == none and problems.len() > before
            # Reported in the arm; nothing is built.
            finish(unreachable_term())
        rty = arm_end(join, value, v, pos, rty)
        scopes.pop()
        if tree.len() == 0
            seal(next)
            cur = next
    if tree.len() > 0
        dead := new_block()
        seal(dead)
        cur = dead
    finish(unreachable_term())
    seal(join)
    cur = join
    if value
        vals[result] = rty
        return Val(id: result, ty: rty)
    Val(id: -1, ty: Ty.Unit)

## An arm's statements in a new scope; with `value`, its last expression is
## the arm's value, lowered expecting `rty` once that is known (so a bare
## variant takes the enum of the other arms, type.enum.3).
fn Lower.lower_arm(mut self, body List[ast.Stmt], value bool, rty Ty) Val?
    if not value
        return lower_block(body, false)
    want := if rty.is_unknown() then none else rty
    scopes.push(Map[str, str]())
    mut result := Val(id: -2, ty: Ty.Unit)
    for i in 0..body.len()
        st := body[i]
        if done()
            dead_block()
        if i == body.len() - 1
            if e := final_expr(st)
                if tail_error(e)
                    continue
                result = lower_expr(e, want) else Val(id: -2, ty: Ty.Unit)
                continue
        lower_stmt(st)
    scopes.pop()
    if result.id == -2
        return none
    result

## End the current block with a branch to `yes` when pattern `p` matches
## scrutinee `s` (whose variant index is `tag`), else to `no`. False after a
## problem.
fn Lower.test_pattern(mut self, p ast.Pattern, s Val, tag int, yes int, no int) bool
    match p
        Wildcard =>
            jump(yes, [])
        Literal(lit, lpos) =>
            c := literal_test(lit, s, lpos) else return false
            branch(c, yes, [], no, [])
        Range(lo, hi, inclusive, rpos) =>
            a := literal_int(lo, s, rpos) else return false
            b := literal_int(hi, s, rpos) else return false
            mid := new_block()
            branch(op("ge", [s.id, konst(a, s.ty)], Ty.Bool), mid, [], no, [])
            seal(mid)
            cur = mid
            c := op(if inclusive then "le" else "lt", [s.id, konst(b, s.ty)], Ty.Bool)
            branch(c, yes, [], no, [])
        Alt(alts, _) =>
            for k in 0..alts.len()
                if k == alts.len() - 1
                    return test_pattern(alts[k], s, tag, yes, no)
                other := new_block()
                if not test_pattern(alts[k], s, tag, yes, other)
                    return false
                seal(other)
                cur = other
        Variant(_, name, _, vpos) =>
            # expr.match.14: `Point` or `Point(x, y)` takes any struct value.
            if struct_name(s.ty) != none
                jump(yes, [])
                return true
            n := enum_name(s.ty) else
                problem(vpos, "variant pattern `{name}` on `{s.ty.name()}`")
                return false
            k := case_index(n, name)
            if k < 0
                problem(vpos, "`{n}` has no variant `{name}`")
                return false
            branch(op("eq", [tag, konst(k, Ty.Int)], Ty.Bool), yes, [], no, [])
        TuplePat => return tuple_test(p, s, yes, no)
        Nested => return nested_test(p, s, tag, yes, no)
        StructPat => return labeled_test(p, s, tag, yes, no)
        BindName(_, bpos) =>
            problem(bpos, "a name pattern outside a tuple isn't in the native subset yet")
            return false
    true

## The `bool` that says whether `s` equals literal `lit` (expr.match.7).
fn Lower.literal_test(mut self, lit ast.Literal, s Val, pos ast.Pos) int?
    match lit
        IntLit(_) =>
            n := literal_int(lit, s, pos)?
            op("eq", [s.id, konst(n, Ty.Int)], Ty.Bool)
        BoolLit(b) =>
            if not (s.ty == Ty.Bool)
                problem(pos, "a `bool` pattern on `{s.ty.name()}`")
                return none
            op("eq", [s.id, konst(if b then 1 else 0, Ty.Bool)], Ty.Bool)
        StrLit(text) =>
            if not (s.ty == Ty.Str)
                problem(pos, "a `str` pattern on `{s.ty.name()}`")
                return none
            call("rt.str_eq", [s.id, str_value(text)], Ty.Bool)
        CharLit(_) =>
            n := literal_int(lit, s, pos)?
            op("eq", [s.id, konst(n, Ty.Char)], Ty.Bool)

fn Lower.literal_int(mut self, lit ast.Literal, s Val, pos ast.Pos) int?
    text := match lit
        IntLit(t) => t
        CharLit(t) =>
            if not (s.ty == Ty.Char)
                problem(pos, "a `char` pattern on `{s.ty.name()}`")
                return none
            return t.chars()[0].code()
        _ =>
            problem(pos, "only `int` and `char` ranges are in the native subset yet")
            return none
    if not (s.ty == Ty.Int or s.ty.is_sized())
        problem(pos, "an `int` pattern on `{s.ty.name()}`")
        return none
    n := text.to_int() else
        problem(pos, "integer literal `{text}` out of range")
        return none
    n

## Declare the names a variant pattern binds to its fields (expr.match.6).
## They belong to the enum value, so returning one copies it.
fn Lower.bind_fields(mut self, p ast.Pattern, s Val)
    match p
        Variant(_, name, bindings, _) =>
            binds := bindings else return
            if struct_name(s.ty) != none
                record_bind(binds, s)
                return
            n := enum_name(s.ty) else return
            k := case_index(n, name)
            if k < 0
                return
            fields := enums[n][k].fields
            for j in 0..binds.len()
                if j >= fields.len() or binds[j].name == "_"
                    continue
                ft := fields[j].ty
                declare(binds[j].name, ft, load(s.id, j + 1, ft))
                borrowed.add(lookup(binds[j].name) else "")
        TuplePat => tuple_bind(p, s)
        Nested => nested_bind(p, s)
        StructPat => labeled_bind(p, s)
        _ => return
