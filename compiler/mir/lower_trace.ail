## Call positions for a trap's stack (trace.frame.1, ADR 0641): a user call
## carries the position of the call in `imm` (file, line and column packed
## by `call_pos`), which the code generators turn into a row of the call
## table. The runtime's own calls carry none.
use ast

## A call to a user function at `pos`.
fn Lower.call_at(mut self, name str, args List[int], ty Ty, pos ast.Pos) int
    mut i := inst(-1, "call", args)
    i.name = name
    # A constant's initialiser runs before `main` here, but is lazy in the
    # interpreter, whose stack has no frame for it.
    if not is_rt and not fname.starts_with("init.")
        i.imm = call_pos(file, pos.line, pos.col)
    if ty.is_unit()
        emit_void(i)
        return -1
    emit(i, ty)

## The line of the stack for the function being lowered, to end a runtime
## trap's source excerpt (trace.frame.1): `  at [FILE:]LINE:COL in NAME(..)`.
fn Lower.trap_frame(self, pos ast.Pos) str
    root := if file == 0 then "" else "{src_paths[file]}:"
    "  at {root}{pos.line}:{pos.col} in {self.frame_name()}\n"

## `NAME(..)` of the function being lowered; a `par for` chunk reports the
## function that holds the loop, as the interpreter does.
fn Lower.frame_name(self) str
    if tk.owner != ""
        for f in funcs
            if f.name == tk.owner
                return "{tk.owner}({if f.params.len() > 0 then ".." else ""})"
        return "{tk.owner}()"
    dots := if blocks[0].params.len() > 0 then ".." else ""
    "{plain_name(fname)}({dots})"

## `f` for the instance `f[int]` of a generic function, as the interpreter
## names its frames (trace.frame.1).
pub fn plain_name(full str) str
    # The `.seq` copy of a fork-join function (conc.par.15) is named as the original.
    name := if full.ends_with(".seq") then full.slice(0, full.len() - 4) else full
    if not name.contains("[")
        return name
    mut out := List[str]()
    mut depth := 0
    for c in name.chars()
        if c == '['
            depth += 1
        elif c == ']'
            depth -= 1
        elif depth == 0
            out.push(c.to_str())
    out.join("")
