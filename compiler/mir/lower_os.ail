## Lowering the operating-system calls of the native subset (ADRs 0580-0582):
## `std.fs`, `std.env`, `std.io`, `std.time`, `std.path`, `std.proc`, `.to_float()` and the format
## specifications of an interpolation (lex.str.7). Each is a call of the
## runtime in `compiler/rt/native/os.ail` and `fmt.ail`. A call that can
## fail (`fs.*`) is a fallible function of lane 175's model (lower_err.ail):
## it returns its success value, or sets the error slot to the display text
## of an `fs.IoError` and returns zero; `?`, `else` and `else err` follow it.
## `env.get`, `env.home`, `io.read_line` and `s.to_float()` return an
## optional.
use ast

## A runtime function standing for a standard-library one.
struct OsFn
    ## The runtime function, e.g. `rt.fs_read_text`.
    rt str
    params List[Ty]
    ret Ty
    ## 1: can fail with `fs.IoError` (the runtime also takes the call's trace
    ## line as a last argument).
    fails bool
    ## How many trailing parameters may be left off (ADR 0284): the call
    ## passes `none`, a zero word, for each.
    optional int

fn os_fn(rt str, params List[Ty], ret Ty, fails bool) OsFn
    OsFn(rt: rt, params: params, ret: ret, fails: fails, optional: 0)

## The standard-library function `mod.name`, if the native subset has it.
fn os_lookup(mod str, name str) OsFn?
    s := Ty.Str
    maybe := Ty.Opt(Ty.Str)
    key := "{mod}.{name}"
    match key
        "fs.exists" => os_fn("rt.fs_exists", [s], Ty.Bool, false)
        "fs.read_text" => os_fn("rt.fs_read_text", [s], s, true)
        "fs.write_text" => os_fn("rt.fs_write_text", [s, s], Ty.Unit, true)
        "fs.append_text" => os_fn("rt.fs_append_text", [s, s], Ty.Unit, true)
        "fs.list_dir" => os_fn("rt.fs_list_dir", [s], Ty.List(s), true)
        "fs.walk" => os_fn("rt.fs_walk", [s], Ty.List(s), true)
        "fs.remove" => os_fn("rt.fs_remove", [s], Ty.Unit, true)
        "fs.make_dir" => os_fn("rt.fs_make_dir", [s], Ty.Unit, true)
        "fs.rename" => os_fn("rt.fs_rename", [s, s], Ty.Unit, true)
        "env.get" => os_fn("rt.env_get", [s], maybe, false)
        "env.home" => os_fn("rt.env_home", [], maybe, false)
        "env.cwd" => os_fn("rt.env_cwd", [], s, false)
        "env.program" => os_fn("rt.env_program", [], s, false)
        "path.dir" => os_fn("rt.path_dir", [s], s, false)
        "path.base" => os_fn("rt.path_base", [s], s, false)
        "path.ext" => os_fn("rt.path_ext", [s], s, false)
        "path.stem" => os_fn("rt.path_stem", [s], s, false)
        "path.join" => os_fn("rt.path_join", [s, s], s, false)
        "proc.run" =>
            OsFn(
                rt: "rt.proc_run",
                params: [s, Ty.List(s), maybe, Ty.Opt(Ty.Int)],
                ret: Ty.Struct(PROC_OUTPUT),
                fails: true,
                optional: 2,
            )
        "proc.which" => os_fn("rt.proc_which", [s], maybe, false)
        "io.read_line" => os_fn("rt.io_read_line", [], maybe, false)
        "io.read_all" => os_fn("rt.io_read_all", [], s, false)
        "io.exit" => os_fn("rt.io_exit", [Ty.Int], Ty.Unit, false)
        "time.now_ms" => os_fn("rt.time_now_ms", [], Ty.Int, false)
        "time.sleep_ms" => os_fn("rt.time_sleep_ms", [Ty.Int], Ty.Unit, false)
        _ => none

## The module name when `recv` is one of the OS modules.
fn Lower.os_module(self, recv ast.Expr) str
    for m in ["fs", "env", "io", "time", "path", "proc", "net"]
        if is_module(recv, m)
            return m
    ""

## Whether the call `recv.name(...)` is an OS function that can fail.
fn Lower.os_fails(self, recv ast.Expr, name str) bool
    m := os_module(recv)
    if m == ""
        return false
    if m == "net"
        return net_module_fails(name)
    f := os_lookup(m, name) else return false
    f.fails

## `fs.NAME(...)`, `io.NAME(...)`, `env.NAME(...)`, `time.NAME(...)` and `path.NAME(...)`, from
## `lower_method`. `none` after a report.
fn Lower.lower_os_method(mut self, m str, name str, npos ast.Pos, args List[ast.Arg]) Val?
    if m == "io" and name == "eprint"
        return lower_eprint(args, npos)
    if m == "net"
        return lower_net_module(name, npos, args)
    f := os_lookup(m, name) else
        return unsupported(npos, "`{m}.{name}`")
    if name == "exit"
        v := os_call(f, args, npos)?
        finish(unreachable_term())
        return v
    os_call(f, args, npos)

## Emit the call of `f` with `args`.
fn Lower.os_call(mut self, f OsFn, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() > f.params.len() or args.len() + f.optional < f.params.len()
        return unsupported(pos, "`{f.rt}` with {args.len()} arguments")
    mut vs := List[int]()
    for i in 0..args.len()
        a := args[i]
        if a.label != none or a.mutable
            return unsupported(pos, "`{f.rt}` with a labelled or `mut` argument")
        v := lower_value(a.value, f.params[i])?
        vs.push(convert(v, f.params[i], expr_pos(a.value)))
    for i in args.len()..f.params.len()
        vs.push(konst(0, f.params[i]))
    if f.fails
        vs.push(trace_line(pos))
    if f.rt == "rt.io_exit" or f.rt == "rt.time_sleep_ms"
        os_range_check(f.rt == "rt.io_exit", vs[0], pos)
    Val(id: call(f.rt, vs, f.ret), ty: f.ret)

## The argument checks of `io.exit` (status 0 to 255, std.io.4) and
## `time.sleep_ms` (not negative, std.time.2): a trap at the call, kinds 9
## and 10 of the runtime's trap messages.
fn Lower.os_range_check(mut self, is_exit bool, v int, pos ast.Pos)
    zero := konst(0, Ty.Int)
    fail := new_block()
    check(op("le", [zero, v], Ty.Bool), fail)
    if is_exit
        check(op("le", [v, konst(255, Ty.Int)], Ty.Bool), fail)
    good := cur
    seal(fail)
    cur = fail
    mut t := inst(-1, "trap", [v, zero])
    t.imm = if is_exit then 9 else 10
    t.site = site(if is_exit then "std.io.4" else "std.time.2", "range", "", pos)
    emit_void(t)
    finish(unreachable_term())
    cur = good

## `s.to_float()` (type.num.8): a `float?`.
fn Lower.lower_to_float(mut self, s Val) Val
    t := Ty.Opt(Ty.Float)
    Val(id: call("rt.str_float_opt", [s.id], t), ty: t)

## `io.eprint(x)` (std.io.3): `print`'s text on standard error.
fn Lower.lower_eprint(mut self, args List[ast.Arg], pos ast.Pos) Val?
    call("rt.err_begin", [], Ty.Unit)
    lower_print(args, pos)?
    call("rt.err_end", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

# ---- format specifications (lex.str.7, type.str.11) ----

## The text of `v` shaped by `spec` as a string value. `{x:.N}` rounds a
## float, `{x:x}` is hexadecimal; a width pads with the fill (default a
## space), numbers on the right and everything else on the left unless the
## alignment says so.
fn Lower.fmt_text(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    n := spec.precision else -1
    mut text := -1
    match v.ty
        Int =>
            text = call(if spec.hex then "rt.fmt_hex" else "rt.fmt_int", [v.id], Ty.Str)
        Float =>
            if n >= 0
                text = call("rt.fmt_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Str)
            else
                text = call("rt.fmt_float", [v.id], Ty.Str)
        Bool => text = call("rt.fmt_bool", [v.id], Ty.Str)
        Str => text = v.id
        Char => text = call("rt.str_char", [v.id], Ty.Str)
        _ => return unsupported(pos, "a format specification on a `{v.ty.name()}`")
    w := spec.width else return Val(id: text, ty: Ty.Str)
    numeric := v.ty == Ty.Int or v.ty.is_float()
    mut align := if numeric then 1 else 0
    if a := spec.align
        align = if a == "<" then 0 else if a == ">" then 1 else 2
    fill := spec.fill else " "
    padded := call(
        "rt.fmt_pad",
        [text, konst(w, Ty.Int), str_value(fill), konst(align, Ty.Int)],
        Ty.Str,
    )
    Val(id: padded, ty: Ty.Str)

## A `{x:spec}` piece of `print`: a float with only `.N` is written straight
## into the output buffer; anything else is built as a string first.
fn Lower.lower_fmt_print(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    plain := spec.fill == none and spec.align == none and spec.width == none
    n := spec.precision else -1
    if plain and not spec.hex and n >= 0 and v.ty.is_float()
        call("rt.out_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    s := fmt_text(v, spec, pos)?
    call("rt.out_str", [s.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)
