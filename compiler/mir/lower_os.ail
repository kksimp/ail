## `CALL else ...` where CALL can fail (err.else.1-2): the call, its status,
## and on failure the fallback value or the leaving statement.
fn Lower.lower_os_or_else(mut self, value ast.Expr, other ast.Else, pos ast.Pos) Val?
    f := fallible(value) else
        return lower_else(value, other, pos)
    args := match value
        Method(recv, name, _, margs) =>
            if name == "to_float" and margs.len() == 0 and os_module(recv) == ""
                [ast.Arg(label: none, mutable: false, moved: false, value: recv, param: none)]
            else
                margs
        _ => []
    r := os_call(f, args, pos)?
    ok := call(f.status, [], Ty.Bool)
    join := new_block()
    mut res := -1
    if not f.ret.is_unit()
        res = new_value(f.ret, "")
        blocks[join].params.push(res)
    fail := new_block()
    branch(ok, join, if f.ret.is_unit() then [] else [r.id], fail, [])
    seal(fail)
    cur = fail
    match other
        Fallback(x) =>
            if f.ret.is_unit()
                lower_value(x, none)?
                jump(join, [])
            else
                fb := lower_value(x, f.ret)?
                jump(join, [convert(fb, f.ret, pos)])
        Leave(st) =>
            lower_stmt(st)
            if not done()
                problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(err, body, hpos) =>
            if err != none
                problem(
                    hpos,
                    "`else err` isn't in the native subset yet: error values come with lane 175",
                )
            elif f.ret.is_unit()
                lower_block(body, false)
                if not done()
                    jump(join, [])
            else
                fb := lower_block(body, true)
                if not done()
                    if v := fb
                        jump(join, [convert(v, f.ret, hpos)])
                    else
                        problem(hpos, "this `else` must leave or end with a value")
    seal(join)
    cur = join
    if f.ret.is_unit()
        return Val(id: -1, ty: Ty.Unit)
    Val(id: res, ty: f.ret)

## `name := CALL else ...` for a call from `fallible`: false when `value`
## isn't one.
fn Lower.lower_os_let_else(mut self, name str, pos ast.Pos, value ast.Expr, other ast.Else) bool
    if fallible(value) == none
        return false
    v := lower_os_or_else(value, other, pos) else
        declare(name, Ty.Unknown, -1)
        return true
    declare(name, v.ty, v.id)
    true

