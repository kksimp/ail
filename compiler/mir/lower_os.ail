# ---- format specifications (lex.str.7, type.str.11) ----

## The text of `v` shaped by `spec` as a string value. `{x:.N}` rounds a
## float, `{x:x}` is hexadecimal; a width pads with the fill (default a
## space), numbers on the right and everything else on the left unless the
## alignment says so.
fn Lower.fmt_text(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    n := spec.precision else -1
    mut text := -1
    match v.ty
        Int =>
            text = call(if spec.hex then "rt.fmt_hex" else "rt.fmt_int", [v.id], Ty.Str)
        Float =>
            if n >= 0
                text = call("rt.fmt_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Str)
            else
                text = call("rt.fmt_float", [v.id], Ty.Str)
        Bool => text = call("rt.fmt_bool", [v.id], Ty.Str)
        Str => text = v.id
        Char => text = call("rt.str_char", [v.id], Ty.Str)
        _ => return unsupported(pos, "a format specification on a `{v.ty.name()}`")
    w := spec.width else return Val(id: text, ty: Ty.Str)
    numeric := v.ty == Ty.Int or v.ty.is_float()
    mut align := if numeric then 1 else 0
    if a := spec.align
        align = if a == "<" then 0 else if a == ">" then 1 else 2
    fill := spec.fill else " "
    padded := call(
        "rt.fmt_pad",
        [text, konst(w, Ty.Int), str_value(fill), konst(align, Ty.Int)],
        Ty.Str,
    )
    Val(id: padded, ty: Ty.Str)

## A `{x:spec}` piece of `print`: a float with only `.N` is written straight
## into the output buffer; anything else is built as a string first.
fn Lower.lower_fmt_print(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    plain := spec.fill == none and spec.align == none and spec.width == none
    n := spec.precision else -1
    if plain and not spec.hex and n >= 0 and v.ty.is_float()
        call("rt.out_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    s := fmt_text(v, spec, pos)?
    call("rt.out_str", [s.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)
