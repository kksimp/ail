## Lowering the operating-system calls of the native subset (ADRs 0580-0582):
## `std.fs`, `std.env`, `std.io`, `std.time`, `std.path`, `std.proc`, `.to_float()` and the format
## specifications of an interpolation (lex.str.7). Each is a call of the
## runtime in `compiler/rt/native/os.ail` and `fmt.ail`. A call that can
## fail (`fs.*`) is a fallible function of lane 175's model (lower_err.ail):
## it returns its success value, or sets the error slot to the display text
## of an `fs.IoError` and returns zero; `?`, `else` and `else err` follow it.
## `env.get`, `env.home`, `io.read_line` and `s.to_float()` return an
## optional.
use ast

## A runtime function standing for a standard-library one.
struct OsFn
    ## The runtime function, e.g. `rt.fs_read_text`.
    rt str
    params List[Ty]
    ret Ty
    ## 1: can fail with `fs.IoError` (the runtime also takes the call's trace
    ## line as a last argument).
    fails bool
    ## How many trailing parameters may be left off (ADR 0284): the call
    ## passes `none`, a zero word, for each.
    optional int

fn os_fn(rt str, params List[Ty], ret Ty, fails bool) OsFn
    OsFn(rt: rt, params: params, ret: ret, fails: fails, optional: 0)

## The standard-library function `mod.name`, if the native subset has it.
fn os_lookup(mod str, name str) OsFn?
    s := Ty.Str
    maybe := Ty.Opt(Ty.Str)
    key := "{mod}.{name}"
    match key
        "fs.exists" => os_fn("rt.fs_exists", [s], Ty.Bool, false)
        "fs.read_text" => os_fn("rt.fs_read_text", [s], s, true)
        "fs.read_bytes" => os_fn("rt.fs_read_bytes", [s], Ty.Bytes, true)
        "fs.write_text" => os_fn("rt.fs_write_text", [s, s], Ty.Unit, true)
        "fs.write_bytes" => os_fn("rt.fs_write_bytes", [s, Ty.Bytes], Ty.Unit, true)
        "fs.append_text" => os_fn("rt.fs_append_text", [s, s], Ty.Unit, true)
        "fs.metadata" => os_fn("rt.fs_metadata", [s], Ty.Struct(FS_METADATA), true)
        "fs.volume" => os_fn("rt.fs_volume", [s], Ty.Struct(FS_VOLUME), true)
        "fs.read_range" => os_fn("rt.fs_read_range", [s, Ty.Int, Ty.Int], Ty.Bytes, true)
        "fs.map" => os_fn("rt.fs_map", [s], Ty.Bytes, true)
        "fs.temp_dir" => os_fn("rt.fs_temp_dir", [], s, false)
        "fs.make_temp_dir" => os_fn("rt.fs_make_temp_dir", [s], s, true)
        "fs.trash" => os_fn("rt.fs_trash", [s], Ty.Unit, true)
        "fs.mode" => os_fn("rt.fs_mode", [s], Ty.Int, true)
        "fs.set_mode" => os_fn("rt.fs_set_mode", [s, Ty.Int], Ty.Unit, true)
        "fs.set_modified" => os_fn("rt.fs_set_modified", [s, Ty.Int], Ty.Unit, true)
        "fs.read_link" => os_fn("rt.fs_read_link", [s], s, true)
        "fs.symlink" => os_fn("rt.fs_symlink", [s, s], Ty.Unit, true)
        "fs.truncate" => os_fn("rt.fs_truncate", [s, Ty.Int], Ty.Unit, true)
        "fs.write_at" => os_fn("rt.fs_write_at", [s, Ty.Int, Ty.Bytes], Ty.Unit, true)
        "fs.append_bytes" => os_fn("rt.fs_append_bytes", [s, Ty.Bytes], Ty.Unit, true)
        "fs.list_dir" => os_fn("rt.fs_list_dir", [s], Ty.List(s), true)
        "fs.copy" => os_fn("rt.fs_copy", [s, s], Ty.Unit, true)
        "fs.glob" => os_fn("rt.fs_glob", [s], Ty.List(s), false)
        "fs.scan" => os_fn("rt.fs_scan", [s, Ty.Bool], Ty.Struct(FS_SCAN), true)
        "fs.scan_count" => os_fn("rt.fs_scan_count", [], Ty.Struct(FS_SCAN_COUNT), false)
        "fs.walk" => os_fn("rt.fs_walk", [s], Ty.List(s), true)
        "fs.remove" => os_fn("rt.fs_remove", [s], Ty.Unit, true)
        "fs.make_dir" => os_fn("rt.fs_make_dir", [s], Ty.Unit, true)
        "fs.rename" => os_fn("rt.fs_rename", [s, s], Ty.Unit, true)
        "env.get" => os_fn("rt.env_get", [s], maybe, false)
        "env.vars" => os_fn("rt.env_vars", [], Ty.Map(key: s, val: s), false)
        "env.home" => os_fn("rt.env_home", [], maybe, false)
        "env.cwd" => os_fn("rt.env_cwd", [], s, false)
        "env.program" => os_fn("rt.env_program", [], s, false)
        "path.dir" => os_fn("rt.path_dir", [s], s, false)
        "path.base" => os_fn("rt.path_base", [s], s, false)
        "path.ext" => os_fn("rt.path_ext", [s], s, false)
        "path.stem" => os_fn("rt.path_stem", [s], s, false)
        "path.join" => os_fn("rt.path_join", [s, s], s, false)
        "compress.gzip_file" => os_fn("rt.compress_gzip_file", [s, s], Ty.Unit, true)
        "compress.gunzip_file" => os_fn("rt.compress_gunzip_file", [s, s], Ty.Unit, true)
        "compress.zip_dir" => os_fn("rt.compress_zip_dir", [s, s], Ty.Unit, true)
        "compress.unzip" => os_fn("rt.compress_unzip", [s, s], Ty.Unit, true)
        "compress.gzip" => os_fn("rt.compress_gzip", [s], Ty.Bytes, false)
        "compress.zlib" => os_fn("rt.compress_zlib", [s], Ty.Bytes, false)
        "compress.deflate" => os_fn("rt.compress_deflate", [s], Ty.Bytes, false)
        "compress.inflate" => os_fn("rt.compress_inflate", [Ty.Bytes], Ty.Bytes, true)
        "compress.gunzip" => os_fn("rt.compress_gunzip", [Ty.Bytes], Ty.Bytes, true)
        "compress.unzlib" => os_fn("rt.compress_unzlib", [Ty.Bytes], Ty.Bytes, true)
        "bytes.from_list" =>
            os_fn("rt.bytes_from_list", [Ty.List(Ty.Sized("u8"))], Ty.Bytes, false)
        "bytes.from_hex" => os_fn("rt.bytes_parse_hex", [s], Ty.Opt(Ty.Bytes), false)
        "bytes.from_base64" => os_fn("rt.bytes_parse_base64", [s], Ty.Opt(Ty.Bytes), false)
        "proc.run" =>
            OsFn(
                rt: "rt.proc_run",
                params: [s, Ty.List(s), maybe, Ty.Opt(Ty.Int)],
                ret: Ty.Struct(PROC_OUTPUT),
                fails: true,
                optional: 2,
            )
        "proc.run_bytes" =>
            OsFn(
                rt: "rt.proc_run_bytes",
                params: [s, Ty.List(s), Ty.Opt(Ty.Bytes), Ty.Opt(Ty.Int)],
                ret: Ty.Struct(PROC_RAW),
                fails: true,
                optional: 2,
            )
        "proc.start" =>
            OsFn(
                rt: "rt.proc_start",
                params: [s, Ty.List(s), Ty.Opt(Ty.Int)],
                ret: Ty.Struct(PROC_CHILD),
                fails: true,
                optional: 1,
            )
        "proc.wait" => os_fn("rt.proc_wait_child", [Ty.Struct(PROC_CHILD)], Ty.Int, true)
        "proc.kill" => os_fn("rt.proc_kill_child", [Ty.Struct(PROC_CHILD)], Ty.Int, false)
        "proc.which" => os_fn("rt.proc_which", [s], maybe, false)
        "io.read_line" => os_fn("rt.io_read_line", [], maybe, false)
        "io.read_bytes" => os_fn("rt.io_read_bytes", [], Ty.Bytes, false)
        "io.read_all" => os_fn("rt.io_read_all", [], s, false)
        "io.read_exact" => os_fn("rt.io_read_exact", [Ty.Int], Ty.Opt(Ty.Bytes), false)
        "io.write_bytes" => os_fn("rt.io_write_bytes", [Ty.Bytes], Ty.Unit, false)
        "io.exit" => os_fn("rt.io_exit", [Ty.Int], Ty.Unit, false)
        "os.signals" => os_fn("rt.os_signals", [Ty.List(s)], Ty.Chan(s), false)
        "tz.offset" => os_fn("rt.tz_offset", [s, Ty.Int], Ty.Opt(Ty.Int), false)
        "tz.system" => os_fn("rt.tz_system", [], s, false)
        "task.cancelled" => os_fn("rt.task_cancelled", [], Ty.Bool, false)
        "task.check" => os_fn("rt.task_check", [], Ty.Unit, true)
        "task.threads" => os_fn("rt.task_threads", [], Ty.Int, false)
        "task.set_threads" => os_fn("rt.task_set_threads", [Ty.Int], Ty.Unit, false)
        "time.now_ms" => os_fn("rt.time_now_ms", [], Ty.Int, false)
        "time.sleep_ms" => os_fn("rt.time_sleep_ms", [Ty.Int], Ty.Unit, false)
        _ => none

## The module name when `recv` is one of the OS modules.
fn Lower.os_module(self, recv ast.Expr) str
    for m in [
        "fs",
        "env",
        "io",
        "time",
        "path",
        "proc",
        "net",
        "compress",
        "bytes",
        "tz",
        "os",
        "hw",
        "task",
    ]
        if is_module(recv, m)
            return m
    ""

## The module name when `recv` is a standard module written in the
## runtime (ADR 0614), unless the program has its own module of the name.
fn Lower.std_module(self, recv ast.Expr) str
    for m in ["hash", "random", "crypto"]
        if is_module(recv, m) and not aliases.contains(m)
            return m
    ""

## `hash.NAME(...)`, `path.NAME(...)`, `random.NAME(...)`: a call of the
## runtime's `NAME_m`, typed by its declaration. `random.int` first checks
## `lo <= hi` (std.random.2).
fn Lower.lower_std_call(mut self, m str, name str, npos ast.Pos, args List[ast.Arg]) Val?
    if m == "random" and name == "shuffle"
        return lower_shuffle(npos, args)
    key := "rt.{m}_{name}"
    sig := sigs.get(key) else return unsupported(npos, "`{m}.{name}`")
    if args.len() != sig.params.len()
        return unsupported(npos, "this call of `{m}.{name}`")
    mut vs := List[int]()
    for k in 0..args.len()
        a := args[k]
        if a.label != none or a.mutable
            return unsupported(npos, "this call of `{m}.{name}`")
        mut v := lower_value(a.value, sig.params[k])?
        # `bytes` has a `str`'s layout (native-abi.md §2): `hash.sha256(b"abc")` hashes it as is.
        if v.ty == Ty.Bytes and sig.params[k] == Ty.Str
            v = Val(id: op("copy", [v.id], Ty.Str), ty: Ty.Str)
        vs.push(convert(v, sig.params[k], expr_pos(a.value)))
    if m == "random" and name == "int"
        ok := check_branch(op("le", [vs[0], vs[1]], Ty.Bool))
        trap_open("std.random.2", npos)
        say("`int` needs lo <= hi, but lo is ")
        call("rt.out_int", [vs[0]], Ty.Unit)
        say(" and hi is ")
        call("rt.out_int", [vs[1]], Ty.Unit)
        trap_close(npos)
        cur = ok
    if m == "crypto"
        crypto_checks(name, npos, vs)
    res := call(key, vs, sig.ret)
    # `std.crypto` results are `bytes`, which has a `str`'s layout.
    if m == "crypto" and sig.ret == Ty.Str
        return Val(id: op("copy", [res], Ty.Bytes), ty: Ty.Bytes)
    Val(id: res, ty: sig.ret)

## A trap `RULE: why` unless `cond` holds.
fn Lower.crypto_require(mut self, cond int, rule str, npos ast.Pos, why str)
    ok := check_branch(cond)
    trap_open(rule, npos)
    say(why)
    trap_close(npos)
    cur = ok

## `lo <= v <= hi` for the argument `v` of `crypto.name`, or a trap `rule: ...`.
fn Lower.crypto_range(mut self, rule str, name str, npos ast.Pos, v int, lo int, hi int)
    why := "`{name}` needs a value from {lo} to {hi}"
    crypto_require(op("le", [konst(lo, Ty.Int), v], Ty.Bool), rule, npos, why)
    crypto_require(op("le", [v, konst(hi, Ty.Int)], Ty.Bool), rule, npos, why)

## The length checks of `std.crypto` (std.crypto.2-4); `vs` are the lowered arguments.
fn Lower.crypto_checks(mut self, name str, npos ast.Pos, vs List[int])
    if name == "random_bytes"
        crypto_range("std.crypto.2", name, npos, vs[0], 0, 1073741824)
    if name == "hkdf_sha256"
        crypto_range("std.crypto.3", name, npos, vs[3], 0, 8160)
    if name == "pbkdf2_sha256"
        crypto_range("std.crypto.4", name, npos, vs[2], 1, 4611686018427387904)
        crypto_range("std.crypto.4", name, npos, vs[3], 0, 1048576)

## `random.shuffle(mut xs)` (std.random.4) on any list: the runtime swaps
## elements of the list's element size.
fn Lower.lower_shuffle(mut self, npos ast.Pos, args List[ast.Arg]) Val?
    if args.len() != 1 or not args[0].mutable or args[0].label != none
        return unsupported(npos, "this call of `random.shuffle`")
    v := lower_value(args[0].value, none)?
    e := v.ty.elem() else return unsupported(npos, "`random.shuffle` of a `{v.ty.name()}`")
    size := e.elem_bytes()
    call("rt.random_shuffle", [v.id, konst(size, Ty.Int)], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

## Whether the call `recv.name(...)` is an OS function that can fail.
fn Lower.os_fails(self, recv ast.Expr, name str) bool
    m := os_module(recv)
    if m == ""
        return false
    if m == "net"
        return net_module_fails(name)
    f := os_lookup(m, name) else return false
    f.fails

## `fs.NAME(...)`, `io.NAME(...)`, `env.NAME(...)`, `time.NAME(...)` and `path.NAME(...)`, from
## `lower_method`. `none` after a report.
fn Lower.lower_os_method(mut self, m str, name str, npos ast.Pos, args List[ast.Arg]) Val?
    if m == "io" and name == "eprint"
        return lower_eprint(args, npos)
    if m == "net"
        return lower_net_module(name, npos, args)
    if m == "hw"
        return lower_hw_call(name, npos, args)
    if m == "bytes" and name == "zeros"
        return lower_bytes_zeros(args, npos)
    # A struct of the module built in place: `proc.Output(status: 0, ...)`.
    if structs.contains("{m}.{name}")
        return new_struct("{m}.{name}", args, npos)
    f := os_lookup(m, name) else
        if structs.contains("{m}.{name}")
            return new_struct("{m}.{name}", args, npos)
        return unsupported(npos, "`{m}.{name}`")
    if name == "exit"
        v := os_call(f, args, npos)?
        finish(unreachable_term())
        return v
    os_call(f, args, npos)

## Emit the call of `f` with `args`.
fn Lower.os_call(mut self, f OsFn, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() > f.params.len() or args.len() + f.optional < f.params.len()
        return unsupported(pos, "`{f.rt}` with {args.len()} arguments")
    mut vs := List[int]()
    for i in 0..args.len()
        a := args[i]
        if a.label != none or a.mutable
            return unsupported(pos, "`{f.rt}` with a labelled or `mut` argument")
        v := lower_value(a.value, f.params[i])?
        if v.ty == Ty.Bytes and f.params[i] == Ty.Str and f.rt.starts_with("rt.compress_")
            # `bytes` and `str` have one layout; std.compress.1 takes either.
            vs.push(v.id)
        else
            vs.push(convert(v, f.params[i], expr_pos(a.value)))
    for i in args.len()..f.params.len()
        vs.push(konst(0, f.params[i]))
    trace_effect(f.rt, f.params, vs, pos)
    if f.fails
        vs.push(trace_line(pos))
    if f.rt == "rt.io_exit" or f.rt == "rt.time_sleep_ms"
        os_range_check(f.rt == "rt.io_exit", vs[0], pos)
    if instr.rec
        return rec_call(f, vs, pos)
    Val(id: call(f.rt, vs, f.ret), ty: f.ret)

## The argument checks of `io.exit` (status 0 to 255, std.io.4) and
## `time.sleep_ms` (not negative, std.time.2): a trap at the call, kinds 9
## and 10 of the runtime's trap messages.
fn Lower.os_range_check(mut self, is_exit bool, v int, pos ast.Pos)
    zero := konst(0, Ty.Int)
    fail := new_block()
    check(op("le", [zero, v], Ty.Bool), fail)
    if is_exit
        check(op("le", [v, konst(255, Ty.Int)], Ty.Bool), fail)
    good := cur
    seal(fail)
    cur = fail
    mut t := inst(-1, "trap", [v, zero])
    t.imm = if is_exit then 9 else 10
    t.site = site(if is_exit then "std.io.4" else "std.time.2", "range", "", pos)
    emit_void(t)
    finish(unreachable_term())
    cur = good

## `s.to_float()` (type.num.8): a `float?`.
fn Lower.lower_to_float(mut self, s Val) Val
    t := Ty.Opt(Ty.Float)
    Val(id: call("rt.str_float_opt", [s.id], t), ty: t)

## `io.eprint(x)` (std.io.3): `print`'s text on standard error.
fn Lower.lower_eprint(mut self, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != 1
        return unsupported(pos, "this `print`")
    # The text is worked out before standard output is switched to error: an
    # argument that prints (`io.eprint("{report()}")`) writes to standard output.
    mut shown := List[Val]()
    mut ipos := pos
    match args[0].value
        Interp(parts, at) =>
            ipos = at
            for p in parts
                match p
                    Lit(_) => shown.push(Val(id: -1, ty: Ty.Unit))
                    Hole(x) => shown.push(lower_value(x, none)?)
                    Fmt(x, _) => shown.push(lower_value(x, none)?)
        _ => shown.push(lower_value(args[0].value, none)?)
    call("rt.err_begin", [], Ty.Unit)
    if tk.on
        call("rt.out_lock", [], Ty.Unit)
    match args[0].value
        Interp(parts, _) =>
            for k in 0..parts.len()
                match parts[k]
                    Lit(text) => call("rt.out_str", [str_value(text)], Ty.Unit)
                    Hole(_) => out(shown[k], ipos)?
                    Fmt(_, spec) => lower_fmt_print(shown[k], spec, ipos)?
        _ => out(shown[0], pos)?
    call("rt.out_nl", [], Ty.Unit)
    if tk.on
        call("rt.out_unlock", [], Ty.Unit)
    call("rt.err_end", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

# ---- format specifications (lex.str.7, type.str.11) ----

## The text of `v` shaped by `spec` as a string value. `{x:.N}` rounds a
## float, `{x:x}` is hexadecimal; a width pads with the fill (default a
## space), numbers on the right and everything else on the left unless the
## alignment says so.
fn Lower.fmt_text(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    n := spec.precision else -1
    sflags := spec.flags
    mut text := -1
    match v.ty
        Int | Sized(_) =>
            u := if v.ty == Ty.Sized("u64") then "u" else ""
            if sflags.contains("b")
                text = call(
                    "rt.fmt_radix{if u == "" then "" else "_u"}",
                    [v.id, konst(2, Ty.Int)],
                    Ty.Str,
                )
            else
                text = call(
                    if spec.hex then "rt.fmt_hex{if u == "" then "" else "_u"}" else "rt.fmt_{if u == "" then "int" else "u64"}",
                    [v.id],
                    Ty.Str,
                )
        Float | F32 =>
            if sflags.contains("e")
                text = call(
                    "rt.fmt_exp",
                    [v.id, konst(n, Ty.Int), konst(if v.ty == Ty.F32 then 1 else 0, Ty.Int)],
                    Ty.Str,
                )
            elif n >= 0
                text = call("rt.fmt_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Str)
            elif v.ty == Ty.F32
                text = call("rt.fmt_f32", [v.id], Ty.Str)
            else
                text = call("rt.fmt_float", [v.id], Ty.Str)
        Bool => text = call("rt.fmt_bool", [v.id], Ty.Str)
        Str => text = v.id
        Char => text = call("rt.str_char", [v.id], Ty.Str)
        _ =>
            # A list, tuple, struct or enum is padded as its text form (lex.str.7).
            text = text_of(v, pos)?
    # The marks of a number (lex.str.7): `,` groups, `+` signs, `0` pads after the sign.
    if sflags.contains(",")
        text = call("rt.fmt_group", [text], Ty.Str)
    if sflags.contains("+")
        text = call("rt.fmt_plus", [text], Ty.Str)
    w := spec.width else return Val(id: text, ty: Ty.Str)
    if sflags.contains("0")
        text = call("rt.fmt_zero", [text, konst(w, Ty.Int)], Ty.Str)
    numeric := v.ty == Ty.Int or v.ty.is_sized() or v.ty.is_float()
    mut align := if numeric then 1 else 0
    if a := spec.align
        align = if a == "<" then 0 else if a == ">" then 1 else 2
    fill := spec.fill else " "
    padded := call(
        "rt.fmt_pad",
        [text, konst(w, Ty.Int), str_value(fill), konst(align, Ty.Int)],
        Ty.Str,
    )
    Val(id: padded, ty: Ty.Str)

## A `{x:spec}` piece of `print`: a float with only `.N` is written straight
## into the output buffer; anything else is built as a string first.
fn Lower.lower_fmt_print(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    plain := spec.fill == none and spec.align == none and spec.width == none and spec.flags == ""
    n := spec.precision else -1
    if plain and not spec.hex and n >= 0 and v.ty.is_float()
        call("rt.out_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    s := fmt_text(v, spec, pos)?
    call("rt.out_str", [s.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)
