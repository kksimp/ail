## Lowering the operating-system calls of the native subset (ADRs 0580-0582):
## `std.fs`, `std.env`, `std.io`, `std.time`, `.to_float()` and the format
## specifications of an interpolation (lex.str.7). Each is a call of the
## runtime in `compiler/rt/native/os.ail` and `fmt.ail`. A call that can fail
## is lowered only in an `else` (err.else.1-2): its value, then the runtime's
## status, then the fallback or the leaving statement. Error values arrive
## with lane 175; until then `else err` and `?` are reported (native.subset.1).
use ast

## A runtime function standing for a standard-library one.
struct OsFn
    ## The runtime function, e.g. `rt.fs_read_text`.
    rt str
    params List[Ty]
    ret Ty
    ## The status call a failing function is followed by (`rt.os_ok` or
    ## `rt.parse_ok`), else "".
    status str

fn os_fn(rt str, params List[Ty], ret Ty, status str) OsFn
    OsFn(rt: rt, params: params, ret: ret, status: status)

## The standard-library function `mod.name`, if the native subset has it.
fn os_lookup(mod str, name str) OsFn?
    s := Ty.Str
    key := "{mod}.{name}"
    match key
        "fs.exists" => os_fn("rt.fs_exists", [s], Ty.Bool, "")
        "fs.read_text" => os_fn("rt.fs_read_text", [s], s, "rt.os_ok")
        "fs.write_text" => os_fn("rt.fs_write_text", [s, s], Ty.Unit, "rt.os_ok")
        "fs.append_text" => os_fn("rt.fs_append_text", [s, s], Ty.Unit, "rt.os_ok")
        "fs.list_dir" => os_fn("rt.fs_list_dir", [s], Ty.List(s), "rt.os_ok")
        "fs.remove" => os_fn("rt.fs_remove", [s], Ty.Unit, "rt.os_ok")
        "fs.make_dir" => os_fn("rt.fs_make_dir", [s], Ty.Unit, "rt.os_ok")
        "fs.rename" => os_fn("rt.fs_rename", [s, s], Ty.Unit, "rt.os_ok")
        "env.get" => os_fn("rt.env_get", [s], s, "rt.os_ok")
        "env.home" => os_fn("rt.env_home", [], s, "rt.os_ok")
        "env.cwd" => os_fn("rt.env_cwd", [], s, "")
        "env.program" => os_fn("rt.env_program", [], s, "")
        "io.read_line" => os_fn("rt.io_read_line", [], s, "rt.os_ok")
        "io.read_all" => os_fn("rt.io_read_all", [], s, "")
        "io.exit" => os_fn("rt.io_exit", [Ty.Int], Ty.Unit, "")
        "time.now_ms" => os_fn("rt.time_now_ms", [], Ty.Int, "")
        "time.sleep_ms" => os_fn("rt.time_sleep_ms", [Ty.Int], Ty.Unit, "")
        _ => none

## The module name when `recv` is one of the OS modules.
fn Lower.os_module(self, recv ast.Expr) str
    for m in ["fs", "env", "io", "time"]
        if is_module(recv, m)
            return m
    ""

## What `value` is when it is a call that can fail: a standard-library call
## with a status, or `s.to_float()`.
fn Lower.fallible(self, value ast.Expr) OsFn?
    match value
        Method(recv, name, _, margs) =>
            if name == "to_float" and margs.len() == 0 and os_module(recv) == ""
                return os_fn("rt.str_to_float", [Ty.Str], Ty.Float, "rt.parse_ok")
            m := os_module(recv)
            if m == ""
                return none
            f := os_lookup(m, name) else return none
            if f.status == "" then none else f
        _ => none

## `fs.NAME(...)`, `io.NAME(...)`, `env.NAME(...)` and `time.NAME(...)` that
## cannot fail, from `lower_method`. `none` after a report. A failing one
## outside an `else` is reported.
fn Lower.lower_os_method(mut self, m str, name str, npos ast.Pos, args List[ast.Arg]) Val?
    if m == "io" and name == "eprint"
        return lower_eprint(args, npos)
    f := os_lookup(m, name) else
        return unsupported(npos, "`{m}.{name}`")
    if f.status != ""
        return unsupported(npos, "`{m}.{name}` outside `else` (error values come with lane 175)")
    if name == "exit"
        v := os_call(f, args, npos)?
        finish(unreachable_term())
        return v
    os_call(f, args, npos)

## Emit the call of `f` with `args`.
fn Lower.os_call(mut self, f OsFn, args List[ast.Arg], pos ast.Pos) Val?
    if args.len() != f.params.len()
        return unsupported(pos, "this call")
    mut vs := List[int]()
    for i in 0..args.len()
        a := args[i]
        if a.label != none or a.mutable
            return unsupported(pos, "labelled arguments")
        v := lower_value(a.value, f.params[i])?
        vs.push(convert(v, f.params[i], expr_pos(a.value)))
    Val(id: call(f.rt, vs, f.ret), ty: f.ret)

## `io.eprint(x)` (std.io.3): `print`'s text on standard error.
fn Lower.lower_eprint(mut self, args List[ast.Arg], pos ast.Pos) Val?
    call("rt.err_begin", [], Ty.Unit)
    lower_print(args, pos)?
    call("rt.err_end", [], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

## `CALL else ...` where CALL can fail (err.else.1-2): the call, its status,
## and on failure the fallback value or the leaving statement.
fn Lower.lower_os_or_else(mut self, value ast.Expr, other ast.Else, pos ast.Pos) Val?
    f := fallible(value) else
        return lower_else(value, other, pos)
    args := match value
        Method(recv, name, _, margs) =>
            if name == "to_float" and margs.len() == 0 and os_module(recv) == ""
                [ast.Arg(label: none, mutable: false, moved: false, value: recv, param: none)]
            else
                margs
        _ => []
    r := os_call(f, args, pos)?
    ok := call(f.status, [], Ty.Bool)
    join := new_block()
    mut res := -1
    if not f.ret.is_unit()
        res = new_value(f.ret, "")
        blocks[join].params.push(res)
    fail := new_block()
    branch(ok, join, if f.ret.is_unit() then[] else [r.id], fail, [])
    seal(fail)
    cur = fail
    match other
        Fallback(x) =>
            if f.ret.is_unit()
                lower_value(x, none)?
                jump(join, [])
            else
                fb := lower_value(x, f.ret)?
                jump(join, [convert(fb, f.ret, pos)])
        Leave(st) =>
            lower_stmt(st)
            if not done()
                problem(pos, "this `else` must leave: `return`, `break` or `continue`")
        Handler(err, body, hpos) =>
            if err != none
                problem(
                    hpos,
                    "`else err` isn't in the native subset yet: error values come with lane 175",
                )
            elif f.ret.is_unit()
                lower_block(body, false)
                if not done()
                    jump(join, [])
            else
                fb := lower_block(body, true)
                if not done()
                    if v := fb
                        jump(join, [convert(v, f.ret, hpos)])
                    else
                        problem(hpos, "this `else` must leave or end with a value")
    seal(join)
    cur = join
    if f.ret.is_unit()
        return Val(id: -1, ty: Ty.Unit)
    Val(id: res, ty: f.ret)

## `name := CALL else ...` for a call from `fallible`: false when `value`
## isn't one.
fn Lower.lower_os_let_else(mut self, name str, pos ast.Pos, value ast.Expr, other ast.Else) bool
    if fallible(value) == none
        return false
    v := lower_os_or_else(value, other, pos) else
        declare(name, Ty.Unknown, -1)
        return true
    declare(name, v.ty, v.id)
    true

# ---- format specifications (lex.str.7, type.str.11) ----

## The text of `v` shaped by `spec` as a string value. `{x:.N}` rounds a
## float, `{x:x}` is hexadecimal; a width pads with the fill (default a
## space), numbers on the right and everything else on the left unless the
## alignment says so.
fn Lower.fmt_text(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    n := spec.precision else -1
    mut text := -1
    match v.ty
        Int =>
            text = call(if spec.hex then "rt.fmt_hex" else "rt.fmt_int", [v.id], Ty.Str)
        Float =>
            if n >= 0
                text = call("rt.fmt_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Str)
            else
                text = call("rt.fmt_float", [v.id], Ty.Str)
        Bool => text = call("rt.fmt_bool", [v.id], Ty.Str)
        Str => text = v.id
        Char => text = call("rt.str_char", [v.id], Ty.Str)
        _ => return unsupported(pos, "a format specification on a `{v.ty.name()}`")
    w := spec.width else return Val(id: text, ty: Ty.Str)
    numeric := v.ty == Ty.Int or v.ty.is_float()
    mut align := if numeric then 1 else 0
    if a := spec.align
        align = if a == "<" then 0 else if a == ">" then 1 else 2
    fill := spec.fill else " "
    padded := call(
        "rt.fmt_pad",
        [text, konst(w, Ty.Int), str_value(fill), konst(align, Ty.Int)],
        Ty.Str,
    )
    Val(id: padded, ty: Ty.Str)

## A `{x:spec}` piece of `print`: a float with only `.N` is written straight
## into the output buffer; anything else is built as a string first.
fn Lower.lower_fmt_print(mut self, v Val, spec ast.FormatSpec, pos ast.Pos) Val?
    plain := spec.fill == none and spec.align == none and spec.width == none
    n := spec.precision else -1
    if plain and not spec.hex and n >= 0 and v.ty.is_float()
        call("rt.out_float_fixed", [v.id, konst(n, Ty.Int)], Ty.Unit)
        return Val(id: -1, ty: Ty.Unit)
    s := fmt_text(v, spec, pos)?
    call("rt.out_str", [s.id], Ty.Unit)
    Val(id: -1, ty: Ty.Unit)

## `CALL else ...` as a statement (err.else.1-2): the OS calls, whose value,
## if any, is dropped.
fn Lower.lower_os_handle(mut self, value ast.Expr, other ast.Else)
    pos := expr_pos(value)
    lower_os_or_else(value, other, pos)
