## Reusing lists that don't outlive a loop iteration (ADR 0824). A list made
## empty inside a loop (`mut perm := []` at the top of the body) is a new
## heap object every iteration, with its elements block regrown by the
## pushes that fill it. When nothing keeps the list past the iteration,
## the loop's preheader makes one list instead, and each iteration empties
## it (its length set to 0, its capacity kept) where the old code made a
## new one. The program can't tell: no reference to last iteration's list
## is left when it is emptied (native.reuse.1).
##
## A list escapes when it is stored (`set`, `stx`, `store`, a `push` of the
## list itself), returned, passed to a function value, a primitive or a
## runtime function not listed in KEEPS_NOTHING, or passed to a function
## whose parameter escapes there. Values joined by `copy` or by a jump's
## arguments to a block's parameters are one list for this; parameters
## start as not escaping and are marked until nothing changes, so recursion
## (`make(mut left, ...)` in binarytrees) is handled.

## Runtime functions that read or change the list in their first argument
## and keep no reference to it.
KEEPS_NOTHING := [
    "rt.list_push",
    "rt.list_pushf",
    "rt.list_pushb",
    "rt.list_pushw",
    "rt.list_pushd",
    "rt.list_copy",
    "rt.list_copy_deep",
    "rt.list_join",
    "rt.list_join_chars",
    "rt.list_reserve",
    "rt.list_rows_min",
    "rt.datarange_absmax",
]

## The calls that make a new, empty list.
MAKERS := ["rt.list_new", "rt.list_new_for"]

pub fn reuse_lists(mut m Module)
    mut by_name := Map[str, int]()
    for k in 0..m.funcs.len()
        by_name[m.funcs[k].name] = k
    # `free[f][k]`: parameter `k` of function `f` doesn't escape.
    mut free := [[true for _ in m.funcs[k].params] for k in 0..m.funcs.len()]
    mut changed := true
    while changed
        changed = false
        for k in 0..m.funcs.len()
            esc := escaping(m.funcs[k], by_name, free)
            for j in 0..m.funcs[k].params.len()
                if free[k][j] and esc.escapes[esc.root(m.funcs[k].params[j])]
                    free[k][j] = false
                    changed = true
    for k in 0..m.funcs.len()
        if not m.funcs[k].name.starts_with("rt.")
            esc := escaping(m.funcs[k], by_name, free)
            reuse_in(mut m.funcs[k], esc)

## The values of a function grouped into lists that may be the same object,
## and whether each group escapes.
struct Escape
    up List[int]
    escapes List[bool]

fn Escape.root(self, v int) int
    mut x := v
    while self.up[x] != x
        x = self.up[x]
    x

fn Escape.join(mut self, a int, b int)
    x := self.root(a)
    y := self.root(b)
    if x == y
        return
    self.up[x] = y
    if self.escapes[x]
        self.escapes[y] = true

fn Escape.mark(mut self, v int)
    self.escapes[self.root(v)] = true

fn escaping(f Func, by_name Map[str, int], free List[List[bool]]) Escape
    n := f.vals.len()
    mut e := Escape(up: [v for v in 0..n], escapes: [false for _ in 0..n])
    for blk in f.blocks
        for i in blk.insts
            if i.op == "copy"
                e.join(i.dst, i.arg(0))
        for k in 0..blk.term.targets.len()
            ps := f.blocks[blk.term.targets[k]].params
            for j in 0..blk.term.args[k].len()
                e.join(ps[j], blk.term.args[k][j])
    for blk in f.blocks
        for i in blk.insts
            for a in 0..i.argc()
                if not keeps_nothing(i, a, by_name, free)
                    e.mark(i.arg(a))
        if blk.term.value >= 0
            e.mark(blk.term.value)
    e

## Whether instruction `i` keeps no reference to its argument `a` (true for
## arguments that can't be lists).
fn keeps_nothing(i Inst, a int, by_name Map[str, int], free List[List[bool]]) bool
    match i.op
        "copy" => true
        "get" | "len" | "cap" | "data" => true
        "set" => a < 2
        "ldx" | "bounds" => true
        "stx" | "vstx" => a < 2
        "vldx" => true
        "store" => a == 0
        "load" => true
        "call" =>
            if KEEPS_NOTHING.contains(i.name)
                return a == 0 or i.name != "rt.list_push"
            if k := by_name.get(i.name)
                if not i.name.starts_with("rt.")
                    return a < free[k].len() and free[k][a]
            false
        _ => false

## The pass on one function: each list made in a loop that no earlier
## iteration's list can still be reached through is made once in the
## preheader and emptied where it was made.
fn reuse_in(mut g Func, e Escape)
    loops := find_loops(g)
    mut carried := Set[int]()
    for lp in loops
        for p in g.blocks[lp.header].params
            carried.add(e.root(p))
    # Values that are the constant 0 (an empty list's capacity).
    mut zeros := Set[int]()
    for blk in g.blocks
        for i in blk.insts
            if i.op == "const" and i.imm == 0 and i.dst >= 0
                zeros.add(i.dst)
    for b in 0..g.blocks.len()
        mut k := 0
        while k < g.blocks[b].insts.len()
            i := g.blocks[b].insts[k]
            k += 1
            # A list this pass made (its value is past the analysed ones) stays.
            if i.op != "call" or not MAKERS.contains(i.name) or i.dst < 0 or i.dst >= e.up.len()
                continue
            # A list made with room (`list_new(n)`, n not 0) is a buffer the
            # code may write by index up to n (the vector escape loop's);
            # an emptied list of capacity 0 can't stand in for it.
            if i.name == "rt.list_new" and not (i.argc() == 1 and zeros.contains(i.arg(0)))
                continue
            r := e.root(i.dst)
            if e.escapes[r]
                continue
            if carried.contains(r)
                old := dead_member(g, e, b, k - 1)
                if old >= 0
                    g.vals.push(Ty.Int)
                    g.names.push("")
                    zero := g.vals.len() - 1
                    mut z := inst(zero, "const", [])
                    z.imm = 0
                    mut wipe := inst(-1, "store", [old, zero])
                    wipe.imm = 0
                    mut insts := List[Inst]()
                    for x in 0..g.blocks[b].insts.len()
                        if x == k - 1
                            insts.push(z)
                            insts.push(wipe)
                            insts.push(inst(i.dst, "copy", [old]))
                        else
                            insts.push(g.blocks[b].insts[x])
                    g.blocks[b].insts = insts
                    k += 2
                continue
            lp := innermost(loops, b) else continue
            if lp.pre < 0
                continue
            # The preheader makes the list once.
            g.vals.push(g.vals[i.dst])
            g.names.push("")
            made := g.vals.len() - 1
            g.vals.push(Ty.Int)
            g.names.push("")
            zero := g.vals.len() - 1
            mut empty := inst(made, "call", [zero])
            empty.name = "rt.list_new"
            mut z := inst(zero, "const", [])
            z.imm = 0
            g.blocks[lp.pre].insts.push(z)
            g.blocks[lp.pre].insts.push(empty)
            # Here, it is emptied: its length (the word at +0) set to 0.
            g.vals.push(Ty.Int)
            g.names.push("")
            zero2 := g.vals.len() - 1
            mut z2 := inst(zero2, "const", [])
            z2.imm = 0
            mut cleared := inst(-1, "store", [made, zero2])
            cleared.imm = 0
            at := k - 1
            mut insts := List[Inst]()
            for x in 0..g.blocks[b].insts.len()
                if x == at
                    insts.push(z2)
                    insts.push(cleared)
                    insts.push(inst(i.dst, "copy", [made]))
                else
                    insts.push(g.blocks[b].insts[x])
            g.blocks[b].insts = insts
            k += 2

## The innermost loop that holds block `b`.
fn innermost(loops List[LoopInfo], b int) LoopInfo?
    mut best := -1
    for k in 0..loops.len()
        if loops[k].member[b] and (best < 0 or loops[k].blocks.len() < loops[best].blocks.len())
            best = k
    if best < 0 then none else loops[best]

## Resetting in place (native.reuse.2, ADR 0826): the list made at `blocks[b].insts[at]`
## replaces another list of its group (`buf = []`) that is dead from there
## on. Returns that list's value, else -1. Every other value of the group
## must be a copy, a maker or a parameter of a block other than the entry (a
## function's own parameter belongs to the caller), the returned value must
## be defined before every path to `at`, and no value of the group but the
## new list may be read after `at`.
fn dead_member(f Func, e Escape, b int, at int) int
    made := f.blocks[b].insts[at].dst
    r := e.root(made)
    defs := defs_of(f)
    dom := dominators(f)
    mut inside := Set[int]()
    mut members := List[int]()
    for v in 0..e.up.len()
        if e.root(v) != r
            continue
        members.push(v)
        inside.add(v)
        if v == made
            continue
        d := defs[v]
        if d.at < 0
            if d.block == 0
                return -1
        else
            op := f.blocks[d.block].insts[d.at]
            if op.op != "copy" and not (op.op == "call" and MAKERS.contains(op.name))
                return -1
    n := f.blocks.len()
    mut live_in := [Set[int]() for _ in 0..n]
    mut changed := true
    while changed
        changed = false
        for x in 0..n
            now := live_before(f, inside, live_in, x, 0)
            if now.len() != live_in[x].len()
                live_in[x] = now
                changed = true
    for v in live_before(f, inside, live_in, b, at + 1)
        if v != made
            return -1
    for v in members
        if v == made
            continue
        d := defs[v]
        if d.block == b and d.at >= at
            continue
        if d.block != b and not dom[b][d.block]
            continue
        return v
    -1

## The members of `inside` live just before instruction `from` of block `x`
## (before its parameters when `from` is 0).
fn live_before(f Func, inside Set[int], live_in List[Set[int]], x int, from int) Set[int]
    mut live := Set[int]()
    for t in f.blocks[x].term.targets
        for v in live_in[t]
            live.add(v)
    for v in f.blocks[x].term.uses()
        if inside.contains(v)
            live.add(v)
    mut k := f.blocks[x].insts.len()
    while k > from
        k -= 1
        i := f.blocks[x].insts[k]
        if i.dst >= 0
            live.remove(i.dst)
        for v in i.operands()
            if inside.contains(v)
                live.add(v)
    if from == 0
        for p in f.blocks[x].params
            live.remove(p)
    live
