## Reusing lists that don't outlive a loop iteration (ADR 0824). A list made
## empty inside a loop (`mut perm := []` at the top of the body) is a new
## heap object every iteration, with its elements block regrown by the
## pushes that fill it. When nothing keeps the list past the iteration,
## the loop's preheader makes one list instead, and each iteration empties
## it (its length set to 0, its capacity kept) where the old code made a
## new one. The program can't tell: no reference to last iteration's list
## is left when it is emptied (native.reuse.1).
##
## A list escapes when it is stored (`set`, `stx`, `store`, a `push` of the
## list itself), returned, passed to a function value, a primitive or a
## runtime function not listed in KEEPS_NOTHING, or passed to a function
## whose parameter escapes there. Values joined by `copy` or by a jump's
## arguments to a block's parameters are one list for this; parameters
## start as not escaping and are marked until nothing changes, so recursion
## (`make(mut left, ...)` in binarytrees) is handled.

## Runtime functions that read or change the list in their first argument
## and keep no reference to it.
KEEPS_NOTHING := [
    "rt.list_push",
    "rt.list_pushf",
    "rt.list_pushb",
    "rt.list_copy",
    "rt.list_copy_deep",
    "rt.list_join",
    "rt.list_join_chars",
    "rt.list_reserve",
    "rt.list_rows_min",
]

## The calls that make a new, empty list.
MAKERS := ["rt.list_new", "rt.list_new_for"]

pub fn reuse_lists(m Module) Module
    mut by_name := Map[str, int]()
    for k in 0..m.funcs.len()
        by_name[m.funcs[k].name] = k
    # `free[f][k]`: parameter `k` of function `f` doesn't escape.
    mut free := [[true for _ in f.params] for f in m.funcs]
    mut changed := true
    while changed
        changed = false
        for k in 0..m.funcs.len()
            f := m.funcs[k]
            esc := escaping(f, by_name, free)
            for j in 0..f.params.len()
                if free[k][j] and esc.escapes[esc.root(f.params[j])]
                    free[k][j] = false
                    changed = true
    mut out := m
    for k in 0..out.funcs.len()
        if not out.funcs[k].name.starts_with("rt.")
            out.funcs[k] = reuse_in(out.funcs[k], escaping(out.funcs[k], by_name, free))
    out

## The values of a function grouped into lists that may be the same object,
## and whether each group escapes.
struct Escape
    up List[int]
    escapes List[bool]

fn Escape.root(self, v int) int
    mut x := v
    while up[x] != x
        x = up[x]
    x

fn Escape.join(mut self, a int, b int)
    x := root(a)
    y := root(b)
    if x == y
        return
    up[x] = y
    if escapes[x]
        escapes[y] = true

fn Escape.mark(mut self, v int)
    escapes[root(v)] = true

fn escaping(f Func, by_name Map[str, int], free List[List[bool]]) Escape
    n := f.vals.len()
    mut e := Escape(up: [v for v in 0..n], escapes: [false for _ in 0..n])
    for blk in f.blocks
        for i in blk.insts
            if i.op == "copy"
                e.join(i.dst, i.args[0])
        for k in 0..blk.term.targets.len()
            ps := f.blocks[blk.term.targets[k]].params
            for j in 0..blk.term.args[k].len()
                e.join(ps[j], blk.term.args[k][j])
    for blk in f.blocks
        for i in blk.insts
            for a in 0..i.args.len()
                if not keeps_nothing(i, a, by_name, free)
                    e.mark(i.args[a])
        if blk.term.value >= 0
            e.mark(blk.term.value)
    e

## Whether instruction `i` keeps no reference to its argument `a` (true for
## arguments that can't be lists).
fn keeps_nothing(i Inst, a int, by_name Map[str, int], free List[List[bool]]) bool
    match i.op
        "copy" => true
        "get" | "len" | "cap" | "data" => true
        "set" => a < 2
        "ldx" => true
        "stx" => a < 2
        "store" => a == 0
        "load" => true
        "call" =>
            if KEEPS_NOTHING.contains(i.name)
                return a == 0 or i.name != "rt.list_push"
            if k := by_name.get(i.name)
                if not i.name.starts_with("rt.")
                    return a < free[k].len() and free[k][a]
            false
        _ => false

## The pass on one function: each list made in a loop that no earlier
## iteration's list can still be reached through is made once in the
## preheader and emptied where it was made.
fn reuse_in(f Func, e Escape) Func
    loops := find_loops(f)
    mut carried := Set[int]()
    for lp in loops
        for p in f.blocks[lp.header].params
            carried.add(e.root(p))
    mut g := f
    for b in 0..f.blocks.len()
        mut k := 0
        while k < g.blocks[b].insts.len()
            i := g.blocks[b].insts[k]
            k += 1
            # A list this pass made (its value is past the analysed ones) stays.
            if i.op != "call" or not MAKERS.contains(i.name) or i.dst < 0 or i.dst >= e.up.len()
                continue
            r := e.root(i.dst)
            if e.escapes[r] or carried.contains(r)
                continue
            lp := innermost(loops, b) else continue
            if lp.pre < 0
                continue
            # The preheader makes the list once.
            g.vals.push(g.vals[i.dst])
            g.names.push("")
            made := g.vals.len() - 1
            g.vals.push(Ty.Int)
            g.names.push("")
            zero := g.vals.len() - 1
            mut empty := inst(made, "call", [zero])
            empty.name = "rt.list_new"
            mut z := inst(zero, "const", [])
            z.imm = 0
            g.blocks[lp.pre].insts.push(z)
            g.blocks[lp.pre].insts.push(empty)
            # Here, it is emptied: its length (the word at +0) set to 0.
            g.vals.push(Ty.Int)
            g.names.push("")
            zero2 := g.vals.len() - 1
            mut z2 := inst(zero2, "const", [])
            z2.imm = 0
            mut clear := inst(-1, "store", [made, zero2])
            clear.imm = 0
            at := k - 1
            mut insts := List[Inst]()
            for x in 0..g.blocks[b].insts.len()
                if x == at
                    insts.push(z2)
                    insts.push(clear)
                    insts.push(inst(i.dst, "copy", [made]))
                else
                    insts.push(g.blocks[b].insts[x])
            g.blocks[b].insts = insts
            k += 2
    g

## The innermost loop that holds block `b`.
fn innermost(loops List[LoopInfo], b int) LoopInfo?
    mut best := -1
    for k in 0..loops.len()
        if loops[k].member[b] and (best < 0 or loops[k].blocks.len() < loops[best].blocks.len())
            best = k
    if best < 0 then none else loops[best]
