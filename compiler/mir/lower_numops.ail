## `int`'s `checked_*`, `wrapping_*` and `saturating_*` methods (type.num.12).
## The runtime functions are in rt/native/intops.ail.
use ast

## Whether `name` with `n` arguments is one of these methods.
fn is_int_num_op(name str, n int) bool
    if n == 0
        return name == "checked_neg" or name == "wrapping_neg"
    if n != 1
        return false
    for k in ["checked_add", "checked_sub", "checked_mul", "checked_div", "checked_rem"]
        if name == k
            return true
    for k in ["wrapping_add", "wrapping_sub", "wrapping_mul"]
        if name == k
            return true
    for k in ["saturating_add", "saturating_sub", "saturating_mul"]
        if name == k
            return true
    false

## `a.NAME(b)` or `a.NAME()` on an `int`.
fn Lower.int_num_method(mut self, r Val, name str, vs List[Val], npos ast.Pos) Val?
    mut args := [r.id]
    if vs.len() == 1
        args.push(convert(vs[0], Ty.Int, npos))
    if name.starts_with("checked_")
        return checked_opt(name.slice(8, name.len()), args)
    Val(id: call("rt.int_{name}", args, Ty.Int), ty: Ty.Int)

## `a.checked_OP(b)`: `some(a OP b)`, or `none` when it overflows or `b` is
## zero for `div` and `rem`.
fn Lower.checked_opt(mut self, opname str, args List[int]) Val
    t := Ty.Opt(Ty.Int)
    ok := match opname
        "div" => call("rt.int_div_ok", args, Ty.Bool)
        "rem" => op("ne", [args[1], konst(0, Ty.Int)], Ty.Bool)
        "neg" => op("ne", [args[0], konst(-9223372036854775807 - 1, Ty.Int)], Ty.Bool)
        _ => op("not", [call("rt.int_ovf_{opname}", args, Ty.Bool)], Ty.Bool)
    join := new_block()
    res := new_value(t, "")
    blocks[join].params.push(res)
    yes := new_block()
    no := new_block()
    branch(ok, yes, [], no, [])
    seal(yes)
    seal(no)
    cur = yes
    n := match opname
        "div" => op("div", args, Ty.Int)
        "rem" => call("rt.int_rem_val", args, Ty.Int)
        "neg" => call("rt.int_wrapping_neg", args, Ty.Int)
        _ => call("rt.int_wrapping_{opname}", args, Ty.Int)
    jump(join, [some(Val(id: n, ty: Ty.Int)).id])
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: res, ty: t)
