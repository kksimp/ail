## Assignment order for nested places (type.map.3, ADR 0131): in
## `a.xs[i][k] = f(mut a)` the indexes are evaluated once, before the
## right-hand side, and the containers they select are reached after it, so
## a right-hand side that rebuilds `xs` doesn't leave the store in a stale
## copy. Only a call that may touch the target's root takes this path.

use ast

## Whether evaluating `e` can change the place at `target`: a call with a
## `mut` argument, or a method on a receiver, that overlaps it.
fn Lower.rhs_touches(self, e ast.Expr, target List[str]) bool
    match e
        Try(inner, _, _) => self.rhs_touches(inner, target)
        Call(callee, args, _) =>
            # `f(..)` inside a method may be a `mut self` method of the same type.
            match callee
                Name(n, _) =>
                    if self_ty != ""
                        and traits.mut_self.contains("{self_ty}.{n}")
                        and self_slot(target[0]) >= 0
                        return true
                _ => return mut_arg_overlaps(args, target)
            mut_arg_overlaps(args, target)
        Method(recv, _, _, args) =>
            if p := place_path(recv)
                if paths_overlap(p, target)
                    return true
            mut_arg_overlaps(args, target)
        _ => false

fn mut_arg_overlaps(args List[ast.Arg], target List[str]) bool
    for a in args
        if a.mutable
            if p := place_path(a.value)
                if paths_overlap(p, target)
                    return true
    false

## `e` with every index evaluated now and replaced by a hidden variable.
fn Lower.hoist_place(mut self, e ast.Expr) ast.Expr?
    match e
        Index(r, idx, p) =>
            r2 := self.hoist_place(r)?
            ast.Expr.Index(recv: r2, index: self.hoist_value(idx)?, pos: p)
        Member(r, f, p) => Member(self.hoist_place(r)?, f, p)
        _ => e

## The value of `e`, kept in a new hidden variable; a `Name` for it.
fn Lower.hoist_value(mut self, e ast.Expr) ast.Expr?
    v := lower_value(e, none)?
    name := "~h{nvars}"
    declare(name, v.ty, v.id)
    Name(name, expr_pos(e))

fn is_nested(e ast.Expr) bool
    match e
        Index => true
        Member => true
        _ => false

## `target = value` with the order above, when it applies; whether it did.
fn Lower.assign_after_rhs(
    mut self,
    target ast.Expr,
    op ast.BinOp?,
    value ast.Expr,
    pos ast.Pos,
) bool
    if op != none
        return false
    match target
        Index(recv, index, ipos) =>
            if not is_nested(recv)
                return false
            tp := place_path(target) else return false
            if not self.rhs_touches(value, tp)
                return false
            recv2 := self.hoist_place(recv) else return true
            index2 := self.hoist_value(index) else return true
            v := lower_value(value, none) else return true
            name := "~r{nvars}"
            declare(name, v.ty, v.id)
            lower_assign_body(
                ast.Expr.Index(recv: recv2, index: index2, pos: ipos),
                none,
                Name(name, expr_pos(value)),
                pos,
            )
            true
        _ => false
