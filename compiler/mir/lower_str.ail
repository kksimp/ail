## Strings and characters in the native subset (native.str.1, ADRs 0565-0567): interpolation
## as a value, comparison, the `str` and `char` methods, and the text form of
## numbers. Each method is one call of a runtime function in
## `compiler/rt/native/str.ail`; a method that can trap passes the constant
## head and source excerpt of its position (native-abi.md §7), so the runtime
## prints the interpreter's trap byte for byte.
use ast

## `'x'` (type.char.1): the scalar value, as a `char`.
fn Lower.lower_char(mut self, text str) Val
    Val(id: konst(text.chars()[0].code(), Ty.Char), ty: Ty.Char)

## `"a{x}b"` as a value (lex.str.5): the pieces' text, joined. With only
## string pieces, up to six become one `rt.str_catN` call (one allocation);
## more are joined five at a time onto what is built so far (ADR 0768). With
## a number, `char` or `bool` hole, every hole is evaluated first (a hole may
## itself interpolate), then the pieces are written into the runtime's
## builder and the result is allocated once, with no string made for the
## number (ADR 0837).
fn Lower.lower_interp_value(mut self, parts List[ast.InterpPart], pos ast.Pos) Val?
    mut pieces := List[int]()
    # How each piece is written: 0 a string, 1 an `int`, 2 a `char`, 3 a `bool`.
    mut kinds := List[int]()
    mut scalars := 0
    for p in parts
        mut piece := -1
        mut kind := 0
        match p
            Lit(text) =>
                if text != ""
                    piece = str_value(text)
            Hole(x) =>
                v := lower_value(x, none)?
                match v.ty
                    Int =>
                        piece = v.id
                        kind = 1
                    Char =>
                        piece = v.id
                        kind = 2
                    Bool =>
                        piece = v.id
                        kind = 3
                    _ => piece = text_of(v, expr_pos(x))?
            Fmt(x, spec) =>
                v := lower_value(x, none)?
                f := fmt_text(v, spec, expr_pos(x))?
                piece = f.id
        if piece >= 0
            pieces.push(piece)
            kinds.push(kind)
            if kind != 0
                scalars += 1
    if pieces.len() == 0
        return Val(id: str_value(""), ty: Ty.Str)
    if scalars > 0
        call("rt.sb_begin", [], Ty.Unit)
        for k in 0..pieces.len()
            name := if kinds[k]
                == 0 then "rt.sb_text" else if kinds[k]
                == 1 then "rt.put_int" else if kinds[k]
                == 2 then "rt.sb_add_char" else "rt.put_bool"
            call(name, [pieces[k]], Ty.Unit)
        return Val(id: call("rt.sb_str", [], Ty.Str), ty: Ty.Str)
    mut acc := pieces[0]
    mut at := 1
    while at < pieces.len()
        take := if pieces.len() - at < 5 then pieces.len() - at else 5
        mut args := [acc]
        for k in 0..take
            args.push(pieces[at + k])
        name := if take == 1 then "rt.str_cat" else "rt.str_cat{take + 1}"
        acc = call(name, args, Ty.Str)
        at += take
    Val(id: acc, ty: Ty.Str)

## The text form of a value (type.str.3), as a `str` value.
fn Lower.text_of(mut self, v Val, pos ast.Pos) int?
    if v.ty == Ty.Sized("u64")
        return call("rt.fmt_u64", [v.id], Ty.Str)
    if v.ty == Ty.List(Ty.Sized("u64"))
        return value_text(v.ty, v.id)
    match v.ty
        Str => v.id
        Bytes => call("rt.bytes_show", [v.id], Ty.Str)
        Int | Sized(_) => call("rt.fmt_int", [v.id], Ty.Str)
        Float => call("rt.fmt_float", [v.id], Ty.Str)
        F32 => call("rt.fmt_f32", [v.id], Ty.Str)
        Bool => call("rt.fmt_bool", [v.id], Ty.Str)
        Char => call("rt.str_char", [v.id], Ty.Str)
        Tensor(_) => call("rt.tensor_text", [v.id], Ty.Str)
        List(e) =>
            if e == Ty.Int
                return call("rt.fmt_int_list", [v.id], Ty.Str)
            if s := display_call(v)
                return s
            # A list of strings, floats, bools or sized numbers: its elements in order (type.str.3).
            if e == Ty.Str or e == Ty.Float or e == Ty.Bool or e.is_sized()
                return list_text(v.id, e)
            problem(pos, "not in the native subset yet: the text of a `{v.ty.name()}`")
            none
        _ =>
            if s := display_call(v)
                return s
            problem(pos, "not in the native subset yet: the text of a `{v.ty.name()}`")
            none

## The constant text of a trap's first line, `PATH:LINE:COL: trap[RULE]: `
## (native-abi.md §7), as a string value.
fn Lower.trap_head(mut self, rule str, pos ast.Pos) int
    str_value("{src_paths[file]}:{pos.line}:{pos.col}: trap[{rule}]: ")

## The source excerpt that follows a trap's message.
fn Lower.trap_tail(mut self, pos ast.Pos) int
    lines := src_lines[file]
    line := if pos.line >= 1 and pos.line <= lines.len() then lines[pos.line - 1] else ""
    gutter := "{pos.line}"
    mut pad := List[str]()
    chars := line.chars()
    for c in 0..pos.col - 1
        pad.push(if c < chars.len() and chars[c] == '\t' then "\t" else " ")
    str_value("  {gutter} | {line}\n  {" ".repeat(gutter.chars().len())} | {pad.join("")}^\n{trap_frame(pos)}")

## A `str` or `char` argument of a search method (type.str.6) as a `str` value.
fn Lower.text_arg(mut self, v Val, name str, pos ast.Pos) int?
    match v.ty
        Str => v.id
        Char => call("rt.str_char", [v.id], Ty.Str)
        _ =>
            problem(pos, "`.{name}()` needs a `str` or `char`, found `{v.ty.name()}`")
            none

fn Lower.int_arg(mut self, v Val, name str, pos ast.Pos) int?
    if v.ty == Ty.Int
        return v.id
    problem(pos, "`.{name}()` needs an `int`, found `{v.ty.name()}`")
    none

## `s.to_int()` as a value (type.str.5): an `int?`, absent when `s` isn't a
## whole number that fits.
fn Lower.str_to_int_opt(mut self, r Val) Val
    t := Ty.Opt(Ty.Int)
    n := call("rt.str_to_int", [r.id], Ty.Int)
    ok := call("rt.parse_ok", [], Ty.Bool)
    join := new_block()
    res := new_value(t, "")
    blocks[join].params.push(res)
    yes := new_block()
    no := new_block()
    branch(ok, yes, [], no, [])
    seal(yes)
    seal(no)
    cur = yes
    jump(join, [some(Val(id: n, ty: Ty.Int)).id])
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: res, ty: t)

## The methods whose result is an optional that the subset lacks: `to_float`
## has its own `else` form (lane 177).
fn Lower.str_unsupported(mut self, name str, npos ast.Pos) Val?
    if name == "to_float"
        return unsupported(npos, "`.{name}()` on `str` (its result is an optional)")
    unsupported(npos, "`.{name}()` on `str`")

## `s.NAME(...)` (type.str.3-14). `none` after a problem.
fn Lower.lower_str_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    n := vs.len()
    if n == 0
        match name
            "len" => return Val(id: call("rt.str_len", [r.id], Ty.Int), ty: Ty.Int)
            "byte_len" => return Val(id: call("rt.str_byte_len", [r.id], Ty.Int), ty: Ty.Int)
            "is_empty" =>
                n0 := call("rt.str_byte_len", [r.id], Ty.Int)
                return Val(id: op("eq", [n0, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
            "to_str" => return r
            "to_int" => return str_to_int_opt(r)
            "to_bytes" => return Val(id: call("rt.str_to_bytes", [r.id], Ty.Bytes), ty: Ty.Bytes)
            "chars" =>
                t := Ty.List(Ty.Char)
                return Val(id: call("rt.str_chars", [r.id], t), ty: t)
            "lines" =>
                t := Ty.List(Ty.Str)
                return Val(id: call("rt.str_lines", [r.id], t), ty: t)
            "trim" | "trim_start" | "trim_end" =>
                return Val(id: call("rt.str_{name}", [r.id], Ty.Str), ty: Ty.Str)
            "words" =>
                t := Ty.List(Ty.Str)
                return Val(id: call("rt.str_words", [r.id], t), ty: t)
            "to_upper" => return Val(id: call("rt.str_to_upper", [r.id], Ty.Str), ty: Ty.Str)
            "to_lower" => return Val(id: call("rt.str_to_lower", [r.id], Ty.Str), ty: Ty.Str)
            _ => return str_unsupported(name, npos)
    if n == 1
        match name
            "contains" | "starts_with" | "ends_with" =>
                a := text_arg(vs[0], name, npos)?
                return Val(id: call("rt.str_{name}", [r.id, a], Ty.Bool), ty: Ty.Bool)
            "split" =>
                a := text_arg(vs[0], name, npos)?
                h := trap_head("type.str.4", npos)
                t := Ty.List(Ty.Str)
                return Val(id: call("rt.str_split", [r.id, a, h, trap_tail(npos)], t), ty: t)
            "repeat" =>
                k := int_arg(vs[0], name, npos)?
                h3 := trap_head("type.str.10", npos)
                h4 := trap_head("type.str.15", npos)
                return Val(
                    id: call("rt.str_repeat", [r.id, k, h3, h4, trap_tail(npos)], Ty.Str),
                    ty: Ty.Str,
                )
            "find" =>
                a := text_arg(vs[0], name, npos)?
                t := Ty.Opt(Ty.Int)
                return Val(id: call("rt.str_find_opt", [r.id, a], t), ty: t)
            "rfind" =>
                a := text_arg(vs[0], name, npos)?
                t := Ty.Opt(Ty.Int)
                return Val(id: call("rt.str_rfind_opt", [r.id, a], t), ty: t)
            "count" =>
                a := text_arg(vs[0], name, npos)?
                h := trap_head("type.str.18", npos)
                return Val(
                    id: call("rt.str_count", [r.id, a, h, trap_tail(npos)], Ty.Int),
                    ty: Ty.Int,
                )
            "to_int" => return str_to_int_radix(r, vs[0], npos)
            "char_at" =>
                i := int_arg(vs[0], name, npos)?
                t := Ty.Opt(Ty.Char)
                return Val(id: call("rt.str_char_at", [r.id, i], t), ty: t)
            "strip_prefix" | "strip_suffix" =>
                if not (vs[0].ty == Ty.Str)
                    problem(npos, "`.{name}()` needs a `str`, found `{vs[0].ty.name()}`")
                    return none
                t := Ty.Opt(Ty.Str)
                return Val(id: call("rt.str_{name}", [r.id, vs[0].id], t), ty: t)
            _ => return str_unsupported(name, npos)
    if n == 2
        match name
            "split" =>
                a := text_arg(vs[0], name, npos)?
                limit := int_arg(vs[1], name, npos)?
                h := trap_head("type.str.4", npos)
                t := Ty.List(Ty.Str)
                return Val(
                    id: call("rt.str_split_n", [r.id, a, limit, h, trap_tail(npos)], t),
                    ty: t,
                )
            "slice" =>
                a := int_arg(vs[0], name, npos)?
                b := int_arg(vs[1], name, npos)?
                h := trap_head("type.str.13", npos)
                return Val(
                    id: call("rt.str_slice", [r.id, a, b, h, trap_tail(npos)], Ty.Str),
                    ty: Ty.Str,
                )
            "replace" =>
                a := text_arg(vs[0], name, npos)?
                b := text_arg(vs[1], name, npos)?
                h := trap_head("type.str.14", npos)
                return Val(
                    id: call("rt.str_replace", [r.id, a, b, h, trap_tail(npos)], Ty.Str),
                    ty: Ty.Str,
                )
            "pad_left" | "pad_right" | "center" =>
                w := int_arg(vs[0], name, npos)?
                if not (vs[1].ty == Ty.Char)
                    problem(npos, "`.{name}()` needs a `char` fill, found `{vs[1].ty.name()}`")
                    return none
                align := if name == "pad_left" then 1 else if name == "center" then 2 else 0
                h := trap_head("type.str.15", npos)
                return Val(
                    id: call(
                        "rt.str_pad_checked",
                        [r.id, w, vs[1].id, konst(align, Ty.Int), h, trap_tail(npos)],
                        Ty.Str,
                    ),
                    ty: Ty.Str,
                )
            _ => return str_unsupported(name, npos)
    str_unsupported(name, npos)

## `c.NAME(...)` on a `char` (type.char.2-4).
fn Lower.lower_char_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    if name == "cmp" and vs.len() == 1
        return lower_cmp(r, vs[0], npos)
    if vs.len() == 1 and name == "to_digit"
        radix := int_arg(vs[0], name, npos)?
        h := trap_head("type.char.3", npos)
        t := Ty.Opt(Ty.Int)
        return Val(id: call("rt.char_to_digit", [r.id, radix, h, trap_tail(npos)], t), ty: t)
    if vs.len() != 0
        return unsupported(npos, "`.{name}()` on `char`")
    match name
        "code" => Val(id: op("copy", [r.id], Ty.Int), ty: Ty.Int)
        "to_str" => Val(id: call("rt.str_char", [r.id], Ty.Str), ty: Ty.Str)
        "is_digit" | "is_alpha" | "is_alnum" | "is_space" | "is_upper" | "is_lower" =>
            Val(id: call("rt.char_{name}", [r.id], Ty.Bool), ty: Ty.Bool)
        "to_upper" => Val(id: call("rt.char_upper", [r.id], Ty.Char), ty: Ty.Char)
        "to_lower" => Val(id: call("rt.char_lower", [r.id], Ty.Char), ty: Ty.Char)
        _ => unsupported(npos, "`.{name}()` on `char`")

## `a OP b` on two strings (type.str.3): equality by bytes, order by `cmp`.
fn Lower.str_binary(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val?
    match o
        Eq =>
            Val(id: call("rt.str_eq", [a.id, b.id], Ty.Bool), ty: Ty.Bool)
        Ne =>
            e := call("rt.str_eq", [a.id, b.id], Ty.Bool)
            Val(id: op("not", [e], Ty.Bool), ty: Ty.Bool)
        Lt | Le | Gt | Ge =>
            c := call("rt.str_cmp", [a.id, b.id], Ty.Int)
            Val(id: op(op_name(o), [c, konst(0, Ty.Int)], Ty.Bool), ty: Ty.Bool)
        _ => unsupported(pos, "`{op_symbol(o)}` on `str`")

## `a OP b` on two characters: by scalar value (type.char.1).
fn Lower.char_binary(mut self, o ast.BinOp, a Val, b Val, pos ast.Pos) Val?
    if is_comparison(o)
        return Val(id: op(op_name(o), [a.id, b.id], Ty.Bool), ty: Ty.Bool)
    unsupported(pos, "`{op_symbol(o)}` on `char`")

## `char.from_code(n)` (type.char.4): a `char?`.
fn Lower.lower_char_from_code(mut self, args List[ast.Arg], npos ast.Pos) Val?
    if args.len() != 1
        return unsupported(npos, "`char.from_code` with {args.len()} arguments instead of 1")
    n := lower_value(args[0].value, Ty.Int)?
    k := int_arg(n, "from_code", npos)?
    t := Ty.Opt(Ty.Char)
    Val(id: call("rt.char_from_code", [k], t), ty: t)

## The type an argument of `r.name(...)` is lowered against: a `str` takes
## `str` arguments, except where the method's arguments are counts and
## positions (`s.slice(a, if c then 3 else 2)`).
fn str_arg_want(t Ty, name str) Ty
    if t == Ty.Str and (name == "slice" or name == "char_at" or name == "repeat")
        return Ty.Int
    t

## A method of a `str`.
fn Lower.str_method(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    if name == "cmp" and vs.len() == 1
        return lower_cmp(r, vs[0], npos)
    if name == "to_float" and vs.len() == 0
        return lower_to_float(r)
    return lower_str_method(r, name, npos, vs)

## `s.to_int(radix)` (type.str.20): an `int?` in `radix`, which traps outside 2 to 36.
fn Lower.str_to_int_radix(mut self, r Val, radix Val, pos ast.Pos) Val?
    k := int_arg(radix, "to_int", pos)?
    check_radix(k, pos)
    t := Ty.Opt(Ty.Int)
    n := call("rt.str_to_int_radix", [r.id, k], Ty.Int)
    ok := call("rt.parse_ok", [], Ty.Bool)
    join := new_block()
    res := new_value(t, "")
    blocks[join].params.push(res)
    yes := new_block()
    no := new_block()
    branch(ok, yes, [], no, [])
    seal(yes)
    seal(no)
    cur = yes
    jump(join, [some(Val(id: n, ty: Ty.Int)).id])
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: res, ty: t)

## Trap `type.str.20` unless `radix` is 2 to 36.
fn Lower.check_radix(mut self, radix int, pos ast.Pos)
    lo := binary(
        ast.BinOp.Ge,
        Val(id: radix, ty: Ty.Int),
        Val(id: konst(2, Ty.Int), ty: Ty.Int),
        pos,
    )
    hi := binary(
        ast.BinOp.Le,
        Val(id: radix, ty: Ty.Int),
        Val(id: konst(36, Ty.Int), ty: Ty.Int),
        pos,
    )
    ok1 := check_branch(lo.id)
    radix_trap(radix, pos)
    cur = ok1
    ok2 := check_branch(hi.id)
    radix_trap(radix, pos)
    cur = ok2

fn Lower.radix_trap(mut self, radix int, pos ast.Pos)
    trap_open("type.str.20", pos)
    say("a radix is 2 to 36, found ")
    describe(Val(id: radix, ty: Ty.Int), pos)
    trap_close(pos)
