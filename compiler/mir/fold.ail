## Local rewrites on simplified MIR (ADR 0391): constant folding of
## operations on constants that can't trap, checks that a constant operand
## rules out, and `x % 2^k == 0` as a bit test. Each rewrite keeps the
## value's id, so uses need no renaming; `simplify` then drops what died.

MAX := 9223372036854775807
MIN := -9223372036854775807 - 1

pub fn fold(f Func) Func
    mut g := f
    mut defs := [-1 for _ in 0..g.vals.len()]
    mut insts := List[Inst]()
    for b in 0..g.blocks.len()
        for k in 0..g.blocks[b].insts.len()
            i := g.blocks[b].insts[k]
            if i.dst >= 0
                defs[i.dst] = insts.len()
            insts.push(i)
    mut fd := Folder(defs: defs, insts: insts)
    for b in 0..g.blocks.len()
        mut out := List[Inst]()
        for i in g.blocks[b].insts
            for extra in fd.rewrite(i, mut g.vals, mut g.names)
                out.push(extra)
        g.blocks[b].insts = out
    g

struct Folder
    ## The index in `insts` of each value's defining instruction, or -1.
    defs List[int]
    insts List[Inst]

fn Folder.int_of(self, v int) int?
    d := defs[v]
    if d < 0
        return none
    i := insts[d]
    if i.op == "const" then i.imm else none

fn Folder.float_of(self, v int) float?
    d := defs[v]
    if d < 0
        return none
    i := insts[d]
    if i.op == "fconst" then i.fimm else none

fn Folder.def(self, v int) Inst?
    d := defs[v]
    if d < 0 then none else insts[d]

## `i` rewritten, preceded by any instruction it now needs.
fn Folder.rewrite(mut self, i Inst, mut vals List[Ty], mut names List[str]) List[Inst]
    mut r := i
    if i.args.len() == 1
        if n := int_of(i.args[0])
            # `-1` is `neg 1`; only the smallest `int` can trap (expr.arith.1).
            if i.op == "neg" and n != MIN
                r = konst(i.dst, 0 - n)
            elif i.op == "not"
                r = konst(i.dst, 1 - n)
            elif i.op == "bnot"
                r = konst(i.dst, n.bit_not())
            elif i.op == "itof"
                r = fkonst(i.dst, n.to_float())
        elif x := float_of(i.args[0])
            if i.op == "fneg"
                r = fkonst(i.dst, -x)
    elif i.args.len() == 2
        if n := int_value(i)
            r = konst(i.dst, n)
        elif x := float_value(i)
            r = fkonst(i.dst, x)
        elif i.op == "div" or i.op == "rem"
            # expr.arith.3: a constant divisor other than 0 can't trap,
            # but for `MIN / -1` (expr.arith.1).
            if d := int_of(i.args[1])
                if d != 0 and (i.op == "rem" or d != -1)
                    r.site = -1
        elif i.op == "eq" or i.op == "ne"
            if int_of(i.args[1]) == 0
                if m := low_bits(i.args[0])
                    # x % 2^k == 0 exactly when x's low k bits are 0.
                    mask := vals.len()
                    vals.push(Ty.Int)
                    masked := vals.len()
                    vals.push(Ty.Int)
                    names.push("")
                    names.push("")
                    rem := def(i.args[0]) else i
                    band := Inst(
                        dst: masked,
                        op: "band",
                        args: [rem.args[0], mask],
                        imm: 0,
                        fimm: 0.0,
                        name: "",
                        site: -1,
                    )
                    r.args = [masked, i.args[1]]
                    defs.push(-1)
                    defs.push(-1)
                    return [konst(mask, m), band, r]
    if r.dst >= 0
        defs[r.dst] = insts.len()
        insts.push(r)
    [r]

## `k - 1` when `v` is `x % k` for a constant `k = 2^n`, n >= 1.
fn Folder.low_bits(self, v int) int?
    i := def(v)?
    if i.op != "rem"
        return none
    k := int_of(i.args[1])?
    if k < 2 or k.bit_and(k - 1) != 0
        return none
    k - 1

## The result of an `int` operation on two constants, when it can't trap.
fn Folder.int_value(self, i Inst) int?
    a := int_of(i.args[0])?
    b := int_of(i.args[1])?
    match i.op
        "add" => if b >= 0 and a <= MAX - b or b < 0 and a >= MIN - b then a + b else none
        "sub" => if b <= 0 and a <= MAX + b or b > 0 and a >= MIN + b then a - b else none
        "mul" =>
            if small(a) and small(b) then a * b else none
        "band" => a.bit_and(b)
        "bor" => a.bit_or(b)
        "bxor" => a.bit_xor(b)
        "eq" => if a == b then 1 else 0
        "ne" => if a != b then 1 else 0
        "lt" => if a < b then 1 else 0
        "le" => if a <= b then 1 else 0
        "gt" => if a > b then 1 else 0
        "ge" => if a >= b then 1 else 0
        _ => none

## The result of a `float` operation on two constants.
fn Folder.float_value(self, i Inst) float?
    a := float_of(i.args[0])?
    b := float_of(i.args[1])?
    match i.op
        "fadd" => a + b
        "fsub" => a - b
        "fmul" => a * b
        "fdiv" => if b != 0.0 then a / b else none
        _ => none

## |n| < 2^31.5, so a product of two such can't overflow.
fn small(n int) bool
    n >= -3037000499 and n <= 3037000499

fn konst(dst int, n int) Inst
    Inst(dst: dst, op: "const", args: [], imm: n, fimm: 0.0, name: "", site: -1)

fn fkonst(dst int, x float) Inst
    Inst(dst: dst, op: "fconst", args: [], imm: 0, fimm: x, name: "", site: -1)
