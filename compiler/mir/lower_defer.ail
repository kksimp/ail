## `defer S` (own.defer.1-3): `S` runs when the enclosing block is left, last
## deferred first. Lowering keeps the deferred statements of each open block
## (`Facts.defers`) and emits them where the block is left: at its end, at a
## `return` or a failing `?` (every open block), and at `break` or `continue`
## (the blocks inside the loop).
use ast

## A block begins.
fn Lower.defer_enter(mut self)
    facts.defers.push([])
    facts.defer_loops.push(loops.len())
    uniq.depths.push(scopes.len())
    unwind_enter()
    # A block releases the `move` parameters and the `if x := e` binding that
    # were declared just before it (lower_unique.ail).
    for key in uniq.pending
        facts.defers[facts.defers.len() - 1].push(drop_marker(key))
        unwind_own(key)
    uniq.pending = []

## `defer st` in the current block.
fn Lower.defer_note(mut self, st ast.Stmt)
    facts.defers[facts.defers.len() - 1].push(st)
    unwind_defer(st)

## The block ends: its deferred statements run unless the block already left.
fn Lower.defer_exit(mut self)
    if not done()
        defer_run_from(facts.defers.len() - 1)
    facts.defers.pop()
    facts.defer_loops.pop()
    uniq.depths.pop()
    unwind_exit()

## Run the deferred statements of the blocks from index `first` outwards-in,
## innermost block first and each block's last `defer` first.
fn Lower.defer_run_from(mut self, first int)
    unwind_cut(first)
    mut i := facts.defers.len() - 1
    while i >= first and i >= 0
        sts := facts.defers[i]
        mut k := sts.len() - 1
        while k >= 0
            if key := marker_key(sts[k])
                uniq_release(key)
            else
                lower_stmt(sts[k])
            k -= 1
        i -= 1

## A `return` or a failure leaves the function: every open block's `defer`s run.
fn Lower.defer_all(mut self)
    if facts.defers.len() > 0
        defer_run_from(0)

## `break` or `continue` leaves the blocks of the innermost loop.
fn Lower.defer_loop_exit(mut self)
    defer_loop_exit_to(loops.len())

## `break outer` or `continue outer` leaves the blocks of the loops from the
## `depth`-th one inward (expr.loop.10).
fn Lower.defer_loop_exit_to(mut self, depth int)
    mut first := facts.defers.len()
    while first > 0 and facts.defer_loops[first - 1] >= depth
        first -= 1
    defer_run_from(first)
