## `checked_add`, `checked_sub`, `checked_mul`, `checked_div`, `checked_rem`
## and `checked_neg` on an `int` (type.num.12): the result as an `int?`, `none`
## on overflow or a zero divisor. Add, subtract and negate test the sign bits
## inline; multiply, divide and remainder ask the runtime (`rt.checked_ok`).
## The operation itself is the unchecked instruction, run only where the test
## passed. `saturating_add`, `saturating_sub` and `saturating_mul` ask the
## runtime to clamp (`rt.saturating`).
use ast

fn checked_code(name str) int
    match name
        "checked_add" => 0
        "checked_sub" => 1
        "checked_mul" => 2
        "checked_div" => 3
        "checked_rem" => 4
        "checked_neg" => 5
        _ => -1

fn saturating_code(name str) int
    match name
        "saturating_add" => 0
        "saturating_sub" => 1
        "saturating_mul" => 2
        _ => -1

fn Lower.int_checked(mut self, r Val, name str, npos ast.Pos, vs List[Val]) Val?
    sat := saturating_code(name)
    if sat >= 0
        if r.ty != Ty.Int or vs.len() != 1 or vs[0].ty != Ty.Int
            return none
        return Val(
            id: call("rt.saturating", [konst(sat, Ty.Int), r.id, vs[0].id], Ty.Int),
            ty: Ty.Int,
        )
    code := checked_code(name)
    if code >= 0 and r.ty.is_sized()
        return self.sized_checked(r, code, vs)
    if code < 0 or r.ty != Ty.Int
        return none
    if (code == 5) != (vs.len() == 0) or vs.len() > 1
        return none
    if vs.len() == 1 and vs[0].ty != Ty.Int
        return none
    a := r.id
    b := if vs.len() == 1 then vs[0].id else a
    zero := konst(0, Ty.Int)
    mut ok := -1
    mut s := -1
    if code == 0
        s = op("add", [a, b], Ty.Int)
        ok = op(
            "ge",
            [op("band", [op("bxor", [a, s], Ty.Int), op("bxor", [b, s], Ty.Int)], Ty.Int), zero],
            Ty.Bool,
        )
    elif code == 1
        s = op("sub", [a, b], Ty.Int)
        ok = op(
            "ge",
            [op("band", [op("bxor", [a, b], Ty.Int), op("bxor", [a, s], Ty.Int)], Ty.Int), zero],
            Ty.Bool,
        )
    elif code == 5
        s = op("neg", [a], Ty.Int)
        ok = op("ne", [a, konst(-9223372036854775807 - 1, Ty.Int)], Ty.Bool)
    else
        ok = call("rt.checked_ok", [konst(code, Ty.Int), a, b], Ty.Bool)
    t := Ty.Opt(Ty.Int)
    yes := new_block()
    no := new_block()
    join := new_block()
    res := new_value(t, "")
    blocks[join].params.push(res)
    branch(ok, yes, [], no, [])
    seal(yes)
    seal(no)
    cur = yes
    if code == 2
        s = op("mul", [a, b], Ty.Int)
    elif code == 3
        s = op("div", [a, b], Ty.Int)
    elif code == 4
        s = call("rt.rem_safe", [a, b], Ty.Int)
    jump(join, [some(Val(id: s, ty: Ty.Int)).id])
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: res, ty: t)

## `checked_*` on a sized integer (type.num.14): the operation is done in 64
## bits, which no 32-bit operand pair can overflow, and the result is present
## when it is inside the type's range. `checked_div` and `checked_rem` are
## `none` for a zero divisor.
fn Lower.sized_checked(mut self, r Val, code int, vs List[Val]) Val?
    if (code == 5) != (vs.len() == 0) or vs.len() > 1
        return none
    if vs.len() == 1 and not same_ty(vs[0].ty, r.ty)
        return none
    k := sized_kind(r.ty)
    if k == "u64"
        return u64_checked(r, code, vs)
    a := r.id
    b := if vs.len() == 1 then vs[0].id else a
    t := Ty.Opt(r.ty)
    yes := new_block()
    in_lo := new_block()
    no := new_block()
    join := new_block()
    res := new_value(t, "")
    blocks[join].params.push(res)
    if code == 3 or code == 4
        branch(op("ne", [b, konst(0, Ty.Int)], Ty.Bool), yes, [], no, [])
    else
        jump(yes, [])
    seal(yes)
    cur = yes
    mut s := -1
    match code
        0 => s = op("add", [a, b], Ty.Int)
        1 => s = op("sub", [a, b], Ty.Int)
        2 => s = op("mul", [a, b], Ty.Int)
        3 => s = op("div", [a, b], Ty.Int)
        4 => s = op("rem", [a, b], Ty.Int)
        _ => s = op("neg", [a], Ty.Int)
    branch(op("ge", [s, konst(sized_lo(k), Ty.Int)], Ty.Bool), in_lo, [], no, [])
    seal(in_lo)
    cur = in_lo
    ok := new_block()
    branch(op("le", [s, konst(sized_hi(k), Ty.Int)], Ty.Bool), ok, [], no, [])
    seal(ok)
    seal(no)
    cur = ok
    jump(join, [some(Val(id: s, ty: r.ty)).id])
    cur = no
    jump(join, [konst(0, t)])
    seal(join)
    cur = join
    Val(id: res, ty: t)
