## Git dependencies and `ail.lock` (mod.pkg.6-9), as `77592931:bootstrap/src/packages/git.rs`
## (ADRs 0355-0357). The toolchain fetches a `git` dependency with the system
## `git` into `$AIL_HOME/deps/NAME-COMMIT` (`~/.ail/deps` without `AIL_HOME`):
## a plain, read-only tree without `.git`, never updated in place (mod.pkg.7).
## `ail.lock`, next to the root's `ail.pkg`, pins every git dependency of the
## graph to a commit; a build uses the locked commit while the manifest line
## still matches it (mod.pkg.8).
use ast
use syntax

## The lockfile's name (mod.pkg.8).
pub LOCK := "ail.lock"

## How the command that loads the program treats fetching and the lock. The
## command line sets these as environment variables: `AIL_PKG_WRITE_LOCK`,
## `AIL_PKG_FROZEN` (`--deterministic`), `AIL_PKG_OFFLINE` (`--deny net`) and
## `AIL_PKG_REFRESH` (`ail pkg update`: `*` or a comma-separated name list).
pub struct Options
    ## Write `ail.lock` when it is absent or stale (`run`, `test`).
    pub write_lock bool
    ## A stale lock is an error (mod.pkg.8).
    pub frozen bool
    ## Use only what the cache holds (mod.pkg.7).
    pub offline bool
    ## These dependencies (all if empty) ignore the lock (mod.pkg.9).
    pub refresh List[str]?

fn flag(name str) bool
    v := env.get(name) else ""
    v != "" and v != "0"

pub fn options() Options
    r := env.get("AIL_PKG_REFRESH") else ""
    mut refresh := List[str]()
    named := r != ""
    if named and r != "*"
        refresh = r.split(",")
    Options(
        write_lock: flag("AIL_PKG_WRITE_LOCK"),
        frozen: flag("AIL_PKG_FROZEN"),
        offline: flag("AIL_PKG_OFFLINE"),
        refresh: if named then refresh else none,
    )

fn quote(w str) str
    if w == "" or w.contains(" ") or w.contains("\t") or w.contains("#") or w.contains("\"")
        return "\"{w}\""
    w

fn same(a Source, b Source) bool
    a.url == b.url and a.kind == b.kind and a.pin == b.pin

## One `ail.lock` line: `dep NAME git URL rev|tag PIN commit SHA`.
pub struct Entry
    pub name str
    pub source Source
    pub commit str

fn Entry.line(self) str
    s := self.source
    "dep {self.name} git {quote(s.url)} {s.kind} {quote(s.pin)} commit {self.commit}\n"

## The lock as read, and the entries this load used.
pub struct Lock
    path str
    present bool
    text str
    entries List[Entry]
    pub used List[Entry]
    ## A fetch failed, so the lock isn't rewritten.
    pub failed bool

## Read `ail.lock` in `root`. A malformed line is ignored: the lock is
## generated, so it is then stale and rewritten.
pub fn read_lock(root str) Lock
    file := path.join(root, LOCK)
    mut lock := Lock(path: file, present: false, text: "", entries: [], used: [], failed: false)
    text := fs.read_text(file) else return lock
    lock.present = true
    lock.text = text
    mut n := 0
    for line in text.lines()
        n += 1
        mut ds := List[syntax.Diag]()
        ws := [w.text for w in words(line, n, mut ds)]
        if ws.len() == 8
            and ws[0] == "dep"
            and ws[2] == "git"
            and ws[6] == "commit"
            and (ws[4] == "rev" or ws[4] == "tag")
            lock.entries.push(Entry(
                name: ws[1],
                source: Source(url: ws[3], kind: ws[4], pin: ws[5]),
                commit: ws[7],
            ))
    lock

## The locked commit of dependency `name`, if its entry matches `source` and
## `ail pkg update` isn't refreshing it.
fn Lock.locked(self, name str, source Source, refresh List[str]?) str?
    if r := refresh
        if r.len() == 0 or r.contains(name)
            return none
    for e in self.entries
        if e.name == name and same(e.source, source)
            return e.commit
    none

fn Lock.render(self) str
    sorted := self.used.sorted(by: |e| e.name)
    mut s := "# Generated by `ail`; commit it. `ail pkg update NAME` refreshes an entry (mod.pkg.8-9).\n"
    for e in sorted
        s = "{s}{e.line()}"
    s

## Is the lock out of step with the manifests (mod.pkg.8)?
fn Lock.stale(self) bool
    if not self.present
        return self.used.len() > 0
    self.render() != self.text

## Entries for dependencies that no manifest declares any more.
fn Lock.extra(self) List[str]
    mut out := List[str]()
    for e in self.entries
        mut kept := false
        for u in self.used
            if u.name == e.name
                kept = true
        if not kept
            out.push(e.name)
    out.sorted()

## Write the lock if it is stale and every fetch succeeded.
fn Lock.save(self) str?
    if self.failed or not self.stale()
        return none
    fs.write_text(self.path, self.render()) else err
        return "can't write {self.path}: {err}"
    none

## `$AIL_HOME`, else `~/.ail` (mod.pkg.7).
fn home() str
    h := env.get("AIL_HOME") else ""
    if h != ""
        return h
    user := env.home() else ""
    path.join(user, ".ail")

fn deps_dir() str
    path.join(home(), "deps")

## A fetch's result: the commit and directory, or (when `msg` isn't empty) a
## mod.pkg.7 message and help line.
struct Fetched
    commit str
    dir str
    msg str
    help str

fn failed(msg str, help str) Fetched
    Fetched(commit: "", dir: "", msg: msg, help)

## How long one `git` call may take on Windows, where `GIT_TERMINAL_PROMPT=0` can't be set: 10 minutes.
GIT_WINDOWS_MS := 600000

## The name every temporary directory of a fetch starts with (ADR 1059); `remove_scrap` removes nothing else.
SCRAP_PREFIX := ".fetch-"

fn run_git(args List[str]) proc.Output ! proc.ProcError
    # Never wait on a password prompt.
    # Windows has no `env` program (ADR 1059): git runs directly there, and a credential prompt is cut off by the timeout.
    if (env.get("OS") else "") == "Windows_NT"
        return proc.run("git", args, none, GIT_WINDOWS_MS)?
    mut all := ["GIT_TERMINAL_PROMPT=0", "git"]
    all.extend(args)
    proc.run("env", all)?

## Fetch dependency `name` from `source`, at `locked` if the lock pins it:
## its commit and directory, or a mod.pkg.7 failure.
fn fetch(name str, source Source, locked str?, offline bool) Fetched
    deps := deps_dir()
    if c := locked
        dir := path.join(deps, "{name}-{c}")
        if fs.exists(dir)
            return Fetched(commit: c, dir: dir, msg: "", "")
    if offline
        return failed(
            "dependency `{name}` isn't in the cache `{deps}`, and `--deny net` refuses to fetch it",
            "run the program once without `--deny net` or `--deterministic` to fetch it",
        )
    fs.make_dir(deps) else err
        return failed(
            "can't create the cache `{deps}` for dependency `{name}`: {err}",
            "set `AIL_HOME` to a writable directory",
        )
    tmp := path.join(deps, "{SCRAP_PREFIX}{name}-{time.now_ms()}")
    result := clone(name, source, locked, tmp, deps)
    if fs.exists(tmp)
        remove_scrap(tmp, tmp)
    result

fn clone(name str, source Source, locked str?, tmp str, deps str) Fetched
    if proc.which("git") == none
        return failed(
            "can't run `git` to fetch dependency `{name}`: not found on PATH",
            "install `git`, or depend on a local copy with `path DIR`",
        )
    out := run_git(["clone", "--quiet", "--no-checkout", source.url, tmp]) else err
        return failed(
            "can't run `git` to fetch dependency `{name}`: {err}",
            "install `git`, or depend on a local copy with `path DIR`",
        )
    if out.status != 0
        mut why := "git failed"
        for l in out.err.lines()
            if l.trim() != "" and why == "git failed"
                why = l.trim()
        return failed(
            "can't fetch dependency `{name}` from `{source.url}`: {why}",
            "check the URL and the network; a repository that needs a password needs `git` credentials",
        )
    mut want := source.pin
    if source.kind == "tag"
        want = "refs/tags/{source.pin}"
    if c := locked
        want = c
    # `rev-list -n 1` peels a tag to its commit with no `^\{commit}`, which the MSYS `env` mangles on Windows.
    found := run_git(["-C", tmp, "rev-list", "-n", "1", want, "--"]) else err
        return failed("can't run `git` for dependency `{name}`: {err}", "install `git`")
    if found.status != 0
        mut what := "{source.kind} `{source.pin}`"
        mut help := "pin a {source.kind} that `{source.url}` has"
        if c := locked
            what = "the locked commit `{c}`"
            help = "`ail pkg update {name}` locks what the manifest names now"
        return failed("dependency `{name}`: `{source.url}` has no {what}", help)
    commit := found.out.trim()
    checked := run_git([
        "-C",
        tmp,
        "-c",
        "advice.detachedHead=false",
        "checkout",
        "--quiet",
        "--detach",
        commit,
    ]) else err
        return failed("can't run `git` for dependency `{name}`: {err}", "install `git`")
    if checked.status != 0
        return failed(
            "can't check out commit `{commit}` of dependency `{name}`",
            "try again; the cache may be out of space",
        )
    remove_scrap(path.join(tmp, ".git"), tmp)
    if fs.exists(path.join(tmp, ".git"))
        return failed("can't clear the repository data of `{name}`", "try again")
    dir := path.join(deps, "{name}-{commit}")
    # Another process may have fetched it meanwhile; its tree is the same.
    if not fs.exists(dir)
        fs.rename(tmp, dir) else err
            return failed(
                "can't move dependency `{name}` into the cache: {err}",
                "set `AIL_HOME` to a writable directory",
            )
        # Read-only files, writable directories, so the cache can be cleared (mod.pkg.7).
        # No std call changes a mode yet: where the tools exist (not Windows), `find` and `chmod` do it.
        if (env.get("OS") else "") != "Windows_NT"
            _f := proc.run("find", [
                dir,
                "-type",
                "f",
                "-exec",
                "chmod",
                "a-w",
                "\{}",
                "+",
            ]) else _e3
                return Fetched(commit: commit, dir: dir, msg: "", "")
    Fetched(commit: commit, dir: dir, msg: "", "")

## Remove `target`, a file or a tree inside the scratch directory `root` that this program made (ADR 1059): it
## refuses when `root` isn't named `SCRAP_PREFIX...` or `target` isn't `root` or below it, and a symbolic link
## to a directory is removed as a link, its target untouched.
fn remove_scrap(target str, root str)
    if not path.base(root).starts_with(SCRAP_PREFIX) or not target.starts_with(root)
        return
    meta := fs.metadata(target) else return
    if not meta.is_dir
        rm_file(target)
        return
    files := fs.walk(target) else return
    mut links := Set[str]()
    for f in files
        links.add(f)
    scrap_tree(target, links)

fn scrap_tree(dir str, files Set[str])
    names := fs.list_dir(dir) else return
    for name in names
        p := path.join(dir, name)
        if files.contains(p)
            rm_file(p)
            continue
        scrap_tree(p, files)
    rm_file(dir)

## `rm -f`: a failure is ignored.
fn rm_file(target str)
    fs.remove(target) else return
