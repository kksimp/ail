## Package manifests (mod.pkg.1-3, mod.pkg.6, mod.pkg.10-11, eff.cap.2, unsafe.block.3,
## unsafe.hw.1), as `parse` in `77592931:bootstrap/src/packages.rs`: an `ail.pkg` is a
## `package NAME [caps LIST] [unsafe allow|driver]` line, then one
## `dep NAME path DIR|git URL rev|tag PIN [caps LIST] [unsafe ...]` line per
## dependency. Positions in what `parse` returns are local to the file.
use ast
use syntax

## The language version this compiler implements: `ail MAJOR.MINOR` in a manifest names one (mod.pkg.10).
pub LANG_MAJOR := 0
pub LANG_MINOR := 2

## `0.2`, the version text of this compiler's language.
pub fn lang_version() str
    "{LANG_MAJOR}.{LANG_MINOR}"

## The capabilities `caps` can grant (eff.cap.1).
pub CAPABILITIES := ["fs", "env", "proc", "clock", "random", "net", "net.serve", "ui", "app", "accel"]

## A `git` dependency's source: `git URL` and its `rev` or `tag` pin (mod.pkg.6).
pub struct Source
    pub url str
    ## `rev` or `tag`
    pub kind str
    pub pin str

pub struct Dep
    pub name str
    pub pos ast.Pos
    ## `path DIR`; none for a git dependency or an error.
    pub dir str?
    pub git Source?
    pub caps List[str]
    ## The entries as written (eff.allow.10).
    pub entries List[str]
    ## `unsafe allow` on the line (unsafe.block.3).
    pub unsafe_ok bool
    ## `unsafe driver` on the line (unsafe.hw.1).
    pub driver_ok bool

pub struct Manifest
    ## The `package` line's name and where it is; none for an empty file.
    pub name str?
    pub name_pos ast.Pos
    pub caps List[str]?
    pub entries List[str]
    pub unsafe_ok bool
    pub driver_ok bool
    pub deps List[Dep]
    ## The `ail MAJOR.MINOR` line's version and where it is; none without the line (mod.pkg.10).
    pub version str?
    pub version_pos ast.Pos

pub struct Parsed
    pub manifest Manifest
    pub diags List[syntax.Diag]

struct Word
    text str
    pos ast.Pos

fn diag(rule str, at ast.Pos, msg str, help str) syntax.Diag
    syntax.Diag(rule: rule, pos: at, msg: msg, fixed: false, help: help, fix: "", edits: [])

fn is_space(c char) bool
    c == ' ' or c == '\t' or c == '\r' or c == '\u{b}' or c == '\u{c}'

## The words of one line, with their columns: whitespace separates them,
## `"..."` quotes one, and `#` starts a comment (mod.pkg.2).
fn words(line str, n int, mut diags List[syntax.Diag]) List[Word]
    chars := line.chars()
    mut out := List[Word]()
    mut i := 0
    while i < chars.len()
        if is_space(chars[i])
            i += 1
            continue
        at := ast.Pos(line: n, col: i + 1)
        if chars[i] == '#'
            break
        if chars[i] == '"'
            mut close := -1
            for j in i + 1..chars.len()
                if chars[j] == '"'
                    close = j
                    break
            if close < 0
                diags.push(diag("mod.pkg.2", at, "this quoted word has no closing `\"`", ""))
                break
            out.push(Word(text: chars[i + 1..close].join(""), pos: at))
            i = close + 1
            continue
        start := i
        while i < chars.len() and not is_space(chars[i])
            i += 1
        out.push(Word(text: chars[start..i].join(""), pos: at))
    out

fn is_name(s str) bool
    chars := s.chars()
    if chars.len() == 0
        return false
    first := chars[0]
    if not (is_lower(first) or first == '_')
        return false
    for c in chars[1..]
        if not (is_lower(c) or is_digit(c) or c == '_')
            return false
    true

## `MAJOR.MINOR` as two numbers, or none (mod.pkg.10).
fn version_parts(s str)(int, int)?
    cut := s.split(".")
    if cut.len() != 2
        return none
    for part in cut
        if part.len() == 0
            return none
        for c in part.chars()
            if not is_digit(c)
                return none
    major := cut[0].to_int() else return none
    minor := cut[1].to_int() else return none
    (major, minor)

## Is version `parts` newer than this compiler's language (mod.pkg.11)?
pub fn newer_than_compiler(parts (int, int)) bool
    parts.0 > LANG_MAJOR or (parts.0 == LANG_MAJOR and parts.1 > LANG_MINOR)

fn is_lower(c char) bool
    c >= 'a' and c <= 'z'

fn is_digit(c char) bool
    c >= '0' and c <= '9'

## The names of `caps` entries that take `=SCOPE`, as `--allow` does (eff.allow.2, eff.allow.10).
SCOPED_CAPS := ["fs", "fs.read", "fs.write", "net", "net.serve", "proc", "env"]

## `fs,env`, `all` or `none` (eff.cap.2), or with scopes `fs.read=./data,net=api.example.com` (eff.allow.10):
## the capabilities, sorted. `fs.read` and `fs.write` stand for `fs`, and `net.serve` for `net` as well.
fn caps(list str, at ast.Pos, mut diags List[syntax.Diag]) List[str]
    if list == "none"
        return []
    mut out := List[str]()
    for entry in list.split(",")
        mut name := entry
        mut scoped := false
        eq := entry.find("=")
        if eq != none
            cut := eq else 0
            name = entry.slice(0, cut)
            scoped = true
            if entry.slice(cut + 1, entry.len()) == ""
                diags.push(diag(
                    "eff.allow.2",
                    at,
                    "`{entry}` has no scope after `=`",
                    "write `{name}=SCOPE`, or `{name}` for no limit",
                ))
                continue
        if scoped and not SCOPED_CAPS.contains(name)
            diags.push(diag(
                "eff.allow.2",
                at,
                "`{name}` takes no scope",
                "scopes go on {SCOPED_CAPS.join(", ")}; write `{name}` alone",
            ))
            continue
        base := if name == "fs.read" or name == "fs.write" then "fs" else name
        if name == "all" and not scoped
            for c in CAPABILITIES
                if not out.contains(c)
                    out.push(c)
        elif CAPABILITIES.contains(base)
            if not out.contains(base)
                out.push(base)
            if name == "net.serve" and not out.contains("net")
                out.push("net")
        else
            diags.push(diag(
                "eff.cap.2",
                at,
                "`{name}` is not a capability",
                "`caps` takes a comma-separated list of {CAPABILITIES.join(", ")}, `fs.read` or `fs.write`, each with an optional `=SCOPE`, or `all` or `none`",
            ))
    out.sorted()

## The entries of a `caps` list as written, sorted without repeats (`all` is every capability).
fn cap_entries(list str) List[str]
    mut out := List[str]()
    if list == "none"
        return out
    for entry in list.split(",")
        if entry == "all"
            for c in CAPABILITIES
                if not out.contains(c)
                    out.push(c)
        elif entry != "" and not out.contains(entry)
            out.push(entry)
    out.sorted()

## The value of key `key` among a line's pairs, with the key's position.
struct Pair
    key str
    value str
    pos ast.Pos

fn find_pair(pairs List[Pair], key str) Pair?
    for p in pairs
        if p.key == key
            return p
    none

## Parse a manifest (mod.pkg.2-3, mod.pkg.6). Positions are local.
pub fn parse(src str) Parsed
    mut named := false
    mut name := ""
    mut name_pos := ast.Pos(line: 0, col: 0)
    mut m_caps := none
    mut m_entries := List[str]()
    mut m_unsafe := false
    mut m_driver := false
    mut version := none
    mut version_pos := ast.Pos(line: 0, col: 0)
    mut deps := List[Dep]()
    mut diags := List[syntax.Diag]()
    mut names := Set[str]()
    lines := src.lines()
    for li in 0..lines.len()
        ws := words(lines[li], li + 1, mut diags)
        if ws.len() == 0
            continue
        kw := ws[0].text
        kw_pos := ws[0].pos
        if kw == "ail"
            # mod.pkg.10-11: `ail MAJOR.MINOR` names the language version; it may come before or after `package`.
            if version_pos.line != 0
                diags.push(diag("mod.pkg.10", kw_pos, "an `ail.pkg` has one `ail` line", ""))
            elif ws.len() != 2
                diags.push(diag(
                    "mod.pkg.10",
                    kw_pos,
                    "`ail` needs one version",
                    "write `ail {lang_version()}`",
                ))
            elif parts := version_parts(ws[1].text)
                version = ws[1].text
                version_pos = ws[1].pos
                if newer_than_compiler(parts)
                    diags.push(diag(
                        "mod.pkg.11",
                        ws[1].pos,
                        "this package needs language version {ws[1].text}, and this compiler implements {lang_version()}",
                        "update the toolchain, or lower the line to `ail {lang_version()}`",
                    ))
            else
                diags.push(diag(
                    "mod.pkg.10",
                    ws[1].pos,
                    "`{ws[1].text}` is not a language version",
                    "write `ail MAJOR.MINOR`, such as `ail {lang_version()}`",
                ))
            continue
        if not named and kw != "package"
            diags.push(diag(
                "mod.pkg.2",
                kw_pos,
                "an `ail.pkg` starts with `package NAME`",
                "add a first line such as `package app`",
            ))
            named = true
            name = ""
            name_pos = kw_pos
        allowed := match kw
            "package" => ["caps", "unsafe"]
            "dep" => ["path", "git", "rev", "tag", "caps", "unsafe"]
            _ =>
                diags.push(diag(
                    "mod.pkg.2",
                    kw_pos,
                    "`{kw}` is not a manifest line",
                    "a line is `package NAME ...` or `dep NAME ...`",
                ))
                continue
        if ws.len() < 2
            diags.push(diag("mod.pkg.2", kw_pos, "`{kw}` needs a name", "write `{kw} NAME ...`"))
            continue
        dep_name := ws[1].text
        dep_pos := ws[1].pos
        if not is_name(dep_name)
            diags.push(diag(
                "mod.pkg.2",
                dep_pos,
                "`{dep_name}` is not a package name",
                "a package name is lowercase letters, digits and `_`, like a module directory",
            ))
        mut keys := List[Pair]()
        mut k := 2
        while k < ws.len()
            key := ws[k].text
            kpos := ws[k].pos
            if k + 1 >= ws.len()
                diags.push(diag("mod.pkg.2", kpos, "`{key}` needs a value", "write `{key} VALUE`"))
                k += 2
                continue
            value := ws[k + 1].text
            if not allowed.contains(key)
                diags.push(diag(
                    "mod.pkg.2",
                    kpos,
                    "`{key}` is not a key of a `{kw}` line",
                    "the keys are {allowed.join(", ")}",
                ))
            elif find_pair(keys, key) != none
                diags.push(diag("mod.pkg.2", kpos, "`{key}` is given twice on this line", ""))
                # The later pair replaces the earlier, as a map insert does.
                mut kept := List[Pair]()
                for p in keys
                    if p.key != key
                        kept.push(p)
                kept.push(Pair(key: key, value: value, pos: kpos))
                keys = kept
            else
                keys.push(Pair(key: key, value: value, pos: kpos))
            k += 2
        # unsafe.block.3, unsafe.hw.1: `driver` allows everything `allow` does, and hardware access.
        mut unsafe_ok := false
        mut driver_ok := false
        if u := find_pair(keys, "unsafe")
            if u.value == "allow"
                unsafe_ok = true
            elif u.value == "driver"
                unsafe_ok = true
                driver_ok = true
            else
                diags.push(diag(
                    "unsafe.block.3",
                    u.pos,
                    "`unsafe {u.value}` is not an unsafe setting",
                    "write `unsafe allow` to let this package contain `unsafe` code, or `unsafe driver` to let it reach hardware as well",
                ))
        mut grant := none
        mut grant_entries := List[str]()
        if c := find_pair(keys, "caps")
            grant = caps(c.value, c.pos, mut diags)
            grant_entries = cap_entries(c.value)
        if kw == "package"
            if named and name != ""
                diags.push(diag("mod.pkg.2", kw_pos, "an `ail.pkg` has one `package` line", ""))
                continue
            named = true
            name = dep_name
            name_pos = dep_pos
            m_caps = grant
            m_entries = grant_entries
            m_unsafe = unsafe_ok
            m_driver = driver_ok
            continue
        if names.contains(dep_name) or dep_name == "std"
            msg := if dep_name
                == "std" then "`std` is the standard library, not a package name" else "`{dep_name}` is declared twice"
            diags.push(diag("mod.pkg.4", dep_pos, msg, "give each dependency its own name"))
            continue
        names.add(dep_name)
        mut git := none
        mut dir := none
        p := find_pair(keys, "path")
        g := find_pair(keys, "git")
        if pp := p
            if gp := g
                diags.push(diag(
                    "mod.pkg.3",
                    gp.pos,
                    "a dependency has either `path` or `git`, not both",
                    "",
                ))
            else
                for kk in ["rev", "tag"]
                    if x := find_pair(keys, kk)
                        diags.push(diag(
                            "mod.pkg.6",
                            x.pos,
                            "`{kk}` pins a `git` dependency, not a `path` one",
                            "",
                        ))
                dir = pp.value
        elif gp := g
            rev := find_pair(keys, "rev")
            tag := find_pair(keys, "tag")
            if r := rev
                if tag == none
                    git = Source(url: gp.value, kind: "rev", pin: r.value)
            elif t := tag
                git = Source(url: gp.value, kind: "tag", pin: t.value)
            if git == none
                diags.push(diag(
                    "mod.pkg.6",
                    gp.pos,
                    "a `git` dependency needs exactly one of `rev` and `tag`",
                    "pin it with `rev COMMIT` or `tag TAG`",
                ))
        else
            diags.push(diag(
                "mod.pkg.3",
                dep_pos,
                "dependency `{dep_name}` has no `path` or `git`",
                "write `dep {dep_name} path DIR`",
            ))
        deps.push(Dep(
            name: dep_name,
            pos: dep_pos,
            dir: dir,
            git: git,
            caps: grant else [],
            entries: grant_entries,
            unsafe_ok: unsafe_ok,
            driver_ok: driver_ok,
        ))
    if not named
        diags.push(diag(
            "mod.pkg.2",
            ast.Pos(line: 1, col: 1),
            "an `ail.pkg` starts with `package NAME`",
            "add a first line such as `package app`",
        ))
    Parsed(
        manifest: Manifest(
            name: if named then name else none,
            name_pos: name_pos,
            caps: m_caps,
            entries: m_entries,
            unsafe_ok: m_unsafe,
            driver_ok: m_driver,
            deps: deps,
            version: version,
            version_pos: version_pos,
        ),
        diags: diags,
    )
