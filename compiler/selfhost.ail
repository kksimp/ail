## The self-hosted front end's driver (ADR 0371): run by the bootstrap and
## compared with it by the selftest.
##
##     ail run compiler/selfhost.ail tokens FILE...    the AIL lexer's tokens, as `ail api --tokens FILE`
##
## With more than one file, each file's output follows a line `== FILE`.
use syntax

fn main() !
    args := env.args()
    if args.len() < 2 or args[0] != "tokens"
        io.eprint("usage: ail run compiler/selfhost.ail tokens FILE...")
        io.exit(2)
    files := args[1..]
    for f in files
        if files.len() > 1
            print("== {f}")
        src := fs.read_text(f)?
        print(syntax.tokens_text(syntax.lex(src)))
