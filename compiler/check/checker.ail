## The checker's state and its declaration passes (ADR 0377): traits,
## types, `impl` blocks, fields, function signatures and constants, in the
## order `check_with` in `bootstrap/src/check.rs` runs them, so the
## diagnostics come out in the same order.
use ast

## A type parameter: its name and the traits it must implement (gen.bound.1).
pub struct TParam
    pub name str
    pub bounds List[int]

## A type parameter name in scope.
pub struct Scoped
    pub name str
    pub id int

## An `impl` block's trait and target, with the block's type parameters
## (`none` and `Unknown` after an error).
pub struct ImplInfo
    pub tr int?
    pub target Ty
    pub params List[int]

## A parameter of a signature: `mut`, and its type.
pub struct SigParam
    pub mutable bool
    pub ty Ty

## A function's signature (`Sig` in check.rs): `receiver` is `true` for
## `mut self`; `generics` lists the owner's parameters, then its own
## (`declared` of them), then anonymous ones (gen.anon.1).
pub struct Sig
    pub receiver bool?
    pub params List[SigParam]
    pub moves List[bool]
    pub ret Ty
    pub generics List[int]
    pub owner int
    pub declared int

## A bound check waiting until every declaration is known (gen.bound.3).
pub struct Deferred
    pub ty Ty
    pub tr int
    pub pos ast.Pos
    pub what str

pub struct Checker
    pub prog ast.Program
    pub diags List[Diag]
    pub types Map[str, Def]
    pub traits Map[str, int]
    pub tparams List[TParam]
    pub struct_params List[List[int]]
    pub enum_params List[List[int]]
    pub list_param int
    pub trait_self List[int]
    pub supers List[List[int]]
    pub impl_info List[ImplInfo]
    ## `impl` block by `"{trait}:{constructor}"` (trait.impl.6).
    pub impl_of Map[str, int]
    pub std_eq int
    pub std_ord int
    pub std_to_str int
    pub std_hash int
    pub std_ordering int
    pub std_drop int?
    pub field_types List[List[Ty]]
    pub variant_types List[List[List[Ty]]]
    pub fns Map[str, int]
    ## Methods and associated functions by `"{type}.{name}"`.
    pub methods Map[str, int]
    pub sigs List[Sig]
    pub fn_scopes List[List[Scoped]]
    pub fn_self List[Ty?]
    pub inferred List[List[Ty]]
    pub consts Map[str, int]
    pub scope List[Scoped]
    pub self_ty Ty?
    pub deferring bool
    pub deferred List[Deferred]

pub fn new_checker(p ast.Program) Checker
    Checker(
        prog: p,
        diags: [],
        types: Map[str, Def](),
        traits: Map[str, int](),
        tparams: [],
        struct_params: [],
        enum_params: [],
        list_param: 0,
        trait_self: [],
        supers: [],
        impl_info: [],
        impl_of: Map[str, int](),
        std_eq: 0,
        std_ord: 0,
        std_to_str: 0,
        std_hash: 0,
        std_ordering: 0,
        std_drop: none,
        field_types: [],
        variant_types: [],
        fns: Map[str, int](),
        methods: Map[str, int](),
        sigs: [],
        fn_scopes: [],
        fn_self: [],
        inferred: [List[Ty]() for _ in p.fns],
        consts: Map[str, int](),
        scope: [],
        self_ty: none,
        deferring: true,
        deferred: [],
    )

## The declaration passes of `check_with`, in its order.
pub fn check_declarations(p ast.Program) List[Diag]
    mut c := new_checker(p)
    c.list_param = c.new_param("T", [])
    c.collect_traits()
    c.collect_types()
    c.collect_impls()
    c.resolve_fields()
    c.check_unique_fields()
    c.collect_fns()
    c.collect_consts()
    c.check_uses()
    c.check_deferred_bounds()
    c.check_main()
    c.check_attrs()
    c.check_impls()
    c.diags

fn Checker.err(mut self, rule str, at ast.Pos, text str)
    diags.push(new_diag(rule, at, text))

fn Checker.err_help(mut self, rule str, at ast.Pos, text str, hint str)
    diags.push(new_diag(rule, at, text).with_help(hint))

fn Checker.unsupported(mut self, at ast.Pos, text str)
    diags.push(new_diag("bootstrap.unsupported", at, text))

fn Checker.new_param(mut self, n str, bounds List[int]) int
    tparams.push(TParam(name: n, bounds: bounds))
    tparams.len() - 1

fn Checker.scope_of(self, ids List[int]) List[Scoped]
    [Scoped(name: tparams[id].name, id: id) for id in ids]

fn Checker.in_scope(self, n str) bool
    for s in scope
        if s.name == n
            return true
    false

fn Checker.def_params(self, d Def) List[int]
    match d
        DStruct(s) => struct_params[s]
        DEnum(e) => enum_params[e]

fn Checker.def_name(self, d Def) str
    match d
        DStruct(s) => prog.structs[s].name
        DEnum(e) => prog.enums[e].name

fn Checker.def_pos(self, d Def) ast.Pos
    match d
        DStruct(s) => prog.structs[s].pos
        DEnum(e) => prog.enums[e].pos

fn def_ty(d Def, args List[Ty]) Ty
    match d
        DStruct(s) => Ty.Struct(s, args)
        DEnum(e) => Ty.Enum(e, args)

fn Checker.is_builtin_type(self, n str) bool
    BUILTIN_TYPES.contains(n)

## ---- Traits (traits.rs) ----

fn Checker.collect_traits(mut self)
    for i in 0..prog.traits.len()
        tr := prog.traits[i]
        n := tr.name
        if j := traits.get(n)
            if is_prelude_line(prog.traits[j].pos.line)
                err("mod.unit.1", tr.pos, "`{n}` is already a built-in trait")
            else
                err("mod.unit.1", tr.pos, "`{n}` is declared more than once in this module")
        else
            traits[n] = i
        self_param := new_param("Self", [i])
        trait_self.push(self_param)
        if is_prelude_line(tr.pos.line)
            if n == "Eq"
                std_eq = i
            elif n == "Ord"
                std_ord = i
            elif n == "ToStr"
                std_to_str = i
            elif n == "Hash"
                std_hash = i
            elif n == "Drop"
                std_drop = i
        for k in 0..tr.methods.len()
            f := prog.fns[tr.methods[k]]
            for m in tr.methods[..k]
                if prog.fns[m].name == f.name
                    err("mod.unit.1", f.pos, "`{n}.{f.name}` is declared more than once")
                    break
    collect_supers()

## Each trait's supertraits, transitively (trait.super.1).
fn Checker.collect_supers(mut self)
    mut direct := List[List[int]]()
    for tr in prog.traits
        mut ds := List[int]()
        for s in tr.supers
            if j := trait_named(s.name, s.pos, "trait.super.1")
                ds.push(j)
        direct.push(ds)
    for i in 0..prog.traits.len()
        tr := prog.traits[i]
        mut all := List[int]()
        mut pending := direct[i]
        while pending.len() > 0
            s := pending.pop() else break
            if not all.contains(s)
                all.push(s)
                pending.extend(direct[s])
        if all.contains(i)
            err_help(
                "trait.super.1",
                tr.pos,
                "`{tr.name}` requires itself through its supertraits",
                "remove one of the supertraits so they don't form a cycle",
            )
            all = [s for s in all if s != i]
        supers.push(all)

## Whether bound `b` provides trait `tr` (gen.bound.2, trait.super.3).
fn Checker.provides(self, b int, tr int) bool
    b == tr or (b < supers.len() and supers[b].contains(tr))

## The trait called `n`, reporting when there's none.
fn Checker.trait_named(mut self, n str, at ast.Pos, rule str) int?
    if j := traits.get(n)
        return j
    if types.contains(n) or is_builtin_type(n)
        err_help(
            rule,
            at,
            "`{n}` is a type, not a trait",
            "a constraint or `impl` names a trait, e.g. `Ord`",
        )
        return none
    mut d := new_diag("expr.name.1", at, "unknown trait `{n}`")
    if s := suggest(n, traits.keys())
        d = d.did_you_mean(s)
    diags.push(d)
    none

## ---- Types (check.rs) ----

fn Checker.collect_types(mut self)
    mut decls := List[Def]()
    for i in 0..prog.structs.len()
        decls.push(Def.DStruct(i))
    for i in 0..prog.enums.len()
        decls.push(Def.DEnum(i))
    for d in decls
        n := def_name(d)
        at := def_pos(d)
        mut built_in := false
        if first := types.get(n)
            built_in = is_prelude_line(def_pos(first).line)
        if BUILTIN_TYPES.contains(n) or SPEC_TYPES_NOT_YET.contains(n) or built_in
            err("mod.unit.1", at, "`{n}` is already a built-in type")
        elif types.contains(n) or traits.contains(n)
            mut dg := new_diag("mod.unit.1", at, "`{n}` is declared more than once in this module")
            if first := types.get(n)
                dg = dg.with_note(def_pos(first), "`{n}` is first declared here")
            diags.push(dg)
        else
            types[n] = d
    for i in 0..prog.enums.len()
        if prog.enums[i].name == "Ordering" and is_prelude_line(prog.enums[i].pos.line)
            std_ordering = i
            break
    for s in prog.structs
        ids := declare_generics(s.generics)
        struct_params.push(ids)
    for e in prog.enums
        ids := declare_generics(e.generics)
        enum_params.push(ids)

## The type parameters of a declaration, with their bounds (gen.decl.2, gen.bound.1).
fn Checker.declare_generics(mut self, gs List[ast.GenericParam]) List[int]
    mut ids := List[int]()
    for k in 0..gs.len()
        g := gs[k]
        n := g.name
        mut twice := in_scope(n)
        for h in gs[..k]
            if h.name == n
                twice = true
        if twice
            err("gen.decl.2", g.pos, "the type parameter `{n}` is declared twice")
        elif types.contains(n) or is_builtin_type(n) or n == "Self"
            err_help(
                "gen.decl.2",
                g.pos,
                "`{n}` is already a type",
                "choose another name for the type parameter, e.g. `T`",
            )
        elif traits.contains(n)
            err_help(
                "gen.decl.2",
                g.pos,
                "`{n}` is a trait, so it can't name a type parameter",
                "to require the trait, write `[T {n}]`",
            )
        bounds := resolve_bounds(g.bounds)
        ids.push(new_param(n, bounds))
    ids

fn Checker.resolve_bounds(mut self, bounds List[ast.Ident]) List[int]
    mut out := List[int]()
    for b in bounds
        if j := trait_named(b.name, b.pos, "gen.bound.1")
            out.push(j)
    out

fn Checker.resolve_fields(mut self)
    for i in 0..prog.enums.len()
        e := prog.enums[i]
        scope = scope_of(enum_params[i])
        mut vs := List[List[Ty]]()
        for k in 0..e.variants.len()
            v := e.variants[k]
            for w in e.variants[..k]
                if w.name == v.name
                    err("type.enum.5", v.pos, "variant `{v.name}` is declared twice in `{e.name}`")
                    break
            vs.push(field_list(v.fields, "{e.name}.{v.name}"))
        variant_types.push(vs)
    for i in 0..prog.structs.len()
        s := prog.structs[i]
        scope = scope_of(struct_params[i])
        field_types.push(field_list(s.fields, s.name))
    scope = []

## The types of a field list, reporting repeated names (type.struct.5).
fn Checker.field_list(mut self, fields List[ast.Field], owner str) List[Ty]
    mut tys := List[Ty]()
    for i in 0..fields.len()
        f := fields[i]
        for g in fields[..i]
            if g.name == f.name
                err("type.struct.5", f.pos, "field `{f.name}` is declared twice in `{owner}`")
                break
        tys.push(resolve_type(f.ty))
    tys

## The type parameters of a method's or `impl`'s owner: copies of the
## type's declared ones, with any bounds the head adds (gen.method.1-2).
fn Checker.owner_params(mut self, owner ast.Owner, declared List[int]) List[int]
    names := [tparams[d].name for d in declared]
    mut matching := true
    if given := owner.params
        matching = given.len() == names.len()
        if matching
            for k in 0..given.len()
                if given[k].name != names[k]
                    matching = false
    if not matching
        shown := if names.len() == 0
            "`{owner.name}` has no type parameters"
        else
            "`{owner.name}` has the type parameters {list_names(names)}"
        err_help(
            "gen.method.2",
            owner.pos,
            "{shown}; a method or `impl` names them in order, to add constraints",
            "write `{owner.name}` alone, or e.g. `{owner.name}[{names.join(", ")} Ord]`",
        )
    mut ids := List[int]()
    for k in 0..declared.len()
        mut bounds := tparams[declared[k]].bounds
        mut n := names[k]
        if given := owner.params
            if matching
                for b in resolve_bounds(given[k].bounds)
                    if not bounds.contains(b)
                        bounds.push(b)
            if given.len() == names.len()
                n = given[k].name
        ids.push(new_param(n, bounds))
    ids

## ---- Functions ----

fn Checker.collect_fns(mut self)
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        mut owner_ids := List[int]()
        mut own_self := no_ty()
        match f.within
            InTrait(t) =>
                owner_ids = [trait_self[t]]
                own_self = Ty.Param(trait_self[t])
            InImpl(k) =>
                owner_ids = impl_info[k].params
                own_self = impl_info[k].target
            TopLevel =>
                if o := f.owner
                    if d := types.get(o.name)
                        owner_ids = owner_params(o, def_params(d))
                        own_self = def_ty(d, [Ty.Param(p) for p in owner_ids])
        scope = scope_of(owner_ids)
        self_ty = own_self
        own := declare_generics(f.generics)
        scope.extend(scope_of(own))
        mut generics := owner_ids
        generics.extend(own)
        mut params := List[SigParam]()
        for p in f.params
            mut pty := Ty.Unknown
            mut anonymous := false
            match p.ty.shape
                Named(n, args) =>
                    if args.len() == 0 and not in_scope(n)
                        if tr := traits.get(n)
                            id := new_param(n, [tr])
                            generics.push(id)
                            pty = Ty.Param(id)
                            anonymous = true
                _ => anonymous = false
            if not anonymous
                pty = resolve_type(p.ty)
            params.push(SigParam(mutable: p.mutable, ty: pty))
        mut ret := Ty.Unit
        if r := f.ret
            ret = resolve_ret(r, i)
        is_test := [a for a in f.attrs if a.name == "test"].len() > 0
        if f.ret == none and is_test
            ret = Ty.Res(Ty.Unit, Errs.Inferred(i))
        if f.within == ast.Within.TopLevel
            and f.owner == none
            and f.name == "main"
            and not fails_only(ret)
            ret = Ty.Unit
        match f.within
            InTrait =>
                if f.generics.len() > 0
                    unsupported(
                        f.pos,
                        "type parameters on a trait's methods are not supported by the bootstrap yet",
                    )
                if is_inferred(ret)
                    mut at := f.pos
                    if r := f.ret
                        at = r.pos
                    unsupported(
                        at,
                        "a trait method lists its errors (`T ! E`); the bootstrap can't infer them across implementations",
                    )
            _ => ret = ret
        fn_scopes.push(scope)
        scope = []
        fn_self.push(own_self)
        self_ty = none
        moved := [p.moved for p in f.params]
        sigs.push(Sig(
            receiver: receiver_of(f),
            params: params,
            moves: if moved.contains(true) then moved else [],
            ret: ret,
            generics: generics,
            owner: owner_ids.len(),
            declared: own.len(),
        ))
        if f.within == ast.Within.TopLevel
            register_fn(i, f)

fn no_ty() Ty?
    none

## `true` for `mut self`, `false` for `self`, `none` without a receiver.
fn receiver_of(f ast.FnDecl) bool?
    r := f.receiver else return none
    r.mutable

## `T ! E` whose success value is nothing.
fn fails_only(t Ty) bool
    match t
        Res(ok, _) => ok == Ty.Unit
        _ => false

fn is_inferred(t Ty) bool
    match t
        Res(_, errs) =>
            match errs
                Inferred => true
                ErrSet => false
        _ => false

## Make a top-level function callable by name (mod.unit.1, trait.method.5, trait.auto.4).
fn Checker.register_fn(mut self, i int, f ast.FnDecl)
    n := f.name
    o := f.owner?.name else ""
    if f.owner == none
        if PRELUDE_FNS.contains(n)
            unsupported(
                f.pos,
                "redeclaring the prelude function `{n}` is not supported by the bootstrap",
            )
        elif fns.contains(n) or types.contains(n) or traits.contains(n)
            mut d := new_diag(
                "mod.unit.1",
                f.pos,
                "`{n}` is declared more than once in this module",
            )
            if j := fns.get(n)
                d = d.with_note(prog.fns[j].pos, "`{n}` is first declared here")
            elif t := types.get(n)
                d = d.with_note(def_pos(t), "`{n}` is first declared here")
            diags.push(d)
        else
            fns[n] = i
        return
    at := f.owner?.pos else f.pos
    if not types.contains(o)
        if BUILTIN_TYPES.contains(o) or SPEC_TYPES_NOT_YET.contains(o)
            err(
                "trait.method.5",
                at,
                "methods of `{o}` can only be declared where `{o}` is declared",
            )
        elif traits.contains(o)
            err_help(
                "trait.impl.1",
                at,
                "`{o}` is a trait; its methods are declared in its `trait` block",
                "to implement it for a type, write `impl {o} for Type` with the methods indented below",
            )
        else
            unknown_type(o, at)
        return
    if n == "eq"
        err_help(
            "trait.auto.4",
            f.pos,
            "`eq` is the method of the standard trait `Eq`, which every type has",
            "to replace `{o}`'s, write `impl Eq for {o}` with `fn eq(self, other Self) bool` indented below",
        )
    if n == "to_str"
        err_help(
            "trait.auto.4",
            f.pos,
            "`to_str` is the method of the standard trait `ToStr`, which every type has",
            "to replace `{o}`'s, write `impl ToStr for {o}` with `fn to_str(self) str` indented below",
        )
    key := "{o}.{n}"
    if j := methods.get(key)
        diags.push(
            new_diag(
                "mod.unit.1",
                f.pos,
                "`{o}.{n}` is declared more than once",
            ).with_note(prog.fns[j].pos, "`{o}.{n}` is first declared here"),
        )
    else
        methods[key] = i

## ---- Constants (mod.const.1-3) ----

## Register each constant's name and check that its value is a constant
## expression; typing the values comes with expressions.
fn Checker.collect_consts(mut self)
    for i in 0..prog.consts.len()
        c := prog.consts[i]
        n := c.name
        taken := fns.contains(n)
            or types.contains(n)
            or traits.contains(n)
            or consts.contains(n)
            or PRELUDE_FNS.contains(n)
            or BUILTIN_TYPES.contains(n)
        if taken
            mut d := new_diag(
                "mod.unit.1",
                c.pos,
                "`{n}` is declared more than once in this module",
            )
            if j := consts.get(n)
                d = d.with_note(prog.consts[j].pos, "`{n}` is first declared here")
            elif j := fns.get(n)
                d = d.with_note(prog.fns[j].pos, "`{n}` is first declared here")
            elif t := types.get(n)
                d = d.with_note(def_pos(t), "`{n}` is first declared here")
            diags.push(d)
        else
            consts[n] = i
        constant_expr(c.value)

## Report the parts of a constant's value the bootstrap can't compute (ct.const.1).
fn Checker.constant_expr(mut self, e ast.Expr)
    match e
        Interp(parts, _) =>
            for p in parts
                match p
                    Hole(x) => constant_expr(x)
                    Fmt(x, _) => constant_expr(x)
                    Lit => continue
        ListLit(items, _) =>
            for x in items
                constant_expr(x)
        SetLit(items, _) =>
            for x in items
                constant_expr(x)
        MapLit(entries, _) =>
            for m in entries
                constant_expr(m.key)
                constant_expr(m.value)
        Unary(_, operand, _) => constant_expr(operand)
        NewRef(_, at) =>
            err_help(
                "mod.const.2",
                at,
                "a constant's value can't contain a `ref` cell",
                "a constant is shared by the whole program; make the cell inside a function",
            )
        Binary(_, lhs, rhs, _) =>
            constant_expr(lhs)
            constant_expr(rhs)
        Member(recv, _, _) => constant_expr(recv)
        Call(callee, args, _) =>
            constant_expr(callee)
            for a in args
                constant_expr(a.value)
        Method(recv, _, _, args) =>
            constant_expr(recv)
            for a in args
                constant_expr(a.value)
        Index(recv, index, _) =>
            constant_expr(recv)
            constant_expr(index)
        Range(lo, hi, _, _) =>
            if x := lo
                constant_expr(x)
            if x := hi
                constant_expr(x)
        OrElse(value, otherwise, at) =>
            match otherwise
                Fallback(d) =>
                    constant_expr(value)
                    constant_expr(d)
                _ => not_constant(at, "`else` with a block or a jump", "ct.const.1")
        If(_, _, _, at) => not_constant(at, "`if`", "ct.const.1")
        Match(_, _, at) => not_constant(at, "`match`", "ct.const.1")
        Try(_, _, at) => not_constant(at, "`?`", "ct.const.3")
        _ => return

fn Checker.not_constant(mut self, at ast.Pos, what str, rule str)
    err_help(
        "bootstrap.unsupported",
        at,
        "the bootstrap can't compute {what} in a constant yet ({rule})",
        "move the logic into a function and call it: `NAME := build()`",
    )

## ---- `main`, attributes ----

fn Checker.check_main(mut self)
    for f in prog.fns
        if f.name == "main" and f.owner == none and f.within == ast.Within.TopLevel
            if f.generics.len() > 0
                err("mod.main.1", f.generics[0].pos, "`main` can't have type parameters")
            if f.params.len() > 0
                err("mod.main.1", f.params[0].pos, "`main` takes no parameters")
            mut ok := false
            if i := fns.get("main")
                ok = fails_only(sigs[i].ret)
            if r := f.ret
                if not ok
                    err_help(
                        "mod.main.1",
                        r.pos,
                        "`main` returns nothing, or only an error",
                        "write `fn main()`, or `fn main() !` if it can fail",
                    )
            return
    diags.push(
        new_diag(
            "mod.main.1",
            ast.Pos(line: 1, col: 1),
            "program has no `main` function",
        ).with_help("add:\n    fn main()\n        print(\"Hello, world!\")"),
    )

## test.attr.1-2, gram.attr.4: known attributes, and the shape of a test.
fn Checker.check_attrs(mut self)
    for f in prog.fns
        mut is_test := false
        for a in f.attrs
            if a.name == "test"
                is_test = true
            if not KNOWN_ATTRS.contains(a.name)
                known := ["`@{k}`" for k in KNOWN_ATTRS].join(", ")
                err_help(
                    "test.attr.1",
                    a.pos,
                    "unknown attribute `@{a.name}`",
                    "the known attributes are {known}",
                )
            if a.name == "deprecated" and a.arg == none
                err_help(
                    "gram.attr.4",
                    a.pos,
                    "`@deprecated` needs a reason",
                    "write `@deprecated(\"use new_name instead\")`",
                )
        if not is_test
            continue
        mut bad_shape := true
        if f.owner != none or f.within != ast.Within.TopLevel
            err_help(
                "test.attr.2",
                f.pos,
                "a test is a plain top-level function, not a method",
                "write `@test fn name()`",
            )
        elif f.generics.len() > 0
            err_help(
                "test.attr.2",
                f.generics[0].pos,
                "a test has no type parameters",
                "write `@test fn name()`",
            )
        else
            bad_shape = false
        if not bad_shape
            check_prop_params(f)
        if r := f.ret
            mut fails := false
            match r.shape
                Fallible(ok, _) => fails = ok == none
                _ => fails = false
            if not fails
                err_help(
                    "test.attr.2",
                    r.pos,
                    "a test returns nothing, or only an error",
                    "write `@test fn name()`, or `@test fn name() !` if it can fail",
                )

## test.prop.1-2: each parameter of a property must be generatable.
fn Checker.check_prop_params(mut self, f ast.FnDecl)
    for p in f.params
        mut why := ""
        if p.mutable
            why = "a property's parameters aren't `mut`"
        elif bad := ungeneratable(p.ty, [])
            why = "`ail test` can't generate values of type `{bad}`"
        if why != ""
            err_help(
                "test.prop.2",
                p.pos,
                why,
                "use `int`, `float`, `bool`, `char`, `str`, `List`, `Map`, `Set`, optionals, or structs and enums made of those",
            )

## The first part of `t` that can't be generated (test.prop.2), as written.
fn Checker.ungeneratable(self, t ast.TypeRef, seen List[str]) str?
    match t.shape
        Optional(inner) => ungeneratable(inner, seen)
        RefTo => "ref"
        PtrTo => "a raw pointer"
        AnyTrait(tr) => "any {tr}"
        Fallible => "a fallible type"
        Named(n, args) =>
            if ["int", "i64", "float", "f64", "str", "char", "bool"].contains(n) and args.len() == 0
                return none
            if ["List", "Set", "Map"].contains(n)
                for a in args
                    if bad := ungeneratable(a, seen)
                        return bad
                return none
            if args.len() > 0
                return n
            if seen.contains(n)
                return none
            mut more := seen
            more.push(n)
            for s in prog.structs
                if s.name == n
                    if s.is_error or s.generics.len() > 0
                        return n
                    for f in s.fields
                        if bad := ungeneratable(f.ty, more)
                            return bad
                    return none
            for e in prog.enums
                if e.name == n
                    if e.is_error or e.generics.len() > 0
                        return n
                    for v in e.variants
                        for f in v.fields
                            if bad := ungeneratable(f.ty, more)
                                return bad
                    return none
            n

## ---- Unique types (own.uniq.1, own.uniq.5) ----

fn Checker.is_unique(self, t Ty) bool
    match t
        Struct(i, _) => prog.structs[i].is_unique
        Enum(i, _) => prog.enums[i].is_unique
        Opt(x) => is_unique(x)
        Res(x, _) => is_unique(x)
        ListOf(x) => is_unique(x)
        MapOf(_, x) => is_unique(x)
        _ => false

fn Checker.no_unique(mut self, t Ty, at ast.Pos, what str)
    if is_unique(t)
        err_help(
            "own.uniq.5",
            at,
            "{show(t)} is a unique type, so it can't be {what}",
            "hold it in a local, a `move` parameter, or a field of another `unique` type",
        )

## unsafe.ptr.1: a raw pointer points to a type with a fixed C layout.
fn Checker.ptr_target(mut self, inner Ty, at ast.Pos)
    ok := match inner
        Int | Float | Bool | Num(_) | PtrOf(_) | Unknown => true
        _ => false
    if not ok
        err_help(
            "unsafe.ptr.1",
            at,
            "a raw pointer can't point to {show(inner)}, which has no fixed C layout",
            "point to `int`, `float`, `bool`, a sized number such as `u8`, or another pointer",
        )

fn Checker.check_unique_fields(mut self)
    for s in 0..prog.structs.len()
        decl := prog.structs[s]
        if decl.is_unique
            continue
        for f in 0..decl.fields.len()
            unique_field(field_types[s][f], decl.fields[f].ty.pos, decl.name, "struct")
    for e in 0..prog.enums.len()
        decl := prog.enums[e]
        if decl.is_unique
            continue
        for v in 0..decl.variants.len()
            for f in 0..decl.variants[v].fields.len()
                unique_field(
                    variant_types[e][v][f],
                    decl.variants[v].fields[f].ty.pos,
                    decl.name,
                    "enum",
                )

fn Checker.unique_field(mut self, t Ty, at ast.Pos, owner str, kind str)
    if is_unique(t)
        err_help(
            "own.uniq.5",
            at,
            "{show(t)} is a unique type, so a field of it makes `{owner}` unique too",
            "declare it `unique {kind} {owner}`",
        )

## ---- Standard modules (std.use.1, std.use.3) ----

fn Checker.check_uses(mut self)
    mut seen := Map[str, ast.Pos]()
    for u in prog.uses
        if u.path.len() == 0 or u.path[0].name != "std"
            continue
        dotted := [p.name for p in u.path].join(".")
        if u.path.len() == 1
            err_help(
                "std.use.1",
                u.path[0].pos,
                "`std` is a collection of modules; import one of them",
                "e.g. `use std.fs`; the standard modules are {list_names(STD_MODULES)}",
            )
            continue
        if u.path.len() == 2
            m := u.path[1]
            if not STD_MODULES.contains(m.name)
                mut d := new_diag("std.use.1", m.pos, "there is no standard module `std.{m.name}`")
                d = if s := suggest(m.name, STD_MODULES)
                    d.with_help("did you mean `use std.{s}`?")
                else
                    d.with_help("the standard modules are {list_names(STD_MODULES)}")
                diags.push(d)
                continue
        else
            if AIL_STD_MODULES.contains(dotted)
                continue
            last := u.path[u.path.len() - 1]
            err_help(
                "std.use.1",
                last.pos,
                "the standard modules have no submodules",
                "the standard modules are {list_names(STD_MODULES)}",
            )
            continue
        named := u.alias else u.path[u.path.len() - 1]
        alias := named.name
        key := "{file_of(u.pos)}/{alias}"
        if first := seen.get(key)
            diags.push(
                new_diag(
                    "std.use.3",
                    named.pos,
                    "`{alias}` is already imported",
                ).with_help("it is first imported on line {first.line}; remove one import, or import it under another name with `as`"),
            )
        else
            seen[key] = named.pos

## The path of the file a position is in, or "" for one file or the prelude.
fn Checker.file_of(self, at ast.Pos) str
    if is_prelude_line(at.line)
        return ""
    mut out := ""
    for f in prog.files
        if f.base < at.line
            out = f.path
    out

## The standard module `n` names (std.use.4): the one imported under that
## name, or the standard module called `n` unless the program declares or
## imports something else under that name.
fn Checker.std_module(self, n str) str?
    for u in prog.uses
        if u.path.len() == 2 and u.path[0].name == "std"
            alias := u.alias?.name else u.path[1].name
            if alias == n and STD_MODULES.contains(u.path[1].name)
                return u.path[1].name
    if types.contains(n) or traits.contains(n) or consts.contains(n) or fns.contains(n)
        return none
    for u in prog.uses
        alias := u.alias?.name else u.path[u.path.len() - 1].name
        if alias == n
            return none
    if STD_MODULES.contains(n) then n else none

## The module imported by an explicit `use std.NAME` under `n`.
fn Checker.std_imported(self, n str) str?
    for u in prog.uses
        if u.path.len() == 2 and u.path[0].name == "std"
            alias := u.alias?.name else u.path[1].name
            if alias == n and STD_MODULES.contains(u.path[1].name)
                return u.path[1].name
    none
