## `std.tensor` (spec 17-std, std.tensor.1-22, ADR 0328, ADR 0796), as
## `check/tensor.rs`: `tensor.from(xs, shape)`, `tensor.zeros(shape)` and
## the methods and operators of a `tensor.Tensor[T]`, where `T` is `int`,
## `float` or `f32` (std.tensor.21). A tensor has no fields (std.tensor.1).
use ast

TENSOR_METHODS := [
    "add",
    "argmax",
    "argmin",
    "clamp",
    "conv2d",
    "dot",
    "item",
    "len",
    "map",
    "matmul",
    "max",
    "mean",
    "mul",
    "relu",
    "reshape",
    "round",
    "shape",
    "sigmoid",
    "softmax",
    "sum",
    "tanh",
    "to_f32",
    "to_float",
    "to_list",
    "top2",
    "transpose",
]

fn Checker.tensor_ty(self, elem Ty) Ty
    s := struct_named("tensor.Tensor") else return Ty.Unknown
    Ty.Struct(s, [elem])

## The element type of `t` when it is a `tensor.Tensor[T]`.
@allow("expr.match.3") fn Checker.tensor_elem(self, t Ty) Ty?
    match t
        Struct(s, args) =>
            if prog.structs[s].name == "tensor.Tensor"
                if args.len() > 0
                    return args[0]
                return Ty.Unknown
        _ => return none
    none

fn is_number(t Ty) bool
    t == Ty.Int or t == Ty.Float

## The element types a tensor holds (std.tensor.21).
fn is_elem(t Ty) bool
    is_number(t) or t == Ty.Num("f32")

## `float` or `f32`: the two float element types (std.tensor.21).
fn is_float_elem(t Ty) bool
    t == Ty.Float or t == Ty.Num("f32")

## The element type `from` and `map` take in a list or a result: a `Tensor[f32]`
## is built from a `List[float]` (std.tensor.21).
fn list_elem(elem Ty) Ty
    if elem == Ty.Num("f32")
        return Ty.Float
    elem

## `tensor.f(args)` (std.tensor.2).
@allow("expr.match.3")
fn Checker.tensor_call(mut self, f str, args List[ast.Arg], at ast.Pos, expect Ty?) Ty
    shape := Ty.ListOf(Ty.Int)
    mut wanted := none
    if t := expect
        if e := self.tensor_elem(t)
            if is_elem(e)
                wanted = e
    if f == "from_fn"
        return self.tensor_from_fn(args, at)
    if f == "zeros"
        elem := wanted else Ty.Float
        sig := plain_sig(none, [shape], self.tensor_ty(elem))
        return check_call("tensor.zeros", sig, [], args, none, at, expect)
    # `from(xs)` is 1-D; `from(xs, shape)` gives the shape.
    mut elem := Ty.Float
    if w := wanted
        elem = w
    elif args.len() > 0
        a := args[0]
        t := quiet_type(a.value)
        mut ok := true
        match t
            ListOf(e) =>
                if is_number(e)
                    elem = e
                elif e != Ty.Unknown
                    ok = false
            Unknown => ok = true
            _ => ok = false
        if not ok
            args_only(args)
            err_help(
                "std.tensor.1",
                expr_pos(a.value),
                "a tensor holds `int` or `float` elements, not {show(t)}",
                "pass a `List[int]` or `List[float]`, e.g. `tensor.from([1.0, 2.0])`",
            )
            return Ty.Unknown
    mut params := [Ty.ListOf(list_elem(elem))]
    if args.len() != 1
        params.push(shape)
    check_call(
        "tensor.from",
        plain_sig(none, params, self.tensor_ty(elem)),
        [],
        args,
        none,
        at,
        expect,
    )

## std.tensor.25: `tensor.from_fn(shape, |i| e)`. `shape` is an `int` (a 1-D
## length) or a `List[int]`; the function takes the flat index and gives an
## `int`, a `float` or an `f32`, which is the element type.
fn Checker.tensor_from_fn(mut self, args List[ast.Arg], at ast.Pos) Ty
    help := "write `tensor.from_fn([2, 3], |i| i.to_float())`"
    if args.len() != 2
        args_only(args)
        err_help(
            "std.tensor.25",
            at,
            "`from_fn` takes a shape and a function, but {was_were(args.len())} given",
            help,
        )
        return Ty.Unknown
    shape := args[0]
    f := args[1]
    p := f.param else
        args_only(args)
        err_help(
            "std.tensor.25",
            expr_pos(f.value),
            "`from_fn` takes a function of the flat index",
            help,
        )
        return Ty.Unknown
    st := expr(shape.value, none, true)
    if st != Ty.Int and st != Ty.ListOf(Ty.Int) and st != Ty.Unknown
        err_help(
            "std.tensor.25",
            expr_pos(shape.value),
            "the shape of `from_fn` is an `int` or a `List[int]`, not {show(st)}",
            help,
        )
        return Ty.Unknown
    mark := locals.len()
    if declare(p.name, p.pos)
        self.add_local(Local(
            name: p.name,
            ty: Ty.Int,
            mutable: false,
            how: LocalKind.LoopVar,
            decl: none,
        ))
    out := expr(ast.key_body(f), none, true)
    end_scope(mark)
    if is_elem(out)
        return self.tensor_ty(out)
    if out != Ty.Unknown
        err_help(
            "std.tensor.25",
            expr_pos(f.value),
            "`from_fn`'s function gives {show(out)}, but a tensor holds `int` or `float`",
            "return a number from the function",
        )
    Ty.Unknown

## `t.n(args)` on a tensor `t` (std.tensor.3-8).
fn Checker.tensor_method(
    mut self,
    recv ast.Expr,
    rt Ty,
    n str,
    at ast.Pos,
    args List[ast.Arg],
    expect Ty?,
) Ty
    elem := self.tensor_elem(rt) else Ty.Unknown
    if not TENSOR_METHODS.contains(n)
        args_only(args)
        mut d := new_diag("std.tensor.3", at, "`tensor.Tensor` has no method `{n}`")
        if s := suggest(n, TENSOR_METHODS)
            d = d.did_you_mean_help(s)
        else
            d = d.with_help("a tensor's methods are {list_names(TENSOR_METHODS)}")
        diags.push(d)
        return Ty.Unknown
    std_any.add(pos_key(at))
    if n == "map"
        return self.tensor_map(rt, elem, args, at)
    if n == "to_f32" or n == "to_float"
        return self.tensor_convert(n, elem, args, at)
    if n == "top2" and elem == Ty.Int
        args_only(args)
        err_help(
            "std.tensor.23",
            at,
            "`top2` is on `float` tensors, and this one holds `int`",
            "use `argmax` for the best index of an `int` tensor",
        )
        return Ty.Unknown
    if n == "mean" and elem == Ty.Int
        args_only(args)
        err_help(
            "std.tensor.11",
            at,
            "`mean` is on `float` tensors, and this one holds `int`",
            "convert first: `t.map(|x| x.to_float()).mean()`",
        )
        return Ty.Unknown
    if elem == Ty.Int and (n == "round" or n == "clamp" or n == "conv2d")
        args_only(args)
        if n == "round"
            err_help(
                "std.tensor.19",
                at,
                "`round` is on `float` tensors, and this one holds `int`",
                "a tensor of `int` already has whole numbers",
            )
        elif n == "clamp"
            err_help(
                "std.tensor.18",
                at,
                "`clamp` is on `float` tensors, and this one holds `int`",
                "convert first: `t.map(|x| x.to_float()).clamp(lo, hi)`",
            )
        else
            err_help(
                "std.tensor.16",
                at,
                "`conv2d` is on `float` tensors, and this one holds `int`",
                "convert first: `t.map(|x| x.to_float()).conv2d(k)`",
            )
        return Ty.Unknown
    if (n == "relu" or n == "sigmoid" or n == "tanh") and elem == Ty.Int
        args_only(args)
        err_help(
            "std.tensor.13",
            at,
            "`{n}` is on `float` tensors, and this one holds `int`",
            "convert first: `t.map(|x| x.to_float()).{n}()`",
        )
        return Ty.Unknown
    if n == "softmax" and elem == Ty.Int
        args_only(args)
        err_help(
            "std.tensor.24",
            at,
            "`softmax` is on `float` tensors, and this one holds `int`",
            "convert first: `t.map(|x| x.to_float()).softmax()`",
        )
        return Ty.Unknown
    mut params := List[Ty]()
    mut ret := rt
    if n == "shape"
        ret = Ty.ListOf(Ty.Int)
    elif n == "len"
        ret = Ty.Int
    elif n == "to_list"
        ret = Ty.ListOf(list_elem(elem))
    elif n == "item"
        ret = elem
    elif n == "sum" or n == "max" or n == "mean"
        # std.tensor.11: over every element, or over one axis.
        if args.len() == 0
            ret = elem
        else
            params = [Ty.Int]
    elif n == "round"
        ret = self.tensor_ty(Ty.Int)
    elif n == "argmax" or n == "argmin"
        if args.len() == 0
            ret = Ty.Int
        else
            params = [Ty.Int]
            ret = self.tensor_ty(Ty.Int)
    elif n == "clamp"
        # std.tensor.21: an `f32` tensor's bounds are `float`.
        params = [list_elem(elem), list_elem(elem)]
    elif n == "dot"
        params = [rt]
        ret = elem
    elif n == "add" or n == "mul" or n == "matmul" or n == "conv2d"
        params = [rt]
    elif n == "reshape"
        params = [Ty.ListOf(Ty.Int)]
    elif n == "top2"
        # std.tensor.23: (best index, second index, margin) along an axis.
        params = [Ty.Int]
        ret = Ty.Tuple([self.tensor_ty(Ty.Int), self.tensor_ty(Ty.Int), rt])
    check_call("tensor.Tensor.{n}", plain_sig(false, params, ret), [], args, recv, at, expect)

## std.tensor.22: `to_f32()` on a `float` tensor and `to_float()` on an `f32`
## one; every other conversion is an error.
fn Checker.tensor_convert(mut self, n str, elem Ty, args List[ast.Arg], at ast.Pos) Ty
    args_only(args)
    from_t := if n == "to_f32" then Ty.Float else Ty.Num("f32")
    to_t := if n == "to_f32" then Ty.Num("f32") else Ty.Float
    if elem != from_t
        err_help(
            "std.tensor.22",
            at,
            "`{n}` converts a {show(from_t)} tensor, but this one holds {show(elem)}",
            "`to_f32()` takes `float` tensors and `to_float()` takes `f32` ones",
        )
        return Ty.Unknown
    self.tensor_ty(to_t)

## std.tensor.8: `t.map(|x| e)`: `x` is each element, and `e` is an `int`,
## `float` or `f32`, the new tensor's element type.
fn Checker.tensor_map(mut self, rt Ty, elem Ty, args List[ast.Arg], at ast.Pos) Ty
    if args.len() != 1
        args_only(args)
        err_help(
            "std.tensor.8",
            at,
            "`map` takes one function, but {was_were(args.len())} given",
            "write `t.map(|x| x * 2.0)`",
        )
        return rt
    a := args[0]
    p := a.param else
        expr(a.value, none, true)
        err_help(
            "std.tensor.8",
            expr_pos(a.value),
            "`map` takes a function of each element",
            "write `t.map(|x| x * 2.0)`",
        )
        return rt
    mark := locals.len()
    if declare(p.name, p.pos)
        self.add_local(Local(
            name: p.name,
            ty: elem,
            mutable: false,
            how: LocalKind.LoopVar,
            decl: none,
        ))
    out := expr(ast.key_body(a), elem, true)
    end_scope(mark)
    if is_elem(out)
        return self.tensor_ty(out)
    if out != Ty.Unknown
        err_help(
            "std.tensor.8",
            expr_pos(a.value),
            "`map`'s function gives {show(out)}, but a tensor holds `int` or `float`",
            "return a number from the function",
        )
    Ty.Unknown

## type.num.10 for std.tensor.10: an `int` literal `scalar` beside a
## `Tensor[float]` `t` is a `float`.
fn Checker.float_tensor_scalar(mut self, t Ty, st Ty, scalar ast.Expr) bool
    st == Ty.Int and self.tensor_elem(t) == Ty.Float and float_literal(scalar)

## std.tensor.10: `+`, `-` and `*` with a tensor operand: two tensors of one
## element type, or a tensor and a scalar of its element type, either side.
## `none` when neither operand is a tensor.
fn Checker.tensor_operator(mut self, sym str, arith bool, lt Ty, rt Ty, at ast.Pos) Ty?
    le := self.tensor_elem(lt)
    re := self.tensor_elem(rt)
    if le == none and re == none
        return none
    if not arith or not ["+", "-", "*", "/"].contains(sym)
        if not arith
            return none
        err_help("std.tensor.10", at, "`{sym}` is not defined for tensors", "use `t.map(|x| ...)`")
        return Ty.Unknown
    # std.tensor.21: `f32` and `float` tensors don't mix.
    if a := le
        if b := re
            if a != b and is_float_elem(a) and is_float_elem(b)
                err_help(
                    "std.tensor.21",
                    at,
                    "`{sym}` needs tensors of one element type, but found {show(lt)} and {show(rt)}",
                    "convert one with `t.to_f32()` or `t.to_float()`",
                )
                return Ty.Unknown
    # A `float` scalar takes an `f32` tensor's element type (std.tensor.21).
    mut ok := false
    if a := le
        if b := re
            ok = a == b
        else
            ok = a == rt or (a == Ty.Num("f32") and rt == Ty.Float)
    elif b := re
        ok = b == lt or (b == Ty.Num("f32") and lt == Ty.Float)
    if ok and sym == "/" and (le == Ty.Int or re == Ty.Int)
        err_help(
            "std.tensor.10",
            at,
            "`/` is not defined for `int` tensors",
            "convert first: `t.map(|x| x.to_float())`",
        )
        return Ty.Unknown
    if ok
        if le != none
            return lt
        return rt
    other := if le != none then rt else lt
    mut help := "a tensor combines with a tensor or a number of its element type"
    if le != none and re != none
        help = "convert one with `t.map(|x| x.to_float())`"
    elif is_number(other)
        help = "convert the number to the element type: `x.to_float()` or `x.to_int()`"
    err_help(
        "std.tensor.10",
        at,
        "`{sym}` needs two tensors of one element type, or a tensor and a scalar of its element type, found {show(lt)} and {show(rt)}",
        help,
    )
    Ty.Unknown
