## A diagnostic, as `77592931:bootstrap/src/diag.rs` builds it: a rule, a position,
## a message, and an optional help and notes.
use ast
use fix

pub struct Note
    pub pos ast.Pos
    pub message str

pub struct Diag
    pub rule str
    pub pos ast.Pos
    pub message str
    pub help str?
    pub notes List[Note]
    pub fixes List[fix.Fix]
    pub warning bool

pub fn new_diag(rule str, pos ast.Pos, message str) Diag
    Diag(rule: rule, pos: pos, message: message, help: none, notes: [], fixes: [], warning: false)

fn Diag.with_note(self, at ast.Pos, text str) Diag
    mut d := self
    d.notes.push(Note(pos: at, message: text))
    d

fn Diag.with_help(self, text str) Diag
    mut d := self
    d.help = text
    d

## `did you mean `s`?` as help only.
fn Diag.did_you_mean_help(self, s str) Diag
    self.with_help("did you mean `{s}`?")

fn Diag.with_fix(self, title str, edits List[fix.Edit]) Diag
    mut d := self
    d.fixes.push(fix.Fix(title: title, edits: edits, sure: false))
    d

## A certain fix (fix.auto.1, ADR 1130): `ail check`, `build`, `run` and `test`
## write it into the file. Only for a rewrite with one meaning, the one written.
fn Diag.with_sure_fix(self, title str, edits List[fix.Edit]) Diag
    mut d := self
    d.fixes.push(fix.sure_fix(title, edits))
    d

## `did you mean `s`?` and the fix that replaces `name` by `s` (diag.rs `did_you_mean`).
fn Diag.did_you_mean(self, name str, s str) Diag
    self
        .with_help("did you mean `{s}`?")
        .with_fix("replace `{name}` with `{s}`", [fix.replace(self.pos, name, s)])

## One line of JSON: severity, rule, file, local line and column, message,
## help and fixes, in the order `ail check --json` writes them. `sources`
## holds the lines of each file read from disk; a fix whose anchor doesn't
## settle against them is left out, as `ail check` does (fix.edit.2).
pub fn Diag.to_json(self, files List[ast.SourceFile], sources Map[str, List[List[char]]]) str
    mut file := ""
    mut base := 0
    mut line := self.pos.line
    if line < 1073741824
        for f in files
            if f.base < self.pos.line
                file = f.path
                base = f.base
                line = self.pos.line - f.base
    severity := if self.warning then "warning" else "error"
    mut out := "\{\"severity\":\"{severity}\",\"rule\":\"{self.rule}\",\"file\":{quote(file)},\"line\":{line},\"col\":{self.pos.col},\"message\":{quote(self.message)}"
    if h := self.help
        out = "{out},\"help\":{quote(h)}"
    if self.fixes.len() > 0
        if lines := sources.get(file)
            local := [
                fix.Fix(title: f.title, edits: [shifted(e, base) for e in f.edits], sure: f.sure)
                for f in self.fixes
            ]
            settled := fix.settle_fixes(local, lines)
            expects := fix.expects_of(settled, lines)
            if settled.len() > 0
                out = "{out},\"fixes\":[{[fix_json(settled[i], expects[i]) for i in 0..settled.len()].join(",")}]"
    "{out}}"

## `e` with its lines made local to its file.
pub fn shifted(e fix.Edit, base int) fix.Edit
    fix.Edit(
        pos: ast.Pos(line: e.pos.line - base, col: e.pos.col),
        end: ast.Pos(line: e.end.line - base, col: e.end.col),
        old: e.old,
        anchor: e.anchor,
        text: e.text,
    )

## One fix as JSON. Each edit carries `expect`, the text its span holds in `lines` (fix.edit.7), so a client
## can refuse an edit whose source has changed since the check. `expects` is one text per edit (`fix.expects_of`).
pub fn fix_json(f fix.Fix, expects List[str]) str
    edits := [
        "\{\"line\":{f.edits[i].pos.line},\"col\":{f.edits[i].pos.col},\"end_line\":{f.edits[i].end.line},\"end_col\":{f.edits[i].end.col},\"text\":{quote(f.edits[i].text)},\"expect\":{quote(expects[i])}}"
        for i in 0..f.edits.len()
    ]
    # fix.auto.3: a certain fix says so, for a client that applies those itself (`ail check --json` writes nothing).
    sure := if f.sure then ",\"certain\":true" else ""
    "\{\"title\":{quote(f.title)}{sure},\"edits\":[{edits.join(",")}]}"

## `s` as a JSON string.
fn quote(s str) str
    Json.Str(s).to_text()
