## A diagnostic, as `bootstrap/src/diag.rs` builds it: a rule, a position,
## a message, and an optional help and notes.
use ast
use fix

pub struct Note
    pub pos ast.Pos
    pub message str

pub struct Diag
    pub rule str
    pub pos ast.Pos
    pub message str
    pub help str?
    pub notes List[Note]
    pub fixes List[fix.Fix]
    pub warning bool

pub fn new_diag(rule str, pos ast.Pos, message str) Diag
    Diag(rule: rule, pos: pos, message: message, help: none, notes: [], fixes: [], warning: false)

fn Diag.with_note(self, at ast.Pos, text str) Diag
    mut d := self
    d.notes.push(Note(pos: at, message: text))
    d

fn Diag.with_help(self, text str) Diag
    mut d := self
    d.help = text
    d

## `did you mean `s`?` as help only.
fn Diag.did_you_mean_help(self, s str) Diag
    with_help("did you mean `{s}`?")

fn Diag.with_fix(self, title str, edits List[fix.Edit]) Diag
    mut d := self
    d.fixes.push(fix.Fix(title: title, edits: edits))
    d

## `did you mean `s`?` and the fix that replaces `name` by `s` (diag.rs `did_you_mean`).
fn Diag.did_you_mean(self, name str, s str) Diag
    with_help("did you mean `{s}`?").with_fix(
        "replace `{name}` with `{s}`",
        [fix.replace(pos, name, s)],
    )

## One line of JSON: severity, rule, file, local line and column, message
## and help, in the order `ail check --json` writes them.
pub fn Diag.to_json(self, files List[ast.SourceFile]) str
    mut file := ""
    mut line := pos.line
    if line < 1073741824
        for f in files
            if f.base < pos.line
                file = f.path
                line = pos.line - f.base
    severity := if warning then "warning" else "error"
    mut out := "\{\"severity\":\"{severity}\",\"rule\":\"{rule}\",\"file\":{quote(file)},\"line\":{line},\"col\":{pos.col},\"message\":{quote(message)}"
    if h := help
        out = "{out},\"help\":{quote(h)}"
    # The titles of the fixes, in order; their edits are resolved against the
    # source by the `fix` module (ADR 0203, ADR 0204).
    if fixes.len() > 0
        out = "{out},\"fix_titles\":[{[quote(f.title) for f in fixes].join(",")}]"
    "{out}}"

## `s` as a JSON string.
fn quote(s str) str
    Json.Str(s).to_text()
