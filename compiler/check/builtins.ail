## Methods of the built-in types (ADR 0377), as `check/builtins.rs` and
## `check/keyfn.rs`: `str`, `char`, `int`, `float`, the sized numbers,
## `List`, `Map` and `Set`.
use ast
use fix

## What a built-in method's element type must support.
pub enum Need
    NoNeed
    NeedEq
    NeedOrd
    NeedHash
    NeedNumber

## A built-in method's signature.
pub struct Builtin
    pub mutates bool
    pub params List[Ty]
    pub ret Ty
    pub need Need

pub STR_METHODS := [
    "split",
    "to_int",
    "to_float",
    "chars",
    "trim",
    "slice",
    "to_lower",
    "to_upper",
    "find",
    "replace",
    "char_at",
    "starts_with",
    "ends_with",
    "strip_prefix",
    "strip_suffix",
    "contains",
    "repeat",
    "pad_left",
    "pad_right",
    "center",
    "words",
    "trim_start",
    "trim_end",
    "count",
    "rfind",
    "lines",
    "len",
    "is_empty",
    "byte_len",
    "to_bytes",
]

