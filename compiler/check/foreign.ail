## Other languages' method names for the built-in types (gram.foreign.1,
## expr.name.2; ADR 0262), as `method_help` and `method_rename` in
## `77592931:bootstrap/src/check/builtins.rs`. The fix renames the call.
use ast

## A type's kind for the tables below: `str`, `list`, `map`, `set`, `bytes`
## or `char`; empty for the rest.
@allow("expr.match.3") fn kind_of(t Ty) str
    match t
        Str => "str"
        ListOf => "list"
        MapOf => "map"
        SetOf => "set"
        Bytes => "bytes"
        Char => "char"
        _ => ""

## The AIL method for another language's name for it, when the arguments
## carry over unchanged.
pub fn method_rename(t Ty, name str) str?
    k := kind_of(t)
    # `count` on a list, map or set takes a function (type.coll.28): it is not `len`.
    if name == "length" or name == "size" or (name == "count" and k == "str")
        if k == "str" or k == "list" or k == "map" or k == "set"
            return "len"
    match "{k}.{name}"
        "str.strip" | "str.lstrip" | "str.rstrip" | "str.trim_start" | "str.trim_end" => "trim"
        "str.encode" => "to_bytes"
        "bytes.startswith" | "bytes.startsWith" | "str.startswith" | "str.startsWith" => "starts_with"
        "bytes.endswith" | "bytes.endsWith" | "str.endswith" | "str.endsWith" => "ends_with"
        "str.splitlines" => "lines"
        "str.lower" | "str.lowercase" | "str.toLowerCase" | "char.to_lowercase" => "to_lower"
        "str.upper" | "str.uppercase" | "str.toUpperCase" | "char.to_uppercase" => "to_upper"
        "str.includes" | "list.includes" | "list.has" | "map.has" | "map.has_key" | "map.contains_key" | "set.has" => "contains"
        "str.indexOf" => "find"
        "str.substring" | "str.substr" => "slice"
        "char.is_alphabetic" => "is_alpha"
        "char.is_whitespace" => "is_space"
        "char.is_alphanumeric" => "is_alnum"
        "char.is_numeric" | "char.is_ascii_digit" | "char.isdigit" => "is_digit"
        "list.append" | "list.add" | "list.push_back" => "push"
        "list.indexOf" => "index_of"
        "list.pop_back" => "pop"
        "map.delete" | "set.discard" | "set.delete" => "remove"
        "set.insert" | "set.push" => "add"
        _ => none

## Help for a method name that other languages give the built-in types.
pub fn method_help(t Ty, name str) str?
    k := kind_of(t)
    msg := match "{k}.{name}"
        "str.length" | "str.size" | "str.count" => "write `s.len()` for characters, or `s.byte_len()` for UTF-8 bytes"
        "str.strip" | "str.lstrip" | "str.rstrip" | "str.trim_start" | "str.trim_end" => "write `s.trim()`"
        "str.startswith" => "write `s.starts_with(prefix)`"
        "str.endswith" => "write `s.ends_with(suffix)`"
        "str.removeprefix" => "write `s.strip_prefix(p)`, which gives a `str?`"
        "str.removesuffix" => "write `s.strip_suffix(p)`, which gives a `str?`"
        "str.rjust" | "str.pad_start" | "str.padStart" => "write `s.pad_left(width, ' ')`"
        "str.ljust" | "str.pad_end" | "str.padEnd" => "write `s.pad_right(width, ' ')`"
        "str.zfill" => "write `s.pad_left(width, '0')`"
        "str.join" => "write `xs.join(sep)` on the list"
        "str.splitlines" => "write `s.lines()`"
        "str.isdigit" | "str.isalpha" | "str.isalnum" | "str.isspace" | "str.is_digit" | "str.is_alpha" => "character tests are on `char`: `c.is_digit()`; for a string, test each of `s.chars()`"
        "str.format" => "build text with interpolation: `\"\{a} and \{b}\"`"
        "char.is_whitespace" => "write `c.is_space()`"
        "char.is_alphabetic" => "write `c.is_alpha()`"
        "char.is_alphanumeric" => "write `c.is_alnum()`"
        "char.is_numeric" | "char.is_ascii_digit" | "char.isdigit" => "write `c.is_digit()`"
        "char.to_int" => "write `c.code()` for its scalar value, or `c.to_digit(10)` for a digit's value"
        "char.to_uppercase" => "write `c.to_upper()`"
        "char.to_lowercase" => "write `c.to_lower()`"
        "map.push" => "`m.push(k, x)` needs a map whose values are lists, `Map[K, List[T]]`; for other values write `m[k] = v`"
        "list.append" | "list.add" => "write `xs.push(x)`"
        "list.length" | "list.size" => "write `xs.len()`"
        "list.dedup" | "list.unique" | "list.uniq" | "list.distinct" | "list.drop_duplicates" => "there is no `{name}`: write `xs.counts().keys()` for the distinct `int`, `str` or `char` elements in order of first appearance, `xs.group_by(|x| x).keys()` for any hashable element, or keep a `Set[T]`"
        "list.index" | "list.find" | "list.indexOf" => "write `xs.index_of(x)`, which gives `int?` (`none` if absent)"
        "map.has" | "map.has_key" | "map.contains_key" => "write `m.contains(k)`"
        "map.put" | "map.set" | "map.insert" => "write `m[k] = v`"
        "map.delete" | "map.pop" => "write `m.remove(k)`"
        "set.insert" | "set.push" => "write `s.add(x)`"
        "set.has" => "write `s.contains(x)`"
        "set.discard" | "set.delete" => "write `s.remove(x)`"
        _ => ""
    if msg != ""
        return msg
    match name
        "message" | "msg" | "description" | "getMessage" | "get_message" => "an error's message is its text: interpolate `\"\{e}\"` or write `e.to_str()`; the variants' messages are in the `error enum`"
        "to_string" | "toString" | "__str__" => "write `x.to_str()`, or interpolate: `\"\{x}\"`"
        _ => none

## An unknown name that is another language's spelling of a value: the
## replacement and the help.
pub struct NameWord
    pub new str
    pub help str

pub fn name_word(name str) NameWord?
    match name
        "True" => NameWord(new: "true", help: "booleans are `true` and `false`")
        "False" => NameWord(new: "false", help: "booleans are `true` and `false`")
        "None" | "nil" | "null" | "undefined" | "NULL" => NameWord(
            new: "none",
            help: "the absent value is `none`, and the type must say it can be absent: `int?`",
        )
        "println" | "puts" | "echo" | "print_line" | "printline" | "writeln" => NameWord(
            new: "print",
            help: "`print(value)` writes a value and a newline",
        )
        _ => none

## A call to a function other languages have: the template that rewrites it
## (the `call` anchor), an example of the result, and the help.
pub struct CallHint
    pub template str
    pub example str
    pub help str

fn method_hint(name str, recv_example str, rest str) CallHint
    CallHint(
        template: "$r1.{name}({rest})",
        example: "{recv_example}.{name}({rest})",
        help: "`{name}` is a method: write `{recv_example}.{name}({rest})`",
    )

pub fn call_hint(name str, nargs int) CallHint?
    mut skip := false
    match name
        "len" | "length" | "size" =>
            if nargs == 1
                return CallHint(
                    template: "$r1.len()",
                    example: "xs.len()",
                    help: "`len` is a method: write `xs.len()`",
                )
        "bytes" =>
            if nargs == 1
                return CallHint(
                    template: "bytes.zeros($1)",
                    example: "bytes.zeros(n)",
                    help: "`n` zero bytes are `bytes.zeros(n)`",
                )
        "str" | "string" | "toString" =>
            if nargs == 1
                return CallHint(
                    template: "\"\{$1}\"",
                    example: "\"\{n}\"",
                    help: "interpolate to get text: `\"\{n}\"`, or write `n.to_str()`",
                )
        "printf" =>
            if nargs >= 1
                return CallHint(
                    template: "print($%)",
                    example: "print(\"n is \{n}\")",
                    help: "build the text with interpolation, `print(\"n is \{n}\")`; a width or precision goes after a colon: `\{n:>6}`, `\{x:.2}`",
                )
        "range" =>
            if nargs == 1
                return CallHint(
                    template: "0..$1",
                    example: "0..n",
                    help: "a range is written `0..n` (excludes `n`) or `1..=n` (includes it)",
                )
            if nargs == 2
                return CallHint(
                    template: "$1..$2",
                    example: "a..b",
                    help: "a range is written `a..b` (excludes `b`) or `a..=b` (includes it)",
                )
        _ => skip = true
    one := [
        "sqrt",
        "sin",
        "cos",
        "tan",
        "atan",
        "exp",
        "ln",
        "log10",
        "cbrt",
        "floor",
        "ceil",
        "round",
        "abs",
        "sum",
        "sorted",
        "enumerate",
    ]
    if nargs == 1 and one.contains(name)
        mut recv := "x"
        if name == "abs"
            recv = "n"
        elif name == "sum" or name == "sorted" or name == "enumerate"
            recv = "xs"
        return method_hint(name, recv, "")
    if nargs == 2 and (name == "atan2" or name == "pow" or name == "hypot")
        return CallHint(
            template: "$r1.{name}($2)",
            example: "x.{name}(y)",
            help: "`{name}` is a method: write `x.{name}(y)`",
        )
    if nargs == 2 and (name == "max" or name == "min")
        return CallHint(
            template: "$r1.{name}($2)",
            example: "a.{name}(b)",
            help: "`{name}` is a method: write `a.{name}(b)`",
        )
    none

## Help for another language's call that has no one-line rewrite.
pub fn call_help(name str) str?
    match name
        "int" | "Integer" | "parseInt" | "atoi" => "convert text with `s.to_int()`, which gives `int?` (`none` if it isn't a number), and a float with `x.to_int()`"
        "float" | "parseFloat" => "convert with `s.to_float()` (gives `float?`) or `n.to_float()`"
        "input" | "readline" | "scanf" | "scan" => "read input with `use std.io` and `io.read_line()`, which gives `str?` (`none` at end of input)"
        "printf" | "fmt.Printf" | "format" => "build the text with interpolation, `print(\"n is \{n}\")`; a width or precision goes after a colon: `\{n:>6}`, `\{x:.2}`"
        "enumerate" => "each element with its index is `xs.enumerate()`: `for i, x in xs.enumerate()`"
        "list" | "dict" | "set" | "array" | "vec" | "Vec" => "build collections with literals or typed constructors: `[1, 2]`, `\{\"a\": 1}`, `Set[int]()`, `List[int]()`"
        "isinstance" | "typeof" | "type" => "AIL is statically typed; use `match` on an enum or a trait method instead of a type test"
        "assert" => "`assert` works inside an `@test` function (spec chapter 19)"
        _ => none

## Help for a function name that other languages have (expr.name.2).
pub fn function_help(name str) str?
    match name
        "len" => "write `x.len()`"
        "min" | "max" => "write `a.min(b)` / `a.max(b)`, or `xs.min()` / `xs.max()` for a list (they give `T?`)"
        "ord" => "write `c.code()`"
        "chr" => "write `char.from_code(n)`, which gives a `char?`"
        "sorted" => "write `xs.sorted()`, or `xs.sort()` to sort in place"
        "sum" => "write `xs.sum()`"
        "abs" => "write `x.abs()`"
        "round" => "write `x.round()`: a float, rounded half away from zero; add `.to_int()` for an int"
        "floor" | "ceil" => "write `x.floor()` / `x.ceil()`: a float; add `.to_int()` for an int"
        "sqrt" => "write `x.sqrt()`"
        "str" | "String" | "string" => "write `\"\{x}\"` for a value's text"
        "int" | "Int" | "parseInt" | "atoi" => "write `s.to_int()`, which gives an `int?`; for a float, `x.to_int()`"
        "float" | "parseFloat" => "write `s.to_float()`, or `n.to_float()` for an int"
        "loop" => "write `while true`"
        "range" => "write a range: `0..n`, or `1..=n` to include `n`"
        "println" | "printf" | "puts" | "console" => "write `print(value)`"
        "assert" | "panic" => "write `unreachable(\"message\")` to stop the program"
        _ => none
