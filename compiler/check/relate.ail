## How types relate (ADR 0377): `accepts`, `mismatch`, error sets, type
## parameter inference (`bind`, `subst_unknown`), as `77592931:bootstrap/src/check.rs`
## and `check/traits.rs` define them.
use ast
use fix

## Admit the errors `got` into the set `want`: an inferred set grows, and a
## written set must already contain them. Returns the missing ones.
fn Checker.add_errors(mut self, want Errs, got List[Ty]) List[Ty]
    match want
        Inferred(j) =>
            for g in got
                if not inferred[j].contains(g)
                    inferred[j].push(g)
                    inferred[j] = sort_errors(inferred[j])
            []
        # err.str.3: a function declared `T ! str` passes on any error as its text.
        ErrSet(v) => if v == [Ty.Str] then [] else [g for g in got if not v.contains(g)]

## Whether a value of type `got` is accepted where `want` is expected
## (type.opt.5, trait.any.3, err.decl.3, expr.block.3). An inferred error set
## grows to admit the errors of `got` (err.type.2).
@allow("expr.match.3") fn Checker.accepts(mut self, want Ty, got Ty) bool
    if got == Ty.Never or got == Ty.Unknown or want == Ty.Unknown
        return true
    match want
        Opt(w) =>
            match got
                Opt(g) => same(w, g)
                _ => self.accepts(w, got)
        Res(w, we) =>
            match got
                Res(g, ge) =>
                    gerrs := errs_of(ge)
                    same(w, g) and self.add_errors(we, gerrs).len() == 0
                Union(m) => self.add_errors(we, m).len() == 0
                _ =>
                    if is_error_type(got)
                        return self.add_errors(we, [got]).len() == 0
                    self.accepts(w, got)
        Union(w) =>
            match got
                Union(g) =>
                    for t in g
                        if not w.contains(t)
                            return false
                    true
                _ => w.contains(got)
        AnyOf(a) =>
            match got
                AnyOf(b) => a == b
                Unit => false
                Res => false
                _ => implements(got, a)
        # type.fn.6: a function that can't fail, or fails with fewer errors, fits
        # where one that can fail is expected.
        FnTy(wp, wr) =>
            match got
                FnTy(gp, gr) =>
                    if not same_all(wp, gp)
                        return false
                    if same(wr, gr)
                        return true
                    match wr
                        Res(w, _) =>
                            match gr
                                Res => self.accepts(wr, gr)
                                _ => same(w, gr)
                        _ => false
                _ => same(want, got)
        _ => same(want, got)

## Report a value of type `got` where `want` was expected, under `rule`. An
## unhandled failure is reported as such (err.use.1).
@allow("expr.match.3") fn Checker.mismatch(mut self, rule str, at ast.Pos, want Ty, got Ty)
    if not is_res(want) and self.reject_unhandled(got, at)
        return
    text := "expected {show(want)}, found {show(got)}"
    match want
        Res(_, we) => self.mismatch_errors(rule, at, text, we, got)
        _ =>
            if want == Ty.Char and got == Ty.Str
                # `"0"` where a `char` is expected: the fix writes `'0'` when the string is one plain character.
                diags.push(
                    new_diag(rule, at, text)
                        .with_help("a character is written in single quotes: 'a'")
                        .with_sure_fix("write a character literal", [fix.char_literal(at)]),
                )
            elif wraps_one(want, got)
                # `[x]` where `x` is wanted: `m.push(k, [x])` on a list-valued map (ADR 1172).
                diags.push(
                    new_diag(rule, at, text)
                        .with_help("pass the element itself, not a list of it")
                        .with_sure_fix("pass the element", [fix.unbracket_one(at)]),
                )
            elif h := mismatch_help(want, got)
                err_help(rule, at, text, h)
            elif h := self.distinct_wrap(want, got)
                err_help(rule, at, text, h)
            else
                err(rule, at, text)

@allow("expr.match.3")
fn Checker.mismatch_errors(mut self, rule str, at ast.Pos, text str, we Errs, got Ty)
    mut got_errs := List[Ty]()
    match got
        Res(_, ge) => got_errs = errs_of(ge)
        Union(m) => got_errs = m
        _ => got_errs = if is_error_type(got) then [got] else []
    mut missing := List[Ty]()
    match we
        ErrSet(v) => missing = [g for g in got_errs if not v.contains(g)]
        Inferred => missing = []
    if missing.len() == 0
        err(rule, at, text)
    else
        names := [ty_name(t) for t in missing]
        err_help(
            rule,
            at,
            "{text}: the error type doesn't include {list_names(names)}",
            "add them to the return type, e.g. `T ! A | B`, or use `!T` to infer the errors",
        )

## A distinct type where its base is given, or the other way round (type.distinct.1): wrap or unwrap, not
## `to_float()` (checkbench, ADR 1111).
fn Checker.distinct_wrap(self, want Ty, got Ty) str?
    if wb := self.distinct_base(want)
        if same(wb, got)
            return "{show(want)} is a distinct type: wrap the value, `{ty_name(want)}(x)`"
    if gb := self.distinct_base(got)
        if same(gb, want)
            return "{show(got)} is a distinct type: unwrap it with `{ty_name(gb)}(x)`"
    none

## Help for a mismatch between two types (type.opt.7, expr.name.2).
## Whether `got` is a list of what `want` is.
@allow("expr.match.3") fn wraps_one(want Ty, got Ty) bool
    match got
        ListOf(el) => same(el, want)
        _ => false

fn mismatch_help(want Ty, got Ty) str?
    if is_opt(want) and is_opt(got) and is_opt(opt_inner(want))
        return "an optional doesn't convert to a nested optional, since its `none` would be ambiguous (type.opt.7)"
    if is_opt(got) and same(want, opt_inner(got))
        return "this value may be absent; supply a fallback with `x := value else fallback`"
    if want == Ty.Int and got == Ty.Float
        return "no implicit conversion: `x.to_int()` truncates toward zero; `x.round().to_int()` rounds"
    if want == Ty.Float and got == Ty.Int
        return "no implicit conversion: write `n.to_float()`"
    if k := num_name(want)
        if got == Ty.Int or got == Ty.Float
            return "no implicit conversion: write `x.to_{k}()`"
    if (want == Ty.Int or want == Ty.Float) and num_name(got) != none
        fname := if want == Ty.Int then "to_int" else "to_float"
        return "no implicit conversion: write `x.{fname}()`"
    if want == Ty.Str and got == Ty.Char
        return "make a one-character string with \"\{c}\""
    if want == Ty.Char and got == Ty.Str
        return "a character is written in single quotes: 'a'"
    none

## The inner type of an optional (or the type itself).
@allow("expr.match.3") fn opt_inner(t Ty) Ty
    match t
        Opt(x) => x
        _ => t

## The name of a sized numeric type.
@allow("expr.match.3") fn num_name(t Ty) str?
    match t
        Num(k) => k
        _ => none

## Report a failure that isn't handled (err.use.1); true if `t` is one.
fn Checker.reject_unhandled(mut self, t Ty, at ast.Pos) bool
    if not is_res(t)
        return false
    hint := if is_res(fn_ret) then "pass the error on with `?`, or handle it with `x := ... else ...`" else "handle it with `x := ... else d`, or declare this function's return type with `! E` and pass the error on with `?`"
    err_help("err.use.1", at, "this can fail, and the failure isn't handled", hint)
    self.try_fix_at(t, at)
    true

## fix.edit.3: offer `?` after the failure when this function's error type
## admits its errors; err.fix.1: or make the function fail.
@allow("expr.match.3") fn Checker.try_fix_at(mut self, t Ty, at ast.Pos)
    mut errors := List[Ty]()
    match t
        Res(_, errs) => errors = errs_of(errs)
        _ => return
    mut admits := false
    match fn_ret
        Res(_, we) =>
            match we
                Inferred => admits = true
                ErrSet(want) => admits = [g for g in errors if not want.contains(g)].len() == 0
        _ => admits = false
    sig := if admits then none else self.signature_fix(errors)
    if diags.len() == 0
        return
    last := diags[diags.len() - 1]
    if last.rule != "err.use.1" or last.fixes.len() > 0
        return
    # ADR 1203: `?` is the one reading when the function already admits the errors, and for `main`, which no
    # one calls, so is giving it `! E`; both are certain. Another function's new `! E` stays a guess.
    if admits
        sure_fix_last("pass the error on with `?`", [fix.after_expr(at, "?")])
    elif s := sig
        both := [s.edit, fix.after_expr(at, "?")]
        if prog.fns[cur_fn].name == "main"
            sure_fix_last("{s.title} and pass the error on with `?`", both)
        else
            fix_last("{s.title} and pass the error on with `?`", both)

## `time.date.DateError` as `date.DateError`: a module path as its last name, which `use a.b` gives the module (mod.use.1).
fn shorten_path(name str) str
    parts := name.split(".")
    if parts.len() <= 2
        return name
    "{parts[parts.len() - 2]}.{parts[parts.len() - 1]}"

## Whether `alias` is the name a `use` of the file at `at` gives its module.
fn Checker.alias_used(self, alias str, at ast.Pos) bool
    here := self.file_of(at)
    for u in prog.uses
        if u.path.len() > 0 and self.file_of(u.pos) == here
            name := u.alias?.name else u.path[u.path.len() - 1].name
            if name == alias
                return true
    false

pub struct SigFix
    pub title str
    pub edit fix.Edit

## err.fix.1: give the current function the return type `! errors`, appended
## to its signature line; only when its return type is absent or a plain value.
@allow("expr.match.3") fn Checker.signature_fix(self, extra List[Ty]) SigFix?
    if is_res(fn_ret) or is_opt(fn_ret)
        return none
    # A module's error type is written with the alias its module has in this file (`error_written`, ADR 1206),
    # which must be one of the file's `use` aliases: else no fix.
    home := module_at(prog, prog.fns[cur_fn].pos)
    mut written := [shorten_path(self.error_written(t, home)) for t in extra]
    written.sort()
    mut names := List[str]()
    for w in written
        if names.last() != w
            names.push(w)
    for w in names
        if w.contains(".") and not self.alias_used(w.split(".")[0], prog.fns[cur_fn].pos)
            return none
    joined := names.join(" | ")
    SigFix(
        title: "make `{prog.fns[cur_fn].name}` fail with {joined}",
        edit: fix.at_line_end(prog.fns[cur_fn].pos, " ! {joined}"),
    )

## Add the signature fix, if any, to the diagnostic just reported.
fn Checker.sig_fix_last(mut self, errors List[Ty])
    if s := self.signature_fix(errors)
        fix_last(s.title, [s.edit])

## Sorted, distinct display names of error types.
fn Checker.error_names(self, errors List[Ty]) List[str]
    mut names := [ty_name(t) for t in errors]
    names.sort()
    mut out := List[str]()
    for n in names
        if out.last() != n
            out.push(n)
    out

## The function or method an expression calls, if it is a call (err.paths.1).
@allow("expr.match.3") fn callee_text(e ast.Expr) str
    match e
        Call(callee, _, _) =>
            match callee
                Name(n, _) => return n
                TypeArgs(n, _, _) => return n
                _ => return ""
        Method(recv, name, _, _) =>
            match recv
                Name(r, _) => return "{r}.{name}"
                _ => return ".{name}"
        _ => return ""
    ""

## Remember a failure path of the function being checked (err.paths.1); final pass only.
fn Checker.note_path(
    mut self,
    pos ast.Pos,
    kind str,
    how str,
    value ast.Expr?,
    errors List[Ty],
    context bool,
)
    if not record
        return
    mut call := ""
    if v := value
        call = callee_text(v)
    fail_paths.push(FailPath(
        func: cur_fn,
        pos: pos,
        kind: kind,
        how: how,
        call: call,
        errors: self.error_names(errors),
        context: context,
    ))

## The return type that would let this function fail with `extra` too, as
## the source writes it; `none` for an optional return type.
@allow("expr.match.3") fn Checker.failing_ret(self, extra List[Ty]) str?
    mut names := List[str]()
    match fn_ret
        Res(_, errs) => names = self.error_names(errs_of(errs))
        Opt => return none
        _ => names = []
    for n in self.error_names(extra)
        names.push(n)
    names.sort()
    mut uniq := List[str]()
    for n in names
        if uniq.last() != n
            uniq.push(n)
    ok := ok_type(fn_ret)
    ok_text := if ok == Ty.Unit then "" else ty_name(ok)
    "{ok_text} ! {uniq.join(" | ")}".trim()

## Infer the parameters among `vars` that `pattern` mentions from the type
## `actual` of a value given for it (gen.infer.1). The first binding wins.
@allow("expr.match.3") fn bind(pattern Ty, actual Ty, vars List[int], mut binds List[Bind])
    if actual == Ty.Unknown or actual == Ty.Never or actual == Ty.Unit
        return
    match pattern
        Param(p) =>
            if vars.contains(p)
                for b in binds
                    if b.param == p
                        return
                if not has_unknown(actual)
                    binds.push(Bind(param: p, ty: actual))
        ListOf(x) =>
            match actual
                ListOf(y) => bind(x, y, vars, mut binds)
                _ => return
        SetOf(x) =>
            match actual
                SetOf(y) => bind(x, y, vars, mut binds)
                _ => return
        Opt(x) =>
            match actual
                Opt(y) => bind(x, y, vars, mut binds)
                _ => bind(x, actual, vars, mut binds)
        Conc(a, x) =>
            match actual
                Conc(b, y) =>
                    if a == b
                        bind(x, y, vars, mut binds)
                _ => return
        MapOf(k, v) =>
            match actual
                MapOf(l, w) =>
                    bind(k, l, vars, mut binds)
                    bind(v, w, vars, mut binds)
                _ => return
        FnTy(xs, r) =>
            match actual
                FnTy(ys, s) =>
                    if xs.len() == ys.len()
                        for k in 0..xs.len()
                            bind(xs[k], ys[k], vars, mut binds)
                        bind(r, s, vars, mut binds)
                _ => return
        Tuple(xs) =>
            match actual
                Tuple(ys) =>
                    if xs.len() == ys.len()
                        bind_all(xs, ys, vars, mut binds)
                _ => return
        Struct(s, xs) =>
            match actual
                Struct(t, ys) =>
                    if s == t
                        bind_all(xs, ys, vars, mut binds)
                _ => return
        Enum(s, xs) =>
            match actual
                Enum(t, ys) =>
                    if s == t
                        bind_all(xs, ys, vars, mut binds)
                _ => return
        Res(x, _) =>
            match actual
                Res(y, _) => bind(x, y, vars, mut binds)
                _ => bind(x, actual, vars, mut binds)
        _ => return

fn bind_all(xs List[Ty], ys List[Ty], vars List[int], mut binds List[Bind])
    for k in 0..xs.len().min(ys.len())
        bind(xs[k], ys[k], vars, mut binds)

## The type bound to `p`, or unknown.
fn bound(binds List[Bind], p int) Ty
    for b in binds
        if b.param == p
            return b.ty
    Ty.Unknown

fn is_bound(binds List[Bind], p int) bool
    for b in binds
        if b.param == p
            return true
    false

## Replace the bound type parameters, and make the other `vars` unknown.
@allow("expr.match.3") fn subst_unknown(t Ty, binds List[Bind], vars List[int]) Ty
    match t
        Param(p) =>
            for b in binds
                if b.param == p
                    return b.ty
            if vars.contains(p) then Ty.Unknown else t
        Struct(s, args) => Ty.Struct(s, [subst_unknown(a, binds, vars) for a in args])
        Enum(e, args) => Ty.Enum(e, [subst_unknown(a, binds, vars) for a in args])
        ListOf(x) => Ty.ListOf(subst_unknown(x, binds, vars))
        SetOf(x) => Ty.SetOf(subst_unknown(x, binds, vars))
        MapOf(k, v) => Ty.MapOf(
            key: subst_unknown(k, binds, vars),
            value: subst_unknown(v, binds, vars),
        )
        Opt(x) => Ty.Opt(subst_unknown(x, binds, vars))
        Conc(k, x) => Ty.Conc(k, subst_unknown(x, binds, vars))
        Res(x, errs) =>
            match errs
                ErrSet(set) => Ty.Res(
                    subst_unknown(x, binds, vars),
                    Errs.ErrSet([subst_unknown(e, binds, vars) for e in set]),
                )
                Inferred => Ty.Res(subst_unknown(x, binds, vars), errs)
        Union(m) => Ty.Union([subst_unknown(x, binds, vars) for x in m])
        FnTy(ps, r) => Ty.FnTy(
            [subst_unknown(x, binds, vars) for x in ps],
            subst_unknown(r, binds, vars),
        )
        Tuple(xs) => Ty.Tuple([subst_unknown(x, binds, vars) for x in xs])
        _ => t

## Whether two declared field types could be the same type (type.struct.7).
fn may_be_same(a Ty, b Ty) bool
    a == b or (has_param(a) and has_param(b))

@allow("expr.match.3") fn has_param(t Ty) bool
    match t
        Param => true
        ListOf(e) => has_param(e)
        Opt(e) => has_param(e)
        SetOf(e) => has_param(e)
        Conc(_, e) => has_param(e)
        MapOf(k, v) => has_param(k) or has_param(v)
        Struct(_, args) => any_param(args)
        Enum(_, args) => any_param(args)
        FnTy(ps, r) => any_param(ps) or has_param(r)
        Tuple(xs) => any_param(xs)
        _ => false

fn any_param(ts List[Ty]) bool
    for t in ts
        if has_param(t)
            return true
    false
