## eff.cap.4-5, as `packages::check_grants`: the code of each package reaches
## only the capabilities its grants allow. One diagnostic per grant and
## capability, at the manifest line, naming a chain of calls from a function of
## the package (a public one if any reaches it).
use ast

fn Checker.check_grants(self) List[Diag]
    if prog.grants.len() == 0
        return []
    fx := infer_effects(prog, facts())
    mut dep_names := Set[str]()
    for g in prog.grants
        if not g.own
            dep_names.add(g.package)
    mut owner := List[str?]()
    for f in prog.fns
        if is_prelude_line(f.pos.line)
            owner.push(none)
        else
            head := module_at(prog, f.pos).split(".")[0]
            owner.push(if dep_names.contains(head) then head else "")
    mut out := List[Diag]()
    for g in prog.grants
        for cap in CAPABILITIES
            if g.caps.contains(cap)
                continue
            mut reaching := List[int]()
            for i in 0..prog.fns.len()
                if owner[i] == g.package and fx.sets[i].contains(cap)
                    reaching.push(i)
            if reaching.len() == 0
                continue
            mut at := reaching[0]
            for i in reaching
                if prog.public.contains(prog.fns[i].pos.line)
                    at = i
                    break
            chain := fx.chain(prog, at, cap)
            mut rule := "eff.cap.4"
            mut who := "dependency `{g.package}`"
            mut line := "this `dep` line"
            if g.own
                rule = "eff.cap.5"
                who = "this package"
                line = "its `package` line"
            mut help := "add `{cap}` to the `caps` of {line} if the package should reach it; otherwise remove the call"
            if g.caps.len() == 0
                help = "add `caps {cap}` to {line} if the package should reach `{cap}`; otherwise remove the call"
            first := chain.split(" -> ")[0]
            out.push(
                new_diag(
                    rule,
                    g.pos,
                    "{who} reaches the capability `{cap}`, which {line} doesn't grant: {chain}",
                )
                    .with_note(prog.fns[at].pos, "`{first}` reaches `{cap}`")
                    .with_help(help),
            )
    out

## Whether `p` is an absolute path (`/x`, `\\x`, `c:/x`).
fn grant_abs(p str) bool
    p.starts_with("/") or p.starts_with("\\") or (p.len() > 1 and p.slice(1, 2) == ":")

## The path of the manifest that holds the grant at global line `line`, "" when no file does.
fn grant_file(prog ast.Program, line int) str
    mut out := ""
    for f in prog.files
        if f.base < line
            out = f.path
    out

## eff.allow.13: the directories the scope `@tmp` stands for: `/tmp`, `/var/tmp` and the directories named by
## `TMPDIR`, `TEMP` and `TMP` (on macOS `TMPDIR` is under `/var/folders`).
fn grant_temp_dirs() List[str]
    mut out := ["/tmp", "/var/tmp"]
    for v in ["TMPDIR", "TEMP", "TMP"]
        d := env.get(v) else continue
        if grant_abs(d) and d != "" and not d.contains(",") and not out.contains(d)
            out.push(d)
    out

## eff.allow.12: a path scope of entry `e` that is not absolute is taken from `base_dir`, the directory of the
## manifest that holds it, so a run means the same from any working directory.
## eff.allow.13: the scope `@tmp` on a path entry is the system temporary directories, one entry each.
fn grant_rooted(e str, base_dir str) List[str]
    eq := e.find("=") else return [e]
    name := e.slice(0, eq)
    scope := e.slice(eq + 1, e.len())
    if name != "fs" and name != "fs.read" and name != "fs.write"
        return [e]
    if scope == "@tmp"
        mut dirs := List[str]()
        for d in grant_temp_dirs()
            dirs.push("{name}={d}")
        return dirs
    if grant_abs(scope)
        return [e]
    mut rest := scope
    while rest.starts_with("./")
        rest = rest.slice(2, rest.len())
    if rest == "" or rest == "."
        return ["{name}={base_dir}"]
    ["{name}={path.join(base_dir, rest)}"]

## eff.allow.10: the policy a run gets from the manifests. When the root package has a `caps` line and any
## entry anywhere carries a scope, it is every entry of every grant, sorted without repeats, as `--allow`
## takes it; otherwise "" (no run-time limit beyond the compile-time check). `cwd` is the working directory.
## eff.allow.12: path scopes are made absolute, and `manifest=PATH` names the root manifest for the denial text.
pub fn grants_policy(prog ast.Program, cwd str) str
    mut root := false
    mut scoped := false
    mut all := List[str]()
    for g in prog.grants
        mf_path := grant_file(prog, g.pos.line)
        mut base_dir := path.dir(mf_path)
        if base_dir == "." or base_dir == ""
            base_dir = cwd
        elif not grant_abs(base_dir)
            base_dir = path.join(cwd, base_dir)
        if g.own
            root = true
            # The root package's own line (its package name is empty here, as in `check_grants`).
            if g.package == "" and mf_path != "" and not mf_path.contains(",")
                all.push("manifest={mf_path}")
        for e in g.entries
            if e.contains("=")
                scoped = true
            for rooted in grant_rooted(e, base_dir)
                if not all.contains(rooted)
                    all.push(rooted)
    if not root or not scoped
        return ""
    all.sorted().join(",")
