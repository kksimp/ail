## Positions from here on are the prelude's.
pub PRELUDE_LINE := 1073741824

pub fn is_prelude_line(line int) bool
    line >= PRELUDE_LINE

## A name for a user type that clashes with the prelude type `n` (mod.unit.1).
pub fn prelude_alt(n str) str
    match n
        "Task" => "Job"
        "TaskGroup" => "JobGroup"
        "Channel" => "Pipe"
        "Mutex" => "Lock"
        "Atomic" => "Counter"
        "Heap" => "PriorityQueue"
        "Deque" => "DoubleQueue"
        "Seq" => "Sequence"
        "Grid" => "Board"
        "List" => "Items"
        "Map" => "Table"
        "Set" => "Group"
        _ => "My{n}"

## "`a`, `b` and `c`"
pub fn list_names(names List[str]) str
    quoted := ["`{n}`" for n in names]
    n := quoted.len()
    if n == 0
        return ""
    if n == 1
        return quoted[0]
    "{quoted[..n - 1].join(", ")} and {quoted[n - 1]}"

pub fn count(n int, noun str) str
    if n == 1 then "1 {noun}" else "{n} {noun}s"

pub fn was_were(n int) str
    if n == 1 then "1 was" else "{n} were"

## The closest of `candidates` to `name`, within about a third of its length
## (gram.rec.3): one edit up to 4 characters, two up to 7 (`naess` -> `names`); ties go
## to the first in sorted order.
pub fn suggest(name str, candidates List[str]) str?
    len := name.len()
    if len < 3
        return none
    limit := ((len + 1) / 3).max(1)
    mut best := ""
    mut best_d := limit + 1
    for c in candidates
        # Never offer the name that was given.
        if c == name
            continue
        d := edit_distance(name, c)
        if d < best_d or (d == best_d and c < best)
            best = c
            best_d = d
    if best_d <= limit then best else none

## Edits between `a` and `b`: a character inserted, deleted, changed, or two
## neighbours swapped (`dco` -> `doc` is one edit, as typing makes it).
pub fn edit_distance(a str, b str) int
    x := a.chars()
    y := b.chars()
    mut before := [j for j in 0..y.len() + 1]
    mut prev := [j for j in 0..y.len() + 1]
    for i in 1..x.len() + 1
        mut cur := [i for _ in 0..y.len() + 1]
        for j in 1..y.len() + 1
            cost := if x[i - 1] != y[j - 1] then 1 else 0
            cur[j] = (prev[j] + 1).min(cur[j - 1] + 1).min(prev[j - 1] + cost)
            if i > 1 and j > 1 and x[i - 1] == y[j - 2] and x[i - 2] == y[j - 1]
                cur[j] = cur[j].min(before[j - 2] + 1)
        before = prev
        prev = cur
    prev[y.len()]

## A type name from another language and the AIL type for it.
pub fn foreign_type_word(name str) str?
    match name
        "Integer" | "Int" | "long" | "Long" | "short" | "Number" | "number" | "integer" | "int32" | "int64" | "size_t" | "usize" | "isize" | "uint" | "uint64" | "ssize_t" | "i128" | "u128" => "int"
        "String" | "string" | "std::string" | "Str" | "text" => "str"
        "Boolean" | "boolean" | "Bool" => "bool"
        "double" | "Double" | "float64" | "Float" | "float32" | "real" => "float"
        "Vec" | "Array" | "array" | "list" | "ArrayList" | "vector" | "VecDeque" => "List"
        "dict" | "Dict" | "HashMap" | "Dictionary" | "map" | "object" | "BTreeMap" => "Map"
        "HashSet" | "set" | "TreeSet" | "BTreeSet" => "Set"
        "Character" | "rune" => "char"
        _ => none
