## Function bodies (ADR 0377): blocks, statements, bindings, `else`,
## loops and assignment, as `check_fn` onward in `77592931:bootstrap/src/check.rs`.
use ast
use fix

## What the checker found, and the functions it couldn't type yet.
pub struct Report
    pub diags List[Diag]
    pub gapped List[int]
    pub gapped_structs List[int]
    pub gapped_consts List[int]
    ## Lines of generated code's `impl` whose functions are gapped.
    pub gapped_lines List[int]

## What `ail api` reads besides the diagnostics: each function's checked
## effect set (api.out.4) and the error types of each fallible function
## (err.api.1), by function index.
pub struct Analysis
    pub report Report
    pub effects List[List[str]]
    pub errors Map[int, List[str]]
    ## What each use of a declared name refers to (api.ref.1), by `pos_key`.
    pub symbols Map[int, str]
    pub weak_symbols Map[int, str]
    ## What `ail api --locals/--type` select from (api.loc.1, api.type.1).
    pub locals List[LocalFact]
    pub exprs List[(ast.Pos, str)]
    ## The name positions of every field a write reaches (`ail ask`, api.ask.2).
    pub writes List[ast.Pos]
    ## Each function's failure paths (err.paths.1).
    pub fail_paths List[FailPath]

## Every pass of `check_with` this checker has, in its order.
pub fn check_program(p ast.Program) Report
    analyze(p, false).report

## `check_program`, and with `full` the facts `ail api` outlines.
pub fn analyze(p ast.Program, full bool) Analysis
    analyze_denying(p, full, [])

## The checker after every declaration and function body has been checked.
fn checked_fns(p ast.Program, full bool, denied List[str]) Checker
    mut c := new_checker(p)
    c.denied = denied
    c.list_param = c.new_param("T", [])
    c.collect_traits()
    c.collect_types()
    c.collect_impls()
    c.resolve_fields()
    c.check_unique_fields()
    c.collect_fns()
    c.collect_consts()
    c.check_uses()
    c.check_deferred_bounds()
    c.check_main()
    c.check_attrs()
    c.check_impls()
    for i in 0..p.structs.len()
        c.gap_now = false
        c.check_invariants(i)
        if c.gap_now
            c.gapped_structs.add(i)
        c.check_field_defaults(i)
    # err.type.6: inferred error sets are the least fixed point, found by
    # re-checking the functions silently until nothing changes.
    inferring := [i for i in 0..p.fns.len() if is_inferred(c.sigs[i].ret)]
    if inferring.len() > 0
        for _ in 0..p.fns.len() + 1
            before := c.inferred
            saved := c.diags.len()
            for i in inferring
                c.check_fn(i)
            c.diags = c.diags[..saved]
            if c.inferred == before
                break
    # eff.use.1: only the last pass's discards count.
    c.discards = Map[int, Discard]()
    c.record = full
    for i in 0..p.fns.len()
        c.check_fn(i)
    c.record = false
    c

## The `for` loops `conc.par.2-4` prove independent, which `ail run --parallel`
## puts on the pool (conc.par.8): their positions.
pub fn proven_loops(p ast.Program) List[ast.Pos]
    c := checked_fns(p, false, [])
    c.proven_loops()

## The `for` loops of the program with their parallel verdicts (conc.par.6): `ail effects --parallel`.
pub fn parallel_rows(p ast.Program) List[ParRow]
    c := checked_fns(p, false, [])
    c.parallel_rows()

## What the lowering runs in parallel: the proven loops and the calls of the
## runs that fork (conc.par.8, conc.par.15), from one check of the program.
pub struct ParSites
    pub loops List[ast.Pos]
    pub forks List[ForkSite]

pub fn par_sites(p ast.Program) ParSites
    c := checked_fns(p, false, [])
    ParSites(loops: c.proven_loops(), forks: c.fork_sites())

## The runs of independent pure calls that could fork (conc.par.15): `ail effects --parallel`.
pub fn fork_rows(p ast.Program) List[ForkRow]
    c := checked_fns(p, false, [])
    c.fork_rows()

## `analyze` that also rejects a `main` that reaches a capability of `denied` (eff.cap.1).
pub fn analyze_denying(p ast.Program, full bool, denied List[str]) Analysis
    mut c := checked_fns(p, full, denied)
    c.check_drop_impls()
    c.diags.extend(check_moves(p, c.moved))
    c.diags.extend(c.check_pure())
    c.diags.extend(c.check_caps())
    c.diags.extend(c.check_discards())
    c.diags.extend(c.check_denied())
    c.diags.extend(c.check_grants())
    c.diags.extend(check_handles(p))
    c.diags.extend(check_observe(p))
    c.diags.extend(check_tools(p))
    c.diags.extend(c.check_contract_effects())
    c.diags.extend(c.check_constants())
    c.diags.extend(c.check_par())
    c.diags.extend(c.check_par_comps())
    c.remap_generated()
    report := Report(
        diags: c.diags,
        gapped: c.gapped.sorted(),
        gapped_structs: c.gapped_structs.sorted(),
        gapped_consts: c.gapped_consts.sorted(),
        gapped_lines: c.gapped_impl_lines(),
    )
    if not full
        return Analysis(
            report: report,
            effects: [],
            errors: Map[int, List[str]](),
            symbols: Map[int, str](),
            weak_symbols: Map[int, str](),
            locals: [],
            exprs: [],
            writes: [],
            fail_paths: [],
        )
    mut errors := Map[int, List[str]]()
    for i in 0..p.fns.len()
        # Every file of a package, and generated code (`api --card`, `--expanded`), but not the prelude.
        if p.fns[i].pos.line >= 1073741824
            continue
        match c.sigs[i].ret
            Res(_, errs) => errors[i] = c.error_names(c.errs_of(errs))
            _ => continue
    Analysis(
        report: report,
        effects: infer_effects(p, c.facts()).sets,
        errors: errors,
        symbols: c.symbols,
        weak_symbols: c.weak_symbols,
        locals: c.fact_locals,
        exprs: c.fact_exprs,
        writes: c.fact_writes,
        fail_paths: c.fail_paths,
    )

## The diagnostics of the declaration passes only (slice 1).
pub fn check_declarations(p ast.Program) List[Diag]
    check_program(p).diags

## ct.gen.3: a diagnostic in generated code is reported at the deriving `impl`.
fn Checker.remap_generated(mut self)
    mut from_impl := [false for _ in diags]
    for g in prog.generated
        base := prog.files[g.file].base
        for k in 0..diags.len()
            at := diags[k].pos
            if at.line > base and at.line <= base + 1048576
                diags[k] = diags[k].with_note(
                    at,
                    "in the code `{g.generator}` generated for this `impl`, at gen:impl:{g.label}:{at.line - base}:{at.col}",
                )
                diags[k].pos = g.impl_pos
                diags[k] = json_field_problem(g, diags[k])
                from_impl[k] = true
    # After json.derive.1-2 names the field, the generated code's other
    # problems are its follow-ons (an `else e` whose call failed).
    mut named := List[ast.Pos]()
    for k in 0..diags.len()
        if from_impl[k] and diags[k].rule.starts_with("json.derive.")
            named.push(diags[k].pos)
    if named.len() == 0
        return
    mut kept := List[Diag]()
    for k in 0..diags.len()
        d := diags[k]
        if not (from_impl[k] and named.contains(d.pos) and not d.rule.starts_with("json.derive."))
            kept.push(d)
    diags = kept

## json.derive.1-2: a derived JSON conversion that calls `to_json` or
## `from_json` on a field type with none says so in the user's terms.
fn json_field_problem(g ast.Generated, d Diag) Diag
    mut trait_name := "FromJson"
    mut method := "from_json"
    # `to_json` is a method; `from_json` is an associated function
    # (`T.from_json(j)`).
    mut missing := "associated function"
    if g.generator == "derive_to_json"
        trait_name = "ToJson"
        method = "to_json"
        missing = "method"
    elif g.generator != "derive_from_json"
        return d
    # `to_json` is a method, `from_json` an associated function (trait.assoc.1).
    mut suffix := " has no method `{method}`"
    alt := " has no associated function `{method}`"
    if d.message.ends_with(alt)
        suffix = alt
    if d.rule != "expr.name.1" or not d.message.ends_with(suffix)
        return d
    ty := d.message.slice(0, d.message.len() - suffix.len())
    owner := g.label.split(".")[0]
    mut out := d
    out.rule = if method == "to_json" then "json.derive.1" else "json.derive.2"
    out.message = "can't derive `{trait_name}` for `{owner}`: a field has type {ty}, which has no JSON form"
    out.help = "give {ty} its own `impl {trait_name}`, or change the field to `int`, `float`, `bool`, `str`, `Json`, a `List`, a `Map[str, _]`, an optional or a derived type"
    out

## The deriving `impl` lines of generated code with a gapped function,
## where `ail check` reports that code's diagnostics (ct.gen.3).
fn Checker.gapped_impl_lines(self) List[int]
    mut out := List[int]()
    for g in prog.generated
        base := prog.files[g.file].base
        for k in gapped
            line := prog.fns[k].pos.line
            if line > base and line <= base + 1048576 and not out.contains(g.impl_pos.line)
                out.push(g.impl_pos.line)
    out

## A construct this checker doesn't type yet: the function's lines are left
## out of the comparison, and its value is unknown.
fn Checker.gap(mut self, why str) Ty
    gap_now = true
    if env.get("AIL_CHECK_GAPS") != none
        io.eprint("gap {why}")
    Ty.Unknown

fn Checker.warn(mut self, rule str, at ast.Pos, text str, hint str)
    mut d := new_diag(rule, at, text).with_help(hint)
    d.warning = true
    diags.push(d)

fn Checker.local(self, n str) Local?
    for k in 0..locals.len()
        l := locals[locals.len() - 1 - k]
        if l.name == n
            return l
    none

fn Checker.check_fn(mut self, idx int)
    f := prog.fns[idx]
    gap_now = false
    cur_fn = idx
    allow_wildcards = [
        a
        for a in f.attrs if a.name == "allow" and a.arg == "expr.match.3"
    ].len() > 0
    if f.ext != none
        check_extern(idx, f)
        end_fn(idx)
        return
    if [a for a in f.attrs if a.name == "export c"].len() > 0
        check_export(idx, f)
    if f.body == none
        if f.contracts.len() > 0
            check_bodyless_contracts(idx, f)
        end_fn(idx)
        return
    body := f.body else []
    sig := sigs[idx]
    scope = fn_scopes[idx]
    self_ty = fn_self[idx]
    locals = []
    anchored = 0
    anchors = Map[int, ast.Pos]()
    pending = []
    loop_depth = 0
    unsafe_depth = 0
    if f.unsafe_fn
        unsafe_opt_in(f.pos)
    catching = 0
    fn_ret = sig.ret
    # expr.yield.1: a generator's body gives elements, not a result.
    gen.elem = gen_start(f, sig.ret)
    if gen.elem != none
        fn_ret = Ty.Unit
    push_params(f, sig)
    check_contracts(f, sig.ret)
    need := not returns_nothing(sig.ret) and gen.elem == none
    mut want := none
    if need
        want = sig.ret
    got := block(body, want, need)
    if need and not accepts(sig.ret, got)
        mut at := f.pos
        if r := f.ret
            at = r.pos
        mut msg := "`{full_name(f)}` must end with an expression of type {show(sig.ret)}"
        if e := last_value(body)
            if got != Ty.Unit
                at = expr_pos(e)
                msg = "`{full_name(f)}` returns {show(sig.ret)}, but its body ends with {show(got)}"
        if is_res_or_union(got) or is_error_type(got)
            mismatch("expr.block.2", at, sig.ret, got)
        else
            mut d := new_diag("expr.block.2", at, msg)
            declared := match sig.ret
                Res(ok, _) => ok
                _ => sig.ret
            if declared == Ty.Int and got == Ty.Float
                # Two candidates, the likelier first; neither is applied, since each is a choice.
                d = d.with_help("convert the value with `x.to_int()`, or declare the return type `float` instead")
            if r := f.ret
                d = d.with_note(r.pos, "the return type is declared here")
            diags.push(d)
    end_fn(idx)

fn Checker.end_fn(mut self, idx int)
    record_locals(0)
    gen.elem = none
    scope = []
    self_ty = none
    if gap_now
        gapped.add(idx)

## The receiver and parameters of `f` as locals.
fn Checker.push_params(mut self, f ast.FnDecl, sig Sig)
    if f.receiver != none
        locals.push(Local(
            name: "self",
            ty: self_ty else Ty.Unknown,
            mutable: receiver_of(f) == true,
            how: LocalKind.SelfParam,
            decl: none,
        ))
    for k in 0..f.params.len()
        p := f.params[k]
        if declare(p.name, p.pos)
            how := if p.moved then LocalKind.MoveParam else LocalKind.ParamLocal
            locals.push(Local(
                name: p.name,
                ty: sig.params[k].ty,
                mutable: p.mutable,
                how: how,
                decl: none,
            ))

## The expression a block ends with, if it ends with one.
@allow("expr.match.3") fn last_value(body List[ast.Stmt]) ast.Expr?
    s := body.last()?
    match s
        Eval(e) => e
        _ => none

@allow("expr.match.3") fn is_res_or_union(t Ty) bool
    match t
        Res => true
        Union => true
        _ => false

## A function result with no success value (`Unit`, `!` or `! E`).
@allow("expr.match.3") fn returns_nothing(t Ty) bool
    match t
        Unit => true
        Res(ok, _) => ok == Ty.Unit
        _ => false

## The success type of a value that may be a failure.
@allow("expr.match.3") fn ok_type(t Ty) Ty
    match t
        Res(ok, _) => ok
        _ => t

@allow("expr.match.3") fn is_stmt_eval(s ast.Stmt) bool
    match s
        Eval => true
        _ => false

## A block's type: its last statement's (expr.block.1), or `Never` if a
## statement always leaves (expr.block.3).
fn Checker.block(mut self, stmts List[ast.Stmt], expect Ty?, need bool) Ty
    mark := locals.len()
    anchor_locals(mark, stmts)
    mut ty := Ty.Unit
    mut leaves := false
    for i in 0..stmts.len()
        s := stmts[i]
        last := i + 1 == stmts.len()
        mut want := none
        if last
            want = expect
        marks := effect_marks
        ty = stmt(s, want, last and need)
        if ty == Ty.Never
            leaves = true
        # own.uniq.2: a block's value leaves it.
        if last and need
            if e := eval_of(s)
                consume(e, ty)
        # err.use.1: a failure can't be discarded.
        if (not last or not need) and is_stmt_eval(s) and reject_unhandled(ty, stmt_pos(s))
            ty = Ty.Unknown
        elif not last or not need
            note_discard(s, ty, marks, last)
    end_scope(mark)
    if leaves then Ty.Never else ty

@allow("expr.match.3") fn eval_of(s ast.Stmt) ast.Expr?
    match s
        Eval(e) => e
        _ => none

@allow("expr.match.3") fn is_empty_literal(e ast.Expr) bool
    match e
        ListLit(xs, _) => xs.len() == 0
        SetLit(xs, _) => xs.len() == 0
        MapLit(xs, _) => xs.len() == 0
        _ => false

@allow("expr.match.3") fn is_none_literal(e ast.Expr) bool
    match e
        NoneLit => true
        _ => false

@allow("expr.match.3") fn is_list_literal(e ast.Expr) bool
    match e
        ListLit => true
        _ => false

fn Checker.stmt(mut self, s ast.Stmt, expect Ty?, need bool) Ty
    match s
        Let(n, at, mutable, value, otherwise) =>
            let_stmt(n, at, mutable, value, otherwise)
            Ty.Unit
        LetTuple(names, value, at) =>
            let_tuple(names, value, at)
            Ty.Unit
        Assign(target, op, value, at) =>
            assign(target, op, value, at)
            Ty.Unit
        While(cond, body, _) =>
            condition(cond)
            loop_depth += 1
            block(body, none, false)
            loop_depth -= 1
            # expr.loop.7: `while true` with no `break` of its own never finishes.
            if is_true(cond) and not breaks(body) then Ty.Never else Ty.Unit
        Handle(value, otherwise) =>
            handle(value, otherwise)
            Ty.Unit
        For(_, var, var_pos, mutable, iter, body, _) =>
            elem := if mutable then mut_iterable(iter, var, body) else iterable(
                iter,
                is_hidden(var),
            )
            mark := locals.len()
            # type.tuple.5: the hidden variable of `for a, b in xs` clashes only when the names do.
            if is_hidden(var) or declare(var, var_pos)
                locals.push(Local(
                    name: var,
                    ty: elem,
                    mutable: mutable,
                    how: LocalKind.LoopVar,
                    decl: none,
                ))
            loop_depth += 1
            block(body, none, false)
            loop_depth -= 1
            end_scope(mark)
            Ty.Unit
        With(mutex, var, var_pos, body, at) =>
            with_stmt(mutex, var, var_pos, body, at)
            Ty.Unit
        Unsafe(body, at) =>
            unsafe_opt_in(at)
            unsafe_depth += 1
            t := block(body, expect, need)
            unsafe_depth -= 1
            t
        Break(at) =>
            if loop_depth == 0 and not leaves_literal("break", at)
                err("expr.loop.5", at, "`break` outside a loop")
            Ty.Never
        Continue(at) =>
            if loop_depth == 0 and not leaves_literal("continue", at)
                err("expr.loop.5", at, "`continue` outside a loop")
            Ty.Never
        Return(value, at) =>
            return_stmt(value, at)
            Ty.Never
        Eval(e) => expr(e, expect, need)
        Defer(inner, at) =>
            defer_stmt(inner, at)
            Ty.Unit

@allow("expr.match.3") fn is_true(e ast.Expr) bool
    match e
        Bool(b, _) => b
        _ => false

fn Checker.let_stmt(mut self, n str, at ast.Pos, mutable bool, value ast.Expr, otherwise ast.Else?)
    # type.coll.13: `x := []` or `{}` is typed by its first use; type.opt.9:
    # so is a `mut` local that starts as `none`.
    opt := mutable and is_none_literal(value)
    if (is_empty_literal(value) or opt) and otherwise == none
        # eff.use.1: `_ := e` throws the value away; `_` is never a binding.
        if n != "_" and declare(n, at)
            index := locals.len()
            locals.push(Local(
                name: n,
                ty: Ty.Unknown,
                mutable: mutable,
                how: LocalKind.Binding,
                decl: at,
            ))
            pending.push(Pending(
                name: n,
                lit: expr_pos(value),
                brace: not is_list_literal(value) and not opt,
                opt: opt,
                index: index,
            ))
        return
    mut vt := Ty.Unit
    if otherwise != none
        vt = else_value(value, otherwise)
    else
        vt = expr(value, none, true)
    consume(value, vt)
    mut ty := vt
    if o := otherwise
        ty = else_part(vt, value, o)
    elif reject_unhandled(vt, expr_pos(value))
        ty = ok_type(vt)
    if ty == Ty.Unit
        text := "`{n}` would be bound to an expression that produces no value"
        if method_name(value) == "sort"
            err_help(
                "expr.bind.1",
                expr_pos(value),
                text,
                "`sort()` changes the list in place; `xs.sorted()` gives a new sorted list",
            )
        else
            err("expr.bind.1", expr_pos(value), text)
    if n == "_"
        return
    if declare(n, at)
        locals.push(Local(name: n, ty: ty, mutable: mutable, how: LocalKind.Binding, decl: at))
    elif mutable and diags.len() > 0 and diags[diags.len() - 1].fixes.len() > 0
        # `mut x := e` again becomes `x = e`, so the `mut` goes too.
        diags[diags.len() - 1].fixes[0].edits.insert(0, fix.replace(
            ast.Pos(line: at.line, col: 1),
            "mut ",
            "",
        ))

@allow("expr.match.3") fn method_name(e ast.Expr) str
    match e
        Method(_, n, _, _) => n
        _ => ""

fn Checker.return_stmt(mut self, value ast.Expr?, at ast.Pos)
    if leaves_literal("return", at)
        if v := value
            expr(v, none, true)
        return
    if gen_return(value, at)
        return
    want := fn_ret
    v := value else
        if not returns_nothing(want)
            err("expr.block.2", at, "this function returns {show(want)}, so `return` needs a value")
        return
    if want == Ty.Unit
        t := expr(v, none, true)
        if is_error_type(t)
            return_error_in_infallible(v, t)
        else
            err_help(
                "expr.block.2",
                expr_pos(v),
                "this function doesn't return a value",
                "remove the value, or declare a return type after `)`",
            )
        return
    t := expr(v, want, true)
    consume(v, t)
    if accepts(want, t)
        if is_error_type(t)
            note_path(expr_pos(v), "return", "", none, [t], false)
        else
            match t
                Res(_, errs) => note_path(expr_pos(v), "return", "", v, errs_of(errs), false)
                _ => 0
        return
    want_res := is_res(want)
    if not want_res and is_error_type(t)
        return_error_in_infallible(v, t)
    elif want_res and is_error_type(t)
        mut hint := "add it to the return type"
        if r := failing_ret([t])
            hint = "add it to the return type: `{r}`"
        err_help(
            "err.ret.3",
            expr_pos(v),
            "`{ty_name(t)}` isn't one of the errors this function can fail with",
            hint,
        )
    elif want_res and is_opt(t)
        err_help(
            "err.ret.2",
            expr_pos(v),
            "an optional can't be returned as a result; absence has no error to report",
            "turn absence into an error first: `x := ... else return SomeError`, then return `x`",
        )
    else
        mismatch("expr.block.2", expr_pos(v), want, t)

@allow("expr.match.3") fn is_res(t Ty) bool
    match t
        Res => true
        _ => false

## `t` as an optional: `T?` stays, and `T` becomes `T?`.
fn as_opt(t Ty) Ty
    if is_opt(t) then t else Ty.Opt(t)

@allow("expr.match.3") fn is_opt(t Ty) bool
    match t
        Opt => true
        _ => false

## `return e` of an error value in a function that can't fail (err.ret.1).
fn Checker.return_error_in_infallible(mut self, v ast.Expr, t Ty)
    err_help(
        "err.ret.1",
        expr_pos(v),
        "`{ty_name(t)}` is an error, but this function can't fail",
        "declare the failure in the return type (`T ! E`), or return a value instead",
    )
    sig_fix_last([t])

## The value of `e else ...`. An optional `?` inside it goes to the `else`
## (err.prop.4), which makes the value optional if it wasn't.
@allow("expr.match.3") fn Checker.else_value(mut self, value ast.Expr, o ast.Else?) Ty
    before := caught
    catching += 1
    vt := expr(value, none, true)
    catching -= 1
    if caught > before and is_res(vt)
        if nm := else_name(o)
            err_help(
                "err.prop.4",
                nm.pos,
                "`{nm.name}` would have no error when a `?` inside the value finds `none`",
                "handle the optional separately: `x := opt else ...`, then the result",
            )
    match vt
        Opt => vt
        Res => vt
        Unknown => vt
        _ => if caught > before then Ty.Opt(vt) else vt

## The name of `else name` and a block.
fn else_name(o ast.Else?) ast.Ident?
    e := o else return none
    match e
        Handler(name, _, _) => name
        Fallback | Leave => none

## `f(x) else ...` for a result with no success value (err.else.4).
@allow("expr.match.3") fn Checker.handle(mut self, value ast.Expr, otherwise ast.Else)
    vt := expr(value, none, true)
    match vt
        Res(ok, _) =>
            if ok == Ty.Unit
                else_part(vt, value, otherwise)
                return
            handle_has_value(value, vt, "can fail")
        Opt => handle_has_value(value, vt, "may be absent")
        Unknown => return
        _ =>
            err_help(
                "err.else.4",
                expr_pos(value),
                "`else` handles a failure, but this is {show(vt)} and can't fail",
                "remove the `else`",
            )

fn Checker.handle_has_value(mut self, value ast.Expr, vt Ty, what str)
    err_help(
        "err.else.4",
        expr_pos(value),
        "this {what}, and has a value ({show(vt)}); `else` on its own handles only results with no value",
        "bind the value: `x := ... else ...`",
    )

## Help for `else` on a value that is never absent (expr.name.2).
@allow("expr.match.3") fn never_absent_help(value ast.Expr) str?
    match value
        Index => "indexing traps when the index or key is missing; for a map, `m.get(k)` gives an optional"
        Method(_, n, _, _) =>
            if n == "to_int"
                return "`x.to_int()` on a float traps on NaN or out of range; it never returns `none`"
            none
        _ => none

## Whether `o` is the `else break` that the parser writes for `while name := e`
## (expr.loop.8): its `break` sits at the `while`, before the value `at`.
fn while_bound(at ast.Pos, o ast.Else) bool
    mut found := false
    match o
        Leave(s) =>
            match s
                Break(p) => found = p.line < at.line or (p.line == at.line and p.col < at.col)
                _ => found = false
        _ => found = false
    found

## The `else` part of `x := e else ...`; returns the type bound to `x`
## (err.else.1-3).
@allow("expr.match.3") fn Checker.else_part(mut self, vt Ty, value ast.Expr, o ast.Else) Ty
    at := expr_pos(value)
    mut ok := vt
    mut errors := List[Ty]()
    mut fails := false
    match vt
        Opt(t) => ok = t
        Res(t, e) =>
            ok = t
            errors = errs_of(e)
            fails = true
        Unknown => ok = Ty.Unknown
        _ =>
            text := "`else` handles a value that can be absent (`T?`) or fail (`T ! E`), but this is {show(vt)}"
            if while_bound(at, o)
                # `while name := e` is written as `name := e else break` (expr.loop.8).
                err_help(
                    "expr.loop.8",
                    at,
                    "`while name := e` needs `e` to be `T?` or `T ! E`, but this is {show(vt)}",
                    "use `while cond` for a `bool` condition, or make `e` return a `T?`",
                )
            elif h := never_absent_help(value)
                err_help("err.else.1", at, text, h)
            else
                err("err.else.1", at, text)
    match vt
        Opt | Res =>
            mut how := "block"
            match o
                Fallback => how = "default"
                Leave => how = "leave"
                Handler => how = "block"
            kind := if fails then "handle" else "absent"
            note_path(at, kind, how, value, errors, false)
        _ => 0
    match o
        Fallback(d) =>
            if ok == Ty.Unit
                expr(d, none, true)
                err_help(
                    "err.else.4",
                    expr_pos(d),
                    "this result has no value, so there's nothing to fall back to",
                    "write `else return`, or `else err` with a block that handles the error",
                )
            else
                dt := expr(d, ok, true)
                if not accepts(ok, dt)
                    mismatch("err.else.1", expr_pos(d), ok, dt)
                    # A whole-number float literal where an `int` is expected is written `2`.
                    match d
                        Float(f, p) =>
                            if ok == Ty.Int
                                and f == f.floor()
                                and diags.len() > 0
                                and diags[diags.len() - 1].rule == "err.else.1"
                                whole := f.to_int()
                                fix_last("write `{whole}` as an int", [fix.replace(
                                    p,
                                    "{f:.1}",
                                    "{whole}",
                                )])
                        _ => ok = ok
        Leave(st) => stmt(st, none, false)
        Handler(name, body, bpos) =>
            mark := locals.len()
            if nm := name
                if fails
                    t := if errors.len() == 1 then errors[0] else Ty.Union(errors)
                    if declare(nm.name, nm.pos)
                        locals.push(Local(
                            name: nm.name,
                            ty: t,
                            mutable: false,
                            how: LocalKind.Binding,
                            decl: none,
                        ))
                elif ok != Ty.Unknown
                    err_help(
                        "err.else.3",
                        nm.pos,
                        "only a failure has an error to bind; an optional is just absent",
                        "write `else` without a name",
                    )
                    fix_last("remove `{nm.name}` from the `else`", [fix.delete(
                        ast.Pos(line: nm.pos.line, col: (nm.pos.col - 1).max(1)),
                        ast.Pos(line: nm.pos.line, col: nm.pos.col + nm.name.len()),
                    )])
                elif declare(nm.name, nm.pos)
                    # The value already failed to check: bind the name as unknown,
                    # so its uses in the block don't cascade.
                    locals.push(Local(
                        name: nm.name,
                        ty: Ty.Unknown,
                        mutable: false,
                        how: LocalKind.Binding,
                        decl: none,
                    ))
            # err.else.4: with no value to supply, the block may just end.
            unit := ok == Ty.Unit
            t := if unit then block(body, none, false) else block(body, ok, true)
            end_scope(mark)
            if not unit and not accepts(ok, t)
                err(
                    "err.else.2",
                    bpos,
                    "this `else` block must leave (with `return`, `break` or `continue`) or end with {show(ok)}",
                )
    ok

## Check a new local name against the no-shadowing rules; true if it can be
## added (expr.bind.4-5).
fn Checker.declare(mut self, n str, at ast.Pos) bool
    if record
        bound[locals.len()] = at
    if l := local(n)
        mut d := new_diag("expr.bind.4", at, "`{n}` is already declared in this function")
        if first := l.decl
            d = d.with_note(first, "`{n}` is first declared here")
        if l.mutable
            d = d.with_help("`{n}` is a `mut` variable; to change it, write `{n} = ...`")
            d = d.with_fix("assign to `{n}` with `=`", [fix.replace(at, ":=", "=")])
        else
            d = d.with_help("choose a different name; names can't be shadowed")
        diags.push(d)
        return false
    # The prelude's own locals never meet the program's items, and a
    # module's locals meet only its own (expr.bind.5).
    if is_prelude_line(at.line) or module_at(prog, at) != ""
        return true
    mut what := ""
    # A local may shadow a function (ADR 0469); a call of it in the local's
    # block is expr.call.1.
    if fns.contains(n) or PRELUDE_FNS.contains(n)
        return true
    elif types.contains(n) or BUILTIN_TYPES.contains(n)
        what = "a type"
    elif consts.contains(n)
        what = "a constant"
    elif std_imported(n) != none
        what = "an imported module"
    else
        return true
    mut d := new_diag(
        "expr.bind.5",
        at,
        "`{n}` is already {what} name",
    ).with_help("choose a different name for the local")
    if j := fns.get(n)
        if not is_prelude_line(prog.fns[j].pos.line)
            d = d.with_note(prog.fns[j].pos, "`{n}` is declared here")
    elif t := types.get(n)
        if not is_prelude_line(def_pos(t).line)
            d = d.with_note(def_pos(t), "`{n}` is declared here")
    elif j := consts.get(n)
        d = d.with_note(prog.consts[j].pos, "`{n}` is declared here")
    diags.push(d)
    false

## The pending entry of local `n`, if its type isn't known yet (type.coll.13).
fn Checker.pending_of(self, n str) int?
    for k in 0..pending.len()
        p := pending[k]
        if p.name == n and p.index < locals.len() and locals[p.index].name == n
            return k
    none

## Give pending local `k` its type, now known.
fn Checker.settle(mut self, k int, t Ty)
    p := pending.remove_at(k)
    locals[p.index].ty = t

## Report a use of pending local `k` before its type is known.
fn Checker.unsettled(mut self, k int, at ast.Pos)
    p := pending.remove_at(k)
    if p.opt
        err_help(
            "type.opt.9",
            at,
            "the type of `{p.name}` isn't known yet",
            "its first assignment should fix it, such as `{p.name} = e`",
        )
        locals[p.index].ty = Ty.Unknown
        return
    ctor := if p.brace then "`Map[K, V]()` or `Set[T]()`" else "`List[T]()`"
    first := if p.brace then "`{p.name}.add(x)` or `{p.name}[k] = v`" else "`{p.name}.push(x)`"
    err_help(
        "type.coll.13",
        at,
        "the type of `{p.name}` isn't known yet",
        "its first use should fix it, such as {first}; or declare it with {ctor}",
    )
    locals[p.index].ty = Ty.Unknown

## The type of `e`, reporting nothing: to fix a pending local's type first.
fn Checker.quiet_type(mut self, e ast.Expr) Ty
    n := diags.len()
    was := gap_now
    t := expr(e, none, true)
    diags = diags[..n]
    gap_now = was or gap_now
    t

## Leave a block: its locals go out of scope, and one never typed is an
## error (type.coll.13).
fn Checker.end_scope(mut self, mark int)
    mut k := 0
    while k < pending.len()
        if pending[k].index >= mark
            p := pending.remove_at(k)
            if p.opt
                err_help(
                    "type.opt.9",
                    p.lit,
                    "nothing fixes the type of `{p.name}`",
                    "assign it a value with `{p.name} = e` first",
                )
                continue
            ctor := if p.brace then "`Map[K, V]()` or `Set[T]()`" else "`List[T]()`"
            err_help(
                "type.coll.13",
                p.lit,
                "nothing fixes the type of `{p.name}`",
                "declare it with {ctor}",
            )
        else
            k += 1
    record_locals(mark)
    locals = locals[..mark]

fn Checker.condition(mut self, cond ast.Expr)
    t := expr(cond, Ty.Bool, true)
    if reject_unhandled(t, expr_pos(cond))
        return
    if accepts(Ty.Bool, t)
        return
    hint := truthiness_help(t)
    suffix := truthiness_suffix(t)
    d := new_diag(
        "expr.if.2",
        expr_pos(cond),
        "a condition must be `bool`, found {show(t)}",
    ).with_help(hint)
    if is_simple_cond(cond) and suffix != ""
        diags.push(d.with_fix("test `{suffix.trim()}`", [fix.at_line_end(expr_pos(cond), suffix)]))
    else
        diags.push(d)

## The text that completes the test that `truthiness_help` suggests.
@allow("expr.match.3") fn truthiness_suffix(t Ty) str
    match t
        Int => " != 0"
        Str => " != \"\""
        ListOf => ".len() > 0"
        MapOf => ".len() > 0"
        SetOf => ".len() > 0"
        Opt => " != none"
        _ => ""

## A condition whose end an appended test attaches to.
@allow("expr.match.3") fn is_simple_cond(e ast.Expr) bool
    match e
        Name | Member | Method | Index | Call => true
        _ => false

## The test that the other languages' truthiness stands for.
@allow("expr.match.3") fn truthiness_help(t Ty) str
    match t
        Int => "compare explicitly, e.g. `n != 0`"
        Str => "compare explicitly, e.g. `s != \"\"`"
        ListOf => "test the length, e.g. `xs.len() > 0`"
        MapOf => "test the length, e.g. `xs.len() > 0`"
        SetOf => "test the length, e.g. `xs.len() > 0`"
        Opt => "compare with `none`, e.g. `x != none`, or bind it with `if v := x`"
        _ => "write a comparison that gives `bool`"

## The element type of a `for` loop's iterable (expr.loop.4).
@allow("expr.match.3") fn Checker.iterable(mut self, iter ast.Expr, pairs bool) Ty
    if is_range(iter)
        return range_loop(iter)
    t := expr(iter, none, true)
    at := expr_pos(iter)
    match t
        ListOf(e) => e
        SetOf(e) => e
        # type.bytes.5: iterating `bytes` gives each `u8`.
        Bytes => Ty.Num("u8")
        Conc(k, e) =>
            if k == "Channel"
                # conc.share.7: the loop synchronises with other tasks (conc.par.2).
                handle_calls.add(pos_key(at))
                return e
            iterate_error(t, at, iter)
        Unknown => Ty.Unknown
        Res =>
            reject_unhandled(t, at)
            Ty.Unknown
        MapOf(k, v) =>
            # type.tuple.5: `for k, v in m` takes each entry apart.
            if pairs
                return Ty.Tuple([k, v])
            mut d := new_diag(
                "type.map.5",
                at,
                "`for` iterates a map's entries as `k, v`, or its keys or values",
            ).with_help("write `for k, v in m`, `for k in m.keys()`, or `m.values()`")
            match iter
                Name(n, p) => d = d.with_fix("iterate the keys", [fix.replace(p, n, "{n}.keys()")])
                _ => d = d
            diags.push(d)
            Ty.Unknown
        Str =>
            err_help("expr.loop.4", at, "`for` can't iterate over a `str`", "iterate `s.chars()`")
            Ty.Unknown
        # expr.iter.1: a type with `fn next(mut self) T?`, a `Seq[T]` among them.
        Struct | Enum => iter_next(t, at, iter)
        _ => iterate_error(t, at, iter)

@allow("expr.match.3") fn Checker.range_loop(mut self, iter ast.Expr) Ty
    match iter
        Range(lo, hi, _, at) => loop_range(lo, hi, at)
        _ => return Ty.Int
    Ty.Int

@allow("expr.match.3") fn Checker.iterate_error(mut self, t Ty, at ast.Pos, iter ast.Expr) Ty
    text := "`for` can't iterate over {show(t)}"
    if t == Ty.Int
        err_help("expr.loop.4", at, text, "iterate over a range, e.g. `0..n`")
    elif is_opt(t)
        mut d := new_diag(
            "expr.loop.4",
            at,
            text,
        ).with_help("`recv()` gives one value or `none`; to receive until the channel is closed, write `for v in ch`")
        # `for v in ch.recv()` on a channel name: the loop is the receive.
        match iter
            Method(r, mname, _, args) =>
                if mname == "recv" and args.len() == 0
                    match r
                        Name(n, p) =>
                            if l := local(n)
                                if is_channel(l.ty)
                                    d = d.with_fix(
                                        "receive until the channel is closed",
                                        [fix.replace(p, "{n}.recv()", n)],
                                    )
                        _ => d = d
            _ => d = d
        diags.push(d)
    else
        err_help(
            "expr.loop.4",
            at,
            text,
            "`for` takes a list, a range `a..b`, a `keys()` or `values()` list, or a channel",
        )
    Ty.Unknown

## `for mut x in e`: `e` is a mutable list place that the body doesn't
## otherwise use (expr.loop.6, own.excl.5). Returns the element type.
@allow("expr.match.3")
fn Checker.mut_iterable(mut self, iter ast.Expr, var str, body List[ast.Stmt]) Ty
    if is_range(iter)
        err_help(
            "expr.loop.6",
            expr_pos(iter),
            "`for mut` changes the elements of a list, and a range has none",
            "remove the `mut`",
        )
        return Ty.Int
    t := expr(iter, none, true)
    mut elem := Ty.Unknown
    match t
        ListOf(e) => elem = e
        Unknown => return Ty.Unknown
        _ =>
            err("expr.loop.6", expr_pos(iter), "`for mut` needs a list, found {show(t)}")
            return Ty.Unknown
    require_mutable(iter, "expr.loop.6", "changed by `for mut`")
    if at := overlapping_use(iter, body)
        err_help(
            "own.excl.5",
            at,
            "the loop body can't use this while `for mut` is changing its elements",
            "change the current element through `{var}`",
        )
    elem

## The bounds of a `for` range, which needs both (expr.loop.3).
fn Checker.loop_range(mut self, lo ast.Expr?, hi ast.Expr?, at ast.Pos)
    if lo == none or hi == none
        err_help(
            "expr.loop.3",
            at,
            "a `for` range needs both bounds",
            "write `a..b`; open ranges are only for slices, `xs[a..]`",
        )
    range_bounds(lo, hi)

fn Checker.range_bounds(mut self, lo ast.Expr?, hi ast.Expr?)
    for b in [lo, hi]
        if e := b
            t := expr(e, Ty.Int, true)
            if not accepts(Ty.Int, t)
                err("expr.loop.3", expr_pos(e), "range bounds must be `int`, found {show(t)}")

## ---- Assignment and places ----

fn Checker.assign(mut self, target ast.Expr, op ast.BinOp?, value ast.Expr, at ast.Pos)
    # std.tensor.15: a tensor is a value, so `t[i] = v` is an error.
    if tensor_element_target(target)
        expr(value, none, true)
        err_help(
            "std.tensor.15",
            expr_pos(target),
            "a tensor's elements can't be assigned: a tensor is a value",
            "build a new tensor with `map`, or with `tensor.from`",
        )
        return
    # type.coll.13: `m[k] = v`, `m[k] += n` or `x = e` can fix a pending
    # local's type; `op=` starts a missing key at zero.
    settle_by_assign(target, op, value)
    if n := name_of(target)
        if local(n) == none
            expr(value, none, true)
            if n == "self"
                expr(target, none, true)
            else
                mut d := new_diag(
                    "expr.bind.3",
                    expr_pos(target),
                    "`{n}` isn't declared",
                ).with_help("declare it with `mut {n} := ...`")
                if op == none
                    d = d.with_fix("declare `{n}` with `mut {n} :=`", [
                        fix.insert(expr_pos(target), "mut "),
                        fix.replace(at, "=", ":="),
                    ])
                diags.push(d)
                # Later uses don't report the same name again (gram.rec.2).
                locals.push(Local(
                    name: n,
                    ty: Ty.Unknown,
                    mutable: true,
                    how: LocalKind.Binding,
                    decl: none,
                ))
            return
    mut rooted := false
    if root := place_root(target)
        rooted = local(root) != none
    tt := expr(target, none, true)
    if not rooted
        if tt != Ty.Unknown
            err(
                "expr.bind.6",
                expr_pos(target),
                "only a variable, or a field or element of one, can be assigned",
            )
        expr(value, none, true)
        return
    # type.bytes.2: `bytes` never changes in place.
    if bytes_element_target(target)
        err_help(
            "type.bytes.2",
            expr_pos(target),
            "`bytes` is immutable, so an element can't be assigned",
            "build a new value: `b = b[..i] + bytes.from_list([x]) + b[i + 1..]`, or edit a `List[u8]` and convert it with `bytes.from_list`",
        )
        expr(value, none, true)
        return
    if grid_field_target(target)
        err_help(
            "type.grid.2",
            expr_pos(target),
            "a grid's `rows`, `cols` and `cells` can't be assigned",
            "assign elements with `g[i, j] = v`, or build a new grid with `Grid.fill` or `Grid.from`",
        )
        expr(value, none, true)
        return
    if group_field_assign(target, tt)
        expr(value, none, true)
        return
    require_mutable(target, none, "assigned")
    vt := expr(value, tt, true)
    consume(value, vt)
    if o := op
        operator(o, tt, vt, at)
    elif not accepts(tt, vt)
        mismatch("expr.bind.6", expr_pos(value), tt, vt)

## `t[i]` where `t` is a local tensor.
@allow("expr.match.3") fn Checker.tensor_element_target(self, target ast.Expr) bool
    match target
        Index(recv, _, _) =>
            n := name_of(recv) else return false
            l := local(n) else return false
            tensor_elem(l.ty) != none
        _ => false

## `b[i]` where `b` is `bytes`.
@allow("expr.match.3") fn Checker.bytes_element_target(mut self, target ast.Expr) bool
    match target
        Index(recv, _, _) => quiet_type(recv) == Ty.Bytes
        _ => false

@allow("expr.match.3")
fn Checker.settle_by_assign(mut self, target ast.Expr, op ast.BinOp?, value ast.Expr)
    match target
        Index(recv, index, _) =>
            n := name_of(recv) else return
            k := pending_of(n) else return
            if not pending[k].brace
                return
            kt := quiet_type(index)
            vt := quiet_type(value)
            if op == none or vt == Ty.Int or vt == Ty.Float
                if k2 := pending_of(n)
                    settle(k2, Ty.MapOf(key: kt, value: vt))
        Name(n, _) =>
            if op != none
                return
            k := pending_of(n) else return
            vt := quiet_type(value)
            if pending[k].opt
                # type.opt.9: the first value gives `T?` (type.opt.5).
                if vt != Ty.Unknown and vt != Ty.Unit and vt != Ty.Never
                    settle(k, as_opt(vt))
                return
            brace := pending[k].brace
            if (not brace and is_list_ty(vt)) or (brace and (is_map_ty(vt) or is_set_ty(vt)))
                settle(k, vt)
        _ => return

@allow("expr.match.3") fn name_of(e ast.Expr) str?
    match e
        Name(n, _) => n
        _ => none

@allow("expr.match.3") fn is_list_ty(t Ty) bool
    match t
        ListOf => true
        _ => false

@allow("expr.match.3") fn is_map_ty(t Ty) bool
    match t
        MapOf => true
        _ => false

@allow("expr.match.3") fn is_set_ty(t Ty) bool
    match t
        SetOf => true
        _ => false

## Report if `e` isn't a mutable place (own.place.1). `rule` is the rule for
## this context; without one, it is chosen by the kind of root.
fn Checker.require_mutable(mut self, e ast.Expr, rule str?, action str)
    effect_marks += 1
    record_write(e)
    # own.ref.4: a `ref` cell's contents are mutable through any copy.
    if writes_through_ref(e, rule == "trait.method.3")
        ref_writes.add(pos_key(expr_pos(e)))
        return
    root := place_root(e) else
        err(
            rule else "expr.bind.6",
            expr_pos(e),
            "only a variable, or a field or element of one, can be {action}",
        )
        return
    l := local(root) else return
    if is_capture(root)
        capture_written(root, expr_pos(e), action)
        return
    if l.mutable
        return
    mut fallback_rule := ""
    mut text := ""
    mut hint := ""
    match l.how
        Binding =>
            fallback_rule = "expr.bind.3"
            text = "`{root}` is immutable"
            hint = "declare it with `mut {root} := ...`"
        SelfParam =>
            fallback_rule = "trait.method.1"
            text = "`self` is read-only in this method"
            hint = "declare the method with `mut self`"
        LoopVar =>
            fallback_rule = "expr.loop.4"
            text = "the loop variable `{root}` is immutable"
            hint = "copy it into a `mut` binding first"
        ParamLocal =>
            fallback_rule = "own.param.1"
            text = "the parameter `{root}` is read-only"
            hint = "declare it `mut {root} Type`, and pass it with `mut`"
        MoveParam =>
            fallback_rule = "own.param.1"
            text = "the parameter `{root}` is read-only"
            hint = "declare it `mut {root} Type`, and pass it with `mut`"
    mut d := new_diag(
        rule else fallback_rule,
        expr_pos(e),
        "{text}, so it can't be {action}",
    ).with_help(hint)
    # The binding's own position: where an agent changes the declaration.
    if decl := l.decl
        d = d.with_fix("declare `{root}` with `mut`", [fix.insert(decl, "mut ")])
        d = d.with_note(decl, "`{root}` is declared here")
    diags.push(d)

fn same_step(x Step, y Step, certain bool) bool
    match x
        SField(f) =>
            match y
                SField(g) => f == g
                SIndex => not certain
        SIndex(i) =>
            match y
                SField => not certain
                SIndex(j) => same_index(i, j, certain)

## Whether two index expressions are the same (certain) or may be (not certain).
@allow("expr.match.3") fn same_index(i ast.Expr, j ast.Expr, certain bool) bool
    match i
        Int(m, _) =>
            match j
                Int(n, _) => m == n
                _ => not certain
        Name(m, _) =>
            match j
                Name(n, _) => if certain then m == n else true
                _ => not certain
        _ => not certain

## Whether two argument places certainly overlap (own.excl.2).
fn Checker.certainly_overlap(self, a ast.Expr, b ast.Expr) bool
    pa := place_path(a) else return false
    pb := place_path(b) else return false
    if pa.root != pb.root or local(pa.root) == none
        return false
    for k in 0..pa.steps.len().min(pb.steps.len())
        if not same_step(pa.steps[k], pb.steps[k], true)
            return false
    true

## Whether two places may overlap: same root, and no step that proves them
## apart (a different field, or a different constant index).
fn Checker.may_overlap(self, a ast.Expr, b ast.Expr) bool
    pa := place_path(a) else return false
    pb := place_path(b) else return false
    if pa.root != pb.root or local(pa.root) == none
        return false
    for k in 0..pa.steps.len().min(pb.steps.len())
        if not same_step(pa.steps[k], pb.steps[k], false)
            return false
    true

## The first use in `body` of a place that may overlap `target` (own.excl.5).
fn Checker.overlapping_use(self, target ast.Expr, body List[ast.Stmt]) ast.Pos?
    for s in body
        if at := overlap_in_stmt(target, s)
            return at
    none

fn Checker.overlap_in_else(self, target ast.Expr, o ast.Else) ast.Pos?
    match o
        Fallback(d) => overlap_in_expr(target, d)
        Leave(st) => overlap_in_stmt(target, st)
        Handler(_, body, _) => overlapping_use(target, body)

fn Checker.overlap_in_stmt(self, target ast.Expr, s ast.Stmt) ast.Pos?
    match s
        Let(_, _, _, value, otherwise) =>
            if at := overlap_in_expr(target, value)
                return at
            o := otherwise else return none
            overlap_in_else(target, o)
        Assign(t, _, value, _) => either(overlap_in_expr(target, t), overlap_in_expr(target, value))
        While(cond, body, _) => either(overlap_in_expr(target, cond), overlapping_use(target, body))
        For(_, _, _, _, iter, body, _) => either(
            overlap_in_expr(target, iter),
            overlapping_use(target, body),
        )
        With(m, _, _, body, _) => either(overlap_in_expr(target, m), overlapping_use(target, body))
        Unsafe(body, _) => overlapping_use(target, body)
        Return(v, _) =>
            e := v else return none
            overlap_in_expr(target, e)
        Eval(e) => overlap_in_expr(target, e)
        Handle(value, otherwise) => either(
            overlap_in_expr(target, value),
            overlap_in_else(target, otherwise),
        )
        Defer(st, _) => overlap_in_stmt(target, st)
        LetTuple(_, value, _) => overlap_in_expr(target, value)
        Break => none
        Continue => none

fn either(a ast.Pos?, b ast.Pos?) ast.Pos?
    if x := a
        return x
    b

fn Checker.overlap_in_list(self, target ast.Expr, xs List[ast.Expr]) ast.Pos?
    for x in xs
        if at := overlap_in_expr(target, x)
            return at
    none

fn Checker.overlap_in_args(self, target ast.Expr, args List[ast.Arg]) ast.Pos?
    for a in args
        if at := overlap_in_expr(target, a.value)
            return at
    none

fn Checker.overlap_in_opt(self, target ast.Expr, x ast.Expr?) ast.Pos?
    e := x else return none
    overlap_in_expr(target, e)

@allow("expr.match.3") fn Checker.overlap_in_expr(self, target ast.Expr, x ast.Expr) ast.Pos?
    if p := place_path(x)
        if may_overlap(target, x)
            return expr_pos(x)
        for step in p.steps
            match step
                SIndex(i) =>
                    if at := overlap_in_expr(target, i)
                        return at
                SField => continue
        return none
    match x
        Interp(parts, _) =>
            for part in parts
                match part
                    Hole(y) =>
                        if at := overlap_in_expr(target, y)
                            return at
                    Fmt(y, _) =>
                        if at := overlap_in_expr(target, y)
                            return at
                    Lit => continue
            none
        ListLit(items, _) => overlap_in_list(target, items)
        SetLit(items, _) => overlap_in_list(target, items)
        TupleLit(items, _) => overlap_in_list(target, items)
        Call(callee, args, _) => either(
            overlap_in_expr(target, callee),
            overlap_in_args(target, args),
        )
        Method(recv, _, _, args) => either(
            overlap_in_expr(target, recv),
            overlap_in_args(target, args),
        )
        Member(recv, _, _) => overlap_in_expr(target, recv)
        Index(recv, index, _) => either(
            overlap_in_expr(target, recv),
            overlap_in_expr(target, index),
        )
        Unary(_, operand, _) => overlap_in_expr(target, operand)
        NewRef(value, _) => overlap_in_expr(target, value)
        Closure(_, body, _) => overlap_in_expr(target, body)
        Binary(_, lhs, rhs, _) => either(overlap_in_expr(target, lhs), overlap_in_expr(target, rhs))
        Range(lo, hi, _, _) => either(overlap_in_opt(target, lo), overlap_in_opt(target, hi))
        MapLit(entries, _) =>
            for en in entries
                if at := overlap_in_expr(target, en.key)
                    return at
                if at := overlap_in_expr(target, en.value)
                    return at
            none
        Comp(_, elem, value, clauses, _) =>
            for c in clauses
                if at := overlap_in_expr(target, c.iter)
                    return at
                if at := overlap_in_opt(target, c.cond)
                    return at
            either(overlap_in_expr(target, elem), overlap_in_opt(target, value))
        If(branches, els, _, _) =>
            for b in branches
                match b.cond
                    Test(c) =>
                        if at := overlap_in_expr(target, c)
                            return at
                    Bind(_, _, c) =>
                        if at := overlap_in_expr(target, c)
                            return at
                if at := overlapping_use(target, b.body)
                    return at
            e := els else return none
            overlapping_use(target, e)
        Match(scrutinee, arms, _) =>
            if at := overlap_in_expr(target, scrutinee)
                return at
            for a in arms
                if at := overlapping_use(target, a.body)
                    return at
            none
        Try(inner, context, _) => either(
            overlap_in_expr(target, inner),
            overlap_in_opt(target, context),
        )
        OrElse(value, otherwise, _) =>
            if at := overlap_in_expr(target, value)
                return at
            match otherwise
                Fallback(d) => overlap_in_expr(target, d)
                Leave | Handler => none
        _ => none

## Whether a loop body has a `break` that ends this loop (not one of a
## nested loop's).
fn breaks(body List[ast.Stmt]) bool
    for s in body
        if stmt_breaks(s)
            return true
    false

fn stmt_breaks(s ast.Stmt) bool
    match s
        Break => true
        Eval(e) => breaks_in_expr(e)
        Return(v, _) =>
            e := v else return false
            breaks_in_expr(e)
        Let(_, _, _, value, otherwise) =>
            if breaks_in_expr(value)
                return true
            o := otherwise else return false
            breaks_in_else(o)
        Handle(value, otherwise) => breaks_in_expr(value) or breaks_in_else(otherwise)
        Assign(target, _, value, _) => breaks_in_expr(target) or breaks_in_expr(value)
        While(cond, _, _) => breaks_in_expr(cond)
        For(_, _, _, _, iter, _, _) => breaks_in_expr(iter)
        LetTuple(_, value, _) => breaks_in_expr(value)
        Continue | Defer | With | Unsafe => false

@allow("expr.match.3") fn breaks_in_else(o ast.Else) bool
    match o
        Leave(st) =>
            match st
                Break => true
                _ => false
        Handler(_, body, _) => breaks(body)
        Fallback(v) => breaks_in_expr(v)

fn any_breaks(xs List[ast.Expr]) bool
    for x in xs
        if breaks_in_expr(x)
            return true
    false

fn args_break(args List[ast.Arg]) bool
    for a in args
        if breaks_in_expr(a.value)
            return true
    false

@allow("expr.match.3") fn breaks_in_expr(e ast.Expr) bool
    match e
        If(branches, els, _, _) =>
            for b in branches
                if breaks(b.body)
                    return true
            body := els else return false
            breaks(body)
        Match(scrutinee, arms, _) =>
            if breaks_in_expr(scrutinee)
                return true
            for a in arms
                if breaks(a.body)
                    return true
            false
        Unary(_, operand, _) => breaks_in_expr(operand)
        Binary(_, lhs, rhs, _) => breaks_in_expr(lhs) or breaks_in_expr(rhs)
        Call(callee, args, _) => breaks_in_expr(callee) or args_break(args)
        Method(recv, _, _, args) => breaks_in_expr(recv) or args_break(args)
        Member(recv, _, _) => breaks_in_expr(recv)
        Index(recv, index, _) => breaks_in_expr(recv) or breaks_in_expr(index)
        ListLit(items, _) => any_breaks(items)
        SetLit(items, _) => any_breaks(items)
        TupleLit(items, _) => any_breaks(items)
        # A function literal's body can't leave the enclosing loop (type.fn.4).
        Closure => false
        MapLit(entries, _) =>
            for en in entries
                if breaks_in_expr(en.key) or breaks_in_expr(en.value)
                    return true
            false
        Try(inner, _, _) => breaks_in_expr(inner)
        OrElse(value, otherwise, _) => breaks_in_expr(value) or breaks_in_else(otherwise)
        _ => false

## ---- Contracts and invariants (contracts.rs) ----

## A trait method without a body still has its contracts checked
## (contract.inh.1), with its parameters in scope.
fn Checker.check_bodyless_contracts(mut self, idx int, f ast.FnDecl)
    sig := sigs[idx]
    scope = fn_scopes[idx]
    self_ty = fn_self[idx]
    locals = []
    if f.receiver != none
        locals.push(Local(
            name: "self",
            ty: self_ty else Ty.Unknown,
            mutable: receiver_of(f) == true,
            how: LocalKind.SelfParam,
            decl: none,
        ))
    for k in 0..f.params.len()
        p := f.params[k]
        locals.push(Local(
            name: p.name,
            ty: sig.params[k].ty,
            mutable: p.mutable,
            how: LocalKind.ParamLocal,
            decl: none,
        ))
    check_contracts(f, sig.ret)

## contract.inv.1: a struct's invariants see its fields by bare name and
## must be `bool`.
fn Checker.check_invariants(mut self, struct_index int)
    st := prog.structs[struct_index]
    if st.invariants.len() == 0
        return
    locals = []
    declared := struct_params[struct_index]
    scope = scope_of(declared)
    t := Ty.Struct(struct_index, [Ty.Param(p) for p in declared])
    self_ty = t
    locals.push(Local(name: "self", ty: t, mutable: false, how: LocalKind.SelfParam, decl: none))
    for c in st.invariants
        got := expr(c.cond, Ty.Bool, true)
        if not accepts(Ty.Bool, got)
            mismatch("contract.decl.2", expr_pos(c.cond), Ty.Bool, got)
    locals = []

## type.struct.8: a field's default is a plain constant of the field's type:
## literals, `none`, `[]`, `{}`, `List[T]()`, `Map[K, V]()`, `Set[T]()` and
## lists, sets, maps and tuples of them. It has no names, so a literal in any
## module reads the same value, and it has no effects.
fn Checker.check_field_defaults(mut self, struct_index int)
    st := prog.structs[struct_index]
    declared := struct_params[struct_index]
    locals = []
    scope = scope_of(declared)
    for k in 0..st.fields.len()
        d := st.fields[k].default else continue
        if bad := plain_default(d)
            err_help(
                "type.struct.8",
                expr_pos(bad),
                "`{st.fields[k].name}`'s default isn't a plain constant",
                "write literals, `none`, `[]`, `\{}`, or lists, sets, maps and tuples of them; a default has no names or calls, so build anything else where you write the literal",
            )
            continue
        want := field_types[struct_index][k]
        got := expr(d, want, true)
        if not accepts(want, got)
            mismatch("type.struct.5", expr_pos(d), want, got)
    locals = []

## The first part of a field default that isn't a plain constant (type.struct.8).
@allow("expr.match.3") fn plain_default(e ast.Expr) ast.Expr?
    match e
        Str | Bytes | Int | Float | Char | Bool | NoneLit => none
        Interp(parts, _) =>
            for p in parts
                match p
                    Lit => continue
                    _ => return e
            none
        ListLit(items, _) => first_not_plain(items)
        SetLit(items, _) => first_not_plain(items)
        TupleLit(items, _) => first_not_plain(items)
        MapLit(entries, _) =>
            for m in entries
                if b := plain_default(m.key)
                    return b
                if b := plain_default(m.value)
                    return b
            none
        Unary(_, x, _) => plain_default(x)
        Call(callee, args, _) => empty_collection(callee, args, e)
        _ => e

fn first_not_plain(items List[ast.Expr]) ast.Expr?
    for x in items
        if b := plain_default(x)
            return b
    none

## `List[T]()`, `Map[K, V]()` and `Set[T]()`.
@allow("expr.match.3")
fn empty_collection(callee ast.Expr, args List[ast.Arg], e ast.Expr) ast.Expr?
    if args.len() > 0
        return e
    match callee
        TypeArgs(n, _, _) =>
            if n == "List" or n == "Map" or n == "Set"
                return none
            e
        _ => e

## Check `f`'s contracts with its parameters in scope; `ensures` also sees
## `result`, the success value (contract.ens.1).
fn Checker.check_contracts(mut self, f ast.FnDecl, result_ty Ty)
    for c in f.contracts
        mark := locals.len()
        # contract.ens.3: `old(e)` is `e` typed in the parameters' scope.
        mut olds := List[Local]()
        for o in c.olds
            t := expr(o.value, none, true)
            olds.push(Local(
                name: o.name,
                ty: t,
                mutable: false,
                how: LocalKind.Binding,
                decl: none,
            ))
        if c.is_ensures and not returns_nothing(result_ty)
            mut clash := false
            for p in f.params
                if p.name == "result" and not clash
                    clash = true
                    err_help(
                        "contract.ens.2",
                        p.pos,
                        "`{full_name(f)}` has an `ensures` line, where `result` names its return value",
                        "rename the parameter",
                    )
            if not clash
                locals.push(Local(
                    name: "result",
                    ty: ok_type(result_ty),
                    mutable: false,
                    how: LocalKind.Binding,
                    decl: none,
                ))
        for l in olds
            locals.push(l)
        in_requires = not c.is_ensures
        requires_pos = c.pos
        got := expr(c.cond, Ty.Bool, true)
        in_requires = false
        if not accepts(Ty.Bool, got)
            mismatch("contract.decl.2", expr_pos(c.cond), Ty.Bool, got)
        locals = locals[..mark]

@allow("expr.match.3") fn is_channel(t Ty) bool
    match t
        Conc(k, _) => k == "Channel"
        _ => false
