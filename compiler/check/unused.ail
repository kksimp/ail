## An unused local is a warning (expr.bind.14, ADR 1087): a name bound with `:=` that the function
## never reads. Parameters, loop variables and names starting with `_` don't count; the fix
## renames it `_`. Only the main program's own functions are checked.
use ast
use fix

## A `:=` binding of the function being checked.
pub struct BindDecl
    pub name str
    pub at ast.Pos
    pub used bool

## Remember the binding `n` written at `at`.
fn Checker.note_binding(mut self, n str, at ast.Pos)
    if n.starts_with("_") or at.line >= 1073741824 or is_prelude_line(at.line) or module_at(
        prog,
        at,
    ) != ""
        return
    key := pos_key(at)
    if bind_seen.contains(key)
        return
    bind_seen.add(key)
    bind_decls.push(BindDecl(name: n, at: at, used: false))

## A read of the local declared at `decl`.
fn Checker.note_read(mut self, decl ast.Pos)
    for k in 0..bind_decls.len()
        if bind_decls[k].at == decl
            bind_decls[k].used = true

## Warn for each binding of the function just checked that nothing read, then forget them.
fn Checker.report_unused(mut self)
    for b in bind_decls
        if not b.used
            mut d := new_diag("expr.bind.14", b.at, "`{b.name}` is bound but never used")
            d.warning = true
            d = d.with_help("remove it, or name it `_` to say the value is ignored on purpose")
            diags.push(d)
            fix_last("name it `_`", [fix.replace(b.at, b.name, "_")])
    bind_decls = []
    bind_seen = Set[int]()

## A program with an error gets no unused-local warnings (expr.bind.14): they would bury the
## error under noise, and a draft that fails to check often has names it hasn't used yet.
fn quiet_unused(ds List[Diag]) List[Diag]
    mut failing := false
    for d in ds
        if not d.warning
            failing = true
    if not failing
        return ds
    mut out := List[Diag]()
    for d in ds
        if d.rule != "expr.bind.14"
            out.push(d)
    out

## A declaration that clashes with a prelude type (mod.unit.1) is reported once: the errors
## its uses would add, which name the type, are dropped.
fn drop_clash_cascade(ds List[Diag]) List[Diag]
    mut names := List[str]()
    for d in ds
        if d.rule == "mod.unit.1" and d.message.contains("is a prelude type")
            parts := d.message.split("`")
            if parts.len() > 1
                names.push(parts[1])
    if names.len() == 0
        return ds
    mut out := List[Diag]()
    for d in ds
        mut hit := false
        if d.rule != "mod.unit.1"
            # Case-blind: conc.task.1 on `Task(...)` says "a task is started with `spawn`".
            help := d.help else ""
            said := "{d.message} {help}".to_lower()
            for n in names
                if said.contains(n.to_lower())
                    hit = true
        if not hit
            out.push(d)
    out
