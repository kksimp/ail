## `uhwhatnow?`, the hole that asks (expr.hole.3, ADR 0868 item 2): like
## `todo` it takes the expected type and traps when reached, and its warning
## ranks what in scope fits there, best first, each with a fix that writes it.
use ast
use fix

## One thing that fits the hole: its text, why it fits, and its rank (lower
## is better).
struct Fit
    text str
    why str
    rank int
    ## Among locals, the innermost (most recent) first.
    near int

## How many candidates the warning lists.
ASK_SHOWN := 8

## Whether the hole at `at` is a `uhwhatnow?`.
fn Checker.is_ask(self, at ast.Pos) bool
    for p in prog.asks else []
        if p.line == at.line and p.col == at.col
            return true
    false

## The warning of the `uhwhatnow?` at `at` (expr.hole.3).
fn Checker.ask_hole(mut self, at ast.Pos, expect Ty?) Ty
    t := expect else Ty.Unknown
    if t == Ty.Unknown or t == Ty.Unit or t == Ty.Never
        warn(
            "expr.hole.3",
            at,
            "uhwhatnow?: the expected type isn't known here; in scope: {self.in_scope_text()}",
            "give the place a type (a parameter, a return type or `x: T`) so candidates can be ranked",
        )
        return Ty.Unknown
    fits := self.ranked_fits(t, at)
    if fits.len() == 0
        warn(
            "expr.hole.3",
            at,
            "uhwhatnow?: expected {show(t)}; nothing in scope fits; in scope: {self.in_scope_text()}",
            "replace `uhwhatnow?` with a value of type {show(t)}",
        )
        return t
    mut d := new_diag(
        "expr.hole.3",
        at,
        "uhwhatnow?: expected {show(t)}; best fit: `{fits[0].text}`",
    ).with_help("replace `uhwhatnow?` with one of these, best first")
    d.warning = true
    for k in 0..fits.len()
        if k >= ASK_SHOWN
            d = d.with_note(at, "and {fits.len() - ASK_SHOWN} more")
            break
        d = d.with_note(at, "{k + 1}. `{fits[k].text}`: {fits[k].why}")
        d.fixes.push(fix.Fix(title: "write `{fits[k].text}`", edits: [fix.replace(
            at,
            "uhwhatnow?",
            fits[k].text,
        )]))
    diags.push(d)
    t

## The locals with their types, sorted by name, as `todo` lists them (expr.hole.1).
fn Checker.in_scope_text(self) str
    mut names := List[str]()
    for l in locals
        if l.ty == Ty.Unknown
            names.push("`{l.name}` (type unknown)")
        else
            names.push("`{l.name} {ty_name(l.ty)}`")
    names.sort()
    if names.len() == 0 then "nothing" else names.join(", ")

## Whether a value of type `got` fits where `want` is expected, as written.
fn fits_ty(want Ty, got Ty) bool
    if got == Ty.Unknown or got == Ty.Never or got == Ty.Unit
        return false
    if same(want, got)
        return true
    match want
        Opt(w) => same(w, got)
        _ => false

## What fits a hole of type `want` at `at`, best first: a local, the most
## recent first (0), a field of `self` (1), a field of a local (2), then a call of this
## module's functions or of a local's methods (4, plus 2 for each argument no
## local fills and 1 for a call that can fail).
fn Checker.ranked_fits(mut self, want Ty, at ast.Pos) List[Fit]
    mut out := List[Fit]()
    mut seen := Set[str]()
    for k in 0..locals.len()
        l := locals[locals.len() - 1 - k]
        if seen.contains(l.name)
            continue
        seen.add(l.name)
        if fits_ty(want, l.ty)
            out.push(Fit(
                text: l.name,
                why: "{local_kind(l)} of type `{ty_name(l.ty)}`",
                rank: 0,
                near: k,
            ))
        is_self := match l.how
            SelfParam => true
            _ => false
        self.field_fits(want, l, is_self, at, mut out)
        self.method_fits(want, l, at, mut out)
    self.fn_fits(want, at, mut out)
    out.sort(by: |f| (f.rank, f.near, f.text))
    out

fn local_kind(l Local) str
    match l.how
        ParamLocal | MoveParam => "a parameter"
        SelfParam => "the receiver"
        LoopVar => "a loop variable"
        Binding => "a local"

## The fields of `l` that fit; `self`'s are written bare (trait.method.6).
fn Checker.field_fits(mut self, want Ty, l Local, is_self bool, at ast.Pos, mut out List[Fit])
    s := match l.ty
        Struct(i, args) =>
            if args.len() > 0
                return
            i
        _ => return
    decl := prog.structs[s]
    for i in 0..decl.fields.len()
        f := decl.fields[i]
        if hidden(prog, f.pos, at) or i >= field_types[s].len()
            continue
        ft := field_types[s][i]
        if not fits_ty(want, ft)
            continue
        if is_self
            out.push(Fit(text: f.name, why: "a field of `self`", rank: 1, near: 0))
        else
            out.push(Fit(text: "{l.name}.{f.name}", why: "a field of `{l.name}`", rank: 2, near: 0))

## The methods of `l`'s type whose result fits.
fn Checker.method_fits(mut self, want Ty, l Local, at ast.Pos, mut out List[Fit])
    tn := type_name_of(l.ty) else return
    match l.ty
        Struct(_, args) =>
            if args.len() > 0
                return
        Enum(_, args) =>
            if args.len() > 0
                return
        _ => return
    for key in methods.keys().sorted()
        if not key.starts_with("{tn}.")
            continue
        i := methods[key]
        sig := sigs[i]
        if sig.receiver == none or sig.generics.len() > 0 or hidden(prog, prog.fns[i].pos, at)
            continue
        if c := self.call_fit(want, sig, "{l.name}.{prog.fns[i].name}", i)
            out.push(c)

## The functions of this module whose result fits, written as calls.
fn Checker.fn_fits(mut self, want Ty, at ast.Pos, mut out List[Fit])
    here := module_at(prog, at)
    for key in fns.keys().sorted()
        i := fns[key]
        f := prog.fns[i]
        if f.owner != none or f.name == "main" or has_attr(f, "test")
            continue
        if module_at(prog, f.pos) != here
            continue
        sig := sigs[i]
        if sig.generics.len() > 0
            continue
        if c := self.call_fit(want, sig, f.name, i)
            out.push(c)

## `name(args)` when the result of `sig` fits: each argument is the local of
## its type, preferring one named like the parameter, or `todo`.
fn Checker.call_fit(mut self, want Ty, sig Sig, name str, i int) Fit?
    mut fails := false
    if not fits_ty(want, sig.ret)
        ok := match sig.ret
            Res(o, _) => o
            _ => return none
        if not fits_ty(want, ok)
            return none
        fails = true
    mut args := List[str]()
    mut open := 0
    for k in 0..sig.params.len()
        pname := if k < sig.names.len() then sig.names[k] else ""
        a := self.arg_for(sig.params[k].ty, pname)
        if a == ""
            open += 1
            args.push("todo")
        else
            args.push(a)
    mut text := "{name}({args.join(", ")})"
    mut rank := 4 + 2 * open
    if fails
        text = if is_res(fn_ret) then "{text}?" else "{text} else todo"
        rank += 1
    # Calling the function being checked is rarely the answer.
    if i == cur_fn
        rank += 3
    Fit(text: text, why: "a call that gives `{ty_name(want)}`", rank: rank, near: 0)

## The local that fills a parameter of type `t` named `pname`: one with that
## name, else the innermost of that type, else "".
fn Checker.arg_for(self, t Ty, pname str) str
    mut found := ""
    for k in 0..locals.len()
        l := locals[locals.len() - 1 - k]
        if l.ty == Ty.Unknown or not same(t, l.ty)
            continue
        if l.name == pname
            return l.name
        if found == ""
            found = l.name
    found
