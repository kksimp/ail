## Certain fixes for forms agents bring from other languages (fix.auto.1, ADR 1130),
## each a rewrite with one meaning: a bare name another module of the file exports
## (`Kind` for `event.Kind`, after code moves into a module), and `m[k] else d` on a
## map, which is `m.get(k) else d`.
use ast
use fix

## expr.name.1: the qualified spelling of a bare name `n` when exactly one module the
## file of `at` imports declares a public item `n`; none otherwise.
fn Checker.module_item(self, n str, at ast.Pos) str?
    if n.contains(".")
        return none
    here := file_of(at)
    mut found := List[str]()
    for u in prog.uses
        if u.path.len() == 0 or u.path[0].name == "std" or file_of(u.pos) != here
            continue
        dotted := [p.name for p in u.path].join(".")
        alias := u.alias?.name else u.path[u.path.len() - 1].name
        spelled := "{alias}.{n}"
        if self.public_item("{dotted}.{n}") and not found.contains(spelled)
            found.push(spelled)
    if found.len() == 1 then found[0] else none

## Whether the qualified name `key` is a public top-level item (mod.vis.1).
fn Checker.public_item(self, key str) bool
    for s in prog.structs
        if s.name == key
            return prog.public.contains(s.pos.line)
    for e in prog.enums
        if e.name == key
            return prog.public.contains(e.pos.line)
    for f in prog.fns
        if f.name == key and f.owner == none
            return prog.public.contains(f.pos.line)
    for c in prog.consts
        if c.name == key
            return prog.public.contains(c.pos.line)
    false

## expr.name.1: `d` with the help and certain fix for a bare name another module exports.
fn Checker.with_module_item(self, d Diag, n str, at ast.Pos) Diag?
    q := self.module_item(n, at) else return none
    helped := d.with_help("`{n}` is declared in an imported module: write `{q}` (mod.use.1)")
    helped.with_sure_fix("write `{q}`", [fix.replace(at, n, q)])

## err.else.1: `m[k] else d` where `m` is a map local is `m.get(k) else d`; adds that
## certain fix to the diagnostic just reported.
@allow("expr.match.3") fn Checker.map_index_else(mut self, value ast.Expr)
    match value
        Index(recv, _, _) =>
            match recv
                Name(n, p) =>
                    if l := self.local(n)
                        if is_map_ty(l.ty)
                            self.sure_fix_last("write `{n}.get(...)`", [fix.call_with(
                                p,
                                n,
                                "{n}.get($1)",
                            )])
                _ => return
        _ => return

## The `to_int` of a `char` literal (`'0'.to_int()`), and of a value beside one in a
## binary operation (`c.to_int() - '0'.to_int()`), is `code()`: with a character
## literal on one side the number means a scalar value (expr.name.1). A lone `c.to_int()`
## could mean the digit's value, so it keeps its help only.
@allow("expr.match.3") fn char_lit_int(e ast.Expr) bool
    match e
        Method(recv, name, _, args) =>
            if args.len() > 0 or (name != "to_int" and name != "code")
                return false
            match recv
                Char => true
                _ => false
        _ => false

## The position of the `to_int` call `e` when it has no arguments.
@allow("expr.match.3") fn to_int_pos(e ast.Expr) ast.Pos?
    match e
        Method(_, name, np, args) =>
            if name == "to_int" and args.len() == 0
                return np
            none
        _ => none

## Adds the certain fix `code` to the expr.name.1 reports on `to_int` of a `char` in the
## operands of one operation, when an operand is a character literal's number.
fn Checker.char_code_fix(mut self, lhs ast.Expr, rhs ast.Expr)
    mut at := List[ast.Pos]()
    if char_lit_int(lhs) or char_lit_int(rhs)
        for side in [lhs, rhs]
            if p := to_int_pos(side)
                at.push(p)
    if at.len() == 0
        return
    for k in 0..self.diags.len()
        d := self.diags[k]
        if d.rule == "expr.name.1"
            and d.fixes.len() == 0
            and d.message.starts_with("`char` has no method `to_int`")
            for p in at
                if p == d.pos
                    self.diags[k] = d.with_sure_fix("write `code`", [fix.replace(
                        p,
                        "to_int",
                        "code",
                    )])
