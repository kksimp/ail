## Whether the block of an `else e` still uses its name (err.else.3). The certain fix that
## drops a name an optional's `else` cannot bind must not run while the block reads it: it
## would trade one error for an unknown name. A statement this does not read through counts
## as a use, so the fix is withheld rather than wrong.
use ast

fn block_reads_name(b List[ast.Stmt], n str) bool
    for s in b
        if stmt_reads_name(s, n)
            return true
    false

@allow("expr.match.3") fn stmt_reads_name(s ast.Stmt, n str) bool
    match s
        Eval(x) => mentions_name(x, n)
        Let(_, _, _, x, o) => o != none or mentions_name(x, n)
        Assign(t, _, x, _) => mentions_name(t, n) or mentions_name(x, n)
        Return(v, _) =>
            x := v else return false
            mentions_name(x, n)
        While(c, body, _) => mentions_name(c, n) or block_reads_name(body, n)
        For(_, _, _, _, it, body, _) => mentions_name(it, n) or block_reads_name(body, n)
        Break | Continue => false
        LetTuple(_, x, _) => mentions_name(x, n)
        Unsafe(body, _) => block_reads_name(body, n)
        With(m, _, _, body, _) => mentions_name(m, n) or block_reads_name(body, n)
        Defer(x, _) => stmt_reads_name(x, n)
        _ => true
