## Effects (ADR 0377), as `check/effects.rs`: inference (eff.infer.1-6),
## `@pure` (eff.pure.1), pure contracts (contract.decl.3) and constants
## computed at compile time (ct.const.2). Runs after typing and reads only
## the program and the facts typing recorded.
use ast

## Effects that a `@pure` function may not have (eff.pure.1): everything but
## `fail` and `mutates`, which its signature already shows. They are also
## the effects that pass from a callee to its caller (eff.infer.3).
fn impure(e str) bool
    e != "fail" and e != "mutates"

## The effects of a standard-module function `module.name` (eff.infer.4);
## none when the module has no such function.
fn std_effects(module str, name str) List[str]?
    for row in STD_EFFECTS
        if row.module == module and row.names.contains(name)
            return row.effects
    none

## A group of standard functions with the same effects.
struct StdEffects
    module str
    names List[str]
    effects List[str]

STD_EFFECTS := [
    StdEffects(
        module: "fs",
        names: [
            "read_text",
            "write_text",
            "append_text",
            "read_bytes",
            "write_bytes",
            "append_bytes",
            "exists",
            "list_dir",
            "remove",
            "make_dir",
            "rename",
            "copy",
            "walk",
            "glob",
            "metadata",
            "volume",
            "read_range",
            "trash",
            "temp_dir",
            "make_temp_dir",
            "scan",
            "scan_count",
            "map",
            "mode",
            "set_mode",
            "set_modified",
            "read_link",
            "symlink",
            "truncate",
            "sync",
            "write_at",
            "watch",
        ],
        effects: ["fs", "io"],
    ),
    # std.hash.1: values only. std.compress.1: the byte functions are values
    # only; the file and directory ones read and write files.
    StdEffects(
        module: "hash",
        names: [
            "crc32",
            "hash64",
            "hmac_sha256",
            "hmac_sha256_bytes",
            "hmac_sha384",
            "hmac_sha384_bytes",
            "hmac_sha512",
            "hmac_sha512_bytes",
            "md5_legacy",
            "md5_legacy_bytes",
            "sha1_legacy",
            "sha1_legacy_bytes",
            "sha256",
            "sha256_bytes",
            "sha384",
            "sha384_bytes",
            "sha3_256",
            "sha3_256_bytes",
            "sha3_512",
            "sha3_512_bytes",
            "sha512",
            "sha512_bytes",
        ],
        effects: [],
    ),
    # std.crypto.1-4: values only, except the system generator (effect `random`).
    StdEffects(module: "crypto", names: ["ct_eq", "hkdf_sha256", "pbkdf2_sha256"], effects: []),
    # std.crypto.5-8: signing and key agreement are values; a new P-256 key is `random`.
    StdEffects(
        module: "crypto",
        names: [
            "ecdsa_p256_sign",
            "ecdsa_p256_verify",
            "ed25519_public",
            "ed25519_sign",
            "ed25519_verify",
            "p256_ecdh",
            "p256_public",
            "x25519",
            "x25519_public",
        ],
        effects: [],
    ),
    StdEffects(module: "crypto", names: ["p256_secret", "random_bytes"], effects: ["random"]),
    # unsafe.hw.5: hardware access.
    StdEffects(module: "hw", names: ["at", "fence", "fence_io"], effects: ["hw"]),
    StdEffects(module: "compress", names: ["gzip_file", "gunzip_file", "zip_dir", "unzip"], effects: ["fs", "io"]),
    StdEffects(
        module: "compress",
        names: ["brotli", "deflate", "deflate_flush", "gunzip", "gzip", "inflate", "unbrotli", "unzlib", "unzstd", "zlib", "zstd"],
        effects: [],
    ),
    StdEffects(module: "env", names: ["args", "get", "cwd", "home", "program", "vars"], effects: ["env"]),
    StdEffects(
        module: "proc",
        names: [
            "run",
            "run_bytes",
            "which",
            "start",
            "wait",
            "kill",
            "run_with",
            "run_bytes_with",
            "start_with",
        ],
        effects: ["proc", "io"],
    ),
    # std.proc.11, std.proc.15 (ADR 1213): building options is a value; the process id is
    # a fact of the run, as the environment is.
    StdEffects(module: "proc", names: ["options"], effects: []),
    StdEffects(module: "proc", names: ["pid"], effects: ["env"]),
    StdEffects(module: "io", names: ["read_line", "read_all", "read_bytes", "read_exact", "write_bytes", "eprint", "exit"], effects: ["io"]),
    # std.net.14: a server needs the narrower capability as well.
    StdEffects(module: "net", names: ["serve", "listen"], effects: ["net", "net.serve", "io"]),
    # std.net.1: every request reaches the network.
    StdEffects(
        module: "net",
        names: [
            "get",
            "post",
            "request",
            "get_bytes",
            "post_bytes",
            "request_bytes",
            "options",
            "connect",
            "connect_tls",
        ],
        effects: ["net", "io"],
    ),
    # std.path.1, std.regex.1: text only, so no effects.
    StdEffects(
        module: "path",
        names: ["base", "clean", "dir", "ext", "is_abs", "join", "join_all", "match", "parts", "rel", "split_ext", "stem", "with_ext"],
        effects: [],
    ),
    # std.path.8, std.path.14: the working directory and the home directory come from the environment.
    StdEffects(module: "path", names: ["abs", "expand_home"], effects: ["env"]),
    StdEffects(module: "random", names: ["int", "float", "seed", "shuffle"], effects: ["random"]),
    StdEffects(
        module: "regex",
        names: ["compile", "is_match", "find", "find_all", "group_all", "captures", "replace", "replace_first", "split", "escape"],
        effects: [],
    ),
    StdEffects(module: "time", names: ["mono_ns", "now_ms", "since_ms", "sleep_ms"], effects: ["clock"]),
    # std.os.1 (ADR 1011): watching signals reaches the process.
    StdEffects(module: "os", names: ["signals"], effects: ["proc"]),
    # std.os.5 (ADR 1213): the host name is a fact of the machine, as the environment is.
    StdEffects(module: "os", names: ["hostname"], effects: ["env"]),
    # std.tz.1-2: reads the tz database files, and `TZ`.
    StdEffects(module: "tz", names: ["offset", "system"], effects: ["fs", "env"]),
    # std.tensor.1: values only. conc.cancel.2: reads the running task's flag.
    StdEffects(module: "tensor", names: ["from", "from_fn", "zeros"], effects: []),
    StdEffects(module: "task", names: ["cancelled", "check", "select", "threads"], effects: []),
    # conc.par.18: the pool's cap is process state, so a loop or pure function can't set it.
    StdEffects(module: "task", names: ["set_threads"], effects: ["io"]),
    # std.ui.9: opening a window and every `ui.Window` method.
    StdEffects(module: "ui", names: ["open", "clipboard_get", "clipboard_set", "Window"], effects: ["ui", "io"]),
]

## The effects a function or expression has directly, each with its source
## (`print`, `fs.write_text`, `T ! E`), and the functions it may call.
struct Walked
    direct Map[str, str]
    calls List[int]

## The facts about calls that typing recorded.
struct Facts
    targets Map[int, int]
    fn_values Map[int, int]
    trait_calls Map[int, int]
    assoc_calls Map[int, int]
    std_fns Map[int, str]
    std_methods Set[int]
    ## `net` handle methods, by key (`net.Conn.read`).
    net_methods Map[int, str]
    ## `regex.Regex` method calls (std.regex.25).
    regex_methods Set[int]
    ref_writes Set[int]
    handle_calls Set[int]
    atomic_calls Set[int]
    std_any Set[int]
    float_literals Set[int]
    ## Free functions by name.
    free Map[str, int]
    ## The implementations of the standard traits (eff.infer.5).
    std_impls List[int]
    ## `for` loops over a `next` method, by the iterable (expr.iter.1).
    iter_nexts Map[int, int]

## The inferred effects of a whole program.
struct Effects
    direct List[Map[str, str]]
    calls List[List[int]]
    sets List[List[str]]

fn Checker.facts(self) Facts
    mut free := Map[str, int]()
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        if f.owner == none and f.within == ast.Within.TopLevel
            free[f.name] = i
    # eff.infer.5: operators, interpolation, `print` and the built-in
    # collection methods call the standard traits' implementations.
    mut impls := List[int]()
    if prog.traits.len() > 0
        for tm in [
            TraitMethod(tr: std_eq, n: "eq"),
            TraitMethod(tr: std_ord, n: "cmp"),
            TraitMethod(tr: std_to_str, n: "to_str"),
            TraitMethod(tr: std_hash, n: "hash"),
        ]
            for m in implementations(prog, tm.tr, tm.n)
                if not impls.contains(m)
                    impls.push(m)
    Facts(
        targets: targets,
        fn_values: fn_values,
        trait_calls: trait_calls,
        assoc_calls: assoc_calls,
        std_fns: std_fns,
        std_methods: std_methods,
        net_methods: net_methods,
        regex_methods: regex_methods,
        ref_writes: ref_writes,
        handle_calls: handle_calls,
        atomic_calls: atomic_calls,
        std_any: std_any,
        float_literals: float_literals,
        free: free,
        std_impls: impls.sorted(),
        iter_nexts: gen.nexts,
    )

struct TraitMethod
    tr int
    n str

## The functions that `Trait.name` can run: each implementation's own, or
## the trait's default (eff.infer.5).
fn implementations(prog ast.Program, tr int, n str) List[int]
    mut out := List[int]()
    if tr >= prog.traits.len()
        return out
    decl := prog.traits[tr]
    for m in decl.methods
        if prog.fns[m].name == n and prog.fns[m].body != none
            out.push(m)
            break
    for imp in prog.impls
        if imp.trait_name == decl.name
            for m in imp.methods
                if prog.fns[m].name == n
                    out.push(m)
                    break
    out

## std.app.12: `app.run_host` of the standard module `std.app` (and so
## `app.run`) gives `app`; the module is AIL source, so the rest of its
## effects are inferred like any other code.
fn starts_host(f ast.FnDecl) bool
    # Module items carry their qualified names.
    f.name == "std.app.run_host" and f.owner == none

fn infer_effects(prog ast.Program, fx Facts) Effects
    mut direct := List[Map[str, str]]()
    mut calls := List[List[int]]()
    for f in prog.fns
        mut w := Walked(direct: signature_effects(f), calls: [])
        if starts_host(f)
            w.direct["app"] = "app.run_host"
        if body := f.body
            w.block(prog, fx, body)
        direct.push(w.direct)
        calls.push(w.calls)
    # eff.infer.3: the least fixed point.
    mut sets := [d.keys().sorted() for d in direct]
    mut changed := true
    while changed
        changed = false
        for i in 0..prog.fns.len()
            mut add := List[str]()
            for j in calls[i]
                for e in sets[j]
                    if impure(e) and not sets[i].contains(e) and not add.contains(e)
                        add.push(e)
            if add.len() > 0
                mut grown := sets[i]
                grown.extend(add)
                sets[i] = grown.sorted()
                changed = true
    Effects(direct: direct, calls: calls, sets: sets)

## The effects that running what `w` walked has, each with its source: its
## own operations (`print`), or a chain of calls such as `log -> print`
## (conc.par.2, conc.par.12).
fn Effects.of_walk(self, prog ast.Program, w Walked) Map[str, str]
    mut out := w.direct
    for j in w.calls
        for e in self.sets[j]
            if impure(e) and not out.contains(e)
                out[e] = self.chain(prog, j, e)
    out

## `name` or `Type.name`; a function of an `impl` block is named after the
## implementing type, one of a `trait` block after the trait.
fn display_name(prog ast.Program, f ast.FnDecl) str
    match f.within
        TopLevel => full_name(f)
        InTrait(k) => "{prog.traits[k].name}.{f.name}"
        InImpl(k) => "{prog.impls[k].target.name}.{f.name}"

## The shortest chain of calls from function `from` to the source of effect
## `e`, e.g. `main -> save -> fs.write_text`.
fn Effects.chain(self, prog ast.Program, from int, e str) str
    mut prev := [-1 for _ in 0..self.sets.len()]
    mut seen := [false for _ in 0..self.sets.len()]
    mut queue := [from]
    seen[from] = true
    mut head := 0
    while head < queue.len()
        i := queue[head]
        head += 1
        if source := self.direct[i].get(e)
            mut path := [source]
            mut at := i
            while at >= 0
                path.push(display_name(prog, prog.fns[at]))
                at = prev[at]
            path.reverse()
            return path.join(" -> ")
        for j in self.calls[i]
            if not seen[j] and self.sets[j].contains(e)
                seen[j] = true
                prev[j] = i
                queue.push(j)
    display_name(prog, prog.fns[from])

## `fail` from a `T ! E` or `!` return type, `mutates` from a `mut`
## parameter or `mut self` (eff.infer.2).
fn signature_effects(f ast.FnDecl) Map[str, str]
    mut d := Map[str, str]()
    if t := f.ret
        if is_fallible(t.shape)
            d["fail"] = "its return type"
    if (f.receiver?.mutable else false) or [p for p in f.params if p.mutable].len() > 0
        d["mutates"] = "a `mut` parameter"
    d

@allow("expr.match.3") fn is_fallible(s ast.TypeShape) bool
    match s
        Fallible => true
        _ => false

## eff.pure.1: a `@pure` function has none of `io`, `unsafe`, `spawn` or a
## capability. One diagnostic per function, naming each chain of calls.
fn Checker.check_pure(self) List[Diag]
    if [f for f in prog.fns if has_attr(f, "pure")].len() == 0
        return []
    fx := infer_effects(prog, self.facts())
    mut out := List[Diag]()
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        for a in f.attrs
            if a.name != "pure"
                continue
            bad := [e for e in fx.sets[i] if impure(e)]
            if bad.len() > 0
                n := display_name(prog, f)
                out.push(
                    new_diag(
                        "eff.pure.1",
                        a.pos,
                        "`{n}` is `@pure` but {reasons(prog, fx, i, bad)}",
                    ).with_help("remove `@pure`, or move the effect out of `{n}` and pass its result in as an argument"),
                )
            break
    out

## eff.cap.6-7: `@caps(LIST)` allows a function, and everything it calls, only the listed
## capabilities (`@caps(none)`: none). One diagnostic per function, naming each chain of calls.
fn Checker.check_caps(self) List[Diag]
    if [f for f in prog.fns if has_attr(f, "caps")].len() == 0
        return []
    fx := infer_effects(prog, self.facts())
    mut out := List[Diag]()
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        n := display_name(prog, f)
        for a in f.attrs
            if a.name != "caps"
                continue
            want := (a.arg else "").split(",")
            mut ok := true
            for cap in want
                if cap == ""
                    or (cap == "none" and want.len() > 1)
                    or (cap != "none" and not CAPABILITIES.contains(cap))
                    ok = false
                    shown := if cap == "" then "an empty entry" else "`{cap}`"
                    out.push(
                        new_diag(
                            "eff.cap.7",
                            a.pos,
                            "`@caps` on `{n}` names {shown}, which is not a capability or is mixed with `none`",
                        ).with_help("write `@caps(none)` or `@caps(fs, net)` with names from {CAPABILITIES.join(", ")}"),
                    )
                    break
            if not ok
                break
            bad := [e for e in fx.sets[i] if CAPABILITIES.contains(e) and not want.contains(e)]
            if bad.len() > 0
                allowed := if want == ["none"] then "no capability" else "only {want.join(", ")}"
                out.push(
                    new_diag(
                        "eff.cap.6",
                        a.pos,
                        "`{n}` is `@caps` for {allowed} but {reasons(prog, fx, i, bad)}",
                    ).with_help("add the capability to `@caps` on `{n}`, or move the effect out of `{n}` and pass its result in as an argument"),
                )
            break
    out

## The capabilities `--deny` takes (eff.cap.2).
CAPABILITIES := ["fs", "env", "proc", "clock", "random", "net", "net.serve", "ui", "app"]

## What `--deterministic` denies (eff.det.1).
DETERMINISTIC_DENY := ["clock", "net", "proc", "random"]

## What `--deterministic` denies (eff.det.1).
pub fn deterministic_deny() List[str]
    DETERMINISTIC_DENY

## `--deny LIST` (eff.cap.2): the capabilities, sorted and without repeats, and the usage error
## text (empty when the list is fine).
pub fn parse_deny(list str)(List[str], str)
    mut out := List[str]()
    for raw in list.split(",")
        name := raw.trim()
        if name == "all"
            for c in CAPABILITIES
                out.push(c)
        elif CAPABILITIES.contains(name)
            out.push(name)
        else
            rule := if [
                "io",
                "fail",
                "mutates",
                "unsafe",
                "spawn",
            ].contains(name) then "eff.cap.3" else "eff.cap.2"
            return ([], "`{name}` is not a capability; `--deny` takes a comma-separated list of {CAPABILITIES.join(", ")} or `all` ({rule})")
    mut uniq := List[str]()
    for c in out.sorted()
        if not uniq.contains(c)
            uniq.push(c)
    (uniq, "")

## The entry names `--allow` takes (eff.allow.2) and the ones that may carry a `=SCOPE`.
ALLOW_NAMES := [
    "fs",
    "fs.read",
    "fs.write",
    "net",
    "net.serve",
    "proc",
    "env",
    "clock",
    "random",
    "ui",
    "app",
    "unsafe",
]

ALLOW_SCOPED := ["fs", "fs.read", "fs.write", "net", "net.serve", "proc", "env"]

## `--allow LIST` (eff.allow.1-2): what the list leaves out, as the capabilities `--deny` takes
## (`unsafe` and `hw` stand for unsafe code, which no scope can contain), and the usage error
## text (empty when the list is fine). `none` allows nothing.
pub fn parse_allow(list str)(List[str], str)
    mut allowed := List[str]()
    for raw in list.split(",")
        entry := raw.trim()
        if entry == "" or entry == "none"
            continue
        mut name := entry
        mut scoped := false
        eq := entry.find("=")
        if eq != none
            at := eq else 0
            name = entry.slice(0, at)
            scoped = true
            if entry.slice(at + 1, entry.len()) == ""
                return ([], "`{entry}` has no scope after `=`; write `{name}=SCOPE`, or `{name}` for no limit (eff.allow.2)")
        if not ALLOW_NAMES.contains(name)
            return ([], "`{name}` is not something `--allow` takes; use {ALLOW_NAMES.join(", ")} (eff.allow.2)")
        if scoped and not ALLOW_SCOPED.contains(name)
            return ([], "`{name}` has no scopes; write `{name}` alone (eff.allow.2)")
        allowed.push(name)
    mut out := List[str]()
    for c in CAPABILITIES
        mut keep := allowed.contains(c)
        if c == "fs" and (allowed.contains("fs.read") or allowed.contains("fs.write"))
            keep = true
        if c == "net" and allowed.contains("net.serve")
            keep = true
        if not keep
            out.push(c)
    if not allowed.contains("unsafe")
        out.push("unsafe")
        out.push("hw")
    (out.sorted(), "")

## eff.cap.1: `main` must not reach a denied capability. One diagnostic per
## capability, naming the chain of calls.
fn Checker.check_denied(self) List[Diag]
    if denied.len() == 0
        return []
    mut main := -1
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        if f.name == "main" and f.owner == none and f.within == ast.Within.TopLevel
            main = i
    if main < 0
        return []
    fx := infer_effects(prog, self.facts())
    mut out := List[Diag]()
    for e in fx.sets[main]
        if denied.contains(e)
            out.push(
                new_diag(
                    "eff.cap.1",
                    prog.fns[main].pos,
                    "the program reaches the denied capability `{e}`: {fx.chain(prog, main, e)}",
                ).with_help(if e == "unsafe" or e == "hw" then "unsafe code can step outside every `--allow` scope; remove it, or add `unsafe` to `--allow` to accept that" else "remove the call, or allow `{e}` (`--allow {e}`, or `{e}=SCOPE` where it takes one), or run without denying it"),
            )
    out

## `has effects io and fs via f -> save -> fs.write_text`, grouping effects
## that come from the same chain.
fn reasons(prog ast.Program, fx Effects, i int, bad List[str]) str
    mut groups := List[Group]()
    for e in bad
        ch := fx.chain(prog, i, e)
        add_to_group(mut groups, e, ch)
    groups_text(groups)

struct Group
    effects List[str]
    chain str

fn add_to_group(mut groups List[Group], e str, ch str)
    for k in 0..groups.len()
        if groups[k].chain == ch
            if not groups[k].effects.contains(e)
                groups[k].effects.push(e)
            return
    groups.push(Group(effects: [e], chain: ch))

fn groups_text(groups List[Group]) str
    parts := [
        "has {if g.effects.len() == 1 then "effect" else "effects"} {["`{e}`" for e in g.effects].join(" and ")} via {g.chain}"
        for g in groups
    ]
    parts.join("; ")

## contract.decl.3: a contract's condition has no effect but `fail`.
fn Checker.check_contract_effects(self) List[Diag]
    mut named := List[NamedContract]()
    for f in prog.fns
        for c in f.contracts
            named.push(NamedContract(
                c: c,
                owner: full_name(f),
                word: if c.is_ensures then "ensures" else "requires",
            ))
    for s in prog.structs
        for c in s.invariants
            named.push(NamedContract(c: c, owner: s.name, word: "invariant"))
    if named.len() == 0
        return []
    facts_now := self.facts()
    fx := infer_effects(prog, facts_now)
    mut out := List[Diag]()
    for nc in named
        mut w := Walked(direct: Map[str, str](), calls: [])
        w.expr(prog, facts_now, nc.c.cond)
        for o in nc.c.olds
            w.expr(prog, facts_now, o.value)
        mut bad := Map[str, str]()
        for e in w.direct.keys()
            bad[e] = w.direct[e]
        for j in w.calls
            for e in fx.sets[j]
                if not bad.contains(e)
                    bad[e] = fx.chain(prog, j, e)
        bad.remove("fail")
        if bad.len() == 0
            continue
        what := ["`{e}` via {bad[e]}" for e in bad.keys().sorted()].join(", ")
        out.push(
            new_diag(
                "contract.decl.3",
                nc.c.pos,
                "the `{nc.word}` condition of `{nc.owner}` must be pure, but it has {what}",
            ).with_help("compute the value in the body, or check it with `assert`; a condition may only read its inputs"),
        )
    out

struct NamedContract
    c ast.Contract
    owner str
    word str

## ct.const.2 (ADR 0225): everything a constant's value may call must be
## compile-time-safe: no `io`, `unsafe`, `spawn` or capability.
fn Checker.check_constants(self) List[Diag]
    if prog.consts.len() == 0
        return []
    facts_now := self.facts()
    mut walked := List[Walked]()
    mut any_call := false
    for c in prog.consts
        mut w := Walked(direct: Map[str, str](), calls: [])
        w.expr(prog, facts_now, c.value)
        if w.calls.len() > 0 or [e for e in w.direct.keys() if impure(e)].len() > 0
            any_call = true
        walked.push(w)
    # Most constants call nothing; infer effects only when one does.
    if not any_call
        return []
    fx := infer_effects(prog, facts_now)
    mut out := List[Diag]()
    for k in 0..prog.consts.len()
        c := prog.consts[k]
        w := walked[k]
        mut groups := List[Group]()
        for e in w.direct.keys().sorted()
            if impure(e)
                add_to_group(mut groups, e, "{c.name} -> {w.direct[e]}")
        mut bad := List[str]()
        for j in w.calls
            for e in fx.sets[j]
                if impure(e) and not w.direct.contains(e) and not bad.contains(e)
                    bad.push(e)
        for e in bad.sorted()
            for j in w.calls
                if fx.sets[j].contains(e)
                    add_to_group(mut groups, e, "{c.name} -> {fx.chain(prog, j, e)}")
                    break
        if groups.len() == 0
            continue
        out.push(
            new_diag(
                "ct.const.2",
                c.pos,
                "`{c.name}` is computed at compile time but {groups_text(groups)}",
            ).with_help("constants may call only functions without I/O or capabilities; compute this value in `main`"),
        )
    out

fn Walked.add(mut self, e str, source str)
    if not self.direct.contains(e)
        self.direct[e] = source

fn Walked.call(mut self, i int)
    if not self.calls.contains(i)
        self.calls.push(i)

fn Walked.std_traits(mut self, fx Facts)
    for m in fx.std_impls
        self.call(m)

fn Walked.block(mut self, prog ast.Program, fx Facts, b List[ast.Stmt])
    for s in b
        self.stmt(prog, fx, s)

fn Walked.stmt(mut self, prog ast.Program, fx Facts, s ast.Stmt)
    match s
        Let(_, _, _, value, o) =>
            self.expr(prog, fx, value)
            if e := o
                self.otherwise(prog, fx, e)
        Assign(target, _, value, _) =>
            self.ref_write(fx, target)
            self.expr(prog, fx, target)
            self.expr(prog, fx, value)
        While(c, body, _) =>
            self.expr(prog, fx, c)
            self.block(prog, fx, body)
        For(_, _, _, _, iter, body, _) =>
            self.expr(prog, fx, iter)
            # expr.iter.1: the loop calls the iterable's `next`.
            if i := fx.iter_nexts.get(pos_key(expr_pos(iter)))
                self.call(i)
            self.block(prog, fx, body)
        With(mutex, _, _, body, _) =>
            self.expr(prog, fx, mutex)
            self.block(prog, fx, body)
        Break => return
        Continue => return
        Return(v, _) =>
            if e := v
                self.expr(prog, fx, e)
        Eval(e) => self.expr(prog, fx, e)
        LetTuple(_, value, _) => self.expr(prog, fx, value)
        # type.fn.10: a local function's effects are the enclosing function's.
        LocalFn(d) => self.block(prog, fx, d.body else [])
        Handle(value, o) =>
            self.expr(prog, fx, value)
            self.otherwise(prog, fx, o)
        Defer(inner, _) => self.stmt(prog, fx, inner)
        # unsafe.block.5, eff.infer.4: an `unsafe` block gives `unsafe`.
        Unsafe(body, _) =>
            self.add("unsafe", "an `unsafe` block")
            self.block(prog, fx, body)
        Select(arms, _) =>
            for h in ast.select_heads(arms)
                self.expr(prog, fx, h)
            for body in ast.select_bodies(arms)
                self.block(prog, fx, body)

## eff.infer.2: a write through a `ref` (own.ref.4) gives `mutates`.
fn Walked.ref_write(mut self, fx Facts, place ast.Expr)
    if fx.ref_writes.contains(pos_key(expr_pos(place)))
        self.add("mutates", "a write through a `ref`")

fn Walked.otherwise(mut self, prog ast.Program, fx Facts, o ast.Else)
    match o
        Fallback(e) => self.expr(prog, fx, e)
        Leave(s) => self.stmt(prog, fx, s)
        Handler(_, body, _) => self.block(prog, fx, body)

fn Walked.expr(mut self, prog ast.Program, fx Facts, e ast.Expr)
    match e
        Str | Bytes | Int | Float | Char | Bool | NoneLit | Hole | TypeArgs => return
        # type.fn.2: naming a function as a value counts as calling it, since
        # the value can be called wherever it ends up.
        Name(_, at) =>
            if i := fx.fn_values.get(pos_key(at))
                self.call(i)
        Interp(parts, _) =>
            self.std_traits(fx)
            for p in parts
                match p
                    Lit => continue
                    Hole(x) => self.expr(prog, fx, x)
                    Fmt(x, _) => self.expr(prog, fx, x)
        ListLit(items, _) =>
            for x in items
                self.expr(prog, fx, x)
        SetLit(items, _) =>
            for x in items
                self.expr(prog, fx, x)
        TupleLit(items, _) =>
            for x in items
                self.expr(prog, fx, x)
        Comp(_, elem, value, clauses, _) =>
            for c in clauses
                self.expr(prog, fx, c.iter)
                if i := fx.iter_nexts.get(pos_key(expr_pos(c.iter)))
                    self.call(i)
                if x := c.cond
                    self.expr(prog, fx, x)
            self.expr(prog, fx, elem)
            if v := value
                self.expr(prog, fx, v)
        MapLit(entries, _) =>
            for en in entries
                self.expr(prog, fx, en.key)
                self.expr(prog, fx, en.value)
        Call(callee, args, _) =>
            if n := callee_name(callee)
                # eff.infer.4: `print` writes to standard output.
                if n == "print"
                    self.add("io", "print")
                    self.std_traits(fx)
                elif i := fx.free.get(n)
                    self.call(i)
            else
                self.expr(prog, fx, callee)
            for a in args
                if a.mutable
                    self.ref_write(fx, a.value)
            for a in args
                self.expr(prog, fx, a.value)
        Method(recv, n, name_pos, args) =>
            key := pos_key(name_pos)
            if i := fx.targets.get(key)
                self.call(i)
            elif tr := fx.assoc_calls.get(key)
                # `T.zero()` may run any implementation (trait.assoc.3, eff.infer.3).
                for i in implementations(prog, tr, n)
                    self.call(i)
            elif tr := fx.trait_calls.get(key)
                for i in implementations(prog, tr, n)
                    self.call(i)
            elif efs := std_fn_effects(fx, key, recv, n)
                for ef in efs
                    self.add(ef, "{std_head(fx, key, recv) else ""}.{n}")
            elif n.ends_with("_volatile") and fx.std_any.contains(key)
                # unsafe.hw.5: a volatile access gives `hw`.
                self.add("hw", "a pointer's `{n}`")
            elif m := fx.net_methods.get(key)
                # std.net.14: the methods of the handles `net.serve`, `net.listen` and `net.connect` make.
                for ef in ["net", "io"]
                    self.add(ef, m)
            elif fx.std_methods.contains(key)
                for ef in ["ui", "io"]
                    self.add(ef, "ui.Window.{n}")
            elif fx.regex_methods.contains(key)
                # std.regex.9: text in, text out, so no effects.
                regex_calls := 0
            elif not is_enum_name(prog, recv)
                # A built-in method (`xs.sort()`, `m.get(k)`) may compare,
                # hash or show its elements.
                self.std_traits(fx)
            self.ref_write(fx, recv)
            for a in args
                if a.mutable
                    self.ref_write(fx, a.value)
            self.expr(prog, fx, recv)
            for a in args
                self.expr(prog, fx, a.value)
        Member(recv, _, _) => self.expr(prog, fx, recv)
        Index(recv, index, _) =>
            self.expr(prog, fx, recv)
            self.expr(prog, fx, index)
        Unary(op, operand, _) =>
            # eff.infer.1: `spawn` starts a task (conc.task.1).
            if op == ast.UnOp.Spawn
                self.add("spawn", "spawn")
            self.expr(prog, fx, operand)
        NewRef(value, _) => self.expr(prog, fx, value)
        # type.fn.7: a function literal's body counts where the literal is written.
        Closure(_, body, _) => self.expr(prog, fx, body)
        Binary(op, lhs, rhs, _) =>
            if not is_arithmetic(op) and op != ast.BinOp.And and op != ast.BinOp.Or
                self.std_traits(fx)
            self.expr(prog, fx, lhs)
            self.expr(prog, fx, rhs)
        Range(lo, hi, _, _) =>
            if x := lo
                self.expr(prog, fx, x)
            if x := hi
                self.expr(prog, fx, x)
        If(branches, els, _, _) =>
            for br in branches
                self.expr(prog, fx, cond_value(br.cond))
                self.block(prog, fx, br.body)
            if b := els
                self.block(prog, fx, b)
        Match(scrutinee, arms, _) =>
            self.expr(prog, fx, scrutinee)
            for arm in arms
                if g := arm.guard
                    self.expr(prog, fx, g)
                self.block(prog, fx, arm.body)
        Try(x, context, _) =>
            self.expr(prog, fx, x)
            if c := context
                self.expr(prog, fx, c)
        OrElse(value, o, _) =>
            self.expr(prog, fx, value)
            self.otherwise(prog, fx, o)

## The effects of a recorded standard call `m.f(...)`; none when `f` has
## no listed effects.
fn std_fn_effects(fx Facts, key int, recv ast.Expr, n str) List[str]?
    if std_head(fx, key, recv) == none
        return none
    std_effects(fx.std_fns.get(key)?, n)

## The module name written in `m.f(...)`, for a recorded standard call.
@allow("expr.match.3") fn std_head(fx Facts, key int, recv ast.Expr) str?
    if not fx.std_fns.contains(key)
        return none
    match recv
        Name(m, _) => m
        _ => none

@allow("expr.match.3") fn callee_name(e ast.Expr) str?
    match e
        Name(n, _) => n
        TypeArgs(n, _, _) => n
        _ => none

## `Enum.Variant(...)` builds a value.
@allow("expr.match.3") fn is_enum_name(prog ast.Program, e ast.Expr) bool
    match e
        Name(m, _) => [d for d in prog.enums if d.name == m].len() > 0
        _ => false

## `ail effects FILE [--json]` (eff.infer.6): every program function's effect set by
## stable id, `fn:NAME` or `method:Type.name`, the prelude's left out. Functions that
## share an id are merged.
pub fn effects_report(p ast.Program, json bool) str
    sets := analyze(p, true).effects
    mut ids := Map[str, List[str]]()
    for i in 0..p.fns.len()
        f := p.fns[i]
        if is_prelude_line(f.pos.line)
            continue
        id := if f.owner == none
            and f.within == ast.Within.TopLevel then "fn:{f.name}" else "method:{display_name(p, f)}"
        mut set := ids.get(id) else []
        for e in sets[i]
            if not set.contains(e)
                set.push(e)
        ids[id] = set.sorted()
    names := ids.keys().sorted()
    if json
        items := [
            "{Json.Str(n).to_text()}:[{[Json.Str(e).to_text() for e in ids[n]].join(",")}]"
            for n in names
        ]
        return "\{\"ail_api\":1,\"effects\":\{{items.join(",")}}}\n"
    mut out := ""
    for n in names
        out = "{out}{n} \{{ids[n].join(", ")}}\n"
    out
