## A range of lines of one file not checked yet: `first` to `last`, inclusive.
pub struct Skip
    pub file str
    pub first int
    pub last int

## The lines not checked yet: functions with a construct this checker
## doesn't type yet, from their header to the next declaration, and the
## invariants and constants it couldn't type.
pub fn skipped(p ast.Program, r Report) List[Skip]
    mut starts := List[int]()
    for f in p.fns
        starts.push(f.pos.line)
    for s in p.structs
        starts.push(s.pos.line)
    for e in p.enums
        starts.push(e.pos.line)
    for t in p.traits
        starts.push(t.pos.line)
    for i in p.impls
        starts.push(i.pos.line)
    for c in p.consts
        starts.push(c.pos.line)
    starts.sort()
    mut out := List[Skip]()
    for k in r.gapped
        f := p.fns[k]
        mut end := if f.pos.line < 1073741824 then 1073741823 else 2147483647
        for l in starts
            if l > f.pos.line
                end = l - 1
                break
        out.push(local_skip(p, f.pos.line, end))
    for line in r.gapped_lines
        out.push(local_skip(p, line, line))
    for k in r.gapped_structs
        for inv in p.structs[k].invariants
            out.push(local_skip(p, inv.pos.line, inv.pos.line))
    for k in r.gapped_consts
        line := p.consts[k].pos.line
        out.push(local_skip(p, line, line))
    out

fn local_skip(p ast.Program, first int, last int) Skip
    if first >= 1073741824
        return Skip(file: "", first: first, last: last)
    mut file := ""
    mut base := 0
    for f in p.files
        if f.base < first
            file = f.path
            base = f.base
    Skip(file: file, first: first - base, last: (last - base).min(1048575))
