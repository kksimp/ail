## Calls, methods, fields, indexing and literals of collections, structs
## and variants (ADR 0377), as `list` to `index` in `77592931:bootstrap/src/check.rs`.
use ast
use fix

@allow("expr.match.3") fn Checker.list(mut self, elems List[ast.Expr], at ast.Pos, expect Ty?) Ty
    mut hint := none
    if t := expect
        match opt_inner(t)
            ListOf(x) => hint = x
            _ => hint = none
    if elems.len() == 0
        if h := hint
            return Ty.ListOf(h)
        err_help(
            "type.coll.3",
            at,
            "the element type of this empty list isn't known",
            "use `[]` where a `List[...]` is expected, e.g. as an argument or struct field",
        )
        return Ty.Unknown
    # A known element type: each element must fit it.
    if h := hint
        if not has_unknown(h)
            for e in elems
                t := expr(e, h, true)
                if reject_unhandled(t, expr_pos(e))
                    continue
                if t == Ty.Unit
                    err("type.coll.2", expr_pos(e), "a list element must be a value")
                elif not accepts(h, t)
                    err(
                        "type.coll.2",
                        expr_pos(e),
                        "the elements of this list are {show(h)}, but this is {show(t)}",
                    )
            return Ty.ListOf(h)
    mut first := no_ty()
    for e in elems
        mut want := first
        if want == none
            want = hint
        t := expr(e, want, true)
        if reject_unhandled(t, expr_pos(e))
            continue
        if t == Ty.Unit
            err("type.coll.2", expr_pos(e), "a list element must be a value")
        elif t == Ty.Never
            continue
        elif f := first
            if not same(t, f)
                err(
                    "type.coll.2",
                    expr_pos(e),
                    "list elements must all have one type: this is {show(t)}, the first is {show(f)}",
                )
        else
            first = t
    if f := first
        return Ty.ListOf(f)
    Ty.ListOf(hint else Ty.Unknown)

## Check arguments without a signature to check them against.
fn Checker.args_only(mut self, args List[ast.Arg])
    for a in args
        expr(a.value, none, true)

@allow("expr.match.3") fn Checker.call(mut self, callee ast.Expr, args List[ast.Arg], expect Ty?) Ty
    mut n := ""
    mut npos := expr_pos(callee)
    mut targs := List[ast.TypeRef]()
    mut has_targs := false
    match callee
        Name(x, p) =>
            n = x
            npos = p
        TypeArgs(x, a, p) =>
            n = x
            npos = p
            targs = a
            has_targs = true
        _ =>
            t := expr(callee, none, true)
            return call_value("this value", t, args, expr_pos(callee))
    if not has_targs
        if l := local(n)
            return call_value(n, l.ty, args, npos)
    if n == "print"
        return print_call(args, npos)
    if n == ast.YIELD
        return yield_call(args, npos)
    # err.model.2: `unreachable(message)` traps; it never returns.
    if n == "unreachable"
        s := plain_sig(none, [Ty.Str], Ty.Unit)
        check_call(n, s, [], args, none, npos, none)
        return Ty.Never
    if ASSERT_FNS.contains(n)
        return assert_call(n, args, npos)
    if n == "zip" and not has_targs and not fns.contains("zip")
        return zip_call(args, npos)
    if CONC_TYPES.contains(n)
        return conc_constructor(n, targs, has_targs, args, npos, expect)
    if has_targs and (n == "List" or n == "Set" or n == "Map")
        t := collection_constructor(n, targs, npos)
        if args.len() > 0
            args_only(args)
            err_help(
                "type.coll.8",
                npos,
                "`{n}[...]()` makes an empty collection and takes no arguments",
                "write the elements as a literal, e.g. `[1, 2]`",
            )
        return t
    if d := types.get(n)
        if root_decl_hidden(d, npos)
            # Inside a module a bare name is its own or the standard one: a root type of the same
            # name is not in scope there (mod.unit.1), so a variant such as `Field(...)` wins.
            if v := bare_variant(n, npos, expect)
                return variant_literal(v.enum_index, v.variant, none, args, npos, expect)
        match d
            DStruct(s) =>
                symbols[pos_key(npos)] = "type:{n}"
                mut explicit := no_binds()
                if has_targs
                    explicit = explicit_args(n, struct_params[s], targs, npos)
                return struct_literal(s, explicit, args, npos, expect)
            DEnum(e) =>
                args_only(args)
                err_help(
                    "expr.name.1",
                    npos,
                    "`{n}` is an enum, not a function",
                    "use one of its variants, e.g. `{n}.{prog.enums[e].variants[0].name}`",
                )
                return Ty.Unknown
    if i := fns.get(n)
        reject_test_call(i, npos)
        note_deprecated(i, npos)
        note_unsafe_call(i, npos)
        declared_fns.add(pos_key(npos))
        symbols[pos_key(npos)] = "fn:{n}"
        mut s := sigs[i]
        # A test can fail (test.attr.4), but calling it is already an error.
        if has_attr(prog.fns[i], "test") and prog.fns[i].ret == none
            s.ret = Ty.Unit
        if gapped.contains(i) and is_inferred(s.ret)
            gap("calls a gapped function")
        mut binds := List[Bind]()
        if has_targs
            binds = explicit_args(n, s.generics[s.owner..s.owner + s.declared], targs, npos)
        if has_attr(prog.fns[i], "variadic c")
            return check_variadic(n, s, args, npos, expect)
        return check_call(n, s, binds, args, none, npos, expect)
    if v := bare_variant(n, npos, expect)
        return variant_literal(v.enum_index, v.variant, none, args, npos, expect)
    args_only(args)
    if traits.contains(n)
        err_help(
            "expr.name.1",
            npos,
            "`{n}` is a trait, not a function",
            "call a method of it, e.g. `{n}.method(x)`",
        )
    elif variant_owners(n).len() == 0
        unknown_name(n, npos, args.len())
    Ty.Unknown

## Whether `d` is declared in the root module while `at` is inside another module (mod.unit.1).
fn Checker.root_decl_hidden(self, d Def, at ast.Pos) bool
    decl := def_pos(d)
    decl.line < 1073741824 and module_at(prog, decl) == "" and module_at(prog, at) != ""

fn no_binds() List[Bind]?
    none

## An absent type, for a local read before its first assignment.
fn no_ty() Ty?
    none

fn no_tys() List[Ty]?
    none

fn plain_sig(receiver bool?, params List[Ty], result Ty) Sig
    Sig(
        receiver: receiver,
        params: [SigParam(mutable: false, ty: t) for t in params],
        names: [],
        moves: [],
        ret: result,
        generics: [],
        owner: 0,
        declared: 0,
    )

## `List[T]()`: an empty collection of a given type (type.coll.8).
fn Checker.collection_constructor(mut self, n str, targs List[ast.TypeRef], at ast.Pos) Ty
    want := if n == "Map" then 2 else 1
    if targs.len() != want
        err_help(
            "gram.generic.1",
            at,
            "`{n}` takes {count(want, "type argument")}, but {was_were(targs.len())} given",
            "write e.g. `{n}[int]()`",
        )
        return Ty.Unknown
    first := resolve_type(targs[0])
    if n == "List"
        return Ty.ListOf(first)
    require_key(first, at)
    if n == "Set"
        return Ty.SetOf(first)
    second := resolve_type(targs[1])
    Ty.MapOf(key: first, value: second)

## `{k: v, ...}`, or `{}` where a map or set is expected (type.coll.2-3).
@allow("expr.match.3")
fn Checker.map_literal(mut self, entries List[ast.MapEntry], at ast.Pos, expect Ty?) Ty
    expected := opt_inner(expect else Ty.Unknown)
    if entries.len() == 0
        if is_set_ty(expected) or is_map_ty(expected)
            return expected
        err_help(
            "type.coll.3",
            at,
            "the type of this empty `\{}` isn't known",
            "use `\{}` where a map or set is expected, or write `Map[K, V]()` or `Set[T]()`",
        )
        return Ty.Unknown
    mut kh := none
    mut vh := none
    match expected
        MapOf(k, v) =>
            kh = k
            vh = v
        _ => kh = none
    keys := [en.key for en in entries]
    vals := [en.value for en in entries]
    k := elements(keys, kh, "map keys")
    v := elements(vals, vh, "map values")
    require_key(k, at)
    duplicate_literals(keys, "key")
    Ty.MapOf(key: k, value: v)

## `{a, b, ...}` (type.coll.2).
@allow("expr.match.3")
fn Checker.set_literal(mut self, items List[ast.Expr], at ast.Pos, expect Ty?) Ty
    mut hint := none
    match opt_inner(expect else Ty.Unknown)
        SetOf(x) => hint = x
        _ => hint = none
    t := elements(items, hint, "set elements")
    require_key(t, at)
    duplicate_literals(items, "element")
    Ty.SetOf(t)

## A literal key or element as text, to compare (type.map.1).
@allow("expr.match.3") fn literal_text(e ast.Expr) str?
    match e
        Int(n, _) => "i{n}"
        Unary(op, operand, _) =>
            if op != ast.UnOp.Neg
                return none
            match operand
                Int(n, _) => if n == "0" then "i0" else "i-{n}"
                _ => none
        Str(s, _) => "s{s}"
        Char(c, _) => "c{c}"
        Bool(b, _) => "b{b}"
        _ => none

## Report a key or element written twice as the same literal (type.map.1).
fn Checker.duplicate_literals(mut self, items List[ast.Expr], what str)
    mut seen := List[str]()
    mut first_at := List[ast.Pos]()
    for e in items
        lit := literal_text(e) else continue
        if k := seen.index_of(lit)
            p := first_at[k]
            err_help(
                "type.map.1",
                expr_pos(e),
                "this {what} is written twice in the literal",
                "the first is at {p.line}:{p.col}; remove one",
            )
        else
            seen.push(lit)
            first_at.push(expr_pos(e))

## The common type of a literal's elements: the expected one, which each
## must fit, or else the first element's.
fn Checker.elements(mut self, items List[ast.Expr], hint Ty?, what str) Ty
    mut known := none
    if h := hint
        if not has_unknown(h)
            known = h
    mut first := no_ty()
    for e in items
        mut want := known
        if want == none
            want = first
        t := expr(e, want, true)
        if reject_unhandled(t, expr_pos(e))
            continue
        if t == Ty.Unit
            err("type.coll.2", expr_pos(e), "{what} must be values")
            continue
        if w := want
            if not accepts(w, t)
                err(
                    "type.coll.2",
                    expr_pos(e),
                    "{what} must all have one type: this is {show(t)}, the others are {show(w)}",
                )
        elif t != Ty.Never
            first = t
    if k := known
        return k
    first else Ty.Unknown

## Explicit type arguments for `params` (gen.infer.2).
fn Checker.explicit_args(
    mut self,
    what str,
    params List[int],
    refs List[ast.TypeRef],
    at ast.Pos,
) List[Bind]
    if refs.len() != params.len()
        if params.len() == 0
            err("gen.infer.2", at, "`{what}` takes no type arguments")
        else
            err(
                "gen.infer.2",
                at,
                "`{what}` takes {count(params.len(), "type argument")}, but {was_were(refs.len())} given",
            )
        return [Bind(param: p, ty: Ty.Unknown) for p in params]
    [Bind(param: params[k], ty: resolve_type(refs[k])) for k in 0..params.len()]

## `Variant(field: value, ...)` (type.enum.6), inferring the enum's type
## arguments (gen.infer.1).
fn Checker.variant_literal(
    mut self,
    e int,
    v int,
    explicit List[Bind]?,
    args List[ast.Arg],
    at ast.Pos,
    expect Ty?,
) Ty
    variant := prog.enums[e].variants[v]
    if variant.fields.len() == 0
        args_only(args)
        err_help(
            "type.enum.6",
            at,
            "the variant `{variant.name}` carries no data",
            "write `{variant.name}` without parentheses",
        )
        if b := explicit
            return enum_value(e, [x.ty for x in b], expect, at, variant.name)
        return enum_value(e, none, expect, at, variant.name)
    params := enum_params[e]
    mut binds := explicit else expected_binds(Def.DEnum(e), expect)
    label := "{prog.enums[e].name}.{variant.name}"
    before := diags.len()
    fields_literal(label, variant.fields, variant_types[e][v], params, mut binds, args, at)
    quiet := diags.len() > before
    finish(label, params, mut binds, at, quiet)
    Ty.Enum(e, [bound(binds, p) for p in params])

## Check a call's arguments against a signature (expr.call.1-2, own.param.2,
## own.excl.1-2), inferring its type parameters (gen.infer.1) and checking
## their bounds (gen.bound.3). Returns the type of the call.
fn Checker.check_call(
    mut self,
    what str,
    sig Sig,
    given List[Bind],
    args List[ast.Arg],
    recv ast.Expr?,
    at ast.Pos,
    expect Ty?,
) Ty
    mut binds := given
    vars := sig.generics
    order := arg_slots(what, sig, args, at) else
        args_only(args)
        return subst_unknown(sig.ret, binds, vars)
    before := diags.len()
    for i in order
        a := args[i]
        k := slot_of(sig, args, i)
        p := sig.params[k]
        hint := subst_unknown(p.ty, binds, vars)
        mut want_hint := none
        if hint != Ty.Unknown
            want_hint = hint
        # A `|x| e` argument is a function literal (type.fn.4); its parameter types come
        # from the arguments before it (type.fn.8).
        t := expr(a.value, want_hint, true)
        move_arg(a, k < sig.moves.len() and sig.moves[k])
        bind(p.ty, t, vars, mut binds)
        want := subst_unknown(p.ty, binds, vars)
        if p.mutable and not a.mutable
            mut d := new_diag(
                "own.param.2",
                expr_pos(a.value),
                "this parameter is `mut`, so the argument must be marked `mut`",
            ).with_help("write `mut` before the argument")
            if is_plain_name(a.value)
                d = d.with_fix("mark the argument `mut`", [fix.insert(expr_pos(a.value), "mut ")])
            diags.push(d)
        elif p.mutable
            require_mutable(a.value, "own.param.2", "passed `mut`")
        elif a.mutable
            err_help(
                "own.param.2",
                expr_pos(a.value),
                "this parameter isn't `mut`",
                "remove the `mut`",
            )
        if not accepts(want, t)
            mismatch("expr.call.2", expr_pos(a.value), want, t)
    # Type parameters that only the result mentions come from the expected type.
    if e := expect
        mut open := false
        for v in vars
            if not is_bound(binds, v)
                open = true
        if open
            bind(sig.ret, e, vars, mut binds)
    quiet := diags.len() > before
    finish(what, vars, mut binds, at, quiet)
    # own.uniq.5: generic code may copy its values, so a unique type can't be
    # a function's type argument.
    own := vars[sig.owner.min(vars.len())..]
    for b in binds
        if own.contains(b.param)
            no_unique(b.ty, at, "a type argument")
    # own.excl.1-2: two `mut` places must not overlap.
    mut items := List[ast.Expr]()
    mut muts := List[bool]()
    if r := recv
        items.push(r)
        muts.push(sig.receiver == true)
    for i in order
        items.push(args[i].value)
        muts.push(sig.params[slot_of(sig, args, i)].mutable and args[i].mutable)
    for j in 0..items.len()
        for i in 0..j
            if muts[i] and muts[j] and certainly_overlap(items[i], items[j])
                hint := if is_index(items[j]) then "to exchange two list elements, use `xs.swap(i, j)`" else "pass `mut` only once; the function already sees the change through it"
                err_help(
                    "own.excl.2",
                    expr_pos(items[j]),
                    "this `mut` argument overlaps another `mut` argument of the same call",
                    hint,
                )
    subst(sig.ret, binds)

## ffi.var.2-3: a call of a variadic `extern c fn`. The named parameters are
## checked as in any call; every further argument keeps its own type, which
## must have a C layout, and `f32` is refused because C promotes it to `double`.
fn Checker.check_variadic(mut self, n str, s Sig, args List[ast.Arg], at ast.Pos, expect Ty?) Ty
    want := s.params.len()
    if args.len() < want
        args_only(args)
        err_help(
            "ffi.var.2",
            at,
            "`{n}` takes at least {count(want, "argument")}, but {was_were(args.len())} given",
            "pass the named arguments first, then the variadic ones",
        )
        return s.ret
    fixed := [args[k] for k in 0..want]
    t := check_call(n, s, [], fixed, none, at, expect)
    mut ints := 0
    mut floats := 0
    for p in s.params
        if p.ty == Ty.Float or p.ty == Ty.Num("f32")
            floats += 1
        else
            ints += 1
    for k in want..args.len()
        a := args[k]
        if a.label != none or a.mutable
            err_help(
                "ffi.var.2",
                expr_pos(a.value),
                "a variadic argument is passed by value, with no name and no `mut`",
                "write the plain value",
            )
        vt := expr(a.value, none, true)
        if vt == Ty.Float
            floats += 1
        else
            ints += 1
        if vt == Ty.Num("f32")
            err_help(
                "ffi.var.3",
                expr_pos(a.value),
                "C passes a variadic `float` argument as a `double`, so an `f32` can't be one",
                "convert it to a `float` first",
            )
        elif not c_layout(vt) and vt != Ty.Unknown
            err_help(
                "ffi.var.3",
                expr_pos(a.value),
                "{show(vt)} has no C layout, so it can't be a variadic argument",
                "pass `int`, `float`, `bool`, a sized number or a raw pointer `*T`; make a `str` into a C string with `mem.cstr`",
            )
    if ints > 6 or floats > 8
        err_help(
            "ffi.var.2",
            at,
            "this call to `{n}` passes {ints} integer-like and {floats} float arguments; a C call takes at most 6 and 8",
            "split the call, or pass the values through a buffer",
        )
    t

## The parameter that argument `i` fills: its place when none are named,
## else the named parameter, or the next one for a positional argument.
fn slot_of(sig Sig, args List[ast.Arg], i int) int
    l := args[i].label else return i
    if sig.names.len() == 0
        return i
    sig.names.index_of(l.name) else i

## expr.call.3: check the labels of a call and return the argument indices
## in parameter order, or `none` after reporting a problem (including a
## wrong argument count, expr.call.1).
fn Checker.arg_slots(mut self, what str, sig Sig, args List[ast.Arg], at ast.Pos) List[int]?
    miscount := "`{what}` takes {count(sig.params.len(), "argument")}, but {was_were(args.len())} given"
    mut first := -1
    for i in 0..args.len()
        if args[i].label != none
            first = i
            break
    if first < 0
        if args.len() != sig.params.len()
            mut d := new_diag("expr.call.1", at, miscount)
            # `t.reshape(2, 3)`: the shape is one list.
            if what.ends_with("Tensor.reshape") and sig.params.len() == 1 and args.len() >= 2
                d = d.with_help("the new shape is one list: `t.reshape([2, 3])`")
                d = d.with_fix("pass the shape as a list", [fix.call(
                    at,
                    "reshape",
                    "reshape([$a])",
                )])
            diags.push(d)
            return none
        return [i for i in 0..args.len()]
    first_pos := args[first].label?.pos else at
    if sig.names.len() == 0 or sig.names.len() != sig.params.len()
        err_help(
            "expr.call.3",
            first_pos,
            "`{what}` doesn't take named arguments",
            "pass the arguments by position",
        )
        return none
    mut filled := [-1 for _ in sig.params]
    mut ok := true
    for i in 0..args.len()
        a := args[i]
        mut slot := i
        if l := a.label
            if k := sig.names.index_of(l.name)
                slot = k
            else
                mut d := new_diag("expr.call.3", l.pos, "`{what}` has no parameter `{l.name}`")
                if s := suggest(l.name, sig.names)
                    d = d.did_you_mean(l.name, s)
                elif sig.names.is_empty()
                    d = d.with_help("`{what}` has no parameters, so it takes no named arguments")
                else
                    listed := ["`{n}`" for n in sig.names].join(", ")
                    d = d.with_help("its parameters are {listed}; name one of them")
                diags.push(d)
                ok = false
                continue
        elif i > first
            mut d := new_diag(
                "expr.call.3",
                expr_pos(a.value),
                "a positional argument can't follow a named one",
            ).with_help("name this argument too, or move it before the named ones")
            if i < sig.names.len()
                pn := sig.names[i]
                if [b for b in args if b.label != none and b.label?.name == pn].len() == 0
                    d = d.with_fix("name it `{pn}:`", [fix.insert(expr_pos(a.value), "{pn}: ")])
            diags.push(d)
            ok = false
            continue
        if slot >= filled.len()
            err("expr.call.1", at, miscount)
            return none
        if filled[slot] >= 0
            mut where := expr_pos(a.value)
            mut how := " by position"
            if l := a.label
                where = l.pos
                how = ""
            err_help(
                "expr.call.3",
                where,
                "parameter `{sig.names[slot]}` is given more than once{how}",
                "pass each parameter once: remove one of the two arguments",
            )
            ok = false
        else
            filled[slot] = i
    if not ok
        return none
    missing := [sig.names[k] for k in 0..filled.len() if filled[k] < 0]
    if missing.len() > 0
        err("expr.call.1", at, "`{what}` is missing {list_names(missing)}")
        return none
    filled

@allow("expr.match.3") fn is_index(e ast.Expr) bool
    match e
        Index => true
        _ => false

## Report the type parameters among `vars` that inference left unknown
## (gen.infer.1), unless an error was already reported (`quiet`), and check
## every bound (gen.bound.3). A trait's `Self` already implements it.
fn Checker.finish(mut self, what str, vars List[int], mut binds List[Bind], at ast.Pos, quiet bool)
    missing := [v for v in vars if not is_bound(binds, v)]
    if missing.len() > 0 and not quiet
        names := [tparams[m].name for m in missing]
        mut example := "{what}[...](...)"
        if k := what.find(".")
            example = "{what.slice(0, k)}[...].{what.slice(k + 1, what.len())}(...)"
        err_help(
            "gen.infer.1",
            at,
            "the type of {list_names(names)} for `{what}` can't be inferred from the arguments or the expected type",
            "write the type arguments, e.g. `{example}`",
        )
    for m in missing
        binds.push(Bind(param: m, ty: Ty.Unknown))
    for v in vars
        if trait_self.contains(v)
            continue
        t := bound(binds, v)
        for b in tparams[v].bounds
            require(t, b, at, "the type parameter `{tparams[v].name}` of `{what}`")

fn Checker.print_call(mut self, args List[ast.Arg], at ast.Pos) Ty
    for a in args
        if l := a.label
            unsupported(l.pos, "named arguments are not supported by the bootstrap yet (ADR 0058)")
        if a.mutable
            err_help(
                "own.param.2",
                expr_pos(a.value),
                "`print`'s parameter isn't `mut`",
                "remove the `mut`",
            )
    if args.len() != 1
        args_only(args)
        mut d := new_diag(
            "mod.main.3",
            at,
            "`print` takes exactly one argument, but {was_were(args.len())} given",
        ).with_help("print one string that interpolates the values: `print(\"\{a} \{b}\")`")
        if args.len() > 1 and [a for a in args if a.label != none or a.mutable].len() == 0
            d = d.with_fix("print one interpolated string", [fix.call(at, "print", "print($*)")])
        diags.push(d)
        return Ty.Unit
    v := args[0].value
    t := expr(v, none, true)
    if t == Ty.Unit
        if f := called_fn(v)
            err_help(
                "mod.main.3",
                expr_pos(v),
                "`{f}` returns nothing, so there is no value to print",
                "if `{f}` should give a value, declare its type after the `)`: `fn {f}(...) int`",
            )
        else
            err("mod.main.3", expr_pos(v), "this expression produces no value to print")
    else
        text_form(t, expr_pos(v), "mod.main.3")
    Ty.Unit

## `Type(field: value, ...)` (type.struct.3-5), inferring the struct's type
## arguments (gen.infer.1).
fn Checker.struct_literal(
    mut self,
    s int,
    explicit List[Bind]?,
    args List[ast.Arg],
    at ast.Pos,
    expect Ty?,
) Ty
    decl := prog.structs[s]
    params := struct_params[s]
    mut binds := explicit else expected_binds(Def.DStruct(s), expect)
    before := diags.len()
    private_literal(s, at)
    fields_literal(decl.name, decl.fields, field_types[s], params, mut binds, args, at)
    quiet := diags.len() > before
    finish(decl.name, params, mut binds, at, quiet)
    Ty.Struct(s, [bound(binds, p) for p in params])

## The `(field: value, ...)` of a struct literal or a variant with data
## (type.struct.3-5, type.enum.6).
fn Checker.fields_literal(
    mut self,
    label str,
    fields List[ast.Field],
    ts List[Ty],
    vars List[int],
    mut binds List[Bind],
    args List[ast.Arg],
    at ast.Pos,
)
    mut given := [false for _ in fields]
    slots := field_slots(fields, args)
    positional_types(label, fields, ts, args, slots, at)
    mut lost := false
    for k in 0..args.len()
        a := args[k]
        slot := slots[k]
        if a.mutable
            err_help(
                "own.param.2",
                expr_pos(a.value),
                "`mut` can't mark a struct field's value",
                "remove the `mut`",
            )
        if slot.field < 0
            expr(a.value, none, true)
            lost = true
            if l := a.label
                names := [f.name for f in fields]
                mut d := new_diag("type.struct.4", l.pos, "`{label}` has no field `{l.name}`")
                if s := suggest(l.name, names)
                    d = d.did_you_mean(l.name, s)
                diags.push(d)
            else
                err(
                    "type.struct.4",
                    expr_pos(a.value),
                    "too many arguments: `{label}` has {count(fields.len(), "field")}",
                )
            continue
        i := slot.field
        fname := fields[i].name
        if given[i]
            mut where := expr_pos(a.value)
            if l := a.label
                where = l.pos
            how := if slot.how
                == ArgKind.Shorthand then " (a local named like it sets it too)" else ""
            err("type.struct.4", where, "field `{fname}` is given more than once{how}")
        given[i] = true
        hint := subst_unknown(ts[i], binds, vars)
        mut want_hint := none
        if hint != Ty.Unknown
            want_hint = hint
        t := expr(a.value, want_hint, true)
        if reject_unhandled(t, expr_pos(a.value))
            continue
        consume(a.value, t)
        bind(ts[i], t, vars, mut binds)
        ft := subst_unknown(ts[i], binds, vars)
        if not accepts(ft, t)
            err(
                "type.struct.5",
                expr_pos(a.value),
                "field `{fname}` is {show(ft)}, but this is {show(t)}",
            )
    # std.net.17: `net.Response(...)` may leave `all_headers` out.
    missing := [
        fields[k].name
        for k in 0..fields.len() if not given[k]
            and fields[k].default == none
            and not (label == "net.Response" and fields[k].name == "all_headers")
    ]
    if missing.len() > 0 and not lost
        word := if missing.len() == 1 then "field" else "fields"
        mut d := new_diag(
            "type.struct.4",
            at,
            "`{label}(...)` is missing {word} {list_names(missing)}",
        ).with_help(missing_help(fields))
        holes := ["{m}: todo" for m in missing].join(", ")
        template := if args.len() == 0 then "{label}({holes})" else "{label}($a, {holes})"
        if [a for a in args if a.mutable].len() == 0
            d = d.with_fix("give the missing fields a `todo` each", [fix.call(at, label, template)])
        diags.push(d)

## The help of a missing field (type.struct.4): which fields may be left out
## (type.struct.8), and that these may not.
fn missing_help(fields List[ast.Field]) str
    left := [f.name for f in fields if f.default != none]
    if left.len() == 0
        return "every field must be given (they have no defaults); `todo` stands in for a value you haven't written"
    "the fields without a default must be given; only {list_names(left)} may be left out; `todo` stands in for a value you haven't written"

## type.struct.7: positional arguments may only fill fields whose types all
## differ, so that swapping two of them is a type error.
fn Checker.positional_types(
    mut self,
    label str,
    fields List[ast.Field],
    ts List[Ty],
    args List[ast.Arg],
    slots List[Slot],
    at ast.Pos,
)
    filled := [s.field for s in slots if s.how == ArgKind.Positional and s.field >= 0]
    mut a := -1
    mut b := -1
    for n in 0..filled.len()
        if a >= 0
            break
        for m in n + 1..filled.len()
            if may_be_same(ts[filled[n]], ts[filled[m]])
                a = filled[n]
                b = filled[m]
                break
    if a < 0
        return
    mut where := ast.Pos(line: 0, col: 0)
    for k in 0..args.len()
        if slots[k].how == ArgKind.Positional and slots[k].field == b
            where = expr_pos(args[k].value)
            break
    fa := fields[a].name
    fb := fields[b].name
    mut d := new_diag(
        "type.struct.7",
        where,
        "fields `{fa}` and `{fb}` of `{label}` are both {show(ts[a])}, so they can't be given by position",
    ).with_help("name them: `{label}({fa}: ..., {fb}: ...)`")
    if slots.len() == fields.len() and [
        x
        for x in slots if x.field < 0 or x.how != ArgKind.Positional
    ].len() == 0
        names := [fields[x.field].name for x in slots]
        # A qualified type is written with its module's alias; the anchor takes the name as written.
        written := label.split(".").last() else label
        d = d.with_fix("name the fields", [fix.call_named(at, written, names)])
    diags.push(d)

## What `x.name(...)` can refer to (trait.res.1).
pub enum Cand
    CBuiltin
    CInherent(index int)
    CTrait(index int)

fn Checker.method_index(self, tn str, n str) int?
    methods.get("{tn}.{n}")

@allow("expr.match.3") fn Checker.candidates(self, t Ty, n str) List[Cand]
    mut found := List[Cand]()
    if builtin(t, n) != none
        found.push(Cand.CBuiltin)
    if tn := type_name_of(t)
        if i := method_index(tn, n)
            found.push(Cand.CInherent(i))
    for tr in 0..prog.traits.len()
        if trait_method(tr, n) == none
            continue
        # A built-in method of the same name takes precedence over a standard
        # trait's (`xs.max()`) (trait.auto.4, trait.res.2).
        standard := tr == std_eq or tr == std_ord or tr == std_to_str or tr == std_hash
        if found.len() > 0 and standard
            continue
        mut has := false
        match t
            AnyOf(a) => has = a == tr or tr == std_to_str
            _ => has = implements(t, tr)
        if has
            found.push(Cand.CTrait(tr))
    found

## The pending local named by `recv`, if any (type.coll.13).
fn Checker.pending_recv(self, recv ast.Expr) int?
    n := name_of(recv)?
    pending_of(n)

@allow("expr.match.3")

## type.bytes.13: `bytes.from_list(xs)`, `bytes.from_hex(s)`,
## `bytes.from_base64(s)` and `bytes.zeros(n)`.
fn Checker.bytes_assoc(mut self, n str, at ast.Pos, args List[ast.Arg], expect Ty?) Ty
    mut sig := plain_sig(none, [Ty.ListOf(Ty.Num("u8"))], Ty.Bytes)
    if n == "from_hex" or n == "from_base64"
        sig = plain_sig(none, [Ty.Str], Ty.Opt(Ty.Bytes))
    elif n == "zeros"
        sig = plain_sig(none, [Ty.Int], Ty.Bytes)
    elif n != "from_list"
        args_only(args)
        mut d := new_diag(
            "type.bytes.13",
            at,
            "`bytes` has no associated function `{n}`",
        ).with_help("they are `from_list`, `from_hex`, `from_base64` and `zeros`")
        # `bytes.fromhex` is `bytes.from_hex`: the same letters, spelt with `_`.
        spelt := n.replace("_", "")
        for k in ["from_list", "from_hex", "from_base64", "zeros"]
            if k.replace("_", "") == spelt
                d = d.with_fix("write `{k}`", [fix.replace(at, n, k)])
                break
        diags.push(d)
        return Ty.Unknown
    check_call("bytes.{n}", sig, [], args, none, at, expect)

@allow("expr.match.3")
fn Checker.method(mut self, recv ast.Expr, n str, at ast.Pos, args List[ast.Arg], expect Ty?) Ty
    # type.coll.13: `xs.push(x)` or `s.add(x)` can fix a pending local's type.
    if k := pending_recv(recv)
        if args.len() == 1 and not pending[k].opt
            if n == "push" and not pending[k].brace
                t := quiet_type(args[0].value)
                if k2 := pending_recv(recv)
                    settle(k2, Ty.ListOf(t))
            elif n == "add" and pending[k].brace
                t := quiet_type(args[0].value)
                if k2 := pending_recv(recv)
                    settle(k2, Ty.SetOf(t))
    # type.coll.13: `m.push(k, x)` makes a pending `{}` a `Map[K, List[X]]`.
    if k := pending_recv(recv)
        if n == "push" and pending[k].brace and args.len() == 2
            kt := quiet_type(args[0].value)
            vt := quiet_type(args[1].value)
            if k2 := pending_recv(recv)
                settle(k2, Ty.MapOf(key: kt, value: Ty.ListOf(vt)))
    # `Type.name(...)`: an associated function or a variant; `Trait.name(x,
    # ...)`: a qualified trait method call (trait.res.1).
    mut head := ""
    mut targs := List[ast.TypeRef]()
    mut has_targs := false
    match recv
        Name(x, _) =>
            if local(x) == none
                head = x
        TypeArgs(x, a, _) =>
            head = x
            targs = a
            has_targs = true
        _ => head = ""
    if head != ""
        if not has_targs
            if t := std_call(head, n, at, args, expect)
                return t
        if not has_targs
            if t := param_assoc_call(head, n, at, args, expect)
                return t
        if d := types.get(head)
            mut explicit := no_binds()
            if has_targs
                explicit = explicit_args(head, def_params(d), targs, at)
            return associated(d, explicit, n, at, args, expect)
        # trait.assoc.4: `List[U].from_json(j)`, an associated function of a
        # trait that a builtin generic type implements (ADR 0748).
        if head == "List" and has_targs and targs.len() == 1
            if t := builtin_assoc_call(Ty.ListOf(resolve_type(targs[0])), n, at, args, expect)
                return t
        # type.bytes.13: `bytes.from_list(xs)` and the like.
        if head == "bytes" and not has_targs
            return bytes_assoc(n, at, args, expect)
        # type.char.4: `char.from_code(n)`.
        if head == "char" and not has_targs
            if n != "from_code"
                args_only(args)
                err("expr.name.1", at, "`char` has no associated function `{n}`")
                return Ty.Unknown
            return check_call(
                "char.from_code",
                plain_sig(none, [Ty.Int], Ty.Opt(Ty.Char)),
                [],
                args,
                none,
                at,
                expect,
            )
        if not has_targs
            if tr := traits.get(head)
                return qualified(tr, n, at, args)
    rt0 := expr(recv, none, true)
    if reject_unhandled(rt0, expr_pos(recv)) or rt0 == Ty.Unknown
        args_only(args)
        return Ty.Unknown
    # own.ref.3: a method of a `ref T` is called on the `T` in the cell.
    mut rt := rt0
    match rt0
        RefOf(t) => rt = t
        _ => rt = rt0
    if reject_drop_call(rt, n, at)
        args_only(args)
        return Ty.Unknown
    match rt
        Conc(k, inner) =>
            # eff.use.1: these methods wait for or change shared state.
            effect_marks += 1
            if k == "Atomic"
                atomic_calls.add(pos_key(at))
            else
                handle_calls.add(pos_key(at))
            return conc_method(k, inner, n, at, args)
        Struct(s, _) =>
            sn := prog.structs[s].name
            if sn == "ui.Window"
                return ui_method(recv, n, at, args, expect)
            if tn := sn.strip_prefix("net.")
                if t := net_method(recv, tn, n, at, args, expect)
                    return t
            if sn == "regex.Regex"
                return regex_method(recv, n, at, args, expect)
            if sn == "tensor.Tensor"
                return tensor_method(recv, rt, n, at, args, expect)
            if sn == "proc.Output"
                return output_method(n, at, args)
        PtrOf(target) => return ptr_method(rt, target, n, at, args, expect)
        Enum(e, _) =>
            if prog.enums[e].name == "ui.KeyCode"
                return key_method(recv, n, at, args, expect)
        _ => rt = rt
    cands := candidates(rt, n)
    if cands.len() == 0
        args_only(args)
        if not hidden_std_module(recv, n, at)
            no_method(rt, n, at)
        return Ty.Unknown
    if cands.len() > 1
        args_only(args)
        forms := [cand_form(c, rt, n) for c in cands]
        err_help(
            "trait.res.1",
            at,
            "`{n}` could mean any of {list_names(forms)} here",
            "call a trait's method in the qualified form, e.g. `Trait.name(x, ...)`",
        )
        return Ty.Unknown
    match cands[0]
        CBuiltin => builtin_call(recv, rt, n, at, args)
        CInherent(i) => inherent_call(i, recv, rt, n, at, args, expect)
        CTrait(tr) =>
            if m := trait_method(tr, n)
                if prog.fns[m].receiver == none
                    args_only(args)
                    err_help(
                        "trait.assoc.2",
                        at,
                        "`{n}` is an associated function of `{prog.traits[tr].name}`, not a method",
                        "call it on the type: `{ty_name(rt)}.{n}(...)`",
                    )
                    return Ty.Unknown
            trait_call(tr, rt, recv, n, at, args, expect)

## A name that `ail check` treats as a standard module even when not imported.
fn Checker.std_like(self, n str) bool
    undeclared := not types.contains(n)
        and not traits.contains(n)
        and not consts.contains(n)
        and not fns.contains(n)
    undeclared and STD_MODULES.contains(n)

fn Checker.cand_form(self, c Cand, rt Ty, n str) str
    match c
        CTrait(t) => "{prog.traits[t].name}.{n}(x)"
        CBuiltin | CInherent => "{ty_name(rt)}.{n}"

@allow("expr.match.3")
fn Checker.inherent_call(
    mut self,
    i int,
    recv ast.Expr,
    rt Ty,
    n str,
    at ast.Pos,
    args List[ast.Arg],
    expect Ty?,
) Ty
    private_fn(i, at)
    sig := sigs[i]
    tn := type_name_of(rt) else ""
    mutable := sig.receiver else
        args_only(args)
        err_help(
            "trait.method.4",
            at,
            "`{n}` is an associated function, not a method",
            "call it as `{tn}.{n}(...)`",
        )
        return Ty.Unknown
    if mutable
        require_mutable(recv, "trait.method.3", "the receiver of a `mut self` method")
    targets[pos_key(at)] = i
    symbols[pos_key(at)] = "method:{tn}.{n}"
    note_deprecated(i, at)
    note_unsafe_call(i, at)
    move_receiver(i, recv)
    if gapped.contains(i) and is_inferred(sig.ret)
        gap("calls a gapped method")
    owner_args := args_of(rt)
    mut binds := List[Bind]()
    match rt
        Struct => binds = zip_binds(sig.generics[..sig.owner], owner_args)
        Enum => binds = zip_binds(sig.generics[..sig.owner], owner_args)
        _ => binds = []
    check_call(n, sig, binds, args, recv, at, expect)

@allow("expr.match.3") fn is_any(t Ty) bool
    match t
        AnyOf => true
        _ => false

fn zip_binds(params List[int], ts List[Ty]) List[Bind]
    [Bind(param: params[k], ty: ts[k]) for k in 0..params.len().min(ts.len())]

## `x.name(...)` where `name` comes from trait `tr`, which `x`'s type implements.
fn Checker.trait_call(
    mut self,
    tr int,
    rt Ty,
    recv ast.Expr,
    n str,
    at ast.Pos,
    args List[ast.Arg],
    expect Ty?,
) Ty
    f := trait_method(tr, n) else return Ty.Unknown
    sig := sigs[f]
    if is_any(rt) and not callable_through_any(tr, f)
        args_only(args)
        err_help(
            "trait.any.4",
            at,
            "`{n}` can't be called on {show(rt)}: its signature uses `Self` other than as the receiver",
            "call it on a value of a concrete type, or use a type parameter `[T {prog.traits[tr].name}]` instead of `any`",
        )
        return Ty.Unknown
    if sig.receiver == true
        require_mutable(recv, "trait.method.3", "the receiver of a `mut self` method")
    trait_calls[pos_key(at)] = tr
    weak_symbols[pos_key(at)] = "method:{prog.traits[tr].name}.{n}"
    if c := con_of(rt)
        if k := impl_of.get(impl_key(tr, c))
            record_impl_target(at, k, tr, n)
    check_call(n, sig, [Bind(param: trait_self[tr], ty: rt)], args, recv, at, expect)

## `x.name(...)` through trait `tr` on a value whose type has `impl` block
## `k` runs that block's method or the trait's default (eff.infer.5).
fn Checker.record_impl_target(mut self, at ast.Pos, k int, tr int, n str)
    for m in prog.impls[k].methods
        if prog.fns[m].name == n
            targets[pos_key(at)] = m
            return
    for m in prog.traits[tr].methods
        if prog.fns[m].name == n and prog.fns[m].body != none
            targets[pos_key(at)] = m
            return

## `Trait.name(x, ...)`: a trait's method called on `x` (trait.res.1).
fn Checker.qualified(mut self, tr int, n str, at ast.Pos, args List[ast.Arg]) Ty
    tname := prog.traits[tr].name
    if trait_method(tr, n) == none
        args_only(args)
        names := [prog.fns[m].name for m in prog.traits[tr].methods]
        mut d := new_diag("expr.name.1", at, "`{tname}` has no method `{n}`")
        if s := suggest(n, names)
            d = d.did_you_mean(n, s)
        diags.push(d)
        return Ty.Unknown
    if args.len() == 0
        err_help(
            "expr.call.1",
            at,
            "`{tname}.{n}` needs the value to call it on as its first argument",
            "write `{tname}.{n}(x, ...)`",
        )
        return Ty.Unknown
    recv := args[0].value
    rt := expr(recv, none, true)
    if reject_unhandled(rt, expr_pos(recv)) or rt == Ty.Unknown
        args_only(args[1..])
        return Ty.Unknown
    if not implements(rt, tr) and rt != Ty.AnyOf(tr)
        args_only(args[1..])
        text := "{show(rt)} doesn't implement `{tname}`"
        if h := how_to_implement(rt, tr)
            err_help("gen.bound.3", expr_pos(recv), text, h)
        else
            err("gen.bound.3", expr_pos(recv), text)
        return Ty.Unknown
    trait_call(tr, rt, recv, n, at, args[1..], none)

## `Type.name(...)` or `Type[int].name(...)`: an associated function
## (trait.method.4), or a variant with data (type.enum.6).
fn Checker.associated(
    mut self,
    d Def,
    explicit List[Bind]?,
    n str,
    at ast.Pos,
    args List[ast.Arg],
    expect Ty?,
) Ty
    tn := def_name(d)
    if e := enum_of_def(d)
        if v := variant_index(e, n)
            symbols[pos_key(at)] = "variant:{tn}.{n}"
            return variant_literal(e, v, explicit, args, at, expect)
    i := method_index(tn, n) else
        if t := impl_assoc_call(d, explicit, n, at, args, expect)
            return t
        args_only(args)
        err("expr.name.1", at, "`{tn}` has no associated function `{n}`")
        return Ty.Unknown
    private_fn(i, at)
    sig := sigs[i]
    if sig.receiver != none
        args_only(args)
        err_help(
            "trait.method.4",
            at,
            "`{n}` is a method, so it's called on a value",
            "call it as `x.{n}(...)` where `x` is a `{tn}`",
        )
        return Ty.Unknown
    mut binds := List[Bind]()
    if b := explicit
        binds = zip_binds(sig.generics[..sig.owner], [x.ty for x in b])
    note_deprecated(i, at)
    note_unsafe_call(i, at)
    targets[pos_key(at)] = i
    symbols[pos_key(at)] = "method:{tn}.{n}"
    if gapped.contains(i) and is_inferred(sig.ret)
        gap("calls a gapped associated function")
    check_call("{tn}.{n}", sig, binds, args, none, at, expect)

fn enum_of_def(d Def) int?
    match d
        DEnum(e) => e
        DStruct => none

## Report a method call on a type without that method.
## `o.m()` on a `proc.Output` (std.proc.9): `text` and `ok`, no arguments.
fn Checker.output_method(mut self, n str, at ast.Pos, args List[ast.Arg]) Ty
    args_only(args)
    names := ["ok", "text"]
    if not names.contains(n)
        mut d := new_diag("std.proc.9", at, "`proc.Output` has no method `{n}`")
        if s := suggest(n, names)
            d = d.did_you_mean_help(s)
        else
            d = d.with_help("a process result's methods are {list_names(names)}")
        diags.push(d)
        return Ty.Unknown
    if args.len() > 0
        err("std.proc.9", at, "`{n}` takes no arguments")
        return Ty.Unknown
    if n == "ok"
        Ty.Bool
    else
        Ty.Str

@allow("expr.match.3") fn Checker.no_method(mut self, rt Ty, n str, at ast.Pos)
    mut names := List[str]()
    if tn := type_name_of(rt)
        for k in methods.keys()
            if k.starts_with("{tn}.")
                names.push(k.slice(tn.len() + 1, k.len()))
    else
        names = builtin_names(rt)
    for t in 0..prog.traits.len()
        if implements(rt, t) or rt == Ty.AnyOf(t)
            for m in prog.traits[t].methods
                names.push(prog.fns[m].name)
    match rt
        Struct(s, _) =>
            for f in prog.structs[s].fields
                if f.name == n
                    err_help(
                        "expr.name.1",
                        at,
                        "`{n}` is a field of {show(rt)}, not a method",
                        "remove the `()`",
                    )
                    return
        _ => names = names
    mut d := new_diag("expr.name.1", at, "{show(rt)} has no method `{n}`")
    # `x.is_some()` on an optional is a comparison with `none` (type.opt.5).
    absent := match n
        "is_some" => " != none"
        "is_none" => " == none"
        _ => ""
    dot := ast.Pos(line: at.line, col: (at.col - 1).max(0))
    kind := kind_of(rt)
    if absent != "" and is_opt(rt)
        d = d.with_help("compare the value with `none`, e.g. `x != none`")
        d = d.with_fix("compare with `none`", [fix.replace(dot, ".{n}()", absent)])
    elif kind == "map" and (n == "items" or n == "entries")
        # type.tuple.5: a map iterates as its `(key, value)` pairs.
        d = d.with_help("a map iterates as its entries: `for k, v in m`")
        d = d.with_fix("drop `.{n}()`", [fix.replace(dot, ".{n}()", "")])
    elif is_error_type(rt) and [
        "message",
        "msg",
        "description",
        "getMessage",
        "get_message",
    ].contains(n)
        # An error's text is `to_str()` (the same text as interpolating it).
        d = d.with_help("an error's message is its text: interpolate `\"\{e}\"` or write `e.to_str()`; the variants' messages are in the `error enum`")
        d = d.with_fix("write `to_str`", [fix.replace(at, n, "to_str")])
    elif new := method_rename(rt, n)
        d = d.with_help("write `.{new}()`").with_fix("write `{new}`", [fix.replace(at, n, new)])
    elif h := method_help(rt, n)
        d = d.with_help(h)
    elif s := suggest(n, names)
        d = d.did_you_mean(n, s)
    else
        match rt
            Param(p) => d = d.with_help("a type parameter has only the methods of its constraints; add one, e.g. `[{tparams[p].name} Trait]`")
            Opt => d = d.with_help("a value that can be `none` has no methods yet: get the value first, `v := x else default` or `v := x else return`")
            _ => d = d.with_help("docs/language-card.md lists the methods each built-in type has; `ail api FILE` lists those of your own types")
    diags.push(d)

## std.use.4: `n.f(...)` where the local `n` hides the standard module `n`,
## which has a function `f`. Reports it and returns true.
fn Checker.hidden_std_module(mut self, recv ast.Expr, n str, at ast.Pos) bool
    x := name_of(recv) else return false
    if local(x) == none or not std_functions(x).contains(n)
        return false
    err_help(
        "std.use.4",
        at,
        "the local `{x}` hides the standard module `std.{x}`, so `{x}.{n}` isn't found",
        "rename the local, or import the module under another name: `use std.{x} as {x}_mod`",
    )
    true

## True when the struct type `t` has a field called `n`.
fn Checker.has_field(self, t Ty, n str) bool
    match t
        Struct(s, _) =>
            for f in prog.structs[s].fields
                if f.name == n
                    return true
            false
        _ => false

@allow("expr.match.3") fn Checker.field(mut self, recv ast.Expr, n str, at ast.Pos, expect Ty?) Ty
    mut head := ""
    mut targs := List[ast.TypeRef]()
    mut has_targs := false
    match recv
        Name(x, _) =>
            if local(x) == none
                head = x
        TypeArgs(x, a, _) =>
            head = x
            targs = a
            has_targs = true
        _ => head = ""
    # std.ui.17: `ui.RED`.
    if head != "" and not has_targs and std_module(head) == "ui"
        return ui_color(head, n, at)
    # `Enum.Variant` and `Enum[int].Variant` (type.enum.3).
    if head != ""
        if d := types.get(head)
            match d
                DEnum(e) =>
                    if v := variant_index(e, n)
                        symbols[pos_key(at)] = "variant:{head}.{n}"
                        fields := prog.enums[e].variants[v].fields
                        if fields.len() > 0
                            shown := ["{f.name}: ..." for f in fields]
                            err_help(
                                "type.enum.6",
                                at,
                                "the variant `{n}` carries data",
                                "build it with `{head}.{n}({shown.join(", ")})`",
                            )
                            return Ty.Unknown
                        mut explicit := no_tys()
                        if has_targs
                            explicit = [b.ty for b in explicit_args(
                                head,
                                enum_params[e],
                                targs,
                                at,
                            )]
                        return enum_value(e, explicit, expect, at, n)
                    names := [x.name for x in prog.enums[e].variants]
                    mut diag := new_diag("expr.name.1", at, "`{head}` has no variant `{n}`")
                    if s := suggest(n, names)
                        diag = diag.did_you_mean(n, s)
                    diags.push(diag)
                DStruct => err(
                    "type.struct.6",
                    at,
                    "`{head}` is a type; fields are read from values",
                )
            return Ty.Unknown
    rt0 := expr(recv, none, true)
    if reject_unhandled(rt0, expr_pos(recv)) or rt0 == Ty.Unknown
        return Ty.Unknown
    mut rt := rt0
    match rt0
        RefOf(t) => rt = t
        _ => rt = rt0
    # trait.method.7: a method is only reached through a call, so in value
    # position a field of the same name wins.
    if candidates(rt, n).len() > 0 and not self.has_field(rt, n)
        diags.push(
            new_diag("expr.op.3", at, "`{n}` is a method, so calling it needs `()`")
                .with_help("write `.{n}()`")
                .with_fix("add the parentheses", [fix.replace(at, n, "{n}()")]),
        )
        return Ty.Unknown
    if is_tensor(rt)
        err_help(
            "std.tensor.1",
            at,
            "a tensor has no field `{n}`; its elements live in the runtime",
            "read it with a method: {list_names(TENSOR_METHODS)}",
        )
        return Ty.Unknown
    if t := tuple_field(rt, n, at)
        return t
    match rt
        Struct(s, args) =>
            decl := prog.structs[s]
            for i in 0..decl.fields.len()
                if decl.fields[i].name == n
                    private_field(s, i, at)
                    symbols[pos_key(at)] = "field:{decl.name}.{n}"
                    return subst(field_types[s][i], binds_of(struct_params[s], args))
            names := [f.name for f in decl.fields]
            mut d := new_diag("type.struct.6", at, "`{decl.name}` has no field `{n}`")
            # Another library's field for the same thing (a `requests` response).
            other := match "{decl.name}.{n}"
                "net.Response.status_code" => "status"
                "net.Response.text" => "body"
                _ => ""
            if other != ""
                d = d
                    .with_help("`{decl.name}` has the field `{other}`")
                    .with_fix("write `{other}`", [fix.replace(at, n, other)])
            elif s2 := suggest(n, names)
                d = d.did_you_mean(n, s2)
            elif names.len() == 0
                d = d.with_help("`{decl.name}` has no fields")
            else
                d = d.with_help("`{decl.name}` has the fields {list_names(names)}")
            diags.push(d)
            Ty.Unknown
        _ =>
            mut d := new_diag("type.struct.6", at, "{show(rt)} has no fields")
            if new := method_rename(rt, n)
                d = d.with_help("`{n}` isn't a field; write the method `.{new}()`")
                d = d.with_fix("write `{new}()`", [fix.replace(at, n, "{new}()")])
            else
                d = d.with_help("only structs have fields; the built-in types have methods, written with `()`")
            diags.push(d)
            Ty.Unknown

@allow("expr.match.3") fn map_key(t Ty) Ty
    match t
        MapOf(k, _) => k
        _ => Ty.Unknown

@allow("expr.match.3") fn map_value(t Ty) Ty
    match t
        MapOf(_, v) => v
        _ => Ty.Unknown

@allow("expr.match.3") fn is_negative_literal(e ast.Expr) bool
    match e
        Unary(op, operand, _) => op == ast.UnOp.Neg and is_int_literal(operand)
        _ => false

## `xs[i]` and `xs[a..b]` (type.coll.4, type.str.2).
@allow("expr.match.3") fn Checker.index_expr(mut self, recv ast.Expr, index ast.Expr) Ty
    rt := expr(recv, none, true)
    if reject_unhandled(rt, expr_pos(recv))
        return Ty.Unknown
    # std.tensor.15: `t[i]` and `t[lo..hi]` are tensors. The rank falls by one
    # for `t[i]` at run time, so the type stays `tensor.Tensor[T]`.
    if tensor_elem(rt) != none
        match index
            Range(lo, hi, _, _) => range_bounds(lo, hi)
            _ =>
                it := expr(index, Ty.Int, true)
                if not accepts(Ty.Int, it)
                    err_help(
                        "std.tensor.15",
                        expr_pos(index),
                        "a tensor index must be `int`, found {show(it)}",
                        "index with an `int`, or slice with `lo..hi`",
                    )
        return rt
    if ge := grid_elem(rt)
        return grid_index(index, ge)
    # `m[k]` (type.map.3).
    if is_map_ty(rt)
        if is_range(index)
            err("type.map.3", expr_pos(index), "a map can't be sliced")
            return Ty.Unknown
        k := map_key(rt)
        kt := expr(index, k, true)
        if not accepts(k, kt)
            mismatch("type.map.3", expr_pos(index), k, kt)
        return map_value(rt)
    # type.coll.4: indexes start at 0; there are no negative indexes.
    mut bad := List[ast.Pos]()
    match index
        Range(lo, hi, _, _) =>
            for b in [lo, hi]
                if x := b
                    if is_negative_literal(x) and bad.len() == 0
                        bad.push(expr_pos(x))
        _ =>
            if is_negative_literal(index)
                bad.push(expr_pos(index))
    if bad.len() > 0
        mut d := new_diag(
            "type.coll.4",
            bad[0],
            "a list has no negative indexes",
        ).with_help("count from the end with `xs.len()`: `xs[xs.len() - 1]`, or `xs.last()`")
        match recv
            Name(rn, _) => d = d.with_fix("count from the end", [fix.replace(
                bad[0],
                "-",
                "{rn}.len() - ",
            )])
            _ => d = d
        diags.push(d)
    slice := is_range(index)
    match index
        Range(lo, hi, _, _) => range_bounds(lo, hi)
        _ =>
            it := expr(index, Ty.Int, true)
            if not accepts(Ty.Int, it)
                if rt == Ty.Bytes
                    err(
                        "type.bytes.3",
                        expr_pos(index),
                        "a `bytes` index must be `int`, found {show(it)}",
                    )
                else
                    err(
                        "type.coll.4",
                        expr_pos(index),
                        "a list index must be `int`, found {show(it)}",
                    )
    match rt
        ListOf(t) => if slice then rt else t
        # type.bytes.3-4: an element is a `u8`; a slice is `bytes`.
        Bytes => if slice then rt else Ty.Num("u8")
        Unknown => Ty.Unknown
        Str =>
            mut d := new_diag(
                "type.str.2",
                expr_pos(recv),
                "a `str` can't be indexed",
            ).with_help("index its characters: `s.chars()[i]`, or `s.chars()[a..b].join(\"\")` for a part")
            match recv
                Name(rn, _) =>
                    tail := if slice then ".join(\"\")" else ""
                    d = d.with_fix("index the characters", [fix.call_with(
                        expr_pos(recv),
                        rn,
                        "{rn}.chars()[$1]{tail}",
                    )])
                _ => d = d
            diags.push(d)
            Ty.Unknown
        _ =>
            err("type.coll.4", expr_pos(recv), "only lists and maps can be indexed, not {show(rt)}")
            Ty.Unknown

## ---- Testing (testing.rs) ----

## test.attr.3: a test is run by `ail test`, never called.
fn Checker.reject_test_call(mut self, i int, at ast.Pos)
    f := prog.fns[i]
    if has_attr(f, "test")
        err_help(
            "test.attr.3",
            at,
            "`{f.name}` is a test and can't be called",
            "move shared code into an ordinary function that the test calls",
        )

## `assert(cond)`, `assert(cond, "message")`, `assert_eq(a, b)`, `assert_err(call)`,
## `assert_err(call, Variant)` and `assert_near(a, b, eps)` (test.assert.1-3).
fn Checker.assert_call(mut self, n str, args List[ast.Arg], at ast.Pos) Ty
    for a in args
        if l := a.label
            unsupported(l.pos, "named arguments are not supported by the bootstrap yet (ADR 0058)")
        if a.mutable
            err_help(
                "own.param.2",
                expr_pos(a.value),
                "`{n}`'s parameters aren't `mut`",
                "remove the `mut`",
            )
    lo := assert_arity(n)
    hi := if n == "assert" or n == "assert_err" then 2 else lo
    if args.len() < lo or args.len() > hi
        args_only(args)
        want := if hi == lo then "{lo}" else "{lo} or {hi}"
        err("test.assert.2", at, "`{n}` takes {want} argument(s), but {was_were(args.len())} given")
        return Ty.Unit
    if n == "assert"
        v := args[0].value
        t := expr(v, Ty.Bool, true)
        if t != Ty.Unknown and t != Ty.Never and not reject_unhandled(
            t,
            expr_pos(v),
        ) and not accepts(Ty.Bool, t)
            err("test.assert.2", expr_pos(v), "`assert` needs a `bool`, found {show(t)}")
        if args.len() == 2
            mv := args[1].value
            mt := expr(mv, Ty.Str, true)
            if mt != Ty.Unknown and mt != Ty.Never and not accepts(Ty.Str, mt)
                err_help(
                    "test.assert.2",
                    expr_pos(mv),
                    "the message of `assert` is a `str`, found {show(mt)}",
                    "write the message as text, e.g. `assert(ok, \"why it should hold\")`",
                )
    elif n == "assert_err"
        v := args[0].value
        t := expr(v, none, true)
        mut errs := List[Ty]()
        match t
            Res(_, es) => errs = errs_of(es)
            _ => errs = []
        if not is_res(t) and t != Ty.Unknown and t != Ty.Never
            err_help(
                "test.assert.3",
                expr_pos(v),
                "`assert_err` needs a call that can fail, found `{show(t)}`",
                "pass a call whose return type is `T ! E`; to compare plain values use `assert_eq`",
            )
        if args.len() == 2
            hint := if errs.len() == 1 then errs[0] else Ty.Unknown
            mut st := Ty.Unknown
            if b := bare_variant_ty(args[1].value)
                # `assert_err(call, E.V)` for a variant with data checks the kind alone (test.assert.3).
                st = b
            else
                st = expr(args[1].value, if hint == Ty.Unknown then none else hint, true)
            if is_res(t)
                and st != Ty.Unknown
                and st != Ty.Never
                and errs.len() > 0
                and not errs.contains(st)
                err_help(
                    "test.assert.3",
                    expr_pos(args[1].value),
                    "this call can't fail with `{show(st)}`",
                    "name one of the errors the call declares",
                )
    elif n == "assert_near"
        for a in args
            t := expr(a.value, Ty.Float, true)
            if t != Ty.Unknown and t != Ty.Never and not accepts(Ty.Float, t)
                err_help(
                    "test.assert.2",
                    expr_pos(a.value),
                    "`assert_near` compares `float` values, found {show(t)}",
                    "convert with `.to_float()`",
                )
    else
        lt := expr(args[0].value, none, true)
        rt := expr(args[1].value, lt, true)
        operator(ast.BinOp.Eq, lt, rt, at)
        text_form(lt, expr_pos(args[0].value), "test.assert.2")
    Ty.Unit

## `E.V` where `V` is a variant of the non-generic enum `E` that carries data:
## the enum's type, so `assert_err(call, E.V)` can name the kind alone.
@allow("expr.match.3")
fn Checker.bare_variant_ty(self, e ast.Expr) Ty?
    match e
        Member(recv, n, _) =>
            match recv
                Name(head, _) =>
                    d := types.get(head)?
                    match d
                        DEnum(i) =>
                            v := variant_index(i, n)?
                            if prog.enums[i].variants[v].fields.len() > 0 and enum_params[i].len() == 0
                                return Ty.Enum(i, [])
                            none
                        _ => none
                _ => none
        _ => none

fn assert_arity(n str) int
    match n
        "assert_eq" => 2
        "assert_near" => 3
        _ => 1

## gram.attr.4: using a function marked `@deprecated("why")` warns.
fn Checker.note_deprecated(mut self, i int, at ast.Pos)
    f := prog.fns[i]
    for a in f.attrs
        if a.name == "deprecated"
            if why := a.arg
                mut d := new_diag("gram.attr.4", at, "`{f.name}` is deprecated: {why}")
                d.warning = true
                diags.push(d)
            return

## ---- Privacy (privacy.rs) ----

## `x.f` on a private field of a struct from another module (mod.vis.1).
fn Checker.private_field(mut self, s int, i int, at ast.Pos)
    decl := prog.structs[s]
    f := decl.fields[i]
    if hidden(prog, f.pos, at)
        err_help(
            "mod.vis.1",
            at,
            "field `{f.name}` of `{decl.name}` is private to its module",
            "mark the field `pub {f.name} ...` to use it here",
        )

## `T(...)` for a struct from another module with a private field.
fn Checker.private_literal(mut self, s int, at ast.Pos)
    decl := prog.structs[s]
    for f in decl.fields
        if hidden(prog, f.pos, at)
            err_help(
                "mod.vis.1",
                at,
                "`{decl.name}` can't be built here: its field `{f.name}` is private to its module",
                "call a `pub` function of its module that builds it",
            )
            return

## A call of a private method or associated function of another module.
fn Checker.private_fn(mut self, i int, at ast.Pos)
    f := prog.fns[i]
    if f.within == ast.Within.TopLevel and hidden(prog, f.pos, at)
        full := full_name(f)
        # As written in its own module: `Account.audit`, not `lib.Account.audit`.
        module := module_at(prog, f.pos)
        local := if full.starts_with("{module}.")
            and module != "" then full.chars()[module.len() + 1..].join("") else full
        err_help(
            "mod.vis.1",
            at,
            "`{full}` is private to its module",
            "mark it `pub fn {local}` to use it here",
        )

## ---- Comprehensions (comprehension.rs) ----

@allow("expr.match.3")
fn Checker.comprehension(
    mut self,
    form ast.CompKind,
    elem ast.Expr,
    value ast.Expr?,
    clauses List[ast.CompFor],
    expect Ty?,
) Ty
    want := opt_inner(expect else Ty.Unknown)
    mut hint := none
    mut vhint := none
    match form
        ListComp =>
            match want
                ListOf(t) => hint = t
                _ => hint = none
        SetComp =>
            match want
                SetOf(t) => hint = t
                _ => hint = none
        MapComp =>
            match want
                MapOf(k, v) =>
                    hint = k
                    vhint = v
                _ => hint = none
    # conc.par.12: `par for` is the only clause of a list comprehension.
    for c in clauses
        if c.is_par
            if form != ast.CompKind.ListComp or clauses.len() > 1
                err_help(
                    "conc.par.12",
                    c.var_pos,
                    "`par for` computes the elements of a list comprehension with one `for`",
                    "use one `par for` clause in a `[...]` comprehension, or drop `par`",
                )
            break
    mark := locals.len()
    # expr.comp.4: `continue` skips an element and `break` ends the comprehension.
    loop_depth += 1
    for c in clauses
        unpack := c.unpack.len() > 0
        t := iterable(c.iter, unpack)
        if unpack
            # type.tuple.5: `for a, b in xs` binds the parts.
            locals.push(Local(
                name: c.var,
                ty: t,
                mutable: false,
                how: LocalKind.LoopVar,
                decl: none,
            ))
            unpack_clause(c.unpack, t, c.var_pos)
        elif declare(c.var, c.var_pos)
            locals.push(Local(
                name: c.var,
                ty: t,
                mutable: false,
                how: LocalKind.LoopVar,
                decl: none,
            ))
        if cond := c.cond
            condition(cond)
    t := comp_part(elem, hint)
    mut vt := Ty.Unknown
    if v := value
        vt = comp_part(v, vhint)
    loop_depth -= 1
    end_scope(mark)
    if form != ast.CompKind.ListComp and not has_unknown(t) and t != Ty.Never
        require_key(t, expr_pos(elem))
    match form
        ListComp => Ty.ListOf(t)
        SetComp => Ty.SetOf(t)
        MapComp => Ty.MapOf(key: t, value: vt)

## The element (or key, or value) of a comprehension (expr.comp.3).
fn Checker.comp_part(mut self, e ast.Expr, hint Ty?) Ty
    mut h := none
    if x := hint
        if not has_unknown(x)
            h = x
    t := expr(e, h, true)
    if reject_unhandled(t, expr_pos(e))
        return Ty.Unknown
    if t == Ty.Unit
        err("expr.comp.3", expr_pos(e), "a comprehension's element must be a value")
        return Ty.Unknown
    w := h else return t
    if not accepts(w, t)
        err("expr.comp.3", expr_pos(e), "the elements here are {show(w)}, but this is {show(t)}")
    w

## `f` when `e` is a call `f(...)` of a declared function.
@allow("expr.match.3") fn Checker.called_fn(self, e ast.Expr) str?
    match e
        Call(callee, _, _) =>
            match callee
                Name(f, _) =>
                    if fns.contains(f)
                        return f
                _ => return none
        _ => return none
    none

@allow("expr.match.3") fn is_plain_name(e ast.Expr) bool
    match e
        Name => true
        _ => false
