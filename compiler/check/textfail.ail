## The standard text failure `Fail` (err.fail.1-3, ADR 1140): the prelude's
## `error struct Fail "{msg}"`, what `! str` meant as "no result, fails with
## text" is rewritten to (err.str.4), and the helps that name it.
use ast
use fix

## What err.str.4's certain fix needs (ADR 1140).
pub struct TextFail
    ## The `return`s of the function being checked, while it is declared `! str`.
    pub returns List[TextReturn]
    ## The functions err.str.4 reports, by index: where, and the fix's edits
    ## when the function's own body allows one.
    pub fns Map[int, TextFn]
    ## Those whose calls use the `str` result (`x := f() else ...`, `f()?` in an
    ## expression): the rewrite would break those calls, so no certain fix.
    pub used Set[int]
    ## The `?`s that are statements of their own, whose value nothing uses, by `pos_key`.
    pub stmt_tries Set[int]
    ## The `?`s that end a function err.str.4 reports (or a branch in its tail): the function has no
    ## result, so they use none, if that function is itself rewritten (`attach_text_fixes`).
    pub tail_tries Set[int]
    ## The functions declared `str ! str` (err.str.2): their `?`s don't report err.prop.1 as well,
    ## since the signature is the one mistake.
    pub str_str Set[int]
    ## Where each of those declares its second `str`, by function index (ADR 1163's certain fix).
    pub str_at Map[int, ast.Pos]
    ## The functions declared `!` with no result that `return` a text (ADR 1163).
    pub bare Set[int]
    ## Where an `if` branch or `match` arm gave no value (expr.if.4), by `pos_key` of its last statement.
    pub novalue Set[int]
    ## Every `?` on a call of a `! str` function: the callee, the function it is in, and where.
    pub try_uses List[TryUse]
    ## Statement `else`s on calls of `! str` functions, whichever order the functions come in:
    ## their err.else.4 goes when the callee turns out to be err.str.4's.
    pub handlers List[TextHandler]

pub fn new_text_fail() TextFail
    TextFail(
        returns: [],
        fns: Map[int, TextFn](),
        used: Set[int](),
        stmt_tries: Set[int](),
        tail_tries: Set[int](),
        str_str: Set[int](),
        str_at: Map[int, ast.Pos](),
        bare: Set[int](),
        novalue: Set[int](),
        try_uses: [],
        handlers: [],
    )

pub struct TryUse
    pub callee int
    pub caller int
    pub at int

## A statement `f() else ...` on a call of `! str` function `callee`, at `at`.
pub struct TextHandler
    pub callee int
    pub at ast.Pos

## A `return` with its value's start, and whether the value is a `str` that
## `fix.after_expr` can find the end of.
pub struct TextReturn
    pub at ast.Pos
    pub text bool
    ## How `str ! str`'s fix reads it (`return_kind`): 1 failure, 2 result kept, 0 neither.
    pub kind int

pub struct TextFn
    pub at ast.Pos
    pub edits List[fix.Edit]?
    ## For a body recognised by its tail `if`/`match` (`tail_try_shape`): the callees of its tail `?`s,
    ## and the expr.if.4 / expr.block.2 reports dropped for it, which come back if a callee isn't err.str.4's.
    pub shaped bool
    pub tails List[int]
    pub dropped List[Diag]

## Record `return v` of the function itself (not of a function literal or a
## local function) while it is declared `! str`.
fn Checker.note_text_return(mut self, v ast.Expr, t Ty)
    if fn_lits.floor >= 0
        return
    mut known := self.is_bare_str_result(fn_ret) or self.is_bare_unit_result(fn_ret)
    if text_fail.str_str.contains(cur_fn)
        known = true
    if not known
        return
    w := t == Ty.Str and wrappable(v)
    k := if w then return_kind(v) else 0
    text_fail.returns.push(TextReturn(at: ast.expr_start(v), text: w, kind: k))

## How the certain fix of `str ! str` reads a returned text (ADR 1163): 1 a failure, a literal
## that starts with an error word (`"syntax"`, `"unknown {name}"`, `"overflow"`); 2 a result, kept as
## written: `""`, or an interpolation that starts with a shown value (`"{v}"`); 0 neither.
@allow("expr.match.3") fn return_kind(e ast.Expr) int
    match e
        Str(v, _) =>
            if v == ""
                return 2
            return word_kind(v)
        Interp(parts, _) =>
            if parts.len() == 0
                return 0
            match parts[0]
                Lit(t) => return word_kind(t)
                _ => return 2
        _ => 0
    0

fn word_kind(t str) int
    mut w := ""
    for c in t.chars()
        if not c.is_alpha()
            break
        w = "{w}{c.to_lower()}"
    first := ["error", "invalid", "unknown", "syntax", "overflow", "divide", "division"]
    second := ["undefined", "bad", "failed", "fail", "missing", "expected", "unexpected", "illegal"]
    if first.contains(w) or second.contains(w) or w == "cannot" or w == "not"
        return 1
    0

## Whether `fix.after_expr` finds the end of `e`, which it scans on one line up
## to a space outside brackets and strings: a string (its interpolations may hold
## strings, `else` and `if`), a name, a call, a method call, a field or an index,
## with no character literal.
@allow("expr.match.3") fn wrappable(e ast.Expr) bool
    match e
        Str => true
        Interp => quote_safe(e, false)
        Name => true
        Call => quote_safe(e, false)
        Method => quote_safe(e, false)
        Member => quote_safe(e, false)
        Index => quote_safe(e, false)
        _ => false

## `in_text`: `e` is inside a string's interpolation, which the scan skips as part of the string.
@allow("expr.match.3") fn quote_safe(e ast.Expr, in_text bool) bool
    if is_char(e) or (not in_text and has_spaces(e))
        return false
    inner := in_text or is_interp(e)
    for c in children(e)
        match c
            NExpr(x) =>
                if not quote_safe(x, inner)
                    return false
            NBlock => return false
    true

@allow("expr.match.3") fn is_char(e ast.Expr) bool
    match e
        Char => true
        _ => false

## Forms written with spaces the scan would stop at, outside a string.
@allow("expr.match.3") fn has_spaces(e ast.Expr) bool
    match e
        If => true
        Match => true
        Closure => true
        OrElse => true
        _ => false

@allow("expr.match.3") fn is_interp(e ast.Expr) bool
    match e
        Interp => true
        _ => false

## `! str`: a `str` result with errors inferred for this function (err.str.4).
@allow("expr.match.3") fn Checker.is_bare_str_result(self, t Ty) bool
    match t
        Res(ok, errs) =>
            if ok != Ty.Str
                return false
            match errs
                Inferred(j) => j == cur_fn
                _ => false
        _ => false

## Whether `t` is the prelude's `Fail` (err.fail.1), not a type the program declares.
@allow("expr.match.3") fn Checker.is_std_fail(self, t Ty) bool
    match t
        Struct(s, _) => prog.structs[s].name == "Fail" and is_prelude_line(prog.structs[s].pos.line)
        _ => false

## Whether the error set `want` holds the prelude's `Fail`.
@allow("expr.match.3") fn Checker.fails_with_fail(self, want Errs) bool
    match want
        ErrSet(v) =>
            for t in v
                if self.is_std_fail(t)
                    return true
            false
        _ => false

## err.prop.6: whether `want` is the return type of a function that fails with
## text, `T ! str` or one whose errors include the standard `Fail`, so `?` on
## an absent optional fails with a text. A function literal and a local
## function keep err.prop.2: the rule reads the enclosing declaration.
@allow("expr.match.3") fn Checker.fails_with_text(self, want Ty) bool
    if fn_lits.floor >= 0
        return false
    match want
        Res(_, errs) =>
            match errs
                ErrSet(v) => (v.len() == 1 and v[0] == Ty.Str) or self.fails_with_fail(errs)
                _ => false
        _ => false

## err.fail.3: the help of err.prop.3 in a function that fails with `Fail`:
## the other error becomes a `Fail` with its text, written out.
fn fail_prop_help(other str) str
    "handle it and fail with its text: `v := ... else e`, then `return Fail(msg: \"\{e}\")`; or {other}"

## Whether the program declares a type `Fail` of its own (so `Fail` is not the
## standard one).
fn Checker.own_fail(self) bool
    d := types.get("Fail") else return false
    not is_prelude_line(def_pos(d).line)

## err.fail.1: the prelude's types yield to a bare variant of the expected enum,
## so `Fail(err)` still builds a user's `Value.Fail` where a `Value` is expected,
## as the native lowering resolves it.
fn Checker.prelude_type_yields(self, d Def, n str, expect Ty?) VariantRef?
    if not is_prelude_line(def_pos(d).line)
        return none
    mut found := List[VariantRef]()
    for e in self.expected_enums(expect)
        if v := self.variant_index(e, n)
            found.push(VariantRef(enum_index: e, variant: v))
    if found.len() == 1 then found[0] else none

## The `T` of a result type `T ! ...` as written.
@allow("expr.match.3") fn declared_ok(t ast.TypeRef) ast.TypeRef?
    match t.shape
        Fallible(ok, _) => ok
        _ => none

## err.str.4's certain fix as far as the function's own body decides it: `! str`
## becomes `! Fail` and each `return TEXT` of the function becomes
## `return Fail(msg: TEXT)`, when every `return` with a value gives a `str`, the
## body doesn't end in a `str`, and `Fail` is the standard one; else none.
## `attach_text_fixes` checks the calls and the inferred errors.
fn Checker.no_result_fix(self, declared ast.TypeRef, got Ty) List[fix.Edit]?
    if got == Ty.Str or self.own_fail()
        return none
    ok := declared_ok(declared) else return none
    mut edits := [fix.replace(ok.pos, "str", "Fail")]
    for r in text_fail.returns
        if not r.text or r.at.line == 0
            return none
        edits.push(fix.insert(r.at, "Fail(msg: "))
        edits.push(fix.after_expr(r.at, ")"))
    edits

## The function a call of type `t` calls, when `t` is the result of a declared `! str`
## function (`Res(str, Inferred(j))`, `j` a function of the program), whether or not
## that function has been checked yet.
@allow("expr.match.3") fn Checker.str_callee(self, t Ty) int?
    match t
        Res(ok, errs) =>
            if ok != Ty.Str
                return none
            match errs
                Inferred(j) => if j >= 0 and j < prog.fns.len() then j else none
                _ => none
        _ => none

## A call of a `! str` function whose `str` result is used: no certain fix for it.
fn Checker.note_text_use(mut self, t Ty)
    if j := self.str_callee(t)
        text_fail.used.add(j)

## A statement `f() else ...` on a call of `! str` function `j`. A handler that
## reads its error outside a string interpolation (`return e`, `errs.push(e)`)
## uses it as a `str`, which breaks once it is a `Fail`.
fn Checker.note_text_handler(mut self, j int, value ast.Expr, o ast.Else)
    text_fail.handlers.push(TextHandler(callee: j, at: expr_pos(value)))
    match o
        Handler(name, body, _) =>
            if nm := name
                if block_reads_bare(body, nm.name)
                    text_fail.used.add(j)
        _ => 0

## Whether `b` reads the local `n` anywhere but as a whole `{n}` of a string interpolation.
fn block_reads_bare(b List[ast.Stmt], n str) bool
    for st in b
        if stmt_reads_bare(st, n)
            return true
    false

@allow("expr.match.3") fn stmt_reads_bare(st ast.Stmt, n str) bool
    match st
        Eval(x) => expr_reads_bare(x, n)
        Let(_, _, _, x, o) => expr_reads_bare(x, n) or else_reads_bare(o, n)
        Assign(t, _, x, _) => expr_reads_bare(t, n) or expr_reads_bare(x, n)
        While(c, inner, _) => expr_reads_bare(c, n) or block_reads_bare(inner, n)
        For(_, _, _, _, it, inner, _) => expr_reads_bare(it, n) or block_reads_bare(inner, n)
        Return(v, _) =>
            x := v else return false
            expr_reads_bare(x, n)
        Handle(x, o) => expr_reads_bare(x, n) or else_reads_bare(o, n)
        Defer(inner, _) => stmt_reads_bare(inner, n)
        With(m, _, _, inner, _) => expr_reads_bare(m, n) or block_reads_bare(inner, n)
        Unsafe(inner, _) => block_reads_bare(inner, n)
        LetTuple(_, x, _) => expr_reads_bare(x, n)
        LocalFn(d) => block_reads_bare(d.body else [], n)
        Break => false
        Continue => false
        _ => true

fn else_reads_bare(o ast.Else?, n str) bool
    x := o else return false
    match x
        Fallback(v) => expr_reads_bare(v, n)
        Leave(st) => stmt_reads_bare(st, n)
        Handler(_, inner, _) => block_reads_bare(inner, n)

@allow("expr.match.3") fn expr_reads_bare(e ast.Expr, n str) bool
    if x := name_of(e)
        return x == n
    whole_parts := is_interp(e)
    for c in children(e)
        match c
            NExpr(x) =>
                # `{e}` in a string displays the error, which a `Fail` does as its text.
                if whole_parts and (name_of(x) else "") == n
                    continue
                if expr_reads_bare(x, n)
                    return true
            NBlock(inner) =>
                if block_reads_bare(inner, n)
                    return true
    false

## `f()?` as a statement that gives no value uses no result: after err.str.4's
## rewrite it still checks.
@allow("expr.match.3") fn Checker.note_stmt_try(mut self, e ast.Expr, need bool)
    if need
        return
    match e
        Try(_, _, at) => text_fail.stmt_tries.add(pos_key(at))
        _ => 0

## `?` on a call of a function of err.str.4, at `at`.
fn Checker.note_try_use(mut self, t Ty, at ast.Pos)
    if text_fail.stmt_tries.contains(pos_key(at))
        return
    if j := self.str_callee(t)
        text_fail.try_uses.push(TryUse(callee: j, caller: cur_fn, at: pos_key(at)))

## The `?`s that end `body`, or a branch of an `if` or `match` that does.
@allow("expr.match.3") fn Checker.note_tail_tries(mut self, body List[ast.Stmt])
    x := last_value(body) else return
    match x
        Try(_, _, at) => text_fail.tail_tries.add(pos_key(at))
        If(branches, els, _, _) =>
            for br in branches
                self.note_tail_tries(br.body)
            if b := els
                self.note_tail_tries(b)
        Match(_, arms, _) =>
            for a in arms
                self.note_tail_tries(a.body)
        _ => 0

## The functions err.str.4's fix applies to: those no call uses the `str` result of. A `?` that ends a caller's body (the caller has
## no result) uses none when the caller is rewritten too, so those callers' `?`s are taken out first;
## a caller withheld because a call uses it takes its tail `?`s back into use.
fn Checker.settle_try_uses(self, as_values Set[int]) Set[int]
    mut rewritten := Set[int]()
    for j in text_fail.fns.keys()
        if text_fail.fns[j].edits != none and not as_values.contains(j) and self.text_errors_only(j)
            rewritten.add(j)
    while true
        mut used := Set[int]()
        for j in text_fail.used
            used.add(j)
        for u in text_fail.try_uses
            if not (text_fail.tail_tries.contains(u.at) and rewritten.contains(u.caller))
                used.add(u.callee)
        mut next := Set[int]()
        for j in rewritten
            if used.contains(j)
                continue
            # A body recognised by its tail `?`s is rewritten only with every one of those callees.
            mut tails_ok := true
            for c in text_fail.fns[j].tails
                if not rewritten.contains(c)
                    tails_ok = false
            if tails_ok
                next.add(j)
        if next.len() == rewritten.len()
            return rewritten
        rewritten = next
    rewritten

## After every body is checked (so the order of the functions doesn't matter):
## the err.else.4 of statement `else`s on calls of err.str.4's functions goes (one
## mistake, one error), and err.str.4's certain fix is attached to each function
## whose body allows it, whose only inferred errors are text or `Fail` (`?` turns
## text into a `Fail`, err.fail.3), and whose calls don't use its `str` result
## and that isn't used as a function value.
fn Checker.attach_text_fixes(mut self)
    if text_fail.fns.len() == 0
        return
    self.revert_shaped()
    mut gone := Set[int]()
    for h in text_fail.handlers
        if text_fail.fns.contains(h.callee)
            gone.add(pos_key(h.at))
    if gone.len() > 0
        diags = [d for d in diags if d.rule != "err.else.4" or not gone.contains(pos_key(d.pos))]
    mut as_values := Set[int]()
    for k in fn_values.keys()
        as_values.add(fn_values[k])
    rewritten := self.settle_try_uses(as_values)
    for j in text_fail.fns.keys()
        if not rewritten.contains(j)
            continue
        tf := text_fail.fns[j]
        edits := tf.edits else continue
        for k in 0..diags.len()
            if diags[k].rule == "err.str.4" and diags[k].pos == tf.at
                diags[k] = diags[k].with_sure_fix("fail with the standard `Fail`", edits)

## A function recognised by its tail `?`s (`tail_try_shape`) whose callee isn't err.str.4's has a result
## after all: its err.str.4 goes and the expr.if.4 reports dropped for it come back. Repeated, as one
## reversal can leave another function's callee without err.str.4.
fn Checker.revert_shaped(mut self)
    while true
        mut bad := List[int]()
        for j in text_fail.fns.keys()
            tf := text_fail.fns[j]
            if not tf.shaped
                continue
            for c in tf.tails
                if not text_fail.fns.contains(c)
                    bad.push(j)
                    break
        if bad.len() == 0
            return
        for j in bad
            tf := text_fail.fns[j]
            diags = [d for d in diags if not (d.rule == "err.str.4" and d.pos == tf.at)]
            diags.extend(tf.dropped)
            text_fail.fns.remove(j)

## Whether every error inferred for function `j` is text or the standard `Fail`.
fn Checker.text_errors_only(self, j int) bool
    if j < 0 or j >= inferred.len()
        return false
    for t in inferred[j]
        if t != Ty.Str and not self.is_std_fail(t)
            return false
    true

## err.str.2's certain fix (ADR 1163), decided from the function's own body: in `str ! str` the
## last expression is the result and each `return` of a text literal is the failure, as in
## `T ! str` (err.str.1), so the second `str` becomes `Fail` and each such `return TEXT`
## `return Fail(msg: TEXT)`. None when the body ends in anything but a `str` value, has a
## bare `return`, returns anything but a non-empty literal or interpolation, or the
## program declares its own `Fail`.
@allow("expr.match.3") fn Checker.attach_str_str_fix(mut self, idx int, body List[ast.Stmt], got Ty)
    at := text_fail.str_at.get(idx) else return
    if got != Ty.Str or self.own_fail() or has_bare_return(body)
        return
    tail := body.last() else return
    match tail
        Eval => 0
        _ => return
    mut edits := [fix.replace(at, "str", "Fail")]
    for r in text_fail.returns
        if r.kind == 0 or r.at.line == 0
            return
        if r.kind == 1
            edits.push(fix.insert(r.at, "Fail(msg: "))
            edits.push(fix.after_expr(r.at, ")"))
    for k in 0..diags.len()
        if diags[k].rule == "err.str.2" and diags[k].pos == at and diags[k].fixes.len() == 0
            diags[k] = diags[k].with_sure_fix("fail with the standard `Fail`", edits)

## `!` with no result and no error type (`fn f(...) !`): a function with no result.
@allow("expr.match.3") fn Checker.is_bare_unit_result(self, t Ty) bool
    match t
        Res(ok, errs) =>
            if ok != Ty.Unit
                return false
            match errs
                Inferred(j) => j == cur_fn
                _ => false
        _ => false

## err.str.4 for a function declared `!` whose body has `return TEXT` (ADR 1163): the text has
## no error type to fail with. Reported once at the signature, with the same certain fix as
## `! str` with no result: `! Fail` and `return Fail(msg: TEXT)` for each (`attach_text_fixes`
## checks the errors the function infers).
@allow("expr.match.3") fn Checker.bare_text_fail(mut self, f ast.FnDecl)
    if not text_fail.bare.contains(cur_fn)
        return
    declared := f.ret else return
    match declared.shape
        Fallible(ok, errors) =>
            if ok != none or errors != none
                return
        _ => return
    mut edits := none
    if not self.own_fail()
        mut list := [fix.replace(declared.pos, "!", "! Fail")]
        mut whole := true
        for r in text_fail.returns
            if not r.text or r.at.line == 0
                whole = false
            else
                list.push(fix.insert(r.at, "Fail(msg: "))
                list.push(fix.after_expr(r.at, ")"))
        if whole
            edits = list
    nm := full_name(f)
    text_fail.fns[cur_fn] = TextFn(
        at: declared.pos,
        edits: edits,
        tails: [],
        shaped: false,
        dropped: [],
    )
    diags.push(
        new_diag(
            "err.str.4",
            declared.pos,
            "`!` declares no error type, so `return TEXT` has nothing to fail with; a function with no result that fails with text is `! Fail`",
        ).with_help("write `fn {nm}(...) ! Fail` and fail with `return Fail(msg: \"...\")` (err.fail.1)"),
    )

## What to write as the fallback of a `str`, `int`, `float` or `bool`: the help of err.else.2.
fn fallback_hint(ok Ty) str
    if ok == Ty.Str
        return ", such as `\"\"`"
    if ok == Ty.Int
        return ", such as `0`"
    if ok == Ty.Float
        return ", such as `0.0`"
    if ok == Ty.Bool
        return ", such as `false`"
    ""
