## Help that shows the exact rewrite where a value that can be `none` is used as a plain
## value: an optional list index (type.coll.4) and another language's `unwrap` on an
## optional (expr.name.1). E13 agents lost rounds to help that named no rewrite.

use ast
use fix

## The source text of a short expression, to quote it in a rewrite: a name, a literal, a
## field chain, or a method call whose arguments are themselves short. None for anything else.
@allow("expr.match.3") fn short_text(e ast.Expr) str?
    match e
        Name(n, _) => n
        Int(v, _) => v
        Member(r, n, _) =>
            t := short_text(r) else return none
            "{t}.{n}"
        Method(r, n, _, args) =>
            t := short_text(r) else return none
            if args.len() > 1
                return none
            mut inner := ""
            for a in args
                s := short_text(a.value) else return none
                inner = s
            "{t}.{n}({inner})"
        _ => none

## type.coll.4 on an index of type `T?`: take the value first, then index.
fn opt_index_help(recv ast.Expr, index ast.Expr) str
    it := short_text(index) else "i"
    xs := short_text(recv) else "xs"
    "the index can be `none`: take it first, `j := {it} else return` (or `else 0`), then write `{xs}[j]`"

## Whether `x.NAME(d)` on an optional means `x else d` (expr.name.1).
fn opt_fallback_method(n str) bool
    ["unwrap_or", "value_or", "get_or", "getOrDefault"].contains(n)

## expr.name.1 for a method other languages use to take an optional's value: the
## rewrite with `else` (type.opt.7, err.else.1). None for any other method.
fn opt_method_help(t Ty, n str, recv ast.Expr) str?
    if not is_opt(t)
        return none
    x := short_text(recv) else "x"
    if opt_fallback_method(n)
        return "an optional takes its fallback with `else`: write `{x} else d` in place of `{x}.{n}(d)`, in parentheses inside a larger expression"
    match n
        "unwrap" | "expect" | "get" | "value" | "force" | "unwrap_unchecked" =>
            "an optional has no `{n}`: write `{x} else d` for a fallback, `v := {x} else return` to leave, or `{x} else unreachable(\"why\")` to stop the program as `{n}` does"
        "unwrap_or_else" | "or_else" | "orElse" | "getOrElse" | "unwrap_or_default" =>
            "write `{x} else d`: the value after `else` is computed only when `{x}` is `none`, so it needs no closure"
        "map" | "and_then" | "map_or" | "flat_map" | "ok_or" | "filter" =>
            "an optional has no methods: take the value first, `v := {x} else return`, then use `v`; for a field write `{x}?.field else d`"
        _ => none

## The fix for `x.unwrap_or(d)`, `x.unwrap()` and `x.expect(m)` on an optional, when `x` is
## short (`short_text`): `(x else d)` and `(x else unreachable(...))`. The parentheses keep
## the rewrite exact wherever the call stood, since `else` binds looser than a call
## (type.opt.7, fix.edit.1). The call must sit on one line after a `.` at `at`, or the fix is
## dropped (fix.edit.2). None for any other method.
pub struct OptFix
    pub title str
    pub edits List[fix.Edit]

fn opt_method_fix(t Ty, n str, recv ast.Expr, at ast.Pos) OptFix?
    if not is_opt(t)
        return none
    x := short_text(recv) else return none
    dot := ast.Pos(line: at.line, col: (at.col - 1).max(0))
    lp := fix.insert(expr_pos(recv), "(")
    mut tail := ""
    if opt_fallback_method(n)
        tail = " else $p)"
    elif n == "unwrap" or n == "unwrap_unchecked" or n == "force"
        tail = " else unreachable(\"{x} is none\"))"
    elif n == "expect"
        tail = " else unreachable($p))"
    else
        return none
    what := if tail == " else $p)" then "..." else "unreachable(...)"
    OptFix(title: "write `{x} else {what}`", edits: [lp, fix.call(dot, ".{n}", tail)])

## Help for a method agents guess on a collection, with its fix when the rewrite is certain.
pub struct WordHelp
    pub help str
    pub title str
    pub edits List[fix.Edit]

## expr.name.1 for collection methods other languages have (ADR 1099 vocabulary):
## `s.keys()` and `s.values()` on a set are `s.to_list()` (type.coll.33); `m.set(k, v)`,
## `m.insert(k, v)` and `m.put(k, v)` on a map are `m[k] = v` (type.map.3), as help only,
## since that is a statement and the call may stand where a value is wanted (fix.edit.1).
fn word_help(t Ty, n str, recv ast.Expr, at ast.Pos) WordHelp?
    if is_set_ty(t) and (n == "keys" or n == "values")
        x := short_text(recv) else "s"
        h := "a set is its elements: `for x in {x}` reads them, `{x}.to_list()` gives a list in insertion order, and `{x}.sorted()` a sorted one"
        return WordHelp(help: h, title: "write `to_list`", edits: [fix.replace(at, n, "to_list")])
    if is_map_ty(t) and ["set", "insert", "put"].contains(n)
        m := short_text(recv) else "m"
        h := "a map entry is set by assignment: write `{m}[k] = v` as a statement in place of `{m}.{n}(k, v)`"
        return WordHelp(help: h, title: "", edits: [])
    none
