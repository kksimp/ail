## C structs by value and C callbacks (ffi.struct.1, ffi.cb.1-3, ADR 1074).
use ast

## Why the struct type `t` can't cross a C call by value, or none when it can
## (ffi.struct.1): every field has a C layout or is such a struct, and the
## struct is plain (no type parameters, unique values, invariants or error).
@allow("expr.match.3")
fn Checker.c_struct_why(self, t Ty, depth int) str?
    match t
        Struct(s, _) =>
            d := prog.structs[s]
            if depth > 16
                return "`{d.name}` contains itself"
            if d.generics.len() > 0
                return "`{d.name}` has type parameters"
            if d.is_unique or d.is_error
                return "`{d.name}` is a unique or error type"
            if d.invariants.len() > 0
                return "`{d.name}` has invariants, which a value made by C would skip"
            if d.fields.len() == 0
                return "`{d.name}` has no fields"
            for k in 0..d.fields.len().min(field_types[s].len())
                ft := field_types[s][k]
                if is_struct_ty(ft)
                    if why := c_struct_why(ft, depth + 1)
                        return why
                elif not c_layout(ft) and ft != Ty.Unknown
                    return "field `{d.fields[k].name}` of `{d.name}` is {show(ft)}, which has no C layout"
            none
        _ => "it isn't a struct"

@allow("expr.match.3") fn is_struct_ty(t Ty) bool
    match t
        Struct => true
        _ => false

## Whether `t` is a C callback type (ffi.cb.1): `fn(...)` whose parameters and
## result have C layouts, or no result, and whose arguments fit the registers
## of a C call (six integer-like and eight float, as ffi.decl.3).
@allow("expr.match.3")
fn c_callback_ty(t Ty) bool
    match t
        FnTy(ps, r) =>
            mut ints := 0
            mut floats := 0
            for p in ps
                if not c_layout(p) and p != Ty.Unknown
                    return false
                if p == Ty.Float or p == Ty.Num("f32")
                    floats += 1
                else
                    ints += 1
            if ints > 6 or floats > 8
                return false
            r == Ty.Unit or r == Ty.Unknown or c_layout(r)
        _ => false

@allow("expr.match.3") fn is_fn_ty(t Ty) bool
    match t
        FnTy => true
        _ => false

## ffi.decl.3 for a parameter or result of an `extern c fn` that is a struct
## (ffi.struct.1) or a function type (ffi.cb.1): true when it is allowed, with
## an error already reported when it is not.
fn Checker.c_extra_ok(mut self, t Ty, at ast.Pos, is_result bool) bool
    if is_struct_ty(t)
        if why := c_struct_why(t, 0)
            err_help(
                "ffi.struct.1",
                at,
                "{show(t)} can't be passed to C by value: {why}",
                "give the struct only fields of C types (`int`, `float`, `bool`, sized numbers, raw pointers, other such structs), or pass a raw pointer `*T`",
            )
        return true
    if is_fn_ty(t)
        if is_result
            err_help(
                "ffi.cb.1",
                at,
                "a C function can't return a callback",
                "return a raw pointer `*u8` instead",
            )
            return true
        if not c_callback_ty(t)
            err_help(
                "ffi.cb.1",
                at,
                "a C callback takes and returns only C types, at most six integer-like and eight float arguments, but this is {show(t)}",
                "use `int`, `float`, `bool`, sized numbers and raw pointers; pass other data through a `*u8` user-data pointer",
            )
        return true
    false

## A call of an `extern c fn` (ffi.cb.2): an argument for a `fn` parameter is
## the name of a declared function, since C keeps only a code address.
fn Checker.check_c_call(
    mut self,
    n str,
    s Sig,
    binds List[Bind],
    args List[ast.Arg],
    at ast.Pos,
    expect Ty?,
) Ty
    t := check_call(n, s, binds, args, none, at, expect)
    for k in 0..args.len().min(s.params.len())
        if is_fn_ty(s.params[k].ty)
            cb_name(args[k].value, "ffi.cb.2")
    t

## ffi.cb.2-3: `e` names a declared function (already checked as a value of
## its type). Reports an error otherwise.
fn Checker.cb_name(mut self, e ast.Expr, rule str)
    p := expr_pos(e)
    if np := name_pos(e)
        if fn_values.contains(pos_key(np))
            return
    err_help(
        rule,
        p,
        "a C callback must be the name of a declared function, because C keeps only its code address",
        "write the function's name; pass state through a `*u8` user-data parameter",
    )

## `mem.c_fn(f)` (ffi.cb.3): the C entry of the declared function `f`, as a
## `*u8`. `f` takes and returns only C types.
fn Checker.mem_c_fn(mut self, args List[ast.Arg], at ast.Pos, expect Ty?) Ty
    u8p := Ty.PtrOf(Ty.Num("u8"))
    if args.len() != 1
        return check_call(
            "mem.c_fn",
            plain_sig(none, [Ty.Unknown], u8p),
            [],
            args,
            none,
            at,
            expect,
        )
    t := expr(args[0].value, no_ty(), true)
    cb_name(args[0].value, "ffi.cb.3")
    if is_fn_ty(t) and not c_callback_ty(t)
        err_help(
            "ffi.cb.3",
            expr_pos(args[0].value),
            "`mem.c_fn` makes a C function pointer, but this function's type is {show(t)}",
            "take and return only `int`, `float`, `bool`, sized numbers and raw pointers",
        )
    u8p

@allow("expr.match.3") fn name_pos(e ast.Expr) ast.Pos?
    match e
        Name(_, p) => p
        _ => none
