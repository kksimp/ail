## Use after move (ADR 0377), as `check/moves.rs`: own.uniq.2, own.move.2,
## own.move.4, own.defer.3. A flow-sensitive walk over each function that
## follows which bindings have been moved out on every path. Typing has
## already recorded, in `moved`, each name whose use moves its value.
use ast

## Where a binding was moved, by which rule, and whether every path to here
## moved it.
struct MovedAt
    at ast.Pos
    rule str
    certain bool

## The moved bindings on the current path; `live` is false when no path
## reaches here.
struct Flow
    live bool
    names Map[str, MovedAt]

fn dead() Flow
    Flow(live: false, names: Map[str, MovedAt]())

fn fresh() Flow
    Flow(live: true, names: Map[str, MovedAt]())

fn join(a Flow, b Flow) Flow
    if not a.live
        return b
    if not b.live
        return a
    mut out := a
    for n in a.names.keys()
        mut m := a.names[n]
        if mb := b.names.get(n)
            m.certain = m.certain and mb.certain
        else
            m.certain = false
        out.names[n] = m
    for n in b.names.keys()
        if not a.names.contains(n)
            mut m := b.names[n]
            m.certain = false
            out.names[n] = m
    out

fn forget(f Flow, n str) Flow
    mut out := f
    if out.live
        out.names.remove(n)
    out

struct LoopFlow
    breaks Flow
    continues Flow
    ## How many names were in scope when the loop started.
    outer int

struct Mover
    moves Map[int, str]
    flow Flow
    ## Names in scope, innermost last (names aren't shadowed: expr.bind.4).
    names_in List[str]
    loops List[LoopFlow]
    ## Inside a deferred statement (own.defer.3).
    deferred bool
    found List[Diag]

pub fn check_moves(prog ast.Program, moved List[Moved]) List[Diag]
    if moved.len() == 0
        return []
    mut moves := Map[int, str]()
    for m in moved
        moves[pos_key(m.pos)] = m.rule
    mut w := Mover(moves: moves, flow: dead(), names_in: [], loops: [], deferred: false, found: [])
    for f in prog.fns
        body := f.body else continue
        w.flow = fresh()
        w.names_in = [p.name for p in f.params]
        w.block(body)
    w.found

fn Mover.block(mut self, b List[ast.Stmt])
    mark := names_in.len()
    mut later := List[ast.Stmt]()
    for s in b
        if inner := deferred_stmt(s)
            later.push(inner)
        stmt(s)
    # own.defer.3: a deferred statement runs at the end of the block, so what
    # it uses must still be there.
    for s in later
        saved := deferred
        deferred = true
        uses_only(s)
        deferred = saved
    for n in names_in[mark..]
        flow = forget(flow, n)
    names_in = names_in[..mark]

@allow("expr.match.3") fn deferred_stmt(s ast.Stmt) ast.Stmt?
    match s
        Defer(inner, _) => inner
        _ => none

## Check the uses in `s` against the current flow without moving anything.
fn Mover.uses_only(mut self, s ast.Stmt)
    saved := flow
    stmt(s)
    flow = saved

fn Mover.declare(mut self, n str)
    names_in.push(n)
    flow = forget(flow, n)

fn Mover.stmt(mut self, s ast.Stmt)
    match s
        Let(n, _, _, value, o) =>
            expr(value)
            if e := o
                otherwise(e)
            declare(n)
        LetTuple(names, value, _) =>
            expr(value)
            for b in names
                declare(b.name)
        # type.fn.9: a local function's body is a function of its own; the outer
        # flow goes on past it unchanged.
        LocalFn(d) =>
            declare(d.name)
            saved_flow := flow
            saved_loops := loops
            mark := names_in.len()
            flow = fresh()
            loops = []
            for p in d.params
                names_in.push(p.name)
            block(d.body else [])
            names_in = names_in[..mark]
            flow = saved_flow
            loops = saved_loops
        Assign(target, op, value, _) =>
            expr(value)
            if n := whole_name(target)
                # A whole binding gets a new value; `x += 1` reads it first.
                if op != none
                    expr(target)
                flow = forget(flow, n)
            else
                expr(target)
        While(c, body, _) =>
            expr(c)
            loop_body(body, none)
        Unsafe(body, _) => block(body)
        With(mutex, _, _, body, _) =>
            expr(mutex)
            block(body)
        For(_, var, _, _, iter, body, _) =>
            expr(iter)
            loop_body(body, var)
        Break =>
            st := flow
            flow = dead()
            if loops.len() > 0
                k := loops.len() - 1
                loops[k].breaks = join(loops[k].breaks, st)
        Continue =>
            st := flow
            flow = dead()
            if loops.len() > 0
                k := loops.len() - 1
                loops[k].continues = join(loops[k].continues, st)
        Return(value, _) =>
            if e := value
                expr(e)
            flow = dead()
        Eval(e) => expr(e)
        Handle(value, o) =>
            expr(value)
            otherwise(o)
        # Checked at the end of the block, with the flow there.
        Defer => return

@allow("expr.match.3") fn whole_name(e ast.Expr) str?
    match e
        Name(n, _) => n
        _ => none

## A loop body runs any number of times: a binding from outside the loop
## that is moved on the way back to the top would be used again by the next
## iteration (own.uniq.2, own.move.2).
fn Mover.loop_body(mut self, body List[ast.Stmt], var str?)
    entry := flow
    mark := names_in.len()
    if v := var
        declare(v)
    loops.push(LoopFlow(breaks: dead(), continues: dead(), outer: mark))
    block(body)
    l := loops.pop() else return
    back := join(flow, l.continues)
    flow = dead()
    names_in = names_in[..mark]
    if back.live
        outer := names_in[..l.outer]
        mut again := List[Again]()
        for n in back.names.keys()
            if outer.contains(n) and not (entry.live and entry.names.contains(n))
                again.push(Again(name: n, at: back.names[n]))
        for a in again.sorted(by: |a| a.at.at.line * 100000 + a.at.at.col)
            found.push(
                new_diag(
                    "own.move.4",
                    a.at.at,
                    "`{a.name}` is moved inside a loop, so the next iteration would use it after the move",
                ).with_help("give `{a.name}` a new value before the loop repeats, or `break` after the move"),
            )
    mut after := join(join(entry, l.breaks), back)
    if v := var
        after = forget(after, v)
    flow = after

struct Again
    name str
    at MovedAt

fn Mover.otherwise(mut self, o ast.Else)
    before := flow
    match o
        Fallback(e) => expr(e)
        Leave(s) => stmt(s)
        Handler(err_name, body, _) =>
            mark := names_in.len()
            if n := err_name
                declare(n.name)
            block(body)
            names_in = names_in[..mark]
    # The fallback runs only when the value is absent or failed.
    flow = join(before, flow)

fn Mover.use_name(mut self, n str, at ast.Pos)
    if not flow.live
        return
    if m := flow.names.get(n)
        flow.names.remove(n)
        mut text := "`{n}` may have been moved on some paths to here"
        mut note := "moved here on some paths"
        # own.move.4: a move on only some paths still ends the binding.
        mut rule := "own.move.4"
        if deferred
            text = "the deferred statement uses `{n}`, which is moved before the block ends"
            note = "moved here"
            rule = "own.defer.3"
        elif m.certain
            text = "`{n}` is used after it was moved"
            note = "moved here"
            rule = m.rule
        found.push(
            new_diag(rule, at, text)
                .with_note(m.at, note)
                .with_help("use `{n}` before the move, or give it a new value with `{n} = ...` first"),
        )
        return
    if rule := moves.get(pos_key(at))
        if deferred
            found.push(
                new_diag(
                    "own.defer.3",
                    at,
                    "a deferred statement can't move `{n}`",
                ).with_help("move it in an ordinary statement at the end of the block"),
            )
            return
        flow.names[n] = MovedAt(at: at, rule: rule, certain: true)

fn Mover.exprs(mut self, es List[ast.Expr])
    for e in es
        expr(e)

fn Mover.expr(mut self, e ast.Expr)
    match e
        Str => return
        Bytes => return
        Int => return
        Float => return
        Char => return
        Bool => return
        NoneLit => return
        Hole => return
        TypeArgs => return
        Name(n, at) => use_name(n, at)
        Interp(parts, _) =>
            for p in parts
                match p
                    Lit => continue
                    Hole(x) => expr(x)
                    Fmt(x, _) => expr(x)
        ListLit(items, _) => exprs(items)
        SetLit(items, _) => exprs(items)
        TupleLit(items, _) => exprs(items)
        MapLit(entries, _) =>
            for en in entries
                expr(en.key)
                expr(en.value)
        Call(callee, args, _) =>
            if whole_name(callee) == none
                expr(callee)
            for a in args
                expr(a.value)
        Method(recv, _, _, args) =>
            expr(recv)
            for a in args
                expr(a.value)
        Member(recv, _, _) => expr(recv)
        Unary(_, operand, _) => expr(operand)
        NewRef(value, _) => expr(value)
        # type.fn.5: a function literal copies what it names when it is made.
        Closure(_, body, _) => expr(body)
        Index(recv, index, _) =>
            expr(recv)
            expr(index)
        Binary(op, lhs, rhs, _) =>
            expr(lhs)
            if op == ast.BinOp.And or op == ast.BinOp.Or
                before := flow
                expr(rhs)
                flow = join(before, flow)
            else
                expr(rhs)
        Range(lo, hi, _, _) =>
            if x := lo
                expr(x)
            if x := hi
                expr(x)
        If(branches, els, _, _) => if_flow(branches, els)
        Match(scrutinee, arms, _) =>
            expr(scrutinee)
            start := flow
            mut out := dead()
            for arm in arms
                flow = start
                mark := names_in.len()
                pattern(arm.pat)
                if g := arm.guard
                    expr(g)
                block(arm.body)
                names_in = names_in[..mark]
                out = join(out, flow)
            flow = if arms.len() == 0 then start else out
        Try(x, context, _) =>
            expr(x)
            # The context is evaluated only on the way out of the function.
            if c := context
                saved := flow
                expr(c)
                flow = saved
        OrElse(value, o, _) =>
            expr(value)
            otherwise(o)
        Comp(_, elem, value, clauses, _) => comp(elem, value, clauses)

fn Mover.if_flow(mut self, branches List[ast.Branch], els List[ast.Stmt]?)
    mut out := dead()
    for br in branches
        mark := names_in.len()
        match br.cond
            Test(c) => expr(c)
            Bind(_, _, value) => expr(value)
        after_cond := flow
        match br.cond
            Test => flow = flow
            Bind(n, _, _) => declare(n)
        block(br.body)
        names_in = names_in[..mark]
        out = join(out, flow)
        flow = after_cond
    if b := els
        block(b)
    flow = join(out, flow)

## A comprehension (expr.comp.1): the first source is evaluated once and the
## rest repeats, like a loop body, so a move of an outer binding in it would
## repeat too (own.move.4).
fn Mover.comp(mut self, elem ast.Expr, value ast.Expr?, clauses List[ast.CompFor])
    mark := names_in.len()
    mut entry := dead()
    for i in 0..clauses.len()
        c := clauses[i]
        expr(c.iter)
        if i == 0
            entry = flow
        declare(c.var)
        for b in c.unpack
            declare(b.name)
        if x := c.cond
            expr(x)
    expr(elem)
    if v := value
        expr(v)
    names_in = names_in[..mark]
    for c in clauses
        flow = forget(flow, c.var)
        for b in c.unpack
            flow = forget(flow, b.name)
    if not entry.live or not flow.live
        return
    mut again := List[Again]()
    for n in flow.names.keys()
        if not entry.names.contains(n)
            again.push(Again(name: n, at: flow.names[n]))
    for a in again.sorted(by: |a| a.at.at.line * 100000 + a.at.at.col)
        found.push(
            new_diag(
                "own.move.4",
                a.at.at,
                "`{a.name}` is moved inside a comprehension, so the next element would use it after the move",
            ).with_help("move `{a.name}` outside the comprehension"),
        )

fn Mover.pattern(mut self, p ast.Pattern)
    match p
        Variant(_, _, bindings, _) =>
            if bs := bindings
                for b in bs
                    declare(b.name)
        Alt(alts, _) =>
            for a in alts
                pattern(a)
        TuplePat(elems, _) =>
            for a in elems
                pattern(a)
        BindName(n, _) => declare(n)
        Nested(_, _, nfields, _) =>
            for a in nfields
                pattern(a)
        Wildcard => return
        Literal => return
        Range => return
