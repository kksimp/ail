## Use after move (ADR 0377), as `check/moves.rs`: own.uniq.2, own.move.2,
## own.move.4, own.defer.3. A flow-sensitive walk over each function that
## follows which bindings have been moved out on every path. Typing has
## already recorded, in `moved`, each name whose use moves its value.
use ast

## Where a binding was moved, by which rule, and whether every path to here
## moved it.
struct MovedAt
    at ast.Pos
    rule str
    certain bool

## The moved bindings on the current path; `live` is false when no path
## reaches here.
struct Flow
    live bool
    names Map[str, MovedAt]

fn dead() Flow
    Flow(live: false, names: Map[str, MovedAt]())

fn fresh() Flow
    Flow(live: true, names: Map[str, MovedAt]())

fn join(a Flow, b Flow) Flow
    if not a.live
        return b
    if not b.live
        return a
    mut out := a
    for n in a.names.keys()
        mut m := a.names[n]
        if mb := b.names.get(n)
            m.certain = m.certain and mb.certain
        else
            m.certain = false
        out.names[n] = m
    for n in b.names.keys()
        if not a.names.contains(n)
            mut m := b.names[n]
            m.certain = false
            out.names[n] = m
    out

fn forget(f Flow, n str) Flow
    mut out := f
    if out.live
        out.names.remove(n)
    out

struct LoopFlow
    breaks Flow
    continues Flow
    ## How many names were in scope when the loop started.
    outer int
    ## The loop's position, which `break outer` names (expr.loop.10).
    at ast.Pos

struct Mover
    moves Map[int, str]
    flow Flow
    ## Names in scope, innermost last (names aren't shadowed: expr.bind.4).
    names_in List[str]
    loops List[LoopFlow]
    ## Inside a deferred statement (own.defer.3).
    deferred bool
    found List[Diag]

pub fn check_moves(prog ast.Program, moved List[Moved]) List[Diag]
    if moved.len() == 0
        return []
    mut moves := Map[int, str]()
    for m in moved
        moves[pos_key(m.pos)] = m.rule
    mut w := Mover(moves: moves, flow: dead(), names_in: [], loops: [], deferred: false, found: [])
    for f in prog.fns
        body := f.body else continue
        w.flow = fresh()
        w.names_in = [p.name for p in f.params]
        w.block(body)
    w.found

fn Mover.block(mut self, b List[ast.Stmt])
    mark := self.names_in.len()
    mut later := List[ast.Stmt]()
    for s in b
        if inner := deferred_stmt(s)
            later.push(inner)
        self.stmt(s)
    # own.defer.3: a deferred statement runs at the end of the block, so what
    # it uses must still be there.
    for s in later
        saved := self.deferred
        self.deferred = true
        self.uses_only(s)
        self.deferred = saved
    for n in self.names_in[mark..]
        self.flow = forget(self.flow, n)
    self.names_in = self.names_in[..mark]

@allow("expr.match.3") fn deferred_stmt(s ast.Stmt) ast.Stmt?
    match s
        Defer(inner, _) => inner
        _ => none

## Check the uses in `s` against the current flow without moving anything.
fn Mover.uses_only(mut self, s ast.Stmt)
    saved := self.flow
    self.stmt(s)
    self.flow = saved

fn Mover.declare(mut self, n str)
    self.names_in.push(n)
    self.flow = forget(self.flow, n)

fn Mover.stmt(mut self, s ast.Stmt)
    match s
        Let(n, _, _, value, o) =>
            self.expr(value)
            if e := o
                self.otherwise(e)
            self.declare(n)
        LetTuple(names, value, _) =>
            self.expr(value)
            for b in names
                self.declare(b.name)
        # type.fn.9: a local function's body is a function of its own; the outer
        # flow goes on past it unchanged.
        LocalFn(d) =>
            self.declare(d.name)
            saved_flow := self.flow
            saved_loops := self.loops
            mark := self.names_in.len()
            self.flow = fresh()
            self.loops = []
            for p in d.params
                self.names_in.push(p.name)
            self.block(d.body else [])
            self.names_in = self.names_in[..mark]
            self.flow = saved_flow
            self.loops = saved_loops
        Assign(target, op, value, _) =>
            self.expr(value)
            if n := whole_name(target)
                # A whole binding gets a new value; `x += 1` reads it first.
                if op != none
                    self.expr(target)
                self.flow = forget(self.flow, n)
            else
                self.expr(target)
        While(c, body, wpos) =>
            self.expr(c)
            self.loop_body(body, none, wpos)
        Unsafe(body, _) => self.block(body)
        With(mutex, _, _, body, _) =>
            self.expr(mutex)
            self.block(body)
        For(_, var, _, _, iter, body, fpos) =>
            self.expr(iter)
            self.loop_body(body, var, fpos)
        Break(_, target) =>
            st := self.flow
            self.flow = dead()
            k := self.loop_index(target)
            if k >= 0
                self.loops[k].breaks = join(self.loops[k].breaks, st)
        Continue(_, target) =>
            st := self.flow
            self.flow = dead()
            k := self.loop_index(target)
            if k >= 0
                self.loops[k].continues = join(self.loops[k].continues, st)
        Return(value, _) =>
            if e := value
                self.expr(e)
            self.flow = dead()
        Eval(e) => self.expr(e)
        Handle(value, o) =>
            self.expr(value)
            self.otherwise(o)
        # Checked at the end of the block, with the flow there.
        Defer => return
        # conc.select.3: the heads run in order, then at most one arm's block.
        Select(arms, _) =>
            for h in ast.select_heads(arms)
                self.expr(h)
            start := self.flow
            mut out := if ast.select_always_runs(arms) then dead() else start
            for a in arms
                self.flow = start
                mark := self.names_in.len()
                if b := ast.select_var(a.op)
                    self.declare(b.name)
                self.block(a.body)
                self.names_in = self.names_in[..mark]
                out = join(out, self.flow)
            self.flow = out

@allow("expr.match.3") fn whole_name(e ast.Expr) str?
    match e
        Name(n, _) => n
        _ => none

## A loop body runs any number of times: a binding from outside the loop
## that is moved on the way back to the top would be used again by the next
## iteration (own.uniq.2, own.move.2).
## The loop a `break` or `continue` leaves: the innermost, or the one at
## `target` (expr.loop.10); -1 when there is none.
fn Mover.loop_index(self, target ast.Pos?) int
    if t := target
        mut k := self.loops.len() - 1
        while k >= 0
            if self.loops[k].at.line == t.line and self.loops[k].at.col == t.col
                return k
            k -= 1
        return -1
    self.loops.len() - 1

fn Mover.loop_body(mut self, body List[ast.Stmt], var str?, at ast.Pos)
    entry := self.flow
    mark := self.names_in.len()
    if v := var
        self.declare(v)
    self.loops.push(LoopFlow(breaks: dead(), continues: dead(), outer: mark, at: at))
    self.block(body)
    l := self.loops.pop() else return
    back := join(self.flow, l.continues)
    self.flow = dead()
    self.names_in = self.names_in[..mark]
    if back.live
        outer := self.names_in[..l.outer]
        mut again := List[Again]()
        for n in back.names.keys()
            if outer.contains(n) and not (entry.live and entry.names.contains(n))
                again.push(Again(name: n, at: back.names[n]))
        for a in again.sorted(by: |a| a.at.at.line * 100000 + a.at.at.col)
            self.found.push(
                new_diag(
                    "own.move.4",
                    a.at.at,
                    "`{a.name}` is moved inside a loop, so the next iteration would use it after the move",
                ).with_help("give `{a.name}` a new value before the loop repeats, or `break` after the move"),
            )
    mut after := join(join(entry, l.breaks), back)
    if v := var
        after = forget(after, v)
    self.flow = after

struct Again
    name str
    at MovedAt

fn Mover.otherwise(mut self, o ast.Else)
    before := self.flow
    match o
        Fallback(e) => self.expr(e)
        Leave(s) => self.stmt(s)
        Handler(err_name, body, _) =>
            mark := self.names_in.len()
            if n := err_name
                self.declare(n.name)
            self.block(body)
            self.names_in = self.names_in[..mark]
    # The fallback runs only when the value is absent or failed.
    self.flow = join(before, self.flow)

fn Mover.use_name(mut self, n str, at ast.Pos)
    if not self.flow.live
        return
    if m := self.flow.names.get(n)
        self.flow.names.remove(n)
        mut text := "`{n}` may have been moved on some paths to here"
        mut note := "moved here on some paths"
        # own.move.4: a move on only some paths still ends the binding.
        mut rule := "own.move.4"
        if self.deferred
            text = "the deferred statement uses `{n}`, which is moved before the block ends"
            note = "moved here"
            rule = "own.defer.3"
        elif m.certain
            text = "`{n}` is used after it was moved"
            note = "moved here"
            rule = m.rule
        self.found.push(
            new_diag(rule, at, text)
                .with_note(m.at, note)
                .with_help("use `{n}` before the move, or give it a new value with `{n} = ...` first"),
        )
        return
    if rule := self.moves.get(pos_key(at))
        if self.deferred
            self.found.push(
                new_diag(
                    "own.defer.3",
                    at,
                    "a deferred statement can't move `{n}`",
                ).with_help("move it in an ordinary statement at the end of the block"),
            )
            return
        self.flow.names[n] = MovedAt(at: at, rule: rule, certain: true)

fn Mover.exprs(mut self, es List[ast.Expr])
    for e in es
        self.expr(e)

fn Mover.expr(mut self, e ast.Expr)
    match e
        Str => return
        Bytes => return
        Int => return
        Float => return
        Char => return
        Bool => return
        NoneLit => return
        Hole => return
        TypeArgs => return
        Name(n, at) => self.use_name(n, at)
        Interp(parts, _) =>
            for p in parts
                match p
                    Lit => continue
                    Hole(x) => self.expr(x)
                    Fmt(x, _) => self.expr(x)
        ListLit(items, _) => self.exprs(items)
        SetLit(items, _) => self.exprs(items)
        TupleLit(items, _) => self.exprs(items)
        MapLit(entries, _) =>
            for en in entries
                self.expr(en.key)
                self.expr(en.value)
        Call(callee, args, _) =>
            if whole_name(callee) == none
                self.expr(callee)
            for a in args
                self.expr(a.value)
        Method(recv, _, _, args) =>
            self.expr(recv)
            for a in args
                self.expr(a.value)
        Member(recv, _, _) => self.expr(recv)
        Unary(_, operand, _) => self.expr(operand)
        NewRef(value, _) => self.expr(value)
        # type.fn.5: a function literal copies what it names when it is made.
        Closure(_, body, _) => self.expr(body)
        Index(recv, index, _) =>
            self.expr(recv)
            self.expr(index)
        Binary(op, lhs, rhs, _) =>
            self.expr(lhs)
            if op == ast.BinOp.And or op == ast.BinOp.Or
                before := self.flow
                self.expr(rhs)
                self.flow = join(before, self.flow)
            else
                self.expr(rhs)
        Range(lo, hi, _, _) =>
            if x := lo
                self.expr(x)
            if x := hi
                self.expr(x)
        If(branches, els, _, _) => self.if_flow(branches, els)
        Match(scrutinee, arms, _) =>
            self.expr(scrutinee)
            start := self.flow
            mut out := dead()
            for arm in arms
                self.flow = start
                mark := self.names_in.len()
                self.pattern(arm.pat)
                if g := arm.guard
                    self.expr(g)
                self.block(arm.body)
                self.names_in = self.names_in[..mark]
                out = join(out, self.flow)
            self.flow = if arms.len() == 0 then start else out
        Try(x, context, _) =>
            self.expr(x)
            # The context is evaluated only on the way out of the function.
            if c := context
                saved := self.flow
                self.expr(c)
                self.flow = saved
        OrElse(value, o, _) =>
            self.expr(value)
            self.otherwise(o)
        Comp(_, elem, value, clauses, _) => self.comp(elem, value, clauses)

fn Mover.if_flow(mut self, branches List[ast.Branch], els List[ast.Stmt]?)
    mut out := dead()
    for br in branches
        mark := self.names_in.len()
        match br.cond
            Test(c) => self.expr(c)
            Bind(_, _, value) => self.expr(value)
        after_cond := self.flow
        match br.cond
            Test => self.flow = self.flow
            Bind(n, _, _) => self.declare(n)
        self.block(br.body)
        self.names_in = self.names_in[..mark]
        out = join(out, self.flow)
        self.flow = after_cond
    if b := els
        self.block(b)
    self.flow = join(out, self.flow)

## A comprehension (expr.comp.1): the first source is evaluated once and the
## rest repeats, like a loop body, so a move of an outer binding in it would
## repeat too (own.move.4).
fn Mover.comp(mut self, elem ast.Expr, value ast.Expr?, clauses List[ast.CompFor])
    mark := self.names_in.len()
    mut entry := dead()
    for i in 0..clauses.len()
        c := clauses[i]
        self.expr(c.iter)
        if i == 0
            entry = self.flow
        self.declare(c.var)
        for b in c.unpack
            self.declare(b.name)
        if x := c.cond
            self.expr(x)
    self.expr(elem)
    if v := value
        self.expr(v)
    self.names_in = self.names_in[..mark]
    for c in clauses
        self.flow = forget(self.flow, c.var)
        for b in c.unpack
            self.flow = forget(self.flow, b.name)
    if not entry.live or not self.flow.live
        return
    mut again := List[Again]()
    for n in self.flow.names.keys()
        if not entry.names.contains(n)
            again.push(Again(name: n, at: self.flow.names[n]))
    for a in again.sorted(by: |a| a.at.at.line * 100000 + a.at.at.col)
        self.found.push(
            new_diag(
                "own.move.4",
                a.at.at,
                "`{a.name}` is moved inside a comprehension, so the next element would use it after the move",
            ).with_help("move `{a.name}` outside the comprehension"),
        )

fn Mover.pattern(mut self, p ast.Pattern)
    match p
        Variant(_, _, bindings, _) =>
            if bs := bindings
                for b in bs
                    self.declare(b.name)
        Alt(alts, _) =>
            for a in alts
                self.pattern(a)
        TuplePat(elems, _) =>
            for a in elems
                self.pattern(a)
        BindName(n, _) => self.declare(n)
        Nested(_, _, nfields, _) =>
            for a in nfields
                self.pattern(a)
        StructPat(_, _, _, sfields, _) =>
            for a in sfields
                self.pattern(a)
        Wildcard => return
        Literal => return
        Range => return
