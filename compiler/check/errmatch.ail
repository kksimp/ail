## `match` on an error union (err.match.1-3, ADR 1078): the name `else err`
## bound to a failure of two or more error types is matched by member type.
## An arm `T =>` takes member `T`, and in it the name is a `T`; an arm
## `T.Variant(...)` takes one variant of a member error enum `T`; `_` takes
## the rest. Every member must be covered.
use ast
use fix

## The member of `members` that pattern text `full` names, or -1.
fn Checker.member_named(self, members List[Ty], full str) int
    for k in 0..members.len()
        if n := type_name_of(members[k])
            if n == full
                return k
    -1

## Whether member `k` is covered: by a `T` arm, `_`, or every variant.
fn member_covered(whole List[bool], parts List[Coverage], wildcard bool, k int) bool
    wildcard or whole[k] or (parts[k].variants.len() > 0 and not parts[k].variants.contains(false))

## The part of `full` after its last dot.
fn short_name(full str) str
    parts := full.split(".")
    parts[parts.len() - 1]

fn Checker.not_member(mut self, members List[Ty], full str, at ast.Pos)
    names := [ty_name(m) for m in members]
    mut hint := "match its member types: {list_names(names)}"
    for n in names
        if n != full and short_name(n) == short_name(full)
            hint = "write the member's full name: `{n}`"
    err_help("err.match.1", at, "`{full}` is not an error type of this union", hint)

## Check one arm's pattern; the member type it narrows the name to, and the
## names a `T.Variant(...)` binds.
@allow("expr.match.3")
fn Checker.member_arm(
    mut self,
    members List[Ty],
    pat ast.Pattern,
    mut whole List[bool],
    mut parts List[Coverage],
    mut wildcard bool,
    mut binds List[Binding],
) Ty?
    match pat
        Wildcard(at) =>
            left := [
                ty_name(members[k])
                for k in 0..members.len() if not member_covered(whole, parts, wildcard, k)
            ]
            if left.len() == 0
                err("expr.match.5", at, "this arm can never match; earlier arms cover every member")
                return none
            if not allow_wildcards
                warn(
                    "expr.match.3",
                    at,
                    "`_` covers {list_names(left)}, so an error type added later won't be flagged here",
                    "list the member types instead of `_`, or mark the function `@allow(\"expr.match.3\")`",
                )
            wildcard = true
            none
        Alt(alts, _) =>
            for a in alts
                match a
                    Wildcard(p) => err(
                        "expr.match.8",
                        p,
                        "`_` can't be one of several alternatives; it already matches everything",
                    )
                    Variant(_, _, names, p) =>
                        if binds_names(names)
                            err_help(
                                "expr.match.8",
                                p,
                                "a pattern with alternatives can't bind names",
                                "give this member an arm of its own, or use `_` for its fields",
                            )
                        else
                            mut ignored := List[Binding]()
                            self.member_arm(
                                members,
                                a,
                                mut whole,
                                mut parts,
                                mut wildcard,
                                mut ignored,
                            )
                    Literal | Alt | Range | TuplePat | BindName | Nested | StructPat => self.member_arm(
                        members,
                        a,
                        mut whole,
                        mut parts,
                        mut wildcard,
                        mut binds,
                    )
            none
        Variant(q, n, bindings, at) =>
            full := if qual := q then "{qual}.{n}" else n
            hit := self.member_named(members, full)
            if hit >= 0
                if bindings != none
                    err_help(
                        "err.match.2",
                        at,
                        "the member pattern `{full}` takes no fields",
                        "write `{full} =>`; in the arm, the matched name is a `{full}`",
                    )
                if member_covered(whole, parts, wildcard, hit)
                    err("expr.match.5", at, "this arm can never match; `{full}` is already covered")
                whole[hit] = true
                return members[hit]
            # `T.Variant(...)`: one variant of member error enum `T`.
            if qq := q
                e := self.member_named(members, qq)
                if e >= 0
                    match members[e]
                        Enum(index, args) =>
                            if member_covered(whole, parts, wildcard, e)
                                err(
                                    "expr.match.5",
                                    at,
                                    "this arm can never match; `{qq}` is already covered",
                                )
                                return members[e]
                            mut cov := parts[e]
                            binds = pattern(
                                index,
                                args,
                                ast.Pattern.Variant(none, n, bindings, at),
                                mut cov,
                            )
                            parts[e] = cov
                            return members[e]
                        _ =>
                            err_help(
                                "err.match.1",
                                at,
                                "`{qq}` is a struct, so it has no variant `{n}`",
                                "match the whole member: `{qq} =>`",
                            )
                            return none
            self.not_member(members, full, at)
            none
        _ =>
            err_help(
                "err.match.1",
                pattern_pos(pat),
                "a `match` on an error union takes its member types, their variants, and `_`",
                "match its member types: {list_names([ty_name(m) for m in members])}",
            )
            none

## `match name` where `name` holds one of `members` (err.match.1-3).
@allow("expr.match.3")
fn Checker.union_match(
    mut self,
    scrutinee ast.Expr,
    members List[Ty],
    arms List[ast.Arm],
    at ast.Pos,
    expect Ty?,
    need bool,
) Ty
    # err.match.2: the scrutinee is the name `else err` bound.
    mut name := ""
    match scrutinee
        Name(n, _) =>
            if l := local(n)
                if l.decl == none and l.how == LocalKind.Binding
                    name = n
        _ => name = ""
    if name == ""
        err_help(
            "err.match.2",
            expr_pos(scrutinee),
            "a `match` on an error union works on the name `else err` bound",
            "write `else err` and `match err`",
        )
    mut whole := [false for _ in members]
    mut parts := List[Coverage]()
    for m in members
        nv := match m
            Enum(e, _) => prog.enums[e].variants.len()
            _ => 0
        parts.push(Coverage(variants: [false for _ in 0..nv], literals: [], wildcard: false))
    mut wildcard := false
    mut agree := new_agree(expect, need, "arm", "`match`")
    for arm in arms
        kept_whole := whole
        kept_parts := parts
        kept_wildcard := wildcard
        mut binds := List[Binding]()
        narrowed := self.member_arm(members, arm.pat, mut whole, mut parts, mut wildcard, mut binds)
        # expr.match.11: a guarded arm covers nothing.
        if arm.guard != none
            whole = kept_whole
            parts = kept_parts
            wildcard = kept_wildcard
        mark := locals.len()
        if t := narrowed
            if name != ""
                self.add_local(Local(
                    name: name,
                    ty: t,
                    mutable: false,
                    how: LocalKind.Binding,
                    decl: none,
                ))
        for b in binds
            if b.name != "_" and declare(b.name, b.pos)
                self.add_local(Local(
                    name: b.name,
                    ty: b.ty,
                    mutable: false,
                    how: LocalKind.Binding,
                    decl: none,
                ))
        if g := arm.guard
            condition(g)
        agree_block(mut agree, arm.body, at)
        end_scope(mark)
    # err.match.3: every member is covered.
    missing := [k for k in 0..members.len() if not member_covered(whole, parts, wildcard, k)]
    if missing.len() > 0
        names := [ty_name(members[k]) for k in missing]
        mut d := new_diag(
            "err.match.3",
            at,
            "this `match` doesn't cover the error {if names.len() == 1 then "type" else "types"} {list_names(names)}",
        ).with_help("add an arm for each, or a `_` arm")
        if arms.len() > 0
            last := arms[arms.len() - 1].pat
            indent := " ".repeat(pattern_pos(last).col - 1)
            text := ["{indent}{nm} => todo\n" for nm in names].join("")
            d = d.with_fix("add the missing arms, each a `todo`", [fix.after_block(
                pattern_pos(last),
                text,
            )])
        diags.push(d)
    agree_result(agree)
