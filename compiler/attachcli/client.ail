## `ail attach` (attach.cli.1-3, ADR 0884): the client of a running program's attach socket, so an
## agent needs no hand-written socket code. `ail attach` lists the programs that publish one;
## `ail attach [--port N] observe|screen|heap|tools|input [key=value ...]` sends that query, with the token
## from the program's discovery file, and prints the reply line; `ail attach call TOOL [key=value ...]`
## runs a `@tool` method and `ail attach mcp` serves the program as MCP tools (ADR 0986). Only `input`
## and `call` act, and only when the program runs with `--attach-input` (attach.input.1, attach.tool.4).
use syntax

ATTACH_USAGE := "usage: ail attach [--port N] observe|screen|heap|tools|input [key=value ...] | call TOOL [key=value ...] | mcp   e.g. ail attach screen role=button budget=200; ail attach input kind=press id=pay (needs `ail run --attach-input`); ail attach call add item=tea qty=2 (needs it too); ail attach observe names=n,total since=3; `ail attach` alone lists the running programs"

## A program that publishes an attach socket.
struct Running
    port int
    token str

fn tmp_dir() str
    env.get("TMPDIR") else "/tmp"

## The programs whose discovery files (`attach.wire.1`) are in the temp directory, by port.
fn running() List[Running]
    mut out := List[Running]()
    dir := tmp_dir().strip_suffix("/") else tmp_dir()
    names := fs.list_dir(dir) else return out
    for n in names.sorted()
        if not (n.starts_with("ail-attach-") and n.ends_with(".json"))
            continue
        text := fs.read_text("{dir}/{n}") else continue
        if text.trim() == ""
            continue
        j := parse_json(text) else continue
        addr := j.str("addr") else continue
        token := j.str("token") else continue
        port := (addr.split(":").last() else "").to_int() else continue
        out.push(Running(port: port, token: token))
    out

## A field's JSON: a number stays a number, `names` is a list, anything else is a string.
fn field_json(key str, value str) str
    if key == "names"
        return "[{[syntax.quote(n) for n in value.split(",")].join(",")}]"
    if ["x", "y", "w", "h", "dx", "dy", "budget", "since"].contains(key)
        if value.to_float() != none
            return value
    if ["ctrl", "alt", "shift", "meta"].contains(key) and (value == "true" or value == "false")
        return value
    syntax.quote(value)

## `ail attach ARGS`; the exit status: 0 for a reply, 1 for an error reply, 2 for a usage or connection error.
pub fn command(args List[str]) int
    mut port := 0
    mut rest := List[str]()
    mut i := 0
    while i < args.len()
        a := args[i]
        i += 1
        if a == "--port"
            if i >= args.len()
                io.eprint("error: `--port` needs a port number\n{ATTACH_USAGE}")
                return 2
            port = args[i].to_int() else 0
            i += 1
        else
            rest.push(a)
    apps := running()
    if rest.len() == 0
        if apps.len() == 0
            io.eprint("no program publishes an attach socket (a std.app program started with `ail run` does)")
            return 1
        for a in apps
            print("127.0.0.1:{a.port}")
        return 0
    q := rest[0]
    if q == "mcp"
        return serve_mcp(port)
    if not ["observe", "screen", "heap", "tools", "input", "call"].contains(q)
        io.eprint("error: unknown query `{q}`; the queries are observe, screen, heap and tools, and input and call when the program runs with --attach-input\n{ATTACH_USAGE}")
        return 2
    app := pick(apps, port) else return 2
    mut fields := ["\"v\":1", "\"q\":{syntax.quote(q)}", "\"token\":{syntax.quote(app.token)}"]
    mut pairs := rest[1..]
    if q == "call"
        if pairs.len() == 0 or pairs[0].contains("=")
            io.eprint("error: `call` needs a tool name (`ail attach tools` lists them)\n{ATTACH_USAGE}")
            return 2
        fields.push("\"name\":{syntax.quote(pairs[0])}")
        pairs = pairs[1..]
    mut call_args := List[str]()
    for kv in pairs
        eq := kv.find("=") else
            io.eprint("error: `{kv}` is not key=value\n{ATTACH_USAGE}")
            return 2
        key := kv.slice(0, eq)
        value := kv.slice(eq + 1, kv.len())
        # A call's pairs are its arguments, sent as text; the tool reads each by its type (attach.tool.4).
        if q == "call"
            call_args.push("{syntax.quote(key)}:{syntax.quote(value)}")
        else
            fields.push("{syntax.quote(key)}:{field_json(key, value)}")
    if q == "call"
        fields.push("\"args\":\{{call_args.join(",")}}")
    line := send(app, "\{{fields.join(",")}}") else err
        io.eprint("error: {err.message}")
        return 2
    print(line)
    if line.contains("\"error\"")
        return 1
    0

## The program `port` names, or the only one running; `none` after saying why (attach.cli.2).
fn pick(apps List[Running], port int) Running?
    mut at := -1
    for k in 0..apps.len()
        if port == 0 or apps[k].port == port
            at = k
    if port == 0 and apps.len() > 1
        io.eprint("error: {apps.len()} programs publish a socket; name one with `--port N` (`ail attach` lists them)")
        return none
    if at < 0
        io.eprint("error: no program publishes an attach socket{if port == 0 then "" else " on port {port}"}")
        return none
    apps[at]

## Why a request failed to get a reply.
error struct SendError
    message str

## Sends request line `body` to `app` and gives its reply line (attach.wire.3).
fn send(app Running, body str) str ! SendError
    c := net.connect("127.0.0.1", app.port) else err
        return SendError(message: "can't connect to 127.0.0.1:{app.port}: {err.message}")
    c.set_timeout(5000)
    c.write("{body}\n") else err
        return SendError(message: err.message)
    reply := c.read_line() else err
        return SendError(message: err.message)
    c.close()
    line := reply else
        return SendError(message: "the program closed the connection without a reply")
    line
