## Win64 calls to system DLL functions (ADR 0606): `libsys.NAME` calls on
## the x86-64 target. Each argument goes in the register its position names
## (rcx rdx r8 r9, or xmm0-3 for a float), the caller reserves 32 bytes of
## shadow space, and arguments beyond four go on the stack above it. The call
## is indirect through the import's slot in the PE import table (ADR 0598).
use mir
use codegen

WIN_INT_ARGS := [RCX, RDX, R8, R9]

## `call qword ptr [rip + slot]` for the import NAME: FF 15 and a rel32 to
## the symbol `imp:NAME`, which `compiler/obj/pe.ail` resolves.
pub fn Asm.call_import(mut self, name str)
    byte(255)
    byte(21)
    fixups.push(Fixup(at: code.len(), label: -1, sym: "imp:{name}", tail: 0))
    u32(0)

## The `libsys.NAME` call `i`: stack room for the shadow space and the
## stack arguments, the arguments in place, the indirect call, and the
## room given back. The result is rax, or xmm0 for a float (ADR 0606).
fn Gen.libsys_call(mut self, i mir.Inst)
    n := i.args.len()
    extra := if n > 4 then n - 4 else 0
    room := (32 + 8 * extra + 15) / 16 * 16
    a.alu_ri("sub", RSP, room)
    mut moves := List[Move]()
    for k in 0..n
        v := i.args[k]
        if k >= 4
            if f.vals[v].is_float()
                a.vmovsd_mr(at(RSP, 32 + 8 * (k - 4)), xmm(v, X0))
            else
                a.mov_mr(at(RSP, 32 + 8 * (k - 4)), gpr(v, S0))
        elif f.vals[v].is_float()
            moves.push(move_of(codegen.FLOAT_BASE + k, v))
        else
            moves.push(move_of(WIN_INT_ARGS[k], v))
    parallel(moves)
    a.call_import(i.name.replace("libsys.", ""))
    a.alu_ri("add", RSP, room)
    if i.dst >= 0
        if f.vals[i.dst].is_float()
            put_xmm(i.dst, 0)
        else
            put_gpr(i.dst, RAX)

## The Windows entry (ADR 0606): `_start` calls `main` and passes its result
## to kernel32's `ExitProcess`. The loader enters with rsp 8 mod 16, so
## `sub rsp, 40` aligns the stack for the calls. Unlike `generate`, it calls
## no runtime start-up or exit (`rt.init`, `rt.exit`), which use Linux system calls.
pub fn generate_windows(m mir.Module) codegen.Image
    mut img := codegen.new_image()
    for i in 0..m.strs.len()
        codegen.add_str(mut img, "d:s{i}", m.strs[i])
    mut a := new_asm()
    a.alu_ri("sub", RSP, 40)
    a.call_sym("main")
    a.mov_rr(RCX, RAX)
    a.call_import("ExitProcess")
    a.ud2()
    img.code = a.code
    for fx in a.fixups
        img.relocs.push(codegen.Reloc(at: fx.at, kind: "rel32", sym: fx.sym, tail: fx.tail))
    for f in m.funcs
        gen_func(mut img, m, f)
    img

## A module with one function, `main`, that calls kernel32's `GetStdHandle(-11)`
## and returns 7: the exit code under Wine shows the call went through the import
## table with its argument in rcx (ADR 0606).
pub fn win_sample() mir.Module
    mut h := mir.inst(0, "const", [])
    h.imm = -11
    mut call := mir.inst(1, "call", [0])
    call.name = "libsys.GetStdHandle"
    mut seven := mir.inst(2, "const", [])
    seven.imm = 7
    block := mir.Block(params: List[int](), insts: [h, call, seven], term: mir.return_of(2))
    main := mir.Func(name: "main", params: [], ret: mir.Ty.Int, blocks: [block], vals: [mir.Ty.Int, mir.Ty.Int, mir.Ty.Int], names: ["", "", ""])
    mir.Module(path: "win_sample.ail", funcs: [main], strs: [], sites: [], lines: [], files: ["win_sample.ail"], file_lines: [[]])
