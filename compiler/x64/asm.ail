## The x86-64 instruction encoder (ADR 0385): the instructions the code
## generator uses, encoded to bytes with AIL's own tables (ADR 0010: no
## external assembler). Registers are numbered as the hardware numbers them:
## rax 0, rcx 1, rdx 2, rbx 3, rsp 4, rbp 5, rsi 6, rdi 7, r8-r15 8-15;
## vector registers xmm0-xmm15 are 0-15 in instructions that take them.
## Floats use the VEX (AVX) forms, part of the x86-64-v3 baseline (plat.isa.1, ADR 0005).

pub RAX := 0
pub RCX := 1
pub RDX := 2
pub RBX := 3
pub RSP := 4
pub RBP := 5
pub RSI := 6
pub RDI := 7
pub R8 := 8
pub R9 := 9
pub R10 := 10
pub R11 := 11

## Condition codes (the low nibble of `jcc`/`setcc`).
pub CC_O := 0
pub CC_B := 2
pub CC_AE := 3
pub CC_E := 4
pub CC_NE := 5
pub CC_BE := 6
pub CC_A := 7
pub CC_P := 10
pub CC_NP := 11
pub CC_L := 12
pub CC_GE := 13
pub CC_LE := 14
pub CC_G := 15

## A memory operand: `[base + index * scale + disp]`, or with `base` -1,
## `[rip + disp]` to symbol `sym`.
pub struct Mem
    pub base int
    pub index int
    pub scale int
    pub disp int
    pub sym str

pub fn at(base int, disp int) Mem
    Mem(base: base, index: -1, scale: 1, disp: disp, sym: "")

pub fn at_index(base int, index int, scale int, disp int) Mem
    Mem(base: base, index: index, scale: scale, disp: disp, sym: "")

## `[rip + sym + disp]`: an address in the image, fixed when it is laid out.
pub fn at_sym(sym str, disp int) Mem
    Mem(base: -1, index: -1, scale: 1, disp: disp, sym: sym)

## A 32-bit field to patch once its target is placed: a local label, or a
## symbol of the image. The field is PC-relative to the end of the
## instruction, `tail` bytes after the field.
pub struct Fixup
    pub at int
    pub label int
    pub sym str
    pub tail int

pub struct Asm
    pub code List[u8]
    pub labels List[int]
    pub fixups List[Fixup]
    ## When `JUMP_LINE`, no jump, call or return, and no comparison joined to
    ## its conditional jump, crosses or ends on a line of that many bytes
    ## (native.jump.1, ADR 1096); 0 leaves them as they fall.
    pub window int
    ## Where the last flag-setting instruction starts and ends: a processor
    ## runs it and a conditional jump right after it as one operation.
    pub fuse int
    pub fuse_end int

## The bytes of a line of code for `Asm.window`: processors of 2015 to 2019
## decode a jump that crosses or ends on a 32-byte line many times slower
## (Intel's "jump conditional code" erratum; measured 9% on lzr and 20% on vm
## on ail-linux), and where a jump falls otherwise changes with any edit
## anywhere before it.
pub JUMP_LINE := 32

pub fn new_asm() Asm
    Asm(code: [], labels: [], fixups: [], window: 0, fuse: -1, fuse_end: -1)

## The instruction emitted since `start` sets the flags a jump may read.
fn Asm.flags_from(mut self, start int)
    self.fuse = start
    self.fuse_end = self.code.len()

## `n` bytes that do nothing, in the long forms.
fn Asm.nops(mut self, n int)
    mut left := n
    while left > 0
        k := left.min(8)
        match k
            1 => self.byte(144)
            2 =>
                self.byte(102)
                self.byte(144)
            3 =>
                self.byte(15)
                self.byte(31)
                self.byte(0)
            4 =>
                self.byte(15)
                self.byte(31)
                self.byte(64)
                self.byte(0)
            5 =>
                self.byte(15)
                self.byte(31)
                self.byte(68)
                self.byte(0)
                self.byte(0)
            6 =>
                self.byte(102)
                self.byte(15)
                self.byte(31)
                self.byte(68)
                self.byte(0)
                self.byte(0)
            7 =>
                self.byte(15)
                self.byte(31)
                self.byte(128)
                self.u32(0)
            _ =>
                self.byte(15)
                self.byte(31)
                self.byte(132)
                self.byte(0)
                self.u32(0)
        left -= k

## Move the instructions from `start` to the end past the next line when
## they cross one or end on one, filling with `nops` (native.jump.1).
fn Asm.keep_in_window(mut self, start int)
    end := self.code.len()
    if self.window == 0 or start % self.window == 0
        return
    if start / self.window == (end - 1) / self.window and end % self.window != 0
        return
    mut tail := List[u8]()
    for k in start..end
        tail.push(self.code[k])
    for _ in start..end
        self.code.pop()
    pad := self.window - start % self.window
    self.nops(pad)
    self.code.extend(tail)
    mut k := self.fixups.len() - 1
    while k >= 0 and self.fixups[k].at >= start
        self.fixups[k].at = self.fixups[k].at + pad
        k -= 1

fn Asm.byte(mut self, b int)
    self.code.push(b.bit_and(255).to_u8())

fn Asm.u32(mut self, v int)
    for i in 0..4
        self.code.push(v.shr(8 * i).bit_and(255).to_u8())

fn Asm.u64(mut self, v int)
    for i in 0..8
        self.code.push(v.shr(8 * i).bit_and(255).to_u8())

fn fits8(v int) bool
    v >= -128 and v <= 127

pub fn fits32(v int) bool
    v >= -2147483648 and v <= 2147483647

## A new label, not yet placed.
fn Asm.label(mut self) int
    self.labels.push(-1)
    self.labels.len() - 1

fn Asm.bind(mut self, l int)
    self.labels[l] = self.code.len()
    self.fuse_end = -1

fn ext(r int) int
    if r >= 8 then 1 else 0

fn low(r int) int
    r.bit_and(7)

## REX prefix: `w` 64-bit operand, `r` the ModRM reg field, `x` the SIB
## index, `b` the ModRM rm or SIB base; `force` for byte registers 4-7.
fn Asm.rex(mut self, w int, r int, x int, b int, force bool)
    v := 64 + w * 8 + ext(r) * 4 + ext(x) * 2 + ext(b)
    if v != 64 or force
        self.byte(v)

fn Asm.modrm_reg(mut self, reg int, rm int)
    self.byte(192 + low(reg) * 8 + low(rm))

## ModRM, SIB and displacement for a memory operand; `tail` is the number of
## immediate bytes that follow in this instruction (for RIP-relative fields).
fn Asm.modrm_mem(mut self, reg int, m Mem, tail int)
    r := low(reg) * 8
    if m.base < 0
        self.byte(r + 5)
        self.fixups.push(Fixup(at: self.code.len(), label: -1, sym: m.sym, tail: tail))
        self.u32(m.disp)
        return
    need_sib := m.index >= 0 or low(m.base) == 4
    rm := if need_sib then 4 else low(m.base)
    mut md := 2
    if m.disp == 0 and low(m.base) != 5
        md = 0
    elif fits8(m.disp)
        md = 1
    self.byte(md * 64 + r + rm)
    if need_sib
        idx := if m.index >= 0 then low(m.index) else 4
        ss := match m.scale
            2 => 1
            4 => 2
            8 => 3
            _ => 0
        self.byte(ss * 64 + idx * 8 + low(m.base))
    if md == 1
        self.byte(m.disp)
    elif md == 2
        self.u32(m.disp)

fn index_of(m Mem) int
    if m.index >= 0 then m.index else 0

fn base_of(m Mem) int
    if m.base >= 0 then m.base else 0

## `op reg, r/m` with a one-byte opcode (or `0F op` when `two`), 64-bit.
fn Asm.op_rr(mut self, two bool, op int, reg int, rm int)
    self.rex(1, reg, 0, rm, false)
    if two
        self.byte(15)
    self.byte(op)
    self.modrm_reg(reg, rm)

fn Asm.op_rm(mut self, two bool, op int, reg int, m Mem)
    self.rex(1, reg, index_of(m), base_of(m), false)
    if two
        self.byte(15)
    self.byte(op)
    self.modrm_mem(reg, m, 0)

# ---- moves ----

pub fn Asm.mov_rr(mut self, dst int, src int)
    if dst != src
        self.op_rr(false, 139, dst, src)

## `mov dst, imm`: the shortest of `xor`, `mov r32`, sign-extended `mov
## r/m64, imm32`, and `movabs`.
pub fn Asm.mov_ri(mut self, dst int, v int)
    if v == 0
        self.rex(0, dst, 0, dst, false)
        self.byte(49)
        self.modrm_reg(dst, dst)
    elif v > 0 and v <= 4294967295
        self.rex(0, 0, 0, dst, false)
        self.byte(184 + low(dst))
        self.u32(v)
    elif fits32(v)
        self.rex(1, 0, 0, dst, false)
        self.byte(199)
        self.modrm_reg(0, dst)
        self.u32(v)
    else
        self.rex(1, 0, 0, dst, false)
        self.byte(184 + low(dst))
        self.u64(v)

pub fn Asm.mov_rm(mut self, dst int, m Mem)
    self.op_rm(false, 139, dst, m)

pub fn Asm.mov_mr(mut self, m Mem, src int)
    self.op_rm(false, 137, src, m)

## `mov qword [m], imm32` (sign-extended).
pub fn Asm.mov_mi(mut self, m Mem, v int)
    self.rex(1, 0, index_of(m), base_of(m), false)
    self.byte(199)
    self.modrm_mem(0, m, 4)
    self.u32(v)

## `mov byte [m], imm8`.
pub fn Asm.mov8_mi(mut self, m Mem, v int)
    self.rex(0, 0, index_of(m), base_of(m), false)
    self.byte(198)
    self.modrm_mem(0, m, 1)
    self.byte(v)

pub fn Asm.movzx8_rm(mut self, dst int, m Mem)
    self.rex(0, dst, index_of(m), base_of(m), false)
    self.byte(15)
    self.byte(182)
    self.modrm_mem(dst, m, 0)

pub fn Asm.mov8_mr(mut self, m Mem, src int)
    self.rex(0, src, index_of(m), base_of(m), src >= 4)
    self.byte(136)
    self.modrm_mem(src, m, 0)

## `movzx r32, word [m]`, and `mov r32, dword [m]` (which zero-extends).
pub fn Asm.movzx16_rm(mut self, dst int, m Mem)
    self.rex(0, dst, index_of(m), base_of(m), false)
    self.byte(15)
    self.byte(183)
    self.modrm_mem(dst, m, 0)

pub fn Asm.mov32_rm(mut self, dst int, m Mem)
    self.rex(0, dst, index_of(m), base_of(m), false)
    self.byte(139)
    self.modrm_mem(dst, m, 0)

## `mov word [m], r16` and `mov dword [m], r32`.
pub fn Asm.mov16_mr(mut self, m Mem, src int)
    self.byte(102)
    self.rex(0, src, index_of(m), base_of(m), false)
    self.byte(137)
    self.modrm_mem(src, m, 0)

pub fn Asm.mov32_mr(mut self, m Mem, src int)
    self.rex(0, src, index_of(m), base_of(m), false)
    self.byte(137)
    self.modrm_mem(src, m, 0)

## `mfence`: all earlier loads and stores before all later ones.
pub fn Asm.mfence(mut self)
    self.byte(15)
    self.byte(174)
    self.byte(240)

## `rep stosb` and `rep stosq`: store `al` or `rax` at `[rdi]`, `rcx` times.
pub fn Asm.rep_stosb(mut self)
    self.byte(243)
    self.byte(170)

pub fn Asm.rep_stosq(mut self)
    self.byte(243)
    self.byte(72)
    self.byte(171)

pub fn Asm.lea(mut self, dst int, m Mem)
    self.op_rm(false, 141, dst, m)

# ---- integer arithmetic ----

## The ALU operations' `/digit` (for immediates); the `reg, r/m` opcode is
## `digit * 8 + 3`.
pub fn alu_digit(op str) int
    match op
        "add" => 0
        "or" => 1
        "and" => 4
        "sub" => 5
        "xor" => 6
        "cmp" => 7
        _ => unreachable("not an ALU operation: {op}")

pub fn Asm.alu_rr(mut self, op str, dst int, src int)
    start := self.code.len()
    self.op_rr(false, alu_digit(op) * 8 + 3, dst, src)
    self.flags_from(start)

pub fn Asm.alu_rm(mut self, op str, dst int, m Mem)
    start := self.code.len()
    self.op_rm(false, alu_digit(op) * 8 + 3, dst, m)
    self.flags_from(start)

pub fn Asm.alu_ri(mut self, op str, dst int, v int)
    start := self.code.len()
    self.alu_ri_in(op, dst, v)
    self.flags_from(start)

fn Asm.alu_ri_in(mut self, op str, dst int, v int)
    self.rex(1, 0, 0, dst, false)
    if fits8(v)
        self.byte(131)
        self.modrm_reg(alu_digit(op), dst)
        self.byte(v)
    else
        self.byte(129)
        self.modrm_reg(alu_digit(op), dst)
        self.u32(v)

## `op qword [m], imm` (for `cmp [m], imm`).
pub fn Asm.alu_mi(mut self, op str, m Mem, v int)
    self.rex(1, 0, index_of(m), base_of(m), false)
    if fits8(v)
        self.byte(131)
        self.modrm_mem(alu_digit(op), m, 1)
        self.byte(v)
    else
        self.byte(129)
        self.modrm_mem(alu_digit(op), m, 4)
        self.u32(v)

pub fn Asm.imul_rr(mut self, dst int, src int)
    self.op_rr(true, 175, dst, src)

pub fn Asm.imul_rm(mut self, dst int, m Mem)
    self.op_rm(true, 175, dst, m)

## `imul dst, src, imm32`
pub fn Asm.imul_rri(mut self, dst int, src int, v int)
    self.rex(1, dst, 0, src, false)
    if fits8(v)
        self.byte(107)
        self.modrm_reg(dst, src)
        self.byte(v)
    else
        self.byte(105)
        self.modrm_reg(dst, src)
        self.u32(v)

pub fn Asm.test_rr(mut self, a int, b int)
    start := self.code.len()
    self.op_rr(false, 133, b, a)
    self.flags_from(start)

## `test r, imm32` (the immediate is sign-extended).
pub fn Asm.test_ri(mut self, r int, v int)
    self.rex(1, 0, 0, r, false)
    self.byte(247)
    self.modrm_reg(0, r)
    self.u32(v)
    self.flags_from(self.code.len() - 7)

pub fn Asm.neg(mut self, r int)
    self.rex(1, 0, 0, r, false)
    self.byte(247)
    self.modrm_reg(3, r)

pub fn Asm.not_reg(mut self, r int)
    self.rex(1, 0, 0, r, false)
    self.byte(247)
    self.modrm_reg(2, r)

pub fn Asm.cqo(mut self)
    self.byte(72)
    self.byte(153)

## `imul r`: the signed 128-bit product of `rax` and `r` in `rdx:rax`.
pub fn Asm.imul1(mut self, r int)
    self.rex(1, 0, 0, r, false)
    self.byte(247)
    self.modrm_reg(5, r)

pub fn Asm.idiv(mut self, r int)
    self.rex(1, 0, 0, r, false)
    self.byte(247)
    self.modrm_reg(7, r)

## `shl`, `shr` (logical) or `sar` by an immediate.
pub fn Asm.shift_ri(mut self, op str, r int, n int)
    self.rex(1, 0, 0, r, false)
    self.byte(193)
    self.modrm_reg(shift_digit(op), r)
    self.byte(n)

## The same shifts by `cl`.
pub fn Asm.shift_cl(mut self, op str, r int)
    self.rex(1, 0, 0, r, false)
    self.byte(211)
    self.modrm_reg(shift_digit(op), r)

fn shift_digit(op str) int
    match op
        "shl" => 4
        "shr" => 5
        _ => 7

## `setcc r8` then `movzx r64, r8`: a `bool` from the flags.
pub fn Asm.setcc(mut self, cc int, r int)
    self.rex(0, 0, 0, r, r >= 4)
    self.byte(15)
    self.byte(144 + cc)
    self.modrm_reg(0, r)

pub fn Asm.movzx8_rr(mut self, dst int, src int)
    self.rex(0, dst, 0, src, src >= 4)
    self.byte(15)
    self.byte(182)
    self.modrm_reg(dst, src)

# ---- control ----

## A 32-bit PC-relative field to label `l`.
fn Asm.rel_label(mut self, l int)
    self.fixups.push(Fixup(at: self.code.len(), label: l, sym: "", tail: 0))
    self.u32(0)

pub fn Asm.jmp(mut self, l int)
    start := self.code.len()
    self.byte(233)
    self.rel_label(l)
    self.keep_in_window(start)

pub fn Asm.jcc(mut self, cc int, l int)
    start := if self.fuse_end == self.code.len() then self.fuse else self.code.len()
    self.byte(15)
    self.byte(128 + cc)
    self.rel_label(l)
    self.keep_in_window(start)

## `jmp r`: an indirect jump (a `switch`, native.match.2).
pub fn Asm.jmp_reg(mut self, r int)
    start := self.code.len()
    self.rex(0, 0, 0, r, false)
    self.byte(255)
    self.byte(224 + low(r))
    self.keep_in_window(start)

## `lea dst, [rip + l]`: the address of local label `l`.
pub fn Asm.lea_label(mut self, dst int, l int)
    self.rex(1, dst, 0, 0, false)
    self.byte(141)
    self.byte(low(dst) * 8 + 5)
    self.rel_label(l)

## `movsxd dst, dword [m]`: a signed 32-bit load.
pub fn Asm.movsxd_rm(mut self, dst int, m Mem)
    self.op_rm(false, 99, dst, m)

## A jump table entry: the 32-bit distance from `table`, the table's start in
## the code, to label `l` (`tail` makes the field relative to `table`).
pub fn Asm.table_entry(mut self, table int, l int)
    self.fixups.push(Fixup(
        at: self.code.len(),
        label: l,
        sym: "",
        tail: table - (self.code.len() + 4),
    ))
    self.u32(0)

## The current offset in the code.
pub fn Asm.here(self) int
    self.code.len()

pub fn Asm.call_sym(mut self, sym str)
    self.byte(232)
    self.fixups.push(Fixup(at: self.code.len(), label: -1, sym: sym, tail: 0))
    self.u32(0)
    self.keep_in_window(self.code.len() - 5)

pub fn Asm.call_reg(mut self, r int)
    start := self.code.len()
    self.rex(0, 0, 0, r, false)
    self.byte(255)
    self.byte(208 + low(r))
    self.keep_in_window(start)

pub fn Asm.ret(mut self)
    self.byte(195)
    self.keep_in_window(self.code.len() - 1)

pub fn Asm.push(mut self, r int)
    self.rex(0, 0, 0, r, false)
    self.byte(80 + low(r))

pub fn Asm.pop(mut self, r int)
    self.rex(0, 0, 0, r, false)
    self.byte(88 + low(r))

pub fn Asm.syscall(mut self)
    self.byte(15)
    self.byte(5)

## Atomic read-modify-write on a 64-bit memory operand (ADR 0600): `xchg`
## is implicitly locked; `cmpxchg` compares with and returns in rax; `xadd`
## returns the old value in `r`.
pub fn Asm.xchg_mr(mut self, m Mem, r int)
    self.op_rm(false, 135, r, m)

## `xchg a, b` between two registers: one parallel move's cycle, broken
## without a scratch register (ADR 1049).
pub fn Asm.xchg_rr(mut self, a int, b int)
    self.op_rr(false, 135, a, b)

pub fn Asm.lock_cmpxchg(mut self, m Mem, r int)
    self.byte(240)
    self.op_rm(true, 177, r, m)

pub fn Asm.lock_xadd(mut self, m Mem, r int)
    self.byte(240)
    self.op_rm(true, 193, r, m)

## `out dx, al`, `in al, dx` and `hlt` (freestanding targets, ADR 0953).
pub fn Asm.out_dx_al(mut self)
    self.byte(238)

pub fn Asm.in_al_dx(mut self)
    self.byte(236)

pub fn Asm.hlt(mut self)
    self.byte(244)

pub fn Asm.ud2(mut self)
    self.byte(15)
    self.byte(11)

## Patch every jump to a local label; symbol fixups stay for the linker.
pub fn Asm.resolve_labels(mut self)
    mut rest := List[Fixup]()
    for f in self.fixups
        if f.label < 0
            rest.push(f)
            continue
        to := self.labels[f.label]
        if to < 0
            unreachable("label {f.label} was never placed")
        # A field is relative to the end of its instruction, `tail` bytes on.
        rel := to - (f.at + 4 + f.tail)
        for i in 0..4
            self.code[f.at + i] = rel.shr(8 * i).bit_and(255).to_u8()
    self.fixups = rest

# ---- vector (VEX) ----

## A VEX-encoded instruction: `pp` (0 none, 1 66, 2 F3, 3 F2), `map` (1 0F,
## 2 0F38, 3 0F3A), `w`, the opcode, the ModRM reg field, the extra source
## `vvvv` (0 when unused), and a register `rm`.
fn Asm.vex_rr(mut self, pp int, map int, w int, op int, reg int, vvvv int, rm int)
    self.vex_prefix(pp, map, w, reg, 0, rm, vvvv)
    self.byte(op)
    self.modrm_reg(reg, rm)

fn Asm.vex_rm(mut self, pp int, map int, w int, op int, reg int, vvvv int, m Mem, tail int)
    self.vex_prefix(pp, map, w, reg, index_of(m), base_of(m), vvvv)
    self.byte(op)
    self.modrm_mem(reg, m, tail)

fn Asm.vex_prefix(mut self, pp int, map int, w int, r int, x int, b int, vvvv int)
    self.vex_prefix_l(pp, map, w, r, x, b, vvvv, 0)

## The same with the vector length bit `l`: 0 for 128 bits and scalars, 1 for 256.
fn Asm.vex_prefix_l(mut self, pp int, map int, w int, r int, x int, b int, vvvv int, l int)
    nr := 1 - ext(r)
    nx := 1 - ext(x)
    nb := 1 - ext(b)
    tail := (15 - vvvv) * 8 + l * 4 + pp
    if map == 1 and w == 0 and nx == 1 and nb == 1
        self.byte(197)
        self.byte(nr * 128 + tail)
    else
        self.byte(196)
        self.byte(nr * 128 + nx * 64 + nb * 32 + map)
        self.byte(w * 128 + tail)

## `shlx dst, src, count` and `sarx dst, src, count` (BMI2, x86-64-v3): any
## register holds the count, and the flags are untouched.
pub fn Asm.shlx(mut self, dst int, src int, count int)
    self.vex_rr(1, 2, 1, 247, dst, count, src)

pub fn Asm.sarx(mut self, dst int, src int, count int)
    self.vex_rr(2, 2, 1, 247, dst, count, src)

## `vmovsd xmm, [m]` and `vmovsd [m], xmm`
pub fn Asm.vmovsd_rm(mut self, dst int, m Mem)
    self.vex_rm(3, 1, 0, 16, dst, 0, m, 0)

pub fn Asm.vmovsd_mr(mut self, m Mem, src int)
    self.vex_rm(3, 1, 0, 17, src, 0, m, 0)

## `vmovapd dst, src` (a register copy)
pub fn Asm.vmov_rr(mut self, dst int, src int)
    if dst != src
        self.vex_rr(1, 1, 0, 40, dst, 0, src)

## `vaddsd`, `vsubsd`, `vmulsd`, `vdivsd`, `vsqrtsd`: `dst = a op b`.
pub fn sd_opcode(op str) int
    match op
        "fadd" => 88
        "fmul" => 89
        "fsub" => 92
        "fdiv" => 94
        "sqrt" => 81
        _ => unreachable("not a float operation: {op}")

pub fn Asm.vsd_rrr(mut self, op str, dst int, a int, b int)
    self.vex_rr(3, 1, 0, sd_opcode(op), dst, a, b)

pub fn Asm.vsd_rrm(mut self, op str, dst int, a int, m Mem)
    self.vex_rm(3, 1, 0, sd_opcode(op), dst, a, m, 0)

## `vxorpd` (87) and `vandpd` (84): `dst = a op b`, all registers.
pub fn Asm.vpd_rrr(mut self, op int, dst int, a int, b int)
    self.vex_rr(1, 1, 0, op, dst, a, b)

## `vaddpd` `vsubpd` `vmulpd` `vdivpd` on xmm registers: `dst = a op b`, two doubles (native.vec.3).
pub fn Asm.vpd_op(mut self, op str, dst int, a int, b int)
    self.vex_rr(1, 1, 0, sd_opcode(op), dst, a, b)

## `vunpcklpd` (dst = a[0], b[0]) and `vunpckhpd` (dst = a[1], b[1]) on xmm registers.
pub fn Asm.vunpcklpd(mut self, dst int, a int, b int)
    self.vex_rr(1, 1, 0, 20, dst, a, b)

pub fn Asm.vunpckhpd(mut self, dst int, a int, b int)
    self.vex_rr(1, 1, 0, 21, dst, a, b)

## `vmovupd xmm, [m]` and `vmovupd [m], xmm`: two doubles, unaligned.
pub fn Asm.vmovupd_rm128(mut self, dst int, m Mem)
    self.vex_rm(1, 1, 0, 16, dst, 0, m, 0)

pub fn Asm.vmovupd_mr128(mut self, m Mem, src int)
    self.vex_rm(1, 1, 0, 17, src, 0, m, 0)

## `vroundsd dst, a, b, mode` (mode 9: floor, 10: ceil).
pub fn Asm.vroundsd(mut self, dst int, a int, b int, mode int)
    self.vex_rr(1, 3, 0, 11, dst, a, b)
    self.byte(mode)

## `vucomisd a, b`: the flags of comparing `a` with `b`.
pub fn Asm.vucomisd(mut self, a int, b int)
    self.vex_rr(1, 1, 0, 46, a, 0, b)

## `vmovss` between an xmm register and memory: one single (a load zeroes the
## rest of the register).
pub fn Asm.vmovss_rm(mut self, dst int, m Mem)
    self.vex_rm(2, 1, 0, 16, dst, 0, m, 0)

pub fn Asm.vmovss_mr(mut self, m Mem, src int)
    self.vex_rm(2, 1, 0, 17, src, 0, m, 0)

## `vaddss`, `vsubss`, `vmulss`, `vdivss`: `dst = a op b` on singles.
pub fn Asm.vss_rrr(mut self, op str, dst int, a int, b int)
    self.vex_rr(2, 1, 0, sd_opcode(op), dst, a, b)

## `vcvtsd2ss dst, a, b` and `vcvtss2sd dst, a, b`: `b`'s low double as a
## single in `dst`, and back.
pub fn Asm.vcvtsd2ss(mut self, dst int, a int, b int)
    self.vex_rr(3, 1, 0, 90, dst, a, b)

pub fn Asm.vcvtss2sd(mut self, dst int, a int, b int)
    self.vex_rr(2, 1, 0, 90, dst, a, b)

# ---- 256-bit packed double operations (AVX), for the vector kernels ----

fn Asm.vex256_rr(mut self, pp int, map int, op int, reg int, vvvv int, rm int)
    self.vex_prefix_l(pp, map, 0, reg, 0, rm, vvvv, 1)
    self.byte(op)
    self.modrm_reg(reg, rm)

fn Asm.vex256_rm(mut self, pp int, map int, op int, reg int, vvvv int, m Mem)
    self.vex_prefix_l(pp, map, 0, reg, index_of(m), base_of(m), vvvv, 1)
    self.byte(op)
    self.modrm_mem(reg, m, 0)

## `vmovupd ymm, [m]` and `vmovupd [m], ymm`.
pub fn Asm.vmovupd_rm(mut self, dst int, m Mem)
    self.vex256_rm(1, 1, 16, dst, 0, m)

pub fn Asm.vmovupd_mr(mut self, m Mem, src int)
    self.vex256_rm(1, 1, 17, src, 0, m)

## `vaddpd`, `vsubpd`, `vmulpd`, `vdivpd` on ymm registers: `dst = a op b`.
pub fn Asm.vpd256_rrr(mut self, op str, dst int, a int, b int)
    self.vex256_rr(1, 1, sd_opcode(op), dst, a, b)

## `vaddpd`, `vmulpd` with a memory operand: `dst = a op [m]` on ymm registers.
pub fn Asm.vpd256_rrm(mut self, op str, dst int, a int, m Mem)
    self.vex256_rm(1, 1, sd_opcode(op), dst, a, m)

## `vandpd` (84) and `vandnpd` (85) on ymm registers: `dst = a & b` and
## `dst = ~a & b`; the memory form takes `b` from `[m]`.
pub fn Asm.vlogic256_rrr(mut self, op int, dst int, a int, b int)
    self.vex256_rr(1, 1, op, dst, a, b)

pub fn Asm.vlogic256_rrm(mut self, op int, dst int, a int, m Mem)
    self.vex256_rm(1, 1, op, dst, a, m)

## `vcmppd dst, a, b, pred` on ymm registers (`pred` 17: `a < b`, 18: `a <= b`,
## 30: `a > b`, all false for NaN); the memory form takes `b` from `[m]`.
pub fn Asm.vcmppd_rrr(mut self, dst int, a int, b int, pred int)
    self.vex256_rr(1, 1, 194, dst, a, b)
    self.byte(pred)

pub fn Asm.vcmppd_rrm(mut self, dst int, a int, m Mem, pred int)
    self.vex256_rm(1, 1, 194, dst, a, m)
    self.byte(pred)

## `vroundpd dst, src, mode` (9: floor, 10: ceil, both without the inexact trap).
pub fn Asm.vroundpd(mut self, dst int, src int, mode int)
    self.vex256_rr(1, 3, 9, dst, 0, src)
    self.byte(mode)

## `vblendvpd dst, a, b, mask`: each lane of `b` where the lane of `mask` has its
## sign bit set, else of `a`.
pub fn Asm.vblendvpd(mut self, dst int, a int, b int, mask int)
    self.vex256_rr(1, 3, 75, dst, a, b)
    self.byte(mask * 16)

## `vcvtpd2dq xmm, ymm` (four doubles to four `int32`, rounded to nearest) and
## `vpmovsxdq ymm, xmm` (four `int32` to four `int64`).
pub fn Asm.vcvtpd2dq(mut self, dst int, src int)
    self.vex256_rr(3, 1, 230, dst, 0, src)

pub fn Asm.vpmovsxdq(mut self, dst int, src int)
    self.vex256_rr(1, 2, 37, dst, 0, src)

## `vpaddq dst, a, b`, `vpmuldq dst, a, b` (the signed low 32 bits of each
## lane multiplied to 64) and `vpbroadcastq dst, xmm` on ymm registers.
pub fn Asm.vpaddq_rrr(mut self, dst int, a int, b int)
    self.vex256_rr(1, 1, 212, dst, a, b)

pub fn Asm.vpmuldq_rrr(mut self, dst int, a int, b int)
    self.vex256_rr(1, 2, 40, dst, a, b)

pub fn Asm.vpbroadcastq(mut self, dst int, src int)
    self.vex256_rr(1, 2, 89, dst, 0, src)

## `vpaddq dst, a, [m]` and `vpsllq dst, src, imm` on ymm registers.
pub fn Asm.vpaddq_rrm(mut self, dst int, a int, m Mem)
    self.vex256_rm(1, 1, 212, dst, a, m)

pub fn Asm.vpsllq(mut self, dst int, src int, imm int)
    self.vex256_rr(1, 1, 115, 6, dst, src)
    self.byte(imm)

## `vmovmskpd r32, ymm`: the four sign bits.
pub fn Asm.vmovmskpd(mut self, dst int, src int)
    self.vex256_rr(1, 1, 80, dst, 0, src)

## `vmovups xmm, [m]`: four singles into the low half.
pub fn Asm.vmovups_rm128(mut self, dst int, m Mem)
    self.vex_rm(0, 1, 0, 16, dst, 0, m, 0)

## `vmovups` between a ymm register and memory: eight singles.
pub fn Asm.vmovups_rm(mut self, dst int, m Mem)
    self.vex256_rm(0, 1, 16, dst, 0, m)

pub fn Asm.vmovups_mr(mut self, m Mem, src int)
    self.vex256_rm(0, 1, 17, src, 0, m)

## `vaddps`, `vsubps`, `vmulps`, `vdivps` on ymm registers: `dst = a op b`.
pub fn Asm.vps256_rrr(mut self, op str, dst int, a int, b int)
    self.vex256_rr(0, 1, sd_opcode(op), dst, a, b)

## `vbroadcastss ymm, xmm`: the low single in all eight lanes.
pub fn Asm.vbroadcastss(mut self, dst int, src int)
    self.vex256_rr(1, 2, 24, dst, 0, src)

## `vbroadcastsd ymm, xmm`: the low double in all four lanes.
pub fn Asm.vbroadcastsd(mut self, dst int, src int)
    self.vex256_rr(1, 2, 25, dst, 0, src)

## `vcvtps2pd ymm, m128` (four singles from memory to four doubles) and
## `vmovups m128, xmm` (four singles to memory).
pub fn Asm.vcvtps2pd_rm(mut self, dst int, m Mem)
    self.vex256_rm(0, 1, 90, dst, 0, m)

pub fn Asm.vmovups_mr128(mut self, m Mem, src int)
    self.vex_rm(0, 1, 0, 17, src, 0, m, 0)

## `vcvtpd2ps xmm, ymm` (four doubles to four singles) and
## `vcvtps2pd ymm, xmm`.
pub fn Asm.vcvtpd2ps(mut self, dst int, src int)
    self.vex256_rr(1, 1, 90, dst, 0, src)

pub fn Asm.vcvtps2pd(mut self, dst int, src int)
    self.vex256_rr(0, 1, 90, dst, 0, src)

pub fn Asm.vzeroupper(mut self)
    self.byte(197)
    self.byte(248)
    self.byte(119)

## `vcvtsi2sd dst, dst, r64` and `vcvttsd2si r64, xmm`.
pub fn Asm.vcvtsi2sd(mut self, dst int, src int)
    self.vex_rr(3, 1, 1, 42, dst, dst, src)

pub fn Asm.vcvttsd2si(mut self, dst int, src int)
    self.vex_rr(3, 1, 1, 44, dst, 0, src)

## `vmovq xmm, r64` and `vmovq r64, xmm`.
pub fn Asm.vmovq_xr(mut self, dst int, src int)
    self.vex_rr(1, 1, 1, 110, dst, 0, src)

pub fn Asm.vmovq_rx(mut self, dst int, src int)
    self.vex_rr(1, 1, 1, 126, src, 0, dst)

# ---- SSE (legacy encodings), for the AES and GHASH kernels ----

## `66 [REX] 0F [38|3A] op /r` with an xmm register `rm`: `esc` 0 is `0F op`,
## 1 is `0F 38 op`, 2 is `0F 3A op`; `pre` is the mandatory prefix (0x66,
## 0xF3, or 0 for none).
fn Asm.sse_head(mut self, pre int, esc int, op int, reg int, x int, b int)
    if pre != 0
        self.byte(pre)
    self.rex(0, reg, x, b, false)
    self.byte(15)
    if esc == 1
        self.byte(56)
    elif esc == 2
        self.byte(58)
    self.byte(op)

pub fn Asm.sse_rr(mut self, pre int, esc int, op int, reg int, rm int)
    self.sse_head(pre, esc, op, reg, 0, rm)
    self.modrm_reg(reg, rm)

pub fn Asm.sse_rm(mut self, pre int, esc int, op int, reg int, m Mem)
    self.sse_head(pre, esc, op, reg, index_of(m), base_of(m))
    self.modrm_mem(reg, m, 0)

## `movdqu xmm, [m]` and `movdqu [m], xmm`.
pub fn Asm.movdqu_rm(mut self, dst int, m Mem)
    self.sse_rm(243, 0, 111, dst, m)

pub fn Asm.movdqu_mr(mut self, m Mem, src int)
    self.sse_rm(243, 0, 127, src, m)

## `movdqa dst, src`, `pxor`, `por`, `pshufb` and `aesenc`/`aesenclast` on
## xmm registers (AES-NI, PCLMULQDQ and SSSE3).
pub fn Asm.movdqa_rr(mut self, dst int, src int)
    self.sse_rr(102, 0, 111, dst, src)

pub fn Asm.pxor_rr(mut self, dst int, src int)
    self.sse_rr(102, 0, 239, dst, src)

pub fn Asm.por_rr(mut self, dst int, src int)
    self.sse_rr(102, 0, 235, dst, src)

pub fn Asm.pshufb_rr(mut self, dst int, src int)
    self.sse_rr(102, 1, 0, dst, src)

pub fn Asm.aesenc_rr(mut self, dst int, src int)
    self.sse_rr(102, 1, 220, dst, src)

pub fn Asm.aesenclast_rr(mut self, dst int, src int)
    self.sse_rr(102, 1, 221, dst, src)

## `pclmulqdq dst, src, imm`.
pub fn Asm.pclmulqdq(mut self, dst int, src int, imm int)
    self.sse_rr(102, 2, 68, dst, src)
    self.byte(imm)

## Shifts of an xmm register by an immediate: `kind` is "pslld", "psrld",
## "pslldq" or "psrldq".
pub fn Asm.sse_shift(mut self, kind str, r int, n int)
    op := if kind == "pslldq" or kind == "psrldq" then 115 else 114
    digit := match kind
        "pslld" => 6
        "psrld" => 2
        "pslldq" => 7
        _ => 3
    self.byte(102)
    self.rex(0, 0, 0, r, false)
    self.byte(15)
    self.byte(op)
    self.modrm_reg(digit, r)
    self.byte(n)

## `cpuid`.
pub fn Asm.cpuid(mut self)
    self.byte(15)
    self.byte(162)
