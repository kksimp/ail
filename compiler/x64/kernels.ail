## Vector kernels for the tensor runtime (ADR 0815): hand-assembled AVX loops
## that replace the functions of `compiler/rt/native/tensor.ail` named
## `rt.vec_*` (their AIL bodies are the scalar definitions and the
## reference). Each works four doubles at a time and then element by element,
## with an IEEE operation per element and no fused multiply-add, so the result
## is bit for bit the scalar one; a non-zero `r` rounds every result to `f32`
## (`Tensor[f32]` keeps its elements rounded). They use rax, rcx..r11 and
## xmm0..xmm4 only, which are not preserved by calls (native-abi.md §1).
use codegen

## The kernels this file assembles.
pub fn is_kernel(name str) bool
    name == "rt.vec_axpy"
        or name == "rt.vec_axpyi"
        or name == "rt.vec_axpyf"
        or name == "rt.vec_escape"
        or name == "rt.vec_zip"
        or name == "rt.vec_scal"
        or name == "rt.vec_axpy32"
        or name == "rt.vec_zip32"
        or name == "rt.vec_widen"
        or name == "rt.vec_narrow"
        or name == "rt.vec_scal32"
        or name == "rt.vec_sum16"
        or name == "rt.vec_sum16_32"
        or name == "rt.vec_exp"
        or name == "rt.fill"
        or is_aes_kernel(name)

## Add the kernel `name` to `img`.
pub fn gen_kernel(mut img codegen.Image, name str)
    mut a := new_asm()
    # As in `gen_func`: jumps stay inside 32-byte lines (native.jump.1).
    lined := jump_lines()
    a.window = if lined then JUMP_LINE else 0
    match name
        "rt.vec_axpy" => kernel_axpy(mut a)
        "rt.vec_axpyi" => kernel_axpyi(mut a)
        "rt.vec_axpyf" => kernel_axpyf(mut a)
        "rt.vec_escape" => kernel_escape(mut a)
        "rt.vec_zip" => kernel_zip(mut a)
        "rt.vec_axpy32" => kernel_axpy32(mut a)
        "rt.vec_zip32" => kernel_zip32(mut a)
        "rt.vec_widen" => kernel_widen(mut a)
        "rt.vec_narrow" => kernel_narrow(mut a)
        "rt.vec_scal32" => kernel_scal32(mut a)
        "rt.vec_sum16" => kernel_sum16(mut a, false)
        "rt.vec_sum16_32" => kernel_sum16(mut a, true)
        "rt.vec_exp" => kernel_exp(mut a)
        "rt.fill" => kernel_fill(mut a)
        "rt.aes_hw_ok" | "rt.aes_hw_blocks" | "rt.aes_hw_ghash" => gen_aes_kernel(mut a, name)
        _ => kernel_scal(mut a)
    a.resolve_labels()
    int3 := 204
    while lined and img.code.len() % JUMP_LINE != 0
        img.code.push(int3.to_u8())
    base := img.code.len()
    img.funcs[name] = base
    img.code.extend(a.code)

## `rt.fill(p, n, v, size)`: store the low `size` bytes (1 or 8) of `v` in `n`
## consecutive elements from `p`. rdi = p, rsi = n, rdx = v, rcx = size. A
## long fill is `rep stosb`/`stosq`; a short one a loop, since the string
## instructions take a few dozen cycles to start.
fn kernel_fill(mut a Asm)
    words := a.label()
    small_bytes := a.label()
    small_words := a.label()
    done := a.label()
    bytes_loop := a.label()
    words_loop := a.label()
    a.alu_ri("cmp", RCX, 8)
    a.jcc(CC_E, words)
    a.alu_ri("cmp", RSI, 64)
    a.jcc(CC_B, small_bytes)
    a.mov_rr(RCX, RSI)
    a.mov_rr(RAX, RDX)
    a.rep_stosb()
    a.ret()
    a.bind(small_bytes)
    a.alu_ri("cmp", RSI, 0)
    a.jcc(CC_E, done)
    a.bind(bytes_loop)
    a.mov8_mr(at(RDI, 0), RDX)
    a.alu_ri("add", RDI, 1)
    a.alu_ri("sub", RSI, 1)
    a.jcc(CC_NE, bytes_loop)
    a.ret()
    a.bind(words)
    a.alu_ri("cmp", RSI, 16)
    a.jcc(CC_B, small_words)
    a.mov_rr(RCX, RSI)
    a.mov_rr(RAX, RDX)
    a.rep_stosq()
    a.ret()
    a.bind(small_words)
    a.alu_ri("cmp", RSI, 0)
    a.jcc(CC_E, done)
    a.bind(words_loop)
    a.mov_mr(at(RDI, 0), RDX)
    a.alu_ri("add", RDI, 8)
    a.alu_ri("sub", RSI, 1)
    a.jcc(CC_NE, words_loop)
    a.bind(done)
    a.ret()

## Round the four doubles of ymm`x` to `f32` and back, through xmm3.
fn round_ymm(mut a Asm, x int)
    a.vcvtpd2ps(3, x)
    a.vcvtps2pd(x, 3)

## Round the double of xmm`x` to `f32` and back, through xmm3.
fn round_sd(mut a Asm, x int)
    a.vcvtsd2ss(3, 3, x)
    a.vcvtss2sd(x, 3, 3)

## `if flag != 0 { round }` around `emit`.
fn maybe_round(mut a Asm, flag int, wide bool, x int)
    skip := a.label()
    a.test_rr(flag, flag)
    a.jcc(CC_E, skip)
    if wide
        round_ymm(mut a, x)
    else
        round_sd(mut a, x)
    a.bind(skip)

## `rt.vec_axpy(c, b, n, r; x)`: `c[i] = c[i] + x * b[i]` for `i < n`, the
## product and the sum each rounded. rdi = c, rsi = b, rdx = n, rcx = r,
## xmm0 = x.
fn kernel_axpy(mut a Asm)
    a.vbroadcastsd(0, 0)
    a.mov_rr(R10, RDX)
    a.alu_ri("and", R10, -4)
    a.mov_rr(R11, RDX)
    a.alu_ri("and", R11, 3)
    vloop := a.label()
    tail := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", R10, 0)
    a.jcc(CC_E, tail)
    a.vmovupd_rm(1, at(RSI, 0))
    a.vpd256_rrr("fmul", 1, 1, 0)
    maybe_round(mut a, RCX, true, 1)
    a.vmovupd_rm(2, at(RDI, 0))
    a.vpd256_rrr("fadd", 2, 2, 1)
    maybe_round(mut a, RCX, true, 2)
    a.vmovupd_mr(at(RDI, 0), 2)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("add", RDI, 32)
    a.alu_ri("sub", R10, 4)
    a.jmp(vloop)
    a.bind(tail)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovsd_rm(1, at(RSI, 0))
    a.vsd_rrr("fmul", 1, 1, 0)
    maybe_round(mut a, RCX, false, 1)
    a.vmovsd_rm(2, at(RDI, 0))
    a.vsd_rrr("fadd", 2, 2, 1)
    maybe_round(mut a, RCX, false, 2)
    a.vmovsd_mr(at(RDI, 0), 2)
    a.alu_ri("add", RSI, 8)
    a.alu_ri("add", RDI, 8)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_axpyi(c, b, n, x, keep)`: `c[i] = c[i] + x * b[i]` on `int`s, eight a
## pass in two registers, then one at a time. `vpmuldq` multiplies the low 32
## bits of each lane, which hold the whole value: the data-range guard
## (native.bce.12) kept `x` and `b[i]` within 2^20. rdi = c, rsi = b, rdx = n,
## rcx = x.
fn kernel_axpyi(mut a Asm)
    a.vmovq_xr(0, RCX)
    a.vpbroadcastq(0, 0)
    a.mov_rr(R10, RDX)
    a.alu_ri("and", R10, -8)
    a.mov_rr(R11, RDX)
    a.alu_ri("and", R11, 7)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", R10, 0)
    a.jcc(CC_E, scalar)
    a.vmovupd_rm(1, at(RSI, 0))
    a.vmovupd_rm(2, at(RSI, 32))
    a.vpmuldq_rrr(1, 1, 0)
    a.vpmuldq_rrr(2, 2, 0)
    a.vpaddq_rrm(1, 1, at(RDI, 0))
    a.vpaddq_rrm(2, 2, at(RDI, 32))
    a.vmovupd_mr(at(RDI, 0), 1)
    a.vmovupd_mr(at(RDI, 32), 2)
    a.alu_ri("add", RSI, 64)
    a.alu_ri("add", RDI, 64)
    a.alu_ri("sub", R10, 8)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.mov_rm(RAX, at(RSI, 0))
    a.imul_rr(RAX, RCX)
    a.alu_rm("add", RAX, at(RDI, 0))
    a.mov_mr(at(RDI, 0), RAX)
    a.alu_ri("add", RSI, 8)
    a.alu_ri("add", RDI, 8)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_axpyf(c, b, n, keep; x)`: `c[i] = c[i] + x * b[i]` on doubles,
## eight a pass in two registers, with `x * b[i]` and `c[i] + q` in that
## operand order (native.vec.1). rdi = c, rsi = b, rdx = n, xmm0 = x.
fn kernel_axpyf(mut a Asm)
    a.vbroadcastsd(0, 0)
    a.mov_rr(R10, RDX)
    a.alu_ri("and", R10, -8)
    a.mov_rr(R11, RDX)
    a.alu_ri("and", R11, 7)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", R10, 0)
    a.jcc(CC_E, scalar)
    a.vpd256_rrm("fmul", 1, 0, at(RSI, 0))
    a.vpd256_rrm("fmul", 2, 0, at(RSI, 32))
    a.vmovupd_rm(3, at(RDI, 0))
    a.vmovupd_rm(4, at(RDI, 32))
    a.vpd256_rrr("fadd", 3, 3, 1)
    a.vpd256_rrr("fadd", 4, 4, 2)
    a.vmovupd_mr(at(RDI, 0), 3)
    a.vmovupd_mr(at(RDI, 32), 4)
    a.alu_ri("add", RSI, 64)
    a.alu_ri("add", RDI, 64)
    a.alu_ri("sub", R10, 8)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovsd_rm(1, at(RSI, 0))
    a.vsd_rrr("fmul", 1, 0, 1)
    a.vmovsd_rm(2, at(RDI, 0))
    a.vsd_rrr("fadd", 2, 2, 1)
    a.vmovsd_mr(at(RDI, 0), 2)
    a.alu_ri("add", RSI, 8)
    a.alu_ri("add", RDI, 8)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## The four elementwise operations by code, as MIR names them.
fn zip_op(k int) str
    match k
        0 => "fadd"
        1 => "fsub"
        2 => "fmul"
        _ => "fdiv"

## One loop of `rt.vec_zip`: `out[i] = a[i] op b[i]`. rsi = out, rdx = a,
## rcx = b, r9 = r; r8 holds n.
fn zip_loop(mut a Asm, op str)
    a.mov_rr(RAX, R8)
    a.alu_ri("and", RAX, -4)
    a.mov_rr(R11, R8)
    a.alu_ri("and", R11, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", RAX, 0)
    a.jcc(CC_E, scalar)
    a.vmovupd_rm(1, at(RDX, 0))
    a.vmovupd_rm(2, at(RCX, 0))
    a.vpd256_rrr(op, 1, 1, 2)
    maybe_round(mut a, R9, true, 1)
    a.vmovupd_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 32)
    a.alu_ri("add", RCX, 32)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("sub", RAX, 4)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovsd_rm(1, at(RDX, 0))
    a.vmovsd_rm(2, at(RCX, 0))
    a.vsd_rrr(op, 1, 1, 2)
    maybe_round(mut a, R9, false, 1)
    a.vmovsd_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 8)
    a.alu_ri("add", RCX, 8)
    a.alu_ri("add", RSI, 8)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_zip(op, out, a, b, n, r)`: rdi = op (0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn kernel_zip(mut a Asm)
    mut next := a.label()
    for k in 0..4
        next = a.label()
        a.alu_ri("cmp", RDI, k)
        a.jcc(CC_NE, next)
        zip_loop(mut a, zip_op(k))
        a.bind(next)
    a.ud2()

## One loop of `rt.vec_scal`: `out[i] = a[i] op s`, or `s op a[i]` when
## `left`. rsi = out, rdx = a, rcx = n, r8 = r; ymm0 / xmm0 hold s.
fn scal_loop(mut a Asm, op str, left bool)
    a.vbroadcastsd(4, 0)
    a.mov_rr(RAX, RCX)
    a.alu_ri("and", RAX, -4)
    a.mov_rr(R11, RCX)
    a.alu_ri("and", R11, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", RAX, 0)
    a.jcc(CC_E, scalar)
    a.vmovupd_rm(1, at(RDX, 0))
    if left
        a.vpd256_rrr(op, 1, 4, 1)
    else
        a.vpd256_rrr(op, 1, 1, 4)
    maybe_round(mut a, R8, true, 1)
    a.vmovupd_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 32)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("sub", RAX, 4)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovsd_rm(1, at(RDX, 0))
    if left
        a.vsd_rrr(op, 1, 0, 1)
    else
        a.vsd_rrr(op, 1, 1, 0)
    maybe_round(mut a, R8, false, 1)
    a.vmovsd_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 8)
    a.alu_ri("add", RSI, 8)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_scal(op, out, a, n, r, left; s)`: rdi = op, r9 = left.
fn kernel_scal(mut a Asm)
    mut next := a.label()
    for k in 0..4
        for l in 0..2
            next = a.label()
            a.alu_ri("cmp", RDI, k)
            a.jcc(CC_NE, next)
            a.alu_ri("cmp", R9, l)
            a.jcc(CC_NE, next)
            scal_loop(mut a, zip_op(k), l == 1)
            a.bind(next)
    a.ud2()

# ---- packed `f32` kernels (ADR 0875): eight singles at a time ----
#
# `out = a op b` on singles is the correctly rounded single operation, which is
# what the scalar definitions in `tensor.ail` give (a double holds the exact
# result of two singles' operation closely enough to round once).

## `rt.vec_axpy32(c, b, n; x)`: `c[i] = c[i] + x * b[i]` on singles, the
## product and the sum each rounded. rdi = c, rsi = b, rdx = n, xmm0 = x (a
## double holding an `f32` value).
fn kernel_axpy32(mut a Asm)
    a.vcvtsd2ss(0, 0, 0)
    a.vbroadcastss(3, 0)
    a.mov_rr(R10, RDX)
    a.alu_ri("and", R10, -8)
    a.mov_rr(R11, RDX)
    a.alu_ri("and", R11, 7)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", R10, 0)
    a.jcc(CC_E, scalar)
    a.vmovups_rm(1, at(RSI, 0))
    a.vps256_rrr("fmul", 1, 1, 3)
    a.vmovups_rm(2, at(RDI, 0))
    a.vps256_rrr("fadd", 2, 2, 1)
    a.vmovups_mr(at(RDI, 0), 2)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("add", RDI, 32)
    a.alu_ri("sub", R10, 8)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovss_rm(1, at(RSI, 0))
    a.vss_rrr("fmul", 1, 1, 0)
    a.vmovss_rm(2, at(RDI, 0))
    a.vss_rrr("fadd", 2, 2, 1)
    a.vmovss_mr(at(RDI, 0), 2)
    a.alu_ri("add", RSI, 4)
    a.alu_ri("add", RDI, 4)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## One loop of `rt.vec_zip32`: `out[i] = a[i] op b[i]` on singles. rsi = out,
## rdx = a, rcx = b, r8 = n.
fn zip32_loop(mut a Asm, op str)
    a.mov_rr(RAX, R8)
    a.alu_ri("and", RAX, -8)
    a.mov_rr(R11, R8)
    a.alu_ri("and", R11, 7)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", RAX, 0)
    a.jcc(CC_E, scalar)
    a.vmovups_rm(1, at(RDX, 0))
    a.vmovups_rm(2, at(RCX, 0))
    a.vps256_rrr(op, 1, 1, 2)
    a.vmovups_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 32)
    a.alu_ri("add", RCX, 32)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("sub", RAX, 8)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovss_rm(1, at(RDX, 0))
    a.vmovss_rm(2, at(RCX, 0))
    a.vss_rrr(op, 1, 1, 2)
    a.vmovss_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 4)
    a.alu_ri("add", RCX, 4)
    a.alu_ri("add", RSI, 4)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_zip32(op, out, a, b, n)`: rdi = op (0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn kernel_zip32(mut a Asm)
    mut next := a.label()
    for k in 0..4
        next = a.label()
        a.alu_ri("cmp", RDI, k)
        a.jcc(CC_NE, next)
        zip32_loop(mut a, zip_op(k))
        a.bind(next)
    a.ud2()

## One loop of `rt.vec_scal32`: `out[i] = a[i] op s`, or `s op a[i]` when
## `left`, on singles. rsi = out, rdx = a, rcx = n; xmm0 holds s as a double.
fn scal32_loop(mut a Asm, op str, left bool)
    a.vcvtsd2ss(0, 0, 0)
    a.vbroadcastss(4, 0)
    a.mov_rr(RAX, RCX)
    a.alu_ri("and", RAX, -8)
    a.mov_rr(R11, RCX)
    a.alu_ri("and", R11, 7)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", RAX, 0)
    a.jcc(CC_E, scalar)
    a.vmovups_rm(1, at(RDX, 0))
    if left
        a.vps256_rrr(op, 1, 4, 1)
    else
        a.vps256_rrr(op, 1, 1, 4)
    a.vmovups_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 32)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("sub", RAX, 8)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovss_rm(1, at(RDX, 0))
    if left
        a.vss_rrr(op, 1, 0, 1)
    else
        a.vss_rrr(op, 1, 1, 0)
    a.vmovss_mr(at(RSI, 0), 1)
    a.alu_ri("add", RDX, 4)
    a.alu_ri("add", RSI, 4)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_scal32(op, out, a, n, left; s)`: rdi = op, r8 = left.
fn kernel_scal32(mut a Asm)
    mut next := a.label()
    for k in 0..4
        for l in 0..2
            next = a.label()
            a.alu_ri("cmp", RDI, k)
            a.jcc(CC_NE, next)
            a.alu_ri("cmp", R8, l)
            a.jcc(CC_NE, next)
            scal32_loop(mut a, zip_op(k), l == 1)
            a.bind(next)
    a.ud2()

## `rt.vec_widen(out, a, n)`: `out[i]` (a double) = `a[i]` (a single), four at a
## time. rdi = out, rsi = a, rdx = n.
fn kernel_widen(mut a Asm)
    a.mov_rr(R10, RDX)
    a.alu_ri("and", R10, -4)
    a.mov_rr(R11, RDX)
    a.alu_ri("and", R11, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", R10, 0)
    a.jcc(CC_E, scalar)
    a.vcvtps2pd_rm(1, at(RSI, 0))
    a.vmovupd_mr(at(RDI, 0), 1)
    a.alu_ri("add", RSI, 16)
    a.alu_ri("add", RDI, 32)
    a.alu_ri("sub", R10, 4)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovss_rm(1, at(RSI, 0))
    a.vcvtss2sd(1, 1, 1)
    a.vmovsd_mr(at(RDI, 0), 1)
    a.alu_ri("add", RSI, 4)
    a.alu_ri("add", RDI, 8)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_narrow(out, a, n)`: `out[i]` (a single) = `a[i]` (a double) rounded,
## four at a time; `out` may be `a`. rdi = out, rsi = a, rdx = n.
fn kernel_narrow(mut a Asm)
    a.mov_rr(R10, RDX)
    a.alu_ri("and", R10, -4)
    a.mov_rr(R11, RDX)
    a.alu_ri("and", R11, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.alu_ri("cmp", R10, 0)
    a.jcc(CC_E, scalar)
    a.vmovupd_rm(1, at(RSI, 0))
    a.vcvtpd2ps(2, 1)
    a.vmovups_mr128(at(RDI, 0), 2)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("add", RDI, 16)
    a.alu_ri("sub", R10, 4)
    a.jmp(vloop)
    a.bind(scalar)
    a.alu_ri("cmp", R11, 0)
    a.jcc(CC_E, done)
    a.vmovsd_rm(1, at(RSI, 0))
    a.vcvtsd2ss(1, 1, 1)
    a.vmovss_mr(at(RDI, 0), 1)
    a.alu_ri("add", RSI, 8)
    a.alu_ri("add", RDI, 4)
    a.alu_ri("sub", R11, 1)
    a.jmp(scalar)
    a.bind(done)
    a.vzeroupper()
    a.ret()

## `rt.vec_sum16(p, q, n, s)` and `rt.vec_sum16_32(p, n, s)`: the 16 partial
## sums of std.tensor.5 over the first `n` (a multiple of 16) elements of `p`,
## or of the products with `q` (doubles), halved down to four; the four sums go
## to `s[0..3]`. `vec_sum16_32` reads singles from `p` and widens them. Element
## `i` of a block of 16 adds to lane `i`, four lanes in each of ymm0..ymm3; the
## product and the sum are each rounded (no fused multiply-add). rdi = p,
## rsi = q, rdx = n, rcx = s (`_32`: rdi = p, rsi = n, rdx = s).
fn kernel_sum16(mut a Asm, single bool)
    if single
        a.mov_rr(RCX, RDX)
        a.mov_rr(RDX, RSI)
    for k in 0..4
        a.vpd_rrr(87, k, k, k)
    plain := a.label()
    pl := a.label()
    dl := a.label()
    fin := a.label()
    if not single
        a.alu_ri("cmp", RSI, 0)
        a.jcc(CC_E, plain)
        a.bind(dl)
        a.alu_ri("cmp", RDX, 0)
        a.jcc(CC_E, fin)
        for k in 0..4
            a.vmovupd_rm(4, at(RDI, 32 * k))
            a.vpd256_rrm("fmul", 4, 4, at(RSI, 32 * k))
            a.vpd256_rrr("fadd", k, k, 4)
        a.alu_ri("add", RDI, 128)
        a.alu_ri("add", RSI, 128)
        a.alu_ri("sub", RDX, 16)
        a.jmp(dl)
    a.bind(plain)
    a.bind(pl)
    a.alu_ri("cmp", RDX, 0)
    a.jcc(CC_E, fin)
    for k in 0..4
        if single
            a.vcvtps2pd_rm(4, at(RDI, 16 * k))
            a.vpd256_rrr("fadd", k, k, 4)
        else
            a.vpd256_rrm("fadd", k, k, at(RDI, 32 * k))
    a.alu_ri("add", RDI, if single then 64 else 128)
    a.alu_ri("sub", RDX, 16)
    a.jmp(pl)
    a.bind(fin)
    a.vpd256_rrr("fadd", 0, 0, 2)
    a.vpd256_rrr("fadd", 1, 1, 3)
    a.vpd256_rrr("fadd", 0, 0, 1)
    a.vmovupd_mr(at(RCX, 0), 0)
    a.vzeroupper()
    a.ret()

# ---- `exp` of doubles, four at a time (ADR 0876) ----

## The constants of `float_exp` as doubles' bits, 32 bytes each on the kernel's
## stack frame in this order: |x| mask, 700, 2^-28, ln2/2, 1.5 ln2, 1, 2, 0.5,
## 1/ln2, ln2 hi, ln2 lo, the five polynomial coefficients, -1, and the integer 1023.
VX_CONSTS := [
    9223372036854775807,
    4649368480934526976,
    4481081629233643520,
    4599914934686071279,
    4607361305248770931,
    4607182418800017408,
    4611686018427387904,
    4602678819172646912,
    4609176140021203710,
    4604418534311723008,
    4461442080421002358,
    4595172819793696062,
    -4654820494858601069,
    4544508515198557740,
    -4702957295668925455,
    4496342204012209360,
    -4616189618054758400,
    1023,
]

VX_ABS := 0
VX_C700 := 1
VX_TINY := 2
VX_HALFLN2 := 3
VX_LN2X1P5 := 4
VX_ONE := 5
VX_TWO := 6
VX_HALF := 7
VX_INVLN2 := 8
VX_LN2HI := 9
VX_LN2LO := 10
VX_P1 := 11
VX_P2 := 12
VX_P3 := 13
VX_P4 := 14
VX_P5 := 15
VX_NEG1 := 16
VX_K1023 := 17

fn vx(i int) Mem
    at(RSP, 32 * i)

## `rt.vec_exp(out, a, n) int`: `out[i] = exp(a[i])` (`float_exp`, fdlibm, step for
## step, no fused multiply-add) for as many leading quads as have all four
## arguments in `|x| < 700`; the count done comes back, and the caller finishes
## the rest (a NaN or huge argument included) with `float_exp`. A lane with
## `|x| <= ln2/2` runs the general formula with `k = 0`, which is the same
## number as the short path (`lo = 0`, `r = hi = x`); one with `|x| < 2^-28` gets
## `1 + x`. rdi = out, rsi = a, rdx = n. ymm0..ymm7 are the work (xmm6 and xmm7
## are saved), the constants live on the stack.
fn kernel_exp(mut a Asm)
    a.alu_ri("sub", RSP, 608)
    a.vmovups_mr128(at(RSP, 576), 6)
    a.vmovups_mr128(at(RSP, 592), 7)
    for i in 0..18
        a.mov_ri(RAX, VX_CONSTS[i])
        for j in 0..4
            a.mov_mr(at(RSP, 32 * i + 8 * j), RAX)
    a.mov_ri(RCX, 0)
    loop := a.label()
    cont := a.label()
    end := a.label()
    a.bind(loop)
    a.alu_ri("cmp", RDX, 4)
    a.jcc(CC_B, end)
    a.vmovupd_rm(0, at(RSI, 0))
    a.vlogic256_rrm(84, 1, 0, vx(VX_ABS))
    # All four lanes in range, else stop here.
    a.vcmppd_rrm(2, 1, vx(VX_C700), 17)
    a.vmovmskpd(R8, 2)
    a.alu_ri("cmp", R8, 15)
    a.jcc(CC_E, cont)
    a.jmp(end)
    a.bind(cont)
    # s1 = x > 0 ? 1 : -1 (ymm5); ymm2 = the mask x > 0.
    a.vpd_rrr(87, 3, 3, 3)
    a.vcmppd_rrr(2, 0, 3, 30)
    a.vmovupd_rm(5, vx(VX_NEG1))
    a.vmovupd_rm(6, vx(VX_ONE))
    a.vblendvpd(5, 5, 6, 2)
    # kf for |x| >= 1.5 ln2: floor(x/ln2 + 0.5) above zero, ceil(x/ln2 - 0.5) below (ymm2).
    a.vpd256_rrm("fmul", 3, 0, vx(VX_INVLN2))
    a.vpd256_rrm("fadd", 4, 3, vx(VX_HALF))
    a.vroundpd(4, 4, 9)
    a.vpd256_rrm("fsub", 3, 3, vx(VX_HALF))
    a.vroundpd(3, 3, 10)
    a.vblendvpd(2, 3, 4, 2)
    # |x| < 1.5 ln2: kf = s1; then |x| <= ln2/2: kf = 0 (ymm3).
    a.vcmppd_rrm(3, 1, vx(VX_LN2X1P5), 17)
    a.vblendvpd(3, 2, 5, 3)
    a.vcmppd_rrm(4, 1, vx(VX_HALFLN2), 18)
    a.vlogic256_rrr(85, 3, 4, 3)
    # hi = x - kf ln2hi (ymm4), lo = kf ln2lo (ymm5), r = hi - lo (ymm6), t = r r (ymm7).
    a.vpd256_rrm("fmul", 4, 3, vx(VX_LN2HI))
    a.vpd256_rrr("fsub", 4, 0, 4)
    a.vpd256_rrm("fmul", 5, 3, vx(VX_LN2LO))
    a.vpd256_rrr("fsub", 6, 4, 5)
    a.vpd256_rrr("fmul", 7, 6, 6)
    # q = p1 + t (p2 + t (p3 + t (p4 + t p5))); c = r - t q (ymm1).
    a.vpd256_rrm("fmul", 1, 7, vx(VX_P5))
    a.vpd256_rrm("fadd", 1, 1, vx(VX_P4))
    a.vpd256_rrr("fmul", 1, 7, 1)
    a.vpd256_rrm("fadd", 1, 1, vx(VX_P3))
    a.vpd256_rrr("fmul", 1, 7, 1)
    a.vpd256_rrm("fadd", 1, 1, vx(VX_P2))
    a.vpd256_rrr("fmul", 1, 7, 1)
    a.vpd256_rrm("fadd", 1, 1, vx(VX_P1))
    a.vpd256_rrr("fmul", 1, 7, 1)
    a.vpd256_rrr("fsub", 1, 6, 1)
    # y = 1 - ((lo - r c / (2 - c)) - hi) (ymm2).
    a.vpd256_rrr("fmul", 2, 6, 1)
    a.vmovupd_rm(7, vx(VX_TWO))
    a.vpd256_rrr("fsub", 7, 7, 1)
    a.vpd256_rrr("fdiv", 2, 2, 7)
    a.vpd256_rrr("fsub", 2, 5, 2)
    a.vpd256_rrr("fsub", 2, 2, 4)
    a.vmovupd_rm(7, vx(VX_ONE))
    a.vpd256_rrr("fsub", 2, 7, 2)
    # y * 2^k: the exponent bits (k + 1023) << 52.
    a.vcvtpd2dq(4, 3)
    a.vpmovsxdq(4, 4)
    a.vpaddq_rrm(4, 4, vx(VX_K1023))
    a.vpsllq(4, 4, 52)
    a.vpd256_rrr("fmul", 2, 2, 4)
    # |x| < 2^-28: 1 + x.
    a.vlogic256_rrm(84, 1, 0, vx(VX_ABS))
    a.vcmppd_rrm(3, 1, vx(VX_TINY), 17)
    a.vpd256_rrm("fadd", 5, 0, vx(VX_ONE))
    a.vblendvpd(3, 2, 5, 3)
    a.vmovupd_mr(at(RDI, 0), 3)
    a.alu_ri("add", RDI, 32)
    a.alu_ri("add", RSI, 32)
    a.alu_ri("add", RCX, 4)
    a.alu_ri("sub", RDX, 4)
    a.jmp(loop)
    a.bind(end)
    a.mov_rr(RAX, RCX)
    a.vmovups_rm128(6, at(RSP, 576))
    a.vmovups_rm128(7, at(RSP, 592))
    a.alu_ri("add", RSP, 608)
    a.vzeroupper()
    a.ret()

## `rt.vec_escape(cr, out, n, max, keep; ci, thr)` (native.vec.2): escape counts
## of `z <- z * z + c`, eight points a pass in two independent groups of four
## (one group is a dependent chain of float latencies; two keep the unit busy).
## rdi = cr, rsi = out, rdx = n, rcx = max, xmm0 = ci, xmm1 = thr; r8 (keep) is
## ignored. Group g keeps zr, zi and the count (a double) in ymm(3g), (3g+1),
## (3g+2); ymm6..ymm9 are scratch (saved: xmm6/7 for Windows, xmm8/9 for AIL).
## The constants live on the stack: ci at 0, thr at 32, 2.0 at 64, 1.0 at 96.
## A lane has left when `zr*zr + zi*zi > thr` (false for a NaN); it keeps its
## zr, zi (frozen, so it stays gone) and count, so each lane runs the scalar
## loop's operations in the scalar order. Whole passes: the last may read and
## write up to seven elements past `n` (the caller leaves room).
fn kernel_escape(mut a Asm)
    a.alu_ri("sub", RSP, 208)
    for r in 0..4
        a.vmovups_mr128(at(RSP, 128 + 16 * r), 6 + r)
    a.vbroadcastsd(2, 0)
    a.vmovupd_mr(at(RSP, 0), 2)
    a.vbroadcastsd(2, 1)
    a.vmovupd_mr(at(RSP, 32), 2)
    a.mov_ri(RAX, 4611686018427387904)
    for j in 0..4
        a.mov_mr(at(RSP, 64 + 8 * j), RAX)
    a.mov_ri(RAX, 4607182418800017408)
    for j in 0..4
        a.mov_mr(at(RSP, 96 + 8 * j), RAX)
    group := a.label()
    step := a.label()
    store := a.label()
    done := a.label()
    a.bind(group)
    a.alu_ri("cmp", RDX, 0)
    a.jcc(CC_LE, done)
    for r in 0..6
        a.vpd_rrr(87, r, r, r)
    a.mov_rr(R9, RCX)
    a.bind(step)
    a.alu_ri("cmp", R9, 0)
    a.jcc(CC_LE, store)
    for g in 0..2
        zr := 3 * g
        zi := zr + 1
        kk := zr + 2
        a.vpd256_rrr("fmul", 6, zr, zr)
        a.vpd256_rrr("fmul", 7, zi, zi)
        a.vpd256_rrr("fadd", 8, 6, 7)
        a.vcmppd_rrm(8, 8, at(RSP, 32), 30)
        a.vpd256_rrr("fsub", 6, 6, 7)
        a.vpd256_rrm("fadd", 6, 6, at(RDI, 32 * g))
        a.vpd256_rrm("fmul", 7, zr, at(RSP, 64))
        a.vpd256_rrr("fmul", 7, 7, zi)
        a.vpd256_rrm("fadd", 7, 7, at(RSP, 0))
        a.vblendvpd(zr, 6, zr, 8)
        a.vblendvpd(zi, 7, zi, 8)
        a.vlogic256_rrm(85, 9, 8, at(RSP, 96))
        a.vpd256_rrr("fadd", kk, kk, 9)
        a.vmovmskpd(R10 + g, 8)
    a.alu_rr("and", R10, R11)
    a.alu_ri("cmp", R10, 15)
    a.jcc(CC_E, store)
    a.alu_ri("sub", R9, 1)
    a.jmp(step)
    a.bind(store)
    for g in 0..2
        a.vcvtpd2dq(6, 3 * g + 2)
        a.vpmovsxdq(6, 6)
        a.vmovupd_mr(at(RSI, 32 * g), 6)
    a.alu_ri("add", RDI, 64)
    a.alu_ri("add", RSI, 64)
    a.alu_ri("sub", RDX, 8)
    a.jmp(group)
    a.bind(done)
    for r in 0..4
        a.vmovups_rm128(6 + r, at(RSP, 128 + 16 * r))
    a.alu_ri("add", RSP, 208)
    a.vzeroupper()
    a.ret()
