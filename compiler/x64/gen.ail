## x86-64 code generation from allocated MIR (ADR 0385). Each function is
## laid out in reverse postorder with a frame of `rbp`, the callee-saved
## registers it uses, and its spill slots; checks branch to stubs at the end
## of the function that call `rt.trap` with the site's text and operands
## (native-abi.md §7). The result is a `codegen.Image` for the object
## writer.
use mir
use codegen

## Scratch registers, never allocated (native-abi.md §1): r10 and rax
## (ADR 1049; `S1` is rax, the register a result passes through anyway).
S0 := 10
S1 := 0
X0 := 14
X1 := 15

## Allocatable registers, best first.
pub fn registers() codegen.Target
    codegen.Target(
        int_caller: [RSI, RDI, R8, R9, RCX, RDX, 11],
        int_callee: [RBX, 12, 13, 14, 15],
        float_caller: [32, 33, 34, 35, 36, 37, 38, 39],
        float_callee: [40, 41, 42, 43, 44, 45],
        int_args: INT_ARGS,
        float_args: [32, 33, 34, 35, 36, 37, 38, 39],
        div_regs: [RDX],
    )

INT_ARGS := [7, 6, 2, 1, 8, 9]
## The runtime global holding the stack limit (`rt.STACK_LIMIT`, ADR 0535).
STACK_LIMIT := 15

## A move of the parallel moves at an edge or a call: into location `dst`
## from location `src`, or from a constant (`imm`) or a symbol's address.
struct Move
    dst int
    src int
    imm int
    sym str
    float bool

## A trap stub: where checks jump, and what it passes to `rt.trap`.
struct Stub
    label int
    kind int
    a int
    b int
    site int
    op str
    ## 1: the result overwrote `a`, which is result - b (an add); 2: result + b
    ## (a sub); 3: the second operand was overwritten by a sum with the first,
    ## a constant; 4: `b` is already the list's length (`bounds`). The stub
    ## undoes it before reporting.
    undo int

struct Gen
    a Asm
    ## The Windows target (ADR 0608): `target()` is 3.
    win bool
    ## The freestanding target (ADR 0953): `target()` is 4. (`none` is a
    ## keyword, so the name is `bare`.)
    bare bool
    ## What the function needs from the image and the module, without a copy
    ## of either per function: the sites (shared), the globals' size, and the
    ## requests `gen_func` replays on the image afterwards, in order.
    sites ref codegen.Sites
    nglobals int
    calls List[codegen.CallRow]
    f64s List[float]
    f mir.Func
    loc List[int]
    blabels List[int]
    next_block int
    ## Bytes left for repeated dispatches in this function (§dispatch_chain).
    dup_left int
    remat List[mir.Inst]
    uses List[int]
    stubs List[Stub]
    saved_ints List[int]
    saved_floats List[int]
    slot_base int
    frame int
    ## Caller-saved registers in use, which a `push`'s slow path saves.
    caller_used List[int]
    ## Globals whose address only loads and stores use: the access is
    ## `[rip + globals + 8k]` and the `lea` is skipped (ADR 0623).
    globs Map[int, int]
    ## Shrink-wrapping (ADR 0625): the block that saves the callee-saved
    ## registers (-1: the prologue does), and the blocks whose returns
    ## restore them.
    wrap int
    region List[bool]
    holes List[codegen.Hole]
    sallocs Map[int, int]
    ## The dynamic-library symbols this function calls (Linux, ADR 0870).
    imports List[str]

## Generate the whole program: `_start`, then each function.
pub fn generate(m mir.Module) codegen.Image
    generate_for(m, false)

## The freestanding target `x86_64-none` (ADR 0953): the bootloader enters
## `_start` in 64-bit mode with a valid stack, so there is no `argc`/`argv`;
## the entry stack pointer is passed as the stack top.
pub fn generate_none(m mir.Module) codegen.Image
    generate_for(m, true)

fn generate_for(m mir.Module, bare bool) codegen.Image
    mut img := codegen.new_image()
    img.globals = m.globals_used()
    for i in 0..m.strs.len()
        codegen.add_str(mut img, "d:s{i}", m.strs[i])
    sites := ref codegen.Sites(list: m.sites)
    mut a := new_asm()
    # _start: pass argc and argv to `rt.init`, align the stack, run `main`,
    # exit 0.
    a.alu_rr("xor", RBP, RBP)
    if bare
        a.mov_ri(RDI, 0)
        a.mov_rr(RSI, RSP)
    else
        a.mov_rm(RDI, at(RSP, 0))
        a.lea(RSI, at(RSP, 8))
    a.alu_ri("and", RSP, -16)
    a.call_sym("rt.init")
    a.call_sym("main")
    a.mov_ri(RDI, 0)
    a.call_sym("rt.exit")
    a.ud2()
    img.code = a.code
    for fx in a.fixups
        img.relocs.push(codegen.Reloc(at: fx.at, kind: "rel32", sym: fx.sym, tail: fx.tail))
    for f in m.funcs
        if is_kernel(f.name)
            gen_kernel(mut img, f.name)
        else
            gen_func(mut img, m, sites, f, false, bare)
    codegen.add_call_table(mut img, m)
    img

## `win` is set for the Windows target: `target()` is then 3 (ADR 0608);
## `bare` for the freestanding one, where it is 4 (ADR 0953).
fn gen_func(mut img codegen.Image, m mir.Module, sites ref codegen.Sites, f0 mir.Func, win bool, bare bool)
    f := codegen.split_for_calls(codegen.split_edges(f0))
    al := codegen.allocate(f, registers())
    mut remat := [mir.inst(-1, "", []) for _ in 0..f.vals.len()]
    mut uses := [0 for _ in 0..f.vals.len()]
    for blk in f.blocks
        for i in blk.insts
            if codegen.is_remat(i)
                remat[i.dst] = i
            for u in i.operands()
                uses[u] += 1
        for u in blk.term.uses()
            uses[u] += 1
    mut globs := Map[int, int]()
    mut addr_uses := [0 for _ in 0..f.vals.len()]
    for blk in f.blocks
        for i in blk.insts
            if i.op == "prim"
                and (i.name == "load64" or i.name == "load8" or i.name == "loadf" or i.name == "store64" or i.name == "store8" or i.name == "storef")
                addr_uses[i.arg(0)] += 1
    for blk in f.blocks
        for i in blk.insts
            if i.op == "prim" and i.name == "global" and remat[i.arg(0)].op == "const"
                if addr_uses[i.dst] == uses[i.dst] and uses[i.dst] > 0
                    globs[i.dst] = remat[i.arg(0)].imm
    mut g := Gen(
        a: new_asm(),
        win: win,
        bare: bare,
        sites: sites,
        nglobals: img.globals,
        calls: [],
        f64s: [],
        f: f,
        loc: al.loc,
        blabels: [],
        next_block: -1,
        dup_left: DISPATCH_BYTES,
        remat: remat,
        uses: uses,
        stubs: [],
        saved_ints: [],
        saved_floats: [],
        slot_base: 0,
        frame: 0,
        caller_used: codegen.caller_used(al, registers()),
        globs: globs,
        wrap: al.wrap,
        region: al.region,
        holes: al.holes,
        sallocs: al.sallocs,
        imports: [],
    )
    for r in al.saved
        if r >= codegen.FLOAT_BASE
            g.saved_floats.push(r)
        else
            g.saved_ints.push(r)
    g.blabels = [g.a.label() for _ in 0..f.blocks.len()]
    # Jumps stay inside 32-byte lines (native.jump.1); the trap stubs, which
    # run once, are left as they fall.
    lined := jump_lines()
    g.a.window = if lined then JUMP_LINE else 0
    g.prologue(al.slots)
    # The entry block's parameters arrive in the argument registers.
    g.entry_moves()
    for k in 0..al.order.len()
        b := al.order[k]
        g.next_block = if k + 1 < al.order.len() then al.order[k + 1] else -1
        g.a.bind(g.blabels[b])
        g.gen_block(b)
    g.a.window = 0
    g.gen_stubs()
    g.a.resolve_labels()
    # The function starts on a line, so an offset in it is a place in the
    # line (the executable loads the code at a multiple of the line too).
    int3 := 204
    while lined and img.code.len() % JUMP_LINE != 0
        img.code.push(int3.to_u8())
    for sym in g.imports
        codegen.import_slot(mut img, sym)
    for x in g.f64s
        codegen.add_f64(mut img, x)
    for s in g.stubs
        codegen.add_trap_texts(mut img, m, s.site, s.op)
    base := img.code.len()
    for c in g.calls
        img.calls.push(codegen.CallRow(off: c.off + base, pos: c.pos, func: c.func))
    img.funcs[f.name] = base
    img.code.extend(g.a.code)
    for fx in g.a.fixups
        img.relocs.push(codegen.Reloc(at: fx.at + base, kind: "rel32", sym: fx.sym, tail: fx.tail))

## Whether jumps are kept inside 32-byte lines (native.jump.1);
## `AIL_OPT_OFF=jumpline` turns it off.
fn jump_lines() bool
    not mir.opt_off("jumpline")

# ---- frame ----

fn Gen.prologue(mut self, slots int)
    self.a.push(RBP)
    self.a.mov_rr(RBP, RSP)
    if self.wrap < 0
        for r in self.saved_ints
            self.a.push(r)
    # Saved vector registers sit just below the pushed ones, spill slots
    # below them.
    ints := 8 * self.saved_ints.len()
    self.slot_base = ints + 8 * self.saved_floats.len()
    mut size := 8 * (slots + self.saved_floats.len())
    while (size + ints) % 16 != 0
        size += 8
    self.frame = size
    # Shrink-wrapped, the saved integer registers have their place in the
    # frame, where the pushes would have put them.
    if self.wrap >= 0
        size += ints
    if size > 0
        self.a.alu_ri("sub", RSP, size)
    if self.wrap < 0
        self.save_registers(true)

## Save or restore the callee-saved registers: the integer ones at
## `rbp - 8 * (j + 1)` (where a push puts them), the vector ones below.
fn Gen.save_registers(mut self, out bool)
    ints := 8 * self.saved_ints.len()
    if self.wrap >= 0
        for j in 0..self.saved_ints.len()
            if out
                self.a.mov_mr(at(RBP, 0 - 8 * (j + 1)), self.saved_ints[j])
            else
                self.a.mov_rm(self.saved_ints[j], at(RBP, 0 - 8 * (j + 1)))
    for j in 0..self.saved_floats.len()
        if out
            self.a.vmovsd_mr(
                at(RBP, 0 - ints - 8 * (j + 1)),
                self.saved_floats[j] - codegen.FLOAT_BASE,
            )
        else
            self.a.vmovsd_rm(
                self.saved_floats[j] - codegen.FLOAT_BASE,
                at(RBP, 0 - ints - 8 * (j + 1)),
            )

fn Gen.epilogue(mut self, block int)
    ints := 8 * self.saved_ints.len()
    if self.wrap < 0
        self.save_registers(false)
        if self.saved_ints.len() > 0
            self.a.lea(RSP, at(RBP, 0 - ints))
            mut i := self.saved_ints.len() - 1
            while i >= 0
                self.a.pop(self.saved_ints[i])
                i -= 1
    elif self.region[block]
        self.save_registers(false)
    self.a.mov_rr(RSP, RBP)
    self.a.pop(RBP)
    self.a.ret()

fn Gen.slot(self, l int) Mem
    at(RBP, 0 - self.slot_base - 8 * (l - codegen.SLOT_BASE + 1))

fn is_reg(l int) bool
    l >= 0 and l < codegen.SLOT_BASE

fn is_slot(l int) bool
    l >= codegen.SLOT_BASE

# ---- operands ----

## The constant a value is, when it is an `int` or `bool` constant.
fn Gen.imm(self, v int) int?
    i := self.remat[v]
    if i.op == "const"
        return i.imm
    none

fn Gen.imm32(self, v int) int?
    n := self.imm(v)?
    if fits32(n)
        return n
    none

## `v` in a general register: its own, or `scratch` loaded with it.
fn Gen.gpr(mut self, v int, scratch int) int
    l := self.loc[v]
    if is_reg(l)
        return l
    if is_slot(l)
        self.a.mov_rm(scratch, self.slot(l))
        return scratch
    i := self.remat[v]
    if i.op == "const"
        self.a.mov_ri(scratch, i.imm)
    elif i.op == "str"
        self.a.lea(scratch, at_sym("d:s{i.imm}", 0))
    elif i.op == "fnaddr"
        self.a.lea(scratch, at_sym(i.name, 0))
    else
        unreachable("value v{v} has no location")
    scratch

## `v` in a vector register: its own, or `scratch` loaded with it.
## The symbol of float constant `x`; `gen_func` adds its data to the image.
fn Gen.f64_const(mut self, x float) str
    self.f64s.push(x)
    codegen.f64_sym(x)

fn Gen.xmm(mut self, v int, scratch int) int
    l := self.loc[v]
    if is_reg(l)
        return l - codegen.FLOAT_BASE
    if is_slot(l)
        self.a.vmovsd_rm(scratch, self.slot(l))
        return scratch
    i := self.remat[v]
    sym := self.f64_const(i.fimm)
    self.a.vmovsd_rm(scratch, at_sym(sym, 0))
    scratch

## The register to compute `v` into: its own, or `scratch`.
fn Gen.out_gpr(self, v int, scratch int) int
    if is_reg(self.loc[v]) then self.loc[v] else scratch

fn Gen.out_xmm(self, v int, scratch int) int
    if is_reg(self.loc[v]) then self.loc[v] - codegen.FLOAT_BASE else scratch

## Store a computed value from `r` into its location, when that is a slot.
fn Gen.put_gpr(mut self, v int, r int)
    l := self.loc[v]
    if is_slot(l)
        self.a.mov_mr(self.slot(l), r)
    elif is_reg(l)
        self.a.mov_rr(l, r)

fn Gen.put_xmm(mut self, v int, x int)
    l := self.loc[v]
    if is_slot(l)
        self.a.vmovsd_mr(self.slot(l), x)
    elif is_reg(l)
        self.a.vmov_rr(l - codegen.FLOAT_BASE, x)

# ---- parallel moves ----

fn Gen.move_of(mut self, dst int, v int) Move
    i := self.remat[v]
    fl := self.f.vals[v].is_float()
    if i.op == "const"
        return Move(dst: dst, src: -1, imm: i.imm, sym: "", float: fl)
    if i.op == "str"
        return Move(dst: dst, src: -1, imm: 0, sym: "d:s{i.imm}", float: fl)
    if i.op == "fnaddr"
        return Move(dst: dst, src: -1, imm: 0, sym: i.name, float: fl)
    if i.op == "fconst"
        return Move(dst: dst, src: -1, imm: 0, sym: self.f64_const(i.fimm), float: fl)
    Move(dst: dst, src: self.loc[v], imm: 0, sym: "", float: fl)

## Perform moves as if all at once: a move waits while its destination is
## another's source; a cycle is broken through a scratch register.
fn Gen.parallel(mut self, moves List[Move])
    mut pending := List[Move]()
    for mv in moves
        if mv.dst >= 0 and mv.dst != mv.src
            pending.push(mv)
    while pending.len() > 0
        mut done := -1
        for k in 0..pending.len()
            mut blocked := false
            for j in 0..pending.len()
                if j != k and pending[j].src == pending[k].dst
                    blocked = true
            if not blocked
                done = k
                break
        if done >= 0
            self.emit_move(pending[done])
            pending.remove_at(done)
            continue
        # A cycle. Between two general registers, `xchg` does the first move
        # and leaves the destination's old value in the source: the moves
        # that read either one read the other instead.
        d := pending[0].dst
        src := pending[0].src
        if not pending[0].float and is_reg(d) and is_reg(src)
            self.a.xchg_rr(d, src)
            pending.remove_at(0)
            mut left := List[Move]()
            for mv0 in pending
                mut mv := mv0
                if mv.src == d
                    mv.src = src
                elif mv.src == src
                    mv.src = d
                if mv.dst != mv.src
                    left.push(mv)
            pending = left
            continue
        # Otherwise save the first destination's value and read it from
        # there: rax for a general register (a cycle through a slot only
        # comes from block parameters, whose moves never write rax).
        tmp := if pending[0].float then X1 + codegen.FLOAT_BASE else RAX
        self.emit_move(Move(dst: tmp, src: d, imm: 0, sym: "", float: pending[0].float))
        for j in 0..pending.len()
            if pending[j].src == d
                pending[j].src = tmp

fn Gen.emit_move(mut self, mv Move)
    if mv.float
        x := if is_reg(mv.dst) then mv.dst - codegen.FLOAT_BASE else X0
        if mv.src < 0
            self.a.vmovsd_rm(x, at_sym(mv.sym, 0))
        elif is_reg(mv.src)
            self.a.vmov_rr(x, mv.src - codegen.FLOAT_BASE)
        else
            self.a.vmovsd_rm(x, self.slot(mv.src))
        if is_slot(mv.dst)
            self.a.vmovsd_mr(self.slot(mv.dst), x)
        return
    if is_slot(mv.dst) and mv.src < 0 and mv.sym == "" and fits32(mv.imm)
        self.a.mov_mi(self.slot(mv.dst), mv.imm)
        return
    if is_slot(mv.dst) and is_reg(mv.src)
        self.a.mov_mr(self.slot(mv.dst), mv.src)
        return
    r := if is_reg(mv.dst) then mv.dst else S0
    if mv.src < 0
        if mv.sym != ""
            self.a.lea(r, at_sym(mv.sym, 0))
        else
            self.a.mov_ri(r, mv.imm)
    elif is_reg(mv.src)
        self.a.mov_rr(r, mv.src)
    else
        self.a.mov_rm(r, self.slot(mv.src))
    if is_slot(mv.dst)
        self.a.mov_mr(self.slot(mv.dst), r)

fn Gen.entry_moves(mut self)
    mut moves := List[Move]()
    mut ni := 0
    mut nf := 0
    for p in self.f.params
        if self.f.vals[p].is_float()
            moves.push(Move(
                dst: self.loc[p],
                src: codegen.FLOAT_BASE + nf,
                imm: 0,
                sym: "",
                float: true,
            ))
            nf += 1
        elif ni < INT_ARGS.len()
            moves.push(Move(dst: self.loc[p], src: INT_ARGS[ni], imm: 0, sym: "", float: false))
            ni += 1
    self.parallel(moves)
    # Integer parameters after the sixth are on the stack, above the return
    # address (native-abi.md §1).
    mut k := 0
    for p in self.f.params
        if not self.f.vals[p].is_float()
            if k >= INT_ARGS.len()
                d := self.out_gpr(p, S0)
                self.a.mov_rm(d, at(RBP, 16 + 8 * (k - INT_ARGS.len())))
                self.put_gpr(p, d)
            k += 1

# ---- blocks ----

## The moves that park values in slots across a loop (ADR 0848): stores end
## the block before the loop, loads start each block after it.
fn Gen.hole_moves(mut self, b int, store bool)
    for h in self.holes
        if h.block == b and h.store == store
            if store
                self.emit_move(Move(dst: h.slot, src: h.reg, imm: 0, sym: "", float: h.float))
            else
                self.emit_move(Move(dst: h.reg, src: h.slot, imm: 0, sym: "", float: h.float))

fn Gen.gen_block(mut self, b int)
    blk := self.f.blocks[b]
    n := blk.insts.len()
    # A comparison whose only use is the branch ending the block is fused.
    mut fused := -1
    if blk.term.kind == "branch" and n > 0
        last := blk.insts[n - 1]
        if last.dst == blk.term.cond and self.uses[last.dst] == 1 and cc_of(last.op) >= 0
            fused = n - 1
    # `x & m == 0` (or `!= 0`) as a branch condition is one `test` (ADR 0623).
    mut masked := -1
    if fused > 0
        cmp := blk.insts[fused]
        mask := blk.insts[fused - 1]
        if (cmp.op == "eq" or cmp.op == "ne") and mask.op == "band" and cmp.arg(0) == mask.dst
            if self.uses[mask.dst] == 1
                and self.imm(cmp.arg(1)) == 0
                and self.imm(mask.arg(0)) == none
                if self.imm32(mask.arg(1)) != none or self.loc[mask.arg(1)] >= 0
                    masked = fused - 1
    if b == self.wrap
        self.save_registers(true)
    self.hole_moves(b, false)
    for k in 0..n
        if k == fused or k == masked
            continue
        self.gen_inst(blk.insts[k])
    self.hole_moves(b, true)
    t := blk.term
    match t.kind
        "jump" => self.goto(t.targets[0], t.args[0], true)
        "branch" =>
            yes := t.targets[0]
            no := t.targets[1]
            mut cc := CC_NE
            if masked >= 0
                bt := blk.insts[masked]
                if k := self.imm32(bt.arg(1))
                    self.a.test_ri(self.gpr(bt.arg(0), S0), k)
                else
                    self.a.test_rr(self.gpr(bt.arg(0), S0), self.gpr(bt.arg(1), S1))
                cc = cc_of(blk.insts[fused].op)
            elif fused >= 0
                cc = self.compare(blk.insts[fused])
            else
                r := self.gpr(t.cond, S0)
                self.a.test_rr(r, r)
            self.branch_to(cc, yes, no)
        "switch" => self.switch_jump(t)
        "return" =>
            if t.value >= 0
                if self.f.vals[t.value].is_float()
                    self.parallel([self.move_of(codegen.FLOAT_BASE, t.value)])
                else
                    self.parallel([self.move_of(RAX, t.value)])
            self.epilogue(b)
        _ => self.a.ud2()

## A jump table (native.match.2): an index at or past the last entry (as an
## unsigned number) goes to the last target; else `jmp` to the table's start
## plus the entry's 32-bit distance. The table follows the jump. Each copy of
## a dispatch (§goto) has its own `jmp`, which predicts on its own.
fn Gen.switch_jump(mut self, t mir.Term)
    n := t.targets.len() - 1
    r := self.gpr(t.cond, S0)
    self.a.alu_ri("cmp", r, n)
    self.a.jcc(CC_AE, self.blabels[t.targets[n]])
    table := self.a.label()
    self.a.lea_label(S1, table)
    self.a.movsxd_rm(S0, at_index(S1, r, 4, 0))
    self.a.alu_rr("add", S0, S1)
    self.a.jmp_reg(S0)
    self.a.bind(table)
    start := self.a.here()
    for k in 0..n
        self.a.table_entry(start, self.blabels[t.targets[k]])

## Whether block `to` is only a comparison and a branch: a jump to it is
## cheaper as the comparison and branch themselves, one instruction fewer
## on the way round a loop (loop rotation, ADR 0611).
## Move `args` into the parameters of `to` and continue there. A block of one
## or two plain instructions that only jumps on is repeated here, instead of
## jumped to; `inline` is false inside such a copy.
fn Gen.goto(mut self, to int, args List[int], inline bool)
    ps := self.f.blocks[to].params
    self.parallel([self.move_of(self.loc[ps[j]], args[j]) for j in 0..ps.len()])
    if to == self.next_block
        return
    if self.rotates(to)
        # The loop test again here, instead of a jump back to it.
        h := self.f.blocks[to]
        cc := self.compare(h.insts[h.insts.len() - 1])
        if cc < 16 and inline and self.dispatch_chain(h.term.targets[0])
            # And the body's dispatch again too (native.match.2).
            self.a.jcc(invert(cc), self.blabels[h.term.targets[1]])
            self.replay_dispatch(h.term.targets[0])
        else
            self.branch_to(cc, h.term.targets[0], h.term.targets[1])
    elif inline and self.dispatch_chain(to)
        self.replay_dispatch(to)
    elif inline and self.tail_block(to)
        h := self.f.blocks[to]
        for i in h.insts
            self.gen_inst(i)
        self.goto(h.term.targets[0], h.term.args[0], false)
    else
        self.a.jmp(self.blabels[to])

## The most instructions a copied dispatch has (native.match.2).
DISPATCH_MAX := 32

## The most entries the table of a copied dispatch has.
DISPATCH_ENTRIES := 64

## How many bytes of copied dispatches (about 8 per instruction, 4 per table
## entry) one function may have.
DISPATCH_BYTES := 4096

## Whether `to` starts a dispatch: at most four blocks, each jumping to the
## next, the last ending in a `switch`, with at most `DISPATCH_MAX`
## instructions, no call, and nothing the allocator moves in or out of them.
## A jump to one repeats it (tail duplication, native.match.2), so every arm
## of an interpreter loop ends in an indirect jump of its own, which the
## branch predictor keys on the arm that ran.
fn Gen.dispatch_chain(self, to int) bool
    mut b := to
    mut count := 0
    for _ in 0..4
        if b == self.wrap or b == 0
            return false
        h := self.f.blocks[b]
        for i in h.insts
            if codegen.is_call(i)
                return false
        for hl in self.holes
            if hl.block == b
                return false
        count += h.insts.len()
        if count > DISPATCH_MAX
            return false
        if h.term.kind == "switch"
            cost := 8 * count + 4 * h.term.targets.len()
            if h.term.targets.len() > DISPATCH_ENTRIES + 1 or cost > self.dup_left
                return false
            return not mir.opt_off("taildup")
        if h.term.kind != "jump" or h.term.targets[0] == b
            return false
        b = h.term.targets[0]
    false

## Repeat the dispatch that starts at block `to` here (§dispatch_chain): its
## instructions, the moves into each next block's parameters, and its jump
## table.
fn Gen.replay_dispatch(mut self, to int)
    mut b := to
    while true
        h := self.f.blocks[b]
        self.dup_left -= 8 * h.insts.len()
        for i in h.insts
            self.gen_inst(i)
        if h.term.kind == "switch"
            self.dup_left -= 4 * h.term.targets.len()
            self.switch_jump(h.term)
            return
        nxt := h.term.targets[0]
        ps := self.f.blocks[nxt].params
        args := h.term.args[0]
        self.parallel([self.move_of(self.loc[ps[j]], args[j]) for j in 0..ps.len()])
        b = nxt

## Whether `to` is one or two instructions (no call) and a jump, with nothing
## the allocator moves in or out of it: cheaper to repeat than to jump to.
fn Gen.tail_block(self, to int) bool
    h := self.f.blocks[to]
    n := h.insts.len()
    if to == self.wrap or n == 0 or n > 2 or h.term.kind != "jump"
        return false
    for i in h.insts
        if codegen.is_call(i)
            return false
    for hl in self.holes
        if hl.block == to
            return false
    true

fn Gen.rotates(self, to int) bool
    h := self.f.blocks[to]
    n := h.insts.len()
    if h.term.kind != "branch" or n == 0
        return false
    # Constants rebuilt at each use cost nothing to repeat.
    for k in 0..n - 1
        if not codegen.is_remat(h.insts[k])
            return false
    last := h.insts[n - 1]
    last.dst == h.term.cond and self.uses[last.dst] == 1 and cc_of(last.op) >= 0

## Jump to `yes` when `cc` holds, else to `no`, falling through where the
## next block allows. A float comparison's condition may be a pair (§cc_of).
fn Gen.branch_to(mut self, cc int, yes int, no int)
    if cc >= 16
        # `feq`: ZF and not PF; `fne`: not ZF or PF.
        if cc == 16
            self.a.jcc(CC_P, self.blabels[no])
            self.a.jcc(CC_E, self.blabels[yes])
        else
            self.a.jcc(CC_P, self.blabels[yes])
            self.a.jcc(CC_NE, self.blabels[yes])
        if no != self.next_block
            self.a.jmp(self.blabels[no])
        return
    if yes == self.next_block
        self.a.jcc(invert(cc), self.blabels[no])
        return
    self.a.jcc(cc, self.blabels[yes])
    if no != self.next_block
        self.a.jmp(self.blabels[no])

fn invert(cc int) int
    if cc % 2 == 0 then cc + 1 else cc - 1

## The condition code of a comparison, or -1. `feq` and `fne` need two
## flags and are 16 and 17.
fn cc_of(op str) int
    match op
        "eq" => CC_E
        "ne" => CC_NE
        "lt" => CC_L
        "le" => CC_LE
        "gt" => CC_G
        "ge" => CC_GE
        "feq" => 16
        "fne" => 17
        "fgt" | "flt" => CC_A
        "fge" | "fle" => CC_AE
        _ => -1

fn swapped(cc int) int
    match cc
        12 => CC_G
        14 => CC_GE
        15 => CC_L
        13 => CC_LE
        _ => cc

## Set the flags for a comparison; gives the condition that means true.
fn Gen.compare(mut self, i mir.Inst) int
    x := i.arg(0)
    y := i.arg(1)
    cc := cc_of(i.op)
    if i.op.starts_with("f")
        # `a < b` is `b > a`: ucomisd sets CF for less and for NaN alike.
        flip := i.op == "flt" or i.op == "fle"
        xa := self.xmm(if flip then y else x, X0)
        xb := self.xmm(if flip then x else y, X1)
        self.a.vucomisd(xa, xb)
        return cc
    if k := self.imm32(y)
        r := self.gpr(x, S0)
        # `test r, r` sets the flags a signed comparison with 0 reads.
        if k == 0
            self.a.test_rr(r, r)
        else
            self.a.alu_ri("cmp", r, k)
        return cc
    if k := self.imm32(x)
        r := self.gpr(y, S0)
        if k == 0
            self.a.test_rr(r, r)
        else
            self.a.alu_ri("cmp", r, k)
        return swapped(cc)
    ra := self.gpr(x, S0)
    rb := self.gpr(y, S1)
    self.a.alu_rr("cmp", ra, rb)
    cc

# ---- instructions ----

fn Gen.stub(mut self, kind int, x int, y int, site int, op str) int
    l := self.a.label()
    # An atomic add's overflow has its own message (conc.atomic.5).
    mut k := if kind == 0 and self.sites.list[site].rule == "conc.atomic.5" then 16 else kind
    # A std module's `unreachable("RULE: why")` names its own rule.
    if kind == 14 and self.sites.list[site].rule == "std.unreachable"
        k = 17
    self.stubs.push(Stub(label: l, kind: k, a: x, b: y, site: site, op: op, undo: 0))
    l

fn Gen.gen_inst(mut self, i mir.Inst)
    if codegen.is_remat(i)
        return
    match i.op
        "add" | "sub" | "mul" => self.arith(i)
        "div" | "rem" => self.divide(i)
        "band" | "bor" | "bxor" =>
            alu := match i.op
                "band" => "and"
                "bor" => "or"
                _ => "xor"
            # Into the result's register, with the operands swapped when it
            # is the second one's (ADR 0624).
            d := self.out_gpr(i.dst, S1)
            mut x := i.arg(0)
            mut y := i.arg(1)
            if self.loc[y] == d and self.loc[x] != d
                x = i.arg(1)
                y = i.arg(0)
            if k := self.imm32(y)
                self.a.mov_rr(d, self.gpr(x, d))
                self.a.alu_ri(alu, d, k)
            else
                ry := self.gpr(y, S0)
                self.a.mov_rr(d, self.gpr(x, d))
                self.a.alu_rr(alu, d, ry)
            self.put_gpr(i.dst, d)
        "bnot" =>
            self.a.mov_rr(S1, self.gpr(i.arg(0), S1))
            self.a.not_reg(S1)
            self.put_gpr(i.dst, S1)
        "shl" | "shr" => self.shift(i)
        "neg" =>
            self.a.mov_rr(S1, self.gpr(i.arg(0), S1))
            self.a.neg(S1)
            if i.site >= 0
                kind := if self.sites.list[i.site].op == "abs" then 5 else 2
                self.a.jcc(CC_O, self.stub(kind, i.arg(0), i.arg(0), i.site, "-"))
            self.put_gpr(i.dst, S1)
        "not" =>
            r := self.out_gpr(i.dst, S1)
            self.a.mov_rr(r, self.gpr(i.arg(0), S0))
            self.a.alu_ri("xor", r, 1)
            self.put_gpr(i.dst, r)
        "eq" | "ne" | "lt" | "le" | "gt" | "ge" | "feq" | "fne" | "flt" | "fle" | "fgt" | "fge" =>
            cc := self.compare(i)
            if cc == 16
                self.a.setcc(CC_E, S1)
                self.a.setcc(CC_NP, S0)
                self.a.alu_rr("and", S1, S0)
            elif cc == 17
                self.a.setcc(CC_NE, S1)
                self.a.setcc(CC_P, S0)
                self.a.alu_rr("or", S1, S0)
            else
                self.a.setcc(cc, S1)
            r := self.out_gpr(i.dst, S1)
            self.a.movzx8_rr(r, S1)
            self.put_gpr(i.dst, r)
        "fadd" | "fsub" | "fmul" | "fdiv" =>
            xa := self.xmm(i.arg(0), X0)
            xb := self.xmm(i.arg(1), X1)
            d := self.out_xmm(i.dst, X0)
            self.a.vsd_rrr(i.op, d, xa, xb)
            self.put_xmm(i.dst, d)
        "fneg" | "abs" =>
            xa := self.xmm(i.arg(0), X0)
            mask := if i.op == "fneg" then 1.shl(63) else 1.shl(63).bit_not()
            self.a.mov_ri(S1, mask)
            self.a.vmovq_xr(X1, S1)
            d := self.out_xmm(i.dst, X0)
            self.a.vpd_rrr(if i.op == "fneg" then 87 else 84, d, xa, X1)
            self.put_xmm(i.dst, d)
        "vldx" | "vstx" | "vfadd" | "vfsub" | "vfmul" | "vfdiv" => vec_inst(i)
        "vsplat" | "vpack" | "vlane" | "vhadd" => vec_inst(i)
        "sqrt" | "floor" | "ceil" =>
            xa := self.xmm(i.arg(0), X0)
            d := self.out_xmm(i.dst, X0)
            if i.op == "sqrt"
                self.a.vsd_rrr("sqrt", d, xa, xa)
            else
                self.a.vroundsd(d, xa, xa, if i.op == "floor" then 9 else 10)
            self.put_xmm(i.dst, d)
        "itof" =>
            r := self.gpr(i.arg(0), S1)
            d := self.out_xmm(i.dst, X0)
            self.a.vpd_rrr(87, d, d, d)
            self.a.vcvtsi2sd(d, r)
            self.put_xmm(i.dst, d)
        "ftoi" =>
            xa := self.xmm(i.arg(0), X0)
            self.a.vcvttsd2si(S1, xa)
            if i.site < 0
                self.put_gpr(i.dst, S1)
                return
            ok := self.a.label()
            self.a.mov_ri(S0, 1.shl(63))
            self.a.alu_rr("cmp", S1, S0)
            self.a.jcc(CC_NE, ok)
            # The smallest `int` is the only value that converts to it.
            self.a.vmovsd_rm(X1, at_sym(self.f64_const(-9223372036854775807.0 - 1.0), 0))
            self.a.vucomisd(xa, X1)
            bad := self.stub(4, i.arg(0), i.arg(0), i.site, "")
            self.a.jcc(CC_P, bad)
            self.a.jcc(CC_NE, bad)
            self.a.bind(ok)
            self.put_gpr(i.dst, S1)
        "call" => self.call(i)
        "icall" => self.call_out(i)
        "utrap" => self.a.jmp(self.stub(14, i.arg(0), i.arg(0), i.site, ""))
        "prim" => self.prim(i)
        "get" => self.list_get(i)
        "set" => self.list_set(i)
        "bounds" => self.bounds(i)
        "data" =>
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rm(d, at(self.gpr(i.arg(0), S0), 16))
            self.put_gpr(i.dst, d)
        "ldx" => self.indexed_load(i)
        "stx" => self.indexed_store(i)
        "len" =>
            r := self.gpr(i.arg(0), S0)
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rm(d, at(r, 0))
            self.put_gpr(i.dst, d)
        "cap" =>
            r := self.gpr(i.arg(0), S0)
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rm(d, at(r, 8))
            self.put_gpr(i.dst, d)
        "trap" => self.a.jmp(self.stub(i.imm, i.arg(0), i.arg(1), i.site, i.name))
        "load" =>
            r := self.gpr(i.arg(0), S0)
            if self.f.vals[i.dst].is_float()
                d := self.out_xmm(i.dst, X0)
                self.a.vmovsd_rm(d, at(r, i.imm))
                self.put_xmm(i.dst, d)
            else
                d := self.out_gpr(i.dst, S1)
                self.a.mov_rm(d, at(r, i.imm))
                self.put_gpr(i.dst, d)
        "store" =>
            r := self.gpr(i.arg(0), S0)
            v := i.arg(1)
            if self.f.vals[v].is_float()
                self.a.vmovsd_mr(at(r, i.imm), self.xmm(v, X0))
            elif k := self.imm32(v)
                self.a.mov_mi(at(r, i.imm), k)
            else
                self.a.mov_mr(at(r, i.imm), self.gpr(v, S1))
        "copy" =>
            self.parallel([self.move_of(self.loc[i.dst], i.arg(0))])
        "salloc" =>
            # The object's header word has the lowest address and its first
            # field the next one up; slots count downwards from `rbp`.
            d := self.out_gpr(i.dst, S1)
            self.a.lea(d, self.slot(self.sallocs[i.dst] + i.imm / 8 - 1))
            self.put_gpr(i.dst, d)
        _ => unreachable("x64: no code for `{i.op}`")

fn Gen.arith(mut self, i mir.Inst)
    mut x := i.arg(0)
    mut y := i.arg(1)
    # An unchecked `add` or `mul` whose result takes the second operand's
    # register works in place with the operands swapped.
    if i.site < 0
        and i.op != "sub"
        and self.loc[y] == self.loc[i.dst]
        and self.loc[x] != self.loc[y]
        and is_reg(self.loc[y])
        x = i.arg(1)
        y = i.arg(0)
    sym := match i.op
        "add" => "+"
        "sub" => "-"
        _ => "*"
    d := self.out_gpr(i.dst, S1)
    ky := self.imm32(y)
    # In place when the result shares `x`'s register: an overflow stub
    # recovers `x` from the result (add and sub only).
    # An unchecked `mul` has no stub to recover from, so it works in place too.
    if d == self.loc[x] and (i.op != "mul" or i.site < 0) and (ky != none or self.loc[y] != d)
        if i.op == "mul"
            if k := ky
                self.a.imul_rri(d, d, k)
            else
                self.a.imul_rr(d, self.gpr(y, S0))
            return
        if k := ky
            self.a.alu_ri(i.op, d, k)
        else
            self.a.alu_rr(i.op, d, self.gpr(y, S0))
        if i.site >= 0
            l := self.stub(0, x, y, i.site, sym)
            self.stubs[self.stubs.len() - 1].undo = if i.op == "add" then 1 else 2
            self.a.jcc(CC_O, l)
        return
    # An unchecked sum is one `lea`, whatever the result's register (it
    # reads both operands before it writes).
    if i.op == "add" and i.site < 0 and is_reg(self.loc[x])
        if k := ky
            self.a.lea(d, at(self.loc[x], k))
            self.put_gpr(i.dst, d)
            return
        if is_reg(self.loc[y])
            self.a.lea(d, at_index(self.loc[x], self.loc[y], 1, 0))
            self.put_gpr(i.dst, d)
            return
    if i.op == "sub" and i.site < 0 and is_reg(self.loc[x])
        if k := ky
            self.a.lea(d, at(self.loc[x], 0 - k))
            self.put_gpr(i.dst, d)
            return
    # Into the result's register when that leaves `x` and `y` intact.
    mut r := if d != S1 and d != self.loc[x] and d != self.loc[y] then d else S1
    # An unchecked `n * k` writes its result over `n`: `imul d, n, k` allows it.
    if i.op == "mul" and i.site < 0 and (ky != none or self.imm32(x) != none)
        r = d
    # `3 * n`: the constant goes second; the stub still reports `x OP y`.
    kx := self.imm32(x)
    # `1 + n` into `n`'s own register: the stub recovers `n` from the sum.
    if ky == none and kx != none and i.op == "add" and d == self.loc[y]
        self.a.alu_ri("add", d, kx else 0)
        if i.site >= 0
            l := self.stub(0, x, y, i.site, sym)
            self.stubs[self.stubs.len() - 1].undo = 3
            self.a.jcc(CC_O, l)
        return
    if ky == none and kx != none and i.op != "sub"
        k := kx else 0
        if i.op == "mul"
            self.a.imul_rri(r, self.gpr(y, r), k)
        else
            self.a.mov_rr(r, self.gpr(y, r))
            self.a.alu_ri(i.op, r, k)
        if i.site >= 0
            self.a.jcc(CC_O, self.stub(0, x, y, i.site, sym))
        self.put_gpr(i.dst, r)
        return
    if k := ky
        if i.op == "mul"
            self.a.imul_rri(r, self.gpr(x, r), k)
        else
            self.a.mov_rr(r, self.gpr(x, r))
            self.a.alu_ri(i.op, r, k)
    else
        self.a.mov_rr(r, self.gpr(x, r))
        rb := self.gpr(y, S0)
        if i.op == "mul"
            self.a.imul_rr(r, rb)
        else
            self.a.alu_rr(i.op, r, rb)
    if i.site >= 0
        self.a.jcc(CC_O, self.stub(0, x, y, i.site, sym))
    self.put_gpr(i.dst, r)

## `idiv`: traps on a zero divisor (expr.arith.3) and on the smallest `int`
## divided by -1 (expr.arith.1); `x % -1` is 0 (expr.arith.5).
fn Gen.divide(mut self, i mir.Inst)
    x := i.arg(0)
    y := i.arg(1)
    sym := if i.op == "div" then "/" else "%"
    done := self.a.label()
    if k := self.imm(y)
        if k == 0
            if i.site >= 0
                self.a.jmp(self.stub(1, x, y, i.site, sym))
            else
                self.a.ud2()
            return
        if k == -1
            if i.op == "rem"
                self.a.mov_ri(S1, 0)
            else
                self.a.mov_rr(S1, self.gpr(x, S1))
                self.a.neg(S1)
                if i.site >= 0
                    self.a.jcc(CC_O, self.stub(0, x, y, i.site, sym))
            self.put_gpr(i.dst, S1)
            return
        if k > 0 and power_of_two(k) >= 0
            self.shift_divide(i, power_of_two(k))
            return
        if k > 2 and k < 2147483648
            self.magic_divide(i, k)
            return
        self.a.mov_ri(S0, k)
    else
        # The divisor in r10, the dividend in rax. A value in rdx is the
        # division's own operand or result: the allocator keeps others out
        # of it (ADR 1049).
        rb := self.gpr(y, S0)
        self.a.mov_rr(S0, rb)
        if i.site >= 0
            self.a.test_rr(S0, S0)
            self.a.jcc(CC_E, self.stub(1, x, y, i.site, sym))
        go := self.a.label()
        self.a.alu_ri("cmp", S0, -1)
        self.a.jcc(CC_NE, go)
        if i.op == "rem"
            self.a.mov_ri(RDX, 0)
            self.a.jmp(done)
        else
            self.a.mov_rr(RAX, self.gpr(x, RAX))
            self.a.neg(RAX)
            if i.site >= 0
                self.a.jcc(CC_O, self.stub(0, x, y, i.site, sym))
            self.a.jmp(done)
        self.a.bind(go)
    self.a.mov_rr(RAX, self.gpr(x, RAX))
    self.a.cqo()
    self.a.idiv(S0)
    self.a.bind(done)
    self.put_gpr(i.dst, if i.op == "div" then RAX else RDX)

## The `k` with `n == 2^k`, or -1.
fn power_of_two(n int) int
    mut k := 0
    mut v := 1
    while v < n and k < 62
        v = v * 2
        k += 1
    if v == n then k else -1

## Signed division and remainder by `2^k` rounding toward zero, with shifts:
## a negative dividend is biased by `2^k - 1` first.
fn Gen.shift_divide(mut self, i mir.Inst, k int)
    x := self.gpr(i.arg(0), S0)
    if i.op == "div"
        # Into the result's register (or r10, which `x` may share: it is
        # read for the last time as `d` is written); the bias is taken from
        # `x` first, in rax.
        d := self.out_gpr(i.dst, S0)
        if k > 0
            self.a.mov_rr(RAX, x)
            if k > 1
                self.a.shift_ri("sar", RAX, 63)
            self.a.shift_ri("shr", RAX, 64 - k)
        self.a.mov_rr(d, x)
        if k > 0
            self.a.alu_rr("add", d, RAX)
        self.a.shift_ri("sar", d, k)
        self.put_gpr(i.dst, d)
        return
    # x - (biased x with the low k bits cleared), all in rax.
    self.a.mov_rr(RAX, x)
    if k > 0
        if k > 1
            self.a.shift_ri("sar", RAX, 63)
        self.a.shift_ri("shr", RAX, 64 - k)
        self.a.alu_rr("add", RAX, x)
    self.a.shift_ri("sar", RAX, k)
    self.a.shift_ri("shl", RAX, k)
    self.a.neg(RAX)
    self.a.alu_rr("add", RAX, x)
    self.put_gpr(i.dst, RAX)

## Division and remainder by a constant `k` with a high multiply
## (`codegen.div_magic`), not `idiv`.
fn Gen.magic_divide(mut self, i mir.Inst, k int)
    mut x := self.gpr(i.arg(0), S0)
    # The high multiply writes rdx, which may hold `x` itself (ADR 1049).
    if x == RDX
        self.a.mov_rr(S0, RDX)
        x = S0
    mg := codegen.div_magic(k)
    self.a.mov_ri(RAX, mg[0])
    self.a.imul1(x)
    self.a.alu_rr("add", RDX, x)
    if mg[1] > 0
        self.a.shift_ri("sar", RDX, mg[1])
    self.a.mov_rr(RAX, x)
    self.a.shift_ri("shr", RAX, 63)
    self.a.alu_rr("add", RDX, RAX)
    if i.op == "div"
        self.put_gpr(i.dst, RDX)
        return
    self.a.imul_rri(RDX, RDX, k)
    self.a.mov_rr(RAX, x)
    self.a.alu_rr("sub", RAX, RDX)
    self.put_gpr(i.dst, RAX)

## A shift traps on a count outside 0..=63 (expr.bit.2).
fn Gen.shift(mut self, i mir.Inst)
    x := i.arg(0)
    n := i.arg(1)
    sar := i.op == "shr"
    if k := self.imm(n)
        if k >= 0 and k <= 63
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rr(d, self.gpr(x, d))
            self.a.shift_ri(if sar then "sar" else "shl", d, k)
            self.put_gpr(i.dst, d)
            return
    c := self.gpr(n, S0)
    if i.site >= 0
        self.a.alu_ri("cmp", c, 63)
        self.a.jcc(CC_A, self.stub(6, n, n, i.site, ""))
    d := self.out_gpr(i.dst, S1)
    r := self.gpr(x, S1)
    if sar
        self.a.sarx(d, r, c)
    else
        self.a.shlx(d, r, c)
    self.put_gpr(i.dst, d)

fn Gen.call(mut self, i mir.Inst)
    if codegen.is_push(i)
        self.push(i)
        return
    self.call_out(i)

## `xs.push(v)` with room to spare is a store and a length update; only a
## full list calls the runtime, which grows it (native-abi.md §2).
fn Gen.push(mut self, i mir.Inst)
    l := self.gpr(i.arg(0), S0)
    # `imm` 1: a loop guard saw room for every push the loop makes (native.bce.6).
    room := i.imm == 1
    slow := self.a.label()
    done := self.a.label()
    self.a.mov_rm(RAX, at(l, 0))
    if not room
        self.a.alu_rm("cmp", RAX, at(l, 8))
        self.a.jcc(CC_E, slow)
    v := i.arg(1)
    fl := self.f.vals[v].is_float()
    w := if fl then 8 else mir.push_bytes(i.name)
    if fl or not self.needs_reg(v, w)
        # The elements' address in r10, then the new length from rax; a
        # list held in r10 itself is loaded again for that store.
        self.a.mov_rm(S0, at(l, 16))
        if fl
            self.a.vmovsd_mr(at_index(S0, RAX, 8, 0), self.xmm(v, X0))
        else
            self.store_w(at_index(S0, RAX, w, 0), v, w)
        self.a.alu_ri("add", RAX, 1)
        self.a.mov_mr(at(self.gpr(i.arg(0), S0), 0), RAX)
    else
        # The value needs rax too: the length goes up in memory first, so
        # r10 is free for the elements' address (nothing runs between the
        # two stores).
        self.a.alu_mi("add", at(l, 0), 1)
        self.a.mov_rm(S0, at(l, 16))
        self.store_at(at_index(S0, RAX, w, 0), v, w)
    if room
        return
    self.a.jmp(done)
    self.a.bind(slow)
    # The runtime may use any caller-saved register: keep ours around it.
    mut ints := List[int]()
    mut floats := List[int]()
    for r in self.caller_used
        if r >= codegen.FLOAT_BASE
            floats.push(r - codegen.FLOAT_BASE)
        else
            ints.push(r)
    for r in ints
        self.a.push(r)
    mut size := 8 * floats.len()
    if (size + 8 * ints.len()) % 16 != 0
        size += 8
    if size > 0
        self.a.alu_ri("sub", RSP, size)
    for k in 0..floats.len()
        self.a.vmovsd_mr(at(RSP, 8 * k), floats[k])
    self.call_out(i)
    for k in 0..floats.len()
        self.a.vmovsd_rm(floats[k], at(RSP, 8 * k))
    if size > 0
        self.a.alu_ri("add", RSP, size)
    mut k := ints.len() - 1
    while k >= 0
        self.a.pop(ints[k])
        k -= 1
    self.a.bind(done)

fn Gen.call_out(mut self, i mir.Inst)
    if i.name.starts_with("libsys.")
        # System DLL calls exist on Windows (ADR 0606). On Linux a call is
        # through the slot the dynamic loader binds (ADR 0870), made below as
        # any call is. macOS names start with `_` and trap here.
        sym := i.name.replace("libsys.", "")
        if self.win and not sym.starts_with("_") and not codegen.linux_import(sym)
            self.libsys_call(i)
            return
        if self.win or not codegen.linux_import(sym)
            self.a.ud2()
            return
    if i.site >= 0 and self.sites.list[i.site].kind != "frame"
        # The stack check of err.trap.1 (ADR 0535): below the limit, trap.
        self.a.alu_rm("cmp", RSP, at_sym("globals", 8 * STACK_LIMIT))
        self.a.jcc(CC_B, self.stub(11, -1, -1, i.site, self.sites.list[i.site].op))
    mut moves := List[Move]()
    mut ni := 0
    mut nf := 0
    # A call through a value (`icall`) takes the callee first, into the scratch register.
    indirect := i.op == "icall"
    # A C function (`icall` named "c", ADR 0870) may clobber xmm8-xmm13, which
    # AIL functions keep: save them around the call.
    c_call := indirect and (i.name == "c" or i.name.starts_with("cv"))
    # A variadic call (`cv<N>`, ADR 1031).
    variadic := c_call and i.name.starts_with("cv")
    # On Windows the C convention is Win64 (ffi.load.3): the argument's position
    # names its register (rcx rdx r8 r9 or xmm0-3), 32 bytes of shadow space come
    # first, later arguments go on the stack, and xmm6-xmm15 are the callee's to keep.
    winc := c_call and self.win
    if c_call and not winc
        self.a.alu_ri("sub", RSP, 48)
        for k in 0..6
            self.a.vmovsd_mr(at(RSP, 8 * k), 8 + k)
    mut extra := List[int]()
    for k in 0..i.argc()
        v := i.arg(k)
        if indirect and k == 0
            moves.push(self.move_of(S0, v))
        elif winc
            if k > 4
                extra.push(v)
            elif self.f.vals[v].is_float()
                moves.push(self.move_of(codegen.FLOAT_BASE + k - 1, v))
            else
                moves.push(self.move_of(WIN_INT_ARGS[k - 1], v))
        elif self.f.vals[v].is_float()
            moves.push(self.move_of(codegen.FLOAT_BASE + nf, v))
            nf += 1
        elif ni < INT_ARGS.len()
            moves.push(self.move_of(INT_ARGS[ni], v))
            ni += 1
        else
            extra.push(v)
    # Integer arguments after the sixth go on the stack, the seventh lowest,
    # in a 16-byte multiple (native-abi.md §1).
    shadow := if winc then 32 else 0
    room := (shadow + 8 * extra.len() + 15) / 16 * 16
    if room > 0
        self.a.alu_ri("sub", RSP, room)
        for k in 0..extra.len()
            if self.f.vals[extra[k]].is_float()
                self.a.vmovsd_mr(at(RSP, shadow + 8 * k), self.xmm(extra[k], X0))
            else
                self.a.mov_mr(at(RSP, shadow + 8 * k), self.gpr(extra[k], S0))
    self.parallel(moves)
    if variadic
        if winc
            # Win64 (ffi.var.4): a float among the first four arguments is also in
            # the integer register of its position.
            for k in 1..i.argc().min(5)
                if self.f.vals[i.arg(k)].is_float()
                    self.a.vmovq_rx(WIN_INT_ARGS[k - 1], k - 1)
        else
            # System V (ffi.var.4): `al` is an upper bound of the vector registers used.
            self.a.mov_ri(RAX, nf)
    if indirect
        self.a.call_reg(S0)
    elif i.name.starts_with("libsys.")
        sym := i.name.replace("libsys.", "")
        self.imports.push(sym)
        self.a.call_import(sym)
    else
        self.a.call_sym(i.name)
    if i.imm != 0
        # The return address, for a trap's stack (trace.frame.1).
        self.calls.push(codegen.CallRow(
            off: self.a.code.len(),
            pos: i.imm,
            func: self.call_func(i),
        ))
        # A call copied in by inlining (trace.frame.2) also stands for the
        # frames it was inlined into: a row for each, innermost first.
        if i.site >= 0
            mut fs := self.sites.list[i.site]
            while fs.from >= 0
                fs = self.sites.list[fs.from]
                self.calls.push(codegen.CallRow(
                    off: self.a.code.len(),
                    pos: mir.call_pos(fs.file, fs.line, fs.col),
                    func: fs.func,
                ))
    if room > 0
        self.a.alu_ri("add", RSP, room)
    if c_call and not winc
        for k in 0..6
            self.a.vmovsd_rm(8 + k, at(RSP, 8 * k))
        self.a.alu_ri("add", RSP, 48)
    if i.dst >= 0
        if self.f.vals[i.dst].is_float()
            self.put_xmm(i.dst, 0)
        else
            self.put_gpr(i.dst, RAX)

## The function a call is written in, for its row of a trap's stack: a call
## copied in by inlining another function (trace.frame.2) names that function.
fn Gen.call_func(self, i mir.Inst) str
    if i.site >= 0 and self.sites.list[i.site].from >= 0
        return self.sites.list[i.site].func
    self.f.name

## The memory a load or store prim addresses.
fn Gen.address(mut self, i mir.Inst) Mem
    v := i.arg(0)
    store := i.name.starts_with("store")
    # `base + index * scale + offset` (an indexed load has two arguments,
    # an indexed store three): the primitive's `imm` holds the offset, or
    # offset * 16 + log2(scale).
    if i.argc() == (if store then 3 else 2)
        mut b := self.gpr(v, S0)
        if self.globs.contains(v)
            self.a.lea(S0, at_sym("globals", 8 * self.globs[v]))
            b = S0
        return at_index(b, self.gpr(i.arg(1), S1), 1.shl(i.imm % 16), i.imm / 16)
    if self.globs.contains(v)
        return at_sym("globals", 8 * self.globs[v] + i.imm)
    at(self.gpr(v, S0), i.imm)

fn Gen.prim(mut self, i mir.Inst)
    if i.name.starts_with("fn_addr:")
        # The address of a runtime function, for an import that takes a callback
        # (a Windows thread's start routine, ADR 0599): a relative lea of its symbol.
        d := self.out_gpr(i.dst, S1)
        self.a.lea(d, at_sym(i.name.replace("fn_addr:", ""), 0))
        self.put_gpr(i.dst, d)
        return
    match i.name
        "load64" =>
            mem := self.address(i)
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rm(d, mem)
            self.put_gpr(i.dst, d)
        "load8" =>
            mem := self.address(i)
            d := self.out_gpr(i.dst, S1)
            self.a.movzx8_rm(d, mem)
            self.put_gpr(i.dst, d)
        "loadf" =>
            mem := self.address(i)
            d := self.out_xmm(i.dst, X0)
            self.a.vmovsd_rm(d, mem)
            self.put_xmm(i.dst, d)
        "store64" =>
            self.store_at(self.address(i), i.arg(i.argc() - 1), 8)
        "store8" =>
            self.store_at(self.address(i), i.arg(i.argc() - 1), 1)
        "storef" =>
            v := self.xmm(i.arg(i.argc() - 1), X0)
            self.a.vmovsd_mr(self.address(i), v)
        "loadf32" =>
            # One packed single (ADR 0875), widened exactly.
            mem := self.address(i)
            d := self.out_xmm(i.dst, X0)
            self.a.vmovss_rm(d, mem)
            self.a.vcvtss2sd(d, d, d)
            self.put_xmm(i.dst, d)
        "storef32" =>
            # The `float` (a rounded `f32` value, or rounded here) as a single.
            v := self.xmm(i.arg(i.argc() - 1), X0)
            self.a.vcvtsd2ss(X1, v, v)
            self.a.vmovss_mr(self.address(i), X1)
        "pload8" | "pload16" | "pload32" | "pload64" =>
            # A raw pointer's read (ADR 0835): the width in the name, the
            # result zero-extended. Never moved, merged or dropped.
            mem := at(self.gpr(i.arg(0), S0), 0)
            d := self.out_gpr(i.dst, S1)
            if i.name == "pload8"
                self.a.movzx8_rm(d, mem)
            elif i.name == "pload16"
                self.a.movzx16_rm(d, mem)
            elif i.name == "pload32"
                self.a.mov32_rm(d, mem)
            else
                self.a.mov_rm(d, mem)
            self.put_gpr(i.dst, d)
        "pstore8" | "pstore16" | "pstore32" | "pstore64" =>
            mem := at(self.gpr(i.arg(0), S0), 0)
            if i.name == "pstore8"
                self.store_byte(mem, i.arg(1))
            elif i.name == "pstore64"
                self.store_word(mem, i.arg(1))
            else
                v := self.gpr(i.arg(1), RAX)
                if i.name == "pstore16"
                    self.a.mov16_mr(mem, v)
                else
                    self.a.mov32_mr(mem, v)
        "pfence" | "pfence_io" =>
            self.a.mfence()
        # Freestanding targets only (ADR 0953): byte port I/O and halt.
        "port_out8" =>
            self.parallel([self.move_of(RDX, i.arg(0)), self.move_of(RAX, i.arg(1))])
            self.a.out_dx_al()
        "port_in8" =>
            self.parallel([self.move_of(RDX, i.arg(0))])
            self.a.mov_ri(RAX, 0)
            self.a.in_al_dx()
            self.put_gpr(i.dst, RAX)
        "halt" =>
            self.a.hlt()
        "syscall" =>
            regs := [RAX, RDI, RSI, RDX, S0, R8, R9]
            self.parallel([self.move_of(regs[k], i.arg(k)) for k in 0..i.argc()])
            self.a.syscall()
            self.put_gpr(i.dst, RAX)
        "global" =>
            if self.globs.contains(i.dst)
                return
            d := self.out_gpr(i.dst, S1)
            k := self.imm(i.arg(0)) else 0
            self.a.lea(d, at_sym("globals", 8 * k))
            self.put_gpr(i.dst, d)
        # Threads and atomics (ADRs 0599, 0600). The atomic operations are
        # sequentially consistent: x86-64 loads are acquire, stores are `xchg`.
        "atomic_load" =>
            r := self.gpr(i.arg(0), S0)
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rm(d, at(r, 0))
            self.put_gpr(i.dst, d)
        "atomic_store" | "atomic_xchg" =>
            cell := at(self.gpr(i.arg(0), S0), 0)
            self.parallel([self.move_of(RAX, i.arg(1))])
            self.a.xchg_mr(cell, RAX)
            if i.dst >= 0
                self.put_gpr(i.dst, RAX)
        "atomic_add" =>
            cell := at(self.gpr(i.arg(0), S0), 0)
            self.parallel([self.move_of(RAX, i.arg(1))])
            self.a.lock_xadd(cell, RAX)
            self.put_gpr(i.dst, RAX)
        "atomic_cas" =>
            cell := at(self.gpr(i.arg(0), S0), 0)
            self.parallel([self.move_of(RAX, i.arg(1))])
            nv := i.arg(2)
            if is_reg(self.loc[nv])
                self.a.lock_cmpxchg(cell, self.loc[nv])
            else
                # Both scratch registers are taken: borrow one that is not
                # the cell's, kept on the stack around the exchange.
                tmp := if cell.base == 11 then RDX else 11
                self.a.push(tmp)
                self.a.lock_cmpxchg(cell, self.gpr(nv, tmp))
                self.a.pop(tmp)
            self.put_gpr(i.dst, RAX)
        "sp" =>
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rr(d, RSP)
            self.put_gpr(i.dst, d)
        "clone" =>
            # clone(CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM, stack, 0, 0, arg):
            # the child resumes here on the new stack with rax 0 and runs
            # `rt.worker_main(arg)`; the argument rides in r8 (unused as tls).
            self.parallel([self.move_of(RSI, i.arg(0)), self.move_of(R8, i.arg(1))])
            self.a.mov_ri(RDI, 331520)
            self.a.mov_ri(RDX, 0)
            self.a.mov_ri(S0, 0)
            self.a.mov_ri(RAX, 56)
            self.a.syscall()
            parent := self.a.label()
            self.a.test_rr(RAX, RAX)
            self.a.jcc(CC_NE, parent)
            self.a.mov_rr(RDI, R8)
            self.a.alu_rr("xor", RBP, RBP)
            self.a.call_sym("rt.worker_main")
            self.a.ud2()
            self.a.bind(parent)
            self.put_gpr(i.dst, RAX)
        "win_arg0" =>
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rr(d, RCX)
            self.put_gpr(i.dst, d)
        "sigreturn" =>
            # Entered by the handler's `ret`, so the signal frame starts at
            # the slot above the saved rbp (the prologue is push rbp; mov rbp, rsp).
            self.a.lea(RSP, at(RBP, 8))
            self.a.mov_ri(RAX, 15)
            self.a.syscall()
            self.a.ud2()
        "restart" =>
            # Abandon this thread's frames: run `rt.worker_main(arg)` on a
            # fresh stack at `top`.
            self.parallel([self.move_of(RAX, i.arg(0)), self.move_of(RDI, i.arg(1))])
            self.a.mov_rr(RSP, RAX)
            self.a.alu_rr("xor", RBP, RBP)
            self.a.call_sym("rt.worker_main")
            self.a.ud2()
        "globals_end" =>
            d := self.out_gpr(i.dst, S1)
            self.a.lea(d, at_sym("globals", 8 * self.nglobals))
            self.put_gpr(i.dst, d)
        "gc_regs" =>
            b := self.gpr(i.arg(0), S0)
            for k in 0..5
                self.a.mov_mr(at(b, 8 * k), [RBX, 12, 13, 14, 15][k])
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rr(d, RSP)
            self.put_gpr(i.dst, d)
        "target" =>
            d := self.out_gpr(i.dst, S1)
            self.a.mov_ri(d, if self.bare then 4 else if self.win then 3 else 0)
            self.put_gpr(i.dst, d)
        "code_tab" =>
            d := self.out_gpr(i.dst, S1)
            self.a.lea(d, at_sym("trace.tab", 0))
            self.put_gpr(i.dst, d)
        "frame_ptr" =>
            d := self.out_gpr(i.dst, S1)
            self.a.mov_rr(d, RBP)
            self.put_gpr(i.dst, d)
        "str_addr" | "str_at" | "list_addr" | "list_at" =>
            self.parallel([self.move_of(self.loc[i.dst], i.arg(0))])
        "float_bits" =>
            d := self.out_gpr(i.dst, S1)
            self.a.vmovq_rx(d, self.xmm(i.arg(0), X0))
            self.put_gpr(i.dst, d)
        "bits_float" =>
            d := self.out_xmm(i.dst, X0)
            self.a.vmovq_xr(d, self.gpr(i.arg(0), S0))
            self.put_xmm(i.dst, d)
        "f32_round" =>
            xa := self.xmm(i.arg(0), X0)
            d := self.out_xmm(i.dst, X0)
            self.a.vcvtsd2ss(X1, xa, xa)
            self.a.vcvtss2sd(d, X1, X1)
            self.put_xmm(i.dst, d)
        _ => unreachable("x64: unknown primitive {i.name}")

## `xs[i]`: the list in r10, the index in rax, then the elements' address
## in r10. The element's address, after the bounds check. A `List[bool]`
## holds one byte per element, other lists 8 (native-abi.md §2).
fn Gen.list_index(mut self, i mir.Inst, size int) Mem
    l := self.gpr(i.arg(0), S0)
    if k := self.imm32(i.arg(1))
        if i.site >= 0
            self.a.alu_mi("cmp", at(l, 0), k)
            self.a.jcc(CC_BE, self.stub(3, i.arg(1), i.arg(0), i.site, ""))
        self.a.mov_rm(S0, at(l, 16))
        return at(S0, size * k)
    x := self.gpr(i.arg(1), RAX)
    if i.site >= 0
        self.a.alu_rm("cmp", x, at(l, 0))
        self.a.jcc(CC_AE, self.stub(3, i.arg(1), i.arg(0), i.site, ""))
    self.a.mov_rm(S0, at(l, 16))
    at_index(S0, x, size, 0)

## `bounds idx, len`: the check of a `get` or `set` whose list header was
## hoisted out of a loop (ADR 0890): trap at `site` unless `0 <= idx < len`.
## The stub gets the length itself, not the list.
fn Gen.bounds(mut self, i mir.Inst)
    # A length that is a constant (a list built with a known count,
    # native.bce.15) is compared as an immediate.
    if n := self.imm32(i.arg(1))
        if self.imm(i.arg(0)) == none
            self.a.alu_ri("cmp", self.gpr(i.arg(0), S1), n)
            self.a.jcc(CC_AE, self.stub(3, i.arg(0), i.arg(1), i.site, ""))
            self.stubs[self.stubs.len() - 1].undo = 4
            return
    l := self.gpr(i.arg(1), S0)
    if k := self.imm32(i.arg(0))
        self.a.alu_ri("cmp", l, k)
        self.a.jcc(CC_BE, self.stub(3, i.arg(0), i.arg(1), i.site, ""))
    else
        self.a.alu_rr("cmp", self.gpr(i.arg(0), S1), l)
        self.a.jcc(CC_AE, self.stub(3, i.arg(0), i.arg(1), i.site, ""))
    self.stubs[self.stubs.len() - 1].undo = 4

fn Gen.list_get(mut self, i mir.Inst)
    t := self.f.vals[i.dst]
    if t.is_float()
        mem := self.list_index(i, 8)
        d := self.out_xmm(i.dst, X0)
        self.a.vmovsd_rm(d, mem)
        self.put_xmm(i.dst, d)
    else
        w := t.elem_bytes()
        mem := self.list_index(i, w)
        d := self.out_gpr(i.dst, S1)
        self.load_w(d, mem, w)
        self.put_gpr(i.dst, d)

fn Gen.list_set(mut self, i mir.Inst)
    v := i.arg(2)
    t := self.f.vals[v]
    if t.is_float()
        x := self.xmm(v, X0)
        self.a.vmovsd_mr(self.list_index(i, 8), x)
    else
        w := t.elem_bytes()
        self.store_at(self.list_index(i, w), v, w)

## `ldx`/`stx`: the element at `base[index]`, `imm` bytes each (ADR 0577).
fn Gen.indexed_mem(mut self, i mir.Inst) Mem
    b := self.gpr(i.arg(0), S0)
    if k := self.imm32(i.arg(1))
        return at(b, i.imm * (k + i.elem_off()))
    at_index(b, self.gpr(i.arg(1), S1), i.imm, i.imm * i.elem_off())

fn Gen.indexed_load(mut self, i mir.Inst)
    mem := self.indexed_mem(i)
    if self.f.vals[i.dst].is_float()
        d := self.out_xmm(i.dst, X0)
        self.a.vmovsd_rm(d, mem)
        self.put_xmm(i.dst, d)
    else
        d := self.out_gpr(i.dst, S1)
        self.load_w(d, mem, i.imm)
        self.put_gpr(i.dst, d)

fn Gen.indexed_store(mut self, i mir.Inst)
    v := i.arg(2)
    mem := self.indexed_mem(i)
    if self.f.vals[v].is_float()
        self.a.vmovsd_mr(mem, self.xmm(v, X0))
    else
        self.store_at(mem, v, i.imm)

## An element of `w` bytes (1, 2, 4 or 8): a load zero-extends it.
fn Gen.load_w(mut self, d int, mem Mem, w int)
    if w == 1
        self.a.movzx8_rm(d, mem)
    elif w == 2
        self.a.movzx16_rm(d, mem)
    elif w == 4
        self.a.mov32_rm(d, mem)
    else
        self.a.mov_rm(d, mem)

## Store `v` (`w` bytes) at `mem`, through rax when it is in no register.
## An address that uses rax itself (a spilled index) is first put in r10
## (ADR 1049).
fn Gen.store_at(mut self, mem Mem, v int, w int)
    mut m := mem
    if self.needs_reg(v, w) and (m.base == RAX or m.index == RAX)
        self.a.lea(S0, m)
        m = at(S0, 0)
    self.store_w(m, v, w)

## Whether storing `v` in `w` bytes takes a register: it is in none and no
## immediate stands for it.
fn Gen.needs_reg(self, v int, w int) bool
    if is_reg(self.loc[v])
        return false
    if w == 1
        return self.imm(v) == none
    if w == 8
        return self.imm32(v) == none
    true

## The store itself; `mem` does not use rax unless `v` is in a register or
## an immediate.
fn Gen.store_w(mut self, mem Mem, v int, w int)
    if w == 1
        self.store_byte(mem, v)
    elif w == 2
        self.a.mov16_mr(mem, self.gpr(v, RAX))
    elif w == 4
        self.a.mov32_mr(mem, self.gpr(v, RAX))
    else
        self.store_word(mem, v)

## Store the `int` or `bool` `v` as a word or a byte: a constant goes in as an
## immediate, not through a register.
fn Gen.store_word(mut self, mem Mem, v int)
    if k := self.imm32(v)
        self.a.mov_mi(mem, k)
    else
        self.a.mov_mr(mem, self.gpr(v, RAX))

fn Gen.store_byte(mut self, mem Mem, v int)
    if k := self.imm(v)
        self.a.mov8_mi(mem, k.bit_and(255))
    else
        self.a.mov8_mr(mem, self.gpr(v, RAX))

# ---- trap stubs ----

fn Gen.gen_stubs(mut self)
    for s in self.stubs
        self.a.bind(s.label)
        mut moves := List[Move]()
        moves.push(Move(dst: RDI, src: -1, imm: s.kind, sym: "", float: false))
        if s.kind == 4
            # The float's bits.
            self.a.vmovq_rx(RSI, self.xmm(s.a, X0))
        elif s.kind != 11
            moves.push(self.move_of(RSI, s.a))
        if s.kind != 11
            moves.push(self.move_of(RDX, s.b))
        moves.push(Move(dst: RCX, src: -1, imm: 0, sym: "d:h{s.site}", float: false))
        moves.push(Move(dst: R8, src: -1, imm: 0, sym: "d:o{s.op}", float: false))
        moves.push(Move(dst: R9, src: -1, imm: 0, sym: "d:t{s.site}", float: false))
        if s.kind == 4
            moves.remove_at(1)
        self.parallel(moves)
        if s.undo == 1
            self.a.alu_rr("sub", RSI, RDX)
        elif s.undo == 2
            self.a.alu_rr("add", RSI, RDX)
        elif s.undo == 3
            self.a.alu_rr("sub", RDX, RSI)
        if s.kind == 3 and s.undo != 4
            # The list's length.
            self.a.mov_rm(RDX, at(RDX, 0))
        self.a.call_sym("rt.trap")
        self.a.ud2()
