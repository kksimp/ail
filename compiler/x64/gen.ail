## x86-64 code generation from allocated MIR (ADR 0385). Each function is
## laid out in reverse postorder with a frame of `rbp`, the callee-saved
## registers it uses, and its spill slots; checks branch to stubs at the end
## of the function that call `rt.trap` with the site's text and operands
## (native-abi.md §7). The result is a `codegen.Image` for the object
## writer.
use mir
use codegen

## Scratch registers, never allocated (native-abi.md §3).
S0 := 10
S1 := 11
X0 := 14
X1 := 15

## Allocatable registers, best first.
pub fn registers() codegen.Target
    codegen.Target(
        int_caller: [RSI, RDI, R8, R9, RCX],
        int_callee: [RBX, 12, 13, 14, 15],
        float_caller: [32, 33, 34, 35, 36, 37, 38, 39],
        float_callee: [40, 41, 42, 43, 44, 45],
        int_args: INT_ARGS,
        float_args: [32, 33, 34, 35, 36, 37, 38, 39],
    )

INT_ARGS := [7, 6, 2, 1, 8, 9]

## A move of the parallel moves at an edge or a call: into location `dst`
## from location `src`, or from a constant (`imm`) or a symbol's address.
struct Move
    dst int
    src int
    imm int
    sym str
    float bool

## A trap stub: where checks jump, and what it passes to `rt.trap`.
struct Stub
    label int
    kind int
    a int
    b int
    site int
    op str
    ## 1: the result overwrote `a`, which is result - b (an add); 2: result + b
    ## (a sub). The stub undoes it before reporting.
    undo int

struct Gen
    a Asm
    ## The Windows target (ADR 0608): `target()` is 3.
    win bool
    img codegen.Image
    m mir.Module
    f mir.Func
    loc List[int]
    blabels List[int]
    next_block int
    remat List[mir.Inst]
    uses List[int]
    stubs List[Stub]
    saved_ints List[int]
    saved_floats List[int]
    slot_base int
    frame int
    ## Caller-saved registers in use, which a `push`'s slow path saves.
    caller_used List[int]
    ## Globals whose address only loads and stores use: the access is
    ## `[rip + globals + 8k]` and the `lea` is skipped (ADR 0623).
    globs Map[int, int]
    ## Shrink-wrapping (ADR 0625): the block that saves the callee-saved
    ## registers (-1: the prologue does), and the blocks whose returns
    ## restore them.
    wrap int
    region List[bool]

## Generate the whole program: `_start`, then each function.
pub fn generate(m mir.Module) codegen.Image
    mut img := codegen.new_image()
    img.globals = m.globals_used()
    for i in 0..m.strs.len()
        codegen.add_str(mut img, "d:s{i}", m.strs[i])
    mut a := new_asm()
    # _start: pass argc and argv to `rt.init`, align the stack, run `main`,
    # exit 0.
    a.alu_rr("xor", RBP, RBP)
    a.mov_rm(RDI, at(RSP, 0))
    a.lea(RSI, at(RSP, 8))
    a.alu_ri("and", RSP, -16)
    a.call_sym("rt.init")
    a.call_sym("main")
    a.mov_ri(RDI, 0)
    a.call_sym("rt.exit")
    a.ud2()
    img.code = a.code
    for fx in a.fixups
        img.relocs.push(codegen.Reloc(at: fx.at, kind: "rel32", sym: fx.sym, tail: fx.tail))
    for f in m.funcs
        gen_func(mut img, m, f, false)
    img

## `win` is set for the Windows target: `target()` is then 3 (ADR 0608).
fn gen_func(mut img codegen.Image, m mir.Module, f0 mir.Func, win bool)
    f := codegen.split_for_calls(codegen.split_edges(f0))
    al := codegen.allocate(f, registers())
    mut remat := [mir.inst(-1, "", []) for _ in 0..f.vals.len()]
    mut uses := [0 for _ in 0..f.vals.len()]
    for blk in f.blocks
        for i in blk.insts
            if codegen.is_remat(i)
                remat[i.dst] = i
            for u in i.args
                uses[u] += 1
        for u in blk.term.uses()
            uses[u] += 1
    mut globs := Map[int, int]()
    mut addr_uses := [0 for _ in 0..f.vals.len()]
    for blk in f.blocks
        for i in blk.insts
            if i.op == "prim"
                and (i.name == "load64" or i.name == "load8" or i.name == "loadf" or i.name == "store64" or i.name == "store8" or i.name == "storef")
                addr_uses[i.args[0]] += 1
    for blk in f.blocks
        for i in blk.insts
            if i.op == "prim" and i.name == "global" and remat[i.args[0]].op == "const"
                if addr_uses[i.dst] == uses[i.dst] and uses[i.dst] > 0
                    globs[i.dst] = remat[i.args[0]].imm
    mut g := Gen(
        a: new_asm(),
        win: win,
        img: img,
        m: m,
        f: f,
        loc: al.loc,
        blabels: [],
        next_block: -1,
        remat: remat,
        uses: uses,
        stubs: [],
        saved_ints: [],
        saved_floats: [],
        slot_base: 0,
        frame: 0,
        caller_used: codegen.caller_used(al, registers()),
        globs: globs,
        wrap: al.wrap,
        region: al.region,
    )
    for r in al.saved
        if r >= codegen.FLOAT_BASE
            g.saved_floats.push(r)
        else
            g.saved_ints.push(r)
    g.blabels = [g.a.label() for _ in 0..f.blocks.len()]
    g.prologue(al.slots)
    # The entry block's parameters arrive in the argument registers.
    g.entry_moves()
    for k in 0..al.order.len()
        b := al.order[k]
        g.next_block = if k + 1 < al.order.len() then al.order[k + 1] else -1
        g.a.bind(g.blabels[b])
        g.gen_block(b)
    g.gen_stubs()
    g.a.resolve_labels()
    img = g.img
    base := img.code.len()
    img.funcs[f.name] = base
    img.code.extend(g.a.code)
    for fx in g.a.fixups
        img.relocs.push(codegen.Reloc(at: fx.at + base, kind: "rel32", sym: fx.sym, tail: fx.tail))

# ---- frame ----

fn Gen.prologue(mut self, slots int)
    a.push(RBP)
    a.mov_rr(RBP, RSP)
    if wrap < 0
        for r in saved_ints
            a.push(r)
    # Saved vector registers sit just below the pushed ones, spill slots
    # below them.
    ints := 8 * saved_ints.len()
    slot_base = ints + 8 * saved_floats.len()
    mut size := 8 * (slots + saved_floats.len())
    while (size + ints) % 16 != 0
        size += 8
    frame = size
    # Shrink-wrapped, the saved integer registers have their place in the
    # frame, where the pushes would have put them.
    if wrap >= 0
        size += ints
    if size > 0
        a.alu_ri("sub", RSP, size)
    if wrap < 0
        save_registers(true)

## Save or restore the callee-saved registers: the integer ones at
## `rbp - 8 * (j + 1)` (where a push puts them), the vector ones below.
fn Gen.save_registers(mut self, out bool)
    ints := 8 * saved_ints.len()
    if wrap >= 0
        for j in 0..saved_ints.len()
            if out
                a.mov_mr(at(RBP, 0 - 8 * (j + 1)), saved_ints[j])
            else
                a.mov_rm(saved_ints[j], at(RBP, 0 - 8 * (j + 1)))
    for j in 0..saved_floats.len()
        if out
            a.vmovsd_mr(at(RBP, 0 - ints - 8 * (j + 1)), saved_floats[j] - codegen.FLOAT_BASE)
        else
            a.vmovsd_rm(saved_floats[j] - codegen.FLOAT_BASE, at(RBP, 0 - ints - 8 * (j + 1)))

fn Gen.epilogue(mut self, block int)
    ints := 8 * saved_ints.len()
    if wrap < 0
        save_registers(false)
        if saved_ints.len() > 0
            a.lea(RSP, at(RBP, 0 - ints))
            mut i := saved_ints.len() - 1
            while i >= 0
                a.pop(saved_ints[i])
                i -= 1
    elif region[block]
        save_registers(false)
    a.mov_rr(RSP, RBP)
    a.pop(RBP)
    a.ret()

fn Gen.slot(self, l int) Mem
    at(RBP, 0 - slot_base - 8 * (l - codegen.SLOT_BASE + 1))

fn is_reg(l int) bool
    l >= 0 and l < codegen.SLOT_BASE

fn is_slot(l int) bool
    l >= codegen.SLOT_BASE

# ---- operands ----

## The constant a value is, when it is an `int` or `bool` constant.
fn Gen.imm(self, v int) int?
    i := remat[v]
    if i.op == "const"
        return i.imm
    none

fn Gen.imm32(self, v int) int?
    n := imm(v)?
    if fits32(n)
        return n
    none

## `v` in a general register: its own, or `scratch` loaded with it.
fn Gen.gpr(mut self, v int, scratch int) int
    l := loc[v]
    if is_reg(l)
        return l
    if is_slot(l)
        a.mov_rm(scratch, slot(l))
        return scratch
    i := remat[v]
    if i.op == "const"
        a.mov_ri(scratch, i.imm)
    elif i.op == "str"
        a.lea(scratch, at_sym("d:s{i.imm}", 0))
    elif i.op == "fnaddr"
        a.lea(scratch, at_sym(i.name, 0))
    else
        unreachable("value v{v} has no location")
    scratch

## `v` in a vector register: its own, or `scratch` loaded with it.
fn Gen.xmm(mut self, v int, scratch int) int
    l := loc[v]
    if is_reg(l)
        return l - codegen.FLOAT_BASE
    if is_slot(l)
        a.vmovsd_rm(scratch, slot(l))
        return scratch
    i := remat[v]
    sym := codegen.add_f64(mut img, i.fimm)
    a.vmovsd_rm(scratch, at_sym(sym, 0))
    scratch

## The register to compute `v` into: its own, or `scratch`.
fn Gen.out_gpr(self, v int, scratch int) int
    if is_reg(loc[v]) then loc[v] else scratch

fn Gen.out_xmm(self, v int, scratch int) int
    if is_reg(loc[v]) then loc[v] - codegen.FLOAT_BASE else scratch

## Store a computed value from `r` into its location, when that is a slot.
fn Gen.put_gpr(mut self, v int, r int)
    l := loc[v]
    if is_slot(l)
        a.mov_mr(slot(l), r)
    elif is_reg(l)
        a.mov_rr(l, r)

fn Gen.put_xmm(mut self, v int, x int)
    l := loc[v]
    if is_slot(l)
        a.vmovsd_mr(slot(l), x)
    elif is_reg(l)
        a.vmov_rr(l - codegen.FLOAT_BASE, x)

# ---- parallel moves ----

fn Gen.move_of(mut self, dst int, v int) Move
    i := remat[v]
    fl := f.vals[v].is_float()
    if i.op == "const"
        return Move(dst: dst, src: -1, imm: i.imm, sym: "", float: fl)
    if i.op == "str"
        return Move(dst: dst, src: -1, imm: 0, sym: "d:s{i.imm}", float: fl)
    if i.op == "fnaddr"
        return Move(dst: dst, src: -1, imm: 0, sym: i.name, float: fl)
    if i.op == "fconst"
        return Move(dst: dst, src: -1, imm: 0, sym: codegen.add_f64(mut img, i.fimm), float: fl)
    Move(dst: dst, src: loc[v], imm: 0, sym: "", float: fl)

## Perform moves as if all at once: a move waits while its destination is
## another's source; a cycle is broken through a scratch register.
fn Gen.parallel(mut self, moves List[Move])
    mut pending := List[Move]()
    for mv in moves
        if mv.dst >= 0 and mv.dst != mv.src
            pending.push(mv)
    while pending.len() > 0
        mut done := -1
        for k in 0..pending.len()
            mut blocked := false
            for j in 0..pending.len()
                if j != k and pending[j].src == pending[k].dst
                    blocked = true
            if not blocked
                done = k
                break
        if done >= 0
            emit_move(pending[done])
            pending.remove_at(done)
            continue
        # A cycle: save the first destination's value and read it from there.
        d := pending[0].dst
        tmp := if pending[0].float then X1 + codegen.FLOAT_BASE else S1
        emit_move(Move(dst: tmp, src: d, imm: 0, sym: "", float: pending[0].float))
        for j in 0..pending.len()
            if pending[j].src == d
                pending[j].src = tmp

fn Gen.emit_move(mut self, mv Move)
    if mv.float
        x := if is_reg(mv.dst) then mv.dst - codegen.FLOAT_BASE else X0
        if mv.src < 0
            a.vmovsd_rm(x, at_sym(mv.sym, 0))
        elif is_reg(mv.src)
            a.vmov_rr(x, mv.src - codegen.FLOAT_BASE)
        else
            a.vmovsd_rm(x, slot(mv.src))
        if is_slot(mv.dst)
            a.vmovsd_mr(slot(mv.dst), x)
        return
    if is_slot(mv.dst) and mv.src < 0 and mv.sym == "" and fits32(mv.imm)
        a.mov_mi(slot(mv.dst), mv.imm)
        return
    if is_slot(mv.dst) and is_reg(mv.src)
        a.mov_mr(slot(mv.dst), mv.src)
        return
    r := if is_reg(mv.dst) then mv.dst else S0
    if mv.src < 0
        if mv.sym != ""
            a.lea(r, at_sym(mv.sym, 0))
        else
            a.mov_ri(r, mv.imm)
    elif is_reg(mv.src)
        a.mov_rr(r, mv.src)
    else
        a.mov_rm(r, slot(mv.src))
    if is_slot(mv.dst)
        a.mov_mr(slot(mv.dst), r)

fn Gen.entry_moves(mut self)
    mut moves := List[Move]()
    mut ni := 0
    mut nf := 0
    for p in f.params
        if f.vals[p].is_float()
            moves.push(Move(
                dst: loc[p],
                src: codegen.FLOAT_BASE + nf,
                imm: 0,
                sym: "",
                float: true,
            ))
            nf += 1
        elif ni < INT_ARGS.len()
            moves.push(Move(dst: loc[p], src: INT_ARGS[ni], imm: 0, sym: "", float: false))
            ni += 1
    parallel(moves)
    # Integer parameters after the sixth are on the stack, above the return
    # address (native-abi.md §1).
    mut k := 0
    for p in f.params
        if not f.vals[p].is_float()
            if k >= INT_ARGS.len()
                d := out_gpr(p, S0)
                a.mov_rm(d, at(RBP, 16 + 8 * (k - INT_ARGS.len())))
                put_gpr(p, d)
            k += 1

# ---- blocks ----

fn Gen.gen_block(mut self, b int)
    blk := f.blocks[b]
    n := blk.insts.len()
    # A comparison whose only use is the branch ending the block is fused.
    mut fused := -1
    if blk.term.kind == "branch" and n > 0
        last := blk.insts[n - 1]
        if last.dst == blk.term.cond and uses[last.dst] == 1 and cc_of(last.op) >= 0
            fused = n - 1
    # `x & m == 0` (or `!= 0`) as a branch condition is one `test` (ADR 0623).
    mut masked := -1
    if fused > 0
        cmp := blk.insts[fused]
        mask := blk.insts[fused - 1]
        if (cmp.op == "eq" or cmp.op == "ne") and mask.op == "band" and cmp.args[0] == mask.dst
            if uses[mask.dst] == 1 and imm(cmp.args[1]) == 0 and imm(mask.args[0]) == none
                if imm32(mask.args[1]) != none or loc[mask.args[1]] >= 0
                    masked = fused - 1
    if b == wrap
        save_registers(true)
    for k in 0..n
        if k == fused or k == masked
            continue
        gen_inst(blk.insts[k])
    t := blk.term
    match t.kind
        "jump" =>
            to := t.targets[0]
            ps := f.blocks[to].params
            parallel([move_of(loc[ps[j]], t.args[0][j]) for j in 0..ps.len()])
            if to != next_block
                if rotates(to)
                    # The loop test again here, instead of a jump back to it.
                    h := f.blocks[to]
                    branch_to(
                        compare(h.insts[h.insts.len() - 1]),
                        h.term.targets[0],
                        h.term.targets[1],
                    )
                else
                    a.jmp(blabels[to])
        "branch" =>
            yes := t.targets[0]
            no := t.targets[1]
            mut cc := CC_NE
            if masked >= 0
                bt := blk.insts[masked]
                if k := imm32(bt.args[1])
                    a.test_ri(gpr(bt.args[0], S0), k)
                else
                    a.test_rr(gpr(bt.args[0], S0), gpr(bt.args[1], S1))
                cc = cc_of(blk.insts[fused].op)
            elif fused >= 0
                cc = compare(blk.insts[fused])
            else
                r := gpr(t.cond, S0)
                a.test_rr(r, r)
            branch_to(cc, yes, no)
        "return" =>
            if t.value >= 0
                if f.vals[t.value].is_float()
                    parallel([move_of(codegen.FLOAT_BASE, t.value)])
                else
                    parallel([move_of(RAX, t.value)])
            epilogue(b)
        _ => a.ud2()

## Whether block `to` is only a comparison and a branch: a jump to it is
## cheaper as the comparison and branch themselves, one instruction fewer
## on the way round a loop (loop rotation, ADR 0611).
fn Gen.rotates(self, to int) bool
    h := f.blocks[to]
    n := h.insts.len()
    if h.term.kind != "branch" or n == 0
        return false
    # Constants rebuilt at each use cost nothing to repeat.
    for k in 0..n - 1
        if not codegen.is_remat(h.insts[k])
            return false
    last := h.insts[n - 1]
    last.dst == h.term.cond and uses[last.dst] == 1 and cc_of(last.op) >= 0

## Jump to `yes` when `cc` holds, else to `no`, falling through where the
## next block allows. A float comparison's condition may be a pair (§cc_of).
fn Gen.branch_to(mut self, cc int, yes int, no int)
    if cc >= 16
        # `feq`: ZF and not PF; `fne`: not ZF or PF.
        if cc == 16
            a.jcc(CC_P, blabels[no])
            a.jcc(CC_E, blabels[yes])
        else
            a.jcc(CC_P, blabels[yes])
            a.jcc(CC_NE, blabels[yes])
        if no != next_block
            a.jmp(blabels[no])
        return
    if yes == next_block
        a.jcc(invert(cc), blabels[no])
        return
    a.jcc(cc, blabels[yes])
    if no != next_block
        a.jmp(blabels[no])

fn invert(cc int) int
    if cc % 2 == 0 then cc + 1 else cc - 1

## The condition code of a comparison, or -1. `feq` and `fne` need two
## flags and are 16 and 17.
fn cc_of(op str) int
    match op
        "eq" => CC_E
        "ne" => CC_NE
        "lt" => CC_L
        "le" => CC_LE
        "gt" => CC_G
        "ge" => CC_GE
        "feq" => 16
        "fne" => 17
        "fgt" | "flt" => CC_A
        "fge" | "fle" => CC_AE
        _ => -1

fn swapped(cc int) int
    match cc
        12 => CC_G
        14 => CC_GE
        15 => CC_L
        13 => CC_LE
        _ => cc

## Set the flags for a comparison; gives the condition that means true.
fn Gen.compare(mut self, i mir.Inst) int
    x := i.args[0]
    y := i.args[1]
    cc := cc_of(i.op)
    if i.op.starts_with("f")
        # `a < b` is `b > a`: ucomisd sets CF for less and for NaN alike.
        flip := i.op == "flt" or i.op == "fle"
        xa := xmm(if flip then y else x, X0)
        xb := xmm(if flip then x else y, X1)
        a.vucomisd(xa, xb)
        return cc
    if k := imm32(y)
        r := gpr(x, S0)
        # `test r, r` sets the flags a signed comparison with 0 reads.
        if k == 0
            a.test_rr(r, r)
        else
            a.alu_ri("cmp", r, k)
        return cc
    if k := imm32(x)
        r := gpr(y, S0)
        if k == 0
            a.test_rr(r, r)
        else
            a.alu_ri("cmp", r, k)
        return swapped(cc)
    ra := gpr(x, S0)
    rb := gpr(y, S1)
    a.alu_rr("cmp", ra, rb)
    cc

# ---- instructions ----

fn Gen.stub(mut self, kind int, x int, y int, site int, op str) int
    l := a.label()
    # An atomic add's overflow has its own message (conc.atomic.5).
    k := if kind == 0 and m.sites[site].rule == "conc.atomic.5" then 16 else kind
    stubs.push(Stub(label: l, kind: k, a: x, b: y, site: site, op: op, undo: 0))
    l

fn Gen.gen_inst(mut self, i mir.Inst)
    if codegen.is_remat(i)
        return
    match i.op
        "add" | "sub" | "mul" => arith(i)
        "div" | "rem" => divide(i)
        "band" | "bor" | "bxor" =>
            alu := match i.op
                "band" => "and"
                "bor" => "or"
                _ => "xor"
            # Into the result's register, with the operands swapped when it
            # is the second one's (ADR 0624).
            d := out_gpr(i.dst, S1)
            mut x := i.args[0]
            mut y := i.args[1]
            if loc[y] == d and loc[x] != d
                x = i.args[1]
                y = i.args[0]
            if k := imm32(y)
                a.mov_rr(d, gpr(x, d))
                a.alu_ri(alu, d, k)
            else
                ry := gpr(y, S0)
                a.mov_rr(d, gpr(x, d))
                a.alu_rr(alu, d, ry)
            put_gpr(i.dst, d)
        "bnot" =>
            a.mov_rr(S1, gpr(i.args[0], S1))
            a.not_reg(S1)
            put_gpr(i.dst, S1)
        "shl" | "shr" => shift(i)
        "neg" =>
            a.mov_rr(S1, gpr(i.args[0], S1))
            a.neg(S1)
            if i.site >= 0
                kind := if m.sites[i.site].op == "abs" then 5 else 2
                a.jcc(CC_O, stub(kind, i.args[0], i.args[0], i.site, "-"))
            put_gpr(i.dst, S1)
        "not" =>
            r := out_gpr(i.dst, S1)
            a.mov_rr(r, gpr(i.args[0], S0))
            a.alu_ri("xor", r, 1)
            put_gpr(i.dst, r)
        "eq" | "ne" | "lt" | "le" | "gt" | "ge" | "feq" | "fne" | "flt" | "fle" | "fgt" | "fge" =>
            cc := compare(i)
            if cc == 16
                a.setcc(CC_E, S1)
                a.setcc(CC_NP, S0)
                a.alu_rr("and", S1, S0)
            elif cc == 17
                a.setcc(CC_NE, S1)
                a.setcc(CC_P, S0)
                a.alu_rr("or", S1, S0)
            else
                a.setcc(cc, S1)
            r := out_gpr(i.dst, S1)
            a.movzx8_rr(r, S1)
            put_gpr(i.dst, r)
        "fadd" | "fsub" | "fmul" | "fdiv" =>
            xa := xmm(i.args[0], X0)
            xb := xmm(i.args[1], X1)
            d := out_xmm(i.dst, X0)
            a.vsd_rrr(i.op, d, xa, xb)
            put_xmm(i.dst, d)
        "fneg" | "abs" =>
            xa := xmm(i.args[0], X0)
            mask := if i.op == "fneg" then 1.shl(63) else 1.shl(63).bit_not()
            a.mov_ri(S1, mask)
            a.vmovq_xr(X1, S1)
            d := out_xmm(i.dst, X0)
            a.vpd_rrr(if i.op == "fneg" then 87 else 84, d, xa, X1)
            put_xmm(i.dst, d)
        "sqrt" | "floor" | "ceil" =>
            xa := xmm(i.args[0], X0)
            d := out_xmm(i.dst, X0)
            if i.op == "sqrt"
                a.vsd_rrr("sqrt", d, xa, xa)
            else
                a.vroundsd(d, xa, xa, if i.op == "floor" then 9 else 10)
            put_xmm(i.dst, d)
        "itof" =>
            r := gpr(i.args[0], S1)
            d := out_xmm(i.dst, X0)
            a.vpd_rrr(87, d, d, d)
            a.vcvtsi2sd(d, r)
            put_xmm(i.dst, d)
        "ftoi" =>
            xa := xmm(i.args[0], X0)
            a.vcvttsd2si(S1, xa)
            if i.site < 0
                put_gpr(i.dst, S1)
                return
            ok := a.label()
            a.mov_ri(S0, 1.shl(63))
            a.alu_rr("cmp", S1, S0)
            a.jcc(CC_NE, ok)
            # The smallest `int` is the only value that converts to it.
            a.vmovsd_rm(X1, at_sym(codegen.add_f64(mut img, -9223372036854775807.0 - 1.0), 0))
            a.vucomisd(xa, X1)
            bad := stub(4, i.args[0], i.args[0], i.site, "")
            a.jcc(CC_P, bad)
            a.jcc(CC_NE, bad)
            a.bind(ok)
            put_gpr(i.dst, S1)
        "call" => call(i)
        "icall" => call_out(i)
        "utrap" => a.jmp(stub(14, i.args[0], i.args[0], i.site, ""))
        "prim" => prim(i)
        "get" => list_get(i)
        "set" => list_set(i)
        "data" =>
            d := out_gpr(i.dst, S1)
            a.mov_rm(d, at(gpr(i.args[0], S0), 16))
            put_gpr(i.dst, d)
        "ldx" => indexed_load(i)
        "stx" => indexed_store(i)
        "len" =>
            r := gpr(i.args[0], S0)
            d := out_gpr(i.dst, S1)
            a.mov_rm(d, at(r, 0))
            put_gpr(i.dst, d)
        "cap" =>
            r := gpr(i.args[0], S0)
            d := out_gpr(i.dst, S1)
            a.mov_rm(d, at(r, 8))
            put_gpr(i.dst, d)
        "trap" => a.jmp(stub(i.imm, i.args[0], i.args[1], i.site, i.name))
        "load" =>
            r := gpr(i.args[0], S0)
            if f.vals[i.dst].is_float()
                d := out_xmm(i.dst, X0)
                a.vmovsd_rm(d, at(r, i.imm))
                put_xmm(i.dst, d)
            else
                d := out_gpr(i.dst, S1)
                a.mov_rm(d, at(r, i.imm))
                put_gpr(i.dst, d)
        "store" =>
            r := gpr(i.args[0], S0)
            v := i.args[1]
            if f.vals[v].is_float()
                a.vmovsd_mr(at(r, i.imm), xmm(v, X0))
            else
                a.mov_mr(at(r, i.imm), gpr(v, S1))
        "copy" =>
            parallel([move_of(loc[i.dst], i.args[0])])
        _ => unreachable("x64: no code for `{i.op}`")

fn Gen.arith(mut self, i mir.Inst)
    x := i.args[0]
    y := i.args[1]
    sym := match i.op
        "add" => "+"
        "sub" => "-"
        _ => "*"
    d := out_gpr(i.dst, S1)
    ky := imm32(y)
    # In place when the result shares `x`'s register: an overflow stub
    # recovers `x` from the result (add and sub only).
    if d == loc[x] and i.op != "mul" and (ky != none or loc[y] != d)
        if k := ky
            a.alu_ri(i.op, d, k)
        else
            a.alu_rr(i.op, d, gpr(y, S0))
        if i.site >= 0
            l := stub(0, x, y, i.site, sym)
            stubs[stubs.len() - 1].undo = if i.op == "add" then 1 else 2
            a.jcc(CC_O, l)
        return
    # Into the result's register when that leaves `x` and `y` intact.
    mut r := if d != S1 and d != loc[x] and d != loc[y] then d else S1
    # An unchecked `n * k` writes its result over `n`: `imul d, n, k` allows it.
    if i.op == "mul" and i.site < 0 and (ky != none or imm32(x) != none)
        r = d
    # `3 * n`: the constant goes second; the stub still reports `x OP y`.
    kx := imm32(x)
    if ky == none and kx != none and i.op != "sub"
        k := kx else 0
        if i.op == "mul"
            a.imul_rri(r, gpr(y, r), k)
        else
            a.mov_rr(r, gpr(y, r))
            a.alu_ri(i.op, r, k)
        if i.site >= 0
            a.jcc(CC_O, stub(0, x, y, i.site, sym))
        put_gpr(i.dst, r)
        return
    if k := ky
        if i.op == "mul"
            a.imul_rri(r, gpr(x, r), k)
        else
            a.mov_rr(r, gpr(x, r))
            a.alu_ri(i.op, r, k)
    else
        a.mov_rr(r, gpr(x, r))
        rb := gpr(y, S0)
        if i.op == "mul"
            a.imul_rr(r, rb)
        else
            a.alu_rr(i.op, r, rb)
    if i.site >= 0
        a.jcc(CC_O, stub(0, x, y, i.site, sym))
    put_gpr(i.dst, r)

## `idiv`: traps on a zero divisor (expr.arith.3) and on the smallest `int`
## divided by -1 (expr.arith.1); `x % -1` is 0 (expr.arith.5).
fn Gen.divide(mut self, i mir.Inst)
    x := i.args[0]
    y := i.args[1]
    sym := if i.op == "div" then "/" else "%"
    done := a.label()
    if k := imm(y)
        if k == 0
            if i.site >= 0
                a.jmp(stub(1, x, y, i.site, sym))
            else
                a.ud2()
            return
        if k == -1
            if i.op == "rem"
                a.mov_ri(S1, 0)
            else
                a.mov_rr(S1, gpr(x, S1))
                a.neg(S1)
                if i.site >= 0
                    a.jcc(CC_O, stub(0, x, y, i.site, sym))
            put_gpr(i.dst, S1)
            return
        if k > 0 and power_of_two(k) >= 0
            shift_divide(i, power_of_two(k))
            return
        if k > 2 and k < 2147483648
            magic_divide(i, k)
            return
        a.mov_ri(S1, k)
    else
        rb := gpr(y, S1)
        a.mov_rr(S1, rb)
        if i.site >= 0
            a.test_rr(S1, S1)
            a.jcc(CC_E, stub(1, x, y, i.site, sym))
        go := a.label()
        a.alu_ri("cmp", S1, -1)
        a.jcc(CC_NE, go)
        if i.op == "rem"
            a.mov_ri(RDX, 0)
            a.jmp(done)
        else
            a.mov_rr(RAX, gpr(x, RAX))
            a.neg(RAX)
            if i.site >= 0
                a.jcc(CC_O, stub(0, x, y, i.site, sym))
            a.jmp(done)
        a.bind(go)
    a.mov_rr(RAX, gpr(x, RAX))
    a.cqo()
    a.idiv(S1)
    a.bind(done)
    put_gpr(i.dst, if i.op == "div" then RAX else RDX)

## The `k` with `n == 2^k`, or -1.
fn power_of_two(n int) int
    mut k := 0
    mut v := 1
    while v < n and k < 62
        v = v * 2
        k += 1
    if v == n then k else -1

## Signed division and remainder by `2^k` rounding toward zero, with shifts:
## a negative dividend is biased by `2^k - 1` first.
fn Gen.shift_divide(mut self, i mir.Inst, k int)
    x := gpr(i.args[0], S0)
    if i.op == "div"
        # Into the result's register; the bias is taken from `x` first.
        d := out_gpr(i.dst, S1)
        if k > 0
            a.mov_rr(RAX, x)
            if k > 1
                a.shift_ri("sar", RAX, 63)
            a.shift_ri("shr", RAX, 64 - k)
        a.mov_rr(d, x)
        if k > 0
            a.alu_rr("add", d, RAX)
        a.shift_ri("sar", d, k)
        put_gpr(i.dst, d)
        return
    a.mov_rr(S1, x)
    if k > 0
        a.mov_rr(RAX, x)
        if k > 1
            a.shift_ri("sar", RAX, 63)
        a.shift_ri("shr", RAX, 64 - k)
        a.alu_rr("add", S1, RAX)
    # x - (biased x with the low k bits cleared)
    a.shift_ri("sar", S1, k)
    a.shift_ri("shl", S1, k)
    a.mov_rr(RAX, x)
    a.alu_rr("sub", RAX, S1)
    put_gpr(i.dst, RAX)

## Division and remainder by a constant `k` with a high multiply
## (`codegen.div_magic`), not `idiv`.
fn Gen.magic_divide(mut self, i mir.Inst, k int)
    x := gpr(i.args[0], S0)
    mg := codegen.div_magic(k)
    a.mov_ri(RAX, mg[0])
    a.imul1(x)
    a.alu_rr("add", RDX, x)
    if mg[1] > 0
        a.shift_ri("sar", RDX, mg[1])
    a.mov_rr(RAX, x)
    a.shift_ri("shr", RAX, 63)
    a.alu_rr("add", RDX, RAX)
    if i.op == "div"
        put_gpr(i.dst, RDX)
        return
    a.imul_rri(RDX, RDX, k)
    a.mov_rr(RAX, x)
    a.alu_rr("sub", RAX, RDX)
    put_gpr(i.dst, RAX)

## A shift traps on a count outside 0..=63 (expr.bit.2).
fn Gen.shift(mut self, i mir.Inst)
    x := i.args[0]
    n := i.args[1]
    sar := i.op == "shr"
    if k := imm(n)
        if k >= 0 and k <= 63
            d := out_gpr(i.dst, S1)
            a.mov_rr(d, gpr(x, d))
            a.shift_ri(if sar then "sar" else "shl", d, k)
            put_gpr(i.dst, d)
            return
    c := gpr(n, S0)
    if i.site >= 0
        a.alu_ri("cmp", c, 63)
        a.jcc(CC_A, stub(6, n, n, i.site, ""))
    d := out_gpr(i.dst, S1)
    r := gpr(x, S1)
    if sar
        a.sarx(d, r, c)
    else
        a.shlx(d, r, c)
    put_gpr(i.dst, d)

fn Gen.call(mut self, i mir.Inst)
    if codegen.is_push(i)
        push(i)
        return
    call_out(i)

## `xs.push(v)` with room to spare is a store and a length update; only a
## full list calls the runtime, which grows it (native-abi.md §2).
fn Gen.push(mut self, i mir.Inst)
    l := gpr(i.args[0], S0)
    # `imm` 1: a loop guard saw room for every push the loop makes (native.bce.6).
    room := i.imm == 1
    slow := a.label()
    done := a.label()
    a.mov_rm(RAX, at(l, 0))
    if not room
        a.alu_rm("cmp", RAX, at(l, 8))
        a.jcc(CC_E, slow)
    a.mov_rm(S1, at(l, 16))
    v := i.args[1]
    if f.vals[v].is_float()
        a.vmovsd_mr(at_index(S1, RAX, 8, 0), xmm(v, X0))
    elif f.vals[v] == mir.Ty.Bool
        a.mov8_mr(at_index(S1, RAX, 1, 0), gpr(v, RDX))
    else
        a.mov_mr(at_index(S1, RAX, 8, 0), gpr(v, RDX))
    a.alu_ri("add", RAX, 1)
    a.mov_mr(at(l, 0), RAX)
    if room
        return
    a.jmp(done)
    a.bind(slow)
    # The runtime may use any caller-saved register: keep ours around it.
    mut ints := List[int]()
    mut floats := List[int]()
    for r in caller_used
        if r >= codegen.FLOAT_BASE
            floats.push(r - codegen.FLOAT_BASE)
        else
            ints.push(r)
    for r in ints
        a.push(r)
    mut size := 8 * floats.len()
    if (size + 8 * ints.len()) % 16 != 0
        size += 8
    if size > 0
        a.alu_ri("sub", RSP, size)
    for k in 0..floats.len()
        a.vmovsd_mr(at(RSP, 8 * k), floats[k])
    call_out(i)
    for k in 0..floats.len()
        a.vmovsd_rm(floats[k], at(RSP, 8 * k))
    if size > 0
        a.alu_ri("add", RSP, size)
    mut k := ints.len() - 1
    while k >= 0
        a.pop(ints[k])
        k -= 1
    a.bind(done)

fn Gen.call_out(mut self, i mir.Inst)
    if i.name.starts_with("libsys.")
        # System DLL calls exist only on Windows (ADR 0606). Elsewhere the
        # call traps if it is ever run.
        # macOS names start with `_` and are never imported on Windows.
        if self.win and not i.name.starts_with("libsys._")
            self.libsys_call(i)
        else
            a.ud2()
        return
    mut moves := List[Move]()
    mut ni := 0
    mut nf := 0
    # A call through a value (`icall`) takes the callee first, into the scratch register.
    indirect := i.op == "icall"
    mut extra := List[int]()
    for k in 0..i.args.len()
        v := i.args[k]
        if indirect and k == 0
            moves.push(move_of(S0, v))
        elif f.vals[v].is_float()
            moves.push(move_of(codegen.FLOAT_BASE + nf, v))
            nf += 1
        elif ni < INT_ARGS.len()
            moves.push(move_of(INT_ARGS[ni], v))
            ni += 1
        else
            extra.push(v)
    # Integer arguments after the sixth go on the stack, the seventh lowest,
    # in a 16-byte multiple (native-abi.md §1).
    room := (8 * extra.len() + 15) / 16 * 16
    if room > 0
        a.alu_ri("sub", RSP, room)
        for k in 0..extra.len()
            a.mov_mr(at(RSP, 8 * k), gpr(extra[k], S0))
    parallel(moves)
    if indirect
        a.call_reg(S0)
    elif i.name.starts_with("libsys.")
        # An import exists only on macOS; the runtime guards it with
        # `target() == 2`, so on x86-64 Linux it is never reached.
        a.ud2()
    else
        a.call_sym(i.name)
    if room > 0
        a.alu_ri("add", RSP, room)
    if i.dst >= 0
        if f.vals[i.dst].is_float()
            put_xmm(i.dst, 0)
        else
            put_gpr(i.dst, RAX)

## The memory a load or store prim addresses.
fn Gen.address(mut self, i mir.Inst) Mem
    v := i.args[0]
    store := i.name.starts_with("store")
    # `base + index * scale + offset` (an indexed load has two arguments,
    # an indexed store three): the primitive's `imm` holds the offset, or
    # offset * 16 + log2(scale).
    if i.args.len() == (if store then 3 else 2)
        mut b := gpr(v, S0)
        if globs.contains(v)
            a.lea(S0, at_sym("globals", 8 * globs[v]))
            b = S0
        return at_index(b, gpr(i.args[1], S1), 1.shl(i.imm % 16), i.imm / 16)
    if globs.contains(v)
        return at_sym("globals", 8 * globs[v] + i.imm)
    at(gpr(v, S0), i.imm)

fn Gen.prim(mut self, i mir.Inst)
    if i.name.starts_with("fn_addr:")
        # The function's address is only used with an import: never reached.
        a.ud2()
        d := out_gpr(i.dst, S1)
        a.mov_ri(d, 0)
        put_gpr(i.dst, d)
        return
    match i.name
        "load64" =>
            mem := address(i)
            d := out_gpr(i.dst, S1)
            a.mov_rm(d, mem)
            put_gpr(i.dst, d)
        "load8" =>
            mem := address(i)
            d := out_gpr(i.dst, S1)
            a.movzx8_rm(d, mem)
            put_gpr(i.dst, d)
        "loadf" =>
            mem := address(i)
            d := out_xmm(i.dst, X0)
            a.vmovsd_rm(d, mem)
            put_xmm(i.dst, d)
        "store64" =>
            v := gpr(i.args[i.args.len() - 1], RDX)
            a.mov_mr(address(i), v)
        "store8" =>
            v := gpr(i.args[i.args.len() - 1], RDX)
            a.mov8_mr(address(i), v)
        "storef" =>
            v := xmm(i.args[i.args.len() - 1], X0)
            a.vmovsd_mr(address(i), v)
        "syscall" =>
            regs := [RAX, RDI, RSI, RDX, S0, R8, R9]
            parallel([move_of(regs[k], i.args[k]) for k in 0..i.args.len()])
            a.syscall()
            put_gpr(i.dst, RAX)
        "global" =>
            if globs.contains(i.dst)
                return
            d := out_gpr(i.dst, S1)
            k := imm(i.args[0]) else 0
            a.lea(d, at_sym("globals", 8 * k))
            put_gpr(i.dst, d)
        # Threads and atomics (ADRs 0599, 0600). The atomic operations are
        # sequentially consistent: x86-64 loads are acquire, stores are `xchg`.
        "atomic_load" =>
            r := gpr(i.args[0], S0)
            d := out_gpr(i.dst, S1)
            a.mov_rm(d, at(r, 0))
            put_gpr(i.dst, d)
        "atomic_store" | "atomic_xchg" =>
            cell := at(gpr(i.args[0], S0), 0)
            parallel([move_of(RAX, i.args[1])])
            a.xchg_mr(cell, RAX)
            if i.dst >= 0
                put_gpr(i.dst, RAX)
        "atomic_add" =>
            cell := at(gpr(i.args[0], S0), 0)
            parallel([move_of(RAX, i.args[1])])
            a.lock_xadd(cell, RAX)
            put_gpr(i.dst, RAX)
        "atomic_cas" =>
            cell := at(gpr(i.args[0], S0), 0)
            new := gpr(i.args[2], S1)
            parallel([move_of(RAX, i.args[1])])
            a.lock_cmpxchg(cell, new)
            put_gpr(i.dst, RAX)
        "sp" =>
            d := out_gpr(i.dst, S1)
            a.mov_rr(d, RSP)
            put_gpr(i.dst, d)
        "clone" =>
            # clone(CLONE_VM|FS|FILES|SIGHAND|THREAD|SYSVSEM, stack, 0, 0, arg):
            # the child resumes here on the new stack with rax 0 and runs
            # `rt.worker_main(arg)`; the argument rides in r8 (unused as tls).
            parallel([move_of(RSI, i.args[0]), move_of(R8, i.args[1])])
            a.mov_ri(RDI, 331520)
            a.mov_ri(RDX, 0)
            a.mov_ri(S0, 0)
            a.mov_ri(RAX, 56)
            a.syscall()
            parent := a.label()
            a.test_rr(RAX, RAX)
            a.jcc(CC_NE, parent)
            a.mov_rr(RDI, R8)
            a.alu_rr("xor", RBP, RBP)
            a.call_sym("rt.worker_main")
            a.ud2()
            a.bind(parent)
            put_gpr(i.dst, RAX)
        "restart" =>
            # Abandon this thread's frames: run `rt.worker_main(arg)` on a
            # fresh stack at `top`.
            parallel([move_of(RAX, i.args[0]), move_of(RDI, i.args[1])])
            a.mov_rr(RSP, RAX)
            a.alu_rr("xor", RBP, RBP)
            a.call_sym("rt.worker_main")
            a.ud2()
        "globals_end" =>
            d := out_gpr(i.dst, S1)
            a.lea(d, at_sym("globals", 8 * m.globals_used()))
            put_gpr(i.dst, d)
        "gc_regs" =>
            b := gpr(i.args[0], S0)
            for k in 0..5
                a.mov_mr(at(b, 8 * k), [RBX, 12, 13, 14, 15][k])
            d := out_gpr(i.dst, S1)
            a.mov_rr(d, RSP)
            put_gpr(i.dst, d)
        "target" =>
            d := out_gpr(i.dst, S1)
            a.mov_ri(d, if win then 3 else 0)
            put_gpr(i.dst, d)
        "str_addr" | "str_at" | "list_addr" | "list_at" =>
            parallel([move_of(loc[i.dst], i.args[0])])
        "float_bits" =>
            d := out_gpr(i.dst, S1)
            a.vmovq_rx(d, xmm(i.args[0], X0))
            put_gpr(i.dst, d)
        "bits_float" =>
            d := out_xmm(i.dst, X0)
            a.vmovq_xr(d, gpr(i.args[0], S0))
            put_xmm(i.dst, d)
        _ => unreachable("x64: unknown primitive {i.name}")

## `xs[i]`: the list in S0, the index in S1, the elements' address in rax.
## The element's address, after the bounds check. A `List[bool]` holds one
## byte per element, other lists 8 (native-abi.md §2).
fn Gen.list_index(mut self, i mir.Inst, size int) Mem
    l := gpr(i.args[0], S0)
    if k := imm32(i.args[1])
        if i.site >= 0
            a.alu_mi("cmp", at(l, 0), k)
            a.jcc(CC_BE, stub(3, i.args[1], i.args[0], i.site, ""))
        a.mov_rm(RAX, at(l, 16))
        return at(RAX, size * k)
    x := gpr(i.args[1], S1)
    if i.site >= 0
        a.alu_rm("cmp", x, at(l, 0))
        a.jcc(CC_AE, stub(3, i.args[1], i.args[0], i.site, ""))
    a.mov_rm(RAX, at(l, 16))
    at_index(RAX, x, size, 0)

fn Gen.list_get(mut self, i mir.Inst)
    t := f.vals[i.dst]
    if t.is_float()
        mem := list_index(i, 8)
        d := out_xmm(i.dst, X0)
        a.vmovsd_rm(d, mem)
        put_xmm(i.dst, d)
    elif t == mir.Ty.Bool
        mem := list_index(i, 1)
        d := out_gpr(i.dst, S1)
        a.movzx8_rm(d, mem)
        put_gpr(i.dst, d)
    else
        mem := list_index(i, 8)
        d := out_gpr(i.dst, S1)
        a.mov_rm(d, mem)
        put_gpr(i.dst, d)

fn Gen.list_set(mut self, i mir.Inst)
    v := i.args[2]
    t := f.vals[v]
    if t.is_float()
        x := xmm(v, X0)
        a.vmovsd_mr(list_index(i, 8), x)
    elif t == mir.Ty.Bool
        r := gpr(v, RDX)
        a.mov8_mr(list_index(i, 1), r)
    else
        r := gpr(v, RDX)
        a.mov_mr(list_index(i, 8), r)

## `ldx`/`stx`: the element at `base[index]`, `imm` bytes each (ADR 0577).
fn Gen.indexed_mem(mut self, i mir.Inst) Mem
    b := gpr(i.args[0], S0)
    if k := imm32(i.args[1])
        return at(b, i.imm * (k + i.elem_off()))
    at_index(b, gpr(i.args[1], S1), i.imm, i.imm * i.elem_off())

fn Gen.indexed_load(mut self, i mir.Inst)
    mem := indexed_mem(i)
    if f.vals[i.dst].is_float()
        d := out_xmm(i.dst, X0)
        a.vmovsd_rm(d, mem)
        put_xmm(i.dst, d)
    elif i.imm == 1
        d := out_gpr(i.dst, S1)
        a.movzx8_rm(d, mem)
        put_gpr(i.dst, d)
    else
        d := out_gpr(i.dst, S1)
        a.mov_rm(d, mem)
        put_gpr(i.dst, d)

fn Gen.indexed_store(mut self, i mir.Inst)
    v := i.args[2]
    mem := indexed_mem(i)
    if f.vals[v].is_float()
        a.vmovsd_mr(mem, xmm(v, X0))
    elif i.imm == 1
        a.mov8_mr(mem, gpr(v, RDX))
    else
        a.mov_mr(mem, gpr(v, RDX))

# ---- trap stubs ----

fn Gen.gen_stubs(mut self)
    for s in stubs
        a.bind(s.label)
        codegen.add_trap_texts(mut img, m, s.site, s.op)
        mut moves := List[Move]()
        moves.push(Move(dst: RDI, src: -1, imm: s.kind, sym: "", float: false))
        if s.kind == 4
            # The float's bits.
            a.vmovq_rx(RSI, xmm(s.a, X0))
        else
            moves.push(move_of(RSI, s.a))
        moves.push(move_of(RDX, s.b))
        moves.push(Move(dst: RCX, src: -1, imm: 0, sym: "d:h{s.site}", float: false))
        moves.push(Move(dst: R8, src: -1, imm: 0, sym: "d:o{s.op}", float: false))
        moves.push(Move(dst: R9, src: -1, imm: 0, sym: "d:t{s.site}", float: false))
        if s.kind == 4
            moves.remove_at(1)
        parallel(moves)
        if s.undo == 1
            a.alu_rr("sub", RSI, RDX)
        elif s.undo == 2
            a.alu_rr("add", RSI, RDX)
        if s.kind == 3
            # The list's length.
            a.mov_rm(RDX, at(RDX, 0))
        a.call_sym("rt.trap")
        a.ud2()
