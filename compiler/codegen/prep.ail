## Preparing MIR for code generation (ADR 0386), the same for every target:
## edges that pass arguments out of a two-way branch get a block of their
## own, so a block's moves happen on one edge only; edges to a block that
## only jumps on go straight to its target; blocks are put in reverse
## postorder, so a loop's body follows its header.
use mir

## Split each branch or switch edge that passes arguments: the new block
## jumps to the old target with them.
pub fn split_edges(f mir.Func) mir.Func
    mut g := f
    n := g.blocks.len()
    for b in 0..n
        t := g.blocks[b].term
        if t.kind != "branch" and t.kind != "switch"
            continue
        for e in 0..t.targets.len()
            if t.args[e].len() == 0
                continue
            g.blocks.push(mir.Block(
                params: [],
                insts: [],
                term: mir.jump_to(t.targets[e], t.args[e]),
            ))
            g.blocks[b].term.targets[e] = g.blocks.len() - 1
            g.blocks[b].term.args[e] = []
    thread_jumps(mut g)
    g

## Retarget each edge into an empty block that jumps on without arguments.
fn thread_jumps(mut g mir.Func)
    n := g.blocks.len()
    mut fwd := [b for b in 0..n]
    for b in 1..n
        mut t := b
        mut steps := 0
        while t != 0 and is_forwarder(g.blocks[t]) and steps < n
            t = g.blocks[t].term.targets[0]
            steps += 1
        fwd[b] = t
    for b in 0..n
        for e in 0..g.blocks[b].term.targets.len()
            to := g.blocks[b].term.targets[e]
            if g.blocks[b].term.args[e].len() == 0
                g.blocks[b].term.targets[e] = fwd[to]

fn is_forwarder(blk mir.Block) bool
    blk.params.len() == 0
        and blk.insts.len() == 0
        and blk.term.kind == "jump"
        and blk.term.args[0].len() == 0

## The blocks in reverse postorder from the entry.
pub fn block_order(f mir.Func) List[int]
    n := f.blocks.len()
    mut seen := [false for _ in 0..n]
    mut post := List[int]()
    # An explicit stack of (block, next successor index).
    mut stack := [0]
    mut next := [0 for _ in 0..n]
    seen[0] = true
    while stack.len() > 0
        b := stack[stack.len() - 1]
        succs := f.blocks[b].term.targets
        if next[b] < succs.len()
            s := succs[succs.len() - 1 - next[b]]
            next[b] += 1
            if not seen[s]
                seen[s] = true
                stack.push(s)
        else
            post.push(b)
            stack.pop()
    post.reverse()
    post

## Float constants in a 64-bit pattern, computed with exact float scaling
## (AIL has no bit cast outside the runtime): IEEE 754 binary64.
pub fn f64_bits(x float) int
    if x != x
        return 9221120237041090560
    neg := x < 0.0 or x == 0.0 and 1.0 / x < 0.0
    a := if neg then 0.0 - x else x
    mut bits := 0
    if a > 1.7976931348623157e308
        bits = 2047.shl(52)
    elif a == 0.0
        bits = 0
    else
        mut m := a
        mut e := 0
        while m >= 2.0
            m = m / 2.0
            e += 1
        while m < 1.0
            m = m * 2.0
            e -= 1
        if e < -1022
            # Subnormal: the mantissa is `a` in units of 2^-1074.
            mut s := a
            for _ in 0..1074
                s = s * 2.0
            bits = s.to_int()
        else
            bits = (e + 1023).shl(52).bit_or(((m - 1.0) * 4503599627370496.0).to_int())
    if neg
        bits = bits.bit_or(1.shl(63))
    bits

## Values that cross calls are copied where the calls begin (ADR 0625). The
## deepest block that dominates every block with a call, when it is not the
## entry and no edge leaves or re-enters what it dominates, gets a `copy` of
## each value defined before it and used in it; the uses there read the copy.
## A path that returns before it (`if n < 0: return 1` in a recursive
## function) then holds nothing in callee-saved registers, so the
## allocator can leave them to the code after it and save them there.
pub fn split_for_calls(f0 mir.Func) mir.Func
    mut f := f0
    mut order := block_order(f)
    mut calling := List[int]()
    for b in order
        for i in f.blocks[b].insts
            if is_call(i)
                calling.push(b)
                break
    if calling.len() == 0 or f.blocks.len() < 3
        return f
    mut dom := mir.dominators(f)
    mut x := wrap_block(f, order, dom, calling)
    if x <= 0
        # A block that only returns, shared by a path that calls and one that
        # doesn't, keeps the region open: give each path its own.
        g := duplicate_returns(f)
        if g.blocks.len() == f.blocks.len()
            return f
        order = block_order(g)
        dom = mir.dominators(g)
        x = wrap_block(g, order, dom, calling)
        if x <= 0
            return f
        f = g
    n := f.blocks.len()
    mut region := [false for _ in 0..n]
    for b in order
        region[b] = dom.has(b, x)
    # Values defined outside the region.
    mut inside := [false for _ in 0..f.vals.len()]
    mut rebuilt := [false for _ in 0..f.vals.len()]
    for b in 0..n
        for p in f.blocks[b].params
            inside[p] = region[b]
        for i in f.blocks[b].insts
            if i.dst >= 0
                inside[i.dst] = region[b]
                rebuilt[i.dst] = is_remat(i)
    mut copies := Map[int, int]()
    mut vals := f.vals
    mut names := f.names
    mut head := List[mir.Inst]()
    for b in order
        if not region[b]
            continue
        mut seen := List[int]()
        for i in f.blocks[b].insts
            for a in i.operands()
                seen.push(a)
        for a in f.blocks[b].term.uses()
            seen.push(a)
        for a in seen
            if inside[a] or rebuilt[a] or copies.contains(a)
                continue
            vals.push(f.vals[a])
            names.push("")
            copies[a] = vals.len() - 1
            head.push(mir.inst(vals.len() - 1, "copy", [a]))
    if copies.len() == 0
        return f
    mut g := f
    g.vals = vals
    g.names = names
    for b in order
        if not region[b]
            continue
        mut blk := g.blocks[b]
        mut insts := List[mir.Inst]()
        if b == x
            insts.extend(head)
        for i in blk.insts
            mut r := i
            r = r.with_args([renamed(copies, a) for a in i.operands()])
            insts.push(r)
        blk.insts = insts
        mut tm := blk.term
        if tm.cond >= 0
            tm.cond = renamed(copies, tm.cond)
        if tm.value >= 0
            tm.value = renamed(copies, tm.value)
        tm.args = [[renamed(copies, a) for a in edge] for edge in tm.args]
        blk.term = tm
        g.blocks[b] = blk
    g

## Each edge into a block that only returns (a value it got as an argument,
## or one defined before) goes to a return of its own, when the block has
## two to four edges into it; the old block is left with no way in.
fn duplicate_returns(f mir.Func) mir.Func
    mut g := f
    n := f.blocks.len()
    mut incoming := [0 for _ in 0..n]
    for blk in f.blocks
        for t in blk.term.targets
            incoming[t] += 1
    for r in 1..n
        blk := f.blocks[r]
        if blk.insts.len() > 0 or blk.term.kind != "return" or incoming[r] < 2 or incoming[r] > 4
            continue
        mut slot := -1
        for k in 0..blk.params.len()
            if blk.params[k] == blk.term.value
                slot = k
        for p in 0..n
            for e in 0..g.blocks[p].term.targets.len()
                if g.blocks[p].term.targets[e] != r
                    continue
                v := if slot >= 0 then g.blocks[p].term.args[e][slot] else blk.term.value
                g.blocks.push(mir.Block(params: [], insts: [], term: mir.return_of(v)))
                g.blocks[p].term.targets[e] = g.blocks.len() - 1
                g.blocks[p].term.args[e] = []
        g.blocks[r] = mir.Block(params: [], insts: [], term: mir.unreachable_term())
    g

fn renamed(m Map[int, int], v int) int
    if c := m.get(v)
        return c
    v

## The deepest block, other than the entry, that dominates every block in
## `blocks`, has no parameters, and whose dominated blocks form a region that
## nothing leaves and nothing re-enters at the block itself (a loop header
## fails; the block before it does not): where the code that needs the
## callee-saved registers begins. -1 if there is none.
pub fn wrap_block(f mir.Func, order List[int], dom mir.Doms, blocks List[int]) int
    mut cands := List[int]()
    for c in order
        if c == 0 or f.blocks[c].params.len() > 0
            continue
        mut all := true
        for b in blocks
            if not dom.has(b, c)
                all = false
        if all
            cands.push(c)
    # Deepest first: the one the most blocks dominate is the deepest.
    mut depth := Map[int, int]()
    for c in cands
        mut d := 0
        for k in 0..f.blocks.len()
            if dom.has(c, k)
                d += 1
        depth[c] = d
    cands = cands.sorted(by: |c| 0 - depth[c])
    for c in cands
        mut closed := true
        for b in order
            if not dom.has(b, c)
                continue
            for succ in f.blocks[b].term.targets
                if not dom.has(succ, c) or succ == c
                    closed = false
        if closed
            return c
    -1

## Division by the constant `d` (3 <= d < 2^31) with a multiply, after
## Granlund and Montgomery: `[m, sh]` with
## `x / d == ((mulhs(m, x) + x) >> sh) + (x >>> 63)`, where `m` is the 64-bit
## pattern of `1 + floor(2^(63 + l) / d)` read as signed and `l` is
## `ceil(log2 d)`. `x % d` is then `x - q * d`.
pub fn div_magic(d int) List[int]
    mut l := 0
    while 1.shl(l) < d
        l += 1
    # floor(2^(63 + l) / d) mod 2^64, by long division
    mut q := 0
    mut r := 1
    for _ in 0..63 + l
        r = r * 2
        q = q.shl(1)
        if r >= d
            r -= d
            q = q.bit_or(1)
    m := if q == 9223372036854775807 then 0 - q - 1 else q + 1
    [m, l - 1]
