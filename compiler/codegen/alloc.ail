## Register allocation by linear scan (ADR 0386; Poletto and Sarkar, 1999),
## the same for every target. Each value gets one location for its whole
## life: a register, a stack slot, or none when it is a constant that the
## code generator rematerialises at each use.
##
## Positions: a block's parameters are defined at its start + 1; each
## instruction reads at 2k and writes at 2k + 1; the terminator reads at
## the block's last position. A value's interval runs from its definition
## to its last use, widened to the ends of every block it is live through.
## A block parameter's interval starts at its block: the moves that write it
## end a predecessor whose only successor is that block (critical edges are
## split), and every value live across those moves is live into the block
## too, so it conflicts with the parameter there. The argument and the
## parameter can then share a register, and the move disappears.
use mir

## Where a value lives: a register (0-63, targets number vector registers
## from `FLOAT_BASE`), a stack slot (`SLOT_BASE + k`; a `Vec2` has that slot
## and the next), `REMAT` (rebuilt at each use), or `NOWHERE` (never read).
pub FLOAT_BASE := 32
pub SLOT_BASE := 1000
pub REMAT := -2
pub NOWHERE := -1

## The registers a target lets the allocator use, best first.
pub struct Target
    pub int_caller List[int]
    pub int_callee List[int]
    pub float_caller List[int]
    pub float_callee List[int]
    ## The registers the first integer and float arguments arrive in.
    pub int_args List[int]
    pub float_args List[int]
    ## The registers a `div` or `rem` overwrites (x86-64 `idiv` and `mul`
    ## write rdx): no value lives in one across a division (ADR 1049).
    pub div_regs List[int]

pub struct Alloc
    ## The location of each value.
    pub loc List[int]
    ## The blocks in layout order.
    pub order List[int]
    pub slots int
    ## The callee-saved registers used, which the prologue saves.
    pub saved List[int]
    ## The block where the callee-saved registers are saved, or -1 for the
    ## function's entry; and the blocks it dominates, whose returns restore
    ## them (shrink-wrapping, ADR 0625).
    pub wrap int
    pub region List[bool]
    ## Moves around loops a value is idle in (ADR 0848).
    pub holes List[Hole]
    ## For each `salloc`, the slot number (`SLOT_BASE + k`) of the first of
    ## the `imm / 8 + 1` slots, header word included, that it owns.
    pub sallocs Map[int, int]

## A value kept in a stack slot across a loop that never touches it, so the
## loop's registers go to the values it does use. At the end of block
## `block` (`store`) its register is written to `slot`; at the start of
## `block` (not `store`) the register is loaded back.
pub struct Hole
    pub block int
    pub store bool
    pub reg int
    pub slot int
    pub float bool

## The operations the x86-64 code generator does in the operand's register.
IN_PLACE := ["add", "sub", "band", "bor", "bxor"]

COMMUTES := ["add", "band", "bor", "bxor"]

## Whether an instruction's value is rebuilt at each use instead of held.
pub fn is_remat(i mir.Inst) bool
    i.op == "const" or i.op == "fconst" or i.op == "str" or i.op == "fnaddr"

## Whether an instruction clobbers the caller-saved registers. A `push`
## calls the runtime only when the list is full, and that slow path saves
## the registers itself, so values stay in caller-saved registers across it.
pub fn is_call(i mir.Inst) bool
    if i.op == "call"
        return not is_push(i)
    i.op == "icall"
        or i.op == "prim" and (i.name == "syscall" or i.name == "clone" or i.name == "restart" or i.name == "sigreturn")

pub fn is_push(i mir.Inst) bool
    i.op == "call" and mir.is_push_name(i.name)

## The caller-saved registers that hold some value of the function.
pub fn caller_used(al Alloc, t Target) List[int]
    mut out := List[int]()
    for l in al.loc
        if (t.int_caller.contains(l) or t.float_caller.contains(l)) and not out.contains(l)
            out.push(l)
    out.sorted()

pub fn allocate(f mir.Func, t Target) Alloc
    first := allocate_with(f, t, [])
    # Holes cost a store and a load per entry to a loop, so only the loops
    # that spilled a value they use get them (ADR 0848).
    heads := spilled_loops(f, first.loc)
    if heads.len() == 0
        return first
    allocate_with(f, t, heads)

## The headers of the loops that use a value held in a stack slot.
fn spilled_loops(f mir.Func, loc List[int]) List[int]
    mut out := List[int]()
    for lp in mir.find_loops(f)
        mut found := false
        for b in lp.blocks
            blk := f.blocks[b]
            for i in blk.insts
                for a in i.operands()
                    if loc[a] >= SLOT_BASE
                        found = true
                if i.dst >= 0 and loc[i.dst] >= SLOT_BASE
                    found = true
            for a in blk.term.uses()
                if loc[a] >= SLOT_BASE
                    found = true
        if found
            out.push(lp.header)
    out

fn allocate_with(f mir.Func, t Target, heads List[int]) Alloc
    n := f.vals.len()
    order := block_order(f)
    nb := f.blocks.len()
    mut remat := [false for _ in 0..n]
    for blk in f.blocks
        for i in blk.insts
            if is_remat(i)
                remat[i.dst] = true
    # Positions of each block.
    mut bstart := [0 for _ in 0..nb]
    mut bend := [0 for _ in 0..nb]
    mut pos := 0
    for b in order
        bstart[b] = pos
        pos += 2 + 2 * f.blocks[b].insts.len()
        bend[b] = pos
        pos += 2
    live_in := liveness(f, order)
    # Each value's live ranges, block by block: from its definition (or the
    # block's start when it is live in) to its last use (or the block's end
    # when it is live out). Between ranges it has a hole, where another
    # value may use its register.
    mut ranges := [List[int]() for _ in 0..n]
    mut calls := List[int]()
    mut divs := List[int]()
    mut first := [-1 for _ in 0..n]
    mut last := [-1 for _ in 0..n]
    for b in order
        blk := f.blocks[b]
        # Only the values this block touches have a range in it.
        mut touched := List[int]()
        for v in live_in[b]
            first[v] = bstart[b]
            last[v] = bstart[b]
            touched.push(v)
        for p in blk.params
            first[p] = bstart[b] + 1
            last[p] = bstart[b] + 1
            touched.push(p)
        mut k := bstart[b] + 2
        for i in blk.insts
            for a in i.operands()
                last[a] = k
            if i.dst >= 0
                first[i.dst] = k + 1
                last[i.dst] = k + 1
                touched.push(i.dst)
            if is_call(i)
                calls.push(k)
            if i.op == "div" or i.op == "rem"
                divs.push(k)
            k += 2
        for a in blk.term.uses()
            last[a] = bend[b]
        for succ in blk.term.targets
            for v in live_in[succ]
                last[v] = bend[b]
        for v in touched
            if first[v] >= 0
                add_range(mut ranges[v], first[v], last[v])
                first[v] = -1
    cuts := carve_holes(f, order, bstart, bend, live_in, mut ranges, remat, t, heads)
    mut start := [-1 for _ in 0..n]
    mut end := [-1 for _ in 0..n]
    for v in 0..n
        if ranges[v].len() > 0
            start[v] = ranges[v][0]
            end[v] = ranges[v][ranges[v].len() - 1]
    mut hints := [List[int]() for _ in 0..n]
    for blk in f.blocks
        for e in 0..blk.term.targets.len()
            ps := f.blocks[blk.term.targets[e]].params
            args := blk.term.args[e]
            for j in 0..args.len()
                hints[ps[j]].push(args[j])
                hints[args[j]].push(ps[j])
        for i in blk.insts
            if i.op == "copy"
                hints[i.dst].push(i.arg(0))
            elif i.dst >= 0 and IN_PLACE.contains(i.op)
                # A result in its operand's register is one instruction
                # fewer on x86-64 (`add d, y` with `d` already `x`).
                hints[i.dst].push(i.arg(0))
                hints[i.arg(0)].push(i.dst)
                if COMMUTES.contains(i.op)
                    hints[i.dst].push(i.arg(1))
                    hints[i.arg(1)].push(i.dst)
    mut apart := [List[int]() for _ in 0..n]
    for blk in f.blocks
        for i in blk.insts
            if i.op == "mul" and i.site >= 0 and i.dst >= 0
                apart[i.dst] = i.operands()
    # A parameter that no hint places stays in the register it arrived in,
    # which saves the moves at the function's entry.
    mut arrive := [-1 for _ in 0..n]
    mut ni := 0
    mut nf := 0
    for p in f.params
        if f.vals[p].is_float()
            if nf < t.float_args.len()
                arrive[p] = t.float_args[nf]
            nf += 1
        else
            if ni < t.int_args.len()
                arrive[p] = t.int_args[ni]
            ni += 1
    # A value computed just before a call it dies at, and passed to it, goes
    # in the argument register it is passed in, so the call needs no move.
    for b in order
        mut at := bstart[b] + 2
        for i in f.blocks[b].insts
            if i.op == "call" and not is_push(i)
                mut ni2 := 0
                mut nf2 := 0
                for a in i.operands()
                    if f.vals[a].is_float()
                        if nf2 < t.float_args.len() and arrive[a] < 0 and short_lived(
                            start,
                            end,
                            a,
                            at,
                        )
                            arrive[a] = t.float_args[nf2]
                        nf2 += 1
                    else
                        if ni2 < t.int_args.len() and arrive[a] < 0 and short_lived(
                            start,
                            end,
                            a,
                            at,
                        )
                            arrive[a] = t.int_args[ni2]
                        ni2 += 1
            at += 2
    mut loc := [NOWHERE for _ in 0..n]
    mut queue := List[int]()
    for v in 0..n
        if remat[v]
            loc[v] = REMAT
        elif start[v] >= 0
            queue.push(v)
    queue = queue.sorted(by: |v| start[v] * n + v)
    mut s := Scan(
        loc: loc,
        active: [],
        slots: 0,
        saved: [],
        start: start,
        end: end,
        ranges: ranges,
        calls: calls,
        divs: divs,
        div_regs: t.div_regs,
        hints: hints,
        apart: apart,
        arrive: arrive,
        weight: [],
        weighed: false,
        func: f,
    )
    for v in queue
        s.assign(v, f.vals[v].in_float_reg(), t)
    mut sallocs := Map[int, int]()
    for blk in f.blocks
        for i in blk.insts
            if i.op == "salloc" and i.dst >= 0
                sallocs[i.dst] = SLOT_BASE + s.slots
                s.slots += i.imm / 8 + 1
    mut holes := List[Hole]()
    mut hole_slot := Map[int, int]()
    for c in cuts
        r := s.loc[c.v]
        if r < 0 or r >= SLOT_BASE
            continue
        mut at := 0
        if seen := hole_slot.get(c.v)
            at = seen
        else
            at = s.new_slot()
            hole_slot[c.v] = at
        fl := f.vals[c.v].is_float()
        holes.push(Hole(block: c.pre, store: true, reg: r, slot: at, float: fl))
        for e in c.exits
            holes.push(Hole(block: e, store: false, reg: r, slot: at, float: fl))
    shrink := shrink_wrap(f, order, s, bstart, bend, t)
    Alloc(
        loc: s.loc,
        order: order,
        slots: s.slots,
        saved: s.saved.sorted(),
        wrap: shrink.wrap,
        region: shrink.region,
        holes: holes,
        sallocs: sallocs,
    )

## A value to keep in memory across one loop: the block that ends before the
## loop and the blocks that start after it.
struct Cut
    v int
    pre int
    exits List[int]

## Cuts the live range of every value that is live through a loop without
## touching it, when the loop needs more registers than the target has: the
## value waits in a stack slot and its register is free inside the loop
## (ADR 0848). The loop needs one block before it that only jumps in, blocks
## that follow each other in layout, and exits whose every predecessor is in
## the loop. A value that ends up in a slot anyway loses nothing.
fn carve_holes(
    f mir.Func,
    order List[int],
    bstart List[int],
    bend List[int],
    live_in List[List[int]],
    mut ranges List[List[int]],
    remat List[bool],
    t Target,
    heads List[int],
) List[Cut]
    nb := f.blocks.len()
    n := f.vals.len()
    mut cuts := List[Cut]()
    mut idx := [0 for _ in 0..nb]
    for k in 0..order.len()
        idx[order[k]] = k
    mut preds := [List[int]() for _ in 0..nb]
    for b in 0..nb
        for x in f.blocks[b].term.targets
            preds[x].push(b)
    for lp in mir.find_loops(f)
        if lp.pre < 0 or lp.blocks.len() == 0 or not heads.contains(lp.header)
            continue
        mut lo := nb
        mut hi := -1
        for b in lp.blocks
            if idx[b] < lo
                lo = idx[b]
            if idx[b] > hi
                hi = idx[b]
        if hi - lo + 1 != lp.blocks.len()
            continue
        cs := bstart[order[lo]]
        ce := bend[order[hi]]
        mut exits := List[int]()
        mut ok := true
        for b in lp.blocks
            for x in f.blocks[b].term.targets
                if lp.member[x] or exits.contains(x)
                    continue
                for p in preds[x]
                    if not lp.member[p]
                        ok = false
                exits.push(x)
        if not ok or exits.len() == 0
            continue
        mut hot := [false for _ in 0..n]
        for b in lp.blocks
            blk := f.blocks[b]
            for p in blk.params
                hot[p] = true
            for i in blk.insts
                if i.dst >= 0
                    hot[i.dst] = true
                for a in i.operands()
                    hot[a] = true
            for a in blk.term.uses()
                hot[a] = true
            for e in blk.term.args
                for a in e
                    hot[a] = true
        for fl in [false, true]
            mut live := 0
            for v in live_in[lp.header]
                if not remat[v] and f.vals[v].is_float() == fl
                    live += 1
            regs := if fl then t.float_caller.len()
                + t.float_callee.len() else t.int_caller.len()
                + t.int_callee.len()
            # The loop's own temporaries need a few more.
            if live + 3 <= regs
                continue
            for v in live_in[lp.header]
                # A vector waits in no slot: the moves around a loop carry one word (native.vec.6).
                if remat[v] or hot[v] or f.vals[v].is_float() != fl or f.vals[v].is_vec()
                    continue
                if not spans(ranges[v], cs, ce)
                    continue
                mut cut := List[int]()
                mut k := 0
                while k < ranges[v].len()
                    from := ranges[v][k]
                    to := ranges[v][k + 1]
                    if from < cs
                        cut.push(from)
                        cut.push(if to < cs then to else cs - 1)
                    if to > ce
                        cut.push(if from > ce then from else ce + 1)
                        cut.push(to)
                    k += 2
                ranges[v] = cut
                cuts.push(Cut(v: v, pre: lp.pre, exits: exits))
    cuts

## Whether one range covers `from..=to`.
fn spans(r List[int], from int, to int) bool
    mut k := 0
    while k < r.len()
        if r[k] <= from and r[k + 1] >= to
            return true
        k += 2
    false

## Whether `v` dies at position `at` and was defined within a few
## instructions before it.
fn short_lived(start List[int], end List[int], v int, at int) bool
    start[v] >= 0 and end[v] == at and at - start[v] <= 12

## The cost of keeping each value in memory: one per definition or use,
## times 8 for each loop around it (at most 4).
fn use_weights(f mir.Func) List[int]
    n := f.blocks.len()
    mut depth := [0 for _ in 0..n]
    for lp in mir.find_loops(f)
        for b in lp.blocks
            depth[b] += 1
    mut w := [0 for _ in 0..f.vals.len()]
    for b in 0..n
        mut unit := 1
        for _ in 0..(if depth[b] > 4 then 4 else depth[b])
            unit *= 8
        blk := f.blocks[b]
        for p in blk.params
            w[p] += unit
        for i in blk.insts
            if i.dst >= 0
                w[i.dst] += unit
            for a in i.operands()
                w[a] += unit
        for a in blk.term.uses()
            w[a] += unit
        for e in blk.term.args
            for a in e
                w[a] += unit
    w

struct Wrap
    wrap int
    region List[bool]

## Where the callee-saved registers can be saved instead of at the entry:
## the deepest block that dominates every block a callee-saved register is
## live in, when no edge leaves what it dominates and none comes back to it.
## A path that returns without reaching it then saves and restores nothing.
fn shrink_wrap(f mir.Func, order List[int], s Scan, bstart List[int], bend List[int], t Target) Wrap
    nowrap := Wrap(wrap: -1, region: [])
    if s.saved.len() == 0
        return nowrap
    n := f.blocks.len()
    mut occupied := [false for _ in 0..n]
    for v in 0..s.loc.len()
        l := s.loc[v]
        if l < 0 or l >= SLOT_BASE
            continue
        if not (t.int_callee.contains(l) or t.float_callee.contains(l))
            continue
        for b in order
            mut k := 0
            while k < s.ranges[v].len()
                if s.ranges[v][k] <= bend[b] and s.ranges[v][k + 1] >= bstart[b]
                    occupied[b] = true
                k += 2
    if occupied[0]
        return nowrap
    dom := mir.dominators(f)
    mut where := List[int]()
    for b in order
        if occupied[b]
            where.push(b)
    best := wrap_block(f, order, dom, where)
    if best < 0
        return nowrap
    mut region := [false for _ in 0..n]
    for b in order
        region[b] = dom[b][best]
    Wrap(wrap: best, region: region)

## Append the range `from..=to`, joining it to the last one when they meet
## (consecutive blocks are 2 positions apart).
fn add_range(mut r List[int], from int, to int)
    n := r.len()
    if n > 0 and r[n - 1] >= from - 2
        if to > r[n - 1]
            r[n - 1] = to
        return
    r.push(from)
    r.push(to)

## Whether two values' ranges overlap.
fn overlaps(a List[int], b List[int]) bool
    mut i := 0
    mut j := 0
    while i < a.len() and j < b.len()
        if a[i + 1] < b[j]
            i += 2
        elif b[j + 1] < a[i]
            j += 2
        else
            return true
    false

## Which values are live on entry to each block, in ascending order (the
## block's parameters are defined there, so they are not). Each block is
## summarised once by the values it reads before defining them and the ones
## it defines; the rounds then touch only the live values.
fn liveness(f mir.Func, order List[int]) List[List[int]]
    n := f.vals.len()
    nb := f.blocks.len()
    mut reads := [List[int]() for _ in 0..nb]
    mut defs := [List[int]() for _ in 0..nb]
    mut def_at := [-1 for _ in 0..n]
    mut read_at := [-1 for _ in 0..n]
    for b in order
        blk := f.blocks[b]
        for p in blk.params
            if def_at[p] != b
                def_at[p] = b
                defs[b].push(p)
        for inst in blk.insts
            for a in inst.operands()
                if def_at[a] != b and read_at[a] != b
                    read_at[a] = b
                    reads[b].push(a)
            if inst.dst >= 0 and def_at[inst.dst] != b
                def_at[inst.dst] = b
                defs[b].push(inst.dst)
        for a in blk.term.uses()
            if def_at[a] != b and read_at[a] != b
                read_at[a] = b
                reads[b].push(a)
    mut live_in := [List[int]() for _ in 0..nb]
    mut killed := [0 for _ in 0..n]
    mut seen := [0 for _ in 0..n]
    mut tick := 0
    mut changed := true
    while changed
        changed = false
        mut k := order.len() - 1
        while k >= 0
            b := order[k]
            k -= 1
            tick += 1
            for v in defs[b]
                killed[v] = tick
            mut live := List[int]()
            for s in f.blocks[b].term.targets
                for v in live_in[s]
                    if killed[v] != tick and seen[v] != tick
                        seen[v] = tick
                        live.push(v)
            for v in reads[b]
                if seen[v] != tick
                    seen[v] = tick
                    live.push(v)
            live = live.sorted()
            if live != live_in[b]
                live_in[b] = live
                changed = true
    live_in

struct Scan
    loc List[int]
    ## Values holding a register now.
    active List[int]
    slots int
    saved List[int]
    start List[int]
    end List[int]
    ranges List[List[int]]
    calls List[int]
    ## The positions of the divisions, and the registers they overwrite.
    divs List[int]
    div_regs List[int]
    hints List[List[int]]
    ## The operands of the checked `mul` that defines a value. Its overflow
    ## stub reports both, so the product wants a register of its own.
    apart List[List[int]]
    ## The register a parameter arrived in, else -1.
    arrive List[int]
    ## How much a value costs to keep in memory: its definitions and uses,
    ## each counted 8 times over for every loop it sits in.
    weight List[int]
    ## Whether `weight` has been computed: only a function that runs out of
    ## registers needs it.
    weighed bool
    func mir.Func

## Whether `v` is live across a call, so it needs a callee-saved register.
fn Scan.crosses(self, v int) bool
    live_across(self.ranges[v], self.calls)

## Whether ranges `r` are live across any of the positions `at`: defined
## before one and used after it.
fn live_across(r List[int], at List[int]) bool
    for c in at
        mut k := 0
        while k < r.len()
            if r[k] < c and r[k + 1] > c
                return true
            k += 2
    false

## Whether `v` may hold register `r` at all: not one a division it lives
## across overwrites. A division's operands and result may (ADR 1049).
fn Scan.allowed(self, r int, v int) bool
    not self.div_regs.contains(r) or not live_across(self.ranges[v], self.divs)

## Whether a hinted value that starts after `v` and is not placed yet lives
## across a call.
fn Scan.partner_crosses(self, v int) bool
    for h in self.hints[v]
        if self.loc[h] == NOWHERE and self.start[h] > self.end[v] and self.crosses(h)
            return true
    false

## Whether register `r` is the one of any of `vs`.
fn Scan.shares(self, r int, vs List[int]) bool
    for x in vs
        if self.loc[x] == r
            return true
    false

## Whether register `r` is free for all of `v`'s ranges.
fn Scan.free(self, r int, v int) bool
    if not self.allowed(r, v)
        return false
    for a in self.active
        if self.loc[a] == r and overlaps(self.ranges[a], self.ranges[v])
            return false
    true

fn Scan.assign(mut self, v int, float bool, t Target)
    # Free the registers of values that ended.
    mut keep := List[int]()
    for a in self.active
        if self.end[a] >= self.start[v]
            keep.push(a)
    self.active = keep
    # A value whose later partner (an operand it flows into, a block
    # parameter) lives across a call goes straight to a callee-saved
    # register, so the partner can take the same one and no move is left.
    cross := self.crosses(v) or self.partner_crosses(v)
    mut pool := List[int]()
    if self.func.vals[v].is_vec()
        # A `Vec2` never lives across a call (native.vec.3), and a callee-saved register keeps only its low
        # half (AAPCS64) or is saved as one `float` (Windows x86-64).
        pool.extend(t.float_caller)
    elif float
        if not cross
            pool.extend(t.float_caller)
        pool.extend(t.float_callee)
    else
        if not cross
            pool.extend(t.int_caller)
        pool.extend(t.int_callee)
    mut pick := -1
    for h in self.hints[v]
        r := self.loc[h]
        if r >= 0 and r < SLOT_BASE and pool.contains(r) and self.free(r, v)
            pick = r
            break
    if pick < 0 and self.arrive[v] >= 0 and pool.contains(self.arrive[v]) and self.free(
        self.arrive[v],
        v,
    )
        pick = self.arrive[v]
    if pick < 0 and self.apart[v].len() > 0
        for r in pool
            if self.free(r, v) and not self.shares(r, self.apart[v])
                pick = r
                break
    if pick < 0
        for r in pool
            if self.free(r, v)
                pick = r
                break
    if pick < 0 and not self.weighed
        self.weight = use_weights(self.func)
        self.weighed = true
    if pick < 0
        # Spill whichever of `v` and the values in its way is cheapest to
        # keep in memory (loop-weighted uses, ADR 0622), the one that ends
        # last among equals, when that value alone holds its register over
        # `v`'s ranges.
        mut victim := -1
        for a in self.active
            if pool.contains(self.loc[a])
                and self.allowed(self.loc[a], v)
                and overlaps(self.ranges[a], self.ranges[v])
                and self.sole(a, v)
                and (victim < 0 or self.weight[a] < self.weight[victim] or (self.weight[a] == self.weight[victim] and self.end[a] > self.end[victim]))
                victim = a
        if victim >= 0
            and (self.weight[victim] < self.weight[v] or (self.weight[victim] == self.weight[v] and self.end[victim] > self.end[v]))
            pick = self.loc[victim]
            self.loc[victim] = self.slot_for(victim)
            mut rest := List[int]()
            for a in self.active
                if a != victim
                    rest.push(a)
            self.active = rest
        else
            self.loc[v] = self.slot_for(v)
            return
    self.loc[v] = pick
    self.active.push(v)
    if (t.int_callee.contains(pick) or t.float_callee.contains(pick))
        and not self.saved.contains(pick)
        self.saved.push(pick)

## Whether `a` is the only active value whose use of its register meets `v`.
fn Scan.sole(self, a int, v int) bool
    for b in self.active
        if b != a and self.loc[b] == self.loc[a] and overlaps(self.ranges[b], self.ranges[v])
            return false
    true

## A stack slot for `v`. A `Vec2` takes two that follow each other (native.vec.3) and a `Vec4` four
## (native.vec.5); the target reads its bytes from whichever of them has the lowest address.
fn Scan.slot_for(mut self, v int) int
    at := self.new_slot()
    if self.func.vals[v].is_vec()
        self.slots += 1
    if self.func.vals[v].is_vec4()
        self.slots += 2
    at

fn Scan.new_slot(mut self) int
    self.slots += 1
    SLOT_BASE + self.slots - 1
