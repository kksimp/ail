## Register allocation by linear scan (ADR 0386; Poletto and Sarkar, 1999),
## the same for every target. Each value gets one location for its whole
## life: a register, a stack slot, or none when it is a constant that the
## code generator rematerialises at each use.
##
## Positions: a block's parameters are defined at its start + 1; each
## instruction reads at 2k and writes at 2k + 1; the terminator reads at
## the block's last position. A value's interval runs from its definition
## to its last use, widened to the ends of every block it is live through.
## A block parameter's interval starts at its block: the moves that write it
## end a predecessor whose only successor is that block (critical edges are
## split), and every value live across those moves is live into the block
## too, so it conflicts with the parameter there. The argument and the
## parameter can then share a register, and the move disappears.
use mir

## Where a value lives: a register (0-63, targets number vector registers
## from `FLOAT_BASE`), a stack slot (`SLOT_BASE + k`), `REMAT` (rebuilt at
## each use), or `NOWHERE` (never read).
pub FLOAT_BASE := 32
pub SLOT_BASE := 1000
pub REMAT := -2
pub NOWHERE := -1

## The registers a target lets the allocator use, best first.
pub struct Target
    pub int_caller List[int]
    pub int_callee List[int]
    pub float_caller List[int]
    pub float_callee List[int]

pub struct Alloc
    ## The location of each value.
    pub loc List[int]
    ## The blocks in layout order.
    pub order List[int]
    pub slots int
    ## The callee-saved registers used, which the prologue saves.
    pub saved List[int]
    ## The block where the callee-saved registers are saved, or -1 for the
    ## function's entry; and the blocks it dominates, whose returns restore
    ## them (shrink-wrapping, ADR 0625).
    pub wrap int
    pub region List[bool]

## Whether an instruction's value is rebuilt at each use instead of held.
## How many frame cells `f`'s `cell` instructions use (ADR 0537).
pub fn cells(f mir.Func) int
    mut n := 0
    for b in f.blocks
        for i in b.insts
            if i.op == "cell"
                n = n.max(i.imm + 1)
    n

pub fn is_remat(i mir.Inst) bool
    i.op == "const" or i.op == "fconst" or i.op == "str"

## Whether an instruction clobbers the caller-saved registers. A `push`
## calls the runtime only when the list is full, and that slow path saves
## the registers itself, so values stay in caller-saved registers across it.
pub fn is_call(i mir.Inst) bool
    if i.op == "call"
        return not is_push(i)
    i.op == "prim" and i.name == "syscall"

pub fn is_push(i mir.Inst) bool
    i.op == "call"
        and (i.name == "rt.list_push" or i.name == "rt.list_pushf" or i.name == "rt.list_pushb")

## The caller-saved registers that hold some value of the function.
pub fn caller_used(al Alloc, t Target) List[int]
    mut out := List[int]()
    for l in al.loc
        if (t.int_caller.contains(l) or t.float_caller.contains(l)) and not out.contains(l)
            out.push(l)
    out.sorted()

pub fn allocate(f mir.Func, t Target) Alloc
    n := f.vals.len()
    order := block_order(f)
    nb := f.blocks.len()
    mut remat := [false for _ in 0..n]
    for blk in f.blocks
        for i in blk.insts
            if is_remat(i)
                remat[i.dst] = true
    # Positions of each block.
    mut bstart := [0 for _ in 0..nb]
    mut bend := [0 for _ in 0..nb]
    mut pos := 0
    for b in order
        bstart[b] = pos
        pos += 2 + 2 * f.blocks[b].insts.len()
        bend[b] = pos
        pos += 2
    live_in := liveness(f, order)
    # Each value's live ranges, block by block: from its definition (or the
    # block's start when it is live in) to its last use (or the block's end
    # when it is live out). Between ranges it has a hole, where another
    # value may use its register.
    mut ranges := [List[int]() for _ in 0..n]
    mut calls := List[int]()
    for b in order
        blk := f.blocks[b]
        mut first := [-1 for _ in 0..n]
        mut last := [-1 for _ in 0..n]
        for v in 0..n
            if live_in[b][v]
                first[v] = bstart[b]
                last[v] = bstart[b]
        for p in blk.params
            first[p] = bstart[b] + 1
            last[p] = bstart[b] + 1
        mut k := bstart[b] + 2
        for i in blk.insts
            for a in i.args
                last[a] = k
            if i.dst >= 0
                first[i.dst] = k + 1
                last[i.dst] = k + 1
            if is_call(i)
                calls.push(k)
            k += 2
        for a in blk.term.uses()
            last[a] = bend[b]
        for succ in blk.term.targets
            for v in 0..n
                if live_in[succ][v]
                    last[v] = bend[b]
        for v in 0..n
            if first[v] >= 0
                add_range(mut ranges[v], first[v], last[v])
    mut start := [-1 for _ in 0..n]
    mut end := [-1 for _ in 0..n]
    for v in 0..n
        if ranges[v].len() > 0
            start[v] = ranges[v][0]
            end[v] = ranges[v][ranges[v].len() - 1]
    mut hints := [List[int]() for _ in 0..n]
    for blk in f.blocks
        for e in 0..blk.term.targets.len()
            ps := f.blocks[blk.term.targets[e]].params
            args := blk.term.args[e]
            for j in 0..args.len()
                hints[ps[j]].push(args[j])
                hints[args[j]].push(ps[j])
        for i in blk.insts
            if i.op == "copy"
                hints[i.dst].push(i.args[0])
    mut loc := [NOWHERE for _ in 0..n]
    mut queue := List[int]()
    for v in 0..n
        if remat[v]
            loc[v] = REMAT
        elif start[v] >= 0
            queue.push(v)
    queue = queue.sorted(by: |v| start[v] * n + v)
    mut s := Scan(
        loc: loc,
        active: [],
        slots: 0,
        saved: [],
        start: start,
        end: end,
        ranges: ranges,
        calls: calls,
        hints: hints,
        weight: [],
        weighed: false,
        func: f,
    )
    for v in queue
        s.assign(v, f.vals[v].is_float(), t)
    shrink := shrink_wrap(f, order, s, bstart, bend, t)
    Alloc(
        loc: s.loc,
        order: order,
        slots: s.slots,
        saved: s.saved.sorted(),
        wrap: shrink.wrap,
        region: shrink.region,
    )

## The cost of keeping each value in memory: one per definition or use,
## times 8 for each loop around it (at most 4).
fn use_weights(f mir.Func) List[int]
    n := f.blocks.len()
    mut depth := [0 for _ in 0..n]
    for lp in mir.find_loops(f)
        for b in lp.blocks
            depth[b] += 1
    mut w := [0 for _ in 0..f.vals.len()]
    for b in 0..n
        mut unit := 1
        for _ in 0..(if depth[b] > 4 then 4 else depth[b])
            unit *= 8
        blk := f.blocks[b]
        for p in blk.params
            w[p] += unit
        for i in blk.insts
            if i.dst >= 0
                w[i.dst] += unit
            for a in i.args
                w[a] += unit
        for a in blk.term.uses()
            w[a] += unit
        for e in blk.term.args
            for a in e
                w[a] += unit
    w

struct Wrap
    wrap int
    region List[bool]

## Where the callee-saved registers can be saved instead of at the entry:
## the deepest block that dominates every block a callee-saved register is
## live in, when no edge leaves what it dominates and none comes back to it.
## A path that returns without reaching it then saves and restores nothing.
fn shrink_wrap(f mir.Func, order List[int], s Scan, bstart List[int], bend List[int], t Target) Wrap
    nowrap := Wrap(wrap: -1, region: [])
    if s.saved.len() == 0
        return nowrap
    n := f.blocks.len()
    mut occupied := [false for _ in 0..n]
    for v in 0..s.loc.len()
        l := s.loc[v]
        if l < 0 or l >= SLOT_BASE
            continue
        if not (t.int_callee.contains(l) or t.float_callee.contains(l))
            continue
        for b in order
            mut k := 0
            while k < s.ranges[v].len()
                if s.ranges[v][k] <= bend[b] and s.ranges[v][k + 1] >= bstart[b]
                    occupied[b] = true
                k += 2
    if occupied[0]
        return nowrap
    dom := mir.dominators(f)
    mut where := List[int]()
    for b in order
        if occupied[b]
            where.push(b)
    best := wrap_block(f, order, dom, where)
    if best < 0
        return nowrap
    mut region := [false for _ in 0..n]
    for b in order
        region[b] = dom[b][best]
    Wrap(wrap: best, region: region)

## Append the range `from..=to`, joining it to the last one when they meet
## (consecutive blocks are 2 positions apart).
fn add_range(mut r List[int], from int, to int)
    n := r.len()
    if n > 0 and r[n - 1] >= from - 2
        if to > r[n - 1]
            r[n - 1] = to
        return
    r.push(from)
    r.push(to)

## Whether two values' ranges overlap.
fn overlaps(a List[int], b List[int]) bool
    mut i := 0
    mut j := 0
    while i < a.len() and j < b.len()
        if a[i + 1] < b[j]
            i += 2
        elif b[j + 1] < a[i]
            j += 2
        else
            return true
    false

## Which values are live on entry to each block (the block's parameters
## are defined there, so they are not).
fn liveness(f mir.Func, order List[int]) List[List[bool]]
    n := f.vals.len()
    nb := f.blocks.len()
    mut live_in := [[false for _v in 0..n] for _b in 0..nb]
    mut changed := true
    while changed
        changed = false
        mut k := order.len() - 1
        while k >= 0
            b := order[k]
            k -= 1
            blk := f.blocks[b]
            mut live := [false for _ in 0..n]
            for s in blk.term.targets
                for v in 0..n
                    if live_in[s][v]
                        live[v] = true
            for a in blk.term.uses()
                live[a] = true
            mut i := blk.insts.len() - 1
            while i >= 0
                inst := blk.insts[i]
                if inst.dst >= 0
                    live[inst.dst] = false
                for a in inst.args
                    live[a] = true
                i -= 1
            for p in blk.params
                live[p] = false
            if live != live_in[b]
                live_in[b] = live
                changed = true
    live_in

struct Scan
    loc List[int]
    ## Values holding a register now.
    active List[int]
    slots int
    saved List[int]
    start List[int]
    end List[int]
    ranges List[List[int]]
    calls List[int]
    hints List[List[int]]
    ## How much a value costs to keep in memory: its definitions and uses,
    ## each counted 8 times over for every loop it sits in.
    weight List[int]
    ## Whether `weight` has been computed: only a function that runs out of
    ## registers needs it.
    weighed bool
    func mir.Func

## Whether `v` is live across a call, so it needs a callee-saved register.
fn Scan.crosses(self, v int) bool
    r := ranges[v]
    for c in calls
        mut k := 0
        while k < r.len()
            if r[k] < c and r[k + 1] > c
                return true
            k += 2
    false

## Whether register `r` is free for all of `v`'s ranges.
fn Scan.free(self, r int, v int) bool
    for a in active
        if loc[a] == r and overlaps(ranges[a], ranges[v])
            return false
    true

fn Scan.assign(mut self, v int, float bool, t Target)
    # Free the registers of values that ended.
    mut keep := List[int]()
    for a in active
        if end[a] >= start[v]
            keep.push(a)
    active = keep
    cross := crosses(v)
    mut pool := List[int]()
    if float
        if not cross
            pool.extend(t.float_caller)
        pool.extend(t.float_callee)
    else
        if not cross
            pool.extend(t.int_caller)
        pool.extend(t.int_callee)
    mut pick := -1
    for h in hints[v]
        r := loc[h]
        if r >= 0 and r < SLOT_BASE and pool.contains(r) and free(r, v)
            pick = r
            break
    if pick < 0
        for r in pool
            if free(r, v)
                pick = r
                break
    if pick < 0 and not weighed
        weight = use_weights(func)
        weighed = true
    if pick < 0
        # Spill whichever of `v` and the values in its way is cheapest to
        # keep in memory (loop-weighted uses, ADR 0622), the one that ends
        # last among equals, when that value alone holds its register over
        # `v`'s ranges.
        mut victim := -1
        for a in active
            if pool.contains(loc[a])
                and overlaps(ranges[a], ranges[v])
                and sole(a, v)
                and (victim < 0 or weight[a] < weight[victim] or (weight[a] == weight[victim] and end[a] > end[victim]))
                victim = a
        if victim >= 0
            and (weight[victim] < weight[v] or (weight[victim] == weight[v] and end[victim] > end[v]))
            pick = loc[victim]
            loc[victim] = new_slot()
            mut rest := List[int]()
            for a in active
                if a != victim
                    rest.push(a)
            active = rest
        else
            loc[v] = new_slot()
            return
    loc[v] = pick
    active.push(v)
    if (t.int_callee.contains(pick) or t.float_callee.contains(pick)) and not saved.contains(pick)
        saved.push(pick)

## Whether `a` is the only active value whose use of its register meets `v`.
fn Scan.sole(self, a int, v int) bool
    for b in active
        if b != a and loc[b] == loc[a] and overlaps(ranges[b], ranges[v])
            return false
    true

fn Scan.new_slot(mut self) int
    slots += 1
    SLOT_BASE + slots - 1
