## C calls with structs by value on ARM64 (ffi.struct.2, ADR 1074):
## `rt.ffi_ccall` calls the function of a call frame that
## `compiler/rt/native/ffi_struct.ail` filled with the AAPCS64 argument
## registers (x0-x7, d0-d7, x8) and stack words, and stores x0-x1 and d0-d3
## back. ARM64 needs no callback adapter: AIL functions already keep what
## AAPCS64 makes a callee keep (x19-x28, d8-d15) and take their arguments in
## its registers.

## The frame's words (ffi_struct.ail).
FW_INT := 1
FW_FLT := 9
FW_X8 := 17
FW_NST := 18
FW_RI := 19
FW_RF := 21
FW_STK := 26

## Whether `name` is one of the call kernels (`rt.ffi_ccall_win` is never
## called on ARM64; it gets the same code).
pub fn is_ffi_kernel(name str) bool
    name == "rt.ffi_ccall" or name == "rt.ffi_ccall_win"

## x0 = frame. x19 keeps the frame across the call; the stack words are copied
## below the kernel's frame record, 16-byte aligned.
pub fn kernel_ffi_ccall(mut a Asm)
    a.push_pair(FP, LR)
    a.push_pair(19, 20)
    a.mov_rr(FP, SP)
    a.mov_rr(19, 0)
    a.ldr(9, 19, 8 * FW_NST)
    # The stack area: the words rounded up to a 16-byte multiple.
    a.alu_ri("add", 10, 9, 1)
    a.shift_ri("lsr", 10, 10, 1)
    a.shift_ri("lsl", 10, 10, 4)
    a.mov_rr(11, SP)
    a.alu_rr("sub", 11, 11, 10)
    a.mov_rr(SP, 11)
    a.mov_ri(11, 0)
    a.alu_ri("add", 12, 19, 8 * FW_STK)
    top := a.label()
    done := a.label()
    a.bind(top)
    a.cmp_rr(11, 9)
    a.b_cond(GE, done)
    a.ldr_idx(13, 12, 11)
    a.str_idx(13, SP, 11)
    a.alu_ri("add", 11, 11, 1)
    a.b(top)
    a.bind(done)
    for k in 0..8
        a.ldr_d(k, 19, 8 * (FW_FLT + k))
    a.ldr(8, 19, 8 * FW_X8)
    a.ldr(16, 19, 0)
    for k in 0..8
        a.ldr(k, 19, 8 * (FW_INT + k))
    a.blr(16)
    a.str(0, 19, 8 * FW_RI)
    a.str(1, 19, 8 * (FW_RI + 1))
    for k in 0..4
        a.str_d(k, 19, 8 * (FW_RF + k))
    a.mov_rr(SP, FP)
    a.pop_pair(19, 20)
    a.pop_pair(FP, LR)
    a.ret()
