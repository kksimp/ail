# ---- control ----

pub fn Asm.b(mut self, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "b26", label: l, sym: ""))
    self.word(335544320)

pub fn Asm.b_cond(mut self, cond int, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "b19", label: l, sym: ""))
    self.word(1409286144 + cond)

## `br xn`: an indirect jump (a `switch`, native.match.2).
pub fn Asm.br(mut self, n int)
    self.word(3592355840 + n * 32)

## `adr xd, l`: the address of local label `l`, within 1 MiB.
pub fn Asm.adr_label(mut self, d int, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "adr", label: l, sym: ""))
    self.word(268435456 + d)

## `add xd, xn, xm, lsl #k`.
pub fn Asm.add_lsl(mut self, d int, n int, m int, k int)
    self.word(rrr(2332033024, d, n, m) + k * 1024)

## `ldrsw xt, [xn]`: a signed 32-bit load.
pub fn Asm.ldrsw(mut self, t int, n int)
    self.word(3112173568 + n * 32 + t)

## A jump table entry: the 32-bit distance from the entry itself to label `l`.
pub fn Asm.table_entry(mut self, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "w32", label: l, sym: ""))
    self.word(0)

pub fn Asm.bl(mut self, sym str)
    self.fixups.push(Fixup(at: self.code.len(), kind: "b26", label: -1, sym: sym))
    self.word(2483027968)

pub fn Asm.blr(mut self, r int)
    self.word(3594452992 + r * 32)

pub fn Asm.ret(mut self)
    self.word(3596551104)

pub fn Asm.svc(mut self, imm int)
    self.word(3556769793 + imm * 32)

## ARMv8.1 LSE atomics and acquire/release accesses on a 64-bit location
## (ADR 0600): `swpal`, `ldaddal` and `casal` put the old value in `t`
## (`casal` in `s`, which also holds the expected value); `ldar`/`stlr`.
pub fn Asm.swpal(mut self, s int, t int, n int)
    self.word(4175462400 + s * 65536 + n * 32 + t)

pub fn Asm.ldaddal(mut self, s int, t int, n int)
    self.word(4175429632 + s * 65536 + n * 32 + t)

pub fn Asm.casal(mut self, s int, t int, n int)
    self.word(3370187776 + s * 65536 + n * 32 + t)

pub fn Asm.ldar(mut self, t int, n int)
    self.word(3370122240 + n * 32 + t)

pub fn Asm.stlr(mut self, t int, n int)
    self.word(3365927936 + n * 32 + t)

pub fn Asm.brk(mut self)
    self.word(3558866944)

## Patch a field at `at` for a target `delta` bytes away (or, for `adrp`
## and `add12`, the target address `to` and the field's address `pc`).
pub fn patch(mut code List[u8], f Fixup, pc int, to int)
    mut w := 0
    for i in 0..4
        w = w.bit_or(code[f.at + i].to_int().shl(8 * i))
    match f.kind
        "b26" => w = w.bit_or((to - pc).shr(2).bit_and(67108863))
        "b19" => w = w.bit_or((to - pc).shr(2).bit_and(524287) * 32)
        "adr" =>
            d := to - pc
            w = w.bit_or(d.bit_and(3) * 536870912).bit_or(d.shr(2).bit_and(524287) * 32)
        "w32" => w = (to - pc).bit_and(4294967295)
        "adrp" =>
            pages := to.shr(12) - pc.shr(12)
            w = w.bit_or(pages.bit_and(3) * 536870912).bit_or(pages.shr(2).bit_and(524287) * 32)
        _ => w = w.bit_or(to.bit_and(4095) * 1024)
    for i in 0..4
        code[f.at + i] = w.shr(8 * i).bit_and(255).to_u8()

## Patch every branch to a local label; symbol fixups stay for the writer.
pub fn Asm.resolve_labels(mut self)
    mut rest := List[Fixup]()
    for f in self.fixups
        if f.label < 0
            rest.push(f)
            continue
        to := self.labels[f.label]
        if to < 0
            unreachable("label {f.label} was never placed")
        patch(mut self.code, f, f.at, to)
    self.fixups = rest

# ---- crypto and byte vectors (AES and GHASH kernels) ----

## `aese vd.16b, vn.16b` and `aesmc vd.16b, vn.16b`.
pub fn Asm.aese(mut self, d int, n int)
    self.word(1311262720 + n * 32 + d)

pub fn Asm.aesmc(mut self, d int, n int)
    self.word(1311270912 + n * 32 + d)

## `eor vd.16b, vn.16b, vm.16b` and `orr vd.16b, vn.16b, vm.16b`.
pub fn Asm.veor(mut self, d int, n int, m int)
    self.word(rrr(1847598080, d, n, m))

pub fn Asm.vorr(mut self, d int, n int, m int)
    self.word(rrr(1319115776, d, n, m))

## `mov vd.16b, vn.16b`.
