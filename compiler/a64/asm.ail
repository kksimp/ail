## An ARMv8.2-A (A64) encoder: every instruction the code generator emits,
## as 32-bit little-endian words (ADR 0388). Registers are numbered 0-31;
## 31 is `sp` or `xzr` as the instruction defines. Vector registers `d0`-`d31`
## are numbered 0-31 too: an instruction's operand kinds are fixed.

pub SP := 31
pub XZR := 31
pub FP := 29
pub LR := 30

## Condition codes.
pub EQ := 0
pub NE := 1
pub HS := 2
pub LO := 3
pub MI := 4
pub PL := 5
pub VS := 6
pub VC := 7
pub HI := 8
pub LS := 9
pub GE := 10
pub LT := 11
pub GT := 12
pub LE := 13

## A field to patch once its target is placed. `kind`: "b26" (`b`, `bl`),
## "b19" (`b.cond`, `cbz`), "adrp" or "add12" (the page and offset of a
## symbol's address); `label` is a local label, or -1 for `sym`.
pub struct Fixup
    pub at int
    pub kind str
    pub label int
    pub sym str

pub struct Asm
    pub code List[int]
    pub labels List[int]
    pub fixups List[Fixup]

pub fn new_asm() Asm
    Asm(code: [], labels: [], fixups: [])

fn Asm.word(mut self, w int)
    for i in 0..4
        code.push(w.shr(8 * i).bit_and(255))

pub fn Asm.here(self) int
    code.len()

pub fn Asm.label(mut self) int
    labels.push(-1)
    labels.len() - 1

pub fn Asm.bind(mut self, l int)
    labels[l] = code.len()

pub fn fits_imm12(v int) bool
    v >= 0 and v < 4096

# ---- moves and immediates ----

## `mov xd, xm` (`orr xd, xzr, xm`); with `sp` on either side, `add xd, xn, #0`.
pub fn Asm.mov_rr(mut self, d int, m int)
    if d == m
        return
    if d == SP or m == SP
        word(2432696320 + m * 32 + d)
        return
    word(2852127712 + m * 65536 + d)

## Any 64-bit constant: `movz`/`movn` then `movk` for each other 16-bit part.
pub fn Asm.mov_ri(mut self, d int, v int)
    mut parts := List[int]()
    for k in 0..4
        parts.push(v.shr(16 * k).bit_and(65535))
    mut zeros := 0
    mut ones := 0
    for p in parts
        if p == 0
            zeros += 1
        if p == 65535
            ones += 1
    if ones > zeros
        # movn: the first part that isn't all ones, inverted
        mut first := -1
        for k in 0..4
            if parts[k] != 65535 and first < 0
                first = k
        if first < 0
            word(2457862144 + d)
            return
        word(2457862144 + first * 2097152 + parts[first].bit_xor(65535) * 32 + d)
        for k in first + 1..4
            if parts[k] != 65535
                word(4068474880 + k * 2097152 + parts[k] * 32 + d)
        return
    mut first := -1
    for k in 0..4
        if parts[k] != 0 and first < 0
            first = k
    if first < 0
        word(3531603968 + d)
        return
    word(3531603968 + first * 2097152 + parts[first] * 32 + d)
    for k in first + 1..4
        if parts[k] != 0
            word(4068474880 + k * 2097152 + parts[k] * 32 + d)

# ---- integer arithmetic ----

fn rrr(base int, d int, n int, m int) int
    base + m * 65536 + n * 32 + d

## `add`, `sub`, `adds`, `subs`, `and`, `orr`, `eor` with registers.
pub fn Asm.alu_rr(mut self, op str, d int, n int, m int)
    base := match op
        "add" => 2332033024
        "sub" => 3405774848
        "adds" => 2868903936
        "subs" => 3942645760
        "and" => 2315255808
        "orr" => 2852126720
        _ => 3388997632
    word(rrr(base, d, n, m))

## `add`, `sub`, `adds`, `subs` with a 12-bit unsigned immediate.
pub fn Asm.alu_ri(mut self, op str, d int, n int, imm int)
    base := match op
        "add" => 2432696320
        "sub" => 3506438144
        "adds" => 2969567232
        _ => 4043309056
    word(base + imm * 1024 + n * 32 + d)

pub fn Asm.cmp_rr(mut self, n int, m int)
    alu_rr("subs", XZR, n, m)

pub fn Asm.cmp_ri(mut self, n int, imm int)
    alu_ri("subs", XZR, n, imm)

## `cmn xn, #imm`: compare with `-imm`.
pub fn Asm.cmn_ri(mut self, n int, imm int)
    alu_ri("adds", XZR, n, imm)

## `cmp n, m, asr #63`: whether `n` is the sign of `m` (the high half of a
## product that didn't overflow).
pub fn Asm.cmp_sign(mut self, n int, m int)
    word(rrr(3951034368, XZR, n, m) + 63 * 1024)

## `eor d, n, #1`.
pub fn Asm.eor1(mut self, d int, n int)
    word(3527409664 + n * 32 + d)

## `cbz n, l` and `cbnz n, l`.
pub fn Asm.cbz(mut self, n int, l int)
    fixups.push(Fixup(at: code.len(), kind: "b19", label: l, sym: ""))
    word(3019898880 + n)

pub fn Asm.mul(mut self, d int, n int, m int)
    word(rrr(2600468480, d, n, m) + 31 * 1024)

pub fn Asm.smulh(mut self, d int, n int, m int)
    word(rrr(2604662784, d, n, m) + 31 * 1024)

## `msub d, n, m, a`: a - n * m.
pub fn Asm.msub(mut self, d int, n int, m int, a int)
    word(rrr(2600501248, d, n, m) + a * 1024)

pub fn Asm.sdiv(mut self, d int, n int, m int)
    word(rrr(2596277248, d, n, m))

## `lslv`, `asrv` (shift by a register, count modulo 64).
pub fn Asm.shift_rr(mut self, op str, d int, n int, m int)
    base := if op == "lsl" then 2596282368 else 2596284416
    word(rrr(base, d, n, m))

## `lsl`, `lsr`, `asr` by a constant 0-63.
pub fn Asm.shift_ri(mut self, op str, d int, n int, k int)
    if op == "lsl"
        immr := (64 - k) % 64
        word(3544186880 + immr * 65536 + (63 - k) * 1024 + n * 32 + d)
    elif op == "lsr"
        word(3544186880 + k * 65536 + 63 * 1024 + n * 32 + d)
    else
        word(2470445056 + k * 65536 + 63 * 1024 + n * 32 + d)

pub fn Asm.neg(mut self, d int, m int)
    alu_rr("sub", d, XZR, m)

pub fn Asm.negs(mut self, d int, m int)
    alu_rr("subs", d, XZR, m)

## `mvn d, m` (`orn d, xzr, m`).
pub fn Asm.mvn(mut self, d int, m int)
    word(rrr(2854223872, d, XZR, m))

## `cset d, cond` (`csinc d, xzr, xzr, !cond`).
pub fn Asm.cset(mut self, d int, cond int)
    word(2594113504 + invert(cond) * 4096 + d)

pub fn invert(cond int) int
    cond.bit_xor(1)

# ---- memory ----

## `ldr`/`str` of a 64-bit register at `[n, #off]`: scaled 12-bit when the
## offset is a multiple of 8 in range, else the unscaled 9-bit form; `off`
## must be in one of them.
pub fn Asm.ldr(mut self, t int, n int, off int)
    mem(4181721088, 4164943872, t, n, off)

pub fn Asm.str(mut self, t int, n int, off int)
    mem(4177526784, 4160749568, t, n, off)

pub fn Asm.ldr_d(mut self, t int, n int, off int)
    mem(4248829952, 4232052736, t, n, off)

pub fn Asm.str_d(mut self, t int, n int, off int)
    mem(4244635648, 4227858432, t, n, off)

fn Asm.mem(mut self, scaled int, unscaled int, t int, n int, off int)
    if off >= 0 and off % 8 == 0 and off < 32768
        word(scaled + off / 8 * 1024 + n * 32 + t)
        return
    if off < -256 or off > 255
        unreachable("a64: offset {off} out of range")
    word(unscaled + off.bit_and(511) * 4096 + n * 32 + t)

## `ldr`/`str t, [n, m, lsl #3]`.
pub fn Asm.ldr_idx(mut self, t int, n int, m int)
    word(rrr(4167071744, t, n, m))

pub fn Asm.str_idx(mut self, t int, n int, m int)
    word(rrr(4162877440, t, n, m))

pub fn Asm.ldr_d_idx(mut self, t int, n int, m int)
    word(rrr(4234180608, t, n, m))

pub fn Asm.str_d_idx(mut self, t int, n int, m int)
    word(rrr(4229986304, t, n, m))

pub fn Asm.ldrb(mut self, t int, n int)
    word(960495616 + n * 32 + t)

pub fn Asm.strb(mut self, t int, n int)
    word(956301312 + n * 32 + t)

## `ldrb`/`strb wt, [xn, #k]` (k < 4096) and `[xn, xm]`.
pub fn Asm.ldrb_off(mut self, t int, n int, k int)
    word(960495616 + k * 1024 + n * 32 + t)

pub fn Asm.strb_off(mut self, t int, n int, k int)
    word(956301312 + k * 1024 + n * 32 + t)

pub fn Asm.ldrb_idx(mut self, t int, n int, m int)
    word(rrr(945842176, t, n, m))

pub fn Asm.strb_idx(mut self, t int, n int, m int)
    word(rrr(941647872, t, n, m))

## `stp a, b, [sp, #-16]!` and `ldp a, b, [sp], #16`.
pub fn Asm.push_pair(mut self, a int, b int)
    word(2843738112 + 126 * 32768 + b * 1024 + SP * 32 + a)

pub fn Asm.pop_pair(mut self, a int, b int)
    word(2831155200 + 2 * 32768 + b * 1024 + SP * 32 + a)

## The address of symbol `sym`: `adrp` and `add`, fixed when it is laid out.
pub fn Asm.adr_sym(mut self, d int, sym str)
    fixups.push(Fixup(at: code.len(), kind: "adrp", label: -1, sym: sym))
    word(2415919104 + d)
    fixups.push(Fixup(at: code.len(), kind: "add12", label: -1, sym: sym))
    word(2432696320 + d * 32 + d)

# ---- floating point ----

## `fadd`, `fsub`, `fmul`, `fdiv` on doubles.
pub fn Asm.fop(mut self, op str, d int, n int, m int)
    base := match op
        "fadd" => 509618176
        "fsub" => 509622272
        "fmul" => 509609984
        _ => 509614080
    word(rrr(base, d, n, m))

## One-operand double operations: `fsqrt`, `fneg`, `fabs`, `frintm`
## (floor), `frintp` (ceil), `fmov`.
pub fn Asm.fop1(mut self, op str, d int, n int)
    base := match op
        "fsqrt" => 509722624
        "fneg" => 509689856
        "fabs" => 509657088
        "frintm" => 509952000
        "frintp" => 509919232
        "frintz" => 509984768
        _ => 509624320
    word(base + n * 32 + d)

pub fn Asm.fcmp(mut self, n int, m int)
    word(rrr(509616128, 0, n, m))

## `scvtf dd, xn` and `fcvtzs xd, dn`.
pub fn Asm.scvtf(mut self, d int, n int)
    word(2657222656 + n * 32 + d)

pub fn Asm.fcvtzs(mut self, d int, n int)
    word(2658664448 + n * 32 + d)

## `fmov xd, dn` and `fmov dd, xn`: the bits, unchanged.
pub fn Asm.fmov_xd(mut self, d int, n int)
    word(2657484800 + n * 32 + d)

pub fn Asm.fmov_dx(mut self, d int, n int)
    word(2657550336 + n * 32 + d)

# ---- control ----

pub fn Asm.b(mut self, l int)
    fixups.push(Fixup(at: code.len(), kind: "b26", label: l, sym: ""))
    word(335544320)

pub fn Asm.b_cond(mut self, cond int, l int)
    fixups.push(Fixup(at: code.len(), kind: "b19", label: l, sym: ""))
    word(1409286144 + cond)

pub fn Asm.bl(mut self, sym str)
    fixups.push(Fixup(at: code.len(), kind: "b26", label: -1, sym: sym))
    word(2483027968)

pub fn Asm.ret(mut self)
    word(3596551104)

pub fn Asm.blr(mut self, n int)
    word(3594452992 + n * 32)

pub fn Asm.svc(mut self, imm int)
    word(3556769793 + imm * 32)

## ARMv8.1 LSE atomics and acquire/release accesses on a 64-bit location
## (ADR 0600): `swpal`, `ldaddal` and `casal` put the old value in `t`
## (`casal` in `s`, which also holds the expected value); `ldar`/`stlr`.
pub fn Asm.swpal(mut self, s int, t int, n int)
    word(4175462400 + s * 65536 + n * 32 + t)

pub fn Asm.ldaddal(mut self, s int, t int, n int)
    word(4175429632 + s * 65536 + n * 32 + t)

pub fn Asm.casal(mut self, s int, t int, n int)
    word(3370187776 + s * 65536 + n * 32 + t)

pub fn Asm.ldar(mut self, t int, n int)
    word(3370122240 + n * 32 + t)

pub fn Asm.stlr(mut self, t int, n int)
    word(3365927936 + n * 32 + t)

pub fn Asm.brk(mut self)
    word(3558866944)

## Patch a field at `at` for a target `delta` bytes away (or, for `adrp`
## and `add12`, the target address `to` and the field's address `pc`).
pub fn patch(mut code List[int], f Fixup, pc int, to int)
    mut w := 0
    for i in 0..4
        w = w.bit_or(code[f.at + i].shl(8 * i))
    match f.kind
        "b26" => w = w.bit_or((to - pc).shr(2).bit_and(67108863))
        "b19" => w = w.bit_or((to - pc).shr(2).bit_and(524287) * 32)
        "adrp" =>
            pages := to.shr(12) - pc.shr(12)
            w = w.bit_or(pages.bit_and(3) * 536870912).bit_or(pages.shr(2).bit_and(524287) * 32)
        _ => w = w.bit_or(to.bit_and(4095) * 1024)
    for i in 0..4
        code[f.at + i] = w.shr(8 * i).bit_and(255)

## Patch every branch to a local label; symbol fixups stay for the writer.
pub fn Asm.resolve_labels(mut self)
    mut rest := List[Fixup]()
    for f in fixups
        if f.label < 0
            rest.push(f)
            continue
        to := labels[f.label]
        if to < 0
            unreachable("label {f.label} was never placed")
        patch(mut code, f, f.at, to)
    fixups = rest
