    self.word(rrr(1319115776, d, n, n))

## `pmull vd.1q, vn.1d, vm.1d` and `pmull2 vd.1q, vn.2d, vm.2d`: the carry-less
## product of the low (high) 64-bit halves.
pub fn Asm.pmull(mut self, d int, n int, m int)
    self.word(rrr(249618432, d, n, m))

pub fn Asm.pmull2(mut self, d int, n int, m int)
    self.word(rrr(1323360256, d, n, m))

## `ext vd.16b, vn.16b, vm.16b, #k`: bytes `k..k+15` of `vn` followed by `vm`.
pub fn Asm.vext(mut self, d int, n int, m int, k int)
    self.word(rrr(1845493760, d, n, m) + k * 2048)

## `shl vd.4s, vn.4s, #k` and `ushr vd.4s, vn.4s, #k`, for `k` in 1..31.
pub fn Asm.vshl4(mut self, d int, n int, k int)
    self.word(1325421568 + (32 + k) * 65536 + n * 32 + d)

pub fn Asm.vushr4(mut self, d int, n int, k int)
