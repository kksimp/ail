## An ARMv8.2-A (plat.isa.2) (A64) encoder: every instruction the code generator emits,
## as 32-bit little-endian words (ADR 0388). Registers are numbered 0-31;
## 31 is `sp` or `xzr` as the instruction defines. Vector registers `d0`-`d31`
## are numbered 0-31 too: an instruction's operand kinds are fixed.

pub SP := 31
pub XZR := 31
pub FP := 29
pub LR := 30

## Condition codes.
pub EQ := 0
pub NE := 1
pub HS := 2
pub LO := 3
pub MI := 4
pub PL := 5
pub VS := 6
pub VC := 7
pub HI := 8
pub LS := 9
pub GE := 10
pub LT := 11
pub GT := 12
pub LE := 13

## A field to patch once its target is placed. `kind`: "b26" (`b`, `bl`),
## "b19" (`b.cond`, `cbz`), "adr" (a local label's address), "w32" (a jump
## table entry), "adrp" or "add12" (the page and offset of a symbol's
## address); `label` is a local label, or -1 for `sym`.
pub struct Fixup
    pub at int
    pub kind str
    pub label int
    pub sym str

pub struct Asm
    pub code List[u8]
    pub labels List[int]
    pub fixups List[Fixup]

pub fn new_asm() Asm
    Asm(code: [], labels: [], fixups: [])

fn Asm.word(mut self, w int)
    for i in 0..4
        self.code.push(w.shr(8 * i).bit_and(255).to_u8())

pub fn Asm.here(self) int
    self.code.len()

pub fn Asm.label(mut self) int
    self.labels.push(-1)
    self.labels.len() - 1

pub fn Asm.bind(mut self, l int)
    self.labels[l] = self.code.len()

pub fn fits_imm12(v int) bool
    v >= 0 and v < 4096

# ---- moves and immediates ----

## `mov xd, xm` (`orr xd, xzr, xm`); with `sp` on either side, `add xd, xn, #0`.
pub fn Asm.mov_rr(mut self, d int, m int)
    if d == m
        return
    if d == SP or m == SP
        self.word(2432696320 + m * 32 + d)
        return
    self.word(2852127712 + m * 65536 + d)

## Any 64-bit constant: `movz`/`movn` then `movk` for each other 16-bit part.
pub fn Asm.mov_ri(mut self, d int, v int)
    mut parts := List[int]()
    for k in 0..4
        parts.push(v.shr(16 * k).bit_and(65535))
    mut zeros := 0
    mut ones := 0
    for p in parts
        if p == 0
            zeros += 1
        if p == 65535
            ones += 1
    if ones > zeros
        # movn: the first part that isn't all ones, inverted
        mut first := -1
        for k in 0..4
            if parts[k] != 65535 and first < 0
                first = k
        if first < 0
            self.word(2457862144 + d)
            return
        self.word(2457862144 + first * 2097152 + parts[first].bit_xor(65535) * 32 + d)
        for k in first + 1..4
            if parts[k] != 65535
                self.word(4068474880 + k * 2097152 + parts[k] * 32 + d)
        return
    mut first := -1
    for k in 0..4
        if parts[k] != 0 and first < 0
            first = k
    if first < 0
        self.word(3531603968 + d)
        return
    self.word(3531603968 + first * 2097152 + parts[first] * 32 + d)
    for k in first + 1..4
        if parts[k] != 0
            self.word(4068474880 + k * 2097152 + parts[k] * 32 + d)

## How many instructions `mov_ri` emits for `v`.
pub fn mov_count(v int) int
    mut zeros := 0
    mut ones := 0
    for k in 0..4
        p := v.shr(16 * k).bit_and(65535)
        if p == 0
            zeros += 1
        if p == 65535
            ones += 1
    n := if ones > zeros then 4 - ones else 4 - zeros
    if n < 1 then 1 else n

## `ldr xd, <label>`: a 64-bit load from the literal pool entry at `l`.
pub fn Asm.ldr_lit(mut self, d int, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "b19", label: l, sym: ""))
    self.word(1476395008 + d)

## A 64-bit literal pool entry (two words, low first).
pub fn Asm.pool_entry(mut self, v int)
    self.word(v.bit_and(4294967295))
    self.word(v.shr(32).bit_and(4294967295))

## The 8-bit `fmov` immediate of the double with bits `b`, or -1: a sign, a
## 3-bit exponent and a 4-bit fraction (1.0, 0.5, 2.0, 4.0, 31.0 ...).
pub fn fmov_imm8(b int) int
    if b.bit_and(281474976710655) != 0
        return -1
    e := b.shr(54).bit_and(255)
    top := b.shr(62).bit_and(1)
    if e != 255 and e != 0
        return -1
    if top == 1 and e != 0
        return -1
    if top == 0 and e != 255
        return -1
    sign := b.shr(63).bit_and(1)
    nb := if top == 0 then 1 else 0
    sign * 128 + nb * 64 + b.shr(48).bit_and(63)

## `fmov dd, #imm8` (`fmov_imm8` of the value).
pub fn Asm.fmov_imm(mut self, d int, imm8 int)
    self.word(509612032 + imm8 * 8192 + d)

# ---- integer arithmetic ----

fn rrr(base int, d int, n int, m int) int
    base + m * 65536 + n * 32 + d

## `add`, `sub`, `adds`, `subs`, `and`, `ands`, `orr`, `eor` with registers.
pub fn Asm.alu_rr(mut self, op str, d int, n int, m int)
    base := match op
        "add" => 2332033024
        "sub" => 3405774848
        "adds" => 2868903936
        "subs" => 3942645760
        "and" => 2315255808
        "orr" => 2852126720
        "ands" => 3925868544
        _ => 3388997632
    self.word(rrr(base, d, n, m))

## `add`, `sub`, `adds`, `subs` with a 12-bit unsigned immediate.
pub fn Asm.alu_ri(mut self, op str, d int, n int, imm int)
    base := match op
        "add" => 2432696320
        "sub" => 3506438144
        "adds" => 2969567232
        _ => 4043309056
    if imm < 0 or imm > 16777215
        unreachable("a64: the add/sub immediate {imm} does not fit in 24 bits")
    if imm > 4095
        # The immediate field is 12 bits: the high part goes through the
        # shifted form (`lsl #12`), the low part is a second instruction.
        if op != "add" and op != "sub"
            unreachable("a64: the {op} immediate {imm} does not fit in 12 bits")
        self.word(base + 4194304 + imm / 4096 * 1024 + n * 32 + d)
        if imm % 4096 != 0
            self.word(base + imm % 4096 * 1024 + d * 32 + d)
        return
    self.word(base + imm * 1024 + n * 32 + d)

pub fn Asm.cmp_rr(mut self, n int, m int)
    self.alu_rr("subs", XZR, n, m)

## `cmp sp, xm` (`subs xzr, sp, xm, uxtx`): register 31 as the first
## operand is `sp` only in the extended-register form.
pub fn Asm.cmp_sp(mut self, m int)
    self.word(3944768511 + m * 65536)

## `tst n, m`: the flags of `n & m`.
pub fn Asm.tst_rr(mut self, n int, m int)
    self.alu_rr("ands", XZR, n, m)

pub fn Asm.cmp_ri(mut self, n int, imm int)
    self.alu_ri("subs", XZR, n, imm)

## `cmn xn, #imm`: compare with `-imm`.
pub fn Asm.cmn_ri(mut self, n int, imm int)
    self.alu_ri("adds", XZR, n, imm)

## `cmp n, m, asr #63`: whether `n` is the sign of `m` (the high half of a
## product that didn't overflow).
pub fn Asm.cmp_sign(mut self, n int, m int)
    self.word(rrr(3951034368, XZR, n, m) + 63 * 1024)

## `eor d, n, #1`.
pub fn Asm.eor1(mut self, d int, n int)
    self.word(3527409664 + n * 32 + d)

## The cyclic run of ones in the `e`-bit pattern `p` (`p` already masked, or
## negative for e == 64): `n * 64 + immr` of the logical-immediate form, or -1.
fn logical_run(p int, e int) int
    mask := if e == 64 then -1 else 1.shl(e) - 1
    if p == 0 or p == mask
        return -1
    top := if e == 64 then (if p < 0 then 1 else 0) else p.shr(e - 1).bit_and(1)
    w := if top == 1 then p.bit_xor(mask) else p
    mut s := 0
    while w.shr(s).bit_and(1) == 0
        s += 1
    mut n := 0
    while s + n < 63 and w.shr(s + n).bit_and(1) == 1
        n += 1
    if s + n < 63 and w.shr(s + n) != 0
        return -1
    if top == 1
        return (e - n) * 64 + (e - (s + n)) % e
    n * 64 + (e - s) % e

## The 13-bit `N:immr:imms` field that encodes the 64-bit mask `v` as a
## logical immediate (`and`, `orr`, `eor`, `tst`), or -1 when `v` has none:
## a run of ones, rotated, repeated at a power-of-two period.
pub fn logical_imm(v int) int
    if v == 0 or v == -1
        return -1
    mut e := 2
    while e <= 64
        mut same := true
        if e < 64
            low := 1.shl(e) - 1
            first := v.bit_and(low)
            mut k := 1
            while k * e < 64
                if v.shr(k * e).bit_and(low) != first
                    same = false
                k += 1
        if same
            pat := if e == 64 then v else v.bit_and(1.shl(e) - 1)
            r := logical_run(pat, e)
            if r < 0
                return -1
            n := r / 64
            immr := r % 64
            imms := (0 - 2 * e).bit_and(63).bit_or(n - 1)
            return (if e == 64 then 4096 else 0) + immr * 64 + imms
        e *= 2
    -1

## `and`, `orr`, `eor`, `ands` with a logical immediate (`logical_imm(v) >= 0`).
pub fn Asm.logic_ri(mut self, op str, d int, n int, v int)
    base := match op
        "and" => 2449473536
        "orr" => 2986344448
        "eor" => 3523215360
        _ => 4060086272
    code := logical_imm(v)
    if code < 0
        unreachable("a64: {v} is not a logical immediate")
    self.word(base + code * 1024 + n * 32 + d)

## `tst n, #v`.
pub fn Asm.tst_ri(mut self, n int, v int)
    self.logic_ri("ands", XZR, n, v)

## `cbnz n, l`.
pub fn Asm.cbnz(mut self, n int, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "b19", label: l, sym: ""))
    self.word(3036676096 + n)

## `cbz n, l` and `cbnz n, l`.
pub fn Asm.cbz(mut self, n int, l int)
    self.fixups.push(Fixup(at: self.code.len(), kind: "b19", label: l, sym: ""))
    self.word(3019898880 + n)

pub fn Asm.mul(mut self, d int, n int, m int)
    self.word(rrr(2600468480, d, n, m) + 31 * 1024)

pub fn Asm.smulh(mut self, d int, n int, m int)
    self.word(rrr(2604662784, d, n, m) + 31 * 1024)

## `msub d, n, m, a`: a - n * m.
pub fn Asm.msub(mut self, d int, n int, m int, a int)
    self.word(rrr(2600501248, d, n, m) + a * 1024)

pub fn Asm.sdiv(mut self, d int, n int, m int)
    self.word(rrr(2596277248, d, n, m))

## `lslv`, `asrv` (shift by a register, count modulo 64).
pub fn Asm.shift_rr(mut self, op str, d int, n int, m int)
    base := if op == "lsl" then 2596282368 else 2596284416
    self.word(rrr(base, d, n, m))

## `lsl`, `lsr`, `asr` by a constant 0-63.
pub fn Asm.shift_ri(mut self, op str, d int, n int, k int)
    if op == "lsl"
        immr := (64 - k) % 64
        self.word(3544186880 + immr * 65536 + (63 - k) * 1024 + n * 32 + d)
    elif op == "lsr"
        self.word(3544186880 + k * 65536 + 63 * 1024 + n * 32 + d)
    else
        self.word(2470445056 + k * 65536 + 63 * 1024 + n * 32 + d)

pub fn Asm.neg(mut self, d int, m int)
    self.alu_rr("sub", d, XZR, m)

pub fn Asm.negs(mut self, d int, m int)
    self.alu_rr("subs", d, XZR, m)

## `mvn d, m` (`orn d, xzr, m`).
pub fn Asm.mvn(mut self, d int, m int)
    self.word(rrr(2854223872, d, XZR, m))

## `cset d, cond` (`csinc d, xzr, xzr, !cond`).
pub fn Asm.cset(mut self, d int, cond int)
    self.word(2594113504 + invert(cond) * 4096 + d)

pub fn invert(cond int) int
    cond.bit_xor(1)

# ---- memory ----

## `ldr`/`str` of a 64-bit register at `[n, #off]`: scaled 12-bit when the
## offset is a multiple of 8 in range, else the unscaled 9-bit form; `off`
## must be in one of them.
pub fn Asm.ldr(mut self, t int, n int, off int)
    self.mem(4181721088, 4164943872, t, n, off)

pub fn Asm.str(mut self, t int, n int, off int)
    self.mem(4177526784, 4160749568, t, n, off)

pub fn Asm.ldr_d(mut self, t int, n int, off int)
    self.mem(4248829952, 4232052736, t, n, off)

pub fn Asm.str_d(mut self, t int, n int, off int)
    self.mem(4244635648, 4227858432, t, n, off)

## `ldr st, [n, #off]` and `str st, [n, #off]` of one single: scaled 12-bit
## when `off` is a multiple of 4 in range, else the unscaled 9-bit form.
pub fn Asm.ldr_s(mut self, t int, n int, off int)
    self.mem4(3175088128, 3158310912, t, n, off)

pub fn Asm.str_s(mut self, t int, n int, off int)
    self.mem4(3170893824, 3154116608, t, n, off)

fn Asm.mem4(mut self, scaled int, unscaled int, t int, n int, off int)
    if off >= 0 and off % 4 == 0 and off < 16384
        self.word(scaled + off / 4 * 1024 + n * 32 + t)
        return
    if off < -256 or off > 255
        unreachable("a64: offset {off} out of range")
    self.word(unscaled + off.bit_and(511) * 4096 + n * 32 + t)

fn Asm.mem(mut self, scaled int, unscaled int, t int, n int, off int)
    if off >= 0 and off % 8 == 0 and off < 32768
        self.word(scaled + off / 8 * 1024 + n * 32 + t)
        return
    if off < -256 or off > 255
        unreachable("a64: offset {off} out of range")
    self.word(unscaled + off.bit_and(511) * 4096 + n * 32 + t)

## `ldr`/`str t, [n, m, lsl #3]`.
pub fn Asm.ldr_idx(mut self, t int, n int, m int)
    self.word(rrr(4167071744, t, n, m))

pub fn Asm.str_idx(mut self, t int, n int, m int)
    self.word(rrr(4162877440, t, n, m))

pub fn Asm.ldr_d_idx(mut self, t int, n int, m int)
    self.word(rrr(4234180608, t, n, m))

pub fn Asm.str_d_idx(mut self, t int, n int, m int)
    self.word(rrr(4229986304, t, n, m))

pub fn Asm.ldrb(mut self, t int, n int)
    self.word(960495616 + n * 32 + t)

pub fn Asm.strb(mut self, t int, n int)
    self.word(956301312 + n * 32 + t)

## `ldrh wt, [xn]`, `strh wt, [xn]`, `ldr wt, [xn]` and `str wt, [xn]` (the
## 32-bit forms, zero-extending on a load).
pub fn Asm.ldrh(mut self, t int, n int)
    self.word(2034237440 + n * 32 + t)

pub fn Asm.strh(mut self, t int, n int)
    self.word(2030043136 + n * 32 + t)

pub fn Asm.ldr_w(mut self, t int, n int)
    self.word(3107979264 + n * 32 + t)

pub fn Asm.str_w(mut self, t int, n int)
    self.word(3103784960 + n * 32 + t)

## `dmb ish` and `dsb sy`.
pub fn Asm.dmb_ish(mut self)
    self.word(3573758911)

pub fn Asm.dsb_sy(mut self)
    self.word(3573759903)

## `ldrb`/`strb wt, [xn, #k]` (k < 4096) and `[xn, xm]`.
pub fn Asm.ldrb_off(mut self, t int, n int, k int)
    self.word(960495616 + k * 1024 + n * 32 + t)

pub fn Asm.strb_off(mut self, t int, n int, k int)
    self.word(956301312 + k * 1024 + n * 32 + t)

pub fn Asm.ldrb_idx(mut self, t int, n int, m int)
    self.word(rrr(945842176, t, n, m))

pub fn Asm.strb_idx(mut self, t int, n int, m int)
    self.word(rrr(941647872, t, n, m))

## `ldrh`/`strh` and `ldr`/`str` of a 32-bit register (zero-extending on a
## load) at `[xn, #k * size]` (k < 4096) and `[xn, xm, lsl #1]` or `lsl #2`.
pub fn Asm.ldrh_off(mut self, t int, n int, k int)
    self.word(2034237440 + k * 1024 + n * 32 + t)

pub fn Asm.strh_off(mut self, t int, n int, k int)
    self.word(2030043136 + k * 1024 + n * 32 + t)

pub fn Asm.ldr_w_off(mut self, t int, n int, k int)
    self.word(3107979264 + k * 1024 + n * 32 + t)

pub fn Asm.str_w_off(mut self, t int, n int, k int)
    self.word(3103784960 + k * 1024 + n * 32 + t)

pub fn Asm.ldrh_idx(mut self, t int, n int, m int)
    self.word(rrr(2019588096, t, n, m))

pub fn Asm.strh_idx(mut self, t int, n int, m int)
    self.word(rrr(2015393792, t, n, m))

pub fn Asm.ldr_w_idx(mut self, t int, n int, m int)
    self.word(rrr(3093329920, t, n, m))

pub fn Asm.str_w_idx(mut self, t int, n int, m int)
    self.word(rrr(3089135616, t, n, m))

## `stp a, b, [sp, #-16]!` and `ldp a, b, [sp], #16`.
pub fn Asm.push_pair(mut self, a int, b int)
    self.word(2843738112 + 126 * 32768 + b * 1024 + SP * 32 + a)

pub fn Asm.pop_pair(mut self, a int, b int)
    self.word(2831155200 + 2 * 32768 + b * 1024 + SP * 32 + a)

## `stp a, b, [n, #off]` and `ldp a, b, [n, #off]` (signed offset, a multiple
## of 8 from 0 to 504).
pub fn Asm.stp_off(mut self, a int, b int, n int, off int)
    self.word(2835349504 + off / 8 * 32768 + b * 1024 + n * 32 + a)

pub fn Asm.ldp_off(mut self, a int, b int, n int, off int)
    self.word(2839543808 + off / 8 * 32768 + b * 1024 + n * 32 + a)

## The address of symbol `sym`: `adrp` and `add`, fixed when it is laid out
## (`adrp` alone for the page-aligned `globals`).
pub fn Asm.adr_sym(mut self, d int, sym str)
    self.fixups.push(Fixup(at: self.code.len(), kind: "adrp", label: -1, sym: sym))
    self.word(2415919104 + d)
    # The globals start on a page (`bss` in each object writer is aligned up
    # to a page), so the page address is the address: no `add` (ADR 0890).
    if sym == "globals"
        return
    self.fixups.push(Fixup(at: self.code.len(), kind: "add12", label: -1, sym: sym))
    self.word(2432696320 + d * 32 + d)

# ---- floating point ----

## `fadd`, `fsub`, `fmul`, `fdiv` on doubles.
pub fn Asm.fop(mut self, op str, d int, n int, m int)
    base := match op
        "fadd" => 509618176
        "fsub" => 509622272
        "fmul" => 509609984
        _ => 509614080
    self.word(rrr(base, d, n, m))

## One-operand double operations: `fsqrt`, `fneg`, `fabs`, `frintm`
## (floor), `frintp` (ceil), `fmov`.
pub fn Asm.fop1(mut self, op str, d int, n int)
    base := match op
        "fsqrt" => 509722624
        "fneg" => 509689856
        "fabs" => 509657088
        "frintm" => 509952000
        "frintp" => 509919232
        "frintz" => 509984768
        "fcvt_sd" => 509755392
        "fcvt_ds" => 505593856
        _ => 509624320
    self.word(base + n * 32 + d)

pub fn Asm.fcmp(mut self, n int, m int)
    self.word(rrr(509616128, 0, n, m))

## `scvtf dd, xn` and `fcvtzs xd, dn`.
pub fn Asm.scvtf(mut self, d int, n int)
    self.word(2657222656 + n * 32 + d)

pub fn Asm.fcvtzs(mut self, d int, n int)
    self.word(2658664448 + n * 32 + d)

# ---- NEON (tensor kernels, ADR 0815) ----

## `ldr qt, [xn], #16` and `str qt, [xn], #16`: two doubles, then advance.
pub fn Asm.ldr_q_post(mut self, t int, n int)
    self.word(1019282432 + n * 32 + t)

pub fn Asm.str_q_post(mut self, t int, n int)
    self.word(1015088128 + n * 32 + t)

## `fadd`, `fsub`, `fmul`, `fdiv` on `v.2d`.
pub fn Asm.vop(mut self, op str, d int, n int, m int)
    base := match op
        "fadd" => 1314968576
        "fsub" => 1323357184
        "fmul" => 1851841536
        _ => 1851849728
    self.word(rrr(base, d, n, m))

## `dup vd.2d, vn.d[0]`.
pub fn Asm.vdup(mut self, d int, n int)
    self.word(1309148160 + n * 32 + d)

## `fcvtn vd.2s, vn.2d` and `fcvtl vd.2d, vn.2s`: the two lanes rounded to
## `f32` and widened back (through the low half of a scratch register).
pub fn Asm.vcvtn(mut self, d int, n int)
    self.word(241264640 + n * 32 + d)

pub fn Asm.vcvtl(mut self, d int, n int)
    self.word(241268736 + n * 32 + d)

## `ldr qt, [xn, #off]` and `str qt, [xn, #off]`; `off` a multiple of 16 up to 65520.
pub fn Asm.ldr_q(mut self, t int, n int, off int)
    self.word(1035993088 + off / 16 * 1024 + n * 32 + t)

pub fn Asm.str_q(mut self, t int, n int, off int)
    self.word(1031798784 + off / 16 * 1024 + n * 32 + t)

## `ldur qt, [xn, #off]` and `stur qt, [xn, #off]`: any `off` from -256 to 255.
pub fn Asm.ldur_q(mut self, t int, n int, off int)
    self.word(1019215872 + off.bit_and(511) * 4096 + n * 32 + t)

pub fn Asm.stur_q(mut self, t int, n int, off int)
    self.word(1015021568 + off.bit_and(511) * 4096 + n * 32 + t)

## `mov vd.d[1], vn.d[0]`: the low lane of `vn` into the high lane of `vd`.
pub fn Asm.vins_hi(mut self, d int, n int)
    self.word(1847067648 + n * 32 + d)

## `mov dd, vn.d[1]`: the high lane as a scalar.
pub fn Asm.vlane_hi(mut self, d int, n int)
    self.word(1578632192 + n * 32 + d)

## `faddp dd, vn.2d`: lane 0 + lane 1.
pub fn Asm.vfaddp_d(mut self, d int, n int)
    self.word(2121324544 + n * 32 + d)

## `movi vd.2d, #0`.
pub fn Asm.vzero(mut self, d int)
    self.word(1862329344 + d)

## `fadd`, `fsub`, `fmul`, `fdiv` on `v.4s` (four singles).
pub fn Asm.vop4(mut self, op str, d int, n int, m int)
    base := match op
        "fadd" => 1310774272
        "fsub" => 1319162880
        "fmul" => 1847647232
        _ => 1847655424
    self.word(rrr(base, d, n, m))

## `fcvtn2 vd.4s, vn.2d` and `fcvtl2 vd.2d, vn.4s`: the upper halves.
pub fn Asm.vcvtn2(mut self, d int, n int)
