## `dup vd.4s, vn.s[0]`.
pub fn Asm.vdup4(mut self, d int, n int)
    self.word(1308886016 + n * 32 + d)

## `fadd`, `fsub`, `fmul`, `fdiv` on singles (`s` registers).
pub fn Asm.fop_s(mut self, op str, d int, n int, m int)
    base := match op
        "fadd" => 505423872
        "fsub" => 505427968
        "fmul" => 505415680
        _ => 505419776
    self.word(rrr(base, d, n, m))

## `fmov xd, dn` and `fmov dd, xn`: the bits, unchanged.
pub fn Asm.fmov_xd(mut self, d int, n int)
    self.word(2657484800 + n * 32 + d)

pub fn Asm.fmov_dx(mut self, d int, n int)
