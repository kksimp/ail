## Vector kernels for the tensor runtime (ADR 0815): hand-assembled NEON
## loops that replace the functions of `compiler/rt/native/tensor.ail` named
## `rt.vec_*`, as `compiler/x64/kernels.ail` does there (their AIL bodies are
## the scalar definitions and the reference). Each works two doubles at a time
## and then element by element, with an IEEE operation per element and no
## fused multiply-add, so the result is bit for bit the scalar one; a
## non-zero `r` rounds every result to `f32`. They use x0..x11 and v0..v4
## only, which calls don't preserve (native-abi.md §1).
use codegen

## The kernels this file assembles.
pub fn is_kernel(name str) bool
    name == "rt.vec_axpy"
        or name == "rt.vec_zip"
        or name == "rt.vec_scal"
        or name == "rt.vec_mm"
        or name == "rt.vec_zip32"
        or name == "rt.vec_scal32"
        or name == "rt.vec_mm32"
        or name == "rt.vec_widen"
        or name == "rt.vec_narrow"
        or name == "rt.vec_sum16"
        or name == "rt.vec_sum16_32"
        or name == "rt.vec_exp"
        or is_aes_kernel(name)

## Add the kernel `name` to `img`.
pub fn gen_kernel(mut img codegen.Image, name str)
    mut a := new_asm()
    match name
        "rt.vec_axpy" => kernel_axpy(mut a)
        "rt.vec_zip" => kernel_zip(mut a)
        "rt.vec_mm" => kernel_mm(mut a)
        "rt.vec_zip32" => kernel_zip32(mut a)
        "rt.vec_scal32" => kernel_scal32(mut a)
        "rt.vec_mm32" => kernel_mm32(mut a)
        "rt.vec_widen" => kernel_widen(mut a)
        "rt.vec_narrow" => kernel_narrow(mut a)
        "rt.vec_sum16" => kernel_sum16(mut a, false)
        "rt.vec_sum16_32" => kernel_sum16(mut a, true)
        "rt.vec_exp" => kernel_exp(mut a)
        "rt.aes_hw_blocks" | "rt.aes_hw_ghash" => gen_aes_kernel(mut a, name)
        "rt.vec_scal" => kernel_scal(mut a)
        _ => unreachable("a64: unknown kernel {name}")
    a.resolve_labels()
    base := img.code.len()
    img.funcs[name] = base
    img.code.extend(a.code)

## Round the two doubles of v`x` to `f32` and back, through v3.
fn round_q(mut a Asm, flag int, x int)
    skip := a.label()
    a.cbz(flag, skip)
    a.vcvtn(3, x)
    a.vcvtl(x, 3)
    a.bind(skip)

## Round the double of d`x` to `f32` and back, through d3.
fn round_d(mut a Asm, flag int, x int)
    skip := a.label()
    a.cbz(flag, skip)
    a.fop1("fcvt_sd", 3, x)
    a.fop1("fcvt_ds", x, 3)
    a.bind(skip)

## x8 = n / 2 (pairs), x9 = n % 2.
fn split_count(mut a Asm, n int)
    a.shift_ri("lsr", 8, n, 1)
    a.shift_ri("lsl", 9, 8, 1)
    a.alu_rr("sub", 9, n, 9)

## `rt.vec_axpy(c, b, n, r; x)`: `c[i] = c[i] + x * b[i]` for `i < n`, the
## product and the sum each rounded. x0 = c, x1 = b, x2 = n, x3 = r, d0 = x.
fn kernel_axpy(mut a Asm)
    a.vdup(5, 0)
    split_count(mut a, 2)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.vop("fmul", 1, 1, 5)
    round_q(mut a, 3, 1)
    a.ldr_q_post(2, 0)
    a.alu_ri("sub", 0, 0, 16)
    a.vop("fadd", 2, 2, 1)
    round_q(mut a, 3, 2)
    a.str_q_post(2, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 1, 0)
    a.fop("fmul", 1, 1, 0)
    round_d(mut a, 3, 1)
    a.ldr_d(2, 0, 0)
    a.fop("fadd", 2, 2, 1)
    round_d(mut a, 3, 2)
    a.str_d(2, 0, 0)
    a.bind(done)
    a.ret()

## The four elementwise operations by code, as MIR names them.
fn zip_op(k int) str
    match k
        0 => "fadd"
        1 => "fsub"
        2 => "fmul"
        _ => "fdiv"

## One loop of `rt.vec_zip`: `out[i] = a[i] op b[i]`. x1 = out, x2 = a,
## x3 = b, x4 = n, x5 = r.
fn zip_loop(mut a Asm, op str)
    split_count(mut a, 4)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    a.ldr_q_post(2, 3)
    a.vop(op, 1, 1, 2)
    round_q(mut a, 5, 1)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 2, 0)
    a.ldr_d(2, 3, 0)
    a.fop(op, 1, 1, 2)
    round_d(mut a, 5, 1)
    a.str_d(1, 1, 0)
    a.bind(done)
    a.ret()

## `rt.vec_zip(op, out, a, b, n, r)`: x0 = op (0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn kernel_zip(mut a Asm)
    mut next := a.label()
    for k in 0..4
        next = a.label()
        a.cmp_ri(0, k)
        a.b_cond(NE, next)
        zip_loop(mut a, zip_op(k))
        a.bind(next)
    a.brk()

## One loop of `rt.vec_scal`: `out[i] = a[i] op s`, or `s op a[i]` when
## `left`. x1 = out, x2 = a, x3 = n, x4 = r; d0 and v5 hold s.
fn scal_loop(mut a Asm, op str, left bool)
    a.vdup(5, 0)
    split_count(mut a, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    if left
        a.vop(op, 1, 5, 1)
    else
        a.vop(op, 1, 1, 5)
    round_q(mut a, 4, 1)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 2, 0)
    if left
        a.fop(op, 1, 0, 1)
    else
        a.fop(op, 1, 1, 0)
    round_d(mut a, 4, 1)
    a.str_d(1, 1, 0)
    a.bind(done)
    a.ret()

## `rt.vec_scal(op, out, a, n, r, left; s)`: x0 = op, x5 = left.
fn kernel_scal(mut a Asm)
    mut next := a.label()
    for k in 0..4
        for l in 0..2
            next = a.label()
            a.cmp_ri(0, k)
            a.b_cond(NE, next)
            a.cmp_ri(5, l)
            a.b_cond(NE, next)
            scal_loop(mut a, zip_op(k), l == 1)
            a.bind(next)
    a.brk()

## `rt.vec_mm(c, a, b, n, k, r)`: one row of a matrix product. `c[j]` for
## `j < n` is the sum over `p < k`, in order from 0.0, of `a[p] * b[p * n + j]`,
## each product and sum rounded to `f32` when `r` is not 0 (no fused
## multiply-add), which is what `k` calls of `rt.vec_axpy` on a zeroed row give.
## Eight columns at a time keep their sums in registers across the `p` loop;
## the rest go one by one. x0 = c, x1 = a, x2 = b, x3 = n, x4 = k, x5 = r.
fn kernel_mm(mut a Asm)
    a.shift_ri("lsl", 12, 3, 3)
    a.mov_rr(7, 0)
    a.mov_rr(6, 3)
    a.mov_rr(10, 2)
    wide := a.label()
    a.cbz(5, wide)
    mm_body(mut a, true)
    a.bind(wide)
    mm_body(mut a, false)

## The column loops of `kernel_mm` for `f32` (`single`, sums as four singles
## per register) or `float` (two doubles per register).
fn mm_body(mut a Asm, single bool)
    blocks := a.label()
    tail := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(blocks)
    a.cmp_ri(6, 8)
    a.b_cond(LT, tail)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    ploop := a.label()
    pdone := a.label()
    for k in 0..4
        a.vzero(k)
    a.bind(ploop)
    a.cbz(9, pdone)
    a.ldr_d(16, 8, 0)
    a.alu_ri("add", 8, 8, 8)
    for k in 0..4
        a.ldr_q(4 + k, 11, 16 * k)
    if single
        a.fop1("fcvt_sd", 16, 16)
        a.vdup4(16, 16)
        a.vcvtn(4, 4)
        a.vcvtn2(4, 5)
        a.vcvtn(6, 6)
        a.vcvtn2(6, 7)
        a.vop4("fmul", 4, 4, 16)
        a.vop4("fmul", 6, 6, 16)
        a.vop4("fadd", 0, 0, 4)
        a.vop4("fadd", 1, 1, 6)
    else
        a.vdup(16, 16)
        for k in 0..4
            a.vop("fmul", 4 + k, 4 + k, 16)
        for k in 0..4
            a.vop("fadd", k, k, 4 + k)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(ploop)
    a.bind(pdone)
    if single
        a.vcvtl(4, 0)
        a.vcvtl2(5, 0)
        a.vcvtl(6, 1)
        a.vcvtl2(7, 1)
        for k in 0..4
            a.str_q(4 + k, 7, 16 * k)
    else
        for k in 0..4
            a.str_q(k, 7, 16 * k)
    a.alu_ri("add", 7, 7, 64)
    a.alu_ri("add", 10, 10, 64)
    a.alu_ri("sub", 6, 6, 8)
    a.b(blocks)
    a.bind(tail)
    a.cbz(6, done)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    a.vzero(0)
    sloop := a.label()
    sdone := a.label()
    a.bind(sloop)
    a.cbz(9, sdone)
    a.ldr_d(1, 8, 0)
    a.alu_ri("add", 8, 8, 8)
    a.ldr_d(2, 11, 0)
    if single
        a.fop1("fcvt_sd", 1, 1)
        a.fop1("fcvt_sd", 2, 2)
        a.fop_s("fmul", 1, 1, 2)
        a.fop_s("fadd", 0, 0, 1)
    else
        a.fop("fmul", 1, 1, 2)
        a.fop("fadd", 0, 0, 1)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(sloop)
    a.bind(sdone)
    if single
        a.fop1("fcvt_ds", 0, 0)
    a.str_d(0, 7, 0)
    a.alu_ri("add", 7, 7, 8)
    a.alu_ri("add", 10, 10, 8)
    a.alu_ri("sub", 6, 6, 1)
    a.b(tail)
    a.bind(done)
    a.ret()

# ---- packed `f32` kernels (ADR 0875): four singles at a time ----
#
# A single-precision operation is the correctly rounded `f32` result, which is
# what the scalar definitions in `tensor.ail` give. No fused multiply-add.

## x8 = n / 4 (quads), x9 = n % 4.
fn split_quads(mut a Asm, n int)
    a.shift_ri("lsr", 8, n, 2)
    a.shift_ri("lsl", 9, 8, 2)
    a.alu_rr("sub", 9, n, 9)

## One loop of `rt.vec_zip32`: `out[i] = a[i] op b[i]` on singles. x1 = out,
## x2 = a, x3 = b, x4 = n.
fn zip32_loop(mut a Asm, op str)
    split_quads(mut a, 4)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    a.ldr_q_post(2, 3)
    a.vop4(op, 1, 1, 2)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_s(1, 2, 0)
    a.ldr_s(2, 3, 0)
    a.fop_s(op, 1, 1, 2)
    a.str_s(1, 1, 0)
    a.alu_ri("add", 1, 1, 4)
    a.alu_ri("add", 2, 2, 4)
    a.alu_ri("add", 3, 3, 4)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_zip32(op, out, a, b, n)`: x0 = op (0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn kernel_zip32(mut a Asm)
    mut next := a.label()
    for k in 0..4
        next = a.label()
        a.cmp_ri(0, k)
        a.b_cond(NE, next)
        zip32_loop(mut a, zip_op(k))
        a.bind(next)
    a.brk()

## One loop of `rt.vec_scal32`: `out[i] = a[i] op s`, or `s op a[i]` when
## `left`, on singles. x1 = out, x2 = a, x3 = n; d0 holds s as a double.
fn scal32_loop(mut a Asm, op str, left bool)
    a.fop1("fcvt_sd", 0, 0)
    a.vdup4(5, 0)
    split_quads(mut a, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    if left
        a.vop4(op, 1, 5, 1)
    else
        a.vop4(op, 1, 1, 5)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_s(1, 2, 0)
    if left
        a.fop_s(op, 1, 0, 1)
    else
        a.fop_s(op, 1, 1, 0)
    a.str_s(1, 1, 0)
    a.alu_ri("add", 1, 1, 4)
    a.alu_ri("add", 2, 2, 4)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_scal32(op, out, a, n, left; s)`: x0 = op, x4 = left.
fn kernel_scal32(mut a Asm)
    mut next := a.label()
    for k in 0..4
        for l in 0..2
            next = a.label()
            a.cmp_ri(0, k)
            a.b_cond(NE, next)
            a.cmp_ri(4, l)
            a.b_cond(NE, next)
            scal32_loop(mut a, zip_op(k), l == 1)
            a.bind(next)
    a.brk()

## `rt.vec_widen(out, a, n)`: `out[i]` (a double) = `a[i]` (a single), four at
## a time. x0 = out, x1 = a, x2 = n.
fn kernel_widen(mut a Asm)
    split_quads(mut a, 2)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.vcvtl(2, 1)
    a.vcvtl2(3, 1)
    a.str_q_post(2, 0)
    a.str_q_post(3, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_s(1, 1, 0)
    a.fop1("fcvt_ds", 1, 1)
    a.str_d(1, 0, 0)
    a.alu_ri("add", 1, 1, 4)
    a.alu_ri("add", 0, 0, 8)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_narrow(out, a, n)`: `out[i]` (a single) = `a[i]` (a double) rounded,
## four at a time; `out` may be `a`. x0 = out, x1 = a, x2 = n.
fn kernel_narrow(mut a Asm)
    split_quads(mut a, 2)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.ldr_q_post(2, 1)
    a.vcvtn(3, 1)
    a.vcvtn2(3, 2)
    a.str_q_post(3, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 1, 0)
    a.fop1("fcvt_sd", 1, 1)
    a.str_s(1, 0, 0)
    a.alu_ri("add", 1, 1, 8)
    a.alu_ri("add", 0, 0, 4)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_mm32(c, a, b, n, k)`: one row of an `f32` matrix product. `c[j]` for
## `j < n` is the sum over `p < k`, in order from 0.0, of `a[p] * b[p * n + j]`,
## each product and sum rounded to `f32` (no fused multiply-add). Sixteen
## columns at a time keep their sums in four registers across the `p` loop,
## then four, then one. x0 = c, x1 = a, x2 = b, x3 = n, x4 = k.
fn kernel_mm32(mut a Asm)
    a.shift_ri("lsl", 12, 3, 2)
    a.mov_rr(7, 0)
    a.mov_rr(6, 3)
    a.mov_rr(10, 2)
    wide := a.label()
    quads := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(wide)
    a.cmp_ri(6, 16)
    a.b_cond(LT, quads)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    for k in 0..4
        a.vzero(k)
    ploop := a.label()
    pdone := a.label()
    a.bind(ploop)
    a.cbz(9, pdone)
    a.ldr_s(16, 8, 0)
    a.vdup4(16, 16)
    a.alu_ri("add", 8, 8, 4)
    for k in 0..4
        a.ldr_q(4 + k, 11, 16 * k)
    for k in 0..4
        a.vop4("fmul", 4 + k, 4 + k, 16)
    for k in 0..4
        a.vop4("fadd", k, k, 4 + k)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(ploop)
    a.bind(pdone)
    for k in 0..4
        a.str_q(k, 7, 16 * k)
    a.alu_ri("add", 7, 7, 64)
    a.alu_ri("add", 10, 10, 64)
    a.alu_ri("sub", 6, 6, 16)
    a.b(wide)
    a.bind(quads)
    a.cmp_ri(6, 4)
    a.b_cond(LT, scalar)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    a.vzero(0)
    qloop := a.label()
    qdone := a.label()
    a.bind(qloop)
    a.cbz(9, qdone)
    a.ldr_s(16, 8, 0)
    a.vdup4(16, 16)
    a.alu_ri("add", 8, 8, 4)
    a.ldr_q(4, 11, 0)
    a.vop4("fmul", 4, 4, 16)
    a.vop4("fadd", 0, 0, 4)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(qloop)
    a.bind(qdone)
    a.str_q(0, 7, 0)
    a.alu_ri("add", 7, 7, 16)
    a.alu_ri("add", 10, 10, 16)
    a.alu_ri("sub", 6, 6, 4)
    a.b(quads)
    a.bind(scalar)
    a.cbz(6, done)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    a.vzero(0)
    sloop := a.label()
    sdone := a.label()
    a.bind(sloop)
    a.cbz(9, sdone)
    a.ldr_s(1, 8, 0)
    a.alu_ri("add", 8, 8, 4)
    a.ldr_s(2, 11, 0)
    a.fop_s("fmul", 1, 1, 2)
    a.fop_s("fadd", 0, 0, 1)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(sloop)
    a.bind(sdone)
    a.str_s(0, 7, 0)
    a.alu_ri("add", 7, 7, 4)
    a.alu_ri("add", 10, 10, 4)
    a.alu_ri("sub", 6, 6, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_sum16(p, q, n, s)` and `rt.vec_sum16_32(p, n, s)`: the 16 partial
## sums of std.tensor.5 over the first `n` (a multiple of 16) elements of `p`,
## or of the products with `q` (doubles), halved down to four; the four sums go
## to `s[0..3]`. `vec_sum16_32` reads singles from `p` and widens them. Lane
## `i` of a block of 16 is element `i`, two lanes in each of v0..v7; the product
## and the sum are each rounded. x0 = p, x1 = q, x2 = n, x3 = s (`_32`: x0 = p,
## x1 = n, x2 = s).
fn kernel_sum16(mut a Asm, single bool)
    if single
        a.mov_rr(3, 2)
        a.mov_rr(2, 1)
    for k in 0..8
        a.vzero(k)
    plain := a.label()
    pl := a.label()
    dl := a.label()
    fin := a.label()
    if not single
        a.cbz(1, plain)
        a.bind(dl)
        a.cbz(2, fin)
        for k in 0..8
            a.ldr_q_post(16, 0)
            a.ldr_q_post(17, 1)
            a.vop("fmul", 16, 16, 17)
            a.vop("fadd", k, k, 16)
        a.alu_ri("sub", 2, 2, 16)
        a.b(dl)
    a.bind(plain)
    a.bind(pl)
    a.cbz(2, fin)
    for g in 0..4
        if single
            a.ldr_q_post(16, 0)
            a.vcvtl(17, 16)
            a.vcvtl2(18, 16)
            a.vop("fadd", 2 * g, 2 * g, 17)
            a.vop("fadd", 2 * g + 1, 2 * g + 1, 18)
        else
            for j in 0..2
                a.ldr_q_post(16, 0)
                a.vop("fadd", 2 * g + j, 2 * g + j, 16)
    a.alu_ri("sub", 2, 2, 16)
    a.b(pl)
    a.bind(fin)
    for k in 0..4
        a.vop("fadd", k, k, k + 4)
    a.vop("fadd", 0, 0, 2)
    a.vop("fadd", 1, 1, 3)
    a.str_q(0, 3, 0)
    a.str_q(1, 3, 16)
    a.ret()

# ---- `exp` of doubles, two at a time (ADR 0876) ----

## NEON words for `vins3` / `vins2` (base + registers): `fcmgt`, `fcmge`, `frintm`,
## `frintp`, `fabs`, `fneg`, `fcvtzs`, `bsl`, `bic`, `eor`, `add` on `v.2d` (`.16b`
## for the bit operations), `mov`, `shl #52`, `dup vd.2d, xn` and `mov xd, vn.d[i]`.
VX_FCMGT := 1860232192
VX_FCMGE := 1851843584
VX_FRINTM := 1315018752
VX_FRINTP := 1323403264
VX_FABS := 1323366400
VX_FNEG := 1860237312
VX_FCVTZS := 1323415552
VX_BSL := 1851792384
VX_BIC := 1314921472
VX_EOR := 1847598080
VX_ADD := 1323336704
VX_MOV := 1319115776
VX_SHL52 := 1333023744
VX_DUP := 1309150208
VX_UMOV0 := 1309162496
VX_UMOV1 := 1310211072

## The constants of `float_exp`, as doubles' bits: 700, 2^-28, ln2/2, 1.5 ln2, 1, 2,
## 0.5, 1/ln2, ln2 hi, ln2 lo, then the five polynomial coefficients.
VX_CONSTS := [
    4649368480934526976,
    4481081629233643520,
    4599914934686071279,
    4607361305248770931,
    4607182418800017408,
    4611686018427387904,
    4602678819172646912,
    4609176140021203710,
    4604418534311723008,
    4461442080421002358,
    4595172819793696062,
    -4654820494858601069,
    4544508515198557740,
    -4702957295668925455,
    4496342204012209360,
]

## `rt.vec_exp(out, a, n) int`: `out[i] = exp(a[i])` (`float_exp`, fdlibm, step for
## step, no fused multiply-add) for as many leading pairs as have both
## arguments in `|x| < 700`; the count done comes back, and the caller finishes
## the rest (a NaN or huge argument included) with `float_exp`. A lane with
## `|x| <= ln2/2` runs the general formula with `k = 0`, which is the same
## number as the short path (`lo = 0`, `r = hi = x`); one with `|x| < 2^-28`
## gets `1 + x`. x0 = out, x1 = a, x2 = n; v16..v31 hold the constants
## (v16 700, v17 2^-28, v18 ln2/2, v19 1.5 ln2, v20 1, v21 2, v22 0.5,
## v23 1/ln2, v24 ln2 hi, v25 ln2 lo, v26..v30 the coefficients, v31 the
## integer 1023), v0..v7 the work.
fn kernel_exp(mut a Asm)
    for k in 0..15
        a.mov_ri(9, VX_CONSTS[k])
        a.vins2(VX_DUP, 16 + k, 9)
    a.mov_ri(9, 1023)
    a.vins2(VX_DUP, 31, 9)
    a.mov_ri(3, 0)
    loop := a.label()
    cont := a.label()
    end := a.label()
    a.bind(loop)
    a.cmp_ri(2, 2)
    a.b_cond(LT, end)
    a.ldr_q(0, 1, 0)
    a.vins2(VX_FABS, 1, 0)
    # Both lanes in range, else stop here: the compare masks are all ones.
    a.vins3(VX_FCMGT, 2, 16, 1)
    a.vins2(VX_UMOV0, 9, 2)
    a.vins2(VX_UMOV1, 10, 2)
    a.alu_rr("and", 9, 9, 10)
    a.alu_ri("add", 9, 9, 1)
    a.cbz(9, cont)
    a.b(end)
    a.bind(cont)
    # s1 = x > 0 ? 1 : -1 (v5); v2 = the mask x > 0.
    a.vins3(VX_EOR, 3, 3, 3)
    a.vins3(VX_FCMGT, 2, 0, 3)
    a.vins3(VX_MOV, 5, 2, 2)
    a.vins2(VX_FNEG, 6, 20)
    a.vins3(VX_BSL, 5, 20, 6)
    # kf for |x| >= 1.5 ln2: floor(x/ln2 + 0.5) above zero, ceil(x/ln2 - 0.5) below (v2).
    a.vop("fmul", 3, 23, 0)
    a.vop("fadd", 4, 3, 22)
    a.vins2(VX_FRINTM, 4, 4)
    a.vop("fsub", 3, 3, 22)
    a.vins2(VX_FRINTP, 3, 3)
    a.vins3(VX_BSL, 2, 4, 3)
    # |x| < 1.5 ln2: kf = s1; then |x| <= ln2/2: kf = 0 (v3).
    a.vins3(VX_FCMGT, 3, 19, 1)
    a.vins3(VX_BSL, 3, 5, 2)
    a.vins3(VX_FCMGE, 4, 18, 1)
    a.vins3(VX_BIC, 3, 3, 4)
    # hi = x - kf ln2hi (v4), lo = kf ln2lo (v5), r = hi - lo (v6), t = r r (v7).
    a.vop("fmul", 4, 3, 24)
    a.vop("fsub", 4, 0, 4)
    a.vop("fmul", 5, 3, 25)
    a.vop("fsub", 6, 4, 5)
    a.vop("fmul", 7, 6, 6)
    # q = p1 + t (p2 + t (p3 + t (p4 + t p5))); c = r - t q (v1).
    a.vop("fmul", 1, 7, 30)
    a.vop("fadd", 1, 1, 29)
    a.vop("fmul", 1, 7, 1)
    a.vop("fadd", 1, 1, 28)
    a.vop("fmul", 1, 7, 1)
    a.vop("fadd", 1, 1, 27)
    a.vop("fmul", 1, 7, 1)
    a.vop("fadd", 1, 1, 26)
    a.vop("fmul", 1, 7, 1)
    a.vop("fsub", 1, 6, 1)
    # y = 1 - ((lo - r c / (2 - c)) - hi) (v2).
    a.vop("fmul", 2, 6, 1)
    a.vop("fsub", 7, 21, 1)
    a.vop("fdiv", 2, 2, 7)
    a.vop("fsub", 2, 5, 2)
    a.vop("fsub", 2, 2, 4)
    a.vop("fsub", 2, 20, 2)
    # y * 2^k: the exponent bits (k + 1023) << 52.
    a.vins2(VX_FCVTZS, 4, 3)
    a.vins3(VX_ADD, 4, 4, 31)
    a.vins2(VX_SHL52, 4, 4)
    a.vop("fmul", 2, 2, 4)
    # |x| < 2^-28: 1 + x.
    a.vins2(VX_FABS, 1, 0)
    a.vins3(VX_FCMGT, 3, 17, 1)
    a.vop("fadd", 5, 20, 0)
    a.vins3(VX_BSL, 3, 5, 2)
    a.str_q(3, 0, 0)
    a.alu_ri("add", 0, 0, 16)
    a.alu_ri("add", 1, 1, 16)
    a.alu_ri("add", 3, 3, 2)
    a.alu_ri("sub", 2, 2, 2)
    a.b(loop)
    a.bind(end)
    a.mov_rr(0, 3)
    a.ret()
