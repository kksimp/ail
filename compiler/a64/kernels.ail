## Vector kernels for the tensor runtime (ADR 0815): hand-assembled NEON
## loops that replace the functions of `compiler/rt/native/tensor.ail` named
## `rt.vec_*`, as `compiler/x64/kernels.ail` does there (their AIL bodies are
## the scalar definitions and the reference). Each works two doubles at a time
## and then element by element, with an IEEE operation per element and no
## fused multiply-add, so the result is bit for bit the scalar one; a
## non-zero `r` rounds every result to `f32`. They use x0..x11 and v0..v4
## only, which calls don't preserve (native-abi.md §1).
use codegen

## The kernels this file assembles.
pub fn is_kernel(name str) bool
    name == "rt.vec_axpy"
        or name == "rt.vec_axpyi"
        or name == "rt.vec_axpyf"
        or name == "rt.vec_escape"
        or name == "rt.vec_zip"
        or name == "rt.vec_scal"
        or name == "rt.vec_mm"
        or name == "rt.vec_zip32"
        or name == "rt.vec_scal32"
        or name == "rt.vec_mm32"
        or name == "rt.vec_widen"
        or name == "rt.vec_narrow"
        or name == "rt.vec_sum16"
        or name == "rt.vec_sum16_32"
        or name == "rt.vec_dot16"
        or name == "rt.vec_dot_i8"
        or name == "rt.vec_dot_u8i8"
        or is_aes_kernel(name)
        or is_ffi_kernel(name)

## Add the kernel `name` to `img`.
pub fn gen_kernel(mut img codegen.Image, name str)
    mut a := new_asm()
    match name
        "rt.vec_axpy" => kernel_axpy(mut a)
        "rt.vec_axpyi" => kernel_axpyi(mut a)
        "rt.vec_axpyf" => kernel_axpyf(mut a)
        "rt.vec_escape" => kernel_escape(mut a)
        "rt.vec_zip" => kernel_zip(mut a)
        "rt.vec_mm" => kernel_mm(mut a)
        "rt.vec_zip32" => kernel_zip32(mut a)
        "rt.vec_scal32" => kernel_scal32(mut a)
        "rt.vec_mm32" => kernel_mm32(mut a)
        "rt.vec_widen" => kernel_widen(mut a)
        "rt.vec_narrow" => kernel_narrow(mut a)
        "rt.vec_sum16" => kernel_sum16(mut a, false)
        "rt.vec_sum16_32" => kernel_sum16(mut a, true)
        "rt.vec_dot16" => kernel_dot16(mut a)
        "rt.vec_dot_i8" => kernel_dot_i8(mut a, false)
        "rt.vec_dot_u8i8" => kernel_dot_i8(mut a, true)
        "rt.aes_hw_blocks" | "rt.aes_hw_ghash" => gen_aes_kernel(mut a, name)
        "rt.vec_scal" => kernel_scal(mut a)
        "rt.ffi_ccall" | "rt.ffi_ccall_win" => kernel_ffi_ccall(mut a)
        _ => unreachable("a64: unknown kernel {name}")
    a.resolve_labels()
    base := img.code.len()
    img.funcs[name] = base
    img.code.extend(a.code)

## Round the two doubles of v`x` to `f32` and back, through v3.
fn round_q(mut a Asm, flag int, x int)
    skip := a.label()
    a.cbz(flag, skip)
    a.vcvtn(3, x)
    a.vcvtl(x, 3)
    a.bind(skip)

## Round the double of d`x` to `f32` and back, through d3.
fn round_d(mut a Asm, flag int, x int)
    skip := a.label()
    a.cbz(flag, skip)
    a.fop1("fcvt_sd", 3, x)
    a.fop1("fcvt_ds", x, 3)
    a.bind(skip)

## x8 = n / 2 (pairs), x9 = n % 2.
fn split_count(mut a Asm, n int)
    a.shift_ri("lsr", 8, n, 1)
    a.shift_ri("lsl", 9, 8, 1)
    a.alu_rr("sub", 9, n, 9)

## `rt.vec_axpy(c, b, n, r; x)`: `c[i] = c[i] + x * b[i]` for `i < n`, the
## product and the sum each rounded. x0 = c, x1 = b, x2 = n, x3 = r, d0 = x.
fn kernel_axpy(mut a Asm)
    a.vdup(5, 0)
    split_count(mut a, 2)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.vop("fmul", 1, 1, 5)
    round_q(mut a, 3, 1)
    a.ldr_q_post(2, 0)
    a.alu_ri("sub", 0, 0, 16)
    a.vop("fadd", 2, 2, 1)
    round_q(mut a, 3, 2)
    a.str_q_post(2, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 1, 0)
    a.fop("fmul", 1, 1, 0)
    round_d(mut a, 3, 1)
    a.ldr_d(2, 0, 0)
    a.fop("fadd", 2, 2, 1)
    round_d(mut a, 3, 2)
    a.str_d(2, 0, 0)
    a.bind(done)
    a.ret()

## `rt.vec_axpyi(c, b, n, x, keep)`: `c[i] = c[i] + x * b[i]` on `int`s, four a pass,
## then one at a time. The lanes are narrowed to 32 bits and multiplied to 64
## (`smull`), which is exact: the data-range guard (native.bce.12) kept `x` and
## `b[i]` within 2^20. x0 = c, x1 = b, x2 = n, x3 = x.
fn kernel_axpyi(mut a Asm)
    a.vdup4w(0, 3)
    a.shift_ri("lsr", 8, 2, 2)
    a.shift_ri("lsl", 9, 8, 2)
    a.alu_rr("sub", 9, 2, 9)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.ldr_q_post(2, 1)
    a.vxtn(1, 1)
    a.vxtn2(1, 2)
    a.vsmull(3, 1, 0)
    a.vsmull2(4, 1, 0)
    a.ldr_q(1, 0, 0)
    a.ldr_q(2, 0, 16)
    a.vadd2d(1, 1, 3)
    a.vadd2d(2, 2, 4)
    a.str_q_post(1, 0)
    a.str_q_post(2, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr(10, 1, 0)
    a.mul(10, 10, 3)
    a.ldr(11, 0, 0)
    a.alu_rr("add", 11, 11, 10)
    a.str(11, 0, 0)
    a.alu_ri("add", 0, 0, 8)
    a.alu_ri("add", 1, 1, 8)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_axpyf(c, b, n, keep; x)`: `c[i] = c[i] + x * b[i]` on doubles,
## four a pass in two registers, with `x * b[i]` and `c[i] + q` in that
## operand order (native.vec.1). x0 = c, x1 = b, x2 = n, d0 = x.
fn kernel_axpyf(mut a Asm)
    a.vdup(5, 0)
    a.shift_ri("lsr", 8, 2, 2)
    a.shift_ri("lsl", 9, 8, 2)
    a.alu_rr("sub", 9, 2, 9)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.ldr_q_post(2, 1)
    a.vop("fmul", 1, 5, 1)
    a.vop("fmul", 2, 5, 2)
    a.ldr_q(3, 0, 0)
    a.ldr_q(4, 0, 16)
    a.vop("fadd", 3, 3, 1)
    a.vop("fadd", 4, 4, 2)
    a.str_q_post(3, 0)
    a.str_q_post(4, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 1, 0)
    a.fop("fmul", 1, 0, 1)
    a.ldr_d(2, 0, 0)
    a.fop("fadd", 2, 2, 1)
    a.str_d(2, 0, 0)
    a.alu_ri("add", 0, 0, 8)
    a.alu_ri("add", 1, 1, 8)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## The four elementwise operations by code, as MIR names them.
fn zip_op(k int) str
    match k
        0 => "fadd"
        1 => "fsub"
        2 => "fmul"
        _ => "fdiv"

## One loop of `rt.vec_zip`: `out[i] = a[i] op b[i]`. x1 = out, x2 = a,
## x3 = b, x4 = n, x5 = r.
fn zip_loop(mut a Asm, op str)
    split_count(mut a, 4)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    a.ldr_q_post(2, 3)
    a.vop(op, 1, 1, 2)
    round_q(mut a, 5, 1)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 2, 0)
    a.ldr_d(2, 3, 0)
    a.fop(op, 1, 1, 2)
    round_d(mut a, 5, 1)
    a.str_d(1, 1, 0)
    a.bind(done)
    a.ret()

## `rt.vec_zip(op, out, a, b, n, r)`: x0 = op (0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn kernel_zip(mut a Asm)
    mut next := a.label()
    for k in 0..4
        next = a.label()
        a.cmp_ri(0, k)
        a.b_cond(NE, next)
        zip_loop(mut a, zip_op(k))
        a.bind(next)
    a.brk()

## One loop of `rt.vec_scal`: `out[i] = a[i] op s`, or `s op a[i]` when
## `left`. x1 = out, x2 = a, x3 = n, x4 = r; d0 and v5 hold s.
fn scal_loop(mut a Asm, op str, left bool)
    a.vdup(5, 0)
    split_count(mut a, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    if left
        a.vop(op, 1, 5, 1)
    else
        a.vop(op, 1, 1, 5)
    round_q(mut a, 4, 1)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 2, 0)
    if left
        a.fop(op, 1, 0, 1)
    else
        a.fop(op, 1, 1, 0)
    round_d(mut a, 4, 1)
    a.str_d(1, 1, 0)
    a.bind(done)
    a.ret()

## `rt.vec_scal(op, out, a, n, r, left; s)`: x0 = op, x5 = left.
fn kernel_scal(mut a Asm)
    mut next := a.label()
    for k in 0..4
        for l in 0..2
            next = a.label()
            a.cmp_ri(0, k)
            a.b_cond(NE, next)
            a.cmp_ri(5, l)
            a.b_cond(NE, next)
            scal_loop(mut a, zip_op(k), l == 1)
            a.bind(next)
    a.brk()

## `rt.vec_mm(c, a, b, n, k, r)`: one row of a matrix product. `c[j]` for
## `j < n` is the sum over `p < k`, in order from 0.0, of `a[p] * b[p * n + j]`,
## each product and sum rounded to `f32` when `r` is not 0 (no fused
## multiply-add), which is what `k` calls of `rt.vec_axpy` on a zeroed row give.
## Eight columns at a time keep their sums in registers across the `p` loop;
## the rest go one by one. x0 = c, x1 = a, x2 = b, x3 = n, x4 = k, x5 = r.
fn kernel_mm(mut a Asm)
    a.shift_ri("lsl", 12, 3, 3)
    a.mov_rr(7, 0)
    a.mov_rr(6, 3)
    a.mov_rr(10, 2)
    wide := a.label()
    a.cbz(5, wide)
    mm_body(mut a, true)
    a.bind(wide)
    mm_body(mut a, false)

## The column loops of `kernel_mm` for `f32` (`single`, sums as four singles
## per register) or `float` (two doubles per register).
fn mm_body(mut a Asm, single bool)
    blocks := a.label()
    tail := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(blocks)
    a.cmp_ri(6, 8)
    a.b_cond(LT, tail)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    ploop := a.label()
    pdone := a.label()
    for k in 0..4
        a.vzero(k)
    a.bind(ploop)
    a.cbz(9, pdone)
    a.ldr_d(16, 8, 0)
    a.alu_ri("add", 8, 8, 8)
    for k in 0..4
        a.ldr_q(4 + k, 11, 16 * k)
    if single
        a.fop1("fcvt_sd", 16, 16)
        a.vdup4(16, 16)
        a.vcvtn(4, 4)
        a.vcvtn2(4, 5)
        a.vcvtn(6, 6)
        a.vcvtn2(6, 7)
        a.vop4("fmul", 4, 4, 16)
        a.vop4("fmul", 6, 6, 16)
        a.vop4("fadd", 0, 0, 4)
        a.vop4("fadd", 1, 1, 6)
    else
        a.vdup(16, 16)
        for k in 0..4
            a.vop("fmul", 4 + k, 4 + k, 16)
        for k in 0..4
            a.vop("fadd", k, k, 4 + k)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(ploop)
    a.bind(pdone)
    if single
        a.vcvtl(4, 0)
        a.vcvtl2(5, 0)
        a.vcvtl(6, 1)
        a.vcvtl2(7, 1)
        for k in 0..4
            a.str_q(4 + k, 7, 16 * k)
    else
        for k in 0..4
            a.str_q(k, 7, 16 * k)
    a.alu_ri("add", 7, 7, 64)
    a.alu_ri("add", 10, 10, 64)
    a.alu_ri("sub", 6, 6, 8)
    a.b(blocks)
    a.bind(tail)
    a.cbz(6, done)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    a.vzero(0)
    sloop := a.label()
    sdone := a.label()
    a.bind(sloop)
    a.cbz(9, sdone)
    a.ldr_d(1, 8, 0)
    a.alu_ri("add", 8, 8, 8)
    a.ldr_d(2, 11, 0)
    if single
        a.fop1("fcvt_sd", 1, 1)
        a.fop1("fcvt_sd", 2, 2)
        a.fop_s("fmul", 1, 1, 2)
        a.fop_s("fadd", 0, 0, 1)
    else
        a.fop("fmul", 1, 1, 2)
        a.fop("fadd", 0, 0, 1)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(sloop)
    a.bind(sdone)
    if single
        a.fop1("fcvt_ds", 0, 0)
    a.str_d(0, 7, 0)
    a.alu_ri("add", 7, 7, 8)
    a.alu_ri("add", 10, 10, 8)
    a.alu_ri("sub", 6, 6, 1)
    a.b(tail)
    a.bind(done)
    a.ret()

# ---- packed `f32` kernels (ADR 0875): four singles at a time ----
#
# A single-precision operation is the correctly rounded `f32` result, which is
# what the scalar definitions in `tensor.ail` give. No fused multiply-add.

## x8 = n / 4 (quads), x9 = n % 4.
fn split_quads(mut a Asm, n int)
    a.shift_ri("lsr", 8, n, 2)
    a.shift_ri("lsl", 9, 8, 2)
    a.alu_rr("sub", 9, n, 9)

## One loop of `rt.vec_zip32`: `out[i] = a[i] op b[i]` on singles. x1 = out,
## x2 = a, x3 = b, x4 = n.
fn zip32_loop(mut a Asm, op str)
    split_quads(mut a, 4)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    a.ldr_q_post(2, 3)
    a.vop4(op, 1, 1, 2)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_s(1, 2, 0)
    a.ldr_s(2, 3, 0)
    a.fop_s(op, 1, 1, 2)
    a.str_s(1, 1, 0)
    a.alu_ri("add", 1, 1, 4)
    a.alu_ri("add", 2, 2, 4)
    a.alu_ri("add", 3, 3, 4)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_zip32(op, out, a, b, n)`: x0 = op (0 `+`, 1 `-`, 2 `*`, 3 `/`).
fn kernel_zip32(mut a Asm)
    mut next := a.label()
    for k in 0..4
        next = a.label()
        a.cmp_ri(0, k)
        a.b_cond(NE, next)
        zip32_loop(mut a, zip_op(k))
        a.bind(next)
    a.brk()

## One loop of `rt.vec_scal32`: `out[i] = a[i] op s`, or `s op a[i]` when
## `left`, on singles. x1 = out, x2 = a, x3 = n; d0 holds s as a double.
fn scal32_loop(mut a Asm, op str, left bool)
    a.fop1("fcvt_sd", 0, 0)
    a.vdup4(5, 0)
    split_quads(mut a, 3)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 2)
    if left
        a.vop4(op, 1, 5, 1)
    else
        a.vop4(op, 1, 1, 5)
    a.str_q_post(1, 1)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_s(1, 2, 0)
    if left
        a.fop_s(op, 1, 0, 1)
    else
        a.fop_s(op, 1, 1, 0)
    a.str_s(1, 1, 0)
    a.alu_ri("add", 1, 1, 4)
    a.alu_ri("add", 2, 2, 4)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_scal32(op, out, a, n, left; s)`: x0 = op, x4 = left.
fn kernel_scal32(mut a Asm)
    mut next := a.label()
    for k in 0..4
        for l in 0..2
            next = a.label()
            a.cmp_ri(0, k)
            a.b_cond(NE, next)
            a.cmp_ri(4, l)
            a.b_cond(NE, next)
            scal32_loop(mut a, zip_op(k), l == 1)
            a.bind(next)
    a.brk()

## `rt.vec_widen(out, a, n)`: `out[i]` (a double) = `a[i]` (a single), four at
## a time. x0 = out, x1 = a, x2 = n.
fn kernel_widen(mut a Asm)
    split_quads(mut a, 2)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.vcvtl(2, 1)
    a.vcvtl2(3, 1)
    a.str_q_post(2, 0)
    a.str_q_post(3, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_s(1, 1, 0)
    a.fop1("fcvt_ds", 1, 1)
    a.str_d(1, 0, 0)
    a.alu_ri("add", 1, 1, 4)
    a.alu_ri("add", 0, 0, 8)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_narrow(out, a, n)`: `out[i]` (a single) = `a[i]` (a double) rounded,
## four at a time; `out` may be `a`. x0 = out, x1 = a, x2 = n.
fn kernel_narrow(mut a Asm)
    split_quads(mut a, 2)
    vloop := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(vloop)
    a.cbz(8, scalar)
    a.ldr_q_post(1, 1)
    a.ldr_q_post(2, 1)
    a.vcvtn(3, 1)
    a.vcvtn2(3, 2)
    a.str_q_post(3, 0)
    a.alu_ri("sub", 8, 8, 1)
    a.b(vloop)
    a.bind(scalar)
    a.cbz(9, done)
    a.ldr_d(1, 1, 0)
    a.fop1("fcvt_sd", 1, 1)
    a.str_s(1, 0, 0)
    a.alu_ri("add", 1, 1, 8)
    a.alu_ri("add", 0, 0, 4)
    a.alu_ri("sub", 9, 9, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_mm32(c, a, b, n, k)`: one row of an `f32` matrix product. `c[j]` for
## `j < n` is the sum over `p < k`, in order from 0.0, of `a[p] * b[p * n + j]`,
## each product and sum rounded to `f32` (no fused multiply-add). Sixteen
## columns at a time keep their sums in four registers across the `p` loop,
## then four, then one. x0 = c, x1 = a, x2 = b, x3 = n, x4 = k.
fn kernel_mm32(mut a Asm)
    a.shift_ri("lsl", 12, 3, 2)
    a.mov_rr(7, 0)
    a.mov_rr(6, 3)
    a.mov_rr(10, 2)
    wide := a.label()
    quads := a.label()
    scalar := a.label()
    done := a.label()
    a.bind(wide)
    a.cmp_ri(6, 16)
    a.b_cond(LT, quads)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    for k in 0..4
        a.vzero(k)
    ploop := a.label()
    pdone := a.label()
    a.bind(ploop)
    a.cbz(9, pdone)
    a.ldr_s(16, 8, 0)
    a.vdup4(16, 16)
    a.alu_ri("add", 8, 8, 4)
    for k in 0..4
        a.ldr_q(4 + k, 11, 16 * k)
    for k in 0..4
        a.vop4("fmul", 4 + k, 4 + k, 16)
    for k in 0..4
        a.vop4("fadd", k, k, 4 + k)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(ploop)
    a.bind(pdone)
    for k in 0..4
        a.str_q(k, 7, 16 * k)
    a.alu_ri("add", 7, 7, 64)
    a.alu_ri("add", 10, 10, 64)
    a.alu_ri("sub", 6, 6, 16)
    a.b(wide)
    a.bind(quads)
    a.cmp_ri(6, 4)
    a.b_cond(LT, scalar)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    a.vzero(0)
    qloop := a.label()
    qdone := a.label()
    a.bind(qloop)
    a.cbz(9, qdone)
    a.ldr_s(16, 8, 0)
    a.vdup4(16, 16)
    a.alu_ri("add", 8, 8, 4)
    a.ldr_q(4, 11, 0)
    a.vop4("fmul", 4, 4, 16)
    a.vop4("fadd", 0, 0, 4)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(qloop)
    a.bind(qdone)
    a.str_q(0, 7, 0)
    a.alu_ri("add", 7, 7, 16)
    a.alu_ri("add", 10, 10, 16)
    a.alu_ri("sub", 6, 6, 4)
    a.b(quads)
    a.bind(scalar)
    a.cbz(6, done)
    a.mov_rr(8, 1)
    a.mov_rr(9, 4)
    a.mov_rr(11, 10)
    a.vzero(0)
    sloop := a.label()
    sdone := a.label()
    a.bind(sloop)
    a.cbz(9, sdone)
    a.ldr_s(1, 8, 0)
    a.alu_ri("add", 8, 8, 4)
    a.ldr_s(2, 11, 0)
    a.fop_s("fmul", 1, 1, 2)
    a.fop_s("fadd", 0, 0, 1)
    a.alu_rr("add", 11, 11, 12)
    a.alu_ri("sub", 9, 9, 1)
    a.b(sloop)
    a.bind(sdone)
    a.str_s(0, 7, 0)
    a.alu_ri("add", 7, 7, 4)
    a.alu_ri("add", 10, 10, 4)
    a.alu_ri("sub", 6, 6, 1)
    a.b(scalar)
    a.bind(done)
    a.ret()

## `rt.vec_sum16(p, q, n, s)` and `rt.vec_sum16_32(p, n, s)`: the 16 partial
## sums of std.tensor.5 over the first `n` (a multiple of 16) elements of `p`,
## or of the products with `q` (doubles), halved down to four; the four sums go
## to `s[0..3]`. `vec_sum16_32` reads singles from `p` and widens them. Lane
## `i` of a block of 16 is element `i`, two lanes in each of v0..v7; the product
## and the sum are each rounded. x0 = p, x1 = q, x2 = n, x3 = s (`_32`: x0 = p,
## x1 = n, x2 = s).
fn kernel_sum16(mut a Asm, single bool)
    if single
        a.mov_rr(3, 2)
        a.mov_rr(2, 1)
    for k in 0..8
        a.vzero(k)
    plain := a.label()
    pl := a.label()
    dl := a.label()
    fin := a.label()
    if not single
        a.cbz(1, plain)
        a.bind(dl)
        a.cbz(2, fin)
        for k in 0..8
            a.ldr_q_post(16, 0)
            a.ldr_q_post(17, 1)
            a.vop("fmul", 16, 16, 17)
            a.vop("fadd", k, k, 16)
        a.alu_ri("sub", 2, 2, 16)
        a.b(dl)
    a.bind(plain)
    a.bind(pl)
    a.cbz(2, fin)
    for g in 0..4
        if single
            a.ldr_q_post(16, 0)
            a.vcvtl(17, 16)
            a.vcvtl2(18, 16)
            a.vop("fadd", 2 * g, 2 * g, 17)
            a.vop("fadd", 2 * g + 1, 2 * g + 1, 18)
        else
            for j in 0..2
                a.ldr_q_post(16, 0)
                a.vop("fadd", 2 * g + j, 2 * g + j, 16)
    a.alu_ri("sub", 2, 2, 16)
    a.b(pl)
    a.bind(fin)
    for k in 0..4
        a.vop("fadd", k, k, k + 4)
    a.vop("fadd", 0, 0, 2)
    a.vop("fadd", 1, 1, 3)
    a.str_q(0, 3, 0)
    a.str_q(1, 3, 16)
    a.ret()

## `rt.vec_dot16(p, q, n) float` (type.coll.36, ADR 1316): the products of the `n` (a multiple of 16, not 0)
## doubles at `p` and `q` in std.tensor.5's 16 partial sums, halved down to one. Lane `i` of a block of 16 is
## product `i`, two lanes in each of v0..v7; each product and each sum is rounded (`fmul` then `fadd`, no
## `fmla`). x0 = p, x1 = q, x2 = n; the sum returns in d0.
fn kernel_dot16(mut a Asm)
    for k in 0..8
        a.vzero(k)
    top := a.label()
    a.bind(top)
    for k in 0..8
        a.ldr_q_post(16, 0)
        a.ldr_q_post(17, 1)
        a.vop("fmul", 16, 16, 17)
        a.vop("fadd", k, k, 16)
    a.alu_ri("sub", 2, 2, 16)
    a.cbnz(2, top)
    for k in 0..4
        a.vop("fadd", k, k, k + 4)
    a.vop("fadd", 0, 0, 2)
    a.vop("fadd", 1, 1, 3)
    a.vop("fadd", 0, 0, 1)
    a.faddp_d(0, 0)
    a.ret()

## `rt.vec_dot_i8(p, q, n) int` and `rt.vec_dot_u8i8(p, q, n) int` (type.bytes.19, ADR 1324): the sum of the
## products of the `n` (a multiple of 32, not 0, at most 2^18) bytes at `p` and `q`, `p` read as `i8` or as `u8`
## and `q` as `i8`. Sixteen bytes at a time are multiplied as halfwords and added into word lanes (`smull` and
## `sadalp` for two signed operands; `ushll`, `sshll` and `smlal` for an unsigned `p`): exact, and 2^18 bytes keep
## each word lane under 2^29. The four accumulators v0..v3 are added and summed as doublewords. x0 = p, x1 = q,
## x2 = n; the sum returns in x0.
fn kernel_dot_i8(mut a Asm, unsigned bool)
    for k in 0..4
        a.vzero(k)
    top := a.label()
    a.bind(top)
    for b in 0..2
        a.ldr_q_post(16, 0)
        a.ldr_q_post(17, 1)
        if unsigned
            a.vushll(20, 16)
            a.vushll_hi(21, 16)
            a.vsshll(22, 17)
            a.vsshll_hi(23, 17)
            a.vsmlal(2 * b, 20, 22)
            a.vsmlal_hi(2 * b + 1, 20, 22)
            a.vsmlal(2 * b, 21, 23)
            a.vsmlal_hi(2 * b + 1, 21, 23)
        else
            a.vsmull8(20, 16, 17)
            a.vsmull8_hi(21, 16, 17)
            a.vsadalp(2 * b, 20)
            a.vsadalp(2 * b + 1, 21)
    a.alu_ri("sub", 2, 2, 32)
    a.cbnz(2, top)
    a.vadd4s(0, 0, 1)
    a.vadd4s(2, 2, 3)
    a.vadd4s(0, 0, 2)
    a.vsaddlv4s(0, 0)
    a.fmov_xd(0, 0)
    a.ret()

## `rt.vec_escape(cr, out, n, max, keep; ci, thr)` (native.vec.2): escape counts
## of `z <- z * z + c`, eight points a pass in four independent groups of two
## (one group is a dependent chain of float latencies; four fill the pipes).
## x0 = cr, x1 = out, x2 = n, x3 = max, d0 = ci, d1 = thr; x4 (keep) is ignored.
## Group g keeps zr, zi and the count (a double) in ZR[g], ZR[g]+1, ZR[g]+2;
## v4..v7 and v29 are scratch; v16 ci, v17 thr, v18 2.0, v19 1.0. A lane has
## left when `zr*zr + zi*zi > thr` (false for a NaN); it keeps its zr, zi
## (frozen, so it stays gone) and count, so each lane runs the scalar loop's
## operations in order. Whole passes: the last may read and write up to seven
## elements past `n` (the caller leaves room).
fn kernel_escape(mut a Asm)
    zrs := [0, 20, 23, 26]
    a.vdup(16, 0)
    a.vdup(17, 1)
    a.mov_ri(9, 4611686018427387904)
    a.fmov_dx(18, 9)
    a.vdup(18, 18)
    a.mov_ri(9, 4607182418800017408)
    a.fmov_dx(19, 9)
    a.vdup(19, 19)
    group := a.label()
    step := a.label()
    store := a.label()
    done := a.label()
    a.bind(group)
    a.cmp_ri(2, 0)
    a.b_cond(LE, done)
    for g in 0..4
        for r in 0..3
            a.veor(zrs[g] + r, zrs[g] + r, zrs[g] + r)
    a.mov_rr(9, 3)
    a.bind(step)
    a.cmp_ri(9, 0)
    a.b_cond(LE, store)
    for g in 0..4
        zr := zrs[g]
        zi := zr + 1
        kk := zr + 2
        a.vop("fmul", 4, zr, zr)
        a.vop("fmul", 5, zi, zi)
        a.vop("fadd", 6, 4, 5)
        a.vfcmgt(6, 6, 17)
        a.vop("fsub", 4, 4, 5)
        a.ldr_q(5, 0, 16 * g)
        a.vop("fadd", 4, 4, 5)
        a.vop("fmul", 5, 18, zr)
        a.vop("fmul", 5, 5, zi)
        a.vop("fadd", 5, 5, 16)
        a.vbif(zr, 4, 6)
        a.vbif(zi, 5, 6)
        a.vbic(7, 19, 6)
        a.vop("fadd", kk, kk, 7)
        if g == 0
            a.vmov(29, 6)
        else
            a.vand(29, 29, 6)
    a.vaddp_d(7, 29)
    a.fmov_xd(10, 7)
    a.cmn_ri(10, 2)
    a.b_cond(EQ, store)
    a.alu_ri("sub", 9, 9, 1)
    a.b(step)
    a.bind(store)
    for g in 0..4
        a.vfcvtzs2d(4, zrs[g] + 2)
        a.str_q(4, 1, 16 * g)
    a.alu_ri("add", 0, 0, 64)
    a.alu_ri("add", 1, 1, 64)
    a.alu_ri("sub", 2, 2, 8)
    a.b(group)
    a.bind(done)
    a.ret()
