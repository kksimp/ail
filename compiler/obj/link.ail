## Resolving an image's relocations once the object writer has placed the
## code, the read-only data and the globals (ADR 0387).
use codegen

## The code with every relocation patched, for code at address `code`,
## data at `data` and the globals at `bss`.
pub fn link(img codegen.Image, code int, data int, bss int) List[u8]
    mut out := img.code
    for r in img.relocs
        patch(mut out, r, address(img, r.sym, code, data, bss), code + r.at)
    out

## Patch relocation `r` in `out`: `to` is the symbol's address and `pc` the
## address of the patched word, in the same address space (an RVA works for
## a PE image, whose base is page aligned). Shared by every object writer
## (ADR 0968).
pub fn patch(mut out List[u8], r codegen.Reloc, to int, pc int)
    mut w := read32(out, r.at)
    match r.kind
        "rel32" => w = to + signed32(w) - (pc + 4 + r.tail)
        "b26" => w = w.bit_or((to - pc).shr(2).bit_and(67108863))
        "adrp" =>
            pages := to.shr(12) - pc.shr(12)
            w = w.bit_or(pages.bit_and(3).shl(29)).bit_or(pages.shr(2).bit_and(524287).shl(5))
        "add12" => w = w.bit_or(to.bit_and(4095).shl(10))
        _ => unreachable("unknown relocation {r.kind}")
    for i in 0..4
        out[r.at + i] = w.shr(8 * i).bit_and(255).to_u8()

## The address of a symbol.
fn address(img codegen.Image, sym str, code int, data int, bss int) int
    if sym == "globals"
        return bss
    if sym.starts_with("imp:")
        k := img.imports.index_of(sym.replace("imp:", "")) else unreachable("no import {sym}")
        return bss + 8 * (img.globals + k)
    if sym.starts_with("d:")
        return data + (img.data_syms.get(sym) else unreachable("no data {sym}"))
    code + (img.funcs.get(sym) else unreachable("no function {sym}"))

fn read32(bytes List[u8], at int) int
    mut v := 0
    for i in 0..4
        v = v.bit_or(bytes[at + i].to_int().shl(8 * i))
    v

fn signed32(v int) int
    if v >= 2147483648 then v - 4294967296 else v

pub fn align_up(n int, a int) int
    (n + a - 1) / a * a

## `v` in `n` little-endian bytes.
pub fn put(mut out List[u8], v int, n int)
    for i in 0..n
        out.push(v.shr(8 * i).bit_and(255).to_u8())

## The bytes of a list of byte values, each 0 to 255.
pub fn bytes_of(xs List[int]) List[u8]
    mut out := List[u8]()
    for x in xs
        out.push(x.to_u8())
    out

## Bytes as lines of hexadecimal text, for the driver to write out until
## the standard library writes bytes.
pub fn hex(bytes List[u8]) str
    digits := "0123456789abcdef".chars()
    mut lines := List[str]()
    mut k := 0
    while k < bytes.len()
        mut row := List[char]()
        end := if k + 64 < bytes.len() then k + 64 else bytes.len()
        for i in k..end
            row.push(digits[bytes[i].to_int().shr(4)])
            row.push(digits[bytes[i].to_int().bit_and(15)])
        lines.push(row.join(""))
        k = end
    lines.join("\n")
