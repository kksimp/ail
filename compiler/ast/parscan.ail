## What a `for` body does, for the native parallel loop (conc.par.8, ADR 0601,
## ADR 0911): the scan the lowering and `ail check` share, so the check can say
## when a written `par for` will run in order. Field reads, `match`, `if x :=`,
## `else`, tuples, literals and comprehensions are taken: a chunk lowers them
## as the loop in order does, over values it reads and doesn't share (ADR 1143).

## What a loop body does, for deciding whether its chunks can run apart.
pub struct ParScan
    ## Every name the body mentions, and those it declares itself.
    pub names Set[str]
    pub decls Set[str]
    ## Reads of a name (not as the target of an assignment).
    pub reads Map[str, int]
    ## `x += e` statements outside nested loops, by name.
    pub adds Map[str, int]
    ## Names assigned in any other way.
    pub other Set[str]
    ## Names whose value a method call or `mut` argument may change.
    pub mutated Set[str]
    ## Operations one iteration costs: nested loops count 16 times, a `/` 16
    ## and a `%` 64, or 4 and 6 by an integer literal (conc.par.14, ADR 1157).
    pub work int
    pub mult int
    ## The body has a loop, whose bound the count does not know.
    pub looped bool
    ## The body calls a function or a method that may change its receiver.
    pub calls bool
    ## The body does something the count can't price: a method that may run
    ## long or allocate, a string built from parts, a list, map or set made
    ## (conc.par.14: such a loop is not "counted").
    pub opaque bool
    ## Functions the body calls by name, with the loop multiplier at each call
    ## (conc.par.14: a callee's own cost counts toward the loop's).
    pub callees List[str]
    pub callee_mult List[int]
    ## What the first construct the parallel version doesn't take is.
    pub why str
    ## A construct the parallel version doesn't take.
    pub bad bool

pub fn new_scan() ParScan
    ParScan(
        names: Set[str](),
        decls: Set[str](),
        reads: {},
        adds: {},
        other: Set[str](),
        mutated: Set[str](),
        work: 0,
        mult: 1,
        looped: false,
        calls: false,
        opaque: false,
        callees: [],
        callee_mult: [],
        why: "",
        bad: false,
    )

## Methods that only read their receiver.
READ_ONLY := [
    "len",
    "abs",
    "min",
    "max",
    "to_float",
    "to_int",
    "sqrt",
    "floor",
    "ceil",
    "bit_and",
    "bit_or",
    "bit_xor",
    "shl",
    "shr",
    "join",
    "chars",
]

## Read-only methods whose cost grows with the receiver (conc.par.14).
READ_LONG := ["join", "chars"]

## What a binary operator costs in operations (conc.par.14, ADR 1157): a
## division is about 16 additions and a remainder, nearly always of `int`s,
## about 64. By an integer literal the backend multiplies instead, so they
## count 4 and 6.
fn op_cost(o BinOp, rhs Expr) int
    by_lit := match rhs
        Int => true
        _ => false
    match o
        Div => if by_lit then 4 else 16
        Rem => if by_lit then 6 else 64
        _ => 1

fn is_add(op BinOp?) bool
    o := op else return false
    match o
        Add => true
        _ => false

fn root_name(e Expr) str?
    match e
        Name(n, _) => n
        Index(r, _, _) => root_name(r)
        _ => none

## The variable a place with a field in its path (`p.x`, `ps[i].xs`) belongs to.
fn field_root(e Expr) str?
    match e
        Name(n, _) => n
        Index(r, _, _) => field_root(r)
        Member(r, _, _) => field_root(r)
        _ => none

## The names a `match` arm's pattern binds.
fn pattern_binds(p Pattern, mut out Set[str])
    match p
        Variant(_, _, bindings, _) =>
            bs := bindings else return
            for b in bs
                if b.name != "_"
                    out.add(b.name)
        BindName(n, _) => out.add(n)
        TuplePat(ps, _) =>
            for q in ps
                pattern_binds(q, mut out)
        Nested(_, _, nfields, _) =>
            for q in nfields
                pattern_binds(q, mut out)
        StructPat(_, _, _, sfields, _) =>
            for q in sfields
                pattern_binds(q, mut out)
        Wildcard | Literal | Alt | Range => return

pub fn scan_block(mut sc ParScan, body List[Stmt], depth int)
    for s in body
        scan_stmt(mut sc, s, depth)

fn count_up(mut m Map[str, int], key str)
    mut n := 1
    if prev := m.get(key)
        n = prev + 1
    m[key] = n

## The body has a construct the parallel version doesn't take; the first is named.
fn refuse(mut sc ParScan, why str)
    if not sc.bad
        sc.why = why
    sc.bad = true

fn scan_stmt(mut sc ParScan, s Stmt, depth int)
    match s
        Let(name, _, _, value, otherwise) =>
            scan_expr(mut sc, value)
            if o := otherwise
                scan_else(mut sc, o, depth)
            sc.decls.add(name)
        LetTuple(names, value, _) =>
            scan_expr(mut sc, value)
            for b in names
                sc.decls.add(b.name)
        LocalFn(_) => refuse(mut sc, "a local function")
        Assign(target, op, value, _) =>
            # `x /= e` and `x %= e` divide like the binary operators.
            if o := op
                if op_cost(o, value) > 1
                    scan_cost(mut sc, op_cost(o, value))
            scan_expr(mut sc, value)
            match target
                Name(n, _) =>
                    sc.names.add(n)
                    if is_add(op) and depth == 0
                        count_up(mut sc.adds, n)
                    else
                        sc.other.add(n)
                Index(r, i, _) =>
                    scan_expr(mut sc, i)
                    scan_place(mut sc, r)
                # A field of a variable: the whole variable counts as assigned,
                # which a chunk may do only to its own locals.
                Member => scan_place(mut sc, target)
                _ => refuse(
                    mut sc,
                    "an assignment to a place that is not a name, a field or a list element",
                )
        While(cond, body, _) =>
            sc.mult = sc.mult * 16
            sc.looped = true
            scan_expr(mut sc, cond)
            scan_block(mut sc, body, depth + 1)
            sc.mult = sc.mult / 16
        For(_, var, _, _, iter, body, _) =>
            scan_expr(mut sc, iter)
            sc.decls.add(var)
            sc.mult = sc.mult * 16
            sc.looped = true
            scan_block(mut sc, body, depth + 1)
            sc.mult = sc.mult / 16
        Break(_, target) =>
            if depth == 0 or target != none
                refuse(mut sc, "`break` out of the loop")
        Continue(_, target) =>
            if target != none
                refuse(mut sc, "`continue` of an outer loop")
        Eval(e) => scan_expr(mut sc, e)
        Return(_, _) => refuse(mut sc, "`return`")
        Handle(_, _) | Defer(_, _) | With(_, _, _, _, _) | Unsafe(_, _) => refuse(
            mut sc,
            "`handle`, `defer`, `with` or `unsafe`",
        )
        Select(_, _) => refuse(mut sc, "`select`")

## The place an element is stored into: the indexes are read, the list is
## only named.
fn scan_place(mut sc ParScan, e Expr)
    match e
        Name(n, _) => sc.names.add(n)
        Index(r, i, _) =>
            scan_expr(mut sc, i)
            scan_place(mut sc, r)
        Member(r, _, _) =>
            n := field_root(r) else
                refuse(mut sc, "a write through a call result")
                return
            if n == "self"
                refuse(mut sc, "a write to a field of `self`")
                return
            scan_field_path(mut sc, r)
            sc.names.add(n)
            sc.other.add(n)
        _ => refuse(mut sc, "a write through a call result")

## The indexes on a field path are read.
fn scan_field_path(mut sc ParScan, e Expr)
    match e
        Index(r, i, _) =>
            scan_expr(mut sc, i)
            scan_field_path(mut sc, r)
        Member(r, _, _) => scan_field_path(mut sc, r)
        _ => return

## The `else` of `x := e else ...` or `e else ...`: a fallback value, or a
## block that leaves the iteration (`continue`; `break` and `return` refuse).
fn scan_else(mut sc ParScan, o Else, depth int)
    match o
        Fallback(x) => scan_expr(mut sc, x)
        Leave(st) => scan_stmt(mut sc, st, depth)
        Handler(err_name, body, _) =>
            if en := err_name
                sc.decls.add(en.name)
            scan_block(mut sc, body, depth)

## `n` operations per run of the innermost loop; the total stays far from `int`.
fn scan_cost(mut sc ParScan, n int)
    if sc.work < 1000000000
        sc.work += n * sc.mult

fn scan_expr(mut sc ParScan, e Expr)
    match e
        Int | Float | Bool | Str | Char | Bytes | NoneLit => return
        Name(n, _) =>
            sc.names.add(n)
            count_up(mut sc.reads, n)
        Interp(parts, _) =>
            sc.opaque = true
            for p in parts
                match p
                    Lit => continue
                    Hole(x) => scan_expr(mut sc, x)
                    Fmt(x, _) => scan_expr(mut sc, x)
        Call(callee, args, _) =>
            scan_cost(mut sc, 8)
            sc.calls = true
            match callee
                Name(fn_name, _) =>
                    if sc.callees.len() < 64
                        sc.callees.push(fn_name)
                        sc.callee_mult.push(sc.mult)
                    scan_args(mut sc, args)
                _ => refuse(
                    mut sc,
                    "a call of a method value or closure, or a constructor with a path",
                )
        Method(recv, name, _, args) =>
            scan_cost(mut sc, 2)
            if READ_LONG.contains(name) or not READ_ONLY.contains(name)
                sc.opaque = true
            if not READ_ONLY.contains(name)
                sc.calls = true
                if r := root_name(recv)
                    sc.mutated.add(r)
                elif fr := field_root(recv)
                    # A method that may change a field of `p` changes `p`.
                    if fr == "self"
                        refuse(mut sc, "a method call on a field of `self`")
                        return
                    sc.mutated.add(fr)
                    sc.other.add(fr)
                # A method on a temporary (`Vec(x: 1).unit()`) changes only the temporary.
            scan_expr(mut sc, recv)
            scan_args(mut sc, args)
        Index(r, i, _) =>
            scan_cost(mut sc, 2)
            scan_expr(mut sc, r)
            scan_expr(mut sc, i)
        Unary(o, x, _) =>
            match o
                Spawn => refuse(mut sc, "`spawn`")
                Neg | Not => scan_expr(mut sc, x)
        Binary(o, a, b, _) =>
            scan_cost(mut sc, op_cost(o, b))
            scan_expr(mut sc, a)
            scan_expr(mut sc, b)
        ListLit(items, _) =>
            sc.opaque = true
            for x in items
                scan_expr(mut sc, x)
        Range(a, b, _, _) =>
            if x := a
                scan_expr(mut sc, x)
            if y := b
                scan_expr(mut sc, y)
        If(branches, els, _, _) =>
            for b in branches
                match b.cond
                    Test(x) => scan_expr(mut sc, x)
                    Bind(n, _, x) =>
                        scan_expr(mut sc, x)
                        sc.decls.add(n)
                scan_block(mut sc, b.body, 1)
            if body := els
                scan_block(mut sc, body, 1)
        # A field read: of a local of the body, or of a captured value the
        # body doesn't write. `self.x` stays out: a chunk has no `self`.
        Member(recv, name, _) =>
            if (field_root(recv) else "") == "self"
                refuse(mut sc, "a field access `self.{name}` (name the field bare)")
                return
            scan_cost(mut sc, 1)
            scan_expr(mut sc, recv)
        Match(scrutinee, arms, _) =>
            scan_cost(mut sc, 2)
            scan_expr(mut sc, scrutinee)
            for a in arms
                pattern_binds(a.pat, mut sc.decls)
                if g := a.guard
                    scan_expr(mut sc, g)
                scan_block(mut sc, a.body, 1)
        # `?` leaves the function, which no chunk may do.
        Try => refuse(mut sc, "`?`, which leaves the function")
        OrElse(x, o, _) =>
            scan_cost(mut sc, 1)
            scan_expr(mut sc, x)
            scan_else(mut sc, o, 0)
        # Each clause is a nested loop (expr.comp.1); its variables are the comprehension's own.
        Comp(_, elem, value, clauses, _) =>
            sc.mult = sc.mult * 16
            sc.looped = true
            for c in clauses
                scan_expr(mut sc, c.iter)
                sc.decls.add(c.var)
                for b in c.unpack
                    sc.decls.add(b.name)
                if x := c.cond
                    scan_expr(mut sc, x)
            scan_cost(mut sc, 2)
            scan_expr(mut sc, elem)
            if v := value
                scan_expr(mut sc, v)
            sc.mult = sc.mult / 16
        TupleLit(items, _) =>
            scan_cost(mut sc, 2)
            for x in items
                scan_expr(mut sc, x)
        SetLit(items, _) =>
            scan_cost(mut sc, 4)
            sc.opaque = true
            for x in items
                scan_expr(mut sc, x)
        MapLit(entries, _) =>
            scan_cost(mut sc, 4)
            sc.opaque = true
            for en in entries
                scan_expr(mut sc, en.key)
                scan_expr(mut sc, en.value)
        # A key function `by: |x| e` is lowered inline; another function literal is a value.
        Closure(_, body, _) => scan_expr(mut sc, body)
        _ => refuse(
            mut sc,
            "an expression the native parallel loop doesn't take yet (a function literal, `ref`, or a typed name)",
        )

fn scan_args(mut sc ParScan, args List[Arg])
    for a in args
        if a.mutable
            if r := root_name(a.value)
                sc.mutated.add(r)
            else
                fr := field_root(a.value) else
                    refuse(mut sc, "a `mut` argument that is not a named place")
                    return
                if fr == "self"
                    refuse(mut sc, "a `mut` argument that is a field of `self`")
                    return
                sc.mutated.add(fr)
                sc.other.add(fr)
        scan_expr(mut sc, a.value)
