## Which parser fixes are certain (fix.auto.1, ADR 1130). A parser diagnostic
## carries one fix, so certainty is a property of its rule: every fix these rules
## make rewrites another language's spelling into the one AIL form that means the
## same (`else if` as `elif`, `&&` as `and`, `??` as `else`, `let x =` as `x :=`).
## The checker marks its certain fixes one by one (`Diag.with_sure_fix`).
## Left out on purpose: `lex.kw.1` but for its rename inside a function (`sure_syntax_fix`, ADR 1211), the string-escape rules
## (but for the two fixes of `sure_syntax_fix`) and every fix that adds code the author didn't write (`todo` arms). `mod.vis.1` here is `pub` on a
## local (removed) and `pub` on an item another module uses (added).
SURE_SYNTAX_RULES := [
    "gram.foreign.1",
    "gram.fn.2",
    "expr.op.1",
    "expr.bind.1",
    "expr.bind.2",
    "expr.bind.3",
    "expr.if.1",
    "expr.loop.8",
    "expr.match.1",
    "err.type.1",
    "mod.const.1",
    "mod.use.4",
    "mod.vis.1",
    "type.coll.4",
    "type.distinct.1",
]

## The fixes of `lex.str.2` and `lex.str.1` that are certain, told apart by their title (the rest of each rule's
## fixes are guesses): a `\{` that can only be text, because what follows it can't start an expression (the closing
## `"`, `\"`, a space), and the `\}` of an author who escaped both braces (ADR 1138).
pub LITERAL_BRACE_FIX := "escape the literal brace"
pub CLOSING_BRACE_FIX := "remove the backslash"
pub INTERP_QUOTE_FIX := "remove the backslashes before the quotes"

## The one certain fix of `lex.stmt.1`: `return a, b` as `return (a, b)` (ADR 1175).
pub RETURN_TUPLE_FIX := "return a tuple"

## The one certain fix of `expr.match.7` from the parser: a float literal in a pattern as a guard (ADR 1203).
pub FLOAT_GUARD_FIX := "test the float in a guard"

## The title mark of a `lex.kw.1` rename made inside a function, through every use of the word there, to a name no word
## of the file uses: the one certain fix of that rule (ADR 1211). A keyword declared in an item or an `impl` is a guess.
pub KEYWORD_RENAME_SCOPE := " in this function"

## Whether the parser's fix for `rule` is certain.
pub fn sure_syntax(rule str) bool
    SURE_SYNTAX_RULES.contains(rule)

## Whether the parser fix titled `title` for `rule` is certain: the rule's, or one of the two string fixes above.
pub fn sure_syntax_fix(rule str, title str) bool
    if rule == "lex.str.2"
        return title == LITERAL_BRACE_FIX or title == INTERP_QUOTE_FIX
    if rule == "lex.str.1"
        return title == CLOSING_BRACE_FIX
    if rule == "lex.stmt.1"
        return title == RETURN_TUPLE_FIX
    if rule == "expr.match.7"
        return title == FLOAT_GUARD_FIX
    if rule == "lex.kw.1"
        return title.contains(KEYWORD_RENAME_SCOPE)
    sure_syntax(rule)
