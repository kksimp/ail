## `ail new [--no-agent] NAME` (spec tool.new.1-4, ADRs 0903, 1046): a new package directory that
## runs and tests at once, with an agent kit (`AGENTS.md`, `.mcp.json`) unless `--no-agent`. NAME starts with a lowercase letter and holds
## lowercase letters, digits, `_` and `-`. An existing NAME is never touched.
## `ail new .` (tool.new.5) writes only the agent kit into the current project and overwrites nothing.

fn valid(name str) bool
    if name.len() == 0
        return false
    for i in 0..name.len()
        c := name.char_at(i) else return false
        ok := (c >= 'a' and c <= 'z') or (i > 0 and (c.is_digit() or c == '_' or c == '-'))
        if not ok
            return false
    true

## The lessons every agent session starts with (tool.new.3, ADR 1137). `ail mcp` sends the same lines as its
## `initialize` `instructions` (tools/ailmcp/ailmcp.ail `lessons`); the `agent_tools` suite fails if they differ.
fn lessons() List[str]
    [
        "- Read `ail card` once, all of it, before writing code. It names the spellings agents guess wrong (Habits from other languages) and the code that compiles but does not do what you meant (\"Compiles, but is not what you meant\"); no diagnostic reaches the second, so check it yourself.",
        "- `ail check`, `build`, `run` and `test` rewrite some wrong spellings in your files and print `fixed ...`. Read the file again before you edit it.",
    ]

## The agent kit (tool.new.3): at most 475 tokens, each tool with the situation it pays for.
fn agents_md() str
    [
        "# AGENTS.md",
        "",
        "AIL project: source is `.ail`, the CLI is `ail`. Use a tool when its line applies, not as a ritual.",
        "",
        lessons().join("\n"),
        "- Then look up, never guess: `ail card TOPIC`, `ail ask std WORDS` (std and methods), `ail ask how WORDS`.",
        "- A diagnostic `error[RULE]`: `ail check --fix FILE` applies the fixes it carries; `ail explain RULE` gives the meaning and a fix.",
        "- Before editing a function you did not write: `ail context FILE FN --budget 800` (callees, callers, types, tests), not the whole file.",
        "- Before changing a signature or a type: `ail ask FILE what calls FN` (also: who uses T). Never grep.",
        "- Two candidate fixes: `ail try FILE` checks and tests each on a copy.",
        "- A change across several functions in a program with `@test` functions: `ail task start FILE GOAL`, `ail task verify` (check, tests, what no test covers), `ail task finish` (writes `.ail/cert.json`).",
        "- `ail task verify` runs only the check and the `@test` functions: run the project's own build and test commands as well.",
        "- `ail fmt FILE` formats; `ail test FILE` runs the `@test` functions.",
        "- `.mcp.json` registers `ail mcp`: the same tools as MCP calls (`ail_ask`, `ail_check`, `ail_context`, `task_start`, ...), kept warm between calls.",
        "",
    ].join("\n")

## The MCP registration (tool.new.3): `ail mcp` on stdio.
fn mcp_json() str
    "\{\n  \"mcpServers\": \{\n    \"ail\": \{\n      \"command\": \"ail\",\n      \"args\": [\"mcp\"]\n    }\n  }\n}\n"

## Whether the current directory holds an AIL project: a `.ail` file or `ail.pkg` (tool.new.5).
fn is_project() bool
    names := fs.list_dir(".") else return false
    for n in names
        if n.ends_with(".ail") or n == "ail.pkg"
            return true
    false

## `ail new .` (tool.new.5): writes `AGENTS.md` and `.mcp.json` into the current directory unless they exist.
## An existing file is never changed or appended to: for `AGENTS.md` the block to add is printed instead.
fn here(agent bool) int
    if not agent
        io.eprint("error[tool.new.5]: `ail new .` only writes the agent kit, so `--no-agent` leaves nothing to do")
        return 2
    if not is_project()
        io.eprint("error[tool.new.5]: this directory holds no `.ail` file or ail.pkg; use `ail new NAME` for a new project")
        return 2
    mut wrote := List[str]()
    if fs.exists("AGENTS.md")
        print("AGENTS.md exists and was left alone; add this block to it:\n")
        print(agents_md())
    else
        fs.write_text("AGENTS.md", agents_md()) else err
            io.eprint("error: {err.kind}")
            return 1
        wrote.push("AGENTS.md")
    if fs.exists(".mcp.json")
        print(".mcp.json exists and was left alone; register `ail mcp` on stdio under mcpServers.ail:\n")
        print(mcp_json())
    else
        fs.write_text(".mcp.json", mcp_json()) else err
            io.eprint("error: {err.kind}")
            return 1
        wrote.push(".mcp.json")
    if wrote.len() > 0
        print("wrote {wrote.join(", ")}")
    0

## The capabilities a new project starts with (tool.new.6): files under the project, the environment,
## the clock and random numbers. No `net`, `net.serve`, `proc`, `ui` or `app`.
NEW_CAPS := "fs=.,env,clock,random"

## The `ail.pkg` of a new project (tool.new.1, tool.new.6).
fn manifest_text(name str) str
    [
        "ail 0.2",
        "# `caps` is what `ail run` lets this program reach: files under this directory, no network, no other",
        "# programs. A refused call names the entry to add here (`ail explain eff.allow.10`).",
        "package {name} caps {NEW_CAPS}",
        "",
    ].join("\n")

## The exit status of `ail new ARGS`.
pub fn command(args List[str]) int
    mut agent := true
    mut names := []
    for a in args
        if a == "--no-agent"
            agent = false
        else
            names.push(a)
    if names.len() != 1
        io.eprint("usage: ail new [--no-agent] NAME")
        return 2
    name := names[0]
    if name == "."
        return here(agent)
    # tool.new.1: the name is a package name and a directory name.
    if not valid(name)
        io.eprint("error[tool.new.1]: `{name}` isn't a package name; use lowercase letters, digits, `_` and `-`, starting with a letter")
        return 2
    # tool.new.1: nothing that exists is overwritten.
    if fs.exists(name)
        io.eprint("error[tool.new.1]: `{name}` already exists; choose another name")
        return 2
    fs.make_dir(name) else err
        io.eprint("error: {err.kind}")
        return 1
    # tool.new.6: a run reaches the files of the project and nothing else until the `caps` list says so.
    fs.write_text("{name}/ail.pkg", manifest_text(name)) else err
        io.eprint("error: {err.kind}")
        return 1
    fs.write_text(
        "{name}/main.ail",
        "## {name}: say what this program does.\n\n## The greeting for `who`.\nfn greet(who str) str\n    \"Hello, \{who}!\"\n\nfn main()\n    print(greet(\"world\"))\n\n@test fn greets()\n    assert_eq(greet(\"ail\"), \"Hello, ail!\")\n",
    ) else err
        io.eprint("error: {err.kind}")
        return 1
    # tool.new.3: the agent kit, unless `--no-agent` (tool.new.4).
    if agent
        fs.write_text("{name}/AGENTS.md", agents_md()) else err
            io.eprint("error: {err.kind}")
            return 1
        fs.write_text("{name}/.mcp.json", mcp_json()) else err
            io.eprint("error: {err.kind}")
            return 1
        print("created {name}/ (ail.pkg, main.ail, AGENTS.md, .mcp.json)")
    else
        print("created {name}/ (ail.pkg, main.ail)")
    print("next: ail run {name}    ail test {name}/main.ail")
    print("runs reach only files under {name}/ (no network, no other programs); `caps` in {name}/ail.pkg lists more")
    # tool.path.1: the kit's `.mcp.json` and `AGENTS.md` run a bare `ail`.
    if (proc.which("ail") else "") == ""
        io.eprint("hint: `ail` is not on your PATH, so the kit's commands won't run; `ail doctor --path` prints the line to add")
    0
