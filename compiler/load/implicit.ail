## Implicit `self` (trait.method.6-7, ADR 0141), as `77592931:bootstrap/src/implicit_self.rs`.
## Inside a method, the receiver's fields and methods are in scope by bare
## name. This pass rewrites `x` to `self.x` and `f(...)` to `self.f(...)`, and
## reports locals and parameters that would hide a member.
use ast
use syntax

## The prelude's functions, which a bare call could also mean.
PRELUDE_FNS := ["print", "unreachable", "assert", "assert_eq"]

## The members of one type: its field names and its method names.
struct Members
    owner str
    fields Set[str]
    methods Set[str]

## What the pass changed: the program with the rewritten functions, and its diagnostics.
pub struct SelfDone
    pub program ast.Program
    pub diags List[syntax.Diag]

struct SelfCx
    owner str
    fields Set[str]
    methods Set[str]
    free Set[str]
    diags List[syntax.Diag]

pub fn rewrite_self(prog ast.Program) SelfDone
    mut out := prog
    mut free := Set[str]()
    for f in prog.fns
        if f.owner == none and f.within == ast.Within.TopLevel
            free.add(f.name)
    for n in PRELUDE_FNS
        free.add(n)
    mut diags := List[syntax.Diag]()
    mut cache := Map[str, Members]()
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        if f.receiver == none or (f.body == none and f.contracts.len() == 0)
            continue
        m := members_of(prog, i, mut cache)
        if m.fields.len() == 0 and m.methods.len() == 0
            continue
        mut cx := SelfCx(
            owner: m.owner,
            fields: m.fields,
            methods: m.methods,
            free: free,
            diags: diags,
        )
        for p in f.params
            cx.declare(p.name, p.pos)
        mut fixed := f
        mut contracts := List[ast.Contract]()
        for c in f.contracts
            mut nc := c
            nc.cond = cx.expr(c.cond)
            mut olds := List[ast.Old]()
            for o in c.olds
                olds.push(ast.Old(name: o.name, value: cx.expr(o.value)))
            nc.olds = olds
            contracts.push(nc)
        fixed.contracts = contracts
        if body := f.body
            fixed.body = cx.block(body)
        out.fns[i] = fixed
        diags = cx.diags
    # contract.inv.1: an invariant sees the struct's fields and methods.
    for k in 0..prog.structs.len()
        s := prog.structs[k]
        if s.invariants.len() == 0
            continue
        m := type_members(prog, s.name, mut cache)
        mut cx := SelfCx(
            owner: m.owner,
            fields: m.fields,
            methods: m.methods,
            free: free,
            diags: diags,
        )
        mut invariants := List[ast.Contract]()
        for c in s.invariants
            mut nc := c
            nc.cond = cx.expr(c.cond)
            invariants.push(nc)
        out.structs[k].invariants = invariants
        diags = cx.diags
    SelfDone(program: out, diags: diags)

## The names of the methods (functions with a receiver) among `idx`.
fn method_names(prog ast.Program, idx List[int]) List[str]
    [prog.fns[m].name for m in idx if prog.fns[m].receiver != none]

## The type (or trait) whose members method `i` sees.
fn members_of(prog ast.Program, i int, mut cache Map[str, Members]) Members
    f := prog.fns[i]
    ty := match f.within
        InTrait(t) =>
            mut ms := Set[str]()
            for n in method_names(prog, prog.traits[t].methods)
                ms.add(n)
            return Members(owner: prog.traits[t].name, fields: Set[str](), methods: ms)
        InImpl(k) => prog.impls[k].target.name
        TopLevel =>
            o := f.owner else
                return Members(owner: "", fields: Set[str](), methods: Set[str]())
            o.name
    type_members(prog, ty, mut cache)

## The field and method names of type `ty`, including the methods its traits provide.
fn type_members(prog ast.Program, ty str, mut cache Map[str, Members]) Members
    if hit := cache.get(ty)
        return hit
    mut fields := Set[str]()
    for s in prog.structs
        if s.name == ty
            for fd in s.fields
                fields.add(fd.name)
    mut methods := Set[str]()
    for g in prog.fns
        if g.receiver == none
            continue
        mine := match g.within
            TopLevel =>
                if o := g.owner then o.name == ty else false
            InImpl(k) => prog.impls[k].target.name == ty
            InTrait(_) => false
        if mine
            methods.add(g.name)
    for imp in prog.impls
        if imp.target.name != ty
            continue
        for t in prog.traits
            if t.name == imp.trait_name
                for n in method_names(prog, t.methods)
                    methods.add(n)
                break
    found := Members(owner: ty, fields: fields, methods: methods)
    cache[ty] = found
    found

## trait.method.7: a local or parameter can't take a field's name. (A method's
## name is fine: a method is only reached by a call.)
fn SelfCx.declare(mut self, name str, at ast.Pos)
    if not self.fields.contains(name)
        return
    self.diags.push(syntax.Diag(
        rule: "trait.method.7",
        pos: at,
        msg: "`{name}` is a field of `{self.owner}`, so a method's local can't have that name",
        fixed: false,
        help: "rename the local; inside the method, `{name}` already means `self.{name}`",
        fix: "",
        edits: [],
    ))

fn SelfCx.block(mut self, b List[ast.Stmt]) List[ast.Stmt]
    mut out := List[ast.Stmt]()
    for s in b
        out.push(self.stmt(s))
    out

fn SelfCx.stmt(mut self, s ast.Stmt) ast.Stmt
    match s
        Let(name, pos, mutable, value, otherwise) =>
            v := self.expr(value)
            mut o := none
            if x := otherwise
                o = self.otherwise(x)
            self.declare(name, pos)
            ast.Stmt.Let(name, pos, mutable, v, o)
        Assign(target, op, value, pos) =>
            t := self.expr(target)
            ast.Stmt.Assign(target: t, op: op, value: self.expr(value), pos: pos)
        While(cond, body, pos) =>
            c := self.expr(cond)
            ast.Stmt.While(c, self.block(body), pos)
        For(is_par, var, var_pos, mutable, iter, body, pos) =>
            it := self.expr(iter)
            self.declare(var, var_pos)
            ast.Stmt.For(is_par, var, var_pos, mutable, it, self.block(body), pos)
        With(mutex, var, var_pos, body, pos) =>
            mx := self.expr(mutex)
            self.declare(var, var_pos)
            ast.Stmt.With(mx, var, var_pos, self.block(body), pos)
        Unsafe(body, pos) => ast.Stmt.Unsafe(self.block(body), pos)
        Return(value, pos) =>
            if v := value
                return ast.Stmt.Return(self.expr(v), pos)
            s
        Eval(value) => ast.Stmt.Eval(self.expr(value))
        LetTuple(names, value, pos) =>
            v := self.expr(value)
            for b in names
                self.declare(b.name, b.pos)
            ast.Stmt.LetTuple(names, v, pos)
        Handle(value, otherwise) =>
            v := self.expr(value)
            ast.Stmt.Handle(v, self.otherwise(otherwise))
        Defer(inner, pos) => ast.Stmt.Defer(self.stmt(inner), pos)
        Break(_) | Continue(_) => s

fn SelfCx.otherwise(mut self, o ast.Else) ast.Else
    match o
        Fallback(value) => ast.Else.Fallback(self.expr(value))
        Leave(inner) => ast.Else.Leave(self.stmt(inner))
        Handler(err, body, pos) =>
            if e := err
                self.declare(e.name, e.pos)
            ast.Else.Handler(err, self.block(body), pos)

fn SelfCx.pattern(mut self, p ast.Pattern)
    match p
        Variant(_, _, bindings, _) =>
            if bs := bindings
                for b in bs
                    self.declare(b.name, b.pos)
        Alt(alts, _) =>
            for a in alts
                self.pattern(a)
        TuplePat(elems, _) =>
            for a in elems
                self.pattern(a)
        BindName(name, pos) => self.declare(name, pos)
        Wildcard(_) | Literal(_, _) | Range(_, _, _, _) => 0

fn SelfCx.exprs(mut self, xs List[ast.Expr]) List[ast.Expr]
    mut out := List[ast.Expr]()
    for x in xs
        out.push(self.expr(x))
    out

fn SelfCx.args(mut self, args List[ast.Arg]) List[ast.Arg]
    mut out := List[ast.Arg]()
    for a in args
        mut na := a
        na.value = self.expr(a.value)
        out.push(na)
    out

@allow("expr.match.3") fn SelfCx.opt(mut self, x ast.Expr?) ast.Expr?
    if v := x
        return self.expr(v)
    none

@allow("expr.match.3") fn SelfCx.expr(mut self, e ast.Expr) ast.Expr
    match e
        Name(n, pos) =>
            if self.fields.contains(n)
                return ast.Expr.Member(ast.Expr.Name("self", pos), n, pos)
            e
        Call(callee, args, pos) =>
            new_args := self.args(args)
            match callee
                Name(n, name_pos) =>
                    if not self.methods.contains(n)
                        return ast.Expr.Call(callee, new_args, pos)
                    if self.free.contains(n)
                        self.diags.push(syntax.Diag(
                            rule: "trait.method.7",
                            pos: pos,
                            msg: "`{n}` is both a method of `{self.owner}` and a function",
                            fixed: false,
                            help: "write `self.{n}(...)` for the method, or rename one of them",
                            fix: "",
                            edits: [],
                        ))
                        return ast.Expr.Call(callee, new_args, pos)
                    ast.Expr.Method(ast.Expr.Name("self", name_pos), n, name_pos, new_args)
                _ => ast.Expr.Call(callee: self.expr(callee), args: new_args, pos: pos)
        Interp(parts, pos) =>
            mut out := List[ast.InterpPart]()
            for p in parts
                match p
                    Lit(_) => out.push(p)
                    Hole(x) => out.push(ast.InterpPart.Hole(self.expr(x)))
                    Fmt(x, spec) => out.push(ast.InterpPart.Fmt(self.expr(x), spec))
            ast.Expr.Interp(out, pos)
        ListLit(items, pos) => ast.Expr.ListLit(self.exprs(items), pos)
        SetLit(items, pos) => ast.Expr.SetLit(self.exprs(items), pos)
        TupleLit(items, pos) => ast.Expr.TupleLit(self.exprs(items), pos)
        Comp(form, elem, value, clauses, pos) =>
            mut cs := List[ast.CompFor]()
            for c in clauses
                mut nc := c
                nc.iter = self.expr(c.iter)
                self.declare(c.var, c.var_pos)
                for b in c.unpack
                    self.declare(b.name, b.pos)
                nc.cond = self.opt(c.cond)
                cs.push(nc)
            el := self.expr(elem)
            ast.Expr.Comp(form, el, self.opt(value), cs, pos)
        MapLit(entries, pos) =>
            mut out := List[ast.MapEntry]()
            for en in entries
                k := self.expr(en.key)
                out.push(ast.MapEntry(key: k, value: self.expr(en.value)))
            ast.Expr.MapLit(out, pos)
        Method(recv, name, name_pos, args) =>
            r := self.expr(recv)
            mut out := List[ast.Arg]()
            for a in args
                # expr.key.2: a key function's parameter is a new local (the literal declares it).
                mut na := a
                na.value = self.expr(a.value)
                out.push(na)
            ast.Expr.Method(r, name, name_pos, out)
        Member(recv, name, name_pos) => ast.Expr.Member(self.expr(recv), name, name_pos)
        Index(recv, index, pos) =>
            r := self.expr(recv)
            ast.Expr.Index(recv: r, index: self.expr(index), pos: pos)
        Unary(op, operand, pos) => ast.Expr.Unary(op, self.expr(operand), pos)
        NewRef(value, pos) => ast.Expr.NewRef(self.expr(value), pos)
        # type.fn.4: a function literal's parameters are new locals.
        Closure(params, body, pos) =>
            for p in params
                self.declare(p.name, p.pos)
            ast.Expr.Closure(params, self.expr(body), pos)
        Binary(op, lhs, rhs, pos) =>
            l := self.expr(lhs)
            ast.Expr.Binary(op: op, lhs: l, rhs: self.expr(rhs), pos: pos)
        Range(lo, hi, inclusive, pos) =>
            l := self.opt(lo)
            ast.Expr.Range(lo: l, hi: self.opt(hi), inclusive: inclusive, pos: pos)
        If(branches, els, else_err, pos) =>
            mut bs := List[ast.Branch]()
            for b in branches
                mut cond := b.cond
                match b.cond
                    Test(c) => cond = ast.Cond.Test(self.expr(c))
                    Bind(name, bpos, value) =>
                        v := self.expr(value)
                        self.declare(name, bpos)
                        cond = ast.Cond.Bind(name, bpos, v)
                bs.push(ast.Branch(cond: cond, body: self.block(b.body)))
            if ee := else_err
                self.declare(ee.name, ee.pos)
            mut ne := none
            if b := els
                ne = self.block(b)
            ast.Expr.If(bs, ne, else_err, pos)
        Match(scrutinee, arms, pos) =>
            sc := self.expr(scrutinee)
            mut out := List[ast.Arm]()
            for arm in arms
                self.pattern(arm.pat)
                g := self.opt(arm.guard)
                out.push(ast.Arm(pat: arm.pat, guard: g, body: self.block(arm.body)))
            ast.Expr.Match(sc, out, pos)
        OrElse(value, otherwise, pos) =>
            v := self.expr(value)
            ast.Expr.OrElse(v, self.otherwise(otherwise), pos)
        Try(inner, context, pos) =>
            i := self.expr(inner)
            ast.Expr.Try(i, self.opt(context), pos)
        Str(_, _) | Bytes(_, _) | Int(_, _) | Float(_, _) | Char(_, _) | Bool(_, _) | NoneLit(_) | Hole(_) | TypeArgs(
            _,
            _,
            _,
        ) => e
