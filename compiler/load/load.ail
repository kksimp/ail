JSON_NAMES := ["Json", "JsonMember", "JsonError", "parse_json", "parse_json_lines"]
JSON_DERIVE_NAMES := ["ToJson", "FromJson", "load_json", "print_json"]
ARGS_DERIVE_NAMES := ["FromArgs", "ArgsFailure"]
DERIVE_NAMES := ["TypeInfo", "TypeKind", "FieldInfo", "VariantInfo", "DeriveError"]

## Read the program at `arg`, a file or a package directory, with every module
## it imports. `std` is the directory of the standard modules in AIL.
pub fn load(arg str, std str) Loaded ! LoadError
    load_full(arg, std, Map[str, str](), Map[str, str]())

## `load`, with the texts the program's own derive generators wrote, by
## `TYPE.TRAIT` (ct.derive.1-4): the caller runs them natively and loads
## again. A text `@@err MESSAGE` is the generator's `DeriveError`, one
## `@@fx REASONS` a generator that isn't compile-time-safe (ct.derive.3).
pub fn load_derived(arg str, std str, user Map[str, str]) Loaded ! LoadError
    load_full(arg, std, user, Map[str, str]())

## `load` with the text of some files given instead of read from disk, by
## path (`ail edit` checks the edited state before anything is written).
pub fn load_with(arg str, std str, over Map[str, str]) Loaded ! LoadError
    load_full(arg, std, Map[str, str](), over)

## `load` with both: generator texts `user` and file texts `over`.
fn load_full(arg str, std str, user Map[str, str], over Map[str, str]) Loaded ! LoadError
    mut root := "."
    mut root_files := List[str]()
    if arg.ends_with(".ail")
        cut := arg.split("/")
        root = if cut.len() > 1 then cut[..cut.len() - 1].join("/") else "."
        root_files.push(arg)
    else
        root = arg
        root_files = ail_files(arg)
        if root_files.len() == 0
            return LoadError("{arg} has no .ail files (mod.unit.5)")
    load_package(root, root_files, std, user, over)

## The `.ail` files directly in `dir`, sorted (mod.unit.1).
fn ail_files(dir str) List[str]
    names := fs.list_dir(dir) else return []
    [path.join(dir, n) for n in names.sorted() if n.ends_with(".ail") and n != ".ail"]

fn load_package(
    root str,
    root_files List[str],
    std str,
    user Map[str, str],
    over Map[str, str],
) Loaded ! LoadError
    # The manifests come first: they say where each package is (mod.pkg.1-3).
    packages := pkg.read(root)
    mut files := List[ast.SourceFile]()
    mut tokens := List[syntax.Token]()
    mut sources := List[str]()
    mut diags := List[syntax.Diag]()
    mut seen := Set[str]()
    seen.add("")
    mut queue := [("", root_files)]
    # The modules made from C headers, by module name (ffi.decl.1).
    mut made := Map[str, str]()
    # std.use.4: the standard modules the files name without `use` (stduse.ail).
    mut implicit := List[ast.Use]()
    while queue.len() > 0
        item := queue.pop() else break
        module := item.0
        for p in item.1
            if (files.len() + 1) * FILE_LINES >= PRELUDE_LINE
                return LoadError("the program has more than {files.len()} files")
            shown := std_shown(p, std)
            mut src := ""
            if given := over.get(p)
                src = given
            elif made.contains(module)
                src = made[module]
            else
                src = fs.read_text(p) else return LoadError("can't read {shown}")
            base := files.len() * FILE_LINES
            lexed := syntax.lex(src)
            mut toks := shift(lexed.tokens, base)
            toks.pop()
            for d in lexed.diags
                diags.push(at_line(d, base))
            for imp in scan_uses(toks)
                if cheader.is_use(imp)
                    # A C header: its module is written from the header's own text (ffi.decl.1).
                    if not seen.contains(imp[0])
                        seen.add(imp[0])
                        if text := cheader.module_for(cheader.header_of(imp[0]), cheader.dir_of(p))
                            made[imp[0]] = text
                            queue.push((imp[0], ["<{imp[0]}>"]))
                    continue
                if imp[0] == "std"
                    dotted := imp.join(".")
                    if sf := std_file(dotted)
                        if not seen.contains(dotted)
                            seen.add(dotted)
                            queue.push((dotted, [path.join(std, sf)]))
                    continue
                t := packages.target(module, imp)
                if t.undeclared or seen.contains(t.module)
                    continue
                seen.add(t.module)
                found := ail_files(t.dir)
                if found.len() > 0
                    queue.push((t.module, found))
                elif not fs.exists("{t.dir}.ail")
                    # gram.rec.7 (ADR 1136): `use src.store` from the package root also loads `store`, the module
                    # its mod.use.4 fix names, so the rest of the program is checked with it.
                    if tail_parts := rooted_rest(packages, module, imp)
                        alt := packages.target(module, tail_parts)
                        if not seen.contains(alt.module)
                            seen.add(alt.module)
                            queue.push((alt.module, ail_files(alt.dir)))
            # The standard library's own files import what they use.
            if not module.starts_with("std.")
                rows := std_mentions(toks, std)
                for r in rows
                    named := IMPLICIT_STD[r]
                    if not seen.contains(named.1)
                        seen.add(named.1)
                        queue.push((named.1, [path.join(std, named.2)]))
                implicit.extend(implicit_uses(rows, base + 1))
            tokens.extend(toks)
            sources.push(src)
            files.push(ast.SourceFile(path: shown, module: module, base: base))
    # The end of the input sits just past the last file's last line, so an error at it
    # (an unclosed `fn broken(`) is reported there, not at the next file's base line.
    mut end_line := files.len() * FILE_LINES
    if files.len() > 0 and sources.len() == files.len()
        end_line = files[files.len() - 1].base + sources[sources.len() - 1].lines().len() + 1
    tokens.push(syntax.Token(tok: syntax.Tok.Eof, pos: ast.Pos(line: end_line, col: 1)))
    mut first := assemble(tokens, files, diags, std, packages, implicit)?
    first.texts = sources
    mut done := first
    if diags.len() == 0 and first.diags.len() == 0 and wanted(tokens)
        done = expand_derives(first, tokens, files, std, user, packages)?
    packages.finish(mut done.program, mut done.diags, mut done.texts)
    done

## The standard module `dotted` written in AIL: its file under the std directory.
fn std_file(dotted str) str?
    for m in STD_MODULES
        if m.0 == dotted
            return m.1
    none

## The name a file is shown under: `<std>/...` for a standard module.
fn std_shown(p str, std str) str
    prefix := "{std}/"
    if rest := p.strip_prefix(prefix)
        return "<std>/{rest}"
    p

fn at_line(d syntax.Diag, base int) syntax.Diag
    syntax.Diag(
        rule: d.rule,
        pos: ast.Pos(line: d.pos.line + base, col: d.pos.col),
        msg: d.msg,
        fixed: d.fixed,
        help: d.help,
        fix: d.fix,
        edits: d.edits,
    )

## The tokens with every line moved down by `base`, in interpolations too.
@allow("expr.match.3") fn shift(tokens List[syntax.Token], base int) List[syntax.Token]
    mut out := List[syntax.Token]()
    for t in tokens
        out.push(syntax.Token(
            tok: shift_tok(t.tok, base),
            pos: ast.Pos(line: t.pos.line + base, col: t.pos.col),
        ))
    out

@allow("expr.match.3") fn shift_tok(tok syntax.Tok, base int) syntax.Tok
    match tok
        Interp(parts) =>
            mut out := List[syntax.Part]()
            for p in parts
                match p
                    Lit(text) => out.push(syntax.Part.Lit(text))
                    Code(code) => out.push(syntax.Part.Code(shift(code, base)))
                    Fmt(code, spec) => out.push(syntax.Part.Fmt(shift(code, base), spec))
            syntax.Tok.Interp(out)
        _ => tok

## The module paths of a file's top-level `use` lines, to load them before
## parsing.
@allow("expr.match.3") fn scan_uses(tokens List[syntax.Token]) List[List[str]]
    mut out := List[List[str]]()
    mut depth := 0
    mut i := 0
    while i < tokens.len()
        match tokens[i].tok
            Indent => depth += 1
            Dedent => depth = if depth > 0 then depth - 1 else 0
            Kw(w) =>
                if w == "use" and depth == 0
                    mut parts := List[str]()
                    mut j := i + 1
                    while j < tokens.len()
                        match tokens[j].tok
                            Ident(name) => parts.push(name)
                            Sym(s) =>
                                if s != "."
                                    break
                            Str(h) =>
                                # `use c "header.h" as name` (ffi.decl.1).
                                if parts == ["c"]
                                    parts = [cheader.module_name(h)]
                                break
                            _ => break
                        j += 1
                    if parts.len() > 0
                        out.push(parts)
            _ => 0
        i += 1
    out

## Parse the tokens of `files` after the prelude.
@allow("expr.match.3")
fn assemble(
    tokens List[syntax.Token],
    files List[ast.SourceFile],
    diags List[syntax.Diag],
    std str,
    packages pkg.Packages,
    implicit List[ast.Use],
) Loaded ! LoadError
    mut all := prelude_tokens(tokens)
    all.extend(tokens)
    parsed := syntax.parse(all)
    mut prog := parsed.program
    # std.use.4: the implicit imports whose names the files' own imports leave free.
    kept := keep_implicit(implicit, prog.uses, FILE_LINES)
    prog.uses.extend(kept)
    add_std_types(mut prog, std)?
    prog.files = files
    mut found := diags
    found.extend(parsed.diags)
    resolve(prog, one_per_line(found), packages)

## contract.inh.1: an implementation's method inherits the contracts of the
## trait's method of the same name.
@allow("expr.match.3") fn link_contracts(prog ast.Program) ast.Program
    mut out := prog
    for i in 0..prog.fns.len()
        f := prog.fns[i]
        match f.within
            InImpl(k) =>
                for t in prog.traits
                    if t.name == prog.impls[k].trait_name
                        for m in t.methods
                            if prog.fns[m].name == f.name and prog.fns[m].contracts.len() > 0
                                out.fns[i].inherits = m
                                break
                        break
            _ => 0
    out

## The prelude's tokens, numbered from `PRELUDE_LINE`.
@allow("expr.match.3") fn prelude_tokens(tokens List[syntax.Token]) List[syntax.Token]
    lexed := syntax.lex(prelude_text(tokens))
    mut toks := shift(lexed.tokens, PRELUDE_LINE)
    toks.pop()
    toks

## Whether a token names one of `names` outside its own declaration.
@allow("expr.match.3") fn wants(tokens List[syntax.Token], names List[str]) bool
    mut named := false
    mut declared := false
    for i in 0..tokens.len()
        match tokens[i].tok
            Ident(n) =>
                if names.contains(n)
                    named = true
                    if i > 0
                        match tokens[i - 1].tok
                            Kw(w) =>
                                if ["fn", "struct", "enum", "trait"].contains(w)
                                    declared = true
                            _ => 0
            _ => 0
    named and not declared

## The always-read prelude, plus the optional modules the program names
## (json.prelude.1, ADR 0161): `json`, `jsonderive`, `default`, `argsderive`, `derive`,
## `grid` (ADR 0937), `heap` and `deque` (ADR 1086), `seq` (ADR 1073), and `fail` (ADR 1140).
@allow("expr.match.3") fn prelude_text(tokens List[syntax.Token]) str
    parts := split_modules(mir.PRELUDE_EMBED)
    want_json_derive := wants(tokens, JSON_DERIVE_NAMES)
    want_json := want_json_derive or wants(tokens, JSON_NAMES)
    mut at_derive := false
    for i in 1..tokens.len()
        match tokens[i].tok
            Ident(n) =>
                if n == "derive"
                    match tokens[i - 1].tok
                        Sym(s) =>
                            if s == "@"
                                at_derive = true
                        _ => 0
            _ => 0
    mut text := parts[0]
    if want_json
        text = "{text}{parts[1]}"
    if want_json_derive
        text = "{text}{parts[2]}"
    want_default := wants(tokens, ["Default"])
    if want_default
        text = "{text}{parts[3]}"
    want_args := wants(tokens, ARGS_DERIVE_NAMES)
    if want_args
        text = "{text}{parts[4]}"
    if want_json_derive or want_default or want_args or at_derive or wants(tokens, DERIVE_NAMES)
        text = "{text}{parts[5]}"
    if wants(tokens, ["Grid"])
        text = "{text}{parts[6]}"
    if wants(tokens, ["Heap"])
        text = "{text}{parts[7]}"
    if wants(tokens, ["Deque"])
        text = "{text}{parts[8]}"
    # expr.yield.1: `Seq[T]`, what a generator returns (ADR 1073).
    if wants(tokens, ["Seq"])
        text = "{text}{parts[9]}"
    # err.fail.1: the standard `Fail`, unless the program declares its own.
    if wants(tokens, ["Fail"])
        text = "{text}{parts[10]}"
    text

## The prelude cut at its `## @module` markers: core, json, jsonderive,
## default, argsderive, derive, grid, heap, deque, seq, fail. Each part after the first starts after its marker line.
fn split_modules(text str) List[str]
    mut parts := List[str]()
    mut cur := List[str]()
    for line in text.lines()
        if line.starts_with("## @module ")
            parts.push("{cur.join("\n")}\n")
            cur = []
        else
            cur.push(line)
    parts.push("{cur.join("\n")}\n")
    parts

## Add the standard modules' types to `prog`, each named `module.Type`
## (std.use.2).
fn add_std_types(mut prog ast.Program, std str) !LoadError
    src := fs.read_text(path.join(
        std,
        "types.ail",
    )) else return LoadError("can't read the standard types")
    lexed := syntax.lex(src)
    mut toks := shift(lexed.tokens, STD_TYPES_LINE)
    parsed := syntax.parse(toks)
    for s in parsed.program.structs
        mut d := s
        d.name = "{STD_TYPES[s.name]}.{s.name}"
        prog.structs.push(d)
    for e in parsed.program.enums
        mut d := e
        d.name = "{STD_TYPES[e.name]}.{e.name}"
        prog.enums.push(d)

## One syntax diagnostic per line (gram.rec.1, ADR 0263), as `one_per_line` in
## modules.rs: sorted by position, the first report on a line stays. String
## errors are independent of the rest and always stay. (The lexer and the
## parser report no warnings.)
fn one_per_line(diags List[syntax.Diag]) List[syntax.Diag]
    sorted := diags.sorted(by: |d| d.pos.line * 100000 + d.pos.col)
    mut kept := List[syntax.Diag]()
    for d in sorted
        same_line := kept.len() > 0 and kept[kept.len() - 1].pos.line == d.pos.line
        if d.rule.starts_with("lex.str.") or not same_line
            kept.push(d)
            continue
        prev := kept[kept.len() - 1]
        # Two reports of one mistake at one place (the lexer's with a fix, the parser's without): keep the fixed one.
        if d.fixed and not prev.fixed and d.pos == prev.pos
            kept[kept.len() - 1] = d
            continue
        if prev.fixed and d.fixed and explicit(prev.edits) and explicit(d.edits) and apart(
            prev.edits,
            d.edits,
        )
            mut joined := prev.edits
            joined.extend(d.edits)
            kept[kept.len() - 1].edits = joined
    kept

fn explicit(edits List[fix.Edit]) bool
    for e in edits
        if e.old != none or e.anchor != "exact"
            return false
    true

fn apart(xs List[fix.Edit], ys List[fix.Edit]) bool
    for x in xs
        for y in ys
            if overlaps(x, y)
                return false
    true

fn overlaps(a fix.Edit, b fix.Edit) bool
    ka := a.pos.line * 100000 + a.pos.col
    ea := a.end.line * 100000 + a.end.col
    kb := b.pos.line * 100000 + b.pos.col
    eb := b.end.line * 100000 + b.end.col
    ka <= eb and kb <= ea
