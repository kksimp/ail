## `ail effects FILE|DIR [--json]` (eff.infer.6): the program loaded and checked as
## `ail check` does, then each function's effects. A program with errors prints them
## on stderr and exits 2.
use ast
use check

pub fn effects_command(rest List[str], std str) int
    json := rest.contains("--json")
    paths := [a for a in rest if not a.starts_with("--")]
    if paths.len() != 1
        io.eprint("usage: ail effects [--json] FILE|DIR")
        return 2
    loaded := load(paths[0], std) else err
        io.eprint("error: {err.message}")
        return 2
    mut found := [shown_syntax(d) for d in loaded.diags]
    if loaded.diags.len() == 0
        found = [shown_check(d) for d in check.check_program(loaded.program).diags]
    if found.len() > 0
        io.eprint(report(loaded.program.files, loaded.texts, found, json))
        for d in found
            if not d.warning
                return 2
    if rest.contains("--parallel")
        print(parallel_report(loaded, paths[0], json).trim_end())
        return 0
    print(check.effects_report(loaded.program, json).trim_end())
    0

## `ail effects --parallel` (conc.par.6): one line per `for` loop in source order,
## `FILE:LINE:COL ID for VAR: VERDICT (RULE: REASON)`, with ` at FILE:LINE:COL` when the
## reason points at a write or exit; or one JSON object with `--json`.
fn parallel_report(loaded Loaded, path str, json bool) str
    rows := check.parallel_rows(loaded.program)
    files := loaded.program.files
    if json
        items := [
            "\{\"at\":{Json.Str(place(files, path, r.pos)).to_text()},\"fn\":{Json.Str(r.func).to_text()},\"var\":{Json.Str(r.var).to_text()},\"par\":{r.is_par},\"verdict\":\"{r.verdict}\",\"rule\":\"{r.rule}\",\"reason\":{Json.Str(r.reason).to_text()},\"reason_at\":{Json.Str(place(files, path, r.at)).to_text()}}"
            for r in rows
        ]
        return "\{\"ail_api\":1,\"loops\":[{items.join(",")}]}\n"
    mut out := ""
    for r in rows
        kw := if r.is_par then "par for" else "for"
        near := if r.at.line == r.pos.line and r.at.col == r.pos.col then "" else " at {place(files, path, r.at)}"
        out = "{out}{place(files, path, r.pos)} {r.func} {kw} {r.var}: {r.verdict} ({r.rule}: {r.reason}{near})\n"
    out

fn place(files List[ast.SourceFile], path str, p ast.Pos) str
    found := locate(files, p)
    file := if found.0 == "" then path else found.0
    "{file}:{found.1.line}:{found.1.col}"
