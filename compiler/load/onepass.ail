## Everything in one pass (gram.rec.4, ADR 1112, ADR 1136): when a file has syntax
## errors or an import fails, `ail check` still reports the checker's errors from the
## code they don't touch, so the mistakes of a program show up in one run.
##
## A declaration (a function, struct, enum, trait or impl) is a segment: the lines
## from one line that starts in column 1 to the next. A syntax error in a function's
## body breaks only its statement (the statement's lines and its indented block): the
## parser skips that statement and keeps the rest of the function (gram.rec.6). Any
## other syntax error breaks its whole segment. A checker error is dropped when it is
## on a broken statement's lines, or in its function and names a name the statement
## binds or judges the whole body (`FLOW_RULES`); inside a broken segment; or when it
## mentions a name a broken segment declares (that name is missing from the program,
## so uses of it would only repeat the syntax error).
##
## The loader's own errors (an import, a private item) leave the program whole: only
## the checker's errors on the same line are dropped. An import that resolves to
## nothing makes its name unknown: the declarations that use it are left out
## (gram.rec.7). Warnings are dropped: they judge the whole program, and a broken
## declaration changes it.
use ast

## The lines [first, end_row] (1-based, in the file's own numbering) of the segment
## around `at`, in `lines`.
fn segment_around(lines List[str], at int)(int, int)
    mut row_in := at
    if row_in > lines.len()
        row_in = lines.len()
    if row_in < 1
        row_in = 1
    mut first := row_in
    while first > 1 and not opens_segment(lines, first)
        first -= 1
    mut end_row := row_in
    while end_row < lines.len() and not opens_segment(lines, end_row + 1)
        end_row += 1
    (first, end_row)

## Does line `n` start a declaration: text in column 1 that is not a comment? An
## attribute line starts one unless the line above it is an attribute, and a
## declaration right under an attribute continues it.
fn opens_segment(lines List[str], n int) bool
    line := lines[n - 1]
    if line == "" or line.starts_with(" ") or line.starts_with("\t") or line.starts_with("#")
        return false
    if n > 1 and lines[n - 2].starts_with("@")
        return false
    true

## The words of one line.
fn words_of(line str) List[str]
    mut out := List[str]()
    mut cur := ""
    for c in line.chars()
        if c.is_alnum() or c == '_'
            cur = "{cur}{c}"
        else
            if cur != ""
                out.push(cur)
            cur = ""
    if cur != ""
        out.push(cur)
    out

DECL_WORDS := [
    "fn",
    "pub",
    "struct",
    "enum",
    "trait",
    "impl",
    "error",
    "unique",
    "unsafe",
    "extern",
    "type",
    "for",
    "export",
    "mut",
    "self",
    "use",
    "import",
    "const",
    "as",
]

## The names a broken declaration was meant to declare: the words of its header
## up to the first `(`, `=` or `:`, minus the keywords.
fn declared_names(header str) List[str]
    mut upto := header
    # Go's `fn (p P) name()`: the name follows the receiver.
    if upto.starts_with("fn (")
        if shut := upto.find(")")
            upto = "fn {upto.slice(shut + 1, upto.len())}"
    for mark in ["(", "=", ":", "["]
        if cut := upto.find(mark)
            upto = upto.slice(0, cut)
    mut out := List[str]()
    for w in words_of(upto)
        # Short names too (`fn f`, `const N`): a use of one would only repeat the syntax error.
        if not DECL_WORDS.contains(w)
            out.push(w)
    out

## The methods a broken `trait` or `impl` declares, so `x.into()` of a broken
## `trait Into[T]` is not reported again (trait.decl.3, checkbench, ADR 1111).
fn method_names(lines List[str], seg (int, int)) List[str]
    mut out := List[str]()
    head := lines[seg.0 - 1]
    if not head.starts_with("trait ") and not head.starts_with("impl ")
        return out
    for row in seg.0 + 1..seg.1 + 1
        body := lines[row - 1].trim()
        if body.starts_with("fn ")
            out.extend(declared_names(body))
    out

fn mentions(text str, names List[str]) bool
    for w in words_of(text)
        if names.contains(w)
            return true
    false

## The file of `program.files` that holds global line `line`, or -1.
fn file_of(files List[ast.SourceFile], line int) int
    if line >= PRELUDE_LINE
        return -1
    mut k := files.len()
    while k > 0
        k -= 1
        if files[k].base < line
            return k
    -1

## Checker rules that judge a function's whole body: a dropped statement can be
## what the body lacked (its value, a `wait`, a move on another path).
FLOW_RULES := ["expr.block.2", "own.move.4", "own.defer.3", "conc.task.5", "type.never.3"]

## A syntax error after which the tokens may not be the ones written (the block
## structure, a string, a bracket left open over many lines, lex.stmt.2): its
## whole segment is broken.
fn reshapes(rule str) bool
    rule.starts_with("lex.block.") or rule.starts_with("lex.str.") or rule == "lex.stmt.2"

## The loader's errors after which the name still resolves: a private item
## (mod.vis.1-2), an import below the declarations (mod.use.3), a second import of
## a name (mod.use.6).
fn leaves_whole(rule str) bool
    rule.starts_with("mod.vis.") or rule == "mod.use.3" or rule == "mod.use.6"

fn is_import(line str) bool
    line.starts_with("use ")
        or line.starts_with("pub use ")
        or line.starts_with("import ")
        or line.starts_with("from ")

## Whether a loader error on an import leaves the import bound: a name that
## still resolves, or `use src.store` from the package root, which the loader
## binds to the module its fix names (mod.unit.2, gram.rec.7).
fn keeps_import(d Shown) bool
    leaves_whole(d.rule) or (d.rule == "mod.use.4" and d.edits.len() > 0)

## The names an import line binds: the name after `as`, else the last part of the
## path. After a syntax error, every word of the line but the keywords.
fn import_names(line str, garbled bool) List[str]
    words := words_of(line)
    mut out := List[str]()
    if garbled
        for w in words
            if not DECL_WORDS.contains(w) and w != "std" and w != "from" and w != "c"
                out.push(w)
        return out
    for k in 0..words.len()
        if words[k] == "as" and k + 1 < words.len()
            out.push(words[k + 1])
            return out
    if words.len() > 0
        out.push(words[words.len() - 1])
    out

## The leading spaces of a line, a tab as four.
fn indent_of(line str) int
    mut n := 0
    for c in line.chars()
        if c == ' '
            n += 1
        elif c == '\t'
            n += 4
        else
            return n
    n

FN_LEAD := ["pub", "unsafe", "export", "extern", "c"]

## Does `line` start a function: `fn` among its first words, after only `pub`,
## `unsafe`, `export` or `extern c`, or after an attribute?
fn is_fn_header(line str) bool
    mut upto := line.trim()
    if upto.starts_with("#")
        return false
    if upto.starts_with("@")
        # `@allow("rule") fn name(..)`: the attribute's own brackets come first.
        return words_of(upto).contains("fn")
    if cut := upto.find("(")
        upto = upto.slice(0, cut)
    for w in words_of(upto)
        if w == "fn"
            return true
        if not FN_LEAD.contains(w)
            return false
    false

## The lines [header, end] of the function whose body holds line `own` of segment
## `seg`, when the function parsed (its header line is a function's position in
## `prog`, `base` lines on); none when `own` is the header itself or not in a body.
fn body_around(prog ast.Program, lines List[str], seg (int, int), own int, base int)(int, int)?
    if own < seg.0 or own > lines.len()
        return none
    mut hdr := own
    while hdr >= seg.0 and not is_fn_header(lines[hdr - 1])
        hdr -= 1
    if hdr < seg.0 or hdr == own
        return none
    if lines[own - 1].trim() != "" and indent_of(lines[own - 1]) <= indent_of(lines[hdr - 1])
        return none
    mut parsed := false
    for f in prog.fns
        if f.pos.line == hdr + base
            parsed = true
    if not parsed
        return none
    mut end_row := hdr
    while end_row < seg.1 and not is_fn_header(lines[end_row])
        end_row += 1
    (hdr, end_row)

CONT_ENDS := ["(", "[", "\{", ",", "+", "-", "*", "/", "%", "=", "|", " and", " or"]

CONT_STARTS := [")", "]", "}", ".", "and ", "or "]

## Does the line go on onto the next one (an open bracket, a comma, an operator)?
fn goes_on(line str) bool
    t := line.trim()
    for e in CONT_ENDS
        if t.ends_with(e)
            return true
    false

## Does the line continue the one above?
fn carries_on(line str) bool
    t := line.trim()
    for e in CONT_STARTS
        if t.starts_with(e)
            return true
    false

## The lines [first, end] of the statement around line `own`, no higher than
## `floor`: the lines it continues over, then its indented block.
fn statement_lines(lines List[str], own int, floor int)(int, int)
    mut first := own
    while first > floor and (goes_on(lines[first - 2]) or carries_on(lines[first - 1]))
        first -= 1
    lead := indent_of(lines[first - 1])
    mut end_row := own
    while end_row < lines.len()
        below := lines[end_row]
        if goes_on(lines[end_row - 1]) or carries_on(below) or below.trim() == "" or indent_of(below) > lead
            end_row += 1
        else
            break
    (first, end_row)

BIND_WORDS := ["let", "var", "const", "val", "auto"]

## The names the first line of a broken statement binds: left of `:=` (every name
## of a tuple, else the first), the loop names of a `for`, the name after another
## language's `let`, `var` or `const`.
fn bound_names(line str) List[str]
    mut t := line.trim()
    if s := t.strip_prefix("mut ")
        t = s
    words := words_of(t)
    mut out := List[str]()
    if words.len() == 0
        return out
    if BIND_WORDS.contains(words[0])
        if words.len() > 1
            out.push(words[1])
        return out
    if words[0] == "for"
        for k in 1..words.len()
            if words[k] == "in"
                break
            out.push(words[k])
        return out
    if cut := t.find(":=")
        left := words_of(t.slice(0, cut))
        if t.starts_with("(")
            out.extend(left)
        elif left.len() > 0
            out.push(left[0])
    out

## The words inside the backquoted spans of a message.
fn ticked_words(text str) List[str]
    mut out := List[str]()
    parts := text.split("`")
    mut k := 1
    while k < parts.len()
        out.extend(words_of(parts[k]))
        k += 2
    out

fn mentions_ticked(text str, names List[str]) bool
    if names.len() == 0
        return false
    for w in ticked_words(text)
        if names.contains(w)
            return true
    false

## The code of a line without a `#` comment that starts it.
fn code_of(line str) str
    if line.trim().starts_with("#")
        return ""
    line

## The segments of the program's own files (not the standard library's) that use a
## name in `gone`, an import that resolves to nothing, as global line ranges
## (gram.rec.7). A segment that uses one in its signature (a function's header
## line, any line of a type) is missing its types, so its own names are unknown
## too: the search runs again with them, up to four rounds.
fn tainted(loaded Loaded, gone List[str]) List[(int, int)]
    mut out := List[(int, int)]()
    if gone.len() == 0
        return out
    files := loaded.program.files
    mut texts := List[List[str]]()
    mut segs := List[(int, int, int)]()
    for fi in 0..files.len()
        if fi >= loaded.texts.len() or files[fi].path.starts_with("<std>") or files[fi].path.starts_with("gen:")
            texts.push(List[str]())
            continue
        lines := loaded.texts[fi].split("\n")
        texts.push(lines)
        mut row := 1
        while row <= lines.len()
            if opens_segment(lines, row) and not is_import(lines[row - 1])
                seg := segment_around(lines, row)
                segs.push((fi, seg.0, seg.1))
                row = seg.1 + 1
            else
                row += 1
    mut unknown := gone
    mut hit := [false for _ in segs]
    mut rounds := 0
    mut grew := true
    while grew and rounds < 4
        grew = false
        rounds += 1
        for k in 0..segs.len()
            if hit[k]
                continue
            s := segs[k]
            lines := texts[s.0]
            mut uses := false
            for row in s.1..s.2 + 1
                if mentions(code_of(lines[row - 1]), unknown)
                    uses = true
                    break
            if not uses
                continue
            hit[k] = true
            base := files[s.0].base
            out.push((s.1 + base, s.2 + base))
            head := lines[s.1 - 1]
            if not is_fn_header(head) or mentions(head, unknown)
                for n in declared_names(head)
                    if not unknown.contains(n)
                        unknown.push(n)
                        grew = true
    out

## The checker's errors in `semantic` that survive the errors in `broken` (both
## already shown; `broken` is `loaded.diags` as shown, the first `loaded.parsed` of
## them the lexer's and the parser's): see the head of this file. When an error
## can't be placed in a file, nothing is kept.
pub fn one_pass(loaded Loaded, semantic List[Shown], broken List[Shown]) List[Shown]
    files := loaded.program.files
    # Whole declarations, and the names they declared.
    mut ranges := List[(int, int)]()
    mut names := List[str]()
    # Broken statements, the functions that hold them, and the names they bind.
    mut stmts := List[(int, int)]()
    mut bodies := List[(int, int)]()
    mut bound := List[str]()
    # The lines of the loader's errors, and the imports that resolve to nothing.
    mut rows := Set[int]()
    mut gone := List[str]()
    for k in 0..broken.len()
        d := broken[k]
        garbled := k < loaded.parsed
        fi := file_of(files, d.pos.line)
        if fi < 0 or fi >= loaded.texts.len()
            return []
        lines := loaded.texts[fi].split("\n")
        base := files[fi].base
        own := d.pos.line - base
        seg := segment_around(lines, own)
        head := if seg.0 >= 1 and seg.0 <= lines.len() then lines[seg.0 - 1] else ""
        rows.add(d.pos.line)
        if is_import(head)
            # gram.rec.7: an import that binds nothing makes its name unknown, not the whole program.
            if garbled or not keeps_import(d)
                gone.extend(import_names(head, garbled))
            continue
        if not garbled
            if not leaves_whole(d.rule)
                ranges.push((seg.0 + base, seg.1 + base))
            continue
        if not reshapes(d.rule)
            if fnr := body_around(loaded.program, lines, seg, own, base)
                # gram.rec.6: the parser skipped this statement and kept the rest of the function.
                ext := statement_lines(lines, own, fnr.0 + 1)
                stmts.push((ext.0 + base, ext.1 + base))
                bodies.push((fnr.0 + base, fnr.1 + base))
                bound.extend(bound_names(lines[ext.0 - 1]))
                continue
        ranges.push((seg.0 + base, seg.1 + base))
        if seg.0 >= 1 and seg.0 <= lines.len()
            names.extend(declared_names(head))
            names.extend(method_names(lines, seg))
    ranges.extend(tainted(loaded, gone))
    mut kept := List[Shown]()
    for d in semantic
        help_text := d.help else ""
        text := "{d.message} {help_text}"
        at := d.pos.line
        # `mod.main.1` judges the whole program, like a warning: a broken declaration may be the missing `main`.
        if d.warning or d.rule == "mod.main.1" or rows.contains(at) or inside(ranges, at) or inside(stmts, at)
            continue
        if mentions(text, names) or mentions_ticked(text, gone)
            continue
        if inside(bodies, at) and (FLOW_RULES.contains(d.rule) or mentions_ticked(text, bound))
            continue
        mut touches := false
        for n in d.notes
            if inside(ranges, n.pos.line) or inside(stmts, n.pos.line) or mentions(n.message, names)
                touches = true
        if not touches
            kept.push(d)
    kept

fn inside(ranges List[(int, int)], line int) bool
    for r in ranges
        if line >= r.0 and line <= r.1
            return true
    false
