## `ail fix FILE [--dry-run] [--json]` (fix.apply.1-4, ADR 0203) with this
## checker as the diagnoser, in place of `fix.run_with_rust`. Each round's
## source is written beside FILE under a hidden name and loaded as `ail check`
## does, so a program's own modules resolve; the diagnostics come back with
## their settled fixes (ADR 0145) and FILE's name.
use check
use fixrun
use fix
use pkg

MAX_ROUNDS := 5

## A check of `src`, as the file `path` holds it.
fn diagnose(file str, src str, json bool, std str) fixrun.Diagnosis
    cut := file.split("/")
    dir := if cut.len() > 1 then "{cut[..cut.len() - 1].join("/")}/" else ""
    tmp := "{dir}.ail-fix-{time.now_ms()}.ail"
    fs.write_text(tmp, src) else err
        return fixrun.Diagnosis(found: [], report: "")
    loaded := load(tmp, std) else err
        fs.remove(tmp) else e
            return fixrun.Diagnosis(found: [], report: "error: can't remove {tmp}")
        return fixrun.Diagnosis(found: [], report: "error: {err.message}")
    mut shown := [shown_syntax(d) for d in loaded.diags]
    mut found := List[fixrun.Found]()
    lines := fix.split_lines(src)
    for d in loaded.diags
        mut fixes := List[fix.Fix]()
        if d.edits.len() > 0
            fixes = fix.settle_fixes(
                [fix.Fix(title: d.fix, edits: d.edits, sure: fix.sure_syntax_fix(d.rule, d.fix))],
                lines,
            )
        found.push(fixrun.Found(rule: d.rule, pos: d.pos, warning: false, fixes: fixes))
    if loaded.diags.len() == 0
        diags := check.check_program(loaded.program).diags
        shown = [shown_check(d) for d in diags]
        for d in diags
            if d.pos.line <= FILE_LINES
                found.push(fixrun.Found(
                    rule: d.rule,
                    pos: d.pos,
                    warning: d.warning,
                    fixes: fix.settle_fixes(d.fixes, lines),
                ))
    fs.remove(tmp) else e
        io.eprint("error: can't remove {tmp}")
    sorted := found.sorted(by: |f| (f.pos.line, f.pos.col))
    mut text := ""
    if shown.len() > 0
        text = report(loaded.program.files, loaded.texts, shown, json).replace(tmp, file)
    fixrun.Diagnosis(found: sorted, report: text)

pub fn fix_command(rest List[str], std str) int
    if rest.contains("--migrate")
        # mod.pkg.12: `ail fix --migrate [DIR]` reads the tree's language version and runs the migration steps.
        dirs := [a for a in rest if not a.starts_with("--")]
        if dirs.len() > 1 or rest.len() > dirs.len() + 1
            io.eprint("usage: ail fix --migrate [DIR]")
            return 2
        return pkg.migrate_command(if dirs.len() == 1 then dirs[0] else ".")
    mut r := fixrun.begin(rest)
    if r.code >= 0
        return r.code
    # fix.auto.1: first the certain fixes in the program's module files, which the rounds below can't
    # reach since they see only FILE; then FILE is read again and fixed by those rounds.
    if not rest.contains("--dry-run") and certain_rounds(r.path, std) > 0
        r = fixrun.begin(rest)
        if r.code >= 0
            return r.code
    json := rest.contains("--json")
    for _ in 0..MAX_ROUNDS
        if not fixrun.step(mut r, diagnose(r.path, r.src, json, std))
            break
    fixrun.canonicalize(mut r)
    fixrun.finish(mut r, diagnose(r.path, r.src, json, std))

## What `check --fix` did (fix.check.1): the rules of the fixes applied, in order, and
## the status (0, or 2 when the file can't be read or written).
pub struct Repair
    pub rules List[str]
    pub code int

## `fixed 3: expr.not.1, gram.fn.4 x2` (fix.check.1): the rules in first-seen order with a count when more than one.
pub fn fixed_line(rules List[str]) str
    mut order := List[str]()
    for r in rules
        if not order.contains(r)
            order.push(r)
    mut parts := List[str]()
    for r in order
        n := [x for x in rules if x == r].len()
        parts.push(if n > 1 then "{r} x{n}" else r)
    "fixed {rules.len()}: {parts.join(", ")}"

## Fixes `path` to a fixed point as `ail fix` does, writing it and printing nothing (fix.check.1).
pub fn repair(path str, std str) Repair
    mut r := fixrun.begin([path])
    if r.code >= 0
        return Repair(rules: [], code: r.code)
    for _ in 0..MAX_ROUNDS
        if not fixrun.step(mut r, diagnose(r.path, r.src, false, std))
            break
    fixrun.canonicalize(mut r)
    if r.rules.len() > 0
        fs.write_text(r.path, r.src) else err
            io.eprint("error: can't write {r.path}: {err.kind}")
            return Repair(rules: [], code: 2)
    Repair(rules: r.rules, code: 0)
