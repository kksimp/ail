## `ail header FILE|DIR [-o OUT.h]` (ffi.export.3): the C header of a program's
## `pub export c fn` functions, so the C side never writes a prototype by hand.
## The program is loaded and checked as `ail check` does; a program with
## errors prints them on stderr and exits 2.
use ast
use check

pub fn header_command(rest List[str], std str) int
    mut out_path := ""
    mut paths := List[str]()
    mut k := 0
    while k < rest.len()
        if rest[k] == "-o" and k + 1 < rest.len()
            out_path = rest[k + 1]
            k += 2
        else
            paths.push(rest[k])
            k += 1
    if paths.len() != 1
        io.eprint("usage: ail header FILE|DIR [-o OUT.h]")
        return 2
    loaded := load(paths[0], std) else err
        io.eprint("error: {err.message}")
        return 2
    mut found := [shown_syntax(d) for d in loaded.diags]
    if loaded.diags.len() == 0
        found = [shown_check(d) for d in check.check_program(loaded.program).diags]
    if found.len() > 0
        io.eprint(report(loaded.program.files, loaded.texts, found, false))
        for d in found
            if not d.warning
                return 2
    text := c_header(loaded.program, paths[0])
    if out_path == ""
        print(text.trim_end())
        return 0
    fs.write_text(out_path, text) else err
        io.eprint("error: can't write {out_path}")
        return 2
    0

## The header text for the exported functions of `prog`, in source order.
pub fn c_header(prog ast.Program, source str) str
    guard := guard_name(source)
    mut out := "/* Generated by `ail header {source}`. Do not edit. */\n"
    out = "{out}#ifndef {guard}\n#define {guard}\n\n#include <stdbool.h>\n#include <stdint.h>\n\n"
    out = "{out}#ifdef __cplusplus\nextern \"C\" \{\n#endif\n\n"
    for f in prog.fns
        if not exported(f)
            continue
        if d := f.doc
            for line in d.split("\n")
                out = "{out}/* {line.trim()} */\n"
        ret := if r := f.ret then c_type(r) else "void"
        mut ps := ["{c_type(p.ty)} {p.name}" for p in f.params]
        if ps.len() == 0
            ps = ["void"]
        out = "{out}{ret} {symbol(f)}({ps.join(", ")});\n"
    "{out}\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"

## Whether `f` is a `pub export c fn` (the parser's attribute `export c`).
fn exported(f ast.FnDecl) bool
    [a for a in f.attrs if a.name == "export c"].len() > 0

## The C symbol of an exported function: the string after `export c`, else the AIL name.
fn symbol(f ast.FnDecl) str
    for a in f.attrs
        if a.name == "export c"
            return a.arg else f.name
    f.name

## `a/b/my-lib.ail` becomes `MY_LIB_H`.
fn guard_name(source str) str
    base := source.split("/").last() else source
    stem := base.split(".")[0]
    mut s := ""
    for c in stem.chars()
        if c.is_alpha() or c.is_digit()
            s = "{s}{c.to_upper()}"
        else
            s = "{s}_"
    "{s}_H"

## ffi.map.1 in reverse: the C spelling of a type that has a C layout.
@allow("expr.match.3") fn c_type(t ast.TypeRef) str
    match t.shape
        Named(name, _) => c_scalar(name)
        PtrTo(inner) => c_pointee(inner)
        _ => "void"

@allow("expr.match.3") fn c_pointee(t ast.TypeRef) str
    match t.shape
        Named(name, _) =>
            s := c_scalar(name)
            if s == "void" then "void *" else "{s} *"
        PtrTo(inner) => "{c_pointee(inner)}*"
        _ => "void *"

fn c_scalar(name str) str
    match name
        "int" => "int64_t"
        "float" => "double"
        "f32" => "float"
        "bool" => "bool"
        "i8" => "int8_t"
        "i16" => "int16_t"
        "i32" => "int32_t"
        "i64" => "int64_t"
        "u8" => "uint8_t"
        "u16" => "uint16_t"
        "u32" => "uint32_t"
        "u64" => "uint64_t"
        _ => "void"
