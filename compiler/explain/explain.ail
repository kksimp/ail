## `ail explain [RULE | FAMILY | WORD] [--json]` in AIL (explain.list.1, explain.show.1,
## explain.cover.4, explain.find.1; ADRs 0146, 0336, 0670, 0746), ported from
## `77592931:bootstrap/src/explain.rs` and byte-identical to it: a spec rule's text, the
## ADRs it cites and the nearest example. The Rust one embeds the specification
## at build time; this one reads `docs/spec/*.md`, the ADR index and the
## fixable list from the repository, `AIL_ROOT` or the parent of `AIL_COMPILER`
## (the same rule `ail build` uses for the runtime).
## `tools/explain/parity.sh` checks it against the goldens frozen from the Rust one.

## The code for an implementation limit; not a rule ID (spec README, rule 6).
UNSUPPORTED := "bootstrap.unsupported"
UNSUPPORTED_TEXT := "Not a spec rule: the bootstrap doesn't implement this construct yet. The program may be valid AIL. The message names the construct and the spec rule that defines it; run `ail explain` on that rule for the full text. Rewrite the code without the construct, or wait for the bootstrap to support it. (spec README, Rule IDs, item 6; ADR 0023)"

## The rule whose explanation lists the constructs outside the native subset (ADR 0746).
SUBSET_RULE := "native.subset.1"

## Longest rule text printed in the text form, in characters.
TEXT_CHARS := 380

## Longest example printed in the text form (explain.cover.4).
EXAMPLE_LINES := 4

struct Chapter
    name str
    text str

struct RuleRow
    rule str
    chapter str
    file str

struct Adr
    id str
    title str

struct Worked
    rejected str
    fixed str?

struct Explanation
    rule str
    file str
    line int
    text str
    adrs List[Adr]
    example str?
    rejected str?
    fixed str?

## The repository directory.
fn root() str
    r := env.get("AIL_ROOT") else ""
    if r != ""
        return r
    c := env.get("AIL_COMPILER") else ""
    if c != ""
        d := path.dir(c)
        if d == ""
            return "."
        return d
    "."

fn read_or_die(file str) str
    text := fs.read_text(file) else err
        io.eprint("error: can't read {file}: {err.kind}")
        io.exit(2)
        return ""
    text

## Every `docs/spec/*.md` chapter, sorted by name.
fn chapters() List[Chapter]
    dir := path.join(root(), "docs/spec")
    names := fs.list_dir(dir) else err
        io.eprint("error: can't read {dir}: {err.kind}")
        io.exit(2)
        return []
    mut out := List[Chapter]()
    for name in names.sorted()
        if name.ends_with(".md")
            out.push(Chapter(name: name, text: read_or_die(path.join(dir, name))))
    out

fn cat(a str, b str) str
    "{a}{b}"

fn clen(s str) int
    s.chars().len()

## Is `s` shaped like a rule ID, `chapter.section.n`?
fn is_rule_id(s str) bool
    parts := s.split(".")
    if parts.len() != 3
        return false
    for k in 0..2
        if parts[k] == ""
            return false
        for c in parts[k].chars()
            code := c.code()
            if not ((code >= 97 and code <= 122) or code == 95)
                return false
    if parts[2] == ""
        return false
    for c in parts[2].chars()
        code := c.code()
        if code < 48 or code > 57
            return false
    true

## The rule ID that starts `line`, if it starts one (`**chapter.section.n** — ...`).
fn rule_at(line str) str?
    rest := line.strip_prefix("**") else
        return none
    end := rest.find("**") else
        return none
    id := rest.slice(0, end)
    if is_rule_id(id)
        return id
    none

fn all_rows(chs List[Chapter]) List[RuleRow]
    mut rows := List[RuleRow]()
    for ch in chs
        for line in ch.text.lines()
            r := rule_at(line) else ""
            if r != ""
                rows.push(RuleRow(rule: r, chapter: r.split(".")[0], file: ch.name))
    rows

fn all_rules(chs List[Chapter]) List[str]
    mut out := List[str]()
    for row in all_rows(chs)
        out.push(row.rule)
    out

## Does `ail fix` repair diagnostics of `rule`?
fn fixable(rule str) bool
    file := path.join(root(), "compiler/explain/fixable.txt")
    text := fs.read_text(file) else ""
    text.lines().contains(rule)

fn hex_digit(n int) str
    "0123456789abcdef".slice(n, n + 1)

fn json_str(v str) str
    mut s := "\""
    for c in v.chars()
        code := c.code()
        if c == '"'
            s = cat(s, "\\\"")
        elif c == '\\'
            s = "{s}\\\\"
        elif c == '\n'
            s = "{s}\\n"
        elif code == 13
            s = "{s}\\r"
        elif code == 9
            s = "{s}\\t"
        elif code < 32
            s = cat(s, "\\u00{hex_digit(code / 16)}{hex_digit(code % 16)}")
        else
            s = "{s}{c.to_str()}"
    cat(s, "\"")

## `text` with the last `ch` characters or fewer: `s` as `print!` would write it.
fn emit(text str)
    if text.ends_with("\n")
        print(text.slice(0, clen(text) - 1))
    elif text != ""
        print(text)

## `ail explain [--json]` (explain.list.1): every rule, its chapter key and
## file, and whether a fix exists.
fn list(json bool)
    rows := all_rows(chapters())
    mut fixes := 0
    for row in rows
        if fixable(row.rule)
            fixes += 1
    if json
        mut s := "\{\"api\":1,\"count\":{rows.len()},\"fixable\":{fixes},\"rules\":["
        mut i := 0
        for row in rows
            if i > 0
                s = "{s},"
            fix := if fixable(row.rule) then "true" else "false"
            s = cat(
                s,
                "\{\"rule\":{json_str(row.rule)},\"chapter\":{json_str(row.chapter)},\"file\":{json_str(row.file)},\"fix\":{fix}}",
            )
            i += 1
        print(cat(s, "]}"))
    else
        for row in rows
            mark := if fixable(row.rule) then " fix" else ""
            print("{row.rule} {row.file}{mark}")
        print("{rows.len()} rules, {fixes} with a fix")

## `text` cut after the last sentence within `TEXT_CHARS`.
fn shorten(text str) str
    if clen(text) <= TEXT_CHARS
        return text
    head := text.slice(0, TEXT_CHARS)
    a := head.rfind(". ") else -1
    b := head.rfind(".\n") else -1
    mut cut := clen(head)
    if a >= 0
        cut = a + 1
    elif b >= 0
        cut = b + 1
    "{head.slice(0, cut)} ... (cut; see the line above)"

## `[label](target)` as `label`: a link target costs tokens and an agent can't
## follow it from the terminal (explain.cover.4, ADR 0336).
fn strip_links(text str) str
    mut out := ""
    mut rest := text
    while true
        open := rest.find("[") else -1
        if open < 0
            break
        after := rest.slice(open + 1, clen(rest))
        mut linked := false
        c := after.find("](") else -1
        if c >= 0
            label := after.slice(0, c)
            tail := after.slice(c, clen(after))
            e := tail.find(")") else -1
            if e >= 0 and not label.contains("[") and not label.contains("\n")
                out = "{out}{rest.slice(0, open)}{label}"
                rest = after.slice(c + e + 1, clen(after))
                linked = true
        if not linked
            out = "{out}{rest.slice(0, open + 1)}"
            rest = after
    "{out}{rest}"

## The ADRs cited in `text` (`ADR NNNN`), with titles from the ADR index.
fn adrs_in(text str) List[Adr]
    index := read_or_die(path.join(root(), "docs/decisions/README.md"))
    mut out := List[Adr]()
    parts := text.split("ADR ")
    for k in 1..parts.len()
        mut num := ""
        for c in parts[k].chars()
            code := c.code()
            if code < 48 or code > 57
                break
            num = "{num}{c.to_str()}"
        mut seen := false
        for a in out
            if a.id == num
                seen = true
        if clen(num) != 4 or seen
            continue
        row := "| [{num}]("
        mut title := ""
        for l in index.lines()
            if l.starts_with(row)
                cells := l.split(" | ")
                if cells.len() > 1
                    title = cells[1]
                break
        out.push(Adr(id: num, title: title))
    out

## The lines of a code block that opens at `at`, up to the closing fence.
fn block(lines List[str], at int) str
    mut body := List[str]()
    mut i := at + 1
    while i < lines.len() and not lines[i].starts_with("```")
        body.push(lines[i])
        i += 1
    body.join("\n")

## The first block tagged `error=RULE` anywhere in the specification, and the
## plain block that directly follows it, if any (explain.show.1).
fn worked_example(chs List[Chapter], rule str) Worked?
    tag := "error={rule}"
    for ch in chs
        lines := ch.text.lines()
        mut open := -1
        for k in 0..lines.len()
            t := lines[k].strip_prefix("```ail ") else ""
            if t != "" and t.words().contains(tag)
                open = k
                break
        if open < 0
            continue
        rejected := block(lines, open)
        mut i := open + 1
        while i < lines.len() and not lines[i].starts_with("```")
            i += 1
        # Past the closing fence, to the next block unless a heading or rule comes first.
        mut fixed := none
        mut k := i + 1
        while k < lines.len()
            l := lines[k]
            r := rule_at(l) else ""
            if l.starts_with("#") or r != "" or l.starts_with("```")
                break
            k += 1
        if k < lines.len()
            t := lines[k].trim_end()
            if t == "```ail" or t == "```ail fragment"
                fixed = block(lines, k)
        return Worked(rejected: rejected, fixed: fixed)
    none

## The first block of the specification whose `rules=` tag names `rule`, when
## the rule's own section has no example (ADR 0670).
fn tagged_example(chs List[Chapter], rule str) str?
    for ch in chs
        lines := ch.text.lines()
        for i in 0..lines.len()
            tags := lines[i].strip_prefix("```ail ") else ""
            if tags == ""
                continue
            words := tags.words()
            mut named := false
            for w in words
                ids := w.strip_prefix("rules=") else ""
                if ids != "" and ids.split(",").contains(rule)
                    named = true
            if not named
                continue
            body := block(lines, i).lines()
            mut tool := ""
            mut pkg := ""
            mut stdin := ""
            for w in words
                tool = w.strip_prefix("tool=") else tool
                pkg = w.strip_prefix("pkg=") else pkg
                stdin = w.strip_prefix("stdin=") else stdin
            mut blank := true
            for l in body
                if l.trim() != ""
                    blank = false
            # A block with no code (`pkg=` or `fixture=`) shows its command alone.
            if blank and tool == ""
                continue
            mut out := ""
            if pkg != ""
                out = cat(out, "# package {pkg}\n")
            if tool != ""
                out = cat(out, "$ ail {tool.replace(",", " ")}")
                if stdin != ""
                    out = cat(out, " < {stdin}")
                out = "{out}\n"
            if not blank
                # Three lines at most: a tagged block is often a whole program (ADR 0670).
                out = cat(out, body.take(3).join("\n"))
            return out.trim_end()
    none

fn explanation(chs List[Chapter], rule str) Explanation?
    if rule == UNSUPPORTED
        mut line := 1
        for ch in chs
            if ch.name == "README.md"
                ls := ch.text.lines()
                for k in 0..ls.len()
                    if ls[k].contains(UNSUPPORTED)
                        line = k + 1
                        break
        return Explanation(
            rule: rule,
            file: "docs/spec/README.md",
            line: line,
            text: UNSUPPORTED_TEXT,
            adrs: adrs_in(UNSUPPORTED_TEXT),
            example: none,
            rejected: none,
            fixed: none,
        )
    for ch in chs
        lines := ch.text.lines()
        mut start := -1
        for k in 0..lines.len()
            r := rule_at(lines[k]) else ""
            if r == rule
                start = k
                break
        if start < 0
            continue
        # The rule's text runs to the next rule, heading or code block.
        mut end := start + 1
        while end < lines.len()
            l := lines[end]
            r := rule_at(l) else ""
            if r != "" or l.starts_with("#") or l.starts_with("```")
                break
            end += 1
        mut first := lines[start]
        cut := first.find("** ") else -1
        if cut >= 0
            first = first.slice(cut + 3, clen(first))
        mut head := List[str]()
        for c in first.chars()
            if head.len() == 0 and (c == '—' or c == '-' or c == ' ')
                continue
            head.push(c.to_str())
        mut parts := [head.join("")]
        for k in start + 1..end
            parts.push(lines[k])
        text := strip_links(parts.join("\n").trim())
        # The nearest `ail` example after the rule, within the same section.
        mut example := none
        mut i := end
        while i < lines.len() and not lines[i].starts_with("#")
            if lines[i].trim().starts_with("```ail")
                example = block(lines, i)
                break
            i += 1
        mut rejected := none
        mut fixed := none
        w := worked_example(chs, rule)
        if ww := w
            rejected = ww.rejected
            fixed = ww.fixed
        # A worked example replaces the nearest example, which may belong to another rule.
        mut shown := none
        if rejected == none
            ex := example else ""
            if ex.trim() != ""
                shown = ex
            else
                shown = tagged_example(chs, rule)
        return Explanation(
            rule: rule,
            file: "docs/spec/{ch.name}",
            line: start + 1,
            text: text,
            adrs: adrs_in(text),
            example: shown,
            rejected: rejected,
            fixed: fixed,
        )
    none

## The rows of the constructs table: (construct, owner) (ADR 0746).
fn subset_constructs() List[List[str]]
    text := read_or_die(path.join(root(), "docs/design/native-subset-constructs.md"))
    mut out := List[List[str]]()
    for l in text.lines()
        if not l.starts_with("|")
            continue
        mut cell := l.trim()
        while cell.starts_with("|")
            cell = cell.slice(1, clen(cell))
        while cell.ends_with("|")
            cell = cell.slice(0, clen(cell) - 1)
        mut cells := List[str]()
        for c in cell.split("|")
            cells.push(c.trim())
        if cells.len() == 3 and cells[0] != "Construct" and not cells[0].starts_with("---")
            out.push([cells[0], cells[1], cells[2]])
    out

fn to_text(e Explanation) str
    file := e.file.strip_prefix("docs/spec/") else e.file
    mut s := "{e.rule} ({file}:{e.line})\n{shorten(e.text)}\n"
    mut example := e.example
    if e.rule == SUBSET_RULE
        # ADR 0746: the constructs the native backend does not take yet, with the owner of each.
        s = "{s}\noutside the subset:\n"
        for row in subset_constructs()
            s = cat(s, "  {row[0]}: {row[2]}\n")
        example = none
    mut labels := ["example", "rejected example", "repaired"]
    mut codes := [example, e.rejected, e.fixed]
    for k in 0..3
        code := codes[k] else
            continue
        s = cat(s, "\n{labels[k]}:\n")
        keep := if k == 0 then EXAMPLE_LINES else 1000000000
        ls := code.lines()
        for l in ls.take(keep)
            s = cat(s, "  {l}\n")
        if ls.len() > keep
            s = "{s}  ...\n"
    s

fn to_json(e Explanation) str
    mut s := "\{\"api\":1,\"rule\":{json_str(e.rule)}"
    s = cat(s, ",\"file\":{json_str(e.file)},\"line\":{e.line}")
    s = cat(s, ",\"text\":{json_str(e.text)}")
    s = cat(s, ",\"adrs\":[")
    mut i := 0
    for a in e.adrs
        if i > 0
            s = "{s},"
        s = cat(s, "\{\"id\":{json_str(a.id)},\"title\":{json_str(a.title)}}")
        i += 1
    s = "{s}]"
    fix := if fixable(e.rule) then "true" else "false"
    s = cat(s, ",\"fix\":{fix}")
    x := e.example else ""
    if e.example != none
        s = cat(s, ",\"example\":{json_str(x)}")
    r := e.rejected else ""
    if e.rejected != none
        s = cat(s, ",\"rejected\":{json_str(r)}")
    f := e.fixed else ""
    if e.fixed != none
        s = cat(s, ",\"fixed\":{json_str(f)}")
    cat(s, "}")

## Closest known rule IDs to a mistyped one, for the "did you mean" help.
fn near(chs List[Chapter], rule str) List[str]
    mut prefix := rule
    cut := rule.rfind(".") else -1
    if cut >= 0
        prefix = rule.slice(0, cut)
    rules := all_rules(chs)
    mut same := List[str]()
    for r in rules
        if r.starts_with("{prefix}.")
            same.push(r)
    if same.len() == 0
        chapter := rule.split(".")[0]
        # One rule per section of the same chapter.
        mut sections := List[str]()
        for r in rules
            mut section := r
            c := r.rfind(".") else -1
            if c >= 0
                section = r.slice(0, c)
            if r.split(".")[0] == chapter and not sections.contains(section)
                sections.push(section)
                same.push(r)
        same = same.sorted()
    same.take(8)

## Longest one-line summary in a family listing, in characters.
SUMMARY_CHARS := 100

## A prefix with more rules than this and no dot lists its families instead.
LIST_MAX := 40

## Most rules a word search prints.
WORD_MAX := 20

## One rule in a listing: where it is and its text on one line.
struct Brief
    rule str
    file str
    line int
    text str

## Every rule with its text joined onto one line, in spec order.
fn briefs(chs List[Chapter]) List[Brief]
    mut out := List[Brief]()
    for ch in chs
        lines := ch.text.lines()
        for k in 0..lines.len()
            r := rule_at(lines[k]) else ""
            if r == ""
                continue
            mut first := lines[k]
            cut := first.find("** ") else -1
            if cut >= 0
                first = first.slice(cut + 3, clen(first))
            mut head := List[str]()
            for c in first.chars()
                if head.len() == 0 and (c == '—' or c == '-' or c == ' ')
                    continue
                head.push(c.to_str())
            mut parts := [head.join("")]
            mut e := k + 1
            while e < lines.len()
                l := lines[e]
                later := rule_at(l) else ""
                if later != "" or l.starts_with("#") or l.starts_with("```")
                    break
                if l.trim() != ""
                    parts.push(l.trim())
                e += 1
            out.push(Brief(rule: r, file: ch.name, line: k + 1, text: strip_links(parts.join(" "))))
    out

## The first sentence of `text`, cut to `SUMMARY_CHARS` at a space.
fn summary(text str) str
    mut s := text
    dot := s.find(". ") else -1
    if dot >= 0
        s = s.slice(0, dot + 1)
    if clen(s) <= SUMMARY_CHARS
        return s
    head := s.slice(0, SUMMARY_CHARS)
    sp := head.rfind(" ") else SUMMARY_CHARS
    "{head.slice(0, sp)} ..."

## A letter, digit, `_` or `.`: a character of a name in a code span.
fn name_char(code int) bool
    if (code >= 97 and code <= 122) or (code >= 65 and code <= 90)
        return true
    (code >= 48 and code <= 57) or code == 95 or code == 46

## The names that open the code spans of `text`: `read_line() str?` gives `read_line`.
fn span_names(text str) List[str]
    mut out := List[str]()
    parts := text.split("`")
    mut k := 1
    while k < parts.len()
        mut name := List[str]()
        for c in parts[k].chars()
            if not name_char(c.code())
                break
            name.push(c.to_str())
        n := name.join("")
        if n != "" and not out.contains(n)
            out.push(n)
        k += 2
    out

## Code-span names that say nothing about a family: keywords and the tool's name.
PLAIN_NAMES := [
    "use",
    "enum",
    "trait",
    "struct",
    "impl",
    "fn",
    "match",
    "error",
    "mut",
    "return",
    "for",
    "while",
    "break",
    "if",
    "not",
    "and",
    "yield",
    "move",
    "todo",
    "ail",
    "tools",
]

## `n` as a family listing shows it: `r.read` as `read`; "" for a keyword, a
## module path, a rule ID, a one-letter name or a number.
fn family_name(n str) str
    mut s := n
    parts := s.split(".")
    if parts.len() > 1 and clen(parts[0]) <= 2
        s = s.slice(clen(parts[0]) + 1, clen(s))
    if clen(s) < 2 or s.starts_with("std.") or s.starts_with(".") or PLAIN_NAMES.contains(s)
        return ""
    if is_rule_id(s)
        return ""
    code := s.chars()[0].code()
    if code >= 48 and code <= 57
        return ""
    s

## Does `word` appear in `text` as a whole word, ignoring case?
fn plain_has(text str, word str) bool
    mut cur := List[str]()
    for c in text.to_lower().chars()
        code := c.code()
        if name_char(code) and code != 46
            cur.push(c.to_str())
        else
            if cur.len() > 0 and cur.join("") == word
                return true
            cur = List[str]()
    cur.join("") == word

## The rules under `within` (every rule when it is empty) that name `word` in
## code (`exit(code int)`, `io.exit`); failing that, those that use it as a word.
fn by_word(all List[Brief], within str, word str) List[Brief]
    mut code := List[Brief]()
    for b in all
        if within != "" and not b.rule.starts_with("{within}.")
            continue
        for n in span_names(b.text)
            if n == word or n.ends_with(".{word}")
                code.push(b)
                break
    if code.len() > 0
        return code
    mut plain := List[Brief]()
    for b in all
        if within != "" and not b.rule.starts_with("{within}.")
            continue
        if plain_has(b.text, word)
            plain.push(b)
    plain

## `arg` as a family prefix or word: lower case, no trailing dot; "" when it
## can't be one (`--foo`).
fn query_of(arg str) str
    mut q := arg.to_lower()
    while q.ends_with(".")
        q = q.slice(0, clen(q) - 1)
    if q == "" or q.starts_with(".")
        return ""
    # After `to_lower`, a name character is a lower-case letter, digit, `_` or `.`.
    for c in q.chars()
        if not name_char(c.code())
            return ""
    q

## The rules found for `query`, one line each, `limit` at most (explain.find.1).
fn print_rules(query str, hits List[Brief], limit int, json bool)
    shown := hits.take(limit)
    if json
        mut items := List[str]()
        for b in shown
            where := json_str("docs/spec/{b.file}")
            item := "\{\"rule\":{json_str(b.rule)},\"file\":{where},\"line\":{b.line}"
            items.push(cat(item, ",\"summary\":{json_str(summary(b.text))}}"))
        head := "\{\"api\":1,\"query\":{json_str(query)},\"count\":{hits.len()}"
        print(cat(head, ",\"rules\":[{items.join(",")}]}"))
        return
    mut width := 0
    for b in shown
        width = width.max(clen(b.rule))
    mut out := ["{hits.len()} rules for `{query}`:"]
    for b in shown
        out.push("  {b.rule.pad_right(width, ' ')}  {summary(b.text)}")
    if hits.len() > shown.len()
        out.push("  ... {hits.len() - shown.len()} more; narrow it to a family: `ail explain FAMILY.WORD`")
    out.push("`ail explain RULE` prints one rule in full. `ail ask std WORDS` finds a std function.")
    print(out.join("\n"))

## A large prefix (`std`, `expr`): its families, with the rule count and the
## names each family's rules open with (explain.find.1).
fn print_sections(query str, hits List[Brief], json bool)
    mut sections := List[str]()
    mut counts := List[int]()
    mut names := List[List[str]]()
    for b in hits
        parts := b.rule.split(".")
        section := "{parts[0]}.{parts[1]}"
        mut i := sections.len()
        for k in 0..sections.len()
            if sections[k] == section
                i = k
        if i == sections.len()
            sections.push(section)
            counts.push(0)
            names.push(List[str]())
        counts[i] = counts[i] + 1
        for n in span_names(b.text)
            shown := family_name(n)
            if shown != ""
                if not names[i].contains(shown)
                    names[i].push(shown)
                break
    if json
        mut items := List[str]()
        for k in 0..sections.len()
            ns := [json_str(n) for n in names[k].take(8)].join(",")
            items.push("\{\"section\":{json_str(sections[k])},\"count\":{counts[k]},\"names\":[{ns}]}")
        print("\{\"api\":1,\"query\":{json_str(query)},\"count\":{hits.len()},\"sections\":[{items.join(",")}]}")
        return
    mut width := 0
    for s in sections
        width = width.max(clen(s))
    mut out := ["{hits.len()} rules for `{query}` in {sections.len()} families:"]
    for k in 0..sections.len()
        mut row := "  {sections[k].pad_right(width, ' ')}  {counts[k]}"
        if names[k].len() > 0
            more := if names[k].len() > 8 then ", ..." else ""
            row = "{row}: {names[k].take(8).join(", ")}{more}"
        out.push(row)
    out.push("`ail explain FAMILY` lists one family, e.g. `ail explain {sections[0]}`.")
    print(out.join("\n"))

## `ail explain PREFIX|WORD` (explain.find.1): the rules of a family
## (`std.io`), the families of a chapter (`std`), or the rules that name a word
## (`exit`, `std.io.exit`). False when nothing matches.
fn discover(chs List[Chapter], query str, json bool) bool
    all := briefs(chs)
    mut hits := List[Brief]()
    for b in all
        if b.rule.starts_with("{query}.")
            hits.push(b)
    if hits.len() > 0
        if hits.len() > LIST_MAX and not query.contains(".")
            print_sections(query, hits, json)
        else
            print_rules(query, hits, hits.len(), json)
        return true
    # `std.io.exit`: the word `exit` among the rules of `std.io`. A dotted query
    # searches only a prefix that has rules, so `no.such.rule` stays an error.
    mut word := query
    mut within := ""
    cut := query.rfind(".") else -1
    if cut >= 0
        word = query.slice(cut + 1, clen(query))
        within = query.slice(0, cut)
        mut known := false
        for b in all
            if b.rule.starts_with("{within}.")
                known = true
                break
        if not known
            return false
    hits = by_word(all, within, word)
    if hits.len() == 0
        return false
    print_rules(query, hits, WORD_MAX, json)
    true

fn run(rule str, json bool) int
    chs := chapters()
    found := explanation(chs, rule)
    if found != none
        e := found else
            return 2
        if json
            print(to_json(e))
        else
            emit(to_text(e))
        return 0
    q := if is_rule_id(rule) then "" else query_of(rule)
    if q != ""
        if discover(chs, q, json)
            return 0
        if not q.contains(".")
            help := "`ail explain` lists every rule; `ail explain std` lists the std families; `ail ask std WORDS` finds a std function"
            if json
                io.eprint("\{\"api\":1,\"severity\":\"error\",\"message\":{json_str("no rule, family or word matches `{rule}`")},\"help\":{json_str(help)}}")
            else
                io.eprint("error: no rule, family or word matches `{rule}`\nhelp: {help}")
            return 2
    close := near(chs, rule)
    mut help := "rule IDs look like `expr.bind.4`; see docs/spec/"
    if close.len() > 0
        help = "known rules nearby: {close.join(", ")}"
    if json
        io.eprint("\{\"api\":1,\"severity\":\"error\",\"message\":{json_str("unknown rule `{rule}`")},\"help\":{json_str(help)}}")
    else
        io.eprint("error: unknown rule `{rule}`\nhelp: {help}")
    2

## `ail explain [RULE | FAMILY | WORD] [--json]`: the exit status.
pub fn command(args List[str]) int
    json := args.contains("--json")
    mut rest := List[str]()
    for a in args
        if a != "--json"
            rest.push(a)
    if rest.len() == 0
        list(json)
        return 0
    if rest.len() == 1
        return run(rest[0], json)
    io.eprint("usage: ail explain [RULE | FAMILY | WORD] [--json]")
    2
