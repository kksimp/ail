## Agent task: read each function's effects from `ail effects`, and count how
## many functions use each effect, so a reviewer sees what the module touches.
##   ./ail run examples/tool_effects_table.ail

fn main() !
    here := path.dir(env.program())
    file := "{here}/../tools/tokbench/corpus/agent-r5/data/effects.ail"
    r := proc.run("{here}/../ail", ["effects", file])? "reading effects"
    mut users := Map[str, int]()
    for line in r.out.lines()
        parts := line.split(" \{")
        name := (parts.first() else "").replace("fn:", "")
        inner := (parts.last() else "").replace("}", "")
        mut names := []
        if inner.len() > 0
            names = inner.split(", ")
        for effect in names
            seen := users.get(effect) else 0
            users[effect] = seen + 1
        label := if names.len() == 0 then "pure" else names.join(", ")
        print("{name}: {label}")
    for effect in users.keys().sorted()
        print("{effect} used by {users[effect]}")
