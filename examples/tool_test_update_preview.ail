## Agent task: preview the snapshot updates `ail test --update --dry-run` would
## make to a file with a wrong expected value, and count the changed lines.
##   ./ail run examples/tool_test_update_preview.ail

fn main() !
    here := path.dir(env.program())
    file := "{here}/../tools/tokbench/corpus/agent-r5/data/tests.ail"
    r := proc.run("{here}/../ail", ["test", "--update", "--dry-run", file])? "previewing updates"
    mut added := 0
    mut removed := 0
    for line in r.out.lines()
        if line.starts_with("+") and not line.starts_with("+++")
            added += 1
            print(line)
        elif line.starts_with("-") and not line.starts_with("---")
            removed += 1
            print(line)
    print("{added} lines added, {removed} removed")
