## Gzip a file's text many times over, gunzip it, and check the round trip.
## Prints only booleans: the compressed bytes depend on the zlib build.
##   ./ail run examples/gz_check.ail

fn main() !
    text := fs.read_text("{path.dir(env.program())}/agent-data/records.txt")? "reading records"
    mut big := ""
    for i in 0..50
        big = "{big}{text}"
    packed := compress.gzip(big)
    print("gzip is smaller: {packed.len() < big.to_bytes().len()}")
    back := compress.gunzip(packed)?
    print("round trip equal: {back.text() == big}")
