## Compression (std.compress, ADRs 0445-0446): gzip a repetitive log, check that
## it shrinks, and gunzip it back. Bytes that are not a gzip stream are refused.
##   ./ail run examples/compress.ail

use std.compress

fn main() ! compress.CompressError
    mut log := ""
    for i in 0..200
        log = "{log}level=info msg=ok\n"
    packed := compress.gzip(log)
    print("gzip is smaller: {packed.len() < log.len()}")
    back := compress.gunzip(packed)?
    print("round trip equal: {back == log}")
    bad := [1, 2, 3]
    print("corrupt input: {compress.gunzip(bad) else "rejected"}")
