## Agent-style digest: the SHA-256 and CRC-32 of each record line, so a later
## run can tell which records changed. `hash` is fast, not secure, for the CRC.
##   ./ail run examples/digest_lines.ail

fn main() !
    text := fs.read_text("{path.dir(env.program())}/agent-data/records.txt")? "reading records"
    for line in text.lines()
        print("{hash.sha256(line)} {hash.crc32(line)} {line}")
