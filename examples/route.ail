## An agent-style HTTP route: one GET route, a method check and a 404. The
## request line is parsed and the response rendered as HTTP/1.1 text. The socket
## loop waits on std.net server support (lane 124); this runs the same route on
## sample request lines.
##   ./ail run examples/route.ail

struct Request
    method str
    path str

struct Response
    status int
    body str

fn parse_request(line str) Request?
    parts := line.split(" ")
    if parts.len() < 2
        return none
    Request(method: parts[0], path: parts[1])

fn route(req Request) Response
    if req.path != "/health"
        return Response(status: 404, body: "no such route")
    if req.method != "GET"
        return Response(status: 405, body: "use GET")
    Response(status: 200, body: "ok {req.path}")

fn reason(status int) str
    match status
        200 => "OK"
        404 => "Not Found"
        _ => "Method Not Allowed"

fn render(res Response) str
    "HTTP/1.1 {res.status} {reason(res.status)}\r\nContent-Length: {res.body.len()}\r\n\r\n{res.body}"

fn main() !
    lines := ["GET /health HTTP/1.1", "POST /health HTTP/1.1", "GET /nope HTTP/1.1", "junk"]
    for line in lines
        req := parse_request(line) else
            print("400 bad request: {line}")
            continue
        print(render(route(req)).replace("\r", ""))
        print("--")
