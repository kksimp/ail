# A three-stage pipeline over bounded channels (spec 11, conc.share.3): one
# task produces numbers, one squares them, and `main` collects the results.
# Each stage closes its output when its input runs dry.

fn produce(out Channel[int], n int)
    for i in 1..=n
        out.send(i)
    out.close()

fn square(input Channel[int], out Channel[int])
    while true
        x := input.recv() else break
        out.send(x * x)
    out.close()

fn main() !
    numbers := Channel[int](2)
    squares := Channel[int](2)
    stages := TaskGroup()
    stages.add(spawn produce(numbers, 6))
    stages.add(spawn square(numbers, squares))
    mut total := 0
    while true
        s := squares.recv() else break
        print("square {s}")
        total += s
    stages.wait_all()?
    print("total {total}")
