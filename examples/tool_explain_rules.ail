## Agent task: look up each rule ID in a list with `ail explain`, and report
## whether it resolves, with the first line of its explanation.
##   ./ail run examples/tool_explain_rules.ail

fn main() !
    here := path.dir(env.program())
    text := fs.read_text("{here}/../tools/tokbench/corpus/agent-r5/data/rules.txt")? "reading rules"
    for rule in text.lines()
        r := proc.run("{here}/../ail", ["explain", rule])? "explaining {rule}"
        shown := if r.ok() then r.out else r.err
        first := shown.lines().first() else ""
        print("{rule} {r.status} {first}")
