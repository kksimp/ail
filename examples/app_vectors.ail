## Vector shapes on a canvas (std.app.32, ADR 1032): a disc, a ring, a rounded
## card, a triangle and a zig-zag line. `ail run examples/app_vectors.ail`
## prints the display list; `--window` opens it in the app host, where the
## macOS, Windows and Linux hosts draw the same anti-aliased shapes.
use std.app
use std.env

struct Shapes
    n int

impl app.App for Shapes
    fn update(mut self, ev app.Event)
        n += 1

    fn view(self) app.Node
        app.canvas("shapes", 360.0, 140.0, [
            app.draw_rect(0.0, 0.0, 360.0, 140.0, 0xf4f4f4),
            app.Op.Round(x: 20.0, y: 20.0, w: 100.0, h: 100.0, r: 50.0, color: 0x3478f6, alpha: 1.0, stroke: 0.0),
            app.Op.Round(x: 140.0, y: 20.0, w: 100.0, h: 100.0, r: 50.0, color: 0x3478f6, alpha: 1.0, stroke: 6.0),
            app.Op.Round(x: 260.0, y: 20.0, w: 80.0, h: 50.0, r: 12.0, color: 0xe5484d, alpha: 0.8, stroke: 0.0),
            app.Op.Poly(points: [260.0, 120.0, 300.0, 80.0, 340.0, 120.0], color: 0x30a46c, alpha: 1.0),
            app.Op.Line(points: [150.0, 110.0, 175.0, 60.0, 190.0, 100.0, 215.0, 40.0], color: 0x202020, width: 4.0),
        ])

    fn title(self) str
        "Vectors"

fn main()
    mut s := Shapes(n: 0)
    if env.args().contains("--window")
        app.run(mut s) else err
            print("no window: {err.kind}: {err.message}")
        return
    print(app.outline(s.view()))
