## Agent task: measure test coverage with `ail test --coverage` and print the
## coverage line, so an agent knows how much of the file its tests reach.
##   ./ail run examples/tool_test_coverage.ail

fn main() !
    ail := env.get("AIL") else "{path.dir(env.program())}/../ail"
    file := "{path.dir(ail)}/tools/tokbench/corpus/agent-r5/data/tests.ail"
    r := proc.run(ail, ["test", "--coverage", file])? "measuring coverage"
    for line in r.text().lines()
        if line.starts_with("coverage ")
            print(line.split(": ").last() else "")
    print("exit {r.status}")
