## Agent task: extract the text of each local PDF with the PDF reader, and size
## it by lines and words, so an agent knows whether to read it whole.
##   ./ail run examples/tool_pdf_text.ail

fn main() !
    here := path.dir(env.program())
    pdfs := "{here}/../tools/tokbench/corpus/agent-r5/data/pdf"
    reader := "{here}/../tools/pdf/pdf.ail"
    for name in fs.list_dir(pdfs)?.sorted()
        r := proc.run("{here}/../ail", ["run", reader, "text", "{pdfs}/{name}"])? "reading {name}"
        words := [w for w in r.out.replace("\n", " ").split(" ") if w.len() > 0].len()
        print("{name}: status {r.status}, {r.out.lines().len()} lines, {words} words")
