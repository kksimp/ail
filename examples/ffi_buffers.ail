# Raw pointers and buffers (unsafe.ptr.1-3, unsafe.mem.3, ADR 0435): C fills memory
# the program allocated, and C writes back a pointer into the string it parsed.
use std.mem

extern c fn memset(p *u8, byte i32, n int) *u8
extern c fn memcpy(dst *int, src *int, bytes int) *int
extern c fn strtod(text *u8, rest **u8) float

## The sum of `n` ints starting at `p`.
fn sum(p *int, n int) int
    mut total := 0
    unsafe
        for i in 0..n
            total += p.offset(i).read()
    total

struct Parsed
    value float
    rest str

## Parses a leading number like C's `strtod`, with the text after it.
fn parse_prefix(text str) Parsed
    unsafe
        s := mem.cstr(text)
        rest := mem.alloc(1, mem.null())
        value := strtod(s, rest)
        after := mem.from_cstr(rest.read())
        mem.free(rest)
        mem.free(s)
        Parsed(value: value, rest: after)

fn main()
    unsafe
        a := mem.alloc(4, 0)
        b := mem.alloc(4, 0)
        for i in 0..4
            a.offset(i).write((i + 1) * 100)
        memcpy(b, a, 32)
        print(sum(b, 4))
        mem.free(a)
        bytes := mem.alloc(8, 1.to_u8())
        memset(bytes, 255, 4)
        print(bytes.read())
        print(bytes.offset(3).read())
        print(bytes.offset(4).read())
        mem.free(bytes)
        mem.free(b)
    parsed := parse_prefix("3.25kg")
    print(parsed.value)
    print(parsed.rest)
