## Agent task: count which spec rule IDs the fixtures' diagnostics cite,
## most frequent first, so a fixer knows which rule to `ail explain` next.
##   ./ail run examples/tool_check_rules.ail

fn main() !
    here := path.dir(env.program())
    data := "{here}/../tools/tokbench/corpus/agent-r5/data"
    names := fs.list_dir(data)? "listing fixtures"
    mut counts := Map[str, int]()
    for name in names.sorted()
        if not name.ends_with(".ail")
            continue
        r := proc.run("{here}/../ail", ["check", "--json", "{data}/{name}"])? "checking {name}"
        for line in r.err.lines()
            d := parse_json(line) else continue
            rule := d.str("rule") else continue
            seen := counts.get(rule) else 0
            counts[rule] = seen + 1
    for rule in counts.keys().sorted().sorted(by: |m| -counts[m])
        print("{counts[rule]} {rule}")
    print("{counts.len()} distinct rules")
