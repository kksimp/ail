## Agent task: render each local HTML page with Garlic's text mode and count the
## words on it, so an agent can size a page before reading it in full.
##   ./ail run examples/tool_garlic_pages.ail

fn main() !
    here := path.dir(env.program())
    pages := "{here}/../tools/tokbench/corpus/agent-r5/data/pages"
    garlic := "{here}/../tools/garlic/garlic.ail"
    names := fs.list_dir(pages)? "listing pages"
    mut all_words := 0
    for name in names.sorted()
        r := proc.run("{here}/../ail", [
            "run",
            garlic,
            "--print",
            "--width",
            "60",
            "{pages}/{name}",
        ])? "rendering {name}"
        text := r.out.replace("\n", " ")
        words := [w for w in text.split(" ") if w.len() > 0].len()
        all_words += words
        print("{name}: {r.out.lines().len()} lines, {words} words")
    print("total words: {all_words}")
