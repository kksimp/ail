# Fetch a URL and summarise the response (std.net, ADRs 0283 and 0369).
# With no argument it asks an https URL; when that fails (no network, or
# the page isn't there) it says why on standard error and summarises the
# copy in examples/data, so the printed lines are the same either way.
#   ./ail run examples/fetch.ail https://example.com/

fn main() !
    url := env.args().first() else "https://example.com/tasks.json"
    body := fetch(url) else err
        io.eprint("{err.kind}: {err.message}")
        fs.read_text(path.join(path.dir(env.program()), "data/{path.base(url)}"))?
    lines := body.lines()
    print("{path.base(url)}: {lines.len()} lines, {body.len()} characters")
    print(lines[0])

fn fetch(url str) str ! net.NetError
    r := net.get(url)?
    if r.status != 200
        return net.NetError(url: url, kind: Other, message: "HTTP {r.status}")
    r.body
