## Agent task: check which fixture files `ail fmt` would rewrite, so an agent
## formats only the files that need it.
##   ./ail run examples/tool_fmt_check.ail

fn main() !
    here := path.dir(env.program())
    data := "{here}/../tools/tokbench/corpus/agent-r5/data"
    names := fs.list_dir(data)? "listing fixtures"
    mut clean := 0
    mut dirty := 0
    for name in names.sorted()
        if not name.ends_with(".ail")
            continue
        r := proc.run("{here}/../ail", ["fmt", "--check", "{data}/{name}"])? "checking {name}"
        if r.status == 0
            clean += 1
            print("{name}: clean")
        else
            dirty += 1
            print("{name}: needs formatting")
    print("{clean} clean, {dirty} need formatting")
