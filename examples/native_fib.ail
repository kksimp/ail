# Recursion and an iterative loop side by side. Calls between free
# functions are the native subset's calling convention (ADR 0384).
fn fib(n int) int
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)

fn fib_loop(n int) int
    mut a := 0
    mut b := 1
    for _ in 0..n
        next := a + b
        a = b
        b = next
    a

fn main()
    for n in [0, 1, 2, 10, 20, 25]
        print("fib({n}) = {fib(n)}, {fib_loop(n)} by loop")
    print("fib(30) = {fib(30)}")
