# Calls into the C library (ffi.call.1-2, ADR 0431): `extern c` declares a C
# function, a call is `unsafe`, and the safe wrappers below are plain AIL.
use std.mem

extern c "libm" fn hypot(a float, b float) float
extern c fn abs(x i32) i32
extern c fn toupper(c i32) i32
extern c fn strlen(s *u8) int
extern c fn atoi(s *u8) i32

## The length of `text` in bytes, as C counts it.
fn c_length(text str) int
    unsafe
        p := mem.cstr(text)
        n := strlen(p)
        mem.free(p)
        n

## What C's `atoi` reads from the start of `text`.
fn c_atoi(text str) int
    unsafe
        p := mem.cstr(text)
        n := atoi(p)
        mem.free(p)
        n.to_int()

fn main()
    unsafe
        print(hypot(3.0, 4.0))
        print(abs(-7))
        print(toupper(97))
    print(c_length("héllo"))
    print(c_atoi("1234 apples"))
