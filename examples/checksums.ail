## Digests and checksums (std.hash, ADRs 0442-0445): SHA-2 digests, an HMAC
## that signs a message with a key, and the CRC-32 that gzip and zip use.
## Each value is the standard test vector, so the output is easy to check.
##   ./ail run examples/checksums.ail

use std.hash

fn main()
    print("sha256 of abc: {hash.sha256("abc")}")
    print("sha512 of empty: {hash.sha512("")}")
    print("hmac-sha256: {hash.hmac_sha256("key", "The quick brown fox jumps over the lazy dog")}")
    print("crc32 of 123456789: {hash.crc32("123456789")}")
