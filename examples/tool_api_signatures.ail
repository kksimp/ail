## Agent task: list the functions of each package module with `ail api`, their
## signatures, and whether each one has a doc comment.
##   ./ail run examples/tool_api_signatures.ail

fn main() !
    here := path.dir(env.program())
    data := "{here}/../tools/tokbench/corpus/agent-r5/data"
    for file in ["{data}/pkg/mathx.ail", "{data}/ok.ail"]
        r := proc.run("{here}/../ail", ["api", file])? "reading {path.base(file)}"
        doc := parse_json(r.out)? "parsing {path.base(file)}"
        for item in doc.arr("items") else []
            kind := item.str("kind") else ""
            if kind == "fn"
                doc_text := item.str("doc") else ""
                documented := doc_text.len() > 0
                fname := item.str("name") else ""
                sig := item.str("signature") else ""
                print("{path.base(file)} {fname} doc={documented} {sig}")
