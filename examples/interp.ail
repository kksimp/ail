# An interpreter for a small scripting language: tokenizer, parser, tree-walking evaluator, and 16 test scripts.
# Its output matches a Python version of the same program byte for byte.

MAX_DEPTH := 200
KEYWORDS := {"let", "if", "else", "while", "fn", "return", "true", "false", "and", "or", "not"}
TWO_CHAR_OPS := {"==", "!=", "<=", ">="}
ONE_CHAR_OPS := r"+-*/%<>=(){},"
ESCAPES := {'n': '\n', '"': '"', '\\': '\\'}
BINARY_LEVELS := [
    ["or"],
    ["and"],
    ["==", "!="],
    ["<", "<=", ">", ">="],
    ["+", "-"],
    ["*", "/", "%"],
]

struct Pos
    line int
    col int

error struct MiniError
    pos Pos
    msg str

enum TokKind
    Int
    Str
    Ident
    Keyword
    Op
    End

struct Token
    kind TokKind
    text str
    pos Pos

fn Token.describe(self) str
    match kind
        End => "end of input"
        Int => "number {text}"
        Str => "string"
        Ident | Keyword | Op => "'{text}'"

struct Lexer
    chars List[char]
    i int
    line int
    col int

fn Lexer.new(src str) Lexer
    Lexer(chars: src.chars(), i: 0, line: 1, col: 1)

fn Lexer.peek_at(self, offset int) char
    j := i + offset
    if j < chars.len()
        return chars[j]
    '\0'

fn Lexer.peek(self) char
    peek_at(0)

fn Lexer.pos(self) Pos
    Pos(line, col)

fn Lexer.advance(mut self) char
    c := chars[i]
    i += 1
    if c == '\n'
        line += 1
        col = 1
    else
        col += 1
    c

fn Lexer.text_from(self, start int) str
    chars[start..i].join("")

fn Lexer.skip_blank(mut self)
    while true
        match peek()
            ' ' | '\n' | '\t' | '\r' => advance()
            '/' =>
                if peek_at(1) != '/'
                    return
                while peek() != '\0' and peek() != '\n'
                    advance()
            _ => return

fn Lexer.token(mut self) Token ! MiniError
    pos := pos()
    c := peek()
    if c.is_digit()
        start := i
        while peek().is_digit()
            advance()
        return Token(Int, text_from(start), pos)
    if c.is_alpha() or c == '_'
        start := i
        while peek().is_alnum() or peek() == '_'
            advance()
        word := text_from(start)
        kind := if KEYWORDS.contains(word)
            TokKind.Keyword
        else
            Ident
        return Token(kind, word, pos)
    if c == '"'
        return string(pos)
    if TWO_CHAR_OPS.contains("{c}{peek_at(1)}")
        advance()
        advance()
        return Token(Op, text_from(i - 2), pos)
    if ONE_CHAR_OPS.contains(c)
        advance()
        return Token(Op, "{c}", pos)
    MiniError(pos, "unexpected character '{c}'")

fn Lexer.string(mut self, pos Pos) Token ! MiniError
    advance()
    mut parts := []
    while true
        match peek()
            '\0' | '\n' => return MiniError(pos, "unterminated string")
            '"' => break
            '\\' =>
                escape_pos := pos()
                advance()
                e := peek()
                if e == '\0' or e == '\n'
                    continue
                decoded := ESCAPES.get(e) else return MiniError(escape_pos, "unknown escape '\\{e}'")
                advance()
                parts.push(decoded)
            _ => parts.push(advance())
    advance()
    Token(Str, parts.join(""), pos)

fn tokenize(src str) List[Token] ! MiniError
    mut lexer := Lexer.new(src)
    mut tokens := []
    while true
        lexer.skip_blank()
        if lexer.peek() == '\0'
            tokens.push(Token(End, "", lexer.pos()))
            return tokens
        tokens.push(lexer.token()?)

enum Expr
    IntLit(pos Pos, value int)
    StrLit(pos Pos, value str)
    BoolLit(pos Pos, value bool)
    Var(pos Pos, name str)
    Unary(pos Pos, op str, operand Expr)
    Binary(pos Pos, op str, left Expr, right Expr)
    Call(pos Pos, name str, args List[Expr])

fn Expr.pos(self) Pos
    match self
        IntLit(pos, _) => pos
        StrLit(pos, _) => pos
        BoolLit(pos, _) => pos
        Var(pos, _) => pos
        Unary(pos, _, _) => pos
        Binary(pos, _, _, _) => pos
        Call(pos, _, _) => pos

struct FnDef
    name str
    params List[str]
    body List[Stmt]

enum Stmt
    Let(pos Pos, name str, value Expr)
    Assign(pos Pos, name str, value Expr)
    If(pos Pos, cond Expr, then_body List[Stmt], else_body List[Stmt])
    While(pos Pos, cond Expr, body List[Stmt])
    FnDecl(def FnDef)
    Return(pos Pos, value Expr?)
    ExprStmt(expr Expr)

struct Parser
    tokens List[Token]
    i int

fn Parser.peek(self) Token
    tokens[i]

fn Parser.peek_next(self) Token
    tokens[(i + 1).min(tokens.len() - 1)]

fn Parser.advance(mut self) Token
    tok := peek()
    if tok.kind != End
        i += 1
    tok

fn Parser.at_any(self, ops List[str]) bool
    tok := peek()
    (tok.kind == Op or tok.kind == Keyword) and ops.contains(tok.text)

fn Parser.at(self, text str) bool
    at_any([text])

fn Parser.expected(self, what str) MiniError
    tok := peek()
    MiniError(tok.pos, "expected {what} but found {tok.describe()}")

fn Parser.expect(mut self, text str) Token ! MiniError
    if not at(text)
        return expected("'{text}'")
    advance()

fn Parser.expect_ident(mut self) str ! MiniError
    if peek().kind != Ident
        return expected("identifier")
    advance().text

fn Parser.program(mut self) List[Stmt] ! MiniError
    mut stmts := []
    while peek().kind != End
        stmts.push(statement()?)
    stmts

fn Parser.block(mut self) List[Stmt] ! MiniError
    expect("\{")?
    mut stmts := []
    while not at("}")
        if peek().kind == End
            return expected("'}'")
        stmts.push(statement()?)
    advance()
    stmts

fn Parser.statement(mut self) Stmt ! MiniError
    tok := peek()
    pos := tok.pos
    if at("let")
        advance()
        name := expect_ident()?
        expect("=")?
        return Let(pos, name, expression(0)?)
    if at("if")
        return if_statement()
    if at("while")
        advance()
        cond := expression(0)?
        return While(pos, cond, block()?)
    if at("fn")
        advance()
        name := expect_ident()?
        expect("(")?
        mut params := []
        if not at(")")
            params.push(expect_ident()?)
            while at(",")
                advance()
                params.push(expect_ident()?)
        expect(")")?
        return FnDecl(FnDef(name, params, block()?))
    if at("return")
        advance()
        if at("}")
            return Return(pos, none)
        return Return(pos, expression(0)?)
    next := peek_next()
    if tok.kind == Ident and next.kind == Op and next.text == "="
        advance()
        advance()
        return Assign(pos, tok.text, expression(0)?)
    ExprStmt(expression(0)?)

fn Parser.if_statement(mut self) Stmt ! MiniError
    pos := expect("if")?.pos
    cond := expression(0)?
    then_body := block()?
    mut else_body := []
    if at("else")
        advance()
        else_body = if at("if")
            [if_statement()?]
        else
            block()?
    If(pos, cond, then_body, else_body)

fn Parser.expression(mut self, level int) Expr ! MiniError
    if level == BINARY_LEVELS.len()
        return unary()
    mut left := expression(level + 1)?
    while at_any(BINARY_LEVELS[level])
        op := advance()
        right := expression(level + 1)?
        left = Binary(op.pos, op.text, left, right)
    left

fn Parser.unary(mut self) Expr ! MiniError
    if at("-") or at("not")
        op := advance()
        return Unary(op.pos, op.text, unary()?)
    primary()

fn Parser.primary(mut self) Expr ! MiniError
    tok := peek()
    match tok.kind
        Int =>
            advance()
            value := tok.text.to_int() else return MiniError(tok.pos, "number too large")
            IntLit(tok.pos, value)
        Str =>
            advance()
            StrLit(tok.pos, tok.text)
        Ident =>
            advance()
            if not at("(")
                return Var(tok.pos, tok.text)
            advance()
            mut args := []
            if not at(")")
                args.push(expression(0)?)
                while at(",")
                    advance()
                    args.push(expression(0)?)
            expect(")")?
            Call(tok.pos, tok.text, args)
        Keyword =>
            if tok.text != "true" and tok.text != "false"
                return expected("expression")
            advance()
            BoolLit(tok.pos, tok.text == "true")
        Op =>
            if tok.text != "("
                return expected("expression")
            advance()
            inner := expression(0)?
            expect(")")?
            inner
        End => expected("expression")

enum Value
    Int(n int)
    Str(s str)
    Bool(b bool)
    Nil

fn Value.type_name(self) str
    match self
        Int(_) => "int"
        Str(_) => "str"
        Bool(_) => "bool"
        Nil => "nil"

fn Value.as_int(self) int?
    match self
        Int(n) => n
        Str(_) | Bool(_) | Nil => none

fn Value.as_str(self) str?
    match self
        Str(s) => s
        Int(_) | Bool(_) | Nil => none

fn Value.as_bool(self) bool?
    match self
        Bool(b) => b
        Int(_) | Str(_) | Nil => none

impl ToStr for Value
    fn to_str(self) str
        match self
            Int(n) => "{n}"
            Str(s) => s
            Bool(b) => "{b}"
            Nil => "nil"

enum Flow
    Next
    Returned(value Value)

struct Env
    scopes List[Map[str, Value]]
    base int

fn Env.find(self, name str) int?
    mut k := scopes.len()
    while k > base
        k -= 1
        if scopes[k].contains(name)
            return k
    if scopes[0].contains(name)
        return 0
    none

fn Env.get(self, name str) Value?
    k := find(name)?
    scopes[k].get(name)

struct Interp
    env Env
    functions Map[str, FnDef]
    depth int

fn Interp.new() Interp
    Interp(Env([{}], 0), {}, 0)

fn undefined_variable(pos Pos, name str) MiniError
    MiniError(pos, "undefined variable '{name}'")

fn checked(pos Pos, result int?) Value ! MiniError
    n := result else return MiniError(pos, "integer overflow")
    Int(n)

fn Interp.run(mut self, program List[Stmt]) !
    exec_all(program)?

fn Interp.exec_all(mut self, body List[Stmt]) Flow ! MiniError
    for stmt in body
        flow := exec(stmt)?
        if flow != Next
            return flow
    Next

fn Interp.exec_block(mut self, body List[Stmt]) Flow ! MiniError
    env.scopes.push({})
    flow := exec_all(body)?
    env.scopes.pop()
    flow

fn Interp.exec(mut self, stmt Stmt) Flow ! MiniError
    match stmt
        Let(_, name, value) => env.scopes[env.scopes.len() - 1][name] = eval(value)?
        Assign(pos, name, value) =>
            k := env.find(name) else return undefined_variable(pos, name)
            env.scopes[k][name] = eval(value)?
        If(_, cond, then_body, else_body) =>
            if condition(cond)?
                return exec_block(then_body)
            return exec_block(else_body)
        While(_, cond, body) =>
            while condition(cond)?
                flow := exec_block(body)?
                if flow != Next
                    return flow
        FnDecl(def) => functions[def.name] = def
        Return(_, value) =>
            if e := value
                return Returned(eval(e)?)
            return Returned(Nil)
        ExprStmt(e) => eval(e)?
    Next

fn Interp.condition(mut self, e Expr) bool ! MiniError
    v := eval(e)?
    b := v.as_bool() else return MiniError(e.pos(), "type mismatch: condition must be bool, got {v.type_name()}")
    b

fn Interp.eval(mut self, e Expr) Value ! MiniError
    match e
        IntLit(_, n) => Int(n)
        StrLit(_, s) => Str(s)
        BoolLit(_, b) => Bool(b)
        Var(pos, name) =>
            v := env.get(name) else return undefined_variable(pos, name)
            v
        Unary(pos, op, operand) =>
            v := eval(operand)?
            if op == "-"
                if n := v.as_int()
                    return checked(pos, n.checked_neg())
            if op == "not"
                if b := v.as_bool()
                    return Bool(not b)
            MiniError(pos, "type mismatch: cannot apply '{op}' to {v.type_name()}")
        Binary(pos, op, left, right) =>
            if op == "and" or op == "or"
                return logical(pos, op, left, right)
            binary(pos, op, eval(left)?, eval(right)?)
        Call(pos, name, args) =>
            mut values := []
            for arg in args
                values.push(eval(arg)?)
            call(pos, name, values)

fn Interp.logical(mut self, pos Pos, op str, left Expr, right Expr) Value ! MiniError
    a := eval(left)?
    x := a.as_bool() else return MiniError(pos, "type mismatch: '{op}' needs bool operands, got {a.type_name()}")
    if (op == "and" and not x) or (op == "or" and x)
        return a
    b := eval(right)?
    if b.as_bool() == none
        return MiniError(pos, "type mismatch: '{op}' needs bool operands, got {b.type_name()}")
    b

fn binary(pos Pos, op str, a Value, b Value) Value ! MiniError
    if op == "=="
        return Bool(a == b)
    if op == "!="
        return Bool(a != b)
    if op == "+"
        if sa := a.as_str()
            if sb := b.as_str()
                return Str("{sa}{sb}")
    mismatch := MiniError(pos, "type mismatch: cannot apply '{op}' to {a.type_name()} and {b.type_name()}")
    x := a.as_int() else return mismatch
    y := b.as_int() else return mismatch
    if (op == "/" or op == "%") and y == 0
        return MiniError(pos, "division by zero")
    match op
        "+" => checked(pos, x.checked_add(y))
        "-" => checked(pos, x.checked_sub(y))
        "*" => checked(pos, x.checked_mul(y))
        "/" => checked(pos, x.checked_div(y))
        "%" => Int(x % y)
        "<" => Bool(x < y)
        "<=" => Bool(x <= y)
        ">" => Bool(x > y)
        ">=" => Bool(x >= y)
        _ => unreachable("unknown operator {op}")

fn wrong_arguments(pos Pos, name str, want int, got int) MiniError
    MiniError(pos, "wrong number of arguments: '{name}' takes {want} but got {got}")

fn Interp.call(mut self, pos Pos, name str, args List[Value]) Value ! MiniError
    if name == "print" or name == "str"
        if args.len() != 1
            return wrong_arguments(pos, name, 1, args.len())
        if name == "str"
            return Str("{args[0]}")
        print(args[0])
        return Nil
    def := functions.get(name) else return MiniError(pos, "undefined function '{name}'")
    if args.len() != def.params.len()
        return wrong_arguments(pos, name, def.params.len(), args.len())
    if depth == MAX_DEPTH
        return MiniError(pos, "stack overflow")
    mut frame := {}
    for i in 0..args.len()
        frame[def.params[i]] = args[i]
    saved_base := env.base
    env.base = env.scopes.len()
    env.scopes.push(frame)
    depth += 1
    flow := exec_all(def.body)?
    depth -= 1
    env.scopes = env.scopes[..env.base]
    env.base = saved_base
    match flow
        Next => Nil
        Returned(v) => v

SCRIPTS := {
    "fibonacci": r"""
        // The first sixteen Fibonacci numbers, on one line
        fn fib(n) {
            if n < 2 {
                return n
            }
            return fib(n - 1) + fib(n - 2)
        }
        let line = ""
        let i = 0
        while i <= 15 {
            if i > 0 {
                line = line + " "
            }
            line = line + str(fib(i))
            i = i + 1
        }
        print(line)
        """,
    "factorial": r"""
        fn fact(n) {
            if n <= 1 {
                return 1
            }
            return n * fact(n - 1)
        }
        fn fact_loop(n) {
            let result = 1
            while n > 1 {
                result = result * n
                n = n - 1
            }
            return result
        }
        print(fact(10))
        print(fact(20))
        print(fact(12) == fact_loop(12))
        print(fact(21))
        """,
    "fizzbuzz": r"""
        let n = 1
        let out = ""
        while n <= 15 {
            if n % 15 == 0 {
                out = out + "FizzBuzz"
            } else if n % 3 == 0 {
                out = out + "Fizz"
            } else {
                if n % 5 == 0 {
                    out = out + "Buzz"
                } else {
                    out = out + str(n)
                }
            }
            if n < 15 { out = out + "," }
            n = n + 1
        }
        print(out)
        """,
    "strings": r"""
        fn repeat(s, times) {
            let out = ""
            while times > 0 {
                out = out + s
                times = times - 1
            }
            return out
        }
        let row = 1
        while row <= 4 {
            print(repeat(" ", 4 - row) + repeat("*", 2 * row - 1))
            row = row + 1
        }
        print("she said \"hi\"\nand left")
        print("ab" + "cd" == "abcd")
        print(1 == "1")
        print(true != 1)
        print(-7 / 2)
        print(-7 % 2)
        print(not (3 > 2) or 2 >= 2)
        print(false and missing)
        print(true or missing())
        fn nothing() { return }
        print(nothing())
        """,
    "even and odd": r"""
        fn is_even(n) {
            if n == 0 { return true }
            return is_odd(n - 1)
        }
        fn is_odd(n) {
            if n == 0 { return false }
            return is_even(n - 1)
        }
        print(is_even(10))
        print(is_odd(7))
        print(is_even(7))
        print(is_odd(150))
        """,
    "scopes": r"""
        let x = "global"
        let count = 0
        fn bump() {
            count = count + 1
            let x = "local"
            return x
        }
        if true {
            let x = "block"
            print(x)
            count = 10
        }
        print(x)
        print(bump())
        print(count)
        """,
    "bad character": r"""
        let a = 1
        let b = a # 2
        """,
    "unterminated string": r"""
        print("ok")
        print("hello)
        """,
    "missing paren": r"""
        fn add(a, b {
            return a + b
        }
        """,
    "undefined variable": r"""
        fn peek() {
            return secret
        }
        let secret = 1
        fn outer() {
            let hidden = 2
            return inner()
        }
        fn inner() { return hidden }
        print(peek())
        print(outer())
        """,
    "type mismatch": r"""
        let total = 5
        print("total: " + str(total))
        let flag = true
        print(total + flag)
        """,
    "division by zero": r"""
        fn average(sum, count) {
            return sum / count
        }
        print(average(10, 2))
        print(average(7, 0))
        """,
    "undefined function": r"""
        fn square(n) { return n * n }
        print(square(4))
        print(sqaure(5))
        """,
    "wrong arguments": r"""
        fn add(a, b) { return a + b }
        print(add(1, 2))
        print(add(1, 2, 3))
        """,
    "stack overflow": r"""
        fn down(n) {
            return down(n + 1)
        }
        print("going down")
        down(0)
        """,
    "bad condition": r"""
        let n = 3
        while n {
            n = n - 1
        }
        """,
}

fn run_script(source str) !
    mut parser := Parser(tokenize(source)?, 0)
    mut interp := Interp.new()
    interp.run(parser.program()?)?

fn main()
    for name in SCRIPTS.keys()
        print("== {name} ==")
        run_script(SCRIPTS[name]) else err
            print("error at {err.pos.line}:{err.pos.col}: {err.msg}")
