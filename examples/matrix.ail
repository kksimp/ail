## An agent-style matrix script: multiply two small integer matrices with
## std.tensor and print the product, its transpose and each row's sum.
##   ./ail run examples/matrix.ail

fn main()
    a := tensor.from([1, 2, 3, 4, 5, 6], [2, 3])
    b := tensor.from([7, 8, 9, 10, 11, 12], [3, 2])
    c := a.matmul(b)
    print("shape {c.shape()}")
    print("product {c.to_list()}")
    print("transpose {a.transpose().to_list()}")
    print("row sums {c.sum(1).to_list()}")
