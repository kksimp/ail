## An agent-style process supervisor: run each job with a time limit and report
## its exit status, a timeout, or a failure to start. Nothing is shelled out.
##   ./ail run examples/supervise.ail

struct Job
    cmd str
    args List[str]
    limit int

fn run_job(job Job) str
    r := proc.run(job.cmd, job.args, "", job.limit) else err
        if err.kind == TimedOut
            return "timed out after {job.limit} ms"
        return "could not start"
    if r.ok()
        return "ok"
    "exit {r.status}: {r.err.trim()}"

fn main() !
    jobs := [
        Job(cmd: "echo", args: ["hello"], limit: 1000),
        Job(cmd: "sh", args: ["-c", "echo oops >&2; exit 3"], limit: 1000),
        Job(cmd: "sleep", args: ["5"], limit: 200),
        Job(cmd: "no-such-tool-xyz", args: [], limit: 1000),
    ]
    mut failed := 0
    for job in jobs
        result := run_job(job)
        if result != "ok"
            failed += 1
        print("{job.cmd:<18}{result}")
    print("{failed} of {jobs.len()} jobs failed")
