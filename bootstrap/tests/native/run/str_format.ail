# `{x:spec}` as a value and in `print` (type.str.11).
fn main()
    x := 3.14159
    n := 255
    s := "ab"
    c := 'z'
    print("[{x:.2}] [{x:8.3}] [{x:<8.1}] [{x:^9.0}] [{x:*>10.4}]")
    print("[{n:x}] [{n:6}] [{n:<6}] [{n:^6}] [{n:0>6}] [{n:#>8x}]")
    print("[{-n:x}] [{-n:6}] [{-n:0>6}]")
    print("[{s:5}] [{s:>5}] [{s:^5}] [{s:^6}] [{s:-<6}] [{s:1}]")
    print("[{c:3}] [{c:>3}] [{true:7}] [{false:>7}]")
    print("[{1.5:.0}] [{2.5:.0}] [{0.125:.2}] [{1e20:.1}] [{-0.5:.0}]")
    m := "[{x:.3}] [{n:>5}] [{s:^7}]"
    print(m)
    print(m.len())
    print("[{(-9223372036854775807 - 1):x}]")
