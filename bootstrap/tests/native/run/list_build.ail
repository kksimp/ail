## chunks, windows, flatten and counts on native lists (type.coll.17-19).
fn main()
    xs := [1, 2, 3, 4, 5]
    print(xs.chunks(2))
    print(xs.windows(3))
    print(xs.windows(9))
    print(xs.chunks(9))
    print(xs.take(0).chunks(2))
    print([[1, 2], [], [3]].flatten())
    print([["a"], ["b", "c"]].flatten())
    print("a b a c b a".split(" ").counts())
    print([3, 1, 3].counts())
    print(['x', 'y', 'x'].counts())
    c := [1, 1, 2].counts()
    print(c[1] + c[2])
    for p in xs.chunks(2)
        print(p.len())
    print([2.5, 1.5].chunks(1))
    print([true, false, true].windows(2))
