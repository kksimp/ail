fn main()
    b := "hi\n".to_bytes()
    print(b)
    print(b[0])
    print(b[0] + 1)
    print(bytes.zeros(3))
    print(b"ab" < b"ac")
    print(b"ab" >= b"ac")
    print(b"ab" <= b"ab")
    print(b"a" < b"ab")
    print(b.hex(" "))
    print(b.hex(""))
    print(b[1..])
    print(b"a\tb\rc\\d\"e\x00\x1f\x7f\x80\xff~")
    print(b == b"hi\n")
