# `any Trait` (ADR 0616): boxing where `any T` is expected, dispatch by tag,
# a `mut self` method through the box, and copies that stay independent.
trait Shape
    fn area(self) int
    fn name(self) str
    fn describe(self) int
        10 * self.area()
    fn grow(mut self, k int)

struct Circle
    r int

struct Rect
    w int
    h int

impl Shape for Circle
    fn area(self) int
        3 * r * r
    fn name(self) str
        "circle"
    fn grow(mut self, k int)
        r += k

impl Shape for Rect
    fn area(self) int
        w * h
    fn name(self) str
        if w == h then "square" else "rect"
    fn grow(mut self, k int)
        w += k

struct Drawing
    shapes List[any Shape]

fn Drawing.add(mut self, s any Shape)
    self.shapes.push(s)

fn total(xs List[any Shape]) int
    mut t := 0
    for s in xs
        t += s.area()
    t

fn main()
    c := Circle(r: 2)
    mut d := Drawing(shapes: [c, Rect(w: 3, h: 4)])
    d.add(Rect(w: 4, h: 4))
    for s in d.shapes
        print("{s.name()} {s.area()} {s.describe()}")
    print(total(d.shapes))
    mut e := d
    e.shapes[0].grow(1)
    print("{d.shapes[0].area()} {e.shapes[0].area()} {c.area()}")
    one := d.shapes[2]
    print(one.name())
