fn main()
    for x in [0.0, 0.5, 1.0, 2.0, -3.25, 10.0, 1000.0, 1e6, 1e12, 0.001, -0.75]
        print("{x.sin():.9} {x.cos():.9} {x.tan():.9} {x.atan():.9}")
        print("{x.exp():.6} {x.ln():.9} {x.log10():.9} {x.cbrt():.9}")
    print("{2.0.pow(0.5):.9} {(-2.0).pow(3.0):.9} {10.0.pow(-2.0):.9} {3.0.hypot(4.0):.9}")
    print("{1.0.atan2(-1.0):.9} {(-1.0).atan2(-1.0):.9} {0.0.atan2(-1.0):.9}")
    print("{1.0.pow(1e308):.9} {2.0.pow(0.0):.9} {0.0.pow(-1.0)} {(-0.0).pow(-1.0)}")
