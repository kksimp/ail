enum Color
    Red
    Blue

struct P
    name str
    age int

fn swap(p(int, str))(str, int)
    a, b := p
    (b, a)

fn kind(p(int, int)) str
    match p
        (0, _) => "zero"
        (x, 1) => "x{x} one"
        _ => "other"

fn main()
    t := (1, "a")
    print(t)
    print(t.0)
    print(t.1)
    n, s := t
    print("{n} {s}")
    print(swap(t))
    mut m := (1, 2)
    m.0 = 5
    m.1 += 3
    print(m)
    print(m == (5, 5))
    print(m != (5, 5))
    print((1, "b") < (1, "c"))
    print((2, "a") > (1, "z"))
    print((1, 2) <= (1, 2))
    print((1, 2) >= (1, 3))
    print(kind((0, 9)))
    print(kind((4, 1)))
    print(kind((4, 4)))
    pairs := [(1, "x"), (2, "y")]
    for a, b in pairs
        print("{a}{b}")
    for p in pairs
        print(p.1)
    nested := ((1, 2), "z")
    print(nested)
    print(nested.0.1)
    c := (Color.Red, 3.5, true)
    print(c.1)
    match c
        (Color.Red, x, _) => print("red {x}")
        _ => print("other")
    mut ps := [(1, 2)]
    ps.push((3, 4))
    q := ps[0]
    ps[0].0 = 99
    print(q)
    for e in ps
        print(e)
    print(ps.len())
