# std.mem and the libc subset in native builds (ffi.native.1, unsafe.mem.1-3, ADR 0844).
use std.mem

extern c "libm" fn hypot(a float, b float) float
extern c fn abs(x i32) i32
extern c fn toupper(c i32) i32
extern c fn strlen(s *u8) int
extern c fn atoi(s *u8) i32
extern c fn memset(p *u8, byte i32, n int) *u8
extern c fn memcpy(dst *int, src *int, bytes int) *int
extern c fn strtod(text *u8, rest **u8) float

fn num(text str) float
    unsafe
        s := mem.cstr(text)
        rest := mem.alloc(1, mem.null())
        v := strtod(s, rest)
        used := rest.read().offset(0)
        after := mem.from_cstr(used)
        mem.free(rest)
        mem.free(s)
        print("{text} -> {v} rest={after}")
        v

fn int_of(text str) i32
    unsafe
        s := mem.cstr(text)
        n := atoi(s)
        mem.free(s)
        n

fn main()
    unsafe
        print(hypot(3.0, 4.0))
        print(hypot(0.0, 0.0))
        print(hypot(1.0e200, 1.0e200))
        print(abs(-7))
        print(abs(9))
        print(toupper(97))
        print(toupper(65))
        print(toupper(48))
        a := mem.alloc(4, 7)
        a.offset(2).write(9)
        b := mem.alloc(4, 0)
        memcpy(b, a, 32)
        print(b.read() + b.offset(1).read() + b.offset(2).read() + b.offset(3).read())
        f := mem.alloc(3, 2.5)
        print(f.offset(2).read())
        h := mem.alloc(2, 3.to_u16())
        print(h.offset(1).read())
        t := mem.alloc(2, true)
        print(t.read())
        k := mem.cast(a, 0.to_u8())
        print(k.read())
        mem.free(a)
        mem.free(b)
        mem.free(f)
        mem.free(h)
        mem.free(t)
        buf := mem.alloc(8, 1.to_u8())
        memset(buf, 255, 4)
        print(buf.read())
        print(buf.offset(4).read())
        mem.free(buf)
        z := mem.cstr("héllo")
        print(strlen(z))
        print(mem.from_cstr(z))
        mem.free(z)
        e := mem.cstr("")
        print(strlen(e).to_float())
        mem.free(e)
        print(mem.null().is_null())
    print(int_of("1234 apples"))
    print(int_of("  -42x"))
    print(int_of("+7"))
    print(int_of("none"))
    print(int_of("99999999999"))
    num("3.25kg")
    num("  -0.005")
    num("1e3x")
    num("2.5E-2")
    num("abc")
    num(".5")
    num("7.")
    num("0.1")
    num("123456789012345678901234567890")
    num("1e400")
    num("-1e-400")
    num("1e")
