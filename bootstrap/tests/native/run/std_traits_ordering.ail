# Split from std_traits (ADR 0725). Original rules: trait.std.1-4, trait.derive.1,
# trait.auto.1-3, expr.cmp.1.
# This part: ordering with `<`, `cmp`, `largest`, and `Ordering` values.
struct Version
    major int
    minor int

impl Ord for Version

enum Level
    Low
    High

impl Ord for Level

struct Money
    cents int

impl Ord for Money
    fn cmp(self, other Self) Ordering
        other.cents.cmp(self.cents)

fn largest[T Ord](items List[T]) T
    mut best := items[0]
    for x in items
        if x > best
            best = x
    best

fn find(xs List[int], x int) int?
    for i in 0..xs.len()
        if xs[i] == x
            return i
    none

fn main()
    print(Version(major: 1, minor: 9) < Version(major: 2, minor: 0))
    print(largest([
        Version(major: 1, minor: 2),
        Version(major: 1, minor: 10),
        Version(major: 0, minor: 99),
    ]))
    print(largest(["pear", "apple", "zoo"]))
    print(largest([3, 9, 4]))
    print(Level.Low < High)
    print(largest([[1, 2], [1, 3], [0, 9]]))
    print(largest([Money(cents: 5), Money(cents: 1), Money(cents: 9)]))
    n := 1
    print(n.cmp(2))
    print("b".cmp("a"))
    match Version(major: 1, minor: 0).cmp(Version(major: 1, minor: 0))
        Less => print("less")
        Equal => print("equal")
        Greater => print("greater")
    print(find([4, 5], 6) == none)
    print(find([4, 5], 5) == 1)
    print(Ordering.Less)
