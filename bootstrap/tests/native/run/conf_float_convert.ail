# Conversions and NaN comparisons (type.num.6, type.num.9).
fn main()
    print(3.9.to_int())
    print((-3.9).to_int())
    print(0.5.to_int())
    print((-0.5).to_int())
    print((-0.0).to_int())
    print(9007199254740993.to_float())
    print(9223372036854775807.to_float())
    print((-2.5).floor())
    print((-2.5).ceil())
    print((-0.4).floor())
    print((-0.4).ceil())
    print((0.0 - 1.0).sqrt())
    print(2.0.abs())
    print((-0.0).abs())
    nan := 0.0 / 0.0
    print(nan == nan)
    print(nan != nan)
    print(nan < 1.0)
    print(nan >= 1.0)
    print(1.0 > nan)
    print(-0.0 == 0.0)
    print([3.0, 1.0, 2.0].len())
