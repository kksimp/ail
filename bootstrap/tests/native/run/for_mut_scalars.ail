# own.excl.5: `for mut` over scalar, str, tuple, list and map elements writes back.
fn first_big(mut xs List[int]) int
    for mut x in xs
        if x > 5
            x = 0
            return 1
        x += 100
    0

fn main()
    mut fs := [1.5, 2.5]
    for mut f in fs
        f *= 2.0
    print(fs)
    mut ss := ["a", "b"]
    for mut s in ss
        s = "{s}{s}"
    print(ss)
    mut ns := [1, 2, 3, 4]
    for mut n in ns
        if n == 2
            continue
        if n == 4
            break
        n += 10
    print(ns)
    mut ts := [(1, 2), (3, 4)]
    for mut t in ts
        t = (t.1, t.0)
    print(ts)
    mut ls := [[1], [2, 3]]
    for mut l in ls
        l = [9]
    print(ls)
    mut ms := [{"a": 1}, {"b": 2}]
    for mut m in ms
        m = {"z": 0}
    print(ms.len())
    mut bs := [true, false]
    for mut b in bs
        b = not b
    print(bs)
    mut ys := [1, 2, 9]
    print(first_big(mut ys))
    print(ys)
