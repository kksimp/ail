## type.str.4: `split(sep, limit)` makes at most `limit` pieces; the last keeps the rest.
fn main()
    print("a=b=c".split("=", 2))
    print("a=b=c".split("=", 1))
    print("a=b=c".split('=', 9))
    print("abc".split("=", 2))
    print("".split("=", 2))
    print("k = v = w ".split("=", 2))
    key := "name=ail".split("=", 2)[0]
    print(key)
