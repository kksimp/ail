# `push` in a counted loop: the guard checks the room for every push once,
# and a list that is full, a conditional push and a second push in the
# body keep working (native.bce.6). Lists made empty before the loop are
# sized where they are made.
fn squares(n int) List[int]
    mut xs := []
    for i in 0..n
        xs.push(i * i)
    xs

fn twice(n int) List[int]
    mut xs := []
    for i in 0..n
        xs.push(i)
        xs.push(0 - i)
    xs

fn evens(n int) List[int]
    mut xs := []
    for i in 0..n
        if i % 2 == 0
            xs.push(i)
    xs

fn after(mut xs List[int], n int)
    for i in 0..n
        xs.push(i + 100)

fn floats(n int) List[float]
    mut xs := []
    for i in 0..n
        xs.push(i.to_float() * 0.5)
    xs

fn flags(n int) List[bool]
    mut xs := []
    for i in 0..n
        xs.push(i % 3 == 0)
    xs

fn total(xs List[int]) int
    mut s := 0
    for x in xs
        s += x
    s

fn main()
    for n in [0, 1, 3, 4, 5, 17, 1000, 1100000]
        print("{n} {squares(n).len()} {total(squares(n) )} {twice(n).len()} {total(evens(n))} {floats(n).len()} {flags(n).len()}")
    mut full := [1, 2, 3, 4]
    after(mut full, 50)
    print("{full.len()} {total(full)}")
    mut one := [7]
    after(mut one, 0)
    after(mut one, 9)
    print("{one.len()} {total(one)}")
