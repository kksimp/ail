# Bit operations at the edges of the 0..=63 shift range (expr.bit.1, expr.bit.2).
fn main()
    print(1.shl(63))
    print((-1).shl(63))
    print((-1).shr(63))
    print(lo_bits().shr(63))
    print(5.shl(0))
    print((-5).shr(0))
    print((-9223372036854775807 - 1).bit_not())
    print((-1).bit_and(255))
    print((-16).bit_or(3))
    print((-16).bit_xor(-1))
    print(0.bit_not())
    print(1.shl(62).shl(1))
    print((1.shl(40) + 1).shr(40))
    print((-8).shr(1).shr(1))
    mut s := 0
    for k in 0..64
        s = s.bit_xor(1.shl(k))
        s = s.bit_xor((-1).shr(k))
    print(s)

fn lo_bits() int
    -9223372036854775807 - 1
