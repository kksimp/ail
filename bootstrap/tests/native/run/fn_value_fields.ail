# type.fn.3: a function held in a field is called as `(op.run)(x)`, and a list
# can hold function values.
struct Op
    name str
    run fn(int, int) int

fn add(a int, b int) int
    a + b

fn mul(a int, b int) int
    a * b

fn double(n int) int
    n * 2

fn pick(name str) fn(int, int) int
    if name == "add"
        return add
    mul

fn main()
    ops := [Op(name: "add", run: add), Op(name: "mul", run: mul)]
    for op in ops
        print("{op.name} {(op.run)(6, 7)}")
    print(pick("mul")(3, 4))
    fs := [double, double]
    mut total := 0
    for h in fs
        total += h(5)
    print(total)
