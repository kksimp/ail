# Float text form (type.num.7): shortest round-trip digits, fixed notation
# for -4 <= e < 16, exponent form otherwise, and the special values.
fn main()
    print(0.1 + 0.2)
    print(1e300)
    print(-0.0)
    print(0.0 - 0.0)
    print(0.0 / 0.0)
    print(1.0 / 0.0)
    print(-1.0 / 0.0)
    print(1e-7)
    print(5e-324)
    print(1e16)
    print(1e15)
    print(0.0001)
    print(0.00001)
    print(3.0)
    print(1e22)
    print(123456789.125)
    print(-2.5e-5)
    print(1.7976931348623157e308)
    print("{0.1} {-0.0} {1e-7} {2.0 / 3.0}")
    print([0.5, -0.0, 2.0])
    print([0.0 / 0.0, 1.0 / 0.0])
