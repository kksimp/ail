fn show(x int?)
    if v := x
        print(v)
    else
        print("none")

fn main()
    big := 9223372036854775807
    small := -big - 1
    show(big.checked_add(1))
    show(big.checked_add(-1))
    show(small.checked_sub(1))
    show(small.checked_sub(-1))
    show(big.checked_mul(2))
    show(small.checked_mul(-1))
    show(7.checked_mul(6))
    show(small.checked_div(-1))
    show(7.checked_div(0))
    show((-7).checked_div(2))
    show(small.checked_rem(-1))
    show(7.checked_rem(0))
    show((-7).checked_rem(3))
    show(small.checked_neg())
    show(5.checked_neg())
    print(big.wrapping_add(1))
    print(small.wrapping_sub(1))
    print(big.wrapping_mul(3))
    print(small.wrapping_neg())
    print(big.saturating_add(5))
    print(small.saturating_add(-5))
    print(small.saturating_sub(1))
    print(big.saturating_sub(-1))
    print(big.saturating_mul(2))
    print(big.saturating_mul(-2))
    print(small.saturating_mul(-1))
    print(3.saturating_mul(4))
