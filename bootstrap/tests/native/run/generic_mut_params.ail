## A generic function with `mut` scalar parameters takes them as cells and
## writes them back (own.mut.2, gen.infer.1).
fn swap[T](mut a T, mut b T)
    t := a
    a = b
    b = t

fn main()
    mut xs := [1, 2, 3]
    i := 1
    j := 2
    swap(mut xs[i], mut xs[j])
    print(xs)
    mut p := 1
    mut q := 2
    swap(mut p, mut q)
    print("{p} {q}")
