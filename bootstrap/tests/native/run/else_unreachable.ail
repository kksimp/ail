fn first(xs List[int]) int
    xs.get(0) else unreachable("empty")

fn parse(s str) int
    n := s.to_int() else unreachable("not a number: {s}")
    n + 1

fn pick(opt int?) int
    opt else unreachable("none")

fn main()
    print(first([7, 8]))
    print(parse("41"))
    print(pick(5))
    m := Map[str, int]()
    m["a"] = 3
    print(m.get("a") else unreachable("no key"))
