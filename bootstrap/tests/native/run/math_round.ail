fn main()
    print(2.5.round())
    print((-2.5).round())
    print(0.49999999999999994.round())
    print((-0.49999999999999994).round())
    print((-0.5).round())
    print(0.5.round())
    print((-0.2).round())
    print(0.2.round())
    print((-0.0).round())
    print(0.0.round())
    print(1e300.round())
    print((-1e300).round())
    print(4503599627370497.5.round())
    print((-4503599627370497.5).round())
    print((1.0 / 0.0).round())
    print((-1.0 / 0.0).round())
    print((0.0 / 0.0).round())
    mut x := 1.0
    for i in 1..60
        x = x * 1.37 - 0.5 * i.to_float()
        print(x.round())
        print((x / 7.0).round())
        print((-x / 3.0).round())
    print(-1.0 * (0.0 - 0.0).round() / 1.0)
    print(7.0.round().to_int())
