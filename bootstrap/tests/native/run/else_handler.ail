## `else` with a block on an absent value (err.else.1-3): the block leaves, or
## ends in the replacement value; for `to_int`, `pop` and `get`.
fn parse(text str) int
    n := text.to_int() else
        print("bad number {text}")
        return -1
    n * 2

fn fallback(text str) int
    n := text.to_int() else
        print("defaulting {text}")
        99
    n

fn last(xs List[int]) int
    mut ys := xs
    v := ys.pop() else
        print("empty")
        -5
    v

fn find(m Map[str, int], key str) int
    v := m.get(key) else
        print("no {key}")
        return 0
    v + 1

fn main()
    print(parse("21"))
    print(parse("x"))
    print(fallback("7"))
    print(fallback("y"))
    print(last([1, 2, 3]))
    print(last([]))
    m := {"a": 1}
    print(find(m, "a"))
    print(find(m, "b"))
    total := 5 + (fallback("z"))
    print(total)
