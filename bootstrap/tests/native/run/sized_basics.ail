# Sized integers: conversions, comparison, printing (type.num.13-15).
fn widen(a u8, b i8, c u16, d i32, e u32) int
    a.to_int() + b.to_int() + c.to_int() + d.to_int() + e.to_int()

fn pick(n int) u8
    n.to_u8()

fn show(a u8, b i8) str
    "a={a} b={b}"

fn main()
    print(widen(200.to_u8(), (0 - 5).to_i8(), 65535.to_u16(), (0 - 7).to_i32(), 4000000000.to_u32()))
    x := pick(255)
    y := pick(3)
    print(x > y)
    print(x == y)
    print(show(x, (0 - 128).to_i8()))
    print(x)
