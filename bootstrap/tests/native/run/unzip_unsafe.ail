# compress.unzip refuses unsafe names before writing, and checks CRC-32 (std.compress.5).
fn try(label str, z bytes)
    fs.write_bytes("/tmp/ail_unzip_case.zip", z) else err
        print("write {err.kind}")
        return
    compress.unzip("/tmp/ail_unzip_case.zip", "/tmp/ail_unzip_case_out") else err
        print("{label} {err.kind} {err.message}")
        return
    print("{label} ok")

