fn scale(mut x float, k float)
    x = x * k

fn grow(mut xs List[float], mut total float)
    for v in xs
        total += v
    xs.push(total)

struct Acc
    sum float

fn main()
    mut a := 1.5
    scale(mut a, 4.0)
    print(a)
    mut r := Acc(sum: 2.0)
    scale(mut r.sum, 2.5)
    print(r.sum)
    mut fs := [1.0, 2.0]
    scale(mut fs[1], 3.0)
    print(fs)
    mut t := 0.0
    grow(mut fs, mut t)
    print(t)
    print(fs)
