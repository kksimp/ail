# std.tensor.6: `int` tensors add and multiply with checks; argmax, round
# and the other int-valued results.
fn counts() tensor.Tensor[int]
    return tensor.zeros([2, 3])

fn main()
    a := tensor.from([1, 2, 3, 4, 5, 6], [2, 3])
    b := tensor.from([6, 5, 4, 3, 2, 1], [2, 3])
    print(a)
    print(counts())
    print(a + b)
    print(a - b)
    print(a * b)
    print(a * 3)
    print(10 - a)
    print(-a)
    print(a.sum())
    print(a.max())
    print(a.dot(b))
    print(a.matmul(b.transpose()))
    print(a.sum(0))
    print(a.sum(1))
    print(a.max(0))
    print(a.max(1))
    print(a.add(b).mul(a))
    print(a[1])
    print(a[1][2])
    print(a[1][2].item())
    print(a[0..1])
    print(a.reshape([3, 2]))
    print(a.to_list())
    print(a.shape())
    print(a == b)
    print(a == a + counts().reshape([2, 3]))
    c := tensor.from([0.5, 2.5, -1.5, 3.4, 0.0 - 0.4, 7.5], [2, 3])
    print(c.round())
    print(c.argmax())
    print(c.argmin())
    print(c.argmax(0))
    print(c.argmin(1))
    print(a.argmax(1))
    print(a.argmin())
    print(a + tensor.from([10, 20, 30]))
    print(tensor.from([5, 3, 9, 1]).argmax())
