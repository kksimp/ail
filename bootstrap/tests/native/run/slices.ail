# List slices (ADR 0394): open and inclusive ranges, deep copies of nested
# lists, `List[bool]`, and the interpreter's trap.
fn main()
    xs := [1, 2, 3, 4, 5]
    print(xs[1..])
    print(xs[..2])
    print(xs[1..=3])
    print(xs[5..])
    nested := [[1], [2, 3]]
    mut ys := nested[1..]
    ys[0].push(9)
    print(nested)
    print(ys)
    bs := [true, false, true]
    print(bs[1..])
    n := 3
    print(xs[n..n + 3])
