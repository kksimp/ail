# Strings as values: interpolation, the text of numbers, comparison, and
# the methods (type.str.3-14).
fn label(name str, n int) str
    "{name}#{n}"

fn shout(s str) str
    "{s.to_upper()}!"

fn main()
    a := label("job", 7)
    b := label("job", -12)
    print(a)
    print(b)
    print(shout("hey"))
    print(a == "job#7")
    print(a != "job#7")
    print(a == b)
    print("" == "")
    print("abcdefghij" == "abcdefghij")
    print("abcdefghij" == "abcdefghik")
    print("abcdefghij" < "abcdefghik")
    print("abcdefghik" <= "abcdefghij")
    print("ab" < "abc")
    print("abc" > "ab")
    print("b" > "abc")
    print("é" > "z")
    print("x" >= "x")
    print((-9223372036854775807 - 1).to_str())
    print(9223372036854775807.to_str())
    print(0.to_str())
    print(1.5.to_str())
    print(true.to_str())
    print(1e20.to_str())
    print("{1.0}{2.5}{0.1}{-0.0}")
    print("{true} {false}")
    t := "{1}{2}{3}"
    print(t)
    print(t.len())
    print("".len())
    u := "\{"
    print(u.len())
    print("hello world".contains("o w"))
    print("hello world".contains("ow"))
    print("hello".contains(""))
    print("hello".starts_with("he"))
    print("hello".starts_with("hello!"))
    print("hello".starts_with(""))
    print("hello".ends_with("llo"))
    print("hello".ends_with("hhello"))
    print("hello".ends_with('o'))
    print("hello".contains('l'))
    print("hello".replace("l", "L"))
    print("hello".replace("ll", ""))
    print("hello".replace("hello", "goodbye"))
    print("aaa".replace("aa", "b"))
    print("hello".replace("z", "y"))
    print("a,b,,c,".split(","))
    print("".split(","))
    print("abc".split("abc"))
    print("a--b--c".split("--"))
    print("a b".split(' '))
    print("  \t pad \n ".trim())
    print("   ".trim().len())
    print("x".trim())
    print("l1\nl2\r\nl3\n".lines())
    print("a\n\n".lines())
    print("".lines())
    print("a\r".lines())
    print("hello".slice(1, 3))
    print("hello".slice(0, 0))
    print("hello".slice(5, 5))
    print("hello".slice(0, 5))
    print("ab".repeat(3))
    print("ab".repeat(0))
    print("".repeat(5))
    print("5".pad_left(3, '0'))
    print("5".pad_right(3, '.'))
    print("long".pad_left(2, '0'))
    print("x".pad_left(0, '-'))
    print("x".pad_left(-3, '-'))
    print("é".pad_left(3, 'ñ'))
    print("Hello, World".to_lower())
    print("Hello, World".to_upper())
    parts := "k=v".split("=")
    print(parts.len())
    print(parts[0])
    print(parts[1])
    joined := parts.join("::")
    print(joined)
    words := "the quick brown fox".split(" ")
    mut total := 0
    for w in words
        total += w.len()
    print(total)
    print("{words.len()} words, {total} letters")
