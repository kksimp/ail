# std.tensor.15-18: indexing, slices, item, clamp, argmax, conv2d.
fn series(n int) List[float]
    [((i * 7) % 11).to_float() * 0.25 - 1.0 for i in 0..n]

fn main()
    t := tensor.from(series(6))
    print(t[1])
    print(t[1].item())
    print(t[1..4])
    print(t[..2])
    print(t[3..])
    print(t[2..=3])
    m := tensor.from(series(12), [3, 4])
    print(m[1])
    print(m[1][2])
    print(m[1][2].item())
    print(m[1..3])
    print(m[1..3].shape())
    print(m.clamp(-0.5, 1.0))
    print(m.argmax())
    print(m.argmin())
    print(tensor.from([1.0, 0.0 / 0.0, 3.0, 3.0]).argmax())
    img := tensor.from(series(8 * 11), [8, 11])
    k := tensor.from([0.5, -1.0, 0.25, 2.0, 0.0, 1.5], [2, 3])
    c := img.conv2d(k)
    print(c.shape())
    print(c.sum())
    print(c[2])
    print(img.conv2d(img).shape())
