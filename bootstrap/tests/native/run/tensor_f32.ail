# std.tensor.21-22: Tensor[f32] holds float elements rounded to f32 after
# every operation. Values here are not exact in f32, so a missed rounding
# shows in the printed digits.
fn show(t tensor.Tensor[f32])
    print(t.to_float().to_list())

fn half() tensor.Tensor[f32]
    tensor.from([0.1, 16777217.0, 3.4028236e38, 1.0e-45, -2.5, 7.0e-46], [2, 3]).to_f32()

fn main()
    a := half()
    show(a)
    show(a * 3.0)
    show(0.1 + a)
    show(a / 3.0)
    show(a - a)
    show(-a)
    show(a + a)
    show(a * a)
    show(a.transpose())
    print(a.shape())
    print(a.len())
    b := tensor.from([0.3, 1.1, 2.7, -4.3, 0.7, 9.9], [3, 2]).to_f32()
    show(a.matmul(b))
    show(b.matmul(tensor.from([0.1, 0.2, 0.3, 0.4], [2, 2]).to_f32()))
    c := tensor.from([-3.3, -0.0, 0.0, 0.7, 2.2, 40.0]).to_f32()
    show(c.relu())
    show(c.sigmoid())
    show(c.tanh())
    show(c.add(c).mul(c))
    print(c == c)
    print((c * 1.0000001) == c)
    x := tensor.from([1.5, 2.5]).to_f32().to_float()
    print(x + 0.1)
