# Sized checked_* and to_float natively (type.num.12, type.num.14-15).
fn main()
    w := 250.to_u8()
    print("{w.wrapping_add(10.to_u8())} {w.checked_add(10.to_u8())} {w.saturating_add(10.to_u8())}")
    print("{w.checked_sub(251.to_u8())} {w.wrapping_sub(251.to_u8())} {w.checked_div(0.to_u8())}")
    s := 127.to_i8()
    print("{s.wrapping_add(1.to_i8())} {s.saturating_add(1.to_i8())} {s.checked_neg()} {s.wrapping_neg()}")
    h := 2166136261.to_u32()
    print("{h.wrapping_mul(16777619.to_u32())} {h.to_int()} {h.to_float()} {h.to_hex()}")
    f := 2.5.to_f32()
    print("{f} {f.round()} {f.to_int()} {f.sqrt()} {(0.1).to_f32() + (0.2).to_f32()}")
    print("{(-5).to_i8().to_i16()}")
    a := 100.to_i8()
    print("{a.checked_mul(2.to_i8())} {a.checked_add(27.to_i8())} {a.checked_sub((-128).to_i8())}")
    m := (-128).to_i8()
    print("{m.checked_div((-1).to_i8())} {m.checked_neg()} {m.checked_rem(0.to_i8())} {a.checked_rem(7.to_i8())}")
    u := 4000000000.to_u32()
    print("{u.checked_mul(2.to_u32())} {u.checked_add(294967295.to_u32())} {u.checked_div(3.to_u32())}")
