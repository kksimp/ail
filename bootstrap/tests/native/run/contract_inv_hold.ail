# contract.inv.1-3: invariants hold after construction and after every
# `mut self` method.
struct Account
    balance int
    limit int
    invariant balance >= 0
    invariant balance <= limit

fn Account.deposit(mut self, n int)
    balance += n

fn Account.room(self) int
    limit - balance

fn main()
    mut a := Account(balance: 5, limit: 10)
    a.deposit(3)
    print(a.room())
