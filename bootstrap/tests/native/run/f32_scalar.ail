# Scalar f32: arithmetic rounds to f32 after every operation, and prints as the shortest f32 text (type.num.13-15).
fn add(a f32, b f32) f32
    a + b

fn scale(a f32) f32
    a * 2

fn tenth() f32
    0.1

fn less(a f32, b f32) bool
    a < b

fn flip(a f32) f32
    -a

struct Pt
    x f32
    y f32

fn norm(p Pt) f32
    (p.x * p.x + p.y * p.y).sqrt()

fn main()
    t := 0.1.to_f32()
    print(add(t, 0.2.to_f32()))
    print(scale(t))
    print(tenth())
    print(less(1.0.to_f32(), 2.0.to_f32()))
    print(flip(3.0.to_f32()))
    big := 1e10.to_f32()
    print(big)
    print(big * big * big * big)
    print(3.to_f32())
    print(9007199254740993.to_f32())
    print(16777217.to_f32())
    print((0 - 9223372036854775807).to_f32())
    y := 2.0.to_f32()
    print("{y} {y:.3} {t:.9}")
    print(y.sqrt())
    print(y.to_float())
    print(t.to_float())
    print(y.to_int())
    print(y == 2.0.to_f32())
    print(norm(Pt(x: 3.0.to_f32(), y: 4.0.to_f32())))
    print(1e-40.to_f32())
    print(3.4e38.to_f32() * 10.to_f32())
    print(1.5.to_f32().floor())
    print((0 - 2.5).to_f32().round())
    print(200.to_u8().to_f32())
    s := "{add(t, t)}"
    print(s)
