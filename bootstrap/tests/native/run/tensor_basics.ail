# std.tensor.1-3, std.tensor.9: building a tensor, its shape, its elements and
# its text form; == on tensors.
fn main()
    a := tensor.from([1, 2, 3, 4, 5, 6], [2, 3])
    b := tensor.from([1.5, -2.0, 0.0])
    c := tensor.from([1, 2, 3, 4, 5, 6], [2, 3])
    print(a.shape())
    print(a.len())
    print(a.to_list())
    print(b.to_list())
    print(a)
    print(b)
    print("text {b}")
    print(a == c)
    print(a != c)
    print(a == tensor.from([1, 2, 3, 4, 5, 6], [3, 2]))
    print(b == tensor.from([1.5, -2.0, 0.0]))
    print(b == tensor.from([1.5, -2.0, 1.0]))
    inf := 1.0 / 0.0
    nan := inf - inf
    print(tensor.from([nan]) == tensor.from([nan]))
    print(tensor.from([0.0]) == tensor.from([-0.0]))
    e := tensor.from([1.0, 2.0, 3.0, 4.0], [2, 2])
    print(e.shape().len())
    z := tensor.from([1.0], [])
    print(z.shape())
    print(z)
