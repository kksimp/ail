# std.tensor.1-9: building tensors, their methods, text form and equality.
fn main()
    a := tensor.from([1.0, 2.0, 3.0, 4.0], [2, 2])
    b := tensor.from([5.0, 6.0, 7.0, 8.0], [2, 2])
    print(a)
    print(a.shape())
    print(a.sum())
    print(a.dot(b))
    print(a.add(b))
    print(a.mul(b))
    print(a.matmul(b))
    print(a.map(|x| x * 10.0))
    v := tensor.from([1, 2, 3])
    print(v.sum())
    print(v.map(|x| x * x).to_list())
    print(a.map(|x| x.round()).to_list())
    print(v.map(|x| x.to_float() / 2.0))
    s := 3
    print(v.map(|x| x + s).to_list())
    print(a == a.map(|x| x))
    print(a.reshape([4]).len())
