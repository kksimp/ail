# std.tensor.1-13 on float tensors: construction, reductions, elementwise
# operators with broadcasting, scalars, matmul, transpose, relu, text.
fn counts() tensor.Tensor[float]
    return tensor.zeros([2, 3])

fn main()
    a := tensor.from([1.0, 2.0, 3.0, 4.0], [2, 2])
    b := tensor.from([5.0, 6.0, 7.0, 8.0], [2, 2])
    print(a)
    print(a.shape())
    print(a.sum())
    print(a.dot(b))
    print(a.add(b))
    print(a.mul(b))
    print(a.matmul(b))
    print(counts())
    print(tensor.zeros([3]))
    print(a == a.add(tensor.zeros([2, 2])))
    print(a == b)
    print(a.reshape([4]).len())
    print(a + b)
    print(a - b)
    print(a * b)
    print(b / a)
    print(a * 2.0)
    print(2 * a)
    print(1.0 - a)
    print(10.0 / a)
    print(-a)
    print(a.transpose())
    print(tensor.from([-1.0, 0.5, -0.0, 3.0]).relu())
    print(a.max())
    print(a.mean())
    row := tensor.from([10.0, 20.0])
    print(a + row)
    print(tensor.from([1.0, 2.0, 3.0]) * tensor.from([1.0, 2.0], [2, 1]))
