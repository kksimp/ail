fn main()
    xs := [5, 3, 9, 1, 3, 7]
    print(xs.sorted())
    print(xs.sorted(by: |x| -x))
    print(xs)
    shift := 4
    print(xs.sorted(by: |x| (x - shift) * (x - shift)))
    fs := [2.5, -1.0, 9.25]
    print(fs.sorted(by: |f| f.to_int() * -1))
    words := ["pear", "fig", "banana", "kiwi", "apple"]
    print(words.sorted(by: |w| w.len()).join(","))
    empty := List[int]()
    print(empty.sorted(by: |x| x))
    one := [4]
    print(one.sorted())
    mut ys := [3, 1, 2, 1, 3, 2]
    ys.sort()
    print(ys)
    ys.sort(by: |y| -y)
    print(ys)
    mut big := List[int]()
    for i in 0..1000
        big.push((i * 7919) % 1009)
    s := big.sorted()
    mut ok := true
    for i in 1..s.len()
        if s[i - 1] > s[i]
            ok = false
    print(ok)
    print([s[0], s[999]])
    t := big.sorted(by: |v| v % 10)
    print([t[0], t[1], t[999]])
