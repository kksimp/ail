# lex.str.7, type.str.11: width, fill, alignment, `.N` and `x`; type.num.8.
fn main()
    n := 255
    r := 3.14159
    print("[{n:>6}][{n:<6}][{n:^6}][{n:x}][{n:0>4x}][{-n:x}]")
    print("[{r:.2}][{r:8.3}][{r:>8.1}][{r:*<9.2}][{-r:.0}][{2.5:.0}][{3.5:.0}]")
    print("[{"ab":^6}][{"ab":*<5}][{"ab":>1}][{"héé":-^7}]")
    print("[{true:>6}][{false:<6}][{n:5}]")
    print("{0.1}{1e22}{5e-324}{-0.0}{1.5e300}{123456789012345678.0}")
    print("{0.1 + 0.2}{1.0 / 3.0}{100.0}{1e16}{0.0001}{0.00001}")
    print("[{-9223372036854775807 - 1:x}][{0:x}][{4096:x}]")
    inputs := ["2.5E-3", "1e999", "-0", "+1", ".5", "5.", "1e", "0.1", "123456789012345678901234567890", "4.9e-324", "2.4e-324", "2.5e-324", "1.7976931348623157e308", "1.7976931348623159e308", "9007199254740993", "inf", "-inf", "nan", "0.000001", "1e-7", "00012.50", "1_000", ""]
    for s in inputs
        x := s.to_float() else
            print("{s}: none")
            continue
        print("{s}: {x}")
