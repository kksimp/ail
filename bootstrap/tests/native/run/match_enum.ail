# `match` on enums (ADR 0603): bindings, `_` fields, bare variants with
# data, `|`, guards on bindings, qualified patterns, nested matches and
# statements in arms. `@allow` (a lint setting) doesn't change the code.
enum Expr
    Num(n int)
    Neg(e Expr)
    Add(a Expr, b Expr)
    Mul(a Expr, b Expr)
    Var(name str)
    Zero

enum Color
    Red
    Green
    Blue

fn eval(e Expr, x int) int
    match e
        Num(n) => n
        Neg(inner) => -eval(inner, x)
        Add(a, b) => eval(a, x) + eval(b, x)
        Mul(a, b) =>
            l := eval(a, x)
            if l == 0
                return 0
            l * eval(b, x)
        Var(name) if name.len() == 1 => x
        Var(_) => 0
        Zero => 0

fn kind(e Expr) str
    match e
        Num | Zero => "atom"
        Expr.Var(_) => "var"
        Add | Mul => "binary"
        Neg(_) => "unary"

fn is_small(e Expr) bool
    match e
        Num(n) if n < 10 => true
        Num | Neg | Add | Mul | Var | Zero => false

fn next(c Color) Color
    match c
        Red => Green
        Green => Blue
        Blue => Red

@allow("expr.match.3")
fn name(c Color) str
    match c
        Color.Red => "red"
        _ => "cool"

fn main()
    e := Expr.Add(a: Expr.Mul(a: Num(3), b: Var("x")), b: Neg(Num(4)))
    print(eval(e, 5))
    print(eval(Mul(a: Zero, b: Var("yy")), 9))
    print(eval(Add(a: Var("long"), b: Var("z")), 9))
    for t in [e, Num(1), Zero, Var("q"), Neg(Zero)]
        print(kind(t))
    print(is_small(Num(3)))
    print(is_small(Num(30)))
    print(is_small(Zero))
    mut c := Color.Red
    for _ in 0..4
        c = next(c)
        print(name(c))
    print(c == Green)
    match e
        Add(l, _) =>
            match l
                Mul(_, r) => print(kind(r))
                Num | Neg | Add | Var | Zero => print("other")
        Num | Neg | Mul | Var | Zero => print("no")
