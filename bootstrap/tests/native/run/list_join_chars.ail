# type.coll.9: `join` on a list of characters, with a separator and non-ASCII.
fn main()
    mut line := List[char]()
    line.push('a')
    line.push('b')
    print(line.join(""))
    line.push('é')
    line.push('€')
    line.push('😀')
    print(line.join("-"))
    print(List[char]().join(","))
    mut one := List[char]()
    one.push('z')
    print(one.join("++"))
    print(line.join("é").len())
