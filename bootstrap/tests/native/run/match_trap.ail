# A trap inside a `match` arm reports the arm's position (ADR 0603).
enum Step
    Take(i int)
    Skip

fn run(steps List[Step], xs List[int]) int
    mut total := 0
    for s in steps
        match s
            Take(i) => total += xs[i]
            Skip => continue
    total

fn main()
    xs := [10, 20, 30]
    print(run([Step.Take(0), Skip, Take(2)], xs))
    print(run([Take(1), Take(3)], xs))
