fn double(n int) int
    n * 2

fn square(n int) int
    n * n

fn half(x float) float
    x / 2.0

fn show(n int)
    print("show {n}")

fn apply(f fn(int) int, x int) int
    f(x)

fn twice(f fn(int) int, x int) int
    f(f(x))

fn pick(which int) fn(int) int
    if which == 0
        double
    else
        square

fn each(f fn(int), n int)
    for i in 0..n
        f(i)

fn many(f fn(int, float, int) float, a int) float
    f(a, 1.5, a + 1)

fn mix(a int, b float, c int) float
    a.to_float() * b + c.to_float()

fn main()
    f := double
    print(f(21))
    print(apply(square, 7))
    print(twice(double, 5))
    print(pick(0)(8))
    print(pick(1)(8))
    g := half
    print(g(5.0))
    each(show, 3)
    print(many(mix, 4))
    mut total := 0
    for k in 0..5
        h := if k % 2 == 0 then double else square
        total += h(k)
    print(total)
