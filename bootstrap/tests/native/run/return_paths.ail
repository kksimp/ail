# A function that returns through one shared point on a path that calls and
# on a path that doesn't (ADR 0816): each path returns on its own, and the
# values the calling path keeps across calls come back right.
fn tree(mut a List[int], mut b List[int], depth int) int
    node := a.len()
    a.push(-1)
    b.push(-1)
    if depth > 0
        l := tree(mut a, mut b, depth - 1)
        r := tree(mut a, mut b, depth - 1)
        a[node] = l
        b[node] = r
    node

fn count(a List[int], b List[int], node int) int
    if a[node] < 0
        return 1
    1 + count(a, b, a[node]) + count(b, a, b[node])

fn pick(n int, k int) int
    # The result is a different value on each path to the one return.
    mut r := k
    if n > 0
        r = pick(n - 1, k + 1) + n
    elif n < -5
        r = k * 2
    r

fn collatz_depth(n int, steps int) int
    if n == 1
        return steps
    next := if n % 2 == 0 then n / 2 else 3 * n + 1
    collatz_depth(next, steps + 1)

fn three(a int, b int, c int, d int) int
    # Four values live across the calls.
    mut t := 0
    if a > 0
        x := three(a - 1, b + 1, c, d)
        y := three(a - 1, b, c + 1, d)
        t = x + y + a * b + c * d
    else
        t = a + b + c + d
    t

fn main()
    mut a := List[int]()
    mut b := List[int]()
    root := tree(mut a, mut b, 8)
    print(root)
    print(a.len())
    print(count(a, b, root))
    print(pick(5, 1))
    print(pick(0, 7))
    print(pick(-9, 7))
    print(pick(-2, 7))
    print(collatz_depth(27, 0))
    print(three(6, 1, 2, 3))
    print(three(0, 1, 2, 3))
