fn main()
    a := b"\x89PNG\r\n\x1a\n"
    print(a.len())
    print(a.hex())
    print(a[0].to_int())
    print(a[7].to_int())
    print(a[1..4].text())
    print(a[1..=3].hex())
    print(a[..2].hex())
    print(a[6..].hex())
    print(a == b"\x89PNG\r\n\x1a\n")
    print(a != b"\x89PNG")
    print(a[1..4] == b"PNG")
    print(b"".len())
    print(b"".text().len())
    s := b"caf\xc3\xa9 \xe2\x82\xac"
    print(s.text())
    print(s.hex())
    bad := b"a\xffb\xc3(\xe0\x80\x80\xf0\x9f\x92"
    print(bad.text())
    print(bad.text().len())
    print(b"\xed\xa0\x80\xf4\x90\x80\x80".text().len())
    mut total := 0
    mut i := 0
    while i < a.len()
        total += a[i].to_int()
        i += 1
    print(total)
