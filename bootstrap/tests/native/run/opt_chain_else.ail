struct Owner
    name str
    pos int

struct F
    owner Owner?
    pos int

fn label(f F) str
    f.owner?.name else "none"

fn where(f F) int
    at := f.owner?.pos else f.pos
    at

fn flag(o Owner?) bool
    (o?.pos > 3 else false)

fn main()
    a := F(Owner("x", 7), 1)
    b := F(none, 2)
    print(label(a))
    print(label(b))
    print(where(a))
    print(where(b))
    print(flag(Owner("y", 5)))
    print(flag(none))
