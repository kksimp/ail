# `std.tz` in a native build (std.tz.1-3, ADR 0840): offsets from the
# platform's TZif files agree with the interpreter's, before and after the
# last transition (the POSIX rule of the footer).
use std.tz

fn show(zone str, secs int)
    if off := tz.offset(zone, secs)
        print("{zone} {secs} {off}")
    else
        print("{zone} {secs} none")

fn main()
    zones := ["UTC", "Europe/Paris", "America/New_York", "Asia/Kolkata", "Australia/Sydney", "Pacific/Auckland", "America/Sao_Paulo", "Not/AZone", "../etc/passwd", ""]
    times := [0, 951782400, 1700000000, 1783000000, 1790000000, 4102444800, 4118000000, -2000000000]
    for z in zones
        for t in times
            show(z, t)
    print(tz.system().len() > 0)
