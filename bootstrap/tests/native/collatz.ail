# MIR of a loop with a value `if`, a call and checked arithmetic (ADR 0384).
fn steps(n int) int
    mut x := n
    mut k := 0
    while x != 1
        x = if x % 2 == 0 then x / 2 else 3 * x + 1
        k += 1
    k

fn main()
    mut total := 0
    for i in 1..=10
        total += steps(i)
    print("total {total}")
