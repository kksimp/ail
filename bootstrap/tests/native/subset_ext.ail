# The edges of the subset's newer pieces: `else` on a binding only after
# `s.to_int()`, `s.to_float()` and the OS calls, format specifications only
# on numbers, `bool` and `str` (native.subset.1). A computed constant is fine
# (ADR 0604).
LIMIT := 2 * 8
SCALE := LIMIT.abs()

fn pick(s str) int
    n := s.find("x") else 0
    n

fn main()
    x := 2.5
    print("{x:.2} {x:>8} {[1, 2]:>8}")
    print(LIMIT)
    print(pick("1.5"))
