# The edges of the subset's newer pieces: `else` on a binding only after
# `s.to_int()`, `{x:.N}` only on a float, constants only of constant
# expressions (native.subset.1).
LIMIT := 2 * 8
SCALE := LIMIT.abs()

fn pick(s str) float
    n := s.to_float() else 0.0
    n

fn main()
    x := 2.5
    print("{x:.2} {x:>8}")
    print(LIMIT)
    print(pick("1.5"))
