# The edges of the OS calls in the native subset (ADR 0580): the error
# of a failing call is a typed value, `?` needs a function that can fail, and an
# optional is not printed.
fn plain() str
    text := fs.read_text("x")?
    text

fn main()
    other := fs.read_text("y") else err
        print(err.kind)
        ""
    print(other)
    n := io.read_line()
    print(n)
    print(plain())
