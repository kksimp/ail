# std.json: errors carry the character offset (json.err.1)
fn show(text str)
    if v := parse_json(text)
        print("ok {v.to_text()}")
    else err
        print("{err.at}: {err.message}")

fn main()
    show("")
    show("[1, 2,]")
    show("[1 2]")
    show("\{\"a\" 1}")
    show("\"abc")
    show("[1] x")
    show("01")
    show("-")
    show("1.")
    show("\"\\ud83d\"")
    show("\"\\u12G4\"")
    show("\"\\q\"")
    show("tru")
