# std.tensor.21-23 on Tensor[f32]: reductions, activations, indexing, top2, conv2d.
fn scale(t tensor.Tensor[f32], k float) tensor.Tensor[f32]
    t * k

fn main()
    xs := [1.5, 2.5]
    t := tensor.from(xs).to_f32()
    print(t)
    print(scale(t, 2.0))
    u := tensor.from([0.1, 0.2, 0.3], [3]).to_f32()
    print(u.sum())
    print(u.mean())
    print(u.max())
    print(u.dot(u))
    print(u.softmax().sum())
    print((u * u).relu().sigmoid().tanh())
    print(u.reshape([3, 1]).matmul(u.reshape([1, 3])))
    print(u[1].item())
    print(u.argmax())
    print(u.round())
    print(u.clamp(0.15, 0.25))
    print(u.map(|v| v + v))
    print(u.map(|v| v.to_float().to_int()))
    w := tensor.from_fn([2, 2], |i| i.to_float() * 0.1)
    print(w.to_f32().conv2d(tensor.from([1.0], [1, 1]).to_f32()))
    a, b, c := w.to_f32().top2(0)
    print(c)
    n := 3
    v := tensor.zeros([n, 2])
    print(v.shape())
    print(tensor.from([1, 2, 3]).sum() + tensor.from([4, 5, 6]).dot(tensor.from([1, 1, 1])))
    print(tensor.from([2.0, 4.0]).mean(0))
    print(tensor.from([1.0, 2.0, 3.0, 4.0], [2, 2]).max(0))
    print(tensor.from([1.0, 2.0, 3.0, 4.0], [2, 2]).argmin(1))
