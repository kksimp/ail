## Enums with payloads are written and read as {"kind": "Name", fields...}; unit variants as their name (json.derive.1-3).
enum Shape
    Dot
    Circle(r float, label str?)
    Poly(points List[Point])

struct Point
    x int
    y int

struct Scene
    shapes List[Shape]

impl ToJson for Shape
impl FromJson for Shape
impl ToJson for Point
impl FromJson for Point
impl ToJson for Scene
impl FromJson for Scene

fn main()
    s := Scene(shapes: [Shape.Dot, Shape.Circle(2.0, "a"), Shape.Poly([Point(x: 1, y: 2)])])
    text := s.to_json().to_text()
    print(text)
    doc := parse_json(text) else return
    back := Scene.from_json(doc) else err
        print("failed: {err.message}")
        return
    print(back == s)
    dot := parse_json("\{\"kind\": \"Dot\"}") else return
    d := Shape.from_json(dot) else return
    print(d)
    for bad in [
        "\{\"shapes\": [\"Dot\", \{\"kind\": \"Circle\"}]}",
        "\{\"shapes\": [\{\"kind\": \"Box\"}]}",
        "\{\"shapes\": [\{\"r\": 1}]}",
        "\{\"shapes\": [\{\"kind\": 3}]}",
        "\{\"shapes\": [\{\"kind\": \"Poly\", \"points\": [\{\"x\": 1, \"y\": 2}, \{\"x\": 1}]}]}",
        "\{\"shapes\": [7]}",
    ]
        j := parse_json(bad) else return
        x := Scene.from_json(j) else err
            print(err.message)
            continue
        print(x)
