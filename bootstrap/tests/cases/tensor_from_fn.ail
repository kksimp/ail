fn main()
    print(tensor.from_fn(4, |i| i.to_float() * 0.5))
    print(tensor.from_fn([2, 3], |i| i * i))
    print(tensor.from_fn([2, 2], |i| (i % 2).to_float()).sum(0))
    f := tensor.from_fn([3], |i| i.to_float()).to_f32()
    print(f)
    print(tensor.from_fn(0, |i| i).len())
    print(tensor.from_fn([2, 0], |i| i.to_float()).shape())
    t := tensor.from_fn([2, 2], |i| 10 - i)
    print(t.max())
    print(tensor.from_fn(5, |i| (i % 3).to_float()).softmax().sum() > 0.99)
