struct V
    a int
    b int

impl Ord for V
    fn cmp(self, other Self) Ordering
        other.a.cmp(self.a)

fn main()
    print([1, 2] < [1, 3])
    print([1, 2] < [1, 2])
    print([1, 2] <= [1, 2])
    print([1, 2] < [1, 2, 0])
    print([1, 2, 0] < [1, 2])
    print([2] > [1, 9])
    print(["a", "b"] < ["a", "c"])
    print([1.5, 2.0] >= [1.5, 1.0])
    print([[1], [2]] < [[1], [3]])
    print(List[int]() < [1])
    print([(1, "a")] < [(1, "b")])
    print([V(a: 1, b: 0)] < [V(a: 2, b: 0)])
    print([V(a: 3, b: 0)] < [V(a: 2, b: 0)])
    xs := [[3, 1], [1, 5], [1, 2], [2]]
    print(xs.sorted())
    print(xs.min())
    print(xs.max())
