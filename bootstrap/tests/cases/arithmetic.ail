fn main()
    print(2 + 3 * 4)
    print((2 + 3) * 4)
    print(10 - 4 - 3)
    print(100 / 10 / 5)
    print(7 / 2)
    print(-7 / 2)
    print(7 % 3)
    print(-7 % 2)
    print(7 % -2)
    print(-2 * -3)
    print(-(4 - 10))
    print(9223372036854775807)
    min := -9223372036854775807 - 1
    print(min % -1)
    print(1 == 1 and 2 != 3)
    print("a" == "a")
    print("a" != "a")
    print(true == false)
    total := 1 +
        2 +
        3
    print(total)
