# Tuples (type.tuple.1-9): literals, element access, destructuring,
# `for` over pairs, patterns, ordering, hashing, `zip` and `enumerate`.
struct P
    name str
    age int

fn divmod(a int, b int)(int, int)
    (a / b, a % b)

fn main()
    t := (1, "a")
    print(t)
    print(t.0)
    q, r := divmod(17, 5)
    print("{q} {r}")
    mut p := (1, 2)
    p.0 = 10
    print(p)
    a, mut b := p
    b += 1
    print("{a} {b}")
    ages := {"ann": 31, "bob": 25}
    for name, age in ages
        print("{name} is {age}")
    pairs := [(3, "c"), (1, "b"), (1, "a")]
    print(pairs.sorted())
    print([n for n, _ in pairs])
    s := {(1, 2), (1, 2), (2, 1)}
    print(s.len())
    m := {(0, 0): "origin"}
    print(m[(0, 0)])
    match (1, "x")
        (0, _) => print("zero")
        (n, s2) => print("{n} {s2}")
    nested := ((1, 2), 3)
    print(nested.0.1)
    print((1, 2) < (1, 3))
    print((1, "a") == (1, "a"))
    xs := ["a", "b", "c"]
    for i, x in xs.enumerate()
        print("{i}: {x}")
    for n, x in zip([1, 2, 3], xs)
        print("{n}{x}")
    print(zip(xs, [1]))
    ps := [P(name: "b", age: 3), P(name: "a", age: 3), P(name: "c", age: 1)]
    for one in ps.sorted(by: |one| (one.age, one.name))
        print(one.name)
    inv := {v: k for k, v in {"x": 1, "y": 2}}
    print(inv)
