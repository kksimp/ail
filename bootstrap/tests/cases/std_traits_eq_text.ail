# Split from std_traits (ADR 0725). Original rules: trait.std.1-4, trait.derive.1,
# trait.auto.1-3, expr.cmp.1.
# This part: `==` on enums, structs and lists, and the text forms.
enum Dir
    North
    East
    South
    West

impl ToStr for Dir
    fn to_str(self) str
        match self
            North => "N"
            East => "E"
            South => "S"
            West => "W"

struct Move
    dir Dir
    steps int

struct Point
    x int
    y int

struct Name
    text str
    id int

impl Eq for Name
    fn eq(self, other Self) bool
        self.text == other.text

fn count[T Eq](items List[T], x T) int
    mut n := 0
    for y in items
        if y == x
            n += 1
    n

fn main()
    d := Dir.East
    print(d == East)
    print(d != West)
    print("{d} {[Dir.North, South]}")
    print(Move(dir: West, steps: 3))
    p := Point(x: 1, y: 2)
    print(p == Point(x: 1, y: 2))
    print(p == Point(x: 2, y: 1))
    print(Name(text: "ab", id: 1) == Name(text: "ab", id: 2))
    print(count(
        [Name(text: "x", id: 1), Name(text: "y", id: 2), Name(text: "x", id: 3)],
        Name(text: "x", id: 0),
    ))
    print([d, North] == [East, North])
