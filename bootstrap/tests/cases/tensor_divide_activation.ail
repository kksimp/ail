# std.tensor.10, std.tensor.13: `/` on float tensors, and the activations.
fn main()
    a := tensor.from([1.0, 2.0, 4.0, 8.0], [2, 2])
    b := tensor.from([2.0, 4.0, 8.0, 16.0], [2, 2])
    print(b / a)
    print(a / 2.0)
    print(8.0 / a)
    print(a / b * 2.0)
    print(tensor.from([-2.0, -0.5, 0.0, 3.0]).relu())
    print(tensor.from([0.0, 0.0]).sigmoid())
    print(tensor.from([0.0, 0.0]).tanh())
    print(tensor.from([0.0 / 0.0, 1.0]).relu().to_list()[1])
    print(tensor.from([1.5]).relu().sum())
    print(a.map(|x| x * -1.0).relu())
