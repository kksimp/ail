# type.num.7: a float's text form is Python's repr.
fn main()
    print(0.1 + 0.2)
    print(1e16)
    print(9999999999999998.0)
    print(1e-5)
    print(0.0001)
    print(5e-324)
    print(1.2345678901234568e+17)
    n := 9007199254740993
    print(n.to_float())
    print(-0.0)
    print(0.0)
    print(1.0)
    print(1000.0)
    print(1e15)
    print(123456789012345.6)
    print(0.1)
    print(1.0 / 3.0)
    print(2.0 / 3.0)
    print(1e22)
    print(1e21)
    print(1.5e300)
    print(-1.5e-300)
    print(2.2250738585072014e-308)
    print(1.7976931348623157e308)
    print(100.0)
    print(0.001)
    print(0.00012345)
    print(1e-4)
    print(9.999999999999999e-5)
    print(1e100)
    print(12345678.9)
    print(-123.456)
    print(3.141592653589793)
    print(2.718281828459045)
    print(0.5)
    print(1e-7)
    print(4.35)
    print(0.3)
    print(1e23)
    print(5e-310)
    print(9007199254740993.0)
    inf := 1e308 * 10.0
    print(inf)
    print(-inf)
    print(inf - inf)
    print(-(inf - inf))
    print(0.0 / 0.0)
    print(-(0.0 / 0.0))
