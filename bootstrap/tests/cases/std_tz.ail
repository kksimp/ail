## std.tz.1-3: offsets from the platform's tz database.
use std.tz

fn main()
    # 2026-01-15T12:00Z and 2026-07-15T12:00Z.
    for zone in ["America/New_York", "Europe/London", "Australia/Sydney", "Asia/Kolkata", "UTC"]
        print("{zone} {tz.offset(zone, 1_768_478_400)} {tz.offset(zone, 1_784_116_800)}")
    # Before the first transition, and far in the future (the POSIX footer).
    print("{tz.offset("America/New_York", -3_000_000_000)} {tz.offset("America/New_York", 4_102_444_800)}")
    # Unknown and unsafe names have no offset.
    print("{tz.offset("Mars/Base", 0)} {tz.offset("../etc/passwd", 0)} {tz.offset("/etc/passwd", 0)} {tz.offset("", 0)}")
    print(tz.system().len() > 0)
