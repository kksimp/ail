# std.tensor.21, std.tensor.22: mixing f32 and float tensors, and wrong conversions.
fn half() tensor.Tensor[f32]
    tensor.from([1.0, 2.0], [2])

fn main()
    a := half()
    b := tensor.from([1.0, 2.0], [2])
    print(a + b)
    print(a.to_f32())
    print(b.to_float())
    print(tensor.from([1, 2], [2]).to_f32())
