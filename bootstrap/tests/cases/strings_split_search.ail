# type.str.4 and type.str.6: split, contains, starts_with, ends_with with a str
# or a char; strip_prefix and strip_suffix.
fn main()
    print("a,b,c".split(","))
    print("a,,b".split(","))
    print(",a,".split(","))
    print("".split(","))
    print(",".split(","))
    print("abc".split(","))
    print("a--b--c".split("--"))
    print("aaa".split("aa"))
    print("aaaa".split("aa"))
    print("a, b".split(", "))
    print("abc".split("abc"))
    print("añb".split("ñ"))
    print("a→b→c".split('→'))
    print("a,b".split(','))
    print("l1\nl2\n".split('\n'))
    print("a\tb".split('\t'))
    print("x'y".split('\''))
    print("a\"b".split('"'))
    print("\{a}".split('{'))
    print("a b  c".split(' '))
    print("é,e".split('é'))
    print("a,b".split(",").len())
    # contains / starts_with / ends_with
    print([
        "hello".contains('e'),
        "hello".contains('z'),
        "hello".contains("ell"),
        "hello".contains("hello!"),
    ])
    print([
        "hello".starts_with('h'),
        "hello".starts_with('e'),
        "hello".starts_with("he"),
        "hello".starts_with("hello!"),
    ])
    print([
        "hello".ends_with('o'),
        "hello".ends_with('l'),
        "hello".ends_with("llo"),
        "hello".ends_with("!hello"),
    ])
    print([
        "é".starts_with('é'),
        "é".ends_with('é'),
        "é".contains('é'),
        "é".contains('e'),
        "e".contains('é'),
    ])
    print([
        "a\n".ends_with('\n'),
        "a".ends_with('\n'),
        "\{x}".contains('{'),
        "it's".contains('\''),
        "say \"x\"".contains('"'),
    ])
    print([
        "😀!".starts_with('😀'),
        "ab".contains("ba"),
        "".contains('a'),
        "".starts_with('a'),
        "".ends_with('a'),
    ])
    # strip_prefix / strip_suffix return the rest, or none
    print([
        "foobar".strip_prefix("foo"),
        "foobar".strip_prefix("bar"),
        "foobar".strip_prefix("foobar"),
        "x".strip_prefix("xx"),
    ])
    print([
        "foobar".strip_suffix("bar"),
        "foobar".strip_suffix("foo"),
        "foobar".strip_suffix("foobar"),
        "x".strip_suffix("xx"),
    ])
    print([
        "aaa".strip_prefix("a"),
        "aaa".strip_suffix("aa"),
        "ab".strip_prefix("ab"),
        "é!".strip_suffix("!"),
    ])
    if rest := "key=value".strip_prefix("key=")
        print("value is {rest}")
    r := "nothing".strip_prefix("x") else "default"
    print(r)
