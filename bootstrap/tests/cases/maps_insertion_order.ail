fn main()
    mut m := {"c": 3, "a": 1, "b": 2}
    print(m)
    print(m.keys())
    print(m.values())
    # update keeps the position
    m["a"] = 10
    print(m)
    print(m.keys())
    print(m.values())
    # remove keeps the order of the others
    m.remove("c")
    print(m)
    m["d"] = 4
    print(m)
    # a re-added key goes last
    m["c"] = 33
    print(m)
    print(m.keys())
    print(m.values())
    m.remove("a")
    m["a"] = 100
    print(m)
    # insertion of many, remove first, still ordered
    mut big := Map[int, int]()
    for i in 0..10
        big[9 - i] = i
    print(big.keys())
    big.remove(9)
    big.remove(5)
    print(big.keys())
    big[5] = 0
    big[9] = 0
    print(big.keys())
    print(big.values())
    # sets
    mut s := {5, 3, 9}
    print(s)
    print(s.add(3))
    print(s)
    print(s.add(1))
    print(s)
    print(s.remove(5))
    print(s)
    print(s.add(5))
    print(s)
    print(s.sorted())
    # literal duplicates at run time: first position, last value
    k := 1
    d := {k: "a", 2: "b", k: "c"}
    print(d)
    ds := {k, 2, k, 0}
    print(ds)
    # remove everything then refill
    for key in m.keys()
        m.remove(key)
    print(m)
    m["z"] = 1
    m["y"] = 2
    print(m)
    # a map from an empty literal then inserted out of order
    mut e := Map[str, int]()
    e["b"] = 1
    e["a"] = 2
    e["c"] = 3
    print(e.keys())
    print(e.keys().sorted())
