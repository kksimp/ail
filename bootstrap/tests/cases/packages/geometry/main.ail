# A package: the root module, `geo` (two files) and `util.text` (mod.unit.1-2).
use geo
use util.text as fmt
use std.fs

struct Label
    text str

impl geo.Shape for Label
    fn area(self) int
        0
    fn name(self) str
        "label {self.text}"

fn main()
    p := geo.origin()
    q := geo.Point(x: 3, y: 4)
    print(geo.dist2(p, q))
    print(q.x + q.y)
    print(q.scaled(2))
    c := geo.Circle.unit()
    print(c.area())
    shapes := [geo.Form.Round(2), geo.Form.Box(w: 2, h: 3)]
    for s in shapes
        print(geo.describe(s))
    match shapes[0]
        geo.Form.Round(r) => print("round {r}")
        geo.Form.Box(w, h) => print("box {w}x{h}")
    print(geo.ORIGIN_NAME)
    print(fmt.banner("done"))
    l := Label(text: "x")
    print(geo.total([l, c]))
    stack := geo.Stack[int].new()
    print(stack.size())
    print(root_point().label)
    print(c.name())
    print(fs.exists("no-such-file.txt") or geo.has_file("no-such-file.txt"))
