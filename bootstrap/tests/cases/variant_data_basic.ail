enum Shape
    Circle(r int)
    Rect(w int, h int)
    Empty

fn Shape.area(self) int
    match self
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Empty => 0

fn Shape.name(self) str
    match self
        Circle(_) => "circle"
        Rect(w, _) =>
            if w == 0
                "flat rect"
            else
                "rect"
        Empty => "empty"

fn widest(shapes List[Shape]) Shape
    mut best := Shape.Empty
    mut best_width := -1
    for s in shapes
        width := match s
            Circle(r) => 2 * r
            Rect(w, _) => w
            Empty => 0
        if width > best_width
            best = s
            best_width = width
    best

fn main()
    shapes := [Shape.Circle(r: 2), Rect(h: 3, w: 4), Empty, Rect(w: 0, h: 9)]
    for s in shapes
        print("{s.name()}: {s.area()}")
    print(widest(shapes).name())
