## `Default` derives for a struct whose fields all have defaults, and
## generic code calls `T.default()` (trait.assoc.1, ADR 0350).
struct Point
    x int
    y float

struct Box[T]
    item T
    label str

struct Config
    name str
    verbose bool
    tags List[str]
    limits Map[str, int]
    owner str?
    origin Point

impl Default for Point
impl Default for Box[T Default]
impl Default for Config

fn fill[T Default](n int) List[T]
    [T.default() for _ in 0..n]

fn main()
    print(Config.default())
    print(fill[Point](2))
    print(fill[int](3))
    print(Box[Point].default())
    print(fill[List[str]](1))
