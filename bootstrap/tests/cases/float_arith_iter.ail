# type.num.6: + - * / are IEEE 754 (round to nearest, ties to even); output mirrors a Python loop.
fn main()
    mut x := 1.0
    mut y := 0.1
    mut s := 0.0
    for i in 0..40
        x = x * 1.7 + 0.3 / (x + 1.0)
        y = y - x / 3.0
        s += y * 0.5
        s -= x / 7.0
        print("{x} {y} {s}")
    mut z := 1.0
    for i in 0..30
        z *= 0.1
        z += 1e-3
        z /= 3.0
        print(z)
    mut h := 1e300
    for i in 0..5
        h *= 1e3
        print(h)
    mut l := 1e-300
    for i in 0..30
        l /= 1e20
    print(l)
    mut q := 1.0
    for i in 0..1100
        q /= 2.0
    print(q)
    print(0.1 + 0.2 + 0.3)
    print(0.3 + 0.2 + 0.1)
    print(1e16 + 1.0)
    print(1e16 + 2.0)
    print(9007199254740992.0 + 1.0)
    print(9007199254740992.0 + 3.0)
    print(0.1 * 3.0)
    print(1.1 * 1.1)
    print(100.0 * 1.1)
    print(1.0 - 0.9)
    print(4.35 * 100.0)
    print(3.0 * (1.0 / 3.0))
    print(2.0 * 0.1 == 0.2)
    print(0.1 + 0.2 == 0.3)
    print(1e308 + 1e308)
    print(-1e308 - 1e308)
    print(1e-320 / 1e10)
    print(5e-324 / 2.0)
    print(5e-324 * 0.5)
    print(1.5 * 5e-324)
    print(2.5 * 5e-324)
