# type.char.3 and type.char.4: to_digit, code, char.from_code, ordering, equality.
fn has(n int) bool
    char.from_code(n) != none

fn main()
    # to_digit by radix
    print([
        '7'.to_digit(10),
        '7'.to_digit(7),
        '7'.to_digit(8),
        '0'.to_digit(2),
        '1'.to_digit(2),
        '2'.to_digit(2),
    ])
    print([
        'a'.to_digit(16),
        'A'.to_digit(16),
        'f'.to_digit(16),
        'F'.to_digit(16),
        'g'.to_digit(16),
        'G'.to_digit(16),
    ])
    print([
        'g'.to_digit(17),
        'G'.to_digit(17),
        'z'.to_digit(36),
        'Z'.to_digit(36),
        'z'.to_digit(35),
        'Z'.to_digit(35),
    ])
    print(['9'.to_digit(10), '9'.to_digit(9), 'a'.to_digit(10), 'a'.to_digit(11), 'A'.to_digit(11)])
    print([
        '٣'.to_digit(10),
        '５'.to_digit(10),
        'ａ'.to_digit(36),
        'é'.to_digit(36),
        '-'.to_digit(36),
        ' '.to_digit(36),
    ])
    print(['0'.to_digit(36), '5'.to_digit(36), '5'.to_digit(6), '5'.to_digit(5)])
    # is_digit implies to_digit(10)
    mut ok := true
    for n in 0..300
        c := char.from_code(n) else continue
        if c.is_digit() != (c.to_digit(10) != none)
            ok = false
    print(ok)
    # code and from_code
    print(['A'.code(), '0'.code(), '\0'.code(), 'é'.code(), '😀'.code(), '\u{10FFFF}'.code()])
    print([char.from_code(65), char.from_code(0), char.from_code(233), char.from_code(128512)])
    print([has(0xD7FF), has(0xD800), has(0xDBFF), has(0xDC00), has(0xDFFF), has(0xE000)])
    print([has(0x10FFFF), has(0x110000), has(-1), has(4294967361), has(9223372036854775807)])
    print(char.from_code(65) == 'A')
    print(char.from_code(-9223372036854775807 - 1))
    # round trip
    mut same := true
    for n in 0..2000
        if c := char.from_code(n)
            if c.code() != n
                same = false
    print(same)
    # ordering is by code point
    print([
        'a' < 'b',
        'b' < 'a',
        'a' <= 'a',
        'Z' < 'a',
        'é' > 'z',
        '😀' > '\u{FFFF}',
        'a' >= 'b',
        '\0' < ' ',
    ])
    print(['a' == 'a', 'a' == 'A', 'a' != 'b', 'é' == '\u{e9}', '\'' == '\u{27}'])
    print(['b', 'A', 'a', 'é', 'Z', '😀', '0'].sorted())
    print(['b', 'A', 'a'].min())
    print(['b', 'A', 'a'].max())
    print('x'.cmp('y') == Less)
