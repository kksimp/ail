# Traits, impls, default methods, `any`, and trait-typed parameters
# (trait.decl.1-2, trait.impl.1, trait.res.1, trait.any.1-3, gen.anon.1).
trait Shape
    fn area(self) int
    fn name(self) str
        "shape"
    fn describe(self) str
        "{self.name()} with area {self.area()}"

struct Circle
    r int

struct Rect
    w int
    h int

impl Shape for Circle
    fn area(self) int
        3 * self.r * self.r
    fn name(self) str
        "circle"

impl Shape for Rect
    fn area(self) int
        self.w * self.h

fn Rect.square(side int) Rect
    Rect(w: side, h: side)

trait Scale
    fn scale(mut self, k int)

impl Scale for Rect
    fn scale(mut self, k int)
        self.w *= k
        self.h *= k

struct Scene
    shapes List[any Shape]

fn total(shapes List[any Shape]) int
    mut sum := 0
    for s in shapes
        sum += s.area()
    sum

fn bigger(a Shape, b Shape) bool
    a.area() > b.area()

fn largest[T Shape](items List[T]) T
    mut best := items[0]
    for item in items
        if item.area() > best.area()
            best = item
    best

fn grow[T Scale](mut x T)
    x.scale(10)

trait Label
    fn label(self) str

impl Label for int
    fn label(self) str
        "#{self}"

fn main()
    c := Circle(r: 2)
    r := Rect.square(3)
    print(c.describe())
    print(r.describe())
    print(Shape.area(c))
    print(total([c, r, Circle(r: 1)]))
    print(bigger(c, r))
    print(largest([Rect(w: 1, h: 2), Rect(w: 3, h: 1), Rect(w: 2, h: 1)]))
    mut big := r
    big.scale(2)
    print("{big} {r}")
    grow(mut big)
    print(big.area())
    scene := Scene(shapes: [c, r])
    for s in scene.shapes
        print(s.describe())
    print(scene)
    n := 7
    print(n.label())
