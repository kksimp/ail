enum Shape
    Circle(r int)
    Rect(w int, h int)

fn describe(s Shape) str
    match s
        Rect(w, h) if w == h => "square {w}"
        Rect(w, h) if w > h => "wide {w}x{h}"
        Rect(_, _) => "tall"
        Circle(r) if r > 10 => "big circle"
        Circle(_) => "circle"

fn sign(n int) str
    match n
        _ if n < 0 => "negative"
        0 => "zero"
        _ if n % 2 == 0 => "even"
        _ => "odd"

fn main()
    print(describe(Shape.Rect(w: 3, h: 3)))
    print(describe(Shape.Rect(w: 5, h: 2)))
    print(describe(Shape.Rect(w: 2, h: 5)))
    print(describe(Shape.Circle(11)))
    print(describe(Shape.Circle(1)))
    for n in [-4, 0, 6, 7]
        print(sign(n))
