# fuzz-input: cookie
# fuzz-needs: std.net.jar
# std.net.jar on hostile Set-Cookie lines (std.net.20-23): a bad line is dropped, never a crash;
# the Cookie header a jar builds has no CR, LF or NUL; a script never sees an HttpOnly cookie.
use std.net.jar

fn main()
    mut j := jar.new()
    url := "http://example.com/a/b"
    stored := j.set_cookie(url, {{TEXT}})
    also := j.set_cookie("http://sub.example.com/", {{TEXT2}})
    h := j.header(url)
    if h.contains("\r") or h.contains("\n") or h.contains("\0")
        print("FAIL the Cookie header has a control character")
    print(stored or not stored)
    print(also or not also)
    print(j.len() <= 2)
    for k in j.for_script(url).keys()
        if k == ""
            print("FAIL a script sees an unnamed cookie")
    ok := j.set_from_script(url, "x=1; HttpOnly")
    if ok and j.for_script(url).contains("x")
        print("FAIL a script set an HttpOnly cookie")
    j.clear()
    print(j.len())
    # Known answers (RFC 6265, std.net.20-23).
    mut k := jar.new()
    if not k.set_cookie("http://example.com/a/b", "n=v; Path=/a")
        print("FAIL a plain cookie was refused")
    if k.header("http://example.com/a/c") != "n=v"
        print("FAIL Path=/a cookie missing under /a/c: {k.header("http://example.com/a/c")}")
    if k.header("http://example.com/z") != ""
        print("FAIL Path=/a cookie sent to /z")
    if k.header("http://other.org/a") != ""
        print("FAIL a host-only cookie went to another host")
    k.set_cookie("http://example.com/a/b", "n=v; Path=/a; Max-Age=0")
    if k.header("http://example.com/a/c") != ""
        print("FAIL Max-Age=0 did not remove the cookie")
    if k.set_cookie("http://example.com/", "d=1; Domain=other.org")
        print("FAIL a cookie for a foreign domain was stored")
    k.set_cookie("http://example.com/", "s=1; Secure")
    if k.header("http://example.com/").contains("s=1")
        print("FAIL a Secure cookie was sent over http")
    k.set_cookie("http://example.com/", "h=1; HttpOnly")
    if k.for_script("http://example.com/").contains("h")
        print("FAIL a script sees an HttpOnly cookie")
    if not k.header("http://example.com/").contains("h=1")
        print("FAIL an HttpOnly cookie is not sent")
