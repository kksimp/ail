# fuzz-input: http
# fuzz-needs: std.net
# net.serve fed raw hostile requests over a socket: a malformed request is refused with an
# error or a 4xx, never a crash or a hang; the server then still serves a good request.
use std.net

fn worker(srv net.Server) int
    mut served := 0
    for _ in 0..2
        ex := srv.accept() else err
            continue
        ex.respond(net.Response(status: 200, headers: {}, body: "ok")) else err
            continue
        served += 1
    served

fn main() !
    srv := net.serve("127.0.0.1:0")?
    w := spawn worker(srv)
    addr := "{srv.addr()}"
    port := (addr.split(":").last() else "0").to_int() else 0
    c := net.connect("127.0.0.1", port)?
    c.set_timeout(2000)
    c.write({{TEXT}}) else err
        print("write {err.kind}")
    got := c.read_line() else err
        none
    first := got else "closed"
    if first.starts_with("HTTP/") and not first.contains(" ")
        print("FAIL status line has no code: {first}")
    c.close()
    r := net.get("http://{addr}/")?
    if r.status != 200
        print("FAIL a good request after a bad one got {r.status}")
    srv.close()
    n := w.wait()?
    print(n >= 1)
