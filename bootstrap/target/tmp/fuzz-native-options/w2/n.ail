error struct Empty "the list is empty"
error struct Big "the number is too big"

fn find(xs List[int], want int) int?
    for i in 0..xs.len()
        if xs[i] == want
            return i
    none

fn pick(n int) int?
    if n % 6 == 0
        return none
    n * 2

fn halve(x float) float?
    if x < 0.0
        return none
    x / 2.0

fn first(xs List[int]) int ! Empty
    if xs.len() == 0
        return Empty()
    xs[0]

fn small(n int) int ! Big
    if n > 99
        return Big()
    n

fn both(a List[int], b List[int]) int ! Empty | Big
    x := small(first(a)?)?
    y := small(first(b)?)?
    x + y

fn check(n int) ! Big
    if n > 99
        return Big()

fn lookup(xs List[int], i int) int?
    if i < 0 or i >= xs.len()
        return none
    xs[i]

fn twice(xs List[int], i int) int ! Empty
    v := first(xs)?
    w := lookup(xs, i) else return Empty()
    v + w

fn main()
    xs := [16, 153, -13]
    m0 := first([182, 164, -15]) else
        print("fallback block")
        7
    print(m0)
    if v := pick(23)
        print(v + 1)
    else
        print("none")
    print(halve(-3.5) else 0.0)
    if p := find(xs, 8)
        print("p {p}")
    elif q := lookup(xs, 8)
        print("q {q}")
    else
        print("neither")
    if pick(22) == none
        print("missing")
    print(pick(31) else -7)
    w6 := small(-5 * 11) else err
        print("failed: {err}")
        0
    print(w6)
    mut count7 := 0
    for i in 0..12
        v := small(i * 55) else continue
        count7 += v
    print(count7)
    if p := find(xs, 17)
        print("p {p}")
    elif q := lookup(xs, 17)
        print("q {q}")
    else
        print("neither")
    mut o9 := pick(-5)
    print(o9 else 5)
    o9 = none
    print(o9 else 100)
    o9 = -5
    print(o9 else 100)
    if p := find(xs, 12)
        print("p {p}")
    elif q := lookup(xs, 12)
        print("q {q}")
    else
        print("neither")
    print(twice([278, 120, 85], 17) else -3)
    mut count12 := 0
    for i in 0..11
        v := small(i * 29) else continue
        count12 += v
    print(count12)
    print(pick(24) else -7)
    m14 := first([215, 92, 201]) else
        print("fallback block")
        7
    print(m14)
    print("done")
