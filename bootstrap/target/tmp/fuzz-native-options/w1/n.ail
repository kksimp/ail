error struct Empty "the list is empty"
error struct Big "the number is too big"

fn find(xs List[int], want int) int?
    for i in 0..xs.len()
        if xs[i] == want
            return i
    none

fn pick(n int) int?
    if n % 4 == 0
        return none
    n * 8

fn halve(x float) float?
    if x < 0.0
        return none
    x / 2.0

fn first(xs List[int]) int ! Empty
    if xs.len() == 0
        return Empty()
    xs[0]

fn small(n int) int ! Big
    if n > 109
        return Big()
    n

fn both(a List[int], b List[int]) int ! Empty | Big
    x := small(first(a)?)?
    y := small(first(b)?)?
    x + y

fn check(n int) ! Big
    if n > 109
        return Big()

fn lookup(xs List[int], i int) int?
    if i < 0 or i >= xs.len()
        return none
    xs[i]

fn twice(xs List[int], i int) int ! Empty
    v := first(xs)?
    w := lookup(xs, i) else return Empty()
    v + w

fn main()
    xs := []
    if pick(8) == none
        print("missing")
    m1 := first([244]) else
        print("fallback block")
        7
    print(m1)
    print(halve(5.5) else 0.0)
    mut o3 := pick(31)
    print(o3 else 5)
    o3 = none
    print(o3 else 100)
    o3 = 31
    print(o3 else 100)
    if pick(16) == none
        print("missing")
    print(pick(10) else -7)
    if p := find(xs, -3)
        print("p {p}")
    elif q := lookup(xs, -3)
        print("q {q}")
    else
        print("neither")
    if v := pick(-3)
        print(v + 1)
    else
        print("none")
    print(both([97, 35, 53], [144, 213, -14]) else -9)
    print(find(xs, 27) else -1)
    print(halve(4.5) else 0.0)
    if pick(11) != none
        print("found")
    print("done")
