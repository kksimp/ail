struct Pt
    a int
    b int

fn Pt.sum(self) int
    a + b

fn Pt.shift(mut self, d int)
    a += d

enum Shape
    Circle(r int)
    Rect(w int, h int)
    Dot

fn Shape.area(selfint )
    match self
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Dot => 0

fn mul(a int, b int) int
    a * b

trait Weigh
    fn weight(self) int
    fn heavy(self) bool
        weight() > 10

impl Weigh for Pt
    fn weight(self) int
        a * 2 + b

fn largest[T Ord](items List[T]) T
    mut best := items[0]
    for x in items
        if x > best
            best = x
    best

fn guarded(x int) int
    requires x == x
    ensures result >= 0 or result < 0
    x

fn chain(x int) !int
    y := check_pos(x)? "chain"
    y + 1

error enum Fail
    Neg(n int)

fn check_pos(x int) int ! Fail
    if x < 0
        return Fail.Neg(n: x)
    x

fn pick(xs List[int], i int) int?
    if i >= 0 and i < xs.len()
        return xs[i]
    none

fn f0(p0 int, p1 int) int
    t1 := spawn check_pos(9.min(p0))
    w2 := t1.wait() else 0
    mut m3 := Pt(a: 6, b: 6)
    v7 := match Shape.Rect(w: w2, h: 11)
        Circle(r4) => r4 + 3.abs()
        Rect(w5, _) => w5 * p1
        Dot => p1
    p0

fn f1(p0 int, p1 int) int
    mut m8 := Pt(b: p1, a: (pick([1, 2], 1) else 0))
    print((p0 + 3))
    m8.shift(Shape.Dot.area())
    11

