fn main()
    mut mi := Map[int, int]()
    mut ms := Map[str, int]()
    mut mf := Map[str, float]()
    mut si := Set[int]()
    mut ss := Set[str]()
    print(mi.get(8) else -1)
    mi.remove(1)
    print(si.contains(2))
    print(si.contains(-2))
    print(mi.get(9) else -1)
    mi[-2] = (mi.get(-2) else 0) + -2
    mi[2] = 32
    for x in si
        print(x * 2)
    print(si.contains(8))
    mi[7] = -19
    mi[5] = (mi.get(5) else 0) + 75
    print(ss.add("x y"))
    print(mi)
    print(ms)
    print(mf)
    print(si)
    print(ss)
    mut big := Map[int, int]()
    for i in 0..2699
        big[i * 7 % 1663] = i
    for i in 0..2699 / 3
        big.remove(i * 7 % 1663)
    mut sum := 0
    for k in big.keys()
        sum += k * 31 + (big.get(k) else 0)
    print(big.len())
    print(sum)
    mut total := 0
    for v in mi.values()
        total += v
    print(total)
    mut words := Map[str, int]()
    for w in ["the", "cat", "the", "hat", "the", "end"]
        words[w] += 1
    print(words)
