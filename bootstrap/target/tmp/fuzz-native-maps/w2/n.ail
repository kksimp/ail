fn main()
    mut mi := Map[int, int]()
    mut ms := Map[str, int]()
    mut mf := Map[str, float]()
    mut si := Set[int]()
    mut ss := Set[str]()
    print(ss.add("x y"))
    for x in si
        print(x * 2)
    mi[1] = 24
    print([3, 14, 17].len())
    print(mi.len() + ms.len() + si.len() + ss.len())
    print(mi.len() + ms.len() + si.len() + ss.len())
    print(ss.add("tea"))
    mi.remove(2)
    print(mi)
    print(ms)
    print(mf)
    print(si)
    print(ss)
    mut big := Map[int, int]()
    for i in 0..876
        big[i * 10 % 1330] = i
    for i in 0..876 / 3
        big.remove(i * 10 % 1330)
    mut sum := 0
    for k in big.keys()
        sum += k * 31 + (big.get(k) else 0)
    print(big.len())
    print(sum)
    mut total := 0
    for v in mi.values()
        total += v
    print(total)
    mut words := Map[str, int]()
    for w in ["the", "cat", "the", "hat", "the", "end"]
        words[w] += 1
    print(words)
