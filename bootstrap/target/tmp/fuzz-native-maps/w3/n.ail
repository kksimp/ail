fn main()
    mut mi := Map[int, int]()
    mut ms := Map[str, int]()
    mut mf := Map[str, float]()
    mut si := Set[int]()
    mut ss := Set[str]()
    print([8, 22, 30].len())
    mi[8] = -7
    print(mi.contains(3))
    print(mi.keys())
    print(ms.values())
    for x in si
        print(x * 2)
    for x in si
        print(x * 2)
    mi.remove(-2)
    print(mi.len() + ms.len() + si.len() + ss.len())
    print(mi)
    print(ms)
    print(mf)
    print(si)
    print(ss)
    mut big := Map[int, int]()
    for i in 0..688
        big[i * 7 % 1715] = i
    for i in 0..688 / 3
        big.remove(i * 7 % 1715)
    mut sum := 0
    for k in big.keys()
        sum += k * 31 + (big.get(k) else 0)
    print(big.len())
    print(sum)
    mut total := 0
    for v in mi.values()
        total += v
    print(total)
    mut words := Map[str, int]()
    for w in ["the", "cat", "the", "hat", "the", "end"]
        words[w] += 1
    print(words)
