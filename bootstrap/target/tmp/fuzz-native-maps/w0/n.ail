fn main()
    mut mi := Map[int, int]()
    mut ms := Map[str, int]()
    mut mf := Map[str, float]()
    mut si := Set[int]()
    mut ss := Set[str]()
    mi[-2] = 38
    mf[""] = 39.5
    mi.remove(1)
    mf["é"] = 55.5
    mi[-2] = 17
    ms.remove("é")
    mf["b"] = 18.5
    for x in si
        print(x * 2)
    print(mi)
    print(ms)
    print(mf)
    print(si)
    print(ss)
    mut big := Map[int, int]()
    for i in 0..135
        big[i * 4 % 814] = i
    for i in 0..135 / 3
        big.remove(i * 4 % 814)
    mut sum := 0
    for k in big.keys()
        sum += k * 31 + (big.get(k) else 0)
    print(big.len())
    print(sum)
    mut total := 0
    for v in mi.values()
        total += v
    print(total)
    mut words := Map[str, int]()
    for w in ["the", "cat", "the", "hat", "the", "end"]
        words[w] += 1
    print(words)
