fn main()
    print("[{"[{"  pad ":>0}]":*^6}]".chars().len())
    s1 := "a\tb".to_lower()
    print(s1)
    for c in "a".pad_left(2, ' ').pad_right(6, ' ').chars()
        print(c.to_lower())
    s3 := s1
    print(s3)
    print("0123456789".len())
    s5 := s3
    print(s5)
    s6 := "[{s1:*^2}]"
    print(s6)
    s7 := "a"
    print(s7)
    for c in "x,y,,z".pad_left(6, '0').to_upper().chars()
        print(c.to_upper())
    s9 := "Hello"
    print(s9)
    s10 := "x,y,,z".to_str().repeat(3).trim()
    print(s10)
