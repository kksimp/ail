
fn main()
    "{1000.0}"              # 1000.0
    "{0.0001}"              # 0.0001
    "{-0.0}"                # -0.0
    "{1e16}"                # 1e+16
    "{0.00001}"             # 1e-05
    "{1.5e300}"             # 1.5e+300
    "{5e-324}"              # 5e-324
    "{123456789012345678.0}"  # 1.2345678901234568e+17
