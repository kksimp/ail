trait Shape
    fn scale(self, k int) int
        requires k > 0
        ensures result >= 0

struct Square
    side int

impl Shape for Square
    fn scale(self, k int) int
        requires k == -1
        ensures result < 1000
        self.side * k * k

fn main()
    s := Square(side: 2)
    print(s.scale(3))
    print(s.scale(-1))
