fn main()
    xs := [3, 1, 4, 1, 5]
    print([x * x for x in xs if x > 1])          # [9, 16, 25]
    print({x for x in xs}.len())                 # 4
    sizes := {w: w.chars().len() for w in ["a", "bcd"]}
    print(sizes["bcd"])                          # 3
    print([r * 10 + c for r in 1..3 for c in 0..2])   # [10, 11, 20, 21]
    print([t.to_int() else continue for t in ["1", "x", "3"]])  # [1, 3]
