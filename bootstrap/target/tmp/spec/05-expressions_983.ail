fn sign(n int) str
    match n
        _ if n < 0 => "negative"
        0 => "zero"
        _ => "positive"

fn grade(c char) str
    match c
        'a'..='f' => "low"
        'g'..'z' => "high"
        _ => "other"

fn main()
    print(sign(-3))                   # negative
    print(sign(0))                    # zero
    print(grade('c'))                 # low
    print(grade('x'))                 # high
