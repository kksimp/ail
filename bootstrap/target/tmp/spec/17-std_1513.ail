use std.proc

fn main() !
    c := proc.start("sh", ["-c", "cat"])?
    c.stdin.send("hello")
    c.stdin.close()
    for line in c.out
        print(line)
    status := proc.wait(move c)?
    print(status)
    d := proc.start("sh", ["-c", "sleep 60"])?
    print(proc.kill(move d))          # 137 on Unix
