fn main()
    a := {1, 2, 3}
    b := {3, 4}
    print(a.union(b))                             # {1, 2, 3, 4}
    print(a.intersect(b))                         # {3}
    print(a.difference(b))                        # {1, 2}
    m := {"x": 1, "y": 2}
    print(m.keys().union(["z"]))                  # {"x", "y", "z"}: the result is a set
