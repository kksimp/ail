unique struct Lock
    id int

impl Drop for Lock
    fn drop(mut self)
        print("unlock {id}")

fn release(move l Lock)
    print("releasing {l.id}")

# prints "releasing 1", "unlock 1", then "unlock 2" when the block ends

fn main()
    a := Lock(id: 1)
    b := Lock(id: 2)
    release(move a)
