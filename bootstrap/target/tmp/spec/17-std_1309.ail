use std.env

fn main()
    print(env.args().len())                      # 0: the harness passes no words
    print(env.get("AIL_SPEC_NOT_SET") else "unset")   # unset
    print(env.cwd().len() > 0)                   # true
    print(env.program().len() > 0)               # true
    print(env.vars().len() >= 0)                 # true
    print(env.home() else "no home")
