fn add8(a i8, b i8) i8
    a + b

fn main()
    print(add8(100, 27))           # 127
    print(-(5.to_i8()))            # -5: unary minus on a signed size
    print(f32_half(3.0))           # 1.5
    print(200.to_hex())            # c8: same methods as int, in the type

fn f32_half(x f32) f32
    x.sqrt() * x.sqrt() / 2
