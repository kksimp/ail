fn main()
    s := "héllo"
    n := 42
    ok := true
    print(s.len())                                # 5 characters
    print(s.chars().len())                        # 5
    print("{n} {ok} {s}")                         # 42 true héllo
    print(s == "héllo")                           # true: equality compares UTF-8 bytes
    print("abc" < "abd")                          # true
    c := 'é'
    print(c)                                      # é
