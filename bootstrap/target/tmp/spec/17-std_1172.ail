fn main()
    a := tensor.from([1.0, -2.0, 3.0, 0.5], [2, 2])
    b := tensor.from([4.0, 8.0, -1.0, 2.0], [2, 2])
    print((a * b + a).relu())     # tensor.from([5.0, 0.0, 0.0, 1.5], [2, 2])
    print(-(a - b) / b)           # tensor.from([0.75, 1.25, 4.0, 0.75], [2, 2])
    print((a * 2.0 - b).sigmoid().tanh().sum() > 0.0)   # true
