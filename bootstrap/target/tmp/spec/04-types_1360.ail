fn main()
    a := {"a": 1, "b": 2}
    b := {"b": 2, "a": 1}
    print(a == b)                                 # true: order is ignored
    print({1, 2} == {2, 1})                       # true
    e := Map[str, int]()
    print(e)                                      # {}
    print(a.get("cy") else 0)                     # 0
    print(a.contains("a"))                        # true
    print(a.len())                                # 2
    for k in a.keys()
        print("{k}: {a[k]}")
    s := {3, 1, 2}
    for x in s
        print(x)                                  # 3, 1, 2: insertion order
    print(s.is_subset({1, 2, 3, 4}))              # true
    print(s.sorted())                             # [1, 2, 3]
