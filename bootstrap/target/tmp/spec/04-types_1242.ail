fn main()
    xs := [10, 20, 30, 40]
    print(xs[1])                                  # 20
    print(xs[1..3])                               # [20, 30]
    print(xs[1..=2])                              # [20, 30]
    print(xs[2..])                                # [30, 40]
    print(xs[..2])                                # [10, 20]
    print(xs.len())                               # 4
