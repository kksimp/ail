fn find(id int) int?
    if id > 0
        return id * 10
    none

error enum ParseError
    BadNumber(text str) "bad number {text}"

fn parse(s str) int ! ParseError
    n := s.to_int() else return BadNumber(text: s)
    n

fn main()
    if v := find(2)
        print(v)              # 20
    else
        print("missing")
    if w := parse("x")
        print(w)
    else err
        print(err)            # bad: x
