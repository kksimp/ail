struct TypeInfo
    name str
    id str
    module str
    kind TypeKind
    is_error bool
    params List[str]
    fields List[FieldInfo]
    variants List[VariantInfo]

enum TypeKind
    Struct
    Enum

struct FieldInfo
    name str
    type_text str
    public bool

struct VariantInfo
    name str
    fields List[FieldInfo]

fn main()
    print("")
