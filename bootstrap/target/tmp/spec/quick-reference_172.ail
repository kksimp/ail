enum Shape
    Circle(r int)
    Rect(w int, h int)

fn area(s Shape) int
    match s
        Circle(r) => 3 * r * r
        Rect(w, _) => w * w       # `_` skips a field

fn round(s Shape) bool
    match s
        Circle => true            # bare: any fields, binds none
        Rect => false

fn main()
    print("")
