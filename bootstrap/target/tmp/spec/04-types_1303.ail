fn main()
    mut xs := [1, 2, 3]
    xs.insert(1, 9)                               # [1, 9, 2, 3]
    xs.insert(xs.len(), 4)                        # append
    n := xs.remove_at(0)                          # 1
    xs.extend([5, 6])
    print(n)                                      # 1
    print(xs.first() else 0)                      # 9
    xs.reverse()
    print(xs)
    xs.clear()
    print(xs.len())                               # 0
