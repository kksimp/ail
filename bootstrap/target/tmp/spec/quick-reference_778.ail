fn main()
    mut w := ui.open("Demo", 40, 10) else return   # fails headless: kind "no_display"
    w.put(1, 1, "Hello", 0xFFFFFF, 0x000000)
    w.present()
    while true
        match w.next_event()
            Key(key, ctrl, _, _) =>                # "a", "enter", "f1"; Ctrl-S is ("s", true)
                if key == "escape"
                    break
            Close => break
            Resize(_, _) | Mouse(_, _, _, _) | Scroll(_) => w.present()
