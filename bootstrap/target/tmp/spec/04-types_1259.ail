fn main()
    mut out := []
    out.push("a")                                 # out is List[str] from this use
    out.push("b")
    mut ids := [3, 1, 2]
    ids.swap(0, 2)                                # [2, 1, 3]
    ids.swap(1, 1)                                # does nothing
    print(out.join(","))                          # a,b
    print(ids)                                    # [2, 1, 3]
