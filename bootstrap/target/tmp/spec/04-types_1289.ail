fn main()
    xs := [3, 1, 2]
    print(xs.sorted())                            # [1, 2, 3]
    print(xs.min() else 0)                        # 1
    print(xs.max() else 0)                        # 3
    print(xs.sum())                               # 6
    print([0.5, 0.25].sum())                      # 0.75
    print(xs.take(2))                             # [3, 1]
    mut ys := [2.0, 1.0]
    ys.sort()
    print(ys)                                     # [1.0, 2.0]
