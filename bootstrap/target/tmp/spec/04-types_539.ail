
fn main()
    b := b"hello\x00\n"
    print(b.len())                       # 7
    print(b[1])                          # 101
    print(b[1..3])                       # b"el"
    print(b[..2] + b[3..])               # b"helo\x00\n"
    print(b.hex())                       # 68656c6c6f000a
    print("hi".to_bytes().to_list())     # [104, 105]
    print(bytes.from_base64("aGk=") else b"")
    for x in b"abc"
        print(x)                         # 97 98 99
