use std.net

fn echo(srv net.Server) !
    ex := srv.accept()?
    ex.respond_bytes(200, {}, ex.request.data + b"!")?

fn main() !
    srv := net.serve("127.0.0.1:0")?
    t := spawn echo(srv)
    r := net.post_bytes("http://{srv.addr()}/", b"\x01\x02", "application/octet-stream")?
    print("{r.status} {r.data.hex()}")
    t.wait()?
