enum Color
    Red
    Green
    Blue

enum Shape
    Dot
    Circle(r int)
    Rect(w int, h int)
    Label(text str, size int)

enum Tree
    Leaf
    Node(left Tree, value int, right Tree)

fn code(c Color) int
    match c
        Red => 5
        Green => 29
        Blue => 7

fn area(s Shape) int
    match s
        Dot => 0
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Label(_, n) => n

fn big(s Shape) bool
    match s
        Circle(r) if r > 7 => true
        Rect(w, h) if w * h > 29 => true
        Circle(_) | Rect(_, _) => false
        Dot | Label(_, _) => false

fn name(s Shape) str
    match s
        Dot => "dot"
        Circle(_) => "circle"
        Rect(_, _) => "rect"
        Label(t, _) => t

fn bucket(n int) str
    match n
        0 => "zero"
        1 | 2 | 3 => "few"
        4..8 => "some"
        _ => "many"

fn word(s str) int
    match s
        "one" => 1
        "two" | "three" => 23
        _ => 0

fn insert(t Tree, v int) Tree
    match t
        Leaf => Node(left: Leaf, value: v, right: Leaf)
        Node(l, x, rt) =>
            if v < x
                Node(left: insert(l, v), value: x, right: rt)
            else
                Node(left: l, value: x, right: insert(rt, v))

fn sum(t Tree) int
    match t
        Leaf => 0
        Node(l, x, rt) => sum(l) + x + sum(rt)

fn depth(t Tree) int
    match t
        Leaf => 0
        Node(l, _, rt) =>
            dl := depth(l)
            dr := depth(rt)
            if dl > dr then dl + 1 else dr + 1

fn pick(i int) Color
    match i % 3
        0 => Red
        1 => Green
        _ => Blue

fn main()
    print(big(Shape.Circle(4)))
    mut total1 := 0
    for i in 0..9
        total1 += code(pick(i))
    print(total1)
    print(area(Shape.Label("bc", 38)))
    print(big(Shape.Circle(1)))
    print(Color.Green == Color.Red)
    print(bucket(3))
    print(bucket(11))
    print(bucket(11))
    print(area(Shape.Label("a", 42)))
    print(name(Shape.Rect(w: 9, h: 11)))
    print(Shape.Label("bc", 39) != Shape.Circle(8))
    print(Shape.Dot == Shape.Circle(2))
    print(Shape.Label("bc", 42) == Shape.Circle(4))
    print("done")
