enum Color
    Red
    Green
    Blue

enum Shape
    Dot
    Circle(r int)
    Rect(w int, h int)
    Label(text str, size int)

enum Tree
    Leaf
    Node(left Tree, value int, right Tree)

fn code(c Color) int
    match c
        Red => 1
        Green => 20
        Blue => 6

fn area(s Shape) int
    match s
        Dot => 0
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Label(_, n) => n

fn big(s Shape) bool
    match s
        Circle(r) if r > 6 => true
        Rect(w, h) if w * h > 20 => true
        Circle(_) | Rect(_, _) => false
        Dot | Label(_, _) => false

fn name(s Shape) str
    match s
        Dot => "dot"
        Circle(_) => "circle"
        Rect(_, _) => "rect"
        Label(t, _) => t

fn bucket(n int) str
    match n
        0 => "zero"
        1 | 2 | 3 => "few"
        4..12 => "some"
        _ => "many"

fn word(s str) int
    match s
        "one" => 1
        "two" | "three" => 23
        _ => 0

fn insert(t Tree, v int) Tree
    match t
        Leaf => Node(left: Leaf, value: v, right: Leaf)
        Node(l, x, rt) =>
            if v < x
                Node(left: insert(l, v), value: x, right: rt)
            else
                Node(left: l, value: x, right: insert(rt, v))

fn sum(t Tree) int
    match t
        Leaf => 0
        Node(l, x, rt) => sum(l) + x + sum(rt)

fn depth(t Tree) int
    match t
        Leaf => 0
        Node(l, _, rt) =>
            dl := depth(l)
            dr := depth(rt)
            if dl > dr then dl + 1 else dr + 1

fn pick(i int) Color
    match i % 3
        0 => Red
        1 => Green
        _ => Blue

fn main()
    print(area(Shape.Rect(w: 0, h: 5)))
    shapes1 := [Shape.Dot, Shape.Dot, Shape.Dot]
    mut sum1 := 0
    for s in shapes1
        sum1 += area(s)
    print(sum1)
    print(shapes1[0] == shapes1[1])
    print(Shape.Rect(w: 3, h: 5) != Shape.Dot)
    print(big(Shape.Label("bc", 34)))
    print(name(Shape.Label("a", 40)))
    print(Color.Blue == Color.Blue)
    print(big(Shape.Rect(w: 11, h: 1)))
    shapes7 := [Shape.Circle(0), Shape.Label("hello", 29), Shape.Dot]
    mut sum7 := 0
    for s in shapes7
        sum7 += area(s)
    print(sum7)
    print(shapes7[0] == shapes7[1])
    print(Shape.Label("", 25) == Shape.Label("hello", 26))
    print("done")
