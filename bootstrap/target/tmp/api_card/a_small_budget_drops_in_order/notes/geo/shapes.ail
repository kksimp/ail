## A point on the plane.
pub struct P
    pub x int
    pub y int

## The origin.
pub fn origin() P
    P(x: 0, y: 0)

fn hidden() int
    1

fn hidden_two(a int, b int) int
    a + b

fn hidden_three(a int, b int) int
    a * b

fn hidden_four(a int, b int) int
    a - b

fn hidden_five(a int, b int) int
    a / b
