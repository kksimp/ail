fn f0(n int) int
    n % 8 - 9

fn f1(n int) int
    n % 4 - 0

fn apply(f fn(int) int, x int) int
    f(x)

fn twice(f fn(int) int, x int) int
    f(f(x))

fn pick(which int) fn(int) int
    if which % 2 == 0
        f0
    else
        f1

fn each(f fn(int), n int)
    for i in 0..n
        f(i)

fn show(n int)
    print("show {n}")

fn mix(a int, b float, c int) float
    a.to_float() * b + c.to_float()

fn many(f fn(int, float, int) float, a int) float
    f(a, 1.5, a + 1)

fn main()
    print([-10, 3, 4, -5, -3, -1].sorted(by: |x| -x))
    g1 := f1
    print(g1(18))
    print(pick(10)(10))
    print(pick(21)(21))
    g4 := f1
    print(g4(19))
