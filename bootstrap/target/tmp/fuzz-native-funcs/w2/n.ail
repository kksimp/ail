fn f0(n int) int
    n * 3 + 18

fn f1(n int) int
    if n > 10 then n - 3 else n + 3

fn f2(n int) int
    n % 7 - 18

fn f3(n int) int
    (n - 19) * (n - 19)

fn apply(f fn(int) int, x int) int
    f(x)

fn twice(f fn(int) int, x int) int
    f(f(x))

fn pick(which int) fn(int) int
    if which % 2 == 0
        f0
    else
        f3

fn each(f fn(int), n int)
    for i in 0..n
        f(i)

fn show(n int)
    print("show {n}")

fn mix(a int, b float, c int) float
    a.to_float() * b + c.to_float()

fn many(f fn(int, float, int) float, a int) float
    f(a, 1.5, a + 1)

fn main()
    print(["pear", "fig", "banana", "kiwi", "apple", "date"].sorted(by: |w| w.len()).join(","))
    print(many(mix, 18))
    print([2.5, -1.0, 5.25, 9.0].sorted(by: |f| f.to_int() * -1))
    shift3 := 0
    print([-7, 15, -7, 3, -8, -9].sorted(by: |x| (x - shift3) * (x - shift3)))
    print([-6, 17].sorted(by: |x| x % 2))
    print([2.5, -1.0, -1.25, 9.0].sorted(by: |f| f.to_int() * -1))
    shift6 := 8
    print([22, 26, 12, -5, 3, 7, 18].sorted(by: |x| (x - shift6) * (x - shift6)))
    print(["pear", "fig", "banana", "kiwi", "apple", "date"].sorted(by: |w| w.len()).join(","))
    mut ys8 := [26, -3, 28, 20, 15, 14, 16, -7]
    ys8.sort()
    print(ys8)
    ys8.sort(by: |y| -y)
    print(ys8)
    print(pick(33)(33))
    print(pick(35)(35))
