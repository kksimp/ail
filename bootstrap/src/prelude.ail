## The standard traits and `Ordering` (ADR 0127). The bootstrap reads this
## before every program, so its declarations are built in.

enum Ordering
    Less
    Equal
    Greater

trait Eq
    fn eq(self, other Self) bool

trait Ord
    fn cmp(self, other Self) Ordering
    fn min(self, other Self) Self
        if self.cmp(other) == Greater
            other
        else
            self
    fn max(self, other Self) Self
        if self.cmp(other) == Less
            other
        else
            self

trait ToStr
    fn to_str(self) str

## Map keys and set elements. Automatic, with no methods (trait.auto.5).
trait Hash

## The cleanup of a unique type: runs once when the value's owner goes out
## of scope, unless it was moved away first (own.uniq.3, ADR 0191).
trait Drop
    fn drop(mut self)

## What `Task.wait()` fails with when the task trapped (conc.task.6, ADR 0187):
## the trap's rule and its message.
error struct Trapped
    rule str
    message str

## What `?` fails with on `none` in a function whose errors are inferred
## (err.prop.5, ADR 0279).
error struct Absent "a value is absent"
## @module json
## `std.json` (lane 5, plan section 4): a JSON value, parser and printer. It
## is read only when the program names one of its public items and doesn't
## declare that name itself, so other programs pay nothing for it.
## TODO(lane 4): once `use std.NAME` exists, move these to `use std.json` as
## `json.parse`, `json.Value`, and so on (ADR 0161).

enum Json
    Null
    Bool(b bool)
    Num(n float)
    Str(s str)
    Arr(items List[Json])
    Obj(members List[JsonMember])

struct JsonMember
    key str
    value Json

## `at` is the 0-based character offset of the problem (json.err.1).
error struct JsonError
    at int
    message str

struct JsonParser
    chars List[char]
    pos int

fn JsonParser.fail_at(self, at int, message str) JsonError
    JsonError(at, message)

fn JsonParser.fail(self, message str) JsonError
    JsonError(pos, message)

fn JsonParser.at_end(self) bool
    pos >= chars.len()

fn JsonParser.peek(self) char?
    if at_end()
        return none
    chars[pos]

fn JsonParser.unexpected(self) JsonError
    if c := peek()
        return fail("unexpected character '{c}'")
    fail("unexpected end of input")

fn JsonParser.skip_space(mut self)
    while not at_end() and " \t\n\r".contains(chars[pos])
        pos += 1

fn JsonParser.document(mut self) !Json
    value := value()?
    skip_space()
    if not at_end()
        return fail("extra data after value")
    value

fn JsonParser.value(mut self) !Json
    skip_space()
    c := peek() else return unexpected()
    if c == '-' or c.is_digit()
        return number()
    match c
        '{' => object()
        '[' => array()
        '"' => Str(string()?)
        _ =>
            if word("true")
                return Bool(true)
            if word("false")
                return Bool(false)
            if word("null")
                return Null
            unexpected()

fn JsonParser.word(mut self, w str) bool
    end := pos + w.chars().len()
    if end > chars.len() or chars[pos..end].join("") != w
        return false
    pos = end
    true

fn JsonParser.object(mut self) !Json
    pos += 1
    skip_space()
    if peek() == '}'
        pos += 1
        return Obj([])
    mut members := []
    while true
        skip_space()
        if peek() != '"'
            return unexpected()
        key := string()?
        skip_space()
        if peek() != ':'
            if at_end()
                return unexpected()
            return fail("expected ':' after object key")
        pos += 1
        members.push(JsonMember(key, value()?))
        if container_end('}')?
            return Obj(members)

fn JsonParser.array(mut self) !Json
    pos += 1
    skip_space()
    if peek() == ']'
        pos += 1
        return Arr([])
    mut items := []
    while true
        items.push(value()?)
        if container_end(']')?
            return Arr(items)

fn JsonParser.container_end(mut self, close char) !bool
    skip_space()
    if peek() == close
        pos += 1
        return true
    if peek() != ','
        return unexpected()
    comma := pos
    pos += 1
    skip_space()
    if peek() == ']' or peek() == '}'
        return fail_at(comma, "trailing comma")
    false

fn JsonParser.string(mut self) !str
    start := pos
    pos += 1
    mut text := []
    while true
        c := peek() else return fail_at(start, "unterminated string")
        match c
            '"' => break
            '\n' => return fail_at(start, "unterminated string")
            '\\' => text.push(escape(start)?)
            _ =>
                if c.code() < 0x20
                    return fail("control character in string")
                text.push(c)
                pos += 1
    pos += 1
    text.join("")

fn JsonParser.escape(mut self, start int) !char
    at := pos
    pos += 1
    c := peek() else return fail_at(start, "unterminated string")
    pos += 1
    match c
        '"' | '\\' | '/' => c
        'b' => '\u{8}'
        'f' => '\u{c}'
        'n' => '\n'
        'r' => '\r'
        't' => '\t'
        'u' => unicode(at)
        _ => return fail_at(at, "invalid escape '\\{c}'")

## Four hex digits at `pos`, advancing past them.
fn JsonParser.hex4(mut self, at int) !int
    end := pos + 4
    if end > chars.len()
        return fail_at(at, "invalid unicode escape")
    mut code := 0
    for d in chars[pos..end]
        code = code * 16 + (d.to_digit(16) else return fail_at(at, "invalid unicode escape"))
    pos = end
    code

## A `\u` escape; a high surrogate must be followed by `\u` and a low one.
fn JsonParser.unicode(mut self, at int) !char
    mut code := hex4(at)?
    if code >= 0xDC00 and code <= 0xDFFF
        return fail_at(at, "unpaired surrogate escape")
    if code >= 0xD800 and code <= 0xDBFF
        if pos + 2 > chars.len() or chars[pos] != '\\' or chars[pos + 1] != 'u'
            return fail_at(at, "unpaired surrogate escape")
        low_at := pos
        pos += 2
        low := hex4(low_at)?
        if low < 0xDC00 or low > 0xDFFF
            return fail_at(at, "unpaired surrogate escape")
        code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)
    ch := char.from_code(code) else return fail_at(at, "invalid unicode escape")
    ch

fn JsonParser.digits(mut self) int
    start := pos
    while not at_end() and chars[pos].is_digit()
        pos += 1
    pos - start

fn JsonParser.number(mut self) !Json
    start := pos
    if peek() == '-'
        pos += 1
    if peek() == '0'
        pos += 1
    elif digits() == 0
        return fail("invalid number")
    if peek() == '.'
        pos += 1
        if digits() == 0
            return fail("invalid number")
    if peek() == 'e' or peek() == 'E'
        pos += 1
        if peek() == '+' or peek() == '-'
            pos += 1
        if digits() == 0
            return fail("invalid number")
    text := chars[start..pos].join("")
    Num(text.to_float() else return fail_at(start, "invalid number"))

## Parse one JSON document (json.parse.1).
fn parse_json(text str) Json ! JsonError
    mut p := JsonParser(text.chars(), 0)
    p.document()

fn json_quote(s str) str
    mut out := ["\""]
    for c in s.chars()
        piece := match c
            '"' => "\\\""
            '\\' => "\\\\"
            '\n' => "\\n"
            '\r' => "\\r"
            '\t' => "\\t"
            '\u{8}' => "\\b"
            '\u{c}' => "\\f"
            _ =>
                if c.code() < 0x20
                    "\\u{c.code().to_hex().pad_left(4, '0')}"
                else
                    "{c}"
        out.push(piece)
    out.push("\"")
    out.join("")

## Compact text: no spaces, object members in document order (json.print.1).
fn Json.to_text(self) str
    match self
        Null => "null"
        Bool(b) => "{b}"
        Num(n) => "{n}"
        Str(s) => json_quote(s)
        Arr(items) =>
            mut parts := []
            for item in items
                parts.push(item.to_text())
            "[{parts.join(",")}]"
        Obj(members) =>
            mut parts := []
            for m in members
                parts.push("{json_quote(m.key)}:{m.value.to_text()}")
            "\{{parts.join(",")}}"

## The first member named `key`; `none` unless this is an object (json.query.1).
fn Json.get(self, key str) Json?
    match self
        Obj(members) =>
            for m in members
                if m.key == key
                    return m.value
            none
        Null | Bool(_) | Num(_) | Str(_) | Arr(_) => none

fn Json.at(self, i int) Json?
    match self
        Arr(items) =>
            if i < 0 or i >= items.len()
                return none
            items[i]
        Null | Bool(_) | Num(_) | Str(_) | Obj(_) => none

fn Json.as_str(self) str?
    match self
        Str(s) => s
        Null | Bool(_) | Num(_) | Arr(_) | Obj(_) => none

fn Json.as_num(self) float?
    match self
        Num(n) => n
        Null | Bool(_) | Str(_) | Arr(_) | Obj(_) => none

fn Json.as_bool(self) bool?
    match self
        Bool(b) => b
        Null | Num(_) | Str(_) | Arr(_) | Obj(_) => none

fn Json.as_arr(self) List[Json]?
    match self
        Arr(items) => items
        Null | Bool(_) | Num(_) | Str(_) | Obj(_) => none

fn Json.as_obj(self) List[JsonMember]?
    match self
        Obj(members) => members
        Null | Bool(_) | Num(_) | Str(_) | Arr(_) => none

## Typed fields: member `key` when it holds that variant, else `none` (json.query.2).
fn Json.str(self, key str) str?
    get(key)?.as_str()

fn Json.num(self, key str) float?
    get(key)?.as_num()

fn Json.bool(self, key str) bool?
    get(key)?.as_bool()

fn Json.arr(self, key str) List[Json]?
    get(key)?.as_arr()

## Replaces the first member named `key`, or adds one at the end; traps unless
## this is an object (json.query.3).
fn Json.set(mut self, key str, value Json)
    mut members := as_obj() else unreachable("json.query.3: `set` needs a JSON object")
    if i := [m.key for m in members].index_of(key)
        members[i].value = value
    else
        members.push(JsonMember(key: key, value: value))
    self = Json.Obj(members)

## A whole number, or `none` unless this is a number without a fraction.
fn Json.as_int(self) int?
    n := as_num()?
    if n.floor() != n
        return none
    n.to_int()

fn Json.int(self, key str) int?
    get(key)?.as_int()

## The JSON kind of this value, for messages: `null`, `bool`, `number`, ...
fn Json.kind(self) str
    match self
        Null => "null"
        Bool(_) => "bool"
        Num(_) => "number"
        Str(_) => "string"
        Arr(_) => "array"
        Obj(_) => "object"

## Member `key`, or a `JsonError` naming it (json.query.4). The `need_*`
## forms fail with the kind they expected; derived `from_json` uses them.
## `at` is -1: the value isn't tied to a place in a text.
fn Json.need(self, key str) Json ! JsonError
    v := get(key) else return JsonError(-1, "missing {key}")
    v

fn Json.need_str(self) str ! JsonError
    v := as_str() else return JsonError(-1, "expected a string, found {kind()}")
    v

fn Json.need_num(self) float ! JsonError
    v := as_num() else return JsonError(-1, "expected a number, found {kind()}")
    v

fn Json.need_int(self) int ! JsonError
    v := as_int() else return JsonError(-1, "expected a whole number, found {to_text()}")
    v

fn Json.need_bool(self) bool ! JsonError
    v := as_bool() else return JsonError(-1, "expected a bool, found {kind()}")
    v

fn Json.need_arr(self) List[Json] ! JsonError
    v := as_arr() else return JsonError(-1, "expected an array, found {kind()}")
    v

## @module jsonderive
## A value with a JSON form. `impl ToJson for T` with no methods derives
## `to_json` with `derive_to_json` (ct.derive.2, ADR 0307).
@derive(derive_to_json) trait ToJson
    fn to_json(self) Json

impl ToJson for Json
    fn to_json(self) Json
        self

impl ToJson for str
    fn to_json(self) Json
        Json.Str(self)

impl ToJson for int
    fn to_json(self) Json
        Json.Num(self.to_float())

impl ToJson for float
    fn to_json(self) Json
        Json.Num(self)

impl ToJson for bool
    fn to_json(self) Json
        Json.Bool(self)

impl ToJson for List[T ToJson]
    fn to_json(self) Json
        Json.Arr([x.to_json() for x in self])

## A type that can be read from JSON. `impl FromJson for T` derives the
## associated function `T.from_json(j Json) T ! JsonError` with
## `derive_from_json` (ct.derive.2, ct.gen.1, ADR 0307).
@derive(derive_from_json) trait FromJson

## A struct becomes an object of its fields in declaration order; an enum
## variant without fields becomes its name, one with fields an object
## `{"Name": {fields}}`. A field `T?` that is `none` becomes `null`.
fn derive_to_json(t TypeInfo) str ! DeriveError
    if t.kind == TypeKind.Struct
        return "fn to_json(self) Json\n    Json.Obj({json_members(t.fields, "self.", "    ")})\n"
    mut out := ["fn to_json(self) Json\n    match self\n"]
    for v in t.variants
        if v.fields.len() == 0
            out.push("        {v.name} => Json.Str(\"{v.name}\")\n")
        else
            names := [f.name for f in v.fields]
            body := "Json.Obj([JsonMember(\"{v.name}\", Json.Obj({json_members(v.fields, "", "            ")}))])"
            out.push("        {v.name}({names.join(", ")}) => {body}\n")
    out.join("")

## `[JsonMember(...), ...]` for `fields`, one per line after `indent`.
fn json_members(fields List[FieldInfo], prefix str, indent str) str
    if fields.len() == 0
        return "List[JsonMember]()"
    mut parts := []
    for f in fields
        value := if f.type_text.ends_with("?")
            "{prefix}{f.name}?.to_json() else Json.Null"
        else
            "{prefix}{f.name}.to_json()"
        parts.push("{indent}    JsonMember(\"{f.name}\", {value}),\n")
    "[\n{parts.join("")}{indent}]"

## A struct reads each field from the member of its name; a field `T?` may
## be missing. An enum reads a variant's name; variants with fields aren't
## supported yet.
fn derive_from_json(t TypeInfo) str ! DeriveError
    if t.params.len() > 0
        return DeriveError("`FromJson` can't be derived for the generic type `{t.name}` yet")
    head := "fn {t.name}.from_json(j Json) {t.name} ! JsonError\n"
    if t.kind == TypeKind.Struct
        mut args := []
        for f in t.fields
            value := json_field(f)?
            args.push("{f.name}: {value}")
        return "{head}    {t.name}({args.join(", ")})\n"
    mut out := [head, "    name := j.need_str()?\n"]
    for v in t.variants
        if v.fields.len() > 0
            return DeriveError("`FromJson` can't read the variant `{t.name}.{v.name}`: variants with fields aren't supported yet")
        out.push("    if name == \"{v.name}\"\n        return {t.name}.{v.name}\n")
    out.push("    return JsonError(-1, \"unknown {t.name} `\{name}`\")\n")
    out.join("")

fn json_field(f FieldInfo) str ! DeriveError
    key := "\"{f.name}\""
    if f.type_text.ends_with("?")
        reader := match f.type_text
            "str?" => "str"
            "float?" => "num"
            "int?" => "int"
            "bool?" => "bool"
            "Json?" => "get"
            _ => return DeriveError("`FromJson` can't read the optional field `{f.name} {f.type_text}` yet")
        return "j.{reader}({key})"
    json_value(f.type_text, "j.need({key})?", 0)

## Text that reads a `type_text` from the `Json` expression `v`.
fn json_value(type_text str, v str, nesting int) str ! DeriveError
    match type_text
        "str" => "{v}.need_str()?"
        "float" => "{v}.need_num()?"
        "int" => "{v}.need_int()?"
        "bool" => "{v}.need_bool()?"
        "Json" => v
        _ =>
            if inner := type_text.strip_prefix("List[")
                item := "e{nesting}"
                elem := json_value(inner.slice(0, inner.chars().len() - 1), item, nesting + 1)?
                return "[{elem} for {item} in {v}.need_arr()?]"
            if type_text.contains("[") or type_text.contains("?") or type_text.contains(" ")
                return DeriveError("`FromJson` can't read the type `{type_text}` yet")
            "{type_text}.from_json({v})?"
## @module derive
## Derive generators (ct.derive.1-4, refl.info.1-3, ADRs 0227, 0229, 0306):
## the compiler passes a generator the `TypeInfo` of the deriving type.

## One struct or enum as declared (refl.info.1).
struct TypeInfo
    name str
    id str
    module str
    kind TypeKind
    is_error bool
    params List[str]
    fields List[FieldInfo]
    variants List[VariantInfo]

enum TypeKind
    Struct
    Enum

struct FieldInfo
    name str
    type_text str
    public bool

struct VariantInfo
    name str
    fields List[FieldInfo]

## Why a generator can't derive its trait for a type (ct.derive.4).
error struct DeriveError
    message str
