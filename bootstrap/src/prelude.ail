## The standard traits and `Ordering` (ADR 0127). The bootstrap reads this
## before every program, so its declarations are built in.

enum Ordering
    Less
    Equal
    Greater

trait Eq
    fn eq(self, other Self) bool

trait Ord
    fn cmp(self, other Self) Ordering
    fn min(self, other Self) Self
        if self.cmp(other) == Greater
            other
        else
            self
    fn max(self, other Self) Self
        if self.cmp(other) == Less
            other
        else
            self

trait ToStr
    fn to_str(self) str

## Map keys and set elements. Automatic, with no methods (trait.auto.5).
trait Hash
