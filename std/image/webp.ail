## ---- Lossy: VP8 key frames (std.webp.11 to std.webp.17) ----

## The coefficient bands of the 17 positions of a block, the last one a stop (std.webp.14).
VP8_BANDS := [0, 1, 2, 3, 6, 4, 5, 6, 6, 6, 6, 6, 6, 6, 6, 7, 0]

## The order the 16 coefficients of a block are coded in, as positions in the 4x4 block.
VP8_ZIGZAG := [0, 1, 4, 8, 5, 2, 3, 6, 9, 12, 13, 10, 7, 11, 14, 15]

## The probabilities of the extra bits of the token categories 3 to 6, one after the other,
## with how many each has and where each starts.
VP8_CATP := [
    173,
    148,
    140,
    176,
    155,
    140,
    135,
    180,
    157,
    141,
    134,
    130,
    254,
    254,
    243,
    230,
    196,
    177,
    153,
    140,
    133,
    130,
    129,
]

VP8_CATLEN := [3, 4, 5, 11]
VP8_CATOFF := [0, 3, 7, 12]

## The arithmetic decoder of one VP8 partition (std.webp.11). `rng` is the range
## minus 1, from 127 to 254; `bits` holds the bits read and not yet used; `eof` is
## set when a bit is wanted past `stop`.
struct Arith
    data bytes
    pos int
    stop int
    rng int
    bits int
    nbits int
    eof bool

fn arith(data bytes, start int, stop int) Arith
    Arith(data: data, pos: start, stop: stop, rng: 254, bits: 0, nbits: 0, eof: false)

## The next bit, 0 or 1; `prob` is the chance in 256 that it is 0 (std.webp.11).
fn abit(mut a Arith, prob int) int
    if a.nbits < 8
        if a.pos >= a.stop
            a.eof = true
            return 0
        a.bits = a.bits | (a.data[a.pos].to_int() << (8 - a.nbits))
        a.pos += 1
        a.nbits += 8
    split := ((a.rng * prob) >> 8) + 1
    mut v := 0
    if a.bits >= (split << 8)
        a.rng = a.rng - split
        a.bits = a.bits - (split << 8)
        v = 1
    else
        a.rng = split - 1
    while a.rng < 127
        a.rng = (a.rng << 1) | 1
        a.bits = a.bits << 1
        a.nbits -= 1
    v

## An `n` bit number, high bit first, every bit at probability 128.
fn auint(mut a Arith, n int) int
    mut v := 0
    for _ in 0..n
        v = (v << 1) | abit(mut a, 128)
    v

## A flag, then (if it is set) an `n` bit number and a sign bit; 0 without the flag.
fn aopt(mut a Arith, n int) int
    if abit(mut a, 128) == 0
        return 0
    v := auint(mut a, n)
    if abit(mut a, 128) == 1
        return -v
    v

fn clamp(v int, lo int, hi int) int
    if v < lo
        return lo
    if v > hi
        return hi
    v

fn zeros(n int) List[int]
    mut out := List[int]()
    for _ in 0..n
        out.push(0)
    out

## What the first partition says before the macroblocks (std.webp.12 and std.webp.13).
## `quant` holds, per segment, the dequantization factors y1 dc, y1 ac, y2 dc, y2 ac,
## uv dc, uv ac; `fparams` holds, per segment and per kind of macroblock (0 whole-block
## prediction, 1 per-block prediction), the loop filter level, interior limit,
## high-edge-variance threshold and the kind.
struct Hdr
    seg bool
    upd_map bool
    seg_p List[int]
    simple bool
    filter_on bool
    nop_log2 int
    quant List[int]
    fparams List[int]
    prob List[int]
    use_skip bool
    skip_p int

fn read_header(mut a Arith) Hdr
    _ := abit(mut a, 128)
    _ := abit(mut a, 128)
    use_seg := abit(mut a, 128) == 1
    mut upd_map := false
    mut rel := false
    mut seg_q := zeros(4)
    mut seg_f := zeros(4)
    mut seg_p := [255, 255, 255]
    if use_seg
        upd_map = abit(mut a, 128) == 1
        if abit(mut a, 128) == 1
            rel = abit(mut a, 128) == 0
            for i in 0..4
                seg_q[i] = aopt(mut a, 7)
            for i in 0..4
                seg_f[i] = aopt(mut a, 6)
        if upd_map
            for i in 0..3
                if abit(mut a, 128) == 1
                    seg_p[i] = auint(mut a, 8)
                else
                    seg_p[i] = 255
    simple := abit(mut a, 128) == 1
    flevel := auint(mut a, 6)
    sharp := auint(mut a, 3)
    use_delta := abit(mut a, 128) == 1
    mut ref_d := zeros(4)
    mut mode_d := zeros(4)
    if use_delta and abit(mut a, 128) == 1
        for i in 0..4
            ref_d[i] = aopt(mut a, 6)
        for i in 0..4
            mode_d[i] = aopt(mut a, 6)
    mut fparams := List[int]()
    for sg in 0..4
        mut base := flevel
        if use_seg
            base = seg_f[sg]
            if rel
                base += flevel
        for j in 0..2
            mut level := base
            if use_delta
                level += ref_d[0]
                if j == 1
                    level += mode_d[0]
            if level <= 0
                fparams.push(0)
                fparams.push(0)
                fparams.push(0)
                fparams.push(j)
                continue
            level = level.min(63)
            mut il := level
            if sharp > 0
                if sharp > 4
                    il = il >> 2
                else
                    il = il >> 1
                il = il.min(9 - sharp)
            il = il.max(1)
            hl := if level < 15 then 0 elif level < 40 then 1 else 2
            fparams.push(2 * level + il)
            fparams.push(il)
            fparams.push(hl)
            fparams.push(j)
    nop_log2 := auint(mut a, 2)
    base_q := auint(mut a, 7)
    dq1 := aopt(mut a, 4)
    dq2 := aopt(mut a, 4)
    dq3 := aopt(mut a, 4)
    dq4 := aopt(mut a, 4)
    dq5 := aopt(mut a, 4)
    mut quant := List[int]()
    for sg in 0..4
        mut q := base_q
        if use_seg
            q = seg_q[sg]
            if rel
                q += base_q
        quant.push(VP8_DCQ[clamp(q + dq1, 0, 127)])
        quant.push(VP8_ACQ[clamp(q, 0, 127)])
        quant.push(VP8_DCQ[clamp(q + dq2, 0, 127)] * 2)
        quant.push((VP8_ACQ[clamp(q + dq3, 0, 127)] * 155 / 100).max(8))
        quant.push(VP8_DCQ[clamp(q + dq4, 0, 117)])
        quant.push(VP8_ACQ[clamp(q + dq5, 0, 127)])
    _ := abit(mut a, 128)
    mut prob := List[int]()
    for i in 0..1056
        if abit(mut a, VP8_UPDATE[i]) == 1
            prob.push(auint(mut a, 8))
        else
            prob.push(VP8_DEFAULT[i])
    use_skip := abit(mut a, 128) == 1
    mut skip_p := 0
    if use_skip
        skip_p = auint(mut a, 8)
    Hdr(
        seg: use_seg,
        upd_map: upd_map,
        seg_p: seg_p,
        simple: simple,
        filter_on: flevel != 0,
        nop_log2: nop_log2,
        quant: quant,
        fparams: fparams,
        prob: prob,
        use_skip: use_skip,
        skip_p: skip_p,
    )

## The decoded planes of a VP8 frame: luma then the two chroma planes in `pl`, each
## padded to whole macroblocks (`sy` and `sc` are the row lengths, `uo` and `vo` where
## the chroma planes start).
struct Planes
    width int
    height int
    sy int
    sc int
    uo int
    vo int
    pl List[int]

## The state of the macroblock being decoded and of its neighbours: `ybr` is the
## 26 row by 32 column workspace (luma at row 1, column 8; the two chroma blocks at
## rows 18 and columns 8 and 24; the row above and the column left around them),
## `coeff` the 400 coefficients (16 luma blocks, 4 + 4 chroma blocks, then the 16
## second-order ones from 384), `up_*` and `left_*` what the blocks above and left
## of the macroblock say (std.webp.14), `mbf` four numbers per macroblock for the
## loop filter.
struct Ctx
    pl List[int]
    sy int
    sc int
    uo int
    vo int
    ybr List[int]
    coeff List[int]
    tmp List[int]
    up_pred List[int]
    up_nz List[int]
    up_nzy List[int]
    left_pred List[int]
    left_nz int
    left_nzy int
    seg int
    mbf List[int]

fn clip8(v int) int
    if v < 0
        return 0
    if v > 255
        return 255
    v

## Sets the row above and the column left of the macroblock in the workspace from
## the neighbours already decoded, or from 127 above and 129 left at the edges (std.webp.15).
fn prep_ybr(mut c Ctx, mbx int, mby int, mbw int)
    if mbx == 0
        for y in 0..17
            c.ybr[y * 32 + 7] = 129
        for y in 17..26
            c.ybr[y * 32 + 7] = 129
            c.ybr[y * 32 + 23] = 129
    else
        for y in 0..17
            c.ybr[y * 32 + 7] = c.ybr[y * 32 + 23]
        for y in 17..26
            c.ybr[y * 32 + 7] = c.ybr[y * 32 + 15]
            c.ybr[y * 32 + 23] = c.ybr[y * 32 + 31]
    if mby == 0
        for x in 7..28
            c.ybr[x] = 127
        for x in 7..16
            c.ybr[17 * 32 + x] = 127
        for x in 23..32
            c.ybr[17 * 32 + x] = 127
    else
        for i in 0..16
            c.ybr[8 + i] = c.pl[(16 * mby - 1) * c.sy + 16 * mbx + i]
        for i in 0..8
            c.ybr[17 * 32 + 8 + i] = c.pl[c.uo + (8 * mby - 1) * c.sc + 8 * mbx + i]
            c.ybr[17 * 32 + 24 + i] = c.pl[c.vo + (8 * mby - 1) * c.sc + 8 * mbx + i]
        for i in 16..20
            if mbx == mbw - 1
                c.ybr[8 + i] = c.pl[(16 * mby - 1) * c.sy + 16 * mbx + 15]
            else
                c.ybr[8 + i] = c.pl[(16 * mby - 1) * c.sy + 16 * mbx + i]
    for y in [4, 8, 12]
        for i in 24..28
            c.ybr[y * 32 + i] = c.ybr[i]

## Reads the tokens of one 4x4 block of coefficients into `c.coeff` from `cb` on and
## gives 1 when the block has any, else 0 (std.webp.14). `plane` is 0 luma with a
## second-order block, 1 second-order, 2 chroma, 3 luma alone; `ctx` how many of the
## blocks left and above had any; `first` that the first coefficient is not coded.
fn residual(
    mut t Arith,
    prob List[int],
    plane int,
    ctx int,
    qdc int,
    qac int,
    first bool,
    mut c Ctx,
    cb int,
) int
    pb := plane * 264
    mut n := 0
    if first
        n = 1
    mut p := pb + (VP8_BANDS[n] * 3 + ctx) * 11
    if abit(mut t, prob[p]) == 0
        return 0
    while n != 16
        n += 1
        if abit(mut t, prob[p + 1]) == 0
            p = pb + VP8_BANDS[n] * 33
            continue
        mut v := 0
        if abit(mut t, prob[p + 2]) == 0
            v = 1
            p = pb + (VP8_BANDS[n] * 3 + 1) * 11
        else
            if abit(mut t, prob[p + 3]) == 0
                if abit(mut t, prob[p + 4]) == 0
                    v = 2
                else
                    v = 3 + abit(mut t, prob[p + 5])
            elif abit(mut t, prob[p + 6]) == 0
                if abit(mut t, prob[p + 7]) == 0
                    v = 5 + abit(mut t, 159)
                else
                    v = 7 + 2 * abit(mut t, 165)
                    v += abit(mut t, 145)
            else
                b1 := abit(mut t, prob[p + 8])
                b0 := abit(mut t, prob[p + 9 + b1])
                cat := 2 * b1 + b0
                v = 0
                for k in 0..VP8_CATLEN[cat]
                    v = v * 2 + abit(mut t, VP8_CATP[VP8_CATOFF[cat] + k])
                v += 3 + (8 << cat)
            p = pb + (VP8_BANDS[n] * 3 + 2) * 11
        z := VP8_ZIGZAG[n - 1]
        mut q := qdc
        if z > 0
            q = qac
        mut cf := v * q
        if abit(mut t, 128) == 1
            cf = -cf
        c.coeff[cb + z] = cf
        if n == 16 or abit(mut t, prob[p]) == 0
            return 1
    1

## The inverse Walsh-Hadamard transform of the second-order block: it gives the DC
## coefficient of each of the 16 luma blocks (std.webp.14).
fn wht(mut c Ctx)
    for i in 0..4
        a0 := c.coeff[384 + i] + c.coeff[396 + i]
        a1 := c.coeff[388 + i] + c.coeff[392 + i]
        a2 := c.coeff[388 + i] - c.coeff[392 + i]
        a3 := c.coeff[384 + i] - c.coeff[396 + i]
        c.tmp[i] = a0 + a1
        c.tmp[8 + i] = a0 - a1
        c.tmp[4 + i] = a3 + a2
        c.tmp[12 + i] = a3 - a2
    for i in 0..4
        dc := c.tmp[i * 4] + 3
        a0 := dc + c.tmp[3 + i * 4]
        a1 := c.tmp[1 + i * 4] + c.tmp[2 + i * 4]
        a2 := c.tmp[1 + i * 4] - c.tmp[2 + i * 4]
        a3 := dc - c.tmp[3 + i * 4]
        c.coeff[i * 64] = (a0 + a1) >> 3
        c.coeff[i * 64 + 16] = (a3 + a2) >> 3
        c.coeff[i * 64 + 32] = (a0 - a1) >> 3
        c.coeff[i * 64 + 48] = (a3 - a2) >> 3

## Adds the inverse DCT of the block at `cb` to the 4x4 pixels at row `y`, column `x` of the workspace.
fn idct(mut c Ctx, y int, x int, cb int)
    for i in 0..4
        c0 := c.coeff[cb + i]
        c4 := c.coeff[cb + 4 + i]
        c8 := c.coeff[cb + 8 + i]
        c12 := c.coeff[cb + 12 + i]
        a := c0 + c8
        b := c0 - c8
        e := ((c4 * 35468) >> 16) - ((c12 * 85627) >> 16)
        d := ((c4 * 85627) >> 16) + ((c12 * 35468) >> 16)
        c.tmp[i * 4] = a + d
        c.tmp[i * 4 + 1] = b + e
        c.tmp[i * 4 + 2] = b - e
        c.tmp[i * 4 + 3] = a - d
    for j in 0..4
        dc := c.tmp[j] + 4
        a := dc + c.tmp[8 + j]
        b := dc - c.tmp[8 + j]
        e := ((c.tmp[4 + j] * 35468) >> 16) - ((c.tmp[12 + j] * 85627) >> 16)
        d := ((c.tmp[4 + j] * 85627) >> 16) + ((c.tmp[12 + j] * 35468) >> 16)
        o := (y + j) * 32 + x
        c.ybr[o] = clip8(c.ybr[o] + ((a + d) >> 3))
        c.ybr[o + 1] = clip8(c.ybr[o + 1] + ((b + e) >> 3))
        c.ybr[o + 2] = clip8(c.ybr[o + 2] + ((b - e) >> 3))
        c.ybr[o + 3] = clip8(c.ybr[o + 3] + ((a - d) >> 3))

## Adds a DC-only block to the 4x4 pixels at row `y`, column `x`.
fn idct_dc(mut c Ctx, y int, x int, dc0 int)
    dc := (dc0 + 4) >> 3
    for j in 0..4
        for i in 0..4
            o := (y + j) * 32 + x + i
            c.ybr[o] = clip8(c.ybr[o] + dc)

fn fill(mut c Ctx, y int, x int, n int, v int)
    for j in 0..n
        for i in 0..n
            c.ybr[(y + j) * 32 + x + i] = v

## Predicts the `n` x `n` block (16 or 8) at row `y`, column `x` of the workspace
## (std.webp.15): modes 0 DC, 1 TrueMotion, 2 vertical, 3 horizontal, and 10 DC of
## the left column only, 11 DC of the row above only, 12 flat 128 (the DC cases at
## the top and left edges).
fn pred_block(mut c Ctx, y int, x int, n int, mode int)
    if mode == 0
        mut s := n
        for i in 0..n
            s += c.ybr[(y - 1) * 32 + x + i] + c.ybr[(y + i) * 32 + x - 1]
        fill(mut c, y, x, n, s / (2 * n))
    elif mode == 10
        mut s := n / 2
        for j in 0..n
            s += c.ybr[(y + j) * 32 + x - 1]
        fill(mut c, y, x, n, s / n)
    elif mode == 11
        mut s := n / 2
        for i in 0..n
            s += c.ybr[(y - 1) * 32 + x + i]
        fill(mut c, y, x, n, s / n)
    elif mode == 12
        fill(mut c, y, x, n, 128)
    elif mode == 1
        corner := c.ybr[(y - 1) * 32 + x - 1]
        for j in 0..n
            d1 := c.ybr[(y + j) * 32 + x - 1] - corner
            for i in 0..n
                c.ybr[(y + j) * 32 + x + i] = clip8(d1 + c.ybr[(y - 1) * 32 + x + i])
    elif mode == 2
        for j in 0..n
            for i in 0..n
                c.ybr[(y + j) * 32 + x + i] = c.ybr[(y - 1) * 32 + x + i]
    else
        for j in 0..n
            for i in 0..n
                c.ybr[(y + j) * 32 + x + i] = c.ybr[(y + j) * 32 + x - 1]

fn put4(mut c Ctx, y int, x int, v0 int, v1 int, v2 int, v3 int, row int)
    o := (y + row) * 32 + x
    c.ybr[o] = v0
    c.ybr[o + 1] = v1
    c.ybr[o + 2] = v2
    c.ybr[o + 3] = v3

## Predicts the 4x4 block at row `y`, column `x` with one of the ten per-block modes
## (std.webp.15): 0 DC, 1 TrueMotion, 2 vertical, 3 horizontal, 4 down-right,
## 5 vertical-right, 6 down-left, 7 vertical-left, 8 horizontal-down, 9 horizontal-up.
fn pred4(mut c Ctx, y int, x int, mode int)
    t := (y - 1) * 32 + x
    a := c.ybr[t - 1]
    b := c.ybr[t]
    cc := c.ybr[t + 1]
    d := c.ybr[t + 2]
    e := c.ybr[t + 3]
    f := c.ybr[t + 4]
    g := c.ybr[t + 5]
    h := c.ybr[t + 6]
    ni := c.ybr[t + 7]
    p := c.ybr[y * 32 + x - 1]
    q := c.ybr[(y + 1) * 32 + x - 1]
    r := c.ybr[(y + 2) * 32 + x - 1]
    s := c.ybr[(y + 3) * 32 + x - 1]
    if mode == 0
        fill(mut c, y, x, 4, (b + cc + d + e + p + q + r + s + 4) >> 3)
    elif mode == 1
        for j in 0..4
            left := c.ybr[(y + j) * 32 + x - 1]
            for i in 0..4
                c.ybr[(y + j) * 32 + x + i] = clip8(left + c.ybr[t + i] - a)
    elif mode == 2
        v0 := (a + 2 * b + cc + 2) >> 2
        v1 := (b + 2 * cc + d + 2) >> 2
        v2 := (cc + 2 * d + e + 2) >> 2
        v3 := (d + 2 * e + f + 2) >> 2
        for j in 0..4
            put4(mut c, y, x, v0, v1, v2, v3, j)
    elif mode == 3
        h0 := (a + 2 * p + q + 2) >> 2
        h1 := (p + 2 * q + r + 2) >> 2
        h2 := (q + 2 * r + s + 2) >> 2
        h3 := (r + 2 * s + s + 2) >> 2
        put4(mut c, y, x, h0, h0, h0, h0, 0)
        put4(mut c, y, x, h1, h1, h1, h1, 1)
        put4(mut c, y, x, h2, h2, h2, h2, 2)
        put4(mut c, y, x, h3, h3, h3, h3, 3)
    elif mode == 4
        srq := (s + 2 * r + q + 2) >> 2
        rqp := (r + 2 * q + p + 2) >> 2
        qpa := (q + 2 * p + a + 2) >> 2
        pab := (p + 2 * a + b + 2) >> 2
        abc := (a + 2 * b + cc + 2) >> 2
        bcd := (b + 2 * cc + d + 2) >> 2
        cde := (cc + 2 * d + e + 2) >> 2
        put4(mut c, y, x, pab, abc, bcd, cde, 0)
        put4(mut c, y, x, qpa, pab, abc, bcd, 1)
        put4(mut c, y, x, rqp, qpa, pab, abc, 2)
        put4(mut c, y, x, srq, rqp, qpa, pab, 3)
    elif mode == 5
        ab := (a + b + 1) >> 1
        bc := (b + cc + 1) >> 1
        cd := (cc + d + 1) >> 1
        de := (d + e + 1) >> 1
        rqp := (r + 2 * q + p + 2) >> 2
        qpa := (q + 2 * p + a + 2) >> 2
        pab := (p + 2 * a + b + 2) >> 2
        abc := (a + 2 * b + cc + 2) >> 2
        bcd := (b + 2 * cc + d + 2) >> 2
        cde := (cc + 2 * d + e + 2) >> 2
        put4(mut c, y, x, ab, bc, cd, de, 0)
        put4(mut c, y, x, pab, abc, bcd, cde, 1)
        put4(mut c, y, x, qpa, ab, bc, cd, 2)
        put4(mut c, y, x, rqp, pab, abc, bcd, 3)
    elif mode == 6
        abc := (b + 2 * cc + d + 2) >> 2
        bcd := (cc + 2 * d + e + 2) >> 2
        cde := (d + 2 * e + f + 2) >> 2
        dfe := (e + 2 * f + g + 2) >> 2
        efg := (f + 2 * g + h + 2) >> 2
        fgh := (g + 2 * h + ni + 2) >> 2
        ghh := (h + 2 * ni + ni + 2) >> 2
        put4(mut c, y, x, abc, bcd, cde, dfe, 0)
        put4(mut c, y, x, bcd, cde, dfe, efg, 1)
        put4(mut c, y, x, cde, dfe, efg, fgh, 2)
        put4(mut c, y, x, dfe, efg, fgh, ghh, 3)
    elif mode == 7
        ab := (b + cc + 1) >> 1
        bc := (cc + d + 1) >> 1
        cd := (d + e + 1) >> 1
        de := (e + f + 1) >> 1
        abc := (b + 2 * cc + d + 2) >> 2
        bcd := (cc + 2 * d + e + 2) >> 2
        cde := (d + 2 * e + f + 2) >> 2
        dfe := (e + 2 * f + g + 2) >> 2
        efg := (f + 2 * g + h + 2) >> 2
        fgh := (g + 2 * h + ni + 2) >> 2
        put4(mut c, y, x, ab, bc, cd, de, 0)
        put4(mut c, y, x, abc, bcd, cde, dfe, 1)
        put4(mut c, y, x, bc, cd, de, efg, 2)
        put4(mut c, y, x, bcd, cde, dfe, fgh, 3)
    elif mode == 8
        sr := (s + r + 1) >> 1
        rq := (r + q + 1) >> 1
        qp := (q + p + 1) >> 1
        pa := (p + a + 1) >> 1
        srq := (s + 2 * r + q + 2) >> 2
        rqp := (r + 2 * q + p + 2) >> 2
        qpa := (q + 2 * p + a + 2) >> 2
        pab := (p + 2 * a + b + 2) >> 2
        abc := (a + 2 * b + cc + 2) >> 2
        bcd := (b + 2 * cc + d + 2) >> 2
        put4(mut c, y, x, pa, pab, abc, bcd, 0)
        put4(mut c, y, x, qp, qpa, pa, pab, 1)
        put4(mut c, y, x, rq, rqp, qp, qpa, 2)
        put4(mut c, y, x, sr, srq, rq, rqp, 3)
    else
        pq := (p + q + 1) >> 1
        qr := (q + r + 1) >> 1
        rs := (r + s + 1) >> 1
        pqr := (p + 2 * q + r + 2) >> 2
        qrs := (q + 2 * r + s + 2) >> 2
        rss := (r + 2 * s + s + 2) >> 2
        put4(mut c, y, x, pq, pqr, qr, qrs, 0)
        put4(mut c, y, x, qr, qrs, rs, rss, 1)
        put4(mut c, y, x, rs, rss, s, s, 2)
        put4(mut c, y, x, s, s, s, s, 3)

## Decodes one macroblock: reads its modes from the first partition `fp` and its
## coefficients from the token partition `t`, predicts and adds the residual in the
## workspace, and copies the result into the planes (std.webp.13 to std.webp.15).
fn decode_mb(mut fp Arith, mut t Arith, hd Hdr, mut c Ctx, mbx int, mby int, mbw int)
    if hd.upd_map
        if abit(mut fp, hd.seg_p[0]) == 0
            c.seg = abit(mut fp, hd.seg_p[1])
        else
            c.seg = abit(mut fp, hd.seg_p[2]) + 2
    mut skip := 0
    if hd.use_skip
        skip = abit(mut fp, hd.skip_p)
    for i in 0..400
        c.coeff[i] = 0
    prep_ybr(mut c, mbx, mby, mbw)
    y16 := abit(mut fp, 145)
    mut pred16 := 0
    mut pred4s := zeros(16)
    if y16 == 1
        if abit(mut fp, 156) == 0
            if abit(mut fp, 163) == 0
                pred16 = 0
            else
                pred16 = 2
        elif abit(mut fp, 128) == 0
            pred16 = 3
        else
            pred16 = 1
        for i in 0..4
            c.up_pred[mbx * 4 + i] = pred16
            c.left_pred[i] = pred16
    else
        for j in 0..4
            mut p := c.left_pred[j]
            for i in 0..4
                o := (c.up_pred[mbx * 4 + i] * 10 + p) * 9
                if abit(mut fp, VP8_BMODE[o]) == 0
                    p = 0
                elif abit(mut fp, VP8_BMODE[o + 1]) == 0
                    p = 1
                elif abit(mut fp, VP8_BMODE[o + 2]) == 0
                    p = 2
                elif abit(mut fp, VP8_BMODE[o + 3]) == 0
                    if abit(mut fp, VP8_BMODE[o + 4]) == 0
                        p = 3
                    elif abit(mut fp, VP8_BMODE[o + 5]) == 0
                        p = 4
                    else
                        p = 5
                elif abit(mut fp, VP8_BMODE[o + 6]) == 0
                    p = 6
                elif abit(mut fp, VP8_BMODE[o + 7]) == 0
                    p = 7
                elif abit(mut fp, VP8_BMODE[o + 8]) == 0
                    p = 8
                else
                    p = 9
                pred4s[j * 4 + i] = p
                c.up_pred[mbx * 4 + i] = p
            c.left_pred[j] = p
    mut predc := 0
    if abit(mut fp, 142) == 0
        predc = 0
    elif abit(mut fp, 114) == 0
        predc = 2
    elif abit(mut fp, 183) == 0
        predc = 3
    else
        predc = 1
    mut nzdc := 0
    mut nzac := 0
    if skip == 0
        qb := c.seg * 6
        mut plane := 3
        if y16 == 1
            nz := residual(
                mut t,
                hd.prob,
                1,
                c.left_nzy + c.up_nzy[mbx],
                hd.quant[qb + 2],
                hd.quant[qb + 3],
                false,
                mut c,
                384,
            )
            c.left_nzy = nz
            c.up_nzy[mbx] = nz
            wht(mut c)
            plane = 0
        mut lnz := zeros(8)
        mut unz := zeros(8)
        for i in 0..8
            lnz[i] = (c.left_nz >> i) & 1
            unz[i] = (c.up_nz[mbx] >> i) & 1
        mut cb := 0
        for yy in 0..4
            mut nz := lnz[yy]
            for xx in 0..4
                nz = residual(
                    mut t,
                    hd.prob,
                    plane,
                    nz + unz[xx],
                    hd.quant[qb],
                    hd.quant[qb + 1],
                    y16 == 1,
                    mut c,
                    cb,
                )
                unz[xx] = nz
                if nz == 1
                    nzac = nzac | (1 << (yy * 4 + xx))
                if c.coeff[cb] != 0
                    nzdc = nzdc | (1 << (yy * 4 + xx))
                cb += 16
            lnz[yy] = nz
        for pc in [0, 2]
            for yy in 0..2
                mut nz := lnz[4 + yy + pc]
                for xx in 0..2
                    nz = residual(
                        mut t,
                        hd.prob,
                        2,
                        nz + unz[4 + xx + pc],
                        hd.quant[qb + 4],
                        hd.quant[qb + 5],
                        false,
                        mut c,
                        cb,
                    )
                    unz[4 + xx + pc] = nz
                    if nz == 1
                        nzac = nzac | (1 << (16 + pc * 2 + yy * 2 + xx))
                    if c.coeff[cb] != 0
                        nzdc = nzdc | (1 << (16 + pc * 2 + yy * 2 + xx))
                    cb += 16
                lnz[4 + yy + pc] = nz
        mut lm := 0
        mut um := 0
        for i in 0..8
            lm = lm | (lnz[i] << i)
            um = um | (unz[i] << i)
        c.left_nz = lm
        c.up_nz[mbx] = um
        if nzdc == 0 and nzac == 0
            skip = 1
    else
        if y16 == 1
            c.left_nzy = 0
            c.up_nzy[mbx] = 0
        c.left_nz = 0
        c.up_nz[mbx] = 0
    if y16 == 1
        mut pm := pred16
        if pm == 0
            if mbx == 0 and mby == 0
                pm = 12
            elif mbx == 0
                pm = 11
            elif mby == 0
                pm = 10
        pred_block(mut c, 1, 8, 16, pm)
        for n in 0..16
            by := (n >> 2) * 4 + 1
            bx := (n & 3) * 4 + 8
            if ((nzac >> n) & 1) == 1
                idct(mut c, by, bx, 16 * n)
            elif ((nzdc >> n) & 1) == 1
                idct_dc(mut c, by, bx, c.coeff[16 * n])
    else
        for n in 0..16
            by := (n >> 2) * 4 + 1
            bx := (n & 3) * 4 + 8
            pred4(mut c, by, bx, pred4s[n])
            if ((nzac >> n) & 1) == 1
                idct(mut c, by, bx, 16 * n)
            elif ((nzdc >> n) & 1) == 1
                idct_dc(mut c, by, bx, c.coeff[16 * n])
    mut cm := predc
    if cm == 0
        if mbx == 0 and mby == 0
            cm = 12
        elif mbx == 0
            cm = 11
        elif mby == 0
            cm = 10
    for k in 0..2
        by := 18
        bx := 8 + 16 * k
        cbase := 256 + 64 * k
        pred_block(mut c, by, bx, 8, cm)
        if ((nzac >> (16 + 4 * k)) & 15) != 0
            for q in 0..4
                idct(mut c, by + (q >> 1) * 4, bx + (q & 1) * 4, cbase + 16 * q)
        elif ((nzdc >> (16 + 4 * k)) & 15) != 0
            for q in 0..4
                idct_dc(mut c, by + (q >> 1) * 4, bx + (q & 1) * 4, c.coeff[cbase + 16 * q])
    for y in 0..16
        for x in 0..16
            c.pl[(mby * 16 + y) * c.sy + mbx * 16 + x] = c.ybr[(1 + y) * 32 + 8 + x]
    for y in 0..8
        for x in 0..8
            c.pl[c.uo + (mby * 8 + y) * c.sc + mbx * 8 + x] = c.ybr[(18 + y) * 32 + 8 + x]
            c.pl[c.vo + (mby * 8 + y) * c.sc + mbx * 8 + x] = c.ybr[(18 + y) * 32 + 24 + x]
    fo := (c.seg * 2 + (1 - y16)) * 4
    k4 := (mby * mbw + mbx) * 4
    c.mbf[k4] = hd.fparams[fo]
    c.mbf[k4 + 1] = hd.fparams[fo + 1]
    c.mbf[k4 + 2] = hd.fparams[fo + 2]
    if hd.fparams[fo + 3] == 1 or skip == 0
        c.mbf[k4 + 3] = 1
    else
        c.mbf[k4 + 3] = 0

## Filters 16 or 8 positions along an edge with the simple filter (std.webp.16): `idx` is
## the first pixel after the edge, `istep` the distance to the next position along
## the edge and `jstep` the distance across it.
fn filter2(mut c Ctx, level int, idx int, istep int, jstep int)
    mut i := idx
    for _ in 0..16
        p1 := c.pl[i - 2 * jstep]
        p0 := c.pl[i - jstep]
        q0 := c.pl[i]
        q1 := c.pl[i + jstep]
        if ((p0 - q0).abs() << 1) + ((p1 - q1).abs() >> 1) <= level
            a := 3 * (q0 - p0) + clamp(p1 - q1, -128, 127)
            a1 := clamp((a + 4) >> 3, -16, 15)
            a2 := clamp((a + 3) >> 3, -16, 15)
            c.pl[i - jstep] = clip8(p0 + a2)
            c.pl[i] = clip8(q0 - a1)
        i += istep

## The normal loop filter of `n` positions along an edge: `four` for the edges inside a
## macroblock (std.webp.16).
fn filter246(
    mut c Ctx,
    n int,
    level int,
    ilevel int,
    hlevel int,
    idx int,
    istep int,
    jstep int,
    four bool,
)
    mut i := idx
    for _ in 0..n
        p3 := c.pl[i - 4 * jstep]
        p2 := c.pl[i - 3 * jstep]
        p1 := c.pl[i - 2 * jstep]
        p0 := c.pl[i - jstep]
        q0 := c.pl[i]
        q1 := c.pl[i + jstep]
        q2 := c.pl[i + 2 * jstep]
        q3 := c.pl[i + 3 * jstep]
        mut edge := ((p0 - q0).abs() << 1) + ((p1 - q1).abs() >> 1) <= level
        if edge
            edge = (p3 - p2).abs() <= ilevel
                and (p2 - p1).abs() <= ilevel
                and (p1 - p0).abs() <= ilevel
                and (q1 - q0).abs() <= ilevel
                and (q2 - q1).abs() <= ilevel
                and (q3 - q2).abs() <= ilevel
        if edge
            if (p1 - p0).abs() > hlevel or (q1 - q0).abs() > hlevel
                a := 3 * (q0 - p0) + clamp(p1 - q1, -128, 127)
                a1 := clamp((a + 4) >> 3, -16, 15)
                a2 := clamp((a + 3) >> 3, -16, 15)
                c.pl[i - jstep] = clip8(p0 + a2)
                c.pl[i] = clip8(q0 - a1)
            elif four
                a := 3 * (q0 - p0)
                a1 := clamp((a + 4) >> 3, -16, 15)
                a2 := clamp((a + 3) >> 3, -16, 15)
                a3 := (a1 + 1) >> 1
                c.pl[i - 2 * jstep] = clip8(p1 + a3)
                c.pl[i - jstep] = clip8(p0 + a2)
                c.pl[i] = clip8(q0 - a1)
                c.pl[i + jstep] = clip8(q1 - a3)
            else
                a := clamp(3 * (q0 - p0) + clamp(p1 - q1, -128, 127), -128, 127)
                a1 := (27 * a + 63) >> 7
                a2 := (18 * a + 63) >> 7
                a3 := (9 * a + 63) >> 7
                c.pl[i - 3 * jstep] = clip8(p2 + a3)
                c.pl[i - 2 * jstep] = clip8(p1 + a2)
                c.pl[i - jstep] = clip8(p0 + a1)
                c.pl[i] = clip8(q0 - a1)
                c.pl[i + jstep] = clip8(q1 - a2)
                c.pl[i + 2 * jstep] = clip8(q2 - a3)
        i += istep

## Filters every macroblock edge of the decoded planes, left to right and top to
## bottom, once the whole frame is decoded (std.webp.16).
fn loop_filter(mut c Ctx, simple bool, mbw int, mbh int)
    for mby in 0..mbh
        for mbx in 0..mbw
            k4 := (mby * mbw + mbx) * 4
            lv := c.mbf[k4]
            if lv == 0
                continue
            il := c.mbf[k4 + 1]
            hl := c.mbf[k4 + 2]
            inner := c.mbf[k4 + 3] == 1
            yi := (mby * c.sy + mbx) * 16
            ui := c.uo + (mby * c.sc + mbx) * 8
            vi := c.vo + (mby * c.sc + mbx) * 8
            if simple
                if mbx > 0
                    filter2(mut c, lv + 4, yi, c.sy, 1)
                if inner
                    for o in [4, 8, 12]
                        filter2(mut c, lv, yi + o, c.sy, 1)
                if mby > 0
                    filter2(mut c, lv + 4, yi, 1, c.sy)
                if inner
                    for o in [4, 8, 12]
                        filter2(mut c, lv, yi + c.sy * o, 1, c.sy)
                continue
            if mbx > 0
                filter246(mut c, 16, lv + 4, il, hl, yi, c.sy, 1, false)
                filter246(mut c, 8, lv + 4, il, hl, ui, c.sc, 1, false)
                filter246(mut c, 8, lv + 4, il, hl, vi, c.sc, 1, false)
            if inner
                for o in [4, 8, 12]
                    filter246(mut c, 16, lv, il, hl, yi + o, c.sy, 1, true)
                filter246(mut c, 8, lv, il, hl, ui + 4, c.sc, 1, true)
                filter246(mut c, 8, lv, il, hl, vi + 4, c.sc, 1, true)
            if mby > 0
                filter246(mut c, 16, lv + 4, il, hl, yi, 1, c.sy, false)
                filter246(mut c, 8, lv + 4, il, hl, ui, 1, c.sc, false)
                filter246(mut c, 8, lv + 4, il, hl, vi, 1, c.sc, false)
            if inner
                for o in [4, 8, 12]
                    filter246(mut c, 16, lv, il, hl, yi + c.sy * o, 1, c.sy, true)
                filter246(mut c, 8, lv, il, hl, ui + c.sc * 4, 1, c.sc, true)
                filter246(mut c, 8, lv, il, hl, vi + c.sc * 4, 1, c.sc, true)

## The planes of the VP8 key frame in `data` (std.webp.11 to std.webp.16): the frame
## header, the first partition (segments, loop filter, quantizers, probabilities),
## the token partitions, every macroblock, then the loop filter.
fn decode_vp8(data bytes) Planes ! WebpError
    if data.len() < 10
        return bad(
            WebpKind.Truncated,
            "the VP8 chunk has {data.len()} bytes, not even the frame header",
        )
    tag := data[0].to_int() | (data[1].to_int() << 8) | (data[2].to_int() << 16)
    if (tag & 1) != 0
        return bad(WebpKind.Corrupt, "the VP8 frame is not a key frame")
    if ((tag >> 1) & 7) > 3
        return bad(WebpKind.Corrupt, "the VP8 version {(tag >> 1) & 7} is not 0 to 3")
    if ((tag >> 4) & 1) == 0
        return bad(WebpKind.Unsupported, "the VP8 frame is not meant to be shown")
    plen := tag >> 5
    if data[3..6] != b"\x9d\x01\x2a"
        return bad(WebpKind.Corrupt, "the VP8 frame does not have the start code 9d 01 2a")
    w := data.u16_le(6) & 16383
    h := data.u16_le(8) & 16383
    if w == 0 or h == 0
        return bad(WebpKind.Corrupt, "the VP8 frame is {w}x{h}")
    if w * h > image.MAX_PIXELS
        return bad(WebpKind.Unsupported, "{w}x{h} has more than {image.MAX_PIXELS} pixels")
    if 10 + plen > data.len()
        return bad(
            WebpKind.Truncated,
            "the first VP8 partition of {plen} bytes runs past the end of the chunk",
        )
    mut fp := arith(data, 10, 10 + plen)
    hd := read_header(mut fp)
    if fp.eof
        return bad(WebpKind.Truncated, "the VP8 frame header ends early")
    nop := 1 << hd.nop_log2
    tbl := 10 + plen
    mut at := tbl + 3 * (nop - 1)
    if at > data.len()
        return bad(
            WebpKind.Truncated,
            "the table of {nop} VP8 partitions runs past the end of the chunk",
        )
    mut left := data.len() - at
    mut parts := List[Arith]()
    for i in 0..(nop - 1)
        pl := u24(data, tbl + 3 * i)
        if pl > left
            return bad(
                WebpKind.Truncated,
                "VP8 partition {i} of {pl} bytes runs past the end of the chunk",
            )
        parts.push(arith(data, at, at + pl))
        at += pl
        left -= pl
    parts.push(arith(data, at, at + left))
    mbw := (w + 15) >> 4
    mbh := (h + 15) >> 4
    sy := mbw * 16
    sc := mbw * 8
    ysz := sy * mbh * 16
    csz := sc * mbh * 8
    mut c := Ctx(
        pl: zeros(ysz + 2 * csz),
        sy: sy,
        sc: sc,
        uo: ysz,
        vo: ysz + csz,
        ybr: zeros(26 * 32),
        coeff: zeros(400),
        tmp: zeros(16),
        up_pred: zeros(mbw * 4),
        up_nz: zeros(mbw),
        up_nzy: zeros(mbw),
        left_pred: zeros(4),
        left_nz: 0,
        left_nzy: 0,
        seg: 0,
        mbf: zeros(mbw * mbh * 4),
    )
    for mby in 0..mbh
        c.left_pred = zeros(4)
        c.left_nz = 0
        c.left_nzy = 0
        c.ybr = zeros(26 * 32)
        pidx := mby & (nop - 1)
        mut t := parts[pidx]
        for mbx in 0..mbw
            decode_mb(mut fp, mut t, hd, mut c, mbx, mby, mbw)
        parts[pidx] = t
    if fp.eof
        return bad(WebpKind.Truncated, "the first VP8 partition ends before the last macroblock")
    for pt in parts
        if pt.eof
            return bad(WebpKind.Truncated, "a VP8 token partition ends before the last macroblock")
    if hd.filter_on
        loop_filter(mut c, hd.simple, mbw, mbh)
    Planes(width: w, height: h, sy: sy, sc: sc, uo: ysz, vo: ysz + csz, pl: c.pl)

## `v` shifted down by 6 and clamped to 0 to 255 (std.webp.17).
fn clip6(v int) int
    if v < 0
        return 0
    if v > 16383
        return 255
    v >> 6

## One pixel, 0xRRGGBBAA, from luma `y`, chroma `u` and `v` and alpha `a` (std.webp.17).
fn yuv_px(y int, u int, v int, a int) int
    yy := (y * 19077) >> 8
    r := clip6(yy + ((v * 26149) >> 8) - 14234)
    g := clip6(yy - ((u * 6419) >> 8) - ((v * 13320) >> 8) + 8708)
    b := clip6(yy + ((u * 33050) >> 8) - 17685)
    (r << 24) | (g << 16) | (b << 8) | a

## The chroma plane samples for the `w` pixels of two luma rows, in `t_out` for the
## upper and `b_out` for the lower one, from the chroma rows starting at `top` and
## `cur` in `pl`: each is a weighted mean of the nearest chroma samples (std.webp.17).
fn upsample_chroma(pl List[int], top int, cur int, w int, mut t_out List[int], mut b_out List[int])
    last := (w - 1) >> 1
    mut tl := pl[top]
    mut l := pl[cur]
    t_out[0] = (3 * tl + l + 2) >> 2
    b_out[0] = (3 * l + tl + 2) >> 2
    for x in 1..(last + 1)
        t := pl[top + x]
        s := pl[cur + x]
        avg := tl + t + l + s + 8
        d12 := (avg + 2 * (t + l)) >> 3
        d03 := (avg + 2 * (tl + s)) >> 3
        t_out[2 * x - 1] = (d12 + tl) >> 1
        t_out[2 * x] = (d03 + t) >> 1
        b_out[2 * x - 1] = (d03 + l) >> 1
        b_out[2 * x] = (d12 + s) >> 1
        tl = t
        l = s
    if (w & 1) == 0
        t_out[w - 1] = (3 * tl + l + 2) >> 2
        b_out[w - 1] = (3 * l + tl + 2) >> 2

## The pixels (0xRRGGBBAA, rows from the top) of decoded planes and an alpha plane
## (empty for opaque), with the chroma planes upsampled by the triangle filter (std.webp.17).
fn lossy_pixels(p Planes, alpha List[int]) List[int]
    w := p.width
    h := p.height
    mut out := List[int]()
    mut ut := zeros(w)
    mut ub := zeros(w)
    mut vt := zeros(w)
    mut vb := zeros(w)
    for r in 0..h
        mut tk := 0
        mut ck := 0
        mut upper := true
        if r == 0 or (r == h - 1 and (h & 1) == 0)
            tk = r >> 1
            ck = tk
        elif (r & 1) == 1
            ck = (r + 1) >> 1
            tk = ck - 1
        else
            ck = r >> 1
            tk = ck - 1
            upper = false
        upsample_chroma(p.pl, p.uo + tk * p.sc, p.uo + ck * p.sc, w, mut ut, mut ub)
        upsample_chroma(p.pl, p.vo + tk * p.sc, p.vo + ck * p.sc, w, mut vt, mut vb)
        for x in 0..w
            mut a := 255
            if not alpha.is_empty()
                a = alpha[r * w + x]
            if upper
                out.push(yuv_px(p.pl[r * p.sy + x], ut[x], vt[x], a))
            else
                out.push(yuv_px(p.pl[r * p.sy + x], ub[x], vb[x], a))
    out

## The alpha plane of the ALPH chunk at `at` for a `w` x `h` picture (std.webp.18): a
## header byte (reserved 2 bits, pre-processing 2, filter 2, compression 2), then raw
## values or a headerless VP8L stream whose green channel is the alpha, then the
## filter undone (none, horizontal, vertical, gradient predictor).
fn alpha_plane(data bytes, at int, size int, w int, h int) List[int] ! WebpError
    if size < 1
        return bad(WebpKind.Truncated, "the ALPH chunk is empty")
    hb := data[at].to_int()
    method := hb & 3
    filt := (hb >> 2) & 3
    if method > 1 or (hb >> 6) != 0
        return bad(WebpKind.Corrupt, "the ALPH header byte {hb} is not valid")
    mut pl := List[int]()
    if method == 0
        if size - 1 < w * h
            return bad(WebpKind.Truncated, "the ALPH chunk has {size - 1} bytes, not {w * h}")
        for i in 0..(w * h)
            pl.push(data[at + 1 + i].to_int())
    else
        px := lossless_pixels(data[at + 1..at + size], w, h, 0)?
        for p in px
            pl.push((p >> 8) & 255)
    if filt == 0
        return pl
    mut out := List[int]()
    for y in 0..h
        for x in 0..w
            i := y * w + x
            mut pred := 0
            if x == 0 and y == 0
                pred = 0
            elif y == 0
                pred = out[i - 1]
            elif x == 0
                pred = out[i - w]
            elif filt == 1
                pred = out[i - 1]
            elif filt == 2
                pred = out[i - w]
            else
                pred = clamp(out[i - 1] + out[i - w] - out[i - w - 1], 0, 255)
            out.push((pl[i] + pred) & 255)
    out

## Where the picture of a file or of an animation frame is: its chunk, and the
## ALPH chunk before it (std.webp.3, std.webp.18).
struct Pic
    kind str
    at int
    size int
    alph_at int
    alph_size int

## The first VP8 or VP8L chunk in `start` to `limit`, with the first ALPH chunk before it.
fn find_pic(data bytes, start int, limit int) Pic ! WebpError
    mut out := Pic(kind: "", at: 0, size: 0, alph_at: 0, alph_size: 0)
    mut pos := start
    while pos + 8 <= limit
        tag := data[pos..pos + 4].text()
        size := data.u32_le(pos + 4)
        at := pos + 8
        if at + size > limit
            return bad(
                WebpKind.Truncated,
                "the {tag} chunk of {size} bytes runs past the end of the frame",
            )
        if tag == "ALPH"
            if out.alph_size == 0
                out.alph_at = at
                out.alph_size = size
        elif tag == "VP8L" or tag == "VP8 "
            out.kind = tag
            out.at = at
            out.size = size
            break
        pos = at + size + (size & 1)
    if out.kind == ""
        return bad(WebpKind.BadChunk, "the frame has no image chunk")
    out

## A decoded picture: `px` are 0xRRGGBBAA pixels, `alpha` says whether the file
## claims any transparency (the VP8L alpha hint, or an ALPH chunk).
struct Pixels
    width int
    height int
    px List[int]
    alpha bool

## The pixels of the picture `pic` in `data`, lossless or lossy with its alpha.
fn picture(data bytes, pic Pic) Pixels ! WebpError
    if pic.kind == "VP8L"
        payload := data[pic.at..pic.at + pic.size]
        hd := lossless_header(payload, 0, payload.len())?
        if hd.width * hd.height > image.MAX_PIXELS
            return bad(
                WebpKind.Unsupported,
                "{hd.width}x{hd.height} has more than {image.MAX_PIXELS} pixels",
            )
        argb := lossless_pixels(payload, hd.width, hd.height, 40)?
        mut px := List[int]()
        for p in argb
            px.push(((p & 0xffffff) << 8) | (p >> 24))
        return Pixels(width: hd.width, height: hd.height, px: px, alpha: hd.alpha)
    planes := decode_vp8(data[pic.at..pic.at + pic.size])?
    mut al := List[int]()
    if pic.alph_size > 0
        al = alpha_plane(data, pic.alph_at, pic.alph_size, planes.width, planes.height)?
    Pixels(
        width: planes.width,
        height: planes.height,
        px: lossy_pixels(planes, al),
        alpha: pic.alph_size > 0,
    )

fn to_image(w int, h int, px List[int]) image.Image
    mut out := List[u8]()
    for p in px
        out.push_u32_be(p)
    image.Image(width: w, height: h, pixels: bytes.from_list(out))

## One frame of an animation (std.webp.19): the whole canvas as it looks when the
## frame is shown, and how long it stays, in milliseconds.
pub struct Frame
    pub img image.Image
    pub delay_ms int

## A decoded WebP (std.webp.19). `loops` is the repeat count of the ANIM chunk: 0
## repeats forever; a still picture is one frame that plays once (1).
pub struct Animation
    pub width int
    pub height int
    pub loops int
    pub frames List[Frame]

## `src` drawn over `dst`, both 0xRRGGBBAA, not premultiplied (std.webp.20).
fn blend_px(src int, dst int) int
    sa := src & 255
    if sa == 0
        return dst
    dfa := ((dst & 255) * (256 - sa)) >> 8
    ba := sa + dfa
    scale := 16777216 / ba
    r := (((src >> 24) & 255) * sa + ((dst >> 24) & 255) * dfa) * scale
    g := (((src >> 16) & 255) * sa + ((dst >> 16) & 255) * dfa) * scale
    b := (((src >> 8) & 255) * sa + ((dst >> 8) & 255) * dfa) * scale
    ((r >> 24) << 24) | ((g >> 24) << 16) | ((b >> 24) << 8) | ba

## The frames of an animated file, composed on the canvas (std.webp.19 and std.webp.20).
fn compose(data bytes, s Scan, first_only bool) Animation ! WebpError
    if s.canvas_w == 0
        return bad(WebpKind.BadChunk, "the file has an ANMF chunk but no VP8X chunk")
    if s.loops < 0
        return bad(WebpKind.BadChunk, "the file has an ANMF chunk before any ANIM chunk")
    cw := s.canvas_w
    ch := s.canvas_h
    if cw * ch > image.MAX_PIXELS
        return bad(
            WebpKind.Unsupported,
            "the canvas of {cw}x{ch} has more than {image.MAX_PIXELS} pixels",
        )
    limit := data.u32_le(4) + 8
    mut canvas := zeros(cw * ch)
    mut frames := List[Frame]()
    mut prev_x := 0
    mut prev_y := 0
    mut prev_w := 0
    mut prev_h := 0
    mut prev_bg := false
    mut prev_key := false
    mut pos := s.at - 8
    while pos + 8 <= limit
        tag := data[pos..pos + 4].text()
        size := data.u32_le(pos + 4)
        at := pos + 8
        if at + size > limit
            return bad(
                WebpKind.Truncated,
                "the {tag} chunk of {size} bytes runs past the end of the file",
            )
        if tag == "ANMF"
            if size < 16
                return bad(WebpKind.BadChunk, "the ANMF chunk has {size} bytes, not 16 or more")
            fx := u24(data, at) * 2
            fy := u24(data, at + 3) * 2
            fw := u24(data, at + 6) + 1
            fh := u24(data, at + 9) + 1
            dur := u24(data, at + 12)
            fl := data[at + 15].to_int()
            dispose_bg := (fl & 1) != 0
            noblend := (fl & 2) != 0
            if fx + fw > cw or fy + fh > ch
                return bad(
                    WebpKind.BadChunk,
                    "the frame of {fw}x{fh} at {fx},{fy} does not fit the canvas of {cw}x{ch}",
                )
            if (frames.len() + 1) * cw * ch > image.MAX_PIXELS
                return bad(
                    WebpKind.Unsupported,
                    "the frames hold more than {image.MAX_PIXELS} pixels in all",
                )
            pix := picture(data, find_pic(data, at + 16, at + size)?)?
            if pix.width != fw or pix.height != fh
                return bad(
                    WebpKind.Corrupt,
                    "the frame says {fw}x{fh} but its image is {pix.width}x{pix.height}",
                )
            full := fw == cw and fh == ch
            mut key := false
            if frames.is_empty()
                key = true
            elif (not pix.alpha or noblend) and full
                key = true
            else
                key = prev_bg and ((prev_w == cw and prev_h == ch) or prev_key)
            if key
                canvas = zeros(cw * ch)
            elif prev_bg
                for y in prev_y..(prev_y + prev_h)
                    for x in prev_x..(prev_x + prev_w)
                        canvas[y * cw + x] = 0
            for y in 0..fh
                for x in 0..fw
                    src := pix.px[y * fw + x]
                    i := (fy + y) * cw + fx + x
                    mut v := src
                    if not key and not noblend and (src & 255) != 255
                        inside := prev_bg
                            and fx + x >= prev_x
                            and fx + x < prev_x + prev_w
                            and fy + y >= prev_y
                            and fy + y < prev_y + prev_h
                        if not inside
                            v = blend_px(src, canvas[i])
                    canvas[i] = v
            frames.push(Frame(img: to_image(cw, ch, canvas), delay_ms: dur))
            prev_x = fx
            prev_y = fy
            prev_w = fw
            prev_h = fh
            prev_bg = dispose_bg
            prev_key = key
            if first_only
                break
        pos = at + size + (size & 1)
    if frames.is_empty()
        return bad(WebpKind.BadChunk, "the file has no image")
    Animation(width: cw, height: ch, loops: s.loops, frames: frames)

fn check_canvas(s Scan, img image.Image) image.Image ! WebpError
    if s.canvas_w > 0 and (s.canvas_w != img.width or s.canvas_h != img.height)
        return bad(
            WebpKind.Corrupt,
            "the VP8X canvas {s.canvas_w}x{s.canvas_h} differs from the image {img.width}x{img.height}",
        )
    img

## The image in the WebP file `data` as RGBA8 (std.webp.3): a still file, lossless
## or lossy with or without alpha, or the first frame of an animation.
pub fn decode(data bytes) image.Image ! WebpError
    s := scan(data)?
    if s.kind == "ANMF"
        anim := compose(data, s, true)?
        return anim.frames[0].img
    if s.kind == "VP8L"
        return check_canvas(s, decode_lossless(data[s.at..s.at + s.size])?)
    pix := picture(data, Pic(
        kind: s.kind,
        at: s.at,
        size: s.size,
        alph_at: s.alph_at,
        alph_size: s.alph_size,
    ))?
    check_canvas(s, to_image(pix.width, pix.height, pix.px))

## Every frame of the WebP file `data` (std.webp.19); a still file is one frame with delay 0.
pub fn decode_animation(data bytes) Animation ! WebpError
    s := scan(data)?
    if s.kind == "ANMF"
        return compose(data, s, false)
    img := decode(data)?
    Animation(
        width: img.width,
        height: img.height,
        loops: 1,
        frames: [Frame(img: img, delay_ms: 0)],
    )
