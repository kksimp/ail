## std.image.png (spec std.png.1-10, ADR 1250): PNG decode and encode, written
## in AIL from the PNG specification (ISO 15948, W3C Third Edition). `decode`
## reads every color type and bit depth, palettes, `tRNS` transparency and
## Adam7 interlace, and gives an RGBA8 `image.Image`; `encode` writes one.
## Zlib comes from `compress` and CRC-32 from `hash`.
##
##     img := png.decode(fs.read_bytes("a.png")?)?
##     fs.write_bytes("b.png", png.encode(img)?)?
use std.image

## Why a PNG could not be read or written (std.png.10).
pub error struct PngError "png: {self.why}"
    pub kind PngKind
    pub why str

## The class of a failure (std.png.10).
pub enum PngKind
    NotPng
    Truncated
    BadChunk
    BadHeader
    Checksum
    Corrupt
    Unsupported
    BadImage

## The five color types of PNG (std.png.2).
pub enum ColorType
    Gray
    Rgb
    Palette
    GrayAlpha
    Rgba

## What the IHDR chunk says (std.png.2).
pub struct Info
    pub width int
    pub height int
    pub color ColorType
    pub depth int
    pub interlaced bool

struct Header
    width int
    height int
    depth int
    ctype int
    interlaced bool

struct Chunk
    kind str
    at int
    size int
    critical bool

## One Adam7 pass (or the whole image): its first pixel, its steps, its size.
struct Pass
    xs int
    ys int
    dx int
    dy int
    w int
    h int

SIGNATURE := b"\x89PNG\r\n\x1a\n"

fn bad(k PngKind, why str) PngError
    PngError(kind: k, why: why)

## Whether `data` starts with the PNG signature (std.png.1).
pub fn is_png(data bytes) bool
    data.starts_with(SIGNATURE)

## The chunks of `data`, each one's CRC-32 checked, up to IEND (all of them), or
## only the first when `first_only`.
fn read_chunks(data bytes, first_only bool) List[Chunk] ! PngError
    if not is_png(data)
        return bad(PngKind.NotPng, "the data does not start with the PNG signature")
    last := if first_only then "IHDR" else "IEND"
    mut out := List[Chunk]()
    mut pos := 8
    while true
        if pos + 12 > data.len()
            return bad(PngKind.Truncated, "the data ends before the {last} chunk is complete")
        size := data.u32_be(pos)
        if size > 2147483647
            return bad(PngKind.BadChunk, "a chunk claims {size} bytes")
        if pos + 12 + size > data.len()
            return bad(PngKind.Truncated, "the data ends inside a chunk of {size} bytes")
        kind := data[pos + 4..pos + 8].text()
        want := data.u32_be(pos + 8 + size)
        got := hash.crc32(data[pos + 4..pos + 8 + size])
        if want != got
            return bad(PngKind.Checksum, "the {kind} chunk fails its CRC-32")
        critical := (data[pos + 4].to_int() & 32) == 0
        out.push(Chunk(kind: kind, at: pos + 8, size: size, critical: critical))
        if kind == "IEND" or first_only
            return out
        pos += 12 + size
    out

fn channels(ctype int) int
    if ctype == 0 or ctype == 3
        return 1
    if ctype == 4
        return 2
    if ctype == 2
        return 3
    4

fn read_header(data bytes, chunks List[Chunk]) Header ! PngError
    c := chunks[0]
    if c.kind != "IHDR"
        return bad(PngKind.BadChunk, "the first chunk is {c.kind}, not IHDR")
    if c.size != 13
        return bad(PngKind.BadHeader, "the IHDR chunk has {c.size} bytes, not 13")
    w := data.u32_be(c.at)
    h := data.u32_be(c.at + 4)
    depth := data[c.at + 8].to_int()
    ctype := data[c.at + 9].to_int()
    if w < 1 or h < 1 or w > 2147483647 or h > 2147483647
        return bad(PngKind.BadHeader, "the size {w}x{h} is not positive")
    if ctype != 0 and ctype != 2 and ctype != 3 and ctype != 4 and ctype != 6
        return bad(PngKind.BadHeader, "color type {ctype} does not exist")
    ok := if ctype == 0
        depth == 1 or depth == 2 or depth == 4 or depth == 8 or depth == 16
    elif ctype == 3
        depth == 1 or depth == 2 or depth == 4 or depth == 8
    else
        depth == 8 or depth == 16
    if not ok
        return bad(PngKind.BadHeader, "bit depth {depth} is not allowed with color type {ctype}")
    if data[c.at + 10].to_int() != 0
        return bad(PngKind.BadHeader, "compression method {data[c.at + 10].to_int()} is not 0")
    if data[c.at + 11].to_int() != 0
        return bad(PngKind.BadHeader, "filter method {data[c.at + 11].to_int()} is not 0")
    il := data[c.at + 12].to_int()
    if il > 1
        return bad(PngKind.BadHeader, "interlace method {il} is not 0 or 1")
    if w * h > image.MAX_PIXELS
        return bad(PngKind.Unsupported, "{w}x{h} has more than {image.MAX_PIXELS} pixels")
    Header(width: w, height: h, depth: depth, ctype: ctype, interlaced: il == 1)

## The size, color type and bit depth of a PNG, from its first chunk (std.png.2).
pub fn info(data bytes) Info ! PngError
    chunks := read_chunks(data, true)?
    hd := read_header(data, chunks)?
    color := if hd.ctype == 0
        ColorType.Gray
    elif hd.ctype == 2
        ColorType.Rgb
    elif hd.ctype == 3
        ColorType.Palette
    elif hd.ctype == 4
        ColorType.GrayAlpha
    else
        ColorType.Rgba
    Info(
        width: hd.width,
        height: hd.height,
        color: color,
        depth: hd.depth,
        interlaced: hd.interlaced,
    )

fn passes(w int, h int, interlaced bool) List[Pass]
    if not interlaced
        return [Pass(xs: 0, ys: 0, dx: 1, dy: 1, w: w, h: h)]
    xs := [0, 4, 0, 2, 0, 1, 0]
    ys := [0, 0, 4, 0, 2, 0, 1]
    dx := [8, 8, 4, 4, 2, 2, 1]
    dy := [8, 8, 8, 4, 4, 2, 2]
    mut out := List[Pass]()
    for i in 0..7
        pw := (w - xs[i] + dx[i] - 1) / dx[i]
        ph := (h - ys[i] + dy[i] - 1) / dy[i]
        if pw > 0 and ph > 0
            out.push(Pass(xs: xs[i], ys: ys[i], dx: dx[i], dy: dy[i], w: pw, h: ph))
    out

fn paeth(a int, b int, c int) int
    p := a + b - c
    pa := (p - a).abs()
    pb := (p - b).abs()
    pc := (p - c).abs()
    if pa <= pb and pa <= pc
        return a
    if pb <= pc
        return b
    c

## The rows of one pass with their filters undone: `rows` rows of `rb` bytes,
## read from `raw` at `start`, each row led by its filter byte.
fn unfilter(raw bytes, start int, rows int, rb int, bpp int) List[u8] ! PngError
    mut out := List[u8]()
    mut pos := start
    for r in 0..rows
        f := raw[pos].to_int()
        pos += 1
        base := r * rb
        if f == 0
            for i in 0..rb
                out.push(raw[pos + i])
        elif f == 1
            for i in 0..rb
                a := if i >= bpp then out[base + i - bpp].to_int() else 0
                out.push_u8((raw[pos + i].to_int() + a) & 255)
        elif f == 2
            for i in 0..rb
                b := if r > 0 then out[base - rb + i].to_int() else 0
                out.push_u8((raw[pos + i].to_int() + b) & 255)
        elif f == 3
            for i in 0..rb
                a := if i >= bpp then out[base + i - bpp].to_int() else 0
                b := if r > 0 then out[base - rb + i].to_int() else 0
                out.push_u8((raw[pos + i].to_int() + (a + b) / 2) & 255)
        elif f == 4
            for i in 0..rb
                a := if i >= bpp then out[base + i - bpp].to_int() else 0
                b := if r > 0 then out[base - rb + i].to_int() else 0
                c := if r > 0 and i >= bpp then out[base - rb + i - bpp].to_int() else 0
                out.push_u8((raw[pos + i].to_int() + paeth(a, b, c)) & 255)
        else
            return bad(PngKind.Corrupt, "row {r} has the unknown filter type {f}")
        pos += rb
    out

## Sample number `k` of the row starting at `row` in `u`.
fn sample(u List[u8], row int, k int, depth int) int
    if depth == 8
        return u[row + k].to_int()
    if depth == 16
        return u[row + 2 * k].to_int() * 256 + u[row + 2 * k + 1].to_int()
    bit := k * depth
    byte := u[row + bit / 8].to_int()
    (byte >> (8 - depth - bit % 8)) & ((1 << depth) - 1)

## A gray or color sample of `depth` bits as 0 to 255.
fn to8(v int, depth int) int
    if depth == 8
        return v
    if depth == 16
        return v / 256
    v * 255 / ((1 << depth) - 1)

## One unfiltered pass as RGBA8, row by row.
fn to_rgba(u List[u8], ps Pass, rb int, hd Header, plte bytes, trns bytes) List[u8] ! PngError
    d := hd.depth
    ch := channels(hd.ctype)
    mask := (1 << d) - 1
    mut out := List[u8]()
    mut key := -1
    mut kr := -1
    mut kg := -1
    mut kb := -1
    if hd.ctype == 0 and trns.len() == 2
        key = trns.u16_be(0) & mask
    if hd.ctype == 2 and trns.len() == 6
        kr = trns.u16_be(0) & mask
        kg = trns.u16_be(2) & mask
        kb = trns.u16_be(4) & mask
    for y in 0..ps.h
        row := y * rb
        for x in 0..ps.w
            k := x * ch
            if hd.ctype == 0
                g := sample(u, row, k, d)
                v := to8(g, d)
                out.push_u8(v)
                out.push_u8(v)
                out.push_u8(v)
                out.push_u8(if g == key then 0 else 255)
            elif hd.ctype == 2
                r := sample(u, row, k, d)
                g := sample(u, row, k + 1, d)
                b := sample(u, row, k + 2, d)
                out.push_u8(to8(r, d))
                out.push_u8(to8(g, d))
                out.push_u8(to8(b, d))
                out.push_u8(if r == kr and g == kg and b == kb then 0 else 255)
            elif hd.ctype == 3
                i := sample(u, row, k, d)
                if i * 3 + 2 >= plte.len()
                    return bad(
                        PngKind.Corrupt,
                        "palette index {i} is outside the {plte.len() / 3} entries of PLTE",
                    )
                out.push(plte[i * 3])
                out.push(plte[i * 3 + 1])
                out.push(plte[i * 3 + 2])
                out.push_u8(if i < trns.len() then trns[i].to_int() else 255)
            elif hd.ctype == 4
                v := to8(sample(u, row, k, d), d)
                out.push_u8(v)
                out.push_u8(v)
                out.push_u8(v)
                out.push_u8(to8(sample(u, row, k + 1, d), d))
            else
                out.push_u8(to8(sample(u, row, k, d), d))
                out.push_u8(to8(sample(u, row, k + 1, d), d))
                out.push_u8(to8(sample(u, row, k + 2, d), d))
                out.push_u8(to8(sample(u, row, k + 3, d), d))
    out

## Copies the pixels of an Adam7 pass to their places in the whole image.
fn place(mut pix List[u8], ps Pass, part List[u8], w int)
    for y in 0..ps.h
        for x in 0..ps.w
            dst := ((ps.ys + y * ps.dy) * w + ps.xs + x * ps.dx) * 4
            src := (y * ps.w + x) * 4
            for j in 0..4
                pix[dst + j] = part[src + j]

## The image in `data` as RGBA8 (std.png.3 to std.png.8).
pub fn decode(data bytes) image.Image ! PngError
    chunks := read_chunks(data, false)?
    hd := read_header(data, chunks)?
    mut idat := List[u8]()
    mut plte := b""
    mut trns := b""
    for i in 1..chunks.len()
        c := chunks[i]
        if c.kind == "IDAT"
            idat.push_bytes(data[c.at..c.at + c.size])
        elif c.kind == "PLTE"
            if c.size == 0 or c.size % 3 != 0 or c.size > 768
                return bad(
                    PngKind.BadChunk,
                    "the PLTE chunk has {c.size} bytes, not 3 to 768 in threes",
                )
            if hd.ctype == 0 or hd.ctype == 4
                return bad(PngKind.BadChunk, "a gray image has a PLTE chunk")
            plte = data[c.at..c.at + c.size]
        elif c.kind == "tRNS"
            trns = data[c.at..c.at + c.size]
        elif c.kind == "IHDR"
            return bad(PngKind.BadChunk, "there is a second IHDR chunk")
        elif c.critical and c.kind != "IEND"
            return bad(PngKind.Unsupported, "the critical chunk {c.kind} is not known")
    if idat.is_empty()
        return bad(PngKind.BadChunk, "there is no IDAT chunk")
    if hd.ctype == 3 and plte.len() == 0
        return bad(PngKind.BadChunk, "a palette image has no PLTE chunk")
    if hd.ctype == 0 and trns.len() != 0 and trns.len() != 2
        return bad(PngKind.BadChunk, "the tRNS chunk of a gray image has {trns.len()} bytes, not 2")
    if hd.ctype == 2 and trns.len() != 0 and trns.len() != 6
        return bad(PngKind.BadChunk, "the tRNS chunk of an RGB image has {trns.len()} bytes, not 6")
    if hd.ctype == 3 and trns.len() > plte.len() / 3
        return bad(PngKind.BadChunk, "the tRNS chunk has more entries than PLTE")
    raw := compress.unzlib(bytes.from_list(idat)) else err
        return bad(PngKind.Corrupt, "the image data is not valid zlib: {err.message}")
    bits := channels(hd.ctype) * hd.depth
    bpp := (bits / 8).max(1)
    ps := passes(hd.width, hd.height, hd.interlaced)
    mut need := 0
    for p in ps
        need += p.h * (1 + (p.w * bits + 7) / 8)
    if raw.len() < need
        return bad(
            PngKind.Truncated,
            "the image data has {raw.len()} bytes, the header needs {need}",
        )
    mut pix := List[u8]()
    if hd.interlaced
        for _ in 0..(hd.width * hd.height * 4)
            pix.push_u8(0)
    mut start := 0
    for p in ps
        rb := (p.w * bits + 7) / 8
        u := unfilter(raw, start, p.h, rb, bpp)?
        start += p.h * (rb + 1)
        part := to_rgba(u, p, rb, hd, plte, trns)?
        if hd.interlaced
            place(mut pix, p, part, hd.width)
        else
            pix = part
    image.Image(width: hd.width, height: hd.height, pixels: bytes.from_list(pix))

fn put_chunk(mut out List[u8], kind str, body bytes)
    tag := kind.to_bytes()
    out.push_u32_be(body.len())
    out.push_bytes(tag)
    out.push_bytes(body)
    out.push_u32_be(hash.crc32(tag + body))

## Row `r` of `scan` (rows of `rb` bytes) under filter `f`.
fn filtered(scan bytes, r int, rb int, bpp int, f int) List[u8]
    base := r * rb
    mut out := List[u8]()
    for i in 0..rb
        x := scan[base + i].to_int()
        a := if i >= bpp then scan[base + i - bpp].to_int() else 0
        b := if r > 0 then scan[base - rb + i].to_int() else 0
        c := if r > 0 and i >= bpp then scan[base - rb + i - bpp].to_int() else 0
        p := if f
            == 0 then 0 elif f
            == 1 then a elif f
            == 2 then b elif f
            == 3 then (a + b) / 2 else paeth(a, b, c)
        out.push_u8((x - p + 256) & 255)
    out

## The sum of the bytes read as signed numbers: the usual guide to a good filter.
fn score(row List[u8]) int
    mut s := 0
    for v in row
        n := v.to_int()
        s += if n < 128 then n else 256 - n
    s

## `img` as a PNG file (std.png.9). The file is 8-bit RGB when every pixel is
## opaque and 8-bit RGBA otherwise; each row takes the filter that scores best.
pub fn encode(img image.Image) bytes ! PngError
    w := img.width
    h := img.height
    if w < 1 or h < 1 or w > image.MAX_PIXELS or h > image.MAX_PIXELS or w * h > image.MAX_PIXELS
        return bad(PngKind.BadImage, "{w}x{h} is not a size from 1 pixel to {image.MAX_PIXELS}")
    if img.pixels.len() != w * h * 4
        return bad(
            PngKind.BadImage,
            "{w}x{h} needs {w * h * 4} pixel bytes, not {img.pixels.len()}",
        )
    mut opaque := true
    for i in 0..(w * h)
        if img.pixels[i * 4 + 3].to_int() != 255
            opaque = false
            break
    mut scan := img.pixels
    mut bpp := 4
    if opaque
        bpp = 3
        mut rgb := List[u8]()
        for i in 0..(w * h)
            rgb.push(img.pixels[i * 4])
            rgb.push(img.pixels[i * 4 + 1])
            rgb.push(img.pixels[i * 4 + 2])
        scan = bytes.from_list(rgb)
    rb := w * bpp
    mut raw := List[u8]()
    for r in 0..h
        mut best := filtered(scan, r, rb, bpp, 0)
        mut best_f := 0
        mut best_s := score(best)
        for f in 1..5
            cand := filtered(scan, r, rb, bpp, f)
            s := score(cand)
            if s < best_s
                best = cand
                best_f = f
                best_s = s
        raw.push_u8(best_f)
        raw.extend(best)
    mut head := List[u8]()
    head.push_u32_be(w)
    head.push_u32_be(h)
    head.push_u8(8)
    head.push_u8(if opaque then 2 else 6)
    head.push_u8(0)
    head.push_u8(0)
    head.push_u8(0)
    mut out := List[u8]()
    out.push_bytes(SIGNATURE)
    put_chunk(mut out, "IHDR", bytes.from_list(head))
    z := compress.zlib(bytes.from_list(raw))
    mut at := 0
    while at < z.len()
        stop := (at + 1048576).min(z.len())
        put_chunk(mut out, "IDAT", z[at..stop])
        at = stop
    put_chunk(mut out, "IEND", b"")
    bytes.from_list(out)
