## std.toml (spec std.toml.1-8, ADR 0901): TOML 1.0 text read into the `Json`
## value, so one set of accessors (`get`, `at`, `as_str`, ...) serves both
## formats. Tables are `Obj`, arrays are `Arr`, strings are `Str`, booleans
## are `Bool`. Integers and floats are `Num`, and dates and times stay `Str`
## in their TOML spelling (std.toml.3). `write` is the inverse (std.toml.9-12).

## Why the text is not TOML (std.toml.8). `line` is 1-based.
pub error struct TomlError "{self.why} (line {self.line})"
    pub why str
    pub line int

struct TomlParser
    chars List[char]
    pos int
    ## How each table path already read was defined (std.toml.13): 1 by a
    ## `[header]`, 2 by a dotted key, 3 an inline table or a fixed array, 4 an
    ## array of tables, 5 created on the way to a header.
    kinds Map[str, int]

## The TOML document `text` as a `Json` object (std.toml.1).
pub fn parse(text str) Json ! TomlError
    mut p := TomlParser(chars: text.chars(), pos: 0, kinds: Map[str, int]())
    p.document()?

fn TomlParser.fail(self, why str) TomlError
    mut line := 1
    mut i := 0
    while i < self.pos and i < self.chars.len()
        if self.chars[i] == '\n'
            line += 1
        i += 1
    TomlError(why: why, line: line)

fn TomlParser.at_end(self) bool
    self.pos >= self.chars.len()

fn TomlParser.peek(self) char?
    if self.at_end()
        return none
    self.chars[self.pos]

fn TomlParser.peek_at(self, k int) char?
    if self.pos + k >= self.chars.len()
        return none
    self.chars[self.pos + k]

## A control character other than a tab (std.toml.13).
fn is_control(c char) bool
    (c.code() < 32 and c != '\t') or c.code() == 127

fn is_bare(c char) bool
    c.is_digit() or c == '_' or c == '-' or ('a' <= c and c <= 'z') or ('A' <= c and c <= 'Z')

## Spaces and tabs only.
fn TomlParser.skip_blank(mut self)
    while not self.at_end() and (self.chars[self.pos] == ' ' or self.chars[self.pos] == '\t')
        self.pos += 1

## A comment, up to but not including its line break (std.toml.13).
fn TomlParser.comment(mut self) !
    self.pos += 1
    while not self.at_end()
        c := self.chars[self.pos]
        if c == '\n' or (c == '\r' and self.peek_at(1) == '\n')
            break
        if is_control(c)
            return self.fail("control character in a comment")
        self.pos += 1

## Blanks, line breaks and comments (between statements and inside arrays).
fn TomlParser.skip_all(mut self) !
    while not self.at_end()
        c := self.chars[self.pos]
        if c == ' ' or c == '\t' or c == '\n'
            self.pos += 1
        elif c == '\r' and self.peek_at(1) == '\n'
            self.pos += 2
        elif c == '#'
            self.comment()?
        else
            break

## After a statement: blanks, an optional comment, then a line break or the end.
fn TomlParser.end_of_line(mut self) !
    self.skip_blank()
    if self.peek() == '#'
        self.comment()?
    if self.at_end()
        return
    if self.chars[self.pos] == '\r' and self.peek_at(1) == '\n'
        self.pos += 1
    if self.chars[self.pos] != '\n'
        return self.fail("expected end of line")
    self.pos += 1

fn TomlParser.document(mut self) !Json
    mut root := Json.Obj([])
    mut cur := List[str]()
    while true
        self.skip_all()?
        if self.at_end()
            break
        if self.chars[self.pos] == '['
            double := self.peek_at(1) == '['
            self.pos += 1
            if double
                self.pos += 1
            self.skip_blank()
            cur = self.key_path()?
            self.skip_blank()
            if self.peek() != ']'
                return self.fail("expected ']'")
            self.pos += 1
            if double
                if self.peek() != ']'
                    return self.fail("expected ']]'")
                self.pos += 1
            mode := if double then 2 else 1
            root = self.put(root, cur, 0, "", cur.len(), Json.Null, mode)?
            self.end_of_line()?
        else
            key := self.key_path()?
            self.skip_blank()
            if self.peek() != '='
                return self.fail("expected '=' after key")
            self.pos += 1
            v := self.value()?
            root = self.put(root, self.joined(cur, key), 0, "", cur.len(), v, 0)?
            self.end_of_line()?
    root

fn TomlParser.joined(self, a List[str], b List[str]) List[str]
    mut out := List[str]()
    for s in a
        out.push(s)
    for s in b
        out.push(s)
    out

## Sets (mode 0), creates a table (mode 1) or appends a table to an array of
## tables (mode 2) at `path[at..]` below `node`, whose own path is `prefix`.
## `base` is where the key of a `key = value` line starts in `path`; the part
## before it is the current table header. A path through an array of tables
## goes into the array's last table (std.toml.5). A table is defined once
## (std.toml.13).
fn TomlParser.put(
    mut self,
    node Json,
    path List[str],
    at int,
    prefix str,
    base int,
    val Json,
    mode int,
) !Json
    match node
        Json.Arr(items) =>
            if items.len() == 0
                return self.fail("key path runs through an empty array")
            if (self.kinds.get(prefix) else 0) != 4
                return self.fail("key path runs through an array that is not an array of tables")
            last := items.len() - 1
            mut copy := items
            sub := self.put(copy[last], path, at, "{prefix}#{last};", base, val, mode)?
            copy[last] = sub
            Json.Arr(copy)
        Json.Obj(members) =>
            key := path[at]
            child := "{prefix}{key.len()}:{key}"
            kind := self.kinds.get(child) else 0
            mut idx := -1
            for i in 0..members.len()
                if members[i].key == key
                    idx = i
            mut ms := members
            if kind == 3
                return self.fail("'{key}' is an inline table or a fixed array and cannot be extended")
            if at < path.len() - 1
                if idx >= 0
                    if mode == 0 and at >= base and kind != 2
                        return self.fail("'{key}' is already defined as a table")
                    sub := self.put(ms[idx].value, path, at + 1, child, base, val, mode)?
                    ms[idx] = JsonMember(key, sub)
                else
                    self.kinds[child] = if mode == 0 and at >= base then 2 else 5
                    sub := self.put(Json.Obj([]), path, at + 1, child, base, val, mode)?
                    ms.push(JsonMember(key, sub))
            elif mode == 0
                if idx >= 0
                    return self.fail("duplicate key '{key}'")
                ms.push(JsonMember(key, val))
                sealed := match val
                    Json.Obj(_) | Json.Arr(_) => true
                    Json.Null | Json.Bool(_) | Json.Num(_) | Json.Str(_) => false
                if sealed
                    self.kinds[child] = 3
            elif mode == 1
                if idx >= 0
                    if kind != 5
                        return self.fail("table '{key}' is already defined")
                else
                    ms.push(JsonMember(key, Json.Obj([])))
                self.kinds[child] = 1
            elif idx < 0
                ms.push(JsonMember(key, Json.Arr([Json.Obj([])])))
                self.kinds[child] = 4
            else
                if kind != 4
                    return self.fail("'{key}' is already defined and is not an array of tables")
                arr := ms[idx].value.as_arr() else return self.fail("'{key}' is already defined and is not an array of tables")
                mut a := arr
                a.push(Json.Obj([]))
                ms[idx] = JsonMember(key, Json.Arr(a))
            Json.Obj(ms)
        Json.Null | Json.Bool(_) | Json.Num(_) | Json.Str(_) => return self.fail("key path runs through a value that is not a table")

## A key: bare, "quoted" or 'literal', with dots between parts (std.toml.4).
fn TomlParser.key_path(mut self) !List[str]
    mut parts := List[str]()
    while true
        self.skip_blank()
        c := self.peek() else return self.fail("expected a key")
        if c == '"'
            parts.push(self.basic_string()?)
        elif c == '\''
            parts.push(self.literal_string()?)
        else
            start := self.pos
            while not self.at_end() and is_bare(self.chars[self.pos])
                self.pos += 1
            if self.pos == start
                return self.fail("expected a key")
            parts.push(self.chars[start..self.pos].join(""))
        self.skip_blank()
        if self.peek() == '.'
            self.pos += 1
        else
            break
    parts

fn TomlParser.value(mut self) !Json
    self.skip_blank()
    c := self.peek() else return self.fail("expected a value")
    match c
        '"' =>
            if self.peek_at(1) == '"' and self.peek_at(2) == '"'
                return Json.Str(self.multi_basic()?)
            Json.Str(self.basic_string()?)
        '\'' =>
            if self.peek_at(1) == '\'' and self.peek_at(2) == '\''
                return Json.Str(self.multi_literal()?)
            Json.Str(self.literal_string()?)
        '[' => self.array()
        '{' => self.inline_table()
        _ => self.scalar()

fn TomlParser.array(mut self) !Json
    self.pos += 1
    mut items := List[Json]()
    while true
        self.skip_all()?
        if self.peek() == ']'
            self.pos += 1
            break
        items.push(self.value()?)
        self.skip_all()?
        if self.peek() == ','
            self.pos += 1
        elif self.peek() == ']'
            self.pos += 1
            break
        else
            return self.fail("expected ',' or ']' in array")
    Json.Arr(items)

## An inline table keeps its own record of defined keys: it is sealed once read.
fn TomlParser.inline_table(mut self) !Json
    self.pos += 1
    mut t := Json.Obj([])
    self.skip_blank()
    if self.peek() == '}'
        self.pos += 1
        return t
    saved := self.kinds
    self.kinds = Map[str, int]()
    while true
        key := self.key_path()?
        self.skip_blank()
        if self.peek() != '='
            return self.fail("expected '=' after key")
        self.pos += 1
        v := self.value()?
        t = self.put(t, key, 0, "", 0, v, 0)?
        self.skip_blank()
        if self.peek() == ','
            self.pos += 1
            self.skip_blank()
            if self.peek() == '}'
                return self.fail("trailing comma in an inline table")
        elif self.peek() == '}'
            self.pos += 1
            break
        else
            return self.fail("expected ',' or '}' in inline table")
    self.kinds = saved
    t

## A bare word: boolean, number or date-time.
fn TomlParser.scalar(mut self) !Json
    mut word := self.token()
    if word == ""
        return self.fail("expected a value")
    # A date and a time may be separated by one space.
    if word.len() == 10 and word.char_at(4) == '-' and self.peek() == ' ' and self.digit_at(1)
        self.pos += 1
        word = "{word} {self.token()}"
    if word == "true"
        return Json.Bool(true)
    if word == "false"
        return Json.Bool(false)
    w := word.chars()
    if (w.len() >= 3 and w[2] == ':' and num_at(w, 0, 2) >= 0)
        or (w.len() >= 5 and w[4] == '-' and num_at(w, 0, 4) >= 0)
        if not valid_datetime(w)
            return self.fail("invalid date or time '{word}'")
        return Json.Str(word)
    body := if w[0] == '+' or w[0] == '-' then word.slice(1, word.len()) else word
    if body == "inf"
        return Json.Num(if w[0] == '-' then -1.0 / 0.0 else 1.0 / 0.0)
    if body == "nan"
        return Json.Num(0.0 / 0.0)
    shape := number_kind(w)
    if shape == 0
        return self.fail("invalid value '{word}'")
    clean := word.replace("_", "")
    if shape == 2
        unsigned := if clean.starts_with("+") then clean.slice(1, clean.len()) else clean
        f := unsigned.to_float() else return self.fail("invalid number '{word}'")
        return Json.Num(f)
    if clean.starts_with("0x") or clean.starts_with("0o") or clean.starts_with("0b")
        mut base := 2
        if clean.starts_with("0x")
            base = 16
        elif clean.starts_with("0o")
            base = 8
        mut n := 0
        for d in clean.slice(2, clean.len()).chars()
            digit := d.to_digit(base) else return self.fail("invalid number '{word}'")
            if n > (9223372036854775807 - digit) / base
                return self.fail("integer '{word}' is out of range")
            n = n * base + digit
        return Json.Num(n.to_float())
    plain := if clean.starts_with("+") then clean.slice(1, clean.len()) else clean
    n := plain.to_int() else return self.fail("integer '{word}' is out of range")
    Json.Num(n.to_float())

## The index after the digits of `base` that start at `i`, with a single `_`
## allowed between two digits; -1 when there is no digit at `i`.
fn digits_end(w List[char], i int, base int) int
    if i >= w.len() or (w[i].to_digit(base) else -1) < 0
        return -1
    mut j := i
    while j < w.len()
        if (w[j].to_digit(base) else -1) >= 0
            j += 1
        elif w[j] == '_' and j + 1 < w.len() and (w[j + 1].to_digit(base) else -1) >= 0
            j += 1
        else
            break
    j

## 0 when `w` is not a number, 1 for an integer and 2 for a float
## (std.toml.13): no leading zeros, `_` only between digits, a fraction and an
## exponent have digits.
fn number_kind(w List[char]) int
    n := w.len()
    if n >= 2 and w[0] == '0' and (w[1] == 'x' or w[1] == 'o' or w[1] == 'b')
        base := if w[1] == 'x' then 16 elif w[1] == 'o' then 8 else 2
        return if digits_end(w, 2, base) == n then 1 else 0
    mut i := 0
    if w[0] == '+' or w[0] == '-'
        i = 1
    if i >= n
        return 0
    mut j := i + 1
    if w[i] != '0'
        j = digits_end(w, i, 10)
        if j < 0
            return 0
    if j == n
        return 1
    mut shape := 1
    if w[j] == '.'
        j = digits_end(w, j + 1, 10)
        if j < 0
            return 0
        shape = 2
    if j < n and (w[j] == 'e' or w[j] == 'E')
        j += 1
        if j < n and (w[j] == '+' or w[j] == '-')
            j += 1
        j = digits_end(w, j, 10)
        if j < 0
            return 0
        shape = 2
    if j != n
        return 0
    shape

## The number made of `k` ASCII digits at `i`, or -1.
fn num_at(w List[char], i int, k int) int
    if i + k > w.len()
        return -1
    mut v := 0
    for c in w[i..i + k]
        d := c.to_digit(10) else return -1
        v = v * 10 + d
    v

fn days_in(y int, m int) int
    if m == 2
        leap := y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
        return if leap then 29 else 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

fn valid_date(w List[char]) bool
    if w.len() != 10 or w[4] != '-' or w[7] != '-'
        return false
    y := num_at(w, 0, 4)
    m := num_at(w, 5, 2)
    d := num_at(w, 8, 2)
    y >= 0 and m >= 1 and m <= 12 and d >= 1 and d <= days_in(y, m)

## HH:MM:SS with an optional fraction.
fn valid_time(w List[char]) bool
    if w.len() < 8 or w[2] != ':' or w[5] != ':'
        return false
    h := num_at(w, 0, 2)
    mi := num_at(w, 3, 2)
    sec := num_at(w, 6, 2)
    if h < 0 or h > 23 or mi < 0 or mi > 59 or sec < 0 or sec > 60
        return false
    if w.len() == 8
        return true
    if w[8] != '.' or w.len() == 9
        return false
    for c in w[9..w.len()]
        if not c.is_digit()
            return false
    true

fn valid_offset(w List[char]) bool
    if w.len() == 1
        return w[0] == 'Z' or w[0] == 'z'
    if w.len() != 6 or (w[0] != '+' and w[0] != '-') or w[3] != ':'
        return false
    h := num_at(w, 1, 2)
    mi := num_at(w, 4, 2)
    h >= 0 and h <= 23 and mi >= 0 and mi <= 59

## A date, a time, or a date and time with an optional offset (std.toml.13).
fn valid_datetime(w List[char]) bool
    if w.len() == 10
        return valid_date(w)
    if w.len() >= 3 and w[2] == ':'
        return valid_time(w)
    if w.len() < 19 or not valid_date(w[0..10]) or not "Tt ".contains(w[10])
        return false
    rest := w[11..w.len()]
    mut cut := -1
    for i in 0..rest.len()
        if cut < 0 and "Zz+-".contains(rest[i])
            cut = i
    if cut < 0
        return valid_time(rest)
    valid_time(rest[0..cut]) and valid_offset(rest[cut..rest.len()])

fn TomlParser.digit_at(self, k int) bool
    c := self.peek_at(k) else return false
    c.is_digit()

fn TomlParser.token(mut self) str
    start := self.pos
    while not self.at_end() and not " \t\n\r,]}#".contains(self.chars[self.pos])
        self.pos += 1
    self.chars[start..self.pos].join("")

fn TomlParser.basic_string(mut self) !str
    self.pos += 1
    mut out := List[char]()
    while true
        c := self.peek() else return self.fail("unterminated string")
        if c == '\n'
            return self.fail("unterminated string")
        if is_control(c)
            return self.fail("control character in a string")
        self.pos += 1
        if c == '"'
            break
        if c == '\\'
            out.push(self.escape()?)
        else
            out.push(c)
    out.join("")

fn TomlParser.literal_string(mut self) !str
    self.pos += 1
    start := self.pos
    while true
        c := self.peek() else return self.fail("unterminated string")
        if c == '\n'
            return self.fail("unterminated string")
        if is_control(c)
            return self.fail("control character in a string")
        if c == '\''
            break
        self.pos += 1
    text := self.chars[start..self.pos].join("")
    self.pos += 1
    text

## How many `q` characters start at `pos`.
fn TomlParser.quotes(self, q char) int
    mut n := 0
    while self.peek_at(n) == q
        n += 1
    n

fn TomlParser.multi_literal(mut self) !str
    self.pos += 3
    if self.peek() == '\r' and self.peek_at(1) == '\n'
        self.pos += 1
    if self.peek() == '\n'
        self.pos += 1
    mut out := List[char]()
    while true
        c := self.peek() else return self.fail("unterminated string")
        if c == '\'' and self.peek_at(1) == '\'' and self.peek_at(2) == '\''
            # Up to two quotes before the closing three belong to the string.
            n := self.quotes('\'')
            if n > 5
                return self.fail("too many quotes in a multi-line string")
            mut extra := n - 3
            while extra > 0
                out.push('\'')
                extra -= 1
            self.pos += n
            break
        if c == '\r' and self.peek_at(1) == '\n'
            self.pos += 1
        else
            if is_control(c) and c != '\n'
                return self.fail("control character in a string")
            out.push(c)
            self.pos += 1
    out.join("")

fn TomlParser.multi_basic(mut self) !str
    self.pos += 3
    if self.peek() == '\r' and self.peek_at(1) == '\n'
        self.pos += 1
    if self.peek() == '\n'
        self.pos += 1
    mut out := List[char]()
    while true
        c := self.peek() else return self.fail("unterminated string")
        if c == '"' and self.peek_at(1) == '"' and self.peek_at(2) == '"'
            n := self.quotes('"')
            if n > 5
                return self.fail("too many quotes in a multi-line string")
            mut extra := n - 3
            while extra > 0
                out.push('"')
                extra -= 1
            self.pos += n
            break
        if c == '\r' and self.peek_at(1) == '\n'
            self.pos += 1
            continue
        self.pos += 1
        if c == '\\'
            nxt := self.peek() else return self.fail("unterminated string")
            if nxt == '\n' or nxt == ' ' or nxt == '\t' or nxt == '\r'
                # A line-ending backslash drops the break and the blanks after it.
                self.skip_blank()
                if self.peek() == '\r' and self.peek_at(1) == '\n'
                    self.pos += 1
                if self.peek() != '\n'
                    return self.fail("a backslash before a space must end the line")
                while not self.at_end()
                    d := self.chars[self.pos]
                    if d == ' ' or d == '\t' or d == '\n'
                        self.pos += 1
                    elif d == '\r' and self.peek_at(1) == '\n'
                        self.pos += 2
                    else
                        break
            else
                out.push(self.escape()?)
        else
            if is_control(c) and c != '\n'
                return self.fail("control character in a string")
            out.push(c)
    out.join("")

## The escape after a backslash that `pos` has already passed (std.toml.2).
fn TomlParser.escape(mut self) !char
    c := self.peek() else return self.fail("unterminated string")
    self.pos += 1
    match c
        'b' => '\u{8}'
        't' => '\t'
        'n' => '\n'
        'f' => '\u{c}'
        'r' => '\r'
        '"' => '"'
        '\\' => '\\'
        'u' => self.hex_char(4)?
        'U' => self.hex_char(8)?
        _ => return self.fail("invalid escape '\\{c}'")

fn TomlParser.hex_char(mut self, n int) !char
    end := self.pos + n
    if end > self.chars.len()
        return self.fail("invalid unicode escape")
    mut code := 0
    for d in self.chars[self.pos..end]
        code = code * 16 + (d.to_digit(16) else return self.fail("invalid unicode escape"))
    self.pos = end
    ch := char.from_code(code) else return self.fail("invalid unicode escape")
    ch

## Why a value has no TOML text (std.toml.12). `path` names it: `a.b` for a
## key, `a[1]` for an array element, `(root)` for the document.
pub error struct TomlWriteError "{self.why} (at {self.path})"
    pub why str
    pub path str

## The TOML text of the object `j` (std.toml.9): the values of a table first,
## then its sub-tables as `[a.b]`, and arrays of objects as `[[a]]`.
pub fn write(j Json) str ! TomlWriteError
    members := j.as_obj() else return TomlWriteError(
        why: "the root of a TOML document must be a table",
        path: "(root)",
    )
    lines := table_lines(members, List[str]())?
    if lines.len() == 0
        return ""
    # Every header is preceded by a blank line; none is wanted at the top.
    first := if lines[0] == "" then 1 else 0
    body := lines[first..lines.len()].join("\n")
    "{body}\n"

## The lines of the table `members` that sits at `trail`.
fn table_lines(members List[JsonMember], trail List[str]) List[str] ! TomlWriteError
    mut out := List[str]()
    for m in members
        if is_table(m.value) or is_table_array(m.value)
            continue
        named := path_text(trail, m.key)
        out.push("{key_text(m.key)} = {value_text(m.value, named)?}")
    for m in members
        here := path_with(trail, m.key)
        if is_table(m.value)
            sub := m.value.as_obj() else List[JsonMember]()
            out.push("")
            out.push("[{header_text(here)}]")
            for l in table_lines(sub, here)?
                out.push(l)
        elif is_table_array(m.value)
            items := m.value.as_arr() else List[Json]()
            for item in items
                sub := item.as_obj() else List[JsonMember]()
                out.push("")
                out.push("[[{header_text(here)}]]")
                for l in table_lines(sub, here)?
                    out.push(l)
    out

fn is_table(v Json) bool
    match v
        Json.Obj(_) => true
        Json.Null | Json.Bool(_) | Json.Num(_) | Json.Str(_) | Json.Arr(_) => false

## A non-empty array whose items are all objects (std.toml.10).
fn is_table_array(v Json) bool
    items := v.as_arr() else return false
    if items.len() == 0
        return false
    for item in items
        if not is_table(item)
            return false
    true

fn path_with(trail List[str], key str) List[str]
    mut out := List[str]()
    for p in trail
        out.push(p)
    out.push(key)
    out

fn path_text(trail List[str], key str) str
    path_with(trail, key).join(".")

fn header_text(trail List[str]) str
    mut parts := List[str]()
    for p in trail
        parts.push(key_text(p))
    parts.join(".")

## A value on one line: arrays in `[...]`, objects as inline tables.
fn value_text(v Json, spot str) !str
    match v
        Json.Null => return TomlWriteError(
            why: "null has no TOML value: leave the key out",
            path: spot,
        )
        Json.Bool(b) => if b then "true" else "false"
        Json.Num(f) => num_text(f)
        Json.Str(s) => quoted(s)
        Json.Arr(items) => array_text(items, spot)?
        Json.Obj(members) => inline_table_text(members, spot)?

fn array_text(items List[Json], spot str) !str
    mut parts := List[str]()
    mut i := 0
    for item in items
        parts.push(value_text(item, "{spot}[{i}]")?)
        i += 1
    body := parts.join(", ")
    "[{body}]"

fn inline_table_text(members List[JsonMember], spot str) !str
    if members.len() == 0
        return "\{}"
    mut parts := List[str]()
    for m in members
        v := value_text(m.value, "{spot}.{m.key}")?
        parts.push("{key_text(m.key)} = {v}")
    body := parts.join(", ")
    "\{ {body} }"

## A whole number below 1e15 is an integer, anything else a float (std.toml.11).
fn num_text(f float) str
    if f != f
        return "nan"
    zero := 0.0
    if f == 1.0 / zero
        return "inf"
    if f == -1.0 / zero
        return "-inf"
    t := Json.Num(f).to_text()
    if t.contains('.') or t.contains('e') or t.contains('E') or t.len() < 16
        return t
    "{t}.0"

fn is_bare_key(k str) bool
    if k == ""
        return false
    for c in k.chars()
        ok := ('a' <= c and c <= 'z')
            or ('A' <= c and c <= 'Z')
            or c.is_digit()
            or c == '_'
            or c == '-'
        if not ok
            return false
    true

fn key_text(k str) str
    if is_bare_key(k)
        return k
    quoted(k)

## A basic string: `"` and `\` and the control characters escaped (std.toml.2).
fn quoted(s str) str
    mut buf := List[str]()
    for c in s.chars()
        code := c.code()
        if c == '"'
            buf.push("\\\"")
        elif c == '\\'
            buf.push("\\\\")
        elif c == '\n'
            buf.push("\\n")
        elif c == '\t'
            buf.push("\\t")
        elif c == '\r'
            buf.push("\\r")
        elif code == 8
            buf.push("\\b")
        elif code == 12
            buf.push("\\f")
        elif code < 32 or code == 127
            hex := code.to_hex().pad_left(4, '0')
            buf.push("\\u")
            buf.push(hex)
        else
            buf.push(c.to_str())
    dq := "\""
    body := buf.join("")
    "{dq}{body}{dq}"
