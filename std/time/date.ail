## std.time.date (spec std.date.1-27, ADRs 0447-0451, 1221, TBD): calendar dates, dates
## with a time and a zone, durations as milliseconds, ISO 8601 and
## `format` patterns. All arithmetic is pure; only `now`, `now_local` and
## named zones touch the platform (clock, and the tz database through
## `std.tz`).
##
## A zone is a `str`: `"UTC"` (or `"Z"`), a fixed offset such as `"+05:30"`,
## or an IANA name such as `"America/New_York"`.
use std.time
use std.tz

## Milliseconds in a second, minute, hour and day: a duration is an `int` of
## milliseconds, so `dt.add_ms(3 * date.HOUR)`.
pub SEC := 1000
pub MIN := 60000
pub HOUR := 3600000
pub DAY := 86400000

MONTHS := [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
]

WEEKDAYS := ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

## Why a date, time or zone was refused (std.date.15).
pub error struct DateError "{self.why}: `{self.text}`"
    pub text str
    pub why str

## A calendar day in the proleptic Gregorian calendar. Compare with `<` and
## `==`: year, then month, then day.
pub struct Date
    pub year int
    pub month int
    pub day int

impl Ord for Date

impl ToStr for Date
    fn to_str(self) str
        self.iso()

## An instant with its zone and the calendar fields there (std.date.8).
## `==` compares the fields, so the same instant in two zones differs; compare
## instants with `a.unix_ms() == b.unix_ms()` or `a.before(b)`.
pub struct DateTime
    pub date Date
    pub hour int
    pub minute int
    pub second int
    pub ms int
    ## Seconds east of UTC at this instant.
    pub offset int
    pub zone str

fn lo(a int, b int) int
    if a < b
        return a
    b

fn fdiv(a int, b int) int
    q := a / b
    if a % b != 0 and (a < 0) != (b < 0)
        return q - 1
    q

fn fmod(a int, b int) int
    a - fdiv(a, b) * b

## Whether `year` is a leap year (std.date.1).
pub fn is_leap(year int) bool
    year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

## The number of days in a month, 1-12 (std.date.1).
pub fn days_in_month(year int, month int) int
    if month == 2
        if is_leap(year)
            return 29
        return 28
    if month == 4 or month == 6 or month == 9 or month == 11
        return 30
    31

fn days_from_civil(year int, month int, day int) int
    y := if month <= 2 then year - 1 else year
    era := fdiv(y, 400)
    yoe := y - era * 400
    mp := if month > 2 then month - 3 else month + 9
    doy := (153 * mp + 2) / 5 + day - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

## The date `days` days after 1970-01-01 (before it when negative) (std.date.2).
pub fn Date.from_days(days int) Date
    z := days + 719468
    era := fdiv(z, 146097)
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10 then mp + 3 else mp - 9
    bump := if m <= 2 then 1 else 0
    y := yoe + era * 400 + bump
    Date(year: y, month: m, day: d)

## The date, or `none` when `month` or `day` doesn't exist (std.date.1).
pub fn Date.new(year int, month int, day int) Date?
    if month < 1 or month > 12 or day < 1 or day > days_in_month(year, month)
        return none
    Date(year: year, month: month, day: day)

## Days since 1970-01-01 (std.date.2).
pub fn Date.days(self) int
    days_from_civil(self.year, self.month, self.day)

## 1 for Monday to 7 for Sunday (std.date.3).
pub fn Date.weekday(self) int
    fmod(self.days() + 3, 7) + 1

## 1 for January 1 (std.date.3).
pub fn Date.yday(self) int
    self.days() - days_from_civil(self.year, 1, 1) + 1

## This date plus `n` days, `n` may be negative (std.date.4).
pub fn Date.add_days(self, n int) Date
    Date.from_days(self.days() + n)

## This date plus `n` months. A day the target month lacks becomes its last
## day: January 31 plus one month is February 28 or 29 (std.date.5).
pub fn Date.add_months(self, n int) Date
    index := self.year * 12 + self.month - 1 + n
    y := fdiv(index, 12)
    m := fmod(index, 12) + 1
    Date(year: y, month: m, day: lo(self.day, days_in_month(y, m)))

## This date plus `n` years; February 29 becomes February 28 in a common
## year (std.date.5).
pub fn Date.add_years(self, n int) Date
    self.add_months(12 * n)

## Days from `other` to this date (std.date.4).
pub fn Date.since(self, other Date) int
    self.days() - other.days()

## `2026-10-20` (std.date.9).
pub fn Date.iso(self) str
    "{pad4(self.year)}-{pad2(self.month)}-{pad2(self.day)}"

## The date formatted by `pattern` (std.date.10): the fields of the time are 0.
pub fn Date.format(self, pattern str) str
    DateTime(
        date: self,
        hour: 0,
        minute: 0,
        second: 0,
        ms: 0,
        offset: 0,
        zone: "UTC",
    ).format(pattern)

fn pad2(n int) str
    "{n}".pad_left(2, '0')

fn pad4(n int) str
    "{n}".pad_left(4, '0')

## The seconds east of UTC of a fixed zone, or `none` for a named one.
fn fixed_offset(zone str) int?
    if zone == "UTC" or zone == "Z"
        return 0
    first := zone.char_at(0) else return none
    if first != '+' and first != '-'
        return none
    sign := if first == '-' then -1 else 1
    rest := zone.slice(1, zone.len()).replace(":", "")
    h := digits(rest, 0, 2)?
    mut m := 0
    if rest.len() == 4
        m = digits(rest, 2, 2)?
    elif rest.len() != 2
        return none
    if h > 23 or m > 59
        return none
    sign * (h * 3600 + m * 60)

## `+05:30` for 19800 and `UTC` for 0.
fn fixed_name(offset int) str
    if offset == 0
        return "UTC"
    sign := if offset < 0 then "-" else "+"
    a := if offset < 0 then -offset else offset
    "{sign}{pad2(a / 3600)}:{pad2(a % 3600 / 60)}"

## The offset of `zone` at the instant `secs`, or `none` for an unknown zone.
fn zone_offset(zone str, secs int) int?
    if f := fixed_offset(zone)
        return f
    tz.offset(zone, secs)

## The instant of local time `local` (seconds, read as if UTC) in `zone`.
## A time that happens twice takes the first; one that is skipped takes the
## offset before the change, so it lands after the gap (std.date.7).
fn resolve(local int, zone str) int?
    if f := fixed_offset(zone)
        return local - f
    a := zone_offset(zone, local - 86400)?
    b := zone_offset(zone, local + 86400)?
    ta := local - a
    tb := local - b
    a_ok := valid(zone, ta, a)
    b_ok := valid(zone, tb, b)
    if a_ok and b_ok
        return lo(ta, tb)
    if b_ok and not a_ok
        return tb
    ta

fn valid(zone str, t int, off int) bool
    o := zone_offset(zone, t) else return false
    o == off

fn build(ms int, zone str) DateTime
    secs := fdiv(ms, 1000)
    off := zone_offset(zone, secs) else 0
    local := secs + off
    sod := fmod(local, 86400)
    DateTime(
        date: Date.from_days(fdiv(local, 86400)),
        hour: sod / 3600,
        minute: sod % 3600 / 60,
        second: sod % 60,
        ms: fmod(ms, 1000),
        offset: off,
        zone: zone,
    )

fn known(zone str) DateError?
    if zone_offset(zone, 0) == none
        # std.date.20: a zone name the zone data doesn't know.
        return DateError(text: zone, why: "unknown zone")
    none

## The instant `ms` milliseconds after 1970-01-01T00:00:00Z, seen in `zone`
## (std.date.7).
pub fn at(ms int, zone str) DateTime ! DateError
    if e := known(zone)
        return e
    build(ms, zone)

## The instant `ms`, in UTC (std.date.7).
pub fn utc(ms int) DateTime
    build(ms, "UTC")

## The current instant, in UTC (std.date.11). Denied by `--deterministic`
## with the rest of the clock (eff.det.1).
pub fn now() DateTime
    build(time.now_ms(), "UTC")

## The current instant in the system zone: `TZ`, else `/etc/localtime`, else
## UTC (std.date.11).
pub fn now_local() DateTime
    zone := tz.system()
    if zone_offset(zone, 0) == none
        return build(time.now_ms(), "UTC")
    build(time.now_ms(), zone)

## Milliseconds since 1970-01-01T00:00:00Z (std.date.8).
pub fn DateTime.unix_ms(self) int
    ((self.date.days() * 86400 + self.hour * 3600 + self.minute * 60 + self.second) - self.offset)
        * 1000
        + self.ms

## Whether this instant is earlier than `other`'s (std.date.8).
pub fn DateTime.before(self, other DateTime) bool
    self.unix_ms() < other.unix_ms()

## Milliseconds from `other` to this instant (std.date.8).
pub fn DateTime.since(self, other DateTime) int
    self.unix_ms() - other.unix_ms()

## This instant `n` milliseconds later, in the same zone: exact elapsed
## time, so across a clock change the wall time jumps (std.date.12).
pub fn DateTime.add_ms(self, n int) DateTime
    build(self.unix_ms() + n, self.zone)

## The same instant seen in another zone (std.date.7).
pub fn DateTime.in_zone(self, other str) DateTime ! DateError
    at(self.unix_ms(), other)

fn DateTime.on(self, d Date) DateTime
    tod := self.hour * 3600 + self.minute * 60 + self.second
    local := d.days() * 86400 + tod
    fallback := local - self.offset
    secs := resolve(local, self.zone) else fallback
    build(secs * 1000 + self.ms, self.zone)

## The same wall-clock time `n` days later in the same zone, so across a
## clock change the elapsed time is 23 or 25 hours (std.date.12).
pub fn DateTime.add_days(self, n int) DateTime
    self.on(self.date.add_days(n))

## The same wall-clock time `n` months later; see `Date.add_months`.
pub fn DateTime.add_months(self, n int) DateTime
    self.on(self.date.add_months(n))

## The same wall-clock time `n` years later; see `Date.add_years`.
pub fn DateTime.add_years(self, n int) DateTime
    self.on(self.date.add_years(n))

## 1 for Monday to 7 for Sunday.
pub fn DateTime.weekday(self) int
    self.date.weekday()

## `2026-10-20T17:01:52.123Z`, or with `+05:30` for a zone that isn't UTC; the
## fraction is left out when it is zero (std.date.9). `parse_iso` reads it back.
pub fn DateTime.iso(self) str
    frac := if self.ms != 0 then ".{pad3(self.ms)}" else ""
    zone_text := if self.offset == 0 then "Z" else fixed_name(self.offset)
    "{self.date.iso()}T{pad2(self.hour)}:{pad2(self.minute)}:{pad2(self.second)}{frac}{zone_text}"

fn pad3(n int) str
    "{n}".pad_left(3, '0')

## The date and time formatted by `pattern` (std.date.10, std.date.23). Tokens:
## `%Y` year, `%y` two-digit year, `%C` century, `%m` month, `%d` day, `%e` day
## padded with a space, `%j` day of year, `%H` hour, `%k` hour padded with a
## space, `%I` 12-hour, `%l` 12-hour padded with a space, `%p` AM or PM, `%P`
## am or pm, `%M` minute, `%S` second, `%f` milliseconds, `%a` `%A` weekday
## name, `%b` `%h` `%B` month name, `%u` weekday 1-7 from Monday, `%w` weekday
## 0-6 from Sunday, `%U` `%W` week of the year (Sunday or Monday first), `%G`
## `%g` `%V` ISO 8601 week year and week, `%z` `+0530`, `%:z` `+05:30`, `%Z`
## the zone, `%s` Unix seconds, `%F` `%Y-%m-%d`, `%T` `%H:%M:%S`, `%R`
## `%H:%M`, `%D` `%m/%d/%y`, `%r` `%I:%M:%S %p`, `%c` `%a %b %e %H:%M:%S %Y`,
## `%x` `%m/%d/%y`, `%X` `%H:%M:%S`, `%n` a newline, `%t` a tab, `%%` a percent
## sign. `%-d` drops the padding of a number and `%_d` pads it with spaces.
## Any other token is kept as written.
pub fn DateTime.format(self, pattern str) str
    cs := pattern.chars()
    mut out := List[str]()
    mut i := 0
    while i < cs.len()
        c := cs[i]
        i += 1
        if c != '%' or i >= cs.len()
            out.push("{c}")
            continue
        mut t := cs[i]
        i += 1
        mut flag := ' '
        if (t == '-' or t == '_') and i < cs.len()
            flag = t
            t = cs[i]
            i += 1
        if t == ':' and i < cs.len() and cs[i] == 'z'
            i += 1
            out.push(self.offset_text(true))
        elif text := self.token(t)
            out.push(shaped(text, t, flag))
        elif flag != ' '
            out.push("%{flag}{t}")
        else
            out.push("%{t}")
    out.join("")

fn DateTime.offset_text(self, colon bool) str
    sign := if self.offset < 0 then "-" else "+"
    a := if self.offset < 0 then -self.offset else self.offset
    sep := if colon then ":" else ""
    "{sign}{pad2(a / 3600)}{sep}{pad2(a % 3600 / 60)}"

fn DateTime.hour12(self) int
    h := self.hour % 12
    if h == 0
        return 12
    h

## The text of one `format` token, or `none` for a token that doesn't exist.
fn DateTime.token(self, t char) str?
    d := self.date
    if t == 'Y'
        return pad4(d.year)
    if t == 'y'
        return pad2(fmod(d.year, 100))
    if t == 'C'
        return pad2(fdiv(d.year, 100))
    if t == 'm'
        return pad2(d.month)
    if t == 'd'
        return pad2(d.day)
    if t == 'e'
        return "{d.day}".pad_left(2, ' ')
    if t == 'j'
        return "{d.yday()}".pad_left(3, '0')
    if t == 'H'
        return pad2(self.hour)
    if t == 'k'
        return "{self.hour}".pad_left(2, ' ')
    if t == 'I'
        return pad2(self.hour12())
    if t == 'l'
        return "{self.hour12()}".pad_left(2, ' ')
    if t == 'p'
        return if self.hour < 12 then "AM" else "PM"
    if t == 'P'
        return if self.hour < 12 then "am" else "pm"
    if t == 'M'
        return pad2(self.minute)
    if t == 'S'
        return pad2(self.second)
    if t == 'f'
        return pad3(self.ms)
    if t == 'a'
        return WEEKDAYS[d.weekday() - 1].slice(0, 3)
    if t == 'A'
        return WEEKDAYS[d.weekday() - 1]
    if t == 'b' or t == 'h'
        return MONTHS[d.month - 1].slice(0, 3)
    if t == 'B'
        return MONTHS[d.month - 1]
    if t == 'u'
        return "{d.weekday()}"
    if t == 'w'
        return "{d.weekday() % 7}"
    if t == 'U'
        return pad2((d.yday() - 1 + 7 - d.weekday() % 7) / 7)
    if t == 'W'
        return pad2((d.yday() - 1 + 7 - (d.weekday() - 1)) / 7)
    if t == 'G'
        return pad4(iso_year(d))
    if t == 'g'
        return pad2(fmod(iso_year(d), 100))
    if t == 'V'
        return pad2(iso_week(d))
    if t == 'z'
        return self.offset_text(false)
    if t == 'Z'
        return self.zone
    if t == 's'
        return "{fdiv(self.unix_ms(), 1000)}"
    if t == 'F'
        return self.format("%Y-%m-%d")
    if t == 'T' or t == 'X'
        return self.format("%H:%M:%S")
    if t == 'R'
        return self.format("%H:%M")
    if t == 'D' or t == 'x'
        return self.format("%m/%d/%y")
    if t == 'r'
        return self.format("%I:%M:%S %p")
    if t == 'c'
        return self.format("%a %b %e %H:%M:%S %Y")
    if t == 'n'
        return "\n"
    if t == 't'
        return "\t"
    if t == '%'
        return "%"
    none

## `text` without its leading zeros and spaces, keeping at least one character.
fn trim_pad(text str) str
    cs := text.chars()
    mut i := 0
    while i < cs.len() - 1 and (cs[i] == '0' or cs[i] == ' ')
        i += 1
    text.slice(i, cs.len())

## Applies the `-` (no padding) or `_` (space padding) flag to a number token.
fn shaped(text str, t char, flag char) str
    if flag == ' ' or not "YyCmdejHkIlMSfUWGgVus".contains("{t}")
        return text
    trimmed := trim_pad(text)
    if flag == '-'
        return trimmed
    trimmed.pad_left(text.len(), ' ')

## Weeks in the ISO 8601 year `y`: 53 when it starts on a Thursday, or is a
## leap year that starts on a Wednesday, else 52.
fn weeks_in_year(y int) int
    if iso_p(y) == 4 or iso_p(y - 1) == 3
        return 53
    52

fn iso_p(y int) int
    fmod(y + fdiv(y, 4) - fdiv(y, 100) + fdiv(y, 400), 7)

fn iso_raw(d Date) int
    (d.yday() - d.weekday() + 10) / 7

## The ISO 8601 week number, 1-53 (std.date.23).
fn iso_week(d Date) int
    w := iso_raw(d)
    if w < 1
        return weeks_in_year(d.year - 1)
    if w > weeks_in_year(d.year)
        return 1
    w

## The ISO 8601 week-numbering year of `d`, which differs from its calendar
## year in the first and last days of the year (std.date.23).
fn iso_year(d Date) int
    w := iso_raw(d)
    if w < 1
        return d.year - 1
    if w > weeks_in_year(d.year)
        return d.year + 1
    d.year

## The characters from `a` up to `b` or the end, whichever is first.
fn part(text str, a int, b int) str
    n := text.len()
    if a >= n
        return ""
    if b > n
        return text.slice(a, n)
    text.slice(a, b)

fn digits(text str, p int, n int) int?
    seg := part(text, p, p + n)
    if seg.len() != n
        return none
    for c in seg.chars()
        if not "0123456789".contains("{c}")
            return none
    seg.to_int()

# The causes are std.date.17 (the date), 18 (the time), 19 (the offset) and 20 (the zone).
fn bad(text str, why str) DateError
    DateError(text: text, why: why)

## The date in `YYYY-MM-DD` (std.date.13).
pub fn parse_date(text str) Date ! DateError
    y := digits(text, 0, 4) else return bad(text, "expected a 4-digit year")
    if part(text, 4, 5) != "-" or part(text, 7, 8) != "-" or text.len() != 10
        return bad(text, "expected YYYY-MM-DD")
    m := digits(text, 5, 2) else return bad(text, "expected a 2-digit month")
    d := digits(text, 8, 2) else return bad(text, "expected a 2-digit day")
    # std.date.16: the text has the right shape but names no day.
    day := Date.new(y, m, d) else return bad(text, "no such day")
    day

## An ISO 8601 date and time with an offset: `2026-10-20T17:01:52Z`,
## `2026-10-20T13:01:52.5-04:00`; `T` may be a space; seconds are optional;
## a fraction beyond milliseconds is cut (std.date.14). The result is in the
## text's own offset. A text with no offset is an error: use `parse_in`.
pub fn parse_iso(text str) DateTime ! DateError
    parse_with(text, "")

## Like `parse_iso`, for a text with no offset, read in `zone`; an offset in
## the text still wins (std.date.14).
pub fn parse_in(text str, zone str) DateTime ! DateError
    if e := known(zone)
        return e
    parse_with(text, zone)

fn parse_with(text str, zone str) DateTime ! DateError
    d := parse_date(part(text, 0, 10)) else err
        return bad(text, err.why)
    if text.len() < 16
        return bad(text, "expected a time after the date")
    sep := part(text, 10, 11)
    if sep != "T" and sep != " "
        return bad(text, "expected `T` between the date and the time")
    # std.date.18: the time part, after the date.
    hh := digits(text, 11, 2) else return bad(text, "expected a 2-digit hour")
    mm := digits(text, 14, 2) else return bad(text, "expected a 2-digit minute")
    if part(text, 13, 14) != ":" or hh > 23 or mm > 59
        return bad(text, "expected HH:MM")
    mut p := 16
    mut ss := 0
    if part(text, p, p + 1) == ":"
        ss = digits(text, p + 1, 2) else return bad(text, "expected a 2-digit second")
        if ss > 59
            return bad(text, "seconds go to 59 (leap seconds aren't supported)")
        p += 3
    mut frac := 0
    if part(text, p, p + 1) == "."
        mut scale := 100
        p += 1
        mut n := 0
        while p < text.len() and "0123456789".contains(part(text, p, p + 1))
            if scale > 0
                frac += (digits(text, p, 1) else 0) * scale
                scale /= 10
            p += 1
            n += 1
        if n == 0
            return bad(text, "expected digits after `.`")
    rest := part(text, p, text.len())
    tod := hh * 3600 + mm * 60 + ss
    local := d.days() * 86400 + tod
    if rest == ""
        if zone == ""
            return bad(text, "no offset (write Z or +HH:MM, or use parse_in)")
        secs := resolve(local, zone) else return bad(text, "unknown zone")
        return build(secs * 1000 + frac, zone)
    # std.date.19: the offset.
    off := fixed_offset(rest) else return bad(text, "expected Z, +HH:MM or -HH:MM after the time")
    build((local - off) * 1000 + frac, if off == 0 then "UTC" else fixed_name(off))

## `Tue, 20 Oct 2026 17:01:52 +0000` (RFC 2822, std.date.24); `parse_rfc2822`
## reads it back.
pub fn DateTime.rfc2822(self) str
    self.format("%a, %d %b %Y %H:%M:%S %z")

## `Tue, 20 Oct 2026 17:01:52 GMT`, the instant in UTC: the HTTP date of RFC 9110
## for `Date`, `Last-Modified` and `Expires` headers (std.date.24).
pub fn DateTime.http_date(self) str
    build(self.unix_ms(), "UTC").format("%a, %d %b %Y %H:%M:%S GMT")

## An RFC 3339 timestamp: `2026-10-20T17:01:52Z`, `2026-10-20T13:01:52.5-04:00`.
## Stricter than `parse_iso`: seconds and an offset are required, the separator
## is `T` or `t` and the offset may be `z` (std.date.25). Use it for
## timestamps from JSON APIs and logs.
pub fn parse_rfc3339(text str) DateTime ! DateError
    if text.len() < 20
        return bad(text, "expected YYYY-MM-DDTHH:MM:SS and an offset")
    sep := part(text, 10, 11)
    if sep != "T" and sep != "t"
        return bad(text, "expected `T` between the date and the time")
    if part(text, 16, 17) != ":"
        return bad(text, "RFC 3339 needs seconds")
    fixed := "{part(text, 0, 10)}T{part(text, 11, text.len()).to_upper()}"
    r := parse_with(fixed, "") else err
        return bad(text, err.why)
    r

fn obsolete_zone(z str) str
    u := z.to_upper()
    if u == "EST"
        return "-0500"
    if u == "EDT" or u == "CST"
        return if u == "EDT" then "-0400" else "-0600"
    if u == "CDT" or u == "MST"
        return if u == "CDT" then "-0500" else "-0700"
    if u == "MDT" or u == "PST"
        return if u == "MDT" then "-0600" else "-0800"
    if u == "PDT"
        return "-0700"
    z

## An RFC 2822 date, as in an email `Date` header or an HTTP `Date` header:
## `Tue, 20 Oct 2026 17:01:52 +0000`, `20 Oct 2026 17:01 GMT`. The weekday is
## optional and not checked, seconds are optional, the zone is `±HHMM`, `Z`,
## `UT`, `GMT`, `UTC` or a North American name (`EST`, `PDT`...), and a trailing
## `(comment)` is dropped (std.date.25).
pub fn parse_rfc2822(text str) DateTime ! DateError
    mut t := text
    if pos := t.find("(")
        t = part(t, 0, pos)
    if pos := t.find(",")
        t = part(t, pos + 1, t.len())
    mut ws := t.words()
    if ws.len() == 0
        return bad(text, "expected a date such as Tue, 20 Oct 2026 17:01:52 +0000")
    ws[ws.len() - 1] = obsolete_zone(ws[ws.len() - 1])
    joined := ws.join(" ")
    pat := if joined.split(":").len() == 3 then "%d %b %Y %H:%M:%S %z" else "%d %b %Y %H:%M %z"
    r := scan_format(joined, pat, "") else err
        return bad(text, err.why)
    r

## Reads `text` by a `format`-style `pattern` (std.date.26). The instant must
## carry an offset, from `%z` or `%s`; for text without one use
## `parse_format_in`.
pub fn parse_format(text str, pattern str) DateTime ! DateError
    scan_format(text, pattern, "")

## Like `parse_format`, for text with no offset, read in `zone`; an offset in
## the text still wins (std.date.26).
pub fn parse_format_in(text str, pattern str, zone str) DateTime ! DateError
    if e := known(zone)
        return e
    scan_format(text, pattern, zone)

fn expand_pattern(pattern str) str
    cs := pattern.chars()
    mut out := List[str]()
    mut i := 0
    while i < cs.len()
        c := cs[i]
        i += 1
        if c != '%' or i >= cs.len()
            out.push("{c}")
            continue
        t := cs[i]
        i += 1
        if t == 'F'
            out.push("%Y-%m-%d")
        elif t == 'T'
            out.push("%H:%M:%S")
        elif t == 'R'
            out.push("%H:%M")
        elif t == 'D'
            out.push("%m/%d/%y")
        elif t == 'r'
            out.push("%I:%M:%S %p")
        else
            out.push("%{t}")
    out.join("")

## How many digits start at `p`, at most `maxn`.
fn digit_run(text str, p int, maxn int) int
    mut n := 0
    while n < maxn and p + n < text.len() and "0123456789".contains(part(text, p + n, p + n + 1))
        n += 1
    n

fn field_width(text str, p int, maxn int, what str) int ! DateError
    n := digit_run(text, p, maxn)
    if n == 0
        return bad(text, "expected {what}")
    n

## The length of the name at `p` when it is `name` or its first three letters,
## in any case; 0 when it is neither.
fn name_len(text str, p int, name str) int
    full := name.len()
    if part(text, p, p + full).to_lower() == name.to_lower()
        return full
    if part(text, p, p + 3).to_lower() == part(name, 0, 3).to_lower()
        return 3
    0

fn find_name(names List[str], text str, p int) int
    for i in 0..names.len()
        if name_len(text, p, names[i]) > 0
            return i
    -1

## The reader behind `parse_format` and `parse_format_in` (std.date.26,
## std.date.27). A space in the pattern matches any run of spaces and tabs.
fn scan_format(text str, pattern str, zone str) DateTime ! DateError
    pat := expand_pattern(pattern).chars()
    mut i := 0
    mut p := 0
    mut year := 0
    mut month := 0
    mut day := 0
    mut yday := 0
    mut hour := 0
    mut minute := 0
    mut second := 0
    mut frac := 0
    mut ampm := 0
    mut has_year := false
    mut has_month := false
    mut has_day := false
    mut has_off := false
    mut off := 0
    mut epoch := false
    mut secs := 0
    while i < pat.len()
        c := pat[i]
        i += 1
        if c == ' '
            while p < text.len() and (part(text, p, p + 1) == " " or part(text, p, p + 1) == "\t")
                p += 1
            continue
        if c != '%' or i >= pat.len()
            if part(text, p, p + 1) != "{c}"
                return bad(text, "expected `{c}`")
            p += 1
            continue
        t := pat[i]
        i += 1
        if t == 'Y'
            w := field_width(text, p, 4, "a year")?
            if w < 4
                return bad(text, "expected a 4-digit year")
            year = digits(text, p, w) else 0
            has_year = true
            p += w
        elif t == 'y'
            w := field_width(text, p, 2, "a 2-digit year")?
            v := digits(text, p, w) else 0
            year = if v < 69 then 2000 + v else 1900 + v
            has_year = true
            p += w
        elif t == 'm'
            w := field_width(text, p, 2, "a month")?
            month = digits(text, p, w) else 0
            has_month = true
            p += w
        elif t == 'd' or t == 'e'
            if t == 'e' and part(text, p, p + 1) == " "
                p += 1
            w := field_width(text, p, 2, "a day")?
            day = digits(text, p, w) else 0
            has_day = true
            p += w
        elif t == 'j'
            w := field_width(text, p, 3, "a day of the year")?
            yday = digits(text, p, w) else 0
            p += w
        elif t == 'H' or t == 'k' or t == 'I' or t == 'l'
            if (t == 'k' or t == 'l') and part(text, p, p + 1) == " "
                p += 1
            w := field_width(text, p, 2, "an hour")?
            hour = digits(text, p, w) else 0
            if t == 'I' or t == 'l'
                if hour < 1 or hour > 12
                    return bad(text, "12-hour clock goes 1 to 12")
                if ampm == 0
                    ampm = 3
            p += w
        elif t == 'M'
            w := field_width(text, p, 2, "a minute")?
            minute = digits(text, p, w) else 0
            p += w
        elif t == 'S'
            w := field_width(text, p, 2, "a second")?
            second = digits(text, p, w) else 0
            p += w
        elif t == 'f'
            w := field_width(text, p, 9, "digits of a fraction")?
            s3 := part(text, p, p + w).pad_right(3, '0').slice(0, 3)
            frac = s3.to_int() else 0
            p += w
        elif t == 'p' or t == 'P'
            ap := part(text, p, p + 2).to_upper()
            if ap == "AM"
                ampm = 1
            elif ap == "PM"
                ampm = 2
            else
                return bad(text, "expected AM or PM")
            p += 2
        elif t == 'b' or t == 'B' or t == 'h'
            k := find_name(MONTHS, text, p)
            if k < 0
                return bad(text, "expected a month name")
            month = k + 1
            has_month = true
            p += name_len(text, p, MONTHS[k])
        elif t == 'a' or t == 'A'
            k := find_name(WEEKDAYS, text, p)
            if k < 0
                return bad(text, "expected a weekday name")
            p += name_len(text, p, WEEKDAYS[k])
        elif t == 's'
            neg := part(text, p, p + 1) == "-"
            if neg
                p += 1
            w := field_width(text, p, 18, "Unix seconds")?
            secs = digits(text, p, w) else 0
            if neg
                secs = 0 - secs
            epoch = true
            p += w
        elif t == 'z'
            has_off = true
            ch := part(text, p, p + 1)
            up3 := part(text, p, p + 3).to_upper()
            if ch == "Z" or ch == "z"
                off = 0
                p += 1
            elif up3 == "UTC" or up3 == "GMT"
                off = 0
                p += 3
            elif part(text, p, p + 2).to_upper() == "UT"
                off = 0
                p += 2
            elif ch == "+" or ch == "-"
                if digit_run(text, p + 1, 2) != 2
                    return bad(text, "expected +HH:MM or +HHMM for the offset")
                hh := digits(text, p + 1, 2) else 0
                p += 3
                mut mm := 0
                q := if part(text, p, p + 1) == ":" then p + 1 else p
                if digit_run(text, q, 2) == 2
                    mm = digits(text, q, 2) else 0
                    p = q + 2
                if hh > 23 or mm > 59
                    return bad(text, "offset out of range")
                sign := if ch == "-" then -1 else 1
                off = sign * (hh * 3600 + mm * 60)
            else
                return bad(text, "expected an offset such as Z, +HH:MM or +HHMM")
        elif t == 'n' or t == 't'
            while p < text.len() and part(text, p, p + 1).trim() == ""
                p += 1
        elif t == '%'
            if part(text, p, p + 1) != "%"
                return bad(text, "expected `%`")
            p += 1
        else
            return bad(text, "can't read the token `%{t}` (std.date.26 lists the ones that can be read)")
    if p < text.len()
        return bad(text, "unexpected text after the pattern")
    if epoch
        return build(secs * 1000 + frac, "UTC")
    if ampm == 3
        return bad(text, "%I needs %p")
    mut h := hour
    if ampm == 1 or ampm == 2
        if hour < 1 or hour > 12
            return bad(text, "12-hour clock goes 1 to 12")
        h = hour % 12 + (if ampm == 2 then 12 else 0)
    if h > 23 or minute > 59 or second > 59
        return bad(text, "time out of range")
    if not has_year
        return bad(text, "the pattern has no year (add %Y)")
    mut day_of := Date(year: year, month: 1, day: 1)
    if yday > 0 and not has_month and not has_day
        if yday > 366 or (yday == 366 and not is_leap(year))
            return bad(text, "no such day")
        day_of = Date(year: year, month: 1, day: 1).add_days(yday - 1)
    else
        if not has_month or not has_day
            return bad(text, "the pattern has no month and day (add %m and %d, or %j)")
        day_of = Date.new(year, month, day) else return bad(text, "no such day")
    local := day_of.days() * 86400 + h * 3600 + minute * 60 + second
    if has_off
        return build((local - off) * 1000 + frac, if off == 0 then "UTC" else fixed_name(off))
    if zone == ""
        return bad(text, "no offset (use %z, or parse_format_in)")
    zsecs := resolve(local, zone) else return bad(text, "unknown zone")
    build(zsecs * 1000 + frac, zone)

# ---- durations as text (std.date.21, std.date.22) ----

## The most a parsed duration may be, in milliseconds: a parse never overflows.
MAX_DURATION := 1000000000000000000

DURATION_UNITS := [86400000, 3600000, 60000, 1000, 1]
DURATION_NAMES := ["d", "h", "m", "s", "ms"]

## `ms` as days, hours, minutes, seconds and milliseconds, largest first, the
## zero parts left out: `3723000` is `1h 2m 3s`. Zero is `0s`, a negative
## duration has a leading `-` (std.date.21).
pub fn duration_text(ms int) str
    if ms == 0
        return "0s"
    mut n := if ms < 0 then 0 - ms else ms
    mut out := []
    for i in 0..DURATION_UNITS.len()
        k := n / DURATION_UNITS[i]
        if k > 0
            out.push("{k}{DURATION_NAMES[i]}")
            n -= k * DURATION_UNITS[i]
    sign := if ms < 0 then "-" else ""
    "{sign}{out.join(" ")}"

fn unit_ms(unit str) int?
    for i in 0..DURATION_NAMES.len()
        if DURATION_NAMES[i] == unit
            return DURATION_UNITS[i]
    none

## One `NUMBER UNIT` pair of a duration, added to `total`.
fn add_part(total int, num str, unit str, text str) int ! DateError
    mult := unit_ms(unit) else return bad(text, "unknown unit `{unit}` (write d, h, m, s or ms)")
    n := num.to_int() else return bad(text, "duration too large")
    if n > MAX_DURATION / mult
        return bad(text, "duration too large")
    t := total + n * mult
    if t > MAX_DURATION
        return bad(text, "duration too large")
    t

## A duration written as `NUMBER UNIT` pairs, in any order and optionally
## separated by spaces: `90s`, `1h30m`, `2d`, `1h 2m 3s`, `250ms`; the units are
## `d`, `h`, `m`, `s` and `ms`, the result is in milliseconds, and a leading `-`
## makes it negative (std.date.22).
pub fn parse_duration(text str) int ! DateError
    s := text.trim()
    neg := part(s, 0, 1) == "-"
    body := if neg then part(s, 1, s.len()) else s
    mut total := 0
    mut num := ""
    mut unit := ""
    mut pairs := 0
    for c in body.chars()
        d := "{c}"
        if "0123456789".contains(d)
            if unit != ""
                total = add_part(total, num, unit, text)?
                pairs += 1
                num = ""
                unit = ""
            num = "{num}{d}"
        elif d == " "
            if unit != ""
                total = add_part(total, num, unit, text)?
                pairs += 1
                num = ""
                unit = ""
            elif num != ""
                return bad(text, "expected a unit after the number")
        else
            if num == ""
                return bad(text, "expected a number before the unit")
            unit = "{unit}{d}"
    if unit != ""
        total = add_part(total, num, unit, text)?
        pairs += 1
    elif num != ""
        return bad(text, "expected a unit after the number")
    if pairs == 0
        return bad(text, "expected a duration such as 1h30m")
    if neg then 0 - total else total
