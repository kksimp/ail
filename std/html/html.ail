LEGACY_LIST := """
    AElig AMP Aacute Acirc Agrave Aring Atilde Auml COPY Ccedil ETH Eacute Ecirc Egrave Euml GT
    Iacute Icirc Igrave Iuml LT Ntilde Oacute Ocirc Ograve Oslash Otilde Ouml QUOT REG THORN
    Uacute Ucirc Ugrave Uuml Yacute aacute acirc acute aelig agrave amp aring atilde auml brvbar
    ccedil cedil cent copy curren deg divide eacute ecirc egrave eth euml frac12 frac14 frac34
    gt iacute icirc iexcl igrave iquest iuml laquo lt macr micro middot nbsp not ntilde oacute
    ocirc ograve ordf ordm oslash otilde ouml para plusmn pound quot raquo reg sect shy sup1
    sup2 sup3 szlig thorn times uacute ucirc ugrave uml uuml yacute yen yuml
    """

## The legacy names, which also match with no `;` (std.html.6).
LEGACY := word_set(LEGACY_LIST)

## What numeric references to 0x80-0x9F mean: the windows-1252 characters (std.html.6).
CP1252_LIST := """
    128 8364 130 8218 131 402 132 8222 133 8230 134 8224 135 8225 136 710 137 8240 138 352 139
    8249 140 338 142 381 145 8216 146 8217 147 8220 148 8221 149 8226 150 8211 151 8212 152 732
    153 8482 154 353 155 8250 156 339 158 382 159 376
    """
CP1252 := code_table(CP1252_LIST)

## ---- characters

fn is_alpha_ascii(c char) bool
    k := c.code()
    (k >= 65 and k <= 90) or (k >= 97 and k <= 122)

fn is_alnum_ascii(c char) bool
    is_alpha_ascii(c) or (c.code() >= 48 and c.code() <= 57)

## ASCII upper case to lower case; everything else as it is (std.html.5).
fn lower_ascii(c char) char
    k := c.code()
    if k >= 65 and k <= 90
        return char.from_code(k + 32) else c
    c

## Space, tab, line feed and form feed: HTML's whitespace.
fn is_space_html(c char) bool
    c == ' ' or c == '\t' or c == '\n' or c.code() == 12

fn lower_word(s str) str
    mut out := List[char]()
    for c in s.chars()
        out.push(lower_ascii(c))
    out.join("")

## The character a numeric reference names, with the WHATWG replacements (std.html.6).
fn fix_code(code int) char
    if code == 0 or code > 1114111 or (code >= 55296 and code <= 57343)
        return '\u{fffd}'
    mapped := CP1252.get(code) else code
    char.from_code(mapped) else '\u{fffd}'

## ---- tokenizer (std.html.5-7)

enum Tok
    Start(name str, attrs List[Attr], closed bool)
    End(name str)
    Chars(content str)
    Note(content str)
    Doctype(name str, ids bool)

struct Lexer
    cs List[char]
    pos int
    toks List[Tok]

## The text as characters, with CRLF and CR as LF (std.html.5). NUL stays: it is dropped from body
## text and U+FFFD everywhere else.
fn prepare(src str) List[char]
    raw := src.chars()
    mut out := List[char]()
    mut i := 0
    while i < raw.len()
        c := raw[i]
        if c == '\r'
            out.push('\n')
            if i + 1 < raw.len() and raw[i + 1] == '\n'
                i += 1
        else
            out.push(c)
        i += 1
    out

## `s` with NUL as U+FFFD (std.html.5).
fn nul_fix(s str) str
    s.replace("\u{0}", "\u{fffd}")

fn Lexer.at(self, k int) char?
    p := self.pos + k
    if p >= self.cs.len()
        return none
    self.cs[p]

fn Lexer.done(self) bool
    self.pos >= self.cs.len()

## Does the text at the cursor start with `s`, ignoring ASCII case? `s` is lower case.
fn Lexer.looking_at(self, s str) bool
    want := s.chars()
    if self.pos + want.len() > self.cs.len()
        return false
    for i in 0..want.len()
        if lower_ascii(self.cs[self.pos + i]) != want[i]
            return false
    true

## The value of the digits from the cursor, or -1 when there are none; stops growing past U+10FFFF.
fn Lexer.ref_digits(mut self, base int) int
    start := self.pos
    mut code := 0
    while not self.done()
        v := self.cs[self.pos].to_digit(base) else break
        if code <= 1114111
            code = code * base + v
        self.pos += 1
    if self.pos == start
        return -1
    code

## The text of the character reference at the cursor, which is at `&`; the cursor moves past it.
## A `&` that starts no reference is itself (std.html.6).
fn Lexer.char_ref(mut self, in_attr bool) str
    amp := self.pos
    self.pos += 1
    if self.at(0) == '#'
        self.pos += 1
        mut base := 10
        if self.at(0) == 'x' or self.at(0) == 'X'
            base = 16
            self.pos += 1
        code := self.ref_digits(base)
        if code < 0
            self.pos = amp + 1
            return "&"
        if self.at(0) == ';'
            self.pos += 1
        return "{fix_code(code)}"
    start := self.pos
    while not self.done() and is_alnum_ascii(self.cs[self.pos]) and self.pos - start < 32
        self.pos += 1
    name := self.cs[start..self.pos].join("")
    if self.at(0) == ';'
        if named := ENTITIES.get(name)
            self.pos += 1
            return "{fix_code(named)}"
    mut k := name.len()
    while k > 0
        prefix := name.slice(0, k)
        if LEGACY.contains(prefix)
            after := start + k
            if in_attr and after < self.cs.len()
                follow := self.cs[after]
                if is_alnum_ascii(follow) or follow == '='
                    self.pos = amp + 1
                    return "&"
            self.pos = after
            return "{fix_code(ENTITIES.get(prefix) else 65533)}"
        k -= 1
    self.pos = amp + 1
    "&"

fn Lexer.emit_text(mut self, s str)
    if s != ""
        self.toks.push(Tok.Chars(content: s))

## Text up to the next `<`, with references resolved.
fn Lexer.data(mut self)
    mut buf := List[str]()
    while not self.done()
        c := self.cs[self.pos]
        if c == '<'
            break
        if c == '&'
            buf.push(self.char_ref(false))
        else
            buf.push("{c}")
            self.pos += 1
    self.emit_text(buf.join(""))

fn Lexer.run(mut self)
    while not self.done()
        if self.cs[self.pos] != '<'
            self.data()
            continue
        c1 := self.at(1) else
            self.emit_text("<")
            self.pos += 1
            continue
        if is_alpha_ascii(c1)
            self.start_tag()
        elif c1 == '/'
            c2 := self.at(2) else
                self.emit_text("</")
                self.pos += 2
                continue
            if is_alpha_ascii(c2)
                self.end_tag()
            elif c2 == '>'
                self.pos += 3
            else
                self.pos += 2
                self.bogus_comment()
        elif c1 == '!'
            if self.looking_at("<!--")
                self.comment()
            elif self.looking_at("<!doctype")
                self.doctype()
            else
                self.pos += 2
                self.bogus_comment()
        elif c1 == '?'
            self.pos += 1
            self.bogus_comment()
        else
            self.emit_text("<")
            self.pos += 1

## `<!doctype ...>`: the name and whether the declaration has a public or system identifier.
fn Lexer.doctype(mut self)
    start := self.pos + 9
    self.skip_past_gt()
    stop := self.pos - 1
    mut body := List[str]()
    if stop > start
        body = self.cs[start..stop].join("").to_lower().words()
    mut name := ""
    if body.len() > 0
        name = body[0]
    ids := body.contains("public") or body.contains("system")
    self.toks.push(Tok.Doctype(name: name, ids: ids))

fn Lexer.skip_past_gt(mut self)
    while not self.done() and self.cs[self.pos] != '>'
        self.pos += 1
    self.pos += 1

## `<!x>`, `<?x>` and `</ x>`: a comment up to the next `>` (std.html.5).
fn Lexer.bogus_comment(mut self)
    start := self.pos
    while not self.done() and self.cs[self.pos] != '>'
        self.pos += 1
    self.toks.push(Tok.Note(content: self.cs[start..self.pos].join("")))
    self.pos += 1

## `<!-- ... -->`, also ended by `--!>`; `<!-->` and `<!--->` are empty (std.html.5).
fn Lexer.comment(mut self)
    self.pos += 4
    start := self.pos
    if self.at(0) == '>'
        self.pos += 1
        self.toks.push(Tok.Note(content: ""))
        return
    if self.at(0) == '-' and self.at(1) == '>'
        self.pos += 2
        self.toks.push(Tok.Note(content: ""))
        return
    while not self.done()
        if self.cs[self.pos] == '-' and self.at(1) == '-'
            if self.at(2) == '>'
                self.toks.push(Tok.Note(content: self.cs[start..self.pos].join("")))
                self.pos += 3
                return
            if self.at(2) == '!' and self.at(3) == '>'
                self.toks.push(Tok.Note(content: self.cs[start..self.pos].join("")))
                self.pos += 4
                return
        self.pos += 1
    self.toks.push(Tok.Note(content: self.cs[start..self.pos].join("")))

fn Lexer.tag_name(mut self) str
    mut buf := List[char]()
    while not self.done()
        c := self.cs[self.pos]
        if is_space_html(c) or c == '/' or c == '>'
            break
        buf.push(lower_ascii(c))
        self.pos += 1
    buf.join("")

fn Lexer.skip_space(mut self)
    while not self.done() and is_space_html(self.cs[self.pos])
        self.pos += 1

## An attribute value after `=`, quoted or not, with references resolved; `none` at the end of
## the text.
fn Lexer.attr_value(mut self) str?
    self.skip_space()
    q := self.at(0)?
    mut buf := List[str]()
    if q == '"' or q == '\''
        self.pos += 1
        while true
            c := self.at(0)?
            if c == q
                self.pos += 1
                break
            if c == '&'
                buf.push(self.char_ref(true))
            else
                buf.push("{c}")
                self.pos += 1
    else
        while not self.done()
            c := self.cs[self.pos]
            if is_space_html(c) or c == '>'
                break
            if c == '&'
                buf.push(self.char_ref(true))
            else
                buf.push("{c}")
                self.pos += 1
    buf.join("")

fn has_attr(attrs List[Attr], key str) bool
    for a in attrs
        if a.name == key
            return true
    false

## The attributes of a tag through its `>`, and whether it ends in `/>`; `none` when the text ends
## first, which drops the tag (std.html.5). A repeated attribute keeps its first value.
fn Lexer.attributes(mut self) (List[Attr], bool)?
    mut attrs := List[Attr]()
    mut closed := false
    while true
        while not self.done() and (is_space_html(self.cs[self.pos]) or self.cs[self.pos] == '/')
            if self.cs[self.pos] == '/'
                closed = self.at(1) == '>'
            self.pos += 1
        c := self.at(0)?
        if c == '>'
            self.pos += 1
            return (attrs, closed)
        closed = false
        mut buf := [lower_ascii(c)]
        self.pos += 1
        while not self.done()
            d := self.cs[self.pos]
            if is_space_html(d) or d == '/' or d == '>' or d == '='
                break
            buf.push(lower_ascii(d))
            self.pos += 1
        key := buf.join("")
        self.skip_space()
        mut value := ""
        if self.at(0) == '='
            self.pos += 1
            value = self.attr_value()?
        if not has_attr(attrs, key)
            attrs.push(Attr(name: key, value: value))

fn Lexer.start_tag(mut self)
    self.pos += 1
    name := self.tag_name()
    got := self.attributes() else return
    self.toks.push(Tok.Start(name: name, attrs: got.0, closed: got.1))
    if RAWTEXT.contains(name)
        self.raw(name, false)
    elif RCDATA.contains(name)
        self.raw(name, true)
    elif name == "plaintext"
        self.emit_text(nul_fix(self.cs.slice(self.pos).join("")))
        self.pos = self.cs.len()

## The text of a raw text or RCDATA element, up to its end tag (std.html.7). In `script` text a
## `<!--` opens an escape in which `<script` opens a second one, and the end tag only counts
## outside the second one; `-->` closes both.
fn Lexer.raw(mut self, name str, refs bool)
    mut buf := List[str]()
    mut esc := 0
    while not self.done()
        c := self.cs[self.pos]
        if name == "script"
            if c == '<' and esc == 0 and self.looking_at("<!--")
                esc = 1
                buf.push(self.cs[self.pos..self.pos + 4].join(""))
                self.pos += 4
                continue
            if c == '-' and esc > 0 and self.at(1) == '-' and self.at(2) == '>'
                esc = 0
                buf.push("-->")
                self.pos += 3
                continue
            if c == '<' and esc > 0 and self.at(1) != '/' and self.script_tag()
                esc = 2
                buf.push(self.cs[self.pos..self.pos + 7].join(""))
                self.pos += 7
                continue
            if c == '<' and esc == 2 and self.at(1) == '/' and self.raw_end(name)
                esc = 1
                buf.push(self.cs[self.pos..self.pos + 8].join(""))
                self.pos += 8
                continue
        if c == '<' and self.at(1) == '/' and self.raw_end(name)
            break
        if c == '&' and refs
            buf.push(self.char_ref(false))
        else
            buf.push("{c}")
            self.pos += 1
    self.emit_text(nul_fix(buf.join("")))

## Is the cursor at `<script` followed by whitespace, `/` or `>`?
fn Lexer.script_tag(self) bool
    if self.pos + 7 >= self.cs.len() or not self.looking_at("<script")
        return false
    c := self.cs[self.pos + 7]
    is_space_html(c) or c == '/' or c == '>'

## Is the cursor at `</name` followed by whitespace, `/` or `>`?
fn Lexer.raw_end(self, name str) bool
    want := name.chars()
    p := self.pos + 2
    if p + want.len() > self.cs.len()
        return false
    for i in 0..want.len()
        if lower_ascii(self.cs[p + i]) != want[i]
            return false
    after := p + want.len()
    if after >= self.cs.len()
        return false
    c := self.cs[after]
    is_space_html(c) or c == '/' or c == '>'

fn Lexer.end_tag(mut self)
    self.pos += 2
    name := self.tag_name()
    _ := self.attributes() else return
    self.toks.push(Tok.End(name: name))

fn tokenize(src str) List[Tok]
    mut lx := Lexer(cs: prepare(src), pos: 0, toks: List[Tok]())
    lx.run()
    mut out := List[Tok]()
    for t in lx.toks
        match t
            Tok.Note(c) => out.push(Tok.Note(content: nul_fix(c)))
            Tok.Start(n, attrs, closed) =>
                mut fixed := List[Attr]()
                for a in attrs
                    fixed.push(Attr(name: nul_fix(a.name), value: nul_fix(a.value)))
                out.push(Tok.Start(name: nul_fix(n), attrs: fixed, closed: closed))
            Tok.End(n) => out.push(Tok.End(name: nul_fix(n)))
            _ => out.push(t)
    out

## ---- tree builder (std.html.8-11)

struct Part
    kind int
    name str
    attrs List[Attr]
    kids List[int]
    data str

struct Builder
    parts List[Part]
    stack List[int]
    fragment bool
    in_head bool
    skip_lf bool
    ctx int
    quirks bool

## Where the reader is before the body (std.html.10): comments and spaces there are placed by it.
C_INITIAL := 0
C_BEFORE_HEAD := 1
C_HEAD := 2
C_AFTER_HEAD := 3
C_BODY := 4
C_AFTER_BODY := 5
C_AFTER_AFTER := 6

## In a document, parts 0, 1 and 2 are `html`, `head` and `body`.
HTML_PART := 0
HEAD_PART := 1
BODY_PART := 2

fn elem_part(name str, attrs List[Attr]) Part
    Part(kind: K_ELEM, name: name, attrs: attrs, kids: List[int](), data: "")

fn text_part(kind int, data str) Part
    Part(kind: kind, name: "", attrs: List[Attr](), kids: List[int](), data: data)

fn new_builder(fragment bool) Builder
    if fragment
        return Builder(
            parts: [elem_part("#fragment", List[Attr]())],
            stack: [0],
            fragment: true,
            in_head: false,
            skip_lf: false,
            ctx: C_BODY,
            quirks: false,
        )
    mut doc := elem_part("html", List[Attr]())
    doc.kids = [HEAD_PART, BODY_PART]
    Builder(
        parts: [doc, elem_part("head", List[Attr]()), elem_part("body", List[Attr]())],
        stack: [HTML_PART, HEAD_PART],
        fragment: false,
        in_head: true,
        skip_lf: false,
        ctx: C_INITIAL,
        quirks: true,
    )

fn Builder.top(self) int
    self.stack[self.stack.len() - 1]

fn Builder.top_name(self) str
    self.parts[self.top()].name

fn Builder.name_at(self, i int) str
    self.parts[self.stack[i]].name

## Adds `p` as the last child of the current element and gives its index.
fn Builder.append(mut self, p Part) int
    k := self.parts.len()
    self.parts.push(p)
    t := self.top()
    self.parts[t].kids.push(k)
    k

## Is `s` all HTML white space?
fn all_space(s str) bool
    for c in s.chars()
        if not is_space_html(c)
            return false
    true

## The stack index of the table that new content moves in front of (foster parenting), or -1
## when the current element is not a table part (std.html.9).
fn Builder.foster_idx(self) int
    nm := self.top_name()
    if nm != "table" and nm != "tbody" and nm != "thead" and nm != "tfoot" and nm != "tr"
        return -1
    mut i := self.stack.len() - 1
    while i > 0
        if self.name_at(i) == "table"
            return i
        i -= 1
    -1

## Puts part `k` in front of the table at stack index `t`.
fn Builder.foster_insert(mut self, k int, t int)
    par := self.stack[t - 1]
    at := self.parts[par].kids.index_of(self.stack[t]) else 0
    self.parts[par].kids.insert(at, k)

## Puts `s` as text in front of the table at stack index `t`, joining text that is already there.
fn Builder.foster_text(mut self, s str, t int)
    par := self.stack[t - 1]
    at := self.parts[par].kids.index_of(self.stack[t]) else 0
    if at > 0
        prev := self.parts[par].kids[at - 1]
        if self.parts[prev].kind == K_TEXT
            self.parts[prev].data = "{self.parts[prev].data}{s}"
            return
    k := self.parts.len()
    self.parts.push(text_part(K_TEXT, s))
    self.parts[par].kids.insert(at, k)

## Puts `p` as a child of `html` in front of part `before`; text joins the text before it.
fn Builder.html_insert(mut self, p Part, before int)
    kids := self.parts[HTML_PART].kids
    at := kids.index_of(before) else 0
    if p.kind == K_TEXT and at > 0
        prev := kids[at - 1]
        if self.parts[prev].kind == K_TEXT
            self.parts[prev].data = "{self.parts[prev].data}{p.data}"
            return
    k := self.parts.len()
    self.parts.push(p)
    self.parts[HTML_PART].kids.insert(at, k)

fn Builder.add_text(mut self, s str)
    ft := if all_space(s) then -1 else self.foster_idx()
    if ft > 0
        self.foster_text(s, ft)
        return
    t := self.top()
    n := self.parts[t].kids.len()
    if n > 0
        last := self.parts[t].kids[n - 1]
        if self.parts[last].kind == K_TEXT
            self.parts[last].data = "{self.parts[last].data}{s}"
            return
    _ := self.append(text_part(K_TEXT, s))

fn Builder.pop_to(mut self, i int)
    self.stack = self.stack.slice(0, i)

fn Builder.pop_one(mut self)
    self.pop_to(self.stack.len() - 1)

fn Builder.to_body(mut self)
    self.ctx = C_BODY
    self.in_head = false
    self.stack = [HTML_PART, BODY_PART]

## Attributes of a repeated `<html>` or `<body>` that the element lacks (std.html.10).
fn Builder.merge_attrs(mut self, k int, attrs List[Attr])
    for a in attrs
        if not has_attr(self.parts[k].attrs, a.name)
            self.parts[k].attrs.push(a)

## Where `want` is open on the stack within scope, or -1. `want` "h*" is any heading.
fn Builder.in_scope(self, want str, mode int) int
    mut i := self.stack.len() - 1
    while i >= 0
        nm := self.name_at(i)
        if nm == want or (want == "h*" and HEADINGS.contains(nm))
            return i
        if mode == IN_TABLE
            if nm == "html" or nm == "table" or nm == "template"
                return -1
        else
            if SCOPE.contains(nm)
                return -1
            if mode == IN_BUTTON and nm == "button"
                return -1
            if mode == IN_LIST and (nm == "ol" or nm == "ul")
                return -1
        i -= 1
    -1

fn Builder.close_p(mut self)
    i := self.in_scope("p", IN_BUTTON)
    if i >= 0
        self.pop_to(i)

## Opens an element; past MAX_DEPTH it is added but not opened (std.html.11).
fn Builder.open(mut self, name str, attrs List[Attr], foster bool)
    ft := if foster then self.foster_idx() else -1
    mut k := 0
    if ft > 0
        k = self.parts.len()
        self.parts.push(elem_part(name, attrs))
        self.foster_insert(k, ft)
    else
        k = self.append(elem_part(name, attrs))
    if self.stack.len() < MAX_DEPTH
        self.stack.push(k)

fn Builder.in_foreign(self) bool
    for k in self.stack
        if self.parts[k].name == "svg" or self.parts[k].name == "math"
            return true
    false

fn Builder.token(mut self, t Tok)
    skip := self.skip_lf
    self.skip_lf = false
    match t
        Tok.Chars(content) =>
            mut s := content.replace("\u{0}", "")
            if skip and s.starts_with("\n")
                s = s.slice(1)
            if s == ""
                return
            if not self.fragment and (self.ctx == C_AFTER_BODY or self.ctx == C_AFTER_AFTER)
                if all_space(s)
                    self.add_text(s)
                    return
                self.ctx = C_BODY
            if self.in_head and self.top() == HEAD_PART and not self.fragment
                cs := s.chars()
                mut j := 0
                while j < cs.len() and is_space_html(cs[j])
                    j += 1
                lead := cs.slice(0, j).join("")
                if lead != "" and self.ctx == C_HEAD
                    self.add_text(lead)
                elif lead != "" and self.ctx == C_AFTER_HEAD
                    self.html_insert(text_part(K_TEXT, lead), BODY_PART)
                s = cs.slice(j).join("")
                if s == ""
                    return
                self.to_body()
            self.add_text(s)
        Tok.Note(content) =>
            note := text_part(K_NOTE, content)
            if self.fragment or self.ctx == C_HEAD or self.ctx == C_BODY
                _ := self.append(note)
            elif self.ctx == C_BEFORE_HEAD
                self.html_insert(note, HEAD_PART)
            elif self.ctx == C_AFTER_HEAD
                self.html_insert(note, BODY_PART)
            elif self.ctx == C_AFTER_BODY
                k := self.parts.len()
                self.parts.push(note)
                self.parts[HTML_PART].kids.push(k)
        Tok.Doctype(name, ids) =>
            if self.ctx == C_INITIAL
                self.quirks = not (name == "html" and not ids)
        Tok.Start(name, attrs, closed) => self.start(name, attrs, closed)
        Tok.End(name) => self.end(name)

fn Builder.in_head_phase(self) bool
    self.ctx == C_HEAD or self.ctx == C_AFTER_HEAD

## The stack index of the open `select` when only `option` and `optgroup` stand above it, or -1.
fn Builder.select_idx(self) int
    mut i := self.stack.len() - 1
    while i > 0
        nm := self.name_at(i)
        if nm == "select"
            return i
        if nm != "option" and nm != "optgroup"
            return -1
        i -= 1
    -1

## A start tag (std.html.8-10).
fn Builder.start(mut self, tag str, attrs List[Attr], closed bool)
    if not self.fragment
        if tag == "html"
            if self.ctx == C_INITIAL
                self.ctx = C_BEFORE_HEAD
        elif tag == "head"
            if self.ctx == C_INITIAL or self.ctx == C_BEFORE_HEAD
                self.ctx = C_HEAD
        elif self.ctx == C_INITIAL or self.ctx == C_BEFORE_HEAD
            self.ctx = C_HEAD
        elif self.ctx == C_AFTER_BODY or self.ctx == C_AFTER_AFTER
            self.ctx = C_BODY
    if tag == "html"
        if not self.fragment
            self.merge_attrs(HTML_PART, attrs)
        return
    if tag == "head"
        return
    if tag == "body"
        if not self.fragment
            if self.in_head
                self.to_body()
            self.merge_attrs(BODY_PART, attrs)
        return
    if self.in_head and not HEAD_TAGS.contains(tag)
        self.to_body()
    name := if tag == "image" then "img" else tag
    sel := self.select_idx()
    if sel > 0
        if name == "select"
            self.pop_to(sel)
            return
        if name == "input" or name == "keygen" or name == "textarea"
            self.pop_to(sel)
        elif name != "option" and name != "optgroup" and name != "script" and name != "template"
            return
    if TABLE_PARTS.contains(name)
        self.table_part(name, attrs)
        return
    if name == "table"
        nm := self.top_name()
        if nm == "table" or SECTIONS.contains(nm) or nm == "tr" or nm == "colgroup"
            mut i := self.stack.len() - 1
            while i > 0
                if self.name_at(i) == "table"
                    self.pop_to(i)
                    break
                i -= 1
        elif not self.quirks
            self.close_p()
    elif name == "rb" or name == "rtc"
        while RUBY_ALL.contains(self.top_name())
            self.pop_one()
    elif name == "rt" or name == "rp"
        while RUBY_INNER.contains(self.top_name())
            self.pop_one()
    elif CLOSES_P.contains(name)
        if name == "li"
            self.close_item("li", "li")
        elif name == "dd" or name == "dt"
            self.close_item("dd", "dt")
        self.close_p()
        if HEADINGS.contains(name) and HEADINGS.contains(self.top_name())
            self.pop_one()
    elif name == "a" or name == "button"
        i := self.in_scope(name, IN_PLAIN)
        if i >= 0
            self.pop_to(i)
    elif name == "option"
        if self.top_name() == "option"
            self.pop_one()
    elif name == "optgroup"
        if self.top_name() == "option"
            self.pop_one()
        if self.top_name() == "optgroup"
            self.pop_one()
    mut ft := self.foster_idx()
    if ft > 0 and (name == "style" or name == "script")
        ft = -1
    elif ft > 0 and name == "input" and attr_of(attrs, "type").to_lower() == "hidden"
        ft = -1
    elif ft > 0 and name == "form"
        _ := self.append(elem_part(name, attrs))
        return
    if VOID.contains(name) or (closed and (name == "svg" or name == "math" or self.in_foreign()))
        k := self.parts.len()
        self.parts.push(elem_part(name, attrs))
        if ft > 0
            self.foster_insert(k, ft)
        else
            self.parts[self.top()].kids.push(k)
        return
    self.open(name, attrs, ft > 0)
    if name == "pre" or name == "listing" or name == "textarea"
        self.skip_lf = true

fn attr_of(attrs List[Attr], key str) str
    for a in attrs
        if a.name == key
            return a.value
    ""

## Closes an open list item `a` or `b` before a new one, unless a special element other than
## `address`, `div` and `p` stands between (std.html.8).
fn Builder.close_item(mut self, a str, b str)
    mut i := self.stack.len() - 1
    while i >= 0
        nm := self.name_at(i)
        if nm == a or nm == b
            self.pop_to(i)
            return
        if SPECIAL.contains(nm) and nm != "address" and nm != "div" and nm != "p"
            return
        i -= 1

## A table part opens inside the nearest open table, adding the `tbody` and `tr` it needs; with no
## open table it is ignored (std.html.9).
fn Builder.table_part(mut self, name str, attrs List[Attr])
    t := self.in_scope("table", IN_TABLE)
    if t < 0
        return
    if name == "caption" or name == "colgroup" or SECTIONS.contains(name)
        self.pop_to(t + 1)
        self.open(name, attrs, false)
        return
    if name == "col"
        if self.top_name() != "colgroup"
            self.pop_to(t + 1)
            self.open("colgroup", List[Attr](), false)
        _ := self.append(elem_part("col", attrs))
        return
    if name == "tr"
        while self.stack.len() > t + 1 and not SECTIONS.contains(self.top_name())
            self.pop_one()
        if self.top_name() == "table"
            self.open("tbody", List[Attr](), false)
        self.open("tr", attrs, false)
        return
    while self.stack.len() > t + 1 and not ROW_OR_SECTION.contains(self.top_name())
        self.pop_one()
    if self.top_name() == "table"
        self.open("tbody", List[Attr](), false)
    if SECTIONS.contains(self.top_name())
        self.open("tr", List[Attr](), false)
    self.open(name, attrs, false)

## An end tag (std.html.8-10).
fn Builder.end(mut self, name str)
    if not self.fragment
        if self.ctx == C_INITIAL or self.ctx == C_BEFORE_HEAD
            if name == "head" or name == "body" or name == "html" or name == "br"
                self.ctx = C_HEAD
            else
                self.ctx = C_BEFORE_HEAD
                return
        elif self.ctx == C_AFTER_BODY or self.ctx == C_AFTER_AFTER
            if name != "html" and name != "body"
                self.ctx = C_BODY
        if name == "head" and self.ctx == C_HEAD
            self.ctx = C_AFTER_HEAD
        elif name == "body" and self.ctx == C_BODY
            self.ctx = C_AFTER_BODY
        elif name == "html" and (self.ctx == C_BODY or self.ctx == C_AFTER_BODY)
            self.ctx = C_AFTER_AFTER
        elif (name == "html" or name == "body") and self.in_head_phase()
            self.to_body()
            self.ctx = if name == "html" then C_AFTER_AFTER else C_AFTER_BODY
    if name == "html" or name == "body" or name == "head"
        return
    if self.in_head and not HEAD_TAGS.contains(name)
        if name != "br"
            return
        self.to_body()
    if self.select_idx() > 0 and not SELECT_END.contains(name)
        return
    if name == "br"
        _ := self.append(elem_part("br", List[Attr]()))
        return
    if name == "p"
        at_p := self.in_scope("p", IN_BUTTON)
        if at_p < 0
            _ := self.append(elem_part("p", List[Attr]()))
        else
            self.pop_to(at_p)
        return
    mut i := -1
    if name == "li"
        i = self.in_scope("li", IN_LIST)
    elif HEADINGS.contains(name)
        i = self.in_scope("h*", IN_PLAIN)
    elif name == "table" or TABLE_PARTS.contains(name)
        i = self.in_scope(name, IN_TABLE)
    elif SPECIAL.contains(name)
        i = self.in_scope(name, IN_PLAIN)
    else
        mut j := self.stack.len() - 1
        while j >= 0
            nm := self.name_at(j)
            if nm == name
                i = j
                break
            if SPECIAL.contains(nm)
                break
            j -= 1
    if i >= 0
        self.pop_to(i)

fn Builder.build(self, k int) Node
    p := self.parts[k]
    if p.kind == K_TEXT
        return Node.Text(content: p.data)
    if p.kind == K_NOTE
        return Node.Comment(content: p.data)
    mut kids := List[Node]()
    for j in p.kids
        kids.push(self.build(j))
    Node.Elem(tag: p.name, attrs: p.attrs, kids: kids)

fn build_tree(src str, fragment bool) Node
    mut b := new_builder(fragment)
    for t in tokenize(src)
        b.token(t)
    b.build(0)

## The `html` element of `text`, which always holds `head` then `body` (std.html.1, std.html.10).
pub fn parse(text str) Node
    build_tree(text, false)

## The nodes of `text` read as the content of a `body`, with no `html`, `head` or `body` added
## (std.html.4).
pub fn parse_fragment(text str) List[Node]
    build_tree(text, true).children()

## An element built by hand (std.html.2).
pub fn elem(tag str, attrs List[Attr], kids List[Node]) Node
    Node.Elem(tag: tag, attrs: attrs, kids: kids)

## A text node built by hand (std.html.2).
pub fn text_node(content str) Node
    Node.Text(content: content)

## ---- node methods (std.html.3)

## Is this an element (std.html.3)?
pub fn Node.is_elem(self) bool
    match self
        Node.Elem(_, _, _) => true
        _ => false

fn is_text_node(n Node) bool
    match n
        Node.Text(_) => true
        _ => false

## The tag of an element, `""` for text and comments (std.html.3).
pub fn Node.name(self) str
    match self
        Node.Elem(tag, _, _) => tag
        _ => ""

## A text node's content, or every descendant text of an element joined in document order;
## comments give `""` (std.html.3).
pub fn Node.text(self) str
    match self
        Node.Text(content) => content
        Node.Comment(_) => ""
        Node.Elem(_, _, kids) =>
            mut out := List[str]()
            for k in kids
                out.push(k.text())
            out.join("")

## The value of attribute `key` (lower case), `none` when there is none (std.html.3).
pub fn Node.attr(self, key str) str?
    for a in self.attrs()
        if a.name == key
            return a.value
    none

## The attributes of an element in source order, none for text (std.html.3).
pub fn Node.attrs(self) List[Attr]
    match self
        Node.Elem(_, attrs, _) => attrs
        _ => List[Attr]()

## The children of an element: elements, text and comments (std.html.3).
pub fn Node.children(self) List[Node]
    match self
        Node.Elem(_, _, kids) => kids
        _ => List[Node]()

## The element children only (std.html.3).
pub fn Node.elements(self) List[Node]
    self.children().filter(|k| k.is_elem())

fn split_space(s str) List[str]
    mut out := List[str]()
    mut cur := List[char]()
    for c in s.chars()
        if is_space_html(c) or c == '\r'
            if cur.len() > 0
                out.push(cur.join(""))
                cur.clear()
        else
            cur.push(c)
    if cur.len() > 0
        out.push(cur.join(""))
    out

## Is `name` one of the space-separated words of the `class` attribute (std.html.3)?
pub fn Node.has_class(self, name str) bool
    v := self.attr("class") else return false
    split_space(v).contains(name)

## ---- selectors (std.html.12-14)

struct AttrTest
    key str
    op str
    want str

struct Compound
    tag str
    ids List[str]
    classes List[str]
    tests List[AttrTest]

## One compound and the combinator before it: "" for the first, " " or ">".
struct Step
    comb str
    part Compound

struct SelParser
    cs List[char]
    pos int

fn SelParser.peek(self) char?
    if self.pos >= self.cs.len()
        return none
    self.cs[self.pos]

fn SelParser.fail(self, kind SelectorKind, why str) SelectorError
    SelectorError(kind: kind, why: why, at: self.pos)

fn SelParser.skip_space(mut self)
    while self.pos < self.cs.len() and is_space_html(self.cs[self.pos])
        self.pos += 1

fn ident_char(c char) bool
    is_alnum_ascii(c) or c == '-' or c == '_' or c.code() >= 128

fn SelParser.ident(mut self, what str) str ! SelectorError
    start := self.pos
    while self.pos < self.cs.len() and ident_char(self.cs[self.pos])
        self.pos += 1
    if self.pos == start
        return self.fail(SelectorKind.Syntax, "expected {what}")
    self.cs[start..self.pos].join("")

## `[key]` or `[key op value]`; the cursor is past `[`.
fn SelParser.attr_test(mut self) AttrTest ! SelectorError
    self.skip_space()
    key := lower_word(self.ident("an attribute name")?)
    self.skip_space()
    c := self.peek() else return self.fail(SelectorKind.Syntax, "expected ']'")
    if c == ']'
        self.pos += 1
        return AttrTest(key: key, op: "", want: "")
    mut op := ""
    if c == '='
        op = "="
        self.pos += 1
    elif (c == '~' or c == '^' or c == '$' or c == '*' or c == '|')
        and self.pos + 1 < self.cs.len()
        and self.cs[self.pos + 1] == '='
        op = "{c}="
        self.pos += 2
    else
        return self.fail(SelectorKind.Syntax, "expected ']' or an operator")
    self.skip_space()
    mut want := ""
    q := self.peek() else return self.fail(SelectorKind.Syntax, "expected a value")
    if q == '"' or q == '\''
        self.pos += 1
        start := self.pos
        while self.pos < self.cs.len() and self.cs[self.pos] != q
            self.pos += 1
        if self.pos >= self.cs.len()
            self.pos = start - 1
            return self.fail(SelectorKind.Syntax, "unterminated string")
        want = self.cs[start..self.pos].join("")
        self.pos += 1
    else
        want = self.ident("a value")?
    self.skip_space()
    if self.peek() != ']'
        return self.fail(SelectorKind.Syntax, "expected ']'")
    self.pos += 1
    AttrTest(key: key, op: op, want: want)

fn SelParser.compound(mut self) Compound ! SelectorError
    mut part := Compound(tag: "", ids: List[str](), classes: List[str](), tests: List[AttrTest]())
    mut got := false
    if self.peek() == '*'
        self.pos += 1
        got = true
    elif c := self.peek()
        if ident_char(c)
            part.tag = lower_word(self.ident("a tag")?)
            got = true
    while c := self.peek()
        if c == '#'
            self.pos += 1
            part.ids.push(self.ident("an id")?)
        elif c == '.'
            self.pos += 1
            part.classes.push(self.ident("a class")?)
        elif c == '['
            self.pos += 1
            part.tests.push(self.attr_test()?)
        elif c == ':'
            return self.fail(SelectorKind.Unsupported, "pseudo-classes are not supported")
        else
            break
        got = true
    if not got
        return self.fail(SelectorKind.Syntax, "expected a selector")
    part

## A list of complex selectors separated by commas (std.html.12).
fn parse_selector(src str) List[List[Step]] ! SelectorError
    mut sp := SelParser(cs: src.chars(), pos: 0)
    mut groups := List[List[Step]]()
    sp.skip_space()
    if sp.peek() == none
        return sp.fail(SelectorKind.Empty, "empty selector")
    while true
        mut chain := List[Step]()
        mut comb := ""
        while true
            part := sp.compound()?
            chain.push(Step(comb: comb, part: part))
            before := sp.pos
            sp.skip_space()
            c := sp.peek() else break
            if c == ','
                break
            if c == '>'
                sp.pos += 1
                sp.skip_space()
                comb = ">"
            elif c == '+' or c == '~'
                return sp.fail(SelectorKind.Unsupported, "the combinator '{c}' is not supported")
            elif sp.pos > before
                comb = " "
            else
                return sp.fail(SelectorKind.Syntax, "unexpected '{c}'")
        groups.push(chain)
        if sp.peek() == none
            break
        sp.pos += 1
        sp.skip_space()
        if sp.peek() == none
            return sp.fail(SelectorKind.Syntax, "expected a selector after ','")
    groups

fn attr_matches(op str, have str, want str) bool
    if op == ""
        return true
    if op == "="
        return have == want
    if op == "~="
        return split_space(have).contains(want)
    if op == "^="
        return want != "" and have.starts_with(want)
    if op == "$="
        return want != "" and have.ends_with(want)
    if op == "*="
        return want != "" and have.contains(want)
    have == want or have.starts_with("{want}-")

fn compound_matches(part Compound, n Node) bool
    if part.tag != "" and n.name() != part.tag
        return false
    for id in part.ids
        if (n.attr("id") else "") != id
            return false
    for c in part.classes
        if not n.has_class(c)
            return false
    for t in part.tests
        have := n.attr(t.key) else return false
        if not attr_matches(t.op, have, t.want)
            return false
    true

## Does `chain[0..=k]` match with `chain[k]` at `n`, whose ancestors are `anc[0..d]`?
fn chain_matches(chain List[Step], k int, n Node, anc List[Node], d int) bool
    if not compound_matches(chain[k].part, n)
        return false
    if k == 0
        return true
    if chain[k].comb == ">"
        return d > 0 and chain_matches(chain, k - 1, anc[d - 1], anc, d - 1)
    mut j := d - 1
    while j >= 0
        if chain_matches(chain, k - 1, anc[j], anc, j)
            return true
        j -= 1
    false

fn collect(groups List[List[Step]], n Node, mut anc List[Node], mut out List[Node])
    for k in n.children()
        if not k.is_elem()
            continue
        for chain in groups
            if chain_matches(chain, chain.len() - 1, k, anc, anc.len())
                out.push(k)
                break
        anc.push(k)
        collect(groups, k, mut anc, mut out)
        _ := anc.pop()

## The elements below this node that match the CSS selector `sel`, in document order (std.html.12).
pub fn Node.select(self, sel str) List[Node] ! SelectorError
    groups := parse_selector(sel)?
    mut anc := [self]
    mut out := List[Node]()
    collect(groups, self, mut anc, mut out)
    out

## The first element `select` gives, `none` when there is none (std.html.12).
pub fn Node.select_one(self, sel str) Node? ! SelectorError
    found := self.select(sel)?
    found.first()

## ---- text (std.html.15)

struct TextOut
    out List[str]
    brk int
    space bool
    last str
    cell bool

fn TextOut.lit(mut self, s str)
    if self.brk > 0 and self.out.len() > 0
        self.out.push("\n".repeat(self.brk))
        self.last = "\n"
    elif self.space and self.out.len() > 0 and self.last != "\n" and self.last != "\t"
        self.out.push(" ")
    self.brk = 0
    self.space = false
    self.out.push(s)
    self.last = s.slice(s.len() - 1)

fn TextOut.block(mut self, n int)
    if n > self.brk
        self.brk = n
    self.space = false

fn walk_text(n Node, pre bool, mut o TextOut)
    match n
        Node.Comment(_) => return
        Node.Text(content) =>
            if pre
                if content != ""
                    o.lit(content)
                return
            for c in content.chars()
                if is_space_html(c) or c == '\r'
                    if o.brk == 0
                        o.space = true
                else
                    o.lit("{c}")
        Node.Elem(tag, _, kids) =>
            if TEXT_SKIP.contains(tag)
                return
            if tag == "br"
                o.lit("\n")
                return
            if (tag == "td" or tag == "th") and o.cell
                o.lit("\t")
            bl := if tag == "p" then 2 elif TEXT_BLOCK.contains(tag) then 1 else 0
            if bl > 0
                o.block(bl)
            inner := pre or PRE_TAGS.contains(tag)
            saved := o.cell
            o.cell = false
            for k in kids
                walk_text(k, inner, mut o)
                if k.name() == "td" or k.name() == "th"
                    o.cell = true
            o.cell = saved
            if bl > 0
                o.block(bl)

## The text a reader sees: whitespace collapsed, a line break around each block, a blank line
## around a `p`, a tab between table cells, `br` as a line break, `pre` as written, and no
## `head`, `script`, `style` or `template` (std.html.15).
pub fn to_text(node Node) str
    mut o := TextOut(out: List[str](), brk: 0, space: false, last: "", cell: false)
    walk_text(node, false, mut o)
    o.out.join("")

## ---- writing and escaping (std.html.16-17)

fn esc_text(s str) str
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

fn esc_value(s str) str
    esc_text(s).replace("\"", "&quot;")

fn emit(n Node, raw bool, mut out List[str])
    match n
        Node.Text(content) => out.push(if raw then content else esc_text(content))
        Node.Comment(content) => out.push("<!--{content}-->")
        Node.Elem(tag, attrs, kids) =>
            out.push("<{tag}")
            for a in attrs
                out.push(" {a.name}=\"{esc_value(a.value)}\"")
            out.push(">")
            if VOID.contains(tag)
                return
            inner := RAW_WRITE.contains(tag)
            for k in kids
                emit(k, inner, mut out)
            out.push("</{tag}>")

## `node` as HTML text: void elements with no end tag, every attribute quoted, text escaped
## except in `script` and `style` (std.html.16).
pub fn write(node Node) str
    mut out := List[str]()
    emit(node, false, mut out)
    out.join("")

## The nodes one after another, as `write` gives each (std.html.16).
pub fn write_all(nodes List[Node]) str
    mut out := List[str]()
    for n in nodes
        emit(n, false, mut out)
    out.join("")

## `s` with `&`, `<`, `>`, `"` and `'` as references, safe in text and in a quoted attribute
## value (std.html.17).
pub fn escape(s str) str
    esc_value(s).replace("'", "&#39;")

## `s` with every character reference resolved as in text (std.html.6, std.html.17).
pub fn unescape(s str) str
    mut lx := Lexer(cs: s.chars(), pos: 0, toks: List[Tok]())
    mut out := List[str]()
    while not lx.done()
        c := lx.cs[lx.pos]
        if c == '&'
            out.push(lx.char_ref(false))
        else
            out.push("{c}")
            lx.pos += 1
    out.join("")

## ---- sanitizing (std.html.18-20)

## The elements `policy()` keeps (std.html.18).
SAFE_TAGS := """
    a abbr b blockquote br caption cite code dd del div dl dt em figcaption figure h1 h2 h3 h4
    h5 h6 hr i img ins kbd li mark ol p pre q s small span strong sub sup table tbody td tfoot
    th thead tr u ul
    """
## The elements `policy()` removes with their content (std.html.18).
DROP_TAGS := """
    script style template iframe object embed frame frameset noscript noembed noframes xmp
    plaintext math svg head title meta link base textarea select option
    """

## The default policy: text formatting, lists, tables, links and images; `http`, `https` and
## `mailto` links (std.html.18).
pub fn policy() Policy
    Policy(
        tags: word_set(SAFE_TAGS),
        attrs: {
            "*": ["title", "lang", "dir"],
            "a": ["href"],
            "img": ["src", "alt", "width", "height"],
            "td": ["colspan", "rowspan"],
            "th": ["colspan", "rowspan"],
            "ol": ["start"],
        },
        schemes: word_set("http https mailto"),
        drop: word_set(DROP_TAGS),
    )

## Is the URL relative, or is its scheme allowed? Characters up to space are ignored and case
## does not count, as a browser reads it (std.html.19).
fn url_allowed(v str, schemes Set[str]) bool
    mut cs := List[char]()
    for c in v.chars()
        if c.code() > 32
            cs.push(lower_ascii(c))
    for i in 0..cs.len()
        c := cs[i]
        if c == '/' or c == '?' or c == '#'
            return true
        if c == ':'
            return schemes.contains(cs.slice(0, i).join(""))
    true

fn attr_allowed(tag str, a Attr, p Policy) bool
    if a.name.starts_with("on") or a.name == "srcset"
        return false
    every := p.attrs.get("*") else List[str]()
    own := p.attrs.get(tag) else List[str]()
    if not every.contains(a.name) and not own.contains(a.name)
        return false
    if URL_ATTRS.contains(a.name)
        return url_allowed(a.value, p.schemes)
    true

fn push_merged(mut out List[Node], k Node)
    if is_text_node(k) and out.len() > 0
        prev := out[out.len() - 1]
        if is_text_node(prev)
            out[out.len() - 1] = Node.Text(content: "{prev.text()}{k.text()}")
            return
    out.push(k)

fn clean(n Node, p Policy, mut out List[Node])
    match n
        Node.Comment(_) => return
        Node.Text(_) => push_merged(mut out, n)
        Node.Elem(tag, attrs, kids) =>
            if p.drop.contains(tag)
                return
            mut inner := List[Node]()
            for k in kids
                clean(k, p, mut inner)
            if not p.tags.contains(tag)
                for k in inner
                    push_merged(mut out, k)
                return
            kept := attrs.filter(|a| attr_allowed(tag, a, p))
            out.push(Node.Elem(tag: tag, attrs: kept, kids: inner))

## `text` read as a fragment and written back with only what `p` allows (std.html.19-20).
pub fn sanitize_with(text str, p Policy) str
    mut out := List[Node]()
    for n in parse_fragment(text)
        clean(n, p, mut out)
    write_all(out)

## `text` cleaned with `policy()` (std.html.18).
pub fn sanitize(text str) str
    sanitize_with(text, policy())
