## std.html (spec std.html.1-20, ADR 1272): HTML text read into a tree of `Node`s the way a browser
## reads it, searched with CSS selectors, turned into readable text, written back, and cleaned with
## an allowlist. Reading never fails: any text gives a tree (std.html.1). The tokenizer follows the
## WHATWG HTML tokenizer; the tree builder follows its "in body" rules, with the limits of
## std.html.11.

## An attribute of an element, in source order (std.html.2).
pub struct Attr
    pub name str
    pub value str

## An element, a run of text or a comment (std.html.2).
pub enum Node
    ## An element: its lower-case tag, its attributes and its children.
    Elem(tag str, attrs List[Attr], kids List[Node])
    ## Text with its character references resolved.
    Text(content str)
    ## A comment, without `<!--` and `-->`.
    Comment(content str)

## Why a selector is refused (std.html.14).
pub enum SelectorKind
    ## The selector holds nothing but spaces.
    Empty
    ## The selector is not valid CSS.
    Syntax
    ## Valid CSS that std.html does not match: a pseudo-class or the `+` and `~` combinators.
    Unsupported

## A selector `select` cannot use (std.html.14). `at` is the 0-based character where it stopped.
pub error struct SelectorError "{self.why} at {self.at}"
    pub kind SelectorKind
    pub why str
    pub at int

## What `sanitize_with` keeps (std.html.19). `tags` are kept, `drop` are removed with everything in
## them, any other element is replaced by its children. `attrs` maps a tag, or `"*"` for every kept
## tag, to the attributes it keeps. A URL attribute keeps a value with no scheme or one in
## `schemes`.
pub struct Policy
    pub tags Set[str]
    pub attrs Map[str, List[str]]
    pub schemes Set[str]
    pub drop Set[str]

## Open elements nest at most this deep; deeper start tags join the deepest one (std.html.11).
MAX_DEPTH := 512

K_ELEM := 0
K_TEXT := 1
K_NOTE := 2

IN_PLAIN := 0
IN_BUTTON := 1
IN_LIST := 2
IN_TABLE := 3

fn word_set(src str) Set[str]
    mut out := Set[str]()
    for w in src.words()
        out.add(w)
    out

fn entity_table(src str) Map[str, int]
    mut out := Map[str, int]()
    ws := src.words()
    mut i := 0
    while i + 1 < ws.len()
        v := ws[i + 1].to_int() else 0
        out[ws[i]] = v
        i += 2
    out

fn code_table(src str) Map[int, int]
    mut out := Map[int, int]()
    ws := src.words()
    mut i := 0
    while i + 1 < ws.len()
        k := ws[i].to_int() else 0
        v := ws[i + 1].to_int() else 0
        out[k] = v
        i += 2
    out

## Elements with no content and no end tag (std.html.8).
VOID_LIST := """
    area base basefont bgsound br col embed hr img input keygen link meta param source track wbr
    """
VOID := word_set(VOID_LIST)
## Elements whose content is text up to their end tag, with no references (std.html.7).
RAWTEXT := word_set("script style xmp iframe noembed noframes")
## Elements whose content is text up to their end tag, with references (std.html.7).
RCDATA := word_set("title textarea")
## The WHATWG "special" elements.
SPECIAL_LIST := """
    address applet area article aside dialog base basefont bgsound blockquote body br button caption
    center col colgroup dd details dir div dl dt embed fieldset figcaption figure footer form
    frame frameset h1 h2 h3 h4 h5 h6 head header hgroup hr html iframe img input keygen li link
    listing main marquee menu meta nav noembed noframes noscript object ol p param plaintext pre
    script search section select source style summary table tbody td template textarea tfoot th
    thead title tr track ul wbr xmp
    """
SPECIAL := word_set(SPECIAL_LIST)
## Start tags that close an open `p` (std.html.8).
CLOSES_P_LIST := """
    address article aside blockquote center details dialog dir div dl fieldset figcaption figure
    footer header hgroup main menu nav ol p search section summary ul h1 h2 h3 h4 h5 h6 pre
    listing form hr xmp plaintext dd dt li
    """
CLOSES_P := word_set(CLOSES_P_LIST)
HEADINGS := word_set("h1 h2 h3 h4 h5 h6")
## Elements that stay in `head` before the body starts (std.html.10).
HEAD_LIST := """
    base basefont bgsound link meta title style script noscript noframes template
    """
HEAD_TAGS := word_set(HEAD_LIST)
## Elements that bound the search for an open element.
SCOPE := word_set("applet caption html table td th marquee object template")
## Table parts, which only a table holds (std.html.9).
TABLE_PARTS := word_set("caption col colgroup tbody td tfoot th thead tr")
SECTIONS := word_set("tbody thead tfoot")
ROW_OR_SECTION := word_set("tr tbody thead tfoot")
## Ruby elements a new `rb` or `rtc` closes, and the ones a new `rt` or `rp` closes.
SELECT_END := word_set("select option optgroup script template")
RUBY_ALL := word_set("rb rt rtc rp")
RUBY_INNER := word_set("rb rt rp")
## Elements whose text `to_text` keeps as written (std.html.15).
PRE_TAGS := word_set("pre textarea listing plaintext")
## Elements whose text `write` gives as it is (std.html.16).
RAW_WRITE := word_set("script style xmp iframe noembed noframes plaintext")
## Elements `to_text` leaves out (std.html.15).
TEXT_SKIP := word_set("head script style template")
## Elements `to_text` puts on lines of their own (std.html.15).
TEXT_BLOCK_LIST := """
    address article aside blockquote body caption center dd details dialog dir div dl dt
    fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hgroup hr html li main menu
    nav ol p pre section summary table tbody tfoot thead tr ul
    """
TEXT_BLOCK := word_set(TEXT_BLOCK_LIST)
## Attributes that hold a URL (std.html.19).
URL_ATTRS := word_set("action background cite formaction href longdesc poster src")

## The named character references: the HTML 4 set, `apos`, and the upper-case legacy names
## (std.html.6).
