# ---------------------------------------------------------------- colour conversion

## The frame as RGBA bytes, 4 per pixel, rows top to bottom (std.vpx.6).
## Uses the frame's colour space: BT.709 when the stream says so, else
## BT.601, in studio range unless the stream says full range. Chroma is
## repeated for each pair of pixels.
pub fn Frame.rgba(self) bytes
    # coefficients in 1/16384: luma scale and offset, then V->R, U->G, V->G, U->B
    mut ky := 19077
    mut yo := 16
    mut vr := 26149
    mut ug := 6419
    mut vg := 13320
    mut ub := 33050
    if self.space == 2
        vr = 29372
        ug = 3494
        vg = 8731
        ub = 34610
    if self.full_range
        ky = 16384
        yo = 0
        vr = if self.space == 2 then 25802 else 22970
        ug = if self.space == 2 then 3069 else 5638
        vg = if self.space == 2 then 7669 else 11700
        ub = if self.space == 2 then 30402 else 29032
    cwid := self.cw()
    mut out := bytes.zeros(self.width * self.height * 4).to_list()
    mut o := 0
    for r in 0..self.height
        yrow := r * self.width
        crow := r.shr(1) * cwid
        for c in 0..self.width
            l := (self.y[yrow + c].to_int() - yo) * ky
            cu := self.u[crow + c.shr(1)].to_int() - 128
            cv := self.v[crow + c.shr(1)].to_int() - 128
            out[o] = clip8((l + vr * cv + 8192).shr(14)).to_u8()
            out[o + 1] = clip8((l - ug * cu - vg * cv + 8192).shr(14)).to_u8()
            out[o + 2] = clip8((l + ub * cu + 8192).shr(14)).to_u8()
            out[o + 3] = (255).to_u8()
            o += 4
    bytes.from_list(out)
