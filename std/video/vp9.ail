## A VP9 stream decoder (std.vpx.2). It keeps the reference frames, the
## probability contexts and the segmentation state between calls. All its
## fields are internal.
pub struct Decoder
    # tables, filled once
    kfp List[int]
    pareto List[int]
    scans List[int]
    nbrs List[int]
    dcq List[int]
    acq List[int]
    filt List[int]
    norm List[int]
    band8 List[int]
    log2t List[int]
    def_fc List[int]
    # the packet and its bool decoder
    buf List[u8]
    bd_pos int
    bd_end int
    bd_value int
    bd_count int
    bd_range int
    # frame pool: slot k holds Y, U and V of one frame at slot_size * k
    mem List[u8]
    slot_size int
    nslots int
    slot_w List[int]
    slot_h List[int]
    ref_map List[int]
    cur int
    # sizes of the current frame
    width int
    height int
    color_space int
    color_range int
    mi_cols int
    mi_rows int
    sb_cols int
    sb_rows int
    ystride int
    yrows int
    cstride int
    crows int
    ref_idx List[int]
    # probability contexts
    fc List[int]
    fcs List[int]
    counts List[int]
    # frame header
    frame_type int
    last_frame_type int
    intra_only int
    last_intra_only int
    show_frame int
    last_show int
    error_res int
    reset_ctx int
    intra bool
    refresh_ctx int
    parallel int
    ctx_idx int
    allow_hp int
    interp_filter int
    lf_level int
    sharpness int
    lf_delta_enabled int
    ref_deltas List[int]
    mode_deltas List[int]
    base_q int
    y_dc_delta int
    uv_dc_delta int
    uv_ac_delta int
    lossless bool
    seg_enabled int
    seg_update_map int
    seg_temporal int
    seg_abs int
    seg_feat List[int]
    seg_data List[int]
    seg_probs List[int]
    dq List[int]
    log2_tile_cols int
    log2_tile_rows int
    tx_mode int
    ref_mode int
    comp_fixed int
