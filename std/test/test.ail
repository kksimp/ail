## std.test (spec test.stub.1-6, ADR 1101): stubs for the file system, the clock, the
## network and the environment of ONE test run by `ail test`. A call is active until the test
## ends, and the next test starts with none. The runner gives each test a table file
## (`fs.temp_dir()` + `/.ail-stubs`); each function appends a line to it, and the runtime's
## `fs.read_text`, `fs.read_bytes`, `fs.exists`, `env.get`, `time.now_ms`, `time.mono_ns`, `time.sleep_ms` and
## `net.get`/`net.request` answer from it (compiler/rt/native/stub.ail). Outside `ail test`
## there is no table, and every function here fails with a message that says so.
use std.env as sysenv

## A field of a table line: `%` is `%25`, a newline `%0A` and a tab `%09`.
fn esc(s str) str
    s.replace("%", "%25").replace("\n", "%0A").replace("\t", "%09")

fn table() str
    "{fs.temp_dir()}/.ail-stubs"

fn write_line(p str, line str) bool
    fs.append_text(p, line) else return false
    true

fn put(kind str, a str, b str, c str)
    p := table()
    assert(fs.exists(p), "test.stub.1: stubs work only in a test run by `ail test`")
    ok := write_line(p, "{kind}\t{esc(a)}\t{esc(b)}\t{esc(c)}\n")
    assert(ok, "test.stub.1: can't write the stub table {p}")

## Whether `test.clock` has been called in this test.
fn clock_set() bool
    t := fs.read_text(table()) else ""
    "\n{t}".contains("\nC\t")

## Each file of `content` (path to text) reads as that text for `fs.read_text`, `fs.read_bytes`
## and `fs.exists` until the test ends; the path is compared as `eff.allow.3` compares paths, so
## `a.txt` and `./a.txt` are one file. Nothing is written to disk. A later call for the same path
## replaces the text.
pub fn files(content Map[str, str])
    for name in content.keys().sorted()
        assert(name != "", "test.stub.2: a stubbed file needs a path")
        put("F", name, content[name], "")

## Each pair of `vars` (name to value) is what `env.get(name)` returns until the test ends.
## Other variables are unchanged.
pub fn env(vars Map[str, str])
    for name in vars.keys().sorted()
        assert(name != "", "test.stub.3: a stubbed variable needs a name")
        put("E", name, vars[name], "")

## From here `time.now_ms()` (and `time.now()`) return `ms`, which stands still, `time.mono_ns()` is the same
## clock in nanoseconds, and `time.sleep_ms(n)` returns at once and moves the clock on by `n`.
pub fn clock(ms int)
    assert(ms >= 0, "test.stub.4: the clock starts at 0 or later")
    put("C", "{ms}", "", "")

## Moves the stubbed clock on by `ms`. `test.clock` comes first.
pub fn advance(ms int)
    assert(ms >= 0, "test.stub.4: the clock only moves forward")
    assert(clock_set(), "test.stub.4: call test.clock(ms) before test.advance")
    put("A", "{ms}", "", "")

## `net.get(url)` and the other calls of `std.net` for `METHOD URL` (for example
## `"GET https://api.example.com/items"`, the method in capitals, the URL as the program writes
## it) answer with `status` and `body` and no headers until the test ends, with no network and
## without `@needs(net)`. A request that matches no stub goes on as without stubs.
pub fn http(call str, status int, body str)
    parts := call.split(" ")
    assert(
        parts.len() == 2 and parts[0] != "" and parts[0] == parts[0].to_upper() and parts[1] != "",
        "test.stub.5: write the stub as \"METHOD URL\", for example \"GET https://example.com/x\"",
    )
    assert(status >= 100 and status <= 599, "test.stub.5: the status is 100 to 599")
    put("H", call, body, "{status}")

## ---- Temporary directories and golden files (test.temp.1-3, test.golden.1-4, ADR 1229) ----

## A new empty directory inside the test's own temporary directory (`fs.temp_dir()`), so the runner removes it
## with everything in it when the test ends (test.sandbox.1). Its name starts with `fixture-`.
pub fn temp_dir() str
    dir := fs.make_temp_dir("fixture-") else ""
    assert(dir != "", "test.temp.1: can't make a temporary directory in {fs.temp_dir()}")
    dir

## Whether `rel` is a plain relative path with no empty, `.` or `..` part and no backslash or drive letter.
fn plain_rel(rel str) bool
    if rel == "" or rel.starts_with("/") or rel.contains("\\") or rel.contains(":")
        return false
    for part in rel.split("/")
        if part == "" or part == "." or part == ".."
            return false
    true

## `dir` and the parent directories of `rel` under it, made as far as they are missing.
fn make_parents(dir str, rel str)
    parts := rel.split("/")
    mut at := dir
    for i in 0..parts.len() - 1
        at = "{at}/{parts[i]}"
        fs.make_dir(at) else err
            assert(false, "test.temp.2: can't make the directory {at}: {err}")

## A new temporary directory (`test.temp_dir`) holding each file of `content` (relative path to text), with the
## directories on the way made. Returns the directory. A path that is absolute, empty or has a `..` part is a failure
## of the test.
pub fn temp_files(content Map[str, str]) str
    dir := temp_dir()
    for rel in content.keys().sorted()
        assert(
            plain_rel(rel),
            "test.temp.2: a fixture path is relative, with no `..` part: \"{rel}\"",
        )
        make_parents(dir, rel)
        file := "{dir}/{rel}"
        fs.write_text(file, content[rel]) else err
            assert(false, "test.temp.2: can't write {file}: {err}")
    dir

## The directory of the test file, which `ail test` passes as `AIL_TEST_DIR`.
fn test_dir() str
    d := sysenv.get("AIL_TEST_DIR") else ""
    assert(d != "", "test.golden.1: golden files work only in a test run by `ail test`")
    d

## The first line where `want` and `got` differ, as `line N: expected "A", got "B"`.
fn first_difference(want str, got str) str
    a := want.split("\n")
    b := got.split("\n")
    mut n := 0
    while n < a.len() and n < b.len() and a[n] == b[n]
        n += 1
    left := if n < a.len() then "\"{a[n]}\"" else "the end"
    right := if n < b.len() then "\"{b[n]}\"" else "the end"
    "line {n + 1}: expected {left}, got {right}"

## Compares `actual` with the file `testdata/NAME.golden` beside the test file, byte for byte. A difference, or a
## missing file, fails the test and names the first differing line. With `AIL_UPDATE_GOLDEN=1` in the environment of
## `ail test` the file is written instead (and `testdata/` made), and the test passes. `name` is a plain file name
## (letters, digits, `_`, `-`, `.`; no `/`).
pub fn golden(name str, actual str)
    assert(
        name != "" and plain_rel(name) and not name.contains("/"),
        "test.golden.4: a golden name is a plain file name, not \"{name}\"",
    )
    dir := "{test_dir()}/testdata"
    file := "{dir}/{name}.golden"
    if (sysenv.get("AIL_UPDATE_GOLDEN") else "") == "1"
        fs.make_dir(dir) else err
            assert(false, "test.golden.2: can't make {dir}: {err}")
        fs.write_text(file, actual) else err
            assert(false, "test.golden.2: can't write {file}: {err}")
        return
    want := fs.read_text(file) else ""
    if not fs.exists(file)
        assert(
            false,
            "test.golden.3: no golden file {file}; run `AIL_UPDATE_GOLDEN=1 ail test` to write it",
        )
    assert(
        want == actual,
        "test.golden.3: output differs from {file}, {first_difference(want, actual)}; run `AIL_UPDATE_GOLDEN=1 ail test` to accept the new output",
    )
