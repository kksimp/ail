## std.term (spec std.term.1-12, ADR 1012 and ADR 1254): terminal control for text programs.
## std.term.9-12 (at the end) add colour that honours NO_COLOR, progress bars,
## spinners and the prompts `confirm`, `ask`, `choose` and `password`.
## The style and cursor helpers and `parse` are pure strings and values. `open`
## puts a terminal in raw mode on the alternate screen and `Term.poll` returns
## its key, mouse and resize events. The terminal comes from the C library's
## `tcgetattr`, `tcsetattr`, `cfmakeraw`, `poll`, `read` and `write` (on
## Windows, kernel32's console calls with virtual-terminal input and output,
## so the same sequences and `parse` apply), so no runtime piece is needed. The size is not read with `ioctl` (it is variadic,
## which `ffi.decl.3` leaves out): the terminal is asked for the cursor
## position after moving it to the far corner.
use std.mem
use std.time

extern c fn isatty(fd i32) i32
extern c fn tcgetattr(fd i32, t *u8) i32
extern c fn tcsetattr(fd i32, action i32, t *u8) i32
extern c fn cfmakeraw(t *u8)
extern c fn poll(fds *u8, n int, ms i32) i32
extern c fn read(fd i32, buf *u8, n int) int
extern c fn write(fd i32, buf *u8, n int) int

extern c "kernel32" fn GetStdHandle(n i32) int
extern c "kernel32" fn GetConsoleMode(h int, mode *u8) i32
extern c "kernel32" fn SetConsoleMode(h int, mode i32) i32
extern c "kernel32" fn SetConsoleOutputCP(cp i32) i32
extern c "kernel32" fn SetConsoleCP(cp i32) i32
extern c "kernel32" fn GetConsoleScreenBufferInfo(h int, info *u8) i32
extern c "kernel32" fn WaitForSingleObject(h int, ms i32) i32
extern c "kernel32" fn ReadFile(h int, buf *u8, n i32, got *u8, ov *u8) i32
extern c "kernel32" fn WriteFile(h int, buf *u8, n i32, put *u8, ov *u8) i32

## The escape byte that starts every control sequence.
ESC := "\u{1b}"

## Why the terminal could not be used (std.term.8).
pub error struct TermError "{self.why}"
    pub why str

## What the user did. `Key` follows `std.ui.7`; `Mouse` and `Scroll` follow
## `std.ui.10-11`, with `col` and `row` counted from 0; `Resize` is the new
## size in cells.
pub enum Event
    Key(key KeyCode, ctrl bool, alt bool, shift bool)
    Mouse(col int, row int, button MouseButton, kind MouseKind)
    Scroll(lines int)
    Resize(cols int, rows int)

## A key, as `ui.KeyCode` (std.ui.7, ADR 1068): the typed text, or a named key.
pub enum KeyCode
    Text(text str)
    Enter
    Tab
    Backspace
    Delete
    Insert
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown
    F(n int)

pub enum MouseButton
    Left
    Middle
    Right

pub enum MouseKind
    Down
    Up
    Drag

## The key named `name` as std.ui.7 names it: a named key, or the typed text.
pub fn key_code(name str) KeyCode
    match name
        "enter" => Enter
        "tab" => Tab
        "backspace" => Backspace
        "delete" => Delete
        "insert" => Insert
        "escape" => Escape
        "up" => Up
        "down" => Down
        "left" => Left
        "right" => Right
        "home" => Home
        "end" => End
        "pageup" => PageUp
        "pagedown" => PageDown
        _ =>
            if name.len() >= 2 and name.len() <= 3 and name.starts_with("f")
                if n := name.slice(1, name.len()).to_int()
                    if n >= 1 and n <= 12
                        return F(n)
            Text(name)

## The std.ui.7 name of `key`: its text, or `enter`, `pageup`, `f5` and so on.
pub fn KeyCode.name(self) str
    match self
        Text(t) => t
        Enter => "enter"
        Tab => "tab"
        Backspace => "backspace"
        Delete => "delete"
        Insert => "insert"
        Escape => "escape"
        Up => "up"
        Down => "down"
        Left => "left"
        Right => "right"
        Home => "home"
        End => "end"
        PageUp => "pageup"
        PageDown => "pagedown"
        F(n) => "f{n}"

## The typed text of `key`, or `none` for a named key.
pub fn KeyCode.text(self) str?
    match self
        Text(t) => t
        Enter | Tab | Backspace | Delete | Insert | Escape | Up | Down | Left | Right | Home | End | PageUp | PageDown | F => none

pub struct Size
    pub cols int
    pub rows int

fn byte(n int) int
    n.max(0).min(255)

## Text styles (std.term.1). Each result is a control sequence to print.
pub fn reset() str
    "{ESC}[0m"

pub fn bold() str
    "{ESC}[1m"

pub fn underline() str
    "{ESC}[4m"

pub fn reverse() str
    "{ESC}[7m"

## Foreground colour `n` of the 256-colour palette (0-15 the terminal's own).
pub fn fg(n int) str
    "{ESC}[38;5;{byte(n)}m"

pub fn bg(n int) str
    "{ESC}[48;5;{byte(n)}m"

## True-colour foreground and background, each channel 0 to 255.
pub fn rgb(r int, g int, b int) str
    "{ESC}[38;2;{byte(r)};{byte(g)};{byte(b)}m"

pub fn bg_rgb(r int, g int, b int) str
    "{ESC}[48;2;{byte(r)};{byte(g)};{byte(b)}m"

## Moves the cursor to cell (`col`, `row`), counted from 0 at the top left.
pub fn goto(col int, row int) str
    "{ESC}[{row.max(0) + 1};{col.max(0) + 1}H"

pub fn clear() str
    "{ESC}[2J"

pub fn clear_line() str
    "{ESC}[2K"

pub fn hide_cursor() str
    "{ESC}[?25l"

pub fn show_cursor() str
    "{ESC}[?25h"

pub fn enter_alt() str
    "{ESC}[?1049h"

pub fn leave_alt() str
    "{ESC}[?1049l"

fn skip()
    return

## The text of code point `n`, or "" when it is not a character.
fn chr(n int) str
    c := char.from_code(n) else return ""
    "{c}"

## Control, Alt and Shift from the modifier parameter `m` of a sequence
## (1 plus: Shift 1, Alt 2, Ctrl 4).
fn mods(m int)(bool, bool, bool)
    v := if m > 1 then m - 1 else 0
    (v.bit_and(4) != 0, v.bit_and(2) != 0, v.bit_and(1) != 0)

fn param_ints(ps str) List[int]
    mut out := List[int]()
    for p in ps.split(";")
        out.push(p.to_int() else 0)
    out

fn arrow_name(fin int) str
    if fin == 65
        return "up"
    if fin == 66
        return "down"
    if fin == 67
        return "right"
    if fin == 68
        return "left"
    if fin == 72
        return "home"
    if fin == 70
        return "end"
    ""

## F1 to F4 by their final byte P, Q, R and S.
fn pf_name(fin int) str
    if fin == 80
        return "f1"
    if fin == 81
        return "f2"
    if fin == 82
        return "f3"
    if fin == 83
        return "f4"
    ""

fn tilde_name(n int) str
    match n
        1 | 7 => "home"
        2 => "insert"
        3 => "delete"
        4 | 8 => "end"
        5 => "pageup"
        6 => "pagedown"
        11 => "f1"
        12 => "f2"
        13 => "f3"
        14 => "f4"
        15 => "f5"
        17 => "f6"
        18 => "f7"
        19 => "f8"
        20 => "f9"
        21 => "f10"
        23 => "f11"
        24 => "f12"
        _ => ""

## An SGR mouse report `b;x;y` (std.term.3): `down` is true for the `M` form.
fn mouse_event(ps str, down bool, mut out List[Event])
    v := param_ints(ps)
    if v.len() < 3
        return
    b := v[0]
    which := b.bit_and(3)
    if b.bit_and(64) != 0
        if which == 0
            out.push(Scroll(0 - 3))
        elif which == 1
            out.push(Scroll(3))
        return
    moving := b.bit_and(32) != 0
    if which == 3 and moving
        return
    mut button := MouseButton.Left
    if which == 1
        button = MouseButton.Middle
    elif which == 2
        button = MouseButton.Right
    mut kind := MouseKind.Up
    if moving
        kind = MouseKind.Drag
    elif down
        kind = MouseKind.Down
    out.push(Mouse(col: v[1] - 1, row: v[2] - 1, button: button, kind: kind))

## One sequence `ESC [ ps fin` (std.term.2).
fn csi_event(ps str, fin int, mut out List[Event])
    if ps.starts_with("<") and (fin == 77 or fin == 109)
        mouse_event(ps.slice(1, ps.len()), fin == 77, mut out)
        return
    v := param_ints(ps)
    m := if v.len() > 1 then v[1] else 1
    has_ctrl, has_alt, has_shift := mods(m)
    if fin == 82 and v.len() == 2 and v[0] != 1
        out.push(Resize(cols: v[1], rows: v[0]))
        return
    if fin == 90
        out.push(Key(KeyCode.Tab, ctrl: false, alt: false, shift: true))
        return
    mut name := arrow_name(fin)
    if name == "" and fin == 126
        name = tilde_name(v[0])
    if name == "" and fin >= 80 and fin <= 83
        name = pf_name(fin)
    if name != ""
        out.push(Key(key_code(name), ctrl: has_ctrl, alt: has_alt, shift: has_shift))

## One key that is not an escape sequence, starting at byte `i`; returns the
## bytes it used (std.term.2).
fn char_key(d List[int], i int, alt bool, mut out List[Event]) int
    c := d[i]
    if c == 13 or c == 10
        out.push(Key(KeyCode.Enter, ctrl: false, alt: alt, shift: false))
        return 1
    if c == 9
        out.push(Key(KeyCode.Tab, ctrl: false, alt: alt, shift: false))
        return 1
    if c == 8 or c == 127
        out.push(Key(KeyCode.Backspace, ctrl: false, alt: alt, shift: false))
        return 1
    if c == 0
        out.push(Key(KeyCode.Text(" "), ctrl: true, alt: alt, shift: false))
        return 1
    if c < 27
        out.push(Key(KeyCode.Text("{chr(c + 96)}"), ctrl: true, alt: alt, shift: false))
        return 1
    if c < 32
        out.push(Key(KeyCode.Text("{chr(c + 64)}"), ctrl: true, alt: alt, shift: false))
        return 1
    if c < 127
        out.push(Key(KeyCode.Text("{chr(c)}"), ctrl: false, alt: alt, shift: false))
        return 1
    mut n := 1
    mut mask := 0
    if c >= 240
        n = 4
        mask = 7
    elif c >= 224
        n = 3
        mask = 15
    elif c >= 192
        n = 2
        mask = 31
    if n == 1
        return 1
    if i + n > d.len()
        return d.len() - i
    mut cp := c.bit_and(mask)
    for k in 1..n
        cp = cp.shl(6).bit_or(d[i + k].bit_and(63))
    if cp <= 1114111 and (cp < 55296 or cp > 57343)
        out.push(Key(KeyCode.Text("{chr(cp)}"), ctrl: false, alt: alt, shift: false))
    n

## The escape sequence or Alt key starting at byte `i`; returns its length.
fn escape_at(d List[int], i int, mut out List[Event]) int
    if i + 1 >= d.len()
        out.push(Key(KeyCode.Escape, ctrl: false, alt: false, shift: false))
        return 1
    n := d[i + 1]
    if n == 91
        mut j := i + 2
        while j < d.len() and (d[j] < 64 or d[j] > 126)
            j += 1
        if j >= d.len()
            return d.len() - i
        mut ps := ""
        start := i + 2
        for k in start..j
            ps = "{ps}{chr(d[k])}"
        csi_event(ps, d[j], mut out)
        return j - i + 1
    if n == 79
        if i + 2 >= d.len()
            return d.len() - i
        f := d[i + 2]
        mut name := arrow_name(f)
        if name == ""
            name = pf_name(f)
        if name != ""
            out.push(Key(key_code(name), ctrl: false, alt: false, shift: false))
        return 3
    if n == 27
        out.push(Key(KeyCode.Escape, ctrl: false, alt: true, shift: false))
        return 2
    1 + char_key(d, i + 1, true, mut out)

fn parse_ints(d List[int]) List[Event]
    mut out := List[Event]()
    mut i := 0
    while i < d.len()
        if d[i] == 27
            i += escape_at(d, i, mut out)
        else
            i += char_key(d, i, false, mut out)
    out

## The events the bytes `data` (read from a terminal) stand for, in order
## (std.term.2-3). A sequence cut off at the end of `data` is dropped. A lone
## ESC is the `escape` key. The terminal's cursor-position reply `ESC [ row ;
## col R` is a `Resize` (an F3 with a modifier is `ESC [ 1 ; m R`, so a reply
## from row 1 is not told apart from it).
pub fn parse(data bytes) List[Event]
    mut d := List[int]()
    for i in 0..data.len()
        d.push(data[i].to_int())
    parse_ints(d)

fn is_windows() bool
    (env.get("OS") else "") == "Windows_NT"

fn win_in() int
    unsafe
        GetStdHandle((0 - 10).to_i32())

fn win_out() int
    unsafe
        GetStdHandle((0 - 11).to_i32())

## A 32-bit console mode word at `p`, as an int.
fn word_at(p *u8) int
    unsafe
        b0 := p.read().to_int()
        b1 := p.offset(1).read().to_int()
        b2 := p.offset(2).read().to_int()
        b3 := p.offset(3).read().to_int()
        b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

## Whether standard input and output are both a terminal (std.term.4).
pub fn is_tty() bool
    unsafe
        if is_windows()
            m := mem.alloc(8, 0.to_u8())
            ok := GetConsoleMode(win_in(), m) != 0 and GetConsoleMode(win_out(), m) != 0
            mem.free(m)
            return ok
        isatty(0) == 1 and isatty(1) == 1

## The visible window of the Windows console, in cells.
fn win_size() Size
    unsafe
        info := mem.alloc(32, 0.to_u8())
        mut cols := 80
        mut rows := 24
        if GetConsoleScreenBufferInfo(win_out(), info) != 0
            # srWindow is four 16-bit values at byte 10: left, top, right, bottom.
            left := info.offset(10).read().to_int() + info.offset(11).read().to_int() * 256
            top := info.offset(12).read().to_int() + info.offset(13).read().to_int() * 256
            right := info.offset(14).read().to_int() + info.offset(15).read().to_int() * 256
            bottom := info.offset(16).read().to_int() + info.offset(17).read().to_int() * 256
            cols = right - left + 1
            rows = bottom - top + 1
        mem.free(info)
        Size(cols: cols, rows: rows)

## Writes `s` to standard output at once, without waiting for a newline.
fn send(s str)
    unsafe
        p := mem.cstr(s)
        total := s.byte_len()
        mut off := 0
        put := mem.alloc(8, 0.to_u8())
        while off < total
            mut w := 0
            if is_windows()
                if WriteFile(win_out(), p.offset(off), (total - off).to_i32(), put, mem.null()) != 0
                    w = word_at(put)
            else
                w = write(1, p.offset(off), total - off)
            if w <= 0
                break
            off += w
        mem.free(put)
        mem.free(p)

## Whether standard input has bytes within `ms` milliseconds (negative: wait).
fn wait_input(ms int) bool
    unsafe
        if is_windows()
            wait := if ms < 0 then 0 - 1 else ms
            return WaitForSingleObject(win_in(), wait.to_i32()) == 0
        fds := mem.alloc(8, 0.to_u8())
        fds.offset(4).write(1.to_u8())
        n := poll(fds, 1, ms.to_i32())
        mem.free(fds)
        n > 0

fn read_chunk() List[int]
    mut out := List[int]()
    unsafe
        buf := mem.alloc(256, 0.to_u8())
        mut n := 0
        if is_windows()
            got := mem.alloc(8, 0.to_u8())
            if ReadFile(win_in(), buf, 256.to_i32(), got, mem.null()) != 0
                n = word_at(got)
            mem.free(got)
        else
            n = read(0, buf, 256)
        for i in 0..n
            out.push(buf.offset(i).read().to_int())
        mem.free(buf)
    out

## Moves the cursor to the far corner and asks where it is; the reply, a
## `Resize` to `parse`, is the terminal's size.
fn size_query() str
    "{ESC}7{ESC}[9999;9999H{ESC}[6n{ESC}8"

fn probe_size() Size
    if is_windows()
        return win_size()
    send(size_query())
    if wait_input(500)
        for ev in parse_ints(read_chunk())
            match ev
                Resize(c, r) => return Size(cols: c, rows: r)
                _ => skip()
    Size(cols: 80, rows: 24)

## How often `poll` asks the terminal for its size, in milliseconds.
CHECK_MS := 250

## An open terminal (std.term.5): raw mode, the alternate screen and a hidden
## cursor until `close`, which puts the terminal back. It is a plain value, so
## write `defer t.close()` right after `open`; closing twice does nothing.
pub struct Term
    saved *u8
    mouse bool
    active bool
    cols int
    rows int
    queue List[Event]
    asked int
    alt bool

## Puts the terminal in raw mode and on the alternate screen (std.term.5).
## `mouse` also asks for mouse events. Raw mode turns off output processing
## (end each line with `\r\n`) and signals (Ctrl-C is the key `c` with `ctrl`).
pub fn open(mouse bool) Term ! TermError
    open_with(mouse, true)

## `open`, with the alternate screen only when `alt` is true; the inline prompts
## (std.term.12) use it without, so the text above them stays on screen.
fn open_with(mouse bool, alt bool) Term ! TermError
    if not is_tty()
        return TermError(why: "std.term.5: standard input and output must be a terminal")
    unsafe
        if is_windows()
            return open_windows(mouse, alt)
        saved := mem.alloc(256, 0.to_u8())
        if tcgetattr(0, saved) != 0
            mem.free(saved)
            return TermError(why: "std.term.5: cannot read the terminal settings")
        raw := mem.alloc(256, 0.to_u8())
        for i in 0..256
            raw.offset(i).write(saved.offset(i).read())
        cfmakeraw(raw)
        if tcsetattr(0, 2, raw) != 0
            mem.free(raw)
            mem.free(saved)
            return TermError(why: "std.term.5: cannot set raw mode")
        mem.free(raw)
        enter := if alt then enter_alt() else ""
        send("{enter}{hide_cursor()}")
        if mouse
            send("{ESC}[?1000h{ESC}[?1002h{ESC}[?1006h")
        size := probe_size()
        Term(
            saved: saved,
            mouse: mouse,
            active: true,
            cols: size.cols,
            rows: size.rows,
            queue: [],
            asked: time.now_ms(),
            alt: alt,
        )

## Raw mode on the Windows console (std.term.5): input arrives as the same
## escape sequences as on Unix (virtual-terminal input), output is processed
## for them, and both code pages are UTF-8. `saved` holds the old input and
## output modes.
fn open_windows(mouse bool, alt bool) Term ! TermError
    unsafe
        saved := mem.alloc(8, 0.to_u8())
        if GetConsoleMode(win_in(), saved) == 0 or GetConsoleMode(win_out(), saved.offset(4)) == 0
            mem.free(saved)
            return TermError(why: "std.term.5: cannot read the console modes")
        # Input: virtual-terminal input (0x200) only, so no line input, echo or Ctrl-C.
        # Output: processed (1), virtual-terminal processing (4), no automatic return (8).
        if SetConsoleMode(win_in(), 512.to_i32()) == 0
            mem.free(saved)
            return TermError(why: "std.term.5: cannot set raw mode")
        if SetConsoleMode(win_out(), 13.to_i32()) == 0
            SetConsoleMode(win_in(), word_at(saved).to_i32())
            mem.free(saved)
            return TermError(why: "std.term.5: the console has no virtual-terminal output")
        SetConsoleOutputCP(65001.to_i32())
        SetConsoleCP(65001.to_i32())
        enter := if alt then enter_alt() else ""
        send("{enter}{hide_cursor()}")
        if mouse
            send("{ESC}[?1000h{ESC}[?1002h{ESC}[?1006h")
        size := win_size()
        Term(
            saved: saved,
            mouse: mouse,
            active: true,
            cols: size.cols,
            rows: size.rows,
            queue: [],
            asked: time.now_ms(),
            alt: alt,
        )

fn Term.restore(mut self)
    if not self.active
        return
    self.active = false
    if self.mouse
        send("{ESC}[?1006l{ESC}[?1002l{ESC}[?1000l")
    leave := if self.alt then leave_alt() else ""
    send("{reset()}{show_cursor()}{leave}")
    unsafe
        if is_windows()
            SetConsoleMode(win_in(), word_at(self.saved).to_i32())
            SetConsoleMode(win_out(), word_at(self.saved.offset(4)).to_i32())
        else
            tcsetattr(0, 2, self.saved)

## Puts the terminal back as `open` found it (std.term.5).
pub fn Term.close(mut self)
    self.restore()

## The terminal's size in cells as of the last `open` or `poll` (std.term.6).
pub fn Term.size(self) Size
    Size(cols: self.cols, rows: self.rows)

## Writes `s` to the terminal at once (std.term.7).
pub fn Term.write(self, s str)
    send(s)

## Waits up to `ms` milliseconds (negative: for ever) for the next event
## (std.term.6); `none` when none came, or when standard input has ended. A
## change of size is a `Resize` event, noticed within 250 ms while waiting.
pub fn Term.poll(mut self, ms int) Event?
    start := time.now_ms()
    while true
        if not self.queue.is_empty()
            first := self.queue[0]
            self.queue.remove_at(0)
            return first
        now := time.now_ms()
        if now - self.asked >= CHECK_MS
            if is_windows()
                sz := win_size()
                self.note_size(sz.cols, sz.rows)
            else
                send(size_query())
            self.asked = now
        mut left := CHECK_MS
        if ms >= 0
            left = ms - (now - start)
            if left <= 0
                return none
            if left > CHECK_MS
                left = CHECK_MS
        if wait_input(left)
            chunk := read_chunk()
            if chunk.is_empty()
                return none
            for ev in parse_ints(chunk)
                match ev
                    Resize(c, r) => self.note_size(c, r)
                    _ => self.queue.push(ev)
    none

fn Term.note_size(mut self, c int, r int)
    if c != self.cols or r != self.rows
        self.cols = c
        self.rows = r
        self.queue.push(Resize(cols: c, rows: r))

## Whether standard output alone is a terminal (a console, on Windows), which
## is what styled text and progress output need (std.term.9).
pub fn out_is_tty() bool
    unsafe
        if is_windows()
            m := mem.alloc(8, 0.to_u8())
            ok := GetConsoleMode(win_out(), m) != 0
            mem.free(m)
            return ok
        isatty(1) == 1

## Whether styled text and live progress are wanted on standard output
## (std.term.9): not when `NO_COLOR` is set and not empty, not when `TERM` is
## `dumb`, and only when standard output is a terminal, unless `FORCE_COLOR` is
## set to anything but `0`.
pub fn color_enabled() bool
    if (env.get("NO_COLOR") else "") != ""
        return false
    force := env.get("FORCE_COLOR") else ""
    if force != "" and force != "0"
        return true
    if (env.get("TERM") else "") == "dumb"
        return false
    out_is_tty()

## `s` wrapped in the sequence `seq` and a reset when `on` is true, else `s`.
pub fn paint_if(on bool, s str, seq str) str
    if on
        return "{seq}{s}{reset()}"
    s

## `s` in the style `seq` when `color_enabled()`, else plain (std.term.9).
pub fn paint(s str, seq str) str
    paint_if(color_enabled(), s, seq)

## Named colours (std.term.9): `s` in red, green, yellow, blue, magenta, cyan or
## gray, or strong (bold) or faint, when `color_enabled()`, else `s` unchanged.
pub fn red(s str) str
    paint(s, "{ESC}[31m")

pub fn green(s str) str
    paint(s, "{ESC}[32m")

pub fn yellow(s str) str
    paint(s, "{ESC}[33m")

pub fn blue(s str) str
    paint(s, "{ESC}[34m")

pub fn magenta(s str) str
    paint(s, "{ESC}[35m")

pub fn cyan(s str) str
    paint(s, "{ESC}[36m")

pub fn gray(s str) str
    paint(s, "{ESC}[90m")

pub fn strong(s str) str
    paint(s, "{ESC}[1m")

pub fn faint(s str) str
    paint(s, "{ESC}[2m")

## A bar of `width` cells (at least 1) filled in proportion to `done` of `total`:
## `[===>    ]`. `done` is held to 0 through `total`; a `total` of 0 or less is full
## (std.term.10).
pub fn bar(done int, total int, width int) str
    w := width.max(1)
    mut filled := w
    if total > 0
        filled = done.max(0).min(total) * w / total
    mut body := "=".repeat(filled)
    if filled > 0 and filled < w
        lead := "=".repeat(filled - 1)
        body = "{lead}>"
    gap := " ".repeat(w - filled)
    "[{body}{gap}]"

## One progress line, `label [===>   ]  40% 4/10` (std.term.10).
pub fn progress_text(label str, done int, total int, width int) str
    mut pct := 100
    mut shown := done.max(0)
    if total > 0
        shown = shown.min(total)
        pct = shown * 100 / total
    pct_text := "{pct}%".pad_left(4, ' ')
    "{label} {bar(done, total, width)} {pct_text} {shown}/{total.max(0)}"

## A progress bar on standard output (std.term.10). It redraws one line in
## place while standard output is a terminal and colour is not turned off (`live`)
## and writes nothing otherwise.
pub struct Progress
    pub label str
    pub total int
    pub done int
    pub width int
    live bool
    drawn bool

## A bar for `total` steps, 30 cells wide, drawn at once when live (std.term.10).
pub fn progress(label str, total int) Progress
    mut p := Progress(
        label: label,
        total: total,
        done: 0,
        width: 30,
        live: color_enabled(),
        drawn: false,
    )
    p.draw()
    p

fn Progress.draw(mut self)
    if not self.live
        return
    send("\r{clear_line()}{progress_text(self.label, self.done, self.total, self.width)}")
    self.drawn = true

## Sets the number of finished steps to `n` and redraws (std.term.10).
pub fn Progress.set(mut self, n int)
    self.done = n.max(0).min(self.total.max(0))
    self.draw()

## One more step finished (std.term.10).
pub fn Progress.inc(mut self)
    self.set(self.done + 1)

## Ends the bar with every step counted and moves to the next line; a second
## call does nothing (std.term.10).
pub fn Progress.finish(mut self)
    if not self.live or not self.drawn
        return
    self.done = self.total.max(0)
    self.draw()
    send("\r\n")
    self.drawn = false

## The frames of a spinner, one per `tick`.
SPIN_FRAMES := ["|", "/", "-", "\\"]

## A spinner with a label on standard output (std.term.11); like `Progress`, it
## shows only while standard output is a terminal and colour is not turned off.
pub struct Spinner
    pub label str
    frame int
    live bool

## A spinner with `label`, not yet shown (std.term.11).
pub fn spinner(label str) Spinner
    Spinner(label: label, frame: 0, live: color_enabled())

## Shows the next frame and the label in place of the last (std.term.11).
pub fn Spinner.tick(mut self)
    if not self.live
        return
    send("\r{clear_line()}{SPIN_FRAMES[self.frame % SPIN_FRAMES.len()]} {self.label}")
    self.frame += 1

## Clears the spinner's line; the caller prints any result (std.term.11).
pub fn Spinner.finish(mut self)
    if self.live
        send("\r{clear_line()}")

## `true` for yes, `false` for no, `default` for an empty
## answer and `none` for anything else (std.term.12). Case is ignored.
pub fn parse_yes(line str, default bool) bool?
    t := line.trim().to_lower()
    if t == ""
        return default
    if t == "y" or t == "yes"
        return true
    if t == "n" or t == "no"
        return false
    none

## The index of the option an answer names, by its number counted from 1 or by
## its text (case ignored), or `none` (std.term.12).
pub fn parse_choice(line str, options List[str]) int?
    t := line.trim()
    n := t.to_int() else 0
    if n >= 1 and n <= options.len()
        return n - 1
    for i in 0..options.len()
        if options[i].to_lower() == t.to_lower()
            return i
    none

## One key of a choose prompt: the new highlighted index and 0 to go on, 1 when
## chosen or 2 when cancelled (std.term.12). Up, `k` and Shift-Tab move up, Down,
## `j` and Tab move down, a digit from 1 to 9 chooses that option, Enter chooses
## the highlighted one, and Escape, `q` and Ctrl-C cancel.
fn choose_step(cur int, n int, ev Event)(int, int)
    match ev
        Key(k, ctrl, _, shift) =>
            if ctrl
                if k == Text("c")
                    return (cur, 2)
                return (cur, 0)
            if k == Up or k == Text("k") or (k == Tab and shift)
                return ((cur + n - 1) % n, 0)
            if k == Down or k == Text("j") or k == Tab
                return ((cur + 1) % n, 0)
            if k == Enter
                return (cur, 1)
            if k == Escape or k == Text("q")
                return (cur, 2)
            digit := k.name().to_int() else 0
            if digit >= 1 and digit <= 9 and digit <= n
                return (digit - 1, 1)
            (cur, 0)
        _ => (cur, 0)

## The lines of a choose prompt with `cur` highlighted, each ending `\r\n`. When
## `redraw` is true it first moves up over the lines of an earlier frame.
fn choose_frame(question str, options List[str], cur int, redraw bool, on bool) str
    mut s := ""
    if redraw
        s = "{ESC}[{options.len() + 1}A"
    s = "{s}\r{clear_line()}{question}\r\n"
    for i in 0..options.len()
        mut line := "  {options[i]}"
        if i == cur
            line = paint_if(on, "> {options[i]}", "{ESC}[7m")
        s = "{s}\r{clear_line()}{line}\r\n"
    s

## One key of a password prompt (std.term.12): 0 to go on, 1 when Enter ended
## the answer, 2 when it was cancelled with Escape, Ctrl-C or Ctrl-D. A typed
## character is added to `text` and Backspace takes the last one off.
fn password_step(mut text List[str], ev Event) int
    match ev
        Key(k, ctrl, _, _) =>
            if ctrl
                if k == Text("c") or k == Text("d")
                    return 2
                if k == Text("j") or k == Text("m")
                    return 1
                return 0
            if k == Enter
                return 1
            if k == Escape
                return 2
            if k == Backspace
                if not text.is_empty()
                    text.pop()
                return 0
            typed := k.text() else return 0
            text.push(typed)
            0
        _ => 0

## Asks a yes or no question and returns the answer (std.term.12). The question
## and `[Y/n]` or `[y/N]` (the capital is `default`) go to standard output; the
## answer is a line of standard input, so it works piped too. An answer that is
## not yes or no asks again; the end of input gives `default`.
pub fn confirm(question str, default bool) bool
    hint := if default then "[Y/n]" else "[y/N]"
    while true
        send("{question} {hint} ")
        line := io.read_line() else return default
        answer := parse_yes(line, default) else continue
        return answer
    return default

## Asks for a line of text and returns it trimmed (std.term.12); an empty
## answer or the end of input gives `default`.
pub fn ask(question str, default str) str
    mut shown := question
    if default != ""
        shown = "{question} ({default})"
    send("{shown}: ")
    line := io.read_line() else return default
    t := line.trim()
    if t == ""
        return default
    t

## Asks the user to choose one of `options` and returns its index, or `none`
## when cancelled, when the end of input comes, or when `options` is empty
## (std.term.12). On a terminal it shows the list with the first option
## highlighted: Up and Down (or `k` and `j`) move, Enter chooses, a digit chooses
## that option and Escape cancels. Elsewhere it lists the options with numbers
## and reads a line naming one, asking again for a line that names none.
pub fn choose(question str, options List[str]) int?
    if options.is_empty()
        return none
    if is_tty()
        return choose_tty(question, options)
    send("{question}\n")
    for i in 0..options.len()
        send("  {i + 1}) {options[i]}\n")
    while true
        send("> ")
        line := io.read_line() else return none
        choice := parse_choice(line, options) else continue
        return choice
    none

fn choose_tty(question str, options List[str]) int?
    mut t := open_with(false, false) else err
        send("{err.why}\n")
        return none
    defer t.close()
    on := color_enabled()
    mut cur := 0
    send(choose_frame(question, options, cur, false, on))
    while true
        if not wait_input(0 - 1)
            continue
        chunk := read_chunk()
        if chunk.is_empty()
            return none
        for ev in parse_ints(chunk)
            step := choose_step(cur, options.len(), ev)
            cur = step.0
            if step.1 == 1
                return cur
            if step.1 == 2
                return none
        send(choose_frame(question, options, cur, true, on))
    none

## Asks for a secret and returns it, or `none` when cancelled or when input ends
## (std.term.12). On a terminal nothing is echoed, and Backspace works; elsewhere
## it reads one line of standard input.
pub fn password(question str) str?
    if not is_tty()
        send("{question}: ")
        line := io.read_line() else return none
        return line
    mut t := open_with(false, false) else err
        send("{err.why}\n")
        return none
    defer t.close()
    send("{question}: ")
    mut text := List[str]()
    while true
        if not wait_input(0 - 1)
            continue
        chunk := read_chunk()
        if chunk.is_empty()
            return none
        for ev in parse_ints(chunk)
            state := password_step(mut text, ev)
            if state == 1
                send("\r\n")
                return text.join("")
            if state == 2
                send("\r\n")
                return none
    none
