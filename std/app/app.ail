## std.app (spec std.app.1-19, ADR 0838): an app is a struct that
## implements `App`. `view` returns a tree of `Node`s, `update` receives an
## `Event`. A host program draws the tree with native controls and sends events
## back over standard input and output as JSON lines (std.app.8-10). Without a
## host, `run` prints the tree as text and reads events from standard input,
## which is how a test or an agent drives an app without a window.

## One drawing step of a `Canvas`. Coordinates are in points, colors `0xRRGGBB`.
pub enum Op
    ## Text whose top-left corner is at `x`, `y`; `font` is `mono`, `sans`, `serif` or `web:` and the `id` of a `Font`.
    Str(
        x float,
        y float,
        text str,
        font str,
        size float,
        fg int,
        bold bool,
        italic bool,
        underline bool,
    )
    ## A filled rectangle.
    Fill(x float, y float, w float, h float, color int)
    ## A line of the given width.
    Stroke(x1 float, y1 float, x2 float, y2 float, color int, width float)
    ## An image from a URL or file path, scaled to the rectangle.
    Pic(x float, y float, w float, h float, src str)
    ## A bitmap of `pw` by `ph` pixels scaled to the rectangle. `data` is its
    ## `R, G, B, A` bytes in standard base64; the host keeps the image under
    ## `id`, so an empty `data` draws the image already sent under that `id`.
    Bitmap(x float, y float, w float, h float, id str, pw int, ph int, data str)
    ## A rectangle filled with opacity `alpha`, 0 to 1 (std.app.19).
    Shade(x float, y float, w float, h float, color int, alpha float)
    ## A rounded rectangle, anti-aliased (std.app.32). `r` is clamped to half
    ## the shorter side, so a circle is `r = w / 2`. `stroke` 0 fills; above 0
    ## it outlines with that width, centred on the edge. `alpha` is 0 to 1.
    Round(
        x float,
        y float,
        w float,
        h float,
        r float,
        color int,
        alpha float,
        stroke float,
    )
    ## A filled polygon through `points` (`x0, y0, x1, y1, ...`), non-zero
    ## winding, anti-aliased; fewer than 3 points draw nothing (std.app.32).
    Poly(points List[float], color int, alpha float)
    ## An open polyline through `points` with round caps and joins,
    ## anti-aliased; fewer than 2 points draw nothing (std.app.32).
    Line(points List[float], color int, width float)
    ## A web font: `data` is the bytes of a TrueType or OpenType file in
    ## standard base64. The host keeps the font under `id`; a `Str` whose
    ## `font` is `web:` followed by `id` is drawn in it (an empty `data` keeps
    ## the font already sent). Draws nothing itself.
    Font(id str, data str)
    ## Limits later steps to a rectangle, until the matching `Unclip`.
    Clip(x float, y float, w float, h float)
    Unclip

## A piece of the screen.
pub enum Node
    ## Static text.
    Label(text str)
    ## A push button; its `id` comes back in a `press` event.
    Button(id str, caption str)
    ## A one-line text field; changes come back as `edit` events.
    Field(id str, value str, hint str)
    ## A check box; a click comes back as a `toggle` event.
    Toggle(id str, caption str, on bool)
    ## Children from top to bottom.
    Column(kids List[Node])
    ## Children from left to right.
    Row(kids List[Node])
    ## Flexible empty space.
    Spacer
    ## A drawing surface of a size in points; it also sends `click`, `scroll`
    ## and `key` events with positions inside it.
    Canvas(id str, w float, h float, ops List[Op])

## The JSON of `Op` and `Node` is written out, not derived: a derived impl
## names the type `Node`, which a program's own `Node` would hide (std.app.7).
fn member(name str, value Json) JsonMember
    JsonMember(key: name, value: value)

fn tagged(kind str, rest List[JsonMember]) Json
    mut members := [member("kind", Json.Str(kind))]
    members.extend(rest)
    Json.Obj(members)

fn num(n float) Json
    Json.Num(n)

fn txt(s str) Json
    Json.Str(s)

impl ToJson for Op
    fn to_json(self) Json
        match self
            Str(x, y, s, font, size, fg, bold, italic, underline) =>
                tagged("Str", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("text", txt(s)),
                    member("font", txt(font)),
                    member("size", num(size)),
                    member("fg", Json.Num(fg.to_float())),
                    member("bold", Json.Bool(bold)),
                    member("italic", Json.Bool(italic)),
                    member("underline", Json.Bool(underline)),
                ])
            Fill(x, y, w, h, color) =>
                tagged("Fill", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("w", num(w)),
                    member("h", num(h)),
                    member("color", Json.Num(color.to_float())),
                ])
            Stroke(x1, y1, x2, y2, color, width) =>
                tagged("Stroke", [
                    member("x1", num(x1)),
                    member("y1", num(y1)),
                    member("x2", num(x2)),
                    member("y2", num(y2)),
                    member("color", Json.Num(color.to_float())),
                    member("width", num(width)),
                ])
            Pic(x, y, w, h, src) =>
                tagged("Pic", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("w", num(w)),
                    member("h", num(h)),
                    member("src", txt(src)),
                ])
            Bitmap(x, y, w, h, id, pw, ph, data) =>
                tagged("Bitmap", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("w", num(w)),
                    member("h", num(h)),
                    member("id", txt(id)),
                    member("pw", Json.Num(pw.to_float())),
                    member("ph", Json.Num(ph.to_float())),
                    member("data", txt(data)),
                ])
            Shade(x, y, w, h, color, alpha) =>
                tagged("Shade", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("w", num(w)),
                    member("h", num(h)),
                    member("color", Json.Num(color.to_float())),
                    member("alpha", num(alpha)),
                ])
            Round(x, y, w, h, r, color, alpha, stroke) =>
                tagged("Round", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("w", num(w)),
                    member("h", num(h)),
                    member("r", num(r)),
                    member("color", Json.Num(color.to_float())),
                    member("alpha", num(alpha)),
                    member("stroke", num(stroke)),
                ])
            Poly(points, color, alpha) =>
                tagged("Poly", [
                    member("points", Json.Arr([num(v) for v in points])),
                    member("color", Json.Num(color.to_float())),
                    member("alpha", num(alpha)),
                ])
            Line(points, color, width) =>
                tagged("Line", [
                    member("points", Json.Arr([num(v) for v in points])),
                    member("color", Json.Num(color.to_float())),
                    member("width", num(width)),
                ])
            Font(id, data) => tagged("Font", [member("id", txt(id)), member("data", txt(data))])
            Clip(x, y, w, h) =>
                tagged("Clip", [
                    member("x", num(x)),
                    member("y", num(y)),
                    member("w", num(w)),
                    member("h", num(h)),
                ])
            Unclip => tagged("Unclip", [])

impl ToJson for Node
    fn to_json(self) Json
        match self
            Label(s) => tagged("Label", [member("text", txt(s))])
            Button(id, caption) => tagged("Button", [
                member("id", txt(id)),
                member("caption", txt(caption)),
            ])
            Field(id, value, hint) => tagged("Field", [
                member("id", txt(id)),
                member("value", txt(value)),
                member("hint", txt(hint)),
            ])
            Toggle(id, caption, on) => tagged("Toggle", [
                member("id", txt(id)),
                member("caption", txt(caption)),
                member("on", Json.Bool(on)),
            ])
            Column(kids) => tagged("Column", [member("kids", Json.Arr([
                k.to_json()
                for k in kids
            ]))])
            Row(kids) => tagged("Row", [member("kids", Json.Arr([k.to_json() for k in kids]))])
            Spacer => tagged("Spacer", [])
            Canvas(id, w, h, ops) => tagged("Canvas", [
                member("id", txt(id)),
                member("w", num(w)),
                member("h", num(h)),
                member("ops", Json.Arr([o.to_json() for o in ops])),
            ])

## What happened. `kind` is `start`, `press`, `edit`, `submit`, `toggle`,
## `click`, `scroll`, `key`, `keyup` (key release, std.app.20), `resize`, `close`, `external` (std.app.14), `move`, `leave` (std.app.16), `popup` (std.app.18) or `appearance` (std.app.30; `text` is `dark` or `light`); the other
## fields are zero or empty when they don't apply.
pub struct Event
    pub kind str
    ## The control's id (`press`, `edit`, `submit`, `toggle`, and the canvas
    ## for `click`, `scroll` and `key`).
    pub id str
    ## The new text (`edit`), the key's name as std.ui names it (`key`), or
    ## the button (`click`: `left`, `right` or `other`).
    pub text str
    pub x float
    pub y float
    ## Scroll distance for `scroll`; the canvas size for `resize`.
    pub dx float
    pub dy float
    ## For `resize`: the canvas's monospace cell size in points.
    pub cell_w float
    pub cell_h float
    pub ctrl bool
    pub alt bool
    pub shift bool
    pub meta bool
    ## For `click`: 1, 2 or 3 (std.app.17); 0 for other kinds.
    pub clicks int
    ## For `start` and `resize` in edge mode (std.app.25): the room the
    ## host's window controls take at the window's top-left, in points.
    pub inset_left float
    pub inset_top float
    ## For `start` and `resize` (std.app.31): the main display's size in
    ## points and its scale, device pixels per point; `0` from a host that
    ## does not report them.
    pub screen_w float
    pub screen_h float
    pub scale float
    ## For `measured`: the font family the host used for each run, joined
    ## by commas; empty from a host that does not say (std.app.28).
    pub fonts str
    ## For `start` and `resize` in edge mode: the room the window controls
    ## take at the top-right, `0` when none are there (std.app.33).
    pub inset_right float
    ## For `start` and `resize` (std.app.34): the natural line height of `sans` at 13 points, `0` when the host does not say.
    pub sans_line float

## A run of text whose advance width the host measures (std.app.13); `font`
## is `mono`, `sans`, `serif`, `web:` and a `Font` id, or a CSS
## `font-family` list, which the host measures in its first installed
## family (std.app.28).
pub struct Measure
    pub text str
    pub font str
    pub size float
    pub bold bool
    pub italic bool

## A native menu the app asks for at a point of a canvas (std.app.18).
pub struct Popup
    pub id str
    pub x float
    pub y float
    pub items List[str]

## A native file or folder chooser the app asks for (std.app.22). `start` is
## the folder it opens in ("" for the host's choice).
pub struct Picker
    pub id str
    pub prompt str
    pub folders bool
    pub start str

## Progress of a long job (std.app.15): `total` is 0 when unknown.
pub struct Progress
    pub done int
    pub total int
    pub note str

## A `progress` event from `source`, for `Inbox.post` (std.app.15).
pub fn progress(source str, p Progress) Event
    external(source, "progress|{p.done}|{p.total}|{p.note}")

## The progress an event carries, or `none` for any other event (std.app.15).
pub fn progress_of(ev Event) Progress?
    if ev.kind != "external" or not ev.text.starts_with("progress|")
        return none
    parts := ev.text.split("|", 4)
    if parts.len() < 4
        return none
    done := parts[1].to_int()?
    total := parts[2].to_int()?
    Progress(done: done, total: total, note: parts[3])

## Why an app couldn't run (std.app.9): `no_host`, `start`, `version` or
## `host_exited`.
pub error struct AppError
    pub kind str
    pub message str

## Builders. A variant with two fields of one type can't be built by
## position (type.struct.7); these can.

## Static text.
pub fn label(s str) Node
    Label(s)

## Children from top to bottom.
pub fn column(kids List[Node]) Node
    Column(kids)

## Children from left to right.
pub fn row(kids List[Node]) Node
    Row(kids)

## A push button.
pub fn button(id str, caption str) Node
    Button(id: id, caption: caption)

## A one-line text field.
pub fn field(id str, value str, hint str) Node
    Field(id: id, value: value, hint: hint)

## A check box.
pub fn toggle(id str, caption str, on bool) Node
    Toggle(id: id, caption: caption, on: on)

## A drawing surface.
pub fn canvas(id str, w float, h float, ops List[Op]) Node
    Canvas(id: id, w: w, h: h, ops: ops)

## Plain monospace text of size 13 on a canvas.
pub fn draw_text(x float, y float, s str, fg int) Op
    Str(
        x: x,
        y: y,
        text: s,
        font: "mono",
        size: 13.0,
        fg: fg,
        bold: false,
        italic: false,
        underline: false,
    )

## A filled rectangle on a canvas.
pub fn draw_rect(x float, y float, w float, h float, color int) Op
    Fill(x: x, y: y, w: w, h: h, color: color)

## `R, G, B, A` bytes (each 0..=255) as the `data` of a `Bitmap`.
pub fn bitmap_data(rgba List[int]) str
    bytes.from_list([v.to_u8() for v in rgba]).base64()

## An event of `kind` with every other field zero or empty.
pub fn event(kind str) Event
    Event(
        kind: kind,
        id: "",
        text: "",
        x: 0.0,
        y: 0.0,
        dx: 0.0,
        dy: 0.0,
        cell_w: 0.0,
        cell_h: 0.0,
        clicks: 0,
        ctrl: false,
        alt: false,
        shift: false,
        meta: false,
        inset_left: 0.0,
        inset_top: 0.0,
        screen_w: 0.0,
        screen_h: 0.0,
        scale: 0.0,
        fonts: "",
        inset_right: 0.0,
        sans_line: 0.0,
    )

## The families of a CSS `font-family` list, in order, unquoted and trimmed
## (std.app.28); a plain host face (`mono`, `sans`, `serif`, `web:` and an
## id) is a list of one.
pub fn family_list(font str) List[str]
    mut out := List[str]()
    for part in font.split(",")
        mut f := part.trim()
        if f.len() >= 2 and (f.starts_with("\"") or f.starts_with("'"))
            f = f.slice(1, f.len() - 1).trim()
        if f != ""
            out.push(f)
    out

## The host face a `font-family` list falls back to when none of its
## families is installed (std.app.28): `serif` for `serif`, `mono` for
## `monospace` and `ui-monospace`, else `sans`.
pub fn generic_of(font str) str
    for f in family_list(font)
        low := f.to_lower()
        if low == "serif"
            return "serif"
        if low == "monospace" or low == "ui-monospace" or low == "mono"
            return "mono"
        if low == "sans-serif" or low == "system-ui" or low == "ui-sans-serif" or low == "sans"
            return "sans"
    "sans"

## A button press, for tests.
pub fn press(id str) Event
    mut e := event("press")
    e.id = id
    e

## A field edit, for tests.
pub fn edit(id str, value str) Event
    mut e := event("edit")
    e.id = id
    e.text = value
    e

## A key, for tests.
pub fn key(name str) Event
    mut e := event("key")
    e.text = name
    e

## Where tasks post events into a running app (std.app.14): `post` queues
## an `external` event that `update` handles in turn with the host's.
pub struct Inbox
    ch Channel[Event]

## Queues `ev`, whose `kind` is `external`, `id` names the source and `text`
## carries its data. Waits while the queue is full.
pub fn Inbox.post(self, ev Event)
    self.ch.send(ev)

## An `external` event from `source` with `data`, for `Inbox.post`.
pub fn external(source str, data str) Event
    mut e := event("external")
    e.id = source
    e.text = data
    e

pub trait App
    ## Called once before the first `update` of `run` with the inbox the
    ## app's own tasks post to (std.app.14).
    fn attach(mut self, inbox Inbox)
        return
    ## Changes the state for an event.
    fn update(mut self, ev Event)
    ## The screen for the current state.
    fn view(self) Node
    ## The window title.
    fn title(self) str
        "AIL"
    ## The id of the control to give the keyboard focus; the host acts when
    ## the value changes.
    fn focus(self) str
        ""
    ## Text runs whose widths the app wants measured in the host's fonts;
    ## empty when it has all it needs (std.app.13).
    fn measures(self) List[Measure]
        []
    ## The widths of `runs`, in points, as the host measured them.
    fn measured(mut self, runs List[Measure], widths List[float])
        return
    ## The tree an attached agent's screen model is built from (std.app.24).
    ## It is `view`, unless the app draws somewhere the tree doesn't show.
    fn shown(self) Node
        self.view()
    ## The font family the host used for each of `runs`, when it says
    ## (std.app.28); called after `measured`.
    fn fonts_used(mut self, runs List[Measure], used List[str])
        return
    ## Extra protocol lines for the host, sent after each `update` and
    ## cleared by this call (std.app.21).
    fn lines(mut self) List[str]
        []
    ## Whether the app wants `move` and `leave` events from canvases (std.app.16).
    fn hover(self) bool
        false
    ## Whether the app draws up to the window's top edge, with no title bar
    ## (std.app.25); the host then reports its window controls' insets.
    fn edge(self) bool
        false
    ## A native menu to show; the host answers with a `popup` event (std.app.18).
    fn popup(self) Popup?
        none
    ## A native chooser to show; the host answers `picked` (std.app.22).
    fn pick(self) Picker?
        none

fn indent(depth int) str
    "  ".repeat(depth)

## The tree as indented text: what the headless renderer prints.
pub fn outline(n Node) str
    lines := outline_lines(n, 0)
    lines.join("\n")

fn outline_lines(n Node, depth int) List[str]
    pad := indent(depth)
    match n
        Label(s) => ["{pad}\"{s}\""]
        Button(id, caption) => ["{pad}[{caption}] #{id}"]
        Field(id, value, hint) => ["{pad}<{value}> #{id} ({hint})"]
        Toggle(id, caption, on) => ["{pad}{if on then "[x]" else "[ ]"} {caption} #{id}"]
        Spacer => ["{pad}~"]
        Canvas(id, w, h, ops) =>
            mut out := ["{pad}canvas #{id} {w}x{h} ops={ops.len()}"]
            for op in ops
                out.push("{pad}  {op_text(op)}")
            out
        Column(kids) => group("{pad}column", kids, depth)
        Row(kids) => group("{pad}row", kids, depth)

fn group(head str, kids List[Node], depth int) List[str]
    mut out := [head]
    for k in kids
        out.extend(outline_lines(k, depth + 1))
    out

fn op_text(op Op) str
    match op
        Str(
            x,
            y,
            s,
            font,
            size,
            fg,
            bold,
            italic,
            underline,
        ) => "str {x},{y} \"{s}\" {font} {size} {fg.to_hex()}"
        Fill(x, y, w, h, color) => "fill {x},{y} {w}x{h} {color.to_hex()}"
        Stroke(x1, y1, x2, y2, color, width) => "stroke {x1},{y1} {x2},{y2} {width}"
        Pic(x, y, w, h, src) => "pic {x},{y} {w}x{h} {src}"
        Bitmap(x, y, w, h, id, pw, ph, _) => "bitmap {x},{y} {w}x{h} {id} {pw}x{ph}"
        Shade(x, y, w, h, color, alpha) => "shade {x},{y} {w}x{h} {color.to_hex()} {alpha}"
        Round(x, y, w, h, r, color, alpha, stroke) => "round {x},{y} {w}x{h} r{r} {color.to_hex()} {alpha} {stroke}"
        Poly(points, color, alpha) => "poly {points.len() / 2} {color.to_hex()} {alpha}"
        Line(points, color, width) => "line {points.len() / 2} {color.to_hex()} {width}"
        Font(id, data) => "font {id} {data.len()}"
        Clip(x, y, w, h) => "clip {x},{y} {w}x{h}"
        Unclip => "unclip"

## Feeds `ev` to `app` and returns the new outline: one step of a test.
pub fn step[T App](mut a T, ev Event) str
    a.update(ev)
    outline(a.view())

## The event a JSON object describes (std.app.8): members that are missing
## are zero or empty.
pub fn event_from_json(j Json) Event
    Event(
        kind: j.text("kind", ""),
        id: j.text("id", ""),
        text: j.text("text", ""),
        x: j.num("x") else 0.0,
        y: j.num("y") else 0.0,
        dx: j.num("dx") else 0.0,
        dy: j.num("dy") else 0.0,
        cell_w: j.num("cell_w") else 0.0,
        cell_h: j.num("cell_h") else 0.0,
        ctrl: j.flag("ctrl", false),
        alt: j.flag("alt", false),
        shift: j.flag("shift", false),
        meta: j.flag("meta", false),
        clicks: (j.num("clicks") else 0.0).to_int(),
        inset_left: j.num("inset_left") else 0.0,
        inset_top: j.num("inset_top") else 0.0,
        screen_w: j.num("screen_w") else 0.0,
        screen_h: j.num("screen_h") else 0.0,
        scale: j.num("scale") else 0.0,
        fonts: j.text("fonts", ""),
        inset_right: j.num("inset_right") else 0.0,
        sans_line: j.num("sans_line") else 0.0,
    )

## The message that shows `a` (std.app.7): its title, focus and view tree.
pub fn frame[T App](a T) str
    title := a.title().to_json().to_text()
    focus := a.focus().to_json().to_text()
    hov := if a.hover() then ",\"hover\":true" else ""
    edge := if a.edge() then ",\"edge\":true" else ""
    "\{\"v\":1,\"t\":\"view\",\"title\":{title},\"focus\":{focus}{hov}{edge},\"tree\":{a.view().to_json().to_text()}}"

## The line that puts `text` on the system clipboard (std.app.26), for
## `lines()`: a host that cannot write the clipboard ignores it.
pub fn clipboard(text str) str
    "\{\"v\":1,\"t\":\"clipboard\",\"text\":{text.to_json().to_text()}}"

## Feeds each event to `a` in order, with no host (std.app.11), and returns
## the outline after each one: a test of `update` and `view`.
pub fn script[T App](mut a T, events List[Event]) List[str]
    mut out := List[str]()
    for ev in events
        a.update(ev)
        out.push(outline(a.view()))
    out

## The host program (std.app.10): `AIL_APP_HOST`, else the one built under
## the toolchain's directory (`AIL_ROOT`).
pub fn host_path() str ! AppError
    if p := env.get("AIL_APP_HOST")
        return p
    root := env.get("AIL_ROOT") else return AppError(
        kind: "no_host",
        message: "set AIL_APP_HOST to the app host program",
    )
    p := "{root}/tools/app-host/macos/build/AIL App Host.app/Contents/MacOS/AILAppHost"
    w := "{root}/tools/app-host/windows/build/AILAppHost.exe"
    if fs.exists(w)
        return w
    if fs.exists(p)
        return p
    q := "{root}/tools/app-host/linux/build/ail-app-host"
    if not fs.exists(q)
        return AppError(
            kind: "no_host",
            message: "no host is built; run tools/app-host/macos/run.sh (macOS), tools/app-host/linux/run.sh (Linux) or tools/app-host/windows/run.ps1 (Windows)",
        )
    q

## Runs `a` in a window (std.app.6-10): starts the host, sends the view
## tree whenever it changes and passes each event to `update`, until the
## window closes. Fails when there is no host or the host exits early.
pub fn run[T App](mut a T) ! AppError
    run_host(mut a, host_path()?, [])?

## Runs `a` as `run` does with the host program `cmd` and its arguments
## (std.app.10); a test passes a host written in AIL. The host's standard
## error is copied to the program's when it exits.
pub fn run_host[T App](mut a T, cmd str, args List[str]) ! AppError
    run_with(mut a, cmd, args, new_inbox())?

## A new inbox for `run_with`: the program starts its tasks that post to it
## (a server loop, a timer) before the run and stops them after (std.app.14).
pub fn new_inbox() Inbox
    Inbox(ch: Channel[Event](64))

## Runs `a` as `run_host` does, with events from `inbox`, which the program
## made with `inbox()` and gave to its own tasks.
pub fn run_with[T App](mut a T, cmd str, args List[str], inbox Inbox) ! AppError
    mut c := proc.start(cmd, args) else err
        return AppError(kind: "start", message: "{err}")
    mut sent := frame(a)
    mut shown := a.popup()
    mut chosen := a.pick()
    c.stdin.send("{sent}\n")
    hello := c.out.recv() else return gone(move c)
    j := parse_json(hello) else return mismatch(move c, hello)
    if (j.num("v") else 0.0) != 1.0
        return mismatch(move c, hello)
    a.attach(inbox)
    g := TaskGroup()
    g.add(spawn pump(c.out, inbox))
    mut ev := event_from_json(j)
    mut queued := List[Event]()
    while true
        # std.app.8: a line that isn't an event is skipped.
        if ev.kind == "exited"
            return gone(move c)
        if ev.kind != ""
            a.update(ev)
        if ev.kind == "close"
            break
        # std.app.13: ask the host for the widths the app wants, a few rounds
        # at most; events that arrive meanwhile are handled afterwards.
        mut rounds := 0
        while rounds < 4
            want := a.measures()
            if want.len() == 0
                break
            c.stdin.send("{measure_line(want)}\n")
            mut widths := List[float]()
            mut used := List[str]()
            while true
                got := inbox.ch.recv() else return gone(move c)
                if got.kind == "exited"
                    return gone(move c)
                if got.kind == "measured"
                    widths = [w.to_float() else 0.0 for w in got.text.split(",")]
                    if got.fonts != ""
                        used = got.fonts.split(",")
                    break
                queued.push(got)
            if widths.len() != want.len()
                break
            a.measured(want, widths)
            # std.app.28: the families the host chose, when it says.
            if used.len() == want.len()
                a.fonts_used(want, used)
            rounds += 1
        # std.app.21: protocol lines the app asks to send as they are.
        for extra in a.lines()
            c.stdin.send("{extra}\n")
        # std.app.18: show a menu once per change of the app's request.
        want_menu := a.popup()
        if want_menu != shown
            if m := want_menu
                c.stdin.send("{popup_line(m)}\n")
            shown = want_menu
        # std.app.22: show a chooser once per change of the app's request.
        want_pick := a.pick()
        if want_pick != chosen
            if k := want_pick
                c.stdin.send("{pick_line(k)}\n")
            chosen = want_pick
        now := frame(a)
        if now != sent
            c.stdin.send("{now}\n")
            sent = now
        if queued.len() > 0
            ev = queued[0]
            queued = queued[1..]
        else
            ev = inbox.ch.recv() else return gone(move c)
    c.stdin.close()
    for line in c.err
        io.eprint(line)
    proc.wait(move c) else 0

## Reads the host's lines into `inbox` as events until it exits, then posts
## `exited` (std.app.14).
fn pump(out Channel[str], inbox Inbox)
    while true
        line := out.recv() else break
        inbox.post(event_from_json(parse_json(line) else Json.Null))
    inbox.post(event("exited"))

## The request for the widths of `runs` (std.app.13).
fn measure_line(runs List[Measure]) str
    items := [
        Json.Obj([
            member("text", txt(r.text)),
            member("font", txt(r.font)),
            member("size", num(r.size)),
            member("bold", Json.Bool(r.bold)),
            member("italic", Json.Bool(r.italic)),
        ])
        for r in runs
    ]
    "\{\"v\":1,\"t\":\"measure\",\"runs\":{Json.Arr(items).to_text()}}"

## The request for a native chooser (std.app.22).
fn pick_line(k Picker) str
    j := Json.Obj([
        member("v", num(1.0)),
        member("t", txt("pick")),
        member("id", txt(k.id)),
        member("prompt", txt(k.prompt)),
        member("folders", Json.Bool(k.folders)),
        member("start", txt(k.start)),
    ])
    j.to_text()

## The request for a native menu (std.app.18).
fn popup_line(p Popup) str
    j := Json.Obj([
        member("v", num(1.0)),
        member("t", txt("popup")),
        member("id", txt(p.id)),
        member("x", num(p.x)),
        member("y", num(p.y)),
        member("items", Json.Arr([txt(i) for i in p.items])),
    ])
    j.to_text()

fn gone(move c proc.Child) ! AppError
    status := proc.kill(move c)
    AppError(kind: "host_exited", message: "the app host exited with status {status}")

fn mismatch(move c proc.Child, line str) ! AppError
    proc.kill(move c)
    AppError(kind: "version", message: "the app host spoke another protocol: {line}")
