## std.bigint (spec std.bigint.1-10, ADR 0902, ADR 1124): integers of any size. A value is
## a sign and a magnitude of base-10^9 limbs, least significant first, with
## no zero limb at the top; zero has no limbs and is never negative.

## Why a text or an operation is refused (std.bigint.9).
pub error struct BigIntError "{self.why}"
    pub why str

## A big integer (std.bigint.1).
pub struct BigInt
    neg bool
    limbs List[int]

## Quotient and remainder of a division (std.bigint.5).
pub struct QuoRem
    pub quo BigInt
    pub rem BigInt

BASE := 1000000000

fn trim(limbs List[int]) List[int]
    mut out := limbs
    while out.len() > 0 and out[out.len() - 1] == 0
        out.pop()
    out

fn make(neg bool, limbs List[int]) BigInt
    t := trim(limbs)
    BigInt(neg: neg and t.len() > 0, limbs: t)

## The magnitude comparison: -1, 0 or 1.
fn cmp_mag(a List[int], b List[int]) int
    if a.len() != b.len()
        return if a.len() < b.len() then -1 else 1
    mut i := a.len() - 1
    while i >= 0
        if a[i] != b[i]
            return if a[i] < b[i] then -1 else 1
        i -= 1
    0

fn add_mag(a List[int], b List[int]) List[int]
    mut out := List[int]()
    mut carry := 0
    mut i := 0
    while i < a.len() or i < b.len() or carry > 0
        mut s := carry
        if i < a.len()
            s += a[i]
        if i < b.len()
            s += b[i]
        out.push(s % BASE)
        carry = s / BASE
        i += 1
    out

## `a - b` for `a >= b` in magnitude.
fn sub_mag(a List[int], b List[int]) List[int]
    mut out := List[int]()
    mut borrow := 0
    for i in 0..a.len()
        mut d := a[i] - borrow
        if i < b.len()
            d -= b[i]
        if d < 0
            d += BASE
            borrow = 1
        else
            borrow = 0
        out.push(d)
    trim(out)

fn mul_mag(a List[int], b List[int]) List[int]
    if a.len() == 0 or b.len() == 0
        return List[int]()
    mut res := List[int]()
    for _ in 0..(a.len() + b.len())
        res.push(0)
    for i in 0..a.len()
        mut carry := 0
        for j in 0..b.len()
            cur := res[i + j] + a[i] * b[j] + carry
            res[i + j] = cur % BASE
            carry = cur / BASE
        mut k := i + b.len()
        while carry > 0
            cur := res[k] + carry
            res[k] = cur % BASE
            carry = cur / BASE
            k += 1
    trim(res)

fn mul_small(a List[int], m int) List[int]
    mul_mag(a, trim([m]))

## Magnitude division: the quotient and remainder of `a` by `b` (b is not zero).
fn divmod_mag(a List[int], b List[int]) QuoRem
    mut quo := List[int]()
    mut rem := List[int]()
    mut i := a.len() - 1
    while i >= 0
        # rem = rem * BASE + a[i]
        mut shifted := [a[i]]
        for l in rem
            shifted.push(l)
        rem = trim(shifted)
        # The largest d in 0..BASE-1 with b * d <= rem, by bisection.
        mut lo := 0
        mut hi := BASE - 1
        while lo < hi
            mid := (lo + hi + 1) / 2
            if cmp_mag(mul_small(b, mid), rem) <= 0
                lo = mid
            else
                hi = mid - 1
        quo.push(lo)
        rem = sub_mag(rem, mul_small(b, lo))
        i -= 1
    quo.reverse()
    QuoRem(quo: make(false, quo), rem: make(false, rem))

## The big integer equal to `n` (std.bigint.2).
pub fn from_int(n int) BigInt
    # Work on -(n + 1) for a negative n, so the smallest int does not overflow.
    mut m := n
    if n < 0
        m = -(n + 1)
    mut limbs := List[int]()
    while m > 0
        limbs.push(m % BASE)
        m = m / BASE
    if n < 0
        return make(true, add_mag(limbs, [1]))
    make(false, limbs)

## The big integer written in `text`: decimal digits with an optional leading
## `-` or `+` (std.bigint.2).
pub fn parse(text str) BigInt ! BigIntError
    mut s := text
    mut neg := false
    if s.starts_with("-")
        neg = true
        s = s.slice(1, s.len())
    elif s.starts_with("+")
        s = s.slice(1, s.len())
    if s.len() == 0
        return BigIntError(why: "no digits")
    for c in s.chars()
        if not c.is_digit()
            return BigIntError(why: "invalid digit '{c}'")
    mut limbs := List[int]()
    mut end := s.len()
    while end > 0
        start := if end > 9 then end - 9 else 0
        limbs.push(s.slice(start, end).to_int() else 0)
        end = start
    make(neg, limbs)

## The decimal text (std.bigint.3).
pub fn BigInt.to_text(self) str
    if self.limbs.len() == 0
        return "0"
    mut out := "{self.limbs[self.limbs.len() - 1]}"
    mut i := self.limbs.len() - 2
    while i >= 0
        out = "{out}{"{self.limbs[i]}".pad_left(9, '0')}"
        i -= 1
    if self.neg
        return "-{out}"
    out

## The value as an `int`, or `none` when it does not fit (std.bigint.3).
pub fn BigInt.as_int(self) int?
    if self.limbs.len() > 3
        return none
    # 9223372036854775807 is the largest int; the smallest is its negation less one.
    limit := from_int(9223372036854775807)
    if self.neg
        if cmp_mag(self.limbs, add_mag(limit.limbs, [1])) > 0
            return none
        mut v := 0
        mut i := self.limbs.len() - 1
        while i >= 0
            v = v * BASE - self.limbs[i]
            i -= 1
        return v
    if cmp_mag(self.limbs, limit.limbs) > 0
        return none
    mut v := 0
    mut i := self.limbs.len() - 1
    while i >= 0
        v = v * BASE + self.limbs[i]
        i -= 1
    v

pub fn BigInt.is_zero(self) bool
    self.limbs.len() == 0

pub fn BigInt.is_negative(self) bool
    self.neg

## -1, 0 or 1 as `a` is less than, equal to or greater than `b`.
fn cmp_signed(a BigInt, b BigInt) int
    if a.neg != b.neg
        return if a.neg then -1 else 1
    c := cmp_mag(a.limbs, b.limbs)
    if a.neg
        return -c
    c

## Values compare by size, so `a < b` and `a.cmp(b)` work (std.bigint.4,
## trait.std.2); `==` is the automatic equality, exact because the form is
## normalized.
impl Ord for BigInt
    fn cmp(self, other BigInt) Ordering
        c := cmp_signed(self, other)
        if c < 0
            return Less
        if c > 0
            return Greater
        Equal

## The text form is the decimal text, so `print(b)` and `"{b}"` show the
## number (std.bigint.3, trait.std.3).
impl ToStr for BigInt
    fn to_str(self) str
        self.to_text()

pub fn BigInt.negate(self) BigInt
    make(not self.neg, self.limbs)

pub fn BigInt.abs(self) BigInt
    make(false, self.limbs)

## `a + b`, `a - b`, `a * b` and `-a` (std.bigint.4, std.bigint.10,
## trait.op.1); `a.add(b)` and the other method forms work too.
impl Add for BigInt
    fn add(self, other BigInt) BigInt
        if self.neg == other.neg
            return make(self.neg, add_mag(self.limbs, other.limbs))
        c := cmp_mag(self.limbs, other.limbs)
        if c == 0
            return make(false, List[int]())
        if c > 0
            return make(self.neg, sub_mag(self.limbs, other.limbs))
        make(other.neg, sub_mag(other.limbs, self.limbs))

impl Sub for BigInt
    fn sub(self, other BigInt) BigInt
        self + other.negate()

impl Mul for BigInt
    fn mul(self, other BigInt) BigInt
        make(self.neg != other.neg, mul_mag(self.limbs, other.limbs))

impl Neg for BigInt
    fn neg(self) BigInt
        self.negate()

## `a / b` and `a % b` (std.bigint.10): `divmod`'s quotient and remainder.
## Dividing by zero traps, as it does for `int` (expr.arith.3); `divmod`
## returns the error instead.
impl Div for BigInt
    fn div(self, other BigInt) BigInt
        if other.is_zero()
            unreachable("std.bigint.10: division by zero: test `b.is_zero()` first, or use `a.divmod(b)`, which returns an error")
        divmod_signed(self, other).quo

impl Rem for BigInt
    fn rem(self, other BigInt) BigInt
        if other.is_zero()
            unreachable("std.bigint.10: remainder by zero: test `b.is_zero()` first, or use `a.divmod(b)`, which returns an error")
        divmod_signed(self, other).rem

## `self / o` and `self % o`, truncated toward zero: the remainder has the
## sign of `self` (std.bigint.5). Dividing by zero is an error (std.bigint.9).
pub fn BigInt.divmod(self, o BigInt) QuoRem ! BigIntError
    if o.limbs.len() == 0
        return BigIntError(why: "division by zero")
    divmod_signed(self, o)

## `divmod` for a divisor that is not zero.
fn divmod_signed(a BigInt, b BigInt) QuoRem
    r := divmod_mag(a.limbs, b.limbs)
    QuoRem(quo: make(a.neg != b.neg, r.quo.limbs), rem: make(a.neg, r.rem.limbs))

## `self` to the power `n`, for `n >= 0` (std.bigint.6).
pub fn BigInt.pow(self, n int) BigInt ! BigIntError
    if n < 0
        return BigIntError(why: "negative exponent")
    mut result := from_int(1)
    mut base := self
    mut e := n
    while e > 0
        if e % 2 == 1
            result = result * base
        base = base * base
        e = e / 2
    result

## The product 1 * 2 * ... * n (std.bigint.7).
pub fn factorial(n int) BigInt ! BigIntError
    if n < 0
        return BigIntError(why: "negative factorial")
    mut r := from_int(1)
    for i in 2..(n + 1)
        r = r * from_int(i)
    r
