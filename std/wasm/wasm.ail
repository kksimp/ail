        0x5F => "f32.le"
        0x60 => "f32.ge"
        0x61 => "f64.eq"
        0x62 => "f64.ne"
        0x63 => "f64.lt"
        0x64 => "f64.gt"
        0x65 => "f64.le"
        0x66 => "f64.ge"
        0x67 => "i32.clz"
        0x68 => "i32.ctz"
        0x69 => "i32.popcnt"
        0x6A => "i32.add"
        0x6B => "i32.sub"
        0x6C => "i32.mul"
        0x6D => "i32.div_s"
        0x6E => "i32.div_u"
        0x6F => "i32.rem_s"
        0x70 => "i32.rem_u"
        0x71 => "i32.and"
        0x72 => "i32.or"
        0x73 => "i32.xor"
        0x74 => "i32.shl"
        0x75 => "i32.shr_s"
        0x76 => "i32.shr_u"
        0x77 => "i32.rotl"
        0x78 => "i32.rotr"
        0x79 => "i64.clz"
