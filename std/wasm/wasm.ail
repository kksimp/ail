        0x83 => "i64.and"
        0x84 => "i64.or"
        0x85 => "i64.xor"
        0x86 => "i64.shl"
        0x87 => "i64.shr_s"
        0x88 => "i64.shr_u"
        0x89 => "i64.rotl"
        0x8A => "i64.rotr"
        0x8B => "f32.abs"
        0x8C => "f32.neg"
        0x8D => "f32.ceil"
        0x8E => "f32.floor"
        0x8F => "f32.trunc"
        0x90 => "f32.nearest"
        0x91 => "f32.sqrt"
        0x92 => "f32.add"
        0x93 => "f32.sub"
        0x94 => "f32.mul"
        0x95 => "f32.div"
        0x96 => "f32.min"
        0x97 => "f32.max"
        0x98 => "f32.copysign"
        0x99 => "f64.abs"
