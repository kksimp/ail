        0x9F => "f64.sqrt"
        0xA0 => "f64.add"
        0xA1 => "f64.sub"
        0xA2 => "f64.mul"
        0xA3 => "f64.div"
        0xA4 => "f64.min"
        0xA5 => "f64.max"
