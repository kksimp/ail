## std.yaml (spec std.yaml.1-10, ADR 1090): the common subset of YAML 1.2 read
## into the `Json` value, so one set of accessors (`get`, `at`, `as_str`, ...)
## serves every config format. Maps are `Obj` with `Str` keys, lists are `Arr`,
## and a plain scalar is `Null`, `Bool`, `Num` or `Str` by the YAML 1.2 core
## rules (`yes`, `no`, `on` and `off` stay strings, std.yaml.3). What is outside
## the subset (anchors, aliases, tags, merge keys, several documents,
## multi-line plain or quoted scalars) is refused with a message that says what
## to write instead (std.yaml.7), never read wrongly. `write` is the inverse
## (std.yaml.11-14).

## Why the text is not YAML in the subset (std.yaml.10). `line` is 1-based.
pub error struct YamlError "{self.why} (line {self.line})"
    pub why str
    pub line int

struct YamlParser
    lines List[str]
    pos int

## The scanner for one value written on one line (or a joined flow collection).
struct Inline
    chars List[char]
    pos int
    line int
    depth int

## The YAML document `text` as a `Json` value (std.yaml.1). An empty document
## is `Null`.
pub fn parse(text str) Json ! YamlError
    mut clean := text.replace("\r\n", "\n")
    if clean.starts_with("\u{feff}")
        clean = clean.slice(1, clean.len())
    mut lines := clean.split("\n")
    if clean.ends_with("\n")
        lines = lines[0..lines.len() - 1]
    mut p := YamlParser(lines: lines, pos: 0)
    p.document()?

fn indent_of(s str) int
    mut n := 0
    for c in s.chars()
        if c == ' '
            n += 1
        else
            break
    n

## `s` without its trailing comment (`#` at the start or after a blank, outside
## quotes) and without trailing blanks.
fn strip_comment(s str) str
    cs := s.chars()
    mut quote := ' '
    mut i := 0
    mut cut := cs.len()
    while i < cs.len()
        c := cs[i]
        opens := i == 0 or " \t[\{,:".contains(cs[i - 1])
        if quote == '"'
            if c == '\\'
                i += 1
            elif c == '"'
                quote = ' '
        elif quote == '\''
            if c == '\'' and i + 1 < cs.len() and cs[i + 1] == '\''
                i += 1
            elif c == '\''
                quote = ' '
        elif (c == '"' or c == '\'') and opens
            quote = c
        elif c == '#' and (i == 0 or cs[i - 1] == ' ' or cs[i - 1] == '\t')
            cut = i
            break
        i += 1
    cs[0..cut].join("").trim_end()

## How many `[` and `{` are still open at the end of `s` (outside quotes).
fn flow_depth(s str) int
    cs := s.chars()
    mut quote := ' '
    mut depth := 0
    mut i := 0
    while i < cs.len()
        c := cs[i]
        opens := i == 0 or " \t[\{,:".contains(cs[i - 1])
        if quote == '"'
            if c == '\\'
                i += 1
            elif c == '"'
                quote = ' '
        elif quote == '\''
            if c == '\'' and i + 1 < cs.len() and cs[i + 1] == '\''
                i += 1
            elif c == '\''
                quote = ' '
        elif (c == '"' or c == '\'') and opens
            quote = c
        elif c == '[' or c == '{'
            depth += 1
        elif c == ']' or c == '}'
            depth -= 1
        i += 1
    depth

## The index of the `:` that ends the key of a `key: value` line, or -1 when
## `t` is not a mapping line. The colon must be followed by a blank or the end.
fn key_colon(t str) int
    cs := t.chars()
    if cs.len() == 0 or cs[0] == '[' or cs[0] == '{'
        return -1
    mut i := 0
    if cs[0] == '"' or cs[0] == '\''
        q := cs[0]
        i = 1
        while i < cs.len()
            if q == '"' and cs[i] == '\\'
                i += 2
                continue
            if cs[i] == q
                if q == '\'' and i + 1 < cs.len() and cs[i + 1] == '\''
                    i += 2
                    continue
                break
            i += 1
        i += 1
        while i < cs.len() and cs[i] == ' '
            i += 1
        if i < cs.len() and cs[i] == ':' and (i + 1 == cs.len() or cs[i + 1] == ' ' or cs[i + 1] == '\t')
            return i
        return -1
    while i < cs.len()
        if cs[i] == ':' and (i + 1 == cs.len() or cs[i + 1] == ' ' or cs[i + 1] == '\t')
            return i
        i += 1
    -1

fn is_seq_item(t str) bool
    t == "-" or t.starts_with("- ") or t.starts_with("-\t")

fn is_complex_key(t str) bool
    t == "?" or t.starts_with("? ") or t.starts_with("?\t")

## The refusal text for a scalar that starts an anchor, alias or tag, or "".
fn refusal(word str) str
    if word.starts_with("&")
        return "anchors (&name) are not supported: write the value out in full"
    if word.starts_with("*")
        return "aliases (*name) are not supported: write the value out in full"
    if word.starts_with("!")
        return "tags (!type) are not supported: the value's own form gives its type; quote text that must stay a string"
    ""

fn all_digits(s str) bool
    if s.len() == 0
        return false
    for c in s.chars()
        if not c.is_digit()
            return false
    true

fn is_float(w str) bool
    cs := w.chars()
    mut i := 0
    if i < cs.len() and (cs[i] == '-' or cs[i] == '+')
        i += 1
    mut digits := 0
    while i < cs.len() and cs[i].is_digit()
        i += 1
        digits += 1
    if i < cs.len() and cs[i] == '.'
        i += 1
        while i < cs.len() and cs[i].is_digit()
            i += 1
            digits += 1
    if digits == 0
        return false
    if i < cs.len() and (cs[i] == 'e' or cs[i] == 'E')
        i += 1
        if i < cs.len() and (cs[i] == '-' or cs[i] == '+')
            i += 1
        mut exp := 0
        while i < cs.len() and cs[i].is_digit()
            i += 1
            exp += 1
        if exp == 0
            return false
    i == cs.len()

## An unquoted scalar by the YAML 1.2 core schema (std.yaml.3).
fn resolve(w str) Json
    if w == "" or w == "~" or w == "null" or w == "Null" or w == "NULL"
        return Json.Null
    if w == "true" or w == "True" or w == "TRUE"
        return Json.Bool(true)
    zero := 0.0
    if w == ".inf" or w == ".Inf" or w == ".INF" or w == "+.inf" or w == "+.Inf" or w == "+.INF"
        return Json.Num(1.0 / zero)
    if w == "-.inf" or w == "-.Inf" or w == "-.INF"
        return Json.Num(-1.0 / zero)
    if w == ".nan" or w == ".NaN" or w == ".NAN"
        return Json.Num(zero / zero)
    if w == "false" or w == "False" or w == "FALSE"
        return Json.Bool(false)
    for pre in ["0x", "0o"]
        if w.starts_with(pre) and w.len() > 2
            base := if pre == "0x" then 16 else 8
            mut n := 0
            for d in w.slice(2, w.len()).chars()
                digit := d.to_digit(base) else return Json.Str(w)
                n = n * base + digit
            return Json.Num(n.to_float())
    neg := w.starts_with("-")
    body := if neg or w.starts_with("+") then w.slice(1, w.len()) else w
    if all_digits(body)
        n := body.to_int() else return Json.Num((body.to_float() else 0.0) * (if neg then -1.0 else 1.0))
        return Json.Num((if neg then -n else n).to_float())
    if is_float(w)
        mut fixed := body
        if fixed.starts_with(".")
            fixed = "0{fixed}"
        fixed = fixed.replace(".e", ".0e").replace(".E", ".0E")
        if fixed.ends_with(".")
            fixed = "{fixed}0"
        f := fixed.to_float() else return Json.Str(w)
        return Json.Num(if neg then -f else f)
    Json.Str(w)

fn YamlParser.fail(self, why str) YamlError
    YamlError(why: why, line: self.pos + 1)

fn YamlParser.at_end(self) bool
    self.pos >= self.lines.len()

## The comment-free, trimmed text of line `i`.
fn YamlParser.body(self, i int) str
    strip_comment(self.lines[i]).trim()

## Moves to the next line that holds content.
fn YamlParser.skip_blank_lines(mut self) !
    while self.pos < self.lines.len() and self.body(self.pos) == ""
        self.pos += 1
    if self.pos < self.lines.len()
        raw := self.lines[self.pos]
        k := indent_of(raw)
        if raw.char_at(k) == '\t'
            return self.fail("tabs cannot indent YAML: use spaces")

fn YamlParser.document(mut self) !Json
    self.skip_blank_lines()?
    if self.at_end()
        return Json.Null
    first := self.body(self.pos)
    if first.starts_with("%")
        return self.fail("directives (%YAML, %TAG) are not supported")
    if first == "..."
        self.pos += 1
        self.skip_blank_lines()?
        if self.at_end()
            return Json.Null
        return self.fail("several documents are not supported: parse one document at a time")
    if first == "---"
        self.pos += 1
        self.skip_blank_lines()?
        if self.at_end()
            return Json.Null
        nxt := self.body(self.pos)
        if nxt == "---" or nxt == "..." or nxt.starts_with("--- ") or nxt.starts_with("---\t")
            return self.fail("several documents are not supported: parse one document at a time")
    elif first.starts_with("--- ") or first.starts_with("---\t")
        return self.fail("start the content on the line after '---'")
    v := self.node(indent_of(self.lines[self.pos]))?
    self.skip_blank_lines()?
    if not self.at_end()
        rest := self.body(self.pos)
        if rest == "..."
            self.pos += 1
            self.skip_blank_lines()?
            if self.at_end()
                return v
        if rest == "---" or rest == "..." or rest.starts_with("--- ") or rest.starts_with("---\t")
            return self.fail("several documents are not supported: parse one document at a time")
        return self.fail("unexpected text at this indentation")
    v

## The block node that starts at the current line, indented by `ind`.
fn YamlParser.node(mut self, ind int) !Json
    t := self.body(self.pos)
    if is_seq_item(t)
        return self.seq(ind)
    if is_complex_key(t)
        return self.fail("complex keys (?) are not supported: use a quoted string key")
    if key_colon(t) >= 0
        return self.map(ind)
    start := self.pos + 1
    self.pos += 1
    self.inline_value(t, start, ind - 1, false)?

fn YamlParser.seq(mut self, ind int) !Json
    mut items := List[Json]()
    while true
        self.skip_blank_lines()?
        if self.at_end()
            break
        k := indent_of(self.lines[self.pos])
        if k < ind
            break
        if k > ind
            return self.fail("unexpected indentation")
        t := self.body(self.pos)
        if not is_seq_item(t)
            break
        rest := if t == "-" then "" else t.slice(1, t.len()).trim_start()
        start := self.pos + 1
        if t.starts_with("-\t") and rest != "" and (key_colon(rest) >= 0 or is_seq_item(rest))
            return self.fail("a tab cannot separate '-' from a nested collection: use a space")
        if rest != "" and (key_colon(rest) >= 0 or is_seq_item(rest))
            # `- key: v` and `- - x`: the item's content starts where the
            # dash's text ends, so blank the dash and read the line as a node.
            raw := self.lines[self.pos]
            pad := " ".repeat(ind + 1)
            self.lines[self.pos] = "{pad}{raw.slice(ind + 1, raw.len())}"
            items.push(self.node(indent_of(self.lines[self.pos]))?)
        else
            self.pos += 1
            items.push(self.inline_value(rest, start, ind, false)?)
    Json.Arr(items)

fn YamlParser.map(mut self, ind int) !Json
    mut members := List[JsonMember]()
    while true
        self.skip_blank_lines()?
        if self.at_end()
            break
        k := indent_of(self.lines[self.pos])
        if k < ind
            break
        t := self.body(self.pos)
        if k > ind
            return self.fail("unexpected indentation (a plain value cannot continue on the next line: use | or > for a text block, or quote it)")
        if t == "..." or t == "---"
            break
        if is_seq_item(t)
            return self.fail("expected 'key: value' but found a list item")
        if is_complex_key(t)
            return self.fail("complex keys (?) are not supported: use a quoted string key")
        c := key_colon(t)
        if c < 0
            return self.fail("expected 'key: value' (a key ends with ':' followed by a space or the end of the line)")
        start := self.pos + 1
        key := self.read_key(t.slice(0, c).trim_end(), start)?
        for m in members
            if m.key == key
                return self.fail("duplicate key '{key}'")
        rest := t.slice(c + 1, t.len()).trim_start()
        self.pos += 1
        v := self.inline_value(rest, start, ind, true)?
        members.push(JsonMember(key, v))
    Json.Obj(members)

fn YamlParser.read_key(self, s str, ln int) !str
    if s.starts_with("\"") or s.starts_with("'")
        mut inl := Inline(chars: s.chars(), pos: 0, line: ln, depth: 0)
        q := inl.quoted()?
        inl.finish()?
        return q
    m := refusal(s)
    if m != ""
        return self.fail(m)
    if s == "<<"
        return self.fail("merge keys (<<) are not supported: write the merged entries out in full")
    s

## The value after `key:` or `- ` (`text`, already without its comment). `pos`
## is the line after the one holding `text`; `parent` is the indent of the
## construct that owns the value.
fn YamlParser.inline_value(mut self, text str, start int, parent int, in_map bool) !Json
    if text == ""
        self.skip_blank_lines()?
        if self.at_end()
            return Json.Null
        k := indent_of(self.lines[self.pos])
        if k > parent
            return self.node(k)
        if in_map and k == parent and is_seq_item(self.body(self.pos))
            return self.seq(k)
        return Json.Null
    if text.starts_with("|") or text.starts_with(">")
        return self.block_scalar(text, parent, start)
    mut buf := text
    if text.starts_with("[") or text.starts_with("\{")
        while flow_depth(buf) > 0 and not self.at_end()
            nb := self.body(self.pos)
            if nb != "" and indent_of(self.lines[self.pos]) <= parent
                return self.fail("a flow collection must be indented more than its key")
            if nb == "---" or nb == "..." or nb.starts_with("--- ")
                return self.fail("document markers cannot sit inside a flow collection")
            buf = "{buf} {nb}"
            self.pos += 1
    mut inl := Inline(chars: buf.chars(), pos: 0, line: start, depth: 0)
    v := inl.value()?
    inl.finish()?
    v

## A `|` (literal) or `>` (folded) block (std.yaml.5). The lines after the
## header that are indented deeper than `parent` are the content.
fn YamlParser.block_scalar(mut self, header str, parent int, start int) !Json
    literal := header.starts_with("|")
    mut chomp := ' '
    for h in header.slice(1, header.len()).chars()
        if h == '-' or h == '+'
            chomp = h
        elif h.is_digit()
            return YamlError(
                why: "explicit indentation indicators are not supported: indent the block under its key",
                line: start,
            )
        else
            return YamlError(why: "unexpected text after '{header.slice(0, 1)}'", line: start)
    mut raw := List[str]()
    mut blk := -1
    mut lead := 0
    while self.pos < self.lines.len()
        l := self.lines[self.pos]
        k := indent_of(l)
        if k == l.len()
            # A line of spaces only: text when it reaches past the block's indent.
            if blk < 0
                lead = if l.len() > lead then l.len() else lead
                raw.push("")
            else
                raw.push(if l.len() > blk then l.slice(blk, l.len()) else "")
            self.pos += 1
            continue
        if blk < 0
            if k <= parent
                break
            if lead > k
                return YamlError(why: "a blank line is indented more than the first line of the block", line: self.pos + 1)
            blk = k
        if k < blk
            break
        raw.push(l.slice(blk, l.len()))
        self.pos += 1
    mut last := raw.len()
    while last > 0 and raw[last - 1] == ""
        last -= 1
    trailing := raw.len() - last
    mut out := ""
    if literal
        out = raw[0..last].join("\n")
    else
        mut parts := List[str]()
        mut normal := false
        mut blanks := 0
        for i in 0..last
            s := raw[i]
            if s == ""
                blanks += 1
                continue
            spaced := s.starts_with(" ") or s.starts_with("\t")
            if i == blanks
                parts.push("\n".repeat(blanks))
            elif normal and not spaced
                parts.push(if blanks == 0 then " " else "\n".repeat(blanks))
            else
                parts.push("\n".repeat(blanks + 1))
            parts.push(s)
            normal = not spaced
            blanks = 0
        out = parts.join("")
    if chomp == '-'
        return Json.Str(out)
    if chomp == '+'
        tail := "\n".repeat(if last > 0 then trailing + 1 else trailing)
        return Json.Str("{out}{tail}")
    if last > 0
        return Json.Str("{out}\n")
    Json.Str("")

fn Inline.fail(self, why str) YamlError
    YamlError(why: why, line: self.line)

fn Inline.at_end(self) bool
    self.pos >= self.chars.len()

fn Inline.peek(self) char?
    if self.at_end()
        return none
    self.chars[self.pos]

fn Inline.skip_blank(mut self)
    while not self.at_end() and (self.chars[self.pos] == ' ' or self.chars[self.pos] == '\t')
        self.pos += 1

## After a value on a block line nothing else may follow.
fn Inline.finish(mut self) !
    self.skip_blank()
    if not self.at_end()
        return self.fail("unexpected text after the value")

fn Inline.value(mut self) !Json
    self.skip_blank()
    c := self.peek() else return Json.Null
    if c == '"' or c == '\''
        return Json.Str(self.quoted()?)
    if c == '['
        return self.flow_seq()
    if c == '{'
        return self.flow_map()
    word := self.plain_text()?
    m := refusal(word)
    if m != ""
        return self.fail(m)
    if word != "" and "#%@`".contains(word.char_at(0))
        return self.fail("a plain value cannot start with '{word.char_at(0)}': quote it")
    if self.depth > 0 and (word == "-" or word == "?" or word == ":")
        return self.fail("a lone '{word}' in a flow collection must be quoted")
    if self.depth == 0 and (word.contains(": ") or word.ends_with(":"))
        return self.fail("a mapping cannot start on the same line as its key: put the inner map on its own indented lines or write it with braces")
    resolve(word)

## An unquoted scalar: to the end of the line, or in a flow collection to the
## next `,`, bracket or `: `.
fn Inline.plain_text(mut self) !str
    start := self.pos
    while not self.at_end()
        c := self.chars[self.pos]
        if self.depth > 0
            if c == ',' or c == ']' or c == '}' or c == '[' or c == '{'
                break
            if c == ':'
                and (self.pos + 1 >= self.chars.len() or " ,]}".contains(self.chars[self.pos + 1]))
                break
        self.pos += 1
    self.chars[start..self.pos].join("").trim()

fn Inline.quoted(mut self) !str
    c := self.peek() else return self.fail("expected a string")
    if c == '"'
        return self.double_quoted()
    self.single_quoted()

fn Inline.single_quoted(mut self) !str
    self.pos += 1
    mut out := List[char]()
    while true
        c := self.peek() else return self.fail("unterminated string (a quoted string must end on the line it starts, or use a | block)")
        self.pos += 1
        if c == '\''
            if self.peek() == '\''
                out.push('\'')
                self.pos += 1
            else
                break
        else
            out.push(c)
    out.join("")

fn Inline.double_quoted(mut self) !str
    self.pos += 1
    mut out := List[char]()
    while true
        c := self.peek() else return self.fail("unterminated string (a quoted string must end on the line it starts, or use a | block)")
        self.pos += 1
        if c == '"'
            break
        if c == '\\'
            out.push(self.escape()?)
        else
            out.push(c)
    out.join("")

## The escape after a backslash that `pos` has already passed (std.yaml.2).
fn Inline.escape(mut self) !char
    c := self.peek() else return self.fail("unterminated string")
    self.pos += 1
    match c
        '0' => '\u{0}'
        'a' => '\u{7}'
        'b' => '\u{8}'
        't' => '\t'
        'n' => '\n'
        'v' => '\u{b}'
        'f' => '\u{c}'
        'r' => '\r'
        'e' => '\u{1b}'
        ' ' => ' '
        '"' => '"'
        '/' => '/'
        '\\' => '\\'
        'x' => self.hex_char(2)?
        'u' => self.hex_char(4)?
        'U' => self.hex_char(8)?
        _ => return self.fail("invalid escape '\\{c}'")

fn Inline.hex_char(mut self, n int) !char
    stop := self.pos + n
    if stop > self.chars.len()
        return self.fail("invalid unicode escape")
    mut code := 0
    for d in self.chars[self.pos..stop]
        code = code * 16 + (d.to_digit(16) else return self.fail("invalid unicode escape"))
    self.pos = stop
    ch := char.from_code(code) else return self.fail("invalid unicode escape")
    ch

fn Inline.flow_seq(mut self) !Json
    self.pos += 1
    self.depth += 1
    mut items := List[Json]()
    while true
        self.skip_blank()
        c := self.peek() else return self.fail("unterminated '['")
        if c == ']'
            self.pos += 1
            break
        if c == ','
            return self.fail("empty entry before ','")
        items.push(self.value()?)
        self.skip_blank()
        d := self.peek() else return self.fail("unterminated '['")
        if d == ','
            self.pos += 1
        elif d == ']'
            self.pos += 1
            break
        else
            return self.fail("expected ',' or ']' in list")
    self.depth -= 1
    Json.Arr(items)

fn Inline.flow_map(mut self) !Json
    self.pos += 1
    self.depth += 1
    mut members := List[JsonMember]()
    while true
        self.skip_blank()
        c := self.peek() else return self.fail("unterminated '\{'")
        if c == '}'
            self.pos += 1
            break
        if c == ','
            return self.fail("empty entry before ','")
        mut key := ""
        if c == '"' or c == '\''
            key = self.quoted()?
        else
            key = self.plain_text()?
            bad := refusal(key)
            if bad != ""
                return self.fail(bad)
            if key == "<<"
                return self.fail("merge keys (<<) are not supported: write the merged entries out in full")
        for m in members
            if m.key == key
                return self.fail("duplicate key '{key}'")
        self.skip_blank()
        mut v := Json.Null
        if self.peek() == ':'
            self.pos += 1
            self.skip_blank()
            nxt := self.peek() else return self.fail("unterminated '\{'")
            if nxt != ',' and nxt != '}'
                v = self.value()?
        members.push(JsonMember(key, v))
        self.skip_blank()
        d := self.peek() else return self.fail("unterminated '\{'")
        if d == ','
            self.pos += 1
        elif d == '}'
            self.pos += 1
            break
        else
            return self.fail("expected ',' or '}' in map")
    self.depth -= 1
    Json.Obj(members)

## The YAML text of `j` in block style (std.yaml.11): maps as `key: value`
## lines, lists as `- item` lines, two spaces a level. A scalar document is one
## line. Empty collections are `{}` and `[]`.
pub fn write(j Json) str
    if not is_block(j)
        return "{flow_text(j)}\n"
    body := block_lines(j, 0).join("\n")
    "{body}\n"

## True for a map or list with members: the values written over several lines.
fn is_block(v Json) bool
    match v
        Json.Obj(ms) => ms.len() > 0
        Json.Arr(items) => items.len() > 0
        Json.Null | Json.Bool(_) | Json.Num(_) | Json.Str(_) => false

## The lines of the non-empty map or list `v`, `ind` spaces in.
fn block_lines(v Json, ind int) List[str]
    pad := " ".repeat(ind)
    mut out := List[str]()
    ms := v.as_obj() else List[JsonMember]()
    for m in ms
        k := key_text(m.key, false)
        if is_block(m.value)
            out.push("{pad}{k}:")
            for l in block_lines(m.value, ind + 2)
                out.push(l)
        else
            out.push("{pad}{k}: {flow_text(m.value)}")
    items := v.as_arr() else List[Json]()
    for item in items
        if is_map(item) and is_block(item)
            # `- key: v`: the map's first line starts after the dash.
            sub := block_lines(item, ind + 2)
            for i in 0..sub.len()
                if i == 0
                    rest := sub[0].slice(ind + 2, sub[0].len())
                    out.push("{pad}- {rest}")
                else
                    out.push(sub[i])
        else
            out.push("{pad}- {flow_text(item)}")
    out

fn is_map(v Json) bool
    match v
        Json.Obj(_) => true
        Json.Null | Json.Bool(_) | Json.Num(_) | Json.Str(_) | Json.Arr(_) => false

## A value on one line: scalars, and collections in `[...]` and `{...}`.
fn flow_text(v Json) str
    match v
        Json.Null => "null"
        Json.Bool(b) => if b then "true" else "false"
        Json.Num(f) => num_text(f)
        Json.Str(s) => scalar_text(s, false)
        Json.Arr(items) => flow_list_text(items)
        Json.Obj(ms) => flow_map_text(ms)

fn flow_list_text(items List[Json]) str
    mut parts := List[str]()
    for item in items
        parts.push(flow_nested(item))
    body := parts.join(", ")
    "[{body}]"

fn flow_map_text(ms List[JsonMember]) str
    if ms.len() == 0
        return "\{}"
    mut parts := List[str]()
    for m in ms
        parts.push("{key_text(m.key, true)}: {flow_nested(m.value)}")
    body := parts.join(", ")
    "\{{body}}"

## A value inside `[...]` or `{...}`: its text must not hold `,[]{}` unquoted.
fn flow_nested(v Json) str
    match v
        Json.Str(s) => scalar_text(s, true)
        Json.Null | Json.Bool(_) | Json.Num(_) | Json.Arr(_) | Json.Obj(_) => flow_text(v)

## A whole number below 1e15 is written without a fraction (std.yaml.13).
fn num_text(f float) str
    if f != f
        return ".nan"
    zero := 0.0
    if f == 1.0 / zero
        return ".inf"
    if f == -1.0 / zero
        return "-.inf"
    t := Json.Num(f).to_text()
    if t.contains('.') or t.contains('e') or t.contains('E') or t.len() < 16
        return t
    "{t}.0"

fn key_text(k str, flow bool) str
    scalar_text(k, flow)

## `s` as it is when reading it back gives the same string, else in `"..."`
## (std.yaml.12).
fn scalar_text(s str, flow bool) str
    if is_plain(s, flow)
        return s
    quoted(s)

fn is_plain(s str, flow bool) bool
    if s == "" or s != s.trim() or s == "<<"
        return false
    # YAML 1.1 readers take these as booleans; here they are strings (std.yaml.3).
    for word in ["yes", "no", "on", "off"]
        if s.to_lower() == word
            return false
    if "-?:,[]\{}#&*!|>'\"%@`.".contains(s.chars()[0])
        return false
    if s.contains(": ") or s.ends_with(":") or s.contains(" #")
        return false
    for c in s.chars()
        code := c.code()
        if code < 32 or code == 127
            return false
        if flow and (c == ',' or c == '[' or c == ']' or c == '\{' or c == '}')
            return false
    match resolve(s)
        Json.Str(_) => true
        Json.Null | Json.Bool(_) | Json.Num(_) | Json.Arr(_) | Json.Obj(_) => false

## A double-quoted string with `"`, `\` and control characters escaped.
fn quoted(s str) str
    mut buf := List[str]()
    for c in s.chars()
        code := c.code()
        if c == '"'
            buf.push("\\\"")
        elif c == '\\'
            buf.push("\\\\")
        elif c == '\n'
            buf.push("\\n")
        elif c == '\t'
            buf.push("\\t")
        elif c == '\r'
            buf.push("\\r")
        elif code < 32 or code == 127
            hex := code.to_hex().pad_left(4, '0')
            buf.push("\\u")
            buf.push(hex)
        else
            buf.push(c.to_str())
    dq := "\""
    body := buf.join("")
    "{dq}{body}{dq}"
