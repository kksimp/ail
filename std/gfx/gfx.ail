## std.gfx (spec std.gfx.1-5; ADR 0956): the headless half of the
## real-time frame loop. A game is a struct that implements `Game`; each
## frame it gets an `Input` snapshot and records draw commands into a
## `Frame`. `script` runs a game over scripted input with no window and
## returns each frame as text, so `ail test` covers a game. The window,
## vsync and surface come later (ADR 0957).

use std.app

## One draw command of a `Frame`. Coordinates are pixels from the top left,
## colors `0xRRGGBB`.
pub enum Cmd
    Clear(color int)
    Rect(x float, y float, w float, h float, color int)
    Line(x1 float, y1 float, x2 float, y2 float, color int)
    Text(x float, y float, text str, size float, color int)

## Draw commands for one frame, in order.
pub struct Frame
    pub w int
    pub h int
    pub cmds List[Cmd]

## What the player did, as of one frame (std.gfx.2). `pressed` and `released`
## hold the keys that changed since the previous frame; `down` holds every key
## held now. Keys are named as `std.ui.7` names them.
pub struct Input
    pub down List[str]
    pub pressed List[str]
    pub released List[str]
    pub text str
    pub x float
    pub y float
    pub buttons int
    pub wheel float
    pub pads List[Pad]

## One gamepad's state (std.gfx.11). `buttons` has a bit per held button (`pad_bit`),
## `pressed` and `released` the buttons that changed since the previous frame.
## Sticks run -1.0 to 1.0 (right and up are positive), triggers 0.0 to 1.0.
pub struct Pad
    pub buttons int
    pub pressed int
    pub released int
    pub lx float
    pub ly float
    pub rx float
    pub ry float
    pub lt float
    pub rt float

pub trait Game
    ## Advances the state by `dt` seconds with this frame's input.
    fn update(mut self, input Input, dt float)
    ## Records this frame's draw commands.
    fn draw(self, mut f Frame)

## An input with nothing held or typed.
pub fn idle() Input
    Input(
        down: [],
        pressed: [],
        released: [],
        text: "",
        x: 0.0,
        y: 0.0,
        buttons: 0,
        wheel: 0.0,
        pads: [],
    )

pub fn new_frame(w int, h int) Frame
    Frame(w: w, h: h, cmds: [])

pub fn clear(mut f Frame, color int)
    f.cmds.push(Cmd.Clear(color: color))

pub fn rect(mut f Frame, x float, y float, w float, h float, color int)
    f.cmds.push(Cmd.Rect(x: x, y: y, w: w, h: h, color: color))

pub fn line(mut f Frame, x1 float, y1 float, x2 float, y2 float, color int)
    f.cmds.push(Cmd.Line(x1: x1, y1: y1, x2: x2, y2: y2, color: color))

pub fn text(mut f Frame, x float, y float, s str, size float, color int)
    f.cmds.push(Cmd.Text(x: x, y: y, text: s, size: size, color: color))

## The host event for releasing `key` (std.gfx.3).
pub fn key_up(key str) app.Event
    mut e := app.event("keyup")
    e.text = key
    e

## A gamepad with nothing held and the sticks centred.
pub fn no_pad() Pad
    Pad(buttons: 0, pressed: 0, released: 0, lx: 0.0, ly: 0.0, rx: 0.0, ry: 0.0, lt: 0.0, rt: 0.0)

## The bit of button `name` (std.gfx.11): `a` 1, `b` 2, `x` 4, `y` 8, `lb` 16,
## `rb` 32, `back` 64, `start` 128, `l3` 256, `r3` 512, `up` 1024, `down` 2048,
## `left` 4096, `right` 8192; 0 for any other name.
pub fn pad_bit(name str) int
    names := [
        "a",
        "b",
        "x",
        "y",
        "lb",
        "rb",
        "back",
        "start",
        "l3",
        "r3",
        "up",
        "down",
        "left",
        "right",
    ]
    for k in 0..names.len()
        if names[k] == name
            return 1.shl(k)
    0

## Gamepad `n` (from 0); one that isn't connected is `no_pad()`.
pub fn pad(i Input, n int) Pad
    if n < 0 or n >= i.pads.len()
        return no_pad()
    i.pads[n]

## Whether `button` of gamepad `n` is held.
pub fn pad_down(i Input, n int, button str) bool
    pad(i, n).buttons.bit_and(pad_bit(button)) != 0

## Whether `button` of gamepad `n` went down this frame.
pub fn pad_pressed(i Input, n int, button str) bool
    pad(i, n).pressed.bit_and(pad_bit(button)) != 0

## Whether `button` of gamepad `n` went up this frame.
pub fn pad_released(i Input, n int, button str) bool
    pad(i, n).released.bit_and(pad_bit(button)) != 0

## The `pad` host event for gamepad `n` with state `buttons,lx,ly,rx,ry,lt,rt`;
## an empty `state` says it was disconnected (std.gfx.11).
pub fn pad_event(n int, state str) app.Event
    mut e := app.event("pad")
    e.id = "{n}"
    e.text = state
    e

fn pad_from(old Pad, state str) Pad
    if state == ""
        return no_pad()
    parts := state.split(",")
    if parts.len() != 7
        return old
    buttons := parts[0].to_int() else 0
    Pad(
        buttons: buttons,
        pressed: buttons.bit_and(old.buttons.bit_not()),
        released: old.buttons.bit_and(buttons.bit_not()),
        lx: parts[1].to_float() else 0.0,
        ly: parts[2].to_float() else 0.0,
        rx: parts[3].to_float() else 0.0,
        ry: parts[4].to_float() else 0.0,
        lt: parts[5].to_float() else 0.0,
        rt: parts[6].to_float() else 0.0,
    )

## Whether `key` is held (std.gfx.2).
pub fn down(i Input, key str) bool
    i.down.contains(key)

## Whether `key` went down this frame.
pub fn pressed(i Input, key str) bool
    i.pressed.contains(key)

## Whether `key` went up this frame: a key-up is a fact, not an event to miss.
pub fn released(i Input, key str) bool
    i.released.contains(key)

fn without(keys List[str], key str) List[str]
    mut out := List[str]()
    for k in keys
        if k != key
            out.push(k)
    out

## The next frame's input from the previous one and the host events since
## then: `key` presses a key (not its auto-repeats), `keyup` releases it,
## `click` and `move` set the pointer, `scroll` adds to the wheel (std.gfx.3).
pub fn next_input(prev Input, events List[app.Event]) Input
    mut held := prev.down
    mut went_down := List[str]()
    mut went_up := List[str]()
    mut typed := ""
    mut x := prev.x
    mut y := prev.y
    mut buttons := prev.buttons
    mut wheel := 0.0
    # A gamepad's changes last one frame: keep the buttons held, clear the rest.
    mut pads := List[Pad]()
    for old in prev.pads
        pads.push(Pad(
            buttons: old.buttons,
            pressed: 0,
            released: 0,
            lx: old.lx,
            ly: old.ly,
            rx: old.rx,
            ry: old.ry,
            lt: old.lt,
            rt: old.rt,
        ))
    for ev in events
        if ev.kind == "key"
            if not held.contains(ev.text)
                held.push(ev.text)
                went_down.push(ev.text)
            if ev.text.chars().len() == 1 and not ev.ctrl and not ev.meta
                typed = "{typed}{ev.text}"
        elif ev.kind == "keyup"
            if held.contains(ev.text)
                held = without(held, ev.text)
                went_up.push(ev.text)
        elif ev.kind == "click" or ev.kind == "move"
            x = ev.x
            y = ev.y
            if ev.kind == "click"
                buttons = 1
        elif ev.kind == "scroll"
            wheel = wheel + ev.dy
        elif ev.kind == "pad"
            n := ev.id.to_int() else -1
            if n >= 0 and n < 8
                while pads.len() <= n
                    pads.push(no_pad())
                pads[n] = pad_from(pads[n], ev.text)
    Input(
        down: held,
        pressed: went_down,
        released: went_up,
        text: typed,
        x: x,
        y: y,
        buttons: buttons,
        wheel: wheel,
        pads: pads,
    )

## One command as a line of text (std.gfx.4).
pub fn cmd_text(c Cmd) str
    match c
        Clear(color) => "clear {color}"
        Rect(x, y, w, h, color) => "rect {x},{y} {w}x{h} {color}"
        Line(x1, y1, x2, y2, color) => "line {x1},{y1} {x2},{y2} {color}"
        Text(x, y, s, size, color) => "text {x},{y} \"{s}\" {size} {color}"

## The frame as text, one command per line: how a test or an agent sees it.
pub fn dump(f Frame) str
    mut lines := ["frame {f.w}x{f.h} cmds={f.cmds.len()}"]
    for c in f.cmds
        lines.push("  {cmd_text(c)}")
    lines.join("\n")

## Counts for a frame (std.gfx.5): commands, rectangles and lines, text runs.
pub struct Stats
    pub cmds int
    pub fills int
    pub lines int
    pub texts int

pub fn stats(f Frame) Stats
    mut fills := 0
    mut lines := 0
    mut texts := 0
    for c in f.cmds
        match c
            Clear(_) => fills += 1
            Rect(_, _, _, _, _) => fills += 1
            Line(_, _, _, _, _) => lines += 1
            Text(_, _, _, _, _) => texts += 1
    Stats(cmds: f.cmds.len(), fills: fills, lines: lines, texts: texts)

## Runs `g` over `steps` with no window (std.gfx.4): each is the host events
## of one frame, `dt` seconds apart. Returns `dump` of every frame.
pub fn script[T Game](mut g T, w int, h int, dt float, steps List[List[app.Event]]) List[str]
    mut out := List[str]()
    mut input := idle()
    for evs in steps
        input = next_input(input, evs)
        g.update(input, dt)
        mut f := new_frame(w, h)
        g.draw(mut f)
        out.push(dump(f))
    out
