## std.gfx (spec std.gfx.1, std.gfx.3-6; ADR 0956): the headless half of the
## real-time frame loop. A game is a struct that implements `Game`; each
## frame it gets an `Input` snapshot and records draw commands into a
## `Frame`. `script` runs a game over scripted input with no window and
## returns each frame as text, so `ail test` covers a game. The window,
## vsync and surface (std.gfx.2, std.gfx.7-10) come later.

use std.app

## One draw command of a `Frame`. Coordinates are pixels from the top left,
## colors `0xRRGGBB`.
pub enum Cmd
    Clear(color int)
    Rect(x float, y float, w float, h float, color int)
    Line(x1 float, y1 float, x2 float, y2 float, color int)
    Text(x float, y float, text str, size float, color int)

## Draw commands for one frame, in order.
pub struct Frame
    pub w int
    pub h int
    pub cmds List[Cmd]

## What the player did, as of one frame (std.gfx.3). `pressed` and `released`
## hold the keys that changed since the previous frame; `down` holds every key
## held now. Keys are named as `std.ui.7` names them.
pub struct Input
    pub down List[str]
    pub pressed List[str]
    pub released List[str]
    pub text str
    pub x float
    pub y float
    pub buttons int
    pub wheel float

pub trait Game
    ## Advances the state by `dt` seconds with this frame's input.
    fn update(mut self, input Input, dt float)
    ## Records this frame's draw commands.
    fn draw(self, mut f Frame)

## An input with nothing held or typed.
pub fn idle() Input
    Input(down: [], pressed: [], released: [], text: "", x: 0.0, y: 0.0, buttons: 0, wheel: 0.0)

pub fn new_frame(w int, h int) Frame
    Frame(w: w, h: h, cmds: [])

pub fn clear(mut f Frame, color int)
    f.cmds.push(Cmd.Clear(color: color))

pub fn rect(mut f Frame, x float, y float, w float, h float, color int)
    f.cmds.push(Cmd.Rect(x: x, y: y, w: w, h: h, color: color))

pub fn line(mut f Frame, x1 float, y1 float, x2 float, y2 float, color int)
    f.cmds.push(Cmd.Line(x1: x1, y1: y1, x2: x2, y2: y2, color: color))

pub fn text(mut f Frame, x float, y float, s str, size float, color int)
    f.cmds.push(Cmd.Text(x: x, y: y, text: s, size: size, color: color))

## The host event for releasing `key` (std.gfx.4).
pub fn key_up(key str) app.Event
    mut e := app.event("keyup")
    e.text = key
    e

## Whether `key` is held (std.gfx.3).
pub fn down(i Input, key str) bool
    i.down.contains(key)

## Whether `key` went down this frame.
pub fn pressed(i Input, key str) bool
    i.pressed.contains(key)

## Whether `key` went up this frame: a key-up is a fact, not an event to miss.
pub fn released(i Input, key str) bool
    i.released.contains(key)

fn without(keys List[str], key str) List[str]
    mut out := List[str]()
    for k in keys
        if k != key
            out.push(k)
    out

## The next frame's input from the previous one and the host events since
## then: `key` presses a key (not its auto-repeats), `keyup` releases it,
## `click` and `move` set the pointer, `scroll` adds to the wheel (std.gfx.4).
pub fn next_input(prev Input, events List[app.Event]) Input
    mut held := prev.down
    mut went_down := List[str]()
    mut went_up := List[str]()
    mut typed := ""
    mut x := prev.x
    mut y := prev.y
    mut buttons := prev.buttons
    mut wheel := 0.0
    for ev in events
        if ev.kind == "key"
            if not held.contains(ev.text)
                held.push(ev.text)
                went_down.push(ev.text)
            if ev.text.chars().len() == 1 and not ev.ctrl and not ev.meta
                typed = "{typed}{ev.text}"
        elif ev.kind == "keyup"
            if held.contains(ev.text)
                held = without(held, ev.text)
                went_up.push(ev.text)
        elif ev.kind == "click" or ev.kind == "move"
            x = ev.x
            y = ev.y
            if ev.kind == "click"
                buttons = 1
        elif ev.kind == "scroll"
            wheel = wheel + ev.dy
    Input(held, went_down, went_up, typed, x, y, buttons, wheel)

## One command as a line of text (std.gfx.5).
pub fn cmd_text(c Cmd) str
    match c
        Clear(color) => "clear {color}"
        Rect(x, y, w, h, color) => "rect {x},{y} {w}x{h} {color}"
        Line(x1, y1, x2, y2, color) => "line {x1},{y1} {x2},{y2} {color}"
        Text(x, y, s, size, color) => "text {x},{y} \"{s}\" {size} {color}"

## The frame as text, one command per line: how a test or an agent sees it.
pub fn dump(f Frame) str
    mut lines := ["frame {f.w}x{f.h} cmds={f.cmds.len()}"]
    for c in f.cmds
        lines.push("  {cmd_text(c)}")
    lines.join("\n")

## Counts for a frame (std.gfx.6): commands, rectangles and lines, text runs.
pub struct Stats
    pub cmds int
    pub fills int
    pub lines int
    pub texts int

pub fn stats(f Frame) Stats
    mut fills := 0
    mut lines := 0
    mut texts := 0
    for c in f.cmds
        match c
            Clear(_) => fills += 1
            Rect(_, _, _, _, _) => fills += 1
            Line(_, _, _, _, _) => lines += 1
            Text(_, _, _, _, _) => texts += 1
    Stats(cmds: f.cmds.len(), fills: fills, lines: lines, texts: texts)

## Runs `g` over `steps` with no window (std.gfx.5): each is the host events
## of one frame, `dt` seconds apart. Returns `dump` of every frame.
pub fn script[T Game](mut g T, w int, h int, dt float, steps List[List[app.Event]]) List[str]
    mut out := List[str]()
    mut input := idle()
    for evs in steps
        input = next_input(input, evs)
        g.update(input, dt)
        mut f := new_frame(w, h)
        g.draw(mut f)
        out.push(dump(f))
    out
