## std.gfx.host (spec std.gfx.6-9; ADR 0957): `run` shows a `Game` in a window.
## The frame is drawn by the CPU into a shared mapping of two RGBA8 buffers,
## which the macOS app host maps by path and shows without JSON on the path;
## each `present` is answered by a `vsync` that paces the next frame. The
## program's own mapping comes from the C library's `mkstemp`, `ftruncate`,
## `mmap` and `unlink`, so no runtime piece is needed for it. On Windows it is
## a named file mapping from kernel32 (`CreateFileMappingA`, `MapViewOfFile`),
## which the host opens by name (std.gfx.8, ADR 1044).

use std.app
use std.attach
use std.gfx
use std.mem

extern c fn mkstemp(template *u8) i32
extern c fn ftruncate(fd i32, len int) i32
extern c fn mmap(addr *u8, len int, prot i32, flags i32, fd i32, offset int) *u8
extern c fn unlink(path *u8) i32
extern c fn close(fd i32) i32
extern c fn munmap(addr *u8, len int) i32

extern c "kernel32" fn CreateFileMappingA(
    file int,
    attrs *u8,
    protect i32,
    hi i32,
    lo i32,
    name *u8,
) int

extern c "kernel32" fn MapViewOfFile(map int, access i32, hi i32, lo i32, bytes int) *u8
extern c "kernel32" fn GetCurrentProcessId() i32
extern c "kernel32" fn GetTickCount64() int

## Bytes of unused file before the first buffer and after the last: the
## runtime's `std.mem` block check (unsafe.ptr.5) treats an access at the end
## address of a block as past it, so a mapping that happens to sit right after
## one must not start at the mapping's first byte. A multiple of every page size.
GUARD := 16384

pub error struct GfxError "{self.why}"
    pub why str

## The shared frame buffers: `count` of them, each `stride` bytes by `h` rows.
struct Surface
    base *u8
    mapped int
    path str
    name str
    w int
    h int
    stride int
    count int
    back int

## On Windows: a named, pagefile-backed file mapping (`Local\ail-gfx-PID-TICK`) of two
## buffers of `w` by `h` pixels, held open until the process ends so the host
## can open it by name (std.gfx.8, ADR 1044). Nothing is unlinked.
fn make_win_surface(w int, h int) Surface ! GfxError
    mut pid := 0
    mut tick := 0
    unsafe
        pid = GetCurrentProcessId().to_int()
        tick = GetTickCount64()
    name := "Local\\ail-gfx-{pid}-{tick}"
    stride := w * 4
    total := GUARD + stride * h * 2 + GUARD
    unsafe
        n := mem.cstr(name)
        # INVALID_HANDLE_VALUE (-1) asks for a mapping backed by the paging file; PAGE_READWRITE is 4.
        handle := CreateFileMappingA(0 - 1, mem.null(), 4, 0, total.to_i32(), n)
        mem.free(n)
        if handle == 0
            return GfxError(why: "cannot create the surface mapping")
        # FILE_MAP_ALL_ACCESS is 0xF001F.
        mapping := MapViewOfFile(handle, 983071, 0, 0, total)
        if mapping.is_null()
            return GfxError(why: "cannot map the surface mapping")
        Surface(
            base: mapping.offset(GUARD),
            mapped: total,
            path: "",
            name: name,
            w: w,
            h: h,
            stride: stride,
            count: 2,
            back: 0,
        )

## Maps two buffers of `w` by `h` pixels in a private file (mode 0600, random
## name) under `$TMPDIR`. The file is unlinked once the host has mapped it.
fn make_surface(w int, h int) Surface ! GfxError
    if (env.get("OS") else "") == "Windows_NT"
        return make_win_surface(w, h)?
    dir := env.get("TMPDIR") else "/tmp"
    template := "{dir}/ail-gfx-XXXXXX"
    stride := w * 4
    buffers := stride * h * 2
    total := GUARD + buffers + GUARD
    unsafe
        t := mem.cstr(template)
        fd := mkstemp(t)
        if fd < 0
            mem.free(t)
            return GfxError(why: "cannot create the surface file in {dir}")
        path := mem.from_cstr(t)
        mem.free(t)
        if ftruncate(fd, total) != 0
            close(fd)
            return GfxError(why: "cannot size the surface file")
        # PROT_READ | PROT_WRITE is 3, MAP_SHARED is 1.
        mapping := mmap(mem.null(), total, 3, 1, fd, 0)
        close(fd)
        if mapping.is_null()
            return GfxError(why: "cannot map the surface file")
        Surface(
            base: mapping.offset(GUARD),
            mapped: total,
            path: path,
            name: "",
            w: w,
            h: h,
            stride: stride,
            count: 2,
            back: 0,
        )

fn drop_file(s Surface)
    if s.path == ""
        return
    unsafe
        p := mem.cstr(s.path)
        unlink(p)
        mem.free(p)

## One pixel of the back buffer; off the surface it does nothing.
fn put(s Surface, x int, y int, color int)
    if x < 0 or y < 0 or x >= s.w or y >= s.h
        return
    unsafe
        q := s.base.offset(s.back * s.stride * s.h + y * s.stride + x * 4)
        q.write((color / 65536 % 256).to_u8())
        q.offset(1).write((color / 256 % 256).to_u8())
        q.offset(2).write((color % 256).to_u8())
        q.offset(3).write(255.to_u8())

fn fill(s Surface, x0 int, y0 int, w int, h int, color int)
    for y in y0..y0 + h
        for x in x0..x0 + w
            put(s, x, y, color)

## A line by Bresenham's algorithm.
fn stroke(s Surface, x1 int, y1 int, x2 int, y2 int, color int)
    mut x := x1
    mut y := y1
    dx := if x2 > x1 then x2 - x1 else x1 - x2
    dy := if y2 > y1 then y2 - y1 else y1 - y2
    sx := if x1 < x2 then 1 else -1
    sy := if y1 < y2 then 1 else -1
    mut err := dx - dy
    while true
        put(s, x, y, color)
        if x == x2 and y == y2
            break
        e2 := 2 * err
        if e2 > 0 - dy
            err -= dy
            x += sx
        if e2 < dx
            err += dx
            y += sy

fn skip()
    return

## Draws `f` into the back buffer (std.gfx.7). `Text` is not rasterised yet.
fn raster(s Surface, f gfx.Frame)
    for c in f.cmds
        match c
            Clear(color) => fill(s, 0, 0, s.w, s.h, color)
            Rect(x, y, w, h, color) => fill(
                s,
                x.to_int(),
                y.to_int(),
                w.to_int(),
                h.to_int(),
                color,
            )
            Line(x1, y1, x2, y2, color) => stroke(
                s,
                x1.to_int(),
                y1.to_int(),
                x2.to_int(),
                y2.to_int(),
                color,
            )
            Text(_, _, _, _, _) => skip()

## The canvas that carries the surface, and the key for host lines about it.
CANVAS := "gfx"

fn surface_line(s Surface) str
    if s.name != ""
        return "\{\"v\":1,\"t\":\"surface\",\"id\":\"{CANVAS}\",\"w\":{s.w},\"h\":{s.h},\"stride\":{s.stride},\"offset\":{GUARD},\"count\":{s.count},\"name\":{Json.Str(s.name).to_text()}}"
    "\{\"v\":1,\"t\":\"surface\",\"id\":\"{CANVAS}\",\"w\":{s.w},\"h\":{s.h},\"stride\":{s.stride},\"offset\":{GUARD},\"count\":{s.count},\"path\":\"{s.path}\"}"

fn present_line(buf int) str
    "\{\"v\":1,\"t\":\"present\",\"id\":\"{CANVAS}\",\"buf\":{buf}}"

## The game as a `std.app` application: events collect into the next frame's
## `Input`, and each `vsync` runs `update` and `draw` and presents.
pub struct Loop[T gfx.Game]
    game T
    name str
    w int
    h int
    surf Surface?
    input gfx.Input
    pending List[app.Event]
    out List[str]
    failed str
    unlinked bool
    last gfx.Frame
    texts str

impl app.App for Loop[T gfx.Game]
    fn update(mut self, ev app.Event)
        if ev.kind == app.EventKind.Start
            made := make_surface(self.w, self.h) else err
                self.failed = "{err}"
                return
            self.surf = made
            self.out.push(surface_line(made))
            step(mut self, 0.0)
        elif ev.kind == app.EventKind.Vsync
            if not self.unlinked
                if s := self.surf
                    drop_file(s)
                self.unlinked = true
            dt := if ev.dx > 0.1 then 0.1 else ev.dx
            step(mut self, dt)
        elif ev.kind == app.EventKind.Key
            or ev.kind == app.EventKind.KeyUp
            or ev.kind == app.EventKind.Click
            or ev.kind == app.EventKind.Move
            or ev.kind == app.EventKind.Scroll
            or ev.kind == app.EventKind.Pad
            self.pending.push(ev)

    fn view(self) app.Node
        app.canvas(CANVAS, self.w.to_float(), self.h.to_float(), [])

    fn title(self) str
        self.name

    fn shown(self) app.Node
        app.canvas(CANVAS, self.w.to_float(), self.h.to_float(), ops_of(self.last))

    fn hover(self) bool
        true

    fn lines(mut self) List[str]
        sent := self.out
        self.out = []
        sent

## One frame: this frame's input, `update`, `draw`, raster, and present.
fn step[T gfx.Game](mut l Loop[T], dt float)
    mut s := l.surf else return
    f := advance(mut l, dt)
    raster(s, f)
    # std.gfx.7: the text of the frame, drawn by the host, sent when it changes.
    now := text_line(f)
    if now != l.texts
        l.out.push(now)
        l.texts = now
    l.out.push(present_line(s.back))
    s.back = 1 - s.back
    l.surf = s

## The `text` line for the `Text` commands of `f` (std.gfx.7): the host draws
## them over the surface, in its own fonts. Empty items clear earlier text.
pub fn text_line(f gfx.Frame) str
    mut items := List[str]()
    for c in f.cmds
        match c
            Text(
                x,
                y,
                t,
                size,
                color,
            ) => items.push("\{\"x\":{x},\"y\":{y},\"s\":{Json.Str(t).to_text()},\"size\":{size},\"color\":{color}}")
            Clear(_) => skip()
            Rect(_, _, _, _, _) => skip()
            Line(_, _, _, _, _) => skip()
    "\{\"v\":1,\"t\":\"text\",\"id\":\"{CANVAS}\",\"items\":[{items.join(",")}]}"

## The game's next frame with no window (std.gfx.10): this frame's input,
## `update` and `draw`; the frame is also what `shown` reports. `step` draws
## the same frame into the surface.
pub fn advance[T gfx.Game](mut l Loop[T], dt float) gfx.Frame
    l.input = gfx.next_input(l.input, l.pending)
    l.pending = []
    l.game.update(l.input, dt)
    mut f := gfx.new_frame(l.w, l.h)
    l.game.draw(mut f)
    l.last = f
    f

## The last frame's commands as canvas ops, for the attach screen model
## (std.app.24, std.gfx.10): `Clear` and `Rect` are fills, `Line` a stroke of
## width 1, `Text` a mono string.
fn ops_of(f gfx.Frame) List[app.Op]
    mut out := List[app.Op]()
    for c in f.cmds
        match c
            Clear(color) => out.push(app.Op.Fill(
                x: 0.0,
                y: 0.0,
                w: f.w.to_float(),
                h: f.h.to_float(),
                color: color,
            ))
            Rect(x, y, w, h, color) => out.push(app.Op.Fill(x: x, y: y, w: w, h: h, color: color))
            Line(x1, y1, x2, y2, color) => out.push(app.Op.Stroke(
                x1: x1,
                y1: y1,
                x2: x2,
                y2: y2,
                color: color,
                width: 1.0,
            ))
            Text(x, y, t, size, color) => out.push(app.Op.Str(
                x: x,
                y: y,
                text: t,
                font: "mono",
                size: size,
                fg: color,
                bold: false,
                italic: false,
                underline: false,
            ))
    out

## What an attached agent can observe of a running game (std.gfx.10): the
## game's own values, and the last frame's command counts.
impl attach.Observe for Loop[T gfx.Game + attach.Observe]
    fn observed(self) List[attach.Observed]
        mut seen := self.game.observed()
        st := gfx.stats(self.last)
        seen.push(attach.observed("gfx.cmds", "int", "{st.cmds}"))
        seen.push(attach.observed("gfx.fills", "int", "{st.fills}"))
        seen.push(attach.observed("gfx.lines", "int", "{st.lines}"))
        seen.push(attach.observed("gfx.texts", "int", "{st.texts}"))
        seen

    ## The game's `@tool` methods (attach.tool.3).
    fn tools(self) List[attach.Tool]
        self.game.tools()

    fn call(mut self, ail_tool str, ail_args Json) str
        self.game.call(ail_tool, ail_args)

## The loop for `g`, for `std.gfx.watch` (which runs it with the attach
## listener); `run` is the same without it.
pub fn new_loop[T gfx.Game](g T, title str, w int, h int) Loop[T]
    Loop(
        game: g,
        name: title,
        w: w,
        h: h,
        surf: none,
        input: gfx.idle(),
        pending: [],
        out: [],
        failed: "",
        unlinked: false,
        last: gfx.new_frame(w, h),
        texts: "",
    )

## After a run: the game back in `g`, and the failure the loop recorded.
pub fn finish[T gfx.Game](mut g T, l Loop[T]) ! GfxError
    g = l.game
    if l.failed != ""
        return GfxError(why: l.failed)

## Opens a window `w` by `h` pixels and runs `g` at the display's refresh rate
## until the window closes (std.gfx.6). The file of the shared surface is
## removed when the host has mapped it.
pub fn run[T gfx.Game](mut g T, title str, w int, h int) ! GfxError
    mut l := new_loop(g, title, w, h)
    app.run(mut l) else err
        return GfxError(why: err.message)
    finish(mut g, l)?

## A private surface in `std.mem` memory, for `pixels` where the C library has
## no `mkstemp` (Windows).
fn private_surface(w int, h int) Surface
    stride := w * 4
    total := GUARD + stride * h * 2 + GUARD
    unsafe
        block := mem.alloc(total, 0.to_u8())
        Surface(
            base: block.offset(GUARD),
            mapped: total,
            path: "",
            name: "",
            w: w,
            h: h,
            stride: stride,
            count: 2,
            back: 0,
        )

## The pixels of `f` as `0xRRGGBB` numbers, row by row, drawn the way `run`
## draws them into a fresh surface and read back (std.gfx.9): a test of a
## frame's pixels with no window. Windows uses a private buffer, not a file.
pub fn pixels(f gfx.Frame) List[int] ! GfxError
    windows := (env.get("OS") else "") == "Windows_NT"
    s := if windows then private_surface(f.w, f.h) else make_surface(f.w, f.h)?
    if not windows
        drop_file(s)
    raster(s, f)
    mut out := List[int]()
    unsafe
        for y in 0..f.h
            for x in 0..f.w
                q := s.base.offset(s.back * s.stride * s.h + y * s.stride + x * 4)
                r := q.read().to_int()
                g := q.offset(1).read().to_int()
                b := q.offset(2).read().to_int()
                out.push(r * 65536 + g * 256 + b)
        if windows
            mem.free(s.base.offset(0 - GUARD))
        else
            munmap(s.base.offset(0 - GUARD), s.mapped)
    out
