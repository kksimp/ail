## std.screen pixel classifier (spec std.screen.10, std.screen.11, ADR 0878):
## items found in a raster where the program's own tree is blind (canvas,
## images, video frames). It finds flat-colour rectangles, notices rounded
## corners and takes a label from the nearest text, and every guess says why
## it was made (std.screen.3).

use std.screen

## A flat-colour region: its colour, box and pixel count.
struct Blob
    color int
    x0 int
    y0 int
    x1 int
    y1 int
    n int

fn grow(w int, h int, px List[int], mut seen List[bool], start int) Blob
    c := px[start]
    mut b := Blob(color: c, x0: w, y0: h, x1: 0, y1: 0, n: 0)
    mut stack := [start]
    seen[start] = true
    while stack.len() > 0
        at := stack.pop() else break
        x := at % w
        y := at / w
        b.n += 1
        b.x0 = b.x0.min(x)
        b.y0 = b.y0.min(y)
        b.x1 = b.x1.max(x + 1)
        b.y1 = b.y1.max(y + 1)
        for d in [(1, 0), (-1, 0), (0, 1), (0, -1)]
            nx := x + d.0
            ny := y + d.1
            if nx < 0 or ny < 0 or nx >= w or ny >= h
                continue
            k := ny * w + nx
            if not seen[k] and px[k] == c
                seen[k] = true
                stack.push(k)
    b

## The label for box (`x0`,`y0`)-(`x1`,`y1`): the texts whose centre lies inside it, in order.
fn label(texts List[screen.Item], x0 int, y0 int, x1 int, y1 int) str
    mut out := List[str]()
    for t in texts
        cx := t.x + t.w / 2.0
        cy := t.y + t.h / 2.0
        if cx >= x0.to_float() and cx < x1.to_float() and cy >= y0.to_float() and cy < y1.to_float()
            out.push(t.text)
    out.join(" ")

## Items for the rectangles in `px` (`w` by `h` packed 0xRRGGBB values, row
## by row). `texts` are text items already known (from the tree or an OCR-free
## font draw), used for labels. Regions under 6 by 6 pixels, the background
## (over 60% of the raster) and regions that are not mostly rectangular are
## left out (std.screen.10). Ids are 5000000 plus the box's top left, so the same
## box keeps its id between frames (std.screen.5).
pub fn segment(w int, h int, px List[int], texts List[screen.Item]) List[screen.Item]
    mut out := List[screen.Item]()
    if px.len() != w * h
        return out
    mut seen := List[bool]()
    for _ in px
        seen.push(false)
    for start in 0..px.len()
        if seen[start]
            continue
        b := grow(w, h, px, mut seen, start)
        bw := b.x1 - b.x0
        bh := b.y1 - b.y0
        if bw < 6 or bh < 6 or not rounded_ok(b, bw, bh)
            continue
        if bw * bh * 10 > w * h * 6
            continue
        out.push(classify(w, h, px, b, texts))
    out

## A rounded rectangle loses at most the corner pixels (about 1 - pi/4 of
## a square of the corner radius), so allow 80% fill when a corner is missing.
fn rounded_ok(b Blob, bw int, bh int) bool
    b.n * 10 >= bw * bh * 8

fn rounded(w int, px List[int], b Blob) bool
    px[b.y0 * w + b.x0] != b.color

fn classify(w int, h int, px List[int], b Blob, texts List[screen.Item]) screen.Item
    bw := b.x1 - b.x0
    bh := b.y1 - b.y0
    text := label(texts, b.x0, b.y0, b.x1, b.y1)
    round := rounded(w, px, b)
    shape := if round then "rounded" else "square"
    id := 5000000 + b.y0 * w + b.x0
    mut it := screen.item(id, "panel", text, b.color, b.x0.to_float(), b.y0.to_float(), bw.to_float(), bh.to_float())
    it.conf = 0.5
    it.why = "flat {screen.color_name(b.color)} {shape} rectangle"
    ratio := bw.to_float() / bh.to_float()
    if text != "" and bh >= 16 and bh <= 60 and ratio >= 1.5 and ratio <= 12.0 and bw * bh * 20 < w * h
        it.role = "button"
        it.conf = if round then 0.9 else 0.7
        it.why = "{shape} {screen.color_name(b.color)} rectangle with text '{text}'"
    it
