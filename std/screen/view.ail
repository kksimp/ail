## std.screen.view (spec std.screen.12, std.screen.13, ADR 0878): the screen
## model of any `std.app` program, from its view tree and canvas ops, with no
## code in the program. A canvas's boxes are exact; the controls of the tree are
## laid out by nominal sizes, because the host owns the real layout, so they
## say so (`conf` 0.9, std.screen.3).

use std.app
use std.screen
use std.screen.pixels

fn hash(s str) int
    mut h := 7
    for c in s.chars()
        h = (h * 31 + c.code()) % 900000
    h

fn text_w(s str, size float) float
    s.chars().len().to_float() * size * 0.6

## The items of canvas ops `ops`, moved by (`ox`, `oy`), in paint order
## (std.screen.12): fills, shades, rounded rectangles and polygons are `box`, strings `text`, pictures and bitmaps
## `image`, strokes and polylines `line`.
pub fn of_ops(ops List[app.Op], ox float, oy float) List[screen.Item]
    mut out := List[screen.Item]()
    for op in ops
        match op
            Fill(x, y, w, h, c) => out.push(screen.item(
                2000000 + hash("{x}{y}{w}{h}"),
                "box",
                "",
                c,
                ox + x,
                oy + y,
                w,
                h,
            ))
            Shade(x, y, w, h, c, _) => out.push(screen.item(
                2000000 + hash("{x}{y}{w}{h}"),
                "box",
                "",
                c,
                ox + x,
                oy + y,
                w,
                h,
            ))
            Str(x, y, t, _, size, fg, _, _, _) => out.push(screen.item(
                3000000 + hash("{t}{x}{y}"),
                "text",
                t,
                fg,
                ox + x,
                oy + y,
                text_w(t, size),
                size * 1.3,
            ))
            Pic(x, y, w, h, src) => out.push(screen.item(
                4000000 + hash(src),
                "image",
                src,
                0x808080,
                ox + x,
                oy + y,
                w,
                h,
            ))
            Bitmap(x, y, w, h, id, pw, ph, data) =>
                out.push(screen.item(
                    4000000 + hash(id),
                    "image",
                    id,
                    0x808080,
                    ox + x,
                    oy + y,
                    w,
                    h,
                ))
                out.extend(bitmap_items(ox + x, oy + y, w, h, pw, ph, data))
            Stroke(x1, y1, x2, y2, c, width) => out.push(screen.item(
                6000000 + hash("{x1}{y1}{x2}{y2}"),
                "line",
                "",
                c,
                ox + x1.min(x2),
                oy + y1.min(y2),
                (x2 - x1).abs().max(width),
                (y2 - y1).abs().max(width),
            ))
            Round(x, y, w, h, _, c, _, _) => out.push(screen.item(
                2000000 + hash("{x}{y}{w}{h}"),
                "box",
                "",
                c,
                ox + x,
                oy + y,
                w,
                h,
            ))
            Poly(points, c, _) =>
                if points.len() >= 6
                    out.push(points_item(2000000, "box", points, c, 0.0, ox, oy))
            Line(points, c, width) =>
                if points.len() >= 4
                    out.push(points_item(6000000, "line", points, c, width, ox, oy))
            Font(_, _) => out = out
            Clip(_, _, _, _) => out = out
            Unclip => out = out
    out

## The extreme of the x (`off` 0) or y (`off` 1) values of `points`, the
## smallest or the largest.
fn extent(points List[float], off int, largest bool) float
    n := points.len() / 2
    if n == 0
        return 0.0
    mut best := points[off]
    for k in 0..n
        v := points[k * 2 + off]
        if largest
            best = best.max(v)
        else
            best = best.min(v)
    best

## The item of a polygon or polyline: its bounding box, grown by `width`.
fn points_item(
    base int,
    role str,
    points List[float],
    c int,
    width float,
    ox float,
    oy float,
) screen.Item
    x0 := extent(points, 0, false)
    y0 := extent(points, 1, false)
    screen.item(
        base + hash("{x0}{y0}{points.len()}"),
        role,
        "",
        c,
        ox + x0,
        oy + y0,
        (extent(points, 0, true) - x0).max(width),
        (extent(points, 1, true) - y0).max(width),
    )

## The regions the pixel classifier finds in a `Bitmap` (std.screen.14), moved
## and scaled from bitmap pixels to the rectangle (`x`, `y`, `w`, `h`). An
## empty `data` (an image the host already has) or a size mismatch gives none.
fn bitmap_items(x float, y float, w float, h float, pw int, ph int, data str) List[screen.Item]
    if data == "" or pw < 1 or ph < 1
        return []
    raw := bytes.from_base64(data) else return []
    if raw.len() != pw * ph * 4
        return []
    mut px := List[int]()
    for k in 0..pw * ph
        px.push(raw[k * 4].to_int() * 65536 + raw[k * 4 + 1].to_int() * 256 + raw[k * 4 + 2].to_int())
    sx := w / pw.to_float()
    sy := h / ph.to_float()
    mut out := List[screen.Item]()
    for it in pixels.segment(pw, ph, px, [])
        mut m := it
        m.x = x + it.x * sx
        m.y = y + it.y * sy
        m.w = it.w * sx
        m.h = it.h * sy
        out.push(m)
    out

fn control(id str, role str, text str, x float, y float, w float, focus str) screen.Item
    mut it := screen.item(1000000 + hash(id), role, text, 0x404040, x, y, w, 24.0)
    it.focused = id == focus
    it.conf = 0.9
    it.why = "estimated layout"
    it

## Lays `n` out from (`x`, `y`), pushes its items and returns its size.
fn place(n app.Node, x float, y float, focus str, mut out List[screen.Item])(float, float)
    match n
        Label(t) =>
            w := text_w(t, 13.0)
            out.push(screen.item(3000000 + hash("{t}{x}{y}"), "text", t, 0x202020, x, y, w, 20.0))
            (w, 20.0)
        Button(id, caption) =>
            w := text_w(caption, 13.0) + 24.0
            out.push(control(id, "button", caption, x, y, w, focus))
            (w, 24.0)
        Field(id, value, hint) =>
            out.push(control(
                id,
                "textbox",
                if value == "" then hint else value,
                x,
                y,
                200.0,
                focus,
            ))
            (200.0, 24.0)
        Toggle(id, caption, on) =>
            w := text_w(caption, 13.0) + 28.0
            out.push(control(
                id,
                "checkbox",
                "{caption}{if on then " (on)" else ""}",
                x,
                y,
                w,
                focus,
            ))
            (w, 24.0)
        Spacer => (0.0, 0.0)
        Canvas(id, w, h, ops) =>
            out.push(screen.item(5000000 + hash(id), "canvas", id, 0xffffff, x, y, w, h))
            out.extend(of_ops(ops, x, y))
            (w, h)
        Column(kids) =>
            mut cy := y
            mut cw := 0.0
            for k in kids
                size := place(k, x, cy, focus, mut out)
                cy += size.1 + 4.0
                cw = cw.max(size.0)
            (cw, cy - y)
        Row(kids) =>
            mut cx := x
            mut ch := 0.0
            for k in kids
                size := place(k, cx, y, focus, mut out)
                cx += size.0 + 8.0
                ch = ch.max(size.1)
            (cx - x, ch)

## The screen of view tree `n` in a window `w` by `h`; `focus` is the id of
## the focused control (`App.focus`) (std.screen.13): `of_node(a.view(), w, h, a.focus())` for app `a`.
pub fn of_node(n app.Node, w float, h float, focus str) screen.Screen
    mut items := List[screen.Item]()
    size := place(n, 0.0, 0.0, focus, mut items)
    screen.Screen(w: w.max(size.0), h: h.max(size.1), items: items)

## The id of the control of view tree `n` that `want` names, or "" when none does: `want` is the control's own
## id (`Button("pay", ...)` is "pay") or the number `#N` that `of_node` gives its item (std.screen.13).
pub fn control_id(n app.Node, want str) str
    match n
        Button(id, _) => if id == want or "{1000000 + hash(id)}" == want then id else ""
        Field(id, _, _) => if id == want or "{1000000 + hash(id)}" == want then id else ""
        Toggle(id, _, _) => if id == want or "{1000000 + hash(id)}" == want then id else ""
        Canvas(id, _, _, _) => if id == want or "{5000000 + hash(id)}" == want then id else ""
        Column(kids) => first_control(kids, want)
        Row(kids) => first_control(kids, want)
        Label(_) => ""
        Spacer => ""

fn first_control(kids List[app.Node], want str) str
    for k in kids
        found := control_id(k, want)
        if found != ""
            return found
    ""
