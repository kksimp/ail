## std.humanize (spec std.humanize.1-12, ADR TBD): numbers, sizes and times for
## people to read. Thousands separators and decimal marks for a few locales or
## a custom pair, percentages, compact numbers (`1.2K`), byte sizes (`1.5 MB`,
## `1.4 MiB`), English ordinals (`22nd`) and relative times (`3 minutes ago`).
## Every function is pure and never traps on its input, except that `relative`
## subtracts two `int` values like any other code does. Dates and durations
## stay in `std.time.date` (`date.duration_text`).

## A number style (std.humanize.1). `group` goes between groups of three integer
## digits, `decimal` before the fraction, `percent_sep` between a number and its
## `%`. The integer part is grouped only when it has at least `min_digits`
## digits (Spanish writes `1234` but `12.345`).
pub struct Locale
    pub group str
    pub decimal str
    pub percent_sep str
    pub min_digits int

## English: `1,234.5`, `12%` (std.humanize.2).
pub fn en() Locale
    Locale(group: ",", decimal: ".", percent_sep: "", min_digits: 4)

## German: `1.234,5`, `12 %` with a no-break space (std.humanize.2).
pub fn de() Locale
    Locale(group: ".", decimal: ",", percent_sep: "\u{a0}", min_digits: 4)

## French: `1 234,5` with a narrow no-break space, `12 %` (std.humanize.2).
pub fn fr() Locale
    Locale(group: "\u{202f}", decimal: ",", percent_sep: "\u{202f}", min_digits: 4)

## Spanish: `1234,5` but `12.345,6`, `12 %` (std.humanize.2).
pub fn es() Locale
    Locale(group: ".", decimal: ",", percent_sep: "\u{a0}", min_digits: 5)

## Japanese: `1,234.5`, `12%` (std.humanize.2).
pub fn ja() Locale
    Locale(group: ",", decimal: ".", percent_sep: "", min_digits: 4)

## A style with your own separators: groups every three digits from four up,
## and `%` follows the number directly (std.humanize.3). For more, build a
## `Locale` with all four fields.
pub fn custom(group str, decimal str) Locale
    Locale(group: group, decimal: decimal, percent_sep: "", min_digits: 4)

## The style for a language tag: `en`, `de`, `fr`, `es`, `ja`, with or without a
## region and in either case (`de-AT`, `fr_CA`, `EN`). `none` for any other
## language (std.humanize.2).
pub fn locale(tag str) Locale?
    mut lang := tag.to_lower()
    if i := lang.find("-")
        lang = lang.slice(0, i)
    if j := lang.find("_")
        lang = lang.slice(0, j)
    if lang == "en"
        return en()
    if lang == "de"
        return de()
    if lang == "fr"
        return fr()
    if lang == "es"
        return es()
    if lang == "ja"
        return ja()
    none

MS_MIN := 60000
MS_HOUR := 3600000
MS_DAY := 86400000
MS_WEEK := 604800000
MS_MONTH := 2592000000
MS_YEAR := 31536000000

struct Parts
    ip str
    fp str

struct Scaled
    ip str
    fp str
    idx int
    neg bool

fn pow10(d int) int
    mut p := 1
    for _ in 0..d
        p *= 10
    p

fn clamp_d(d int) int
    if d < 0
        return 0
    if d > 9
        return 9
    d

## `nan`, `inf` or `-inf` for a float with no digits, else `none`.
fn nonfinite(x float) str?
    if x != x
        return "nan"
    if x - x != 0.0
        if x > 0.0
            return "inf"
        return "-inf"
    none

## The integer and fraction digits of `ax` (not negative, finite) rounded to
## `d` decimals, halves away from zero.
fn split_fixed(ax float, d int) Parts
    p := pow10(d)
    big := ax * p.to_float()
    if big >= 4.0e18
        return Parts(ip: "{ax:.0}", fp: "0".repeat(d))
    scaled := big.round().to_int()
    ip := (scaled / p).to_str()
    if d == 0
        return Parts(ip: ip, fp: "")
    Parts(ip: ip, fp: (scaled % p).to_str().pad_left(d, '0'))

fn trim_zeros(s str) str
    mut t := s
    while t.ends_with("0")
        t = t.slice(0, t.len() - 1)
    t

fn group(digits str, loc Locale) str
    if digits.len() <= 3 or digits.len() < loc.min_digits
        return digits
    mut pieces := List[str]()
    mut i := digits.len()
    while i > 0
        mut lo := i - 3
        if lo < 0
            lo = 0
        pieces.push(digits.slice(lo, i))
        i = lo
    pieces.reversed().join(loc.group)

fn assemble(neg bool, ip str, fp str, loc Locale) str
    mut out := group(ip, loc)
    if fp != ""
        out = "{out}{loc.decimal}{fp}"
    if neg
        out = "-{out}"
    out

## `n` divided by `base` until it is below `base` or `top` steps are taken,
## rounded to `d` decimals with trailing zeros dropped. A value that rounds up
## to `base` (999999 to one decimal) moves to the next step.
fn scale(n int, base float, top int, d int) Scaled
    neg := n < 0
    mut v := n.to_float().abs()
    mut idx := 0
    while v >= base and idx < top
        v = v / base
        idx += 1
    mut parts := split_fixed(v, d)
    if idx > 0 and idx < top and (parts.ip.to_int() else 0) >= base.to_int()
        v = v / base
        idx += 1
        parts = split_fixed(v, d)
    Scaled(ip: parts.ip, fp: trim_zeros(parts.fp), idx: idx, neg: neg)

## A scaled count and its unit: a byte count below the first step stays whole
## and ungrouped (`1023 B`).
fn sized(sc Scaled, loc Locale, word str) str
    if sc.idx == 0
        if sc.neg
            return "-{sc.ip} {word}"
        return "{sc.ip} {word}"
    "{assemble(sc.neg, sc.ip, sc.fp, loc)} {word}"

## The integer `n` with the style's thousands separator (std.humanize.4).
pub fn Locale.int_text(self, n int) str
    s := n.to_str()
    if s.starts_with("-")
        return assemble(true, s.slice(1), "", self)
    assemble(false, s, "", self)

## The float `x` with exactly `decimals` decimals (0 to 9, others are cut to
## that range), rounded half away from zero, grouped and with the style's
## decimal mark. A result that is all zeros has no sign. `nan`, `inf` and
## `-inf` come back as those words (std.humanize.5).
pub fn Locale.float_text(self, x float, decimals int) str
    if bad := nonfinite(x)
        return bad
    parts := split_fixed(x.abs(), clamp_d(decimals))
    zero := parts.ip == "0" and parts.fp.replace("0", "") == ""
    assemble(x < 0.0 and not zero, parts.ip, parts.fp, self)

## `ratio` as a percentage: 0.256 with one decimal is `25.6%`. The style's
## `percent_sep` goes before the `%` (std.humanize.6).
pub fn Locale.percent(self, ratio float, decimals int) str
    v := ratio * 100.0
    if bad := nonfinite(v)
        return bad
    "{self.float_text(v, decimals)}{self.percent_sep}%"

## `n` in thousands, millions, billions or trillions with the suffix `K`, `M`,
## `B` or `T`, at most `decimals` decimals and no trailing zeros: 1234 is `1.2K`,
## 2000000 is `2M`. Below 1000 the number is written whole. Past 999 trillion
## the count of trillions grows. The suffixes are English abbreviations in every
## style (std.humanize.7).
pub fn Locale.compact(self, n int, decimals int) str
    sc := scale(n, 1000.0, 4, clamp_d(decimals))
    units := ["", "K", "M", "B", "T"]
    "{assemble(sc.neg, sc.ip, sc.fp, self)}{units[sc.idx]}"

## A byte count in powers of 1000: `B`, `kB`, `MB`, `GB`, `TB`, `PB`, `EB`, at
## most `decimals` decimals, no trailing zeros, one space before the unit
## (a count below 1000 is whole and ungrouped): 1500000 is `1.5 MB` (std.humanize.8).
pub fn Locale.size_si(self, n int, decimals int) str
    sc := scale(n, 1000.0, 6, clamp_d(decimals))
    units := ["B", "kB", "MB", "GB", "TB", "PB", "EB"]
    sized(sc, self, units[sc.idx])

## A byte count in powers of 1024: `B`, `KiB`, `MiB`, `GiB`, `TiB`, `PiB`,
## `EiB`, otherwise like `size_si`: 1572864 is `1.5 MiB` (std.humanize.9).
pub fn Locale.size_iec(self, n int, decimals int) str
    sc := scale(n, 1024.0, 6, clamp_d(decimals))
    units := ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
    sized(sc, self, units[sc.idx])

## English style: `int_text(1234567)` is `1,234,567` (std.humanize.4).
pub fn int_text(n int) str
    en().int_text(n)

## English style: `float_text(1234.5, 2)` is `1,234.50` (std.humanize.5).
pub fn float_text(x float, decimals int) str
    en().float_text(x, decimals)

## English style: `percent(0.256, 1)` is `25.6%` (std.humanize.6).
pub fn percent(ratio float, decimals int) str
    en().percent(ratio, decimals)

## English style: `compact(1234, 1)` is `1.2K` (std.humanize.7).
pub fn compact(n int, decimals int) str
    en().compact(n, decimals)

## English style: `size_si(1500000, 1)` is `1.5 MB` (std.humanize.8).
pub fn size_si(n int, decimals int) str
    en().size_si(n, decimals)

## English style: `size_iec(1572864, 1)` is `1.5 MiB` (std.humanize.9).
pub fn size_iec(n int, decimals int) str
    en().size_iec(n, decimals)

## `n` with its English ordinal suffix: `1st`, `2nd`, `3rd`, `4th`, `11th`,
## `12th`, `13th`, `21st`, `-2nd` (std.humanize.10).
pub fn ordinal(n int) str
    mut r := n % 100
    if r < 0
        r = 0 - r
    mut suffix := "th"
    if r < 11 or r > 13
        m := r % 10
        if m == 1
            suffix = "st"
        elif m == 2
            suffix = "nd"
        elif m == 3
            suffix = "rd"
    "{n}{suffix}"

fn plural(n int, word str) str
    if n == 1
        return "{n} {word}"
    "{n} {word}s"

## How long before or after `now_ms` the time `then_ms` is, both in
## milliseconds: `3 minutes ago`, `in 2 hours`, `just now` (under a second
## either way). The largest unit that fits is used and the count is cut down:
## 90 seconds is `1 minute`, 30 days is `1 month` (30 days), 365 days is
## `1 year` (std.humanize.11).
pub fn relative(then_ms int, now_ms int) str
    delta := now_ms - then_ms
    past := delta >= 0
    mut a := delta
    if not past
        a = 0 - delta
    if a < 1000
        return "just now"
    mut text := ""
    if a < MS_MIN
        text = plural(a / 1000, "second")
    elif a < MS_HOUR
        text = plural(a / MS_MIN, "minute")
    elif a < MS_DAY
        text = plural(a / MS_HOUR, "hour")
    elif a < MS_WEEK
        text = plural(a / MS_DAY, "day")
    elif a < MS_MONTH
        text = plural(a / MS_WEEK, "week")
    elif a < 360 * MS_DAY
        text = plural(a / MS_MONTH, "month")
    else
        mut y := a / MS_YEAR
        if y < 1
            y = 1
        text = plural(y, "year")
    if past
        return "{text} ago"
    "in {text}"
