## std.db.redis (spec std.redis.1-13, ADR 1288): a Redis client over `net.Conn`.
## `redis.connect("redis://host:6379")` (or `rediss://` for TLS 1.3, std.net.13)
## opens a connection that speaks RESP2 and, on request, RESP3. `Reply` is one
## decoded value; `encode` and `decode` are the pure codec. Typed helpers cover
## strings, keys and expiry, hashes, lists, sets and sorted sets; `command`
## sends anything else. A `Pipeline` sends many commands in one write, a
## transaction wraps one in MULTI and EXEC, `subscribe` and `next_message`
## read pub/sub messages, and a `Pool` shares connections between tasks.
##
## Not here: cluster and sentinel, RESP3 client-side caching, streams, scripts
## with typed helpers (send them with `command`), blocking list commands, and
## server-side TLS. A `Client` is used from one task at a time, as a `Conn` is.
use std.net

## Why a call failed.
pub enum RedisKind
    ## The address is not `redis://[user:password@]host[:port][/db]` or `rediss://...`.
    BadUrl
    ## The server refused the password or the user.
    Auth
    ## The server answered with an error (`message` holds its text).
    Server
    ## The bytes read are not RESP.
    Protocol
    ## The reply is valid RESP but not the kind the call expects.
    BadReply
    ## A command was sent on a connection that is subscribed (std.redis.11).
    Subscribed
    ## `next_message` on a connection with no subscription.
    NotSubscribed
    ## The connection is closed, or the server went away.
    Closed
    ## The server made no progress within the timeout (`set_timeout`, std.redis.13).
    TimedOut
    ## The transport failed (connect, TLS, read or write).
    Net

pub error struct RedisError "{self.message}"
    pub kind RedisKind
    pub message str

fn fail(kind RedisKind, message str) RedisError
    RedisError(kind: kind, message: message)

@allow("expr.match.3") fn from_net(e net.NetError) RedisError
    kind := match e.kind
        net.NetKind.Closed => RedisKind.Closed
        net.NetKind.TimedOut => RedisKind.TimedOut
        _ => RedisKind.Net
    RedisError(kind: kind, message: e.message)

## One decoded RESP value (std.redis.2). RESP2 gives `Nil`, `Status`, `Bulk`,
## `Int`, `Failure` and `Array`; RESP3 adds the others.
pub enum Reply
    ## A null: a missing key, a null bulk string, a null array, RESP3 `_`.
    Nil
    ## A simple string (`+OK`).
    Status(line str)
    ## A bulk string, binary safe (a RESP3 verbatim string without its format tag).
    Bulk(data bytes)
    Int(n int)
    Double(x float)
    Bool(b bool)
    ## A RESP3 big number, as its digits.
    BigNum(digits str)
    ## An error reply (`-ERR ...`, RESP3 `!`): the text of the error.
    Failure(message str)
    Array(items List[Reply])
    ## A RESP3 map: `pairs` is key, value, key, value, ...
    Table(pairs List[Reply])
    ## A RESP3 set.
    Members(items List[Reply])
    ## A RESP3 push (out-of-band data such as a pub/sub message).
    Push(items List[Reply])

## The result of `decode`.
pub struct Parsed
    pub reply Reply
    ## The bytes the reply took; 0 when the input holds only part of one.
    pub used int

struct Step
    reply Reply
    ## The index after the reply, or -1 when the input stops inside it.
    upto int

MAX_BULK := 536870912
MAX_ITEMS := 16777216
MAX_DEPTH := 32

## std.redis.2: the bytes of one command as an array of bulk strings, the form
## every request takes.
pub fn encode(args List[str]) bytes
    encode_bytes([a.to_bytes() for a in args])

## std.redis.2: `encode` for arguments that are not text.
pub fn encode_bytes(args List[bytes]) bytes
    mut out := List[u8]()
    out.push_bytes(b"*")
    out.push_bytes("{args.len()}\r\n".to_bytes())
    for a in args
        out.push_bytes(b"$")
        out.push_bytes("{a.len()}\r\n".to_bytes())
        out.push_bytes(a)
        out.push_bytes(b"\r\n")
    bytes.from_list(out)

## The index of the CR of the first CRLF at or after `start`, or -1.
fn line_end(data bytes, start int) int
    n := data.len()
    mut i := start
    while i + 1 < n
        if data[i].to_int() == 13 and data[i + 1].to_int() == 10
            return i
        i += 1
    -1

fn short() Step
    Step(reply: Reply.Nil, upto: -1)

fn bad(what str, got str) RedisError
    return fail(RedisKind.Protocol, "bad {what} in a reply: {got}")

fn parse_at(data bytes, pos int, depth int) Step ! RedisError
    if depth > MAX_DEPTH
        return fail(RedisKind.Protocol, "reply nests deeper than {MAX_DEPTH}")
    if pos >= data.len()
        return short()
    kind := data[pos].to_int()
    eol := line_end(data, pos + 1)
    if eol < 0
        return short()
    head := data[(pos + 1)..eol].text()
    next := eol + 2
    # + simple string
    if kind == 43
        return Step(reply: Reply.Status(head), upto: next)
    # - simple error
    if kind == 45
        return Step(reply: Reply.Failure(head), upto: next)
    # : integer
    if kind == 58
        n := head.to_int() else return bad("integer", head)
        return Step(reply: Reply.Int(n), upto: next)
    # _ null
    if kind == 95
        return Step(reply: Reply.Nil, upto: next)
    # # boolean
    if kind == 35
        if head == "t"
            return Step(reply: Reply.Bool(true), upto: next)
        if head == "f"
            return Step(reply: Reply.Bool(false), upto: next)
        return bad("boolean", head)
    # , double
    if kind == 44
        x := head.to_float() else return bad("double", head)
        return Step(reply: Reply.Double(x), upto: next)
    # ( big number
    if kind == 40
        return Step(reply: Reply.BigNum(head), upto: next)
    # $ bulk string, = verbatim string, ! bulk error
    if kind == 36 or kind == 61 or kind == 33
        n := head.to_int() else return bad("length", head)
        if n < 0
            if kind == 36 and n == -1
                return Step(reply: Reply.Nil, upto: next)
            return bad("length", head)
        if n > MAX_BULK
            return fail(RedisKind.Protocol, "bulk string of {n} bytes is over the limit")
        stop := next + n
        if stop + 2 > data.len()
            return short()
        if data[stop].to_int() != 13 or data[stop + 1].to_int() != 10
            return fail(RedisKind.Protocol, "bulk string is not followed by CRLF")
        body := data[next..stop]
        if kind == 36
            return Step(reply: Reply.Bulk(body), upto: stop + 2)
        if kind == 33
            return Step(reply: Reply.Failure(body.text()), upto: stop + 2)
        if body.len() < 4
            return bad("verbatim string", head)
        return Step(reply: Reply.Bulk(body[4..body.len()]), upto: stop + 2)
    # * array, ~ set, > push, % map
    if kind == 42 or kind == 126 or kind == 62 or kind == 37
        n := head.to_int() else return bad("count", head)
        if n < 0
            if kind == 42 and n == -1
                return Step(reply: Reply.Nil, upto: next)
            return bad("count", head)
        if n > MAX_ITEMS
            return fail(RedisKind.Protocol, "aggregate of {n} items is over the limit")
        total := if kind == 37 then n * 2 else n
        mut items := List[Reply]()
        mut at := next
        for _ in 0..total
            step := parse_at(data, at, depth + 1)?
            if step.upto < 0
                return short()
            items.push(step.reply)
            at = step.upto
        if kind == 42
            return Step(reply: Reply.Array(items), upto: at)
        if kind == 126
            return Step(reply: Reply.Members(items), upto: at)
        if kind == 62
            return Step(reply: Reply.Push(items), upto: at)
        return Step(reply: Reply.Table(items), upto: at)
    return fail(RedisKind.Protocol, "unknown reply type byte {kind}")

## std.redis.2: decodes the first reply in `data`. `used` is 0 when `data` stops
## inside a reply (read more and call again); a byte stream that is not RESP
## fails with kind `Protocol`. Bulk strings over 512 MiB, aggregates over
## 16777216 items and nesting over 32 are refused.
pub fn decode(data bytes) Parsed ! RedisError
    step := parse_at(data, 0, 0)?
    if step.upto < 0
        return Parsed(reply: Reply.Nil, used: 0)
    Parsed(reply: step.reply, used: step.upto)

## Is this a null?
pub fn Reply.is_nil(self) bool
    reply_is_nil(self)

@allow("expr.match.3") fn reply_is_nil(r Reply) bool
    match r
        Reply.Nil => true
        _ => false

## Is this an error reply?
pub fn Reply.is_failure(self) bool
    reply_is_failure(self)

@allow("expr.match.3") fn reply_is_failure(r Reply) bool
    match r
        Reply.Failure(_) => true
        _ => false

## The reply as text: a status, a bulk string (bytes decoded as UTF-8, bad
## bytes replaced), an integer, a double or a big number; none otherwise.
pub fn Reply.as_text(self) str?
    reply_as_text(self)

@allow("expr.match.3") fn reply_as_text(r Reply) str?
    match r
        Reply.Status(line) => line
        Reply.Bulk(data) => data.text()
        Reply.Int(n) => "{n}"
        Reply.Double(x) => "{x}"
        Reply.BigNum(digits) => digits
        _ => none

## The reply as bytes: a bulk string as it is, a status as UTF-8; none otherwise.
pub fn Reply.as_bytes(self) bytes?
    reply_as_bytes(self)

@allow("expr.match.3") fn reply_as_bytes(r Reply) bytes?
    match r
        Reply.Bulk(data) => data
        Reply.Status(line) => line.to_bytes()
        _ => none

## The reply as an integer: an integer, a bool as 1 or 0, or a text that reads as one.
pub fn Reply.as_int(self) int?
    reply_as_int(self)

@allow("expr.match.3") fn reply_as_int(r Reply) int?
    match r
        Reply.Int(n) => n
        Reply.Bool(b) => if b then 1 else 0
        Reply.Status(line) => line.to_int()
        Reply.Bulk(data) => data.text().to_int()
        _ => none

## The reply as a float: a double, an integer, or a text that reads as one.
pub fn Reply.as_float(self) float?
    reply_as_float(self)

@allow("expr.match.3") fn reply_as_float(r Reply) float?
    match r
        Reply.Double(x) => x
        Reply.Int(n) => n.to_float()
        Reply.Status(line) => line.to_float()
        Reply.Bulk(data) => data.text().to_float()
        _ => none

## The reply as a bool: a bool, or an integer other than 0.
pub fn Reply.as_bool(self) bool?
    reply_as_bool(self)

@allow("expr.match.3") fn reply_as_bool(r Reply) bool?
    match r
        Reply.Bool(b) => b
        Reply.Int(n) => n != 0
        _ => none

## Is this a RESP3 push?
pub fn Reply.is_push(self) bool
    reply_is_push(self)

@allow("expr.match.3") fn reply_is_push(r Reply) bool
    match r
        Reply.Push(_) => true
        _ => false

## The elements of an array, set, push or map (a map as key, value, key, ...);
## none for other replies, including `Nil`.
pub fn Reply.as_list(self) List[Reply]?
    reply_as_list(self)

@allow("expr.match.3") fn reply_as_list(r Reply) List[Reply]?
    match r
        Reply.Array(items) => items
        Reply.Members(items) => items
        Reply.Push(items) => items
        Reply.Table(pairs) => pairs
        _ => none

fn server_kind(message str) RedisKind
    if message.starts_with("NOAUTH")
        or message.starts_with("WRONGPASS")
        or message.starts_with("NOPERM")
        return RedisKind.Auth
    RedisKind.Server

@allow("expr.match.3") fn failure_of(r Reply) str?
    match r
        Reply.Failure(message) => message
        _ => none

## An error reply becomes a failure.
fn check(r Reply) ! RedisError
    message := failure_of(r) else
        return
    return fail(server_kind(message), message)

fn expect_int(r Reply) int ! RedisError
    n := r.as_int() else return fail(RedisKind.BadReply, "expected an integer reply")
    n

fn expect_text(r Reply) str ! RedisError
    t := r.as_text() else return fail(RedisKind.BadReply, "expected a string reply")
    t

fn expect_list(r Reply) List[Reply] ! RedisError
    items := r.as_list() else return fail(RedisKind.BadReply, "expected an array reply")
    items

## The elements of an array reply as text; an element that is not text is "".
fn texts(r Reply) List[str] ! RedisError
    mut out := List[str]()
    for item in expect_list(r)?
        out.push(item.as_text() else "")
    out

## What a `rediss://` or `redis://` address says.
struct Target
    tls bool
    host str
    port int
    user str
    password str
    db int
    resp3 bool

fn pct_decode(s str) str
    raw := s.to_bytes()
    mut out := List[u8]()
    mut i := 0
    while i < raw.len()
        if raw[i].to_int() == 37 and i + 2 < raw.len()
            hex := bytes.from_hex(raw[(i + 1)..(i + 3)].text())
            if hex != none
                out.push_bytes(hex else b"")
                i += 3
                continue
        out.push(raw[i])
        i += 1
    bytes.from_list(out).text()

fn parse_url(address str) Target ! RedisError
    tls := address.starts_with("rediss://")
    if not tls and not address.starts_with("redis://")
        return fail(RedisKind.BadUrl, "not a redis:// or rediss:// address: {address}")
    mut rest := address.slice(if tls then 9 else 8, address.len())
    mut resp3 := false
    q := rest.find("?")
    if q != none
        query := rest.slice((q else 0) + 1, rest.len())
        rest = rest.slice(0, q else 0)
        for part in query.split("&")
            if part == "protocol=3" or part == "resp=3"
                resp3 = true
    mut db := 0
    path_at := rest.find("/")
    if path_at != none
        dbtext := rest.slice((path_at else 0) + 1, rest.len())
        rest = rest.slice(0, path_at else 0)
        if dbtext != ""
            db = dbtext.to_int() else return fail(
                RedisKind.BadUrl,
                "bad database number in {address}",
            )
            if db < 0
                return fail(RedisKind.BadUrl, "bad database number in {address}")
    mut user := ""
    mut password := ""
    at := rest.rfind("@")
    if at != none
        info := rest.slice(0, at else 0)
        rest = rest.slice((at else 0) + 1, rest.len())
        colon := info.find(":")
        if colon != none
            user = pct_decode(info.slice(0, colon else 0))
            password = pct_decode(info.slice((colon else 0) + 1, info.len()))
        else
            password = pct_decode(info)
    mut host := rest
    mut port := 6379
    if rest.starts_with("[")
        close := rest.find("]") else return fail(RedisKind.BadUrl, "bad address in {address}")
        host = rest.slice(1, close)
        tail := rest.slice(close + 1, rest.len())
        if tail.starts_with(":")
            port = tail.slice(1, tail.len()).to_int() else return fail(
                RedisKind.BadUrl,
                "bad port in {address}",
            )
        elif tail != ""
            return fail(RedisKind.BadUrl, "bad address in {address}")
    else
        parts := rest.split(":")
        host = parts[0]
        if parts.len() == 2
            port = parts[1].to_int() else return fail(RedisKind.BadUrl, "bad port in {address}")
        elif parts.len() > 2
            return fail(RedisKind.BadUrl, "bad address in {address}")
    if host == "" or port < 1 or port > 65535
        return fail(RedisKind.BadUrl, "bad address in {address}")
    Target(tls: tls, host: host, port: port, user: user, password: password, db: db, resp3: resp3)

## A connection (std.redis.1). Copying it copies the connection handle and the
## unread bytes: use one copy.
pub struct Client
    conn net.Conn
    ## Bytes read and not yet decoded.
    buf bytes
    ## 2 or 3: the protocol the server speaks with this client.
    pub proto int
    ## The channels and patterns this connection is subscribed to.
    subs int
    ## Messages that arrived while a subscription was being confirmed.
    pending List[Message]
    open bool
    address str

## A pub/sub message.
pub enum MsgKind
    ## Sent to a channel this connection subscribed to.
    Channel
    ## Sent to a channel that matches a pattern this connection subscribed to.
    Pattern

pub struct Message
    pub kind MsgKind
    pub channel str
    ## The pattern that matched, `""` for kind `Channel`.
    pub pattern str
    pub data bytes

## The payload as text.
pub fn Message.text(self) str
    self.data.text()

fn dial(t Target) net.Conn ! net.NetError
    if t.tls
        return net.connect_tls(t.host, t.port)?
    net.connect(t.host, t.port)?

## std.redis.1: connects to `redis://[user:password@]host[:port][/db][?protocol=3]`
## (port 6379, database 0, RESP2) or `rediss://...` (TLS 1.3). A password with
## no `:` before it (`redis://secret@host`) is the password of the default
## user; `%XX` in the user and password is decoded. A password sends `AUTH`, a
## database other than 0 sends `SELECT`, and `protocol=3` sends `HELLO 3`
## (which also carries the password). A refused password fails with kind `Auth`.
pub fn connect(address str) Client ! RedisError
    t := parse_url(address)?
    conn := dial(t) else err
        return from_net(err)
    mut c := Client(
        conn: conn,
        buf: b"",
        proto: 2,
        subs: 0,
        pending: List[Message](),
        open: true,
        address: address,
    )
    c.handshake(t) else err
        c.close()
        return err
    c

fn Client.handshake(mut self, t Target) ! RedisError
    if t.resp3
        mut args := ["HELLO", "3"]
        if t.password != ""
            args.push("AUTH")
            args.push(if t.user == "" then "default" else t.user)
            args.push(t.password)
        _ := self.command(args)?
        self.proto = 3
    elif t.password != ""
        mut args := ["AUTH"]
        if t.user != ""
            args.push(t.user)
        args.push(t.password)
        _ := self.command(args)?
    if t.db != 0
        _ := self.command(["SELECT", "{t.db}"])?

## Closes the connection. Later calls fail with kind `Closed`.
pub fn Client.close(self)
    self.conn.close()

## How long a read or write may make no progress, in ms (default 30000). A
## timeout while waiting for a reply closes the connection, because the reply
## may still arrive and be taken for the next one; a timeout in `next_message`
## leaves it open.
pub fn Client.set_timeout(self, ms int)
    self.conn.set_timeout(ms)

fn Client.send(mut self, data bytes) ! RedisError
    if not self.open
        return fail(RedisKind.Closed, "connection is closed")
    self.conn.write_bytes(data) else err
        self.open = false
        self.conn.close()
        return from_net(err)

## The next reply, from the bytes already read or from the connection.
fn Client.read_reply(mut self) Reply ! RedisError
    while true
        got := decode(self.buf) else err
            self.open = false
            self.conn.close()
            return err
        if got.used > 0
            self.buf = self.buf[got.used..self.buf.len()]
            return got.reply
        if not self.open
            return fail(RedisKind.Closed, "connection is closed")
        chunk := self.conn.read_bytes(65536) else err
            e := from_net(err)
            if not (e.kind == RedisKind.TimedOut and self.subs > 0)
                self.open = false
                self.conn.close()
            return e
        if chunk.len() == 0
            self.open = false
            self.conn.close()
            return fail(RedisKind.Closed, "connection closed by the server")
        self.buf = self.buf + chunk
    return fail(RedisKind.Protocol, "unreachable")

## The next reply that is not a push; a push outside a subscription is dropped.
fn Client.read_answer(mut self) Reply ! RedisError
    while true
        r := self.read_reply()?
        if not r.is_push()
            return r
    return fail(RedisKind.Protocol, "unreachable")

## std.redis.3: sends one command and returns its reply. An error reply fails
## with kind `Server` (`Auth` for NOAUTH, WRONGPASS and NOPERM) and its text as
## the message. The arguments are text; `command_bytes` takes bytes.
pub fn Client.command(mut self, args List[str]) Reply ! RedisError
    self.command_bytes([a.to_bytes() for a in args])?

## std.redis.3: `command` with binary arguments.
pub fn Client.command_bytes(mut self, args List[bytes]) Reply ! RedisError
    if self.subs > 0
        return fail(
            RedisKind.Subscribed,
            "connection is subscribed: use next_message, unsubscribe or a second connection",
        )
    self.send(encode_bytes(args))?
    r := self.read_answer()?
    check(r)?
    r

## std.redis.4: `PING`; fails unless the server answers `PONG`.
pub fn Client.ping(mut self) ! RedisError
    r := self.command(["PING"])?
    if expect_text(r)? != "PONG"
        return fail(RedisKind.BadReply, "PING did not answer PONG")

## std.redis.4: `SELECT n`.
pub fn Client.select_db(mut self, n int) ! RedisError
    _ := self.command(["SELECT", "{n}"])?

## std.redis.4: `GET`; none for a missing key.
pub fn Client.get(mut self, key str) str? ! RedisError
    r := self.command(["GET", key])?
    r.as_text()

## std.redis.4: `GET` as bytes.
pub fn Client.get_bytes(mut self, key str) bytes? ! RedisError
    r := self.command(["GET", key])?
    r.as_bytes()

## std.redis.4: `SET key value`.
pub fn Client.set(mut self, key str, value str) ! RedisError
    _ := self.command(["SET", key, value])?

## std.redis.4: `SET` with a binary value.
pub fn Client.set_bytes(mut self, key str, value bytes) ! RedisError
    _ := self.command_bytes([b"SET", key.to_bytes(), value])?

## std.redis.4: `SET key value EX secs`: the key expires after `secs` seconds.
pub fn Client.set_ex(mut self, key str, value str, secs int) ! RedisError
    _ := self.command(["SET", key, value, "EX", "{secs}"])?

## std.redis.4: `SET key value NX`: sets the key only if it does not exist and
## says whether it did. With `secs` over 0 the key also expires.
pub fn Client.set_nx(mut self, key str, value str, secs int) bool ! RedisError
    mut args := ["SET", key, value, "NX"]
    if secs > 0
        args.push("EX")
        args.push("{secs}")
    r := self.command(args)?
    not r.is_nil()

## std.redis.4: `DEL`; the number of keys removed.
pub fn Client.del(mut self, keys List[str]) int ! RedisError
    mut args := ["DEL"]
    args.extend(keys)
    expect_int(self.command(args)?)?

## std.redis.4: `EXISTS key`.
pub fn Client.exists(mut self, key str) bool ! RedisError
    expect_int(self.command(["EXISTS", key])?)? > 0

## std.redis.4: `INCR`; the new value.
pub fn Client.incr(mut self, key str) int ! RedisError
    expect_int(self.command(["INCR", key])?)?

## std.redis.4: `DECR`; the new value.
pub fn Client.decr(mut self, key str) int ! RedisError
    expect_int(self.command(["DECR", key])?)?

## std.redis.4: `INCRBY`; the new value (`delta` may be negative).
pub fn Client.incr_by(mut self, key str, delta int) int ! RedisError
    expect_int(self.command(["INCRBY", key, "{delta}"])?)?

## std.redis.4: `APPEND`; the new length of the value.
pub fn Client.append(mut self, key str, value str) int ! RedisError
    expect_int(self.command(["APPEND", key, value])?)?

## std.redis.4: `STRLEN`; 0 for a missing key.
pub fn Client.strlen(mut self, key str) int ! RedisError
    expect_int(self.command(["STRLEN", key])?)?

## std.redis.5: `EXPIRE`; false when the key does not exist.
pub fn Client.expire(mut self, key str, secs int) bool ! RedisError
    expect_int(self.command(["EXPIRE", key, "{secs}"])?)? == 1

## std.redis.5: `PEXPIRE`, in milliseconds.
pub fn Client.pexpire(mut self, key str, ms int) bool ! RedisError
    expect_int(self.command(["PEXPIRE", key, "{ms}"])?)? == 1

## std.redis.5: `TTL`: seconds left, -1 when the key has no expiry, -2 when it
## does not exist.
pub fn Client.ttl(mut self, key str) int ! RedisError
    expect_int(self.command(["TTL", key])?)?

## std.redis.5: `PERSIST`; true when an expiry was removed.
pub fn Client.persist(mut self, key str) bool ! RedisError
    expect_int(self.command(["PERSIST", key])?)? == 1

## std.redis.5: `KEYS pattern`. Scans the whole keyspace and blocks the
## server: use `scan` on a large database.
pub fn Client.keys(mut self, pattern str) List[str] ! RedisError
    texts(self.command(["KEYS", pattern])?)?

## One page of `scan`.
pub struct ScanPage
    ## Pass it to the next `scan`; 0 means the scan is complete.
    pub cursor int
    pub keys List[str]

## std.redis.5: `SCAN cursor MATCH pattern COUNT count` (start with cursor 0;
## an empty `pattern` matches every key).
pub fn Client.scan(mut self, cursor int, pattern str, count int) ScanPage ! RedisError
    mut args := ["SCAN", "{cursor}"]
    if pattern != ""
        args.push("MATCH")
        args.push(pattern)
    if count > 0
        args.push("COUNT")
        args.push("{count}")
    parts := expect_list(self.command(args)?)?
    if parts.len() != 2
        return fail(RedisKind.BadReply, "SCAN did not answer a cursor and a list")
    next := parts[0].as_int() else return fail(RedisKind.BadReply, "SCAN cursor is not a number")
    ScanPage(cursor: next, keys: texts(parts[1])?)

## std.redis.6: `HSET key field value`; the number of fields added (0 when it
## replaced one).
pub fn Client.hset(mut self, key str, field str, value str) int ! RedisError
    expect_int(self.command(["HSET", key, field, value])?)?

## std.redis.6: `HSET` with many fields.
pub fn Client.hset_all(mut self, key str, fields Map[str, str]) int ! RedisError
    mut args := ["HSET", key]
    for name in fields.keys().sorted()
        args.push(name)
        args.push(fields.get(name) else "")
    expect_int(self.command(args)?)?

## std.redis.6: `HGET`; none when the key or field is missing.
pub fn Client.hget(mut self, key str, field str) str? ! RedisError
    r := self.command(["HGET", key, field])?
    r.as_text()

## std.redis.6: `HGETALL` as a map (empty for a missing key). Both RESP2 and
## RESP3 forms are read.
pub fn Client.hgetall(mut self, key str) Map[str, str] ! RedisError
    items := expect_list(self.command(["HGETALL", key])?)?
    mut out := Map[str, str]()
    mut i := 0
    while i + 1 < items.len()
        out[(items[i].as_text() else "")] = items[i + 1].as_text() else ""
        i += 2
    out

## std.redis.6: `HDEL`; the number of fields removed.
pub fn Client.hdel(mut self, key str, fields List[str]) int ! RedisError
    mut args := ["HDEL", key]
    args.extend(fields)
    expect_int(self.command(args)?)?

## std.redis.6: `HEXISTS`.
pub fn Client.hexists(mut self, key str, field str) bool ! RedisError
    expect_int(self.command(["HEXISTS", key, field])?)? == 1

## std.redis.6: `HINCRBY`; the new value.
pub fn Client.hincr_by(mut self, key str, field str, delta int) int ! RedisError
    expect_int(self.command(["HINCRBY", key, field, "{delta}"])?)?

## std.redis.6: `HKEYS`.
pub fn Client.hkeys(mut self, key str) List[str] ! RedisError
    texts(self.command(["HKEYS", key])?)?

## std.redis.6: `HLEN`.
pub fn Client.hlen(mut self, key str) int ! RedisError
    expect_int(self.command(["HLEN", key])?)?

## std.redis.7: `LPUSH`; the new length.
pub fn Client.lpush(mut self, key str, values List[str]) int ! RedisError
    mut args := ["LPUSH", key]
    args.extend(values)
    expect_int(self.command(args)?)?

## std.redis.7: `RPUSH`; the new length.
pub fn Client.rpush(mut self, key str, values List[str]) int ! RedisError
    mut args := ["RPUSH", key]
    args.extend(values)
    expect_int(self.command(args)?)?

## std.redis.7: `LPOP`; none when the list is empty or missing.
pub fn Client.lpop(mut self, key str) str? ! RedisError
    r := self.command(["LPOP", key])?
    r.as_text()

## std.redis.7: `RPOP`; none when the list is empty or missing.
pub fn Client.rpop(mut self, key str) str? ! RedisError
    r := self.command(["RPOP", key])?
    r.as_text()

## std.redis.7: `LLEN`.
pub fn Client.llen(mut self, key str) int ! RedisError
    expect_int(self.command(["LLEN", key])?)?

## std.redis.7: `LRANGE`; `stop` -1 is the last element.
pub fn Client.lrange(mut self, key str, start int, stop int) List[str] ! RedisError
    texts(self.command(["LRANGE", key, "{start}", "{stop}"])?)?

## std.redis.8: `SADD`; the number of members added.
pub fn Client.sadd(mut self, key str, members List[str]) int ! RedisError
    mut args := ["SADD", key]
    args.extend(members)
    expect_int(self.command(args)?)?

## std.redis.8: `SREM`; the number of members removed.
pub fn Client.srem(mut self, key str, members List[str]) int ! RedisError
    mut args := ["SREM", key]
    args.extend(members)
    expect_int(self.command(args)?)?

## std.redis.8: `SMEMBERS`, in the order the server sends them.
pub fn Client.smembers(mut self, key str) List[str] ! RedisError
    texts(self.command(["SMEMBERS", key])?)?

## std.redis.8: `SISMEMBER`.
pub fn Client.sismember(mut self, key str, member str) bool ! RedisError
    expect_int(self.command(["SISMEMBER", key, member])?)? == 1

## std.redis.8: `SCARD`.
pub fn Client.scard(mut self, key str) int ! RedisError
    expect_int(self.command(["SCARD", key])?)?

## A sorted-set member with its score.
pub struct Scored
    pub member str
    pub score float

## std.redis.8: `ZADD key score member`; the number of members added (0 when
## it updated the score of one).
pub fn Client.zadd(mut self, key str, score float, member str) int ! RedisError
    expect_int(self.command(["ZADD", key, "{score}", member])?)?

## std.redis.8: `ZREM`; the number of members removed.
pub fn Client.zrem(mut self, key str, members List[str]) int ! RedisError
    mut args := ["ZREM", key]
    args.extend(members)
    expect_int(self.command(args)?)?

## std.redis.8: `ZRANGE`: members by rank, lowest score first; `stop` -1 is the last.
pub fn Client.zrange(mut self, key str, start int, stop int) List[str] ! RedisError
    texts(self.command(["ZRANGE", key, "{start}", "{stop}"])?)?

## std.redis.8: `ZRANGE ... WITHSCORES`. Both RESP2 (a flat list) and RESP3
## (a list of pairs) are read.
pub fn Client.zrange_scored(mut self, key str, start int, stop int) List[Scored] ! RedisError
    items := expect_list(self.command(["ZRANGE", key, "{start}", "{stop}", "WITHSCORES"])?)?
    mut out := List[Scored]()
    mut i := 0
    while i < items.len()
        pair := items[i].as_list()
        if pair != none
            both := pair else List[Reply]()
            if both.len() != 2
                return fail(RedisKind.BadReply, "ZRANGE WITHSCORES pair is not two elements")
            out.push(Scored(member: both[0].as_text() else "", score: both[1].as_float() else 0.0))
            i += 1
        else
            if i + 1 >= items.len()
                return fail(RedisKind.BadReply, "ZRANGE WITHSCORES list has an odd length")
            out.push(Scored(
                member: items[i].as_text() else "",
                score: items[i + 1].as_float() else 0.0,
            ))
            i += 2
    out

## std.redis.8: `ZSCORE`; none when the key or member is missing.
pub fn Client.zscore(mut self, key str, member str) float? ! RedisError
    r := self.command(["ZSCORE", key, member])?
    r.as_float()

## std.redis.8: `ZRANK` (0 is the lowest score); none when the member is missing.
pub fn Client.zrank(mut self, key str, member str) int? ! RedisError
    r := self.command(["ZRANK", key, member])?
    r.as_int()

## std.redis.8: `ZCARD`.
pub fn Client.zcard(mut self, key str) int ! RedisError
    expect_int(self.command(["ZCARD", key])?)?

## std.redis.8: `ZINCRBY`; the new score.
pub fn Client.zincr_by(mut self, key str, delta float, member str) float ! RedisError
    r := self.command(["ZINCRBY", key, "{delta}", member])?
    score := r.as_float() else return fail(RedisKind.BadReply, "ZINCRBY did not answer a score")
    score

## std.redis.9: `PUBLISH`; the number of subscribers that received the message.
pub fn Client.publish(mut self, channel str, message str) int ! RedisError
    expect_int(self.command(["PUBLISH", channel, message])?)?

## A batch of commands for `run` and `transaction` (std.redis.10).
pub struct Pipeline
    cmds List[bytes]

## std.redis.10: an empty pipeline.
pub fn pipeline() Pipeline
    Pipeline(cmds: List[bytes]())

## std.redis.10: queues a command.
pub fn Pipeline.add(mut self, args List[str])
    self.cmds.push(encode(args))

## std.redis.10: queues a command with binary arguments.
pub fn Pipeline.add_bytes(mut self, args List[bytes])
    self.cmds.push(encode_bytes(args))

## std.redis.10: how many commands are queued.
pub fn Pipeline.len(self) int
    self.cmds.len()

## std.redis.10: sends every queued command in one write and returns the
## replies in order. A server error is a `Reply.Failure` in the list, not a
## failure of the call: look at each one. An empty pipeline returns an empty
## list. The pipeline is not cleared.
pub fn Client.run(mut self, p Pipeline) List[Reply] ! RedisError
    mut out := List[Reply]()
    if p.cmds.len() == 0
        return out
    if self.subs > 0
        return fail(RedisKind.Subscribed, "connection is subscribed")
    mut wire := List[u8]()
    for cmd in p.cmds
        wire.push_bytes(cmd)
    self.send(bytes.from_list(wire))?
    for _ in 0..p.cmds.len()
        out.push(self.read_answer()?)
    out

## std.redis.10: `MULTI`, the queued commands, `EXEC`: the replies of the
## commands in order, applied together. A queued command the server rejects
## fails the call with kind `Server` (the transaction is discarded). An empty
## list means the transaction was aborted (a WATCHed key changed).
pub fn Client.transaction(mut self, p Pipeline) List[Reply] ! RedisError
    mut wrapped := pipeline()
    wrapped.add(["MULTI"])
    for cmd in p.cmds
        wrapped.cmds.push(cmd)
    wrapped.add(["EXEC"])
    replies := self.run(wrapped)?
    for r in replies
        check(r)?
    last := replies[replies.len() - 1]
    last.as_list() else List[Reply]()

fn to_message(r Reply) Message?
    items := r.as_list() else return none
    if items.len() == 3 and (items[0].as_text() else "") == "message"
        return Message(
            kind: MsgKind.Channel,
            channel: items[1].as_text() else "",
            pattern: "",
            data: items[2].as_bytes() else b"",
        )
    if items.len() == 4 and (items[0].as_text() else "") == "pmessage"
        return Message(
            kind: MsgKind.Pattern,
            channel: items[2].as_text() else "",
            pattern: items[1].as_text() else "",
            data: items[3].as_bytes() else b"",
        )
    none

## Sends SUBSCRIBE, PSUBSCRIBE, UNSUBSCRIBE or PUNSUBSCRIBE and reads one
## confirmation per name; messages that arrive meanwhile wait in `pending`.
fn Client.sub_command(mut self, word str, names List[str]) ! RedisError
    if names.len() == 0
        return fail(RedisKind.BadReply, "{word} needs at least one name")
    mut args := List[str]()
    args.push(word)
    args.extend(names)
    self.send(encode(args))?
    mut seen := 0
    while seen < names.len()
        r := self.read_reply()?
        check(r)?
        m := to_message(r)
        if m != none
            self.pending.push(m else Message(
                kind: MsgKind.Channel,
                channel: "",
                pattern: "",
                data: b"",
            ))
            continue
        items := r.as_list() else continue
        if items.len() >= 3 and (items[0].as_text() else "") == word.to_lower()
            self.subs = items[2].as_int() else 0
            seen += 1

## std.redis.11: subscribes to channels. The connection can then only call
## `subscribe`, `psubscribe`, `unsubscribe`, `punsubscribe` and `next_message`;
## any other call fails with kind `Subscribed`. Use a second connection (or a
## pool) for commands.
pub fn Client.subscribe(mut self, channels List[str]) ! RedisError
    self.sub_command("SUBSCRIBE", channels)?

## std.redis.11: subscribes to channels that match glob patterns (`news.*`).
pub fn Client.psubscribe(mut self, patterns List[str]) ! RedisError
    self.sub_command("PSUBSCRIBE", patterns)?

## std.redis.11: ends subscriptions to the named channels; the connection
## returns to command mode when none is left.
pub fn Client.unsubscribe(mut self, channels List[str]) ! RedisError
    self.sub_command("UNSUBSCRIBE", channels)?

## std.redis.11: ends subscriptions to the named patterns.
pub fn Client.punsubscribe(mut self, patterns List[str]) ! RedisError
    self.sub_command("PUNSUBSCRIBE", patterns)?

## std.redis.11: how many channels and patterns the connection is subscribed to.
pub fn Client.subscriptions(self) int
    self.subs

## std.redis.11: waits for the next message. Confirmations and other replies
## are skipped. A wait longer than the timeout fails with kind `TimedOut` and
## leaves the connection open, so a loop can check for a stop request and call
## again.
pub fn Client.next_message(mut self) Message ! RedisError
    if self.subs == 0 and self.pending.len() == 0
        return fail(RedisKind.NotSubscribed, "connection has no subscription")
    while true
        if self.pending.len() > 0
            first := self.pending[0]
            self.pending = self.pending[1..self.pending.len()]
            return first
        r := self.read_reply()?
        check(r)?
        m := to_message(r) else
            continue
        return m
    return fail(RedisKind.Protocol, "unreachable")

## A set of connections that tasks share (std.redis.12). Created by `pool`.
pub struct Pool
    address str
    free Channel[Client]

## std.redis.12: opens `size` connections to `address`. `get` takes one and
## `put` gives it back, so at most `size` tasks use the server at once.
pub fn pool(address str, size int) Pool ! RedisError
    if size < 1
        return fail(RedisKind.BadUrl, "a pool needs at least one connection")
    free := Channel[Client](size)
    for _ in 0..size
        c := connect(address) else err
            while true
                got := free.try_recv() else break
                got.close()
            return err
        free.send(c)
    Pool(address: address, free: free)

## std.redis.12: takes a connection, waiting up to 30 seconds for one to be
## free; kind `TimedOut` when none is, or the pool is closed.
pub fn Pool.get(self) Client ! RedisError
    c := self.free.recv_for(30000) else return fail(
        RedisKind.TimedOut,
        "no connection free in the pool, or the pool is closed",
    )
    c

## std.redis.12: gives a connection back. One that failed, or is subscribed,
## is closed and replaced by a new connection.
pub fn Pool.put(self, c Client) ! RedisError
    if c.open and c.subs == 0
        self.free.send(c)
        return
    c.close()
    fresh := connect(self.address)?
    self.free.send(fresh)

## std.redis.12: closes the idle connections and the pool. Connections taken
## and not yet returned stay open until their holders close them.
pub fn Pool.close(self)
    self.free.close()
    while true
        got := self.free.try_recv() else break
        got.close()
