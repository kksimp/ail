## std.args (spec std.args.1-6 and 9-14, ADRs 0627, 1068, 0777 and TBD): command-line flags, options and
## positionals from a list of specs, with generated help; repeated and counted
## flags, `-vq` bundles, environment fallbacks, `--version`, subcommands,
## "did you mean" hints and shell completion scripts.
##
##     spec := [args.flag("verbose", "v", "more output"), args.opt("out", "o", "where to write", "a.txt"), args.pos("input", "file to read")]
##     a := args.parse("tool", "what it does", spec, env.args())?
##     a.flag("verbose"); a.get("out"); a.get("input"); a.rest

## What was wrong with the command line, with the usage text (std.args.6).
pub error struct ArgsError "{self.why}\n{self.usage}"
    pub why str
    pub usage str

## One accepted argument: made by `flag`, `opt`, `pos`, `rest`, `count`, `many`
## or `version`.
pub struct Spec
    pub kind SpecKind
    pub name str
    pub short str
    pub help str
    pub default str
    ## The environment variable read when the option is absent (std.args.10); "" for none.
    pub envvar str

## Which builder made a `Spec` (std.args.1-2, ADR 1068, std.args.9, std.args.12).
pub enum SpecKind
    Flag
    Opt
    Pos
    Rest
    Count
    Many
    Version

## What the command line said (std.args.4).
pub struct Args
    values Map[str, str]
    flags Set[str]
    given Set[str]
    lists Map[str, List[str]]
    counts Map[str, int]
    text str
    ## The words left over after the named positionals, in order.
    pub rest List[str]

## A switch: `--NAME` or `-SHORT`; `short` may be "" (std.args.1).
pub fn flag(name str, short str, help str) Spec
    Spec(kind: Flag, name: name, short: short, help: help, default: "", envvar: "")

## An option that takes a value: `--NAME V`, `--NAME=V` or `-SHORT V`;
## `default` is its value when absent (std.args.1).
pub fn opt(name str, short str, help str, default str) Spec
    Spec(kind: Opt, name: name, short: short, help: help, default: default, envvar: "")

## A required positional word, in the order the specs list them (std.args.2).
pub fn pos(name str, help str) Spec
    Spec(kind: Pos, name: name, short: "", help: help, default: "", envvar: "")

## Collects every positional word after the required ones into `rest`
## (std.args.2).
pub fn rest(name str, help str) Spec
    Spec(kind: Rest, name: name, short: "", help: help, default: "", envvar: "")

## A switch that counts: `-vvv` or `--verbose --verbose` is 2 more than
## none; read it with `Args.count` (std.args.9).
pub fn count(name str, short str, help str) Spec
    Spec(kind: Count, name: name, short: short, help: help, default: "", envvar: "")

## An option that may repeat: every value is kept, in order; read them with
## `Args.all` (std.args.9).
pub fn many(name str, short str, help str) Spec
    Spec(kind: Many, name: name, short: short, help: help, default: "", envvar: "")

## `--version` and `-V` print `text` and exit with status 0 (std.args.12).
pub fn version(text str) Spec
    Spec(kind: Version, name: "version", short: "V", help: "print the version", default: text, envvar: "")

## The same spec, read from environment variable `var` when the command line
## leaves it out (std.args.10).
pub fn Spec.with_env(self, var str) Spec
    Spec(kind: self.kind, name: self.name, short: self.short, help: self.help, default: self.default, envvar: var)

## Whether option or positional `name` was given on the command line
## (std.args.8).
pub fn Args.has(self, name str) bool
    self.given.contains(name)

## Option or positional `name` as a `str`, `none` when absent (std.args.8).
pub fn Args.opt(self, name str) str?
    if self.given.contains(name)
        return self.values.get(name)
    none

## `name` as an `int`; text that isn't one is an `ArgsError` (std.args.8).
pub fn Args.int(self, name str) int ! ArgsError
    v := self.values.get(name) else ""
    got := v.to_int()
    n := got else
        return ArgsError(why: "{name} needs an integer, got `{v}`", usage: self.text)
    n

## `name` as a `float` (std.args.8).
pub fn Args.float(self, name str) float ! ArgsError
    v := self.values.get(name) else ""
    got := v.to_float()
    n := got else
        return ArgsError(why: "{name} needs a number, got `{v}`", usage: self.text)
    n

## `name` as an `int` when given and a number, else `none` (std.args.8).
pub fn Args.opt_int(self, name str) int?
    if self.given.contains(name)
        return self.values.get(name)?.to_int()
    none

## `name` as a `float` when given and a number, else `none` (std.args.8).
pub fn Args.opt_float(self, name str) float?
    if self.given.contains(name)
        return self.values.get(name)?.to_float()
    none

## Whether switch `name` was given (std.args.4).
pub fn Args.flag(self, name str) bool
    self.flags.contains(name)

## The value of option or positional `name`; its default when absent
## (std.args.4).
pub fn Args.get(self, name str) str
    self.values.get(name) else ""

## Every value of a `many` option, in the order given; empty when absent
## (std.args.9).
pub fn Args.all(self, name str) List[str]
    self.lists.get(name) else List[str]()

## How many times a `count` switch was given (std.args.9).
pub fn Args.count(self, name str) int
    self.counts.get(name) else 0

fn takes_value(s Spec) bool
    s.kind == Opt or s.kind == Many

fn is_switch(s Spec) bool
    s.kind == Flag or s.kind == Count or s.kind == Version

fn is_named(s Spec) bool
    s.kind != Pos and s.kind != Rest

fn truthy(v str) bool
    w := v.to_lower()
    w == "1" or w == "true" or w == "yes" or w == "on"

## Edits between two words: a character inserted, deleted or changed.
fn dist(a str, b str) int
    x := a.chars()
    y := b.chars()
    mut prev := [j for j in 0..y.len() + 1]
    for i in 1..x.len() + 1
        mut cur := [i for _ in 0..y.len() + 1]
        for j in 1..y.len() + 1
            cost := if x[i - 1] != y[j - 1] then 1 else 0
            cur[j] = (prev[j] + 1).min(cur[j - 1] + 1).min(prev[j - 1] + cost)
        prev = cur
    prev[y.len()]

## The closest candidate to `word` within about a third of its length, or `none`
## (std.args.11).
fn nearest(word str, candidates List[str]) str?
    limit := ((word.len() + 1) / 3).max(1)
    mut best := ""
    mut best_d := limit + 1
    for c in candidates
        if c == word
            continue
        d := dist(word, c)
        if d < best_d or (d == best_d and c < best)
            best = c
            best_d = d
    if best_d <= limit then best else none

fn long_names(specs List[Spec]) List[str]
    mut out := ["help"]
    for s in specs
        if is_named(s)
            out.push(s.name)
    out

fn unknown_long(w str, key str, specs List[Spec]) str
    hit := nearest(key, long_names(specs))
    best := hit else
        return "unknown option {w}"
    "unknown option {w}, did you mean --{best}?"

## The usage text `--help` prints (std.args.5).
pub fn usage(name str, about str, specs List[Spec]) str
    mut line := "usage: {name}"
    mut body := ""
    for s in specs
        if s.kind == Pos
            line = "{line} {s.name.to_upper()}"
        elif s.kind == Rest
            line = "{line} [{s.name.to_upper()}...]"
        elif s.kind != Version
            line = "{line} [--{s.name}]"
        label := if s.short == "" then "--{s.name}" else "-{s.short}, --{s.name}"
        mut label2 := label
        if takes_value(s)
            label2 = "{label} V"
        elif not is_switch(s)
            label2 = s.name.to_upper()
        dflt := if s.kind == Opt and s.default != "" then " (default {s.default})" else ""
        again := if s.kind == Many then " (repeatable)" else ""
        via := if s.envvar != "" then " (env {s.envvar})" else ""
        body = "{body}  {label2.pad_right(22, ' ')}{s.help}{dflt}{again}{via}\n"
    "{line}\n{about}\n\n{body}  {"-h, --help".pad_right(22, ' ')}show this help\n"

fn find_long(specs List[Spec], name str) Spec?
    for s in specs
        if s.name == name and is_named(s)
            return s
    none

fn has_short(specs List[Spec], short str) bool
    for s in specs
        if s.short == short and is_named(s)
            return true
    false

fn find_short(specs List[Spec], short str) Spec?
    for s in specs
        if s.short == short and short != "" and is_named(s)
            return s
    none

## What the command line has set so far.
struct State
    values Map[str, str]
    flags Set[str]
    given Set[str]
    lists Map[str, List[str]]
    counts Map[str, int]

fn State.hit(mut self, s Spec)
    if s.kind == Count
        n := self.counts.get(s.name) else 0
        self.counts[s.name] = n + 1
    self.flags.add(s.name)

fn State.put(mut self, s Spec, v str)
    if s.kind == Many
        mut l := self.lists.get(s.name) else List[str]()
        l.push(v)
        self.lists[s.name] = l
    self.values[s.name] = v
    self.given.add(s.name)

## Reads `words` against `specs`; `text` is the usage text its errors carry.
fn read_words(text str, specs List[Spec], words List[str], vars Map[str, str]) Args ! ArgsError
    mut values := Map[str, str]()
    for s in specs
        if s.kind == Opt
            values[s.name] = s.default
    mut st := State(values: values, flags: Set[str](), given: Set[str](), lists: Map[str, List[str]](), counts: Map[str, int]())
    mut positional := List[str]()
    mut i := 0
    mut literal := false
    while i < words.len()
        w := words[i]
        i += 1
        if literal or not w.starts_with("-") or w == "-"
            positional.push(w)
        elif w == "--"
            literal = true
        elif w == "--help" or w == "-h"
            print(text)
            io.exit(0)
        elif w.starts_with("--")
            body := w.slice(2, w.len())
            eq := body.find("=") else -1
            key := if eq >= 0 then body.slice(0, eq) else body
            inline := if eq >= 0 then body.slice(eq + 1, body.len()) else ""
            found := find_long(specs, key)
            s := found else
                return ArgsError(why: unknown_long(w, key, specs), usage: text)
            if s.kind == Version
                print(s.default)
                io.exit(0)
            if is_switch(s)
                if inline != ""
                    return ArgsError(why: "--{s.name} takes no value", usage: text)
                st.hit(s)
            elif eq >= 0
                st.put(s, inline)
            elif i < words.len()
                st.put(s, words[i])
                i += 1
            else
                return ArgsError(why: "--{s.name} needs a value", usage: text)
        else
            # `-S`, a bundle of switches `-vq`, or an option with its value
            # attached or next: `-n5`, `-n 5` (std.args.9).
            body := w.slice(1, w.len())
            n := body.len()
            mut j := 0
            while j < n
                c := body.slice(j, j + 1)
                found := find_short(specs, c)
                if c == "h" and not has_short(specs, c)
                    print(text)
                    io.exit(0)
                s := found else
                    why := if n == 1 then "unknown option {w}" else "unknown option -{c} in {w}"
                    return ArgsError(why: why, usage: text)
                j += 1
                if s.kind == Version
                    print(s.default)
                    io.exit(0)
                if is_switch(s)
                    st.hit(s)
                else
                    tail := body.slice(j, n)
                    if tail != ""
                        st.put(s, tail)
                    elif i < words.len()
                        st.put(s, words[i])
                        i += 1
                    else
                        return ArgsError(why: "--{s.name} needs a value", usage: text)
                    j = n
    # std.args.10: an environment variable fills what the command line left out.
    for s in specs
        if s.envvar != "" and is_named(s) and not st.given.contains(s.name) and not st.flags.contains(s.name)
            if v := vars.get(s.envvar)
                if takes_value(s)
                    st.put(s, v)
                elif truthy(v)
                    st.hit(s)
    mut next := 0
    for s in specs
        if s.kind == Pos
            if next >= positional.len()
                return ArgsError(why: "missing {s.name.to_upper()}", usage: text)
            st.put(s, positional[next])
            next += 1
    left := positional[next..]
    mut has_rest := false
    for s in specs
        if s.kind == Rest
            has_rest = true
    if left.len() > 0 and not has_rest
        return ArgsError(why: "unexpected argument {left[0]}", usage: text)
    Args(values: st.values, flags: st.flags, given: st.given, lists: st.lists, counts: st.counts, text: text, rest: left)

## Reads `words` (usually `env.args()`) against `specs`. `--help` or `-h`
## prints the usage and exits 0. A bare `--` makes every later word a
## positional (std.args.3, std.args.6).
pub fn parse(name str, about str, specs List[Spec], words List[str]) Args ! ArgsError
    read_words(usage(name, about, specs), specs, words, Map[str, str]())

## `parse` with environment fallbacks: `vars` (usually `env.vars()`) supplies
## the value of an option or switch whose spec has `with_env` and which the
## command line leaves out (std.args.10).
pub fn parse_env(name str, about str, specs List[Spec], words List[str], vars Map[str, str]) Args ! ArgsError
    read_words(usage(name, about, specs), specs, words, vars)

## One subcommand: its name, a one-line description and its own specs
## (std.args.13).
pub struct Command
    pub name str
    pub about str
    pub specs List[Spec]

## A subcommand for `parse_commands` (std.args.13).
pub fn command(name str, about str, specs List[Spec]) Command
    Command(name: name, about: about, specs: specs)

## The subcommand that was chosen and what its words said (std.args.13).
pub struct Parsed
    pub command str
    pub opts Args

## The usage text of a tool with subcommands (std.args.13).
pub fn commands_usage(name str, about str, ver str, commands List[Command]) str
    mut body := ""
    for c in commands
        body = "{body}  {c.name.pad_right(22, ' ')}{c.about}\n"
    body = "{body}  {"help [COMMAND]".pad_right(22, ' ')}show help for a command\n"
    mut optline := "  {"-h, --help".pad_right(22, ' ')}show this help\n"
    if ver != ""
        optline = "{optline}  {"-V, --version".pad_right(22, ' ')}print the version\n"
    "usage: {name} COMMAND [ARGS]\n{about}\n\ncommands:\n{body}\noptions:\n{optline}"

fn command_names(commands List[Command]) List[str]
    mut out := ["help"]
    for c in commands
        out.push(c.name)
    out

fn find_command(commands List[Command], name str) Command?
    for c in commands
        if c.name == name
            return c
    none

## Reads `words`: the first is the subcommand, the rest are that subcommand's
## own flags, options and positionals. `--help`, `-h` or `help` prints the
## command list and exits 0; `help NAME` prints that command's usage;
## `--version` and `-V` print `version` when it isn't "". An unknown command
## is an error with a "did you mean" hint. `vars` is the environment for
## `with_env` specs (std.args.10), `Map[str, str]()` for none (std.args.13).
pub fn parse_commands(name str, about str, ver str, commands List[Command], words List[str], vars Map[str, str]) Parsed ! ArgsError
    top := commands_usage(name, about, ver, commands)
    if words.len() == 0
        return ArgsError(why: "missing COMMAND", usage: top)
    first := words[0]
    if first == "--help" or first == "-h" or (first == "help" and words.len() == 1)
        print(top)
        io.exit(0)
    if ver != "" and (first == "--version" or first == "-V")
        print(ver)
        io.exit(0)
    if first == "help"
        target := words[1]
        got := find_command(commands, target)
        c := got else
            return ArgsError(why: "unknown command {target}", usage: top)
        print(usage("{name} {c.name}", c.about, c.specs))
        io.exit(0)
    found := find_command(commands, first)
    c := found else
        mut why := "unknown command {first}"
        if h := nearest(first, command_names(commands))
            why = "unknown command {first}, did you mean {h}?"
        return ArgsError(why: why, usage: top)
    a := read_words(usage("{name} {c.name}", c.about, c.specs), c.specs, words[1..], vars)?
    Parsed(command: c.name, opts: a)

fn shell_name(name str) str
    name.replace("-", "_").replace(".", "_")

## Keeps help text safe inside the quotes of a completion script.
fn quote_safe(s str) str
    s.replace("'", "").replace("[", "(").replace("]", ")")

fn flag_words(specs List[Spec]) List[str]
    mut out := ["--help", "-h"]
    for s in specs
        if is_named(s)
            out.push("--{s.name}")
            if s.short != ""
                out.push("-{s.short}")
    out

fn zsh_lines(specs List[Spec], pad str) str
    mut out := ""
    for s in specs
        if is_named(s)
            h := quote_safe(s.help)
            tail := if takes_value(s) then ":value:" else ""
            eq := if takes_value(s) then "=" else ""
            out = "{out}{pad}'--{s.name}{eq}[{h}]{tail}' \\\n"
            if s.short != ""
                out = "{out}{pad}'-{s.short}[{h}]{tail}' \\\n"
    "{out}{pad}'--help[show this help]'"

fn fish_lines(name str, cond str, specs List[Spec]) str
    mut out := ""
    for s in specs
        if is_named(s)
            short := if s.short == "" then "" else " -s {s.short}"
            need := if takes_value(s) then " -r" else ""
            out = "{out}complete -c {name}{cond} -l {s.name}{short}{need} -d '{quote_safe(s.help)}'\n"
    out

fn bad_shell(shell str) ArgsError
    ArgsError(why: "unknown shell `{shell}`; use bash, zsh or fish", usage: "")

## A completion script for `shell` (`bash`, `zsh` or `fish`) that completes
## the flags and options of `specs` for the program `name`; print it and
## source it, or save it where the shell looks (std.args.14).
pub fn completion(shell str, name str, specs List[Spec]) str ! ArgsError
    fname := shell_name(name)
    if shell == "bash"
        return "_{fname}() \{\n    local cur=$\{COMP_WORDS[COMP_CWORD]}\n    COMPREPLY=( $(compgen -W \"{flag_words(specs).join(" ")}\" -- \"$cur\") )\n}\ncomplete -F _{fname} {name}\n"
    if shell == "zsh"
        return "#compdef {name}\n_arguments \\\n{zsh_lines(specs, "  ")}\n"
    if shell == "fish"
        return fish_lines(name, "", specs)
    return bad_shell(shell)

## `completion` for a tool with subcommands: the command names first, then
## each command's own flags and options (std.args.14).
pub fn completion_commands(shell str, name str, commands List[Command]) str ! ArgsError
    fname := shell_name(name)
    if shell == "bash"
        mut arms := ""
        for c in commands
            arms = "{arms}        {c.name}) COMPREPLY=( $(compgen -W \"{flag_words(c.specs).join(" ")}\" -- \"$cur\") ) ;;\n"
        names := command_names(commands).join(" ")
        return "_{fname}() \{\n    local cur=$\{COMP_WORDS[COMP_CWORD]}\n    if [ \"$COMP_CWORD\" -eq 1 ]; then\n        COMPREPLY=( $(compgen -W \"{names}\" -- \"$cur\") )\n        return\n    fi\n    case \"$\{COMP_WORDS[1]}\" in\n{arms}    esac\n}\ncomplete -F _{fname} {name}\n"
    if shell == "zsh"
        mut list := ""
        mut arms := ""
        for c in commands
            list = "{list}    '{c.name}:{quote_safe(c.about)}'\n"
            arms = "{arms}    {c.name}) _arguments \\\n{zsh_lines(c.specs, "      ")} ;;\n"
        return "#compdef {name}\n_{fname}() \{\n  local -a cmds\n  cmds=(\n{list}  )\n  if (( CURRENT == 2 )); then\n    _describe 'command' cmds\n    return\n  fi\n  case $words[2] in\n{arms}  esac\n}\n_{fname} \"$@\"\n"
    if shell == "fish"
        mut out := "complete -c {name} -f\n"
        for c in commands
            out = "{out}complete -c {name} -n __fish_use_subcommand -a {c.name} -d '{quote_safe(c.about)}'\n"
            out = "{out}{fish_lines(name, " -n '__fish_seen_subcommand_from {c.name}'", c.specs)}"
        return out
    return bad_shell(shell)
