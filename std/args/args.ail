## std.args (spec std.args.1-6, ADR 0627): command-line flags, options and
## positionals from a list of specs, with generated help.
##
##     spec := [args.flag("verbose", "v", "more output"), args.opt("out", "o", "where to write", "a.txt"), args.pos("input", "file to read")]
##     a := args.parse("tool", "what it does", spec, env.args())?
##     a.flag("verbose"); a.get("out"); a.get("input"); a.rest
##
## Subcommands (std.args.9), an option's environment variable (std.args.10) and
## `--version` (std.args.11):
##
##     cmds := [args.command("add", "add a file", [args.pos("file", "what to add")])]
##     p := args.parse_commands("tool", "1.2.0", "what it does", cmds, env.args())?
##     p.command; p.opts.get("file")

## What was wrong with the command line, with the usage text (std.args.6).
pub error struct ArgsError "{self.why}\n{self.usage}"
    pub why str
    pub usage str

## One accepted argument: made by `flag`, `opt`, `pos` or `rest`.
pub struct Spec
    pub kind SpecKind
    pub name str
    pub short str
    pub help str
    pub default str
    ## The environment variable that supplies the value when the command line
    ## doesn't; "" for none (std.args.10).
    pub envvar str

## Which builder made a `Spec` (std.args.1-2, ADR 1068).
pub enum SpecKind
    Flag
    Opt
    Pos
    Rest

## What the command line said (std.args.4).
pub struct Args
    values Map[str, str]
    flags Set[str]
    given Set[str]
    text str
    ## The words left over after the named positionals, in order.
    pub rest List[str]

## A switch: `--NAME` or `-SHORT`; `short` may be "" (std.args.1).
pub fn flag(name str, short str, help str) Spec
    Spec(kind: Flag, name: name, short: short, help: help, default: "", envvar: "")

## An option that takes a value: `--NAME V`, `--NAME=V` or `-SHORT V`;
## `default` is its value when absent (std.args.1).
pub fn opt(name str, short str, help str, default str) Spec
    Spec(kind: Opt, name: name, short: short, help: help, default: default, envvar: "")

## A required positional word, in the order the specs list them (std.args.2).
pub fn pos(name str, help str) Spec
    Spec(kind: Pos, name: name, short: "", help: help, default: "", envvar: "")

## Collects every positional word after the required ones into `rest`
## (std.args.2).
pub fn rest(name str, help str) Spec
    Spec(kind: Rest, name: name, short: "", help: help, default: "", envvar: "")

## The same spec, with its value taken from environment variable `key` when the
## command line doesn't give it. An option gets the variable's text; a switch is
## on for `1`, `true`, `yes` or `on` (std.args.10).
pub fn Spec.from_env(self, key str) Spec
    Spec(kind: self.kind, name: self.name, short: self.short, help: self.help, default: self.default, envvar: key)

## One subcommand: a name, a help line and its own specs (std.args.9).
pub struct Command
    pub name str
    pub help str
    pub specs List[Spec]

## The subcommand that was chosen and what its words said (std.args.9).
pub struct Parsed
    pub command str
    pub opts Args

## A subcommand for `parse_commands` (std.args.9).
pub fn command(name str, help str, specs List[Spec]) Command
    Command(name: name, help: help, specs: specs)

## Whether option or positional `name` was given on the command line
## (std.args.8).
pub fn Args.has(self, name str) bool
    self.given.contains(name)

## Option or positional `name` as a `str`, `none` when absent (std.args.8).
pub fn Args.opt(self, name str) str?
    if self.given.contains(name)
        return self.values.get(name)
    none

## `name` as an `int`; text that isn't one is an `ArgsError` (std.args.8).
pub fn Args.int(self, name str) int ! ArgsError
    v := self.values.get(name) else ""
    got := v.to_int()
    n := got else
        return ArgsError(why: "{name} needs an integer, got `{v}`", usage: self.text)
    n

## `name` as a `float` (std.args.8).
pub fn Args.float(self, name str) float ! ArgsError
    v := self.values.get(name) else ""
    got := v.to_float()
    n := got else
        return ArgsError(why: "{name} needs a number, got `{v}`", usage: self.text)
    n

## `name` as an `int` when given and a number, else `none` (std.args.8).
pub fn Args.opt_int(self, name str) int?
    if self.given.contains(name)
        return self.values.get(name)?.to_int()
    none

## `name` as a `float` when given and a number, else `none` (std.args.8).
pub fn Args.opt_float(self, name str) float?
    if self.given.contains(name)
        return self.values.get(name)?.to_float()
    none

## Whether switch `name` was given (std.args.4).
pub fn Args.flag(self, name str) bool
    self.flags.contains(name)

## The value of option or positional `name`; its default when absent
## (std.args.4).
pub fn Args.get(self, name str) str
    self.values.get(name) else ""

## The usage text `--help` prints (std.args.5).
pub fn usage(name str, about str, specs List[Spec]) str
    usage_text(name, "", about, specs)

fn usage_text(name str, version str, about str, specs List[Spec]) str
    mut line := "usage: {name}"
    mut body := ""
    for s in specs
        if s.kind == Pos
            line = "{line} {s.name.to_upper()}"
        elif s.kind == Rest
            line = "{line} [{s.name.to_upper()}...]"
        else
            line = "{line} [--{s.name}]"
        label := if s.short == "" then "--{s.name}" else "-{s.short}, --{s.name}"
        mut label2 := label
        if s.kind == Opt
            label2 = "{label} V"
        elif s.kind != Flag
            label2 = s.name.to_upper()
        dflt := if s.kind == Opt and s.default != "" then " (default {s.default})" else ""
        envnote := if s.envvar != "" then " (env {s.envvar})" else ""
        body = "{body}  {label2.pad_right(22, ' ')}{s.help}{dflt}{envnote}\n"
    ver := if version != "" then "  {"-V, --version".pad_right(22, ' ')}show the version\n" else ""
    "{line}\n{about}\n\n{body}  {"-h, --help".pad_right(22, ' ')}show this help\n{ver}"

## The usage text for a tool with subcommands: one line per command (std.args.9).
pub fn commands_usage(name str, version str, about str, cmds List[Command]) str
    mut body := ""
    for c in cmds
        body = "{body}  {c.name.pad_right(22, ' ')}{c.help}\n"
    ver := if version != "" then "  {"-V, --version".pad_right(22, ' ')}show the version\n" else ""
    "usage: {name} COMMAND [ARGS]\n{about}\n\n{body}  {"-h, --help".pad_right(22, ' ')}show this help\n{ver}"

fn find_long(specs List[Spec], name str) Spec?
    for s in specs
        if s.name == name and (s.kind == Flag or s.kind == Opt)
            return s
    none

fn find_short(specs List[Spec], short str) Spec?
    for s in specs
        if s.short == short and short != ""
            return s
    none

## Reads `words` (usually `env.args()`) against `specs`. `--help` or `-h`
## prints the usage and exits 0. A bare `--` makes every later word a
## positional (std.args.3, std.args.6).
pub fn parse(name str, about str, specs List[Spec], words List[str]) Args ! ArgsError
    parse_in(name, "", about, specs, words, env.vars())

## `parse` for a tool with a version: `--version` and `-V` print
## `NAME VERSION` and exit 0 (std.args.11).
pub fn parse_versioned(name str, version str, about str, specs List[Spec], words List[str]) Args ! ArgsError
    parse_in(name, version, about, specs, words, env.vars())

## `parse_versioned` reading environment fallbacks from `environ` instead of the
## process environment, so a test can fix them (std.args.10).
pub fn parse_in(name str, version str, about str, specs List[Spec], words List[str], environ Map[str, str]) Args ! ArgsError
    text := usage_text(name, version, about, specs)
    mut values := Map[str, str]()
    mut flags := Set[str]()
    mut given := Set[str]()
    mut positional := List[str]()
    for s in specs
        if s.kind == Opt
            values[s.name] = s.default
    mut i := 0
    mut literal := false
    while i < words.len()
        w := words[i]
        i += 1
        if literal or not w.starts_with("-") or w == "-"
            positional.push(w)
        elif w == "--"
            literal = true
        elif w == "--help" or w == "-h"
            print(text)
            io.exit(0)
        elif version != "" and (w == "--version" or w == "-V")
            print("{name} {version}")
            io.exit(0)
        else
            long := w.starts_with("--")
            body := if long then w.slice(2, w.len()) else w.slice(1, w.len())
            eq := body.find("=") else -1
            key := if long and eq >= 0 then body.slice(0, eq) else body
            inline := if long and eq >= 0 then body.slice(eq + 1, body.len()) else ""
            found := if long then find_long(specs, key) else find_short(specs, key)
            s := found else
                return ArgsError(why: "unknown option {w}", usage: text)
            if s.kind == Flag
                if inline != ""
                    return ArgsError(why: "--{s.name} takes no value", usage: text)
                flags.add(s.name)
            elif eq >= 0
                values[s.name] = inline
                given.add(s.name)
            elif i < words.len()
                values[s.name] = words[i]
                given.add(s.name)
                i += 1
            else
                return ArgsError(why: "--{s.name} needs a value", usage: text)
    for s in specs
        if s.envvar != "" and (s.kind == Opt or s.kind == Flag)
            if v := environ.get(s.envvar)
                if s.kind == Opt and not given.contains(s.name)
                    values[s.name] = v
                    given.add(s.name)
                elif s.kind == Flag and truthy(v)
                    flags.add(s.name)
    mut next := 0
    mut left := List[str]()
    for s in specs
        if s.kind == Pos
            if next >= positional.len()
                return ArgsError(why: "missing {s.name.to_upper()}", usage: text)
            values[s.name] = positional[next]
            given.add(s.name)
            next += 1
    left = positional[next..]
    mut has_rest := false
    for s in specs
        if s.kind == Rest
            has_rest = true
    if left.len() > 0 and not has_rest
        return ArgsError(why: "unexpected argument {left[0]}", usage: text)
    Args(values: values, flags: flags, given: given, text: text, rest: left)

fn truthy(v str) bool
    w := v.to_lower()
    w == "1" or w == "true" or w == "yes" or w == "on"

## Reads `words` for a tool with subcommands: the first word names the command
## and the rest are parsed against its specs. `--help`, `-h` or `help` prints
## the command list and exits 0; `help CMD` and `CMD --help` print that
## command's usage; a non-empty `version` adds `--version` and `-V`. A missing
## or unknown command is an `ArgsError` (std.args.9, std.args.11).
pub fn parse_commands(name str, version str, about str, cmds List[Command], words List[str]) Parsed ! ArgsError
    parse_commands_in(name, version, about, cmds, words, env.vars())

## `parse_commands` reading environment fallbacks from `environ` (std.args.10).
pub fn parse_commands_in(name str, version str, about str, cmds List[Command], words List[str], environ Map[str, str]) Parsed ! ArgsError
    text := commands_usage(name, version, about, cmds)
    if words.len() == 0
        return ArgsError(why: "missing command", usage: text)
    w := words[0]
    if w == "--help" or w == "-h" or (w == "help" and words.len() == 1)
        print(text)
        io.exit(0)
    if version != "" and (w == "--version" or w == "-V")
        print("{name} {version}")
        io.exit(0)
    mut chosen := w
    mut tail := words[1..]
    if w == "help"
        chosen = words[1]
        tail = ["--help"]
    for c in cmds
        if c.name == chosen
            opts := parse_in("{name} {c.name}", "", c.help, c.specs, tail, environ)?
            return Parsed(command: c.name, opts: opts)
    ArgsError(why: "unknown command {chosen}", usage: text)
