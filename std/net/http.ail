## std.net.http (spec std.net.18, ADR 0419): the handler form of the HTTP
## server, written over `net.serve`, `Server.accept` and `Exchange.respond`.
##
## A handler is a function `fn(net.Request) net.Response`. `serve`
## listens and answers until the server is closed; `run` does the same on a
## server the program already holds, so it can `close` it.
##
## A `Router` (http.route.1-5, ADR 1217) sends each request to the handler of
## the first route whose method and path pattern match, with the pattern's
## parameters in an `http.Req`. `r.upgrade(pattern, handler)` (http.route.6-8,
## ADR 1280) hands the connection of a `GET` to the handler, for a WebSocket
## (`websocket.upgrade`) or a stream of events on the router's own port.
## Middleware (http.mw.1-5, ADR 1276) wraps the routes: `use`, `group`, and the
## built-ins `recover`, `request_id` and `log_requests`.
##
## The client helpers (http.client.1-5): `get_json`, `post_json`, `post_form`,
## `multipart` and `post_multipart`, and `retry` with backoff, over `net.request`.
use std.net
use std.log
use std.crypto
use std.fs
use std.path
use std.compress
use std.random
use std.time
use std.url
use std.net.fileserve

## Workers that answer requests at once. Each handles one request at a time.
WORKERS := 4

fn worker(srv net.Server, handler fn(net.Request) net.Response)
    while true
        ex := srv.accept() else err
            return
        # A client that has gone away is not the server's failure.
        ex.respond(handler(ex.request)) else err
            continue

## The content type of plain text answers.
PLAIN := "text/plain; charset=utf-8"

## What answering one request takes: a response, or, when `raw`, the status
## and headers of `resp` with the bytes `data` as the body (a file).
struct Reply
    resp net.Response
    data bytes
    raw bool

fn plain_reply(status int, why str) Reply
    Reply(resp: text(status, why), data: b"", raw: false)

## The answer to the request for the file `rel` under `root` (http.serve.2,
## http.route.3, http.file.1-7): `rel` is a path of `/`-separated segments, as sent.
fn file_reply(request net.Request, rel str, root str, opts fileserve.Options) Reply
    a := fileserve.answer(request.method, rel, root, request.headers, opts)
    head := net.Response(status: a.status, headers: a.headers, body: "")
    Reply(resp: head, data: a.data, raw: true)

## Sends `rep` on `ex`. A client that has gone away is not the server's failure.
fn send(ex net.Exchange, rep Reply)
    if rep.raw
        ex.respond_bytes(rep.resp.status, rep.resp.headers, rep.data) else err
            return
        return
    ex.respond(rep.resp) else err
        return

## Answers one request for a file under `root` (http.serve.2).
fn file_for(ex net.Exchange, root str, opts fileserve.Options)
    send(ex, file_reply(ex.request, ex.request.path, root, opts))

fn dir_worker(srv net.Server, root str, opts fileserve.Options)
    while true
        ex := srv.accept() else err
            return
        file_for(ex, root, opts)

## Answers every request on `srv` with the files under `root` until `srv.close()`.
pub fn run_dir(srv net.Server, root str) ! Trapped
    run_dir_with(srv, root, fileserve.options())?

## http.file.7: `run_dir` with `fileserve.Options` (caching, index, sidecars).
pub fn run_dir_with(srv net.Server, root str, opts fileserve.Options) ! Trapped
    g := TaskGroup()
    for _ in 0..WORKERS
        g.add(spawn dir_worker(srv, root, opts))
    g.wait_all()?

## Listens on `addr` and serves the files under `root`.
pub fn serve_dir(addr str, root str) ! net.NetError | Trapped
    srv := net.serve(addr)?
    run_dir(srv, root)?

## http.file.7: `serve_dir` with `fileserve.Options`.
pub fn serve_dir_with(addr str, root str, opts fileserve.Options) ! net.NetError | Trapped
    srv := net.serve(addr)?
    run_dir_with(srv, root, opts)?

## Answers every request on `srv` with `handler` until `srv.close()`.
pub fn run(srv net.Server, handler fn(net.Request) net.Response) ! Trapped
    g := TaskGroup()
    for _ in 0..WORKERS
        g.add(spawn worker(srv, handler))
    g.wait_all()?

## Listens on `addr` and answers every request with `handler`.
pub fn serve(addr str, handler fn(net.Request) net.Response) ! net.NetError | Trapped
    srv := net.serve(addr)?
    run(srv, handler)?

## http.route.5: a plain-text response.
pub fn text(status int, body str) net.Response
    net.Response(status: status, headers: {"content-type": PLAIN}, body: body)

## http.route.5: an HTML response.
pub fn html(status int, body str) net.Response
    net.Response(status: status, headers: {"content-type": "text/html; charset=utf-8"}, body: body)

## http.route.5: a JSON response with the text of `value`.
pub fn json(status int, value Json) net.Response
    net.Response(
        status: status,
        headers: {"content-type": "application/json"},
        body: value.to_text(),
    )

## http.route.5: a `302 Found` to `to`, which the client follows.
pub fn redirect(to str) net.Response
    net.Response(status: 302, headers: {"location": to}, body: "")

## http.route.5: the `404` a router gives when no route matches.
pub fn not_found() net.Response
    text(404, "not found")

## http.route.5: the content type for a file extension, with or without its
## dot, in any case; `application/octet-stream` for one not in the table.
pub fn mime_type(ext str) str
    fileserve.mime_type(ext)

## http.route.2: a request a router matched, with the parameters of the
## route's pattern. The other fields are those of `net.Request`.
pub struct Req
    pub method str
    pub path str
    pub query Map[str, str]
    pub headers Map[str, str]
    pub body str
    pub peer str
    pub data bytes
    pub server int
    pub params Map[str, str]

fn req_of(r net.Request, params Map[str, str]) Req
    Req(
        method: r.method,
        path: r.path,
        query: r.query,
        headers: r.headers,
        body: r.body,
        peer: r.peer,
        data: r.data,
        server: r.server,
        params: params,
    )

## http.route.2: the value of the pattern's `:name` or `*name` segment, or `none`.
pub fn Req.param(self, name str) str?
    self.params.get(name)

## http.route.2: the body read as JSON.
pub fn Req.json(self) Json ! JsonError
    value := parse_json(self.body)?
    value

## http.route.2: the body read as a form (`application/x-www-form-urlencoded`):
## `a=1&b=x+y` gives `{"a": "1", "b": "x y"}`; `%XX` and `+` are decoded, a
## repeated name keeps its last value and a piece without `=` has the value "".
pub fn Req.form(self) Map[str, str]
    mut out := Map[str, str]()
    for piece in self.body.split("&")
        if piece == ""
            continue
        pair := piece.split("=", 2)
        name := decode(pair[0], true)
        if pair.len() == 2
            out[name] = decode(pair[1], true)
        else
            out[name] = ""
    out

## http.route.2: stops the server that received the request, as `req.stop()`
## on a `net.Request` does (http.serve.1).
pub fn Req.stop(self)
    net
        .Request(
            method: self.method,
            path: self.path,
            query: self.query,
            headers: self.headers,
            body: self.body,
            peer: self.peer,
            data: self.data,
            server: self.server,
        )
        .stop()

## The value of an ASCII hex digit, or -1.
fn hex_digit(c int) int
    if c >= 48 and c <= 57
        return c - 48
    if c >= 65 and c <= 70
        return c - 55
    if c >= 97 and c <= 102
        return c - 87
    -1

## `s` with each `%XX` made its byte, and each `+` a space when `plus`; a `%`
## not followed by two hex digits is kept. Bytes that aren't UTF-8 become U+FFFD.
fn decode(s str, plus bool) str
    b := s.to_bytes()
    mut out := List[u8]()
    mut i := 0
    while i < b.len()
        c := b[i].to_int()
        if c == 37
            and i + 2 < b.len()
            and hex_digit(b[i + 1].to_int()) >= 0
            and hex_digit(b[i + 2].to_int()) >= 0
            out.push((hex_digit(b[i + 1].to_int()) * 16 + hex_digit(b[i + 2].to_int())).to_u8())
            i += 3
            continue
        if c == 43 and plus
            out.push((32).to_u8())
        else
            out.push(b[i])
        i += 1
    bytes.from_list(out).text()

## The non-empty segments of a path or pattern: `/users//7/` gives `["users", "7"]`.
fn segments(p str) List[str]
    mut out := List[str]()
    for seg in p.split("/")
        if seg != ""
            out.push(seg)
    out

## The parameters when `pattern` matches the path segments `segs`, or `none`
## (http.route.1).
fn match_route(pattern List[str], segs List[str]) Map[str, str]?
    mut params := Map[str, str]()
    for i in 0..pattern.len()
        p := pattern[i]
        if p.starts_with("*")
            params[p.slice(1)] = decode(segs[i..].join("/"), false)
            return params
        if i >= segs.len()
            return none
        if p.starts_with(":")
            params[p.slice(1)] = decode(segs[i], false)
        elif p != segs[i]
            return none
    if segs.len() != pattern.len()
        return none
    params

## The rest of the path after the mount's prefix, or `none` (http.route.3).
fn under(prefix List[str], segs List[str]) str?
    if segs.len() < prefix.len()
        return none
    for i in 0..prefix.len()
        if segs[i] != prefix[i]
            return none
    segs[prefix.len()..].join("/")

## One route: a method (`*` for any), its pattern's segments and its handler.
struct Route
    method str
    parts List[str]
    handler fn(Req) net.Response
    mws List[Mw]
    ## http.route.6: a route made by `upgrade` has `hijack` and `up`.
    hijack bool
    up fn(Req, net.Conn)

## A directory served under a path prefix (http.route.3).
struct Mount
    parts List[str]
    dir str
    opts fileserve.Options

fn no_hook(req Req, resp net.Response)
    return

## A middleware kept by a router (http.mw.1).
struct Mw
    f fn(Req, Next) net.Response

## http.mw.1: the rest of the chain a middleware calls: the middleware after
## it, then the handler. `next.run(req)` runs it and gives its response.
pub struct Next
    mws List[Mw]
    i int
    h fn(Req) net.Response

## http.mw.1: runs the next middleware, or the handler after the last one.
pub fn Next.run(self, req Req) net.Response
    if self.i >= self.mws.len()
        return (self.h)(req)
    m := self.mws[self.i]
    (m.f)(req, Next(mws: self.mws, i: self.i + 1, h: self.h))

fn no_upgrade(req Req, conn net.Conn)
    return

## What `Router.handle` and a `HEAD` answer on an upgrade route: it needs a connection.
fn needs_conn(req Req) net.Response
    text(426, "upgrade required")

## http.route.1: routes, static mounts and a hook, made by `http.router()`.
pub struct Router
    routes List[Route]
    mounts List[Mount]
    hook fn(Req, net.Response)
    gzip_on bool
    mws List[Mw]

## http.route.1: a router with no routes; every request gets `404`.
pub fn router() Router
    Router(
        routes: List[Route](),
        mounts: List[Mount](),
        hook: no_hook,
        gzip_on: false,
        mws: List[Mw](),
    )

## http.route.1: adds a route for `method` (any case; `"*"` for every method)
## and `pattern`. Routes are tried in the order they were added.
pub fn Router.route(mut self, method str, pattern str, handler fn(Req) net.Response)
    self.routes.push(Route(
        method: method.to_upper(),
        parts: segments(pattern),
        handler: handler,
        mws: List[Mw](),
        hijack: false,
        up: no_upgrade,
    ))

## http.route.6: a `GET` route whose handler takes over the connection: it
## gets the request and the `net.Conn` (`Exchange.hijack`, std.net.53), writes
## the response itself and owns the connection until it returns, when the
## router closes it. Use it for `websocket.upgrade` or a stream of events.
## The handler runs in a task of its own, so a long exchange does not hold
## one of the router's workers. Without a server (`handle`) and for `HEAD`
## the route answers `426`.
pub fn Router.upgrade(mut self, pattern str, handler fn(Req, net.Conn))
    self.routes.push(Route(
        method: "GET",
        parts: segments(pattern),
        handler: needs_conn,
        mws: List[Mw](),
        hijack: true,
        up: handler,
    ))

## http.route.1: a `GET` route; it answers `HEAD` too.
pub fn Router.get(mut self, pattern str, handler fn(Req) net.Response)
    self.route("GET", pattern, handler)

## http.route.1: a `POST` route.
pub fn Router.post(mut self, pattern str, handler fn(Req) net.Response)
    self.route("POST", pattern, handler)

## http.route.1: a `PUT` route.
pub fn Router.put(mut self, pattern str, handler fn(Req) net.Response)
    self.route("PUT", pattern, handler)

## http.route.1: a `PATCH` route.
pub fn Router.patch(mut self, pattern str, handler fn(Req) net.Response)
    self.route("PATCH", pattern, handler)

## http.route.1: a `DELETE` route.
pub fn Router.delete(mut self, pattern str, handler fn(Req) net.Response)
    self.route("DELETE", pattern, handler)

## http.route.1: a route for every method.
pub fn Router.any(mut self, pattern str, handler fn(Req) net.Response)
    self.route("*", pattern, handler)

## http.route.3: answers `GET` and `HEAD` under `prefix` with the files under
## `dir`, as `serve_dir` does, when no route matches the path.
pub fn Router.static(mut self, prefix str, dir str)
    self.static_with(prefix, dir, fileserve.options())

## http.file.7: `static` with `fileserve.Options`.
pub fn Router.static_with(mut self, prefix str, dir str, opts fileserve.Options)
    self.mounts.push(Mount(parts: segments(prefix), dir: dir, opts: opts))

## http.route.4: calls `hook` after each request with the request and the
## response; for a file the response has an empty body. A later call replaces it.
pub fn Router.on_request(mut self, hook fn(Req, net.Response))
    self.hook = hook

## http.gzip.2: a body shorter than this many bytes is sent as it is.
GZIP_MIN := 256

## http.gzip.1: whether an `accept-encoding` header value allows a gzip answer:
## `gzip` or `x-gzip` with a `q` that isn't zero, or `*` when gzip isn't named.
pub fn accepts_gzip(header str) bool
    mut named := 0
    mut star := 0
    for item in header.split(",")
        parts := item.split(";")
        coding := parts[0].trim().to_lower()
        mut verdict := 1
        for param in parts[1..]
            val := param.trim().to_lower()
            if val.starts_with("q=") and val.len() > 2
                if val.slice(2).replace("0", "").replace(".", "").trim() == ""
                    verdict = 2
        if coding == "gzip" or coding == "x-gzip"
            named = verdict
        elif coding == "*"
            star = verdict
    if named != 0
        return named == 1
    star == 1

## http.gzip.2: whether a content type is text the gzip answer is worth it for.
fn gzippable(ctype str) bool
    t := ctype.to_lower()
    t.starts_with("text/")
        or t.contains("json")
        or t.contains("xml")
        or t.contains("javascript")
        or t.contains("wasm")

## http.gzip.2: `rep` gzipped when `accept` allows it and the body is text of
## at least `GZIP_MIN` bytes with no `content-encoding` and a status that has a body.
fn gzip_reply(accept str, rep Reply) Reply
    status := rep.resp.status
    if status < 200 or status == 204 or status == 206 or status == 304
        return rep
    if not gzippable(rep.resp.headers.get("content-type") else "")
        return rep
    if (rep.resp.headers.get("content-encoding") else "") != ""
        return rep
    data := if rep.raw then rep.data else rep.resp.body.to_bytes()
    if data.len() < GZIP_MIN
        return rep
    mut out := rep
    before := rep.resp.headers.get("vary") else ""
    out.resp.headers["vary"] = if before
        == "" then "accept-encoding" else "{before}, accept-encoding"
    if not accepts_gzip(accept)
        return out
    out.resp.headers["content-encoding"] = "gzip"
    out.data = compress.gzip(data)
    out.raw = true
    out

## http.gzip.1: from now on `run` and `serve` answer with gzip to a client
## whose `accept-encoding` allows it (see `accepts_gzip`), when the body is
## text of 256 bytes or more. `handle` is not changed: its body is a `str`.
pub fn Router.gzip(mut self)
    self.gzip_on = true

## http.mw.1: adds a middleware, `fn(http.Req, http.Next) net.Response`, to
## every route of this router, and to the `404` and `405` answers. The first
## one added is the outermost. A middleware does its work before the
## handler, calls `next.run(req)` (or answers without it), and may change
## the response it gets back.
pub fn Router.use(mut self, mw fn(Req, Next) net.Response)
    self.mws.push(Mw(f: mw))

## http.mw.2: adds the routes and static mounts of `sub` under `prefix`.
## The middleware of `sub` runs around its routes, inside the middleware of
## this router; later changes to `sub` are not seen. Its hook and gzip
## setting are ignored.
pub fn Router.group(mut self, prefix str, sub Router)
    pre := segments(prefix)
    for rt in sub.routes
        mut parts := List[str]()
        for p in pre
            parts.push(p)
        for p in rt.parts
            parts.push(p)
        mut mws := List[Mw]()
        for m in sub.mws
            mws.push(m)
        for m in rt.mws
            mws.push(m)
        self.routes.push(Route(
            method: rt.method,
            parts: parts,
            handler: rt.handler,
            mws: mws,
            hijack: rt.hijack,
            up: rt.up,
        ))
    for mt in sub.mounts
        mut parts := List[str]()
        for p in pre
            parts.push(p)
        for p in mt.parts
            parts.push(p)
        self.mounts.push(Mount(parts: parts, dir: mt.dir, opts: mt.opts))

## Runs `h` inside this router's middleware, then the route's own.
fn Router.dispatch(self, own List[Mw], h fn(Req) net.Response, req Req) net.Response
    mut all := List[Mw]()
    for m in self.mws
        all.push(m)
    for m in own
        all.push(m)
    Next(mws: all, i: 0, h: h).run(req)

## The answer to `request` (http.route.1-3), after the hook has seen it.
fn Router.reply(self, request net.Request) Reply
    segs := segments(request.path)
    mut allow := List[str]()
    for rt in self.routes
        params := match_route(rt.parts, segs) else
            continue
        if rt.method == "*"
            or rt.method == request.method
            or (rt.method == "GET" and request.method == "HEAD")
            req := req_of(request, params)
            resp := self.dispatch(rt.mws, rt.handler, req)
            (self.hook)(req, resp)
            return Reply(resp: resp, data: b"", raw: false)
        if not allow.contains(rt.method)
            allow.push(rt.method)
    mut rep := Reply(resp: not_found(), data: b"", raw: false)
    mut mounted := false
    if allow.len() > 0
        if allow.contains("GET") and not allow.contains("HEAD")
            allow.push("HEAD")
        rep = plain_reply(405, "method not allowed")
        rep.resp.headers["allow"] = allow.join(", ")
    else
        for m in self.mounts
            if rel := under(m.parts, segs)
                mounted = true
                rep = file_reply(request, rel, m.dir, m.opts)
                break
    req := req_of(request, Map[str, str]())
    if mounted
        (self.hook)(req, rep.resp)
        return rep
    canned := rep.resp
    resp := self.dispatch(List[Mw](), |q| canned, req)
    (self.hook)(req, resp)
    Reply(resp: resp, data: b"", raw: false)

## http.route.4: the response the router gives `request`, without a server; a
## file's body is its text, with bytes that aren't UTF-8 as U+FFFD.
pub fn Router.handle(self, request net.Request) net.Response
    rep := self.reply(request)
    if rep.raw
        return net.Response(
            status: rep.resp.status,
            headers: rep.resp.headers,
            body: rep.data.text(),
        )
    rep.resp

## A request on its way to the handler of an upgrade route (http.route.6).
struct Upgrade
    req Req
    up fn(Req, net.Conn)

## The upgrade route that answers `request`, when the first route that
## matches it is one (http.route.7).
fn Router.find_upgrade(self, request net.Request) Upgrade?
    if request.method != "GET"
        return none
    segs := segments(request.path)
    for rt in self.routes
        params := match_route(rt.parts, segs) else
            continue
        if rt.method == "*" or rt.method == "GET"
            if rt.hijack
                return Upgrade(req: req_of(request, params), up: rt.up)
            return none
    none

## A hijacked connection sent from a worker to `Router.run`, which spawns its
## handler; with no `conn` it says the worker has ended.
struct Hijacked
    req Req
    up fn(Req, net.Conn)
    conn net.Conn?

fn serve_hijacked(h Hijacked)
    c := h.conn else
        return
    (h.up)(h.req, c)
    c.close()

fn route_worker(r Router, srv net.Server, hijacked Channel[Hijacked])
    while true
        ex := srv.accept() else err
            break
        if u := r.find_upgrade(ex.request)
            conn := ex.hijack() else err
                continue
            hijacked.send(Hijacked(req: u.req, up: u.up, conn: conn))
            continue
        mut rep := r.reply(ex.request)
        if r.gzip_on
            rep = gzip_reply(ex.request.headers.get("accept-encoding") else "", rep)
        send(ex, rep)
    ended := Hijacked(req: req_of(no_request(), Map[str, str]()), up: no_upgrade, conn: none)
    hijacked.send(ended)

fn no_request() net.Request
    net.Request(
        method: "GET",
        path: "/",
        query: {},
        headers: {},
        body: "",
        peer: "",
        data: b"",
        server: -1,
    )

## http.route.4, http.route.7: answers every request on `srv` until
## `srv.close()` or a `req.stop()`, as `http.run` does. The handler of an
## upgrade route runs in its own task; `run` returns once the workers have
## ended and those handlers have returned.
pub fn Router.run(self, srv net.Server) ! Trapped
    g := TaskGroup()
    hijacked := Channel[Hijacked](16)
    for _ in 0..WORKERS
        g.add(spawn route_worker(self, srv, hijacked))
    mut live := WORKERS
    while live > 0
        h := hijacked.recv() else
            break
        if h.conn == none
            live -= 1
        else
            g.add(spawn serve_hijacked(h))
    g.wait_all()?

## http.route.4: listens on `addr` and answers every request, as `http.serve` does.
pub fn Router.serve(self, addr str) ! net.NetError | Trapped
    srv := net.serve(addr)?
    self.run(srv)?

## ---- Client helpers (http.client.1-5) ----

## http.client.1: a response whose status is not 2xx, from `get_json` or `post_json`.
pub error struct HttpError "{self.status} from {self.link}"
    pub link str
    pub status int
    pub body str

fn json_options() net.Options
    mut o := net.options()
    o.headers["accept"] = "application/json"
    o

fn json_of(link str, resp net.Response) Json ! HttpError | JsonError
    if resp.status < 200 or resp.status > 299
        return HttpError(link: link, status: resp.status, body: resp.body)
    parse_json(resp.body)?

## http.client.1: `GET`s `link` and reads a 2xx body as JSON.
pub fn get_json(link str) Json ! net.NetError | HttpError | JsonError
    resp := net.request("GET", link, json_options())?
    json_of(link, resp)?

## http.client.1: `POST`s the text of `value` as `application/json` and reads a
## 2xx body as JSON.
pub fn post_json(link str, value Json) Json ! net.NetError | HttpError | JsonError
    mut o := json_options()
    o.headers["content-type"] = "application/json"
    o.body = value.to_text()
    resp := net.request("POST", link, o)?
    json_of(link, resp)?

## http.client.2: `POST`s `pairs` as a form (`application/x-www-form-urlencoded`),
## each name and value encoded by `url.encode_form`, in order.
pub fn post_form(link str, pairs List[(str, str)]) net.Response ! net.NetError
    net.post(link, url.build_query(pairs), "application/x-www-form-urlencoded")?

## http.client.3: one part of a `multipart/form-data` body. A plain field has
## `filename` and `content_type` "".
pub struct Part
    pub name str
    pub filename str
    pub content_type str
    pub data bytes

## http.client.3: a plain text field.
pub fn field(name str, value str) Part
    Part(name: name, filename: "", content_type: "", data: value.to_bytes())

## http.client.3: a file field.
pub fn file_part(name str, filename str, content_type str, data bytes) Part
    Part(name: name, filename: filename, content_type: content_type, data: data)

fn random_boundary() str
    "ail{random.int(0, 4294967295).to_hex()}{random.int(0, 4294967295).to_hex()}"

fn boundary_free(parts List[Part], b str) bool
    needle := b.to_bytes()
    for p in parts
        if (p.data.find(needle) else -1) >= 0
            return false
    true

fn fresh_boundary(parts List[Part]) str
    mut b := random_boundary()
    while not boundary_free(parts, b)
        b = random_boundary()
    b

## A name or file name inside quotes: `"`, CR and LF as `%22`, `%0D`, `%0A`.
fn quoted(s str) str
    s.replace("\r", "%0D").replace("\n", "%0A").replace("\"", "%22")

## http.client.3: the body and the `Content-Type` of a `multipart/form-data`
## request made of `parts` (RFC 7578), each name and file name quoted. With no
## `boundary` a random one that occurs in no part is used.
pub fn multipart(parts List[Part], boundary str = "")(bytes, str)
    b := if boundary == "" then fresh_boundary(parts) else boundary
    mut out := b""
    for p in parts
        mut head := "--{b}\r\nContent-Disposition: form-data; name=\"{quoted(p.name)}\""
        if p.filename != ""
            head = "{head}; filename=\"{quoted(p.filename)}\""
        head = "{head}\r\n"
        if p.content_type != ""
            head = "{head}Content-Type: {p.content_type}\r\n"
        out = out + "{head}\r\n".to_bytes() + p.data + b"\r\n"
    out = out + "--{b}--\r\n".to_bytes()
    (out, "multipart/form-data; boundary={b}")

## http.client.3: `POST`s `parts` as `multipart/form-data`.
pub fn post_multipart(link str, parts List[Part]) net.Response ! net.NetError
    body, ctype := multipart(parts)
    mut o := net.options()
    o.headers["content-type"] = ctype
    o.data = body
    net.request("POST", link, o)?

## The longest wait `retry` makes, before jitter.
BACKOFF_CAP_MS := 30000

## http.client.4: the wait before retry number `attempt` (1 is the first
## retry), before jitter: `base_ms` doubled for each earlier retry, at most 30000.
pub fn backoff_ms(base_ms int, attempt int) int
    shift := (attempt - 1).max(0).min(20)
    (base_ms.max(0) * (1 << shift)).min(BACKOFF_CAP_MS)

fn retryable(kind net.NetKind) bool
    match kind
        net.NetKind.TimedOut => true
        net.NetKind.Refused => true
        net.NetKind.Closed => true
        _ => false

fn pause(base_ms int, attempt int)
    d := backoff_ms(base_ms, attempt)
    time.sleep_ms(d / 2 + random.int(0, d / 2))

## http.client.4: calls `call` up to `attempts` times (at least 1) and returns
## the first answer that is not a failure of kind `timed_out`, `refused` or
## `closed` and not a 5xx status; the rest of the failures are returned at once.
## Before retry n it waits `backoff_ms(base_ms, n)`, jittered to between half and
## all of it. The last attempt's answer is returned as it is, a 5xx response
## included. `call` should be safe to repeat.
pub fn retry(
    attempts int,
    base_ms int,
    call fn() net.Response ! net.NetError,
) net.Response ! net.NetError
    tries := attempts.max(1)
    mut n := 1
    while n < tries
        resp := call() else err
            if not retryable(err.kind)
                return err
            pause(base_ms, n)
            n += 1
            continue
        if resp.status < 500
            return resp
        pause(base_ms, n)
        n += 1
    call()?

## Runs the rest of the chain; a declared function so `recover` can spawn it.
fn call_next(next Next, req Req) net.Response
    next.run(req)

## http.mw.3: a middleware that turns a trap in the rest of the chain into a
## `500` with the body `internal server error`, logging it with `std.log`.
pub fn recover(req Req, next Next) net.Response
    t := spawn call_next(next, req)
    resp := t.wait() else err
        log.err("{req.method} {req.path} trapped: {err.message}")
        return text(500, "internal server error")
    resp

## http.mw.4: a middleware that gives the request an `x-request-id` header,
## keeping one the client sent (up to 64 characters), or else 16 random hex
## digits, and sets the same header on the response.
pub fn request_id(req Req, next Next) net.Response
    mut q := req
    given := req.headers.get("x-request-id") else ""
    if given == "" or given.len() > 64
        q.headers["x-request-id"] = crypto.random_bytes(8).hex()
    resp := next.run(q)
    mut out := resp
    out.headers["x-request-id"] = q.headers["x-request-id"]
    out

## http.mw.5: a middleware that logs each request with `std.log` at `info`
## as `METHOD PATH STATUS MSms`, after the rest of the chain has answered.
pub fn log_requests(req Req, next Next) net.Response
    start := time.mono_ns()
    resp := next.run(req)
    log.info("{req.method} {req.path} {resp.status} {time.since_ms(start)}ms")
    resp
