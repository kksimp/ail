## std.regex natively (spec std.regex.1-25, ADRs 0438 and 0819): the pattern
## parser and the Pike VM of the former Rust regex engine, written in AIL and compiled
## with the program, so native builds match in time proportional to pattern
## times text (std.regex.4). The interpreter keeps the Rust engine; the two
## agree on every vector (`tools/native-regex`). Offsets are characters.

## What a pattern that does not compile is (std.regex.23).
pub error struct RegexError "{self.message}"
    pub pattern str
    pub at int
    pub kind RegexKind
    pub rule str
    pub message str

## What is wrong with a pattern (std.regex.11-22, ADR 1068).
pub enum RegexKind
    UnclosedGroup
    UnopenedGroup
    UnclosedClass
    BadEscape
    BadRepeat
    NothingToRepeat
    BadRange
    BadClass
    BadGroupName
    BadFlag
    Unsupported
    TooLarge

## A compiled pattern: `pat` is the source (std.regex.2).
pub struct Regex
    pub pat str
    code List[int]
    cls_at List[int]
    cls_items List[int]
    cls_neg List[int]
    groups int
    names List[str]
    name_ix List[int]
    anchored bool
    ## 128 flags: the ASCII characters a match can start with, or empty when
    ## any position may start one.
    start List[int]
    ## For each class instruction, 128 flags: whether it takes that ASCII character.
    tab List[int]
    ## Without assertions: for each consuming instruction (and, at index n, the
    ## start) the offset of its precomputed empty-transition closure, which is a
    ## count then the instructions in priority order. Empty when not built.
    clo List[int]
    ## The reversed program with its tables, and two lazily-free (eagerly built,
    ## bounded) DFAs over ASCII: `fwd` finds where the leftmost-first match ends,
    ## `rev` walks back from there to where it starts. `k` is 0 when not built.
    rcode List[int]
    rtab List[int]
    rclo List[int]
    fwd Dfa
    rev Dfa
    ## The character codes every match starts with (std.regex.27), empty when
    ## there is no such literal of 2 or more characters.
    prefix List[int]

pub struct Match
    pub start int
    pub end int
    pub text str

## The first match with its groups (std.regex.9).
pub struct Captures
    pub start int
    pub end int
    pub groups List[str?]
    pub named Map[str, str]

# ---- character sets ----

# Property ids: 0-13 the ASCII and POSIX sets, 14-26 the Unicode ones, 27-36 scripts.
