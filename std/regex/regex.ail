fn chr(n int) char
    c := char.from_code(n) else ' '
    c

fn in_ranges(r List[int], n int) bool
    mut i := 0
    while i < r.len()
        if r[i] <= n and n <= r[i + 1]
            return true
        i += 2
    false

fn is_digit(n int) bool
    48 <= n and n <= 57

fn is_alpha(n int) bool
    (65 <= n and n <= 90) or (97 <= n and n <= 122)

fn is_word(n int) bool
    is_alpha(n) or is_digit(n) or n == 95

fn is_graph(n int) bool
    33 <= n and n <= 126

fn is_punct(n int) bool
    is_graph(n) and not is_word(n) or n == 95

fn lower_of(n int) int
    if n < 128
        return if 65 <= n and n <= 90 then n + 32 else n
    chr(n).to_lower().code()

fn upper_of(n int) int
    if n < 128
        return if 97 <= n and n <= 122 then n - 32 else n
    chr(n).to_upper().code()

fn is_number(n int) bool
    in_ranges(DECIMAL, n) or in_ranges(OTHER_NUMBER, n)

fn script_ranges(id int) List[int]
    match id - SCRIPT_BASE
        0 => LATIN
        1 => GREEK
        2 => CYRILLIC
        3 => HAN
        4 => HIRAGANA
        5 => KATAKANA
        6 => HANGUL
        7 => ARABIC
        8 => HEBREW
        9 => THAI
        _ => DEVANAGARI

## Whether code point `n` is in property `id` (std.regex.10).
fn prop_test(id int, n int) bool
    if id >= SCRIPT_BASE
        return in_ranges(script_ranges(id), n)
    match id
        0 => is_digit(n)
        1 => is_word(n)
        2 => (9 <= n and n <= 13) or n == 32
        3 => is_alpha(n)
        4 => is_alpha(n) or is_digit(n)
        5 => n < 128
        6 => n == 32 or n == 9
        7 => n < 32 or n == 127
        8 => is_graph(n)
        9 => 97 <= n and n <= 122
        10 => is_graph(n) or n == 32
        11 => n < 128 and is_graph(n) and not is_word(n) or n == 95
        12 => 65 <= n and n <= 90
        13 => is_digit(n) or (65 <= n and n <= 70) or (97 <= n and n <= 102)
        14 => chr(n).is_alpha() and not is_number(n)
        15 => chr(n).is_upper()
        16 => chr(n).is_lower()
        17 => is_number(n)
        18 => in_ranges(DECIMAL, n)
        19 => if n < 128 then is_graph(n) and not is_word(n) and not "$+<=>^`|~".contains(chr(n))
            or n == 95 else in_ranges(PUNCT, n)
        20 => if n < 128 then "$+<=>^`|~".contains(chr(n)) else in_ranges(SYMBOL, n)
        21 => in_ranges(SEPARATOR, n)
        22 => in_ranges(SPACE_SEP, n)
        23 => n < 32 or (127 <= n and n <= 159)
        24 => chr(n).is_alpha()
        25 => in_ranges(WHITE, n)
        _ => true

# ---- the parser ----

# Flag bits: i, s, m.
F_I := 1
F_S := 2
F_M := 4

# Node kinds: 0 empty, 1 char (a, fold b), 2 any (a = dotall), 3 class (a, fold b),
# 4 assert (a), 5 cat (first child a), 6 alt (first child a), 7 group (index a
# or -1, body b), 8 repeat (body a, min b, max c or -1, greedy d). `nx` links siblings.
# Asserts: 0 begin text, 1 end text, 2 begin line, 3 end line, 4 word boundary, 5 not.
struct P
    s List[char]
    pos int
    groups int
    depth int
    names List[str]
    name_ix List[int]
    fail_kind str
    fail_at int
    fail_msg str
    nk List[int]
    na List[int]
    nb List[int]
    nc List[int]
    nd List[int]
    nx List[int]
    cls_at List[int]
    cls_items List[int]
    cls_neg List[int]
    fl int
    rmin int
    rmax int
    ak int
    av int
    aneg bool

fn P.fail(mut self, at int, kind str, msg str) int
    if self.fail_kind == ""
        self.fail_kind = kind
        self.fail_at = at
        self.fail_msg = msg
    -1

fn P.failed(self) bool
    self.fail_kind != ""

fn P.more(self, k int) bool
    self.pos + k < self.s.len()

## The character `k` ahead, or NUL at the end (callers check `more`).
fn P.peek(self, k int) char
    if self.pos + k < self.s.len()
        return self.s[self.pos + k]
    '\0'

fn P.eat(mut self, c char) bool
    if self.more(0) and self.s[self.pos] == c
        self.pos += 1
        return true
    false

fn P.mk(mut self, kind int, a int, b int, c int, d int) int
    self.nk.push(kind)
    self.na.push(a)
    self.nb.push(b)
    self.nc.push(c)
    self.nd.push(d)
    self.nx.push(-1)
    self.nk.len() - 1

fn P.alt(mut self, flags int) int
    saved := self.fl
    self.fl = flags
    r := self.alt_in()
    self.fl = saved
    r

fn P.alt_in(mut self) int
    first := self.cat()
    if self.failed()
        return -1
    if not self.eat('|')
        return first
    mut last := first
    while true
        nxt := self.cat()
        if self.failed()
            return -1
        self.nx[last] = nxt
        last = nxt
        if not self.eat('|')
            break
    self.mk(6, first, 0, 0, 0)

fn P.cat(mut self) int
    mut first := -1
    mut last := -1
    mut count := 0
    while self.more(0)
        c := self.peek(0)
        if c == '|' or c == ')'
            break
        start := self.pos
        atom := self.atom()
        if self.failed()
            return -1
        if atom == -2
            continue
        node := self.repeats(atom, start)
        if self.failed()
            return -1
        if first < 0
            first = node
        else
            self.nx[last] = node
        last = node
        count += 1
    if count == 0
        return self.mk(0, 0, 0, 0, 0)
    if count == 1
        return first
    self.mk(5, first, 0, 0, 0)

fn P.repeats(mut self, atom int, start int) int
    mut node := atom
    mut repeated := false
    while true
        at := self.pos
        c := self.peek(0)
        mut mn := 0
        mut mx := -1
        if not self.more(0)
            return node
        if c == '*'
            self.pos += 1
        elif c == '+'
            self.pos += 1
            mn = 1
        elif c == '?'
            self.pos += 1
            mx = 1
        elif c == '{'
            r := self.counted()
            if r < 0
                return -1
            if r == 0
                return node
            mn = self.rmin
            mx = self.rmax
        else
            return node
        if repeated
            return self.fail(
                at,
                "bad_repeat",
                "a repetition operator can't follow another one; group it with `(?:...)`",
            )
        greedy := not self.eat('?')
        node = self.mk(8, node, mn, mx, if greedy then 1 else 0)
        repeated = true
    node

fn P.digits(self, k int) int
    mut v := 0
    mut j := k
    while self.more(j) and is_digit(self.peek(j).code())
        v = v * 10 + self.peek(j).code() - 48
        if v > 1099511627776
            v = 1099511627776
        j += 1
    j

fn P.number(self, from int, to int) int
    mut v := 0
    mut j := from
    while j < to
        v = v * 10 + self.peek(j).code() - 48
        if v > 1099511627776
            v = 1099511627776
        j += 1
    v

## `{n}`, `{n,}` or `{n,m}` at the cursor: 1 with `rmin`/`rmax` set (-1 for
## no upper bound), 0 when the `{` is a literal, -1 for an error.
fn P.counted(mut self) int
    at := self.pos
    mut k := 1
    e1 := self.digits(k)
    if e1 == k
        return 0
    lo := self.number(k, e1)
    k = e1
    mut hi := lo
    if self.peek(k) == ','
        k += 1
        if self.peek(k) == '}'
            hi = -1
        else
            e2 := self.digits(k)
            if e2 == k
                return 0
            hi = self.number(k, e2)
            k = e2
    if self.peek(k) != '}' or not self.more(k)
        return 0
    self.pos += k + 1
    if lo > 1000 or hi > 1000
        return self.fail(at, "bad_repeat", "a repetition count can be at most 1000")
    if hi >= 0 and hi < lo
        return self.fail(
            at,
            "bad_repeat",
            "the lower repetition count is greater than the upper one",
        )
    self.rmin = lo
    self.rmax = hi
    1

fn ch(n int) str
    "{chr(n)}"

fn P.atom(mut self) int
    f := self.fl
    at := self.pos
    c := self.s[self.pos]
    self.pos += 1
    if c == '('
        return self.group(at)
    if c == '['
        return self.class_node(at, f)
    if c == '.'
        return self.mk(2, if f.bit_and(F_S) != 0 then 1 else 0, 0, 0, 0)
    if c == '^'
        return self.mk(4, if f.bit_and(F_M) != 0 then 2 else 0, 0, 0, 0)
    if c == '$'
        return self.mk(4, if f.bit_and(F_M) != 0 then 3 else 1, 0, 0, 0)
    if c == '*' or c == '+' or c == '?'
        return self.fail(at, "nothing_to_repeat", "`{c}` has nothing before it to repeat")
    if c == '\\'
        return self.escape(f, at)
    self.mk(1, c.code(), if f.bit_and(F_I) != 0 then 1 else 0, 0, 0)

fn P.group(mut self, at int) int
    f := self.fl
    self.depth += 1
    if self.depth > 200
        return self.fail(at, "too_large", "groups are nested more than 200 deep")
    mut inner := f
    mut index := -1
    if self.eat('?')
        c := self.peek(0)
        if c == ':' and self.more(0)
            self.pos += 1
        elif (c == 'P' or c == '<') and self.more(0)
            if c == '<' and (self.peek(1) == '=' or self.peek(1) == '!') and self.more(1)
                return self.fail(
                    at,
                    "unsupported",
                    "lookbehind isn't supported: the engine runs in linear time",
                )
            if c == 'P'
                if (self.peek(1) == '=' or self.peek(1) == '>') and self.more(1)
                    return self.fail(
                        at,
                        "unsupported",
                        "named backreferences aren't supported: the engine runs in linear time",
                    )
                self.pos += 1
                if self.peek(0) != '<' or not self.more(0)
                    return self.fail(self.pos, "bad_flag", "`(?P` must be followed by `<name>`")
            self.pos += 1
            name_at := self.pos
            mut name := ""
            mut ok := true
            while self.more(0) and self.peek(0) != '>'
                d := self.peek(0)
                if not is_word(d.code())
                    return self.fail(self.pos, "bad_group_name", "`{d}` can't be in a group name")
                name = "{name}{d}"
                self.pos += 1
            if not self.eat('>')
                return self.fail(name_at, "bad_group_name", "a group name must end with `>`")
            if name == "" or is_digit(self.s[name_at].code())
                return self.fail(
                    name_at,
                    "bad_group_name",
                    "a group name is not empty and doesn't start with a digit",
                )
            if self.names.contains(name)
                return self.fail(name_at, "bad_group_name", "two groups are named `{name}`")
            index = self.groups
            self.groups += 1
            self.names.push(name)
            self.name_ix.push(index)
        elif (c == '=' or c == '!') and self.more(0)
            return self.fail(
                at,
                "unsupported",
                "lookahead isn't supported: the engine runs in linear time",
            )
        else
            # Flags: `(?i)`, `(?-s)`, `(?im:...)`.
            mut on := true
            while true
                if not self.more(0)
                    return self.fail(at, "unclosed_group", "`(` is never closed")
                d := self.s[self.pos]
                self.pos += 1
                mut bit := 0
                if d == 'i'
                    bit = F_I
                elif d == 's'
                    bit = F_S
                elif d == 'm'
                    bit = F_M
                if bit != 0
                    inner = if on then inner.bit_or(bit) else inner.bit_and(7 - bit)
                elif d == '-' and on
                    on = false
                elif d == ')'
                    # `(?i)` applies to the rest of the enclosing group.
                    self.fl = inner
                    self.depth -= 1
                    return -2
                elif d == ':'
                    break
                else
                    return self.fail(
                        self.pos - 1,
                        "bad_flag",
                        "`{d}` isn't a flag; the flags are i, s and m",
                    )
    else
        index = self.groups
        self.groups += 1
    body := self.alt(inner)
    if self.failed()
        return -1
    if not self.eat(')')
        return self.fail(at, "unclosed_group", "`(` is never closed")
    self.depth -= 1
    self.mk(7, index, body, 0, 0)

fn hexval(n int) int
    if is_digit(n)
        return n - 48
    if 65 <= n and n <= 70
        return n - 55
    if 97 <= n and n <= 102
        return n - 87
    -1

fn hex_upper(n int) str
    if n < 16
        return "{"0123456789ABCDEF".slice(n, n + 1)}"
    "{hex_upper(n / 16)}{hex_upper(n % 16)}"

## The code point of `\xHH` or `\x{H...}` after the `x`, or -1 with the error set.
fn P.hex(mut self, at int) int
    bad := "`\\x` needs two hex digits or `\{hex}`"
    mut code := 0
    if self.eat('{')
        mut n := 0
        while self.more(0) and hexval(self.peek(0).code()) >= 0
            code = code * 16 + hexval(self.peek(0).code())
            if code > 4294967295
                code = 4294967295
            n += 1
            self.pos += 1
        if n == 0 or not self.eat('}')
            return self.fail(at, "bad_escape", bad)
    else
        if not self.more(1) or hexval(self.peek(0).code()) < 0 or hexval(self.peek(1).code()) < 0
            return self.fail(at, "bad_escape", bad)
        code = hexval(self.peek(0).code()) * 16 + hexval(self.peek(1).code())
        self.pos += 2
    if code > 1114111 or (55296 <= code and code <= 57343)
        return self.fail(at, "bad_escape", "`{hex_upper(code)}` isn't a Unicode scalar value")
    code

## The Unicode class `\p{name}` after the `p` or `P`: sets `ak` = 1, `av`, `aneg`.
fn P.prop_name(mut self, at int, neg bool) int
    mut name := ""
    if self.eat('{')
        while true
            if not self.more(0)
                return self.fail(at, "bad_class", "`\\p\{` is never closed")
            c := self.s[self.pos]
            self.pos += 1
            if c == '}'
                break
            name = "{name}{c}"
    else
        if not self.more(0)
            return self.fail(at, "bad_escape", "`\\p` needs a class name")
        name = "{self.s[self.pos]}"
        self.pos += 1
    mut n := neg
    if name.starts_with("^")
        name = name.slice(1, name.chars().len())
        n = not n
    id := unicode_id(name)
    if id < 0
        return self.fail(
            at,
            "bad_class",
            "`{name}` isn't a supported Unicode class; supported: {UNICODE_NAMES}",
        )
    self.ak = 1
    self.av = id
    self.aneg = n
    0

fn unicode_id(name str) int
    if name == "Letter"
        return 14
    if name == "Uppercase_Letter"
        return 15
    if name == "Lowercase_Letter"
        return 16
    if name == "Number"
        return 17
    if name == "Decimal_Number"
        return 18
    if name == "Punctuation"
        return 19
    if name == "Symbol"
        return 20
    if name == "Separator"
        return 21
    if i := UNICODE.index_of(name)
        return UNICODE_ID[i]
    if i := SCRIPTS.index_of(name)
        return SCRIPT_BASE + i
    -1

fn P.set_item(mut self, id int, neg bool)
    self.cls_items.push(if neg then 2 else 1)
    self.cls_items.push(id)
    self.cls_items.push(0)

fn P.perl(mut self, id int, neg bool) int
    self.cls_at.push(self.cls_items.len())
    self.cls_neg.push(0)
    self.set_item(id, neg)
    self.mk(3, self.cls_at.len() - 1, 0, 0, 0)

## The escape after a `\` outside a class.
fn P.escape(mut self, f int, at int) int
    if not self.more(0)
        return self.fail(at, "bad_escape", "a pattern can't end with `\\`")
    c := self.s[self.pos]
    self.pos += 1
    if c == 'd'
        return self.perl(P_DIGIT, false)
    if c == 'D'
        return self.perl(P_DIGIT, true)
    if c == 'w'
        return self.perl(P_WORD, false)
    if c == 'W'
        return self.perl(P_WORD, true)
    if c == 's'
        return self.perl(P_SPACE, false)
    if c == 'S'
        return self.perl(P_SPACE, true)
    if c == 'p' or c == 'P'
        if self.prop_name(at, c == 'P') < 0
            return -1
        node := self.perl(self.av, self.aneg)
        self.nb[node] = if f.bit_and(F_I) != 0 then 1 else 0
        return node
    if c == 'b'
        return self.mk(4, 4, 0, 0, 0)
    if c == 'B'
        return self.mk(4, 5, 0, 0, 0)
    if c == 'A'
        return self.mk(4, 0, 0, 0, 0)
    if c == 'z'
        return self.mk(4, 1, 0, 0, 0)
    if '1' <= c and c <= '9'
        return self.fail(
            at,
            "unsupported",
            "backreferences aren't supported: the engine runs in linear time",
        )
    code := self.char_escape(c, at)
    if code < 0
        return -1
    self.mk(1, code, if f.bit_and(F_I) != 0 then 1 else 0, 0, 0)

## The code point an escape letter or punctuation stands for, or -1 with the error set.
fn P.char_escape(mut self, c char, at int) int
    if c == 'n'
        return 10
    if c == 't'
        return 9
    if c == 'r'
        return 13
    if c == 'f'
        return 12
    if c == 'v'
        return 11
    if c == 'a'
        return 7
    if c == 'x'
        return self.hex(at)
    n := c.code()
    if not (is_alpha(n) or is_digit(n))
        return n
    self.fail(at, "bad_escape", "`\\{c}` isn't an escape")

fn P.class_node(mut self, at int, f int) int
    k := self.class(at)
    if k < 0
        return -1
    self.mk(3, k, if f.bit_and(F_I) != 0 then 1 else 0, 0, 0)

## One class atom: a character (`ak` 0, `av`) or a set (`ak` 1, `av`, `aneg`).
fn P.class_atom(mut self, at int) int
    c := self.s[self.pos]
    self.pos += 1
    if c != '\\'
        self.ak = 0
        self.av = c.code()
        return 0
    if not self.more(0)
        return self.fail(at, "unclosed_class", "`[` is never closed")
    e := self.s[self.pos]
    self.pos += 1
    self.ak = 1
    self.aneg = false
    if e == 'd' or e == 'D'
        self.av = P_DIGIT
        self.aneg = e == 'D'
    elif e == 'w' or e == 'W'
        self.av = P_WORD
        self.aneg = e == 'W'
    elif e == 's' or e == 'S'
        self.av = P_SPACE
        self.aneg = e == 'S'
    elif e == 'p' or e == 'P'
        return self.prop_name(at, e == 'P')
    else
        self.ak = 0
        code := self.char_escape(e, at)
        if code < 0
            return -1
        self.av = code
    0

fn P.range_item(mut self, lo int, hi int)
    self.cls_items.push(0)
    self.cls_items.push(lo)
    self.cls_items.push(hi)

## A class after its `[`: its index, or -1 with the error set.
fn P.class(mut self, at int) int
    self.cls_at.push(self.cls_items.len())
    self.cls_neg.push(if self.eat('^') then 1 else 0)
    k := self.cls_at.len() - 1
    mut first := true
    while true
        if not self.more(0)
            return self.fail(at, "unclosed_class", "`[` is never closed")
        c := self.peek(0)
        if c == ']' and not first
            self.pos += 1
            return k
        first = false
        item_at := self.pos
        if c == '[' and self.peek(1) == ':' and self.more(1)
            mut end := -1
            mut j := self.pos + 2
            while j + 1 < self.s.len()
                if self.s[j] == ':' and self.s[j + 1] == ']'
                    end = j
                    break
                j += 1
            if end >= 0
                mut name := ""
                mut j2 := self.pos + 2
                while j2 < end
                    name = "{name}{self.s[j2]}"
                    j2 += 1
                mut neg := false
                if name.starts_with("^")
                    name = name.slice(1, name.chars().len())
                    neg = true
                id := POSIX.index_of(name) else -1
                if id < 0
                    return self.fail(item_at, "bad_class", "`[:{name}:]` isn't a POSIX class")
                self.set_item(id, neg)
                self.pos = end + 2
                continue
        if self.class_atom(item_at) < 0
            return -1
        if self.ak == 1
            self.set_item(self.av, self.aneg)
            continue
        lo := self.av
        if self.peek(0) == '-' and self.more(1) and self.peek(1) != ']'
            self.pos += 1
            hi_at := self.pos
            if self.class_atom(hi_at) < 0
                return -1
            if self.ak == 1
                return self.fail(
                    hi_at,
                    "bad_range",
                    "a range ends at a single character, not a class",
                )
            hi := self.av
            if hi < lo
                return self.fail(
                    item_at,
                    "bad_range",
                    "the range `{ch(lo)}-{ch(hi)}` runs backwards",
                )
            self.range_item(lo, hi)
        else
            self.range_item(lo, lo)
    -1

# ---- the program ----

# Opcodes; each instruction is four words: op, x, y, 0.
I_CHAR := 0
I_FOLD := 1
I_ANY := 2
I_ANYNL := 3
I_CLASS := 4
I_SPLIT := 5
I_JMP := 6
I_SAVE := 7
I_ASSERT := 8
I_MATCH := 9

## The most instructions a program has (std.regex.3).
MAX_PROG := 50000

struct C
    p P
    code List[int]
    full bool
    classes int
    rev bool

fn C.push(mut self, op int, x int, y int) int
    if self.code.len() / 4 >= MAX_PROG
        self.full = true
        return 0
    self.code.push(op)
    self.code.push(x)
    self.code.push(y)
    self.code.push(0)
    self.code.len() / 4 - 1

fn C.here(self) int
    self.code.len() / 4

fn C.patch(mut self, at int, x int, y int)
    if not self.full
        self.code[at * 4 + 1] = x
        self.code[at * 4 + 2] = y

fn C.emit(mut self, n int)
    if self.full
        return
    k := self.p.nk[n]
    if k == 1
        c := self.p.na[n]
        if self.p.nb[n] == 1 and (lower_of(c) != c or upper_of(c) != c)
            self.push(I_FOLD, lower_of(c), 0)
        else
            self.push(I_CHAR, c, 0)
    elif k == 2
        self.push(if self.p.na[n] == 1 then I_ANY else I_ANYNL, 0, 0)
    elif k == 3
        at := self.push(I_CLASS, self.p.na[n], self.p.nb[n])
        if not self.full
            self.code[at * 4 + 3] = self.classes * 128
        self.classes += 1
    elif k == 4
        self.push(I_ASSERT, self.p.na[n], 0)
    elif k == 5
        mut kids := List[int]()
        mut c := self.p.na[n]
        while c >= 0
            kids.push(c)
            c = self.p.nx[c]
        mut i := 0
        while i < kids.len()
            self.emit(if self.rev then kids[kids.len() - 1 - i] else kids[i])
            i += 1
    elif k == 6
        mut jumps := List[int]()
        mut a := self.p.na[n]
        while a >= 0
            nxt := self.p.nx[a]
            if nxt >= 0
                split := self.push(I_SPLIT, 0, 0)
                self.emit(a)
                jumps.push(self.push(I_JMP, 0, 0))
                self.patch(split, split + 1, self.here())
            else
                self.emit(a)
            a = nxt
        end := self.here()
        for j in jumps
            self.patch(j, end, 0)
    elif k == 7
        i := self.p.na[n]
        if i >= 0 and not self.rev
            self.push(I_SAVE, 2 * i, 0)
            self.emit(self.p.nb[n])
            self.push(I_SAVE, 2 * i + 1, 0)
        else
            self.emit(self.p.nb[n])
    elif k == 8
        body := self.p.na[n]
        mn := self.p.nb[n]
        mx := self.p.nc[n]
        greedy := self.p.nd[n] == 1
        mut i := 0
        while i < mn and not self.full
            self.emit(body)
            i += 1
        if mx < 0
            l := self.push(I_SPLIT, 0, 0)
            self.emit(body)
            self.push(I_JMP, l, 0)
            end := self.here()
            if greedy
                self.patch(l, l + 1, end)
            else
                self.patch(l, end, l + 1)
        else
            mut splits := List[int]()
            mut j := mn
            while j < mx and not self.full
                splits.push(self.push(I_SPLIT, 0, 0))
                self.emit(body)
                j += 1
            end := self.here()
            for s in splits
                if greedy
                    self.patch(s, s + 1, end)
                else
                    self.patch(s, end, s + 1)

## The kind a parser failure names.
fn kind_of(kind str) RegexKind
    match kind
        "unclosed_group" => UnclosedGroup
        "unopened_group" => UnopenedGroup
        "unclosed_class" => UnclosedClass
        "bad_escape" => BadEscape
        "bad_repeat" => BadRepeat
        "nothing_to_repeat" => NothingToRepeat
        "bad_range" => BadRange
        "bad_class" => BadClass
        "bad_group_name" => BadGroupName
        "bad_flag" => BadFlag
        "too_large" => TooLarge
        _ => Unsupported

fn rule_of(kind str) str
    mut rule := "std.regex.22"
    if kind == "unclosed_group"
        rule = "std.regex.11"
    elif kind == "unopened_group"
        rule = "std.regex.12"
    elif kind == "unclosed_class"
        rule = "std.regex.13"
    elif kind == "bad_escape"
        rule = "std.regex.14"
    elif kind == "bad_repeat"
        rule = "std.regex.15"
    elif kind == "nothing_to_repeat"
        rule = "std.regex.16"
    elif kind == "bad_range"
        rule = "std.regex.17"
    elif kind == "bad_class"
        rule = "std.regex.18"
    elif kind == "bad_group_name"
        rule = "std.regex.19"
    elif kind == "bad_flag"
        rule = "std.regex.20"
    elif kind == "unsupported"
        rule = "std.regex.21"
    rule

## The literal every match starts with: the characters the program must take
## before its first branch, jump, class or assertion (std.regex.27). Fewer than
## 2 characters is no prefix: the start set (`start_set`) already skips those.
fn literal_prefix(code List[int]) List[int]
    mut out := List[int]()
    mut pc := 0
    n := code.len() / 4
    while pc < n
        op := code[pc * 4]
        if op == I_SAVE
            pc += 1
        elif op == I_CHAR
            out.push(code[pc * 4 + 1])
            pc += 1
        else
            break
    if out.len() < 2
        return []
    out

## The first `i >= lo` with the prefix at `text[i..]`, or -1 (std.regex.27).
fn find_prefix(pre List[int], text List[char], lo int) int
    n := pre.len()
    last := text.len() - n
    first := pre[0]
    mut i := lo
    while i <= last
        if text[i].code() == first
            mut k := 1
            while k < n and text[i + k].code() == pre[k]
                k += 1
            if k == n
                return i
        i += 1
    -1

## The ASCII characters a match can start with (empty: no restriction, because
## the pattern can match the empty string or starts with `.`). Assertions are
## taken as true, so the set only ever grows.
fn start_set(re Regex) List[int]
    n := re.code.len() / 4
    mut seen := List[int]()
    mut i := 0
    while i < n
        seen.push(0)
        i += 1
    mut flags := List[int]()
    i = 0
    while i < 128
        flags.push(0)
        i += 1
    mut stack := [0]
    while stack.len() > 0
        pc := stack[stack.len() - 1]
        stack.pop()
        if seen[pc] == 1
            continue
        seen[pc] = 1
        op := re.code[pc * 4]
        x := re.code[pc * 4 + 1]
        if op == I_MATCH or op == I_ANY or op == I_ANYNL
            return []
        elif op == I_JMP
            stack.push(x)
        elif op == I_SPLIT
            stack.push(x)
            stack.push(re.code[pc * 4 + 2])
        elif op == I_SAVE or op == I_ASSERT
            stack.push(pc + 1)
        elif op == I_CHAR
            if x < 128
                flags[x] = 1
        elif op == I_FOLD
            if x < 128
                flags[x] = 1
                flags[upper_of(x)] = 1
        else
            mut c := 0
            while c < 128
                if class_matches(re, x, c, re.code[pc * 4 + 2] == 1)
                    flags[c] = 1
                c += 1
    flags

## The ASCII table of every class instruction, in program order; word 3 of the
## instruction is its offset (the matcher reads one flag for an ASCII character).
fn class_tables(re Regex, code List[int]) List[int]
    mut tab := List[int]()
    mut memo_key := List[int]()
    mut memo_at := List[int]()
    mut pc := 0
    while pc < code.len() / 4
        if code[pc * 4] == I_CLASS
            key := code[pc * 4 + 1] * 2 + code[pc * 4 + 2]
            at := memo_key.index_of(key) else -1
            if at >= 0
                mut c := 0
                while c < 128
                    tab.push(tab[memo_at[at] + c])
                    c += 1
            else
                memo_key.push(key)
                memo_at.push(tab.len())
                mut c := 0
                while c < 128
                    tab.push(
                        if class_matches(
                            re,
                            code[pc * 4 + 1],
                            c,
                            code[pc * 4 + 2] == 1,
                        ) then 1 else 0,
                    )
                    c += 1
        pc += 1
    tab

## The closures that let the matcher skip the stack when no capture group is
## wanted and the program has no assertion: the same instructions in the same
## order that following `Jmp`, `Split` and `Save` from an instruction would
## reach. See `clo`; empty when there is an assertion or the table would be huge.
fn closures(code List[int]) List[int]
    n := code.len() / 4
    mut pc := 0
    while pc < n
        if code[pc * 4] == I_ASSERT
            return []
        pc += 1
    mut out := List[int]()
    mut seen := List[int]()
    pc = 0
    while pc <= n
        out.push(-1)
        seen.push(0)
        pc += 1
    mut stamp := 0
    pc = 0
    while pc <= n
        op := if pc < n then code[pc * 4] else I_SAVE
        if pc == n or (op != I_JMP and op != I_SPLIT and op != I_SAVE and op != I_MATCH)
            stamp += 1
            out[pc] = out.len()
            at := out.len()
            out.push(0)
            mut stack := [if pc == n then 0 else pc + 1]
            while stack.len() > 0
                q := stack[stack.len() - 1]
                stack.pop()
                if seen[q] == stamp
                    continue
                seen[q] = stamp
                o := code[q * 4]
                if o == I_JMP
                    stack.push(code[q * 4 + 1])
                elif o == I_SPLIT
                    stack.push(code[q * 4 + 2])
                    stack.push(code[q * 4 + 1])
                elif o == I_SAVE
                    stack.push(q + 1)
                else
                    out.push(q)
            out[at] = out.len() - at - 1
            if out.len() > 4000000
                return []
        pc += 1
    out

## Compile `pattern` (std.regex.2).
pub fn compile(pattern str) Regex ! RegexError
    mut p := P(
        s: pattern.chars(),
        pos: 0,
        groups: 1,
        depth: 0,
        names: [],
        name_ix: [],
        fail_kind: "",
        fail_at: 0,
        fail_msg: "",
        nk: [],
        na: [],
        nb: [],
        nc: [],
        nd: [],
        nx: [],
        cls_at: [],
        cls_items: [],
        cls_neg: [],
        fl: 0,
        rmin: 0,
        rmax: 0,
        ak: 0,
        av: 0,
        aneg: false,
    )
    node := p.alt(0)
    if not p.failed() and p.pos < p.s.len()
        p.fail(p.pos, "unopened_group", "`)` has no matching `(`")
    if p.failed()
        return RegexError(
            pattern: pattern,
            at: p.fail_at,
            kind: kind_of(p.fail_kind),
            rule: rule_of(p.fail_kind),
            message: p.fail_msg,
        )
    mut c := C(p: p, code: [], full: false, classes: 0, rev: false)
    c.push(I_SAVE, 0, 0)
    c.emit(node)
    c.push(I_SAVE, 1, 0)
    c.push(I_MATCH, 0, 0)
    if c.full
        return RegexError(
            pattern: pattern,
            at: 0,
            kind: TooLarge,
            rule: "std.regex.22",
            message: "the pattern compiles to more than 50000 instructions; use smaller repetition counts",
        )
    anchored := c.code[4] == I_ASSERT and c.code[5] == 0
    mut re := Regex(
        pat: pattern,
        code: c.code,
        cls_at: p.cls_at,
        cls_items: p.cls_items,
        cls_neg: p.cls_neg,
        groups: p.groups,
        names: p.names,
        name_ix: p.name_ix,
        anchored: anchored,
        start: [],
        tab: [],
        clo: [],
        rcode: [],
        rtab: [],
        rclo: [],
        fwd: Dfa(k: 0, cmap: [], trans: [], hit0: 0),
        rev: Dfa(k: 0, cmap: [], trans: [], hit0: 0),
        prefix: [],
    )
    re.prefix = literal_prefix(c.code)
    re.start = start_set(re)
    re.tab = class_tables(re, re.code)
    re.clo = closures(re.code)
    if re.clo.len() > 0
        mut rc := C(p: p, code: [], full: false, classes: 0, rev: true)
        rc.emit(node)
        rc.push(I_MATCH, 0, 0)
        if not rc.full
            re.rcode = rc.code
            re.rtab = class_tables(re, rc.code)
            re.rclo = closures(rc.code)
            re.fwd = build_dfa(re, re.code, re.tab, re.clo, true)
            re.rev = build_dfa(re, re.rcode, re.rtab, re.rclo, false)
            if re.rev.k == 0
                re.fwd = Dfa(k: 0, cmap: [], trans: [], hit0: 0)
    re

# ---- the DFAs ----

## A DFA over the ASCII characters (`k` classes of characters no instruction
## tells apart, `cmap` maps a character to its class; 0 classes: not built).
## `trans[state * 128 + c]` is the next state times 4, plus 2
## when that state holds `Match` and 1 when it is dead (no threads).
struct Dfa
    k int
    cmap List[int]
    trans List[int]
    hit0 int

## The states being built: the instructions of each, in priority order.
struct B
    hashes List[int]
    sat List[int]
    slen List[int]
    sdata List[int]
    m List[int]
    flags List[int]
    trans List[int]
    kc int

fn B.intern(mut self, items List[int], mk int, code List[int]) int
    mut h := mk
    for x in items
        h = (h * 1000003 + x + 1) % 2147483647
    mut i := 0
    while i < self.hashes.len()
        if self.hashes[i] == h and self.slen[i] == items.len() and self.m[i] == mk
            mut same := true
            mut j := 0
            while j < items.len()
                if self.sdata[self.sat[i] + j] != items[j]
                    same = false
                    break
                j += 1
            if same
                return i
        i += 1
    self.hashes.push(h)
    self.sat.push(self.sdata.len())
    self.slen.push(items.len())
    self.m.push(mk)
    mut flag := if items.len() == 0 then 1 else 0
    for x in items
        self.sdata.push(x)
        if code[x * 4] == I_MATCH
            flag += 2
    self.flags.push(flag)
    mut j2 := 0
    while j2 < self.kc
        self.trans.push(-1)
        j2 += 1
    self.hashes.len() - 1

## Whether consuming instruction `pc` of `code` takes ASCII character `c`.
fn takes(re Regex, code List[int], tab List[int], pc int, c int) bool
    op := code[pc * 4]
    x := code[pc * 4 + 1]
    if op == I_CHAR
        return c == x
    if op == I_FOLD
        return lower_of(c) == x
    if op == I_ANY
        return true
    if op == I_ANYNL
        return c != 10
    tab[code[pc * 4 + 3] + c] == 1

## The most states a DFA is built with; a pattern needing more matches with the VM.
MAX_STATES := 256
MAX_DFA_PROG := 1500

## Build the DFA of `code` by exploring every state over the ASCII character
## classes. Forward: the unanchored leftmost-first search (the states are the
## VM's thread lists in priority order, cut at `Match`, with a new thread
## appended while nothing has matched). Backward: the set of instructions
## reached reading the text in reverse from a match end.
fn build_dfa(re Regex, code List[int], tab List[int], clo List[int], forward bool) Dfa
    n := code.len() / 4
    empty := Dfa(k: 0, cmap: [], trans: [], hit0: 0)
    if clo.len() == 0 or n > MAX_DFA_PROG
        return empty
    # Split the characters into classes no instruction tells apart: each
    # consuming instruction splits every class into those it takes and those it doesn't.
    mut cmap := [0 for k0 in 0..128]
    mut kc := 1
    mut ip := 0
    while ip < n
        op := code[ip * 4]
        x := code[ip * 4 + 1]
        if op == I_CHAR or op == I_FOLD or op == I_ANYNL or op == I_CLASS
            ux := if op == I_FOLD and x < 128 then upper_of(x) else x
            off := code[ip * 4 + 3]
            mut remap := [-1 for k5 in 0..(2 * kc)]
            mut next := 0
            mut c := 0
            while c < 128
                mut bit := 0
                if op == I_CHAR
                    bit = if c == x then 1 else 0
                elif op == I_FOLD
                    bit = if c == x or c == ux then 1 else 0
                elif op == I_ANYNL
                    bit = if c == 10 then 1 else 0
                else
                    bit = tab[off + c]
                key := cmap[c] * 2 + bit
                if remap[key] < 0
                    remap[key] = next
                    next += 1
                cmap[c] = remap[key]
                c += 1
            kc = next
        ip += 1
    mut reps := [0 for k6 in 0..kc]
    mut c3 := 127
    while c3 >= 0
        reps[cmap[c3]] = c3
        c3 -= 1
    mut b := B(hashes: [], sat: [], slen: [], sdata: [], m: [], flags: [], trans: [], kc: kc)
    mut seen := [0 for k1 in 0..n]
    mut stamp := 0
    mut out := List[int]()
    mut first := List[int]()
    off0 := clo[n]
    mut j0 := 1
    while j0 <= clo[off0]
        first.push(clo[off0 + j0])
        j0 += 1
    b.intern(if forward then first else first.sorted(), 0, code)
    mut cur := 0
    while cur < b.hashes.len()
        if b.hashes.len() > MAX_STATES
            return empty
        mut cls := 0
        while cls < kc
            c2 := reps[cls]
            stamp += 1
            out.clear()
            mut matched := false
            mut j := 0
            while j < b.slen[cur]
                pc := b.sdata[b.sat[cur] + j]
                if code[pc * 4] == I_MATCH
                    if forward
                        matched = true
                        break
                elif takes(re, code, tab, pc, c2)
                    off := clo[pc]
                    mut q := 1
                    while q <= clo[off]
                        t := clo[off + q]
                        if seen[t] != stamp
                            seen[t] = stamp
                            out.push(t)
                        q += 1
                j += 1
            m2 := if b.m[cur] == 1 or matched then 1 else 0
            if forward and m2 == 0
                off := clo[n]
                mut q := 1
                while q <= clo[off]
                    t := clo[off + q]
                    if seen[t] != stamp
                        seen[t] = stamp
                        out.push(t)
                    q += 1
            id := b.intern(if forward then out else out.sorted(), m2, code)
            b.trans[cur * kc + cls] = id
            cls += 1
        cur += 1
    if b.hashes.len() > MAX_STATES
        return empty
    mut i := 0
    while i < b.trans.len()
        b.trans[i] = b.trans[i] * 4 + b.flags[b.trans[i]]
        i += 1
    mut full := List[int]()
    mut st := 0
    while st < b.hashes.len()
        mut ch := 0
        while ch < 128
            full.push(b.trans[st * kc + cmap[ch]])
            ch += 1
        st += 1
    Dfa(k: kc, cmap: cmap, trans: full, hit0: b.flags[0].bit_and(2))

## Where the leftmost-first match from `start` ends: -1 for none, -2 when the
## text has a character outside ASCII (the VM takes over). With `earliest`,
## any end will do.
fn dfa_forward(d Dfa, text List[char], start int, earliest bool) int
    mut s := 0
    mut last := -1
    mut pos := start
    end := text.len()
    if d.hit0 != 0
        if earliest
            return pos
        last = pos
    while pos < end
        c := text[pos].code()
        if c >= 128
            return -2
        t := d.trans[s * 128 + c]
        s = t / 4
        pos += 1
        if t.bit_and(2) != 0
            if earliest
                return pos
            last = pos
        if t.bit_and(1) != 0
            break
    last

## The smallest `s` in `start..=end` with `text[s..end]` matching, scanning back
## from `end`: -1 for none, -2 for a character outside ASCII.
fn dfa_backward(d Dfa, text List[char], start int, end int) int
    mut s := 0
    mut found := -1
    mut pos := end
    if d.hit0 != 0
        found = pos
    while pos > start
        c := text[pos - 1].code()
        if c >= 128
            return -2
        t := d.trans[s * 128 + c]
        s = t / 4
        pos -= 1
        if t.bit_and(2) != 0
            found = pos
        if t.bit_and(1) != 0
            break
    found

# ---- the matcher ----

## A character class has `n` (before negation).
fn class_has(re Regex, k int, n int) bool
    mut i := re.cls_at[k]
    end := if k + 1 < re.cls_at.len() then re.cls_at[k + 1] else re.cls_items.len()
    while i < end
        kind := re.cls_items[i]
        if kind == 0
            if re.cls_items[i + 1] <= n and n <= re.cls_items[i + 2]
                return true
        elif prop_test(re.cls_items[i + 1], n) == (kind == 1)
            return true
        i += 3
    false

fn class_matches(re Regex, k int, n int, fold bool) bool
    mut hit := class_has(re, k, n)
    if not hit and fold
        hit = class_has(re, k, lower_of(n)) or class_has(re, k, upper_of(n))
    hit != (re.cls_neg[k] == 1)

fn holds(a int, text List[char], pos int) bool
    before := pos > 0 and is_word(text[pos - 1].code())
    after := pos < text.len() and is_word(text[pos].code())
    if a == 0
        return pos == 0
    if a == 1
        return pos == text.len()
    if a == 2
        return pos == 0 or text[pos - 1].code() == 10
    if a == 3
        return pos == text.len() or text[pos].code() == 10
    if a == 4
        return before != after
    before == after

## Scratch space for the matcher, reused across searches of one text. `mem`
## holds the two thread lists (the instruction of each thread), a mark per
## instruction and list, each list's length and its mark stamp; `caps` the
## capture words per thread, then the working copy at `work_at`; `st` the stack
## of `add`.
struct Vm
    n int
    slots int
    mem List[int]
    seen_at int
    cnt_at int
    stamp_at int
    caps List[int]
    work_at int
    st List[int]
    res List[int]
    ready bool

fn new_vm(re Regex, slots int) Vm
    n := re.code.len() / 4
    if re.fwd.k == 0 or slots > 2
        return full_vm(re, slots)
    Vm(
        n: n,
        slots: slots,
        mem: [0],
        seen_at: 2 * n,
        cnt_at: 4 * n,
        stamp_at: 4 * n + 2,
        caps: [0],
        work_at: 2 * n * slots,
        st: [0],
        res: if slots == 2 then [-1, -1] else [],
        ready: false,
    )

fn full_vm(re Regex, slots int) Vm
    n := re.code.len() / 4
    mut mem := [0 for k1 in 0..(4 * n + 4)]
    mem[4 * n + 2] = 1
    mem[4 * n + 3] = 1
    caps := [-1 for k2 in 0..(2 * n * slots + slots)]
    st := if re.clo.len() == 0 or slots > 2 then [0 for k4 in 0..(4 * n + 8)] else [0]
    Vm(
        n: n,
        slots: slots,
        mem: mem,
        seen_at: 2 * n,
        cnt_at: 4 * n,
        stamp_at: 4 * n + 2,
        caps: caps,
        work_at: 2 * n * slots,
        st: st,
        res: [-1 for k3 in 0..slots],
        ready: true,
    )

## Allocate the scratch space of the Pike VM (`new_vm` leaves it out when the
## DFAs can answer).
fn Vm.fill(mut self, re Regex)
    np := self.n
    self.mem = [0 for k1 in 0..(4 * np + 4)]
    self.mem[4 * np + 2] = 1
    self.mem[4 * np + 3] = 1
    self.caps = [-1 for k2 in 0..(2 * np * self.slots + self.slots)]
    if re.clo.len() == 0 or self.slots > 2
        self.st = [0 for k4 in 0..(4 * np + 8)]
    self.ready = true

## `add` through a closure (see `Regex.clo`): the threads of its instructions
## that list `w` doesn't have yet, each with the start in `vm.caps[vm.work_at + 0]`.
fn add_fast(re Regex, mut vm Vm, w int, off int)
    base := w * vm.n
    stamp := vm.mem[vm.stamp_at + w]
    count := re.clo[off]
    mut j := 1
    while j <= count
        pc := re.clo[off + j]
        if vm.mem[vm.seen_at + base + pc] != stamp
            vm.mem[vm.seen_at + base + pc] = stamp
            idx := base + vm.mem[vm.cnt_at + w]
            vm.mem[idx] = pc
            if vm.slots == 2
                vm.caps[idx * 2] = vm.caps[vm.work_at + 0]
            vm.mem[vm.cnt_at + w] += 1
        j += 1

## Follow empty transitions from `pc0` at `pos` in priority order, adding each
## reachable consuming instruction (and `Match`) to list `w`. The stack holds
## instruction numbers to try later, and below a negative word `-1 - slot` the
## capture word to put back when that branch is done.
fn add(re Regex, mut vm Vm, w int, pc0 int, pos int, text List[char])
    base := w * vm.n
    stamp := vm.mem[vm.stamp_at + w]
    mut sp := 0
    mut pc := pc0
    while true
        mut next := -1
        if vm.mem[vm.seen_at + base + pc] != stamp
            vm.mem[vm.seen_at + base + pc] = stamp
            op := re.code[pc * 4]
            if op == I_JMP
                next = re.code[pc * 4 + 1]
            elif op == I_SPLIT
                vm.st[sp] = re.code[pc * 4 + 2]
                sp += 1
                next = re.code[pc * 4 + 1]
            elif op == I_SAVE
                s := re.code[pc * 4 + 1]
                if s < vm.slots
                    vm.st[sp] = vm.caps[vm.work_at + s]
                    vm.st[sp + 1] = -1 - s
                    sp += 2
                    vm.caps[vm.work_at + s] = pos
                next = pc + 1
            elif op == I_ASSERT
                if holds(re.code[pc * 4 + 1], text, pos)
                    next = pc + 1
            else
                idx := base + vm.mem[vm.cnt_at + w]
                vm.mem[idx] = pc
                mut j := 0
                while j < vm.slots
                    vm.caps[idx * vm.slots + j] = vm.caps[vm.work_at + j]
                    j += 1
                vm.mem[vm.cnt_at + w] += 1
        if next < 0
            while sp > 0 and next < 0
                sp -= 1
                f := vm.st[sp]
                if f < 0
                    sp -= 1
                    vm.caps[vm.work_at + -1 - f] = vm.st[sp]
                else
                    next = f
            if next < 0
                break
        pc = next

## The leftmost-first match at or after `start` (std.regex.4); its capture
## words, two per group and -1 for a group that didn't take part, are left in
## `vm.res`. With `earliest` the first match found is returned without
## resolving priorities, which is enough to say whether there is one.
fn exec(re Regex, text List[char], start0 int, earliest bool, mut vm Vm) bool
    mut start := start0
    if re.prefix.len() > 0 and not re.anchored
        at := find_prefix(re.prefix, text, start0)
        if at < 0
            return false
        start = at
    if re.fwd.k > 0
        e := dfa_forward(re.fwd, text, start, earliest)
        if e == -1
            return false
        if e >= 0
            if earliest
                return true
            s := dfa_backward(re.rev, text, start, e)
            if s >= 0
                if vm.slots == 2
                    vm.res[0] = s
                    vm.res[1] = e
                    return true
                return pike(re, text, s, earliest, mut vm)
    pike(re, text, start, earliest, mut vm)

## The Pike VM search (see `exec`).
fn pike(re Regex, text List[char], start int, earliest bool, mut vm Vm) bool
    if not vm.ready
        vm.fill(re)
    if re.anchored and start > 0
        return false
    vm.mem[vm.cnt_at + 0] = 0
    vm.mem[vm.cnt_at + 1] = 0
    vm.mem[vm.stamp_at + 0] += 1
    vm.mem[vm.stamp_at + 1] += 1
    mut matched := false
    mut pos := start
    mut cur := 0
    fast := re.clo.len() > 0 and vm.slots <= 2
    while true
        if vm.mem[vm.cnt_at + cur] == 0 and not matched and not re.anchored and re.start.len() > 0
            while pos < text.len() and text[pos].code() < 128 and re.start[text[pos].code()] == 0
                pos += 1
        if not matched and (not re.anchored or pos == start)
            mut j := 0
            while j < vm.slots
                vm.caps[vm.work_at + j] = -1
                j += 1
            if fast
                if vm.slots == 2
                    vm.caps[vm.work_at + 0] = pos
                add_fast(re, mut vm, cur, re.clo[vm.n])
            else
                add(re, mut vm, cur, 0, pos, text)
        if vm.mem[vm.cnt_at + cur] == 0 and (matched or re.anchored or pos >= text.len())
            break
        c := if pos < text.len() then text[pos].code() else -1
        nxt := 1 - cur
        vm.mem[vm.cnt_at + nxt] = 0
        vm.mem[vm.stamp_at + nxt] += 1
        mut k := 0
        count := vm.mem[vm.cnt_at + cur]
        while k < count
            idx := cur * vm.n + k
            pc := vm.mem[idx]
            op := re.code[pc * 4]
            if op == I_MATCH
                if earliest
                    return true
                matched = true
                mut j := 0
                while j < vm.slots
                    vm.res[j] = vm.caps[idx * vm.slots + j]
                    j += 1
                if fast and vm.slots == 2
                    vm.res[1] = pos
                break
            x := re.code[pc * 4 + 1]
            mut ok := false
            if op == I_CHAR
                ok = c == x
            elif op == I_FOLD
                ok = c >= 0 and lower_of(c) == x
            elif op == I_ANY
                ok = c >= 0
            elif op == I_ANYNL
                ok = c >= 0 and c != 10
            elif c >= 0 and c < 128
                ok = re.tab[re.code[pc * 4 + 3] + c] == 1
            else
                ok = c >= 0 and class_matches(re, x, c, re.code[pc * 4 + 2] == 1)
            if ok
                mut j := 0
                while j < vm.slots
                    vm.caps[vm.work_at + j] = vm.caps[idx * vm.slots + j]
                    j += 1
                if fast
                    add_fast(re, mut vm, nxt, re.clo[pc])
                else
                    add(re, mut vm, nxt, pc + 1, pos + 1, text)
            k += 1
        cur = nxt
        if pos >= text.len()
            break
        pos += 1
    matched

## Every match, left to right, none overlapping (std.regex.6), as `slots`
## capture words each, flat. An empty match right after the previous match
## isn't one.
fn spans(re Regex, cs List[char], limit int, mut vm Vm) List[int]
    mut out := List[int]()
    mut pos := 0
    mut prev_end := -1
    mut count := 0
    while pos <= cs.len() and count < limit
        if not exec(re, cs, pos, false, mut vm)
            break
        s := vm.res[0]
        e := vm.res[1]
        if s == e and prev_end == e
            pos = e + 1
            continue
        pos = if e > s then e else e + 1
        prev_end = e
        for x in vm.res
            out.push(x)
        count += 1
    out

## `cs[a..b]` as a string: a slice of `text` when it is all ASCII (one byte per
## character), else built from the characters.
fn cut(text str, cs List[char], a int, b int) str
    if text.len() == cs.len()
        return text.slice(a, b)
    mut out := List[char]()
    mut i := a
    while i < b
        out.push(cs[i])
        i += 1
    out.join("")

## The trap of std.regex.7 and std.regex.24: a group the pattern doesn't have.
fn no_group(rule str, why str) int
    unreachable("{rule}: {why}")

# ---- the API ----

fn m_is_match(re Regex, text str) bool
    mut vm := new_vm(re, 0)
    exec(re, text.chars(), 0, true, mut vm)

fn m_find(re Regex, text str) Match?
    cs := text.chars()
    mut vm := new_vm(re, 2)
    if not exec(re, cs, 0, false, mut vm)
        return none
    Match(start: vm.res[0], end: vm.res[1], text: cut(text, cs, vm.res[0], vm.res[1]))

fn m_captures(re Regex, text str) Captures?
    cs := text.chars()
    mut vm := new_vm(re, 2 * re.groups)
    if not exec(re, cs, 0, false, mut vm)
        return none
    mut groups := List[str?]()
    for g in 0..re.groups
        if vm.res[2 * g] >= 0
            groups.push(cut(text, cs, vm.res[2 * g], vm.res[2 * g + 1]))
        else
            groups.push(none)
    mut named := Map[str, str]()
    for k in 0..re.names.len()
        if t := groups[re.name_ix[k]]
            named[re.names[k]] = t
    Captures(start: vm.res[0], end: vm.res[1], groups: groups, named: named)

fn m_find_all(re Regex, text str) List[Match]
    cs := text.chars()
    mut vm := new_vm(re, 2)
    sp := spans(re, cs, 1073741824, mut vm)
    mut out := List[Match]()
    mut i := 0
    while i < sp.len()
        out.push(Match(start: sp[i], end: sp[i + 1], text: cut(text, cs, sp[i], sp[i + 1])))
        i += 2
    out

fn m_group_all(re Regex, text str, group int) List[str]
    if group < 0 or group >= re.groups
        _ := no_group(
            "std.regex.24",
            "the pattern has groups 0 to {re.groups - 1}, not group {group}",
        )
    cs := text.chars()
    mut vm := new_vm(re, 2 * re.groups)
    sp := spans(re, cs, 1073741824, mut vm)
    stride := 2 * re.groups
    mut out := List[str]()
    mut i := 0
    while i < sp.len()
        if sp[i + 2 * group] < 0
            out.push("")
        else
            out.push(cut(text, cs, sp[i + 2 * group], sp[i + 2 * group + 1]))
        i += stride
    out

## The pieces of a replacement template (std.regex.7): `lits[k]` comes before
## group `refs[k]`, and the last literal after the last group.
struct Template
    lits List[str]
    refs List[int]
    ## Why the template is wrong (empty when it is fine).
    bad str

## The group a template reference names, or -1.
fn ref_of(re Regex, name str) int
    if name != "" and all_digits(name)
        n := name.to_int() else return -1
        return if n < re.groups then n else -1
    if k := re.names.index_of(name)
        return re.name_ix[k]
    -1

## What a template reference to `name` that names no group says (std.regex.7).
fn bad_ref(re Regex, name str) str
    if name != "" and all_digits(name)
        return "group {name}; the pattern has groups 0 to {re.groups - 1}"
    mut have := List[str]()
    for n in re.names
        have.push("\"{n}\"")
    "group `{name}`; the pattern's named groups are [{have.join(", ")}]"

fn all_digits(s str) bool
    for c in s.chars()
        if not is_digit(c.code())
            return false
    true

fn template(re Regex, rep str) Template
    cs := rep.chars()
    mut t := Template(lits: [], refs: [], bad: "")
    mut lit := ""
    mut i := 0
    while i < cs.len()
        if cs[i] != '$'
            lit = "{lit}{cs[i]}"
            i += 1
            continue
        nxt := if i + 1 < cs.len() then cs[i + 1] else '\0'
        has := i + 1 < cs.len()
        if has and nxt == '$'
            lit = "{lit}$"
            i += 2
        elif has and nxt == '{'
            mut end := -1
            mut j := i + 2
            while j < cs.len()
                if cs[j] == '}'
                    end = j
                    break
                j += 1
            if end < 0
                t.bad = "`$\{` without a closing `}`"
                return t
            name := cs[i + 2..end].join("")
            g := ref_of(re, name)
            if g < 0
                t.bad = bad_ref(re, name)
                return t
            t.lits.push(lit)
            lit = ""
            t.refs.push(g)
            i = end + 1
        elif has and is_word(nxt.code())
            mut j := i + 1
            while j < cs.len() and is_word(cs[j].code())
                j += 1
            name := cs[i + 1..j].join("")
            g := ref_of(re, name)
            if g < 0
                t.bad = bad_ref(re, name)
                return t
            t.lits.push(lit)
            lit = ""
            t.refs.push(g)
            i = j
        else
            lit = "{lit}$"
            i += 1
    t.lits.push(lit)
    t

## Replace the first `limit` matches (std.regex.7).
fn replace_n(re Regex, text str, rep str, limit int) str
    t := template(re, rep)
    if t.bad != ""
        _ := no_group("std.regex.7", "the replacement refers to {t.bad}")
    cs := text.chars()
    stride := if t.refs.len() == 0 then 2 else 2 * re.groups
    mut vm := new_vm(re, stride)
    sp := spans(re, cs, limit, mut vm)
    mut out := List[str]()
    mut last := 0
    mut i := 0
    while i < sp.len()
        out.push(cut(text, cs, last, sp[i]))
        mut k := 0
        while k < t.refs.len()
            out.push(t.lits[k])
            g := t.refs[k]
            if sp[i + 2 * g] >= 0
                out.push(cut(text, cs, sp[i + 2 * g], sp[i + 2 * g + 1]))
            k += 1
        out.push(t.lits[t.refs.len()])
        last = sp[i + 1]
        i += stride
    out.push(cut(text, cs, last, cs.len()))
    out.join("")

fn m_replace(re Regex, text str, rep str) str
    replace_n(re, text, rep, 1073741824)

fn m_replace_first(re Regex, text str, rep str) str
    replace_n(re, text, rep, 1)

## The text between matches (std.regex.8).
fn m_split(re Regex, text str) List[str]
    cs := text.chars()
    mut vm := new_vm(re, 2)
    sp := spans(re, cs, 1073741824, mut vm)
    mut out := List[str]()
    mut beg := 0
    mut end := 0
    mut i := 0
    while i < sp.len()
        end = sp[i]
        if sp[i + 1] != 0
            out.push(cut(text, cs, beg, end))
        beg = sp[i + 1]
        i += 2
    if end != cs.len() or out.len() == 0
        out.push(cut(text, cs, beg, cs.len()))
    out

## `s` with every character the pattern syntax treats specially escaped (std.regex.1).
pub fn escape(s str) str
    mut out := List[str]()
    for c in s.chars()
        if "\\.+*?()|[]\{}^$-".contains(c)
            out.push("\\")
        out.push("{c}")
    out.join("")

## A `Regex` built by a literal from its pattern alone (std.regex.2) is
## compiled here; a pattern that doesn't compile traps.
fn ready(re Regex) Regex
    if re.code.len() > 0
        return re
    r := compile(re.pat) else e
        unreachable("std.regex.2: `regex.Regex(pat: ...)` holds a pattern that doesn't compile ({e.message}): make a regex with `regex.compile`")
    r

pub fn is_match(re Regex, text str) bool
    m_is_match(ready(re), text)

pub fn find(re Regex, text str) Match?
    m_find(ready(re), text)

pub fn find_all(re Regex, text str) List[Match]
    m_find_all(ready(re), text)

pub fn captures(re Regex, text str) Captures?
    m_captures(ready(re), text)

pub fn group_all(re Regex, text str, group int) List[str]
    m_group_all(ready(re), text, group)

pub fn replace(re Regex, text str, rep str) str
    m_replace(ready(re), text, rep)

pub fn replace_first(re Regex, text str, rep str) str
    m_replace_first(ready(re), text, rep)

pub fn split(re Regex, text str) List[str]
    m_split(ready(re), text)

pub fn Regex.is_match(self, text str) bool
    m_is_match(ready(self), text)

pub fn Regex.find(self, text str) Match?
    m_find(ready(self), text)

pub fn Regex.captures(self, text str) Captures?
    m_captures(ready(self), text)

pub fn Regex.find_all(self, text str) List[Match]
    m_find_all(ready(self), text)

pub fn Regex.group_all(self, text str, group int) List[str]
    m_group_all(ready(self), text, group)

pub fn Regex.replace(self, text str, rep str) str
    m_replace(ready(self), text, rep)

pub fn Regex.replace_first(self, text str, rep str) str
    m_replace_first(ready(self), text, rep)

pub fn Regex.split(self, text str) List[str]
    m_split(ready(self), text)
