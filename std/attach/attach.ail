## std.attach (spec attach.wire.2, attach.wire.3, attach.wire.4, attach.wire.5; ADR 0884): the protocol a running
## program speaks to an attached agent, as pure functions. One JSON object per
## line in, one per line out. Every query reads, except `input` and `call`, which act only when the program was started with `--attach-input` (attach.input.1, attach.tool.4).
## The listener, the token file and the app wrapper are separate (ADR 0884).

use std.screen

## An observed value: its name, its type's name, and its value as JSON text.
pub struct Observed
    pub name str
    pub ty str
    pub value str

pub fn observed(name str, ty str, value str) Observed
    Observed(name: name, ty: ty, value: value)

## The values the program has shown so far, with the revision at which each
## last changed (attach.wire.5).
pub struct Tracker
    pub rev int
    pub values List[Observed]
    pub changed List[int]

pub fn Tracker.new() Tracker
    Tracker(rev: 0, values: [], changed: [])

## Records the program's current `vals`: the revision goes up when any value
## is new or differs, and each such value remembers it (attach.wire.5).
pub fn Tracker.update(mut self, vals List[Observed])
    mut bumped := false
    for v in vals
        mut at := -1
        for k in 0..values.len()
            if values[k].name == v.name
                at = k
        if at < 0
            if not bumped
                rev += 1
                bumped = true
            values.push(v)
            changed.push(rev)
        elif values[at].value != v.value or values[at].ty != v.ty
            if not bumped
                rev += 1
                bumped = true
            values[at] = v
            changed[at] = rev

fn text(s str) str
    Json.Str(s).to_text()

fn failure(why str) str
    "\{\"v\":1,\"error\":{text(why)}}"

## attach.wire.2: whether request `req` carries `token`.
pub fn authorized(req Json, token str) bool
    given := req.str("token") else return false
    token != "" and given == token

## The `observe` reply (attach.wire.5): the values named in `names` (all when
## empty) that changed after revision `since`.
pub fn Tracker.observe(self, names List[str], since int) str
    mut parts := List[str]()
    for k in 0..values.len()
        v := values[k]
        if changed[k] <= since
            continue
        if names.len() > 0 and not names.contains(v.name)
            continue
        parts.push("{text(v.name)}:{v.value}")
    "\{\"v\":1,\"rev\":{rev},\"values\":\{{parts.join(",")}}}"

## The `screen` reply (attach.wire.4): the std.screen query the request
## names, answered as text within its `budget`.
pub fn screen_reply(req Json, sc screen.Screen) str
    budget := (req.num("budget") else 0.0).to_int()
    body := screen_text(req, sc, budget)
    "\{\"v\":1,\"text\":{text(body)}}"

fn screen_text(req Json, sc screen.Screen, budget int) str
    if px := req.num("x")
        if py := req.num("y")
            if rw := req.num("w")
                return sc.describe(px, py, rw, req.num("h") else 1.0, budget)
            return sc.what_is_at(px, py)
    sc.find(req.str("role") else "", req.str("color") else "", req.str("text") else "", budget)

## The reply to request line `line` (attach.wire.2-5). `tr` holds the observed
## values, `sc` the screen, `heap` the heap summary text ("" when there is none).
pub fn answer(line str, token str, tr Tracker, sc screen.Screen, heap str) str
    req := parse_json(line) else err
        return failure("not JSON: {err.message}")
    if not authorized(req, token)
        return failure("missing or wrong token")
    q := req.str("q") else ""
    if q == "observe"
        mut names := List[str]()
        for n in req.arr("names") else []
            if s := n.as_str()
                names.push(s)
        since := (req.num("since") else -1.0).to_int()
        return tr.observe(names, since)
    if q == "screen"
        return screen_reply(req, sc)
    if q == "heap"
        if heap == ""
            return failure("no heap summary is available")
        return "\{\"v\":1,\"heap\":{text(heap)}}"
    if q == "input" or q == "call"
        return failure("{q} is off; start the program with `ail run --attach-input` (attach.input.1, attach.tool.4)")
    if q == "tools"
        return tools_reply([])
    failure("unknown query {text(q)}; the queries are observe, screen, heap and tools, and all of them only read; input and call act, with --attach-input")

## The event kinds an `input` request may send: what a person does at the window (attach.input.3).
INPUT_KINDS := ["press", "edit", "submit", "toggle", "click", "scroll", "key"]

## Whether request line `line` is an `input` request (attach.input.1).
pub fn is_input(line str) bool
    req := parse_json(line) else return false
    (req.str("q") else "") == "input"

## Why `line`, an `input` request, is refused, as a reply line; "" when it may be applied (attach.input.1-3).
## `on` is whether the program was started with `--attach-input`.
pub fn input_refusal(line str, token str, on bool) str
    req := parse_json(line) else err
        return failure("not JSON: {err.message}")
    if not authorized(req, token)
        return failure("missing or wrong token")
    if not on
        return failure("input is off; start the program with `ail run --attach-input` (attach.input.1)")
    if req.str("value") != none
        return failure("`value` is not a member of an event; the new text of a field is `text` (attach.input.2)")
    kind := req.str("kind") else ""
    if not INPUT_KINDS.contains(kind)
        return failure("`kind` must be one of {INPUT_KINDS.join(", ")} (attach.input.3)")
    ""

## The reply when `id` names no control of the program's view (attach.input.2).
pub fn input_unknown(id str) str
    failure("no control `{id}`; `id` is a control's own id or the #N that `screen` shows for it (attach.input.2)")

## The reply to an applied `input` request (attach.input.2).
pub fn input_applied(kind str) str
    "\{\"v\":1,\"applied\":{text(kind)}}"

## An action a program offers an attached agent: a `@tool` method (attach.tool.1-3).
## `params` and `types` are its parameters' names and types; `result` is the
## result's type, "" for none.
pub struct Tool
    pub name str
    pub doc str
    pub params List[str]
    pub types List[str]
    pub result str

pub fn tool(name str, doc str, params List[str], types List[str], result str) Tool
    Tool(name: name, doc: doc, params: params, types: types, result: result)

## The `tools` reply (attach.tool.3): each action with its doc, parameters and result type.
pub fn tools_reply(ts List[Tool]) str
    mut parts := List[str]()
    for t in ts
        mut ps := List[str]()
        for k in 0..t.params.len()
            ps.push("\{\"name\":{text(t.params[k])},\"type\":{text(t.types[k])}}")
        parts.push("\{\"name\":{text(t.name)},\"doc\":{text(t.doc)},\"params\":[{ps.join(",")}],\"result\":{text(t.result)}}")
    "\{\"v\":1,\"tools\":[{parts.join(",")}]}"

## The query `q` of request line `line`; "" when it is not JSON or has none.
pub fn query(line str) str
    req := parse_json(line) else return ""
    req.str("q") else ""

## Why `line`, a `call` request, is refused, as a reply line; "" when it may be run (attach.tool.4).
## `on` is whether the program was started with `--attach-input`.
pub fn call_refusal(line str, token str, on bool) str
    req := parse_json(line) else err
        return failure("not JSON: {err.message}")
    if not authorized(req, token)
        return failure("missing or wrong token")
    if not on
        return failure("call is off; start the program with `ail run --attach-input` (attach.tool.4)")
    if (req.str("name") else "") == ""
        return failure("`call` needs `name`, a tool that `tools` lists (attach.tool.4)")
    ""

## The reply to a call that ran; `value` is the result as JSON text (attach.tool.4).
pub fn called(value str) str
    "\{\"v\":1,\"result\":{value}}"

## The reply to a call whose method failed: the error as text (attach.tool.4).
pub fn call_failed(why str) str
    failure(why)

## The reply when `name` is not a tool of the program (attach.tool.4).
pub fn no_tool(name str) str
    failure("no tool `{name}`; `tools` lists them (attach.tool.4)")

## The reply when argument `param` of tool `name` is missing or not a `ty` (attach.tool.4).
pub fn bad_arg(name str, param str, ty str) str
    failure("tool `{name}` needs `{param}` as {ty} (attach.tool.4)")

## Argument `k` of a call as a string (attach.tool.4).
pub fn arg_str(args Json, k str) str?
    args.str(k)

## Argument `k` as an int: a JSON number or a string of digits, so a shell client's text works (attach.tool.4).
pub fn arg_int(args Json, k str) int?
    if args.num(k) != none
        return args.int(k)
    (args.str(k) else return none).to_int()

## Argument `k` as a float: a JSON number or a numeric string (attach.tool.4).
pub fn arg_float(args Json, k str) float?
    if n := args.num(k)
        return n
    (args.str(k) else return none).to_float()

## Argument `k` as a bool: `true`/`false`, as JSON or as text (attach.tool.4).
pub fn arg_bool(args Json, k str) bool?
    if b := args.bool(k)
        return b
    s := args.str(k) else return none
    if s == "true"
        return true
    if s == "false"
        return false
    none

## A type that can report its observed values (attach.observe.4) and offer its
## `@tool` methods as actions (attach.tool.2). The compiler writes the `impl`
## for a type with `@observe` fields or `@tool` methods when attach is on; a
## type with none can take the defaults, which report nothing and offer nothing.
pub trait Observe
    fn observed(self) List[Observed]
        []

    ## The actions an agent may call (attach.tool.3).
    fn tools(self) List[Tool]
        []

    ## Runs action `ail_tool` with arguments `ail_args` (a JSON object) and gives the reply line (attach.tool.4).
    ## A default is lowered in the impl's file, so it names only prelude items; the parameters'
    ## names are ones no app's field is likely to have.
    fn call(mut self, ail_tool str, ail_args Json) str
        why := Json.Str("no tool `{ail_tool}`; `tools` lists them (attach.tool.4)").to_text()
        "\{\"v\":1,\"error\":{why}}"
