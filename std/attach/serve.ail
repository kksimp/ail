## std.attach.serve (spec attach.wire.1, attach.wire.3, attach.wire.6, attach.wire.7; ADR 0884, ADR 1045):
## the listener that carries the attach protocol for a `std.app` program.
## One thread listens on 127.0.0.1 and hands each request line to the app
## through its inbox; the app answers between events, so program state is never
## read from another thread. Nothing here runs unless `run` is called.

use std.app
use std.attach
use std.env
use std.fs
use std.net
use std.proc
use std.random
use std.screen
use std.screen.view

## The bridge between the listener thread and the app: `lock` serialises
## requests and `replies` carries each answer back.
pub struct Hub
    pub lock Mutex[int]
    pub replies Channel[str]
    ## True once the window has closed: the listener stops at its next connection (attach.wire.7).
    pub stop Mutex[bool]

pub fn Hub.new() Hub
    Hub(lock: Mutex(0), replies: Channel[str](1), stop: Mutex(false))

## A token an agent must present: 24 bytes from the system's random source,
## else from the generator (attach.wire.2).
pub fn make_token() str
    got := system_token()
    if got.chars().len() == 48
        return got
    fallback_token()

## 48 hex digits from the operating system, or "": `/dev/urandom` through `sh`, and on Windows
## .NET's random number generator through PowerShell.
fn system_token() str
    if (env.get("OS") else "") == "Windows_NT"
        script := "$b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object \{ $_.ToString('x2') })"
        out := proc.run("powershell", ["-NoProfile", "-Command", script], none, none) else err
            return ""
        if out.ok()
            return out.text().trim()
        return ""
    out := proc.run(
        "sh",
        ["-c", "head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \\n'"],
        none,
        none,
    ) else err
        return ""
    if out.ok()
        return out.text().trim()
    ""

fn fallback_token() str
    mut s := ""
    for k in 0..6
        h := random.int(0, 4294967295).to_hex()
        mut pad := ""
        for i in 0..8 - h.chars().len()
            pad = "{pad}0"
        s = "{s}{pad}{h}"
    s

## The app `inner` with the attach protocol answered between its events
## (attach.wire.6). Its window size is `w` by `h` for the screen model.
pub struct Watched[T app.App + attach.Observe]
    pub inner T
    pub token str
    pub tr attach.Tracker
    pub hub Hub
    pub w float
    pub h float
    ## Whether `input` requests are applied (attach.input.1).
    pub input bool

impl app.App for Watched[T app.App + attach.Observe]
    fn attach(mut self, inbox app.Inbox)
        inner.attach(inbox)

    fn update(mut self, ev app.Event)
        if ev.kind == app.EventKind.External and ev.id == "attach" and attach.is_input(ev.text)
            why := attach.input_refusal(ev.text, token, input)
            if why != ""
                hub.replies.send(why)
                return
            req := parse_json(ev.text) else
                hub.replies.send("\{\"v\":1,\"error\":\"not JSON\"}")
                return
            mut sent := app.event_from_json(req)
            if sent.id != ""
                # `id` is the control's own id or the `#N` that `screen` shows for it (attach.input.2).
                found := view.control_id(inner.shown(), sent.id.strip_prefix("#") else sent.id)
                if found == ""
                    hub.replies.send(attach.input_unknown(sent.id))
                    return
                sent.id = found
            inner.update(sent)
            hub.replies.send(attach.input_applied(app.kind_name(sent.kind)))
            return
        if ev.kind == app.EventKind.External and ev.id == "attach" and attach.query(ev.text) == "call"
            # A `call` runs a `@tool` method between events, like a person's input (attach.tool.4).
            cwhy := attach.call_refusal(ev.text, token, input)
            if cwhy != ""
                hub.replies.send(cwhy)
                return
            creq := parse_json(ev.text) else
                hub.replies.send("\{\"v\":1,\"error\":\"not JSON\"}")
                return
            hub.replies.send(inner.call(
                creq.str("name") else "",
                creq.get("args") else Json.Obj([]),
            ))
            return
        if ev.kind == app.EventKind.External and ev.id == "attach" and attach.query(ev.text) == "tools"
            treq := parse_json(ev.text) else
                hub.replies.send("\{\"v\":1,\"error\":\"not JSON\"}")
                return
            if not attach.authorized(treq, token)
                hub.replies.send("\{\"v\":1,\"error\":\"missing or wrong token\"}")
                return
            hub.replies.send(attach.tools_reply(inner.tools()))
            return
        if ev.kind == app.EventKind.External and ev.id == "attach"
            tr.update(inner.observed())
            sc := view.of_node(inner.shown(), w, h, inner.focus())
            hub.replies.send(attach.answer(ev.text, token, tr, sc, ""))
            return
        if ev.kind == app.EventKind.Resize
            w = ev.dx
            h = ev.dy
        inner.update(ev)

    fn view(self) app.Node
        inner.view()

    fn title(self) str
        inner.title()

    fn focus(self) str
        inner.focus()

    fn lines(mut self) List[str]
        inner.lines()

    fn measures(self) List[app.Measure]
        inner.measures()

    fn measured(mut self, runs List[app.Measure], widths List[float])
        inner.measured(runs, widths)

## Reads request lines from each connection until it closes and answers each
## through the app (attach.wire.3). One connection at a time; a silent client
## is dropped after 5 seconds. It ends, closing `l`, at the first connection
## after `hub.stop` is set (attach.wire.7).
fn listen_loop(l net.Listener, inbox app.Inbox, hub Hub)
    while true
        c := l.accept() else break
        if hub.stop.get()
            c.close()
            l.close()
            break
        c.set_timeout(5000)
        while true
            got := c.read_line() else break
            line := got else break
            if line.trim() == ""
                break
            mut reply := ""
            with hub.lock as mut n
                n += 1
                inbox.post(app.external("attach", line))
                reply = hub.replies.recv() else ""
            c.write("{reply}\n") else break
            if hub.stop.get()
                break
        c.close()

## Where the address and token are published: `ail-attach-PORT.json` in
## `TMPDIR`, else in `TEMP` (Windows: the temporary folder inside the user's
## profile), else in `/tmp` (attach.wire.1, ADR 1045).
pub fn token_path(port str) str
    dir := env.get("TMPDIR") else (env.get("TEMP") else "/tmp")
    "{dir}/ail-attach-{port}.json"

## A listener on 127.0.0.1 whose address and token are published (attach.wire.1).
pub struct Served
    pub l net.Listener
    pub addr str
    pub token str
    pub path str

## Listens on 127.0.0.1 (a free port) and publishes the address and a new
## token in `token_path` (attach.wire.1). The kind is `listen` when no socket
## could be had and `attach` when the file could not be written.
pub fn open() Served ! app.AppError
    l := net.listen("127.0.0.1:0") else err
        return app.AppError(kind: app.AppKind.Listen, message: "can't listen ({err})")
    addr := l.addr()
    port := addr.split(":").last() else addr
    path := token_path(port)
    token := make_token()
    # Create the file empty, restrict it, then put the token in it.
    fs.write_text(path, "") else err
        l.close()
        return app.AppError(kind: app.AppKind.Attach, message: "can't write {path}: {err}")
    # The owner-only mode is a Unix one; on Windows the file is the user's by its folder (ADR 1045).
    if (env.get("OS") else "") != "Windows_NT"
        chmod := proc.run("chmod", ["600", path], none, none) else err
            l.close()
            return app.AppError(kind: app.AppKind.Attach, message: "can't restrict {path}: {err}")
    fs.write_text(path, "\{\"addr\":\"{addr}\",\"token\":\"{token}\"}\n") else err
        l.close()
        return app.AppError(kind: app.AppKind.Attach, message: "can't write {path}: {err}")
    Served(l: l, addr: addr, token: token, path: path)

## The window of `w` until it closes: the failure of `app.run_with`, if any.
fn shown[T app.App + attach.Observe](
    mut w Watched[T],
    cmd str,
    args List[str],
    inbox app.Inbox,
) app.AppError?
    app.run_with(mut w, cmd, args, inbox) else err
        return err
    none

## Connects to the listener so that its `accept` returns; false when it can't.
fn wake(addr str) bool
    port := (addr.split(":").last() else "").to_int() else return false
    c := net.connect("127.0.0.1", port) else err
        return false
    c.close()
    true

## Runs `a` in the window of the host program `cmd` with the program's `inbox`
## (as `app.run_with`) and
## answers the attach requests that reach `s`; `input` says whether `input`
## requests are applied (attach.input.1). When the window closes, or can't
## open, the listener stops and the discovery file is removed (attach.wire.7).
pub fn run_on[T app.App + attach.Observe](
    s Served,
    mut a T,
    cmd str,
    args List[str],
    inbox app.Inbox,
    input bool,
) ! app.AppError
    hub := Hub.new()
    g := TaskGroup()
    g.add(spawn listen_loop(s.l, inbox, hub))
    mut w := Watched(
        inner: a,
        token: s.token,
        tr: attach.Tracker.new(),
        hub: hub,
        w: 800.0,
        h: 600.0,
        input: input,
    )
    failed := shown(mut w, cmd, args, inbox)
    a = w.inner
    # attach.wire.7: a request the window never answered gets an empty line, and a
    # connection ends the listener's `accept`, which closing its socket from here
    # does not do on every system.
    hub.stop.set(true)
    hub.replies.close()
    if not wake(s.addr)
        s.l.close()
    if e := failed
        fs.remove(s.path) else return e
        return e
    fs.remove(s.path) else return

## Runs `a` in its window as `app.run` does, with the attach listener on
## 127.0.0.1 (a free port); its address and token go to `token_path`, which is
## removed when the window closes (attach.wire.1, attach.wire.7).
pub fn run[T app.App + attach.Observe](mut a T) ! app.AppError
    run_with(mut a, app.host_path()?, [], app.new_inbox())?

## Runs `a` as `app.run_with` does, with the host program `cmd`, its arguments
## and the program's own `inbox`, and with the attach listener on as `run` has
## it; `ail run` makes each `app.run_with(` call this one (attach.run.1).
pub fn run_with[T app.App + attach.Observe](
    mut a T,
    cmd str,
    args List[str],
    inbox app.Inbox,
) ! app.AppError
    s := open() else err
        if err.kind != app.AppKind.Listen
            return err
        # Without a listener the window still runs, just not drivable.
        io.eprint("attach: {err.message}; running the window without the attach server (attach.wire.1)")
        app.run_with(mut a, cmd, args, inbox)?
        return
    run_on(s, mut a, cmd, args, inbox, (env.get("AIL_ATTACH_INPUT") else "") == "1")?
