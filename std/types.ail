## The types of the standard modules (ADR 0157, spec 17-std). The bootstrap
## reads this after the prelude and renames each type into its module, so
## `IoError` here is `fs.IoError` in a program that has `use std.fs`.

## std.fs
error struct IoError
    path str
    kind fs.IoKind

## std.err.1 (ADR 1068): why a file call failed.
enum IoKind
    NotFound
    Permission
    Exists
    IsDir
    NotDir
    NotEmpty
    InvalidUtf8
    Other

## std.fs.10 (ADR 0281)
struct Metadata
    size int
    modified_ms int
    is_dir bool

## std.fs.24 (ADR 0928)
struct Volume
    total int
    free int

## std.compress (ADR 0443)
error struct CompressError
    kind compress.CompressKind
    message str

## std.compress.2 (ADR 1068): why a call failed; the file functions add the I/O kinds of std.err.1.
enum CompressKind
    Corrupt
    Checksum
    TooBig
    UnsafePath
    Unsupported
    NotFound
    Permission
    Exists
    IsDir
    NotDir
    NotEmpty
    InvalidUtf8
    Other

## std.fs.23 (ADR 0927): one entry of `fs.scan`, and the scan.
struct Entry
    path str
    size int
    alloc int
    modified_ms int
    inode int
    device int
    links int
    is_dir bool
    is_link bool

struct Scan
    entries List[fs.Entry]
    skipped List[str]

## std.fs.27 (ADR 0992): what every `fs.scan` has listed so far.
struct ScanCount
    entries int
    bytes int

## std.proc
struct Output
    status int
    out str
    err str

## std.proc.8 (ADR 0417): the output of `run_bytes`.
struct RawOutput
    status int
    out bytes
    err bytes

error struct ProcError
    cmd str
    kind proc.ProcKind

## std.err.1 (ADR 1068): why a process couldn't run.
enum ProcKind
    NotFound
    Permission
    Exists
    IsDir
    NotDir
    NotEmpty
    InvalidUtf8
    Other
    TimedOut
    Cancelled

## std.proc.4 (ADR 0424): a child; `stdin` takes `send` and `close`, `out` and `err` give lines.
unique struct Child
    pid int
    stdin Channel[str]
    out Channel[str]
    err Channel[str]

## std.net (ADR 0283)
struct Response
    status int
    headers Map[str, str]
    body str
    all_headers Map[str, List[str]]

## std.net.16 (ADR 0416): a response with its body undecoded.
struct RawResponse
    status int
    headers Map[str, str]
    data bytes
    all_headers Map[str, List[str]]

error struct NetError
    url str
    kind net.NetKind
    message str

## std.net.4 (ADR 1068): why a network call failed.
enum NetKind
    BadUrl
    BadRequest
    Tls
    NotFound
    Refused
    TimedOut
    Closed
    Bind
    Protocol
    Other

## std.net.6: what a request can set beyond its method and URL.
struct Options
    headers Map[str, str]
    query Map[str, str]
    body str
    timeout_ms int
    max_redirects int
    data bytes
    connect_ms int
    total_ms int

## std.net.9-11: a request the server received, and the server.
struct Request
    method str
    path str
    query Map[str, str]
    headers Map[str, str]
    body str
    peer str
    data bytes
    server int

## std.net.25: a response whose body is read in pieces.
struct Body
    status int
    headers Map[str, str]
    all_headers Map[str, List[str]]
    handle int

struct Server
    handle int

struct Exchange
    request net.Request
    handle int

## std.net.12: raw TCP.
struct Listener
    handle int

struct Conn
    handle int

## std.ui (ADR 0177). A window is a handle; its cells live in the bootstrap.
struct Window
    handle int

struct Size
    cols int
    rows int

struct Modifiers
    ctrl bool
    alt bool
    shift bool

enum Event
    Key(key ui.KeyCode, ctrl bool, alt bool, shift bool)
    Resize(cols int, rows int)
    Close
    Mouse(col int, row int, button ui.MouseButton, kind ui.MouseKind)
    Scroll(lines int)

## std.ui.7 (ADR 1068): a key, as typed text or a named key.
enum KeyCode
    Text(text str)
    Enter
    Tab
    Backspace
    Delete
    Insert
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown
    F(n int)

enum MouseButton
    Left
    Middle
    Right

enum MouseKind
    Down
    Up
    Drag

## std.ui.16: how `put_styled` draws text.
struct Style
    bold bool
    italic bool
    underline bool

## std.ui.18: the caret's shape.
enum Cursor
    Bar
    Block
    Underline

error struct UiError
    kind ui.UiKind
    message str

## std.ui.1 (ADR 1068): why a window couldn't open.
enum UiKind
    NoDisplay
    Closed
    Other

## std.tensor (ADR 0328): opaque; build with `tensor.from(xs, shape)` or
## `tensor.zeros(shape)`, read with its methods. The elements live in the
## bootstrap (`tensor.rs`). The field is a placeholder the checker rejects
## (std.tensor.1), so a tensor is `Eq` but neither ordered nor a key.
struct Tensor[T]
    elements Map[int, T]

## std.regex (ADR 0438). A regex is its pattern; compiled programs are cached
## by the interpreter, so a copy costs nothing.
struct Regex
    pat str

error struct RegexError
    pattern str
    at int
    kind regex.RegexKind
    rule str
    message str

## std.regex.23 (ADR 1068): what is wrong with a pattern (std.regex.11-22).
enum RegexKind
    UnclosedGroup
    UnopenedGroup
    UnclosedClass
    BadEscape
    BadRepeat
    NothingToRepeat
    BadRange
    BadClass
    BadGroupName
    BadFlag
    Unsupported
    TooLarge

struct Match
    start int
    end int
    text str

## `groups[0]` is the whole match; a group that didn't take part is `none`.
struct Captures
    start int
    end int
    groups List[str?]
    named Map[str, str]
