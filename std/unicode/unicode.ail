## std.unicode (spec std.unicode.1-12, ADR 1256): Unicode normalization (NFC,
## NFD, NFKC, NFKD, UAX #15), case folding and caseless matching (Unicode
## chapter 3.13), mark stripping, extended grapheme clusters and word
## segmentation (UAX #29), display width (UAX #11) and line breaking (UAX #14).
## Pure text, no effects. The tables at the end of the file are written by
## tools/native/gen_unicode_text.py from the Unicode character database and
## decoded once, at compile time (ct.const.1).

# Hangul syllables are composed and decomposed by arithmetic (Unicode 3.12).
H_S := 0xAC00
H_L := 0x1100
H_V := 0x1161
H_T := 0x11A7
H_LCOUNT := 19
H_VCOUNT := 21
H_TCOUNT := 28
H_NCOUNT := 588
H_SCOUNT := 11172

# Grapheme cluster break classes, as the generator numbers them.
GC_OTHER := 0
GC_CR := 1
GC_LF := 2
GC_CONTROL := 3
GC_EXTEND := 4
GC_ZWJ := 5
GC_RI := 6
GC_PREPEND := 7
GC_SPACING := 8
GC_L := 9
GC_V := 10
GC_T := 11
GC_LV := 12
GC_LVT := 13
GC_PICT := 14

# Indic conjunct break classes (InCB, rule GB9c).
IB_LINKER := 1
IB_CONSONANT := 2
IB_EXTEND := 3

## Sorted runs of code points with one value each.
struct Runs
    lo List[int]
    hi List[int]
    vals List[int]

## Code points mapped to sequences: key `i` maps to `data[starts[i]..starts[i + 1]]`.
struct Mapping
    keys List[int]
    starts List[int]
    data List[int]

## Canonical pairs: `keys` holds `first * 0x200000 + second`, sorted.
struct Pairs
    keys List[int]
    vals List[int]

## The numbers of a generated table string (see the generator's notes).
fn decode(s str) List[int]
    mut out := List[int]()
    mut acc := 0
    for ch in s.chars()
        code := ch.code()
        # The alphabet is printable ASCII without `"`, `\`, `{` and `}`.
        mut d := code - 33
        if code > 34
            d -= 1
        if code > 92
            d -= 1
        if code > 123
            d -= 1
        if code > 125
            d -= 1
        if d < 45
            acc = acc * 45 + d
        else
            out.push(acc * 45 + d - 45)
            acc = 0
    out

## Runs from (gap, length - 1, value) triples, or (gap, length - 1) pairs
## when `step` is 2 (the value is then 1).
fn runs(xs List[int], step int) Runs
    mut los := List[int]()
    mut his := List[int]()
    mut vals := List[int]()
    mut prev := 0
    mut i := 0
    while i < xs.len()
        first := prev + xs[i]
        last := first + xs[i + 1]
        los.push(first)
        his.push(last)
        vals.push(if step == 3 then xs[i + 2] else 1)
        prev = last
        i += step
    Runs(lo: los, hi: his, vals: vals)

## A mapping from (key gap, length, values) entries.
fn mapping(xs List[int]) Mapping
    mut keys := List[int]()
    mut starts := List[int]()
    mut data := List[int]()
    mut prev := 0
    mut i := 0
    while i < xs.len()
        prev += xs[i]
        n := xs[i + 1]
        keys.push(prev)
        starts.push(data.len())
        for j in 0..n
            data.push(xs[i + 2 + j])
        i += 2 + n
    starts.push(data.len())
    Mapping(keys: keys, starts: starts, data: data)

## Pairs from (first gap, second, composite) triples.
fn pairs(xs List[int]) Pairs
    mut keys := List[int]()
    mut vals := List[int]()
    mut prev := 0
    mut i := 0
    while i < xs.len()
        prev += xs[i]
        keys.push(prev * 0x200000 + xs[i + 1])
        vals.push(xs[i + 2])
        i += 3
    Pairs(keys: keys, vals: vals)

CCC := runs(decode(T_CCC), 3)
DECOMP := mapping(decode(T_DECOMP))
KDECOMP := mapping(decode(T_KDECOMP))
COMPOSE := pairs(decode(T_COMPOSE))
FOLD := mapping(decode(T_FOLD))
GRAPHEME := runs(decode(T_GRAPHEME), 3)
INCB := runs(decode(T_INCB), 3)
MARK := runs(decode(T_MARK), 2)
EAW_RUNS := runs(decode(T_EAW), 3)
ZEROW_RUNS := runs(decode(T_ZEROW), 2)
EMOJI_RUNS := runs(decode(T_EMOJI), 2)
LB_RUNS := runs(decode(T_LB), 3)
WB_RUNS := runs(decode(T_WB), 3)

## The index of the last element of the sorted `xs` that is at most `x`, or -1.
fn floor_index(xs List[int], x int) int
    mut lo := 0
    mut hi := xs.len()
    while lo < hi
        mid := (lo + hi) / 2
        if xs[mid] <= x
            lo = mid + 1
        else
            hi = mid
    lo - 1

## The value of the run holding `code`, or 0.
fn run_value(r Runs, code int) int
    i := floor_index(r.lo, code)
    if i >= 0 and code <= r.hi[i] then r.vals[i] else 0

## The index of `code` among the keys of `m`, or -1.
fn map_index(m Mapping, code int) int
    i := floor_index(m.keys, code)
    if i >= 0 and m.keys[i] == code then i else -1

## The canonical combining class of `code` (none is below U+0300).
fn ccc(code int) int
    if code < 0x300 then 0 else run_value(CCC, code)

## Whether every character of `s` is below `limit`.
fn all_below(s str, limit int) bool
    for ch in s.chars()
        if ch.code() >= limit
            return false
    true

## The text of a list of code points.
fn to_text(codes List[int]) str
    mut cs := List[char]()
    for c in codes
        cs.push(char.from_code(c) else ' ')
    cs.join("")

## Appends `code`, moving it before the marks of a higher combining class
## (the canonical ordering algorithm, Unicode 3.11).
fn push_ordered(mut out List[int], mut classes List[int], code int)
    cc := ccc(code)
    out.push(code)
    classes.push(cc)
    mut i := out.len() - 1
    while cc != 0 and i > 0 and classes[i - 1] > cc
        out.swap(i, i - 1)
        classes.swap(i, i - 1)
        i -= 1

## The full decomposition of `s`, in canonical order (std.unicode.2).
fn decompose(s str, compat bool) List[int]
    mut out := List[int]()
    mut classes := List[int]()
    for ch in s.chars()
        code := ch.code()
        syl := code - H_S
        if code < 0xA0
            push_ordered(mut out, mut classes, code)
        elif syl >= 0 and syl < H_SCOUNT
            push_ordered(mut out, mut classes, H_L + syl / H_NCOUNT)
            push_ordered(mut out, mut classes, H_V + syl % H_NCOUNT / H_TCOUNT)
            if syl % H_TCOUNT != 0
                push_ordered(mut out, mut classes, H_T + syl % H_TCOUNT)
        else
            ki := if compat then map_index(KDECOMP, code) else -1
            di := if ki < 0 then map_index(DECOMP, code) else -1
            if ki >= 0
                for j in KDECOMP.starts[ki]..KDECOMP.starts[ki + 1]
                    push_ordered(mut out, mut classes, KDECOMP.data[j])
            elif di >= 0
                for m in DECOMP.starts[di]..DECOMP.starts[di + 1]
                    push_ordered(mut out, mut classes, DECOMP.data[m])
            else
                push_ordered(mut out, mut classes, code)
    out

## The primary composite of `a` and `b`, or -1.
fn compose_pair(a int, b int) int
    if a >= H_L and a < H_L + H_LCOUNT and b >= H_V and b < H_V + H_VCOUNT
        return H_S + ((a - H_L) * H_VCOUNT + b - H_V) * H_TCOUNT
    syl := a - H_S
    if syl >= 0 and syl < H_SCOUNT and syl % H_TCOUNT == 0 and b > H_T and b < H_T + H_TCOUNT
        return a + b - H_T
    if b < 0x300
        return -1
    key := a * 0x200000 + b
    i := floor_index(COMPOSE.keys, key)
    if i >= 0 and COMPOSE.keys[i] == key then COMPOSE.vals[i] else -1

## The canonical composition algorithm (Unicode 3.11) over a decomposition.
fn compose(codes List[int]) List[int]
    mut out := List[int]()
    mut starter := -1
    mut last_cc := 0
    for code in codes
        cc := ccc(code)
        if starter >= 0 and (out.len() - 1 == starter or (last_cc != 0 and last_cc < cc))
            joined := compose_pair(out[starter], code)
            if joined >= 0
                out[starter] = joined
                continue
        if cc == 0
            starter = out.len()
        last_cc = cc
        out.push(code)
    out

## The Unicode version of the tables, such as `"16.0.0"` (std.unicode.1).
pub fn version() str
    UNICODE_VERSION

## `s` in Normalization Form D: canonical decomposition (std.unicode.2).
pub fn nfd(s str) str
    if all_below(s, 0xC0)
        return s
    to_text(decompose(s, false))

## `s` in Normalization Form KD: compatibility decomposition (std.unicode.2).
pub fn nfkd(s str) str
    if all_below(s, 0xA0)
        return s
    to_text(decompose(s, true))

## `s` in Normalization Form C: canonical decomposition, then canonical
## composition (std.unicode.3).
pub fn nfc(s str) str
    if all_below(s, 0x300)
        return s
    to_text(compose(decompose(s, false)))

## `s` in Normalization Form KC: compatibility decomposition, then canonical
## composition (std.unicode.3).
pub fn nfkc(s str) str
    if all_below(s, 0xA0)
        return s
    to_text(compose(decompose(s, true)))

## Whether `s` is already in Normalization Form C (std.unicode.4).
pub fn is_nfc(s str) bool
    nfc(s) == s

## Whether `s` is already in Normalization Form D (std.unicode.4).
pub fn is_nfd(s str) bool
    nfd(s) == s

## Whether `s` is already in Normalization Form KC (std.unicode.4).
pub fn is_nfkc(s str) bool
    nfkc(s) == s

## Whether `s` is already in Normalization Form KD (std.unicode.4).
pub fn is_nfkd(s str) bool
    nfkd(s) == s

## `s` with full case folding (CaseFolding.txt statuses C and F): the form
## for comparing text without case, not for display (std.unicode.5).
pub fn casefold(s str) str
    mut out := List[char]()
    for ch in s.chars()
        code := ch.code()
        if code < 0x80
            out.push(if 'A' <= ch and ch <= 'Z' then ch.to_lower() else ch)
            continue
        i := map_index(FOLD, code)
        if i < 0
            out.push(ch)
            continue
        for j in FOLD.starts[i]..FOLD.starts[i + 1]
            out.push(char.from_code(FOLD.data[j]) else ch)
    out.join("")

## Whether `a` and `b` are equal ignoring case and canonical equivalence:
## the canonical caseless match of Unicode 3.13, D145 (std.unicode.6).
pub fn caseless_eq(a str, b str) bool
    if a == b
        return true
    nfd(casefold(nfd(a))) == nfd(casefold(nfd(b)))

## `s` without its nonspacing marks (general category Mn) after canonical
## decomposition, recomposed to NFC: `"Crème brûlée"` gives `"Creme brulee"`
## (std.unicode.7).
pub fn strip_marks(s str) str
    if all_below(s, 0xC0)
        return s
    kept := [c for c in decompose(s, false) if c < 0x300 or run_value(MARK, c) == 0]
    to_text(compose(kept))

## The grapheme cluster break class of `code`.
fn grapheme_class(code int) int
    if code < 0x7F
        return if code == 13 then GC_CR elif code == 10 then GC_LF elif code < 32 then GC_CONTROL else GC_OTHER
    syl := code - H_S
    if syl >= 0 and syl < H_SCOUNT
        return if syl % H_TCOUNT == 0 then GC_LV else GC_LVT
    run_value(GRAPHEME, code)

fn is_control(k int) bool
    k == GC_CONTROL or k == GC_CR or k == GC_LF

## Whether no boundary falls between classes `prev` and `k` by the pair rules
## GB3 to GB9b of UAX #29.
fn pair_joins(prev int, k int) bool
    if prev == GC_CR and k == GC_LF
        return true
    if is_control(prev) or is_control(k)
        return false
    if prev == GC_L and (k == GC_L or k == GC_V or k == GC_LV or k == GC_LVT)
        return true
    if (prev == GC_LV or prev == GC_V) and (k == GC_V or k == GC_T)
        return true
    if (prev == GC_LVT or prev == GC_T) and k == GC_T
        return true
    k == GC_EXTEND or k == GC_ZWJ or k == GC_SPACING or prev == GC_PREPEND

## The index of the first character of each extended grapheme cluster of `cs`
## (UAX #29 rules GB3 to GB999).
fn grapheme_starts(cs List[char]) List[int]
    mut starts := List[int]()
    mut prev := -1
    mut ri := 0         # regional indicators in a row before this character
    mut pict := 0       # 1: Extended_Pictographic Extend*, 2: then ZWJ (GB11)
    mut conj := 0       # 1: InCB Consonant [Extend Linker]*, 2: a Linker among them (GB9c)
    for i, ch in cs.enumerate()
        code := ch.code()
        k := grapheme_class(code)
        ib := if code < 0x300 then 0 else run_value(INCB, code)
        joined := prev >= 0 and (pair_joins(prev, k) or
            (ib == IB_CONSONANT and conj == 2) or
            (prev == GC_ZWJ and k == GC_PICT and pict == 2) or
            (prev == GC_RI and k == GC_RI and ri % 2 == 1))
        if not joined
            starts.push(i)
        ri = if k == GC_RI then ri + 1 else 0
        pict = if k == GC_PICT then 1 elif k == GC_EXTEND and pict == 1 then 1 elif k == GC_ZWJ and pict == 1 then 2 else 0
        conj = if ib == IB_CONSONANT then 1 elif ib == IB_LINKER and conj > 0 then 2 elif ib == IB_EXTEND and conj > 0 then conj else 0
        prev = k
    starts

## The extended grapheme clusters of `s`, the characters a reader sees as
## one: `"e\u{301}"` and a flag are one each (std.unicode.8).
pub fn graphemes(s str) List[str]
    cs := s.chars()
    starts := grapheme_starts(cs)
    mut out := List[str]()
    for i, first in starts.enumerate()
        stop := if i + 1 < starts.len() then starts[i + 1] else cs.len()
        out.push(cs[first..stop].join(""))
    out

## The number of extended grapheme clusters of `s` (std.unicode.8).
pub fn grapheme_count(s str) int
    grapheme_starts(s.chars()).len()

## The East Asian Width class of `code` (EAW_N to EAW_F; N is the default).
fn eaw_class(code int) int
    run_value(EAW_RUNS, code)

## The columns one code point takes (UAX #11 and the general category): none
## for a control, a nonspacing or enclosing mark or a format character, two for
## East Asian Wide and Fullwidth, else one.
fn code_width(code int) int
    if code < 0x300
        return if code < 32 or (code >= 0x7F and code < 0xA0) then 0 else 1
    if run_value(ZEROW_RUNS, code) != 0
        return 0
    e := eaw_class(code)
    if e == EAW_W or e == EAW_F then 2 else 1

## The columns of one character (std.unicode.9).
pub fn char_width(c char) int
    code_width(c.code())

## The East Asian Width property of one character, as the Unicode data names
## it: `"N"`, `"A"`, `"H"`, `"Na"`, `"W"` or `"F"` (std.unicode.9).
pub fn east_asian_width(c char) str
    names := ["N", "A", "H", "Na", "W", "F"]
    names[eaw_class(c.code())]

## The columns of the grapheme cluster `cs[first..stop]`: that of its widest
## character, but two for a pair of regional indicators (a flag) and for a
## character with an emoji presentation selector (U+FE0F).
fn cluster_width(cs List[char], first int, stop int) int
    mut w := 0
    mut flags := 0
    mut selector := false
    for j in first..stop
        code := cs[j].code()
        w = w.max(code_width(code))
        if code == 0xFE0F
            selector = true
        if grapheme_class(code) == GC_RI
            flags += 1
    if flags >= 2
        return 2
    if selector and w == 1 and run_value(EMOJI_RUNS, cs[first].code()) != 0
        return 2
    w

## The columns `s` takes on a terminal, by grapheme cluster (std.unicode.10).
pub fn width(s str) int
    cs := s.chars()
    mut total := 0
    if all_below(s, 0x300)
        for ch in cs
            total += code_width(ch.code())
        return total
    starts := grapheme_starts(cs)
    for i, first in starts.enumerate()
        stop := if i + 1 < starts.len() then starts[i + 1] else cs.len()
        total += cluster_width(cs, first, stop)
    total

## One line of text prepared for line breaking: the code points, their raw
## classes, whether each is East Asian (F, W or H), and the units that rule LB9
## makes of them: the index of each unit's first character, its class, and
## whether it is a quotation mark of category Pi that rule LB15a allows.
struct LineText
    cps List[int]
    k List[int]
    ea List[bool]
    starts List[int]
    cls List[int]
    qflag List[bool]

fn lb_newline(c int) bool
    c == LB_BK or c == LB_CR or c == LB_LF or c == LB_NL

fn lb_quote(c int) bool
    c == LB_QU or c == LB_QP or c == LB_QF

## The classes after which a quotation mark of category Pi opens (rule LB15a).
fn lb_opens(c int) bool
    lb_newline(c) or c == LB_OP or lb_quote(c) or c == LB_GL or c == LB_SP or c == LB_ZW

## The classes that may follow a quotation mark of category Pf (rule LB15b).
fn lb_closes(c int) bool
    (c < 0 or lb_newline(c) or lb_quote(c) or c == LB_SP or c == LB_GL or c == LB_WJ or c == LB_CL or
        c == LB_CP or c == LB_EX or c == LB_IS or c == LB_SY or c == LB_ZW)

fn lb_hangul(c int) bool
    c == LB_JL or c == LB_JV or c == LB_JT or c == LB_H2 or c == LB_H3

fn lb_letter(c int) bool
    c == LB_AL or c == LB_HL

## Whether a mark joins the unit before it (rule LB9): not after a break, SP or ZW.
fn lb_joinable(c int) bool
    not lb_newline(c) and c != LB_SP and c != LB_ZW

## Whether the unit `u` begins with U+25CC or is of class AK or AS (rule LB28a).
fn lb_aksara(t LineText, u int) bool
    u >= 0 and (t.cls[u] == LB_AK or t.cls[u] == LB_AS or t.cps[t.starts[u]] == 0x25CC)

fn lb_text(cs List[char]) LineText
    mut cps := List[int]()
    mut k := List[int]()
    mut ea := List[bool]()
    for ch in cs
        code := ch.code()
        e := eaw_class(code)
        cps.push(code)
        k.push(run_value(LB_RUNS, code))
        ea.push(e == EAW_H or e == EAW_W or e == EAW_F)
    mut starts := List[int]()
    mut cls := List[int]()
    for i in 0..cs.len()
        raw := k[i]
        if i > 0 and (raw == LB_CM or raw == LB_ZWJ) and lb_joinable(cls[cls.len() - 1])
            continue
        starts.push(i)
        cls.push(if raw == LB_CM or raw == LB_ZWJ then LB_AL elif raw == LB_XP then LB_ID else raw)
    mut qflag := List[bool]()
    for u in 0..starts.len()
        qflag.push(k[starts[u]] == LB_QP and (u == 0 or lb_opens(cls[u - 1])))
    LineText(cps: cps, k: k, ea: ea, starts: starts, cls: cls, qflag: qflag)

## Whether a line may break before unit `u` (>= 1) of `t`, by rules LB4 to LB31 of
## UAX #14. `ls` is the last unit before it that is not a space, `flags` the
## regional indicators in a row before it and `nums` 1 after NU (NU|SY|IS)*,
## 2 after that and CL or CP, else 0.
fn lb_decide(t LineText, u int, ls int, flags int, nums int) bool
    m := t.cls.len()
    a := u - 1
    i := t.starts[u]
    ai := t.starts[a]
    ca := t.cls[a]
    cb := t.cls[u]
    lsc := if ls >= 0 then t.cls[ls] else -1
    ca_x := t.k[ai]
    cb_x := t.k[i]
    nxt := if u + 1 < m then t.cls[u + 1] else -1
    nxt_ea := u + 1 < m and t.ea[t.starts[u + 1]]
    if lb_newline(ca)
        return not (ca == LB_CR and cb == LB_LF)   # LB4, LB5: never inside CR LF
    if lb_newline(cb) or cb == LB_SP or cb == LB_ZW
        return false                             # LB6, LB7
    if lsc == LB_ZW
        return true                              # LB8
    if t.k[i - 1] == LB_ZWJ
        return false                             # LB8a
    if ca == LB_WJ or cb == LB_WJ or ca == LB_GL
        return false                             # LB11, LB12
    if cb == LB_GL and ca != LB_SP and ca != LB_BA and ca != LB_HY
        return false                             # LB12a
    if cb == LB_CL or cb == LB_CP or cb == LB_EX or cb == LB_SY or lsc == LB_OP
        return false                             # LB13, LB14
    if ls >= 0 and t.qflag[ls]
        return false                             # LB15a
    if cb_x == LB_QF and lb_closes(nxt)
        return false                             # LB15b
    if ca == LB_SP and cb == LB_IS and nxt == LB_NU
        return true                              # LB15c
    if cb == LB_IS
        return false                             # LB15d
    if (lsc == LB_CL or lsc == LB_CP) and cb == LB_NS
        return false                             # LB16
    if lsc == LB_B2 and cb == LB_B2
        return false                             # LB17
    if ca == LB_SP
        return true                              # LB18
    if (lb_quote(cb) and cb_x != LB_QP) or (lb_quote(ca) and ca_x != LB_QF)
        return false                             # LB19
    if lb_quote(cb) and (not t.ea[ai] or not nxt_ea)
        return false                             # LB19a
    if lb_quote(ca) and (not t.ea[i] or a == 0 or not t.ea[t.starts[a - 1]])
        return false
    if ca == LB_CB or cb == LB_CB
        return true                              # LB20
    before := if a >= 1 then t.cls[a - 1] else -1
    if (ca == LB_HY or t.cps[ai] == 0x2010) and cb == LB_AL and (a == 0 or lb_newline(before) or before == LB_SP or
            before == LB_ZW or before == LB_CB or before == LB_GL)
        return false                             # LB20a
    if cb == LB_BA or cb == LB_HY or cb == LB_NS or ca == LB_BB
        return false                             # LB21
    if before == LB_HL and (ca == LB_HY or (ca == LB_BA and not t.ea[ai])) and cb != LB_HL
        return false                             # LB21a
    if (ca == LB_SY and cb == LB_HL) or cb == LB_IN
        return false                             # LB21b, LB22
    if (lb_letter(ca) and cb == LB_NU) or (ca == LB_NU and lb_letter(cb))
        return false                             # LB23
    id_cb := cb == LB_ID or cb == LB_EB or cb == LB_EM
    id_ca := ca == LB_ID or ca == LB_EB or ca == LB_EM
    if (ca == LB_PR and id_cb) or (id_ca and cb == LB_PO)
        return false                             # LB23a
    if ((ca == LB_PR or ca == LB_PO) and lb_letter(cb)) or (lb_letter(ca) and (cb == LB_PR or cb == LB_PO))
        return false                             # LB24
    if (ca == LB_PO or ca == LB_PR) and (cb == LB_OP or cb == LB_HY) and nxt == LB_NU
        return false                             # LB25
    if cb == LB_NU and (ca == LB_PO or ca == LB_PR or ca == LB_HY or ca == LB_IS)
        return false
    if nums == 1 and (cb == LB_NU or cb == LB_SY or cb == LB_IS or cb == LB_CL or cb == LB_CP)
        return false
    if nums >= 1 and (cb == LB_PO or cb == LB_PR)
        return false
    if ca == LB_JL and (cb == LB_JL or cb == LB_JV or cb == LB_H2 or cb == LB_H3)
        return false                             # LB26
    if (ca == LB_JV or ca == LB_H2) and (cb == LB_JV or cb == LB_JT)
        return false
    if (ca == LB_JT or ca == LB_H3) and cb == LB_JT
        return false
