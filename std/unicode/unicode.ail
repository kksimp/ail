    if lb_letter(ca) and lb_letter(cb)
        return false                             # LB28
    dot_b := t.cps[i] == 0x25CC                  # LB28a
    if ca == LB_AP and (cb == LB_AK or cb == LB_AS or dot_b)
        return false
    if lb_aksara(t, a) and (cb == LB_VF or cb == LB_VI)
        return false
    if ca == LB_VI and lb_aksara(t, a - 1) and (cb == LB_AK or dot_b)
        return false
