        return false                             # LB30a
    if (ca == LB_EB and cb == LB_EM) or (ca_x == LB_XP and cb == LB_EM)
        return false                             # LB30b
    true                                         # LB31

## For each index `i` from 0 to the length, whether a line may break before the
## character `i` (the last entry, the end of the text, is always true).
fn line_breaks(cs List[char]) List[bool]
    n := cs.len()
    t := lb_text(cs)
    mut brk := List[bool]()
    mut j := 0
    while j <= n
        brk.push(false)
        j += 1
    brk[n] = true
    mut ls := -1
    mut nums := 0
    mut flags := 0
    for u in 0..t.starts.len()
        if u > 0
            if t.cls[u - 1] != LB_SP
                ls = u - 1
            brk[t.starts[u]] = lb_decide(t, u, ls, flags, nums)
        c := t.cls[u]
        flags = if c == LB_RI then flags + 1 else 0
        nums = if c == LB_NU or ((c == LB_SY or c == LB_IS) and nums == 1) then 1 elif (c == LB_CL or c == LB_CP) and nums == 1 then 2 else 0
    brk

## The text of `cs` cut before each index whose entry of `brk` is true.
fn cut_segments(cs List[char], brk List[bool]) List[str]
    mut out := List[str]()
    mut first := 0
    stop := cs.len() + 1
    for i in 1..stop
        if brk[i]
            out.push(cs[first..i].join(""))
            first = i
    out

## `s` cut into the pieces after which a line may break, by the line breaking
## algorithm of UAX #14 (std.unicode.11). Joining them gives `s` back. A piece
## ends with the spaces after its text; one that ends with a newline
## character (`"\n"`, `"\r\n"`, a form feed) is a mandatory break, the others
## are opportunities. An empty `s` gives `[]`.
pub fn line_segments(s str) List[str]
    cs := s.chars()
    cut_segments(cs, line_breaks(cs))

fn wb_ah(c int) bool
    c == WB_ALETTER or c == WB_HEBREW_LETTER

fn wb_quote(c int) bool
    c == WB_MIDNUMLET or c == WB_SINGLE_QUOTE

fn wb_newline(c int) bool
    c == WB_CR or c == WB_LF or c == WB_NEWLINE

## For each index `i` from 0 to the length, whether a word boundary falls
## before the character `i` (rules WB3 to WB999 of UAX #29; the last entry is
## always true).
fn word_breaks(cs List[char]) List[bool]
    n := cs.len()
    mut k := List[int]()
    for ch in cs
        k.push(run_value(WB_RUNS, ch.code()))
    mut starts := List[int]()
    mut cls := List[int]()
    for i in 0..n
        raw := k[i]
        if i > 0 and (raw == WB_EXTEND or raw == WB_FORMAT or raw == WB_ZWJ) and not wb_newline(cls[cls.len() - 1])
            continue
        starts.push(i)
        cls.push(if raw == WB_EXTPICT then WB_OTHER elif raw == WB_ALETTERPICT then WB_ALETTER else raw)
    mut brk := List[bool]()
    mut j := 0
    while j <= n
        brk.push(false)
        j += 1
    brk[n] = true
    m := starts.len()
    mut flags := 0
    for u in 0..m
        if u > 0
            i := starts[u]
            ca := cls[u - 1]
            cb := cls[u]
            pp := if u >= 2 then cls[u - 2] else -1
            nx := if u + 1 < m then cls[u + 1] else -1
            prev_raw := k[i - 1]
            cur_raw := k[i]
            mut cut := true
            if ca == WB_CR and cb == WB_LF
                cut = false
            elif wb_newline(ca) or wb_newline(cb)
                cut = true
            elif prev_raw == WB_ZWJ and (cur_raw == WB_EXTPICT or cur_raw == WB_ALETTERPICT)
                cut = false
            elif prev_raw == WB_WSEGSPACE and cur_raw == WB_WSEGSPACE
                cut = false
            elif wb_ah(ca) and wb_ah(cb)
                cut = false
            elif wb_ah(ca) and (cb == WB_MIDLETTER or wb_quote(cb)) and wb_ah(nx)
                cut = false
            elif wb_ah(pp) and (ca == WB_MIDLETTER or wb_quote(ca)) and wb_ah(cb)
                cut = false
            elif ca == WB_HEBREW_LETTER and cb == WB_SINGLE_QUOTE
                cut = false
            elif ca == WB_HEBREW_LETTER and cb == WB_DOUBLE_QUOTE and nx == WB_HEBREW_LETTER
                cut = false
            elif pp == WB_HEBREW_LETTER and ca == WB_DOUBLE_QUOTE and cb == WB_HEBREW_LETTER
                cut = false
            elif ca == WB_NUMERIC and cb == WB_NUMERIC
                cut = false
            elif (wb_ah(ca) and cb == WB_NUMERIC) or (ca == WB_NUMERIC and wb_ah(cb))
                cut = false
            elif pp == WB_NUMERIC and (ca == WB_MIDNUM or wb_quote(ca)) and cb == WB_NUMERIC
                cut = false
            elif ca == WB_NUMERIC and (cb == WB_MIDNUM or wb_quote(cb)) and nx == WB_NUMERIC
                cut = false
            elif ca == WB_KATAKANA and cb == WB_KATAKANA
                cut = false
            elif (wb_ah(ca) or ca == WB_NUMERIC or ca == WB_KATAKANA or ca == WB_EXTENDNUMLET) and cb == WB_EXTENDNUMLET
                cut = false
            elif ca == WB_EXTENDNUMLET and (wb_ah(cb) or cb == WB_NUMERIC or cb == WB_KATAKANA)
                cut = false
            elif ca == WB_REGIONAL_INDICATOR and cb == WB_REGIONAL_INDICATOR and flags % 2 == 1
                cut = false
            brk[i] = cut
        flags = if cls[u] == WB_REGIONAL_INDICATOR then flags + 1 else 0
    brk

## `s` cut into all its word-boundary segments by the rules of UAX #29: words,
## runs of spaces, single punctuation marks, one ideograph each (std.unicode.12).
## Joining them gives `s` back; `"can't"`, `"3.14"`, `"foo_bar"` and
## `"e\u{301}"` are one segment each.
pub fn word_segments(s str) List[str]
    cs := s.chars()
    cut_segments(cs, word_breaks(cs))

## Whether a segment holds a letter or a digit: a word, as opposed to space and punctuation.
fn wordlike(seg str) bool
    for ch in seg.chars()
        c := run_value(WB_RUNS, ch.code())
        if c == WB_ALETTER or c == WB_HEBREW_LETTER or c == WB_NUMERIC or c == WB_KATAKANA or c == WB_ALETTERPICT or ch.is_alpha()
            return true
    false

## The words of `s`: the `word_segments` that hold a letter or a digit, in
## order (std.unicode.12). `"Hello, world! 3.14"` gives `["Hello", "world",
## "3.14"]`; Chinese and Japanese text, which has no spaces, is cut one
## ideograph at a time, since the algorithm has no dictionary.
pub fn words(s str) List[str]
    [seg for seg in word_segments(s) if wordlike(seg)]

