        l6: mask32(l6 < o.l6),
        l7: mask32(l7 < o.l7),
    )

## Lane-wise `a <= b`: all ones where it holds, else zero (std.simd.7).
pub fn I32x8.le(self, o I32x8) I32x8
    I32x8(
        l0: mask32(l0 <= o.l0),
        l1: mask32(l1 <= o.l1),
        l2: mask32(l2 <= o.l2),
        l3: mask32(l3 <= o.l3),
        l4: mask32(l4 <= o.l4),
        l5: mask32(l5 <= o.l5),
        l6: mask32(l6 <= o.l6),
        l7: mask32(l7 <= o.l7),
    )

## Lane-wise `a > b`: all ones where it holds, else zero (std.simd.7).
pub fn I32x8.gt(self, o I32x8) I32x8
    I32x8(
        l0: mask32(l0 > o.l0),
        l1: mask32(l1 > o.l1),
        l2: mask32(l2 > o.l2),
        l3: mask32(l3 > o.l3),
        l4: mask32(l4 > o.l4),
        l5: mask32(l5 > o.l5),
        l6: mask32(l6 > o.l6),
        l7: mask32(l7 > o.l7),
    )

## Lane-wise `a >= b`: all ones where it holds, else zero (std.simd.7).
pub fn I32x8.ge(self, o I32x8) I32x8
    I32x8(
        l0: mask32(l0 >= o.l0),
        l1: mask32(l1 >= o.l1),
        l2: mask32(l2 >= o.l2),
        l3: mask32(l3 >= o.l3),
        l4: mask32(l4 >= o.l4),
        l5: mask32(l5 >= o.l5),
        l6: mask32(l6 >= o.l6),
        l7: mask32(l7 >= o.l7),
    )

## The lanes of `o` where `m` is not zero, else of this vector (std.simd.7).
pub fn I32x8.blend(self, o I32x8, m I32x8) I32x8
    I32x8(
        l0: (if m.l0 != 0.to_i32() then o.l0 else l0),
        l1: (if m.l1 != 0.to_i32() then o.l1 else l1),
        l2: (if m.l2 != 0.to_i32() then o.l2 else l2),
        l3: (if m.l3 != 0.to_i32() then o.l3 else l3),
        l4: (if m.l4 != 0.to_i32() then o.l4 else l4),
        l5: (if m.l5 != 0.to_i32() then o.l5 else l5),
        l6: (if m.l6 != 0.to_i32() then o.l6 else l6),
        l7: (if m.l7 != 0.to_i32() then o.l7 else l7),
    )

## The sum of the lanes, added as a balanced tree: lanes 0 and 1, 2 and 3, and so on,
## then those sums in pairs (std.simd.8).
pub fn I32x8.sum(self) i32
    s0 := l0.wrapping_add(l1)
    s1 := l2.wrapping_add(l3)
    s2 := l4.wrapping_add(l5)
    s3 := l6.wrapping_add(l7)
    s4 := s0.wrapping_add(s1)
    s5 := s2.wrapping_add(s3)
    s6 := s4.wrapping_add(s5)
    s6

## 4 lanes of `int` (256 bits).
pub struct I64x4
    l0 int
    l1 int
    l2 int
    l3 int

## Every lane `x` (std.simd.1).
pub fn I64x4.splat(x int) I64x4
    I64x4(l0: x, l1: x, l2: x, l3: x)

## Every lane zero (std.simd.1).
pub fn I64x4.zero() I64x4
    I64x4(l0: 0, l1: 0, l2: 0, l3: 0)

## The lanes `xs[at]` to `xs[at + 3]` (std.simd.1).
pub fn I64x4.load(xs List[int], at int) I64x4
    I64x4(l0: xs[at], l1: xs[at + 1], l2: xs[at + 2], l3: xs[at + 3])

## The lanes as a list (std.simd.1).
pub fn I64x4.to_list(self) List[int]
    [l0, l1, l2, l3]

## Write the lanes to `xs[at]` to `xs[at + 3]` (std.simd.1).
pub fn I64x4.store(self, mut xs List[int], at int)
    xs[at] = l0
    xs[at + 1] = l1
    xs[at + 2] = l2
    xs[at + 3] = l3

## Lane `i` (std.simd.2).
pub fn I64x4.lane(self, i int) int
    check_lane(i, 4)
    to_list()[i]

## A copy with lane `i` set to `x` (std.simd.2).
pub fn I64x4.with_lane(self, i int, x int) I64x4
    check_lane(i, 4)
    mut xs := to_list()
    xs[i] = x
    I64x4.load(xs, 0)

## Lane-wise sum, wrapping (std.simd.4).
pub fn I64x4.add(self, o I64x4) I64x4
    I64x4(
        l0: l0.wrapping_add(o.l0),
        l1: l1.wrapping_add(o.l1),
        l2: l2.wrapping_add(o.l2),
        l3: l3.wrapping_add(o.l3),
