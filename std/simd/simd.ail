pub fn F32x8.mul(self, o F32x8) F32x8
    F32x8(
        l0: l0 * o.l0,
        l1: l1 * o.l1,
        l2: l2 * o.l2,
        l3: l3 * o.l3,
        l4: l4 * o.l4,
        l5: l5 * o.l5,
        l6: l6 * o.l6,
        l7: l7 * o.l7,
