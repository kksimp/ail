## Every lane shifted left by `k` bits, the bits that leave dropped (std.simd.6).
pub fn I64x4.shl(self, k int) I64x4
    check_shift(k, 64)
    I64x4(l0: l0.shl(k), l1: l1.shl(k), l2: l2.shl(k), l3: l3.shl(k))

