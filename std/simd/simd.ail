## The lanes of `o` where `m` is not zero, else of this vector (std.simd.7).
pub fn I64x4.blend(self, o I64x4, m I64x4) I64x4
    I64x4(
        l0: (if m.l0 != 0 then o.l0 else l0),
        l1: (if m.l1 != 0 then o.l1 else l1),
        l2: (if m.l2 != 0 then o.l2 else l2),
        l3: (if m.l3 != 0 then o.l3 else l3),
