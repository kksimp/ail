pub fn I32x8.shr(self, k int) I32x8
    check_shift(k, 32)
    I32x8(
        l0: l0.to_int().shr(k).to_i32(),
        l1: l1.to_int().shr(k).to_i32(),
        l2: l2.to_int().shr(k).to_i32(),
        l3: l3.to_int().shr(k).to_i32(),
        l4: l4.to_int().shr(k).to_i32(),
        l5: l5.to_int().shr(k).to_i32(),
        l6: l6.to_int().shr(k).to_i32(),
        l7: l7.to_int().shr(k).to_i32(),
    )

## Lane-wise `a == b`: all ones where it holds, else zero (std.simd.7).
pub fn I32x8.eq(self, o I32x8) I32x8
    I32x8(
        l0: mask32(l0 == o.l0),
        l1: mask32(l1 == o.l1),
        l2: mask32(l2 == o.l2),
        l3: mask32(l3 == o.l3),
        l4: mask32(l4 == o.l4),
        l5: mask32(l5 == o.l5),
        l6: mask32(l6 == o.l6),
        l7: mask32(l7 == o.l7),
    )

