## Every lane shifted left by `k` bits, the bits that leave dropped (std.simd.6).
pub fn I32x8.shl(self, k int) I32x8
    check_shift(k, 32)
    I32x8(
        l0: wrap32(l0.to_int().shl(k)),
        l1: wrap32(l1.to_int().shl(k)),
        l2: wrap32(l2.to_int().shl(k)),
        l3: wrap32(l3.to_int().shl(k)),
        l4: wrap32(l4.to_int().shl(k)),
        l5: wrap32(l5.to_int().shl(k)),
