    F64x4(
        l0: (if m.l0 != 0 then o.l0 else l0),
        l1: (if m.l1 != 0 then o.l1 else l1),
        l2: (if m.l2 != 0 then o.l2 else l2),
        l3: (if m.l3 != 0 then o.l3 else l3),
    )

## The sum of the lanes, added as a balanced tree: lanes 0 and 1, 2 and 3, and so on,
## then those sums in pairs (std.simd.8).
pub fn F64x4.sum(self) float
    s0 := l0 + l1
    s1 := l2 + l3
    s2 := s0 + s1
    s2

## 8 lanes of `i32` (256 bits).
pub struct I32x8
    l0 i32
    l1 i32
    l2 i32
    l3 i32
    l4 i32
    l5 i32
    l6 i32
    l7 i32

## Every lane `x` (std.simd.1).
pub fn I32x8.splat(x i32) I32x8
    I32x8(l0: x, l1: x, l2: x, l3: x, l4: x, l5: x, l6: x, l7: x)

## Every lane zero (std.simd.1).
pub fn I32x8.zero() I32x8
    I32x8(
        l0: 0.to_i32(),
        l1: 0.to_i32(),
        l2: 0.to_i32(),
        l3: 0.to_i32(),
        l4: 0.to_i32(),
        l5: 0.to_i32(),
        l6: 0.to_i32(),
        l7: 0.to_i32(),
    )

## The lanes `xs[at]` to `xs[at + 7]` (std.simd.1).
pub fn I32x8.load(xs List[i32], at int) I32x8
    I32x8(
        l0: xs[at],
        l1: xs[at + 1],
        l2: xs[at + 2],
        l3: xs[at + 3],
        l4: xs[at + 4],
        l5: xs[at + 5],
        l6: xs[at + 6],
        l7: xs[at + 7],
    )

## The lanes as a list (std.simd.1).
pub fn I32x8.to_list(self) List[i32]
    [l0, l1, l2, l3, l4, l5, l6, l7]

## Write the lanes to `xs[at]` to `xs[at + 7]` (std.simd.1).
pub fn I32x8.store(self, mut xs List[i32], at int)
    xs[at] = l0
    xs[at + 1] = l1
    xs[at + 2] = l2
    xs[at + 3] = l3
    xs[at + 4] = l4
    xs[at + 5] = l5
    xs[at + 6] = l6
    xs[at + 7] = l7

## Lane `i` (std.simd.2).
pub fn I32x8.lane(self, i int) i32
    check_lane(i, 8)
    to_list()[i]

## A copy with lane `i` set to `x` (std.simd.2).
pub fn I32x8.with_lane(self, i int, x i32) I32x8
    check_lane(i, 8)
    mut xs := to_list()
    xs[i] = x
    I32x8.load(xs, 0)

