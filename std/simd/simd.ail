pub fn I32x4.blend(self, o I32x4, m I32x4) I32x4
    I32x4(
        l0: (if m.l0 != 0.to_i32() then o.l0 else l0),
        l1: (if m.l1 != 0.to_i32() then o.l1 else l1),
        l2: (if m.l2 != 0.to_i32() then o.l2 else l2),
        l3: (if m.l3 != 0.to_i32() then o.l3 else l3),
    )

## The sum of the lanes, added as a balanced tree: lanes 0 and 1, 2 and 3, and so on,
## then those sums in pairs (std.simd.8).
pub fn I32x4.sum(self) i32
    s0 := l0.wrapping_add(l1)
    s1 := l2.wrapping_add(l3)
    s2 := s0.wrapping_add(s1)
    s2

## 2 lanes of `int` (128 bits).
pub struct I64x2
    l0 int
    l1 int

## Every lane `x` (std.simd.1).
pub fn I64x2.splat(x int) I64x2
    I64x2(l0: x, l1: x)

## Every lane zero (std.simd.1).
pub fn I64x2.zero() I64x2
    I64x2(l0: 0, l1: 0)

## The lanes `xs[at]` to `xs[at + 1]` (std.simd.1).
pub fn I64x2.load(xs List[int], at int) I64x2
    I64x2(l0: xs[at], l1: xs[at + 1])

## The lanes as a list (std.simd.1).
pub fn I64x2.to_list(self) List[int]
    [l0, l1]

## Write the lanes to `xs[at]` to `xs[at + 1]` (std.simd.1).
pub fn I64x2.store(self, mut xs List[int], at int)
    xs[at] = l0
    xs[at + 1] = l1

## Lane `i` (std.simd.2).
pub fn I64x2.lane(self, i int) int
    check_lane(i, 2)
    to_list()[i]

## A copy with lane `i` set to `x` (std.simd.2).
pub fn I64x2.with_lane(self, i int, x int) I64x2
    check_lane(i, 2)
    mut xs := to_list()
    xs[i] = x
    I64x2.load(xs, 0)

## Lane-wise sum, wrapping (std.simd.4).
pub fn I64x2.add(self, o I64x2) I64x2
    I64x2(l0: l0.wrapping_add(o.l0), l1: l1.wrapping_add(o.l1))

## Lane-wise difference, wrapping (std.simd.4).
pub fn I64x2.sub(self, o I64x2) I64x2
    I64x2(l0: l0.wrapping_sub(o.l0), l1: l1.wrapping_sub(o.l1))

## Lane-wise negation, wrapping (std.simd.4).
pub fn I64x2.neg(self) I64x2
    I64x2(l0: l0.wrapping_neg(), l1: l1.wrapping_neg())

## Lane-wise bitwise and (std.simd.6).
pub fn I64x2.bit_and(self, o I64x2) I64x2
    I64x2(l0: l0.bit_and(o.l0), l1: l1.bit_and(o.l1))

## Lane-wise bitwise or (std.simd.6).
pub fn I64x2.bit_or(self, o I64x2) I64x2
    I64x2(l0: l0.bit_or(o.l0), l1: l1.bit_or(o.l1))

## Lane-wise bitwise exclusive or (std.simd.6).
pub fn I64x2.bit_xor(self, o I64x2) I64x2
    I64x2(l0: l0.bit_xor(o.l0), l1: l1.bit_xor(o.l1))

## Lane-wise bitwise not (std.simd.6).
pub fn I64x2.bit_not(self) I64x2
    I64x2(l0: l0.bit_not(), l1: l1.bit_not())

## Every lane shifted left by `k` bits, the bits that leave dropped (std.simd.6).
pub fn I64x2.shl(self, k int) I64x2
    check_shift(k, 64)
    I64x2(l0: l0.shl(k), l1: l1.shl(k))

## Every lane shifted right by `k` bits, copying the sign bit (std.simd.6).
pub fn I64x2.shr(self, k int) I64x2
    check_shift(k, 64)
    I64x2(l0: l0.shr(k), l1: l1.shr(k))

## Lane-wise `a == b`: all ones where it holds, else zero (std.simd.7).
pub fn I64x2.eq(self, o I64x2) I64x2
    I64x2(l0: mask64(l0 == o.l0), l1: mask64(l1 == o.l1))

## Lane-wise `a != b`: all ones where it holds, else zero (std.simd.7).
pub fn I64x2.ne(self, o I64x2) I64x2
    I64x2(l0: mask64(l0 != o.l0), l1: mask64(l1 != o.l1))

## Lane-wise `a < b`: all ones where it holds, else zero (std.simd.7).
pub fn I64x2.lt(self, o I64x2) I64x2
    I64x2(l0: mask64(l0 < o.l0), l1: mask64(l1 < o.l1))

## Lane-wise `a <= b`: all ones where it holds, else zero (std.simd.7).
pub fn I64x2.le(self, o I64x2) I64x2
    I64x2(l0: mask64(l0 <= o.l0), l1: mask64(l1 <= o.l1))

## Lane-wise `a > b`: all ones where it holds, else zero (std.simd.7).
pub fn I64x2.gt(self, o I64x2) I64x2
    I64x2(l0: mask64(l0 > o.l0), l1: mask64(l1 > o.l1))

## Lane-wise `a >= b`: all ones where it holds, else zero (std.simd.7).
pub fn I64x2.ge(self, o I64x2) I64x2
    I64x2(l0: mask64(l0 >= o.l0), l1: mask64(l1 >= o.l1))

## The lanes of `o` where `m` is not zero, else of this vector (std.simd.7).
pub fn I64x2.blend(self, o I64x2, m I64x2) I64x2
    I64x2(l0: (if m.l0 != 0 then o.l0 else l0), l1: (if m.l1 != 0 then o.l1 else l1))

## The sum of the lanes, added as a balanced tree: lanes 0 and 1, 2 and 3, and so on,
## then those sums in pairs (std.simd.8).
pub fn I64x2.sum(self) int
    s0 := l0.wrapping_add(l1)
    s0

## 8 lanes of `f32` (256 bits).
pub struct F32x8
    l0 f32
    l1 f32
    l2 f32
    l3 f32
    l4 f32
    l5 f32
    l6 f32
    l7 f32

## Every lane `x` (std.simd.1).
pub fn F32x8.splat(x f32) F32x8
    F32x8(l0: x, l1: x, l2: x, l3: x, l4: x, l5: x, l6: x, l7: x)

## Every lane zero (std.simd.1).
pub fn F32x8.zero() F32x8
    F32x8(l0: 0.0, l1: 0.0, l2: 0.0, l3: 0.0, l4: 0.0, l5: 0.0, l6: 0.0, l7: 0.0)

## The lanes `xs[at]` to `xs[at + 7]` (std.simd.1).
pub fn F32x8.load(xs List[f32], at int) F32x8
    F32x8(
        l0: xs[at],
        l1: xs[at + 1],
        l2: xs[at + 2],
        l3: xs[at + 3],
        l4: xs[at + 4],
        l5: xs[at + 5],
        l6: xs[at + 6],
        l7: xs[at + 7],
    )

## The lanes as a list (std.simd.1).
pub fn F32x8.to_list(self) List[f32]
    [l0, l1, l2, l3, l4, l5, l6, l7]

## Write the lanes to `xs[at]` to `xs[at + 7]` (std.simd.1).
pub fn F32x8.store(self, mut xs List[f32], at int)
    xs[at] = l0
    xs[at + 1] = l1
    xs[at + 2] = l2
    xs[at + 3] = l3
    xs[at + 4] = l4
    xs[at + 5] = l5
    xs[at + 6] = l6
    xs[at + 7] = l7

## Lane `i` (std.simd.2).
pub fn F32x8.lane(self, i int) f32
    check_lane(i, 8)
    to_list()[i]

## A copy with lane `i` set to `x` (std.simd.2).
pub fn F32x8.with_lane(self, i int, x f32) F32x8
    check_lane(i, 8)
    mut xs := to_list()
    xs[i] = x
    F32x8.load(xs, 0)

## Lane-wise `a + b` (std.simd.4).
pub fn F32x8.add(self, o F32x8) F32x8
    F32x8(
        l0: l0 + o.l0,
        l1: l1 + o.l1,
        l2: l2 + o.l2,
        l3: l3 + o.l3,
        l4: l4 + o.l4,
        l5: l5 + o.l5,
        l6: l6 + o.l6,
        l7: l7 + o.l7,
    )

## Lane-wise `a - b` (std.simd.4).
pub fn F32x8.sub(self, o F32x8) F32x8
    F32x8(
        l0: l0 - o.l0,
        l1: l1 - o.l1,
        l2: l2 - o.l2,
        l3: l3 - o.l3,
        l4: l4 - o.l4,
        l5: l5 - o.l5,
        l6: l6 - o.l6,
        l7: l7 - o.l7,
    )

