pub fn I64x4.ge(self, o I64x4) I64x4
    I64x4(
        l0: mask64(l0 >= o.l0),
        l1: mask64(l1 >= o.l1),
        l2: mask64(l2 >= o.l2),
        l3: mask64(l3 >= o.l3),
