## std.file (spec std.file.1-9, ADR 1071): streaming file handles. A `Reader`
## reads a file a piece at a time (bytes, an exact count, lines) and a `Writer`
## buffers what is written and puts it in the file in large steps. Both are
## written over `std.fs` (`read_range`, `write_at`, `append_bytes`), so they
## behave the same on macOS, Linux and Windows and hold no operating-system
## resource: a handle that is never closed cannot leak a descriptor, and a file
## can be renamed or removed while a handle names it. A handle remembers its
## path, so a failure's `fs.IoError` is the one `std.fs` gives (`std.err.1`).
##
## Both types are `unique` (`own.uniq.1`): a handle is never copied, so two
## variables cannot hold two positions in one stream. A `Writer`'s `drop` flushes
## what it still buffers, on every path out of its scope (`own.uniq.3`), but a
## `drop` cannot report a failure: call `close` or `flush` to see it.
use std.fs

## Bytes a `Reader` fetches at once, and a `Writer` buffers before it writes.
CHUNK := 65536

## `parts` joined, pairwise so each byte is copied about log2(count) times.
fn join(parts List[bytes]) bytes
    mut xs := parts
    while xs.len() > 1
        mut next := List[bytes]()
        mut i := 0
        while i + 1 < xs.len()
            next.push(xs[i] + xs[i + 1])
            i += 2
        if i < xs.len()
            next.push(xs[i])
        xs = next
    if xs.len() == 0
        return b""
    xs[0]

## A line's text: its bytes without a closing `\r`, invalid UTF-8 as U+FFFD.
fn line_text(b bytes) str
    if b.len() > 0 and b[b.len() - 1] == 13
        return b[0..b.len() - 1].text()
    b.text()

## A file open for reading (std.file.1).
pub unique struct Reader
    path str
    base int
    buf bytes
    at int

## A file open for writing (std.file.6).
pub unique struct Writer
    path str
    appending bool
    pos int
    parts List[bytes]
    held int

## Opens `path` for reading at its start (std.file.1). Fails like
## `fs.read_range`: `not_found`, `permission` or `is_dir`.
pub fn open(path str) Reader ! fs.IoError
    first := fs.read_range(path, 0, CHUNK)?
    Reader(path: path, base: 0, buf: first, at: 0)

## Fetches the next chunk after the one held.
fn Reader.fill(mut self) ! fs.IoError
    next := base + buf.len()
    buf = fs.read_range(path, next, CHUNK)?
    base = next
    at = 0

## Up to `n` bytes from the position; fewer only when the file ends, and an
## empty `bytes` at its end (std.file.2). A negative `n` traps.
pub fn Reader.read(mut self, n int) bytes ! fs.IoError
    requires n >= 0
    mut parts := List[bytes]()
    mut need := n
    while need > 0
        if at >= buf.len()
            fill()?
            if buf.len() == 0
                break
        avail := buf.len() - at
        take := if avail < need then avail else need
        parts.push(buf[at..at + take])
        at += take
        need -= take
    join(parts)

## Exactly `n` bytes, or `none` when fewer remain; then the position is
## unchanged, so a reader that follows a growing file can try again (std.file.3).
pub fn Reader.read_exact(mut self, n int) bytes? ! fs.IoError
    requires n >= 0
    start := tell()
    got := read(n)?
    if got.len() < n
        seek(start)
        return none
    got

## The next line without its `\n` or `\r\n`, or `none` at the end of the file.
## A last line with no ending is returned too (std.file.4).
pub fn Reader.read_line(mut self) str? ! fs.IoError
    line(false)?

## As `read_line`, but only a line whose `\n` is already in the file; otherwise
## `none` and the position is unchanged. A program that follows a log being
## written uses this, so it never sees half a line (std.file.4).
pub fn Reader.read_complete_line(mut self) str? ! fs.IoError
    line(true)?

fn Reader.line(mut self, complete bool) str? ! fs.IoError
    start := tell()
    mut parts := List[bytes]()
    while true
        if at >= buf.len()
            fill()?
            if buf.len() == 0
                break
        size := buf.len()
        mut i := at
        while i < size and buf[i] != 10
            i += 1
        if i < size
            parts.push(buf[at..i])
            at = i + 1
            return line_text(join(parts))
        parts.push(buf[at..size])
        at = size
    if complete
        seek(start)
        return none
    if parts.len() == 0
        return none
    line_text(join(parts))

## The byte offset of the next byte to read (std.file.5).
pub fn Reader.tell(self) int
    base + at

## Moves the position to byte `pos`; a position past the end reads nothing
## until the file grows. A negative `pos` traps (std.file.5).
pub fn Reader.seek(mut self, pos int)
    requires pos >= 0
    if pos >= base and pos <= base + buf.len()
        at = pos - base
    else
        base = pos
        buf = b""
        at = 0

## The file's size now, in bytes (std.file.5).
pub fn Reader.size(self) int ! fs.IoError
    m := fs.metadata(path)?
    m.size

## Ends the reader (std.file.1). Dropping it does the same.
pub fn Reader.close(move self)
    return

## Creates the file, or empties it, and opens it for writing at byte 0
## (std.file.6).
pub fn create(path str) Writer ! fs.IoError
    fs.write_bytes(path, b"")?
    Writer(path: path, appending: false, pos: 0, parts: List[bytes](), held: 0)

## Opens the file for adding at its end, creating it when missing (std.file.6).
## Each flush is one append, so several writers may add to one file.
pub fn append(path str) Writer ! fs.IoError
    fs.append_bytes(path, b"")?
    m := fs.metadata(path)?
    Writer(path: path, appending: true, pos: m.size, parts: List[bytes](), held: 0)

## Opens the file for writing at byte 0 without emptying it, creating it when
## missing: `seek` then patches it in place (std.file.6).
pub fn update(path str) Writer ! fs.IoError
    fs.append_bytes(path, b"")?
    Writer(path: path, appending: false, pos: 0, parts: List[bytes](), held: 0)

## Adds `data` to the buffer; at 64 KiB held, the buffer is written (std.file.7).
pub fn Writer.write_bytes(mut self, data bytes) ! fs.IoError
    parts.push(data)
    held += data.len()
    if held >= CHUNK
        flush()?

## `write_bytes` of the text's UTF-8 bytes (std.file.7).
pub fn Writer.write(mut self, text str) ! fs.IoError
    write_bytes(text.to_bytes())?

## `write` of the text and a `\n` (std.file.7).
pub fn Writer.write_line(mut self, text str) ! fs.IoError
    write_bytes("{text}\n".to_bytes())?

## Writes everything buffered to the file (std.file.7). On a failure the bytes
## stay buffered, so a later `flush` tries again.
pub fn Writer.flush(mut self) ! fs.IoError
    if held == 0
        return
    data := join(parts)
    if appending
        fs.append_bytes(path, data)?
    else
        fs.write_at(path, pos, data)?
    pos += data.len()
    parts = List[bytes]()
    held = 0

## The offset the next written byte will have, counting what is buffered
## (std.file.8).
pub fn Writer.tell(self) int
    pos + held

## Flushes, then moves the write position to byte `pos`; a position past the
## end leaves zero bytes between. A negative position, or any `seek` on a writer
## made by `append`, traps (std.file.8).
pub fn Writer.seek(mut self, to int) ! fs.IoError
    requires to >= 0 and not appending
    flush()?
    pos = to

## Flushes the writer, reporting a failure (std.file.9); a second call does nothing.
pub fn Writer.close(mut self) ! fs.IoError
    flush()?

impl Drop for Writer
    fn drop(mut self)
        flush() else err
            return
