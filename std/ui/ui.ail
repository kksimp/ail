## std.ui for the native backend (spec std.ui.1-18, ADR 0863): the window is
## a grid of cells kept here and drawn by the `std.app` host (std.app.7-9).
## `present` sends the grid as one canvas of `Fill` and `Str` ops; the host's
## `key`, `click`, `scroll`, `resize` and `close` events become `Event`s.
## With no host (`AIL_APP_HOST` unset and no build under `AIL_ROOT`), `open`
## fails with `no_display` (std.ui.1). Programs that build `ui.Event` values
## by hand and draw nothing, like widget tests, behave as under `ail run`.

use std.app

## An open window: its grid, and the channels to the host. Copies share the
## host.
pub struct Window
    pub handle int
    live bool
    cols int
    rows int
    chars List[str]
    fgs List[int]
    bgs List[int]
    sts List[int]
    cur_col int
    cur_row int
    shape Cursor
    title str
    px int
    cell_w float
    mods Modifiers
    queue List[Event]
    to_host Channel[str]
    from_host Channel[str]

pub struct Size
    pub cols int
    pub rows int

pub struct Modifiers
    pub ctrl bool
    pub alt bool
    pub shift bool

## How a cell is drawn (std.ui.16).
pub struct Style
    pub bold bool
    pub italic bool
    pub underline bool

pub enum Event
    Key(key KeyCode, ctrl bool, alt bool, shift bool)
    Resize(cols int, rows int)
    Close
    Mouse(col int, row int, button MouseButton, kind MouseKind)
    Scroll(lines int)

## A key (std.ui.7, ADR 1068): the typed text, or a named key.
pub enum KeyCode
    Text(text str)
    Enter
    Tab
    Backspace
    Delete
    Insert
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    PageUp
    PageDown
    F(n int)

pub enum MouseButton
    Left
    Middle
    Right

pub enum MouseKind
    Down
    Up
    Drag

## The key the host names `name` (std.ui.7): a named key, or the typed text.
pub fn key_code(name str) KeyCode
    match name
        "enter" => Enter
        "tab" => Tab
        "backspace" => Backspace
        "delete" => Delete
        "insert" => Insert
        "escape" => Escape
        "up" => Up
        "down" => Down
        "left" => Left
        "right" => Right
        "home" => Home
        "end" => End
        "pageup" => PageUp
        "pagedown" => PageDown
        _ =>
            if name.len() >= 2 and name.len() <= 3 and name.starts_with("f")
                if n := name.slice(1, name.len()).to_int()
                    if n >= 1 and n <= 12
                        return F(n)
            Text(name)

## The std.ui.7 name of `key`: its text, or `enter`, `pageup`, `f5` and so on.
pub fn KeyCode.name(self) str
    match self
        Text(t) => t
        Enter => "enter"
        Tab => "tab"
        Backspace => "backspace"
        Delete => "delete"
        Insert => "insert"
        Escape => "escape"
        Up => "up"
        Down => "down"
        Left => "left"
        Right => "right"
        Home => "home"
        End => "end"
        PageUp => "pageup"
        PageDown => "pagedown"
        F(n) => "f{n}"

## The typed text of `key`, or `none` for a named key.
pub fn KeyCode.text(self) str?
    match self
        Text(t) => t
        Enter | Tab | Backspace | Delete | Insert | Escape | Up | Down | Left | Right | Home | End | PageUp | PageDown | F => none

## How the caret is drawn (std.ui.18).
pub enum Cursor
    Bar
    Block
    Underline

## Why a window couldn't open (std.ui.1, ADR 1068).
pub error struct UiError
    pub kind UiKind
    pub message str

pub enum UiKind
    NoDisplay
    Closed
    Other

## std.ui.17
pub BLACK := 0x000000
pub BLUE := 0x2472C8
pub CYAN := 0x11A8CD
pub GRAY := 0x808080
pub GREEN := 0x0DBC79
pub MAGENTA := 0xBC3FBC
pub ORANGE := 0xCE9178
pub RED := 0xCD3131
pub WHITE := 0xFFFFFF
pub YELLOW := 0xE5E510

## The screen as an app, so `app.frame` builds the host's view line.
struct Screen
    title str
    w float
    h float
    ops List[app.Op]

impl app.App for Screen
    fn update(mut self, ev app.Event)
        return

    fn view(self) app.Node
        app.canvas("grid", w, h, ops)

    fn title(self) str
        title

## Supplied by the lowering (runtime `chan_ready`): whether `recv` on `ch`
## would return at once, reading what the host child has written so far.
fn chan_ready(ch Channel[str]) bool
    return false

## std.ui.1: a window needs a host, and this run may have none.
pub fn open(title str, cols int, rows int) Window ! UiError
    if cols < 1 or cols > 1000 or rows < 1 or rows > 1000
        return UiError(kind: Other, message: "a window is 1 to 1000 cells each way")
    host := app.host_path() else err
        return UiError(kind: NoDisplay, message: "no window host in this run")
    c := proc.start(host, []) else err
        return UiError(kind: NoDisplay, message: "the window host did not start")
    n := cols * rows
    mut w := Window(
        handle: 1,
        live: true,
        cols: cols,
        rows: rows,
        chars: [" " for i in 0..n],
        fgs: [WHITE for i in 0..n],
        bgs: [BLACK for i in 0..n],
        sts: [0 for i in 0..n],
        cur_col: -1,
        cur_row: -1,
        shape: Cursor.Bar,
        title: title,
        px: 20,
        cell_w: 0.0,
        mods: Modifiers(ctrl: false, alt: false, shift: false),
        queue: [],
        to_host: c.stdin,
        from_host: c.out,
    )
    w.send_view(true)
    # The host's first line, then its first canvas size; later ones are events.
    mut seen := false
    while not seen
        line := w.from_host.recv() else break
        j := parse_json(line) else continue
        ev := app.event_from_json(j)
        if ev.kind == app.EventKind.Resize
            w.cell_w = ev.cell_w
            seen = true
    if not seen
        return UiError(kind: NoDisplay, message: "the window host exited")
    w.send_view(false)
    w

## The font size in points for a cell `px` pixels high.
fn Window.pts(self) float
    px.to_float() / 1.2

## A cell's width in points (the host's mono advance at 13 points, scaled).
fn Window.cw(self) float
    if cell_w <= 0.0
        return pts() * 0.6
    cell_w * pts() / 13.0

fn Window.ch(self) float
    px.to_float()

## Send the grid; `first` gives the canvas its size from the cell counts,
## after that it fills the window.
fn Window.send_view(mut self, first bool)
    if not live
        return
    s := pts()
    mut ops := List[app.Op]()
    cwp := cw()
    chp := ch()
    # A run of cells with one background becomes one `Fill`; one style, one `Str`.
    for r in 0..rows
        mut c := 0
        while c < cols
            i := r * cols + c
            mut e := c + 1
            while e < cols and bgs[r * cols + e] == bgs[i]
                e += 1
            if bgs[i] != BLACK
                ops.push(app.Op.Fill(
                    c.to_float() * cwp,
                    r.to_float() * chp,
                    (e - c).to_float() * cwp,
                    chp,
                    bgs[i],
                ))
            c = e
        c = 0
        while c < cols
            i := r * cols + c
            mut e := c + 1
            while e < cols and fgs[r * cols + e] == fgs[i] and sts[r * cols + e] == sts[i]
                e += 1
            mut text := ""
            for k in c..e
                text = "{text}{chars[r * cols + k]}"
            if text.trim_end() != "" or sts[i].bit_and(4) != 0
                ops.push(app.Op.Str(
                    c.to_float() * cwp,
                    r.to_float() * chp,
                    text,
                    "mono",
                    s,
                    fgs[i],
                    sts[i].bit_and(1) != 0,
                    sts[i].bit_and(2) != 0,
                    sts[i].bit_and(4) != 0,
                ))
            c = e
    if cur_col >= 0 and cur_col < cols and cur_row >= 0 and cur_row < rows
        x := cur_col.to_float() * cwp
        y := cur_row.to_float() * chp
        if shape == Cursor.Block
            ops.push(app.Op.Fill(x, y, cwp, chp, WHITE))
        elif shape == Cursor.Underline
            ops.push(app.Op.Fill(x, y + chp - 2.0, cwp, 2.0, WHITE))
        else
            ops.push(app.Op.Fill(x, y, 2.0, chp, WHITE))
    screen := Screen(
        title: title,
        w: if first then cols.to_float() * cwp else 0.0,
        h: if first then rows.to_float() * chp else 0.0,
        ops: ops,
    )
    to_host.send("{app.frame(screen)}\n")

pub fn Window.size(self) Size
    if not live
        return Size(cols: 0, rows: 0)
    Size(cols: cols, rows: rows)

pub fn Window.clear(mut self, bg int)
    if not live
        return
    for i in 0..cols * rows
        chars[i] = " "
        bgs[i] = bg
        sts[i] = 0
        fgs[i] = WHITE

pub fn Window.put(mut self, col int, row int, text str, fg int, bg int)
    put_styled(col, row, text, fg, bg, Style(bold: false, italic: false, underline: false))

pub fn Window.put_styled(mut self, col int, row int, text str, fg int, bg int, style Style)
    if not live or row < 0 or row >= rows
        return
    mut flags := 0
    if style.bold
        flags = flags + 1
    if style.italic
        flags = flags + 2
    if style.underline
        flags = flags + 4
    mut c := col
    for g in text.chars()
        if c >= 0 and c < cols
            i := row * cols + c
            chars[i] = "{g}"
            fgs[i] = fg
            bgs[i] = bg
            sts[i] = flags
        c += 1

pub fn Window.cursor(mut self, col int, row int)
    cur_col = col
    cur_row = row

pub fn Window.set_cursor(mut self, col int, row int, shape Cursor)
    cur_col = col
    cur_row = row
    self.shape = shape

pub fn Window.present(mut self)
    send_view(false)

## One host line as an `Event`, or none when it is not one the program sees.
fn Window.decode(mut self, line str) Event?
    j := parse_json(line) else return none
    ev := app.event_from_json(j)
    mods = Modifiers(ctrl: ev.ctrl or ev.meta, alt: ev.alt, shift: ev.shift)
    if ev.kind == app.EventKind.Key
        return Event.Key(key_code(ev.text), ev.ctrl or ev.meta, ev.alt, ev.shift)
    if ev.kind == app.EventKind.Click
        button := if ev.text
            == "right" then MouseButton.Right else if ev.text
            == "left" then MouseButton.Left else MouseButton.Middle
        return Event.Mouse((ev.x / cw()).to_int(), (ev.y / ch()).to_int(), button, MouseKind.Down)
    if ev.kind == app.EventKind.Scroll
        lines := (ev.dy / ch()).round().to_int()
        if lines == 0
            return none
        return Event.Scroll(lines)
    if ev.kind == app.EventKind.Resize
        if ev.cell_w > 0.0
            cell_w = ev.cell_w
        nc := bounded((ev.dx / cw()).to_int())
        nr := bounded((ev.dy / ch()).to_int())
        if nc == cols and nr == rows
            return none
        resize_grid(nc, nr)
        return Event.Resize(nc, nr)
    if ev.kind == app.EventKind.Close
        shut()
        return Event.Close
    none

fn bounded(n int) int
    if n < 1
        return 1
    if n > 1000
        return 1000
    n

## The grid at a new size: cells that still fit are kept, new ones blank.
fn Window.resize_grid(mut self, nc int, nr int)
    mut cs := List[str]()
    mut fs := List[int]()
    mut bs := List[int]()
    mut ss := List[int]()
    for r in 0..nr
        for c in 0..nc
            if r < rows and c < cols
                i := r * cols + c
                cs.push(chars[i])
                fs.push(fgs[i])
                bs.push(bgs[i])
                ss.push(sts[i])
            else
                cs.push(" ")
                fs.push(WHITE)
                bs.push(BLACK)
                ss.push(0)
    chars = cs
    fgs = fs
    bgs = bs
    sts = ss
    cols = nc
    rows = nr

fn Window.shut(mut self)
    if live
        live = false
        to_host.close()

pub fn Window.next_event(mut self) Event
    while true
        if queue.len() > 0
            ev := queue[0]
            queue = queue[1..]
            return ev
        if not live
            return Event.Close
        line := from_host.recv() else
            shut()
            return Event.Close
        ev := decode(line) else continue
        return ev
    Event.Close

pub fn Window.poll_event(mut self) Event?
    while true
        if queue.len() > 0
            ev := queue[0]
            queue = queue[1..]
            return ev
        if not live
            return Event.Close
        if not chan_ready(from_host)
            return none
        line := from_host.recv() else
            shut()
            return Event.Close
        ev := decode(line) else continue
        return ev
    none

pub fn Window.modifiers(self) Modifiers
    if not live
        return Modifiers(ctrl: false, alt: false, shift: false)
    mods

pub fn Window.set_title(mut self, text str)
    title = text

pub fn Window.set_font_size(mut self, px int)
    # std.ui.15: a window that is not open keeps 20.
    if not live
        return
    mut best := 20
    mut gap := 1000
    for n in [10, 12, 13, 14, 15, 18, 20, 24, 26, 28, 30, 36, 40]
        d := if n > px then n - px else px - n
        if d < gap
            gap = d
            best = n
    self.px = best

## std.ui.15: a window opens at 20.
pub fn Window.font_size(self) int
    if live then px else 20

pub fn Window.close(mut self)
    shut()

## std.ui.12: the program's own clipboard (the native runtime keeps it; the
## lowering supplies the bodies of these two).
pub fn clipboard_set(text str)
    return

pub fn clipboard_get() str?
    none
