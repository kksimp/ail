## std.audio clips (spec std.audio.1-7, draft): sound as plain data. A clip is
## interleaved float samples in -1.0..1.0 with a sample rate and a channel
## count. Everything here is pure; devices (playback, capture) come from
## `std.audio.device`, which needs a host program and is not written yet.

pub error struct AudioError "{self.why}"
    pub why str

pub struct Clip
    pub rate int
    pub channels int
    pub samples List[float]

## Frames (one sample per channel) in `c` (std.audio.2).
pub fn frames(c Clip) int
    c.samples.len() / c.channels

## Length of `c` in milliseconds (std.audio.2).
pub fn duration_ms(c Clip) int
    frames(c) * 1000 / c.rate

## `ms` milliseconds of silence (std.audio.3).
pub fn silence(rate int, channels int, ms int) Clip
    n := rate * ms / 1000 * channels
    Clip(rate: rate, channels: channels, samples: [0.0 for _ in 0..n])

## A mono sine tone of `freq` Hz and amplitude `amp` (std.audio.3).
pub fn tone(freq float, ms int, rate int, amp float) Clip
    n := rate * ms / 1000
    w := 6.283185307179586 * freq / rate.to_float()
    Clip(rate: rate, channels: 1, samples: [amp * (w * i.to_float()).sin() for i in 0..n])

## Every sample times `g` (std.audio.4).
pub fn gain(c Clip, g float) Clip
    Clip(rate: c.rate, channels: c.channels, samples: [s * g for s in c.samples])

## The largest absolute sample, 0.0 for an empty clip (std.audio.4).
pub fn peak(c Clip) float
    mut p := 0.0
    for s in c.samples
        a := if s < 0.0 then 0.0 - s else s
        if a > p
            p = a
    p

## `a` then `b`; both must share rate and channels (std.audio.5).
pub fn concat(a Clip, b Clip) Clip ! AudioError
    if a.rate != b.rate or a.channels != b.channels
        return AudioError(why: "concat: formats differ")
    mut out := a.samples
    for s in b.samples
        out.push(s)
    Clip(rate: a.rate, channels: a.channels, samples: out)

## `a` and `b` played together, as long as the longer one, samples summed and
## clamped to -1.0..1.0 (std.audio.5).
pub fn mix(a Clip, b Clip) Clip ! AudioError
    if a.rate != b.rate or a.channels != b.channels
        return AudioError(why: "mix: formats differ")
    n := if a.samples.len() > b.samples.len() then a.samples.len() else b.samples.len()
    mut out := List[float]()
    for i in 0..n
        x := if i < a.samples.len() then a.samples[i] else 0.0
        y := if i < b.samples.len() then b.samples[i] else 0.0
        out.push(clamp1(x + y))
    Clip(rate: a.rate, channels: a.channels, samples: out)

fn clamp1(x float) float
    if x > 1.0
        return 1.0
    if x < -1.0
        return -1.0
    x

## One channel: the mean of each frame's samples (std.audio.6).
pub fn to_mono(c Clip) Clip
    if c.channels == 1
        return c
    n := frames(c)
    mut out := List[float]()
    for f in 0..n
        mut sum := 0.0
        for ch in 0..c.channels
            sum += c.samples[f * c.channels + ch]
        out.push(sum / c.channels.to_float())
    Clip(rate: c.rate, channels: 1, samples: out)

## `c` at another sample rate, by linear interpolation (std.audio.6).
pub fn resample(c Clip, rate int) Clip
    if rate == c.rate or frames(c) == 0
        return Clip(rate: rate, channels: c.channels, samples: c.samples)
    n := frames(c)
    m := n * rate / c.rate
    step := c.rate.to_float() / rate.to_float()
    mut out := List[float]()
    for j in 0..m
        pos := j.to_float() * step
        i0 := pos.to_int()
        i1 := if i0 + 1 < n then i0 + 1 else n - 1
        t := pos - i0.to_float()
        for ch in 0..c.channels
            x := c.samples[i0 * c.channels + ch]
            y := c.samples[i1 * c.channels + ch]
            out.push(x + (y - x) * t)
    Clip(rate: rate, channels: c.channels, samples: out)

fn u16le(b bytes, i int) int
    b[i].to_int() + b[i + 1].to_int() * 256

fn u32le(b bytes, i int) int
    u16le(b, i) + u16le(b, i + 2) * 65536

fn put16(mut out List[u8], v int)
    out.push((v % 256).to_u8())
    out.push((v / 256 % 256).to_u8())

fn put32(mut out List[u8], v int)
    put16(mut out, v % 65536)
    put16(mut out, v / 65536)

## A RIFF/WAVE file holding 16-bit PCM or 32-bit float samples as a clip
## (std.audio.7). Chunks other than `fmt ` and `data` are skipped.
pub fn decode_wav(b bytes) Clip ! AudioError
    if b.len() < 12 or not b[0..4].starts_with(b"RIFF") or not b[8..12].starts_with(b"WAVE")
        return AudioError(why: "not a WAV file")
    mut pos := 12
    mut fmt := 0
    mut channels := 0
    mut rate := 0
    mut bits := 0
    mut have_fmt := false
    while pos + 8 <= b.len()
        id := b[pos..pos + 4]
        size := u32le(b, pos + 4)
        body := pos + 8
        if id.starts_with(b"fmt ")
            if size < 16 or body + 16 > b.len()
                return AudioError(why: "short fmt chunk")
            fmt = u16le(b, body)
            channels = u16le(b, body + 2)
            rate = u32le(b, body + 4)
            bits = u16le(b, body + 14)
            have_fmt = true
        elif id.starts_with(b"data")
            if not have_fmt
                return AudioError(why: "data before fmt")
            end := if body + size > b.len() then b.len() else body + size
            ok16 := fmt == 1 and bits == 16
            okf32 := fmt == 3 and bits == 32
            if channels < 1 or rate < 1 or not (ok16 or okf32)
                return AudioError(why: "unsupported format {fmt}/{bits} bit")
            mut out := List[float]()
            if ok16
                mut i := body
                while i + 2 <= end
                    v := u16le(b, i)
                    s := if v >= 32768 then v - 65536 else v
                    out.push(s.to_float() / 32768.0)
                    i += 2
            else
                return AudioError(why: "32-bit float WAV not supported yet")
            return Clip(rate: rate, channels: channels, samples: out)
        pos = body + size + size % 2
    AudioError(why: "no data chunk")

## `c` as a 16-bit PCM WAV file (std.audio.7). Samples are clamped.
pub fn encode_wav(c Clip) bytes
    n := c.samples.len() * 2
    mut out := List[u8]()
    for ch in "RIFF".to_bytes()
        out.push(ch)
    put32(mut out, 36 + n)
    for ch in "WAVEfmt ".to_bytes()
        out.push(ch)
    put32(mut out, 16)
    put16(mut out, 1)
    put16(mut out, c.channels)
    put32(mut out, c.rate)
    put32(mut out, c.rate * c.channels * 2)
    put16(mut out, c.channels * 2)
    put16(mut out, 16)
    for ch in "data".to_bytes()
        out.push(ch)
    put32(mut out, n)
    for s in c.samples
        v := (clamp1(s) * 32767.0).round().to_int()
        put16(mut out, if v < 0 then v + 65536 else v)
    bytes.from_list(out)

## `c` as raw little-endian 16-bit PCM, no header (std.audio.8).
pub fn to_pcm16(c Clip) bytes
    mut out := List[u8]()
    for s in c.samples
        v := (clamp1(s) * 32767.0).round().to_int()
        put16(mut out, if v < 0 then v + 65536 else v)
    bytes.from_list(out)

## A clip from raw little-endian 16-bit PCM (std.audio.8).
pub fn from_pcm16(b bytes, rate int, channels int) Clip
    mut out := List[float]()
    mut i := 0
    while i + 2 <= b.len()
        v := u16le(b, i)
        s := if v >= 32768 then v - 65536 else v
        out.push(s.to_float() / 32768.0)
        i += 2
    Clip(rate: rate, channels: channels, samples: out)

## `v` shifted left by `n` bits.
fn lsh(v int, n int) int
    v.shl(n)

## Reads bits from `data`, most significant first (a FLAC stream).
struct Bits
    data bytes
    pos int

fn Bits.take(mut self, n int) int ! AudioError
    if self.pos + n > self.data.len() * 8
        return AudioError(why: "flac: the data ends early")
    mut v := 0
    mut left := n
    while left > 0
        byte := self.data[self.pos / 8].to_int()
        used := self.pos % 8
        avail := 8 - used
        k := if left < avail then left else avail
        part := byte.shr(avail - k).bit_and(lsh(1, k) - 1)
        v = v.shl(k).bit_or(part)
        self.pos += k
        left -= k
    v

fn Bits.signed(mut self, n int) int ! AudioError
    if n == 0
        return 0
    v := self.take(n)?
    if v >= lsh(1, n - 1)
        return v - lsh(1, n)
    v

fn Bits.unary(mut self) int ! AudioError
    mut n := 0
    while self.take(1)? == 0
        n += 1
    n

## The rice-coded residual of a subframe with `order` warm-up samples.
fn flac_residual(mut b Bits, size int, order int) List[int] ! AudioError
    method := b.take(2)?
    if method > 1
        return AudioError(why: "flac: bad residual coding")
    porder := b.take(4)?
    mut out := List[int]()
    for part in 0..lsh(1, porder)
        n := size.shr(porder)
        count := if part == 0 then n - order else n
        k := b.take(if method == 0 then 4 else 5)?
        escape := if method == 0 then 15 else 31
        if k == escape
            bits := b.take(5)?
            for _ in 0..count
                out.push(b.signed(bits)?)
        else
            for _ in 0..count
                q := b.unary()?
                r := b.take(k)?
                u := q.shl(k).bit_or(r)
                out.push(u.shr(1).bit_xor(0 - u.bit_and(1)))
    out

## One subframe of `size` samples at `bps` bits.
fn flac_subframe(mut b Bits, size int, bps int) List[int] ! AudioError
    if b.take(1)? != 0
        return AudioError(why: "flac: bad subframe")
    kind := b.take(6)?
    mut wasted := 0
    if b.take(1)? == 1
        wasted = b.unary()? + 1
    bits := bps - wasted
    mut s := List[int]()
    if kind == 0
        v := b.signed(bits)?
        for _ in 0..size
            s.push(v)
    elif kind == 1
        for _ in 0..size
            s.push(b.signed(bits)?)
    elif kind >= 8 and kind <= 12
        order := kind - 8
        for _ in 0..order
            s.push(b.signed(bits)?)
        res := flac_residual(mut b, size, order)?
        for i in 0..res.len()
            n := s.len()
            mut p := 0
            if order == 1
                p = s[n - 1]
            elif order == 2
                p = 2 * s[n - 1] - s[n - 2]
            elif order == 3
                p = 3 * s[n - 1] - 3 * s[n - 2] + s[n - 3]
            elif order == 4
                p = 4 * s[n - 1] - 6 * s[n - 2] + 4 * s[n - 3] - s[n - 4]
            s.push(res[i] + p)
    elif kind >= 32
        order := kind - 31
        for _ in 0..order
            s.push(b.signed(bits)?)
        precision := b.take(4)? + 1
        shift := b.signed(5)?
        mut coef := List[int]()
        for _ in 0..order
            coef.push(b.signed(precision)?)
        res := flac_residual(mut b, size, order)?
        for i in 0..res.len()
            n := s.len()
            mut acc := 0
            for j in 0..order
                acc += coef[j] * s[n - 1 - j]
            s.push(res[i] + acc.shr(shift))
    else
        return AudioError(why: "flac: unsupported subframe type {kind}")
    if wasted > 0
        return [v.shl(wasted) for v in s]
    s

## A FLAC file as a clip (std.audio.11). Reads 8 to 24 bit streams; the CRCs
## and the MD5 are not checked.
pub fn decode_flac(data bytes) Clip ! AudioError
    if data.len() < 42 or not data[0..4].starts_with(b"fLaC")
        return AudioError(why: "not a FLAC file")
    mut b := Bits(data: data, pos: 32)
    mut rate := 0
    mut channels := 0
    mut sbps := 0
    mut last := false
    while not last
        last = b.take(1)? == 1
        kind := b.take(7)?
        len := b.take(24)?
        if kind == 0
            b.take(32)?
            b.take(24)?
            b.take(24)?
            rate = b.take(20)?
            channels = b.take(3)? + 1
            sbps = b.take(5)? + 1
            b.take(36)?
            b.take(128)?
        else
            b.pos += len * 8
    if rate == 0
        return AudioError(why: "flac: no STREAMINFO")
    mut out := List[float]()
    while b.pos + 16 <= data.len() * 8
        if b.take(14)? != 16382
            return AudioError(why: "flac: lost frame sync")
        b.take(2)?
        bcode := b.take(4)?
        rcode := b.take(4)?
        assign := b.take(4)?
        scode := b.take(3)?
        b.take(1)?
        first := b.take(8)?
        if first >= 192
            mut more := 1
            if first >= 254
                more = 6
            elif first >= 252
                more = 5
            elif first >= 248
                more = 4
            elif first >= 240
                more = 3
            elif first >= 224
                more = 2
            for _ in 0..more
                b.take(8)?
        mut size := 0
        if bcode == 1
            size = 192
        elif bcode >= 2 and bcode <= 5
            size = lsh(576, bcode - 2)
        elif bcode == 6
            size = b.take(8)? + 1
        elif bcode == 7
            size = b.take(16)? + 1
        elif bcode >= 8
            size = lsh(256, bcode - 8)
        else
            return AudioError(why: "flac: bad block size")
        if rcode == 12
            b.take(8)?
        elif rcode == 13 or rcode == 14
            b.take(16)?
        b.take(8)?
        mut bps := sbps
        if scode == 1
            bps = 8
        elif scode == 2
            bps = 12
        elif scode == 4
            bps = 16
        elif scode == 5
            bps = 20
        elif scode == 6
            bps = 24
        n := if assign < 8 then assign + 1 else 2
        mut chans := List[List[int]]()
        for c in 0..n
            side := (assign == 8 and c == 1)
                or (assign == 9 and c == 0)
                or (assign == 10 and c == 1)
            chans.push(flac_subframe(mut b, size, if side then bps + 1 else bps)?)
        if assign >= 8
            for i in 0..size
                a := chans[0][i]
                d := chans[1][i]
                if assign == 8
                    chans[1][i] = a - d
                elif assign == 9
                    chans[0][i] = a + d
                else
                    m := a.shl(1).bit_or(d.bit_and(1))
                    chans[0][i] = (m + d).shr(1)
                    chans[1][i] = (m - d).shr(1)
        b.pos = (b.pos + 7) / 8 * 8 + 16
        scale := lsh(1, bps - 1).to_float()
        for i in 0..size
            for c in 0..n
                out.push(chans[c][i].to_float() / scale)
        channels = n
    Clip(rate: rate, channels: channels, samples: out)
