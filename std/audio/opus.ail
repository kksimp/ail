## `x` wrapped to a signed 32-bit value.
fn w32(x int) int
    v := x.bit_and(0xFFFFFFFF)
    if v >= 0x80000000
        return v - 0x100000000
    v

## `x` wrapped to a signed 16-bit value.
fn w16(x int) int
    v := x.bit_and(0xFFFF)
    if v >= 0x8000
        return v - 0x10000
    v

fn sat16(x int) int
    x.max(-32768).min(32767)

fn smulwb(a int, b int) int
    w32((a * w16(b)).shr(16))

fn smlawb(a int, b int, c int) int
    w32(a + (b * w16(c)).shr(16))

fn smulww(a int, b int) int
    w32((a * b).shr(16))

fn smlaww(a int, b int, c int) int
    w32(a + (b * c).shr(16))

fn smulbb(a int, b int) int
    w16(a) * w16(b)

fn smmul(a int, b int) int
    w32((a * b).shr(32))

## `a` shifted right by `s` with rounding (silk_RSHIFT_ROUND).
fn rround(a int, s int) int
    if s == 1
        return a.shr(1) + a.bit_and(1)
    (a.shr(s - 1) + 1).shr(1)

## `a` kept between two limits given in either order (silk_LIMIT).
fn limit(a int, l1 int, l2 int) int
    if l1 > l2
        return a.min(l1).max(l2)
    a.min(l2).max(l1)

fn lshift_sat32(a int, s int) int
    w32(limit(a, (-2147483648).shr(s), 2147483647.shr(s)).shl(s))

fn sat32(x int) int
    x.max(-2147483648).min(2147483647)

## Leading zero bits of a 32-bit value.
fn clz32(x int) int
    if x == 0
        return 32
    32 - ilog(x.bit_and(0xFFFFFFFF))

## 1/b in Q`qres` (silk_INVERSE32_varQ).
fn inverse32_varq(b32 int, qres int) int
    hd := clz32(b32.abs()) - 1
    nrm := w32(b32.shl(hd))
    inv := 536870911 / nrm.shr(16)
    result := w32(inv.shl(16))
    err := w32(((1).shl(29) - smulwb(nrm, inv)).shl(3))
    r := smlaww(result, err, inv)
    ls := 61 - hd - qres
    if ls <= 0
        return lshift_sat32(r, 0 - ls)
    if ls < 32
        return r.shr(ls)
    0

## a/b in Q`qres` (silk_DIV32_varQ).
fn div32_varq(a32 int, b32 int, qres int) int
    ah := clz32(a32.abs()) - 1
    an := w32(a32.shl(ah))
    bh := clz32(b32.abs()) - 1
    bn := w32(b32.shl(bh))
    inv := 536870911 / bn.shr(16)
    result := smulwb(an, inv)
    rest := w32(an - w32(smmul(bn, result).shl(3)))
    r := smlawb(result, rest, inv)
    ls := 29 + ah - bh - qres
    if ls < 0
        return lshift_sat32(r, 0 - ls)
    if ls < 32
        return r.shr(ls)
    0

## 2^(x/128) (silk_log2lin).
fn log2lin(x int) int
    if x < 0
        return 0
    if x >= 3967
        return 2147483647
    out := op_lsh(1, x.shr(7))
    f := x.bit_and(0x7F)
    if x < 2048
        return out + (out * smlawb(f, smulbb(f, 128 - f), -174)).shr(7)
    out + out.shr(7) * smlawb(f, smulbb(f, 128 - f), -174)

## As `icdf` with a table that starts at `table[at]` (8-bit entries).
fn RangeDecoder.icdf_at(mut self, table List[int], at int) int
    r := self.rng.shr(8)
    mut s := self.rng
    mut t := s
    mut k := -1
    while true
        k += 1
        t = s
        s = r * table[at + k]
        if self.val >= s
            break
    self.val -= s
    self.rng = t - s
    self.normalize()
    k

## Drops the last `n` bytes of the frame: the Opus layer's redundant CELT
## frame sits there (RFC 6716 §4.5.1).
fn RangeDecoder.shorten(mut self, n int)
    self.data = self.data[0..self.data.len() - n]

## Line spectral frequencies (RFC 6716 §4.2.7.5)

## A codebook of normalised LSFs: narrow/medium band (order 10) or wide
## band (order 16).
struct NlsfBook
    order int
    step int
    cb1 List[int]
    wght List[int]
    cb1_icdf List[int]
    pred List[int]
    sel List[int]
    ec_icdf List[int]
    dmin List[int]

NB_BOOK := NlsfBook(
    order: 10,
    step: 11796,
    cb1: NB_CB1_Q8,
    wght: NB_CB1_WGHT_Q9,
    cb1_icdf: NB_CB1_ICDF,
    pred: NB_PRED_Q8,
    sel: NB_CB2_SELECT,
    ec_icdf: NB_CB2_ICDF,
    dmin: NB_DELTA_MIN_Q15,
)

WB_BOOK := NlsfBook(
    order: 16,
    step: 9830,
    cb1: WB_CB1_Q8,
    wght: WB_CB1_WGHT_Q9,
    cb1_icdf: WB_CB1_ICDF,
    pred: WB_PRED_Q8,
    sel: WB_CB2_SELECT,
    ec_icdf: WB_CB2_ICDF,
    dmin: WB_DELTA_MIN_Q15,
)

## The entropy table offsets and predictor weights of first-stage vector `i0`.
fn nlsf_unpack(cb NlsfBook, i0 int)(List[int], List[int])
    mut ec_ix := [0 for _ in 0..cb.order]
    mut pred := [0 for _ in 0..cb.order]
    mut i := 0
    while i < cb.order
        e := cb.sel[i0 * cb.order / 2 + i / 2]
        ec_ix[i] = e.shr(1).bit_and(7) * 9
        pred[i] = cb.pred[i + e.bit_and(1) * (cb.order - 1)]
        ec_ix[i + 1] = e.shr(5).bit_and(7) * 9
        pred[i + 1] = cb.pred[i + e.shr(4).bit_and(1) * (cb.order - 1) + 1]
        i += 2
    (ec_ix, pred)

fn nlsf_stabilize(mut x List[int], dmin List[int], l int)
    for _ in 0..20
        mut md := x[0] - dmin[0]
        mut at := 0
        for i in 1..l
            gap := x[i] - (x[i - 1] + dmin[i])
            if gap < md
                md = gap
                at = i
        top := 32768 - (x[l - 1] + dmin[l])
        if top < md
            md = top
            at = l
        if md >= 0
            return
        if at == 0
            x[0] = dmin[0]
        elif at == l
            x[l - 1] = 32768 - dmin[l]
        else
            mut lo := dmin[at].shr(1)
            for k in 0..at
                lo += dmin[k]
            mut hi := 32768 - dmin[at].shr(1)
            for k2 in at + 1..l + 1
                hi -= dmin[k2]
            c := limit(rround(x[at - 1] + x[at], 1), lo, hi)
            x[at - 1] = c - dmin[at].shr(1)
            x[at] = x[at - 1] + dmin[at]
    x.sort()
    x[0] = x[0].max(dmin[0])
    for i2 in 1..l
        x[i2] = x[i2].max(sat16(x[i2 - 1] + dmin[i2]))
    x[l - 1] = x[l - 1].min(32768 - dmin[l])
    mut j := l - 2
    while j >= 0
        x[j] = x[j].min(x[j + 1] - dmin[j + 1])
        j -= 1

## The LSFs in Q15 from the codebook indices (RFC 6716 §4.2.7.5.3-5).
fn nlsf_decode(cb NlsfBook, idx List[int]) List[int]
    up := nlsf_unpack(cb, idx[0])
    pred := up.1
    mut res := [0 for _ in 0..cb.order]
    mut prev := 0
    mut i := cb.order - 1
    while i >= 0
        p := smulbb(prev, pred[i]).shr(8)
        mut q := idx[1 + i].shl(10)
        if q > 0
            q -= 102
        elif q < 0
            q += 102
        prev = smlawb(p, q, cb.step)
        res[i] = prev
        i -= 1
    mut nlsf := List[int]()
    for k in 0..cb.order
        v := res[k].shl(14) / cb.wght[idx[0] * cb.order + k] + cb.cb1[idx[0] * cb.order + k].shl(7)
        nlsf.push(limit(v, 0, 32767))
    nlsf_stabilize(mut nlsf, cb.dmin, cb.order)
    nlsf

## One of the two polynomials of the LSF to LPC conversion.
fn find_poly(c List[int], off int, dd int) List[int]
    mut out := [0 for _ in 0..dd + 1]
    out[0] = 65536
    out[1] = 0 - c[off]
    for k in 1..dd
        f := c[off + 2 * k]
        out[k + 1] = w32(out[k - 1].shl(1) - rround(f * out[k], 16))
        mut n := k
        while n > 1
            out[n] = w32(out[n] + out[n - 2] - rround(f * out[n - 1], 16))
            n -= 1
        out[1] -= f
    out

fn bwexpander_32(mut a List[int], d int, chirp0 int)
    mut chirp := chirp0
    cm1 := chirp0 - 65536
    for i in 0..d - 1
        a[i] = smulww(chirp, a[i])
        chirp += rround(chirp * cm1, 16)
    a[d - 1] = smulww(chirp, a[d - 1])

## Fits Q`qin` coefficients into 16 bits at Q`qout` (silk_LPC_fit).
fn lpc_fit(mut a List[int], qout int, qin int, d int) List[int]
    mut fitted := false
    for _ in 0..10
        mut maxabs := 0
        mut at := 0
        for k in 0..d
            if a[k].abs() > maxabs
                maxabs = a[k].abs()
                at = k
        maxabs = rround(maxabs, qin - qout)
        if maxabs > 32767
            maxabs = maxabs.min(163838)
            chirp := 65470 - (maxabs - 32767).shl(14) / (maxabs * (at + 1)).shr(2)
            bwexpander_32(mut a, d, chirp)
        else
            fitted = true
            break
    mut out := List[int]()
    for k2 in 0..d
        if fitted
            out.push(w16(rround(a[k2], qin - qout)))
        else
            v := sat16(rround(a[k2], qin - qout))
            out.push(v)
            a[k2] = v.shl(qin - qout)
    out

## The inverse prediction gain in Q30, or 0 when the filter is unstable
## (silk_LPC_inverse_pred_gain).
fn inv_pred_gain(a_q12 List[int], order int) int
    mut dc := 0
    for v in a_q12
        dc += v
    if dc >= 4096
        return 0
    mut a := [v.shl(12) for v in a_q12]
    lim := 16773022
    min_inv := 107374
    mut inv := op_lsh(1, 30)
    mut k := order - 1
    while k > 0
        if a[k] > lim or a[k] < 0 - lim
            return 0
        rc := w32(0 - a[k].shl(7))
        m1 := op_lsh(1, 30) - smmul(rc, rc)
        inv = w32(smmul(inv, m1).shl(2))
        if inv < min_inv
            return 0
        m2q := 32 - clz32(m1.abs())
        m2 := inverse32_varq(m1, m2q + 30)
        for n in 0..(k + 1).shr(1)
            t1 := a[n]
            t2 := a[k - n - 1]
            v1 := rround(sat32(t1 - w32(rround(t2 * rc, 31))) * m2, m2q)
            if v1 > 2147483647 or v1 < -2147483648
                return 0
            a[n] = v1
            v2 := rround(sat32(t2 - w32(rround(t1 * rc, 31))) * m2, m2q)
            if v2 > 2147483647 or v2 < -2147483648
                return 0
            a[k - n - 1] = v2
        k -= 1
    if a[0] > lim or a[0] < 0 - lim
        return 0
    rc0 := w32(0 - a[0].shl(7))
    m10 := op_lsh(1, 30) - smmul(rc0, rc0)
    inv = w32(smmul(inv, m10).shl(2))
    if inv < min_inv
        return 0
    inv

ORDER16 := [0, 15, 8, 7, 4, 11, 12, 3, 2, 13, 10, 5, 6, 9, 14, 1]
ORDER10 := [0, 9, 6, 3, 4, 5, 8, 1, 2, 7]

## LPC coefficients in Q12 from LSFs in Q15, made stable (silk_NLSF2A).
fn nlsf2a(nlsf List[int], d int) List[int]
    mut c := [0 for _ in 0..d]
    for k in 0..d
        fi := nlsf[k].shr(8)
        ff := nlsf[k] - fi.shl(8)
        cv := LSF_COS_Q12[fi]
        delta := LSF_COS_Q12[fi + 1] - cv
        o := if d == 16 then ORDER16[k] else ORDER10[k]
        c[o] = rround(cv.shl(8) + delta * ff, 4)
    dd := d.shr(1)
    p := find_poly(c, 0, dd)
    q := find_poly(c, 1, dd)
    mut a32 := [0 for _ in 0..d]
    for k2 in 0..dd
        pt := p[k2 + 1] + p[k2]
        qt := q[k2 + 1] - q[k2]
        a32[k2] = 0 - qt - pt
        a32[d - k2 - 1] = qt - pt
    mut a := lpc_fit(mut a32, 12, 17, d)
    mut i := 0
    while inv_pred_gain(a, d) == 0 and i < 16
        bwexpander_32(mut a32, d, 65536 - op_lsh(2, i))
        a = [w16(rround(v, 5)) for v in a32]
        i += 1
    a

fn izeros(n int) List[int]
    [0 for _ in 0..n]

## The decoder state of one SILK channel (silk_decoder_state).
struct SilkChan
    khz int
    frame_length int
    nb_subfr int
    subfr_length int
    ltp_mem int
    order int
    book NlsfBook
    contour List[int]
    lag_low List[int]
    prev_gain int
    first bool
    out List[int]
    slpc List[int]
    lag_prev int
    last_gain int
    prev_type int
    prev_nlsf List[int]
    ec_prev_type int
    ec_prev_lag int
    rs Resampler

fn silk_chan() SilkChan
    SilkChan(
        khz: 0,
        frame_length: 0,
        nb_subfr: 0,
        subfr_length: 0,
        ltp_mem: 0,
        order: 10,
        book: NB_BOOK,
        contour: CONTOUR_ICDF,
        lag_low: UNIFORM8,
        prev_gain: 65536,
        first: true,
        out: izeros(320),
        slpc: izeros(16),
        lag_prev: 100,
        last_gain: 10,
        prev_type: 0,
        prev_nlsf: izeros(16),
        ec_prev_type: 0,
        ec_prev_lag: 0,
        rs: resampler(16),
    )

## Clears what a channel predicts from (silk_decoder_set_fs on a rate change,
## or the side channel restarting after mid-only frames).
fn chan_reset(mut ch SilkChan)
    ch.first = true
    ch.lag_prev = 100
    ch.last_gain = 10
    ch.prev_type = 0
    ch.out = izeros(ch.ltp_mem)
    ch.slpc = izeros(16)

## Sets the internal rate and the subframes of a frame (silk_decoder_set_fs).
fn set_fs(mut ch SilkChan, khz int, subfr int)
    ch.nb_subfr = subfr
    ch.subfr_length = 5 * khz
    fl := subfr * ch.subfr_length
    changed := ch.khz != khz
    if changed
        ch.rs = resampler(khz)
    if changed or fl != ch.frame_length
        if khz == 8
            ch.contour = if subfr == 4 then CONTOUR_NB_ICDF else CONTOUR_10_NB_ICDF
        else
            ch.contour = if subfr == 4 then CONTOUR_ICDF else CONTOUR_10_ICDF
        if changed
            ch.ltp_mem = 20 * khz
            ch.order = if khz < 16 then 10 else 16
            ch.book = if khz < 16 then NB_BOOK else WB_BOOK
            low := match khz
                16 => UNIFORM8
                12 => UNIFORM6
                _ => UNIFORM4
            ch.lag_low = low
            chan_reset(mut ch)
        ch.khz = khz
        ch.frame_length = fl

## How a frame leans on the one before (RFC 6716 §4.2.7.4).
INDEP := 0
INDEP_NO_LTP := 1
COND := 2

## The side information of a frame (silk_decode_indices).
struct Indices
    sig int
    qoff int
    gains List[int]
    nlsf List[int]
    interp int
    lag int
    contour int
    per int
    ltp List[int]
    ltp_scale int
    seed int

fn decode_indices(mut ch SilkChan, mut d RangeDecoder, vad bool, cond int) Indices
    ix := if vad then d.icdf(TYPE_VAD_ICDF, 8) + 2 else d.icdf(TYPE_NO_VAD_ICDF, 8)
    sig := ix.shr(1)
    mut gains := List[int]()
    if cond == COND
        gains.push(d.icdf(DELTA_GAIN_ICDF, 8))
    else
        g := d.icdf_at(GAIN_ICDF, sig * 8).shl(3)
        gains.push(g + d.icdf(UNIFORM8, 8))
    for _ in 1..ch.nb_subfr
        gains.push(d.icdf(DELTA_GAIN_ICDF, 8))
    cb := ch.book
    mut nl := [d.icdf_at(cb.cb1_icdf, sig.shr(1) * 32)]
    up := nlsf_unpack(cb, nl[0])
    ec_ix := up.0
    for i in 0..cb.order
        mut v := d.icdf_at(cb.ec_icdf, ec_ix[i])
        if v == 0
            v -= d.icdf(NLSF_EXT_ICDF, 8)
        elif v == 8
            v += d.icdf(NLSF_EXT_ICDF, 8)
        nl.push(v - 4)
    interp := if ch.nb_subfr == 4 then d.icdf(NLSF_INTERP_ICDF, 8) else 4
    mut lag := 0
    mut contour_ix := 0
    mut per := 0
    mut ltp := List[int]()
    mut scale := 0
    if sig == 2
        mut absolute := true
        if cond == COND and ch.ec_prev_type == 2
            dl := d.icdf(PITCH_DELTA_ICDF, 8)
            if dl > 0
                lag = ch.ec_prev_lag + dl - 9
                absolute = false
        if absolute
            lag = d.icdf(PITCH_LAG_ICDF, 8) * ch.khz.shr(1)
            lag += d.icdf(ch.lag_low, 8)
        ch.ec_prev_lag = lag
        contour_ix = d.icdf(ch.contour, 8)
        per = d.icdf(LTP_PER_ICDF, 8)
        gt := match per
            0 => LTP_GAIN_ICDF_0
            1 => LTP_GAIN_ICDF_1
            _ => LTP_GAIN_ICDF_2
        for _ in 0..ch.nb_subfr
            ltp.push(d.icdf(gt, 8))
        if cond == INDEP
            scale = d.icdf(LTP_SCALE_ICDF, 8)
    ch.ec_prev_type = sig
    seed := d.icdf(UNIFORM4, 8)
    Indices(
        sig: sig,
        qoff: ix.bit_and(1),
        gains: gains,
        nlsf: nl,
        interp: interp,
        lag: lag,
        contour: contour_ix,
        per: per,
        ltp: ltp,
        ltp_scale: scale,
        seed: seed,
    )

## The pulses of a node with `n` leaves at `out[at..]`, split depth first
## (the shell coder, RFC 6716 §4.2.7.8.2).
fn shell_tree(mut d RangeDecoder, mut out List[int], at int, n int, p int)
    if n == 1
        out[at] = p
        return
    table := match n
        16 => SHELL_TABLE_3
        8 => SHELL_TABLE_2
        4 => SHELL_TABLE_1
        _ => SHELL_TABLE_0
    mut left := 0
    if p > 0
        left = d.icdf_at(table, SHELL_OFFSETS[p])
    half := n / 2
    shell_tree(mut d, mut out, at, half, left)
    shell_tree(mut d, mut out, at + half, half, p - left)

## The excitation pulses of a frame of `fl` samples (RFC 6716 §4.2.7.8).
fn silk_pulses(mut d RangeDecoder, sig int, qoff int, fl int) List[int]
    rate := d.icdf_at(RATE_LEVELS_ICDF, sig.shr(1) * 9)
    mut blocks := fl.shr(4)
    if blocks * 16 < fl
        blocks += 1
    mut sums := List[int]()
    mut shifts := List[int]()
    for _ in 0..blocks
        mut n := 0
        mut v := d.icdf_at(PULSES_PER_BLOCK_ICDF, rate * 18)
        while v == 17
            n += 1
            v = d.icdf_at(PULSES_PER_BLOCK_ICDF, 9 * 18 + (if n == 10 then 1 else 0))
        sums.push(v)
        shifts.push(n)
    mut pulses := izeros(blocks * 16)
    for i in 0..blocks
        if sums[i] > 0
            shell_tree(mut d, mut pulses, i * 16, 16, sums[i])
    for i2 in 0..blocks
        if shifts[i2] > 0
            for k in 0..16
                mut q := pulses[i2 * 16 + k]
                for _ in 0..shifts[i2]
                    q = q.shl(1) + d.icdf(LSB_ICDF, 8)
                pulses[i2 * 16 + k] = q
            sums[i2] = sums[i2].bit_or(shifts[i2].shl(5))
    base := 7 * (qoff + sig.shl(1))
    for i3 in 0..(fl + 8).shr(4)
        p := sums[i3]
        if p > 0
            tab := [SIGN_ICDF[base + p.bit_and(0x1F).min(6)], 0]
            for j in 0..16
                if pulses[i3 * 16 + j] > 0
                    pulses[i3 * 16 + j] = pulses[i3 * 16 + j] * (d.icdf(tab, 8).shl(1) - 1)
    pulses

## The subframe gains in Q16 (silk_gains_dequant).
fn gains_dequant(mut ch SilkChan, ind List[int], cond bool) List[int]
    mut out := List[int]()
    for k in 0..ch.nb_subfr
        if k == 0 and not cond
            ch.last_gain = ind[k].max(ch.last_gain - 16)
        else
            step := ind[k] - 4
            th := 8 + ch.last_gain
            if step > th
                ch.last_gain += step.shl(1) - th
            else
                ch.last_gain += step
        ch.last_gain = limit(ch.last_gain, 0, 63)
        out.push(log2lin((smulwb(1907825, ch.last_gain) + 2090).min(3967)))
    out

## The filters of a frame (silk_decoder_control).
struct Ctrl
    gains List[int]
    a0 List[int]
    a1 List[int]
    pitch List[int]
    b List[int]
    ltp_scale int

fn decode_parameters(mut ch SilkChan, mut ind Indices, cond int) Ctrl
    gains := gains_dequant(mut ch, ind.gains, cond == COND)
    nlsf := nlsf_decode(ch.book, ind.nlsf)
    a1 := nlsf2a(nlsf, ch.order)
    if ch.first
        ind.interp = 4
    mut a0 := a1
    if ind.interp < 4
        old := ch.prev_nlsf
        n0 := [old[i] + (ind.interp * (nlsf[i] - old[i])).shr(2) for i in 0..ch.order]
        a0 = nlsf2a(n0, ch.order)
    ch.prev_nlsf = nlsf
    mut pitch := izeros(ch.nb_subfr)
    mut b := izeros(5 * ch.nb_subfr)
    mut scale := 0
    if ind.sig == 2
        mut lags := LAGS_STAGE3
        mut stride := 34
        if ch.khz == 8
            lags = if ch.nb_subfr == 4 then LAGS_STAGE2 else LAGS_STAGE2_10
            stride = if ch.nb_subfr == 4 then 11 else 3
        elif ch.nb_subfr == 2
            lags = LAGS_STAGE3_10
            stride = 12
        lo := 2 * ch.khz
        hi := 18 * ch.khz
        for k in 0..ch.nb_subfr
            pitch[k] = limit(lo + ind.lag + lags[k * stride + ind.contour], lo, hi)
        vq := match ind.per
            0 => LTP_VQ_0
            1 => LTP_VQ_1
            _ => LTP_VQ_2
        for k2 in 0..ch.nb_subfr
            for i2 in 0..5
                b[k2 * 5 + i2] = vq[ind.ltp[k2] * 5 + i2].shl(7)
        scale = LTP_SCALES_Q14[ind.ltp_scale]
    Ctrl(gains: gains, a0: a0, a1: a1, pitch: pitch, b: b, ltp_scale: scale)

## The LPC residual of `inp[at..at + n]` (silk_LPC_analysis_filter).
fn lpc_analysis(inp List[int], at int, coef List[int], n int, order int) List[int]
    mut out := izeros(n)
    for ix in order..n
        mut acc := 0
        for j in 0..order
            acc = w32(acc + smulbb(inp[at + ix - 1 - j], coef[j]))
        acc = w32(inp[at + ix].shl(12) - acc)
        out[ix] = sat16(rround(acc, 12))
    out

OFFSETS_Q10 := [100, 240, 32, 100]

## Excitation through the long- and short-term predictors (silk_decode_core).
fn decode_core(mut ch SilkChan, ind Indices, ctrl Ctrl, pulses List[int]) List[int]
    fl := ch.frame_length
    sl := ch.subfr_length
    mem := ch.ltp_mem
    offset := OFFSETS_Q10[ind.sig.shr(1) * 2 + ind.qoff]
    interp_flag := ind.interp < 4
    mut seed := ind.seed
    mut exc := izeros(fl)
    for i in 0..fl
        seed = w32(907633515 + seed * 196314165)
        mut e := pulses[i].shl(14)
        if e > 0
            e -= 1280
        elif e < 0
            e += 1280
        e += offset.shl(4)
        if seed < 0
            e = 0 - e
        exc[i] = e
        seed = w32(seed + pulses[i])
    mut slpc := ch.slpc
    for _ in 0..sl
        slpc.push(0)
    mut sltp := izeros(mem)
    mut sltp_q15 := izeros(mem + fl)
    mut xq := izeros(fl)
    mut buf_idx := mem
    mut lag := 0
    for k in 0..ch.nb_subfr
        coef := if k < 2 then ctrl.a0 else ctrl.a1
        g := ctrl.gains[k]
        gain_q10 := g.shr(6)
        mut inv_gain := inverse32_varq(g, 47)
        mut adj := 65536
        if g != ch.prev_gain
            adj = div32_varq(ch.prev_gain, g, 16)
            for i2 in 0..16
                slpc[i2] = smulww(adj, slpc[i2])
        ch.prev_gain = g
        if ind.sig == 2
            lag = ctrl.pitch[k]
            if k == 0 or (k == 2 and interp_flag)
                first := mem - lag - ch.order - 2
                mut ob := ch.out
                if k == 2
                    for i3 in 0..2 * sl
                        ob.push(xq[i3])
                res_ltp := lpc_analysis(ob, first + k * sl, coef, mem - first, ch.order)
                for i4 in 0..mem - first
                    sltp[first + i4] = res_ltp[i4]
                if k == 0
                    inv_gain = w32(smulwb(inv_gain, ctrl.ltp_scale).shl(2))
                for i5 in 0..lag + 2
                    sltp_q15[buf_idx - i5 - 1] = smulwb(inv_gain, sltp[mem - i5 - 1])
            elif adj != 65536
                for i6 in 0..lag + 2
                    sltp_q15[buf_idx - i6 - 1] = smulww(adj, sltp_q15[buf_idx - i6 - 1])
        mut res := izeros(sl)
        if ind.sig == 2
            mut p := buf_idx - lag + 2
            for i7 in 0..sl
                mut acc := 2
                for j in 0..5
                    acc = smlawb(acc, sltp_q15[p - j], ctrl.b[k * 5 + j])
                p += 1
                res[i7] = w32(exc[k * sl + i7] + acc.shl(1))
                sltp_q15[buf_idx] = w32(res[i7].shl(1))
                buf_idx += 1
        else
            for j8 in 0..sl
                res[j8] = exc[k * sl + j8]
        for i9 in 0..sl
            mut acc2 := ch.order.shr(1)
            for j2 in 0..ch.order
                acc2 = smlawb(acc2, slpc[16 + i9 - 1 - j2], coef[j2])
            slpc[16 + i9] = sat32(res[i9] + lshift_sat32(acc2, 4))
            xq[k * sl + i9] = sat16(rround(smulww(slpc[16 + i9], gain_q10), 8))
        for i10 in 0..16
            slpc[i10] = slpc[sl + i10]
    ch.slpc = slpc[0..16]
    xq

## One SILK frame of one channel at the internal rate (silk_decode_frame).
fn silk_frame(mut ch SilkChan, mut d RangeDecoder, vad bool, cond int) List[int]
    mut ind := decode_indices(mut ch, mut d, vad, cond)
    pulses := silk_pulses(mut d, ind.sig, ind.qoff, ch.frame_length)
    ctrl := decode_parameters(mut ch, mut ind, cond)
    xq := decode_core(mut ch, ind, ctrl, pulses)
    mem := ch.ltp_mem
    fl := ch.frame_length
    mut kept := List[int]()
    if mem > fl
        for i in fl..mem
            kept.push(ch.out[i])
        for v in xq
            kept.push(v)
    else
        for i2 in fl - mem..fl
            kept.push(xq[i2])
    ch.out = kept
    ch.prev_type = ind.sig
    ch.first = false
    ch.lag_prev = ctrl.pitch[ch.nb_subfr - 1]
    xq

## The resampler to 48 kHz (silk_resampler_private_IIR_FIR): 2x up by an
## all-pass pair, then a 12-phase FIR.
struct Resampler
    fin int
    delay int
    iir List[int]
    fir List[int]
    dbuf List[int]
    batch int
    inv int

fn resampler(khz int) Resampler
    mut inv := (khz * 1000).shl(15) / 48000 * 4
    while smulww(inv, 48000) < (khz * 1000).shl(1)
        inv += 1
    delay := match khz
        8 => 0
        12 => 4
        _ => 7
    Resampler(
        fin: khz,
        delay: delay,
        iir: izeros(6),
        fir: izeros(8),
        dbuf: izeros(khz),
        batch: khz * 10,
        inv: inv,
    )

fn allpass(mut s List[int], i int, x int, c int, third bool) int
    y := x - s[i]
    k := if third then smlawb(y, y, c) else smulwb(y, c)
    o := s[i] + k
    s[i] = x + k
    o

fn up2(mut r Resampler, x List[int]) List[int]
    mut s := r.iir
    mut out := List[int]()
    for v in x
        in32 := v.shl(10)
        a1 := allpass(mut s, 0, in32, 1746, false)
        a2 := allpass(mut s, 1, a1, 14986, false)
        a3 := allpass(mut s, 2, a2, -26453, true)
        out.push(sat16(rround(a3, 10)))
        b1 := allpass(mut s, 3, in32, 6854, false)
        b2 := allpass(mut s, 4, b1, 25769, false)
        b3 := allpass(mut s, 5, b2, -9994, true)
        out.push(sat16(rround(b3, 10)))
    r.iir = s
    out

fn iir_fir(mut r Resampler, x List[int]) List[int]
    mut out := List[int]()
    mut pos := 0
    while true
        n := (x.len() - pos).min(r.batch)
        mut buf := r.fir
        for v in up2(mut r, x[pos..pos + n])
            buf.push(v)
        top := n.shl(17)
        mut idx := 0
        while idx < top
            ti := smulwb(idx.bit_and(0xFFFF), 12)
            b := idx.shr(16)
            f := ti * 4
            g := (11 - ti) * 4
            mut acc := buf[b] * FRAC_FIR_12[f] + buf[b + 1] * FRAC_FIR_12[f + 1]
            acc += buf[b + 2] * FRAC_FIR_12[f + 2] + buf[b + 3] * FRAC_FIR_12[f + 3]
            acc += buf[b + 4] * FRAC_FIR_12[g + 3] + buf[b + 5] * FRAC_FIR_12[g + 2]
            acc += buf[b + 6] * FRAC_FIR_12[g + 1] + buf[b + 7] * FRAC_FIR_12[g]
            out.push(sat16(rround(acc, 15)))
            idx += r.inv
        pos += n
        r.fir = buf[n.shl(1)..n.shl(1) + 8]
        if pos >= x.len()
            break
    out

## A frame at the internal rate to 48 kHz, after the decoder's delay.
fn op_resample(mut r Resampler, x List[int]) List[int]
    ns := r.fin - r.delay
    for i in 0..ns
        r.dbuf[r.delay + i] = x[i]
    head := r.dbuf
    mut out := iir_fir(mut r, head)
    for v in iir_fir(mut r, x[ns..x.len() - r.delay])
        out.push(v)
    for i2 in 0..r.delay
        r.dbuf[i2] = x[x.len() - r.delay + i2]
    out

## Every SILK channel of a stream with the stereo state between them.
struct SilkState
    api int
    internal int
    mid SilkChan
    side SilkChan
    pred_prev List[int]
    smid List[int]
    sside List[int]
    prev_mid_only bool

fn silk_state(api int) SilkState
    SilkState(
        api: api,
        internal: 0,
        mid: silk_chan(),
        side: silk_chan(),
        pred_prev: [0, 0],
        smid: [0, 0],
        sside: [0, 0],
        prev_mid_only: false,
    )

## The mid-side prediction weights in Q13 (silk_stereo_decode_pred).
fn stereo_pred(mut d RangeDecoder) List[int]
    n := d.icdf(STEREO_JOINT_ICDF, 8)
    mut ix := [0, 0, n / 5, 0, 0, n - 5 * (n / 5)]
    for k in 0..2
        ix[k * 3] = d.icdf(UNIFORM3, 8)
        ix[k * 3 + 1] = d.icdf(UNIFORM5, 8)
    mut pred := [0, 0]
    for k2 in 0..2
        q := ix[k2 * 3] + 3 * ix[k2 * 3 + 2]
        lo := STEREO_QUANT_Q13[q]
        step := smulwb(STEREO_QUANT_Q13[q + 1] - lo, 6554)
        pred[k2] = lo + smulbb(step, 2 * ix[k2 * 3 + 1] + 1)
    pred[0] -= pred[1]
    pred

## Mid and side to left and right (silk_stereo_MS_to_LR). `x1` and `x2`
## hold two samples of history and then the frame.
fn ms_to_lr(mut st SilkState, mut x1 List[int], mut x2 List[int], pred List[int], khz int, fl int)
    x1[0] = st.smid[0]
    x1[1] = st.smid[1]
    x2[0] = st.sside[0]
    x2[1] = st.sside[1]
    st.smid = [x1[fl], x1[fl + 1]]
    st.sside = [x2[fl], x2[fl + 1]]
    mut p0 := st.pred_prev[0]
    mut p1 := st.pred_prev[1]
    denom := 65536 / (8 * khz)
    d0 := rround(smulbb(pred[0] - st.pred_prev[0], denom), 16)
    d1 := rround(smulbb(pred[1] - st.pred_prev[1], denom), 16)
    for n in 0..fl
        if n < 8 * khz
            p0 += d0
            p1 += d1
        else
            p0 = pred[0]
            p1 = pred[1]
        mut s := (x1[n] + x1[n + 2] + x1[n + 1].shl(1)).shl(9)
        s = smlawb(x2[n + 1].shl(8), s, p0)
        s = smlawb(s, x1[n + 1].shl(11), p1)
        x2[n + 1] = sat16(rround(s, 8))
    st.pred_prev = pred
    for n2 in 0..fl
        a := x1[n2 + 1]
        b := x2[n2 + 1]
        x1[n2 + 1] = sat16(a + b)
        x2[n2 + 1] = sat16(a - b)

## Skips one channel's low-bitrate redundancy frame (RFC 6716 §4.2.7):
## decoding its indices still moves the channel's pitch-lag context.
fn skip_lbrr(mut ch SilkChan, mut d RangeDecoder, cond int)
    ind := decode_indices(mut ch, mut d, true, cond)
    silk_pulses(mut d, ind.sig, ind.qoff, ch.frame_length)

## The SILK frames of one Opus frame of `ms` milliseconds at `khz` kHz with
## `internal` coded channels: 48 kHz samples per API channel (silk_Decode).
fn silk_decode(mut st SilkState, mut d RangeDecoder, internal int, khz int, ms int) List[List[int]]
    if internal > st.internal and st.internal != 0
        st.side = silk_chan()
    nfr := if ms <= 20 then 1 else ms / 20
    subfr := if ms == 10 then 2 else 4
    set_fs(mut st.mid, khz, subfr)
    if internal == 2
        set_fs(mut st.side, khz, subfr)
    if st.api == 2 and internal == 2 and st.internal == 1
        st.pred_prev = [0, 0]
        st.sside = [0, 0]
        st.side.rs = st.mid.rs
    st.internal = internal
    mut vad := izeros(6)
    mut lflags := izeros(6)
    mut lbrr := [false, false]
    for n in 0..internal
        for i in 0..nfr
            vad[n * 3 + i] = if d.bit_logp(1) then 1 else 0
        lbrr[n] = d.bit_logp(1)
    for n2 in 0..internal
        if lbrr[n2]
            if nfr == 1
                lflags[n2 * 3] = 1
            else
                tab := if nfr == 2 then LBRR_FLAGS_2_ICDF else LBRR_FLAGS_3_ICDF
                sym := d.icdf(tab, 8) + 1
                for i2 in 0..nfr
                    lflags[n2 * 3 + i2] = sym.shr(i2).bit_and(1)
    for i3 in 0..nfr
        for n3 in 0..internal
            if lflags[n3 * 3 + i3] == 1
                if internal == 2 and n3 == 0
                    stereo_pred(mut d)
                    if lflags[3 + i3] == 0
                        d.icdf(MID_ONLY_ICDF, 8)
                cond := if i3 > 0 and lflags[n3 * 3 + i3 - 1] == 1 then COND else INDEP
                if n3 == 0
                    skip_lbrr(mut st.mid, mut d, cond)
                else
                    skip_lbrr(mut st.side, mut d, cond)
    mut left := List[int]()
    mut right := List[int]()
    for i4 in 0..nfr
        mut mid_only := false
        mut pred := [0, 0]
        if internal == 2
            pred = stereo_pred(mut d)
            if vad[3 + i4] == 0
                mid_only = d.icdf(MID_ONLY_ICDF, 8) == 1
        if internal == 2 and not mid_only and st.prev_mid_only
            chan_reset(mut st.side)
        fl := st.mid.frame_length
        cond1 := if i4 == 0 then INDEP else COND
        mut b0 := [0, 0]
        for v in silk_frame(mut st.mid, mut d, vad[i4] == 1, cond1)
            b0.push(v)
        mut b1 := [0, 0]
        if internal == 2
            if mid_only
                for _ in 0..fl
                    b1.push(0)
            else
                mut cond2 := COND
                if i4 <= 1
                    cond2 = INDEP
                elif st.prev_mid_only
                    cond2 = INDEP_NO_LTP
                for v2 in silk_frame(mut st.side, mut d, vad[3 + i4] == 1, cond2)
                    b1.push(v2)
        if st.api == 2 and internal == 2
            ms_to_lr(mut st, mut b0, mut b1, pred, khz, fl)
        else
            b0[0] = st.smid[0]
            b0[1] = st.smid[1]
            st.smid = [b0[fl], b0[fl + 1]]
        for v3 in op_resample(mut st.mid.rs, b0[1..fl + 1])
            left.push(v3)
        if st.api == 2 and internal == 2
            for v4 in op_resample(mut st.side.rs, b1[1..fl + 1])
                right.push(v4)
        st.prev_mid_only = mid_only
    if st.api == 1
        return [left]
    if internal == 1
        return [left, left]
    [left, right]

## The Opus layer (RFC 6716 §4.5)

## An Opus decoder for `channels` output channels (std.opus.5): the CELT and
## SILK states and what the last frame was, for the crossinges between modes.
pub struct Stream
    channels int
    celt CeltState
    silk SilkState
    prev_mode int
    prev_redundancy bool

## A decoder for one stream (std.opus.5), giving 1 or 2 channels.
pub fn stream(channels int) Stream
    requires channels == 1 or channels == 2
    Stream(
        channels: channels,
        celt: celt_state(channels),
        silk: silk_state(channels),
        prev_mode: 0,
        prev_redundancy: false,
    )

## Modes as the crossinges compare them; 0 is "no frame yet".
SILK_ONLY := 1
HYBRID := 2
CELT_ONLY := 3

## A CELT frame for the stream's output channels: a mono frame feeds both
## channels, a stereo frame is averaged for one.
fn celt_out(mut st Stream, mut d RangeDecoder, c int, lm int, start int, end int) List[List[float]]
    pcm := celt_frame(mut st.celt, mut d, c, lm, start, end)
    if st.channels == c
        return pcm
    if st.channels == 2
        return [pcm[0], pcm[0]]
    [[0.5 * (pcm[0][i] + pcm[1][i]) for i in 0..pcm[0].len()]]

## One frame of `f` samples at 48 kHz in `mode` (RFC 6716 §4.5, libopus
## opus_decode_frame): the SILK layer, the CELT layer from band 17 in a
## hybrid frame, and the 5 ms redundant CELT frame that smooths a crossing.
fn opus_frame(mut st Stream, data bytes, mode int, pk Packet, c int) List[List[float]] ! OpusError
    f := pk.samples
    was := st.prev_mode
    from_silk := mode == CELT_ONLY and was != CELT_ONLY and not st.prev_redundancy
    crossing := was != 0 and (from_silk or (mode != CELT_ONLY and was == CELT_ONLY))
    mut d := decoder(data)
    mut ln := data.len()
    mut silk_pcm := List[List[int]]()
    if mode != CELT_ONLY
        if was == CELT_ONLY
            st.silk = silk_state(st.channels)
        khz := if mode == SILK_ONLY then [8, 12, 16][pk.config / 4] else 16
        silk_pcm = silk_decode(mut st.silk, mut d, c, khz, (f / 48).max(10))
    mut redundancy := false
    mut celt_to_silk := false
    mut red := 0
    extra := if mode == HYBRID then 20 else 0
    if mode != CELT_ONLY and d.tell() + 17 + extra <= 8 * ln
        redundancy = if mode == HYBRID then d.bit_logp(12) else true
        if redundancy
            celt_to_silk = d.bit_logp(1)
            red = if mode == HYBRID then d.uint(256) + 2 else ln - (d.tell() + 7).shr(3)
            ln -= red
            if ln * 8 < d.tell()
                return OpusError(why: "a redundant frame longer than its packet")
            d.shorten(red)
    if crossing and not redundancy
        return OpusError(why: "a crossing between CELT and SILK without a redundant frame")
    end := end_band(pk.bandwidth)
    mut red_audio := List[List[float]]()
    if redundancy and celt_to_silk
        mut rd := decoder(data[ln..ln + red])
        red_audio = celt_out(mut st, mut rd, c, 1, 0, end)
    mut pcm := List[List[float]]()
    if mode != SILK_ONLY
        if mode != was and was != 0 and not st.prev_redundancy
            st.celt = celt_state(st.channels)
        lm := match f
            120 => 0
            240 => 1
            480 => 2
            _ => 3
        start := if mode == HYBRID then 17 else 0
        pcm = celt_out(mut st, mut d, c, lm, start, end)
    else
        for _ in 0..st.channels
            pcm.push(zeros(f))
        if was == HYBRID and not (redundancy and celt_to_silk and st.prev_redundancy)
            mut sd := decoder(b"\xff\xff")
            quiet := celt_out(mut st, mut sd, c, 0, 0, end)
            for ch in 0..st.channels
                mut row := pcm[ch]
                for i in 0..120
                    row[i] += quiet[ch][i]
                pcm[ch] = row
    if mode != CELT_ONLY
        for ch2 in 0..st.channels
            mut row2 := pcm[ch2]
            for i2 in 0..f
                row2[i2] += silk_pcm[ch2][i2].to_float()
            pcm[ch2] = row2
    if redundancy and not celt_to_silk
        st.celt = celt_state(st.channels)
        mut rd2 := decoder(data[ln..ln + red])
        tail := celt_out(mut st, mut rd2, c, 1, 0, end)
        for ch3 in 0..st.channels
            mut row3 := pcm[ch3]
            for i3 in 0..120
                w := WINDOW[i3] * WINDOW[i3]
                at := f - 120 + i3
                row3[at] = w * tail[ch3][120 + i3] + (1.0 - w) * row3[at]
            pcm[ch3] = row3
    if redundancy and celt_to_silk and (was != SILK_ONLY or st.prev_redundancy)
        for ch4 in 0..st.channels
            mut row4 := pcm[ch4]
            for i4 in 0..120
                row4[i4] = red_audio[ch4][i4]
                w2 := WINDOW[i4] * WINDOW[i4]
                row4[120 + i4] = w2 * row4[120 + i4] + (1.0 - w2) * red_audio[ch4][120 + i4]
            pcm[ch4] = row4
    st.prev_mode = mode
    st.prev_redundancy = redundancy and not celt_to_silk
    pcm

## Decodes one Opus packet with `st` (std.opus.5): interleaved samples at
## 48 kHz in -1..1, `st.channels` per frame. CELT, SILK and hybrid frames
## all decode; a crossing between CELT and SILK fails unless the encoder sent
## the redundant frame that bridges it.
pub fn decode(mut st Stream, b bytes) audio.Clip ! OpusError
    pk := parse_packet(b) else e
        return e
    mode := match pk.mode
        Silk => SILK_ONLY
        Hybrid => HYBRID
        Celt => CELT_ONLY
    c := if pk.stereo then 2 else 1
    mut samples := List[float]()
    for frame in pk.frames
        pcm := opus_frame(mut st, frame, mode, pk, c) else e2
            return e2
        for i in 0..pk.samples
            for ch in 0..st.channels
                samples.push(pcm[ch][i] / 32768.0)
    audio.Clip(rate: 48000, channels: st.channels, samples: samples)
