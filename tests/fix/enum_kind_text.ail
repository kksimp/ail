fn describe(path str) str
    text := fs.read_text(path) else err
        if err.kind == "not_found"
            return "missing"
        return match err.kind
            "permission" => "locked"
            NotFound | Exists | IsDir | NotDir | NotEmpty | InvalidUtf8 | Other => "unreadable"
    text

fn main()
    print(describe("no-such-file.txt"))
