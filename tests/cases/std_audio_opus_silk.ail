fn check(name str, clip (int, List[str], List[int]))
    channels, packets, expected := clip
    mut st := opus.stream(channels)
    mut got := List[float]()
    for h in packets
        data := bytes.from_hex(h) else b""
        c := opus.decode(mut st, data) else err
            print("{name}: {err}")
            return
        got.extend(c.samples)
    mut bad := 0
    for i in 0..expected.len()
        v := (got[i * 53] * 32768.0).round().to_int().max(-32768).min(32767)
        if (v - expected[i]).abs() > 1
            bad += 1
    print("{name}: {got.len()} samples, {bad} of {expected.len()} off by more than 1")

fn main()
    check("silk_nb_mono", silk_nb_mono())
    check("silk_mb_mono", silk_mb_mono())
    check("silk_wb_10ms", silk_wb_10ms())
    check("silk_wb_60ms", silk_wb_60ms())
    check("silk_wb_stereo", silk_wb_stereo())
    check("silk_wb_stereo_from_24", silk_wb_stereo_from_24())
    check("hybrid_swb_mono_from_22", hybrid_swb_mono_from_22())
    check("hybrid_fb_stereo", hybrid_fb_stereo())
