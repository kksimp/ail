## http.serve.1-3: `req.stop()` ends the server after the answer, `serve_dir`
## gives files their types and refuses what is outside the directory, and a
## kept-alive client makes 100 requests quickly.
use std.net
use std.net.http
use std.fs
use std.time

fn echo(r net.Request) net.Response
    if r.path == "/stop"
        r.stop()
        return net.Response(status: 200, headers: {}, body: "bye")
    net.Response(status: 200, headers: {}, body: "hi {r.path}")

fn main() !
    # http.serve.1: the stopping request is still answered.
    srv := net.serve("127.0.0.1:0")?
    t := spawn http.run(srv, echo)
    base := "http://{srv.addr()}"
    print(net.get("{base}/a")?.body)
    start := time.now_ms()
    for i in 0..100
        net.get("{base}/{i}")?
    print("100 requests fast: {time.now_ms() - start < 500}")
    print(net.get("{base}/stop")?.body)
    t.wait()?
    print("server returned")

    # http.serve.2: static files.
    root := "http_serve_dir_case.tmp"
    fs.make_dir("{root}/sub")?
    fs.write_text("{root}/index.html", "<p>home</p>")?
    fs.write_text("{root}/sub/a.css", "a.css")?
    fs.write_text("{root}/data.bin", "x")?
    d := net.serve("127.0.0.1:0")?
    w := spawn http.run_dir(d, root)
    b := "http://{d.addr()}"
    for p in ["/", "/sub/a.css", "/data.bin", "/missing", "/sub/../x"]
        r := net.get("{b}{p}")?
        print("{p} {r.status} {r.headers.get("content-type") else "-"} {r.body}")
    h := net.request("POST", "{b}/", net.options())?
    print("POST {h.status}")
    d.close()
    w.wait()?
    for p in ["sub/a.css", "index.html", "data.bin", "sub", ""]
        fs.remove("{root}/{p}")?
