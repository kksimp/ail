## std.args.1-6: flags, options, positionals, help and errors.
use std.args

fn spec() List[args.Spec]
    [
        args.flag("verbose", "v", "more output"),
        args.opt("out", "o", "where to write", "a.txt"),
        args.pos("input", "file to read"),
        args.rest("more", "extra files"),
    ]

fn show(words List[str])
    a := args.parse("tool", "does things", spec(), words) else err
        print("error: {err.why}")
        return
    print("{a.flag("verbose")} {a.get("out")} {a.get("input")} {a.rest}")

## std.args.8: typed options, when given and a number.
fn numbers(words List[str])
    specs := [args.opt("n", "n", "a count", "7"), args.opt("f", "f", "a ratio", "2.5")]
    a := args.parse("tool", "does things", specs, words) else err
        print("error: {err.why}")
        return
    print("{a.opt_int("n")} {a.opt_int("f")} {a.opt_float("f")} {a.opt_float("n")}")

fn main()
    numbers(["--n", "5", "--f", "0.25"])
    numbers(["--n", "x"])
    numbers([])
    show(["in.txt"])
    show(["-v", "--out", "b.txt", "in.txt", "x", "y"])
    show(["--out=c.txt", "--", "-weird", "z"])
    show(["--nope", "in.txt"])
    show(["--out"])
    show([])
    print(args.usage("tool", "does things", spec()))
    # std.args.2 (ADR 1068): a spec's kind is an enum.
    print([s.kind == Flag or s.kind == Opt for s in spec()])
    print(args.rest("more", "x").kind == Rest)
