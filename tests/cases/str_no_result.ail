## err.str.4 (ADR 1135): `! str` is a `str` result with inferred errors. A bare
## `return`, or a body that ends with a statement, shows that no result was meant:
## one report at the signature, not one per `return` and branch.
struct Reader
    at int
    text str

fn Reader.expect_more(mut self) ! str
    if self.at >= self.text.len()
        return "end of input"
    self.at += 1
    return

fn check_name(s str) ! str
    if s.is_empty()
        return "empty name"
    print("ok {s}")

# The body ends in an `if` or a `match` whose branches are statements.
fn check_pair(a int, b int) ! str
    if a < 0
        return "negative"
    if a > b
        print("a is larger")
    else
        print("b is larger")

fn check_kind(k int) ! str
    match k
        0 => print("zero")
        _ => return "other"

fn main()
    mut r := Reader(at: 0, text: "1")
    print(r.expect_more() else "failed")
    print(check_name("a") else "failed")
    print(check_pair(1, 2) else "failed")
    print(check_kind(0) else "failed")
