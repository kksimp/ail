## std.jpeg.2, std.jpeg.4-6: the header, the EXIF orientation, turning an image and the
## failures. Pictures made by libjpeg-turbo (Pillow) and checked against Pillow's own
## decode and transposes. Synthetic pictures, no licence attached.
use std.image.jpeg

fn digest(b bytes) int
    mut h := 0
    for x in b
        h = (h * 31 + x.to_int()) % 1000000007
    h

fn fails(label str, data bytes)
    img := jpeg.decode(data) else err
        print("{label}: {err.kind.name()} {err}")
        return
    print("{label}: {img.width}x{img.height} {digest(img.pixels)}")

fn rotated() bytes
    bytes.from_hex([
        "ffd8ffe000104a46494600010100000100010000ffe100224578696600004d4d002a0000000800010112000300000001",
        "0006000000000000ffdb0043000302020302020303030304030304050805050404050a070706080c0a0c0c0b0a0b0b0d",
