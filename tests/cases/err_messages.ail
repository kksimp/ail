## err.msg.1-3: a message on an error type is its display text; it reads the
## fields by name.
error enum LoadError
    MissingEquals "missing '='"
    BadName(text str) "bad cell name '{text}'"
    BadPair(a int, b int) "bad pair {a}"

error struct ParseError "parse error at {line}:{col}: {msg}"
    line int
    col int
    msg str

fn load(n int) !int
    if n == 0
        return BadName(text: "zz")
    if n == 1
        return ParseError(line: 1, col: 2, msg: "oops")
    n

fn main() !
    print(LoadError.MissingEquals)
    print("{LoadError.BadPair(a: 1, b: 2)}")
    x := load(1) else err
        print("got: {err}")
        0
    y := load(0) else err
        print("failed: {err}")
        0
    print(x + y)
