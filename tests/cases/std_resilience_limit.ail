## std.resilience.1 to std.resilience.7: token bucket and sliding window.
use std.time

fn grab(b resilience.Bucket, n int) int
    mut got := 0
    for i in 0..n
        if b.try_take(1)
            got += 1
    got

fn main()
    # a slow bucket: refill is negligible during the test
    b := resilience.token_bucket(1, 60000, 3)
    print("{b.try_take(1)} {b.try_take(1)} {b.try_take(1)} {b.try_take(1)}")
    print("available {b.available()}")
    w := b.wait_ms(1)
    print("wait in range {w > 58000 and w <= 60000}")
    print("bad sizes {b.try_take(0)} {b.try_take(4)}")

    # four tasks share one bucket: exactly the burst is granted
    shared := resilience.token_bucket(1, 60000, 10)
    g := TaskGroup[int]()
    for i in 0..4
        g.add(spawn grab(shared, 5))
    total := g.wait_all() else
        print("a task trapped")
        return
    print("granted {total.sum()}")

    # a fast bucket refills, up to the burst
    f := resilience.token_bucket(1000, 1000, 5)
    print("full {f.try_take(5)} {f.try_take(1)}")
    time.sleep_ms(20)
    print("refilled to burst {f.available()}")

    # take waits for tokens: 1 token per 10 ms
    slow := resilience.token_bucket(1, 10, 2)
    slow.take(2)
    start := time.mono_ns()
    slow.take(1)
    print("waited {time.since_ms(start) >= 9}")

    # sliding window
    win := resilience.window_limiter(3, 60000)
    print("{win.try_acquire()} {win.try_acquire()} {win.try_acquire()} {win.try_acquire()}")
    r := win.retry_after_ms()
    print("retry in range {r > 58000 and r <= 60000}")
    short := resilience.window_limiter(2, 40)
    print("{short.try_acquire()} {short.try_acquire()} {short.try_acquire()}")
    time.sleep_ms(60)
    print("reopened {short.try_acquire()} {short.retry_after_ms() > 0}")
    one := resilience.window_limiter(1, 30)
    one.acquire()
    t2 := time.mono_ns()
    one.acquire()
    print("acquire waited {time.since_ms(t2) >= 29}")
