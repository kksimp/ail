## std.app.13: an app asks the host for text widths and gets them back before
## its next view is sent.
use std.app

struct Meter
    words List[str]
    widths Map[str, float]

impl app.App for Meter
    fn update(mut self, ev app.Event)
        return

    fn view(self) app.Node
        mut parts := List[str]()
        for w in words
            parts.push("{w}={widths.get(w) else -1.0}")
        Label(parts.join(" "))

    fn measures(self) List[app.Measure]
        mut out := List[app.Measure]()
        for w in words
            if not widths.contains(w)
                out.push(app.Measure(text: w, font: "sans", size: 10.0, bold: false, italic: false))
        out

    fn measured(mut self, runs List[app.Measure], ws List[float])
        for k in 0..runs.len()
            widths[runs[k].text] = ws[k]

fn main() !
    mut m := Meter(words: ["ab", "cdef"], widths: {})
    host := "tests/app/measure_host.ail"
    ail := env.get("AIL") else "ail"
    app.run_host(mut m, ail, ["run", host])?
    print(app.outline(m.view()))
