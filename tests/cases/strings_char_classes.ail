# type.char.2: is_digit (ASCII only), is_alpha, is_alnum, is_space, is_upper, is_lower.
# Each line: code point, then digit alpha alnum space upper lower as 0/1.
fn b(x bool) str
    if x
        "1"
    else
        "0"

fn row(c char)
    print("{c.code().to_hex()} {b(c.is_digit())}{b(c.is_alpha())}{b(c.is_alnum())}{b(c.is_space())}{b(c.is_upper())}{b(c.is_lower())}")

fn main()
    row('\u{61}')
    row('\u{5a}')
    row('\u{35}')
    row('\u{663}')
    row('\u{ff15}')
