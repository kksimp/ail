## std.html.1-11: cases of the html5lib tree-construction suite (github.com/html5lib/html5lib-tests, MIT) read
## as whole documents. `dump` writes the tree in the suite's format, so each expected text is the suite's own.
## A line is `<file> <index> ok` when `html.parse` gives that tree. The subset leaves out the cases of the
## limits in std.html.11 (adoption agency, svg and math, template, frameset, noscript in head).
use std.html

fn dump(n Node, depth int, mut out List[str])
    pad := "| {"  ".repeat(depth)}"
    match n
        Node.Text(c) => out.push("{pad}\"{c}\"")
        Node.Comment(c) => out.push("{pad}<!-- {c} -->")
        Node.Elem(tag, attrs, kids) =>
            out.push("{pad}<{tag}>")
            mut lines := List[str]()
            for a in attrs
                lines.push("{pad}  {a.name}=\"{a.value}\"")
            for l in lines.sorted()
                out.push(l)
            for k in kids
                dump(k, depth + 1, mut out)

fn check(id str, src str, want str)
    mut out := List[str]()
    dump(html.parse(src), 0, mut out)
    got := out.join("\n")
    if got == want
        print("{id} ok")
    else
        print("{id} FAIL")
        print(got)

fn main()
    check("comments01 11", "<?xml version=\"1.0\">Hi", "| <html>\n|   <head>\n|   <body>\n|     \"Hi\"")
    check("comments01 12", "<?xml version=\"1.0\">", "| <html>\n|   <head>\n|   <body>")
