fn invalid_2() List[Case]
    [
        Case("Y79Y/003", "- [\n\tfoo,\n foo\n ]\n", ""),
        Case("Y79Y/004", "-\t-\n", ""),
        Case("Y79Y/005", "- \t-\n", ""),
        Case("Y79Y/006", "?\t-\n", ""),
        Case("Y79Y/007", "? -\n:\t-\n", ""),
        Case("Y79Y/008", "?\tkey:\n", ""),
        Case("Y79Y/009", "? key:\n:\tkey:\n", ""),
        Case("YJV2", "[-]\n", ""),
        Case("ZCZ6", "a: b: c: d\n", ""),
        Case("ZL4Z", "---\na: 'b': c\n", ""),
        Case("ZVH3", "- key: value\n - item1\n", ""),
        Case("ZXT5", "[ \"key\"\n  :value ]\n", ""),
    ]

fn main()
    mut inside := List[Case]()
    for c in strict_0()
        inside.push(c)
    for c in strict_1()
        inside.push(c)
    for c in strict_2()
        inside.push(c)
    for c in strict_3()
        inside.push(c)
    mut outside := List[Case]()
    for c in lenient_0()
        outside.push(c)
    for c in lenient_1()
        outside.push(c)
    for c in lenient_2()
        outside.push(c)
    for c in lenient_3()
        outside.push(c)
    mut invalid := List[Case]()
    for c in invalid_0()
        invalid.push(c)
    for c in invalid_1()
        invalid.push(c)
    for c in invalid_2()
        invalid.push(c)
    mut failed := 0
    mut inside_bad := 0
    for c in inside
        if not check_strict(c)
            inside_bad += 1
    print("yaml-test-suite {inside.len() - inside_bad}/{inside.len()} cases in the subset read as the suite says")
    failed += inside_bad
    mut outside_bad := 0
    for c in outside
        if not check_lenient(c)
            outside_bad += 1
    print("yaml-test-suite {outside.len() - outside_bad}/{outside.len()} valid cases outside the subset refused or read exactly")
    failed += outside_bad
    mut invalid_bad := 0
    for c in invalid
        if not check_invalid(c)
            invalid_bad += 1
    print("yaml-test-suite {invalid.len() - invalid_bad}/{invalid.len()} invalid cases refused")
    failed += invalid_bad
    if failed > 0
        print("{failed} cases failed")
