        Case("735Y", "-\n  \"flow in block\"\n- >\n Block scalar\n- !!map # Block collection\n  foo : bar\n", "[\"flow in block\",\"Block scalar\\n\",\{\"foo\":\"bar\"}]"),
        Case("74H7", "!!str a: b\nc: !!int 42\ne: !!str f\ng: h\n!!str 23: !!bool false\n", "\{\"a\":\"b\",\"c\":42,\"e\":\"f\",\"g\":\"h\",\"23\":false}"),
