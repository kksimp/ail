## std.yaml against yaml-test-suite: the cases inside the subset (std.yaml.7) read as the
## suite's JSON, valid YAML outside it is refused or read exactly, and invalid YAML is refused.
## The cases are the suite's files verbatim; tools/conformance/gen_suite_tests.py writes this
## file. yaml-test-suite is MIT licensed (NOTICE).
## Known gaps, invalid documents std.yaml still reads: CML9 (a comment between two words of a flow
## entry) and Y79Y/000 (a tab-only line after a block scalar header); neither is in a list.
use std.yaml

## A case: its id, the YAML text and the suite's JSON ("" when it has none to compare).
struct Case
    name str
    src str
    want str

## The text of the document `c` reads as, or "" when std.yaml refuses it.
fn reads(c Case) str
    doc := yaml.parse(c.src) else return ""
    doc.to_text()

fn expected(c Case) str
    j := parse_json(c.want) else return ""
    j.to_text()

fn check_strict(c Case) bool
    got := reads(c)
    if got == "" or got != expected(c)
        print("FAIL strict {c.name}: read as {got}")
        return false
    true

fn check_lenient(c Case) bool
    got := reads(c)
    if got != "" and got != expected(c)
        print("FAIL lenient {c.name}: read as {got}")
        return false
    true

fn check_invalid(c Case) bool
    got := reads(c)
    if got != ""
        print("FAIL invalid {c.name}: accepted as {got}")
        return false
    true

fn strict_0() List[Case]
    [
        Case(
            name: "229Q",
            src: "-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n",
            want: "[\{\"name\":\"Mark McGwire\",\"hr\":65,\"avg\":0.278},\{\"name\":\"Sammy Sosa\",\"hr\":63,\"avg\":0.288}]",
        ),
        Case(
            name: "2EBW",
            src: "a!\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|}~: safe\n?foo: safe question mark\n:foo: safe colon\n-foo: safe dash\nthis is#not: a comment\n",
            want: "\{\"a!\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|}~\":\"safe\",\"?foo\":\"safe question mark\",\":foo\":\"safe colon\",\"-foo\":\"safe dash\",\"this is#not\":\"a comment\"}",
        ),
        Case(
            name: "3ALJ",
            src: "- - s1_i1\n  - s1_i2\n- s2\n",
            want: "[[\"s1_i1\",\"s1_i2\"],\"s2\"]",
        ),
        Case(name: "3UYS", src: "escaped slash: \"a\\/b\"\n", want: "\{\"escaped slash\":\"a/b\"}"),
        Case(name: "4GC6", src: "'here''s to \"quotes\"'\n", want: "\"here's to \\\"quotes\\\"\""),
        Case(name: "4MUZ/00", src: "\{\"foo\"\n: \"bar\"}\n", want: "\{\"foo\":\"bar\"}"),
        Case(name: "4MUZ/01", src: "\{\"foo\"\n: bar}\n", want: "\{\"foo\":\"bar\"}"),
        Case(name: "4MUZ/02", src: "\{foo\n: bar}\n", want: "\{\"foo\":\"bar\"}"),
        Case(name: "4RWC", src: "  [1, 2, 3]  \n  ", want: "[1,2,3]"),
        Case(name: "4UYU", src: "\"foo: bar\\\": baz\"\n", want: "\"foo: bar\\\": baz\""),
        Case(
            name: "4V8U",
            src: "---\nplain\\value\\with\\backslashes\n",
            want: "\"plain\\\\value\\\\with\\\\backslashes\"",
        ),
        Case(
            name: "54T7",
            src: "\{foo: you, bar: far}\n",
            want: "\{\"foo\":\"you\",\"bar\":\"far\"}",
        ),
        Case(name: "58MP", src: "\{x: :x}\n", want: "\{\"x\":\":x\"}"),
        Case(
            name: "5BVJ",
            src: "literal: |\n  some\n  text\nfolded: >\n  some\n  text\n",
            want: "\{\"literal\":\"some\\ntext\\n\",\"folded\":\"some text\\n\"}",
        ),
        Case(
            name: "5C5M",
            src: "- \{ one : two , three: four , }\n- \{five: six,seven : eight}\n",
            want: "[\{\"one\":\"two\",\"three\":\"four\"},\{\"five\":\"six\",\"seven\":\"eight\"}]",
        ),
        Case(
            name: "5KJE",
            src: "- [ one, two, ]\n- [three ,four]\n",
            want: "[[\"one\",\"two\"],[\"three\",\"four\"]]",
        ),
        Case(name: "5MUD", src: "---\n\{ \"foo\"\n  :bar }\n", want: "\{\"foo\":\"bar\"}"),
        Case(name: "5NYZ", src: "key:    # Comment\n  value\n", want: "\{\"key\":\"value\"}"),
        Case(
            name: "5T43",
            src: "- \{ \"key\":value }\n- \{ \"key\"::value }\n",
            want: "[\{\"key\":\"value\"},\{\"key\":\":value\"}]",
        ),
        Case(
            name: "652Z",
            src: "\{ ?foo: bar,\nbar: 42\n}\n",
            want: "\{\"?foo\":\"bar\",\"bar\":42}",
        ),
        Case(name: "65WH", src: "- foo\n", want: "[\"foo\"]"),
        Case(
            name: "6BCT",
            src: "- foo:\t bar\n- - baz\n  -\tbaz\n",
            want: "[\{\"foo\":\"bar\"},[\"baz\",\"baz\"]]",
        ),
        Case(name: "6H3V", src: "'foo: bar\\': baz'\n", want: "\{\"foo: bar\\\\\":\"baz'\"}"),
        Case(
            name: "6HB6",
            src: "  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.\n",
            want: "\{\"Not indented\":\{\"By one space\":\"By four\\n  spaces\\n\",\"Flow style\":[\"By two\",\"Also by two\",\"Still by two\"]}}",
        ),
        Case(
            name: "6SLA",
            src: "\"foo\\nbar:baz\\tx \\\\$%^&*()x\": 23\n'x\\ny:z\\tx $%^&*()x': 24\n",
            want: "\{\"foo\\nbar:baz\\tx \\\\$%^&*()x\":23,\"x\\\\ny:z\\\\tx $%^&*()x\":24}",
        ),
        Case(
            name: "6VJK",
            src: ">\n Sammy Sosa completed another\n fine season with great stats.\n\n   63 Home Runs\n   0.288 Batting Average\n\n What a year!\n",
            want: "\"Sammy Sosa completed another fine season with great stats.\\n\\n  63 Home Runs\\n  0.288 Batting Average\\n\\nWhat a year!\\n\"",
        ),
        Case(
            name: "7T8X",
            src: ">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n",
            want: "\"\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\"",
        ),
        Case(
            name: "7TMG",
            src: "---\n[ word1\n# comment\n, word2]\n",
            want: "[\"word1\",\"word2\"]",
        ),
        Case(
            name: "7ZZ5",
            src: "---\nnested sequences:\n- - - []\n- - - \{}\nkey1: []\nkey2: \{}\n",
            want: "\{\"nested sequences\":[[[[]]],[[\{}]]],\"key1\":[],\"key2\":\{}}",
        ),
        Case(
            name: "8CWC",
            src: "---\nkey ends with two colons::: value\n",
            want: "\{\"key ends with two colons::\":\"value\"}",
        ),
        Case(name: "8G76", src: "  # Comment\n   \n\n\n", want: "null"),
        Case(
            name: "8KB6",
            src: "---\n- \{ single line, a: b}\n- \{ multi\n  line, a: b}\n",
            want: "[\{\"single line\":null,\"a\":\"b\"},\{\"multi line\":null,\"a\":\"b\"}]",
        ),
        Case(
            name: "8QBE",
            src: "key:\n - item1\n - item2\n",
            want: "\{\"key\":[\"item1\",\"item2\"]}",
        ),
        Case(
            name: "93JH",
            src: " - key: value\n   key2: value2\n -\n   key3: value3\n",
            want: "[\{\"key\":\"value\",\"key2\":\"value2\"},\{\"key3\":\"value3\"}]",
        ),
        Case(name: "96NN/00", src: "foo: |-\n \tbar\n", want: "\{\"foo\":\"\\tbar\"}"),
        Case(name: "96NN/01", src: "foo: |-\n \tbar", want: "\{\"foo\":\"\\tbar\"}"),
        Case(name: "98YD", src: "# Comment only.\n", want: "null"),
        Case(
            name: "9BXH",
            src: "---\n- \{ \"single line\", a: b}\n- \{ \"multi\n  line\", a: b}\n",
            want: "[\{\"single line\":null,\"a\":\"b\"},\{\"multi line\":null,\"a\":\"b\"}]",
        ),
        Case(
            name: "9FMG",
            src: "a:\n  b:\n    c: d\n  e:\n    f: g\nh: i\n",
            want: "\{\"a\":\{\"b\":\{\"c\":\"d\"},\"e\":\{\"f\":\"g\"}},\"h\":\"i\"}",
        ),
        Case(name: "9J7A", src: "foo:\n  bar: baz\n", want: "\{\"foo\":\{\"bar\":\"baz\"}}"),
    ]

fn strict_1() List[Case]
    [
        Case(
            name: "9SA2",
            src: "---\n- \{ \"single line\": value}\n- \{ \"multi\n  line\": value}\n",
            want: "[\{\"single line\":\"value\"},\{\"multi line\":\"value\"}]",
        ),
        Case(
            name: "9SHH",
            src: "single: 'text'\ndouble: \"text\"\n",
            want: "\{\"single\":\"text\",\"double\":\"text\"}",
        ),
        Case(
            name: "9U5K",
            src: "---\n# Products purchased\n- item    : Super Hoop\n  quantity: 1\n- item    : Basketball\n  quantity: 4\n- item    : Big Shoes\n  quantity: 1\n",
            want: "[\{\"item\":\"Super Hoop\",\"quantity\":1},\{\"item\":\"Basketball\",\"quantity\":4},\{\"item\":\"Big Shoes\",\"quantity\":1}]",
        ),
        Case(
            name: "A6F9",
            src: "strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n",
            want: "\{\"strip\":\"text\",\"clip\":\"text\\n\",\"keep\":\"text\\n\"}",
        ),
        Case(name: "AVM7", src: "", want: "null"),
        Case(name: "AZ63", src: "one:\n- 2\n- 3\nfour: 5\n", want: "\{\"one\":[2,3],\"four\":5}"),
        Case(
            name: "AZW3",
            src: "- bla\"keks: foo\n- bla]keks: foo\n",
            want: "[\{\"bla\\\"keks\":\"foo\"},\{\"bla]keks\":\"foo\"}]",
        ),
        Case(
            name: "C2DT",
            src: "\{\n\"adjacent\":value,\n\"readable\": value,\n\"empty\":\n}\n",
            want: "\{\"adjacent\":\"value\",\"readable\":\"value\",\"empty\":null}",
        ),
        Case(name: "CPZ3", src: "---\ntab: \"\\tstring\"\n", want: "\{\"tab\":\"\\tstring\"}"),
        Case(name: "D88J", src: "a: [b, c]\n", want: "\{\"a\":[\"b\",\"c\"]}"),
        Case(name: "D9TU", src: "foo: bar\n", want: "\{\"foo\":\"bar\"}"),
        Case(
            name: "DBG4",
            src: "# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up and away!\",\n  -123,\n  http://example.com/foo#bar ]\n",
            want: "[\"::vector\",\": - ()\",\"Up, up, and away!\",-123,\"http://example.com/foo#bar\",[\"::vector\",\": - ()\",\"Up, up and away!\",-123,\"http://example.com/foo#bar\"]]",
        ),
        Case(
            name: "DC7X",
            src: "a: b\t\nseq:\t\n - a\t\nc: d\t#X\n",
            want: "\{\"a\":\"b\",\"seq\":[\"a\"],\"c\":\"d\"}",
        ),
        Case(name: "DHP8", src: "[foo, bar, 42]\n", want: "[\"foo\",\"bar\",42]"),
        Case(name: "DK95/03", src: " \t\nfoo: 1\n", want: "\{\"foo\":1}"),
        Case(name: "DK95/04", src: "foo: 1\n\t\nbar: 2\n", want: "\{\"foo\":1,\"bar\":2}"),
        Case(name: "DK95/05", src: "foo: 1\n \t\nbar: 2\n", want: "\{\"foo\":1,\"bar\":2}"),
        Case(
            name: "DWX9",
            src: "|\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n",
            want: "\"\\n\\nliteral\\n \\n\\ntext\\n\"",
        ),
        Case(
            name: "F3CP",
            src: "---\n\{ a: [b, c, \{ d: [e, f] } ] }\n",
            want: "\{\"a\":[\"b\",\"c\",\{\"d\":[\"e\",\"f\"]}]}",
        ),
        Case(
            name: "F8F9",
            src: " # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n",
            want: "\{\"strip\":\"# text\",\"clip\":\"# text\\n\",\"keep\":\"# text\\n\\n\"}",
        ),
        Case(
            name: "FQ7F",
            src: "- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n",
            want: "[\"Mark McGwire\",\"Sammy Sosa\",\"Ken Griffey\"]",
        ),
        Case(name: "FUP4", src: "[a, [b, c]]\n", want: "[\"a\",[\"b\",\"c\"]]"),
        Case(
            name: "G4RS",
            src: "unicode: \"Sosa did fine.\\u263A\"\ncontrol: \"\\b1998\\t1999\\t2000\\n\"\nhex esc: \"\\x0d\\x0a is \\r\\n\"\n\nsingle: '\"Howdy!\" he cried.'\nquoted: ' # Not a ''comment''.'\ntie-fighter: '|\\-*-/|'\n",
            want: "\{\"unicode\":\"Sosa did fine.☺\",\"control\":\"\\b1998\\t1999\\t2000\\n\",\"hex esc\":\"\\r\\n is \\r\\n\",\"single\":\"\\\"Howdy!\\\" he cried.\",\"quoted\":\" # Not a 'comment'.\",\"tie-fighter\":\"|\\\\-*-/|\"}",
        ),
        Case(name: "G992", src: ">\n folded\n text\n\n\n", want: "\"folded text\\n\""),
        Case(
            name: "H2RW",
            src: "foo: 1\n\nbar: 2\n    \ntext: |\n  a\n    \n  b\n\n  c\n \n  d\n",
            want: "\{\"foo\":1,\"bar\":2,\"text\":\"a\\n  \\nb\\n\\nc\\n\\nd\\n\"}",
        ),
        Case(
            name: "H3Z8",
            src: "---\nwanted: love ♥ and peace ☮\n",
            want: "\{\"wanted\":\"love ♥ and peace ☮\"}",
        ),
        Case(name: "HM87/00", src: "[:x]\n", want: "[\":x\"]"),
        Case(name: "HM87/01", src: "[?x]\n", want: "[\"?x\"]"),
        Case(
            name: "HMK4",
            src: "name: Mark McGwire\naccomplishment: >\n  Mark set a major league\n  home run record in 1998.\nstats: |\n  65 Home Runs\n  0.278 Batting Average\n",
            want: "\{\"name\":\"Mark McGwire\",\"accomplishment\":\"Mark set a major league home run record in 1998.\\n\",\"stats\":\"65 Home Runs\\n0.278 Batting Average\\n\"}",
        ),
        Case(name: "HWV9", src: "...\n", want: "null"),
        Case(
            name: "J3BT",
            src: "# Tabs and spaces\nquoted: \"Quoted \t\"\nblock:\t|\n  void main() \{\n  \tprintf(\"Hello, world!\\n\");\n  }\n",
            want: "\{\"quoted\":\"Quoted \\t\",\"block\":\"void main() \{\\n\\tprintf(\\\"Hello, world!\\\\n\\\");\\n}\\n\"}",
        ),
        Case(
            name: "J5UC",
            src: "foo: blue\nbar: arrr\nbaz: jazz\n",
            want: "\{\"foo\":\"blue\",\"bar\":\"arrr\",\"baz\":\"jazz\"}",
        ),
        Case(name: "J7VC", src: "one: 2\n\n\nthree: 4\n", want: "\{\"one\":2,\"three\":4}"),
        Case(
            name: "J9HZ",
            src: "---\nhr: # 1998 hr ranking\n  - Mark McGwire\n  - Sammy Sosa\nrbi:\n  # 1998 rbi ranking\n  - Sammy Sosa\n  - Ken Griffey\n",
            want: "\{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}",
        ),
        Case(name: "JEF9/00", src: "- |+\n\n\n", want: "[\"\\n\\n\"]"),
        Case(name: "JEF9/01", src: "- |+\n   \n", want: "[\"\\n\"]"),
        Case(name: "JEF9/02", src: "- |+\n   ", want: "[\"\\n\"]"),
        Case(
            name: "JQ4R",
            src: "block sequence:\n  - one\n  - two : three\n",
            want: "\{\"block sequence\":[\"one\",\{\"two\":\"three\"}]}",
        ),
        Case(
            name: "JR7V",
            src: "- a?string\n- another ? string\n- key: value?\n- [a?string]\n- [another ? string]\n- \{key: value? }\n- \{key: value?}\n- \{key?: value }\n",
            want: "[\"a?string\",\"another ? string\",\{\"key\":\"value?\"},[\"a?string\"],[\"another ? string\"],\{\"key\":\"value?\"},\{\"key\":\"value?\"},\{\"key?\":\"value\"}]",
        ),
        Case(name: "K3WX", src: "---\n\{ \"foo\" # comment\n  :bar }\n", want: "\{\"foo\":\"bar\"}"),
    ]

fn strict_2() List[Case]
    [
        Case(name: "K4SU", src: "- foo\n- bar\n- 42\n", want: "[\"foo\",\"bar\",42]"),
        Case(
            name: "K527",
            src: ">-\n  trimmed\n  \n \n\n  as\n  space\n",
            want: "\"trimmed\\n\\n\\nas space\"",
        ),
        Case(
            name: "K858",
            src: "strip: >-\n\nclip: >\n\nkeep: |+\n\n",
            want: "\{\"strip\":\"\",\"clip\":\"\",\"keep\":\"\\n\"}",
        ),
        Case(name: "KH5V/00", src: "\"1 inline\\ttab\"\n", want: "\"1 inline\\ttab\""),
        Case(name: "KH5V/02", src: "\"3 inline\ttab\"\n", want: "\"3 inline\\ttab\""),
        Case(
            name: "KMK3",
            src: "foo:\n  bar: 1\nbaz: 2\n",
            want: "\{\"foo\":\{\"bar\":1},\"baz\":2}",
        ),
        Case(name: "L24T/00", src: "foo: |\n  x\n   \n", want: "\{\"foo\":\"x\\n \\n\"}"),
        Case(name: "L24T/01", src: "foo: |\n  x\n   ", want: "\{\"foo\":\"x\\n \\n\"}"),
        Case(
            name: "LP6E",
            src: "- [a, b , c ]\n- \{ \"a\"  : b\n   , c : 'd' ,\n   e   : \"f\"\n  }\n- [      ]\n",
            want: "[[\"a\",\"b\",\"c\"],\{\"a\":\"b\",\"c\":\"d\",\"e\":\"f\"},[]]",
        ),
        Case(
            name: "M29M",
            src: "a: |\n ab\n \n cd\n ef\n \n\n...\n",
            want: "\{\"a\":\"ab\\n\\ncd\\nef\\n\"}",
        ),
        Case(
            name: "M6YH",
            src: "- |\n x\n-\n foo: bar\n-\n - 42\n",
            want: "[\"x\\n\",\{\"foo\":\"bar\"},[42]]",
        ),
        Case(
            name: "M7NX",
            src: "---\n\{\n a: [\n  b, c, \{\n   d: [e, f]\n  }\n ]\n}\n",
            want: "\{\"a\":[\"b\",\"c\",\{\"d\":[\"e\",\"f\"]}]}",
        ),
        Case(name: "M9B4", src: "|\n literal\n \ttext\n\n\n", want: "\"literal\\n\\ttext\\n\""),
        Case(
            name: "MJS9",
            src: ">\n  foo \n \n  \t bar\n\n  baz\n",
            want: "\"foo \\n\\n\\t bar\\n\\nbaz\\n\"",
        ),
        Case(name: "MXS3", src: "- \{a: b}\n", want: "[\{\"a\":\"b\"}]"),
        Case(name: "MYW6", src: "|-\n ab\n \n \n...\n", want: "\"ab\""),
        Case(
            name: "MZX3",
            src: "- plain\n- \"double quoted\"\n- 'single quoted'\n- >\n  block\n- plain again\n",
            want: "[\"plain\",\"double quoted\",\"single quoted\",\"block\\n\",\"plain again\"]",
        ),
        Case(
            name: "NJ66",
            src: "---\n- \{ single line: value}\n- \{ multi\n  line: value}\n",
            want: "[\{\"single line\":\"value\"},\{\"multi line\":\"value\"}]",
        ),
        Case(
            name: "P94K",
            src: "key:    # Comment\n        # lines\n  value\n\n\n",
            want: "\{\"key\":\"value\"}",
        ),
        Case(
            name: "PBJ2",
            src: "american:\n  - Boston Red Sox\n  - Detroit Tigers\n  - New York Yankees\nnational:\n  - New York Mets\n  - Chicago Cubs\n  - Atlanta Braves\n",
            want: "\{\"american\":[\"Boston Red Sox\",\"Detroit Tigers\",\"New York Yankees\"],\"national\":[\"New York Mets\",\"Chicago Cubs\",\"Atlanta Braves\"]}",
        ),
        Case(
            name: "Q88A",
            src: "- [ a, b ]\n- \{ a: b }\n- \"a\"\n- 'b'\n- c\n",
            want: "[[\"a\",\"b\"],\{\"a\":\"b\"},\"a\",\"b\",\"c\"]",
