## std.yaml against yaml-test-suite: the cases inside the subset (std.yaml.7) read as the
## suite's JSON, valid YAML outside it is refused or read exactly, and invalid YAML is refused.
## The cases are the suite's files verbatim; tools/conformance/gen_suite_tests.py writes this
## file. yaml-test-suite is MIT licensed (NOTICE).
## Known gaps, invalid documents std.yaml still reads: CML9 (a comment between two words of a flow
## entry) and Y79Y/000 (a tab-only line after a block scalar header); neither is in a list.
use std.yaml

## A case: its id, the YAML text and the suite's JSON ("" when it has none to compare).
struct Case
    name str
    src str
    want str

## The text of the document `c` reads as, or "" when std.yaml refuses it.
fn reads(c Case) str
    doc := yaml.parse(c.src) else return ""
    doc.to_text()

fn expected(c Case) str
    j := parse_json(c.want) else return ""
    j.to_text()

fn check_strict(c Case) bool
    got := reads(c)
    if got == "" or got != expected(c)
        print("FAIL strict {c.name}: read as {got}")
        return false
    true

fn check_lenient(c Case) bool
    got := reads(c)
    if got != "" and got != expected(c)
        print("FAIL lenient {c.name}: read as {got}")
        return false
    true

fn check_invalid(c Case) bool
    got := reads(c)
    if got != ""
        print("FAIL invalid {c.name}: accepted as {got}")
        return false
    true

fn strict_0() List[Case]
    [
        Case("229Q", "-\n  name: Mark McGwire\n  hr:   65\n  avg:  0.278\n-\n  name: Sammy Sosa\n  hr:   63\n  avg:  0.288\n", "[\{\"name\":\"Mark McGwire\",\"hr\":65,\"avg\":0.278},\{\"name\":\"Sammy Sosa\",\"hr\":63,\"avg\":0.288}]"),
        Case("2EBW", "a!\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|}~: safe\n?foo: safe question mark\n:foo: safe colon\n-foo: safe dash\nthis is#not: a comment\n", "\{\"a!\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|}~\":\"safe\",\"?foo\":\"safe question mark\",\":foo\":\"safe colon\",\"-foo\":\"safe dash\",\"this is#not\":\"a comment\"}"),
        Case("3ALJ", "- - s1_i1\n  - s1_i2\n- s2\n", "[[\"s1_i1\",\"s1_i2\"],\"s2\"]"),
        Case("3UYS", "escaped slash: \"a\\/b\"\n", "\{\"escaped slash\":\"a/b\"}"),
        Case("4GC6", "'here''s to \"quotes\"'\n", "\"here's to \\\"quotes\\\"\""),
        Case("4MUZ/00", "\{\"foo\"\n: \"bar\"}\n", "\{\"foo\":\"bar\"}"),
        Case("4MUZ/01", "\{\"foo\"\n: bar}\n", "\{\"foo\":\"bar\"}"),
        Case("4MUZ/02", "\{foo\n: bar}\n", "\{\"foo\":\"bar\"}"),
        Case("4RWC", "  [1, 2, 3]  \n  ", "[1,2,3]"),
        Case("4UYU", "\"foo: bar\\\": baz\"\n", "\"foo: bar\\\": baz\""),
        Case("4V8U", "---\nplain\\value\\with\\backslashes\n", "\"plain\\\\value\\\\with\\\\backslashes\""),
        Case("54T7", "\{foo: you, bar: far}\n", "\{\"foo\":\"you\",\"bar\":\"far\"}"),
        Case("58MP", "\{x: :x}\n", "\{\"x\":\":x\"}"),
        Case("5BVJ", "literal: |\n  some\n  text\nfolded: >\n  some\n  text\n", "\{\"literal\":\"some\\ntext\\n\",\"folded\":\"some text\\n\"}"),
        Case("5C5M", "- \{ one : two , three: four , }\n- \{five: six,seven : eight}\n", "[\{\"one\":\"two\",\"three\":\"four\"},\{\"five\":\"six\",\"seven\":\"eight\"}]"),
        Case("5KJE", "- [ one, two, ]\n- [three ,four]\n", "[[\"one\",\"two\"],[\"three\",\"four\"]]"),
        Case("5MUD", "---\n\{ \"foo\"\n  :bar }\n", "\{\"foo\":\"bar\"}"),
        Case("5NYZ", "key:    # Comment\n  value\n", "\{\"key\":\"value\"}"),
        Case("5T43", "- \{ \"key\":value }\n- \{ \"key\"::value }\n", "[\{\"key\":\"value\"},\{\"key\":\":value\"}]"),
        Case("652Z", "\{ ?foo: bar,\nbar: 42\n}\n", "\{\"?foo\":\"bar\",\"bar\":42}"),
        Case("65WH", "- foo\n", "[\"foo\"]"),
        Case("6BCT", "- foo:\t bar\n- - baz\n  -\tbaz\n", "[\{\"foo\":\"bar\"},[\"baz\",\"baz\"]]"),
        Case("6H3V", "'foo: bar\\': baz'\n", "\{\"foo: bar\\\\\":\"baz'\"}"),
        Case("6HB6", "  # Leading comment line spaces are\n   # neither content nor indentation.\n    \nNot indented:\n By one space: |\n    By four\n      spaces\n Flow style: [    # Leading spaces\n   By two,        # in flow style\n  Also by two,    # are neither\n  \tStill by two   # content nor\n    ]             # indentation.\n", "\{\"Not indented\":\{\"By one space\":\"By four\\n  spaces\\n\",\"Flow style\":[\"By two\",\"Also by two\",\"Still by two\"]}}"),
        Case("6SLA", "\"foo\\nbar:baz\\tx \\\\$%^&*()x\": 23\n'x\\ny:z\\tx $%^&*()x': 24\n", "\{\"foo\\nbar:baz\\tx \\\\$%^&*()x\":23,\"x\\\\ny:z\\\\tx $%^&*()x\":24}"),
        Case("6VJK", ">\n Sammy Sosa completed another\n fine season with great stats.\n\n   63 Home Runs\n   0.288 Batting Average\n\n What a year!\n", "\"Sammy Sosa completed another fine season with great stats.\\n\\n  63 Home Runs\\n  0.288 Batting Average\\n\\nWhat a year!\\n\""),
        Case("7T8X", ">\n\n folded\n line\n\n next\n line\n   * bullet\n\n   * list\n   * lines\n\n last\n line\n\n# Comment\n", "\"\\nfolded line\\nnext line\\n  * bullet\\n\\n  * list\\n  * lines\\n\\nlast line\\n\""),
        Case("7TMG", "---\n[ word1\n# comment\n, word2]\n", "[\"word1\",\"word2\"]"),
        Case("7ZZ5", "---\nnested sequences:\n- - - []\n- - - \{}\nkey1: []\nkey2: \{}\n", "\{\"nested sequences\":[[[[]]],[[\{}]]],\"key1\":[],\"key2\":\{}}"),
        Case("8CWC", "---\nkey ends with two colons::: value\n", "\{\"key ends with two colons::\":\"value\"}"),
        Case("8G76", "  # Comment\n   \n\n\n", ""),
        Case("8KB6", "---\n- \{ single line, a: b}\n- \{ multi\n  line, a: b}\n", "[\{\"single line\":null,\"a\":\"b\"},\{\"multi line\":null,\"a\":\"b\"}]"),
        Case("8QBE", "key:\n - item1\n - item2\n", "\{\"key\":[\"item1\",\"item2\"]}"),
        Case("93JH", " - key: value\n   key2: value2\n -\n   key3: value3\n", "[\{\"key\":\"value\",\"key2\":\"value2\"},\{\"key3\":\"value3\"}]"),
        Case("96NN/00", "foo: |-\n \tbar\n", "\{\"foo\":\"\\tbar\"}"),
        Case("96NN/01", "foo: |-\n \tbar", "\{\"foo\":\"\\tbar\"}"),
        Case("98YD", "# Comment only.\n", ""),
        Case("9BXH", "---\n- \{ \"single line\", a: b}\n- \{ \"multi\n  line\", a: b}\n", "[\{\"single line\":null,\"a\":\"b\"},\{\"multi line\":null,\"a\":\"b\"}]"),
        Case("9FMG", "a:\n  b:\n    c: d\n  e:\n    f: g\nh: i\n", "\{\"a\":\{\"b\":\{\"c\":\"d\"},\"e\":\{\"f\":\"g\"}},\"h\":\"i\"}"),
        Case("9J7A", "foo:\n  bar: baz\n", "\{\"foo\":\{\"bar\":\"baz\"}}"),
    ]

fn strict_1() List[Case]
    [
        Case("9SA2", "---\n- \{ \"single line\": value}\n- \{ \"multi\n  line\": value}\n", "[\{\"single line\":\"value\"},\{\"multi line\":\"value\"}]"),
        Case("9SHH", "single: 'text'\ndouble: \"text\"\n", "\{\"single\":\"text\",\"double\":\"text\"}"),
        Case("9U5K", "---\n# Products purchased\n- item    : Super Hoop\n  quantity: 1\n- item    : Basketball\n  quantity: 4\n- item    : Big Shoes\n  quantity: 1\n", "[\{\"item\":\"Super Hoop\",\"quantity\":1},\{\"item\":\"Basketball\",\"quantity\":4},\{\"item\":\"Big Shoes\",\"quantity\":1}]"),
        Case("A6F9", "strip: |-\n  text\nclip: |\n  text\nkeep: |+\n  text\n", "\{\"strip\":\"text\",\"clip\":\"text\\n\",\"keep\":\"text\\n\"}"),
        Case("AVM7", "", ""),
        Case("AZ63", "one:\n- 2\n- 3\nfour: 5\n", "\{\"one\":[2,3],\"four\":5}"),
        Case("AZW3", "- bla\"keks: foo\n- bla]keks: foo\n", "[\{\"bla\\\"keks\":\"foo\"},\{\"bla]keks\":\"foo\"}]"),
        Case("C2DT", "\{\n\"adjacent\":value,\n\"readable\": value,\n\"empty\":\n}\n", "\{\"adjacent\":\"value\",\"readable\":\"value\",\"empty\":null}"),
        Case("CPZ3", "---\ntab: \"\\tstring\"\n", "\{\"tab\":\"\\tstring\"}"),
        Case("D88J", "a: [b, c]\n", "\{\"a\":[\"b\",\"c\"]}"),
        Case("D9TU", "foo: bar\n", "\{\"foo\":\"bar\"}"),
        Case("DBG4", "# Outside flow collection:\n- ::vector\n- \": - ()\"\n- Up, up, and away!\n- -123\n- http://example.com/foo#bar\n# Inside flow collection:\n- [ ::vector,\n  \": - ()\",\n  \"Up, up and away!\",\n  -123,\n  http://example.com/foo#bar ]\n", "[\"::vector\",\": - ()\",\"Up, up, and away!\",-123,\"http://example.com/foo#bar\",[\"::vector\",\": - ()\",\"Up, up and away!\",-123,\"http://example.com/foo#bar\"]]"),
        Case("DC7X", "a: b\t\nseq:\t\n - a\t\nc: d\t#X\n", "\{\"a\":\"b\",\"seq\":[\"a\"],\"c\":\"d\"}"),
        Case("DHP8", "[foo, bar, 42]\n", "[\"foo\",\"bar\",42]"),
        Case("DK95/03", " \t\nfoo: 1\n", "\{\"foo\":1}"),
        Case("DK95/04", "foo: 1\n\t\nbar: 2\n", "\{\"foo\":1,\"bar\":2}"),
        Case("DK95/05", "foo: 1\n \t\nbar: 2\n", "\{\"foo\":1,\"bar\":2}"),
        Case("DWX9", "|\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n", "\"\\n\\nliteral\\n \\n\\ntext\\n\""),
        Case("F3CP", "---\n\{ a: [b, c, \{ d: [e, f] } ] }\n", "\{\"a\":[\"b\",\"c\",\{\"d\":[\"e\",\"f\"]}]}"),
        Case("F8F9", " # Strip\n  # Comments:\nstrip: |-\n  # text\n  \n # Clip\n  # comments:\n\nclip: |\n  # text\n \n # Keep\n  # comments:\n\nkeep: |+\n  # text\n\n # Trail\n  # comments.\n", "\{\"strip\":\"# text\",\"clip\":\"# text\\n\",\"keep\":\"# text\\n\\n\"}"),
        Case("FQ7F", "- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n", "[\"Mark McGwire\",\"Sammy Sosa\",\"Ken Griffey\"]"),
        Case("FUP4", "[a, [b, c]]\n", "[\"a\",[\"b\",\"c\"]]"),
        Case("G4RS", "unicode: \"Sosa did fine.\\u263A\"\ncontrol: \"\\b1998\\t1999\\t2000\\n\"\nhex esc: \"\\x0d\\x0a is \\r\\n\"\n\nsingle: '\"Howdy!\" he cried.'\nquoted: ' # Not a ''comment''.'\ntie-fighter: '|\\-*-/|'\n", "\{\"unicode\":\"Sosa did fine.☺\",\"control\":\"\\b1998\\t1999\\t2000\\n\",\"hex esc\":\"\\r\\n is \\r\\n\",\"single\":\"\\\"Howdy!\\\" he cried.\",\"quoted\":\" # Not a 'comment'.\",\"tie-fighter\":\"|\\\\-*-/|\"}"),
        Case("G992", ">\n folded\n text\n\n\n", "\"folded text\\n\""),
        Case("H2RW", "foo: 1\n\nbar: 2\n    \ntext: |\n  a\n    \n  b\n\n  c\n \n  d\n", "\{\"foo\":1,\"bar\":2,\"text\":\"a\\n  \\nb\\n\\nc\\n\\nd\\n\"}"),
        Case("H3Z8", "---\nwanted: love ♥ and peace ☮\n", "\{\"wanted\":\"love ♥ and peace ☮\"}"),
        Case("HM87/00", "[:x]\n", "[\":x\"]"),
        Case("HM87/01", "[?x]\n", "[\"?x\"]"),
        Case("HMK4", "name: Mark McGwire\naccomplishment: >\n  Mark set a major league\n  home run record in 1998.\nstats: |\n  65 Home Runs\n  0.278 Batting Average\n", "\{\"name\":\"Mark McGwire\",\"accomplishment\":\"Mark set a major league home run record in 1998.\\n\",\"stats\":\"65 Home Runs\\n0.278 Batting Average\\n\"}"),
        Case("HWV9", "...\n", ""),
        Case("J3BT", "# Tabs and spaces\nquoted: \"Quoted \t\"\nblock:\t|\n  void main() \{\n  \tprintf(\"Hello, world!\\n\");\n  }\n", "\{\"quoted\":\"Quoted \\t\",\"block\":\"void main() \{\\n\\tprintf(\\\"Hello, world!\\\\n\\\");\\n}\\n\"}"),
        Case("J5UC", "foo: blue\nbar: arrr\nbaz: jazz\n", "\{\"foo\":\"blue\",\"bar\":\"arrr\",\"baz\":\"jazz\"}"),
        Case("J7VC", "one: 2\n\n\nthree: 4\n", "\{\"one\":2,\"three\":4}"),
        Case("J9HZ", "---\nhr: # 1998 hr ranking\n  - Mark McGwire\n  - Sammy Sosa\nrbi:\n  # 1998 rbi ranking\n  - Sammy Sosa\n  - Ken Griffey\n", "\{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}"),
        Case("JEF9/00", "- |+\n\n\n", "[\"\\n\\n\"]"),
        Case("JEF9/01", "- |+\n   \n", "[\"\\n\"]"),
        Case("JEF9/02", "- |+\n   ", "[\"\\n\"]"),
        Case("JQ4R", "block sequence:\n  - one\n  - two : three\n", "\{\"block sequence\":[\"one\",\{\"two\":\"three\"}]}"),
        Case("JR7V", "- a?string\n- another ? string\n- key: value?\n- [a?string]\n- [another ? string]\n- \{key: value? }\n- \{key: value?}\n- \{key?: value }\n", "[\"a?string\",\"another ? string\",\{\"key\":\"value?\"},[\"a?string\"],[\"another ? string\"],\{\"key\":\"value?\"},\{\"key\":\"value?\"},\{\"key?\":\"value\"}]"),
        Case("K3WX", "---\n\{ \"foo\" # comment\n  :bar }\n", "\{\"foo\":\"bar\"}"),
    ]

fn strict_2() List[Case]
    [
        Case("K4SU", "- foo\n- bar\n- 42\n", "[\"foo\",\"bar\",42]"),
        Case("K527", ">-\n  trimmed\n  \n \n\n  as\n  space\n", "\"trimmed\\n\\n\\nas space\""),
        Case("K858", "strip: >-\n\nclip: >\n\nkeep: |+\n\n", "\{\"strip\":\"\",\"clip\":\"\",\"keep\":\"\\n\"}"),
        Case("KH5V/00", "\"1 inline\\ttab\"\n", "\"1 inline\\ttab\""),
        Case("KH5V/02", "\"3 inline\ttab\"\n", "\"3 inline\\ttab\""),
        Case("KMK3", "foo:\n  bar: 1\nbaz: 2\n", "\{\"foo\":\{\"bar\":1},\"baz\":2}"),
        Case("L24T/00", "foo: |\n  x\n   \n", "\{\"foo\":\"x\\n \\n\"}"),
        Case("L24T/01", "foo: |\n  x\n   ", "\{\"foo\":\"x\\n \\n\"}"),
        Case("LP6E", "- [a, b , c ]\n- \{ \"a\"  : b\n   , c : 'd' ,\n   e   : \"f\"\n  }\n- [      ]\n", "[[\"a\",\"b\",\"c\"],\{\"a\":\"b\",\"c\":\"d\",\"e\":\"f\"},[]]"),
        Case("M29M", "a: |\n ab\n \n cd\n ef\n \n\n...\n", "\{\"a\":\"ab\\n\\ncd\\nef\\n\"}"),
        Case("M6YH", "- |\n x\n-\n foo: bar\n-\n - 42\n", "[\"x\\n\",\{\"foo\":\"bar\"},[42]]"),
        Case("M7NX", "---\n\{\n a: [\n  b, c, \{\n   d: [e, f]\n  }\n ]\n}\n", "\{\"a\":[\"b\",\"c\",\{\"d\":[\"e\",\"f\"]}]}"),
        Case("M9B4", "|\n literal\n \ttext\n\n\n", "\"literal\\n\\ttext\\n\""),
        Case("MJS9", ">\n  foo \n \n  \t bar\n\n  baz\n", "\"foo \\n\\n\\t bar\\n\\nbaz\\n\""),
        Case("MXS3", "- \{a: b}\n", "[\{\"a\":\"b\"}]"),
        Case("MYW6", "|-\n ab\n \n \n...\n", "\"ab\""),
        Case("MZX3", "- plain\n- \"double quoted\"\n- 'single quoted'\n- >\n  block\n- plain again\n", "[\"plain\",\"double quoted\",\"single quoted\",\"block\\n\",\"plain again\"]"),
        Case("NJ66", "---\n- \{ single line: value}\n- \{ multi\n  line: value}\n", "[\{\"single line\":\"value\"},\{\"multi line\":\"value\"}]"),
        Case("P94K", "key:    # Comment\n        # lines\n  value\n\n\n", "\{\"key\":\"value\"}"),
        Case("PBJ2", "american:\n  - Boston Red Sox\n  - Detroit Tigers\n  - New York Yankees\nnational:\n  - New York Mets\n  - Chicago Cubs\n  - Atlanta Braves\n", "\{\"american\":[\"Boston Red Sox\",\"Detroit Tigers\",\"New York Yankees\"],\"national\":[\"New York Mets\",\"Chicago Cubs\",\"Atlanta Braves\"]}"),
        Case("Q88A", "- [ a, b ]\n- \{ a: b }\n- \"a\"\n- 'b'\n- c\n", "[[\"a\",\"b\"],\{\"a\":\"b\"},\"a\",\"b\",\"c\"]"),
        Case("QT73", "# comment\n...\n", ""),
        Case("R52L", "---\n\{ top1: [item1, \{key2: value2}, item3], top2: value2 }\n", "\{\"top1\":[\"item1\",\{\"key2\":\"value2\"},\"item3\"],\"top2\":\"value2\"}"),
        Case("RLU9", "foo:\n- 42\nbar:\n  - 44\n", "\{\"foo\":[42],\"bar\":[44]}"),
        Case("S4T7", "aaa: bbb\n...\n", "\{\"aaa\":\"bbb\"}"),
        Case("S7BG", "---\n- :,\n", "[\":,\"]"),
        Case("SM9W/00", "-", "[null]"),
        Case("SSW6", "---\n'here''s to \"quotes\"'\n", "\"here's to \\\"quotes\\\"\""),
        Case("SYW4", "hr:  65    # Home runs\navg: 0.278 # Batting average\nrbi: 147   # Runs Batted In\n", "\{\"hr\":65,\"avg\":0.278,\"rbi\":147}"),
        Case("TE2A", "block mapping:\n key: value\n", "\{\"block mapping\":\{\"key\":\"value\"}}"),
        Case("TS54", ">\n ab\n cd\n \n ef\n\n\n gh\n", "\"ab cd\\nef\\n\\ngh\\n\""),
        Case("UDM2", "- \{ url: http://example.org }\n", "[\{\"url\":\"http://example.org\"}]"),
        Case("UDR7", "sequence: [ one, two, ]\nmapping: \{ sky: blue, sea: green }\n", "\{\"sequence\":[\"one\",\"two\"],\"mapping\":\{\"sky\":\"blue\",\"sea\":\"green\"}}"),
        Case("UKK6/01", "::\n", "\{\":\":null}"),
        Case("VJP3/01", "k: \{\n k\n :\n v\n }\n", "\{\"k\":\{\"k\":\"v\"}}"),
        Case("W42U", "- # Empty\n- |\n block node\n- - one # Compact\n  - two # sequence\n- one: two # Compact mapping\n", "[null,\"block node\\n\",[\"one\",\"two\"],\{\"one\":\"two\"}]"),
        Case("Y79Y/001", "foo: |\n \t\nbar: 1\n", "\{\"foo\":\"\\t\\n\",\"bar\":1}"),
        Case("Y79Y/002", "- [\n\t\n foo\n ]\n", "[[\"foo\"]]"),
        Case("Y79Y/010", "-\t-1\n", "[-1]"),
        Case("YD5X", "- [name        , hr, avg  ]\n- [Mark McGwire, 65, 0.278]\n- [Sammy Sosa  , 63, 0.288]\n", "[[\"name\",\"hr\",\"avg\"],[\"Mark McGwire\",65,0.278],[\"Sammy Sosa\",63,0.288]]"),
    ]

fn strict_3() List[Case]
    [
        Case("ZF4X", "Mark McGwire: \{hr: 65, avg: 0.278}\nSammy Sosa: \{\n    hr: 63,\n    avg: 0.288\n  }\n", "\{\"Mark McGwire\":\{\"hr\":65,\"avg\":0.278},\"Sammy Sosa\":\{\"hr\":63,\"avg\":0.288}}"),
        Case("ZK9H", "\{ key: [[[\n  value\n ]]]\n}\n", "\{\"key\":[[[\"value\"]]]}"),
    ]

fn lenient_0() List[Case]
    [
        Case("26DV", "\"top1\" : \n  \"key1\" : &alias1 scalar1\n'top2' : \n  'key2' : &alias2 scalar2\ntop3: &node3 \n  *alias1 : scalar3\ntop4: \n  *alias2 : scalar4\ntop5   :    \n  scalar5\ntop6: \n  &anchor6 'key6' : scalar6\n", "\{\"top1\":\{\"key1\":\"scalar1\"},\"top2\":\{\"key2\":\"scalar2\"},\"top3\":\{\"scalar1\":\"scalar3\"},\"top4\":\{\"scalar2\":\"scalar4\"},\"top5\":\"scalar5\",\"top6\":\{\"key6\":\"scalar6\"}}"),
        Case("27NA", "%YAML 1.2\n--- text\n", "\"text\""),
        Case("2AUY", " - !!str a\n - b\n - !!int 42\n - d\n", "[\"a\",\"b\",42,\"d\"]"),
        Case("2G84/02", "--- |1-", "\"\""),
        Case("2G84/03", "--- |1+", "\"\""),
        Case("2LFX", "%FOO  bar baz # Should be ignored\n              # with a warning.\n---\n\"foo\"\n", "\"foo\""),
        Case("2SXE", "&a: key: &a value\nfoo:\n  *a:\n", "\{\"key\":\"value\",\"foo\":\"key\"}"),
        Case("2XXW", "# Sets are represented as a\n# Mapping where each key is\n# associated with a null value\n--- !!set\n? Mark McGwire\n? Sammy Sosa\n? Ken Griff\n", "\{\"Mark McGwire\":null,\"Sammy Sosa\":null,\"Ken Griff\":null}"),
        Case("33X3", "---\n- !!int 1\n- !!int -2\n- !!int 33\n", "[1,-2,33]"),
        Case("35KP", "--- !!map\n? a\n: b\n--- !!seq\n- !!str c\n--- !!str\nd\ne\n", ""),
        Case("36F6", "---\nplain: a\n b\n\n c\n", "\{\"plain\":\"a b\\nc\"}"),
        Case("3GZX", "First occurrence: &anchor Foo\nSecond occurrence: *anchor\nOverride anchor: &anchor Bar\nReuse anchor: *anchor\n", "\{\"First occurrence\":\"Foo\",\"Second occurrence\":\"Foo\",\"Override anchor\":\"Bar\",\"Reuse anchor\":\"Bar\"}"),
        Case("3MYT", "---\nk:#foo\n &a !t s\n", "\"k:#foo &a !t s\""),
        Case("3R3P", "&sequence\n- a\n", "[\"a\"]"),
        Case("3RLN/00", "\"1 leading\n    \\ttab\"\n", "\"1 leading \\ttab\""),
        Case("3RLN/01", "\"2 leading\n    \\\ttab\"\n", "\"2 leading \\ttab\""),
        Case("3RLN/02", "\"3 leading\n    \ttab\"\n", "\"3 leading tab\""),
        Case("3RLN/03", "\"4 leading\n    \\t  tab\"\n", "\"4 leading \\t  tab\""),
        Case("3RLN/04", "\"5 leading\n    \\\t  tab\"\n", "\"5 leading \\t  tab\""),
        Case("3RLN/05", "\"6 leading\n    \t  tab\"\n", "\"6 leading tab\""),
        Case("4CQQ", "plain:\n  This unquoted scalar\n  spans many lines.\n\nquoted: \"So does this\n  quoted scalar.\\n\"\n", "\{\"plain\":\"This unquoted scalar spans many lines.\",\"quoted\":\"So does this quoted scalar.\\n\"}"),
        Case("4Q9F", "--- >\n ab\n cd\n \n ef\n\n\n gh\n", "\"ab cd\\nef\\n\\ngh\\n\""),
