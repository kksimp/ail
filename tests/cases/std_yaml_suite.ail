            src: "# The !!omap tag is one of the optional types\n# introduced for YAML 1.1. In 1.2, it is not\n# part of the standard tags and should not be\n# enabled by default.\n# Ordered maps are represented as\n# A sequence of mappings, with\n# each mapping having one key\n--- !!omap\n- Mark McGwire: 65\n- Sammy Sosa: 63\n- Ken Griffy: 58\n",
            want: "[\{\"Mark McGwire\":65},\{\"Sammy Sosa\":63},\{\"Ken Griffy\":58}]",
        ),
        Case(
            name: "JHB9",
            src: "# Ranking of 1998 home runs\n---\n- Mark McGwire\n- Sammy Sosa\n- Ken Griffey\n\n# Team ranking\n---\n- Chicago Cubs\n- St Louis Cardinals\n",
            want: "",
        ),
        Case(
            name: "JS2J",
            src: "First occurrence: &anchor Value\nSecond occurrence: *anchor\n",
            want: "\{\"First occurrence\":\"Value\",\"Second occurrence\":\"Value\"}",
        ),
        Case(
            name: "JTV5",
            src: "? a\n  true\n: null\n  d\n? e\n  42\n",
            want: "\{\"a true\":\"null d\",\"e 42\":null}",
        ),
        Case(name: "K54U", src: "---\tscalar\n", want: "\"scalar\""),
        Case(name: "KH5V/01", src: "\"2 inline\\\ttab\"\n", want: "\"2 inline\\ttab\""),
        Case(name: "KSS4", src: "--- \"quoted\nstring\"\n--- &node foo\n", want: ""),
        Case(name: "L383", src: "--- foo  # comment\n--- foo  # comment\n", want: ""),
        Case(
            name: "L94M",
            src: "? !!str a\n: !!int 47\n? c\n: !!str d\n",
            want: "\{\"a\":47,\"c\":\"d\"}",
        ),
        Case(
            name: "L9U5",
            src: "implicit block key : [\n  implicit flow key : value,\n ]\n",
            want: "\{\"implicit block key\":[\{\"implicit flow key\":\"value\"}]}",
        ),
        Case(
            name: "LE5A",
            src: "- !!str \"a\"\n- 'b'\n- &anchor \"c\"\n- *anchor\n- !!str\n",
            want: "[\"a\",\"b\",\"c\",\"c\",\"\"]",
        ),
        Case(
            name: "LQZ7",
            src: "\"implicit block key\" : [\n  \"implicit flow key\" : value,\n ]\n",
            want: "\{\"implicit block key\":[\{\"implicit flow key\":\"value\"}]}",
        ),
        Case(
            name: "M5C3",
            src: "literal: |2\n  value\nfolded:\n   !foo\n  >1\n value\n",
            want: "\{\"literal\":\"value\\n\",\"folded\":\"value\\n\"}",
        ),
        Case(
            name: "M7A3",
            src: "Bare\ndocument\n...\n# No document\n...\n|\n%!PS-Adobe-2.0 # Not the first line\n",
            want: "",
        ),
        Case(name: "MUS6/02", src: "%YAML  1.1\n---\n", want: "null"),
        Case(name: "MUS6/03", src: "%YAML \t 1.1\n---\n", want: "null"),
        Case(name: "MUS6/04", src: "%YAML 1.1  # comment\n---\n", want: "null"),
        Case(name: "MUS6/05", src: "%YAM 1.1\n---\n", want: "null"),
        Case(name: "MUS6/06", src: "%YAMLL 1.1\n---\n", want: "null"),
        Case(
            name: "NAT4",
            src: "---\na: '\n  '\nb: '  \n  '\nc: \"\n  \"\nd: \"  \n  \"\ne: '\n\n  '\nf: \"\n\n  \"\ng: '\n\n\n  '\nh: \"\n\n\n  \"\n",
            want: "\{\"a\":\" \",\"b\":\" \",\"c\":\" \",\"d\":\" \",\"e\":\"\\n\",\"f\":\"\\n\",\"g\":\"\\n\\n\",\"h\":\"\\n\\n\"}",
        ),
        Case(
            name: "NB6Z",
            src: "key:\n  value\n  with\n  \t\n  tabs\n",
            want: "\{\"key\":\"value with\\ntabs\"}",
        ),
    ]

fn lenient_3() List[Case]
    [
        Case(
            name: "NP9H",
            src: "\"folded \nto a space,\t\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n",
            want: "\"folded to a space,\\nto a line feed, or \\t \\tnon-content\"",
        ),
        Case(
            name: "P2AD",
            src: "- | # Empty header↓\n literal\n- >1 # Indentation indicator↓\n  folded\n- |+ # Chomping indicator↓\n keep\n\n- >1- # Both indicators↓\n  strip\n",
            want: "[\"literal\\n\",\" folded\\n\",\"keep\\n\\n\",\" strip\"]",
        ),
        Case(
            name: "P76L",
            src: "%TAG !! tag:example.com,2000:app/\n---\n!!int 1 - 3 # Interval, not integer\n",
            want: "\"1 - 3\"",
        ),
        Case(
            name: "PRH3",
            src: "' 1st non-empty\n\n 2nd non-empty \n\t3rd non-empty '\n",
            want: "\" 1st non-empty\\n2nd non-empty 3rd non-empty \"",
        ),
        Case(name: "PUW8", src: "---\na: b\n---\n", want: ""),
        Case(name: "Q5MG", src: "\t\{}\n", want: "\{}"),
        Case(
            name: "Q8AD",
            src: "---\n\"folded \nto a space,\n \nto a line feed, or \t\\\n \\ \tnon-content\"\n",
            want: "\"folded to a space,\\nto a line feed, or \\t \\tnon-content\"",
        ),
        Case(name: "QF4Y", src: "[\nfoo: bar\n]\n", want: "[\{\"foo\":\"bar\"}]"),
        Case(
            name: "R4YG",
            src: "- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n",
            want: "[\"detected\\n\",\"\\n\\n# detected\\n\",\" explicit\\n\",\"\\t\\ndetected\\n\"]",
        ),
        Case(name: "RR7F", src: "a: 4.2\n? d\n: 23\n", want: "\{\"d\":23,\"a\":4.2}"),
        Case(name: "RTP8", src: "%YAML 1.2\n---\nDocument\n... # Suffix\n", want: "\"Document\""),
        Case(
            name: "RZT7",
            src: "---\nTime: 2001-11-23 15:01:42 -5\nUser: ed\nWarning:\n  This is an error message\n  for the log file\n---\nTime: 2001-11-23 15:02:31 -5\nUser: ed\nWarning:\n  A slightly different error\n  message.\n---\nDate: 2001-11-23 15:03:17 -5\nUser: ed\nFatal:\n  Unknown variable \"bar\"\nStack:\n  - file: TopClass.py\n    line: 23\n    code: |\n      x = MoreObject(\"345\\n\")\n  - file: MoreClass.py\n    line: 58\n    code: |-\n      foo = bar\n",
            want: "",
        ),
        Case(
            name: "S4JQ",
            src: "# Assuming conventional resolution:\n- \"12\"\n- 12\n- ! 12\n",
            want: "[\"12\",12,\"12\"]",
        ),
        Case(
            name: "S9E8",
            src: "sequence:\n- one\n- two\nmapping:\n  ? sky\n  : blue\n  sea : green\n",
            want: "\{\"sequence\":[\"one\",\"two\"],\"mapping\":\{\"sky\":\"blue\",\"sea\":\"green\"}}",
        ),
        Case(name: "SKE5", src: "---\nseq:\n &anchor\n- a\n- b\n", want: "\{\"seq\":[\"a\",\"b\"]}"),
        Case(
            name: "T26H",
            src: "--- |\n \n  \n  literal\n   \n  \n  text\n\n # Comment\n",
            want: "\"\\n\\nliteral\\n \\n\\ntext\\n\"",
        ),
        Case(
            name: "T4YY",
            src: "---\n' 1st non-empty\n\n 2nd non-empty \n 3rd non-empty '\n",
            want: "\" 1st non-empty\\n2nd non-empty 3rd non-empty \"",
        ),
        Case(name: "T5N4", src: "--- |\n literal\n \ttext\n\n\n", want: "\"literal\\n\\ttext\\n\""),
        Case(
            name: "TL85",
            src: "\"\n  foo \n \n  \t bar\n\n  baz\n\"\n",
            want: "\" foo\\nbar\\nbaz \"",
        ),
        Case(
            name: "U3C3",
            src: "%TAG !yaml! tag:yaml.org,2002:\n---\n!yaml!str \"foo\"\n",
            want: "\"foo\"",
        ),
        Case(
            name: "U3XV",
            src: "---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4:\n  &node4\n  &k4 key4: four\ntop5:\n  &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n",
            want: "\{\"top1\":\{\"key1\":\"one\"},\"top2\":\{\"key2\":\"two\"},\"top3\":\{\"key3\":\"three\"},\"top4\":\{\"key4\":\"four\"},\"top5\":\{\"key5\":\"five\"},\"top6\":\"six\",\"top7\":\"seven\"}",
        ),
        Case(
            name: "U9NS",
            src: "---\ntime: 20:03:20\nplayer: Sammy Sosa\naction: strike (miss)\n...\n---\ntime: 20:03:47\nplayer: Sammy Sosa\naction: grand slam\n...\n",
            want: "",
        ),
        Case(
            name: "UGM3",
            src: "--- !<tag:clarkevans.com,2002:invoice>\ninvoice: 34843\ndate   : 2001-01-23\nbill-to: &id001\n    given  : Chris\n    family : Dumars\n    address:\n        lines: |\n            458 Walkman Dr.\n            Suite #292\n        city    : Royal Oak\n        state   : MI\n        postal  : 48046\nship-to: *id001\nproduct:\n    - sku         : BL394D\n      quantity    : 4\n      description : Basketball\n      price       : 450.00\n    - sku         : BL4438H\n      quantity    : 1\n      description : Super Hoop\n      price       : 2392.00\ntax  : 251.42\ntotal: 4443.52\ncomments:\n    Late afternoon is best.\n    Backup contact is Nancy\n    Billsmer @ 338-4338.\n",
            want: "\{\"invoice\":34843,\"date\":\"2001-01-23\",\"bill-to\":\{\"given\":\"Chris\",\"family\":\"Dumars\",\"address\":\{\"lines\":\"458 Walkman Dr.\\nSuite #292\\n\",\"city\":\"Royal Oak\",\"state\":\"MI\",\"postal\":48046}},\"ship-to\":\{\"given\":\"Chris\",\"family\":\"Dumars\",\"address\":\{\"lines\":\"458 Walkman Dr.\\nSuite #292\\n\",\"city\":\"Royal Oak\",\"state\":\"MI\",\"postal\":48046}},\"product\":[\{\"sku\":\"BL394D\",\"quantity\":4,\"description\":\"Basketball\",\"price\":450},\{\"sku\":\"BL4438H\",\"quantity\":1,\"description\":\"Super Hoop\",\"price\":2392}],\"tax\":251.42,\"total\":4443.52,\"comments\":\"Late afternoon is best. Backup contact is Nancy Billsmer @ 338-4338.\"}",
        ),
        Case(name: "UT92", src: "---\n\{ matches\n% : 20 }\n...\n---\n# Empty\n...\n", want: ""),
        Case(name: "UV7Q", src: "x:\n - x\n  \tx\n", want: "\{\"x\":[\"x x\"]}"),
        Case(name: "V55R", src: "- &a a\n- &b b\n- *a\n- *b\n", want: "[\"a\",\"b\",\"a\",\"b\"]"),
        Case(
            name: "W4TN",
            src: "%YAML 1.2\n--- |\n%!PS-Adobe-2.0\n...\n%YAML 1.2\n---\n# Empty\n...\n",
            want: "",
        ),
        Case(
            name: "W5VH",
            src: "a: &:@*!$\"<foo>: scalar a\nb: *:@*!$\"<foo>:\n",
            want: "\{\"a\":\"scalar a\",\"b\":\"scalar a\"}",
        ),
        Case(
            name: "WZ62",
            src: "\{\n  foo : !!str,\n  !!str : bar,\n}\n",
            want: "\{\"foo\":\"\",\"\":\"bar\"}",
        ),
        Case(name: "X8DW", src: "---\n? key\n# comment\n: value\n", want: "\{\"key\":\"value\"}"),
        Case(name: "XLQ9", src: "---\nscalar\n%YAML 1.2\n", want: "\"scalar %YAML 1.2\""),
        Case(
            name: "XV9V",
            src: "Folding:\n  \"Empty line\n\n  as a line feed\"\nChomping: |\n  Clipped empty lines\n \n\n",
            want: "\{\"Folding\":\"Empty line\\nas a line feed\",\"Chomping\":\"Clipped empty lines\\n\"}",
        ),
        Case(name: "Y2GN", src: "---\nkey: &an:chor value\n", want: "\{\"key\":\"value\"}"),
        Case(
            name: "Z67P",
            src: "literal: |2\n  value\nfolded: !foo >1\n value\n",
            want: "\{\"literal\":\"value\\n\",\"folded\":\"value\\n\"}",
        ),
        Case(
            name: "Z9M4",
            src: "%TAG !e! tag:example.com,2000:app/\n---\n- !e!foo \"bar\"\n",
            want: "[\"bar\"]",
        ),
        Case(name: "ZH7C", src: "&a a: b\nc: &d d\n", want: "\{\"a\":\"b\",\"c\":\"d\"}"),
        Case(
            name: "ZWK4",
            src: "---\na: 1\n? b\n&anchor c: 3\n",
            want: "\{\"a\":1,\"b\":null,\"c\":3}",
        ),
