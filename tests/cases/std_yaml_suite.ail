        Case("QF4Y", "[\nfoo: bar\n]\n", "[\{\"foo\":\"bar\"}]"),
        Case("R4YG", "- |\n detected\n- >\n \n  \n  # detected\n- |1\n  explicit\n- >\n \t\n detected\n", "[\"detected\\n\",\"\\n\\n# detected\\n\",\" explicit\\n\",\"\\t\\ndetected\\n\"]"),
