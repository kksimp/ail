        Case(name: "SM9W/00", src: "-", want: "[null]"),
        Case(
            name: "SSW6",
            src: "---\n'here''s to \"quotes\"'\n",
            want: "\"here's to \\\"quotes\\\"\"",
        ),
        Case(
            name: "SYW4",
            src: "hr:  65    # Home runs\navg: 0.278 # Batting average\nrbi: 147   # Runs Batted In\n",
            want: "\{\"hr\":65,\"avg\":0.278,\"rbi\":147}",
        ),
        Case(
            name: "TE2A",
            src: "block mapping:\n key: value\n",
            want: "\{\"block mapping\":\{\"key\":\"value\"}}",
        ),
        Case(name: "TS54", src: ">\n ab\n cd\n \n ef\n\n\n gh\n", want: "\"ab cd\\nef\\n\\ngh\\n\""),
        Case(
            name: "UDM2",
            src: "- \{ url: http://example.org }\n",
            want: "[\{\"url\":\"http://example.org\"}]",
        ),
        Case(
            name: "UDR7",
            src: "sequence: [ one, two, ]\nmapping: \{ sky: blue, sea: green }\n",
            want: "\{\"sequence\":[\"one\",\"two\"],\"mapping\":\{\"sky\":\"blue\",\"sea\":\"green\"}}",
