        Case("7MNF", "top1:\n  key1: val1\ntop2\n", ""),
        Case("8XDJ", "key: word1\n#  xxx\n  word2\n", ""),
        Case("9C9N", "---\nflow: [a,\nb,\nc]\n", ""),
        Case("9CWY", "key:\n - item1\n - item2\ninvalid\n", ""),
        Case("9HCY", "!foo \"bar\"\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n", ""),
        Case("9JBA", "---\n[ a, b, c, ]#invalid\n", ""),
        Case("9KBC", "--- key1: value1\n    key2: value2\n", ""),
        Case("9MAG", "---\n[ , a, b, c ]\n", ""),
