        Case("7BMT", "---\ntop1: &node1\n  &k1 key1: one\ntop2: &node2 # comment\n  key2: two\ntop3:\n  &k3 key3: three\ntop4: &node4\n  &k4 key4: four\ntop5: &node5\n  key5: five\ntop6: &val6\n  six\ntop7:\n  &val7 seven\n", "\{\"top1\":\{\"key1\":\"one\"},\"top2\":\{\"key2\":\"two\"},\"top3\":\{\"key3\":\"three\"},\"top4\":\{\"key4\":\"four\"},\"top5\":\{\"key5\":\"five\"},\"top6\":\"six\",\"top7\":\"seven\"}"),
        Case("7BUB", "---\nhr:\n  - Mark McGwire\n  # Following node labeled SS\n  - &SS Sammy Sosa\nrbi:\n  - *SS # Subsequent occurrence\n  - Ken Griffey\n", "\{\"hr\":[\"Mark McGwire\",\"Sammy Sosa\"],\"rbi\":[\"Sammy Sosa\",\"Ken Griffey\"]}"),
