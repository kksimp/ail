        Case("9YRD", "a\nb  \n  c\nd\n\ne\n", "\"a b c d\\ne\""),
        Case("A2M4", "? a\n: -\tb\n  -  -\tc\n     - d\n", "\{\"a\":[\"b\",[\"c\",\"d\"]]}"),
        Case("A984", "a: b\n c\nd:\n e\n  f\n", "\{\"a\":\"b c\",\"d\":\"e f\"}"),
        Case("AB8U", "- single multiline\n - sequence entry\n", "[\"single multiline - sequence entry\"]"),
        Case("B3HG", "--- >\n folded\n text\n\n\n", "\"folded text\\n\""),
