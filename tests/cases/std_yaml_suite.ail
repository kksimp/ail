        Case("FBC9", "safe: a!\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|}~\n     !\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az\{|}~\nsafe question mark: ?foo\nsafe colon: :foo\nsafe dash: -foo\n", "\{\"safe\":\"a!\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|}~ !\\\"#$%&'()*+,-./09:;<=>?@AZ[\\\\]^_`az\{|}~\",\"safe question mark\":\"?foo\",\"safe colon\":\":foo\",\"safe dash\":\"-foo\"}"),
