        Case("BS4K", "word1  # comment\nword2\n", ""),
        Case("C2SP", "[23\n]: 42\n", ""),
        Case("CQ3W", "---\nkey: \"missing closing quote\n", ""),
        Case("CTN5", "---\n[ a, b, c, , ]\n", ""),
        Case("CVW2", "---\n[ a, b, c,#invalid\n]\n", ""),
        Case("CXX2", "--- &anchor a: b\n", ""),
        Case("D49Q", "'a\\nb': 1\n'c\n d': 1\n", ""),
        Case("DK4H", "---\n[ key\n  : value ]\n", ""),
        Case("DK95/01", "foo: \"bar\n\tbaz\"\n", ""),
        Case("DK95/06", "foo:\n  a: 1\n  \tb: 2\n", ""),
    ]

