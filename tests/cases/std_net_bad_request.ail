## std.net.6, std.net.11: header injection and bad statuses are refused on
## both sides; the exchange stays open after a refused response.
use std.net

fn worker(srv net.Server) !
    ex := srv.accept()?
    ex.respond(net.Response(status: 99, headers: {}, body: "")) else err
        print("status: {err.kind}")
    ex.respond(net.Response(status: 200, headers: {"x\r\ninjected": "1"}, body: "")) else err
        print("name: {err.kind}")
    ex.respond(net.Response(
        status: 200,
        headers: {"x-a": "1\r\nSet-Cookie: s=1"},
        body: "",
    )) else err
        print("value: {err.kind}")
    ex.respond(net.Response(
        status: 201,
        headers: {"content-length": "500", "x-a": "1"},
        body: "made",
    ))?
    ex.respond(net.Response(status: 200, headers: {}, body: "again")) else err
        print("twice: {err.kind}")

fn kind_of(method str, url str, o net.Options) str
    r := net.request(method, url, o) else err
        return err.kind
    "{r.status}"

fn main() !
    srv := net.serve("127.0.0.1:0")?
    w := spawn worker(srv)
    base := "http://{srv.addr()}/"
    mut o := net.options()
    o.headers["x-a"] = "1\r\nHost: evil"
    print("client value: {kind_of("GET", base, o)}")
    mut o2 := net.options()
    o2.headers["bad name"] = "1"
    print("client name: {kind_of("GET", base, o2)}")
    print("client method: {kind_of("GE T", base, net.options())}")
    r := net.get(base)?
    # The worker prints its last line after it has sent this response: wait for it,
    # so the order of the two tasks' output does not depend on the schedule.
    w.wait()?
    print("{r.status} {r.headers["x-a"]} {r.headers["content-length"]} {r.body}")
