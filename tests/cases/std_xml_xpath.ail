## std.xml.17-22: XPath 1.0 queries. Every expected line below is lxml's answer to the same expression on the same document.
use std.xml

fn num(x float) str
    if x != x
        return "NaN"
    if x == 0.0
        return "0"
    if x - x != 0.0
        return if x > 0.0 then "Infinity" else "-Infinity"
    if x == x.floor() and x.abs() < 1000000000000000.0
        return x.to_int().to_str()
    "{x}"

fn item(n xml.Node) str
    if n.is_elem()
        return "E:{n.name()}={n.text()}"
    "S:{n.text()}"

fn render(v xml.XValue) str
    match v
        Nodes(ns) => "[{ns.map(|n| item(n)).join(", ")}]"
        Str(s) => "Str:{s}"
        Num(x) => "Num:{num(x)}"
        Bool(b) => "Bool:{b}"

fn run(root xml.Node, ctx str, expr str)
    label := if ctx == "" then expr else "[{ctx}] {expr}"
    mut at := root
    if ctx != ""
        found := root.select(ctx) else
            print("{label} => context error")
            return
        at = found[0]
    v := at.xpath(expr) else
        print("{label} => error")
        return
    print("{label} => {render(v)}")

fn main() !
    doc := "<catalog><book id=\"b1\" lang=\"en\"><title>Alpha</title><price>10</price><tags><tag>a</tag><tag>b</tag></tags></book><book id=\"b2\" lang=\"fr\"><title>Beta</title><price>25.5</price><tags><tag>b</tag></tags></book><book id=\"b3\"><title>Gamma</title><price>7</price></book><note>see <b>book</b> two</note></catalog>"
    root := xml.parse(doc)?
    run(root, "", "/catalog")
    run(root, "", "/catalog/book")
    run(root, "", "//book")
    run(root, "", "//title")
    run(root, "", "/catalog/book[1]/title")
    run(root, "", "/catalog/book[last()]/title")
    run(root, "", "//book[@id='b2']/title")
    run(root, "", "//book[price>9]/title")
    run(root, "", "//book[price>9 and @lang]/@id")
    run(root, "", "//book[not(@lang)]/@id")
    run(root, "", "//book[position()<3]/@id")
    run(root, "", "//book[position()=last()-1]/@id")
    run(root, "", "count(//book)")
    run(root, "", "count(//tag)")
    run(root, "", "sum(//price)")
    run(root, "", "sum(//book/price) div 4")
    run(root, "", "//book[2]/preceding-sibling::book/@id")
    run(root, "", "//book[1]/following-sibling::*")
    run(root, "", "//book[3]/preceding-sibling::book[1]/@id")
    run(root, "", "//tag[.='b']")
    run(root, "", "//tag[.='b']/ancestor::book/@id")
    run(root, "", "//tag[.='b']/ancestor::*[1]")
    run(root, "", "//title/text()")
    run(root, "", "//note/text()")
    run(root, "", "//note//text()")
    run(root, "", "//note/node()")
    run(root, "", "count(//note/node())")
    run(root, "", "string(//note)")
    run(root, "", "normalize-space(' a  b ')")
    run(root, "", "concat('a','b',//book[1]/@id)")
    run(root, "", "contains(//note,'two')")
    run(root, "", "contains('abc','')")
