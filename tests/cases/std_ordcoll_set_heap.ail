## std.ordcoll.8 to std.ordcoll.13: OrdSet, and IndexHeap with update,
## decrease_key, remove and a largest-first queue.
fn show(label str, e (int, int)?)
    x := e else
        print("{label} none")
        return
    print("{label} {x.0} {x.1}")

fn main()
    mut s := ordcoll.OrdSet[str].new()
    print(s.add("pear"))
    print(s.add("apple"))
    print(s.add("pear"))
    print(s.add("fig"))
    print(s.to_list().join(","))
    print(s.len())
    print(s.floor("g") else "none")
    print(s.ceiling("g") else "none")
    print(s.range("b", "q").join(","))
    print(s.rank("pear"))
    print(s.remove("fig"))
    print(s.remove("fig"))
    print(s.first() else "none")
    print(s.last() else "none")
    print(s.pop_first() else "none")
    print(s.len())

    mut q := ordcoll.IndexHeap[int].new()
    print(q.is_empty())
    q.push(3, 30)
    q.push(1, 10)
    q.push(2, 20)
    q.push(5, 50)
    print(q.len())
    show("peek", q.peek())
    print(q.decrease_key(5, 5))
    print(q.decrease_key(2, 25))
    print(q.priority(5) else -1)
    print(q.priority(4) else -1)
    q.push(1, 60)
    print(q.contains(1))
    print(q.contains(4))
    print(q.remove(3) else -1)
    print(q.remove(3) else -1)
    show("pop", q.pop())
    show("pop", q.pop())
    show("pop", q.pop())
    show("pop", q.pop())
    print(q.is_empty())

    mut big := ordcoll.IndexHeap[float].new_max()
    big.push(0, 1.5)
    big.push(1, 9.5)
    big.push(2, 4.5)
    print(big.decrease_key(0, 7.5))
    print(big.decrease_key(1, 2.0))
    mut order := List[str]()
    while not big.is_empty()
        e := big.pop() else
            break
        order.push("{e.0}")
    print(order.join(" "))
