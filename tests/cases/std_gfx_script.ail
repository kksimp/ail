## std.gfx.1-5: key-down, key-up and a frame dump, with no window.
use std.app
use std.gfx

struct Player
    x float
    moving bool

impl gfx.Game for Player
    fn update(mut self, input gfx.Input, dt float)
        if gfx.down(input, Right)
            x += 10.0 * dt
        self.moving = gfx.down(input, Right)

    fn draw(self, mut f gfx.Frame)
        gfx.clear(mut f, 0)
        gfx.rect(mut f, self.x, 5.0, 4.0, 4.0, 16711680)

fn main()
    mut p := Player(x: 0.0, moving: false)
    steps := [[app.key("right")], [], [gfx.key_up(Right)]]
    lines := gfx.script(mut p, 32, 16, 0.5, steps)
    for l in lines
        print(l)
    i := gfx.next_input(gfx.idle(), [app.key("a")])
    print(gfx.pressed(i, Text("a")))
    j := gfx.next_input(i, [])
    print("{gfx.pressed(j, Text("a"))} {gfx.down(j, Text("a"))}")
    k := gfx.next_input(j, [gfx.key_up(Text("a"))])
    print(gfx.released(k, Text("a")))
    mut f := gfx.new_frame(8, 4)
    gfx.line(mut f, 0.0, 0.0, 7.0, 3.0, 255)
    gfx.text(mut f, 1.0, 1.0, "hi", 12.0, 65280)
    print(gfx.dump(f))
    print(gfx.cmd_text(f.cmds[0]))
    st := gfx.stats(f)
    print("{st.cmds} {st.fills} {st.lines} {st.texts}")
