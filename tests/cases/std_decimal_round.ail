## std.decimal.5-6: rounding modes by `round` and `divide`.
use std.decimal

fn cut(text str, mode decimal.Rounding) str
    d := decimal.parse(text) else err
        return "{err}"
    r := d.round(0, mode) else err
        return "{err}"
    "{r}"

fn row(mode decimal.Rounding)
    mut cells := List[str]()
    for t in ["2.5", "-2.5", "1.6", "-1.6", "1.1", "-1.1", "-0.4"]
        cells.push(cut(t, mode))
    print("{mode.name()}: {cells.join(" ")}")

fn scaled(text str, mode decimal.Rounding)
    d := decimal.parse(text) else err
        print("{err}")
        return
    r := d.round(2, mode) else err
        print("{err}")
        return
    print("{text} {mode.name()} -> {r}")

fn quotient(a str, b str, scale int, mode decimal.Rounding)
    x := decimal.parse(a) else err
        print("{err}")
        return
    y := decimal.parse(b) else err
        print("{err}")
        return
    q := x.divide(y, scale, mode) else err
        print("{err}")
        return
    print("{a} / {b} at {scale} {mode.name()} = {q}")

fn main()
    for m in decimal.Rounding.variants()
        row(m)
    scaled("1.005", decimal.Rounding.HalfEven)
    scaled("1.005", decimal.Rounding.HalfUp)
    scaled("1.015", decimal.Rounding.HalfEven)
    scaled("1.5", decimal.Rounding.Down)
    scaled("-1.001", decimal.Rounding.Floor)
    quotient("10", "3", 4, decimal.Rounding.HalfEven)
    quotient("2", "3", 4, decimal.Rounding.HalfEven)
    quotient("2", "3", 4, decimal.Rounding.Down)
    quotient("-7", "2", 0, decimal.Rounding.HalfEven)
    quotient("-7", "2", 0, decimal.Rounding.HalfDown)
    quotient("-7", "2", 0, decimal.Rounding.Floor)
    quotient("-7", "2", 0, decimal.Rounding.Ceiling)
    quotient("1.50", "0.25", 2, decimal.Rounding.Down)
    quotient("100", "8", 1, decimal.Rounding.Down)
    quotient("100.00", "3", 2, decimal.Rounding.HalfEven)
    quotient("1", "0", 2, decimal.Rounding.Down)
