## std.png.11 and std.png.12: broken APNG files fail with `PngError`, never a trap. Each file is a copy of a Pillow-made APNG
## (3 frames, `basic` of std_apng_decode) with one chunk changed and its CRC-32 recomputed, so only that fault is read.
use std.image.png

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    anim := png.decode_animation(b) else err
        print("{name}: {err.kind.name()}")
        return
    print("{name}: ok {anim.width}x{anim.height} loops {anim.loops} frames {anim.frames.len()}")

fn main()
    show(
        "fctl sequence",
        "",
    )
    show(
        "frame count",
        "",
    )
    show(
        "outside canvas",
        "",
    )
    show(
        "dispose op",
        "",
    )
    show(
        "first frame",
        "",
    )
    show(
        "actl size",
        "",
    )
    show(
        "missing fdat",
        "",
    )
    show(
        "zero frames",
        "",
    )
    show(
        "fdat sequence",
        "",
    )
    show(
        "fctl size",
        "",
    )
    show(
        "fdat data",
        "",
    )
    show(
        "crc",
        "",
    )
    show(
        "truncated",
        "89504e470d0a1a0a0000000d4948445200000008000000060806000000fe05dffb000000086163544c0000000300000000ceedbac00000001a666354",
    )
    show("not png", "474946383961")
    show(
        "actl after idat",
        "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a0000001349444154789c63646462fecf00054c0c48000016c60109b31cbffa000000086163544c0000000200000000f38d93700000000049454e44ae426082",
    )
    show(
        "actl without fctl",
        "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a000000086163544c0000000100000005c4471d2f0000001349444154789c63646462fecf00054c0c48000016c60109b31cbffa0000000049454e44ae426082",
    )
