fn main()
    n := 255
    m := -255
    z := 0
    x := 1234567.891
    print("[{n:08}][{m:08}][{n:b}][{n:010b}][{n:+}][{z:+}][{m:+}]")
    print("[{1234567:,}][{-1234:,}][{999:,}][{x:,.2}][{x:+,.1}]")
    print("[{1234.5:e}][{0.00123:e}][{1234.5:.2e}][{0.0:e}][{-1234.5:e}][{1234.5:12.1e}][{9.99:.1e}]")
    print("[{n:+08}][{n:*>+8}][{n:x}][{n:08x}]")
