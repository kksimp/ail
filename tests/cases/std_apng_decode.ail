## std.png.11 to std.png.13: APNG files read by `decode_animation`. The frames of the files made by Pillow's APNG writer
## (libpng chunks) are checked against the frames it was given or its own reader (`basic`, `dispose_bg_over`,
## `dispose_prev_over`, `over_none`, `rgb`, `default_hidden`, `still`); `semi`, `semi_clear`, `interlaced`, `palette_trns` and
## `gray_hidden` are hand-assembled (sub-rectangles, translucent blend, Adam7 frames, a palette with `tRNS`, a default image
## outside the animation, a delay denominator of 0) and checked with an exact-fraction implementation of the specification's
## blend rounded to nearest. Each frame is the canvas as it looks when shown: delay, size and the CRC-32 of its RGBA pixels.
## `decode` gives the default image.
use std.image.png

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    anim := png.decode_animation(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: canvas {anim.width}x{anim.height} loops {anim.loops} frames {anim.frames.len()}")
    for i, f in anim.frames.enumerate()
        print("  {i}: {f.delay_ms}ms {f.img.width}x{f.img.height} crc {hash.crc32(f.img.pixels)}")
    first := png.decode(b) else err
        print("  decode: {err.kind.name()}")
        return
    print("  decode: {first.width}x{first.height} crc {hash.crc32(first.pixels)}")

fn main()
    show(
        "basic",
        "",
    )
    show(
        "dispose_bg_over",
        "",
    )
    show(
        "dispose_prev_over",
        "",
    )
    show(
        "over_none",
        "",
    )
    show(
        "rgb",
        "",
    )
    show(
        "default_hidden",
        "",
    )
    show(
        "still",
        "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a0000001349444154789c63646462fecf00054c0c48000016c60109b31cbffa0000000049454e44ae426082",
    )
    show(
        "semi",
        "",
    )
    show(
        "semi_clear",
        "",
    )
    show(
        "interlaced",
        "",
    )
    show(
        "palette_trns",
        "",
    )
    show(
        "gray_hidden",
        "",
    )
