struct Item
    name str
    cents int

fn total(items List[Item]) int
    mut sum := 0
    for it in items
        sum += it.cents
    sum

fn label(n int) str
    "total {n}"

@test fn sums()
    assert_eq(total([Item(name: "pen", cents: 5)]), 5)

fn main()
    items := [Item(name: "pen", cents: 120), Item(name: "ink", cents: 80)]
    print(label(total(items)))
