## type.num.17, type.num.18: integer math, float classification and the `float` constants.
fn main()
    print(12.gcd(18))
    print((0 - 12).gcd(18))
    print(0.gcd(0))
    print(0.gcd(7))
    print(17.gcd(5))
    print(4.lcm(6))
    print((0 - 4).lcm(6))
    print(0.lcm(5))
    print(21.lcm(6))
    print(0.isqrt())
    print(15.isqrt())
    print(16.isqrt())
    print(99.isqrt())
    print(9223372036854775807.isqrt())
    print(1.is_pow2())
    print(64.is_pow2())
    print(96.is_pow2())
    print(0.is_pow2())
    print((0 - 8).is_pow2())
    print(1.log2())
    print(1023.log2())
    print(1024.log2())
    print(9223372036854775807.log2())
    print(8.0.log2())
    print(0.5.log2())
    print(1.0.log2())
    print((0.0 / 0.0).is_nan())
    print(1.0.is_nan())
    print(1.0.is_finite())
    print((1.0 / 0.0).is_finite())
    print((0.0 / 0.0).is_finite())
    print((0.0 - 1.0 / 0.0).is_infinite())
    print(1.0.is_infinite())
    print(float.PI)
    print(float.E)
    print(float.TAU)
    print(float.INF)
    print(float.NAN.is_nan())
    print(float.TAU == 2.0 * float.PI)
    print(float.INF.is_infinite())
