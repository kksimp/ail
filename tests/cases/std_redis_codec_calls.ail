## std.redis.2, 10: Pipeline.add_bytes and Reply.is_push, against RESP2 framing
## (*N, then $LEN and the bytes for each argument, all ended by CRLF).
use std.db.redis

fn main()
    cmd := redis.encode_bytes([b"SET", b"k", b"\x00\xff"])
    print(cmd.hex())
    print(cmd == redis.encode(["SET", "k", "ÿ"]))
    mut p := redis.pipeline()
    p.add_bytes([b"GET", b"k"])
    p.add(["PING"])
    print(p.len())
    print(redis.Reply.Push([redis.Reply.Int(1)]).is_push())
    print(redis.Reply.Int(1).is_push())
    print(redis.Reply.Nil.is_push())
    print(redis.Reply.Array([]).is_push())
