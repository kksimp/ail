# contract.prove.1-2 (ADR 1055): every check here is proved and left out; the
# program prints what it would with every check in place.
fn at(xs List[int], i int) int
    requires i >= 0
    requires i < xs.len()
    xs[i]

fn digit(n int) int
    requires n >= 0
    ensures result >= 0
    ensures result < 10
    n % 10

fn clamp_low(n int) int
    ensures result >= 0
    if n < 0
        return 0
    n

fn total(xs List[int]) int
    mut sum := 0
    for i in 0..xs.len()
        sum += at(xs, i)
    sum

fn main()
    xs := [3, 1, 4, 1, 5]
    print(total(xs))
    k := 42
    print(digit(k))
    print(clamp_low(-3))
    print(clamp_low(7))
    n := xs.len()
    if n > 2
        print(at(xs, n - 1))
