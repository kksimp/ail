## std.mysql.9, std.mysql.10, std.mysql.15: connect_with and exec_stmt against a scripted server that
## speaks the MySQL protocol (HandshakeV10, OK, the SET NAMES utf8mb4 query and its OK, COM_STMT_PREPARE OK, COM_STMT_EXECUTE OK), and
## tls_from_text for each ssl-mode the spec names.
use std.net
use std.db.mysql

fn le(n int, width int) bytes
    mut h := List[u8]()
    for i in 0..width
        h.push_u8(if i < 8 then (n >> (8 * i)).bit_and(255) else 0)
    bytes.from_list(h)

fn pkt(seq int, body bytes) bytes
    le(body.len(), 3) + le(seq, 1) + body

fn serve(l net.Listener) str ! net.NetError
    c := l.accept()?
    mut seen := List[str]()
    hello := b"\x0a8.0.test\x00"
        + le(77, 4)
        + b"abcdefgh\x00"
        + le(32768, 2)
        + b"\x2d"
        + le(2, 2)
        + le(8, 2)
        + b"\x15"
        + le(0, 10)
        + b"ijklmnopqrst\x00"
        + b"mysql_native_password\x00"
    c.write_bytes(pkt(0, hello))?
    login := c.read_bytes(4096)?
    seen.push("login seq={login[3]} user={login.text().contains("ann")}")
    c.write_bytes(pkt(2, b"\x00\x00\x00" + le(2, 2) + le(0, 2)))?
    names := c.read_bytes(4096)?
    seen.push("names seq={names[3]} cmd={names[4]} {names[5..names.len()].text()}")
    c.write_bytes(pkt(1, b"\x00\x00\x00" + le(2, 2) + le(0, 2)))?
    prep := c.read_bytes(4096)?
    seen.push("prepare seq={prep[3]} cmd={prep[4]} {prep[5..prep.len()].text()}")
    c.write_bytes(
        pkt(
            1,
            b"\x00" + le(9, 4) + le(0, 2) + le(1, 2) + b"\x00" + le(0, 2),
        ) + pkt(2, b"\x03def") + pkt(3, b"\xfe" + le(0, 2) + le(2, 2)),
    )?
    exec := c.read_bytes(4096)?
    seen.push("execute seq={exec[3]} cmd={exec[4]} id={exec.u32_le(5)}")
    c.write_bytes(pkt(1, b"\x00\x03\x00" + le(2, 2) + le(0, 2)))?
    c.close()
    seen.join("\n")

fn kind_of(text str) str
    t := mysql.tls_from_text(text) else err
        return "error {err.kind.name()}"
    "{t == mysql.Tls.Disable} {t == mysql.Tls.Prefer} {t == mysql.Tls.Require}"

fn main() !
    for s in [
        "disable",
        "DISABLED",
        "prefer",
        "preferred",
        "require",
        "required",
        "verify-ca",
        "verify_identity",
        "bogus",
    ]
        print("{s}: {kind_of(s)}")
    l := net.listen("127.0.0.1:0")?
    port := (l.addr().split(":").last() else "0").to_int() else 0
    t := spawn serve(l)
    cfg := mysql.Config(
        host: "127.0.0.1",
        port: port,
        user: "ann",
        password: "",
        database: "db",
        timeout_ms: 5000,
        tls: mysql.Tls.Disable,
    )
    mut c := mysql.connect_with(cfg)?
    s := c.prepare("UPDATE t SET a = ?")?
    print("stmt id={s.id} params={s.params} columns={s.columns}")
    n := c.exec_stmt(s, [mysql.Value.Int(5)])?
    print("affected {n}")
    c.close()
    print(t.wait()?)
    l.close()
