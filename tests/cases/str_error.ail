## err.str.1, err.str.3 (ADR 1129): `T ! str` fails with text.
fn parse(s str) int ! str
    n := s.to_int() else return "not a number: {s}"
    if n < 0
        return "negative"
    n

fn double(s str) int ! str
    n := parse(s)?
    n * 2

fn why(k int) str
    "reason {k}"

fn pick(k int) int ! str
    text := why(k)
    if k > 1
        return text
    if k > 0
        return text.to_upper()
    k

fn from_fs() int ! str
    text := fs.read_text("/no/such/file/str_error")?
    text.len()

fn show(s str)
    n := double(s) else e
        print("failed: {e}")
        return
    print(n)

fn main()
    show("21")
    show("-3")
    show("x")
    for k in 0..3
        v := pick(k) else e
            print("pick {e}")
            continue
        print(v)
    n := from_fs() else e
        print("fs failed: {e.len() > 0}")
        return
    print(n)
