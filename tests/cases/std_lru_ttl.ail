## std.lru.6-7: the cache whose entries expire.
use std.time

fn main()
    mut t := lru.Ttl[str, int].new(3, 10)
    t.put_at("a", 1, 0)
    t.put_at("b", 2, 4_000_000)
    print(t.get_at("a", 9_999_999) else -1)
    print(t.get_at("a", 10_000_000) else -1)
    print(t.len())
    print(t.get_at("b", 13_000_000) else -1)
    t.put_at("b", 3, 13_000_000)
    print(t.get_at("b", 20_000_000) else -1)
    t.put_at("c", 4, 20_000_000)
    t.put_at("d", 5, 20_000_000)
    print(t.len())
    t.put_at("e", 6, 21_000_000)
    print(t.get_at("b", 21_000_000) else -1)
    print(t.purge_at(35_000_000))
    print(t.len())
    mut live := lru.Ttl[str, int].new(2, 1000)
    live.put("x", 1)
    print(live.get("x") else -1)
    mut brief := lru.Ttl[str, int].new(2, 5)
    brief.put("y", 2)
    time.sleep_ms(50)
    print(brief.contains("y"))
    print(brief.get("y") else -1)
    print(brief.len())
