## std.protobuf.5, 7, 8, 9: fixed64, bytes and zigzag fields, against the encoding in the protobuf
## guide (tag = num << 3 | wire type; zigzag maps 0,-1,1,-2 to 0,1,2,3; fixed64 is 8 bytes little endian).
use std.protobuf

fn main() !
    mut m := protobuf.Message(fields: [])
    m.add_fixed64(3, 1)
    m.add_bytes(2, b"\x01\x02")
    m.add_sint(4, -1)
    m.add_sint(4, 2)
    m.add_sint(4, -3)
    m.add_fixed64(5, -2)
    wire := protobuf.encode(m)
    print(wire.hex())
    d := protobuf.decode(wire)?
    print(d.get_fixed64(3)?)
    print(d.get_fixed64(5)?)
    print(d.get_fixed64(9) else 0)
    print(d.sints(4)?)
    print(d.ints(4)?)
