## std.net.web.9: CORS headers on answers, preflights, and the OPTIONS route.
use std.net
use std.net.http
use std.net.web

fn req(method str, headers Map[str, str]) http.Req
    http.Req(
        method: method,
        path: "/x",
        query: {},
        headers: headers,
        body: "",
        peer: "",
        data: b"",
        server: -1,
        params: {},
    )

fn hello(r http.Req) net.Response
    http.text(200, "hi")

fn header(resp net.Response, name str) str
    resp.headers.get(name) else "-"

fn main() !
    opts := web.cors_opts(origins: ["https://app.example"], credentials: true, expose: ["x-total"])
    h := web.cors(opts, hello)

    allowed := h(req("GET", {"origin": "https://app.example"}))
    print(allowed.body)
    print(header(allowed, "access-control-allow-origin"))
    print(header(allowed, "access-control-allow-credentials"))
    print(header(allowed, "access-control-expose-headers"))
    print(header(allowed, "vary"))

    denied := h(req("GET", {"origin": "https://evil.example"}))
    print(denied.body)
    print(header(denied, "access-control-allow-origin"))
    print(header(denied, "vary"))

    pre := h(req("OPTIONS", {
        "origin": "https://app.example",
        "access-control-request-method": "PUT",
        "access-control-request-headers": "content-type,x-token",
    }))
    print(pre.status)
    print("[{pre.body}]")
    print(header(pre, "access-control-allow-origin"))
    print(header(pre, "access-control-allow-methods"))
    print(header(pre, "access-control-allow-headers"))
    print(header(pre, "access-control-max-age"))
    print(header(pre, "access-control-allow-credentials"))

    bad := h(req("OPTIONS", {
        "origin": "https://app.example",
        "access-control-request-method": "TRACE",
    }))
    print("{bad.status} {header(bad, "access-control-allow-origin")}")

    any_h := web.cors(web.cors_opts(), hello)
    wild := any_h(req("GET", {"origin": "https://x.example"}))
    print(header(wild, "access-control-allow-origin"))
    print(header(wild, "vary"))
    cred_h := web.cors(web.cors_opts(credentials: true), hello)
    cred := cred_h(req("GET", {"origin": "https://x.example"}))
    print(header(cred, "access-control-allow-origin"))

    mut r := http.router()
    web.preflight(mut r, opts)
    served := r.handle(net.Request(
        method: "OPTIONS",
        path: "/api/items/7",
        query: {},
        headers: {"origin": "https://app.example", "access-control-request-method": "DELETE"},
        body: "",
        peer: "",
        data: b"",
        server: -1,
    ))
    print(served.status)
    print(header(served, "access-control-allow-origin"))
