## std.jpeg.1, std.jpeg.3: baseline JPEGs made by libjpeg-turbo (through Pillow), each
## checked by a digest of libjpeg-turbo's own RGBA decode. The pictures are synthetic
## gradients and noise, no licence attached.
use std.image.jpeg

fn digest(b bytes) int
    mut h := 0
    for x in b
        h = (h * 31 + x.to_int()) % 1000000007
    h

fn show(label str, hex str)
    data := bytes.from_hex(hex) else b""
    img := jpeg.decode(data) else err
        print("{label}: {err}")
        return
    print("{label}: {img.width}x{img.height} {digest(img.pixels)}")

