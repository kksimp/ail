## std.cron.7, std.cron.8: schedules read in a time zone, across clock changes.
use std.time.date

fn when(t int?, zone str) str
    x := t else return "none"
    z := date.at(x, zone) else return "bad zone"
    z.iso()

fn run(expr str, zone str, start_text str, count int)
    s := cron.parse(expr) else return
    z := s.in_zone(zone) else err
        print("[{expr}] {err.kind.name()}: {err}")
        return
    start := date.parse_iso(start_text) else return
    print("[{expr}] in {z.zone}")
    for t in z.upcoming(start.unix_ms(), count)
        print("  {when(t, zone)}")

fn back(expr str, zone str, start_text str)
    s := cron.parse(expr) else return
    z := s.in_zone(zone) else return
    start := date.parse_iso(start_text) else return
    print("[{expr}] before {start_text} in {zone}: {when(z.prev(start.unix_ms()), zone)}")

fn main()
    # New York springs forward on 2026-03-08: 02:30 does not exist that day
    run("30 2 * * *", "America/New_York", "2026-03-06T12:00:00Z", 4)
    # and falls back on 2026-11-01: 01:30 happens twice and fires once, the first time
    run("30 1 * * *", "America/New_York", "2026-10-30T12:00:00Z", 4)
    run("*/30 * * * *", "America/New_York", "2026-11-01T04:40:00Z", 6)
    run("0 9 * * MON-FRI", "Asia/Kolkata", "2026-11-27T04:00:00Z", 3)
    run("0 0 * * *", "+05:30", "2026-11-27T04:00:00Z", 2)
    run("30 2 * * *", "Australia/Sydney", "2026-10-02T00:00:00Z", 4)
    run("0 12 * * *", "Mars/Base", "2026-11-27T04:00:00Z", 1)
    back("30 2 * * *", "America/New_York", "2026-03-09T12:00:00Z")
    back("30 2 * * *", "America/New_York", "2026-03-09T06:30:00Z")
    back("30 1 * * *", "America/New_York", "2026-11-02T12:00:00Z")
    back("0 0 * * *", "Asia/Kolkata", "2026-11-27T04:00:00Z")
