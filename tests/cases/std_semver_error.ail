## std.semver.2, std.semver.6, std.semver.12: what is rejected, and the kind.
use std.semver

fn try_version(text str)
    v := semver.parse(text) else err
        print("[{text}]: {err.kind.name()}: {err}")
        return
    print("[{text}]: ok {v}")

fn try_range(text str)
    r := semver.parse_range(text) else err
        print("[{text}]: {err.kind.name()}: {err}")
        return
    print("[{text}]: ok {r.text}")

fn main()
    try_version("")
    try_version("1.2")
    try_version("1.2.3.4")
    try_version("v1.2.3")
    try_version("01.2.3")
    try_version("1.x.3")
    try_version("1..3")
    try_version("1.2.99999999999999999999")
    try_version("1.2.3-")
    try_version("1.2.3-01")
    try_version("1.2.3-a_b")
    try_version("1.2.3+")
    try_version("1.2.3+a..b")
    try_version("1.2.3-rc.1+007")
    try_version("1.2.3-alpha-1")
    try_version("10.20.30")
    try_range("^")
    try_range("1.2.3.4")
    try_range(">=1.2.a")
    try_range("1.2.3-")
    try_range("^1.2 || ~2.0.1")
    try_range(">=1.0.0 <2")
