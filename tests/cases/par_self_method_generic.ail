## The generic case of par_self_method_call: `at(i)` in a method of `Shelf[T]`
## is a method of `self` too, though `Shelf[int].at` is instantiated only when
## a call needs it. The loop stays sequential (conc.par.8).

struct Shelf[T]
    items List[T]

fn Shelf.at(self, i int) T
    items[i]

fn Shelf.copy(self) List[T]
    mut out := List[T]()
    for i in 0..items.len()
        out.push(at(i))
    out

fn main()
    s := Shelf(items: [10, 20, 30])
    print(s.copy())
