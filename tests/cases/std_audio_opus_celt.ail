fn clicks_mono_64k() (int, List[str], List[int])
    packets := [
        "",
        "",
        "",
        "",
    ]
    expected := [
        0, -2, 39, -30, 39, -191, -10118, 4986, -9158, 6818, 540, -69,
        22, -22, -66, -42, 0, 0, 0, 5, -20, -24, -24, -23,
        -23, -23, -23, -22, -22, -21, -20, -20, -19, -19, -19, -19,
        -18, -21, -5, 0, 0, 0, 0, 0, 0, 0, 0, 0,
        -10, -148, -91, -377, -73, -83, -77, -83, -74, -70, -68, -66,
        -64, -66, -65, -63, -62, -60, -58, -57, -54, -53, -54, -54,
        -51,
    ]
    (1, packets, expected)

fn check(name str, clip (int, List[str], List[int]))
    channels, packets, expected := clip
    mut st := opus.celt_state(channels)
    mut got := List[float]()
    for h in packets
        data := bytes.from_hex(h) else b""
        c := opus.decode(mut st, data) else err
            print("{name}: {err}")
            return
        got.extend(c.samples)
    mut bad := 0
    for i in 0..expected.len()
        v := (got[i * 53] * 32768.0).round().to_int().max(-32768).min(32767)
        if (v - expected[i]).abs() > 1
            bad += 1
    print("{name}: {got.len()} samples, {bad} of {expected.len()} off by more than 1")

fn main()
    check("tone_stereo_64k", tone_stereo_64k())
    check("tone_stereo_10ms", tone_stereo_10ms())
    check("clicks_mono_64k", clicks_mono_64k())
    mut st := opus.celt_state(1)
    silk := opus.decode(mut st, bytes.from_hex("0800") else b"") else err
        print(err)
        return
    print(silk.samples.len())
