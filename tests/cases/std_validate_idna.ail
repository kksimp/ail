## std.validate.2, std.validate.3: Punycode and IDNA.
use std.validate

fn try_ascii(s str)
    a := validate.to_ascii(s) else err
        print("[{s}] {err.kind.name()}")
        return
    u := validate.to_unicode(a) else err
        print("[{s}] {a} unicode: {err.kind.name()}")
        return
    print("[{s}] {a} {u}")

fn try_decode(s str)
    d := validate.punycode_decode(s) else err
        print("[{s}] {err.kind.name()}")
        return
    print("[{s}] {d}")

fn main()
    try_ascii("bücher.de")
    try_ascii("Example.COM")
    try_ascii("日本語.jp")
    try_ascii("münchen.de")
    try_ascii("straße.de")
    try_ascii("фото.рф")
    try_ascii("xn--mller-kva.de")
    try_ascii("a.b.c.d.example")
    try_ascii("BÜCHER.de")
    try_ascii("a_b.com")
    try_ascii("-a.com")
    try_ascii("a-.com")
    try_ascii("ab--cd.com")
    try_ascii("xn--x.de")
    try_ascii("xn--a.com")
    try_ascii("😀.com")
    try_ascii("a..b")
    try_ascii("ex ample.com")
    try_ascii("ΕΛΛΗΝΙΚΑ.gr")
    try_ascii("a.b.")
    try_ascii("")
    try_ascii("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com")
    try_ascii("bü_x.de")
    print(validate.punycode_encode("bücher"))
    try_decode("bcher-kva")
    print(validate.punycode_encode("münchen"))
    try_decode("mnchen-3ya")
    print(validate.punycode_encode("日本語"))
    try_decode("wgv71a119e")
    print(validate.punycode_encode("ü"))
    try_decode("tda")
    print(validate.punycode_encode("abc"))
    try_decode("abc-")
    print(validate.punycode_encode("a-b"))
    try_decode("a-b-")
    print(validate.punycode_encode("-"))
    try_decode("--")
    print(validate.punycode_encode("ЯЯЯ"))
    try_decode("70aaa")
    print(validate.punycode_encode("한국어"))
    try_decode("3e0bk47br7k")
    print(validate.punycode_encode("mañana"))
    try_decode("maana-pta")
    print(validate.punycode_encode("αβγ"))
    try_decode("mxacd")
    print(validate.punycode_encode("a😀b"))
    try_decode("ab-no82a")
    try_decode("!")
    try_decode("bcher-kv")
    try_decode("9999999999999")
    try_decode("-x")
    try_decode("ü")
    print(validate.is_domain("bücher.de"))
    print(validate.is_domain("a..b"))
