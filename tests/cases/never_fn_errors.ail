## type.never.1, type.never.3, err.else.1 and err.else.2 (ADR 1119):
## `never` only as a declared function's result, a body that reaches its
## end, `return` in a `never` function, and a fallback that returns no value.
## `int ! str` is legal since ADR 1129 (err.str.1), so `parse` adds no error.
use std.io

fn quit(why str) never
    io.eprint(why)

fn stop() never
    return

fn usage()
    io.eprint("usage: count N")
    io.exit(2)

fn parse(s str) int ! str
    if s == ""
        return "empty"
    s.len()

fn main()
    x := 3
    b := x == 3
    n := "4".to_int() else usage()
    k := "5".to_int() else
        usage()
    print(n + k)
    print(parse("abc") else 0)
    print(b)
    quit("x")
    stop()

fn keep(v never) int
    1
