# type.num.9: abs/floor/ceil/round/sqrt on inf, nan and signed zeros; chaining and method syntax on literals.
fn main()
    inf := 1.0 / 0.0
    nan := inf - inf
    print(inf.abs())
    print((-inf).abs())
    print(nan.abs())
    print(inf.floor())
    print((-inf).floor())
    print(inf.ceil())
    print((-inf).ceil())
    print(nan.floor())
    print(nan.ceil())
    print(inf.round())
    print((-inf).round())
    print(nan.round())
    print(inf.sqrt())
    print((-inf).sqrt())
    print(nan.sqrt())
    print((-0.0).sqrt())
    print((-0.0).abs())
    print((-1.0).sqrt())
    print(2.0.sqrt())
    print(4.0.sqrt())
    print(1e308.sqrt())
    print(5e-324.sqrt())
    print(2.0.sqrt() * 2.0.sqrt())
    print(2.0.sqrt() * 2.0.sqrt() == 2.0)
    print(1e300.floor())
    print((-1e300).ceil())
    print(1e300.round())
    print((-2.5).abs().round())
    print((-2.5).round().abs())
    print((-7.5).floor().abs().sqrt())
    # postfix binds tighter than unary minus
    print(-2.5.abs())
    print(-4.0.sqrt())
    x := -3.75
    print(x.abs())
    print(-x.abs())
    print(x.floor())
    print(x.ceil())
    print(x.round())
    print(x.abs().floor())
    print((x * x).sqrt())
    print((x * 2).abs() + 1)
