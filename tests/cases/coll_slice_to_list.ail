# type.coll.33, type.str.13: `xs.slice(a, b)`, `xs.slice(a)`, `s.slice(a)` and `s.to_list()`.
fn main()
    xs := [10, 20, 30, 40, 50]
    print(xs.slice(1, 3))
    print(xs.slice(3))
    print(xs.slice(5))
    print(xs.slice(0, 0))
    names := ["ann", "bob", "cy"]
    print(names.slice(1).join(","))
    print("Héllo".slice(1))
    print("Héllo".slice(1, 3))
    s := {3, 1, 2}
    ys := s.to_list()
    print(ys)
    print(ys.len())
    mut zs := s.to_list()
    zs.push(9)
    print(zs)
    print(s.len())
    e := Set[str]()
    print(e.to_list().len())
