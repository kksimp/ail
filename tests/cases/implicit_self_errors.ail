# trait.method.7: a bare call can't mean both a method and a function; a
# parameter may hide a field (ADR 1121).
struct Box
    size int

fn grow(n int) int
    n + 1

fn Box.grow(self) int
    size + 1

fn Box.resize(self, size int) int
    size

fn Box.twice(self) int
    grow() * 2

fn main()
    b := Box(size: 1)
    print(b.resize(2))
    print(b.twice())
