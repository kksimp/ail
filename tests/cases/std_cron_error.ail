## std.cron.2 and std.cron.12: what is rejected, and the kind.
use std.cron

fn try_expr(text str)
    s := cron.parse(text) else err
        print("[{text}]: {err.kind.name()}: {err}")
        return
    print("[{text}]: ok {s.seconds}")

fn main()
    try_expr("")
    try_expr("   ")
    try_expr("* * * *")
    try_expr("* * * * * * *")
    try_expr("61 * * * *")
    try_expr("* 24 * * *")
    try_expr("* * 0 * *")
    try_expr("* * * 13 *")
    try_expr("* * * * 8")
    try_expr("*/0 * * * *")
    try_expr("*/x * * * *")
    try_expr("*/ * * * *")
    try_expr("5-1 * * * *")
    try_expr("a * * * *")
    try_expr("MON * * * *")
    try_expr("1,,2 * * * *")
    try_expr("* * * foo *")
    try_expr("* * L * *")
    try_expr("-1 * * * *")
    try_expr("1-2-3 * * * *")
    try_expr("99999999999999999999 * * * *")
    try_expr("*/99999999999999999999 * * * *")
    try_expr("@reboot")
    try_expr("@every 5m")
    try_expr("60 * * * * *")
    try_expr("0 0 * * 7")
    try_expr("*/5 1-5/2 * * *")
    try_expr("0 0 * * * *")
    try_expr("  0 0 1 FEB-APR MON,wed  ")
