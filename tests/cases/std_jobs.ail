## std.jobs.1-3, std.jobs.8: a pool runs queued jobs by priority, then in the order submitted; the counts after.
fn handle(j jobs.Job) jobs.Outcome
    print("{j.name} {j.payload} p{j.priority} run {j.attempt}")
    jobs.done()

fn main() !
    mut p := jobs.pool(handle, 1)
    a := p.submit("a", "x")
    b := p.submit("b", "x", priority: 5)
    c := p.submit("c", "x", priority: 5)
    d := p.submit("d", "x", priority: 1)
    print("{a} {b} {c} {d}")
    print(p.stats().pending)
    p.start()
    print(p.wait_idle(5000))
    st := p.stats()
    print("done {st.done} pending {st.pending} running {st.running} dead {st.dead}")
    p.stop()?
