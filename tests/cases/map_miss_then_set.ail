## A missed `get` followed by a store, and `+=` on new keys, with the key set
## again after other keys were added (type.map.1, type.map.7).
fn main()
    mut m := Map[str, int]()
    names := ["a", "b", "c", "a", "d", "b", "a"]
    for w in names
        c := m.get(w) else 0
        m[w] = c + 1
    print(m)
    mut n := Map[int, int]()
    for i in 0..40
        n[i % 7] += i
    print(n.len())
    print(n[3])
    mut s := Set[str]()
    for w in names
        s.add(w)
    print(s.len())
    k := "z"
    z := m.get(k) else -1
    m["q"] = 1
    m[k] = z
    m[k] = z + 1
    print(m)
