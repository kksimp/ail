## std.webp.15 to std.webp.17: WebP files with an ALPH chunk next to a lossy image: raw and lossless-coded alpha, the
## horizontal, vertical and gradient prediction filters, level quantization, and a lossless image with alpha. The expected
## pixels are what libwebp decodes (RGBA, not premultiplied).
use std.image.webp

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    inf := webp.info(b) else err
        print("{name}: info {err.kind.name()}: {err.why}")
        return
    img := webp.decode(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: {inf.width}x{inf.height} lossless {inf.lossless} alpha {inf.alpha} animated {inf.animated}")
    if img.width != inf.width or img.height != inf.height
        print("size differs")
    if img.pixels.len() <= 400
        print(img.pixels.hex())
    else
        print("crc {hash.crc32(img.pixels)}")

fn main()
    show("alpha ll", "")
    show("alpha raw", "")
    show("alpha quant", "524946468c00000057454250565038580a000000100000000c0000080000414c504821000000114f2024204356a84444709e27880420b2e6822d2ed8e282f10e44f43f28a7c30f005650382044000000d001009d012a0d00090002804225b00274010ed38b200000fee87c34b684d7d2969e8865dafc3a85bff98c7c3468731918848a03f5967b9affc29577fff079917f7cd000")
    show("alpha checks ll", "")
    show("alpha filter horizontal", "")
    show("alpha filter vertical", "")
    show("alpha filter gradient", "")
    show("lossless alpha", "524946467c000000574542505650384c6f0000002f08800110993244f43f3611d1ff70308a2449d1cdf977c9fc631a1b5db1108cdb4852e47d311f857ba9ab6ddb86c55c5244906d539df9c31ce771fcf22fff97f7c973b56be4aa3962f650aff1e1c50f21d80c91011cab811c100a84c1ec07c12948c61b033964105486820c50220000")
