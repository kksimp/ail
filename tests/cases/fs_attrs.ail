## std.fs.27 to std.fs.32: mode, set_mode, set_modified, read_link, symlink, truncate.
## A link may be refused on Windows (permission or other), so the link check
## prints the same line either way.
fn main() !
    base := "{env.get("TMPDIR") else env.get("TEMP") else "/tmp"}/ail-fs-attrs-case"
    fs.make_dir(base)?
    f := "{base}/a.txt"
    fs.write_text(f, "0123456789")?
    m := fs.mode(f)?
    print(m >= 0 and m <= 4095)
    fs.set_mode(f, m.bit_and(4095 - 128))?
    print(fs.mode(f)?.bit_and(128) == 0)
    fs.set_mode(f, m.bit_or(128))?
    print(fs.mode(f)?.bit_and(128) != 0)
    fs.set_modified(f, 1700000000000)?
    print(fs.metadata(f)?.modified_ms)
    fs.truncate(f, 4)?
    print(fs.read_text(f)?)
    fs.truncate(f, 6)?
    print(fs.read_bytes(f)?.len())
    l := "{base}/link"
    mut link_ok := false
    fs.symlink("a.txt", l) else err
        link_ok = err.kind == "permission" or err.kind == "other"
    if not link_ok
        link_ok = fs.read_link(l)? == "a.txt" and fs.read_bytes(l)?.len() == 6
        fs.remove(l)?
    print("link {if link_ok then "ok" else "wrong"}")
    fs.read_link(f) else err
        print(err.kind)
    fs.mode("{base}/missing") else err
        print(err.kind)
    fs.set_modified("{base}/missing", 0) else err
        print(err.kind)
    fs.truncate("{base}/missing", 0) else err
        print(err.kind)
    fs.remove(f)?
    fs.remove(base)?
