## std.validate.4 to std.validate.8: email addresses.
use std.validate

fn try_email(s str)
    e := validate.email(s) else err
        print("[{s}] {err.kind.name()}")
        return
    print("[{s}] {e.local} {e.domain} {e.unicode_domain} {e.smtputf8} {e}")

fn main()
    try_email("a@example.com")
    try_email("User.Name+tag@Example.COM")
    try_email("user@bücher.de")
    try_email("jörg@müller.de")
    try_email("日本語@日本語.jp")
    try_email("a@xn--bcher-kva.de")
    try_email("a@xn--bcher-kva.DE")
    try_email("A@X.COM")
    try_email("a+b@x.io")
    try_email("a@123.com")
    try_email("a@x.c0m")
    try_email("a@x.example")
    try_email("😀@x.com")
    try_email("tést@exämple.org")
    try_email("!#$%&'*+-/=?^_`\{|}~@x.com")
    try_email("a@sub.domain.example.org")
    try_email("a@b")
    try_email("a@localhost")
    try_email("a@example.test")
    try_email("a@x.invalid")
    try_email("a@x.local")
    try_email("a@x.onion")
    try_email("a@x.arpa")
    try_email("a@sub.test")
    try_email("a..b@x.com")
    try_email(".a@x.com")
    try_email("a.@x.com")
    try_email("a b@x.com")
    try_email("\"a b\"@x.com")
    try_email("a@[1.2.3.4]")
    try_email("a@1.2.3.4")
    try_email("a@-x.com")
    try_email("a@x-.com")
    try_email("a@x..com")
    try_email("Name <a@x.com>")
    try_email("a@b.co.")
    try_email("@x.com")
    try_email("a@")
    try_email("a@ex_ample.com")
    try_email("a@x.123")
    try_email("x@y@z.com")
    try_email("a@x.co m")
    try_email("a@😀.com")
    try_email("no-at-sign")
    try_email("")
    try_email("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@x.com")
    try_email("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa@x.com")
    try_email("a@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com")
    try_email("a@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com")
    try_email("a@x.com.")
    try_email("a@.com")
    try_email("a@xn--p1ai")
    try_email("ab@ÄÖ.com")
    print(validate.is_email("a@example.com"))
    print(validate.is_email("a@b"))
