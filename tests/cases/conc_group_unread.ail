# conc.task.8: an error of a task that `wait_all` never read ends the program
# when the group's block ends, as an error that reached `main` does (ADR 1209).

error struct Lost "lost {n}"
    n int

fn fetch(n int) int ! Lost
    if n == 2
        return Lost(n: n)
    n

fn start()
    g := TaskGroup[int ! Lost]()
    for n in 1..=3
        g.add(spawn fetch(n))
    print("started")

fn main()
    start()
    print("not reached")
