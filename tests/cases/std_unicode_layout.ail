## std.unicode.9-12: character and text width, line segments, word segments and words.
fn show(xs List[str]) str
    xs.join("|").replace("\n", "/")

fn main()
    # std.unicode.9: char_width and east_asian_width
    print(unicode.char_width('a'))
    print(unicode.char_width('日'))
    print(unicode.char_width(char.from_code(0x301) else ' '))
    print(unicode.char_width(char.from_code(0x1F600) else ' '))
    print(unicode.char_width(char.from_code(0) else ' '))
    print(unicode.char_width(char.from_code(0x200B) else ' '))
    print(unicode.char_width(char.from_code(0xAD) else ' '))
    print(unicode.char_width(char.from_code(0xFF71) else ' '))
    print(unicode.char_width(char.from_code(0xFF21) else ' '))
    print(unicode.char_width(char.from_code(0x1161) else ' '))
    print(unicode.east_asian_width('a'))
    print(unicode.east_asian_width('日'))
    print(unicode.east_asian_width(char.from_code(0xFF71) else ' '))
    print(unicode.east_asian_width(char.from_code(0xFF21) else ' '))
    print(unicode.east_asian_width('é'))
    print(unicode.east_asian_width(char.from_code(0x2603) else ' '))
    print(unicode.east_asian_width(char.from_code(0x378) else ' '))
    # std.unicode.10: width
    print(unicode.width(""))
    print(unicode.width("hello"))
    print(unicode.width("日本語"))
    print(unicode.width("a\tb"))
    print(unicode.width("e\u{301}"))
    print(unicode.width("abc\u{301}\u{301}d"))
    print(unicode.width("\u{1F600}"))
    print(unicode.width("\u{1F1EB}\u{1F1F7}"))
    print(unicode.width("\u{1F1EB}\u{1F1F7}\u{1F1E9}\u{1F1EA}"))
    print(unicode.width("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}"))
    print(unicode.width("\u{2764}"))
    print(unicode.width("\u{2764}\u{FE0F}"))
    print(unicode.width("1\u{FE0F}\u{20E3}"))
    print(unicode.width("\u{AC01}"))
    print(unicode.width("\u{1100}\u{1161}\u{11A8}"))
    print(unicode.width("\u{915}\u{94D}\u{937}"))
    print(unicode.width("\u{FF21}\u{FF22}"))
    print(unicode.width("\u{200B}"))
    # std.unicode.11: line_segments
    print(show(unicode.line_segments("The quick brown fox-jumps over\nthe lazy dog.")))
    print(show(unicode.line_segments("Price: $1,234.50 (5%) -- ok")))
    print(show(unicode.line_segments("\u{65E5}\u{672C}\u{8A9E}\u{3001}\u{3067}\u{3059}\u{3002}")))
    print(show(unicode.line_segments("a\u{A0}b c")))
    print(show(unicode.line_segments("http://example.com/a-b")))
    print(show(unicode.line_segments("end.  Next")))
    print(unicode.line_segments("").len())
    print(unicode.line_segments("one").len())
    print(unicode.line_segments("a b c").join("").len())
    # std.unicode.12: word_segments and words
    print(show(unicode.word_segments("Hello, world!")))
    print(show(unicode.word_segments("can't stop 3.14")))
    print(show(unicode.word_segments("foo_bar  baz")))
    print(show(unicode.word_segments("\u{65E5}\u{672C}\u{8A9E}")))
    print(show(unicode.word_segments("\u{1F1EB}\u{1F1F7}\u{1F1E9}\u{1F1EA}")).len())
    print(show(unicode.words("Hello, world! 3.14 can't e\u{301}cole")))
    print(unicode.words("... --- !!!").len())
    print(unicode.word_segments("").len())
