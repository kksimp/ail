## std.lru.1-5: the least recently used cache.
use std.lru

fn main()
    mut c := lru.Cache[str, int].new(2)
    c.put("a", 1)
    c.put("b", 2)
    print(c.get("a") else -1)
    c.put("c", 3)
    print(c.contains("b"))
    print(c.get("b") else -1)
    print(c.keys().join(","))
    print(c.peek("a") else -1)
    c.put("d", 4)
    print(c.keys().join(","))
    print(c.len())
    print(c.remove("c"))
    print(c.remove("zz"))
    print(c.keys().join(","))
    c.put("e", 5)
    c.put("f", 6)
    print(c.keys().join(","))
    c.put("e", 50)
    print(c.get("e") else 0)
    print(c.keys().join(","))
    c.clear()
    print(c.len())
    c.put("x", 9)
    print(c.keys().join(","))
    small := lru.Cache[int, int].new(0)
    print(small.capacity())
    mut one := small
    one.put(1, 10)
    one.put(2, 20)
    print(one.len())
    print(one.get(1) else -1)
    print(one.get(2) else -1)
