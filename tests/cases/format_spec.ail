fn main()
    x := 3.14159
    n := 255
    s := "ab"
    print("[{x:.2}][{x:8.3}][{n:x}][{n:0>6x}][{s:^6}][{s:*<5}][{n:>5}][{s:>4}]")
    print("[{-n:x}][{2.5:.0}][{3.5:.0}][{0.0 / 0.0:.2}][{s:^5}][{n:<6}]")
    print("[{"name":-<8}][{[1, 2]:>8}][{true:>6}][{n + 1:5}]")
    print("{x:.2}: {n:>3}")
