## std.webp.3 to std.webp.9: lossless WebP files from libwebp at several settings: one pixel, palettes of 2, 5 and 40
## colors (color indexing at three packings), gradients (predictor, cross-color, subtract-green), transparency,
## repeated tiles (backward references), noise with a color cache, a meta prefix image, and a VP8X wrapper. The
## expected pixels are what libwebp decodes (larger images are shown as the CRC-32 of the pixels).
use std.image.webp

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    inf := webp.info(b) else err
        print("{name}: info {err.kind.name()}: {err.why}")
        return
    img := webp.decode(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: {inf.width}x{inf.height} lossless {inf.lossless} alpha {inf.alpha} animated {inf.animated}")
    if img.width != inf.width or img.height != inf.height
        print("size differs")
    if img.pixels.len() <= 400
        print(img.pixels.hex())
    else
        print("crc {hash.crc32(img.pixels)}")

fn main()
    show("one pixel", "5249464618000000574542505650384c0c0000002f00000000287215ead1ff00")
    show("solid", "524946461c000000574542505650384c0f0000002f02400000000862ddbb89fe47ff5300")
    show("two colors", "524946461c000000574542505650384c0f0000002f07c00000c5e847f43f669867980100")
    show(
        "five colors",
        "524946462e000000574542505650384c220000002f080001000591b6cde8fd0b2ebf02014191ffa309080afd1fadff55e8f224b81d00",
    )
    show(
        "forty colors",
        "524946464e000000574542505650384c410000002f0bc00100b98ce87fec08246df1b6bff805ef7f5c8120926da4134b06b1147b6478b3bf800201429327b99e62027ac967ec527dd4abf250b953b92ce53326150000",
    )
    show(
        "gradient",
        "524946463a000000574542505650384c2e0000002f0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412ef98ef0b01",
    )
    show(
        "alpha",
        "5249464646000000574542505650384c3a0000002f09800110b93244f43f7611d1ff302868db860992f207ba0761198a212393b68db2b35735cccbc46c02203fcc10ed0780f602da80c22b10a602",
    )
    show(
        "tiles",
        "524946467a000000574542505650384c6d0000002f2fc007008592da5a334910349138780a402442acc29f5a86f99d95f8f48462004023841cd28924835e65716c1319cf000670ab0900a421032f0166183e42d8c03246f0dad6b050ff8bb0155eabea446b61cf9de3b705589cd8370b413c58fa70ec6d8e94eefb5dfad8ff9f0600",
    )
    show(
        "blur",
        "",
    )
    show(
        "meta",
        "",
    )
    show(
        "vp8x icc",
        "524946465600000057454250565038580a0000002000000005000003000049434350100000006963632d746573742d70726f66696c655650384c200000002f05c00000b98ce87fec22a2ff01856c23400776fe623fc2a0cc414c00444a0e",
    )
    b := bytes.from_hex("524946461c000000574542505650384c0f0000002f02400000000862ddbb89fe47ff5300") else return
    print(webp.is_webp(b))
    print(webp.is_webp(b[0..11]))
    print(webp.is_webp(b"RIFF\x04\x00\x00\x00WAVE"))
