    check(484, "[link](/uri \"title\")\n", "<p><a href=\"/uri\" title=\"title\">link</a></p>\n")
    check(485, "[link](/uri)\n", "<p><a href=\"/uri\">link</a></p>\n")
    check(486, "[](./target.md)\n", "<p><a href=\"./target.md\"></a></p>\n")
    check(487, "[link]()\n", "<p><a href=\"\">link</a></p>\n")
    check(488, "[link](<>)\n", "<p><a href=\"\">link</a></p>\n")
    check(489, "[]()\n", "<p><a href=\"\"></a></p>\n")
    check(490, "[link](/my uri)\n", "<p>[link](/my uri)</p>\n")
    check(492, "[link](foo\nbar)\n", "<p>[link](foo\nbar)</p>\n")
    check(497, "[link](\\(foo\\))\n", "<p><a href=\"(foo)\">link</a></p>\n")
    check(498, "[link](foo(and(bar)))\n", "<p><a href=\"foo(and(bar))\">link</a></p>\n")
    check(499, "[link](foo(and(bar))\n", "<p>[link](foo(and(bar))</p>\n")
    check(500, "[link](foo\\(and\\(bar\\))\n", "<p><a href=\"foo(and(bar)\">link</a></p>\n")
    check(504, "[link](foo\\bar)\n", "<p><a href=\"foo%5Cbar\">link</a></p>\n")
    check(505, "[link](foo%20b&auml;)\n", "<p><a href=\"foo%20b%C3%A4\">link</a></p>\n")
    check(506, "[link](\"title\")\n", "<p><a href=\"%22title%22\">link</a></p>\n")
    check(513, "[link] (/uri)\n", "<p>[link] (/uri)</p>\n")
    check(514, "[link [foo [bar]]](/uri)\n", "<p><a href=\"/uri\">link [foo [bar]]</a></p>\n")
    check(515, "[link] bar](/uri)\n", "<p>[link] bar](/uri)</p>\n")
    check(516, "[link [bar](/uri)\n", "<p>[link <a href=\"/uri\">bar</a></p>\n")
    check(517, "[link \\[bar](/uri)\n", "<p><a href=\"/uri\">link [bar</a></p>\n")
    check(520, "[foo [bar](/uri)](/uri)\n", "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n")
    check(523, "*[foo*](/uri)\n", "<p>*<a href=\"/uri\">foo*</a></p>\n")
    check(524, "[foo *bar](baz*)\n", "<p><a href=\"baz*\">foo *bar</a></p>\n")
    check(525, "*foo [bar* baz]\n", "<p><em>foo [bar</em> baz]</p>\n")
    check(527, "[foo`](/uri)`\n", "<p>[foo<code>](/uri)</code></p>\n")
    check(531, "[link \\[bar][ref]\n\n[ref]: /uri\n", "<p><a href=\"/uri\">link [bar</a></p>\n")
    check(536, "*[foo*][ref]\n\n[ref]: /uri\n", "<p>*<a href=\"/uri\">foo*</a></p>\n")
    check(537, "[foo *bar][ref]*\n\n[ref]: /uri\n", "<p><a href=\"/uri\">foo *bar</a>*</p>\n")
    check(539, "[foo`][ref]`\n\n[ref]: /uri\n", "<p>[foo<code>][ref]</code></p>\n")
    check(546, "[foo]: /url1\n\n[foo]: /url2\n\n[bar][foo]\n", "<p><a href=\"/url1\">bar</a></p>\n")
    check(547, "[bar][foo\\!]\n\n[foo!]: /url\n", "<p>[bar][foo!]</p>\n")
    check(548, "[foo][ref[]\n\n[ref[]: /uri\n", "<p>[foo][ref[]</p>\n<p>[ref[]: /uri</p>\n")
    check(550, "[[[foo]]]\n\n[[[foo]]]: /url\n", "<p>[[[foo]]]</p>\n<p>[[[foo]]]: /url</p>\n")
    check(551, "[foo][ref\\[]\n\n[ref\\[]: /uri\n", "<p><a href=\"/uri\">foo</a></p>\n")
    check(552, "[bar\\\\]: /uri\n\n[bar\\\\]\n", "<p><a href=\"/uri\">bar\\</a></p>\n")
    check(553, "[]\n\n[]: /uri\n", "<p>[]</p>\n<p>[]: /uri</p>\n")
    check(554, "[\n ]\n\n[\n ]: /uri\n", "<p>[\n]</p>\n<p>[\n]: /uri</p>\n")
    check(562, "[[bar [foo]\n\n[foo]: /url\n", "<p>[[bar <a href=\"/url\">foo</a></p>\n")
    check(564, "[foo] bar\n\n[foo]: /url\n", "<p><a href=\"/url\">foo</a> bar</p>\n")
    check(565, "\\[foo]\n\n[foo]: /url \"title\"\n", "<p>[foo]</p>\n")
    check(566, "[foo*]: /url\n\n*[foo*]\n", "<p>*<a href=\"/url\">foo*</a></p>\n")
    check(567, "[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n", "<p><a href=\"/url2\">foo</a></p>\n")
