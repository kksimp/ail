    check(569, "[foo]()\n\n[foo]: /url1\n", "<p><a href=\"\">foo</a></p>\n")
    check(571, "[foo][bar][baz]\n\n[baz]: /url\n", "<p>[foo]<a href=\"/url\">bar</a></p>\n")
    check(576, "![foo ![bar](/url)](/url2)\n", "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n")
