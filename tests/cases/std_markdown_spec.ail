## std.markdown.1-16: examples of the CommonMark 0.31.2 specification (spec.commonmark.org), each with the
## official HTML. A line is `N ok` when `markdown.html` gives that HTML byte for byte. The subset leaves out
## HTML blocks, raw HTML, tabs, other autolink schemes and examples with non-ASCII text (std.markdown.15).
use std.markdown

fn check(n int, src str, want str)
    got := markdown.html(src)
    if got == want
        print("{n} ok")
    else
        print("{n} FAIL")
        print(got)

fn main()
    check(15, "\\\\*emphasis*\n", "<p>\\<em>emphasis</em></p>\n")
    check(16, "foo\\\nbar\n", "<p>foo<br />\nbar</p>\n")
    check(17, "`` \\[\\` ``\n", "<p><code>\\[\\`</code></p>\n")
    check(18, "    \\[\\]\n", "<pre><code>\\[\\]\n</code></pre>\n")
    check(19, "~~~\n\\[\\]\n~~~\n", "<pre><code>\\[\\]\n</code></pre>\n")
    check(29, "&copy\n", "<p>&amp;copy</p>\n")
    check(30, "&MadeUpEntity;\n", "<p>&amp;MadeUpEntity;</p>\n")
    check(35, "`f&ouml;&ouml;`\n", "<p><code>f&amp;ouml;&amp;ouml;</code></p>\n")
    check(36, "    f&ouml;f&ouml;\n", "<pre><code>f&amp;ouml;f&amp;ouml;\n</code></pre>\n")
    check(37, "&#42;foo&#42;\n*foo*\n", "<p>*foo*\n<em>foo</em></p>\n")
    check(38, "&#42; foo\n\n* foo\n", "<p>* foo</p>\n<ul>\n<li>foo</li>\n</ul>\n")
    check(39, "foo&#10;&#10;bar\n", "<p>foo\n\nbar</p>\n")
    check(40, "&#9;foo\n", "<p>\tfoo</p>\n")
    check(41, "[a](url &quot;tit&quot;)\n", "<p>[a](url &quot;tit&quot;)</p>\n")
    check(42, "- `one\n- two`\n", "<ul>\n<li>`one</li>\n<li>two`</li>\n</ul>\n")
    check(43, "***\n---\n___\n", "<hr />\n<hr />\n<hr />\n")
    check(44, "+++\n", "<p>+++</p>\n")
    check(45, "===\n", "<p>===</p>\n")
    check(46, "--\n**\n__\n", "<p>--\n**\n__</p>\n")
    check(47, " ***\n  ***\n   ***\n", "<hr />\n<hr />\n<hr />\n")
    check(48, "    ***\n", "<pre><code>***\n</code></pre>\n")
    check(49, "Foo\n    ***\n", "<p>Foo\n***</p>\n")
    check(50, "_____________________________________\n", "<hr />\n")
    check(51, " - - -\n", "<hr />\n")
    check(52, " **  * ** * ** * **\n", "<hr />\n")
    check(53, "-     -      -      -\n", "<hr />\n")
    check(54, "- - - -    \n", "<hr />\n")
    check(56, " *-*\n", "<p><em>-</em></p>\n")
    check(58, "Foo\n***\nbar\n", "<p>Foo</p>\n<hr />\n<p>bar</p>\n")
    check(59, "Foo\n---\nbar\n", "<h2>Foo</h2>\n<p>bar</p>\n")
    check(61, "- Foo\n- * * *\n", "<ul>\n<li>Foo</li>\n<li>\n<hr />\n</li>\n</ul>\n")
    check(63, "####### foo\n", "<p>####### foo</p>\n")
    check(64, "#5 bolt\n\n#hashtag\n", "<p>#5 bolt</p>\n<p>#hashtag</p>\n")
    check(65, "\\## foo\n", "<p>## foo</p>\n")
    check(66, "# foo *bar* \\*baz\\*\n", "<h1>foo <em>bar</em> *baz*</h1>\n")
    check(67, "#                  foo                     \n", "<h1>foo</h1>\n")
    check(68, " ### foo\n  ## foo\n   # foo\n", "<h3>foo</h3>\n<h2>foo</h2>\n<h1>foo</h1>\n")
    check(69, "    # foo\n", "<pre><code># foo\n</code></pre>\n")
    check(70, "foo\n    # bar\n", "<p>foo\n# bar</p>\n")
    check(71, "## foo ##\n  ###   bar    ###\n", "<h2>foo</h2>\n<h3>bar</h3>\n")
