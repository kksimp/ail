    check(228, "aaa     \nbbb     \n", "<p>aaa<br />\nbbb</p>\n")
    check(229, "  \n\naaa\n  \n\n# aaa\n\n  \n", "<p>aaa</p>\n<h1>aaa</h1>\n")
    check(235, "> bar\nbaz\n> foo\n", "<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n")
