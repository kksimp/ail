    check(240, "> foo\n    - bar\n", "<blockquote>\n<p>foo\n- bar</p>\n</blockquote>\n")
    check(241, ">\n", "<blockquote>\n</blockquote>\n")
    check(242, ">\n>  \n> \n", "<blockquote>\n</blockquote>\n")
    check(243, ">\n> foo\n>  \n", "<blockquote>\n<p>foo</p>\n</blockquote>\n")
    check(245, "> foo\n> bar\n", "<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n")
    check(246, "> foo\n>\n> bar\n", "<blockquote>\n<p>foo</p>\n<p>bar</p>\n</blockquote>\n")
    check(247, "foo\n> bar\n", "<p>foo</p>\n<blockquote>\n<p>bar</p>\n</blockquote>\n")
    check(249, "> bar\nbaz\n", "<blockquote>\n<p>bar\nbaz</p>\n</blockquote>\n")
