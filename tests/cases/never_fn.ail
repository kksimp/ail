## type.never.1-3 (ADR 1119): a call of a function declared `never` fits where
## any value is expected (a fallback, a match arm, an `if` branch) and ends the
## program; `io.exit` runs only on the last call.
use std.io

struct Cli
    name str

fn Cli.fail(self, why str) never
    io.eprint("{name}: {why}")
    io.exit(3)

fn usage(why str) never
    Cli(name: "count").fail(why)

fn parse(s str) int
    v := s.to_int() else usage("not a number: {s}")
    v

fn pick(k int) str
    match k
        0 => "zero"
        1 => "one"
        _ => usage("no word for {k}")

fn main()
    n := "41".to_int() else usage("bad")
    print(n + 1)
    print(parse("7") * 2)
    print(pick(1))
    m := if n > 0 then n else usage("negative")
    print(m)
    print("last")
    print(pick(5))
    print("never printed")
