## std.feed.1, std.feed.5, std.feed.6 and std.feed.7: Atom, RSS 1.0 and JSON Feed.
use std.feed
use std.time.date

fn stamp(d date.DateTime?) str
    x := d else return "none"
    x.format("%Y-%m-%d %H:%M:%S %:z")

fn show(f feed.Feed)
    print("{f.format.name()} | {f.title} | {f.link} | {f.url} | {f.description} | {f.language} | {f.author} | [{f.id}] | {stamp(f.updated)}")
    for it in f.items
        print("{it.id} | {it.title} | {it.link} | {it.summary} | {it.content} | {it.author} | [{it.tags.join(",")}]")
        print("{stamp(it.published)} | {stamp(it.updated)}")
        for e in it.enclosures
            print("{e.url} {e.mime} {e.length}")

fn main() !
    atom := """
        <?xml version="1.0" encoding="utf-8"?>
        <feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
          <title>Atom Example</title>
          <subtitle>Words</subtitle>
          <link href="https://example.org/"/>
          <link rel="self" href="https://example.org/feed.atom"/>
          <updated>2003-12-13T18:30:02Z</updated>
          <author><name>John</name></author>
          <id>urn:uuid:60a76c80</id>
          <entry>
            <title>Atom-Powered Robots</title>
            <link href="https://example.org/2003/12/13/atom03"/>
            <link rel="enclosure" type="image/png" length="99" href="https://example.org/r.png"/>
            <id>urn:uuid:1225c695</id>
            <updated>2003-12-13T18:30:02+01:00</updated>
            <published>2003-12-12T10:00:00Z</published>
            <summary>Some text.</summary>
            <category term="robots"/>
          </entry>
        </feed>
        """
    show(feed.parse(atom)?)
    rdf := """
        <?xml version="1.0"?>
        <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns="http://purl.org/rss/1.0/" xmlns:dc="http://purl.org/dc/elements/1.1/">
          <channel rdf:about="https://example.net/">
            <title>RDF Site</title>
            <link>https://example.net/</link>
            <description>Old style</description>
          </channel>
          <item rdf:about="https://example.net/a">
            <title>Item A</title>
            <link>https://example.net/a</link>
            <dc:date>2004-02-01T08:00:00Z</dc:date>
            <dc:creator>Bob</dc:creator>
            <dc:subject>misc</dc:subject>
          </item>
        </rdf:RDF>
        """
    show(feed.parse(rdf)?)
    js := "\{\"version\":\"https://jsonfeed.org/version/1.1\",\"title\":\"JSON Example\",\"home_page_url\":\"https://example.com/\",\"feed_url\":\"https://example.com/feed.json\",\"authors\":[\{\"name\":\"Cy\"}],\"items\":[\{\"id\":\"1\",\"url\":\"https://example.com/1\",\"title\":\"One\",\"content_html\":\"<p>hi</p>\",\"date_published\":\"2020-01-02T03:04:05Z\",\"tags\":[\"a\",\"b\"],\"attachments\":[\{\"url\":\"https://example.com/x.mp3\",\"mime_type\":\"audio/mpeg\",\"size_in_bytes\":77}]}]}"
    show(feed.parse(js)?)
