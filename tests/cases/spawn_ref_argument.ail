# own.ref.2: a `ref`, or a value that holds one, can't be passed to a spawned task.
struct Node
    value int
    next List[ref Node]

fn on_ref(c ref Node) int
    c.value

fn on_list(cs List[ref Node]) int
    cs.len()

fn on_node(n Node) int
    n.next.len()

fn plain(n int) int
    n

fn main()
    c := ref Node(value: 1, next: [])
    a := spawn on_ref(c)
    b := spawn on_list([c])
    d := spawn on_node(Node(value: 2, next: [c]))
    e := spawn plain(3)
    print(a.wait() else 0)
    print(b.wait() else 0)
    print(d.wait() else 0)
    print(e.wait() else 0)
