## std.tar.4, std.tar.5: archives made by other tools, read back. One archive, built with Python's tarfile
## (ustar with a prefix, GNU long name and long link records, pax long name, UTF-8 name and fractional time,
## a hard link and a fifo), gzipped.
GZ := ""

fn show(e tar.Entry)
    short := if e.name.len() < 20 then e.name else e.name.slice(0, 8)
    print("{short} {e.name.len()} {e.kind.name()} {e.mode} {e.mtime} {e.data.len()} {e.link.len()} [{e.data.text().trim()}]")

fn main() !
    gz := bytes.from_base64(GZ) else b""
    es := tar.read(gz)?
    print(es.len())
    for e in es
        show(e)
    plain := compress.gunzip(gz)?
    print(plain.len())
    print(tar.read(plain)? == es)
