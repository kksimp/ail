## std.validate.12 to std.validate.14: host names, Luhn and card numbers.
use std.validate

fn try_host(s str)
    h := validate.hostname(s) else err
        print("[{s}] {err.kind.name()}")
        return
    print("[{s}] {h}")

fn try_card(s str)
    c := validate.card(s) else err
        print("[{s}] {err.kind.name()}")
        return
    print("[{s}] {c.brand.name()} {c.number} {c.last4}")

fn try_digit(s str)
    d := validate.luhn_digit(s) else err
        print("[{s}] {err.kind.name()}")
        return
    print("[{s}] {d}")

fn main()
    try_host("localhost")
    try_host("example.com")
    try_host("Example.COM")
    try_host("a-b.example.org")
    try_host("a.b.")
    try_host("x")
    try_host("my_host.com")
    try_host("-a.com")
    try_host("a-.com")
    try_host("a..b")
    try_host("")
    try_host(".")
    try_host("a.123")
    try_host("123.456.789.012")
    try_host("1.2.3.4")
    try_host("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com")
    try_host("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com")
    try_host("bücher.de")
    try_host("a b.com")
    try_host("a.b-.c")
    try_host("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com")
    print(validate.is_hostname("localhost"))
    print(validate.is_hostname("my_host.com"))
    print(validate.is_hostname("a.b."))
    print(validate.is_hostname("1.2.3.4"))
    print(validate.luhn("79927398713"))
    print(validate.luhn("4111111111111111"))
    print(validate.luhn("4111111111111112"))
    print(validate.luhn("0"))
    print(validate.luhn("00"))
    print(validate.luhn(""))
    print(validate.luhn("12a4"))
    print(validate.luhn("49927398716"))
    print(validate.luhn("5500000000000004"))
    print(validate.luhn("378282246310005"))
    print(validate.luhn("6011111111111117"))
    print(validate.luhn("3530111333300000"))
    print(validate.luhn("1234567812345670"))
    print(validate.luhn(" 4111"))
    try_digit("7992739871")
    try_digit("411111111111111")
    try_digit("550000000000000")
    try_digit("37828224631000")
    try_digit("0")
    try_digit("")
    try_digit("12x")
    try_card("4111111111111111")
    try_card("4111 1111 1111 1111")
    try_card("4111-1111-1111-1111")
    try_card("5555555555554444")
    try_card("2223003122003222")
    try_card("378282246310005")
    try_card("6011111111111117")
    try_card("3056930009020004")
    try_card("3530111333300000")
    try_card("6200000000000005")
    try_card("4111111111111112")
    try_card("4111")
    try_card("41111111111111111111")
    try_card("4111 1111 1111 111a")
    try_card("")
    try_card("4222222222222")
    try_card("9999999999999995")
