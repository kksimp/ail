## std.wasm.1-9: modules built by clang and the linker (an object file with relocation sections, linked files with SIMD, bulk memory and tail calls, name and producers sections) parse, validate and write back with the same content.
use std.wasm

fn show(name str, src bytes)
    m := wasm.parse(src) else err
        print("{name} parse {err.kind.name()}")
        return
    wasm.validate(m) else err
        print("{name} validate {err.kind.name()}")
        return
    out := wasm.write(m) else err
        print("{name} write {err.kind.name()}")
        return
    back := wasm.parse(out) else err
        print("{name} reparse {err.kind.name()}")
        return
    mut names := List[str]()
    for c in m.customs
        names.push(c.name)
    joined := names.join(",")
    same := back == m
    print("{name} funcs={m.func_count()} exports={m.exports.len()} datas={m.datas.len()} customs={joined} same={same}")

