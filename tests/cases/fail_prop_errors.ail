## err.fail.3 (ADR 1140): `?` in a function that fails with `Fail` passes the
## text of a `T ! str` call on as a `Fail`; another undeclared error is
## err.prop.3, whose help shows `else e` and `return Fail(msg: "{e}")`.
fn parse(s str) int ! str
    n := s.to_int() else return "not a number: {s}"
    n

fn load(path str) ! Fail
    text := fs.read_text(path)?
    print(text)

# Legal: the text becomes a `Fail`.
fn total(s str) int ! Fail
    n := parse(s)?
    n + 1

# The form the help shows checks.
fn load_text(path str) ! Fail
    text := fs.read_text(path) else e
        return Fail(msg: "{e}")
    print(text)

fn main()
    load("x") else e
        print("{e}")
    print(total("1") else 0)
    load_text("x") else e
        print("{e}")
