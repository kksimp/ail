## `--accel`: a parallel comprehension of an offloadable function gives the CPU's result where there is no GPU
## (and, on a Mac with one, an f32-rounded result within 1e-3). Prints the same on every host.
struct Lin
    rows int
    cols int

fn dot(w List[float], m Lin, x List[float], r int) float
    mut acc := 0.0
    for c in 0..m.cols
        acc += w[r * m.cols + c] * x[c]
    acc

fn mv(w List[float], m Lin, x List[float]) List[float]
    [dot(w, m, x, r) par for r in 0..m.rows]

fn main()
    m := Lin(rows: 5000, cols: 16)
    mut w := []
    for i in 0..m.rows * m.cols
        w.push((i % 7).to_float() * 0.25)
    mut x := []
    for c in 0..m.cols
        x.push(1.0 + c.to_float() * 0.5)
    ys := mv(w, m, x)
    mut want := 0.0
    for c in 0..m.cols
        want += w[5 * m.cols + c] * x[c]
    d := (ys[5] - want).abs()
    print(ys.len())
    print(d < 0.001)
