# lex.num.2: digits '.' digits, an exponent, or both; underscores separate digits.
fn main()
    print(1.0)
    print(0.5)
    print(1e3)
    print(1E3)
    print(1e+3)
    print(1e-3)
    print(2.5e3)
    print(2.5E-3)
    print(1_000.5)
    print(1.000_5)
    print(1_0e2)
    print(1e1_0)
    print(1_000_000.000_001)
    print(0.000_1)
    print(1e0)
    print(0e0)
    print(0.0e5)
    print(007.5)
    print(1.0e+22)
    print(12e-1)
    print(-1e3)
    print(-2.5e-3)
    print(3.0.abs())
    print(1e3.abs())
    print(2.5e-1.floor())
    # expr.prec.1: postfix binds tighter than unary minus
    print(-3.5.abs())
    print(1_0.5_0)
    # literals are correctly rounded to nearest, ties to even
    print(9007199254740993.0)
    print(9007199254740995.0)
    print(0.1000000000000000055511151231257827)
    print(0.30000000000000004440892098500626)
    print(1.7976931348623158e308)
    print(2.4703282292062328e-324)
    print(2.4703282292062327e-324)
    print(4.9e-324)
    print(1e-400)
    print(-1e-400)
    print(123456789012345678901234567890.0)
    print(0.000000000000000000000000000001)
