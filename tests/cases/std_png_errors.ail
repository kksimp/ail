## std.png.10: what is refused and the kind of each failure. Each fixture is a small PNG with one thing wrong.
use std.image.png

fn try_decode(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    img := png.decode(b) else err
        text := if err.kind.name() == "Corrupt" and name == "bad zlib" then "Corrupt" else "{err.kind.name()}: {err.why}"
        print("[{name}] {text}")
        return
    print("[{name}] ok {img.width}x{img.height}")

fn try_info(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    inf := png.info(b) else err
        print("[{name}] {err.kind.name()}: {err.why}")
        return
    print("[{name}] ok {inf.width}x{inf.height}")

fn main()
    try_decode("empty", "")
    try_decode("not png", "4749463839612e2e2e2e")
    try_decode("cut in IEND", "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d2400000016746558")
    try_info("cut in IHDR", "89504e470d0a1a0a0000000d494844520000000200000002080600000072")
    try_decode("bad crc", "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d240000001674655874436f6d6d656e74006d61646520627920612074657374c759968f0000001a49444154789c62606462fecfc2caf69f819d83f33f1737cf7f00200b044b5ac770770000000049454e44ae426082")
    try_decode("depth", "89504e470d0a1a0a0000000d4948445200000002000000020402000000382477720000001649444154789c636064626661656360e7e0e4e2e60100018f004f0474adbd0000000049454e44ae426082")
    try_decode("ctype", "89504e470d0a1a0a0000000d49484452000000020000000208050000006003a2ca0000001649444154789c636064626661656360e7e0e4e2e60100018f004f0474adbd0000000049454e44ae426082")
    try_decode("size", "89504e470d0a1a0a0000000d4948445200000000000000020802000000f9214a4e0000001649444154789c636064626661656360e7e0e4e2e60100018f004f0474adbd0000000049454e44ae426082")
    try_decode("interlace", "89504e470d0a1a0a0000000d494844520000000200000002080200000213dafb5f0000001649444154789c636064626661656360e7e0e4e2e60100018f004f0474adbd0000000049454e44ae426082")
    try_decode("filter byte", "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000000b49444154789ce364400600008c000a3eed6b620000000049454e44ae426082")
    try_decode("short data", "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000000b49444154789c636000030000070001b286acf40000000049454e44ae426082")
    try_decode("no idat", "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000000049454e44ae426082")
    try_decode("critical", "89504e470d0a1a0a0000000d4948445200000002000000020802000000fdd49a730000000141424344782abb56c40000001649444154789c636064626661656360e7e0e4e2e60100018f004f0474adbd0000000049454e44ae426082")
