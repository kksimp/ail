# trait.op.3, type.num.10: no implicit int/float conversion; only literals convert.
struct S
    v float

fn takes(x float) float
    x

fn gives(n int) float
    n

fn gives2(n int) int
    n.to_float()

fn main()
    a := 1.5
    n := 3
    print(a + n)
    print(n + a)
    print(a * n)
    print(n - a)
    print(a / n)
    print(a == n)
    print(n == a)
    print(a < n)
    print(n >= a)
    print(takes(n))
    print(S(v: n))
    mut m := 2.0
    m += n
    m = n
    mut k := 1
    k = a
    k += a
    x := a + (2 * 3)
    y := a * (n + 1)
    z := 2 * 3 * a
    w := n + 1.0
    v := a + (1 + 1)
    u := a.floor() + n
    print([a, n])
