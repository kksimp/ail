# type.num.8: correctly rounded parsing of very long digit strings and huge exponents.
fn main()
    z := "0".repeat(400)
    print("1{z}".to_float())
    print("0.{z}1".to_float())
    print("0.{z}1e401".to_float())
    print("{z}1.5".to_float())
    print("1{z}e-400".to_float())
    print("9007199254740993.{z}1".to_float())
    print("9007199254740993{z}".to_float())
    print("-1{z}".to_float())
    print("-0.{z}1".to_float())
    print("1e{z}1".to_float())
    print("1e-{z}1".to_float())
    print("1e+{z}".to_float())
    print("1.{z}".to_float())
    print("2.2250738585072011e-308".to_float())
    print("2.2250738585072012e-308".to_float())
    print("1.7976931348623158e308".to_float())
    print("1.7976931348623159e308".to_float())
    print("-1.7976931348623159e308".to_float())
    print("1e99999999999999999999".to_float())
    print("-1e99999999999999999999".to_float())
    print("1e-99999999999999999999".to_float())
    print("0e99999999999999999999".to_float())
