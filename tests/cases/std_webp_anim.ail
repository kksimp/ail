## std.webp.18 to std.webp.20: animated WebP files made with libwebp's webpmux: lossless and lossy frames, sub-rectangle
## frames at even offsets, dispose-to-background, no-blend and alpha-blended frames, and a loop count. Each frame is the
## canvas as libwebp's AnimDecoder composes it, shown as its delay, size and the CRC-32 of its RGBA pixels. `decode` of
## an animated file returns the first frame.
use std.image.webp

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    anim := webp.decode_animation(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: canvas {anim.width}x{anim.height} loops {anim.loops} frames {anim.frames.len()}")
    for i, f in anim.frames.enumerate()
        print("  {i}: {f.delay_ms}ms {f.img.width}x{f.img.height} crc {hash.crc32(f.img.pixels)}")
    first := webp.decode(b) else err
        print("  decode: {err.kind.name()}")
        return
    print("  decode: {first.width}x{first.height} crc {hash.crc32(first.pixels)}")

fn main()
    show("full", "")
    show("rects", "")
    show("dispose", "")
    show("lossy", "")
    show("mixed", "")
