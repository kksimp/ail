        Case(name: "invalid/table/no-close-04", src: "[\n", want: ""),
        Case(name: "invalid/table/no-close-05", src: "[fwfw.wafw\n", want: ""),
        Case(name: "invalid/table/no-close-06", src: "[a\n[b]\n[c\n[d]\n", want: ""),
        Case(name: "invalid/table/no-close-07", src: "[']\n", want: ""),
        Case(name: "invalid/table/no-close-08", src: "[''']\n", want: ""),
        Case(
            name: "invalid/table/no-close-09",
            src: "[\"where will it end\"\"]\nname = value\n",
            want: "",
        ),
        Case(
            name: "invalid/table/overwrite-array-in-parent",
            src: "[[parent-table.arr]]\n[parent-table]\nnot-arr = 1\narr = 2\n",
            want: "",
        ),
        Case(name: "invalid/table/overwrite-bool-with-array", src: "a=true\n[[a]]\n", want: ""),
        Case(name: "invalid/table/overwrite-with-deep-table", src: "a=1\n[a.b.c.d]\n", want: ""),
        Case(
            name: "invalid/table/redefine-01",
            src: "# Define b as int, and try to use it as a table: error\n[a]\nb = 1\n\n[a.b]\nc = 2\n",
            want: "",
        ),
        Case(
            name: "invalid/table/redefine-02",
            src: "# Define t2 as a table via dotted key in [t1] block, and then redefine [t1.t2]\n[t1]\nt2.t3.v = 0\n[t1.t2]\n",
            want: "",
        ),
        Case(
            name: "invalid/table/redefine-03",
            src: "# Define t2.t3 as a table via dotted key in [t1] block, and then redefine [t1.t2.t3]\n[t1]\nt2.t3.v = 0\n[t1.t2.t3]\n",
            want: "",
        ),
        Case(name: "invalid/table/rrbrace", src: "[[table] ]\n", want: ""),
        Case(name: "invalid/table/super-twice", src: "[a.b]\n[a]\n[a]\n", want: ""),
        Case(
            name: "invalid/table/text-after-table",
            src: "[error] this shouldn't be here\n",
            want: "",
        ),
        Case(name: "invalid/table/trailing-dot", src: "[a.]\n", want: ""),
        Case(name: "invalid/table/whitespace", src: "[invalid key]\n", want: ""),
        Case(name: "invalid/table/with-pound", src: "[key#group]\nanswer = 42\n", want: ""),
    ]

fn main()
    mut good := List[Case]()
    for c in valid_0()
        good.push(c)
    for c in valid_1()
        good.push(c)
    for c in valid_2()
        good.push(c)
    for c in valid_3()
        good.push(c)
    for c in valid_4()
        good.push(c)
    for c in valid_5()
        good.push(c)
    mut bad := List[Case]()
    for c in invalid_0()
        bad.push(c)
    for c in invalid_1()
        bad.push(c)
    for c in invalid_2()
        bad.push(c)
    for c in invalid_3()
        bad.push(c)
    for c in invalid_4()
        bad.push(c)
    for c in invalid_5()
        bad.push(c)
    for c in invalid_6()
        bad.push(c)
    for c in invalid_7()
        bad.push(c)
    for c in invalid_8()
        bad.push(c)
    for c in invalid_9()
        bad.push(c)
    for c in invalid_10()
        bad.push(c)
    for c in invalid_11()
        bad.push(c)
    for c in invalid_12()
        bad.push(c)
    mut failed := 0
    mut good_bad := 0
    for c in good
        if not check_valid(c)
            good_bad += 1
    print("toml-test {good.len() - good_bad}/{good.len()} valid documents read as the suite says")
    failed += good_bad
    mut bad_bad := 0
    for c in bad
        if not check_invalid(c)
            bad_bad += 1
    print("toml-test {bad.len() - bad_bad}/{bad.len()} invalid documents refused")
    failed += bad_bad
    if failed > 0
        print("{failed} cases failed")
