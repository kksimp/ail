        Case("valid/array/strings", "string_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''']\n", "\{\"string_array\":[\{\"type\":\"string\",\"value\":\"all\"},\{\"type\":\"string\",\"value\":\"strings\"},\{\"type\":\"string\",\"value\":\"are the same\"},\{\"type\":\"string\",\"value\":\"type\"}]}"),
