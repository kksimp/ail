        Case("valid/datetime/datetime", "space = 1987-07-05 17:45:00Z\n\n# ABNF is case-insensitive, both \"Z\" and \"z\" must be supported.\nlower = 1987-07-05t17:45:00z\n", "\{\"lower\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},\"space\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"}}"),
        Case("valid/datetime/edge", "first-offset = 0001-01-01 00:00:00Z\nfirst-local  = 0001-01-01 00:00:00\nfirst-date   = 0001-01-01\n\nlast-offset = 9999-12-31 23:59:59Z\nlast-local  = 9999-12-31 23:59:59\nlast-date   = 9999-12-31\n", "\{\"first-date\":\{\"type\":\"date-local\",\"value\":\"0001-01-01\"},\"first-local\":\{\"type\":\"datetime-local\",\"value\":\"0001-01-01T00:00:00\"},\"first-offset\":\{\"type\":\"datetime\",\"value\":\"0001-01-01T00:00:00Z\"},\"last-date\":\{\"type\":\"date-local\",\"value\":\"9999-12-31\"},\"last-local\":\{\"type\":\"datetime-local\",\"value\":\"9999-12-31T23:59:59\"},\"last-offset\":\{\"type\":\"datetime\",\"value\":\"9999-12-31T23:59:59Z\"}}"),
