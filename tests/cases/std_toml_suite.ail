## std.toml against toml-test (TOML 1.0.0): every valid document reads as the suite's JSON,
## every invalid one is refused (std.toml.1 to std.toml.14). The cases are the suite's files
## verbatim; tools/conformance/gen_suite_tests.py writes this file. toml-test is MIT licensed,
## Copyright (c) 2018 TOML authors (NOTICE).
use std.toml

## A case: its name, the TOML text and, for a valid one, the suite's typed JSON ("" if invalid).
struct Case
    name str
    src str
    want str

## Whether `got` is the value the typed JSON `want` describes: a leaf is {"type": T, "value": V}
## with V a string. Dates and times are kept as text, so only their kind is checked.
fn reads_as(want Json, got Json) bool
    match want
        Json.Obj(ms) =>
            t := want.str("type")
            v := want.str("value")
            if ms.len() == 2 and t != none and v != none
                return leaf(want.str("type") else "", want.str("value") else "", got)
            have := got.as_obj() else return false
            if have.len() != ms.len()
                return false
            for m in ms
                g := got.get(m.key) else return false
                if not reads_as(m.value, g)
                    return false
            true
        Json.Arr(items) =>
            have := got.as_arr() else return false
            if have.len() != items.len()
                return false
            for i in 0..items.len()
                if not reads_as(items[i], have[i])
                    return false
            true
        _ => false

fn leaf(t str, v str, got Json) bool
    match got
        Json.Str(s) => if t == "string" then s == v else t.starts_with("date") or t.starts_with("time")
        Json.Bool(b) => t == "bool" and (v == "true") == b
        Json.Num(f) => number_reads_as(t, v, f)
        _ => false

fn number_reads_as(t str, v str, f float) bool
    if t != "integer" and t != "float"
        return false
    if v.ends_with("inf")
        return f == (if v.starts_with("-") then -1.0 / 0.0 else 1.0 / 0.0)
    if v.ends_with("nan")
        return f != f
    plain := if v.starts_with("+") then v.slice(1, v.len()) else v
    want := plain.to_float() else return true
    f == want

fn check_valid(c Case) bool
    doc := toml.parse(c.src) else err
        print("FAIL valid {c.name}: refused: {err}")
        return false
    want := parse_json(c.want) else return false
    if not reads_as(want, doc)
        print("FAIL valid {c.name}: read as {doc.to_text()}")
        return false
    true

fn check_invalid(c Case) bool
    doc := toml.parse(c.src) else return true
    print("FAIL invalid {c.name}: accepted as {doc.to_text()}")
    false

fn valid_0() List[Case]
    [
        Case("valid/array/array", "ints = [1, 2, 3, ]\nfloats = [1.1, 2.1, 3.1]\nstrings = [\"a\", \"b\", \"c\"]\ndates = [\n\t1987-07-05T17:45:00Z,\n\t1979-05-27T07:32:00,\n\t2006-06-01,\n\t11:00:00,\n]\ncomments = [\n         1,\n         2, #this is ok\n]\n", "\{\"comments\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}],\"dates\":[\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},\{\"type\":\"datetime-local\",\"value\":\"1979-05-27T07:32:00\"},\{\"type\":\"date-local\",\"value\":\"2006-06-01\"},\{\"type\":\"time-local\",\"value\":\"11:00:00\"}],\"floats\":[\{\"type\":\"float\",\"value\":\"1.1\"},\{\"type\":\"float\",\"value\":\"2.1\"},\{\"type\":\"float\",\"value\":\"3.1\"}],\"ints\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"},\{\"type\":\"integer\",\"value\":\"3\"}],\"strings\":[\{\"type\":\"string\",\"value\":\"a\"},\{\"type\":\"string\",\"value\":\"b\"},\{\"type\":\"string\",\"value\":\"c\"}]}"),
        Case("valid/array/array-subtables", "[[arr]]\n[arr.subtab]\nval=1\n\n[[arr]]\n[arr.subtab]\nval=2\n", "\{\"arr\":[\{\"subtab\":\{\"val\":\{\"type\":\"integer\",\"value\":\"1\"}}},\{\"subtab\":\{\"val\":\{\"type\":\"integer\",\"value\":\"2\"}}}]}"),
        Case("valid/array/bool", "a = [true, false]\n", "\{\"a\":[\{\"type\":\"bool\",\"value\":\"true\"},\{\"type\":\"bool\",\"value\":\"false\"}]}"),
        Case("valid/array/empty", "thevoid = [[[[[]]]]]\n", "\{\"thevoid\":[[[[[]]]]]}"),
        Case("valid/array/hetergeneous", "mixed = [[1, 2], [\"a\", \"b\"], [1.1, 2.1]]\n", "\{\"mixed\":[[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}],[\{\"type\":\"string\",\"value\":\"a\"},\{\"type\":\"string\",\"value\":\"b\"}],[\{\"type\":\"float\",\"value\":\"1.1\"},\{\"type\":\"float\",\"value\":\"2.1\"}]]}"),
        Case("valid/array/mixed-int-array", "arrays-and-ints =  [1, [\"Arrays are not integers.\"]]\n", "\{\"arrays-and-ints\":[\{\"type\":\"integer\",\"value\":\"1\"},[\{\"type\":\"string\",\"value\":\"Arrays are not integers.\"}]]}"),
        Case("valid/array/mixed-int-float", "ints-and-floats = [1, 1.1]\n", "\{\"ints-and-floats\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"float\",\"value\":\"1.1\"}]}"),
        Case("valid/array/mixed-int-string", "strings-and-ints = [\"hi\", 42]\n", "\{\"strings-and-ints\":[\{\"type\":\"string\",\"value\":\"hi\"},\{\"type\":\"integer\",\"value\":\"42\"}]}"),
        Case("valid/array/mixed-string-table", "contributors = [\n  \"Foo Bar <foo@example.com>\",\n  \{ name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\n]\n\n# Start with a table as the first element. This tests a case that some libraries\n# might have where they will check if the first entry is a table/map/hash/assoc\n# array and then encode it as a table array. This was a reasonable thing to do\n# before TOML 1.0 since arrays could only contain one type, but now it's no\n# longer.\nmixed = [\{k=\"a\"}, \"b\", 1]\n", "\{\"contributors\":[\{\"type\":\"string\",\"value\":\"Foo Bar <foo@example.com>\"},\{\"email\":\{\"type\":\"string\",\"value\":\"bazqux@example.com\"},\"name\":\{\"type\":\"string\",\"value\":\"Baz Qux\"},\"url\":\{\"type\":\"string\",\"value\":\"https://example.com/bazqux\"}}],\"mixed\":[\{\"k\":\{\"type\":\"string\",\"value\":\"a\"}},\{\"type\":\"string\",\"value\":\"b\"},\{\"type\":\"integer\",\"value\":\"1\"}]}"),
        Case("valid/array/nested", "nest = [[\"a\"], [\"b\"]]\n", "\{\"nest\":[[\{\"type\":\"string\",\"value\":\"a\"}],[\{\"type\":\"string\",\"value\":\"b\"}]]}"),
        Case("valid/array/nested-double", "nest = [\n\t[\n\t\t[\"a\"],\n\t\t[1, 2, [3]]\n\t]\n]\n", "\{\"nest\":[[[\{\"type\":\"string\",\"value\":\"a\"}],[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"},[\{\"type\":\"integer\",\"value\":\"3\"}]]]]}"),
