        Case("valid/datetime/leap-year", "2000-datetime       = 2000-02-29 15:15:15Z\n2000-datetime-local = 2000-02-29 15:15:15\n2000-date           = 2000-02-29\n\n2024-datetime       = 2024-02-29 15:15:15Z\n2024-datetime-local = 2024-02-29 15:15:15\n2024-date           = 2024-02-29\n", "\{\"2000-date\":\{\"type\":\"date-local\",\"value\":\"2000-02-29\"},\"2000-datetime\":\{\"type\":\"datetime\",\"value\":\"2000-02-29T15:15:15Z\"},\"2000-datetime-local\":\{\"type\":\"datetime-local\",\"value\":\"2000-02-29T15:15:15\"},\"2024-date\":\{\"type\":\"date-local\",\"value\":\"2024-02-29\"},\"2024-datetime\":\{\"type\":\"datetime\",\"value\":\"2024-02-29T15:15:15Z\"},\"2024-datetime-local\":\{\"type\":\"datetime-local\",\"value\":\"2024-02-29T15:15:15\"}}"),
