        Case("valid/datetime/local-date", "bestdayever = 1987-07-05\n", "\{\"bestdayever\":\{\"type\":\"date-local\",\"value\":\"1987-07-05\"}}"),
        Case("valid/datetime/local-time", "besttimeever = 17:45:00\nmilliseconds = 10:32:00.555\n", "\{\"besttimeever\":\{\"type\":\"time-local\",\"value\":\"17:45:00\"},\"milliseconds\":\{\"type\":\"time-local\",\"value\":\"10:32:00.555\"}}"),
        Case("valid/datetime/milliseconds", "utc1  = 1987-07-05T17:45:56.123Z\nutc2  = 1987-07-05T17:45:56.6Z\nwita1 = 1987-07-05T17:45:56.123+08:00\nwita2 = 1987-07-05T17:45:56.6+08:00\n", "\{\"utc1\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.123Z\"},\"utc2\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.600Z\"},\"wita1\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.123+08:00\"},\"wita2\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56.600+08:00\"}}"),
        Case("valid/datetime/timezone", "utc  = 1987-07-05T17:45:56Z\npdt  = 1987-07-05T17:45:56-05:00\nnzst = 1987-07-05T17:45:56+12:00\nnzdt = 1987-07-05T17:45:56+13:00  # DST\n", "\{\"nzdt\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56+13:00\"},\"nzst\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56+12:00\"},\"pdt\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56-05:00\"},\"utc\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:56Z\"}}"),
        Case("valid/empty-crlf", "\r\n", "\{}"),
        Case("valid/empty-lf", "\n", "\{}"),
    ]

fn valid_1() List[Case]
    [
        Case("valid/empty-nothing", "", "\{}"),
        Case("valid/empty-space", " ", "\{}"),
        Case("valid/empty-tab", "\t", "\{}"),
        Case("valid/example", "best-day-ever = 1987-07-05T17:45:00Z\n\n[numtheory]\nboring = false\nperfection = [6, 28, 496]\n", "\{\"best-day-ever\":\{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},\"numtheory\":\{\"boring\":\{\"type\":\"bool\",\"value\":\"false\"},\"perfection\":[\{\"type\":\"integer\",\"value\":\"6\"},\{\"type\":\"integer\",\"value\":\"28\"},\{\"type\":\"integer\",\"value\":\"496\"}]}}"),
        Case("valid/float/exponent", "# Please keep exponent-upper.toml in sync with this.\n\nexp       = 3e2\npos-exp   = 3e+2\nneg-exp   = 3e-2\nzero-exp  = 3e0\nfrac      = 3.1e2\nneg       = -1e-1\nzero      = 0e2\nzero-plus = +0e2\n", "\{\"exp\":\{\"type\":\"float\",\"value\":\"300\"},\"frac\":\{\"type\":\"float\",\"value\":\"310\"},\"neg\":\{\"type\":\"float\",\"value\":\"-0.1\"},\"neg-exp\":\{\"type\":\"float\",\"value\":\"0.03\"},\"pos-exp\":\{\"type\":\"float\",\"value\":\"300\"},\"zero\":\{\"type\":\"float\",\"value\":\"0\"},\"zero-exp\":\{\"type\":\"float\",\"value\":\"3\"},\"zero-plus\":\{\"type\":\"float\",\"value\":\"0\"}}"),
        Case("valid/float/exponent-upper", "# Both upper- and lower-case \"e\" is valid, so repeat the exponent.toml test with\n# upper-case.\nexp        = 3E2\npos-exp    = 3E+2\nneg-exp    = 3E-2\nzero-exp   = 3E0\nfrac       = 3.1E2\nneg        = -1E-1\nzero       = 0E2\nzero-plus = +0E2\n", "\{\"exp\":\{\"type\":\"float\",\"value\":\"300\"},\"frac\":\{\"type\":\"float\",\"value\":\"310\"},\"neg\":\{\"type\":\"float\",\"value\":\"-0.1\"},\"neg-exp\":\{\"type\":\"float\",\"value\":\"0.03\"},\"pos-exp\":\{\"type\":\"float\",\"value\":\"300\"},\"zero\":\{\"type\":\"float\",\"value\":\"0\"},\"zero-exp\":\{\"type\":\"float\",\"value\":\"3\"},\"zero-plus\":\{\"type\":\"float\",\"value\":\"0\"}}"),
        Case("valid/float/float", "pi = 3.14\npospi = +3.14\nnegpi = -3.14\nzero-intpart = 0.123\nleading-zero-fractional = 0.0123\n", "\{\"negpi\":\{\"type\":\"float\",\"value\":\"-3.14\"},\"pi\":\{\"type\":\"float\",\"value\":\"3.14\"},\"pospi\":\{\"type\":\"float\",\"value\":\"3.14\"},\"zero-intpart\":\{\"type\":\"float\",\"value\":\"0.123\"},\"leading-zero-fractional\":\{\"type\":\"float\",\"value\":\"0.0123\"}}"),
        Case("valid/float/inf-and-nan", "# We don't encode +nan and -nan back with the signs; many languages don't\n# support a sign on NaN (it doesn't really make much sense).\nnan = nan\nnan_neg = -nan\nnan_plus = +nan\ninfinity = inf\ninfinity_neg = -inf\ninfinity_plus = +inf\n", "\{\"infinity\":\{\"type\":\"float\",\"value\":\"inf\"},\"infinity_neg\":\{\"type\":\"float\",\"value\":\"-inf\"},\"infinity_plus\":\{\"type\":\"float\",\"value\":\"inf\"},\"nan\":\{\"type\":\"float\",\"value\":\"nan\"},\"nan_neg\":\{\"type\":\"float\",\"value\":\"nan\"},\"nan_plus\":\{\"type\":\"float\",\"value\":\"nan\"}}"),
        Case("valid/float/long", "longpi = 3.141592653589793\nneglongpi = -3.141592653589793\n", "\{\"longpi\":\{\"type\":\"float\",\"value\":\"3.141592653589793\"},\"neglongpi\":\{\"type\":\"float\",\"value\":\"-3.141592653589793\"}}"),
        Case("valid/float/max-int", "# Maximum and minimum safe natural numbers.\nmax_float =  9_007_199_254_740_991.0\nmin_float = -9_007_199_254_740_991.0\n", "\{\"max_float\":\{\"type\":\"float\",\"value\":\"9007199254740991\"},\"min_float\":\{\"type\":\"float\",\"value\":\"-9007199254740991\"}}"),
        Case("valid/float/underscore", "before = 3_141.5927\nafter = 3141.592_7\nexponent = 3e1_4\n", "\{\"after\":\{\"type\":\"float\",\"value\":\"3141.5927\"},\"before\":\{\"type\":\"float\",\"value\":\"3141.5927\"},\"exponent\":\{\"type\":\"float\",\"value\":\"3.0e14\"}}"),
        Case("valid/float/zero", "zero = 0.0\nsigned-pos = +0.0\nsigned-neg = -0.0\nexponent = 0e0\nexponent-two-0 = 0e00\nexponent-signed-pos = +0e0\nexponent-signed-neg = -0e0\n", "\{\"exponent\":\{\"type\":\"float\",\"value\":\"0\"},\"exponent-signed-neg\":\{\"type\":\"float\",\"value\":\"-0\"},\"exponent-signed-pos\":\{\"type\":\"float\",\"value\":\"0\"},\"exponent-two-0\":\{\"type\":\"float\",\"value\":\"0\"},\"signed-neg\":\{\"type\":\"float\",\"value\":\"-0\"},\"signed-pos\":\{\"type\":\"float\",\"value\":\"0\"},\"zero\":\{\"type\":\"float\",\"value\":\"0\"}}"),
        Case("valid/implicit-and-explicit-after", "[a.b.c]\nanswer = 42\n\n[a]\nbetter = 43\n", "\{\"a\":\{\"better\":\{\"type\":\"integer\",\"value\":\"43\"},\"b\":\{\"c\":\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}}}}"),
        Case("valid/implicit-and-explicit-before", "[a]\nbetter = 43\n\n[a.b.c]\nanswer = 42\n", "\{\"a\":\{\"better\":\{\"type\":\"integer\",\"value\":\"43\"},\"b\":\{\"c\":\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}}}}"),
        Case("valid/implicit-groups", "[a.b.c]\nanswer = 42\n", "\{\"a\":\{\"b\":\{\"c\":\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}}}}"),
        Case("valid/inline-table/array-01", "arr = [ \{'a'= 1}, \{'a'= 2} ]\n\npeople = [\{first_name = \"Bruce\", last_name = \"Springsteen\"},\n          \{first_name = \"Eric\", last_name = \"Clapton\"},\n          \{first_name = \"Bob\", last_name = \"Seger\"}]\n", "\{\"arr\":[\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"}},\{\"a\":\{\"type\":\"integer\",\"value\":\"2\"}}],\"people\":[\{\"first_name\":\{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Springsteen\"}},\{\"first_name\":\{\"type\":\"string\",\"value\":\"Eric\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Clapton\"}},\{\"first_name\":\{\"type\":\"string\",\"value\":\"Bob\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Seger\"}}]}"),
        Case("valid/inline-table/array-02", "# \"No newlines are allowed between the curly braces unless they are valid within\n# a value\"\n\na = \{ a = [\n]}\n", "\{\"a\":\{\"a\":[]}}"),
        Case("valid/inline-table/array-03", "b = \{ a = [\n\t\t1,\n\t\t2,\n\t], b = [\n\t\t3,\n\t\t4,\n\t]}\n", "\{\"b\":\{\"a\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}],\"b\":[\{\"type\":\"integer\",\"value\":\"3\"},\{\"type\":\"integer\",\"value\":\"4\"}]}}"),
        Case("valid/inline-table/bool", "a = \{a = true, b = false}\n", "\{\"a\":\{\"a\":\{\"type\":\"bool\",\"value\":\"true\"},\"b\":\{\"type\":\"bool\",\"value\":\"false\"}}}"),
        Case("valid/inline-table/empty", "empty1 = \{}\nempty2 = \{ }\nempty_in_array = [ \{ not_empty = 1 }, \{} ]\nempty_in_array2 = [\{},\{not_empty=1}]\nmany_empty = [\{},\{},\{}]\nnested_empty = \{\"empty\"=\{}}\nwith_cmt =\{            }#nothing here\n", "\{\"empty1\":\{},\"empty2\":\{},\"with_cmt\":\{},\"empty_in_array\":[\{\"not_empty\":\{\"type\":\"integer\",\"value\":\"1\"}},\{}],\"empty_in_array2\":[\{},\{\"not_empty\":\{\"type\":\"integer\",\"value\":\"1\"}}],\"many_empty\":[\{},\{},\{}],\"nested_empty\":\{\"empty\":\{}}}"),
        Case("valid/inline-table/end-in-bool", "black = \{ python=\">3.6\", version=\">=18.9b0\", allow_prereleases=true }\n", "\{\"black\":\{\"allow_prereleases\":\{\"type\":\"bool\",\"value\":\"true\"},\"python\":\{\"type\":\"string\",\"value\":\">3.6\"},\"version\":\{\"type\":\"string\",\"value\":\">=18.9b0\"}}}"),
        Case("valid/inline-table/inline-table", "name        = \{ first = \"Tom\", last = \"Preston-Werner\" }\npoint       = \{ x = 1, y = 2 }\nsimple      = \{ a = 1 }\nstr-key     = \{ \"a\" = 1 }\ntable-array = [\{ \"a\" = 1 }, \{ \"b\" = 2 }]\n", "\{\"name\":\{\"first\":\{\"type\":\"string\",\"value\":\"Tom\"},\"last\":\{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":\{\"x\":\{\"type\":\"integer\",\"value\":\"1\"},\"y\":\{\"type\":\"integer\",\"value\":\"2\"}},\"simple\":\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"}},\"str-key\":\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"}},\"table-array\":[\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"}},\{\"b\":\{\"type\":\"integer\",\"value\":\"2\"}}]}"),
        Case("valid/inline-table/key-dotted-01", "a = \{   a.b  =  1   }\nb = \{   \"a\".\"b\"  =  1   }\nc = \{   a   .   b  =  1   }\nd = \{   'a'   .   \"b\"  =  1   }\ne = \{a.b=1}\n", "\{\"a\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\"b\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\"c\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\"d\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\"e\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}}}"),
        Case("valid/inline-table/key-dotted-02", "many.dots.here.dot.dot.dot = \{a.b.c = 1, a.b.d = 2}\n", "\{\"many\":\{\"dots\":\{\"here\":\{\"dot\":\{\"dot\":\{\"dot\":\{\"a\":\{\"b\":\{\"c\":\{\"type\":\"integer\",\"value\":\"1\"},\"d\":\{\"type\":\"integer\",\"value\":\"2\"}}}}}}}}}}"),
        Case("valid/inline-table/key-dotted-03", "[tbl]\na.b.c = \{d.e=1}\n\n[tbl.x]\na.b.c = \{d.e=1}\n", "\{\"tbl\":\{\"a\":\{\"b\":\{\"c\":\{\"d\":\{\"e\":\{\"type\":\"integer\",\"value\":\"1\"}}}}},\"x\":\{\"a\":\{\"b\":\{\"c\":\{\"d\":\{\"e\":\{\"type\":\"integer\",\"value\":\"1\"}}}}}}}}"),
        Case("valid/inline-table/key-dotted-04", "[[arr]]\nt = \{a.b=1}\nT = \{a.b=1}\n\n[[arr]]\nt = \{a.b=2}\nT = \{a.b=2}\n", "\{\"arr\":[\{\"T\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\"t\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}}},\{\"T\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"2\"}}},\"t\":\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"2\"}}}}]}"),
        Case("valid/inline-table/key-dotted-05", "arr-1 = [\{a.b = 1}]\narr-2 = [\"str\", \{a.b = 1}]\n\narr-3 = [\{a.b = 1}, \{a.b = 2}]\narr-4 = [\"str\", \{a.b = 1}, \{a.b = 2}]\n", "\{\"arr-1\":[\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}}],\"arr-2\":[\{\"type\":\"string\",\"value\":\"str\"},\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}}],\"arr-3\":[\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"2\"}}}],\"arr-4\":[\{\"type\":\"string\",\"value\":\"str\"},\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"1\"}}},\{\"a\":\{\"b\":\{\"type\":\"integer\",\"value\":\"2\"}}}]}"),
        Case("valid/inline-table/key-dotted-06", "top.dot.dot = [\n\t\{dot.dot.dot = 1},\n\t\{dot.dot.dot = 2},\n]\n", "\{\"top\":\{\"dot\":\{\"dot\":[\{\"dot\":\{\"dot\":\{\"dot\":\{\"type\":\"integer\",\"value\":\"1\"}}}},\{\"dot\":\{\"dot\":\{\"dot\":\{\"type\":\"integer\",\"value\":\"2\"}}}}]}}}"),
        Case("valid/inline-table/key-dotted-07", "arr = [\n\t\{a.b = [\{c.d = 1}]}\n]\n", "\{\"arr\":[\{\"a\":\{\"b\":[\{\"c\":\{\"d\":\{\"type\":\"integer\",\"value\":\"1\"}}}]}}]}"),
        Case("valid/inline-table/multiline", "tbl_multiline = \{ a = 1, b = \"\"\"\nmultiline\n\"\"\", c = \"\"\"and yet\nanother line\"\"\", d = 4 }\n", "\{\"tbl_multiline\":\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"},\"b\":\{\"type\":\"string\",\"value\":\"multiline\\n\"},\"c\":\{\"type\":\"string\",\"value\":\"and yet\\nanother line\"},\"d\":\{\"type\":\"integer\",\"value\":\"4\"}}}"),
        Case("valid/inline-table/nest", "tbl_tbl_empty = \{ tbl_0 = \{} }\ntbl_tbl_val   = \{ tbl_1 = \{ one = 1 } }\ntbl_arr_tbl   = \{ arr_tbl = [ \{ one = 1 } ] }\narr_tbl_tbl   = [ \{ tbl = \{ one = 1 } } ]\n\n# Array-of-array-of-table is interesting because it can only\n# be represented in inline form.\narr_arr_tbl_empty = [ [ \{} ] ]\narr_arr_tbl_val = [ [ \{ one = 1 } ] ]\narr_arr_tbls  = [ [ \{ one = 1 }, \{ two = 2 } ] ]\n", "\{\"arr_arr_tbl_empty\":[[\{}]],\"arr_arr_tbl_val\":[[\{\"one\":\{\"type\":\"integer\",\"value\":\"1\"}}]],\"arr_arr_tbls\":[[\{\"one\":\{\"type\":\"integer\",\"value\":\"1\"}},\{\"two\":\{\"type\":\"integer\",\"value\":\"2\"}}]],\"arr_tbl_tbl\":[\{\"tbl\":\{\"one\":\{\"type\":\"integer\",\"value\":\"1\"}}}],\"tbl_arr_tbl\":\{\"arr_tbl\":[\{\"one\":\{\"type\":\"integer\",\"value\":\"1\"}}]},\"tbl_tbl_empty\":\{\"tbl_0\":\{}},\"tbl_tbl_val\":\{\"tbl_1\":\{\"one\":\{\"type\":\"integer\",\"value\":\"1\"}}}}"),
        Case("valid/inline-table/spaces", "# https://github.com/toml-lang/toml-test/issues/146\nclap-1 = \{ version = \"4\"  , features = [\"derive\", \"cargo\"] }\n\n# Contains some literal tabs!\nclap-2 = \{ version = \"4\"\t   \t,\t  \tfeatures = [   \"derive\" \t  ,  \t  \"cargo\"   ]   , nest   =   \{  \t  \"a\"   =   'x'  , \t  'b'   = [ 1.5    ,   9.0  ]  }  }\n", "\{\"clap-1\":\{\"version\":\{\"type\":\"string\",\"value\":\"4\"},\"features\":[\{\"type\":\"string\",\"value\":\"derive\"},\{\"type\":\"string\",\"value\":\"cargo\"}]},\"clap-2\":\{\"version\":\{\"type\":\"string\",\"value\":\"4\"},\"features\":[\{\"type\":\"string\",\"value\":\"derive\"},\{\"type\":\"string\",\"value\":\"cargo\"}],\"nest\":\{\"a\":\{\"type\":\"string\",\"value\":\"x\"},\"b\":[\{\"type\":\"float\",\"value\":\"1.5\"},\{\"type\":\"float\",\"value\":\"9\"}]}}}"),
        Case("valid/integer/float64-max", "# Maximum and minimum safe float64 natural numbers. Mainly here for\n# -int-as-float.\nmax_int =  9_007_199_254_740_991\nmin_int = -9_007_199_254_740_991\n", "\{\"max_int\":\{\"type\":\"integer\",\"value\":\"9007199254740991\"},\"min_int\":\{\"type\":\"integer\",\"value\":\"-9007199254740991\"}}"),
        Case("valid/integer/integer", "answer = 42\nposanswer = +42\nneganswer = -42\nzero = 0\n", "\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"},\"neganswer\":\{\"type\":\"integer\",\"value\":\"-42\"},\"posanswer\":\{\"type\":\"integer\",\"value\":\"42\"},\"zero\":\{\"type\":\"integer\",\"value\":\"0\"}}"),
        Case("valid/integer/literals", "bin1 = 0b11010110\nbin2 = 0b1_0_1\n\noct1 = 0o01234567\noct2 = 0o755\noct3 = 0o7_6_5\n\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef\nhex4 = 0x00987\n", "\{\"bin1\":\{\"type\":\"integer\",\"value\":\"214\"},\"bin2\":\{\"type\":\"integer\",\"value\":\"5\"},\"hex1\":\{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex2\":\{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex3\":\{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex4\":\{\"type\":\"integer\",\"value\":\"2439\"},\"oct1\":\{\"type\":\"integer\",\"value\":\"342391\"},\"oct2\":\{\"type\":\"integer\",\"value\":\"493\"},\"oct3\":\{\"type\":\"integer\",\"value\":\"501\"}}"),
        Case("valid/integer/long", "# int64 \"should\" be supported, but is not mandatory. It's fine to skip this\n# test.\nint64-max     = 9223372036854775807\nint64-max-neg = -9223372036854775808\n", "\{\"int64-max\":\{\"type\":\"integer\",\"value\":\"9223372036854775807\"},\"int64-max-neg\":\{\"type\":\"integer\",\"value\":\"-9223372036854775808\"}}"),
        Case("valid/integer/underscore", "kilo = 1_000\nx = 1_1_1_1\n", "\{\"kilo\":\{\"type\":\"integer\",\"value\":\"1000\"},\"x\":\{\"type\":\"integer\",\"value\":\"1111\"}}"),
        Case("valid/integer/zero", "d1 = 0\nd2 = +0\nd3 = -0\n\nh1 = 0x0\nh2 = 0x00\nh3 = 0x00000\n\no1 = 0o0\na2 = 0o00\na3 = 0o00000\n\nb1 = 0b0\nb2 = 0b00\nb3 = 0b00000\n", "\{\"a2\":\{\"type\":\"integer\",\"value\":\"0\"},\"a3\":\{\"type\":\"integer\",\"value\":\"0\"},\"b1\":\{\"type\":\"integer\",\"value\":\"0\"},\"b2\":\{\"type\":\"integer\",\"value\":\"0\"},\"b3\":\{\"type\":\"integer\",\"value\":\"0\"},\"d1\":\{\"type\":\"integer\",\"value\":\"0\"},\"d2\":\{\"type\":\"integer\",\"value\":\"0\"},\"d3\":\{\"type\":\"integer\",\"value\":\"0\"},\"h1\":\{\"type\":\"integer\",\"value\":\"0\"},\"h2\":\{\"type\":\"integer\",\"value\":\"0\"},\"h3\":\{\"type\":\"integer\",\"value\":\"0\"},\"o1\":\{\"type\":\"integer\",\"value\":\"0\"}}"),
        Case("valid/key/alphanum", "alpha = \"a\"\n123 = \"num\"\n000111 = \"leading\"\n10e3 = \"false float\"\none1two2 = \"mixed\"\nwith-dash = \"dashed\"\nunder_score = \"___\"\n34-11 = 23\n\n[2018_10]\n001 = 1\n\n[a-a-a]\n_ = false\n", "\{\"000111\":\{\"type\":\"string\",\"value\":\"leading\"},\"10e3\":\{\"type\":\"string\",\"value\":\"false float\"},\"123\":\{\"type\":\"string\",\"value\":\"num\"},\"34-11\":\{\"type\":\"integer\",\"value\":\"23\"},\"alpha\":\{\"type\":\"string\",\"value\":\"a\"},\"one1two2\":\{\"type\":\"string\",\"value\":\"mixed\"},\"under_score\":\{\"type\":\"string\",\"value\":\"___\"},\"with-dash\":\{\"type\":\"string\",\"value\":\"dashed\"},\"2018_10\":\{\"001\":\{\"type\":\"integer\",\"value\":\"1\"}},\"a-a-a\":\{\"_\":\{\"type\":\"bool\",\"value\":\"false\"}}}"),
        Case("valid/key/case-sensitive", "sectioN = \"NN\"\n\n[section]\nname = \"lower\"\nNAME = \"upper\"\nName = \"capitalized\"\n\n[Section]\nname = \"different section!!\"\n\"μ\" = \"greek small letter mu\"\n\"Μ\" = \"greek capital letter MU\"\nM = \"latin letter M\"\n\n", "\{\"sectioN\":\{\"type\":\"string\",\"value\":\"NN\"},\"Section\":\{\"M\":\{\"type\":\"string\",\"value\":\"latin letter M\"},\"name\":\{\"type\":\"string\",\"value\":\"different section!!\"},\"Μ\":\{\"type\":\"string\",\"value\":\"greek capital letter MU\"},\"μ\":\{\"type\":\"string\",\"value\":\"greek small letter mu\"}},\"section\":\{\"NAME\":\{\"type\":\"string\",\"value\":\"upper\"},\"Name\":\{\"type\":\"string\",\"value\":\"capitalized\"},\"name\":\{\"type\":\"string\",\"value\":\"lower\"}}}"),
    ]

fn valid_2() List[Case]
    [
        Case("valid/key/dotted-01", "name.first = \"Arthur\"\n\"name\".'last' = \"Dent\"\n\nmany.dots.dot.dot.dot = 42\n", "\{\"many\":\{\"dots\":\{\"dot\":\{\"dot\":\{\"dot\":\{\"type\":\"integer\",\"value\":\"42\"}}}}},\"name\":\{\"first\":\{\"type\":\"string\",\"value\":\"Arthur\"},\"last\":\{\"type\":\"string\",\"value\":\"Dent\"}}}"),
        Case("valid/key/dotted-02", "# Note: this file contains literal tab characters.\n\n# Space are ignored, and key parts can be quoted.\ncount.a       = 1\ncount . b     = 2\n\"count\".\"c\"   = 3\n\"count\" . \"d\" = 4\n'count'.'e'   = 5\n'count' . 'f' = 6\n\"count\".'g'   = 7\n\"count\" . 'h' = 8\ncount.'i'     = 9\ncount \t.\t 'j'\t   = 10\n\"count\".k     = 11\n\"count\" . l   = 12\n", "\{\"count\":\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"},\"b\":\{\"type\":\"integer\",\"value\":\"2\"},\"c\":\{\"type\":\"integer\",\"value\":\"3\"},\"d\":\{\"type\":\"integer\",\"value\":\"4\"},\"e\":\{\"type\":\"integer\",\"value\":\"5\"},\"f\":\{\"type\":\"integer\",\"value\":\"6\"},\"g\":\{\"type\":\"integer\",\"value\":\"7\"},\"h\":\{\"type\":\"integer\",\"value\":\"8\"},\"i\":\{\"type\":\"integer\",\"value\":\"9\"},\"j\":\{\"type\":\"integer\",\"value\":\"10\"},\"k\":\{\"type\":\"integer\",\"value\":\"11\"},\"l\":\{\"type\":\"integer\",\"value\":\"12\"}}}"),
        Case("valid/key/dotted-03", "top.key = 1\n\n[tbl]\na.b.c = 42.666\n\n[a.few.dots]\npolka.dot = \"again?\"\npolka.dance-with = \"Dot\"\n\n", "\{\"a\":\{\"few\":\{\"dots\":\{\"polka\":\{\"dance-with\":\{\"type\":\"string\",\"value\":\"Dot\"},\"dot\":\{\"type\":\"string\",\"value\":\"again?\"}}}}},\"tbl\":\{\"a\":\{\"b\":\{\"c\":\{\"type\":\"float\",\"value\":\"42.666\"}}}},\"top\":\{\"key\":\{\"type\":\"integer\",\"value\":\"1\"}}}"),
        Case("valid/key/dotted-04", "top.key = 1\n\n[[arr]]\na.b.c=1\na.b.d=2\n\n[[arr]]\na.b.c=3\na.b.d=4\n\n", "\{\"arr\":[\{\"a\":\{\"b\":\{\"c\":\{\"type\":\"integer\",\"value\":\"1\"},\"d\":\{\"type\":\"integer\",\"value\":\"2\"}}}},\{\"a\":\{\"b\":\{\"c\":\{\"type\":\"integer\",\"value\":\"3\"},\"d\":\{\"type\":\"integer\",\"value\":\"4\"}}}}],\"top\":\{\"key\":\{\"type\":\"integer\",\"value\":\"1\"}}}"),
        Case("valid/key/dotted-empty", "''.x = \"empty.x\"\nx.\"\" = \"x.empty\"\n[a]\n\"\".'' = \"empty.empty\"\n", "\{\"\":\{\"x\":\{\"type\":\"string\",\"value\":\"empty.x\"}},\"a\":\{\"\":\{\"\":\{\"type\":\"string\",\"value\":\"empty.empty\"}}},\"x\":\{\"\":\{\"type\":\"string\",\"value\":\"x.empty\"}}}"),
        Case("valid/key/empty-01", "\"\" = \"blank\"\n", "\{\"\":\{\"type\":\"string\",\"value\":\"blank\"}}"),
        Case("valid/key/empty-02", "'' = \"blank\"\n", "\{\"\":\{\"type\":\"string\",\"value\":\"blank\"}}"),
        Case("valid/key/empty-03", "''=0\n", "\{\"\":\{\"type\":\"integer\",\"value\":\"0\"}}"),
        Case("valid/key/empty-04", "tbl-1     = \{\"\" = 1}\ntbl-2     = \{\"\" = \{\"\" = 1}}\narr-tbl-1 = [\{\"\" = 2}]\narr-tbl-2 = [[\{\"\" = 2}]]\n", "\{\"arr-tbl-1\":[\{\"\":\{\"type\":\"integer\",\"value\":\"2\"}}],\"arr-tbl-2\":[[\{\"\":\{\"type\":\"integer\",\"value\":\"2\"}}]],\"tbl-1\":\{\"\":\{\"type\":\"integer\",\"value\":\"1\"}},\"tbl-2\":\{\"\":\{\"\":\{\"type\":\"integer\",\"value\":\"1\"}}}}"),
        Case("valid/key/equals-nospace", "answer=42\n", "\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}"),
        Case("valid/key/escapes", "\"\\n\" = \"newline\"\n\"\\b\" = \"bell\"\n\"\\u00c0\" = \"latin capital letter A with grave\"\n\"\\\"\" = \"just a quote\"\n\n[\"backsp\\b\\b\"]\n\n[\"\\\"quoted\\\"\"]\nquote = true\n\n[\"a.b\".\"\\u00c0\"]\n", "\{\"\\b\":\{\"type\":\"string\",\"value\":\"bell\"},\"\\n\":\{\"type\":\"string\",\"value\":\"newline\"},\"\\\"\":\{\"type\":\"string\",\"value\":\"just a quote\"},\"backsp\\b\\b\":\{},\"À\":\{\"type\":\"string\",\"value\":\"latin capital letter A with grave\"},\"\\\"quoted\\\"\":\{\"quote\":\{\"type\":\"bool\",\"value\":\"true\"}},\"a.b\":\{\"À\":\{}}}"),
        Case("valid/key/like-date", "# '-' is a valid character in keys: make a key that looks like a date.\n2001-02-03   = 1\n\"2001-02-04\" = 2\n'2001-02-05' = 3\n\n# Also include datetime and time for good measure; these need to be quoted as\n# ':' isn't a valid bare key.\n\"2001-02-06T15:16:17+01:00\" = 4\n\"2001-02-07T15:16:17\"       = 5\n\"15:16:17\"                  = 6\n\n# Dotted keys\na.2001-02-08 = 7\na.2001-02-09.2001-02-10 = 8\n2001-02-11.a.2001-02-12 = 9\n\n# Table names\n[2002-01-02]\nk = 10\n\n[2002-01-02.2024-01-03]\nk = 11\n\n[[2002-01-04]]\nk = 12\n", "\{\"15:16:17\":\{\"type\":\"integer\",\"value\":\"6\"},\"2001-02-03\":\{\"type\":\"integer\",\"value\":\"1\"},\"2001-02-04\":\{\"type\":\"integer\",\"value\":\"2\"},\"2001-02-05\":\{\"type\":\"integer\",\"value\":\"3\"},\"2001-02-06T15:16:17+01:00\":\{\"type\":\"integer\",\"value\":\"4\"},\"2001-02-07T15:16:17\":\{\"type\":\"integer\",\"value\":\"5\"},\"2002-01-04\":[\{\"k\":\{\"type\":\"integer\",\"value\":\"12\"}}],\"2001-02-11\":\{\"a\":\{\"2001-02-12\":\{\"type\":\"integer\",\"value\":\"9\"}}},\"2002-01-02\":\{\"k\":\{\"type\":\"integer\",\"value\":\"10\"},\"2024-01-03\":\{\"k\":\{\"type\":\"integer\",\"value\":\"11\"}}},\"a\":\{\"2001-02-08\":\{\"type\":\"integer\",\"value\":\"7\"},\"2001-02-09\":\{\"2001-02-10\":\{\"type\":\"integer\",\"value\":\"8\"}}}}"),
        Case("valid/key/numeric-01", "1     = true\n", "\{\"1\":\{\"type\":\"bool\",\"value\":\"true\"}}"),
        Case("valid/key/numeric-02", "1.2   = true\n", "\{\"1\":\{\"2\":\{\"type\":\"bool\",\"value\":\"true\"}}}"),
        Case("valid/key/numeric-03", "0123  = true\n", "\{\"0123\":\{\"type\":\"bool\",\"value\":\"true\"}}"),
        Case("valid/key/numeric-04", "01.23 = true\n", "\{\"01\":\{\"23\":\{\"type\":\"bool\",\"value\":\"true\"}}}"),
        Case("valid/key/numeric-05", "23.01 = true\n", "\{\"23\":\{\"01\":\{\"type\":\"bool\",\"value\":\"true\"}}}"),
        Case("valid/key/numeric-06", "-1    = true\n", "\{\"-1\":\{\"type\":\"bool\",\"value\":\"true\"}}"),
        Case("valid/key/numeric-07", "-01   = true\n", "\{\"-01\":\{\"type\":\"bool\",\"value\":\"true\"}}"),
        Case("valid/key/numeric-08", "1  = 'one'\n01 = 'zero one'\n", "\{\"01\":\{\"type\":\"string\",\"value\":\"zero one\"},\"1\":\{\"type\":\"string\",\"value\":\"one\"}}"),
        Case("valid/key/quoted-dots", "plain = 1\n\"with.dot\" = 2\n\n[plain_table]\nplain = 3\n\"with.dot\" = 4\n\n[table.withdot]\nplain = 5\n\"key.with.dots\" = 6\n\"escaped\\u002edot\" = 7\n", "\{\"plain\":\{\"type\":\"integer\",\"value\":\"1\"},\"with.dot\":\{\"type\":\"integer\",\"value\":\"2\"},\"plain_table\":\{\"plain\":\{\"type\":\"integer\",\"value\":\"3\"},\"with.dot\":\{\"type\":\"integer\",\"value\":\"4\"}},\"table\":\{\"withdot\":\{\"escaped.dot\":\{\"type\":\"integer\",\"value\":\"7\"},\"key.with.dots\":\{\"type\":\"integer\",\"value\":\"6\"},\"plain\":\{\"type\":\"integer\",\"value\":\"5\"}}}}"),
        Case("valid/key/quoted-unicode", "\n\"\\u0000\" = \"null\"\n'\\u0000' = \"different key\"\n\"\\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\" = \"escaped key\"\n\n\"~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\" = \"basic key\"\n'l ~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}' = \"literal key\"\n", "\{\"\\u0000\":\{\"type\":\"string\",\"value\":\"null\"},\"\\b \\f A \u{7f} \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\":\{\"type\":\"string\",\"value\":\"escaped key\"},\"\\\\u0000\":\{\"type\":\"string\",\"value\":\"different key\"},\"l ~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\":\{\"type\":\"string\",\"value\":\"literal key\"},\"~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\":\{\"type\":\"string\",\"value\":\"basic key\"}}"),
        Case("valid/key/space", "# Keep whitespace inside quotes keys at all positions.\n\"a b\"   = 1\n\" c d \" = 2\n\"  much \t\t  whitespace  \t\\n  \\r\\n  \" = 3\n\n[ \" tbl \" ]\n\"\\ttab\\ttab\\t\" = \"tab\"\n", "\{\"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \":\{\"type\":\"integer\",\"value\":\"3\"},\" c d \":\{\"type\":\"integer\",\"value\":\"2\"},\"a b\":\{\"type\":\"integer\",\"value\":\"1\"},\" tbl \":\{\"\\ttab\\ttab\\t\":\{\"type\":\"string\",\"value\":\"tab\"}}}"),
        Case("valid/key/special-chars", "\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\" = 1\n", "\{\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\":\{\"type\":\"integer\",\"value\":\"1\"}}"),
        Case("valid/key/special-word", "false = false\ntrue = 1\ninf = 100000000\nnan = \"ceci n'est pas un nombre\"\n\n", "\{\"false\":\{\"type\":\"bool\",\"value\":\"false\"},\"inf\":\{\"type\":\"integer\",\"value\":\"100000000\"},\"nan\":\{\"type\":\"string\",\"value\":\"ceci n'est pas un nombre\"},\"true\":\{\"type\":\"integer\",\"value\":\"1\"}}"),
        Case("valid/key/start", "# Table and keys can start with any character; there is no requirement for it to\n# start with a letter.\n\n[-key]\n-key = 1\n\n[_key]\n_key = 2\n\n[1key]\n1key = 3\n\n[-]\n- = 4\n\n[_]\n_ = 5\n\n[1] \n1 = 6\n\n[---] \n--- = 7\n\n[___]\n___ = 8\n\n[111]\n111 = 9\n\n[inline]\n--- = \{--- = 10, ___ = 11, 111 = 12}\n", "\{\"-\":\{\"-\":\{\"type\":\"integer\",\"value\":\"4\"}},\"---\":\{\"---\":\{\"type\":\"integer\",\"value\":\"7\"}},\"-key\":\{\"-key\":\{\"type\":\"integer\",\"value\":\"1\"}},\"1\":\{\"1\":\{\"type\":\"integer\",\"value\":\"6\"}},\"111\":\{\"111\":\{\"type\":\"integer\",\"value\":\"9\"}},\"1key\":\{\"1key\":\{\"type\":\"integer\",\"value\":\"3\"}},\"_\":\{\"_\":\{\"type\":\"integer\",\"value\":\"5\"}},\"___\":\{\"___\":\{\"type\":\"integer\",\"value\":\"8\"}},\"_key\":\{\"_key\":\{\"type\":\"integer\",\"value\":\"2\"}},\"inline\":\{\"---\":\{\"---\":\{\"type\":\"integer\",\"value\":\"10\"},\"111\":\{\"type\":\"integer\",\"value\":\"12\"},\"___\":\{\"type\":\"integer\",\"value\":\"11\"}}}}"),
        Case("valid/key/zero", "0=0\n", "\{\"0\":\{\"type\":\"integer\",\"value\":\"0\"}}"),
        Case("valid/multibyte", "# Test multibyte throughout\n\n# Tèƨƭ ƒïℓè ƒôř TÓM£\n# Óñℓ¥ ƭλïƨ ôñè ƭřïèƨ ƭô è₥úℓáƭè á TÓM£ ƒïℓè ωřïƭƭèñ β¥ á úƨèř ôƒ ƭλè ƙïñδ ôƒ ƥářƨèř ωřïƭèřƨ ƥřôβáβℓ¥ λáƭè\n\n['𝐭𝐛𝐥']\nstring = \"𝓼𝓽𝓻𝓲𝓷𝓰 - #\"          # \" 𝓼𝓽𝓻𝓲𝓷𝓰\n\t['𝐭𝐛𝐥'.sub]\n\t'𝕒𝕣𝕣𝕒𝕪' = [ \"] \", \" # \"]      # ] 𝓪𝓻𝓻𝓪𝔂\n\t'𝕒𝕣𝕣𝕒𝕪𝟚' = [ \"Tèƨƭ #11 ]ƥřôƲèδ ƭλáƭ\", \"Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ\" ]\n\t# Ýôú δïδñ'ƭ ƭλïñƙ ïƭ'δ áƨ èáƨ¥ áƨ çλúçƙïñϱ ôúƭ ƭλè ℓáƨƭ #, δïδ ¥ôú?\n\tanother_test_string = \"§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #\"\n\tescapes = \" Âñδ ωλèñ \\\"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \\\"\"   # \"áñδ çô₥₥èñƭƨ ářè ƭλèřè ƭôô\"\n\t# Tλïñϱƨ ωïℓℓ ϱèƭ λářδèř\n\t\t['𝐭𝐛𝐥'.sub.\"βïƭ#\"]\n\t\t\"ωλáƭ?\" = \"Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ δô ƭλáƭ?\"\n\t\tmulti_line_array = [\n\t\t\t\"]\",\n\t\t\t# ] Óλ ¥èƨ Ì δïδ\n\t\t\t]\n", "\{\"𝐭𝐛𝐥\":\{\"string\":\{\"type\":\"string\",\"value\":\"𝓼𝓽𝓻𝓲𝓷𝓰 - #\"},\"sub\":\{\"another_test_string\":\{\"type\":\"string\",\"value\":\"§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #\"},\"escapes\":\{\"type\":\"string\",\"value\":\" Âñδ ωλèñ \\\"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \\\"\"},\"βïƭ#\":\{\"multi_line_array\":[\{\"type\":\"string\",\"value\":\"]\"}],\"ωλáƭ?\":\{\"type\":\"string\",\"value\":\"Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ δô ƭλáƭ?\"}},\"𝕒𝕣𝕣𝕒𝕪\":[\{\"type\":\"string\",\"value\":\"] \"},\{\"type\":\"string\",\"value\":\" # \"}],\"𝕒𝕣𝕣𝕒𝕪𝟚\":[\{\"type\":\"string\",\"value\":\"Tèƨƭ #11 ]ƥřôƲèδ ƭλáƭ\"},\{\"type\":\"string\",\"value\":\"Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ\"}]}}}"),
        Case("valid/newline-crlf", "os = \"DOS\"\r\nnewline = \"crlf\"\r\n", "\{\"newline\":\{\"type\":\"string\",\"value\":\"crlf\"},\"os\":\{\"type\":\"string\",\"value\":\"DOS\"}}"),
        Case("valid/newline-lf", "os = \"unix\"\nnewline = \"lf\"\n", "\{\"newline\":\{\"type\":\"string\",\"value\":\"lf\"},\"os\":\{\"type\":\"string\",\"value\":\"unix\"}}"),
        Case("valid/spec-1.0.0/array-0", "integers = [ 1, 2, 3 ]\ncolors = [ \"red\", \"yellow\", \"green\" ]\nnested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]\nnested_mixed_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\nstring_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\n\n# Mixed-type arrays are allowed\nnumbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\ncontributors = [\n  \"Foo Bar <foo@example.com>\",\n  \{ name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\n]\n", "\{\"colors\":[\{\"type\":\"string\",\"value\":\"red\"},\{\"type\":\"string\",\"value\":\"yellow\"},\{\"type\":\"string\",\"value\":\"green\"}],\"contributors\":[\{\"type\":\"string\",\"value\":\"Foo Bar <foo@example.com>\"},\{\"email\":\{\"type\":\"string\",\"value\":\"bazqux@example.com\"},\"name\":\{\"type\":\"string\",\"value\":\"Baz Qux\"},\"url\":\{\"type\":\"string\",\"value\":\"https://example.com/bazqux\"}}],\"integers\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"},\{\"type\":\"integer\",\"value\":\"3\"}],\"nested_arrays_of_ints\":[[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}],[\{\"type\":\"integer\",\"value\":\"3\"},\{\"type\":\"integer\",\"value\":\"4\"},\{\"type\":\"integer\",\"value\":\"5\"}]],\"nested_mixed_array\":[[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}],[\{\"type\":\"string\",\"value\":\"a\"},\{\"type\":\"string\",\"value\":\"b\"},\{\"type\":\"string\",\"value\":\"c\"}]],\"numbers\":[\{\"type\":\"float\",\"value\":\"0.1\"},\{\"type\":\"float\",\"value\":\"0.2\"},\{\"type\":\"float\",\"value\":\"0.5\"},\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"},\{\"type\":\"integer\",\"value\":\"5\"}],\"string_array\":[\{\"type\":\"string\",\"value\":\"all\"},\{\"type\":\"string\",\"value\":\"strings\"},\{\"type\":\"string\",\"value\":\"are the same\"},\{\"type\":\"string\",\"value\":\"type\"}]}"),
        Case("valid/spec-1.0.0/array-1", "integers2 = [\n  1, 2, 3\n]\n\nintegers3 = [\n  1,\n  2, # this is ok\n]\n", "\{\"integers2\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"},\{\"type\":\"integer\",\"value\":\"3\"}],\"integers3\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}]}"),
        Case("valid/spec-1.0.0/array-of-tables-0", "[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]  # empty table within the array\n\n[[products]]\nname = \"Nail\"\nsku = 284758393\n\ncolor = \"gray\"\n", "\{\"products\":[\{\"name\":\{\"type\":\"string\",\"value\":\"Hammer\"},\"sku\":\{\"type\":\"integer\",\"value\":\"738594937\"}},\{},\{\"color\":\{\"type\":\"string\",\"value\":\"gray\"},\"name\":\{\"type\":\"string\",\"value\":\"Nail\"},\"sku\":\{\"type\":\"integer\",\"value\":\"284758393\"}}]}"),
        Case("valid/spec-1.0.0/array-of-tables-1", "[[fruits]]\nname = \"apple\"\n\n[fruits.physical]  # subtable\ncolor = \"red\"\nshape = \"round\"\n\n[[fruits.varieties]]  # nested array of tables\nname = \"red delicious\"\n\n[[fruits.varieties]]\nname = \"granny smith\"\n\n\n[[fruits]]\nname = \"banana\"\n\n[[fruits.varieties]]\nname = \"plantain\"\n", "\{\"fruits\":[\{\"name\":\{\"type\":\"string\",\"value\":\"apple\"},\"physical\":\{\"color\":\{\"type\":\"string\",\"value\":\"red\"},\"shape\":\{\"type\":\"string\",\"value\":\"round\"}},\"varieties\":[\{\"name\":\{\"type\":\"string\",\"value\":\"red delicious\"}},\{\"name\":\{\"type\":\"string\",\"value\":\"granny smith\"}}]},\{\"name\":\{\"type\":\"string\",\"value\":\"banana\"},\"varieties\":[\{\"name\":\{\"type\":\"string\",\"value\":\"plantain\"}}]}]}"),
        Case("valid/spec-1.0.0/array-of-tables-2", "points = [ \{ x = 1, y = 2, z = 3 },\n           \{ x = 7, y = 8, z = 9 },\n           \{ x = 2, y = 4, z = 8 } ]\n", "\{\"points\":[\{\"x\":\{\"type\":\"integer\",\"value\":\"1\"},\"y\":\{\"type\":\"integer\",\"value\":\"2\"},\"z\":\{\"type\":\"integer\",\"value\":\"3\"}},\{\"x\":\{\"type\":\"integer\",\"value\":\"7\"},\"y\":\{\"type\":\"integer\",\"value\":\"8\"},\"z\":\{\"type\":\"integer\",\"value\":\"9\"}},\{\"x\":\{\"type\":\"integer\",\"value\":\"2\"},\"y\":\{\"type\":\"integer\",\"value\":\"4\"},\"z\":\{\"type\":\"integer\",\"value\":\"8\"}}]}"),
        Case("valid/spec-1.0.0/boolean-0", "bool1 = true\nbool2 = false\n", "\{\"bool1\":\{\"type\":\"bool\",\"value\":\"true\"},\"bool2\":\{\"type\":\"bool\",\"value\":\"false\"}}"),
        Case("valid/spec-1.0.0/comment-0", "# This is a full-line comment\nkey = \"value\"  # This is a comment at the end of a line\nanother = \"# This is not a comment\"\n", "\{\"another\":\{\"type\":\"string\",\"value\":\"# This is not a comment\"},\"key\":\{\"type\":\"string\",\"value\":\"value\"}}"),
        Case("valid/spec-1.0.0/float-0", "# fractional\nflt1 = +1.0\nflt2 = 3.1415\nflt3 = -0.01\n\n# exponent\nflt4 = 5e+22\nflt5 = 1e06\nflt6 = -2E-2\n\n# both\nflt7 = 6.626e-34\n", "\{\"flt1\":\{\"type\":\"float\",\"value\":\"1\"},\"flt2\":\{\"type\":\"float\",\"value\":\"3.1415\"},\"flt3\":\{\"type\":\"float\",\"value\":\"-0.01\"},\"flt4\":\{\"type\":\"float\",\"value\":\"5e+22\"},\"flt5\":\{\"type\":\"float\",\"value\":\"1e+06\"},\"flt6\":\{\"type\":\"float\",\"value\":\"-0.02\"},\"flt7\":\{\"type\":\"float\",\"value\":\"6.626e-34\"}}"),
        Case("valid/spec-1.0.0/float-1", "flt8 = 224_617.445_991_228\n", "\{\"flt8\":\{\"type\":\"float\",\"value\":\"224617.445991228\"}}"),
        Case("valid/spec-1.0.0/float-2", "# infinity\nsf1 = inf  # positive infinity\nsf2 = +inf # positive infinity\nsf3 = -inf # negative infinity\n\n# not a number\nsf4 = nan  # actual sNaN/qNaN encoding is implementation-specific\nsf5 = +nan # same as `nan`\nsf6 = -nan # valid, actual encoding is implementation-specific\n", "\{\"sf1\":\{\"type\":\"float\",\"value\":\"inf\"},\"sf2\":\{\"type\":\"float\",\"value\":\"inf\"},\"sf3\":\{\"type\":\"float\",\"value\":\"-inf\"},\"sf4\":\{\"type\":\"float\",\"value\":\"nan\"},\"sf5\":\{\"type\":\"float\",\"value\":\"nan\"},\"sf6\":\{\"type\":\"float\",\"value\":\"nan\"}}"),
    ]

fn valid_3() List[Case]
    [
        Case("valid/spec-1.0.0/inline-table-0", "name = \{ first = \"Tom\", last = \"Preston-Werner\" }\npoint = \{ x = 1, y = 2 }\nanimal = \{ type.name = \"pug\" }\n", "\{\"animal\":\{\"type\":\{\"name\":\{\"type\":\"string\",\"value\":\"pug\"}}},\"name\":\{\"first\":\{\"type\":\"string\",\"value\":\"Tom\"},\"last\":\{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":\{\"x\":\{\"type\":\"integer\",\"value\":\"1\"},\"y\":\{\"type\":\"integer\",\"value\":\"2\"}}}"),
        Case("valid/spec-1.0.0/inline-table-1", "[name]\nfirst = \"Tom\"\nlast = \"Preston-Werner\"\n\n[point]\nx = 1\ny = 2\n\n[animal]\ntype.name = \"pug\"\n", "\{\"animal\":\{\"type\":\{\"name\":\{\"type\":\"string\",\"value\":\"pug\"}}},\"name\":\{\"first\":\{\"type\":\"string\",\"value\":\"Tom\"},\"last\":\{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":\{\"x\":\{\"type\":\"integer\",\"value\":\"1\"},\"y\":\{\"type\":\"integer\",\"value\":\"2\"}}}"),
        Case("valid/spec-1.0.0/inline-table-2", "[product]\ntype = \{ name = \"Nail\" }\n# type.edible = false  # INVALID\n", "\{\"product\":\{\"type\":\{\"name\":\{\"type\":\"string\",\"value\":\"Nail\"}}}}"),
        Case("valid/spec-1.0.0/inline-table-3", "[product]\ntype.name = \"Nail\"\n# type = \{ edible = false }  # INVALID\n", "\{\"product\":\{\"type\":\{\"name\":\{\"type\":\"string\",\"value\":\"Nail\"}}}}"),
        Case("valid/spec-1.0.0/integer-0", "int1 = +99\nint2 = 42\nint3 = 0\nint4 = -17\n", "\{\"int1\":\{\"type\":\"integer\",\"value\":\"99\"},\"int2\":\{\"type\":\"integer\",\"value\":\"42\"},\"int3\":\{\"type\":\"integer\",\"value\":\"0\"},\"int4\":\{\"type\":\"integer\",\"value\":\"-17\"}}"),
        Case("valid/spec-1.0.0/integer-1", "int5 = 1_000\nint6 = 5_349_221\nint7 = 53_49_221  # Indian number system grouping\nint8 = 1_2_3_4_5  # VALID but discouraged\n", "\{\"int5\":\{\"type\":\"integer\",\"value\":\"1000\"},\"int6\":\{\"type\":\"integer\",\"value\":\"5349221\"},\"int7\":\{\"type\":\"integer\",\"value\":\"5349221\"},\"int8\":\{\"type\":\"integer\",\"value\":\"12345\"}}"),
        Case("valid/spec-1.0.0/integer-2", "# hexadecimal with prefix `0x`\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef\n\n# octal with prefix `0o`\noct1 = 0o01234567\noct2 = 0o755 # useful for Unix file permissions\n\n# binary with prefix `0b`\nbin1 = 0b11010110\n", "\{\"bin1\":\{\"type\":\"integer\",\"value\":\"214\"},\"hex1\":\{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex2\":\{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex3\":\{\"type\":\"integer\",\"value\":\"3735928559\"},\"oct1\":\{\"type\":\"integer\",\"value\":\"342391\"},\"oct2\":\{\"type\":\"integer\",\"value\":\"493\"}}"),
        Case("valid/spec-1.0.0/key-value-pair-0", "key = \"value\"\n", "\{\"key\":\{\"type\":\"string\",\"value\":\"value\"}}"),
        Case("valid/spec-1.0.0/keys-0", "key = \"value\"\nbare_key = \"value\"\nbare-key = \"value\"\n1234 = \"value\"\n", "\{\"1234\":\{\"type\":\"string\",\"value\":\"value\"},\"bare-key\":\{\"type\":\"string\",\"value\":\"value\"},\"bare_key\":\{\"type\":\"string\",\"value\":\"value\"},\"key\":\{\"type\":\"string\",\"value\":\"value\"}}"),
        Case("valid/spec-1.0.0/keys-1", "\"127.0.0.1\" = \"value\"\n\"character encoding\" = \"value\"\n\"ʎǝʞ\" = \"value\"\n'key2' = \"value\"\n'quoted \"value\"' = \"value\"\n", "\{\"127.0.0.1\":\{\"type\":\"string\",\"value\":\"value\"},\"character encoding\":\{\"type\":\"string\",\"value\":\"value\"},\"key2\":\{\"type\":\"string\",\"value\":\"value\"},\"quoted \\\"value\\\"\":\{\"type\":\"string\",\"value\":\"value\"},\"ʎǝʞ\":\{\"type\":\"string\",\"value\":\"value\"}}"),
        Case("valid/spec-1.0.0/keys-3", "name = \"Orange\"\nphysical.color = \"orange\"\nphysical.shape = \"round\"\nsite.\"google.com\" = true\n", "\{\"name\":\{\"type\":\"string\",\"value\":\"Orange\"},\"physical\":\{\"color\":\{\"type\":\"string\",\"value\":\"orange\"},\"shape\":\{\"type\":\"string\",\"value\":\"round\"}},\"site\":\{\"google.com\":\{\"type\":\"bool\",\"value\":\"true\"}}}"),
        Case("valid/spec-1.0.0/keys-4", "fruit.name = \"banana\"     # this is best practice\nfruit. color = \"yellow\"    # same as fruit.color\nfruit . flavor = \"banana\"   # same as fruit.flavor\n", "\{\"fruit\":\{\"color\":\{\"type\":\"string\",\"value\":\"yellow\"},\"flavor\":\{\"type\":\"string\",\"value\":\"banana\"},\"name\":\{\"type\":\"string\",\"value\":\"banana\"}}}"),
        Case("valid/spec-1.0.0/keys-5", "# VALID BUT DISCOURAGED\n\napple.type = \"fruit\"\norange.type = \"fruit\"\n\napple.skin = \"thin\"\norange.skin = \"thick\"\n\napple.color = \"red\"\norange.color = \"orange\"\n", "\{\"apple\":\{\"color\":\{\"type\":\"string\",\"value\":\"red\"},\"skin\":\{\"type\":\"string\",\"value\":\"thin\"},\"type\":\{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":\{\"color\":\{\"type\":\"string\",\"value\":\"orange\"},\"skin\":\{\"type\":\"string\",\"value\":\"thick\"},\"type\":\{\"type\":\"string\",\"value\":\"fruit\"}}}"),
        Case("valid/spec-1.0.0/keys-6", "# RECOMMENDED\n\napple.type = \"fruit\"\napple.skin = \"thin\"\napple.color = \"red\"\n\norange.type = \"fruit\"\norange.skin = \"thick\"\norange.color = \"orange\"\n", "\{\"apple\":\{\"color\":\{\"type\":\"string\",\"value\":\"red\"},\"skin\":\{\"type\":\"string\",\"value\":\"thin\"},\"type\":\{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":\{\"color\":\{\"type\":\"string\",\"value\":\"orange\"},\"skin\":\{\"type\":\"string\",\"value\":\"thick\"},\"type\":\{\"type\":\"string\",\"value\":\"fruit\"}}}"),
        Case("valid/spec-1.0.0/keys-7", "3.14159 = \"pi\"\n", "\{\"3\":\{\"14159\":\{\"type\":\"string\",\"value\":\"pi\"}}}"),
        Case("valid/spec-1.0.0/local-date-0", "ld1 = 1979-05-27\n", "\{\"ld1\":\{\"type\":\"date-local\",\"value\":\"1979-05-27\"}}"),
        Case("valid/spec-1.0.0/local-date-time-0", "ldt1 = 1979-05-27T07:32:00\nldt2 = 1979-05-27T00:32:00.999\n", "\{\"ldt1\":\{\"type\":\"datetime-local\",\"value\":\"1979-05-27T07:32:00\"},\"ldt2\":\{\"type\":\"datetime-local\",\"value\":\"1979-05-27T00:32:00.999\"}}"),
        Case("valid/spec-1.0.0/local-time-0", "lt1 = 07:32:00\nlt2 = 00:32:00.999\n", "\{\"lt1\":\{\"type\":\"time-local\",\"value\":\"07:32:00\"},\"lt2\":\{\"type\":\"time-local\",\"value\":\"00:32:00.999\"}}"),
        Case("valid/spec-1.0.0/offset-date-time-0", "odt1 = 1979-05-27T07:32:00Z\nodt2 = 1979-05-27T00:32:00-07:00\nodt3 = 1979-05-27T00:32:00.999-07:00\n", "\{\"odt1\":\{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00Z\"},\"odt2\":\{\"type\":\"datetime\",\"value\":\"1979-05-27T00:32:00-07:00\"},\"odt3\":\{\"type\":\"datetime\",\"value\":\"1979-05-27T00:32:00.999-07:00\"}}"),
        Case("valid/spec-1.0.0/offset-date-time-1", "odt4 = 1979-05-27 07:32:00Z\n", "\{\"odt4\":\{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00Z\"}}"),
        Case("valid/spec-1.0.0/string-0", "str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\u00E9\\nLocation\\tSF.\"\n", "\{\"str\":\{\"type\":\"string\",\"value\":\"I'm a string. \\\"You can quote me\\\". Name\\tJosé\\nLocation\\tSF.\"}}"),
        Case("valid/spec-1.0.0/string-1", "str1 = \"\"\"\nRoses are red\nViolets are blue\"\"\"\n", "\{\"str1\":\{\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"}}"),
        Case("valid/spec-1.0.0/string-2", "# On a Unix system, the above multi-line string will most likely be the same as:\nstr2 = \"Roses are red\\nViolets are blue\"\n\n# On a Windows system, it will most likely be equivalent to:\nstr3 = \"Roses are red\\r\\nViolets are blue\"\n", "\{\"str2\":\{\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"},\"str3\":\{\"type\":\"string\",\"value\":\"Roses are red\\r\\nViolets are blue\"}}"),
        Case("valid/spec-1.0.0/string-3", "# The following strings are byte-for-byte equivalent:\nstr1 = \"The quick brown fox jumps over the lazy dog.\"\n\nstr2 = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n\nstr3 = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\n", "\{\"str1\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"str2\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"str3\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"}}"),
        Case("valid/spec-1.0.0/string-4", "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\n# str5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVALID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6 = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\nstr7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"\n", "\{\"str4\":\{\"type\":\"string\",\"value\":\"Here are two quotation marks: \\\"\\\". Simple enough.\"},\"str5\":\{\"type\":\"string\",\"value\":\"Here are three quotation marks: \\\"\\\"\\\".\"},\"str6\":\{\"type\":\"string\",\"value\":\"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\".\"},\"str7\":\{\"type\":\"string\",\"value\":\"\\\"This,\\\" she said, \\\"is just a pointless statement.\\\"\"}}"),
        Case("valid/spec-1.0.0/string-5", "# What you see is what you get.\nwinpath  = 'C:\\Users\\nodejs\\templates'\nwinpath2 = '\\\\ServerX\\admin$\\system32\\'\nquoted   = 'Tom \"Dubs\" Preston-Werner'\nregex    = '<\\i\\c*\\s*>'\n", "\{\"quoted\":\{\"type\":\"string\",\"value\":\"Tom \\\"Dubs\\\" Preston-Werner\"},\"regex\":\{\"type\":\"string\",\"value\":\"<\\\\i\\\\c*\\\\s*>\"},\"winpath\":\{\"type\":\"string\",\"value\":\"C:\\\\Users\\\\nodejs\\\\templates\"},\"winpath2\":\{\"type\":\"string\",\"value\":\"\\\\\\\\ServerX\\\\admin$\\\\system32\\\\\"}}"),
        Case("valid/spec-1.0.0/string-6", "regex2 = '''I [dw]on't need \\d\{2} apples'''\nlines  = '''\nThe first newline is\ntrimmed in raw strings.\n   All other whitespace\n   is preserved.\n'''\n", "\{\"lines\":\{\"type\":\"string\",\"value\":\"The first newline is\\ntrimmed in raw strings.\\n   All other whitespace\\n   is preserved.\\n\"},\"regex2\":\{\"type\":\"string\",\"value\":\"I [dw]on't need \\\\d\{2} apples\"}}"),
        Case("valid/spec-1.0.0/string-7", "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\n\n# apos15 = '''Here are fifteen apostrophes: ''''''''''''''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: '''''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\nstr = ''''That,' she said, 'is still pointless.''''\n", "\{\"apos15\":\{\"type\":\"string\",\"value\":\"Here are fifteen apostrophes: '''''''''''''''\"},\"quot15\":\{\"type\":\"string\",\"value\":\"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\"},\"str\":\{\"type\":\"string\",\"value\":\"'That,' she said, 'is still pointless.'\"}}"),
        Case("valid/spec-1.0.0/table-0", "[table]\n", "\{\"table\":\{}}"),
        Case("valid/spec-1.0.0/table-1", "[table-1]\nkey1 = \"some string\"\nkey2 = 123\n\n[table-2]\nkey1 = \"another string\"\nkey2 = 456\n", "\{\"table-1\":\{\"key1\":\{\"type\":\"string\",\"value\":\"some string\"},\"key2\":\{\"type\":\"integer\",\"value\":\"123\"}},\"table-2\":\{\"key1\":\{\"type\":\"string\",\"value\":\"another string\"},\"key2\":\{\"type\":\"integer\",\"value\":\"456\"}}}"),
        Case("valid/spec-1.0.0/table-2", "[dog.\"tater.man\"]\ntype.name = \"pug\"\n", "\{\"dog\":\{\"tater.man\":\{\"type\":\{\"name\":\{\"type\":\"string\",\"value\":\"pug\"}}}}}"),
        Case("valid/spec-1.0.0/table-3", "[a.b.c]            # this is best practice\n[ d.e.f ]          # same as [d.e.f]\n[ g .  h  . i ]    # same as [g.h.i]\n[ j . \"ʞ\" . 'l' ]  # same as [j.\"ʞ\".'l']\n", "\{\"a\":\{\"b\":\{\"c\":\{}}},\"d\":\{\"e\":\{\"f\":\{}}},\"g\":\{\"h\":\{\"i\":\{}}},\"j\":\{\"ʞ\":\{\"l\":\{}}}}"),
        Case("valid/spec-1.0.0/table-4", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n\n[x] # defining a super-table afterward is ok\n", "\{\"x\":\{\"y\":\{\"z\":\{\"w\":\{}}}}}"),
        Case("valid/spec-1.0.0/table-5", "# VALID BUT DISCOURAGED\n[fruit.apple]\n[animal]\n[fruit.orange]\n", "\{\"animal\":\{},\"fruit\":\{\"apple\":\{},\"orange\":\{}}}"),
        Case("valid/spec-1.0.0/table-6", "# RECOMMENDED\n[fruit.apple]\n[fruit.orange]\n[animal]\n", "\{\"animal\":\{},\"fruit\":\{\"apple\":\{},\"orange\":\{}}}"),
        Case("valid/spec-1.0.0/table-7", "# Top-level table begins.\nname = \"Fido\"\nbreed = \"pug\"\n\n# Top-level table ends.\n[owner]\nname = \"Regina Dogman\"\nmember_since = 1999-08-04\n", "\{\"breed\":\{\"type\":\"string\",\"value\":\"pug\"},\"name\":\{\"type\":\"string\",\"value\":\"Fido\"},\"owner\":\{\"member_since\":\{\"type\":\"date-local\",\"value\":\"1999-08-04\"},\"name\":\{\"type\":\"string\",\"value\":\"Regina Dogman\"}}}"),
        Case("valid/spec-1.0.0/table-8", "fruit.apple.color = \"red\"\n# Defines a table named fruit\n# Defines a table named fruit.apple\n\nfruit.apple.taste.sweet = true\n# Defines a table named fruit.apple.taste\n# fruit and fruit.apple were already created\n", "\{\"fruit\":\{\"apple\":\{\"color\":\{\"type\":\"string\",\"value\":\"red\"},\"taste\":\{\"sweet\":\{\"type\":\"bool\",\"value\":\"true\"}}}}}"),
        Case("valid/spec-1.0.0/table-9", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n# [fruit.apple]  # INVALID\n# [fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n", "\{\"fruit\":\{\"apple\":\{\"color\":\{\"type\":\"string\",\"value\":\"red\"},\"taste\":\{\"sweet\":\{\"type\":\"bool\",\"value\":\"true\"}},\"texture\":\{\"smooth\":\{\"type\":\"bool\",\"value\":\"true\"}}}}}"),
        Case("valid/spec-example-1", "# This is a TOML document. Boom.\n\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Lance Uppercut\"\ndob = 1979-05-27T07:32:00-08:00 # First class dates? Why not?\n\n[database]\nserver = \"192.168.1.1\"\nports = [ 8001, 8001, 8002 ]\nconnection_max = 5000\nenabled = true\n\n[servers]\n\n  # You can indent as you please. Tabs or spaces. TOML don't care.\n  [servers.alpha]\n  ip = \"10.0.0.1\"\n  dc = \"eqdc10\"\n\n  [servers.beta]\n  ip = \"10.0.0.2\"\n  dc = \"eqdc10\"\n\n[clients]\ndata = [ [\"gamma\", \"delta\"], [1, 2] ]\n\n# Line breaks are OK when inside arrays\nhosts = [\n  \"alpha\",\n  \"omega\"\n]\n", "\{\"title\":\{\"type\":\"string\",\"value\":\"TOML Example\"},\"clients\":\{\"data\":[[\{\"type\":\"string\",\"value\":\"gamma\"},\{\"type\":\"string\",\"value\":\"delta\"}],[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}]],\"hosts\":[\{\"type\":\"string\",\"value\":\"alpha\"},\{\"type\":\"string\",\"value\":\"omega\"}]},\"database\":\{\"connection_max\":\{\"type\":\"integer\",\"value\":\"5000\"},\"enabled\":\{\"type\":\"bool\",\"value\":\"true\"},\"server\":\{\"type\":\"string\",\"value\":\"192.168.1.1\"},\"ports\":[\{\"type\":\"integer\",\"value\":\"8001\"},\{\"type\":\"integer\",\"value\":\"8001\"},\{\"type\":\"integer\",\"value\":\"8002\"}]},\"owner\":\{\"dob\":\{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00-08:00\"},\"name\":\{\"type\":\"string\",\"value\":\"Lance Uppercut\"}},\"servers\":\{\"alpha\":\{\"dc\":\{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":\{\"type\":\"string\",\"value\":\"10.0.0.1\"}},\"beta\":\{\"dc\":\{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":\{\"type\":\"string\",\"value\":\"10.0.0.2\"}}}}"),
        Case("valid/spec-example-1-compact", "#Useless spaces eliminated.\ntitle=\"TOML Example\"\n[owner]\nname=\"Lance Uppercut\"\ndob=1979-05-27T07:32:00-08:00#First class dates\n[database]\nserver=\"192.168.1.1\"\nports=[8001,8001,8002]\nconnection_max=5000\nenabled=true\n[servers]\n[servers.alpha]\nip=\"10.0.0.1\"\ndc=\"eqdc10\"\n[servers.beta]\nip=\"10.0.0.2\"\ndc=\"eqdc10\"\n[clients]\ndata=[[\"gamma\",\"delta\"],[1,2]]\nhosts=[\n\"alpha\",\n\"omega\"\n]\n", "\{\"title\":\{\"type\":\"string\",\"value\":\"TOML Example\"},\"clients\":\{\"data\":[[\{\"type\":\"string\",\"value\":\"gamma\"},\{\"type\":\"string\",\"value\":\"delta\"}],[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"integer\",\"value\":\"2\"}]],\"hosts\":[\{\"type\":\"string\",\"value\":\"alpha\"},\{\"type\":\"string\",\"value\":\"omega\"}]},\"database\":\{\"connection_max\":\{\"type\":\"integer\",\"value\":\"5000\"},\"enabled\":\{\"type\":\"bool\",\"value\":\"true\"},\"server\":\{\"type\":\"string\",\"value\":\"192.168.1.1\"},\"ports\":[\{\"type\":\"integer\",\"value\":\"8001\"},\{\"type\":\"integer\",\"value\":\"8001\"},\{\"type\":\"integer\",\"value\":\"8002\"}]},\"owner\":\{\"dob\":\{\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00-08:00\"},\"name\":\{\"type\":\"string\",\"value\":\"Lance Uppercut\"}},\"servers\":\{\"alpha\":\{\"dc\":\{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":\{\"type\":\"string\",\"value\":\"10.0.0.1\"}},\"beta\":\{\"dc\":\{\"type\":\"string\",\"value\":\"eqdc10\"},\"ip\":\{\"type\":\"string\",\"value\":\"10.0.0.2\"}}}}"),
    ]

fn valid_4() List[Case]
    [
        Case("valid/string/basic-escape-01", "# Escape \"\ntest = \"\\\"one\\\"\"\n", "\{\"test\":\{\"type\":\"string\",\"value\":\"\\\"one\\\"\"}}"),
        Case("valid/string/basic-escape-02", "# Escape \\ and then \"\ntest = \"\\\\\\\"one\"\n", "\{\"test\":\{\"type\":\"string\",\"value\":\"\\\\\\\"one\"}}"),
        Case("valid/string/basic-escape-03", "# Escape \\ four times and then \"\ntest = \"\\\\\\\\\\\\\\\\\\\"one\"\n", "\{\"test\":\{\"type\":\"string\",\"value\":\"\\\\\\\\\\\\\\\\\\\"one\"}}"),
        Case("valid/string/empty", "answer = \"\"\n", "\{\"answer\":\{\"type\":\"string\",\"value\":\"\"}}"),
        Case("valid/string/ends-in-whitespace-escape", "beee = \"\"\"\nheeee\ngeeee\\  \n\n\n      \"\"\"\n", "\{\"beee\":\{\"type\":\"string\",\"value\":\"heeee\\ngeeee\"}}"),
        Case("valid/string/escape-tricky", "end_esc = \"String does not end here\\\" but ends here\\\\\"\nlit_end_esc = 'String ends here\\'\n\nmultiline_unicode = \"\"\"\n\\u00a0\"\"\"\n\nmultiline_not_unicode = \"\"\"\n\\\\u0041\"\"\"\n\nmultiline_end_esc = \"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"\n\nlit_multiline_not_unicode = '''\n\\u007f'''\n\nlit_multiline_end = '''There is no escape\\'''\n", "\{\"end_esc\":\{\"type\":\"string\",\"value\":\"String does not end here\\\" but ends here\\\\\"},\"lit_end_esc\":\{\"type\":\"string\",\"value\":\"String ends here\\\\\"},\"lit_multiline_end\":\{\"type\":\"string\",\"value\":\"There is no escape\\\\\"},\"lit_multiline_not_unicode\":\{\"type\":\"string\",\"value\":\"\\\\u007f\"},\"multiline_end_esc\":\{\"type\":\"string\",\"value\":\"When will it end? \\\"\\\"\\\"...\\\"\\\"\\\" should be here\\\"\"},\"multiline_not_unicode\":\{\"type\":\"string\",\"value\":\"\\\\u0041\"},\"multiline_unicode\":\{\"type\":\"string\",\"value\":\"\u{a0}\"}}"),
        Case("valid/string/escaped-escape", "answer = \"\\\\x64\"\n", "\{\"answer\":\{\"type\":\"string\",\"value\":\"\\\\x64\"}}"),
        Case("valid/string/escapes", "backspace     = \"|\\b.\"\ntab           = \"|\\t.\"\nnewline       = \"|\\n.\"\nformfeed      = \"|\\f.\"\ncarriage      = \"|\\r.\"\nquote         = \"|\\\".\"\nbackslash     = \"|\\\\.\"\ndelete        = \"|\\u007F.\"\nunitseparator = \"|\\u001F.\"\n\n# \\u is escaped, so should NOT be interperted as a \\u escape.\nnotunicode1   = \"|\\\\u.\"\nnotunicode2   = \"|\\u005Cu.\"\nnotunicode3   = \"|\\\\u0075.\"\nnotunicode4   = \"|\\\\\\u0075.\"\n", "\{\"backslash\":\{\"type\":\"string\",\"value\":\"|\\\\.\"},\"backspace\":\{\"type\":\"string\",\"value\":\"|\\b.\"},\"carriage\":\{\"type\":\"string\",\"value\":\"|\\r.\"},\"delete\":\{\"type\":\"string\",\"value\":\"|\u{7f}.\"},\"formfeed\":\{\"type\":\"string\",\"value\":\"|\\f.\"},\"newline\":\{\"type\":\"string\",\"value\":\"|\\n.\"},\"notunicode1\":\{\"type\":\"string\",\"value\":\"|\\\\u.\"},\"notunicode2\":\{\"type\":\"string\",\"value\":\"|\\\\u.\"},\"notunicode3\":\{\"type\":\"string\",\"value\":\"|\\\\u0075.\"},\"notunicode4\":\{\"type\":\"string\",\"value\":\"|\\\\u.\"},\"quote\":\{\"type\":\"string\",\"value\":\"|\\\".\"},\"tab\":\{\"type\":\"string\",\"value\":\"|\\t.\"},\"unitseparator\":\{\"type\":\"string\",\"value\":\"|\\u001f.\"}}"),
        Case("valid/string/multibyte", "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nbasic    = \"ɑ € 𐫱 ɑ€𐫱\"\nraw      = 'ɑ € 𐫱 ɑ€𐫱'\nml-basic = \"\"\"ɑ € 𐫱 ɑ€𐫱\"\"\"\nml-raw   = '''ɑ € 𐫱 ɑ€𐫱'''\n", "\{\"basic\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-raw\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"raw\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"}}"),
        Case("valid/string/multibyte-escape", "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nbasic-1    = \"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\nml-basic-1 = \"\"\"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\"\"\n\n# Again, but only using \\U\nbasic-2    = \"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\nml-basic-2 = \"\"\"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\"\"\n", "\{\"basic-1\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic-1\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"basic-2\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic-2\":\{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"}}"),
        Case("valid/string/multiline", "# NOTE: this file includes some literal tab characters.\n\nequivalent_one = \"The quick brown fox jumps over the lazy dog.\"\nequivalent_two = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n\nequivalent_three = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\n\nwhitespace-after-bs = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\   \n       the lazy dog.\\\t\n       \"\"\"\n\nno-space = \"\"\"a\\\n    b\"\"\"\n\n# Has tab character.\nkeep-ws-before = \"\"\"a   \t\\\n   b\"\"\"\n\nescape-bs-1 = \"\"\"a \\\\\nb\"\"\"\n\nescape-bs-2 = \"\"\"a \\\\\\\nb\"\"\"\n\nescape-bs-3 = \"\"\"a \\\\\\\\\n  b\"\"\"\n", "\{\"equivalent_one\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"equivalent_three\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"equivalent_two\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"},\"escape-bs-1\":\{\"type\":\"string\",\"value\":\"a \\\\\\nb\"},\"escape-bs-2\":\{\"type\":\"string\",\"value\":\"a \\\\b\"},\"escape-bs-3\":\{\"type\":\"string\",\"value\":\"a \\\\\\\\\\n  b\"},\"keep-ws-before\":\{\"type\":\"string\",\"value\":\"a   \\tb\"},\"no-space\":\{\"type\":\"string\",\"value\":\"ab\"},\"whitespace-after-bs\":\{\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"}}"),
        Case("valid/string/multiline-empty", "empty-1 = \"\"\"\"\"\"\n\n# A newline immediately following the opening delimiter will be trimmed.\nempty-2 = \"\"\"\n\"\"\"\n\n# \\ at the end of line trims newlines as well; note that last \\ is followed by\n# two spaces, which are ignored.\nempty-3 = \"\"\"\\\n    \"\"\"\nempty-4 = \"\"\"\\\n   \\\n   \\  \n   \"\"\"\n\n", "\{\"empty-1\":\{\"type\":\"string\",\"value\":\"\"},\"empty-2\":\{\"type\":\"string\",\"value\":\"\"},\"empty-3\":\{\"type\":\"string\",\"value\":\"\"},\"empty-4\":\{\"type\":\"string\",\"value\":\"\"}}"),
        Case("valid/string/multiline-escaped-crlf", "# The following line should be an unescaped backslash followed by a Windows\r\n# newline sequence (\"\\r\\n\")\r\n0=\"\"\"\\\r\n\"\"\"\r\n", "\{\"0\":\{\"type\":\"string\",\"value\":\"\"}}"),
        Case("valid/string/multiline-quotes", "# Make sure that quotes inside multiline strings are allowed, including right\n# after the opening '''/\"\"\" and before the closing '''/\"\"\"\n\nlit_one = ''''one quote''''\nlit_two = '''''two quotes'''''\nlit_one_space = ''' 'one quote' '''\nlit_two_space = ''' ''two quotes'' '''\n\none = \"\"\"\"one quote\"\"\"\"\ntwo = \"\"\"\"\"two quotes\"\"\"\"\"\none_space = \"\"\" \"one quote\" \"\"\"\ntwo_space = \"\"\" \"\"two quotes\"\" \"\"\"\n\nmismatch1 = \"\"\"aaa'''bbb\"\"\"\nmismatch2 = '''aaa\"\"\"bbb'''\n\n# Three opening \"\"\", then one escaped \", then two \"\" (allowed), and then three\n# closing \"\"\"\nescaped = \"\"\"lol\\\"\"\"\"\"\"\n\nfive-quotes = \"\"\"\nClosing with five quotes\n\"\"\"\"\"\nfour-quotes = \"\"\"\nClosing with four quotes\n\"\"\"\"\n", "\{\"escaped\":\{\"type\":\"string\",\"value\":\"lol\\\"\\\"\\\"\"},\"five-quotes\":\{\"type\":\"string\",\"value\":\"Closing with five quotes\\n\\\"\\\"\"},\"four-quotes\":\{\"type\":\"string\",\"value\":\"Closing with four quotes\\n\\\"\"},\"lit_one\":\{\"type\":\"string\",\"value\":\"'one quote'\"},\"lit_one_space\":\{\"type\":\"string\",\"value\":\" 'one quote' \"},\"lit_two\":\{\"type\":\"string\",\"value\":\"''two quotes''\"},\"lit_two_space\":\{\"type\":\"string\",\"value\":\" ''two quotes'' \"},\"mismatch1\":\{\"type\":\"string\",\"value\":\"aaa'''bbb\"},\"mismatch2\":\{\"type\":\"string\",\"value\":\"aaa\\\"\\\"\\\"bbb\"},\"one\":\{\"type\":\"string\",\"value\":\"\\\"one quote\\\"\"},\"one_space\":\{\"type\":\"string\",\"value\":\" \\\"one quote\\\" \"},\"two\":\{\"type\":\"string\",\"value\":\"\\\"\\\"two quotes\\\"\\\"\"},\"two_space\":\{\"type\":\"string\",\"value\":\" \\\"\\\"two quotes\\\"\\\" \"}}"),
        Case("valid/string/nl", "nl_mid = \"val\\nue\"\nnl_end = \"\"\"value\\n\"\"\"\n\nlit_nl_end = '''value\\n'''\nlit_nl_mid = 'val\\nue'\nlit_nl_uni = 'val\\ue'\n", "\{\"lit_nl_end\":\{\"type\":\"string\",\"value\":\"value\\\\n\"},\"lit_nl_mid\":\{\"type\":\"string\",\"value\":\"val\\\\nue\"},\"lit_nl_uni\":\{\"type\":\"string\",\"value\":\"val\\\\ue\"},\"nl_end\":\{\"type\":\"string\",\"value\":\"value\\n\"},\"nl_mid\":\{\"type\":\"string\",\"value\":\"val\\nue\"}}"),
        Case("valid/string/quoted-unicode", "\nescaped_string = \"\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\"\nnot_escaped_string = '\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff'\n\nbasic_string = \"~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\"\nliteral_string = '~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}'\n", "\{\"basic_string\":\{\"type\":\"string\",\"value\":\"~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\"},\"escaped_string\":\{\"type\":\"string\",\"value\":\"\\u0000 \\b \\f A \u{7f} \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\"},\"literal_string\":\{\"type\":\"string\",\"value\":\"~ \u{80} ÿ \u{d7ff} \u{e000} \u{ffff} 𐀀 \u{10ffff}\"},\"not_escaped_string\":\{\"type\":\"string\",\"value\":\"\\\\u0000 \\\\u0008 \\\\u000c \\\\U00000041 \\\\u007f \\\\u0080 \\\\u00ff \\\\ud7ff \\\\ue000 \\\\uffff \\\\U00010000 \\\\U0010ffff\"}}"),
        Case("valid/string/raw", "backspace = 'This string has a \\b backspace character.'\ntab = 'This string has a \\t tab character.'\nunescaped_tab = 'This string has an \t unescaped tab character.'\nnewline = 'This string has a \\n new line character.'\nformfeed = 'This string has a \\f form feed character.'\ncarriage = 'This string has a \\r carriage return character.'\nslash = 'This string has a \\/ slash character.'\nbackslash = 'This string has a \\\\ backslash character.'\n", "\{\"backslash\":\{\"type\":\"string\",\"value\":\"This string has a \\\\\\\\ backslash character.\"},\"backspace\":\{\"type\":\"string\",\"value\":\"This string has a \\\\b backspace character.\"},\"carriage\":\{\"type\":\"string\",\"value\":\"This string has a \\\\r carriage return character.\"},\"formfeed\":\{\"type\":\"string\",\"value\":\"This string has a \\\\f form feed character.\"},\"newline\":\{\"type\":\"string\",\"value\":\"This string has a \\\\n new line character.\"},\"slash\":\{\"type\":\"string\",\"value\":\"This string has a \\\\/ slash character.\"},\"tab\":\{\"type\":\"string\",\"value\":\"This string has a \\\\t tab character.\"},\"unescaped_tab\":\{\"type\":\"string\",\"value\":\"This string has an \\t unescaped tab character.\"}}"),
        Case("valid/string/raw-empty", "empty = ''\n", "\{\"empty\":\{\"type\":\"string\",\"value\":\"\"}}"),
        Case("valid/string/raw-multiline", "# Single ' should be allowed.\noneline = '''This string has a ' quote character.'''\n\n# A newline immediately following the opening delimiter will be trimmed.\nfirstnl = '''\nThis string has a ' quote character.'''\n\n# All other whitespace and newline characters remain intact.\nmultiline = '''\nThis string\nhas ' a quote character\nand more than\none newline\nin it.'''\n\n# Tab character in literal string does not need to be escaped\nmultiline_with_tab = '''First line\n\t Followed by a tab'''\n\nthis-str-has-apostrophes='''' there's one already\n'' two more\n'''''\n", "\{\"firstnl\":\{\"type\":\"string\",\"value\":\"This string has a ' quote character.\"},\"multiline\":\{\"type\":\"string\",\"value\":\"This string\\nhas ' a quote character\\nand more than\\none newline\\nin it.\"},\"multiline_with_tab\":\{\"type\":\"string\",\"value\":\"First line\\n\\t Followed by a tab\"},\"oneline\":\{\"type\":\"string\",\"value\":\"This string has a ' quote character.\"},\"this-str-has-apostrophes\":\{\"type\":\"string\",\"value\":\"' there's one already\\n'' two more\\n''\"}}"),
        Case("valid/string/simple", "answer = \"You are not drinking enough whisky.\"\n", "\{\"answer\":\{\"type\":\"string\",\"value\":\"You are not drinking enough whisky.\"}}"),
        Case("valid/string/start-mb", "# Start first line with a multibyte character.\n#\n# https://github.com/marzer/tomlplusplus/issues/190\ns1 = \"§\"\ns2 = '§'\ns3 = \"\"\"\\\n§\"\"\"\ns4 = \"\"\"\n§\"\"\"\ns5 = \"\"\"§\"\"\"\ns6 = '''\n§'''\ns7 = '''§'''\n", "\{\"s1\":\{\"type\":\"string\",\"value\":\"§\"},\"s2\":\{\"type\":\"string\",\"value\":\"§\"},\"s3\":\{\"type\":\"string\",\"value\":\"§\"},\"s4\":\{\"type\":\"string\",\"value\":\"§\"},\"s5\":\{\"type\":\"string\",\"value\":\"§\"},\"s6\":\{\"type\":\"string\",\"value\":\"§\"},\"s7\":\{\"type\":\"string\",\"value\":\"§\"}}"),
        Case("valid/string/unicode-escape", "delta-1 = \"\\u03B4\"\ndelta-2 = \"\\U000003B4\"\na       = \"\\u0061\"\nb       = \"\\u0062\"\nc       = \"\\U00000063\"\nnull-1  = \"\\u0000\"\nnull-2  = \"\\U00000000\"\n\nml-delta-1 = \"\"\"\\u03B4\"\"\"\nml-delta-2 = \"\"\"\\U000003B4\"\"\"\nml-a       = \"\"\"\\u0061\"\"\"\nml-b       = \"\"\"\\u0062\"\"\"\nml-c       = \"\"\"\\U00000063\"\"\"\nml-null-1  = \"\"\"\\u0000\"\"\"\nml-null-2  = \"\"\"\\U00000000\"\"\"\n", "\{\"a\":\{\"type\":\"string\",\"value\":\"a\"},\"b\":\{\"type\":\"string\",\"value\":\"b\"},\"c\":\{\"type\":\"string\",\"value\":\"c\"},\"delta-1\":\{\"type\":\"string\",\"value\":\"δ\"},\"delta-2\":\{\"type\":\"string\",\"value\":\"δ\"},\"ml-a\":\{\"type\":\"string\",\"value\":\"a\"},\"ml-b\":\{\"type\":\"string\",\"value\":\"b\"},\"ml-c\":\{\"type\":\"string\",\"value\":\"c\"},\"ml-delta-1\":\{\"type\":\"string\",\"value\":\"δ\"},\"ml-delta-2\":\{\"type\":\"string\",\"value\":\"δ\"},\"ml-null-1\":\{\"type\":\"string\",\"value\":\"\\u0000\"},\"ml-null-2\":\{\"type\":\"string\",\"value\":\"\\u0000\"},\"null-1\":\{\"type\":\"string\",\"value\":\"\\u0000\"},\"null-2\":\{\"type\":\"string\",\"value\":\"\\u0000\"}}"),
        Case("valid/string/with-pound", "pound = \"We see no # comments here.\"\npoundcomment = \"But there are # some comments here.\" # Did I # mess you up?\n", "\{\"pound\":\{\"type\":\"string\",\"value\":\"We see no # comments here.\"},\"poundcomment\":\{\"type\":\"string\",\"value\":\"But there are # some comments here.\"}}"),
        Case("valid/table/array-empty", "[[a]]\n", "\{\"a\":[\{}]}"),
        Case("valid/table/array-empty-name", "# Silly thing to do, but valid.\n\n[['']]\na = 1\n[['']]\na = 2\n", "\{\"\":[\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"}},\{\"a\":\{\"type\":\"integer\",\"value\":\"2\"}}]}"),
        Case("valid/table/array-implicit", "[[albums.songs]]\nname = \"Glory Days\"\n", "\{\"albums\":\{\"songs\":[\{\"name\":\{\"type\":\"string\",\"value\":\"Glory Days\"}}]}}"),
        Case("valid/table/array-implicit-and-explicit-after", "[[a.b]]\nx = 1\n\n[a]\ny = 2\n", "\{\"a\":\{\"b\":[\{\"x\":\{\"type\":\"integer\",\"value\":\"1\"}}],\"y\":\{\"type\":\"integer\",\"value\":\"2\"}}}"),
        Case("valid/table/array-many", "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n\n[[people]]\nfirst_name = \"Eric\"\nlast_name = \"Clapton\"\n\n[[people]]\nfirst_name = \"Bob\"\nlast_name = \"Seger\"\n", "\{\"people\":[\{\"first_name\":\{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Springsteen\"}},\{\"first_name\":\{\"type\":\"string\",\"value\":\"Eric\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Clapton\"}},\{\"first_name\":\{\"type\":\"string\",\"value\":\"Bob\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Seger\"}}]}"),
        Case("valid/table/array-nest", "[[albums]]\nname = \"Born to Run\"\n\n  [[albums.songs]]\n  name = \"Jungleland\"\n\n  [[albums.songs]]\n  name = \"Meeting Across the River\"\n\n[[albums]]\nname = \"Born in the USA\"\n  \n  [[albums.songs]]\n  name = \"Glory Days\"\n\n  [[albums.songs]]\n  name = \"Dancing in the Dark\"\n", "\{\"albums\":[\{\"name\":\{\"type\":\"string\",\"value\":\"Born to Run\"},\"songs\":[\{\"name\":\{\"type\":\"string\",\"value\":\"Jungleland\"}},\{\"name\":\{\"type\":\"string\",\"value\":\"Meeting Across the River\"}}]},\{\"name\":\{\"type\":\"string\",\"value\":\"Born in the USA\"},\"songs\":[\{\"name\":\{\"type\":\"string\",\"value\":\"Glory Days\"}},\{\"name\":\{\"type\":\"string\",\"value\":\"Dancing in the Dark\"}}]}]}"),
        Case("valid/table/array-one", "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n", "\{\"people\":[\{\"first_name\":\{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":\{\"type\":\"string\",\"value\":\"Springsteen\"}}]}"),
        Case("valid/table/array-table-array", "[[a]]\n    [[a.b]]\n        [a.b.c]\n            d = \"val0\"\n    [[a.b]]\n        [a.b.c]\n            d = \"val1\"\n", "\{\"a\":[\{\"b\":[\{\"c\":\{\"d\":\{\"type\":\"string\",\"value\":\"val0\"}}},\{\"c\":\{\"d\":\{\"type\":\"string\",\"value\":\"val1\"}}}]}]}"),
        Case("valid/table/array-within-dotted", "[fruit]\napple.color = \"red\"\n\n[[fruit.apple.seeds]]\nsize = 2\n", "\{\"fruit\":\{\"apple\":\{\"color\":\{\"type\":\"string\",\"value\":\"red\"},\"seeds\":[\{\"size\":\{\"type\":\"integer\",\"value\":\"2\"}}]}}}"),
        Case("valid/table/empty", "[a]\n", "\{\"a\":\{}}"),
        Case("valid/table/empty-name", "['']\nx = 1\n\n[\"\".a]\nx = 2\n\n[a.'']\nx = 3\n", "\{\"\":\{\"x\":\{\"type\":\"integer\",\"value\":\"1\"},\"a\":\{\"x\":\{\"type\":\"integer\",\"value\":\"2\"}}},\"a\":\{\"\":\{\"x\":\{\"type\":\"integer\",\"value\":\"3\"}}}}"),
        Case("valid/table/keyword", "[true]\n\n[false]\n\n[inf]\n\n[nan]\n\n\n", "\{\"false\":\{},\"inf\":\{},\"nan\":\{},\"true\":\{}}"),
        Case("valid/table/keyword-with-values", "[true]\nk = 1\n\n[false]\nk = 2\n\n[inf]\nk = 3\n\n[nan]\nk = 4\n", "\{\"false\":\{\"k\":\{\"type\":\"integer\",\"value\":\"2\"}},\"inf\":\{\"k\":\{\"type\":\"integer\",\"value\":\"3\"}},\"nan\":\{\"k\":\{\"type\":\"integer\",\"value\":\"4\"}},\"true\":\{\"k\":\{\"type\":\"integer\",\"value\":\"1\"}}}"),
        Case("valid/table/names", "[a.b.c]\n[a.\"b.c\"]\n[a.'d.e']\n[a.' x ']\n[ d.e.f ]\n[ g . h . i ]\n[ j . \"ʞ\" . 'l' ]\n\n[x.1.2]\n", "\{\"a\":\{\" x \":\{},\"b.c\":\{},\"d.e\":\{},\"b\":\{\"c\":\{}}},\"d\":\{\"e\":\{\"f\":\{}}},\"g\":\{\"h\":\{\"i\":\{}}},\"j\":\{\"ʞ\":\{\"l\":\{}}},\"x\":\{\"1\":\{\"2\":\{}}}}"),
        Case("valid/table/names-with-values", "[a.b.c]\nkey = 1\n\n[a.\"b.c\"]\nkey = 2\n\n[a.'d.e']\nkey = 3\n\n[a.' x ']\nkey = 4\n\n[ d.e.f ]\nkey = 5\n\n[ g . h . i ]\nkey = 6\n\n[ j . \"ʞ\" . 'l' ]\nkey = 7\n\n[x.1.2]\nkey = 8\n", "\{\"a\":\{\" x \":\{\"key\":\{\"type\":\"integer\",\"value\":\"4\"}},\"b\":\{\"c\":\{\"key\":\{\"type\":\"integer\",\"value\":\"1\"}}},\"b.c\":\{\"key\":\{\"type\":\"integer\",\"value\":\"2\"}},\"d.e\":\{\"key\":\{\"type\":\"integer\",\"value\":\"3\"}}},\"d\":\{\"e\":\{\"f\":\{\"key\":\{\"type\":\"integer\",\"value\":\"5\"}}}},\"g\":\{\"h\":\{\"i\":\{\"key\":\{\"type\":\"integer\",\"value\":\"6\"}}}},\"j\":\{\"ʞ\":\{\"l\":\{\"key\":\{\"type\":\"integer\",\"value\":\"7\"}}}},\"x\":\{\"1\":\{\"2\":\{\"key\":\{\"type\":\"integer\",\"value\":\"8\"}}}}}"),
        Case("valid/table/no-eol-01", "# No newline at end of file.\n[table]", "\{\"table\":\{}}"),
        Case("valid/table/no-eol-02", "# No newline at end of file.\n[table]\na=1", "\{\"table\":\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"}}}"),
    ]

fn valid_5() List[Case]
    [
        Case("valid/table/sub", "[a]\nkey = 1\n\n# a.extend is a key inside the \"a\" table.\n[a.extend]\nkey = 2\n\n[a.extend.more]\nkey = 3\n", "\{\"a\":\{\"key\":\{\"type\":\"integer\",\"value\":\"1\"},\"extend\":\{\"key\":\{\"type\":\"integer\",\"value\":\"2\"},\"more\":\{\"key\":\{\"type\":\"integer\",\"value\":\"3\"}}}}}"),
        Case("valid/table/sub-empty", "[a]\n[a.b]\n", "\{\"a\":\{\"b\":\{}}}"),
        Case("valid/table/whitespace", "[\"valid key\"]\n", "\{\"valid key\":\{}}"),
        Case("valid/table/with-literal-string", "['a']\n[a.'\"b\"']\n[a.'\"b\"'.c]\nanswer = 42 \n", "\{\"a\":\{\"\\\"b\\\"\":\{\"c\":\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}}}}"),
        Case("valid/table/with-pound", "[\"key#group\"]\nanswer = 42\n", "\{\"key#group\":\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}}"),
        Case("valid/table/with-single-quotes", "['a']\n[a.'b']\n[a.'b'.c]\nanswer = 42 \n", "\{\"a\":\{\"b\":\{\"c\":\{\"answer\":\{\"type\":\"integer\",\"value\":\"42\"}}}}}"),
        Case("valid/table/without-super", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n[x] # defining a super-table afterwards is ok\n", "\{\"x\":\{\"y\":\{\"z\":\{\"w\":\{}}}}}"),
        Case("valid/table/without-super-with-values", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\na = 1\nb = 2\n[x] # defining a super-table afterwards is ok\nc = 3\nd = 4\n", "\{\"x\":\{\"c\":\{\"type\":\"integer\",\"value\":\"3\"},\"d\":\{\"type\":\"integer\",\"value\":\"4\"},\"y\":\{\"z\":\{\"w\":\{\"a\":\{\"type\":\"integer\",\"value\":\"1\"},\"b\":\{\"type\":\"integer\",\"value\":\"2\"}}}}}}"),
    ]

fn invalid_0() List[Case]
    [
        Case("invalid/array/double-comma-01", "double-comma-01 = [1,,2]\n", ""),
        Case("invalid/array/double-comma-02", "double-comma-02 = [1,2,,]\n", ""),
        Case("invalid/array/extend-defined-aot", "[[tab.arr]]\n[tab]\narr.val1=1\n", ""),
        Case("invalid/array/extending-table", "a = [\{ b = 1 }]\n\n# Cannot extend tables within static arrays\n# https://github.com/toml-lang/toml/issues/908\n[a.c]\nfoo = 1\n", ""),
        Case("invalid/array/missing-separator-01", "arrr = [true false]\n", ""),
        Case("invalid/array/missing-separator-02", "wrong = [ 1 2 3 ]\n", ""),
        Case("invalid/array/no-close-01", "no-close-01 = [ 1, 2, 3\n", ""),
        Case("invalid/array/no-close-02", "no-close-02 = [1,\n", ""),
        Case("invalid/array/no-close-03", "no-close-03 = [42 #]\n", ""),
        Case("invalid/array/no-close-04", "no-close-04 = [\{ key = 42\n", ""),
        Case("invalid/array/no-close-05", "no-close-05 = [\{ key = 42}\n", ""),
        Case("invalid/array/no-close-06", "no-close-06 = [\{ key = 42 #}]\n", ""),
        Case("invalid/array/no-close-07", "no-close-07 = [\{ key = 42} #]\n", ""),
        Case("invalid/array/no-close-08", "no-close-08 = [\n", ""),
        Case("invalid/array/no-close-table-01", "no-close-table-01 = [\{ key = 42\n", ""),
        Case("invalid/array/no-close-table-02", "no-close-table-02 = [\{ key = 42 #\n", ""),
        Case("invalid/array/no-close-table-03", "no-close-table-03 = [1,\{a=1]\n", ""),
        Case("invalid/array/no-close-table-04", "no-close-table-04 = [1,\{2]\n", ""),
        Case("invalid/array/no-comma-01", "no-comma-01 = [true false]\n", ""),
        Case("invalid/array/no-comma-02", "no-comma-02 = [ 1 2 3 ]\n", ""),
        Case("invalid/array/no-comma-03", "no-comma-03 = [ 1 #,]\n", ""),
        Case("invalid/array/only-comma-01", "only-comma-01 = [,]\n", ""),
        Case("invalid/array/only-comma-02", "only-comma-02 = [,,]\n", ""),
        Case("invalid/array/tables-01", "# INVALID TOML DOC\nfruit = []\n\n[[fruit]] # Not allowed\n", ""),
        Case("invalid/array/tables-02", "# INVALID TOML DOC\n[[fruit]]\n  name = \"apple\"\n\n  [[fruit.variety]]\n    name = \"red delicious\"\n\n  # This table conflicts with the previous table\n  [fruit.variety]\n    name = \"granny smith\"\n", ""),
        Case("invalid/array/text-after-array-entries", "array = [\n  \"Is there life after an array separator?\", No\n  \"Entry\"\n]\n", ""),
        Case("invalid/array/text-before-array-separator", "array = [\n  \"Is there life before an array separator?\" No,\n  \"Entry\"\n]\n", ""),
        Case("invalid/array/text-in-array", "array = [\n  \"Entry 1\",\n  I don't belong,\n  \"Entry 2\",\n]\n", ""),
        Case("invalid/bool/almost-false", "almost-false            = fals\n", ""),
        Case("invalid/bool/almost-false-with-extra", "almost-false-with-extra = falsify\n", ""),
        Case("invalid/bool/almost-true", "almost-true             = tru\n", ""),
        Case("invalid/bool/almost-true-with-extra", "almost-true-with-extra  = truthy\n", ""),
        Case("invalid/bool/capitalized-false", "capitalized-false        = False\n", ""),
        Case("invalid/bool/capitalized-true", "capitalized-true         = True\n", ""),
        Case("invalid/bool/just-f", "just-f                  = f\n", ""),
        Case("invalid/bool/just-t", "just-t                  = t\n", ""),
        Case("invalid/bool/mixed-case", "mixed-case              = valid   = False\n", ""),
        Case("invalid/bool/mixed-case-false", "mixed-case-false        = falsE\n", ""),
        Case("invalid/bool/mixed-case-true", "mixed-case-true         = trUe\n", ""),
        Case("invalid/bool/starting-same-false", "starting-same-false     = falsey\n", ""),
    ]

fn invalid_1() List[Case]
    [
        Case("invalid/bool/starting-same-true", "starting-same-true      = truer\n", ""),
        Case("invalid/bool/wrong-case-false", "wrong-case-false        = FALSE\n", ""),
        Case("invalid/bool/wrong-case-true", "wrong-case-true         = TRUE\n", ""),
        Case("invalid/control/bare-cr", "# The following line contains a single carriage return control character\r\n\r", ""),
        Case("invalid/control/bare-formfeed", "bare-formfeed     = \u{c}\n", ""),
        Case("invalid/control/bare-null", "bare-null         = \"some value\" \u{0}\n", ""),
        Case("invalid/control/bare-vertical-tab", "bare-vertical-tab = \u{b}\n", ""),
        Case("invalid/control/comment-cr", "comment-cr   = \"Carriage return in comment\" # \ra=1\n", ""),
        Case("invalid/control/comment-del", "comment-del  = \"0x7f\"   # \u{7f}\n", ""),
        Case("invalid/control/comment-ff", "comment-ff   = \"0x7f\"   # \u{c}\n", ""),
        Case("invalid/control/comment-lf", "comment-lf   = \"ctrl-P\" # \u{10}\n", ""),
        Case("invalid/control/comment-null", "comment-null = \"null\"   # \u{0}\n", ""),
        Case("invalid/control/comment-us", "comment-us   = \"ctrl-_\" # \u{1f}\n", ""),
        Case("invalid/control/linetab-number-01", "linetab-number-01 = 1\u{b}\n", ""),
        Case("invalid/control/linetab-number-02", "linetab-number-02 = 1.5\u{b}\n", ""),
        Case("invalid/control/linetab-number-03", "linetab-number-03 = 0xff\u{b}\n", ""),
        Case("invalid/control/linetab-number-04", "linetab-number-04 = +inf\u{b}\n", ""),
        Case("invalid/control/multi-del", "multi-del  = \"\"\"null\u{7f}\"\"\"\n", ""),
        Case("invalid/control/multi-lf", "multi-lf   = \"\"\"null\u{10}\"\"\"\n", ""),
        Case("invalid/control/multi-null", "multi-null = \"\"\"null\u{0}\"\"\"\n", ""),
        Case("invalid/control/multi-us", "multi-us   = \"\"\"null\u{1f}\"\"\"\n", ""),
        Case("invalid/control/only-ff", "\u{c}", ""),
        Case("invalid/control/only-null", "\u{0}", ""),
        Case("invalid/control/only-vt", "\u{b}", ""),
        Case("invalid/control/rawmulti-del", "rawmulti-del  = '''null\u{7f}'''\n", ""),
        Case("invalid/control/rawmulti-lf", "rawmulti-lf   = '''null\u{10}'''\n", ""),
        Case("invalid/control/rawmulti-null", "rawmulti-null = '''null\u{0}'''\n", ""),
