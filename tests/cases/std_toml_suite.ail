        ),
        Case(
            name: "valid/array/mixed-int-float",
            src: "ints-and-floats = [1, 1.1]\n",
            want: "\{\"ints-and-floats\":[\{\"type\":\"integer\",\"value\":\"1\"},\{\"type\":\"float\",\"value\":\"1.1\"}]}",
        ),
        Case(
            name: "valid/array/mixed-int-string",
            src: "strings-and-ints = [\"hi\", 42]\n",
