        Case("valid/array/string-quote-comma-01", "title = [\n\"Client: \\\"XXXX\\\", Job: XXXX\",\n\"Code: XXXX\"\n]\n", "\{\"title\":[\{\"type\":\"string\",\"value\":\"Client: \\\"XXXX\\\", Job: XXXX\"},\{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}"),
