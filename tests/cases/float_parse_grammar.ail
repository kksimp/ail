# type.num.8: s.to_float() grammar, correct rounding, overflow to inf, underflow (expected values from Python float() on grammar-accepted strings).
fn main()
    cases := [
        "0",
        "-0",
        "1",
        "-1",
        "1.5",
        "-1.5",
        "0.5",
        "1e5",
        "1E5",
        "1e+5",
        "1e-5",
        "1.5e3",
        "-1.5E-3",
        "123",
        "007",
        "00.5",
        "0e0",
        "1e0",
        "0.0",
        "-0.0",
        "inf",
        "-inf",
        "nan",
        "+inf",
        "Inf",
        "INF",
        "Infinity",
        "infinity",
        "NaN",
        "NAN",
        "-nan",
        "+nan",
        "nan ",
        "-Infinity",
        "+1",
        "+1.5",
        ".5",
        "-.5",
        "5.",
        "-5.",
        "1_0",
        "1_0.5",
        "1._5",
        "1e1_0",
        " 1",
        "1 ",
        "1\n",
        "\t1",
        "",
        "-",
        "+",
        "--1",
        "-+1",
        "1..2",
        "1.2.3",
        "1e",
        "1e+",
        "1e-",
        "e5",
        "1e5.5",
        "0x10",
        "0b1",
        "1f",
        "1.5f",
        "1.5d",
        "1d",
        "\u{661}\u{662}\u{663}",
        "\u{ff11}\u{ff12}\u{ff13}",
        "1,5",
        "1 000",
        "- 1",
        "-1 ",
        "1e400",
        "-1e400",
        "1e-400",
        "-1e-400",
        "1.7976931348623157e308",
        "1.7976931348623158e308",
        "1.7976931348623159e308",
        "1.797693134862315807e308",
        "1.7976931348623158079e308",
        "1.797693134862315708145274237317043567981e308",
        "2.4703282292062327e-324",
        "2.4703282292062328e-324",
        "2.470328229206232720882e-324",
        "5e-324",
        "4.9e-324",
        "1e-323",
        "2.2250738585072014e-308",
        "2.2250738585072011e-308",
        "9007199254740993",
        "9007199254740993.0",
        "9007199254740992.5",
        "9007199254740993.000000000001",
        "0.1",
        "0.3",
        "0.30000000000000004",
        "4.35",
        "1e23",
        "8.41e21",
        "9.5e-322",
        "123456789012345678901234567890",
        "0.000000000000000000000000000001",
        "1e999999999999999999999",
        "1e-999999999999999999999",
        "0e999999999999999999999",
        "00000000000000000000000000000001e1",
        "NaN",
        "nAn",
        "iNf",
        "1e5 ",
        "1E+05",
        "1E-05",
        "\u{663}",
        "1\u{a0}",
        "1\u{2003}",
        "\\u00a01",
    ]
    for s in cases
        v := s.to_float()
        print("[{s}] -> {v}")
