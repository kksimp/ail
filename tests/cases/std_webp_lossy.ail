## std.webp.11 to std.webp.14: lossy (VP8) WebP files from libwebp at several settings: sizes that are not a multiple of 16
## (1x1 to 17x17), segments, the simple and the normal loop filter, sharpness, no filter, 4 and 8 token partitions, filter
## deltas, a VP8X wrapper, a flat image, a very low quality image and one whose macroblocks skip their residual. The
## expected pixels are what libwebp decodes with its default (fancy) chroma upsampling; larger images are shown as the
## CRC-32 of the pixels.
use std.image.webp

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    inf := webp.info(b) else err
        print("{name}: info {err.kind.name()}: {err.why}")
        return
    img := webp.decode(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: {inf.width}x{inf.height} lossless {inf.lossless} alpha {inf.alpha} animated {inf.animated}")
    if img.width != inf.width or img.height != inf.height
        print("size differs")
    if img.pixels.len() <= 400
        print(img.pixels.hex())
    else
        print("crc {hash.crc32(img.pixels)}")

fn main()
    show(
        "lossy 1x1",
        "524946463800000057454250565038202c000000b001009d012a0100010002804225a00274ba0004300000feead47ffc2b59eb746a0fffa127fb97fa27e00000",
    )
    show(
        "lossy 2x2",
        "524946463c000000574542505650382030000000d001009d012a0200020001402625a00274ba01f80003b000fef3c267ff15bfe39b7c736ff8adfff8b39188ecbc000000",
    )
    show(
        "lossy 3x5",
        "524946463e000000574542505650382032000000b001009d012a0300050002c04c25b00274010eba6d9000fedf4ffb439ffced48cdffca87fffe41f1eda86d96057cb3000000",
    )
    show(
        "lossy 16x16",
        "",
    )
    show(
        "lossy 17x17",
        "524946468a00000057454250565038207e0000001004009d012a110011003ec5549f4ba7a522a1b7f55800f018896a009d328470001502962aacbc688000fec4a066a808cf0041fe027cafc8c807622fff6adf1fc67cad9e2a97134c432efc3dd86b898771a8d8b7da8fcb0428a1ae7380cb495e4b6d7893b21e0eb971dcb920157be5c5a8f11c846e2abcd8ed28be600000",
    )
    show(
        "lossy segments",
        "",
    )
    show(
        "lossy noise",
        "",
    )
    show(
        "lossy simple",
        "",
    )
    show(
        "lossy sharp",
        "",
    )
    show(
        "lossy nofilter",
        "",
    )
    show(
        "lossy 4parts",
        "",
    )
    show(
        "lossy deltas",
        "",
    )
    show(
        "lossy simple 8parts deltas",
        "",
    )
    show(
        "lossy vp8x",
        "",
    )
    show(
        "lossy flat",
        "",
    )
    show(
        "lossy lowq",
        "524946466800000057454250565038205c0000003004009d012a280028003f81c0e0703fb2af2b355aad53f0300002074da99df60d7d341af9122aabc50000fee7156f0e1997fa910767d6c9ad7015260e9d1ddfc2352e16739f2ab3c395601ae6f4aa3b9cbefb63b3fba4c270000000",
    )
    show(
        "lossy skip",
        "",
    )
