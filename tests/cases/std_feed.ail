## std.feed.1-8: read an RSS 2.0 feed and its dates.
use std.feed
use std.time.date

fn stamp(d date.DateTime?) str
    x := d else return "none"
    x.format("%Y-%m-%d %H:%M:%S %:z")

fn main() !
    src := """
        <?xml version="1.0"?>
        <rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
          <channel>
            <title>Example &amp; Co</title>
            <link>https://example.com/</link>
            <description>News</description>
            <language>en-us</language>
            <lastBuildDate>Tue, 10 Jun 2003 09:41:01 -0500</lastBuildDate>
            <item>
              <title>First</title>
              <link>https://example.com/1</link>
              <description>One &lt;b&gt;bold&lt;/b&gt;</description>
              <dc:creator>Ann</dc:creator>
              <category>news</category>
              <category>tech</category>
              <guid isPermaLink="false">id-1</guid>
              <pubDate>Tue, 10 Jun 2003 04:00:00 GMT</pubDate>
              <enclosure url="https://example.com/a.mp3" length="12345" type="audio/mpeg"/>
            </item>
            <item>
              <title>Second</title>
              <link>https://example.com/2</link>
              <content:encoded><![CDATA[<p>Hi</p>]]></content:encoded>
              <pubDate>Wed, 02 Oct 2002 13:00:00 EST</pubDate>
            </item>
          </channel>
        </rss>
        """
    f := feed.parse(src)?
    print(f.format.name())
    print(f.title)
    print("{f.link} {f.language} {stamp(f.updated)}")
    print(f.items.len())
    for it in f.items
        print("{it.id} | {it.title} | {it.author} | [{it.tags.join(",")}]")
        print("{it.summary} | {it.content} | {stamp(it.published)}")
        for e in it.enclosures
            print("{e.url} {e.mime} {e.length}")
