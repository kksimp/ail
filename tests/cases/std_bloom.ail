## std.bloom.1 to std.bloom.8: sizing from a count and a rate, no false
## negatives, a bounded false-positive share for str and int keys, reset, and
## union of filters of one shape.
use std.bloom

fn main()
    mut f := bloom.new(1000, 0.01)
    print("bits {f.bits()} hashes {f.hashes()}")
    for i in 0..1000
        f.add("key{i}")
    print("count {f.count()}")
    mut missed := 0
    for i in 0..1000
        if not f.has("key{i}")
            missed += 1
    print("false negatives {missed}")
    mut fp := 0
    for i in 0..10000
        if f.has("other{i}")
            fp += 1
    print("false positives under 3 percent {fp < 300}")
    r := f.fill_ratio()
    print("fill near half {r > 0.4 and r < 0.6}")
    est := f.false_positive_rate()
    print("estimate under 3 percent {est > 0.0 and est < 0.03}")

    mut g := bloom.new(100, 0.05)
    print("bits {g.bits()} hashes {g.hashes()}")
    mut n := bloom.new(1000, 0.01)
    for i in 0..1000
        n.add_int(i * 7)
    mut lost := 0
    for i in 0..1000
        if not n.has_int(i * 7)
            lost += 1
    print("int false negatives {lost}")
    mut nfp := 0
    for i in 0..10000
        if n.has_int(100000 + i)
            nfp += 1
    print("int false positives under 3 percent {nfp < 300}")

    mut small := bloom.with_size(64, 3)
    print("with_size {small.bits()} {small.hashes()} {small.count()} {small.fill_ratio():.3}")
    small.add("x")
    small.add("x")
    seen := small.has("x")
    print("repeat {small.count()} {seen}")
    small.reset()
    print("reset {small.count()} {small.fill_ratio():.3}")

    mut a := bloom.with_size(256, 3)
    mut b := bloom.with_size(256, 3)
    a.add("x")
    b.add("y")
    u := a.union(b) else
        print("union none")
        return
    has_x := u.has("x")
    has_y := u.has("y")
    print("union {has_x} {has_y} {u.count()}")
    narrow := a.union(bloom.with_size(128, 3))
    fewer := a.union(bloom.with_size(256, 4))
    print("shape {narrow == none} {fewer == none}")
