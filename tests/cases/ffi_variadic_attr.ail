# ffi.var.1: an attribute on an `extern c fn` keeps its variadic mark, so the
# call still takes extra arguments.
use std.mem

@inline extern c fn sprintf(buf *u8, fmt *u8, ...) i32

fn main()
    unsafe
        buf := mem.alloc(32, 0.to_u8())
        fmt := mem.cstr("%d-%d")
        n := sprintf(buf, fmt, 4, 2)
        print(n)
        print(mem.from_cstr(buf))
        mem.free(fmt)
        mem.free(buf)
