fn main()
    print("ff".to_int(16))
    print("-101".to_int(2))
    print("102".to_int(2))
    print("Zz".to_int(36))
    print("".to_int(10))
    print(255.to_str(2))
    print((0 - 255).to_str(16))
    print(255.to_str())
    print(35.to_str(36))
    s := "a-b-c"
    print(s.find('-'))
    print(s.rfind('-'))
    print(s.count('-'))
    print(s.replace('-', '+'))
    print(s.replace("-", '_'))
    print(s.split('-'))
