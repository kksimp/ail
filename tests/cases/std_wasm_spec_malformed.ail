## std.wasm.6: `assert_malformed` binary modules of the WebAssembly specification test suite are refused by `parse`, with the kind.
use std.wasm

fn run(name str, src bytes)
    m := wasm.parse(src) else err
        print("{name} parse {err.kind.name()}")
        return
    wasm.validate(m) else err
        print("{name} validate {err.kind.name()}")
        return
    out := wasm.write(m) else err
        print("{name} write {err.kind.name()}")
        return
    back := wasm.parse(out) else err
        print("{name} reparse {err.kind.name()}")
        return
    same := back == m
    exact := out == src
    print("{name} ok {same} {exact}")

fn main()
    run("binary.4", b"")
    run("binary.30", b"\x00\x61\x73\x6d\x00\x00\x01\x00")
