## std.ordcoll.1 to std.ordcoll.7: OrdMap put, get, remove, first and last,
## floor and ceiling, range, keys and rank.
fn show(label str, e (int, str)?)
    x := e else
        print("{label} none")
        return
    print("{label} {x.0} {x.1}")

fn main()
    mut m := ordcoll.OrdMap[int, str].new()
    print(m.is_empty())
    for k in [30, 10, 20, 50, 40]
        m.put(k, "v{k}")
    print(m.len())
    show("first", m.first())
    show("last", m.last())
    show("floor25", m.floor(25))
    show("floor20", m.floor(20))
    show("floor5", m.floor(5))
    show("ceiling25", m.ceiling(25))
    show("ceiling20", m.ceiling(20))
    show("ceiling55", m.ceiling(55))
    show("lower20", m.lower(20))
    show("lower10", m.lower(10))
    show("higher20", m.higher(20))
    show("higher50", m.higher(50))
    print(m.get(30) else "none")
    print(m.get(31) else "none")
    print(m.contains(40))
    print(m.contains(41))
    m.put(30, "new")
    print(m.get(30) else "none")
    print(m.len())
    print(["{e.0}={e.1}" for e in m.range(15, 40)].join(" "))
    print(["{e.0}={e.1}" for e in m.from_key(30, 2)].join(" "))
    print(m.rank(30))
    print(m.rank(5))
    print(m.rank(99))
    show("nth2", m.nth(2))
    show("nth9", m.nth(9))
    print(m.remove(20) else "none")
    print(m.remove(20) else "none")
    print(m.len())
    print(["{k}" for k in m.keys()].join(","))
    print(m.values().join(","))
    show("pop_first", m.pop_first())
    show("pop_last", m.pop_last())
    print(m.len())
    show("first", m.first())
