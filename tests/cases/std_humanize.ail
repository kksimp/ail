## std.humanize.1-11: locales, numbers, percentages, compact numbers, sizes,
## ordinals and relative times.
use std.humanize

fn main()
    # std.humanize.4: integers
    print(humanize.int_text(0))
    print(humanize.int_text(999))
    print(humanize.int_text(1000))
    print(humanize.int_text(1234567))
    print(humanize.int_text(-1234567))
    print(humanize.de().int_text(1234567))
    print(humanize.fr().int_text(1234567))
    print(humanize.es().int_text(1234))
    print(humanize.es().int_text(12345))
    print(humanize.ja().int_text(1234567))
    print(humanize.custom("_", "'").int_text(1234567))
    # std.humanize.2: language tags
    print(humanize.locale("de-AT") != none)
    print(humanize.locale("FR_ca") != none)
    print(humanize.locale("xx") == none)
    de := humanize.locale("de") else humanize.en()
    print(de.float_text(1234.5, 2))
    # std.humanize.5: floats
    print(humanize.float_text(1234.5, 2))
    print(humanize.float_text(1234.5, 0))
    print(humanize.float_text(0.125, 2))
    print(humanize.float_text(-0.001, 2))
    print(humanize.float_text(-1234567.891, 1))
    print(humanize.float_text(2.5, 0))
    print(humanize.float_text(1.0, 3))
    print(humanize.fr().float_text(9876543.21, 2))
    print(humanize.es().float_text(1234.5, 1))
    print(humanize.custom(" ", ",").float_text(1234567.5, 1))
    # std.humanize.6: percentages
    print(humanize.percent(0.256, 1))
    print(humanize.percent(1.0, 0))
    print(humanize.percent(0.0, 2))
    print(humanize.percent(12.5, 0))
    print(humanize.de().percent(0.256, 1))
    print(humanize.fr().percent(0.5, 0))
    # std.humanize.7: compact numbers
    print(humanize.compact(0, 1))
    print(humanize.compact(999, 1))
    print(humanize.compact(1000, 1))
    print(humanize.compact(1234, 1))
    print(humanize.compact(1250, 1))
    print(humanize.compact(999999, 1))
    print(humanize.compact(999950, 1))
    print(humanize.compact(2000000, 1))
    print(humanize.compact(3400000, 1))
    print(humanize.compact(7100000000, 2))
    print(humanize.compact(5000000000000, 0))
    print(humanize.compact(-1234, 1))
    print(humanize.compact(1234567, 0))
    print(humanize.de().compact(1234, 1))
    # std.humanize.8: SI sizes
    print(humanize.size_si(0, 1))
    print(humanize.size_si(999, 1))
    print(humanize.size_si(1000, 1))
    print(humanize.size_si(1500000, 1))
    print(humanize.size_si(1234567, 2))
    print(humanize.size_si(999999, 1))
    print(humanize.size_si(5000000000, 0))
    print(humanize.size_si(-2500, 1))
    print(humanize.de().size_si(1500000, 1))
    # std.humanize.9: IEC sizes
    print(humanize.size_iec(1023, 1))
    print(humanize.size_iec(1024, 1))
    print(humanize.size_iec(1572864, 1))
    print(humanize.size_iec(1048575, 1))
    print(humanize.size_iec(1073741824, 2))
    print(humanize.size_iec(9223372036854775807, 1))
    # std.humanize.10: ordinals
    mut ords := []
    for n in [0, 1, 2, 3, 4, 10, 11, 12, 13, 14, 21, 22, 23, 101, 111, 112, 113, 1000, -1, -2, -11]
        ords.push(humanize.ordinal(n))
    print(ords.join(" "))
    # std.humanize.11: relative times
    now := 1000000000000
    print(humanize.relative(now, now))
    print(humanize.relative(now - 999, now))
    print(humanize.relative(now - 1000, now))
    print(humanize.relative(now - 59999, now))
    print(humanize.relative(now - 60000, now))
    print(humanize.relative(now - 180000, now))
    print(humanize.relative(now - 5400000, now))
    print(humanize.relative(now - 7200000, now))
    print(humanize.relative(now - 86400000, now))
    print(humanize.relative(now - 6 * 86400000, now))
    print(humanize.relative(now - 7 * 86400000, now))
    print(humanize.relative(now - 21 * 86400000, now))
    print(humanize.relative(now - 30 * 86400000, now))
    print(humanize.relative(now - 359 * 86400000, now))
    print(humanize.relative(now - 360 * 86400000, now))
    print(humanize.relative(now - 365 * 86400000, now))
    print(humanize.relative(now - 800 * 86400000, now))
    print(humanize.relative(now + 120000, now))
    print(humanize.relative(now + 3 * 3600000, now))
    print(humanize.relative(now + 500, now))
