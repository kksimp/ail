## std.textdiff.1-3, 5: `lines` is a shortest line diff (Remove before Add in a
## run of changes), with 1-based line numbers; `stat` counts the changes.
use std.textdiff

fn show(a str, b str)
    edits := textdiff.lines(a, b)
    print("{edits.len()} edits")
    for e in edits
        print("{e.kind.name()} {e.a} {e.b} {e.nl} {e.text}")

fn main()
    show("a\nb\nc\n", "a\nx\nc\nd\n")
    show("a\nb", "a\nb\n")
    show("", "")
    show("", "x\n")
    show("same\ntext\n", "same\ntext\n")
    s := textdiff.stat("a\nb\nc\n", "a\nx\nc\nd\n")
    print("added {s.0} removed {s.1}")
    # the example of the Myers paper: ABCABBA to CBABAC takes 5 changes
    s2 := textdiff.stat("A\nB\nC\nA\nB\nB\nA\n", "C\nB\nA\nB\nA\nC\n")
    print("added {s2.0} removed {s2.1}")
    s3 := textdiff.stat("same\n", "same\n")
    print("added {s3.0} removed {s3.1}")
    e1 := textdiff.lines("x\n", "x\n")[0]
    print(e1.kind == Keep)
