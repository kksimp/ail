# unsafe.block.1-2: an `unsafe fn` is called inside an `unsafe` block, which
# may give a value and may `return`.
unsafe fn twice(x int) int
    x * 2

fn safe_twice(x int) int
    unsafe
        twice(x)

fn early(x int) int
    unsafe
        if x > 5
            return twice(x)
    0

fn main()
    print(safe_twice(21))
    print(early(9))
    print(early(1))
    unsafe
        y := twice(4)
        print(y)
