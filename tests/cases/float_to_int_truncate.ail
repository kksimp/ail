# type.num.9: x.to_int() truncates toward zero; exact at the int boundaries.
fn main()
    print(2.9.to_int())
    print((-2.9).to_int())
    print(0.9.to_int())
    print((-0.9).to_int())
    print((-0.0).to_int())
    print(0.0.to_int())
    print(5e-324.to_int())
    print(1.0.to_int())
    print((-1.0).to_int())
    print(1.9999999999999998.to_int())
    print(2.5.to_int())
    print((-2.5).to_int())
    print(1e15.to_int())
    print(1e18.to_int())
    print(9007199254740992.0.to_int())
    print(9007199254740993.0.to_int())
    print(9223372036854774784.0.to_int())
    print((-9223372036854774784.0).to_int())
    print((-9223372036854775808.0).to_int())
    print(123456789.987654321.to_int())
    print((-123456789.987654321).to_int())
    x := 7.9
    print(x.to_int() + 1)
    print((x * 10).to_int())
    n := 41
    print(n.to_float().to_int())
    print((n.to_float() / 2).to_int())
    xs := [0.5, 1.5, 2.5, -0.5, -1.5, -2.5]
    mut out := List[int]()
    for v in xs
        out.push(v.to_int())
    print(out)
    r := List[int]()
    print(r)
    print(2.5.round().to_int())
    print((-2.5).round().to_int())
    print(0.5.floor().to_int())
    print((-0.5).ceil().to_int())
