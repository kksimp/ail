## std.gif.3 to std.gif.9: still and animated GIFs, interlace, transparency, disposal, clipping, the loop
## count, and LZW streams that fill the 4096-entry code table. The small fixtures are written by a script that
## LZW-encodes chosen color indexes; the expected frames are checked against an independent decoder (the larger
## files are shown as the CRC-32 of the pixels).
use std.image.gif

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    inf := gif.info(b) else err
        print("{name}: info {err.kind.name()}: {err.why}")
        return
    anim := gif.decode(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: {inf.version} {anim.width}x{anim.height} loops {anim.loops} frames {anim.frames.len()}")
    for f in anim.frames
        if f.img.pixels.len() <= 400
            print("  {f.delay_ms} ms {f.img.pixels.hex()}")
        else
            print("  {f.delay_ms} ms crc {hash.crc32(f.img.pixels)}")

fn main()
    show(
        "still",
        "47494638396105000400810000ff000000ff000000ffffffff2c00000000050004000002064434869ad758003b",
    )
    show(
        "interlace",
        "47494638396103000a0082000000ff001ee10a3cc3145aa51e788728966932b44b3cd22d462c0000000003000a0040030d08bad4f22686396ab927cf9000003b",
    )
    show(
        "transparent",
        "47494638396104000300810000000000ff000000ff000000ff21f90401050000002c0000000004000300000206442063380205003b",
    )
    show(
        "anim",
        "",
    )
    show(
        "clip",
        "47494638376103000300810000ff000000ff000000ffffffff2c020002000300030000020444348650002c00000000010001000002025c01003b",
    )
    show(
        "big",
        "",
    )
    show(
        "pillow256",
        "",
    )
    b := bytes.from_hex("47494638396105000400810000ff000000ff000000ffffffff2c00000000050004000002064434869ad758003b") else return
    print(gif.is_gif(b))
    print(gif.is_gif(b"GIF9"))
    print(gif.is_gif(b[0..3]))
    first := gif.first_frame(b) else return
    print("{first.width}x{first.height} {first.pixel(1, 0)}")
