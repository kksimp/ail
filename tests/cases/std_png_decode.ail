## std.png.2 to std.png.8: every color type and bit depth, palettes, tRNS, filters, Adam7 and split IDAT.
## The fixtures are made by a script that writes each file filter by filter (rows cycle through the five
## filters) from random samples; the expected pixels are checked against an independent decoder.
use std.image.png

fn show(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    inf := png.info(b) else err
        print("{name}: info {err.kind.name()}: {err.why}")
        return
    img := png.decode(b) else err
        print("{name}: {err.kind.name()}: {err.why}")
        return
    print("{name}: {img.width}x{img.height} {inf.color.name()} depth {inf.depth} interlaced {inf.interlaced}")
    print(img.pixels.hex())

fn main()
    show("gray1", "89504e470d0a1a0a0000000d494844520000000a000000050100000000541f40c50000001674655874436f6d6d656e74006d61646520627920612074657374c759968f0000001749444154789c6358c4c098348fe9210373fa1f96920a0021e404dd6e2d5cc30000000049454e44ae426082")
    show("gray2", "89504e470d0a1a0a0000000d4948445200000007000000050200000000e641b1a50000001674655874436f6d6d656e74006d61646520627920612074657374c759968f0000001749444154789c63d8ddc078539c299081597c1e4b8f0e0021f503f42c64ffa40000000049454e44ae426082")
    show("gray4", "89504e470d0a1a0a0000000d4948445200000005000000060400000000eb60e6960000001674655874436f6d6d656e74006d61646520627920612074657374c759968f0000002049444154789c63b0179bc0e8deaac2744f6102b3f5472d96aa6a3e06f7820f005192076e1d9974ab0000000049454e44ae426082")
