## std.app.6-10: `run_host` speaks the protocol to a host written in AIL.
use std.app

struct Todo
    items List[str]
    draft str
    log List[str]

impl app.App for Todo
    fn update(mut self, ev app.Event)
        log.push(ev.kind)
        if ev.kind == Edit
            draft = ev.text
        if (ev.kind == Press and ev.id == "add") or ev.kind == Submit
            items.push(draft)
            draft = ""
        if ev.kind == Resize
            log.push("{ev.dx}x{ev.dy} cell {ev.cell_w}x{ev.cell_h}")
        if ev.kind == Click
            log.push("{ev.text} {ev.x},{ev.y} on {ev.id}")

    fn view(self) app.Node
        mut kids := [app.field("draft", draft, "new item"), app.button("add", "Add")]
        for item in items
            kids.push(Label(item))
        Column(kids)

    fn title(self) str
        "Todo ({items.len()})"

fn main() !
    mut t := Todo(items: [], draft: "", log: [])
    host := "tests/app/fake_host.ail"
    ail := env.get("AIL") else (env.get("AIL_BINARY") else "ail")
    app.run_host(mut t, ail, ["run", host])?
    print(t.log.join("\n"))
    print(app.outline(t.view()))
