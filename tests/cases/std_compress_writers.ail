## std.compress.15, 16: the zstd and Brotli writers. Small frames and streams
## are checked byte for byte (RFC 8878, RFC 7932, worked by hand and read by the
## reference decoders), larger inputs by their size and a round trip through
## compress.unzstd and compress.unbrotli at levels 1, 3 and 9. The same output
## was read by the reference decoders when the rules were written.
use std.compress

fn show(b bytes) str
    mut parts := List[str]()
    for i in 0..b.len()
        parts.push("{b[i]}")
    parts.join(" ")

fn filled(n int, v int) bytes
    mut xs := List[u8]()
    for i in 0..n
        xs.push(v.to_u8())
    bytes.from_list(xs)

fn alternating(n int) bytes
    mut xs := List[u8]()
    for i in 0..n
        xs.push((i % 2).to_u8())
    bytes.from_list(xs)

## Text with repeats, and a few bytes of noise.
fn prose(n int) bytes
    words := ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta"]
    mut xs := List[u8]()
    mut seed := 12345
    while xs.len() < n
        seed = (seed * 1103515245 + 12345) % 2147483648
        w := words[(seed / 65536) % 8]
        for c in w.to_bytes()
            xs.push(c)
        xs.push(32)
        if seed % 17 == 0
            xs.push((seed % 251).to_u8())
    bytes.from_list(xs[..n])

fn main() !
    print(show(compress.zstd("")))
    print(show(compress.zstd("abc")))
    print(show(compress.zstd(filled(40, 97))))
    print(show(compress.zstd("ab{filled(32, 122).to_str()}c")))
    print(compress.zstd(alternating(70000)).len() < 100)
    print(compress.zstd(filled(300000, 0)).len())
    print(show(compress.brotli("")))
    print(show(compress.brotli("abc")))
    print(compress.brotli(alternating(70000)).len() < 100)
    print(compress.brotli(filled(300000, 0)).len() < 100)
    text := prose(200000)
    print(compress.zstd(text).len() < text.len() / 2)
    print(compress.brotli(text).len() < text.len() / 2)
    print(compress.zstd(text, 1).len() >= compress.zstd(text, 9).len())
    print(compress.brotli(text, 1).len() >= compress.brotli(text, 9).len())
    for data in [b"", b"x", "abc abc abc".to_bytes(), alternating(70000), filled(300000, 7), text]
        for level in [1, 3, 9]
            z := compress.unzstd(compress.zstd(data, level))?
            b := compress.unbrotli(compress.brotli(data, level))?
            print("{z == data} {b == data}")
