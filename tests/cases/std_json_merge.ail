## json.merge.1: `target.merge(patch)` is JSON Merge Patch (RFC 7386), with the
## test vectors of its Appendix A.
fn mp(target str, patch str) !
    t := parse_json(target)?
    p := parse_json(patch)?
    print(t.merge(p))

fn main() !
    mp(r"""{"a":"b"}""", r"""{"a":"c"}""")
    mp(r"""{"a":"b"}""", r"""{"b":"c"}""")
    mp(r"""{"a":"b"}""", r"""{"a":null}""")
    mp(r"""{"a":"b","b":"c"}""", r"""{"a":null}""")
    mp(r"""{"a":["b"]}""", r"""{"a":"c"}""")
    mp(r"""{"a":"c"}""", r"""{"a":["b"]}""")
    mp(r"""{"a":{"b":"c"}}""", r"""{"a":{"b":"d","c":null}}""")
    mp(r"""{"a":[{"b":"c"}]}""", r"""{"a":[1]}""")
    mp(r"""["a","b"]""", r"""["c","d"]""")
    mp(r"""{"a":"b"}""", r"""["c"]""")
    mp(r"""{"a":"foo"}""", "null")
    mp(r"""{"a":"foo"}""", "\"bar\"")
    mp(r"""{"e":null}""", r"""{"a":1}""")
    mp(r"""[1,2]""", r"""{"a":"b","c":null}""")
    mp("\{}", r"""{"a":{"bb":{"ccc":null}}}""")
