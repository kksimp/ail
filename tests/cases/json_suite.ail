# std.json against the JSONTestSuite y_ and n_ cases (json.parse.1, json.err.2 to json.err.4):
# every y_ document parses and its text reads back to itself, every n_ document fails,
# and the implementation-defined i_ documents print the verdict this parser gives.
# Left out: the cases whose bytes are not UTF-8 (a `str` is always UTF-8) and the two
# unbounded nestings n_structure_100000_opening_arrays and n_structure_open_array_object.

fn accepts(text str) bool
    _ := parse_json(text) else
        return false
    true

fn stable(text str) bool
    j := parse_json(text) else
        return false
    k := parse_json(j.to_text()) else
        return false
    k.to_text() == j.to_text()

