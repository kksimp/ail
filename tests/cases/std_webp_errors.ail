## std.webp.10: what is refused and the kind of each failure, for `info` and for `decode`. The fixtures are small WebP
## files with one thing wrong: a wrong form type, a cut file, a cut stream, a bad signature, a lossy file and an animation.
use std.image.webp

fn kind_info(b bytes) str
    inf := webp.info(b) else err
        return err.kind.name()
    "ok {inf.width}x{inf.height}"

fn kind_decode(b bytes) str
    img := webp.decode(b) else err
        return err.kind.name()
    "ok {img.width}x{img.height}"

fn try_file(name str, hex str)
    b := bytes.from_hex(hex) else
        print("{name}: bad fixture")
        return
    print("[{name}] info {kind_info(b)}, decode {kind_decode(b)}")

fn main()
    try_file("empty", "")
    try_file(
        "wave",
        "524946463a000000574156455650384c2e0000002f0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412ef98ef0b01",
    )
    try_file(
        "riff size",
        "524946463a000000574542505650384c2e0000002f0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412",
    )
    try_file(
        "cut stream",
        "524946462e000000574542505650384c220000002f0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf62784",
    )
    try_file(
        "cut tail",
        "",
    )
    try_file("cut early", "5249464614000000574542505650384c070000002f0fc00200b98c00")
    try_file("short chunk", "5249464610000000574542505650384c030000002f0fc000")
    try_file(
        "signature",
        "524946463a000000574542505650384c2e0000002e0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412ef98ef0b01",
    )
    try_file(
        "version",
        "524946463a000000574542505650384c2e0000002f0fc00220b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412ef98ef0b01",
    )
    try_file(
        "lossy",
        "",
    )
    try_file(
        "animated",
        "524946468400000057454250565038580a00000002000000070000070000414e494d06000000000000000000414e4d4628000000000000000000070000070000280000025650384c0f0000002f07c0010007109589fe0722a2ff0100414e4d46280000000000000000000700000700003c0000005650384c0f0000002f07c001000710b58cfe0722a2ff0100",
    )
    try_file("no image", "524946461000000057454250455849460400000061626364")
    try_file(
        "bad vp8x",
        "5249464646000000574542505650385804000000000000005650384c2e0000002f0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412ef98ef0b01",
    )
    try_file(
        "canvas",
        "524946464c00000057454250565038580a000000000000001000000b00005650384c2e0000002f0fc00200b98ce87fec22a2ff0105010b416b41ffb2dc1360220ca46d1bdaf6278404095697209412ef98ef0b01",
    )
    try_file(
        "flipped",
        "524946463a000000574542505650384c2e0000002f0fc00200b98ce87fec78a2ff0105010b1b6b41ffb2dc133a220ca46d1bdaac2784040956977a9412ef98ef0b5b",
    )
    try_file(
