## std.cbor.1-10: encoding to and decoding from CBOR, including the failures.
use std.cbor

fn show(label str, j Json)
    data := cbor.encode(j) else err
        print("{label}: error: {err}")
        return
    print("{label}: {data.hex()}")

fn dec(hex str)
    data := bytes.from_hex(hex) else b""
    j := cbor.decode(data) else err
        print("[{hex}] {err.kind.name()}: {err}")
        return
    print("[{hex}] {j.to_text()}")

fn round(text str)
    j := parse_json(text) else return
    data := cbor.encode(j) else return
    back := cbor.decode(data) else return
    print("{text} -> {back.to_text()}")

fn main()
    show("null", Json.Null)
    show("true", Json.Bool(true))
    show("false", Json.Bool(false))
    show("0", Json.Num(0.0))
    show("23", Json.Num(23.0))
    show("24", Json.Num(24.0))
    show("255", Json.Num(255.0))
    show("256", Json.Num(256.0))
    show("65535", Json.Num(65535.0))
    show("65536", Json.Num(65536.0))
    show("2^32-1", Json.Num(4294967295.0))
    show("2^32", Json.Num(4294967296.0))
    show("2^53", Json.Num(9007199254740992.0))
    show("-1", Json.Num(-1.0))
    show("-24", Json.Num(-24.0))
    show("-25", Json.Num(-25.0))
    show("-1000", Json.Num(-1000.0))
    show("-2^63", Json.Num(-9223372036854775808.0))
    show("2^63", Json.Num(9223372036854775808.0))
    show("1.5", Json.Num(1.5))
    show("-4.1", Json.Num(-4.1))
    show("1e20", Json.Num(100000000000000000000.0))
    show("-0.0", Json.Num(-0.0))
    show("empty str", Json.Str(""))
    show("a", Json.Str("a"))
    show("IETF", Json.Str("IETF"))
    show("u-umlaut", Json.Str("\u{fc}"))
    show("empty arr", Json.Arr([]))
    show("empty obj", Json.Obj([]))
    show("[1,2,3]", Json.Arr([Json.Num(1.0), Json.Num(2.0), Json.Num(3.0)]))
    show("obj", parse_json("\{\"a\": 1, \"b\": [2, 3]}") else Json.Null)
    mut deep := Json.Null
    mut k := 0
    while k < 600
        deep = Json.Arr([deep])
        k += 1
    show("deep", deep)
    dec("00")
    dec("17")
    dec("1818")
    dec("1903e8")
    dec("1a000f4240")
    dec("1b000000e8d4a51000")
    dec("20")
