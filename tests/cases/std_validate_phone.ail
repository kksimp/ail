## std.validate.15, std.validate.16: E.164 phone numbers.
use std.validate

fn try_phone(s str, cc str)
    p := validate.phone(s, default_cc: cc) else err
        print("[{s}] {err.kind.name()}")
        return
    print("[{s}] {p} cc={p.country_code} national={p.national}")

fn main()
    try_phone("+1 415-555-2671", "")
    try_phone("+14155552671", "")
    try_phone("+44 20 7946 0958", "")
    try_phone("+81 3-1234-5678", "")
    try_phone("+49 30 123456", "")
    try_phone("+33 1 23 45 67 89", "")
    try_phone("+61 2 1234 5678", "")
    try_phone("+86 10 1234 5678", "")
    try_phone("+91 98765 43210", "")
    try_phone("+55 11 91234-5678", "")
    try_phone("+7 495 123-45-67", "")
    try_phone("+353 1 234 5678", "")
    try_phone("+44 20-7946.0958", "")
    try_phone("+1 (415) 555-2671 ", "")
    try_phone("(415) 555-2671", "1")
    try_phone("1-415-555-2671", "1")
    try_phone("020 7946 0958", "44")
    try_phone("030 123456", "49")
    try_phone("+999 123456", "")
    try_phone("+1 415 555", "")
    try_phone("+1234567890123456", "")
    try_phone("+0 1234567", "")
    try_phone("415 555 2671", "")
    try_phone("", "")
    try_phone("+", "")
    try_phone("+44", "")
    try_phone("0044 20 7946 0958", "")
    try_phone("00 1 415 555 2671", "")
    try_phone("+44 20 7946 095a", "")
    try_phone("+1 415-555-2671 ext 5", "")
    print(validate.is_e164("+14155552671"))
    print(validate.is_e164("+1 415 555 2671"))
    print(validate.is_e164("14155552671"))
    print(validate.is_e164("+44"))
    print(validate.is_e164("+4420794609580"))
