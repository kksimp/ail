## std.args.12-13: counted and repeated switches, `-vq` bundles, and
## "did you mean" hints, with an environment fallback beside them.
use std.args

fn spec() List[args.Spec]
    [
        args.count("verbose", "v", "more output"),
        args.flag("quiet", "q", "less output"),
        args.opt("jobs", "j", "workers", "1").from_env("TOOL_JOBS"),
        args.many("tag", "t", "a tag"),
        args.pos("input", "file to read"),
    ]

fn show(words List[str], vars Map[str, str])
    a := args.parse_in("tool", "", "does things", spec(), words, vars) else err
        print("error: {err.why}")
        return
    print("{a.count("verbose")} {a.flag("verbose")} {a.flag("quiet")} {a.get("jobs")} {a.all("tag")} {a.get("input")}")

fn main()
    bare := Map[str, str]()
    show(["a.txt"], bare)
    show(["-vvq", "-j4", "-t", "x", "--tag=y", "a.txt"], bare)
    show(["--verbose", "--verbose", "a.txt"], bare)
    show(["-j", "2", "a.txt"], {"TOOL_JOBS": "8"})
    show(["--verbos", "a.txt"], bare)
    show(["-vx", "a.txt"], bare)
    show(["-j"], bare)
    print(args.usage("tool", "does things", spec()))
