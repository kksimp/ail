# == and != on maps and sets, alone and inside structs, enums and lists (native: eq.T over the entries).
struct Holder
    m Map[str, int]
    s Set[int]

enum E
    A(m Map[int, int])
    B

fn main()
    a := {"x": 1, "y": 2}
    b := {"y": 2, "x": 1}
    print(a == b)
    print(a != b)
    print({"x": 1} == {"x": 2})
    print({"x": 1} == {"y": 1})
    print({"x": 1} == {"x": 1, "y": 2})
    print({"x": 1, "y": 2} == {"x": 1})
    print({1, 2, 3} == {3, 2, 1})
    print({1, 2, 3} == {3, 2})
    print({1, 2} == {1, 2, 3})
    print({1, 2} != {1, 2})
    print(Map[int, int]() == Map[int, int]())
    print(Set[int]() == Set[int]())
    mut c := {"k": 1, "j": 2, "i": 3}
    c.remove("j")
    print(c == {"k": 1, "i": 3})
    print({"a": 1.5} == {"a": 1.5})
    print({"a": 1.5} == {"a": 2.5})
    print({"a": {1, 2}} == {"a": {2, 1}})
    print({"a": {1, 2}} == {"a": {2, 3}})
    print({"a": [1, 2]} == {"a": [1, 2]})
    print({"a": [1, 2]} == {"a": [2, 1]})
    print({1: {"p": {1: 1}}} == {1: {"p": {1: 1}}})
    print({1: {"p": {1: 1}}} == {1: {"p": {1: 2}}})
    h1 := Holder(m: {"q": 1}, s: {1, 2})
    h2 := Holder(m: {"q": 1}, s: {2, 1})
    h3 := Holder(m: {"q": 2}, s: {2, 1})
    print(h1 == h2)
    print(h1 == h3)
    print(E.A(m: {1: 2}) == E.A(m: {1: 2}))
    print(E.A(m: {1: 2}) == E.A(m: {1: 3}))
    print(E.B == E.B)
    print([{1: 1}, {2: 2}] == [{1: 1}, {2: 2}])
    print([{1: 1}, {2: 2}] == [{1: 1}, {2: 3}])
    print({"s": "x"} == {"s": "x"})
    print({"s": "x"} == {"s": "y"})
    print({1: true} == {1: true})
    print({'a': 1} == {'a': 1})
