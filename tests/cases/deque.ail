# Deque[T] (type.deque.1-5, ADR 1086) against a list, on pseudo-random operations.
fn lcg(s int) int
    (s * 1103515245 + 12345) % 2147483648

fn main()
    mut seed := 7
    mut bad := 0
    mut d := Deque[int]()
    mut model := List[int]()
    for step in 0..2000
        seed = lcg(seed)
        op := seed / 65536 % 6
        if op == 0 or op == 1
            d.push_back(step)
            model.push(step)
        elif op == 2 or op == 3
            d.push_front(step)
            mut next := [step]
            next.extend(model)
            model = next
        elif op == 4
            got := d.pop_back()
            want := model.pop()
            if got != want
                bad += 1
        else
            got := d.pop_front()
            if model.is_empty()
                if got != none
                    bad += 1
            else
                if got != model[0]
                    bad += 1
                model = model[1..]
        if d.len() != model.len() or d.is_empty() != model.is_empty()
            bad += 1
        if d.first() != model.first() or d.last() != model.last()
            bad += 1
        if step % 100 == 0
            if d.to_list() != model
                bad += 1
            for i in 0..model.len()
                if d[i] != model[i] or d.at(i) != model[i]
                    bad += 1
            mut seen := List[int]()
            for x in d
                seen.push(x)
            if seen != model or d.len() != model.len()
                bad += 1
    print("bad {bad}")
    e := Deque.from([1, 2, 3])
    print(e.to_list())
    print(e.at(2))
    mut c := e
    c.push_front(0)
    print("{e.len()} {c.len()}")
    mut none_left := Deque[str]()
    print(none_left.pop_front())
    print(none_left.pop_back())
    mut w := Deque.from([1, 2, 3])
    w.set(0, 9)
    w.push_front(0)
    mut sum := 0
    for x in w
        sum += x * 10
    print("{w[1]} {w[3]} {sum} {w.len()}")
