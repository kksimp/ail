use std.ui

fn button_name(b ui.MouseButton) str
    match b
        Left => "left"
        Middle => "middle"
        Right => "right"

fn mouse_kind(k ui.MouseKind) str
    match k
        Down => "down"
        Up => "up"
        Drag => "drag"

fn main()
    mut w := ui.open("T", 30, 10) else err
        print("no window: {err.kind}")
        return
    print("size {w.size().cols}x{w.size().rows}")
    w.clear(0x202020)
    w.put(1, 1, "hi", 0xFFFFFF, 0x202020)
    w.present()
    while true
        match w.next_event()
            Key(k, c, a, s) => print("key {k.name()} {c} {a} {s}")
            Mouse(c, r, b, k) => print("mouse {c},{r} {button_name(b)} {mouse_kind(k)}")
            Scroll(n) => print("scroll {n}")
            Resize(c, r) => print("resize {c}x{r}")
            Close =>
                print("close")
                break
        w.present()
    print(w.size().cols)
