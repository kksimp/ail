fn check_all(names List[str]) ! str
    fn first(xs List[str]) str
        for x in xs
            if not x.is_empty()
                return x
        return "none"
    if names.is_empty()
        return "no names"
    print("first {first(names)}")

fn main()
    check_all(["", "ann"]) else e
        print("error: {e}")
