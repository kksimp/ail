fn pad(a int, b int) str
    "{a}-{b}"

fn code(a int, b int, u str?, m Map[str, int]) ! str
    if a == 0
        return "unknown {u else ""}"
    if a == 1
        return "sum {a + b}"
    if a == 2
        return "n {pad(a, b)} {m["k"]}"
    print("ok")

fn main()
    m := Map[str, int]()
    code(0, 1, none, m) else e
        print("error: {e}")
