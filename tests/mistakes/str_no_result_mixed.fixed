fn tokenize(line str) List[str] ! str
    if line.trim().is_empty()
        return "empty line"
    line.split(" ")

fn eval(toks List[str]) int ! str
    n := toks[0].to_int() else return "not a number: {toks[0]}"
    n

fn run_line(line str) ! Fail
    toks := tokenize(line)?
    v := eval(toks)?
    if v < 0
        return Fail(msg: "negative")
    print(v)

fn main()
    run_line("12 x") else e
        print("error: {e}")
    run_line("") else e
        print("error: {e}")
