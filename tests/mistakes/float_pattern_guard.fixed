enum Expr
    Lit(v float)
    Neg(x Expr)
    Bin(op char, l Expr, r Expr)

@allow("expr.match.3") fn weight(e Expr) int
    match e
        Bin('*', Lit(fv), x) if fv == 1.0 => weight(x)
        Bin('+', Lit(fv), x) if fv == 0.0 => weight(x)
        Neg(x) => 1 + weight(x)
        _ => 0

fn main()
    e := Expr.Bin(op: '*', l: Expr.Lit(v: 1.0), r: Expr.Neg(x: Expr.Lit(v: 2.0)))
    print(weight(e))
