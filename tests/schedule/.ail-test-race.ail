use std.env
use std.io
# conc.sched.1-2: a lost update that only some interleavings show.

fn inc(c Atomic[int])
    v := c.load()
    c.store(v + 1)

fn no_lost_update() !
    c := Atomic(0)
    g := TaskGroup()
    g.add(spawn inc(c))
    g.add(spawn inc(c))
    g.wait_all()?
    assert_eq(c.load(), 2)

fn main()
    args := env.args()
    k := args[0].len()
    if k == 1
        no_lost_update() else err
            io.eprint("error: {err}")
            io.exit(1)
        io.exit(0)
    io.exit(4)
