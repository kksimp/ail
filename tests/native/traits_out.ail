# The edges of traits in the native subset (ADR 0616): structs and primitives
# convert to `any Trait`, an enum doesn't yet.
trait Named
    fn name(self) str

struct Cat
    lives int

enum Color
    Red
    Blue

impl Named for Cat
    fn name(self) str
        "cat"

impl Named for Color
    fn name(self) str
        "color"

fn show(n any Named) str
    n.name()

fn echo(n any Named) any Named
    n

fn main()
    print(show(Cat(lives: 9)))
    print(show(Color.Red))
    print(echo(Cat(lives: 2)))
