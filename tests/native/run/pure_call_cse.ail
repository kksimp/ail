fn small(a int, b int) int
    if a > b
        return a - b
    b - a

fn heavy(n int) int
    mut s := 0
    mut i := 0
    while i < n
        s = (s + small(i * 3, s)) % 1000003
        i += 1
    s

fn peek(xs List[int], k int) int
    small(xs[k], 0) + 1

fn twice(n int) int
    heavy(n) + heavy(n)

fn in_loop(n int) int
    mut t := 0
    for i in 0..n
        t += heavy(300) % 7 + i
    t

fn after_write() int
    mut xs := [1, 2, 3]
    a := peek(xs, 1)
    xs[1] = 40
    b := peek(xs, 1)
    a * 100 + b

fn branches(c bool) int
    if c
        return heavy(50) + heavy(50)
    heavy(50)

fn main()
    print(twice(1000))
    print(in_loop(0))
    print(in_loop(25))
    print(after_write())
    print(branches(true))
    print(branches(false))
