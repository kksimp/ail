fn main()
    zero := 0.0
    inf := 1.0 / zero
    nan := zero / zero
    print(zero.sin())
    print((-zero).sin())
    print(inf.sin())
    print(nan.cos())
    print(inf.exp())
    print((-inf).exp())
    print((-inf).atan())
    print(zero.ln())
    print((-1.0).ln())
    print(inf.log10())
    print((-inf).cbrt())
    print(zero.atan2(-1.0))
    print((-zero).atan2(-1.0))
    print(nan.pow(0.0))
    print(1.0.pow(nan))
    print((-1.0).pow(inf))
    print(0.5.pow(-inf))
    print(2.0.pow(-inf))
    print((-2.0).pow(0.5))
    print(inf.hypot(nan))
    print(3.0.hypot(-4.0))
