# Traits in native code (ADR 0536): `impl` methods are methods of their
# type, a trait's default methods are copied to each type that doesn't
# define them, and a bounded generic calls the concrete type's methods.
trait Shape
    fn area(self) int
    fn name(self) str
    fn score(self) int
        area() * 100 + name().len()

struct Circle
    r int

struct Rect
    w int
    h int

enum Blob
    Dot
    Line(len int)

impl Shape for Circle
    fn area(self) int
        3 * r * r
    fn name(self) str
        "circle"

impl Shape for Rect
    fn area(self) int
        w * h
    fn name(self) str
        if w == h then "square" else "rectangle"
    fn score(self) int
        -area()

impl Shape for Blob
    fn area(self) int
        match self
            Dot => 0
            Line(n) => n
    fn name(self) str
        "blob"

fn total[T Shape](xs List[T]) int
    mut sum := 0
    for x in xs
        sum += x.area()
    sum

fn label[T Shape](x T) str
    print(x.score())
    x.name()

fn largest[T Ord](items List[T]) T
    mut best := items[0]
    for x in items
        if x > best
            best = x
    best

fn main()
    print(Circle(r: 2).score())
    print(Rect(w: 3, h: 3).score())
    print(total([Rect(w: 1, h: 2), Rect(w: 3, h: 4)]))
    print(total([Circle(r: 1)]))
    print(label(Blob.Line(7)))
    print(label(Blob.Dot))
    print(largest([3, 9, 4]))
    print(largest([2.5, 1.5]))
