# An index that is a constant, or a variable that only ever holds constants,
# is in bounds when at least that many pushes came first (native.bce.4); the
# other cases keep their check.
fn tally(n int) List[int]
    mut counts := [0, 0, 0, 0]
    for i in 0..n
        mut k := 3
        if i % 5 == 0
            k = 0
        elif i % 3 == 0
            k = 1
        elif i % 2 == 0
            k = 2
        counts[k] += 1
    counts

fn pick(n int) int
    mut xs := []
    xs.push(10)
    xs.push(20)
    mut k := 1
    if n > 0
        k = 0
    xs[k]

fn fixed() int
    mut xs := []
    xs.push(1)
    xs.push(2)
    xs.push(3)
    xs[0] + xs[1] + xs[2]

fn main()
    print(tally(100))
    print(pick(0))
    print(pick(5))
    print(fixed())
