## Collections in which most pages hold nothing live (ADR 0562): short-lived
## strings made between long-lived ones. The sweep frees the dead pages
## without reading them; every kept string must still be whole afterwards.
fn main()
    mut kept := List[str]()
    mut sum := 0
    for i in 0..3000000
        s := "item {i} of the churn"
        if i % 5000 == 0
            kept.push(s)
        sum += s.len()
    mut ok := 0
    for k in 0..kept.len()
        if kept[k] == "item {k * 5000} of the churn"
            ok += 1
    print("{kept.len()} {ok} {sum}")
