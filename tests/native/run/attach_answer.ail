use std.attach
use std.screen

fn ask(tr attach.Tracker, s screen.Screen, q str) str
    attach.answer(q, "t0k", tr, s, "")

fn main()
    mut tr := attach.Tracker.new()
    tr.update([attach.observed("total", "int", "3"), attach.observed("name", "str", "\"tea\"")])
    s := screen.Screen(w: 100.0, h: 100.0, items: [screen.item(1, "button", "Pay", 0xcc2222, 10.0, 10.0, 80.0, 30.0)])
    tok := "t0k"
    assert_eq(ask(tr, s, "\{\"q\":\"observe\",\"token\":\"t0k\"}"), "\{\"v\":1,\"rev\":1,\"values\":\{\"total\":3,\"name\":\"tea\"}}")
    assert_eq(ask(tr, s, "\{\"q\":\"observe\",\"token\":\"t0k\",\"names\":[\"total\"]}"), "\{\"v\":1,\"rev\":1,\"values\":\{\"total\":3}}")
    assert_eq(ask(tr, s, "\{\"q\":\"observe\"}"), "\{\"v\":1,\"error\":\"missing or wrong token\"}")
    assert(ask(tr, s, "\{\"q\":\"set\",\"token\":\"t0k\"}").contains("all of them only read"))
    assert(ask(tr, s, "not json").contains("not JSON"))
    tr.update([attach.observed("total", "int", "4"), attach.observed("name", "str", "\"tea\"")])
    assert_eq(tr.observe([], 1), "\{\"v\":1,\"rev\":2,\"values\":\{\"total\":4}}")
    assert_eq(tr.observe([], 2), "\{\"v\":1,\"rev\":2,\"values\":\{}}")
    tr.update([attach.observed("total", "int", "4"), attach.observed("name", "str", "\"tea\"")])
    assert_eq(tr.rev, 2)
    shown := attach.answer("\{\"q\":\"screen\",\"token\":\"t0k\",\"role\":\"button\"}", tok, tr, s, "")
    assert(shown.contains("button 'Pay', red"))
    assert(attach.answer("\{\"q\":\"heap\",\"token\":\"t0k\"}", tok, tr, s, "").contains("no heap summary"))
    assert(attach.answer("\{\"q\":\"heap\",\"token\":\"t0k\"}", tok, tr, s, "live 12").contains("live 12"))
    print("ok")
