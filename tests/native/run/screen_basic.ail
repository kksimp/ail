use std.screen

fn main()
    mut s := screen.Screen(w: 800.0, h: 600.0, items: [])
    mut pay := screen.item(1, "button", "Submit", 0xcc2222, 412.0, 300.0, 100.0, 32.0)
    pay.href = "/pay"
    pay.focused = true
    s.items.push(pay)
    s.items.push(screen.item(2, "text", "Total: 5", 0x202020, 20.0, 20.0, 200.0, 16.0))
    s.items.push(screen.item(3, "button", "Cancel", 0x5a5a5a, 300.0, 300.0, 80.0, 32.0))
    print(s.what_is_at(420.0, 310.0))
    print(s.what_is_at(0.0, 0.0))
    print(s.find("button", "", "", 0))
    print(s.find("", "red", "", 0))
    print(s.find("", "", "total", 0))
    print(s.describe(0.0, 0.0, 800.0, 100.0, 0))
    print(s.find("", "", "", 6))
    mut t := screen.Screen(w: 800.0, h: 600.0, items: [s.items[0], s.items[1]])
    t.items[1].text = "Total: 6"
    t.items.push(screen.item(9, "image", "", 0x2255cc, 0.0, 400.0, 50.0, 50.0))
    print(t.changes_since(s, 0))
    print(t.changes_since(t, 0))
    for c in [0x000000, 0xffffff, 0xff0000, 0x8b0000, 0x00ff00, 0x006400, 0x0000ff, 0xffa500, 0x8b4513, 0xffc0cb, 0x808080, 0x800080]
        print(screen.color_name(c))
