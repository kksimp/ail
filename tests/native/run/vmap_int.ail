# Element-wise `int` loops in lanes (native.vec.6): checked add and subtract, the bitwise
# operations, a constant and a value from before the loop as the other operand, a list read and
# written in place, a comprehension, every length from 0 to 17, and values next to the ends of
# the range that must not trap.
fn sum2(mut c List[int], a List[int], b List[int])
    for i in 0..a.len()
        c[i] = a[i] + b[i]

fn diff_k(mut c List[int], a List[int], k int)
    for i in 0..a.len()
        c[i] = a[i] - k

fn bits(mut c List[int], a List[int], b List[int], m int)
    for i in 0..a.len()
        c[i] = (a[i] & m) | (b[i] ^ 85)

fn bump(mut xs List[int])
    for i in 0..xs.len()
        xs[i] = xs[i] + 1

fn chain(mut c List[int], a List[int], b List[int], n int)
    for i in 0..n
        t := a[i] - b[i]
        c[i] = t + a[i] + 7

fn made(a List[int], b List[int]) List[int]
    [a[i] - b[i] for i in 0..a.len()]

fn run(n int)
    a := [x * 37 - 100 for x in 0..n]
    b := [1000 - x * x * 3 for x in 0..n]
    mut c := [0 for _ in 0..n]
    sum2(mut c, a, b)
    print("n {n} sum2 {c}")
    diff_k(mut c, a, 12345)
    print("n {n} diff {c}")
    bits(mut c, a, b, 1023)
    print("n {n} bits {c}")
    bump(mut c)
    print("n {n} bump {c}")
    mut d := [9 for _ in 0..n]
    chain(mut d, a, b, n)
    print("n {n} chain {d}")
    print("n {n} made {made(a, b)}")
    mut e := a
    sum2(mut e, a, a)
    print("n {n} self {e}")

fn main()
    for n in 0..18
        run(n)
    top := 9223372036854775807
    low := 0 - top - 1
    edge := [top, low, top - 1, low + 1, 0, -1, 1, top, low, 5, top - 5]
    other := [0, 0, 1, -1, top, top, low, low + top, top, top - 5, 5]
    mut out := [0 for _ in 0..edge.len()]
    sum2(mut out, edge, other)
    print(out)
    diff_k(mut out, [low, low + 1, 0, top, top - 1, -1, 1, low, 3, 4, 5], 0)
    print(out)
    mut big := [x for x in 0..1003]
    bump(mut big)
    mut s := 0
    for x in big
        s += x
    print("sum {s}")
