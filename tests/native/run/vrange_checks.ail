# Function-wide value ranges (native.range.1-3, ADR 1063): the checks the
# ranges rule out are gone and the comparisons they decide are folded; every
# result is the same as with AIL_OPT_OFF=vrange.

# Bytes: every product and sum below fits, so none is checked.
fn hash3(a int, b int, c int) int
    x := a.bit_and(255)
    y := b.bit_and(255)
    z := c.bit_and(255)
    (x * 65536 + y * 256 + z) * 2654435761

# A counter below `n` stepping by a constant can't overflow.
fn steps3(n int) int
    mut i := 0
    mut k := 0
    while i < n
        i += 3
        k += 1
    k + i

# Counting down from a length to 0: `j + 1` and `j - 1` can't overflow.
fn down(xs List[int]) int
    mut j := xs.len() - 1
    mut s := 0
    while j >= 0
        s += xs[j] * (j + 1)
        j -= 1
    s

# A value never negative: `/ 4` and `% 8` are a shift and a mask.
fn halves(n int) int
    m := n.bit_and(1023)
    m / 4 + m % 8

# `m < 16` always holds.
fn decided(n int) int
    m := n.bit_and(15)
    if m < 16
        return m + 100
    0 - 1

# The count is within 0..=31, so the shift isn't checked.
fn shifted(n int, k int) int
    n.bit_and(65535).shl(k.bit_and(31))

# `n % 1000` is within -999..=999, so its negation can't overflow.
fn negs(n int) int
    m := n % 1000
    0 - m

fn main()
    print(hash3(1, 2, 3))
    print(hash3(300, 255, 511))
    print(steps3(10))
    print(steps3(0))
    print(down([5, 6, 7]))
    print(halves(1037))
    print(halves(-5))
    print(decided(47))
    print(shifted(70000, 33))
    print(negs(-123456))
