# Binary reads on `bytes` and pushes onto a `List[u8]` (type.bytes.15-18).
fn main()
    mut xs := List[u8]()
    xs.push_u8(255)
    xs.push_i8(-2)
    xs.push_u16_le(513)
    xs.push_u16_be(513)
    xs.push_i16_le(-300)
    xs.push_i16_be(-300)
    xs.push_u32_le(4000000000)
    xs.push_u32_be(305419896)
    xs.push_i32_le(-123456789)
    xs.push_i32_be(-1)
    xs.push_i64_le(-9000000000000)
    xs.push_i64_be(81985529216486895)
    top := 9223372036854775807
    xs.push_u64_le(top.to_u64() * 2 + 1)
    xs.push_u64_be(1)
    xs.push_f32_le(1.5)
    xs.push_f32_be(-2.25)
    xs.push_f64_le(0.5)
    xs.push_f64_be(-1024.75)
    xs.push_bytes(b"ok")
    xs.push_bytes(b"")
    xs.push_uvarint(0)
    xs.push_uvarint(300)
    xs.push_uvarint(9223372036854775807)
    b := bytes.from_list(xs)
    print(b.len())
    print(b[..10].hex())
    print(b.u8(0))
    print(b.i8(1))
    print(b.u8(1))
    print(b.u16_le(2))
    print(b.u16_be(4))
    print(b.u16_le(4))
    print(b.i16_le(6))
    print(b.i16_be(8))
    print(b.u16_le(6))
    print(b.u32_le(10))
    print(b.i32_le(10))
    print(b.u32_be(14))
    print(b.u32_le(14))
    print(b.i32_le(18))
    print(b.i32_be(22))
    print(b.u32_be(22))
    print(b.i64_le(26))
    print(b.i64_be(34))
    print(b.u64_le(42))
    print(b.i64_le(42))
    print(b.u64_be(50))
    print(b.u64_le(50))
    print(b.f32_le(58))
    print(b.f32_be(62))
    print(b.f64_le(66))
    print(b.f64_be(74))
    print(b[82..84].text())
    mut at := 84
    while at < b.len()
        p := b.uvarint(at) else (-1, 0)
        print("{p.0} {p.1}")
        at += p.1
    print(b.uvarint(b.len()) == none)
    print(b"\x80".uvarint(0) == none)
    print(b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01".uvarint(0) == none)
    print(b"\xff\xff\xff\xff\xff\xff\xff\xff\x7f".uvarint(0) else (0, 0))
    mut sum := 0
    for i in 0..10
        sum += b.u32_le(i)
    print(sum)
