# List ordering: `<`, `cmp`, and sorted, min, max, contains on lists of lists (type.coll.11, type.num.11).
fn main()
    inf := 1.0 / 0.0
    nan := inf - inf
    print([1, 2] < [1, 3])
    print([1, 2] <= [1, 2])
    print([2] > [1, 9])
    print([1, 2, 0] >= [1, 2])
    print(List[int]() < [0])
    print(["b", "a"] < ["b", "b"])
    print([1.0, nan] < [1.0, nan])
    print([1.0, nan] <= [1.0, nan])
    print([nan] < [1.0])
    print([1.0] < [1.0, nan])
    print([-0.0] <= [0.0])
    print([0.0] < [-0.0])
    print([1, 2].cmp([1, 3]))
    print([1.0, nan].cmp([1.0, nan]))
    print(["a"].cmp(["a"]))
    print(['b', 'a'].cmp(['b']))
    xs := [[1.0, nan], [1.0, 2.0], [0.5, nan], [1.0]]
    print(xs.sorted())
    print(xs.max())
    print(xs.min())
    print(xs.contains([1.0, 2.0]))
    print(xs.contains([2.0]))
    print([[3, 1], [2], [3]].sorted())
    print([["b"], ["a", "z"], ["a"]].max())
