# One row is shorter than the others: the trap names `b[k][j]` (type.coll.4).
fn column(b List[List[int]], j int, n int) int
    mut total := 0
    for i in 0..2
        for k in 0..n
            total += b[k][j]
    total

fn main()
    print(column([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 2, 3))
    print(column([[1, 2, 3], [4, 5], [7, 8, 9]], 2, 3))
