# More sized integers in containers: sets, map printing, nested lists, comparisons, optional fields.
struct Cell
    v u8?
    w List[i16]

fn main()
    s := {3.to_u8(), 1.to_u8(), 3.to_u8()}
    print(s.len())
    print(s.contains(1.to_u8()))
    m := {7.to_i32(): "a", (0 - 2).to_i32(): "b"}
    print(m)
    print(m.get(7.to_i32()) else "none")
    rows := [[1.to_u8(), 2.to_u8()], [3.to_u8()]]
    print(rows)
    print(rows[0][1])
    print(rows[0] == [1.to_u8(), 2.to_u8()])
    print([1.to_i8(), 2.to_i8()] == [1.to_i8(), 3.to_i8()])
    c := Cell(v: 5.to_u8(), w: [(0 - 1).to_i16(), 2.to_i16()])
    print(c.v else 0.to_u8())
    print(c.w)
    d := Cell(v: none, w: [])
    print(d.v else 9.to_u8())
    sq := [x * x for x in [1, 2, 3]]
    print(sq)
    u := [x.to_u8() for x in sq]
    print(u)
    mut counts := {1.to_u8(): 0}
    counts[1.to_u8()] = 5
    print(counts[1.to_u8()])
    print(u[1..3])
    print("{u} and {s.len()}")
    for x in u
        print(x)
    neg := [(0 - 3).to_i16(), 5.to_i16(), (0 - 9).to_i16()]
    print(neg.sorted())
    print(neg.min() else 0.to_i16())
    print(neg.max() else 0.to_i16())
