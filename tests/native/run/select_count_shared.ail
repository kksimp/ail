# Counts in one function whose selects keep the counter's register (the
# x86-64 `cmov` form, native.select.1, ADR 1141 as amended 2026-11-18): a
# count moves only when its condition holds. Also run with
# AIL_OPT_OFF=selsum, which gives `select c, n, n` plus 1 on one side.
fn main()
    mut bad := 0
    mut hits := 0
    mut seed := 7
    for r in 0..60
        seed = (seed * 1103515245 + 12345) % 2147483648
        a := seed % 17
        b := a + r % 3
        if a > b
            bad += 1
        if a + 1 != b + 1 and r % 3 == 0
            bad += 1
        if b - a != r % 3
            bad += 1
        if r % 7 == 0
            hits += 1
        if a == b
            continue
        hits += 1
    print("bad {bad} hits {hits}")
