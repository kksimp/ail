# `compress.inflate` fails with: compress.CompressError(kind: compress.CompressKind.Corrupt, message: "over-subscribed Huffman code")
use std.compress

fn main() !
    d := compress.inflate(b"\x9c\x48\xcd\xc9\xc9\x57\x28\xcf\x2f\xca\x49\x51\xc8\x18\x65\x8f\xb2\x47\xd9\xa3\xec\x51\xf6\x28\x7b\x94\x3d\xca\x1e\x65\x53\xcc\x06\x00")?
    print(d.len())
