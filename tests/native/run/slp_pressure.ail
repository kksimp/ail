# Thirty-two pairs live at once (native.vec.3), more than the float registers, so
# some two-lane vectors spill to their two stack slots and come back.
fn press(mut s List[float], m float)
    x0 := s[0] * m + 0.0
    y0 := s[1] * m + 0.0
    x1 := s[2] * m + 1.0
    y1 := s[3] * m + 1.0
    x2 := s[4] * m + 2.0
    y2 := s[5] * m + 2.0
    x3 := s[6] * m + 3.0
    y3 := s[7] * m + 3.0
    x4 := s[8] * m + 4.0
    y4 := s[9] * m + 4.0
    x5 := s[10] * m + 5.0
    y5 := s[11] * m + 5.0
    x6 := s[12] * m + 6.0
    y6 := s[13] * m + 6.0
    x7 := s[14] * m + 7.0
    y7 := s[15] * m + 7.0
    x8 := s[16] * m + 8.0
    y8 := s[17] * m + 8.0
    x9 := s[18] * m + 9.0
    y9 := s[19] * m + 9.0
    x10 := s[20] * m + 10.0
    y10 := s[21] * m + 10.0
    x11 := s[22] * m + 11.0
    y11 := s[23] * m + 11.0
    x12 := s[24] * m + 12.0
    y12 := s[25] * m + 12.0
    x13 := s[26] * m + 13.0
    y13 := s[27] * m + 13.0
    x14 := s[28] * m + 14.0
    y14 := s[29] * m + 14.0
    x15 := s[30] * m + 15.0
    y15 := s[31] * m + 15.0
    x16 := s[32] * m + 16.0
    y16 := s[33] * m + 16.0
    x17 := s[34] * m + 17.0
    y17 := s[35] * m + 17.0
    x18 := s[36] * m + 18.0
    y18 := s[37] * m + 18.0
    x19 := s[38] * m + 19.0
    y19 := s[39] * m + 19.0
    x20 := s[40] * m + 20.0
    y20 := s[41] * m + 20.0
    x21 := s[42] * m + 21.0
    y21 := s[43] * m + 21.0
    x22 := s[44] * m + 22.0
    y22 := s[45] * m + 22.0
    x23 := s[46] * m + 23.0
    y23 := s[47] * m + 23.0
    x24 := s[48] * m + 24.0
    y24 := s[49] * m + 24.0
    x25 := s[50] * m + 25.0
    y25 := s[51] * m + 25.0
    x26 := s[52] * m + 26.0
    y26 := s[53] * m + 26.0
    x27 := s[54] * m + 27.0
    y27 := s[55] * m + 27.0
    x28 := s[56] * m + 28.0
    y28 := s[57] * m + 28.0
    x29 := s[58] * m + 29.0
    y29 := s[59] * m + 29.0
    x30 := s[60] * m + 30.0
    y30 := s[61] * m + 30.0
    x31 := s[62] * m + 31.0
    y31 := s[63] * m + 31.0
    s[0] = x0 * x31
    s[1] = y0 * y31
    s[2] = x1 * x30
    s[3] = y1 * y30
    s[4] = x2 * x29
    s[5] = y2 * y29
    s[6] = x3 * x28
    s[7] = y3 * y28
    s[8] = x4 * x27
    s[9] = y4 * y27
    s[10] = x5 * x26
    s[11] = y5 * y26
    s[12] = x6 * x25
    s[13] = y6 * y25
    s[14] = x7 * x24
    s[15] = y7 * y24
    s[16] = x8 * x23
    s[17] = y8 * y23
    s[18] = x9 * x22
    s[19] = y9 * y22
    s[20] = x10 * x21
    s[21] = y10 * y21
    s[22] = x11 * x20
    s[23] = y11 * y20
    s[24] = x12 * x19
    s[25] = y12 * y19
    s[26] = x13 * x18
    s[27] = y13 * y18
    s[28] = x14 * x17
    s[29] = y14 * y17
    s[30] = x15 * x16
    s[31] = y15 * y16
    s[32] = x16 * x15
    s[33] = y16 * y15
    s[34] = x17 * x14
    s[35] = y17 * y14
    s[36] = x18 * x13
    s[37] = y18 * y13
    s[38] = x19 * x12
    s[39] = y19 * y12
    s[40] = x20 * x11
    s[41] = y20 * y11
    s[42] = x21 * x10
    s[43] = y21 * y10
    s[44] = x22 * x9
    s[45] = y22 * y9
    s[46] = x23 * x8
    s[47] = y23 * y8
    s[48] = x24 * x7
    s[49] = y24 * y7
    s[50] = x25 * x6
    s[51] = y25 * y6
    s[52] = x26 * x5
    s[53] = y26 * y5
    s[54] = x27 * x4
    s[55] = y27 * y4
    s[56] = x28 * x3
    s[57] = y28 * y3
    s[58] = x29 * x2
    s[59] = y29 * y2
    s[60] = x30 * x1
    s[61] = y30 * y1
    s[62] = x31 * x0
    s[63] = y31 * y0

fn main()
    mut s := [i.to_float() * 0.125 - 3.0 for i in 0..64]
    press(mut s, 1.5)
    print(s)
    press(mut s, -0.5)
    print(s)
