# slp-expect: pairs
# Thirty-two pairs live at once in a loop bce versions (native.vec.3), more than the
# float registers, so some two-lane vectors spill to their two stack slots and come back.
fn press(mut s List[float], n int, m float)
    for r in 0..n
        b := r * 64
        x0 := s[b] * m + 0.0
        y0 := s[b + 1] * m + 0.0
        x1 := s[b + 2] * m + 1.0
        y1 := s[b + 3] * m + 1.0
        x2 := s[b + 4] * m + 2.0
        y2 := s[b + 5] * m + 2.0
        x3 := s[b + 6] * m + 3.0
        y3 := s[b + 7] * m + 3.0
        x4 := s[b + 8] * m + 4.0
        y4 := s[b + 9] * m + 4.0
        x5 := s[b + 10] * m + 5.0
        y5 := s[b + 11] * m + 5.0
        x6 := s[b + 12] * m + 6.0
        y6 := s[b + 13] * m + 6.0
        x7 := s[b + 14] * m + 7.0
        y7 := s[b + 15] * m + 7.0
        x8 := s[b + 16] * m + 8.0
        y8 := s[b + 17] * m + 8.0
        x9 := s[b + 18] * m + 9.0
        y9 := s[b + 19] * m + 9.0
        x10 := s[b + 20] * m + 10.0
        y10 := s[b + 21] * m + 10.0
        x11 := s[b + 22] * m + 11.0
        y11 := s[b + 23] * m + 11.0
        x12 := s[b + 24] * m + 12.0
        y12 := s[b + 25] * m + 12.0
        x13 := s[b + 26] * m + 13.0
        y13 := s[b + 27] * m + 13.0
        x14 := s[b + 28] * m + 14.0
        y14 := s[b + 29] * m + 14.0
        x15 := s[b + 30] * m + 15.0
        y15 := s[b + 31] * m + 15.0
        x16 := s[b + 32] * m + 16.0
        y16 := s[b + 33] * m + 16.0
        x17 := s[b + 34] * m + 17.0
        y17 := s[b + 35] * m + 17.0
        x18 := s[b + 36] * m + 18.0
        y18 := s[b + 37] * m + 18.0
        x19 := s[b + 38] * m + 19.0
        y19 := s[b + 39] * m + 19.0
        x20 := s[b + 40] * m + 20.0
        y20 := s[b + 41] * m + 20.0
        x21 := s[b + 42] * m + 21.0
        y21 := s[b + 43] * m + 21.0
        x22 := s[b + 44] * m + 22.0
        y22 := s[b + 45] * m + 22.0
        x23 := s[b + 46] * m + 23.0
        y23 := s[b + 47] * m + 23.0
        x24 := s[b + 48] * m + 24.0
        y24 := s[b + 49] * m + 24.0
        x25 := s[b + 50] * m + 25.0
        y25 := s[b + 51] * m + 25.0
        x26 := s[b + 52] * m + 26.0
        y26 := s[b + 53] * m + 26.0
        x27 := s[b + 54] * m + 27.0
        y27 := s[b + 55] * m + 27.0
        x28 := s[b + 56] * m + 28.0
        y28 := s[b + 57] * m + 28.0
        x29 := s[b + 58] * m + 29.0
        y29 := s[b + 59] * m + 29.0
        x30 := s[b + 60] * m + 30.0
        y30 := s[b + 61] * m + 30.0
        x31 := s[b + 62] * m + 31.0
        y31 := s[b + 63] * m + 31.0
        s[b] = x0 * x31
        s[b + 1] = y0 * y31
        s[b + 2] = x1 * x30
        s[b + 3] = y1 * y30
        s[b + 4] = x2 * x29
        s[b + 5] = y2 * y29
        s[b + 6] = x3 * x28
        s[b + 7] = y3 * y28
        s[b + 8] = x4 * x27
        s[b + 9] = y4 * y27
        s[b + 10] = x5 * x26
        s[b + 11] = y5 * y26
        s[b + 12] = x6 * x25
        s[b + 13] = y6 * y25
        s[b + 14] = x7 * x24
        s[b + 15] = y7 * y24
        s[b + 16] = x8 * x23
        s[b + 17] = y8 * y23
        s[b + 18] = x9 * x22
        s[b + 19] = y9 * y22
        s[b + 20] = x10 * x21
        s[b + 21] = y10 * y21
        s[b + 22] = x11 * x20
        s[b + 23] = y11 * y20
        s[b + 24] = x12 * x19
        s[b + 25] = y12 * y19
        s[b + 26] = x13 * x18
        s[b + 27] = y13 * y18
        s[b + 28] = x14 * x17
        s[b + 29] = y14 * y17
        s[b + 30] = x15 * x16
        s[b + 31] = y15 * y16
        s[b + 32] = x16 * x15
        s[b + 33] = y16 * y15
        s[b + 34] = x17 * x14
        s[b + 35] = y17 * y14
        s[b + 36] = x18 * x13
        s[b + 37] = y18 * y13
        s[b + 38] = x19 * x12
        s[b + 39] = y19 * y12
        s[b + 40] = x20 * x11
        s[b + 41] = y20 * y11
        s[b + 42] = x21 * x10
        s[b + 43] = y21 * y10
        s[b + 44] = x22 * x9
        s[b + 45] = y22 * y9
        s[b + 46] = x23 * x8
        s[b + 47] = y23 * y8
        s[b + 48] = x24 * x7
        s[b + 49] = y24 * y7
        s[b + 50] = x25 * x6
        s[b + 51] = y25 * y6
        s[b + 52] = x26 * x5
        s[b + 53] = y26 * y5
        s[b + 54] = x27 * x4
        s[b + 55] = y27 * y4
        s[b + 56] = x28 * x3
        s[b + 57] = y28 * y3
        s[b + 58] = x29 * x2
        s[b + 59] = y29 * y2
        s[b + 60] = x30 * x1
        s[b + 61] = y30 * y1
        s[b + 62] = x31 * x0
        s[b + 63] = y31 * y0

fn main()
    mut s := [i.to_float() * 0.125 - 3.0 for i in 0..128]
    press(mut s, 2, 1.5)
    print(s)
    press(mut s, 2, -0.5)
    print(s)
