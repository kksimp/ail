fn f(n int) int
    n + 1

fn g(x float) float
    x * 2.0

fn main()
    a := f(1)
    b := f(a)
    c := f(b)
    d := f(c)
    e := f(d)
    h := f(e)
    i := f(h)
    j := f(i)
    k := f(j)
    l := f(k)
    m := f(l)
    n := f(m)
    print(a + b + c + d + e + h + i + j + k + l + m + n)
    print(a * b - c * d + e * h - i * j + k * l - m * n)
    x1 := g(1.0)
    x2 := g(x1)
    x3 := g(x2)
    x4 := g(x3)
    x5 := g(x4)
    x6 := g(x5)
    x7 := g(x6)
    x8 := g(x7)
    x9 := g(x8)
    print(x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9)
    mut s := 0
    for q in 0..10
        s += q * a - b + c * d - e
    print(s)
