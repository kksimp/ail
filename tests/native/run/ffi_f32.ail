# `f32` parameters and results of C functions (ffi.map.1): the single travels in the low half
# of the float register, and a result is widened exactly.
extern c "m" fn sqrtf(x f32) f32
extern c "m" fn fmaxf(a f32, b f32) f32
extern c "libm" fn scalbnf(x f32, e i32) f32

fn main()
    unsafe
        print(sqrtf(2.25.to_f32()).to_float())
        print(sqrtf(2.0.to_f32()).to_float())
        print(fmaxf(2.5.to_f32(), (-1.0).to_f32()).to_float())
        print(scalbnf(1.5.to_f32(), 4).to_float())
