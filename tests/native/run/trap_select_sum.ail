# A conditional sum that overflows when its condition holds still traps, and
# only then (native.select.4, expr.arith.1).
fn bump(xs List[int], start int) int
    mut n := start
    for x in xs
        if x > 0
            n += 1
    n

fn main()
    print("kept {bump([0, -1, 0], 9223372036854775807)}")
    print("near {bump([1, 0, 0], 9223372036854775806)}")
    over := bump([0, 1], 9223372036854775807)
    print("not reached {over}")
