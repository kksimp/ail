# type.str.16-18: center, words, trim_start, trim_end, count and rfind on
# ASCII and wide text, matching `ail run`.
fn show(xs List[str])
    print(xs.len())
    for x in xs
        print("[{x}]")

fn main()
    print("[{"ab".center(7, '*')}]")
    print("[{"abc".center(8, '-')}]")
    print("[{"é".center(4, 'ß')}]")
    print("[{"toolong".center(3, ' ')}]")
    print("[{"".center(3, 'x')}]")
    print("[{"x".center(0, 'x')}]")
    show("  a  b ".words())
    show("\t one\ttwo\nthree  ".words())
    show("   ".words())
    show("".words())
    show("日本\u{3000}語  é".words())
    print("[{"  x ".trim_start()}]")
    print("[{"  x ".trim_end()}]")
    print("[{"x".trim_start()}]")
    print("[{" \u{3000}日本\u{3000} ".trim_end()}]")
    print("[{" \u{3000}日本\u{3000} ".trim_start()}]")
    print("[{"   ".trim_start()}]")
    print("[{"   ".trim_end()}]")
    print("abababa".count("aba"))
    print("aaaa".count("aa"))
    print("héllo héllo".count("é"))
    print("abc".count("z"))
    print("".count("a"))
    print("a/b/c".rfind("/") else -1)
    print("abababa".rfind("aba") else -1)
    print("héllo é".rfind("é") else -1)
    print("abc".rfind("z") else -1)
    print("abc".rfind("") else -1)
    print("".rfind("") else -1)
    print("日本語日本".rfind("日本") else -1)
