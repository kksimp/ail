    print("inflate level 0: {r0.len()} {r0.hex() == ""}")
    r1 := compress.inflate(b"\x4b\x4c\x4a\x56\x48\x49\x4d\x53\x48\x1c\xa5\x47\xc3\x61\x00\xd2\x41\x55\x55\x15\x00") else b""
    print("inflate level 1: {r1.len()} {r1.hex() == ""}")
