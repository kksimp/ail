    print("inflate level 9: {r9.len()} {r9.hex() == ""}")
    m := compress.gunzip(b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\x4b\x4c\x4a\x06\x00\xc2\x41\x24\x35\x03\x00\x00\x00\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\x4b\x49\x4d\x4b\x07\x00\x59\x8e\x6d\x3b\x04\x00\x00\x00") else b""
    print("two members: {m.text()}")
    named := compress.gunzip(b"\x1f\x8b\x08\x08\x00\x00\x00\x00\x00\x03\x6e\x61\x6d\x65\x2e\x74\x78\x74\x00\xab\x50\xc8\x4d\x2c\xca\x2e\x06\x00\x4a\x49\x0f\xbf\x07\x00\x00\x00") else b"fallback"
    print("fname: {named.text()}")
    bad := compress.gunzip(b"plain text, not gzip at all") else b"rejected"
