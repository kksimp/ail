# std.compress: gzip, zlib and deflate write the bytes `ail run` writes; inflate, gunzip and unzlib read
# every block type and fail with the interpreter's messages (std.compress.1-4, 7-8).
use std.compress

fn main()
    text := "the quick brown fox jumps over the lazy dog, the quick brown fox"
    print(compress.gzip(text).hex())
    print(compress.zlib(text).hex())
    print(compress.deflate(text).hex())
    print(compress.deflate("").hex())
    print(compress.gzip(b"\x00\x01\x02").hex())
    mut big := ""
    for i in 0..3000
        big = "{big}line {i % 97} of the log, value {i * 7 % 13}\n"
    packed := compress.gzip(big)
    print("gzip smaller {packed.len() < big.len()}")
    back := compress.gunzip(packed) else b""
    print("round trip {back.text() == big}")
    zb := compress.unzlib(compress.zlib(big)) else b""
    print("zlib round trip {zb.text() == big}")
