# std.hash.2: SHA-256, SHA-384, SHA-512 and HMAC-SHA-256, as hex.
fn main()
    print(hash.sha256("abc"))
    print(hash.sha256(""))
    print(hash.sha256("The quick brown fox jumps over the lazy dog"))
    print(hash.sha256("0123456789012345678901234567890123456789012345678901234567890123"))
    print(hash.sha256("01234567890123456789012345678901234567890123456789012345"))
    print(hash.sha384("abc"))
    print(hash.sha384(""))
    print(hash.sha512("abc"))
    print(hash.sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"))
    print(hash.sha512("a"))
    print(hash.hmac_sha256("key", "The quick brown fox jumps over the lazy dog"))
    print(hash.hmac_sha256("", ""))
    print(hash.hmac_sha256(
        "a-very-long-key-a-very-long-key-a-very-long-key-a-very-long-key-xx",
        "data",
    ))
