# std.compress.14: `unzstd` reads RFC 8878 frames: raw, RLE and compressed blocks, Huffman
# literals (FSE-coded and direct weights), predefined, RLE and described FSE tables, repeat
# offsets, several frames with a skippable one between; and its failures (std.compress.2, 4).
use std.compress
use std.hash

## Decompress `data` and print its size and CRC-32, or the failure.
fn show(name str, data bytes)
    out := compress.unzstd(data) else err
        print("{name}: {err.message}")
        print(err.kind)
        b""
    print("{name} {out.len()} {hash.crc32(out)}")

