# std.net.http2.1-6: an h2c (prior knowledge) server from `http2.run`, driven
# by a client written over `net.Conn`: two streams answered on one
# connection, a POST body, PING, a protocol error answered with GOAWAY, an
# HTTP/1.1 request answered 505, and the server stopping with `l.close()`.
use std.net.http2

fn hello(req net.Request) net.Response
    if req.path == "/echo"
        return net.Response(
            status: 200,
            headers: {"content-type": "text/plain"},
            body: "echo {req.method} {req.body}",
        )
    who := req.query.get("name") else "world"
    host := req.headers.get("host") else "?"
    net.Response(status: 200, headers: {"x-test": "yes"}, body: "hello {who} via {host}")

PREFACE := b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

fn frame(ty int, flags int, sid int, payload bytes) bytes
    n := payload.len()
    mut h := List[u8]()
    h.push_u8((n >> 16).bit_and(255))
    h.push_u8((n >> 8).bit_and(255))
    h.push_u8(n.bit_and(255))
    h.push_u8(ty)
    h.push_u8(flags)
    h.push_u32_be(sid)
    bytes.from_list(h) + payload

fn request(method str, target str) bytes
    http2.encode([
        http2.Field(name: ":method", value: method),
        http2.Field(name: ":scheme", value: "http"),
        http2.Field(name: ":path", value: target),
        http2.Field(name: ":authority", value: "localhost"),
    ])

struct Got
    ty int
    flags int
    sid int
    data bytes

struct Client
    conn net.Conn
    buf bytes

fn Client.complete(self) bool
    if self.buf.len() < 9
        return false
    n := self.buf[0].to_int() * 65536 + self.buf[1].to_int() * 256 + self.buf[2].to_int()
    self.buf.len() >= 9 + n

## The next frame from the server; type -1 once it has closed.
fn Client.next(mut self) Got ! net.NetError
    while not self.complete()
        chunk := self.conn.read_bytes(65536)?
        if chunk.len() == 0
            return Got(ty: -1, flags: 0, sid: 0, data: b"")
        self.buf = self.buf + chunk
    n := self.buf[0].to_int() * 65536 + self.buf[1].to_int() * 256 + self.buf[2].to_int()
    g := Got(
        ty: self.buf[3].to_int(),
        flags: self.buf[4].to_int(),
        sid: self.buf.u32_be(5),
        data: self.buf[9..9 + n],
    )
    self.buf = self.buf[9 + n..self.buf.len()]
    g

fn dial(port int) Client ! net.NetError
    conn := net.connect("127.0.0.1", port)?
    conn.set_timeout(5000)
    Client(conn: conn, buf: b"")

fn main() !
    l := net.listen("127.0.0.1:0")?
    port := l.addr().split(":")[1].to_int() else 0
    server := spawn http2.run(l, hello)

    # Two requests on one connection; the second has a body.
    mut c := dial(port)?
    c.conn.write_bytes(
        PREFACE
            + frame(4, 0, 0, b"")
            + frame(1, 5, 1, request("GET", "/hi?name=ail"))
            + frame(1, 4, 3, request("POST", "/echo"))
            + frame(0, 1, 3, b"ping"),
    )?
    mut d := http2.decoder()
    mut heads := Map[int, List[str]]()
    mut bodies := Map[int, str]()
    mut ended := 0
    while ended < 2
        g := c.next()?
        if g.ty < 0
            print("closed early")
            return
        if g.ty == 1
            mut lines := List[str]()
            for f in d.decode(g.data)?
                lines.push("{f.name}: {f.value}")
            heads[g.sid] = lines
        if g.ty == 0
            prev := bodies.get(g.sid) else ""
            bodies[g.sid] = "{prev}{g.data.text()}"
        if (g.ty == 0 or g.ty == 1) and g.flags.bit_and(1) != 0
            ended += 1
    for sid in [1, 3]
        print("stream {sid}")
        for line in heads.get(sid) else List[str]()
            print("  {line}")
        got := bodies.get(sid) else ""
        print("  body: {got}")

    # PING is answered with the same eight bytes.
    c.conn.write_bytes(frame(6, 0, 0, b"abcdefgh"))?
    while true
        pg := c.next()?
        if pg.ty < 0 or (pg.ty == 6 and pg.flags == 1)
            print("ping ack {pg.data.text()}")
            break

    # HEADERS on an even stream is a connection error.
    mut bad := dial(port)?
    bad.conn.write_bytes(PREFACE + frame(4, 0, 0, b"") + frame(1, 5, 2, request("GET", "/")))?
    while true
        bg := bad.next()?
        if bg.ty < 0
            print("closed without GOAWAY")
            break
        if bg.ty == 7
            print("goaway code {bg.data.u32_be(4)}")
            break

    # An HTTP/1.1 request gets 505.
    legacy := net.connect("127.0.0.1", port)?
    legacy.set_timeout(5000)
    legacy.write("GET / HTTP/1.1\r\nHost: x\r\n\r\n")?
    mut answer := ""
    while true
        part := legacy.read(4096)?
        if part == ""
            break
        answer = "{answer}{part}"
    print(answer.split("\r\n")[0])

    # GOAWAY from the client ends its connection; close stops the server.
    c.conn.write_bytes(frame(7, 0, 0, b"\x00\x00\x00\x00\x00\x00\x00\x00"))?
    while true
        eg := c.next()?
        if eg.ty < 0
            break
    l.close()
    server.wait()?
    print("stopped")
