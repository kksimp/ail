# std.net.grpc client (std.net.70-72) against the std.net.grpc server over
# loopback h2c: unary, server streaming, client streaming, bidirectional, a
# failing call, an unknown method, metadata, trailers, and a deadline.
use std.net.grpc

fn echo(call grpc.Call) ! grpc.GrpcError
    req := call.recv()? else b""
    who := call.metadata.get("x-who") else "?"
    call.set_header("x-seen", "yes")
    call.set_trailer("x-trail", "done")
    call.send("echo:{req.text()}:{who}".to_bytes())?

fn count(call grpc.Call) ! grpc.GrpcError
    req := call.recv()? else b"0"
    n := req.text().to_int() else 0
    for i in 1..n + 1
        call.send("m{i}".to_bytes())?

fn sum(call grpc.Call) ! grpc.GrpcError
    mut total := 0
    while true
        m := call.recv()? else break
        total += m.text().to_int() else 0
    call.send("{total}".to_bytes())?

fn chat(call grpc.Call) ! grpc.GrpcError
    while true
        m := call.recv()? else break
        call.send(b"you said " + m)?

fn fail(call grpc.Call) ! grpc.GrpcError
    return grpc.status_error(grpc.Code.NotFound, "nope 100%")

fn slow(call grpc.Call) ! grpc.GrpcError
    time.sleep_ms(600)
    call.send(b"late")?

fn big(call grpc.Call) ! grpc.GrpcError
    req := call.recv()? else b""
    call.send(req)?

fn drain(c grpc.ClientCall) ! grpc.GrpcError
    mut got := List[str]()
    while true
        m := c.recv()? else break
        got.push(m.text())
    print("  got {got.join(",")}")

fn run(port int) ! grpc.GrpcError
    mut ch := grpc.connect("127.0.0.1:{port}")?
    mut o := grpc.call_options()
    o.metadata.add("x-who", "kaleb")
    print("unary {ch.unary("/t.S/Echo", b"hi", o)?.text()}")

    c := ch.start("/t.S/Echo", o)?
    c.send(b"again")?
    c.close_send()?
    print("again {(c.recv()? else b"").text()}")
    _ := c.recv()?
    print("header {c.header("x-seen") else "-"} trailer {c.trailer("x-trail") else "-"}")

    print("server streaming")
    s := ch.start("/t.S/Count", grpc.call_options())?
    s.send(b"3")?
    s.close_send()?
    drain(s)?

    print("client streaming")
    cs := ch.start("/t.S/Sum", grpc.call_options())?
    for n in ["1", "2", "39"]
        cs.send(n.to_bytes())?
    cs.close_send()?
    drain(cs)?

    print("bidi")
    bd := ch.start("/t.S/Chat", grpc.call_options())?
    bd.send(b"a")?
    print("  {(bd.recv()? else b"").text()}")
    bd.send(b"b")?
    print("  {(bd.recv()? else b"").text()}")
    bd.close_send()?
    drain(bd)?

    _ := ch.unary("/t.S/Fail", b"x", grpc.call_options()) else err
        print("fail {err.status.code.name()} {err.status.message}")
    _ := ch.unary("/t.S/Nope", b"x", grpc.call_options()) else err
        print("nope {err.status.code.name()} {err.status.message}")

    payload := "z".repeat(300000).to_bytes()
    back := ch.unary("/t.S/Big", payload, grpc.call_options())?
    print("big {back.len()} {back == payload}")

    ch.close()
    mut ch2 := grpc.connect("127.0.0.1:{port}")?
    mut d := grpc.call_options()
    d.timeout_ms = 150
    _ := ch2.unary("/t.S/Slow", b"x", d) else err
        print("deadline {err.status.code.name()}")
    ch2.close()

fn main() !
    mut s := grpc.server()
    s.handle("/t.S/Echo", echo)
    s.handle("/t.S/Count", count)
    s.handle("/t.S/Sum", sum)
    s.handle("/t.S/Chat", chat)
    s.handle("/t.S/Fail", fail)
    s.handle("/t.S/Slow", slow)
    s.handle("/t.S/Big", big)
    l := net.listen("127.0.0.1:0")?
    port := l.addr().split(":")[1].to_int() else 0
    server := spawn s.run(l)
    run(port)?
    l.close()
    server.wait()?
    print("stopped")
