# Pairs whose two lists are one list (native.vec.3): the same index (i == j), and
# indexes one apart, so lane 1 of one pair is lane 0 of the other. The pass must
# keep the scalar order of every load and store.
fn kick(mut s List[float], i int, j int, m float)
    dx := s[i] - s[j]
    dy := s[i + 1] - s[j + 1]
    s[i] -= dx * m
    s[i + 1] -= dy * m
    s[j] += dx * m
    s[j + 1] += dy * m

fn shift(mut s List[float], i int, j int)
    a := s[j] * 2.0
    b := s[j + 1] * 2.0
    s[i] = a + 1.0
    s[i + 1] = b + 1.0

fn main()
    mut s := [0.5, 1.25, -3.0, 4.75, 2.0, -0.125]
    kick(mut s, 0, 0, 0.5)
    print(s)
    kick(mut s, 1, 2, 0.25)
    print(s)
    kick(mut s, 3, 2, 0.75)
    print(s)
    shift(mut s, 1, 0)
    print(s)
    shift(mut s, 0, 1)
    print(s)
    shift(mut s, 2, 2)
    print(s)
