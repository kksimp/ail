## `s.to_float() else ...` with no boxed optional (type.num.8, err.else.1-2):
## numbers, text that is not a number, `nan` (a number, so the `else` does
## not run), and the `else` as a value, a `return` and a block.
fn parse(s str) float
    x := s.to_float() else return -2.0
    x

fn main()
    mut bad := 0
    a := "3.5".to_float() else -1.0
    b := "-0.25".to_float() else -1.0
    c := "6.02214076e23".to_float() else -1.0
    d := "123456789012345678901".to_float() else -1.0
    if a != 3.5 or b != -0.25 or c != 6.02214076e23 or d < 1.2e20 or d > 1.3e20
        bad += 1
    e := "abc".to_float() else -1.0
    f := "".to_float() else -1.0
    g := "1 ".to_float() else -1.0
    if e != -1.0 or f != -1.0 or g != -1.0
        bad += 1
    n := "nan".to_float() else 0.0
    if n == n
        bad += 1
    i := "inf".to_float() else 0.0
    if i <= 1.0e308
        bad += 1
    if parse("2.5") != 2.5 or parse("x2.5") != -2.0
        bad += 1
    mut misses := 0
    for t in ["1", "one", "1e3", "e3", "-7.5", "--7.5"]
        v := t.to_float() else
            misses += 1
            0.0
        if v < -8.0
            bad += 1
    print("bad {bad} misses {misses}")
