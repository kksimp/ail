# Set[int] and Set[str]: add, remove, contains, order, iteration (type.map.1, type.map.5, type.map.6).
fn main()
    mut s := Set[int]()
    print(s.add(5))
    print(s.add(3))
    print(s.add(5))
    s.add(8)
    print(s.len())
    print(s.contains(3))
    print(s.remove(3))
    print(s.remove(3))
    s.add(3)
    print(s)
    for x in s
        print(x * 2)
    mut seen := Set[str]()
    for w in ["a", "b", "a", "c", "b", "d"]
        if seen.add(w)
            print("new {w}")
    print(seen.len())
    lit := {4, 2, 9}
    print(lit)
    mut big := Set[int]()
    for i in 0..1000
        big.add(i * 7 % 101)
    print(big.len())
    mut n := 0
    for x in big
        n += x
    print(n)
    flags := {true, false}
    print(flags)
    for f in flags
        print(f)
