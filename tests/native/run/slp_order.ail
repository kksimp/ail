# slp-expect: any
# Stores and loads interleaved around would-be pairs in loops bce versions
# (native.vec.3): a store between the two loads, the second lane stored first, and a
# print between the two stores. Whatever the pass pairs, the output is the scalar one.
fn between(mut s List[float], n int)
    for i in 0..n
        k := i * 4
        x := s[k] * 3.0
        s[k + 1] = x - 1.0
        y := s[k + 1] * 3.0
        s[k + 2] = x + 1.0
        s[k + 3] = y + 1.0

fn reversed(mut s List[float], n int, m float)
    for i in 0..n
        k := i * 2
        x := s[k] + m
        y := s[k + 1] + m
        s[k + 1] = y * 0.5
        s[k] = x * 0.5

fn printed(mut s List[float], n int, m float)
    for i in 0..n
        k := i * 2
        x := s[k] * m
        y := s[k + 1] * m
        s[k] = x
        print(s[k + 1])
        s[k + 1] = y

fn main()
    mut s := [i.to_float() + 1.0 for i in 0..16]
    between(mut s, 4)
    print(s)
    reversed(mut s, 8, 0.25)
    print(s)
    reversed(mut s, 7, -1.5)
    print(s)
    printed(mut s, 3, 3.5)
    print(s)
