# `{x:.N}` rounds the exact binary value half to even (type.str.11).
fn main()
    print("{2.5:.0} {3.5:.0} {-2.5:.0} {0.5:.0} {1.5:.0}")
    print("{0.125:.2} {0.375:.2} {0.135:.2} {1.005:.2}")
    print("{123456.789:.1} {0.1:.20} {1e-7:.3} {1e15:.2}")
    print("{0.0:.3} {-0.0:.2} {-0.004:.2} {99.995:.2}")
    print("{0.0 / 0.0:.2} {1.0 / 0.0:.3} {-1.0 / 0.0:.1}")
    x := 2.0 / 3.0
    print("{x:.0} {x:.1} {x:.5} {x:.12}")
    print("{x} and {x:.3}")
