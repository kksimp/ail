# Index checks bound their index for what follows (native.range.1, ADR 1063,
# amended 2026-11-21): `sp - 1` after an access at `sp` or `sp - 1` passed
# can't overflow, and a second check of the same index against the same
# length goes. Every result is the same as with AIL_OPT_OFF=vrange.

fn run(code List[int]) int
    mut st := [0 for _ in 0..16]
    mut sp := 0
    mut pc := 0
    while pc < code.len()
        op := code[pc]
        pc += 1
        match op
            0 =>
                st[sp] = code[pc]
                pc += 1
                sp += 1
            1 =>
                sp -= 1
                st[sp - 1] = st[sp - 1] + st[sp]
            2 =>
                sp -= 1
                st[sp - 1] = st[sp - 1] * st[sp]
            _ => break
    st[sp - 1]

fn main()
    # (2 + 3) * 4 + 1
    print(run([0, 2, 0, 3, 1, 0, 4, 2, 0, 1, 1]))
    print(run([0, 7, 0, 6, 2]))
    mut total := 0
    for k in 0..1000
        total += run([0, k, 0, 2, 2, 0, 1, 1])
    print(total)
