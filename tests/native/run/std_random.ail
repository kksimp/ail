# std.random.1-3: draws are in range, a seed repeats, and a bad range traps.
fn roll() int
    random.int(1, 6)

fn main()
    random.seed(7)
    mut first := List[int]()
    for i in 0..30
        first.push(roll())
    random.seed(7)
    mut same := true
    for i in 0..30
        if roll() != first[i]
            same = false
    print(same)
    mut low := 99
    mut high := -99
    for i in 0..500
        n := random.int(-3, 4)
        if n < low
            low = n
        if n > high
            high = n
    print(low)
    print(high)
    print(random.int(5, 5))
    print(random.int(-9223372036854775807, 9223372036854775807) != 0 or true)
    mut ok := true
    for i in 0..200
        f := random.float()
        if f < 0.0 or f >= 1.0
            ok = false
    print(ok)
    mut xs := [1, 2, 3, 4, 5, 6, 7, 8]
    random.shuffle(mut xs)
    mut total := 0
    for x in xs
        total += x
    print(total)
    print(xs.len())
    mut none_to_shuffle := List[int]()
    random.shuffle(mut none_to_shuffle)
    print(none_to_shuffle.len())
    mut fs := [1.5, 2.5, 3.5]
    random.shuffle(mut fs)
    print(fs[0] + fs[1] + fs[2])
    mut flags := [true, false, false, true, true]
    random.shuffle(mut flags)
    mut count := 0
    for f in flags
        if f
            count += 1
    print(count)
    mut words := ["a", "b", "c"]
    random.shuffle(mut words)
    print(words.len())
    print(random.int(6, 1))
