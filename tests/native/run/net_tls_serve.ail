# net.serve_tls, net.listen_tls and connect_tls against them (std.net.46-48):
# a TLS 1.3 server with a test CA, an ECDSA P-256 key (PKCS#8 and SEC 1) and an
# RSA key (PKCS#1). The program runs itself as the client with SSL_CERT_FILE
# naming the CA. Ports and the temporary directory vary, so they are not printed.
use std.env
use std.fs
use std.net
use std.proc

fn port_of(addr str) str
    addr.split(":")[1]

## Answers until the server is closed.
fn answer(srv net.Server)
    while true
        ex := srv.accept() else err
            return
        r := ex.request
        body := "{r.method} {r.path} {r.query} [{r.body}]"
        ex.respond(net.Response(status: 200, headers: {"x-tls": "yes"}, body: body)) else err
            continue

## Echoes one line on the one connection the client makes. (Closing a
## listener doesn't wake an `accept` waiting on it, so it isn't looped.)
fn echo(l net.Listener)
    c := l.accept() else err
        print("accept {err.kind}")
        return
    got := c.read_line() else err
        c.close()
        return
    line := got else "none"
    c.write("echo {line}\n") else err
        c.close()
        return
    c.close()

## The client side, in a child process that trusts the test CA.
fn client(ec str, rsa str, raw str) ! net.NetError
    a := net.get("https://localhost:{ec}/a?x=1")?
    print("ec {a.status} {a.headers.get("x-tls")} {a.body}")
    b := net.post("https://127.0.0.1:{ec}/b", "payload", "text/plain")?
    print("ec {b.status} {b.body}")
    c := net.get("https://localhost:{rsa}/c")?
    print("rsa {c.status} {c.body}")
    port := raw.to_int() else 0
    conn := net.connect_tls("localhost", port)?
    conn.write("hello\n")?
    got := conn.read_line()? else "none"
    print("raw {got}")
    conn.close()

## A request from a process that doesn't trust the test CA.
fn untrusted(port str) str
    r := net.get("https://localhost:{port}/") else err
        return "untrusted {err.kind}"
    "untrusted {r.status}"

## `serve_tls`'s failure for a certificate and key, with the directory hidden.
fn load_fail(dir str, cert str, key str) str
    srv := net.serve_tls("127.0.0.1:0", "{dir}/{cert}", "{dir}/{key}") else err
        return "{err.kind}: {err.message.replace(dir, "DIR")}"
    srv.close()
    "served"

fn main() !
    args := env.args()
    if args.len() == 4 and args[0] == "client"
        client(args[1], args[2], args[3])?
        return
    dir := fs.make_temp_dir("ail-tls-")?
    fs.write_text("{dir}/ca.pem", ca_pem())?
    fs.write_text("{dir}/ec.pem", ec_pem())?
    fs.write_text("{dir}/ec.key", ec_key())?
    fs.write_text("{dir}/ec1.key", ec_key_sec1())?
    fs.write_text("{dir}/rsa.pem", rsa_pem())?
    fs.write_text("{dir}/rsa.key", rsa_key())?
    srv := net.serve_tls("127.0.0.1:0", "{dir}/ec.pem", "{dir}/ec.key")?
    rsa := net.serve_tls("127.0.0.1:0", "{dir}/rsa.pem", "{dir}/rsa.key")?
    l := net.listen_tls("127.0.0.1:0", "{dir}/ec.pem", "{dir}/ec1.key")?
    t1 := spawn answer(srv)
    t2 := spawn answer(rsa)
    t3 := spawn echo(l)
    mut opts := proc.options()
    opts.env = {"SSL_CERT_FILE": "{dir}/ca.pem"}
    opts.timeout_ms = 60000
    ports := [port_of(srv.addr()), port_of(rsa.addr()), port_of(l.addr())]
    out := proc.run_with(env.program(), ["client", ports[0], ports[1], ports[2]], opts)?
    for line in out.out.trim().split("\n")
        print(line)
    print("client exit {out.status}")
    # Plain HTTP to a TLS port is answered with a plain-text 400.
    p := net.get("http://{srv.addr()}/")?
    print("plain {p.status} {p.body.trim()}")
    # This process doesn't trust the test CA.
    print(untrusted(ports[0]))
    print(load_fail(dir, "none.pem", "ec.key"))
    print(load_fail(dir, "ec.pem", "none.key"))
    print(load_fail(dir, "ec.key", "ec.key"))
    print(load_fail(dir, "ec.pem", "rsa.key"))
    print(load_fail(dir, "rsa.pem", "ec.key"))
    print(load_fail(dir, "ec.pem", "ec.pem"))
    srv.close()
    rsa.close()
    l.close()
    t1.wait()?
    t2.wait()?
    t3.wait()?
    for f in ["ca.pem", "ec.pem", "ec.key", "ec1.key", "rsa.pem", "rsa.key"]
        fs.remove("{dir}/{f}")?
    fs.remove(dir)?

