fn fib(n int) int
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)

fn paths(r int, c int) int
    if r == 0 or c == 0
        return 1
    (paths(r - 1, c) + paths(r, c - 1)) % 1000000007

fn split(lo int, hi int) int
    if hi - lo < 2
        return lo
    mid := (lo + hi) / 2
    split(lo, mid) + split(mid, hi)

fn grow(n int) int
    if n < 1
        return 1
    grow(n - 1) * 3 + grow(n - 2)

fn main()
    print(fib(40))
    print(fib(-3))
    print(paths(14, 14))
    print(split(0, 1000))
    print(grow(30))
