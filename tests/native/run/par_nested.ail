# conc.par.14: a loop the compiler chose may sit inside a loop that runs in
# order; each run of the outer body tests the inner loop's work again, and a
# loop inside a loop on the pool runs in order in its chunk (ADR 0987).
fn steps(m int) int
    mut acc := 0
    for t in 0..50
        mut s := 0
        for j in 0..m
            s += (j * t) % 13
        acc = (acc * 31 + s) % 1000000007
    acc

fn main()
    # A `while` around a heavy inner loop: the inner loop may go to the pool on every step.
    n := 200000
    mut cur := List[int]()
    for i in 0..n
        cur.push(i % 10)
    mut next := cur
    mut step := 0
    while step < 5
        for i in 0..n
            next[i] = (cur[i] * 3 + cur[(i + 1) % n] + step) % 1000
        cur = next
        step += 1
    mut sum := 0
    for i in 0..n
        sum += cur[i]
    print("{cur.len()} {cur[0]} {cur[n - 1]} {sum}")
    # An outer `for` that carries a value, around inner loops above and below the work test.
    print("{steps(600000)} {steps(1000)}")
    # A short inner range of literal bounds stays a plain loop.
    mut tot := 0
    mut tmp := [0, 0, 0, 0]
    for r in 0..100
        for k in 0..4
            tmp[k] = r * k + tot
        tot = tmp[3] % 1000 + tot % 7
    print("{tot} {tmp[0]} {tmp[2]}")
    # An outer loop on the pool: its inner loop runs in order in each chunk.
    mut rows := List[int]()
    for _ in 0..64
        rows.push(0)
    for i in 0..64
        mut s := 0
        for j in 0..5000
            s += (i + j) % 7
        rows[i] = s
    mut total := 0
    for i in 0..64
        total += rows[i]
    print("{rows[0]} {rows[63]} {total}")
