fn fail(n int) net.Response ! net.NetError
    if n > 0
        return net.NetError(url: "u", kind: Protocol, message: "bad {n}")
    net.Response(status: 200, headers: {}, body: "ok", all_headers: {})

fn main()
    r := fail(0) else
        print("failed")
        return
    print("{r.status} {r.body}")
    s := fail(2) else
        print("failed")
        return
    print("{s.status}")
