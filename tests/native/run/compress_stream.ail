# Larger inputs of different kinds: the compressed bytes must equal the
# interpreter's (std.compress.1), checked by length, a rolling sum, and both ends.
use std.compress

fn digest(label str, b bytes)
    mut sum := 0
    mut i := 0
    while i < b.len()
        sum = (sum * 31 + b[i].to_int()) % 1000000007
        i += 1
    tail := if b.len() > 24 then b[b.len() - 24..] else b
    head := if b.len() > 24 then b[..24] else b
    print("{label}: {b.len()} {sum} {head.hex()} {tail.hex()}")

fn noise(n int, seed int, letters int) str
    mut s := seed
    mut out := ""
    mut i := 0
    while i < n
        s = (s * 1103515245 + 12345) % 2147483648
        out = "{out}{"abcdefghijklmnopqrstuvwxyz0123456789 \n".slice(s / 65536 % letters, s / 65536 % letters + 1)}"
        i += 1
    out

fn main()
    runs := "x".repeat(70000)
    digest("runs", compress.gzip(runs))
    words := "the quick brown fox jumps over the lazy dog\n".repeat(1500)
    digest("words", compress.zlib(words))
    digest("noise", compress.deflate(noise(6000, 7, 37)))
    digest("few", compress.gzip(noise(20000, 11, 4)))
    mix := "{noise(3000, 5, 37)}{words}{noise(3000, 9, 20)}{runs}"
    digest("mix", compress.gzip(mix))
    back := compress.gunzip(compress.gzip(mix)) else b""
    print(back.text() == mix)
