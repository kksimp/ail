# Maps with enum values (type.map.1): flat and with fields, set, get,
# index, copy, keys.
enum Color
    Red
    Green

enum Shape
    Dot
    Circle(r int)
    Rect(w int, h int)

fn area(s Shape) int
    match s
        Dot => 0
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h

fn main()
    mut cs := {"a": Color.Red}
    cs["b"] = Color.Green
    print(cs["b"] == Color.Green)
    if c := cs.get("a")
        print(c == Color.Red)
    mut ss := Map[str, Shape]()
    ss["c"] = Shape.Circle(2)
    ss["r"] = Shape.Rect(w: 3, h: 4)
    ss["d"] = Shape.Dot
    copy := ss
    ss["c"] = Shape.Dot
    for k in copy.keys()
        print("{k} {area(copy[k])}")
    print(area(ss["c"]))
    print(area(ss.get("zz") else Shape.Rect(w: 1, h: 1)))
    print(ss.contains("r"))
    print(ss.len())
