# unsafe.block.1: an `unsafe` block runs like a plain block. gram.attr.4:
# `@deprecated` changes nothing at run time. test.attr.2: a `@test` function
# is left out of the build, so it may use what the native subset lacks.
@deprecated("use total") fn sum(a int, b int) int
    a + b

fn total(xs List[int]) int
    mut t := 0
    unsafe
        for x in xs
            t += x
    t

@test fn totals_add_up()
    assert_eq(total([1, 2, 3]), 6)
    assert_eq({"a": 1}.len(), 1)

fn main()
    print(total([2, 3]))
    print(total([4, 5, 6]))
