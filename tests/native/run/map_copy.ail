# Maps are values: assigning copies (own.val.1); `mut` parameters share.
fn bump(mut m Map[str, int])
    m["x"] += 1

fn total(m Map[str, int]) int
    mut t := 0
    for k in m.keys()
        t += m[k]
    t

fn main()
    mut a := {"x": 1, "y": 2}
    mut b := a
    b["x"] = 100
    b["z"] = 3
    print(a)
    print(b)
    bump(mut a)
    bump(mut a)
    print(a)
    print(total(a))
    mut lists := Map[int, List[int]]()
    lists.push(1, 10)
    lists.push(1, 11)
    lists.push(2, 20)
    mut copy := lists
    copy.push(1, 12)
    lists.push(2, 21)
    print(lists[1])
    print(lists[2])
    print(copy[1])
    print(copy[2])
    mut nest := Map[int, Map[int, str]]()
    nest[1] = Map[int, str]()
    nest[1][2] = "two"
    mut other := nest
    other[1][3] = "three"
    print(nest[1].len())
    print(other[1].len())
    xs := lists[1]
    print(xs)
