# expr.comp.*: set and map comprehensions.
fn squares(n int) Set[int]
    {i * i % 7 for i in 0..n}

fn lengths(words List[str]) Map[str, int]
    {w: w.len() for w in words if w.len() > 1}

fn words(ws List[str]) Set[str]
    {w for w in ws}

fn pairs(n int) Map[int, List[int]]
    {i: [i, i + 1] for i in 0..n}

fn main()
    print(squares(10))
    print(lengths(["a", "bb", "ccc", "bb"]))
    print(words(["x", "y", "x"]))
    print(pairs(3)[2])
    print(pairs(4).len())
