# std.err.1, err.text.1: fs failures are `fs.IoError` values, with `?`, `else`
# and `else err`, and a failure reaching `main` is reported as `ail run` does.
fn load(path str) str ! fs.IoError
    fs.read_text(path)?

fn probe(path str)
    text := load(path) else err
        print("failed: {err}")
        return
    print("read bytes: {text.len() > 1000}")

fn list(path str)
    names := fs.list_dir(path) else err
        print("list_dir: {err}")
        return
    print(names.len() > 0)

fn main() ! fs.IoError
    probe("docs/spec/17-std.md")
    probe("docs/no-such-file.md")
    probe("docs")
    probe("tests/native/run/os_bad_utf8.bin")
    probe("docs/spec/17-std.md/x")
    probe("a \"quoted\" path")
    fs.make_dir("docs/spec/23-native.md") else err
        print("make_dir: {err}")
    fs.remove("docs/decisions") else err
        print("remove: {err}")
    fs.rename("docs/no-such-file.md", "docs/other") else err
        print("rename: {err}")
    list("docs/no-such-dir")
    list("docs/decisions/README.md")
    list("docs/spec")
    print(env.get("AIL_SURELY_NOT_SET") else "unset")
    if v := env.get("AIL_TEST_DIR")
        print(v.len() > 0)
    if f := "2.5".to_float()
        print(f + 1.0)
    if g := "x2".to_float()
        print(g)
    else
        print("not a number")
    fs.write_text("/nonexistent-dir-ail/x.txt", "y")?
    print("not reached")
