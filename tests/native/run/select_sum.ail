# `if c: n += w` adds `select(c, w, 0)` and the sum stays checked
# (native.select.4, ADR 1162): every result is the same as with
# AIL_OPT_OFF=selsum.
fn count_eq(xs List[int], k int) int
    mut n := 0
    for x in xs
        if x == k
            n += 1
    n

fn count_others(xs List[int], k int) int
    mut n := 0
    for x in xs
        if x == k
            continue
        n += 1
    n

fn sum_over(xs List[int], lo int) int
    mut s := 0
    for x in xs
        if x > lo
            s += x
    s

fn take_away(xs List[int], start int, step int) int
    mut left := start
    for x in xs
        if x % 3 == 0
            left -= step
    left

fn weigh(xs List[int]) int
    mut t := 0
    for x in xs
        if x < 0
            t += 10
    t

fn letters(s str, want char) int
    mut total := 0
    for c in s
        if c == want
            total += 1
    total

fn main()
    xs := [3, -1, 4, 1, -5, 9, 2, 6, -5, 3]
    print(count_eq(xs, 3))
    print(count_others(xs, 3))
    print(sum_over(xs, 2))
    print(take_away(xs, 100, 7))
    print(weigh(xs))
    print(letters("the quick brown fox jumped over the lazy dog, eventually", 'e'))
    # The largest int stays as it is while the condition fails.
    print(count_eq([1, 2, 1], 0) + 9223372036854775807)
    print(sum_over([1, 2, 1], 5) + 9223372036854775807)
