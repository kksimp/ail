PI := 3.141592653589793
SOLAR_MASS := 4.0 * PI * PI
DAYS := 365.24
N := 2 * 3 + 1

fn parse(s str) int
    n := s.to_int() else -1
    n

fn first(s str) int
    n := s.to_int() else return 99
    n + 1

fn main()
    args := env.args()
    count := args.len()
    print(count)
    n := if count > 0 then parse(args[0]) else 1000
    print(n)
    for s in [
        "0",
        "42",
        "-17",
        "9223372036854775807",
        "-9223372036854775808",
        "9223372036854775808",
        "",
        "-",
        "1x",
        "+5",
        " 3",
    ]
        print(parse(s))
    print(first("7"))
    print(first("seven"))
    print(SOLAR_MASS)
    print(N)
    print("{SOLAR_MASS:.9}")
    print("{DAYS:.1} {DAYS:.0} {-DAYS:.3}")
    for x in [0.5, 1.5, 2.5, -0.5, 0.125, 1e20, 1e-7, 123.456789, -0.0, 0.0, 2.675, 1e300]
        print("{x:.2} {x:.0} {x:.9}")
    mut grid := List[List[int]]()
    mut row := [1, 2, 3]
    grid.push(row)
    row[0] = 9
    grid.push(row)
    print(grid[0][0])
    print(grid[1][0])
    mut names := List[str]()
    names.push("a")
    print(names.len())
