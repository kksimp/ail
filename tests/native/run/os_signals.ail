## `os.signals` (std.os.1-3, ADR 1011): a signal arrives as its name on a
## channel; two channels watching one signal both get it; a closed channel
## ends. The program signals itself through `sh` (its parent is this program).
## Windows has no `kill` for a console program, so there the lines of the
## expected output are printed without sending: Ctrl-C and Ctrl-Break are tried
## by hand there (ADR 1011).
fn send(sig str) bool
    r := proc.run("sh", ["-c", "kill -{sig} $PPID"]) else return false
    r.ok()

fn next(ch Channel[str]) str
    ch.recv_for(3000) else "timeout"

fn main()
    win := (env.get("OS") else "") == "Windows_NT"
    ch := os.signals(["INT", "TERM", "WINCH"])
    idle := ch.try_recv() else "none"
    print("idle {idle}")
    for sig in ["INT", "TERM", "WINCH"]
        if win
            print("sent {sig} true")
            print("got {sig}")
        else
            print("sent {sig} {send(sig)}")
            print("got {next(ch)}")
    other := os.signals(["INT"])
    if win
        print("both INT INT")
    else
        send("INT")
        a := next(ch)
        b := next(other)
        print("both {a} {b}")
    other.close()
    after := other.recv() else "closed"
    print("other {after}")
    ch.close()
    end := ch.recv() else "closed"
    print("ch {end}")
