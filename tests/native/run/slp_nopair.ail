# Lists the pairing pass (native.vec.3) leaves scalar: `f32` elements and integers.
fn f32s(mut s List[f32], k int, m f32)
    x := s[k] * m
    y := s[k + 1] * m
    s[k] = x + s[k + 2]
    s[k + 1] = y + s[k + 3]

fn ints(mut s List[int], k int, m int)
    x := s[k] * m
    y := s[k + 1] * m
    s[k] = x + s[k + 2]
    s[k + 1] = y + s[k + 3]

fn main()
    mut a := [x.to_f32() for x in [1.5, 2.25, 0.1, 0.2, 7.0]]
    three := 3.0
    half := 0.5
    f32s(mut a, 0, three.to_f32())
    f32s(mut a, 1, half.to_f32())
    print(a)
    mut b := [3, -4, 5, 6, 7]
    ints(mut b, 0, 3)
    ints(mut b, 1, -2)
    print(b)
