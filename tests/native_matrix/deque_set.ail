struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_set
    items List[Set[int]]

fn add_set(mut xs List[Set[int]], x Set[int])
    xs.push(x)

fn wrap_set(x Set[int]) Set[int]?
    x

fn nothing_set() Set[int]?
    none

K_set := [{1}, {2}]

## deque.empty_push[set]
fn s0()
    mut d := Deque[Set[int]]()
    d.push_back({1})
    d.push_front({2})
    print(d.len())

## deque.from[set]
fn s1()
    d := Deque.from([{1}, {2}])
    print(d.len())

## deque.pop[set]
fn s2()
    mut d := Deque.from([{1}, {2}, {3}])
    if x := d.pop_front()
        print(1)
    if x := d.pop_back()
        print(2)

## deque.first_last[set]
fn s3()
    d := Deque.from([{1}, {2}])
    if x := d.first()
        print(1)
    if x := d.last()
        print(2)

## deque.index[set]
fn s4()
    d := Deque.from([{1}, {2}])
    x := d[1]
    print(x.len() == x.len())

## deque.at_set[set]
fn s5()
    mut d := Deque.from([{1}, {2}])
    d.set(0, {3})
    x := d.at(0)
    print(d.len())

## deque.to_list[set]
fn s6()
    d := Deque.from([{1}, {2}])
    print(d.to_list().len())

## deque.for[set]
fn s7()
    d := Deque.from([{1}, {2}])
    mut n := 0
    for x in d
        n += 1
    print(n)

## deque.vocab[set]
fn s8()
    d := Deque.from([{1}, {2}])
    print(d.filter(|x| x == {1}).len() + d.map(|x| x.len()).len() + d.flat_map(|x| [x]).len())
    print(d.any(|x| x == {1}))
    print(d.all(|x| x == {1}))
    print(d.count(|x| x == {1}))
    print(d.fold(0, |acc, x| acc + 1))
    if x := d.find(|x| x == {1})
        print(1)

## deque.take_skip[set]
fn s9()
    d := Deque.from([{1}, {2}, {3}])
    print(d.take(1).len() + d.skip(1).len() + d.take_while(|x| x == {1}).len() + d.skip_while(|x| x == {1}).len())

## deque.enumerate_zip[set]
fn s10()
    d := Deque.from([{1}, {2}])
    print(d.enumerate().len() + d.zip([1, 2]).len())

## deque.is_empty[set]
fn s11()
    d := Deque[Set[int]]()
    print(d.is_empty())

fn main()
    print("-- deque.empty_push[set]")
    s0()
    print("-- deque.from[set]")
    s1()
    print("-- deque.pop[set]")
    s2()
    print("-- deque.first_last[set]")
    s3()
    print("-- deque.index[set]")
    s4()
    print("-- deque.at_set[set]")
    s5()
    print("-- deque.to_list[set]")
    s6()
    print("-- deque.for[set]")
    s7()
    print("-- deque.vocab[set]")
    s8()
    print("-- deque.take_skip[set]")
    s9()
    print("-- deque.enumerate_zip[set]")
    s10()
    print("-- deque.is_empty[set]")
    s11()
