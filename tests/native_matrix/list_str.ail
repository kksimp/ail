    print("-- list.zip[str]")
    s43()
    print("-- list.zip_into[str]")
    s44()
    print("-- list.for[str]")
    s45()
    print("-- list.for_mut[str]")
    s46()
    print("-- list.comprehension[str]")
    s47()
    print("-- list.set_comprehension[str]")
    s48()
    print("-- list.map_comprehension[str]")
    s49()
    print("-- list.eq[str]")
    s50()
    print("-- list.lt[str]")
    s51()
    print("-- list.print[str]")
    s52()
    print("-- list.interp[str]")
    s53()
    print("-- list.nested_push[str]")
    s54()
    print("-- list.in_struct[str]")
    s55()
    print("-- list.pass_mut[str]")
    s56()
    print("-- list.generic_first[str]")
    s57()
    print("-- list.generic_ord[str]")
