    print("-- list.index[str]")
    s5()
    print("-- list.index_assign[str]")
    s6()
    print("-- list.slice[str]")
    s7()
    print("-- list.push[str]")
    s8()
    print("-- list.pop[str]")
    s9()
    print("-- list.swap[str]")
    s10()
    print("-- list.first_last[str]")
    s11()
    print("-- list.insert[str]")
    s12()
    print("-- list.remove_at[str]")
    s13()
