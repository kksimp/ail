    s14()
    print("-- list.clear[str]")
    s15()
    print("-- list.reverse[str]")
    s16()
    print("-- list.reversed[str]")
    s17()
    print("-- list.contains[str]")
    s18()
    print("-- list.index_of[str]")
    s19()
    print("-- list.join[str]")
    s20()
    print("-- list.min_max[str]")
    s21()
    print("-- list.sorted[str]")
    s22()
    print("-- list.sort[str]")
    s23()
    print("-- list.sorted_by[str]")
    s24()
    print("-- list.sort_by[str]")
    s25()
    print("-- list.min_by[str]")
    s26()
    print("-- list.take_skip[str]")
    s27()
    print("-- list.set_ops[str]")
    s28()
    print("-- list.chunks_windows[str]")
    s29()
    print("-- list.counts[str]")
    s30()
    print("-- list.flatten[str]")
    s31()
    print("-- list.enumerate[str]")
    s32()
    print("-- list.any_all[str]")
    s33()
    print("-- list.find[str]")
    s34()
    print("-- list.filter[str]")
    s35()
    print("-- list.map[str]")
    s36()
    print("-- list.map_to_self[str]")
    s37()
    print("-- list.group_by[str]")
    s38()
    print("-- list.count[str]")
    s39()
    print("-- list.fold[str]")
    s40()
    print("-- list.flat_map[str]")
