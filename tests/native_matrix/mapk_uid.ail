struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_uid
    items List[Uid]

fn add_uid(mut xs List[Uid], x Uid)
    xs.push(x)

fn wrap_uid(x Uid) Uid?
    x

fn nothing_uid() Uid?
    none

K_uid := [Uid(1), Uid(2)]

## mapk.literal[uid]
fn s0()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.len())

## mapk.empty[uid]
fn s1()
    m := Map[Uid, int]()
    print(m.len())

## mapk.typed_by_use[uid]
fn s2()
    mut m := {}
    m[Uid(1)] += 1
    print(m.len())

## mapk.index[uid]
fn s3()
    m := {Uid(1): 1}
    print(m[Uid(1)])

## mapk.assign[uid]
fn s4()
    mut m := Map[Uid, int]()
    m[Uid(1)] = 1
    m[Uid(2)] = 2
    print(m.len())

## mapk.op_assign[uid]
fn s5()
    mut m := Map[Uid, int]()
    m[Uid(1)] += 3
    print(m[Uid(1)])

## mapk.get[uid]
fn s6()
    m := {Uid(1): 1}
    print(m.get(Uid(1)) else 0)

## mapk.get_or[uid]
fn s7()
    m := {Uid(1): 1}
    print(m.get_or(Uid(2), 7))

## mapk.contains[uid]
fn s8()
    m := {Uid(1): 1}
    print(m.contains(Uid(1)))

## mapk.remove[uid]
fn s9()
    mut m := {Uid(1): 1, Uid(2): 2}
    print(m.remove(Uid(1)) else 0)

## mapk.keys_values[uid]
fn s10()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.keys().len() + m.values().len())

## mapk.keys_sorted[uid]
fn s11()
    m := {Uid(2): 1, Uid(1): 2}
    print(m.keys().sorted().len())

## mapk.top[uid]
fn s12()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.top(1).len())

## mapk.for[uid]
fn s13()
    m := {Uid(1): 1, Uid(2): 2}
    mut n := 0
    for k, v in m
        n += v
    print(n)

## mapk.any_all_count[uid]
fn s14()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.any(|k, v| v > 1))
    print(m.all(|k, v| v > 1))
    print(m.count(|k, v| v > 1))

## mapk.fold[uid]
fn s15()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.fold(0, |acc, k, v| acc + v))

## mapk.filter[uid]
fn s16()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.filter(|k, v| v > 1).len())

## mapk.map[uid]
fn s17()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.map(|k, v| v).len())

## mapk.flat_map[uid]
fn s18()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.flat_map(|k, v| [v, v]).len())

## mapk.map_values[uid]
fn s19()
    m := {Uid(1): 1, Uid(2): 2}
    print(m.map_values(|k, v| v * 2).len())

## mapk.push[uid]
fn s20()
    mut m := Map[Uid, List[int]]()
    m.push(Uid(1), 1)
    m.push(Uid(1), 2)
    print(m[Uid(1)].len())

## mapk.eq[uid]
fn s21()
    m := {Uid(1): 1}
    print(m == {Uid(1): 1})

## mapk.print[uid]
fn s22()
    m := {Uid(1): 1}
    print(m)

## mapk.is_empty[uid]
fn s23()
    m := {Uid(1): 1}
    print(m.is_empty())

fn main()
    print("-- mapk.literal[uid]")
    s0()
    print("-- mapk.empty[uid]")
    s1()
    print("-- mapk.typed_by_use[uid]")
    s2()
    print("-- mapk.index[uid]")
    s3()
    print("-- mapk.assign[uid]")
    s4()
    print("-- mapk.op_assign[uid]")
    s5()
    print("-- mapk.get[uid]")
    s6()
    print("-- mapk.get_or[uid]")
    s7()
    print("-- mapk.contains[uid]")
    s8()
    print("-- mapk.remove[uid]")
    s9()
    print("-- mapk.keys_values[uid]")
    s10()
    print("-- mapk.keys_sorted[uid]")
    s11()
    print("-- mapk.top[uid]")
    s12()
    print("-- mapk.for[uid]")
    s13()
    print("-- mapk.any_all_count[uid]")
    s14()
    print("-- mapk.fold[uid]")
    s15()
    print("-- mapk.filter[uid]")
    s16()
    print("-- mapk.map[uid]")
    s17()
    print("-- mapk.flat_map[uid]")
    s18()
    print("-- mapk.map_values[uid]")
    s19()
    print("-- mapk.push[uid]")
    s20()
    print("-- mapk.eq[uid]")
    s21()
    print("-- mapk.print[uid]")
    s22()
    print("-- mapk.is_empty[uid]")
    s23()
