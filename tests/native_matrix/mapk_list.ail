struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_list
    items List[List[int]]

fn add_list(mut xs List[List[int]], x List[int])
    xs.push(x)

fn wrap_list(x List[int]) List[int]?
    x

fn nothing_list() List[int]?
    none

K_list := [[1], [1, 2]]

## mapk.literal[list]
fn s0()
    m := {[1]: 1, [1, 2]: 2}
    print(m.len())

## mapk.empty[list]
fn s1()
    m := Map[List[int], int]()
    print(m.len())

## mapk.typed_by_use[list]
fn s2()
    mut m := {}
    m[[1]] += 1
    print(m.len())

## mapk.index[list]
fn s3()
    m := {[1]: 1}
    print(m[[1]])

## mapk.assign[list]
fn s4()
    mut m := Map[List[int], int]()
    m[[1]] = 1
    m[[1, 2]] = 2
    print(m.len())

## mapk.op_assign[list]
fn s5()
    mut m := Map[List[int], int]()
    m[[1]] += 3
    print(m[[1]])

## mapk.get[list]
fn s6()
    m := {[1]: 1}
    print(m.get([1]) else 0)

## mapk.get_or[list]
fn s7()
    m := {[1]: 1}
    print(m.get_or([1, 2], 7))

## mapk.contains[list]
fn s8()
    m := {[1]: 1}
    print(m.contains([1]))

## mapk.remove[list]
fn s9()
    mut m := {[1]: 1, [1, 2]: 2}
    print(m.remove([1]) else 0)

## mapk.keys_values[list]
fn s10()
    m := {[1]: 1, [1, 2]: 2}
    print(m.keys().len() + m.values().len())

## mapk.keys_sorted[list]
fn s11()
    m := {[1, 2]: 1, [1]: 2}
    print(m.keys().sorted().len())

## mapk.top[list]
fn s12()
    m := {[1]: 1, [1, 2]: 2}
    print(m.top(1).len())

## mapk.for[list]
fn s13()
    m := {[1]: 1, [1, 2]: 2}
    mut n := 0
    for k, v in m
        n += v
    print(n)

## mapk.any_all_count[list]
fn s14()
    m := {[1]: 1, [1, 2]: 2}
    print(m.any(|k, v| v > 1))
    print(m.all(|k, v| v > 1))
    print(m.count(|k, v| v > 1))

## mapk.fold[list]
fn s15()
    m := {[1]: 1, [1, 2]: 2}
    print(m.fold(0, |acc, k, v| acc + v))

## mapk.filter[list]
fn s16()
    m := {[1]: 1, [1, 2]: 2}
    print(m.filter(|k, v| v > 1).len())

## mapk.map[list]
fn s17()
    m := {[1]: 1, [1, 2]: 2}
    print(m.map(|k, v| v).len())

## mapk.flat_map[list]
fn s18()
    m := {[1]: 1, [1, 2]: 2}
    print(m.flat_map(|k, v| [v, v]).len())

## mapk.map_values[list]
fn s19()
    m := {[1]: 1, [1, 2]: 2}
    print(m.map_values(|k, v| v * 2).len())

## mapk.push[list]
fn s20()
    mut m := Map[List[int], List[int]]()
    m.push([1], 1)
    m.push([1], 2)
    print(m[[1]].len())

## mapk.eq[list]
fn s21()
    m := {[1]: 1}
    print(m == {[1]: 1})

## mapk.print[list]
fn s22()
    m := {[1]: 1}
    print(m)

## mapk.is_empty[list]
fn s23()
    m := {[1]: 1}
    print(m.is_empty())

fn main()
    print("-- mapk.literal[list]")
    s0()
    print("-- mapk.empty[list]")
    s1()
    print("-- mapk.typed_by_use[list]")
    s2()
    print("-- mapk.index[list]")
    s3()
    print("-- mapk.assign[list]")
    s4()
    print("-- mapk.op_assign[list]")
    s5()
    print("-- mapk.get[list]")
    s6()
    print("-- mapk.get_or[list]")
    s7()
    print("-- mapk.contains[list]")
    s8()
    print("-- mapk.remove[list]")
    s9()
    print("-- mapk.keys_values[list]")
    s10()
    print("-- mapk.keys_sorted[list]")
    s11()
    print("-- mapk.top[list]")
    s12()
    print("-- mapk.for[list]")
    s13()
    print("-- mapk.any_all_count[list]")
    s14()
    print("-- mapk.fold[list]")
    s15()
    print("-- mapk.filter[list]")
    s16()
    print("-- mapk.map[list]")
    s17()
    print("-- mapk.flat_map[list]")
    s18()
    print("-- mapk.map_values[list]")
    s19()
    print("-- mapk.push[list]")
    s20()
    print("-- mapk.eq[list]")
    s21()
    print("-- mapk.print[list]")
    s22()
    print("-- mapk.is_empty[list]")
    s23()
