struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_str
    items List[str]

fn add_str(mut xs List[str], x str)
    xs.push(x)

fn wrap_str(x str) str?
    x

fn nothing_str() str?
    none

K_str := ["a", "b"]

## heap.empty_push_pop[str]
fn s0()
    mut h := Heap[str]()
    h.push("b")
    h.push("a")
    if x := h.pop()
        print(h.len())

## heap.max_first[str]
fn s1()
    mut h := Heap[str](max_first: true)
    h.push("a")
    h.push("b")
    if x := h.peek()
        print(h.len())

## heap.from[str]
fn s2()
    h := Heap.from(["c", "a", "b"])
    print(h.len())

## heap.from_max[str]
fn s3()
    h := Heap.from_max(["c", "a", "b"])
    print(h.to_sorted().len())

## heap.is_empty[str]
fn s4()
    h := Heap[str]()
    print(h.is_empty())

## heap.drain[str]
fn s5()
    mut h := Heap.from(["c", "a", "b"])
    mut n := 0
    while x := h.pop()
        n += 1
    print(n)

fn main()
    print("-- heap.empty_push_pop[str]")
    s0()
    print("-- heap.max_first[str]")
    s1()
    print("-- heap.from[str]")
    s2()
    print("-- heap.from_max[str]")
    s3()
    print("-- heap.is_empty[str]")
    s4()
    print("-- heap.drain[str]")
    s5()
