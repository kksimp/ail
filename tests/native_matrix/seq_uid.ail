struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_uid
    items List[Uid]

fn add_uid(mut xs List[Uid], x Uid)
    xs.push(x)

fn wrap_uid(x Uid) Uid?
    x

fn nothing_uid() Uid?
    none

K_uid := [Uid(1), Uid(2)]

## seq.of_collect[uid]
fn s0()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.collect().len())

## seq.map_filter[uid]
fn s1()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.filter(|x| x == Uid(1)).map(|x| x).collect().len())

## seq.take_skip[uid]
fn s2()
    s := Seq.of([Uid(1), Uid(2), Uid(3)])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[uid]
fn s3()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.enumerate().collect().len())

## seq.zip_chain[uid]
fn s4()
    s := Seq.of([Uid(1), Uid(2)])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[uid]
fn s5()
    s := Seq.of([Uid(1)])
    t := Seq.of([Uid(2)])
    print(s.chain(move t).collect().len())

## seq.next[uid]
fn s6()
    mut s := Seq.of([Uid(1), Uid(2)])
    if x := s.next()
        print(1)

## seq.for[uid]
fn s7()
    s := Seq.of([Uid(1), Uid(2)])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[uid]
fn s8()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.count(|x| x == Uid(1)))

## seq.fold[uid]
fn s9()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[uid]
fn s10()
    s := Seq.of([Uid(1), Uid(2)])
    if x := s.find(|x| x == Uid(2))
        print(1)

## seq.flat_map[uid]
fn s11()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[uid]
fn s12()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.take_while(|x| x == Uid(1)).collect().len())

## seq.skip_while[uid]
fn s13()
    s := Seq.of([Uid(1), Uid(2)])
    print(s.skip_while(|x| x == Uid(1)).collect().len())

fn main()
    print("-- seq.of_collect[uid]")
    s0()
    print("-- seq.map_filter[uid]")
    s1()
    print("-- seq.take_skip[uid]")
    s2()
    print("-- seq.enumerate[uid]")
    s3()
    print("-- seq.zip_chain[uid]")
    s4()
    print("-- seq.chain[uid]")
    s5()
    print("-- seq.next[uid]")
    s6()
    print("-- seq.for[uid]")
    s7()
    print("-- seq.count_any[uid]")
    s8()
    print("-- seq.fold[uid]")
    s9()
    print("-- seq.find[uid]")
    s10()
    print("-- seq.flat_map[uid]")
    s11()
    print("-- seq.while[uid]")
    s12()
    print("-- seq.skip_while[uid]")
    s13()
