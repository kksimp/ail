struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bool
    items List[bool]

fn add_bool(mut xs List[bool], x bool)
    xs.push(x)

fn wrap_bool(x bool) bool?
    x

fn nothing_bool() bool?
    none

K_bool := [false, true]

## grid.fill[bool]
fn s0()
    g := Grid.fill(2, 3, false)
    print(g.rows * g.cols)

## grid.from[bool]
fn s1()
    g := Grid.from([[false, true], [true, false]])
    print(g.cells.len())

## grid.index[bool]
fn s2()
    g := Grid.fill(2, 2, false)
    x := g[1, 1]
    print(x == x)

## grid.index_assign[bool]
fn s3()
    mut g := Grid.fill(2, 2, false)
    g[0, 1] = true
    print(g.rows)

## grid.row[bool]
fn s4()
    g := Grid.from([[false, true], [true, false]])
    print(g.row(1).len())

## grid.to_list[bool]
fn s5()
    g := Grid.fill(2, 2, false)
    print(g.to_list().len())

## grid.cells_for[bool]
fn s6()
    g := Grid.fill(2, 2, false)
    mut n := 0
    for x in g.cells
        n += 1
    print(n)

fn main()
    print("-- grid.fill[bool]")
    s0()
    print("-- grid.from[bool]")
    s1()
    print("-- grid.index[bool]")
    s2()
    print("-- grid.index_assign[bool]")
    s3()
    print("-- grid.row[bool]")
    s4()
    print("-- grid.to_list[bool]")
    s5()
    print("-- grid.cells_for[bool]")
    s6()
