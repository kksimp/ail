    print("-- list.filter[float]")
    s35()
    print("-- list.map[float]")
    s36()
    print("-- list.map_to_self[float]")
    s37()
    print("-- list.count[float]")
    s38()
    print("-- list.fold[float]")
    s39()
    print("-- list.flat_map[float]")
