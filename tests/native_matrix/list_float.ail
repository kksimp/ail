struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_float
    items List[float]

fn add_float(mut xs List[float], x float)
    xs.push(x)

fn wrap_float(x float) float?
    x

fn nothing_float() float?
    none

K_float := [1.5, 2.5]

## list.literal[float]
fn s0()
    xs := [1.5, 2.5, 3.5]
    print(xs.len())

## list.empty[float]
fn s1()
    xs := List[float]()
    print(xs.len())

## list.typed_by_push[float]
fn s2()
    mut xs := []
    xs.push(1.5)
    print(xs.len())

## list.len[float]
fn s3()
    xs := [1.5, 2.5]
    print(xs.len())

## list.is_empty[float]
fn s4()
    xs := [1.5]
    print(xs.is_empty())

## list.index[float]
fn s5()
    xs := [1.5, 2.5]
    x := xs[1]
    print(x == x)

## list.index_assign[float]
fn s6()
    mut xs := [1.5, 2.5]
    xs[0] = 3.5
    print(xs.len())

## list.slice[float]
fn s7()
    xs := [1.5, 2.5, 3.5]
    print(xs[1..].len() + xs[..1].len() + xs[0..2].len())

## list.slice_method[float]
fn s8()
    xs := [1.5, 2.5, 3.5]
    print(xs.slice(1).len() + xs.slice(0, 2).len())

## list.push[float]
fn s9()
    mut xs := [1.5]
    xs.push(2.5)
    print(xs.len())

## list.pop[float]
fn s10()
    mut xs := [1.5, 2.5]
    if x := xs.pop()
        print(xs.len())

## list.swap[float]
fn s11()
    mut xs := [1.5, 2.5]
    xs.swap(0, 1)
    print(xs.len())

## list.first_last[float]
fn s12()
    xs := [1.5, 2.5]
    if x := xs.first()
        print(1)
    if x := xs.last()
        print(2)

## list.insert[float]
fn s13()
    mut xs := [1.5]
    xs.insert(0, 2.5)
    print(xs.len())

## list.remove_at[float]
fn s14()
    mut xs := [1.5, 2.5]
    x := xs.remove_at(0)
    print(xs.len())

## list.extend[float]
fn s15()
    mut xs := [1.5]
    xs.extend([2.5, 3.5])
    print(xs.len())

## list.clear[float]
fn s16()
    mut xs := [1.5]
    xs.clear()
    print(xs.len())

## list.reverse[float]
fn s17()
    mut xs := [1.5, 2.5]
    xs.reverse()
    print(xs.len())

## list.reversed[float]
fn s18()
    xs := [1.5, 2.5]
    print(xs.reversed().len())

## list.contains[float]
fn s19()
    xs := [1.5, 2.5]
    print(xs.contains(2.5))

## list.index_of[float]
fn s20()
    xs := [1.5, 2.5]
    print(xs.index_of(2.5) else -1)

## list.join[float]
fn s21()
    xs := [1.5, 2.5]
    print(xs.join(",").len() > 0)

## list.sum[float]
fn s22()
    xs := [1.5, 2.5]
    s := xs.sum()
    print(1)

## list.min_max[float]
fn s23()
    xs := [2.5, 1.5, 3.5]
    if x := xs.min()
        print(1)
    if x := xs.max()
        print(2)

## list.sorted[float]
fn s24()
    xs := [3.5, 1.5, 2.5]
    print(xs.sorted().len())

## list.sort[float]
fn s25()
    mut xs := [3.5, 1.5, 2.5]
    xs.sort()
    print(xs.len())

## list.sorted_by[float]
fn s26()
    xs := [3.5, 1.5, 2.5]
    print(xs.sorted(by: |x| x).len())

## list.sort_by[float]
fn s27()
    mut xs := [3.5, 1.5, 2.5]
    xs.sort(by: |x| x)
    print(xs.len())

## list.min_by[float]
fn s28()
    xs := [3.5, 1.5, 2.5]
    if x := xs.min(by: |x| x)
        print(1)
    if x := xs.max(by: |x| x)
        print(2)

## list.take_skip[float]
fn s29()
    xs := [1.5, 2.5, 3.5]
    print(xs.take(2).len() + xs.skip(1).len())

## list.chunks_windows[float]
fn s30()
    xs := [1.5, 2.5, 3.5]
    print(xs.chunks(2).len() + xs.windows(2).len())

## list.flatten[float]
fn s31()
    xs := [[1.5], [2.5, 3.5]]
    print(xs.flatten().len())

## list.enumerate[float]
fn s32()
    xs := [1.5, 2.5]
    for i, x in xs.enumerate()
        print(i)

## list.any_all[float]
fn s33()
    xs := [1.5, 2.5]
    print(xs.any(|x| x == 1.5))
    print(xs.all(|x| x == 1.5))

## list.find[float]
fn s34()
    xs := [1.5, 2.5]
    if x := xs.find(|x| x == 2.5)
        print(1)

## list.filter[float]
fn s35()
    xs := [1.5, 2.5]
    print(xs.filter(|x| x == 1.5).len())

## list.map[float]
fn s36()
    xs := [1.5, 2.5]
    print(xs.map(|x| x).len())

## list.map_to_self[float]
fn s37()
    xs := [1.5, 2.5]
    print(xs.map(|x| x).len())

## list.count[float]
fn s38()
    xs := [1.5, 2.5, 1.5]
    print(xs.count(|x| x == 1.5))

## list.fold[float]
fn s39()
    xs := [1.5, 2.5]
    print(xs.fold(0, |acc, x| acc + 1))

## list.flat_map[float]
fn s40()
    xs := [1.5, 2.5]
    print(xs.flat_map(|x| [x, x]).len())

## list.take_skip_while[float]
fn s41()
    xs := [1.5, 2.5]
    print(xs.take_while(|x| x == 1.5).len() + xs.skip_while(|x| x == 1.5).len())

## list.zip[float]
fn s42()
    xs := [1.5, 2.5]
    for x, y in xs.zip([1, 2])
        print(y)

## list.zip_into[float]
fn s43()
    xs := [1.5, 2.5]
    for y, x in [1, 2].zip(xs)
        print(y)

## list.for[float]
fn s44()
    xs := [1.5, 2.5]
    mut n := 0
    for x in xs
        n += 1
    print(n)

## list.for_mut[float]
fn s45()
    mut xs := [1.5, 2.5]
    for mut x in xs
        x = 3.5
    print(xs.len())

## list.comprehension[float]
fn s46()
    xs := [1.5, 2.5]
    ys := [x for x in xs if x == 1.5]
    print(ys.len())

## list.eq[float]
fn s47()
    xs := [1.5, 2.5]
    ys := [1.5, 2.5]
    print(xs == ys)
    print(xs != [3.5])

## list.lt[float]
fn s48()
    xs := [1.5]
    ys := [2.5]
    print(xs < ys)

## list.print[float]
fn s49()
    xs := [1.5, 2.5]
    print(xs)

## list.interp[float]
fn s50()
    xs := [1.5, 2.5]
    print("{xs}".len() > 0)

## list.nested_push[float]
fn s51()
    mut xs := [[1.5]]
    xs[0].push(2.5)
    print(xs[0].len())

## list.in_struct[float]
fn s52()
    mut b := Box_float(items: [1.5])
    b.items.push(2.5)
    print(b.items.len())

## list.pass_mut[float]
fn s53()
    mut xs := [1.5]
    add_float(mut xs, 2.5)
    print(xs.len())

## list.generic_first[float]
fn s54()
    xs := [1.5, 2.5]
    if x := first_of(xs)
        print(1)

## list.generic_ord[float]
fn s55()
    xs := [1.5, 2.5]
    if x := biggest(xs)
        print(1)

## list.contains_list[float]
fn s56()
    xs := [[1.5], [2.5]]
    print(xs.contains([2.5]))

## list.sorted_nested[float]
fn s57()
    xs := [[2.5], [1.5]]
    print(xs.sorted().len())

fn main()
    print("-- list.literal[float]")
    s0()
    print("-- list.empty[float]")
    s1()
