    print("-- list.index_assign[float]")
    s6()
    print("-- list.slice[float]")
    s7()
    print("-- list.slice_method[float]")
    s8()
    print("-- list.push[float]")
    s9()
    print("-- list.pop[float]")
    s10()
    print("-- list.swap[float]")
    s11()
