struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_payenum
    items List[Shape]

fn add_payenum(mut xs List[Shape], x Shape)
    xs.push(x)

fn wrap_payenum(x Shape) Shape?
    x

fn nothing_payenum() Shape?
    none

K_payenum := [Shape.Circle(r: 1), Shape.Square(s: 2)]

## grid.fill[payenum]
fn s0()
    g := Grid.fill(2, 3, Shape.Circle(r: 1))
    print(g.rows * g.cols)

## grid.from[payenum]
fn s1()
    g := Grid.from([[Shape.Circle(r: 1), Shape.Square(s: 2)], [Shape.Circle(r: 3), Shape.Circle(r: 1)]])
    print(g.cells.len())

## grid.index[payenum]
fn s2()
    g := Grid.fill(2, 2, Shape.Circle(r: 1))
    x := g[1, 1]
    print(1 == 1)

## grid.index_assign[payenum]
fn s3()
    mut g := Grid.fill(2, 2, Shape.Circle(r: 1))
    g[0, 1] = Shape.Square(s: 2)
    print(g.rows)

## grid.row[payenum]
fn s4()
    g := Grid.from([[Shape.Circle(r: 1), Shape.Square(s: 2)], [Shape.Circle(r: 3), Shape.Circle(r: 1)]])
    print(g.row(1).len())

## grid.to_list[payenum]
fn s5()
    g := Grid.fill(2, 2, Shape.Circle(r: 1))
    print(g.to_list().len())

## grid.cells_for[payenum]
fn s6()
    g := Grid.fill(2, 2, Shape.Circle(r: 1))
    mut n := 0
    for x in g.cells
        n += 1
    print(n)

fn main()
    print("-- grid.fill[payenum]")
    s0()
    print("-- grid.from[payenum]")
    s1()
    print("-- grid.index[payenum]")
    s2()
    print("-- grid.index_assign[payenum]")
    s3()
    print("-- grid.row[payenum]")
    s4()
    print("-- grid.to_list[payenum]")
    s5()
    print("-- grid.cells_for[payenum]")
    s6()
