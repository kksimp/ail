struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_u8
    items List[u8]

fn add_u8(mut xs List[u8], x u8)
    xs.push(x)

fn wrap_u8(x u8) u8?
    x

fn nothing_u8() u8?
    none

K_u8 := [1.to_u8(), 2.to_u8()]

## list.literal[u8]
fn s0()
    xs := [1.to_u8(), 2.to_u8(), 3.to_u8()]
    print(xs.len())

## list.empty[u8]
fn s1()
    xs := List[u8]()
    print(xs.len())

## list.typed_by_push[u8]
fn s2()
    mut xs := []
    xs.push(1.to_u8())
    print(xs.len())

## list.len[u8]
fn s3()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.len())

## list.is_empty[u8]
fn s4()
    xs := [1.to_u8()]
    print(xs.is_empty())

## list.index[u8]
fn s5()
    xs := [1.to_u8(), 2.to_u8()]
    x := xs[1]
    print(x == x)

## list.index_assign[u8]
fn s6()
    mut xs := [1.to_u8(), 2.to_u8()]
    xs[0] = 3.to_u8()
    print(xs.len())

## list.slice[u8]
fn s7()
    xs := [1.to_u8(), 2.to_u8(), 3.to_u8()]
    print(xs[1..].len() + xs[..1].len() + xs[0..2].len())

## list.slice_method[u8]
fn s8()
    xs := [1.to_u8(), 2.to_u8(), 3.to_u8()]
    print(xs.slice(1).len() + xs.slice(0, 2).len())

## list.push[u8]
fn s9()
    mut xs := [1.to_u8()]
    xs.push(2.to_u8())
    print(xs.len())

## list.pop[u8]
fn s10()
    mut xs := [1.to_u8(), 2.to_u8()]
    if x := xs.pop()
        print(xs.len())

## list.swap[u8]
fn s11()
    mut xs := [1.to_u8(), 2.to_u8()]
    xs.swap(0, 1)
    print(xs.len())

## list.first_last[u8]
fn s12()
    xs := [1.to_u8(), 2.to_u8()]
    if x := xs.first()
        print(1)
    if x := xs.last()
        print(2)

## list.insert[u8]
fn s13()
    mut xs := [1.to_u8()]
    xs.insert(0, 2.to_u8())
    print(xs.len())

## list.remove_at[u8]
fn s14()
    mut xs := [1.to_u8(), 2.to_u8()]
    x := xs.remove_at(0)
    print(xs.len())

## list.extend[u8]
fn s15()
    mut xs := [1.to_u8()]
    xs.extend([2.to_u8(), 3.to_u8()])
    print(xs.len())

## list.clear[u8]
fn s16()
    mut xs := [1.to_u8()]
    xs.clear()
    print(xs.len())

## list.reverse[u8]
fn s17()
    mut xs := [1.to_u8(), 2.to_u8()]
    xs.reverse()
    print(xs.len())

## list.reversed[u8]
fn s18()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.reversed().len())

## list.contains[u8]
fn s19()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.contains(2.to_u8()))

## list.index_of[u8]
fn s20()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.index_of(2.to_u8()) else -1)

## list.join[u8]
fn s21()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.join(",").len() > 0)

## list.sum[u8]
fn s22()
    xs := [1.to_u8(), 2.to_u8()]
    s := xs.sum()
    print(1)

## list.min_max[u8]
fn s23()
    xs := [2.to_u8(), 1.to_u8(), 3.to_u8()]
    if x := xs.min()
        print(1)
    if x := xs.max()
        print(2)

## list.sorted[u8]
fn s24()
    xs := [3.to_u8(), 1.to_u8(), 2.to_u8()]
    print(xs.sorted().len())

## list.sort[u8]
fn s25()
    mut xs := [3.to_u8(), 1.to_u8(), 2.to_u8()]
    xs.sort()
    print(xs.len())

## list.sorted_by[u8]
fn s26()
    xs := [3.to_u8(), 1.to_u8(), 2.to_u8()]
    print(xs.sorted(by: |x| x).len())

## list.sort_by[u8]
fn s27()
    mut xs := [3.to_u8(), 1.to_u8(), 2.to_u8()]
    xs.sort(by: |x| x)
    print(xs.len())

## list.min_by[u8]
fn s28()
    xs := [3.to_u8(), 1.to_u8(), 2.to_u8()]
    if x := xs.min(by: |x| x)
        print(1)
    if x := xs.max(by: |x| x)
        print(2)

## list.take_skip[u8]
fn s29()
    xs := [1.to_u8(), 2.to_u8(), 3.to_u8()]
    print(xs.take(2).len() + xs.skip(1).len())

## list.set_ops[u8]
fn s30()
    xs := [1.to_u8(), 2.to_u8()]
    ys := [2.to_u8(), 3.to_u8()]
    print(xs.union(ys).len() + xs.intersect(ys).len() + xs.difference(ys).len())

## list.chunks_windows[u8]
fn s31()
    xs := [1.to_u8(), 2.to_u8(), 3.to_u8()]
    print(xs.chunks(2).len() + xs.windows(2).len())

## list.counts[u8]
fn s32()
    xs := [1.to_u8(), 2.to_u8(), 1.to_u8()]
    c := xs.counts()
    print(c.len())

## list.flatten[u8]
fn s33()
    xs := [[1.to_u8()], [2.to_u8(), 3.to_u8()]]
    print(xs.flatten().len())

## list.enumerate[u8]
fn s34()
    xs := [1.to_u8(), 2.to_u8()]
    for i, x in xs.enumerate()
        print(i)

## list.any_all[u8]
fn s35()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.any(|x| x == 1.to_u8()))
    print(xs.all(|x| x == 1.to_u8()))

## list.find[u8]
fn s36()
    xs := [1.to_u8(), 2.to_u8()]
    if x := xs.find(|x| x == 2.to_u8())
        print(1)

## list.filter[u8]
fn s37()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.filter(|x| x == 1.to_u8()).len())

## list.map[u8]
fn s38()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.map(|x| x).len())

## list.map_to_self[u8]
fn s39()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.map(|x| x).len())

## list.group_by[u8]
fn s40()
    xs := [1.to_u8(), 2.to_u8(), 1.to_u8()]
    g := xs.group_by(|x| x)
    print(g.len())

## list.count[u8]
fn s41()
    xs := [1.to_u8(), 2.to_u8(), 1.to_u8()]
    print(xs.count(|x| x == 1.to_u8()))

## list.fold[u8]
fn s42()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.fold(0, |acc, x| acc + 1))

## list.flat_map[u8]
fn s43()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.flat_map(|x| [x, x]).len())

## list.take_skip_while[u8]
fn s44()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs.take_while(|x| x == 1.to_u8()).len() + xs.skip_while(|x| x == 1.to_u8()).len())

## list.zip[u8]
fn s45()
    xs := [1.to_u8(), 2.to_u8()]
    for x, y in xs.zip([1, 2])
        print(y)

## list.zip_into[u8]
fn s46()
    xs := [1.to_u8(), 2.to_u8()]
    for y, x in [1, 2].zip(xs)
        print(y)

## list.for[u8]
fn s47()
    xs := [1.to_u8(), 2.to_u8()]
    mut n := 0
    for x in xs
        n += 1
    print(n)

## list.for_mut[u8]
fn s48()
    mut xs := [1.to_u8(), 2.to_u8()]
    for mut x in xs
        x = 3.to_u8()
    print(xs.len())

## list.comprehension[u8]
fn s49()
    xs := [1.to_u8(), 2.to_u8()]
    ys := [x for x in xs if x == 1.to_u8()]
    print(ys.len())

## list.set_comprehension[u8]
fn s50()
    xs := [1.to_u8(), 2.to_u8(), 1.to_u8()]
    s := {x for x in xs}
    print(s.len())

## list.map_comprehension[u8]
fn s51()
    xs := [1.to_u8(), 2.to_u8()]
    m := {x: 1 for x in xs}
    print(m.len())

## list.eq[u8]
fn s52()
    xs := [1.to_u8(), 2.to_u8()]
    ys := [1.to_u8(), 2.to_u8()]
    print(xs == ys)
    print(xs != [3.to_u8()])

## list.lt[u8]
fn s53()
    xs := [1.to_u8()]
    ys := [2.to_u8()]
    print(xs < ys)

## list.print[u8]
fn s54()
    xs := [1.to_u8(), 2.to_u8()]
    print(xs)

## list.interp[u8]
fn s55()
    xs := [1.to_u8(), 2.to_u8()]
    print("{xs}".len() > 0)

## list.nested_push[u8]
fn s56()
    mut xs := [[1.to_u8()]]
    xs[0].push(2.to_u8())
    print(xs[0].len())

## list.in_struct[u8]
fn s57()
    mut b := Box_u8(items: [1.to_u8()])
    b.items.push(2.to_u8())
    print(b.items.len())

## list.pass_mut[u8]
fn s58()
    mut xs := [1.to_u8()]
    add_u8(mut xs, 2.to_u8())
    print(xs.len())

## list.generic_first[u8]
fn s59()
    xs := [1.to_u8(), 2.to_u8()]
    if x := first_of(xs)
        print(1)

## list.generic_ord[u8]
fn s60()
    xs := [1.to_u8(), 2.to_u8()]
    if x := biggest(xs)
        print(1)

## list.contains_list[u8]
fn s61()
    xs := [[1.to_u8()], [2.to_u8()]]
    print(xs.contains([2.to_u8()]))

## list.sorted_nested[u8]
fn s62()
    xs := [[2.to_u8()], [1.to_u8()]]
    print(xs.sorted().len())

