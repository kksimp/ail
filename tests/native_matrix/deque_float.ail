struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_float
    items List[float]

fn add_float(mut xs List[float], x float)
    xs.push(x)

fn wrap_float(x float) float?
    x

fn nothing_float() float?
    none

K_float := [1.5, 2.5]

## deque.empty_push[float]
fn s0()
    mut d := Deque[float]()
    d.push_back(1.5)
    d.push_front(2.5)
    print(d.len())

## deque.from[float]
fn s1()
    d := Deque.from([1.5, 2.5])
    print(d.len())

## deque.pop[float]
fn s2()
    mut d := Deque.from([1.5, 2.5, 3.5])
    if x := d.pop_front()
        print(1)
    if x := d.pop_back()
        print(2)

## deque.first_last[float]
fn s3()
    d := Deque.from([1.5, 2.5])
    if x := d.first()
        print(1)
    if x := d.last()
        print(2)

## deque.index[float]
fn s4()
    d := Deque.from([1.5, 2.5])
    x := d[1]
    print(x == x)

## deque.at_set[float]
fn s5()
    mut d := Deque.from([1.5, 2.5])
    d.set(0, 3.5)
    x := d.at(0)
    print(d.len())

## deque.to_list[float]
fn s6()
    d := Deque.from([1.5, 2.5])
    print(d.to_list().len())

## deque.for[float]
fn s7()
    d := Deque.from([1.5, 2.5])
    mut n := 0
    for x in d
        n += 1
    print(n)

## deque.vocab[float]
fn s8()
    d := Deque.from([1.5, 2.5])
    print(d.filter(|x| x == 1.5).len() + d.map(|x| x).len() + d.flat_map(|x| [x]).len())
    print(d.any(|x| x == 1.5))
    print(d.all(|x| x == 1.5))
    print(d.count(|x| x == 1.5))
    print(d.fold(0, |acc, x| acc + 1))
    if x := d.find(|x| x == 1.5)
        print(1)

## deque.take_skip[float]
fn s9()
    d := Deque.from([1.5, 2.5, 3.5])
    print(d.take(1).len() + d.skip(1).len() + d.take_while(|x| x == 1.5).len() + d.skip_while(|x| x == 1.5).len())

## deque.enumerate_zip[float]
fn s10()
    d := Deque.from([1.5, 2.5])
    print(d.enumerate().len() + d.zip([1, 2]).len())

## deque.is_empty[float]
fn s11()
    d := Deque[float]()
    print(d.is_empty())

fn main()
    print("-- deque.empty_push[float]")
    s0()
    print("-- deque.from[float]")
    s1()
    print("-- deque.pop[float]")
    s2()
    print("-- deque.first_last[float]")
    s3()
    print("-- deque.index[float]")
    s4()
    print("-- deque.at_set[float]")
    s5()
    print("-- deque.to_list[float]")
    s6()
    print("-- deque.for[float]")
    s7()
    print("-- deque.vocab[float]")
    s8()
    print("-- deque.take_skip[float]")
    s9()
    print("-- deque.enumerate_zip[float]")
    s10()
    print("-- deque.is_empty[float]")
    s11()
