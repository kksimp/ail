struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_str
    items List[str]

fn add_str(mut xs List[str], x str)
    xs.push(x)

fn wrap_str(x str) str?
    x

fn nothing_str() str?
    none

K_str := ["a", "b"]

## set.literal[str]
fn s0()
    s := {"a", "b"}
    print(s.len())

## set.empty[str]
fn s1()
    s := Set[str]()
    print(s.len())

## set.from_list[str]
fn s2()
    s := {x for x in ["a", "b", "a"]}
    print(s.len())

## set.add_remove[str]
fn s3()
    mut s := Set[str]()
    print(s.add("a"))
    print(s.remove("a"))

## set.contains[str]
fn s4()
    s := {"a", "b"}
    print(s.contains("a"))

## set.is_empty[str]
fn s5()
    s := {"a"}
    print(s.is_empty())

## set.sorted[str]
fn s6()
    s := {"b", "a"}
    print(s.sorted().len())

## set.to_list[str]
fn s7()
    s := {"a", "b"}
    print(s.to_list().len())

## set.is_subset[str]
fn s8()
    s := {"a"}
    t := {"a", "b"}
    print(s.is_subset(t))

## set.set_ops[str]
fn s9()
    s := {"a", "b"}
    t := {"b", "c"}
    print(s.union(t).len() + s.intersect(t).len() + s.difference(t).len())

## set.any_all_find[str]
fn s10()
    s := {"a", "b"}
    print(s.any(|x| x == "a"))
    print(s.all(|x| x == "a"))
    if x := s.find(|x| x == "b")
        print(1)

## set.filter_map[str]
fn s11()
    s := {"a", "b"}
    print(s.filter(|x| x == "a").len() + s.map(|x| x).len())

## set.group_by[str]
fn s12()
    s := {"a", "b"}
    print(s.group_by(|x| x).len())

## set.count_fold[str]
fn s13()
    s := {"a", "b"}
    print(s.count(|x| x == "a"))
    print(s.fold(0, |acc, x| acc + 1))

## set.flat_map[str]
fn s14()
    s := {"a", "b"}
    print(s.flat_map(|x| [x]).len())

## set.take_skip[str]
fn s15()
    s := {"a", "b", "c"}
    print(s.take(1).len() + s.skip(1).len() + s.take_while(|x| x == "a").len() + s.skip_while(|x| x == "a").len())

## set.zip_enumerate[str]
fn s16()
    s := {"a", "b"}
    print(s.zip([1, 2]).len() + s.enumerate().len())

## set.min_max[str]
fn s17()
    s := {"a", "b"}
    if x := s.min()
        print(1)
    if x := s.max()
        print(2)

## set.for[str]
fn s18()
    s := {"a", "b"}
    mut n := 0
    for x in s
        n += 1
    print(n)

## set.eq[str]
fn s19()
    s := {"a", "b"}
    print(s == {"b", "a"})

## set.print[str]
fn s20()
    s := {"a"}
    print(s)

## set.in_map[str]
fn s21()
    mut m := Map[str, Set[str]]()
    m["a"] = Set[str]()
    m["a"].add("a")
    print(m["a"].len())

## set.in_list[str]
fn s22()
    mut xs := [Set[str]()]
    xs[0].add("a")
    print(xs[0].len())

fn main()
    print("-- set.literal[str]")
    s0()
    print("-- set.empty[str]")
    s1()
    print("-- set.from_list[str]")
    s2()
    print("-- set.add_remove[str]")
    s3()
    print("-- set.contains[str]")
    s4()
    print("-- set.is_empty[str]")
    s5()
    print("-- set.sorted[str]")
    s6()
    print("-- set.to_list[str]")
    s7()
    print("-- set.is_subset[str]")
    s8()
    print("-- set.set_ops[str]")
    s9()
    print("-- set.any_all_find[str]")
    s10()
    print("-- set.filter_map[str]")
    s11()
    print("-- set.group_by[str]")
    s12()
    print("-- set.count_fold[str]")
    s13()
    print("-- set.flat_map[str]")
    s14()
    print("-- set.take_skip[str]")
    s15()
    print("-- set.zip_enumerate[str]")
    s16()
    print("-- set.min_max[str]")
    s17()
    print("-- set.for[str]")
    s18()
    print("-- set.eq[str]")
    s19()
    print("-- set.print[str]")
    s20()
    print("-- set.in_map[str]")
    s21()
    print("-- set.in_list[str]")
    s22()
