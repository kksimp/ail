struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_payenum
    items List[Shape]

fn add_payenum(mut xs List[Shape], x Shape)
    xs.push(x)

fn wrap_payenum(x Shape) Shape?
    x

fn nothing_payenum() Shape?
    none

K_payenum := [Shape.Circle(r: 1), Shape.Square(s: 2)]

## list.literal[payenum]
fn s0()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 3)]
    print(xs.len())

## list.empty[payenum]
fn s1()
    xs := List[Shape]()
    print(xs.len())

## list.typed_by_push[payenum]
fn s2()
    mut xs := []
    xs.push(Shape.Circle(r: 1))
    print(xs.len())

## list.len[payenum]
fn s3()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.len())

## list.is_empty[payenum]
fn s4()
    xs := [Shape.Circle(r: 1)]
    print(xs.is_empty())

## list.index[payenum]
fn s5()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    x := xs[1]
    print(1 == 1)

## list.index_assign[payenum]
fn s6()
    mut xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    xs[0] = Shape.Circle(r: 3)
    print(xs.len())

## list.slice[payenum]
fn s7()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 3)]
    print(xs[1..].len() + xs[..1].len() + xs[0..2].len())

## list.slice_method[payenum]
fn s8()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 3)]
    print(xs.slice(1).len() + xs.slice(0, 2).len())

## list.push[payenum]
fn s9()
    mut xs := [Shape.Circle(r: 1)]
    xs.push(Shape.Square(s: 2))
    print(xs.len())

## list.pop[payenum]
fn s10()
    mut xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    if x := xs.pop()
        print(xs.len())

## list.swap[payenum]
fn s11()
    mut xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    xs.swap(0, 1)
    print(xs.len())

## list.first_last[payenum]
fn s12()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    if x := xs.first()
        print(1)
    if x := xs.last()
        print(2)

## list.insert[payenum]
fn s13()
    mut xs := [Shape.Circle(r: 1)]
    xs.insert(0, Shape.Square(s: 2))
    print(xs.len())

## list.remove_at[payenum]
fn s14()
    mut xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    x := xs.remove_at(0)
    print(xs.len())

## list.extend[payenum]
fn s15()
    mut xs := [Shape.Circle(r: 1)]
    xs.extend([Shape.Square(s: 2), Shape.Circle(r: 3)])
    print(xs.len())

## list.clear[payenum]
fn s16()
    mut xs := [Shape.Circle(r: 1)]
    xs.clear()
    print(xs.len())

## list.reverse[payenum]
fn s17()
    mut xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    xs.reverse()
    print(xs.len())

## list.reversed[payenum]
fn s18()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.reversed().len())

## list.contains[payenum]
fn s19()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.contains(Shape.Square(s: 2)))

## list.index_of[payenum]
fn s20()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.index_of(Shape.Square(s: 2)) else -1)

## list.join[payenum]
fn s21()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.join(",").len() > 0)

## list.sorted_by[payenum]
fn s22()
    xs := [Shape.Circle(r: 3), Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.sorted(by: |x| 1).len())

## list.sort_by[payenum]
fn s23()
    mut xs := [Shape.Circle(r: 3), Shape.Circle(r: 1), Shape.Square(s: 2)]
    xs.sort(by: |x| 1)
    print(xs.len())

## list.min_by[payenum]
fn s24()
    xs := [Shape.Circle(r: 3), Shape.Circle(r: 1), Shape.Square(s: 2)]
    if x := xs.min(by: |x| 1)
        print(1)
    if x := xs.max(by: |x| 1)
        print(2)

## list.take_skip[payenum]
fn s25()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 3)]
    print(xs.take(2).len() + xs.skip(1).len())

## list.set_ops[payenum]
fn s26()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    ys := [Shape.Square(s: 2), Shape.Circle(r: 3)]
    print(xs.union(ys).len() + xs.intersect(ys).len() + xs.difference(ys).len())

## list.chunks_windows[payenum]
fn s27()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 3)]
    print(xs.chunks(2).len() + xs.windows(2).len())

## list.counts[payenum]
fn s28()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 1)]
    c := xs.counts()
    print(c.len())

## list.flatten[payenum]
fn s29()
    xs := [[Shape.Circle(r: 1)], [Shape.Square(s: 2), Shape.Circle(r: 3)]]
    print(xs.flatten().len())

## list.enumerate[payenum]
fn s30()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    for i, x in xs.enumerate()
        print(i)

## list.any_all[payenum]
fn s31()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.any(|x| x == Shape.Circle(r: 1)))
    print(xs.all(|x| x == Shape.Circle(r: 1)))

## list.find[payenum]
fn s32()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    if x := xs.find(|x| x == Shape.Square(s: 2))
        print(1)

## list.filter[payenum]
fn s33()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.filter(|x| x == Shape.Circle(r: 1)).len())

## list.map[payenum]
fn s34()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.map(|x| 1).len())

## list.map_to_self[payenum]
fn s35()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.map(|x| x).len())

## list.group_by[payenum]
fn s36()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 1)]
    g := xs.group_by(|x| 1)
    print(g.len())

## list.count[payenum]
fn s37()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 1)]
    print(xs.count(|x| x == Shape.Circle(r: 1)))

## list.fold[payenum]
fn s38()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.fold(0, |acc, x| acc + 1))

## list.flat_map[payenum]
fn s39()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.flat_map(|x| [x, x]).len())

## list.take_skip_while[payenum]
fn s40()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs.take_while(|x| x == Shape.Circle(r: 1)).len() + xs.skip_while(|x| x == Shape.Circle(r: 1)).len())

## list.zip[payenum]
fn s41()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    for x, y in xs.zip([1, 2])
        print(y)

## list.zip_into[payenum]
fn s42()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    for y, x in [1, 2].zip(xs)
        print(y)

## list.for[payenum]
fn s43()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    mut n := 0
    for x in xs
        n += 1
    print(n)

## list.for_mut[payenum]
fn s44()
    mut xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    for mut x in xs
        x = Shape.Circle(r: 3)
    print(xs.len())

## list.comprehension[payenum]
fn s45()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    ys := [x for x in xs if x == Shape.Circle(r: 1)]
    print(ys.len())

## list.set_comprehension[payenum]
fn s46()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 1)]
    s := {x for x in xs}
    print(s.len())

## list.map_comprehension[payenum]
fn s47()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    m := {x: 1 for x in xs}
    print(m.len())

## list.eq[payenum]
fn s48()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    ys := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs == ys)
    print(xs != [Shape.Circle(r: 3)])

## list.print[payenum]
fn s49()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print(xs)

## list.interp[payenum]
fn s50()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    print("{xs}".len() > 0)

## list.nested_push[payenum]
fn s51()
    mut xs := [[Shape.Circle(r: 1)]]
    xs[0].push(Shape.Square(s: 2))
    print(xs[0].len())

## list.in_struct[payenum]
fn s52()
    mut b := Box_payenum(items: [Shape.Circle(r: 1)])
    b.items.push(Shape.Square(s: 2))
    print(b.items.len())

## list.pass_mut[payenum]
fn s53()
    mut xs := [Shape.Circle(r: 1)]
    add_payenum(mut xs, Shape.Square(s: 2))
    print(xs.len())

## list.generic_first[payenum]
fn s54()
    xs := [Shape.Circle(r: 1), Shape.Square(s: 2)]
    if x := first_of(xs)
        print(1)

## list.contains_list[payenum]
fn s55()
    xs := [[Shape.Circle(r: 1)], [Shape.Square(s: 2)]]
    print(xs.contains([Shape.Square(s: 2)]))

