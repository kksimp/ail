struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bool
    items List[bool]

fn add_bool(mut xs List[bool], x bool)
    xs.push(x)

fn wrap_bool(x bool) bool?
    x

fn nothing_bool() bool?
    none

K_bool := [false, true]

## mapk.literal[bool]
fn s0()
    m := {false: 1, true: 2}
    print(m.len())

## mapk.empty[bool]
fn s1()
    m := Map[bool, int]()
    print(m.len())

## mapk.typed_by_use[bool]
fn s2()
    mut m := {}
    m[false] += 1
    print(m.len())

## mapk.index[bool]
fn s3()
    m := {false: 1}
    print(m[false])

## mapk.assign[bool]
fn s4()
    mut m := Map[bool, int]()
    m[false] = 1
    m[true] = 2
    print(m.len())

## mapk.op_assign[bool]
fn s5()
    mut m := Map[bool, int]()
    m[false] += 3
    print(m[false])

## mapk.get[bool]
fn s6()
    m := {false: 1}
    print(m.get(false) else 0)

## mapk.get_or[bool]
fn s7()
    m := {false: 1}
    print(m.get_or(true, 7))

## mapk.contains[bool]
fn s8()
    m := {false: 1}
    print(m.contains(false))

## mapk.remove[bool]
fn s9()
    mut m := {false: 1, true: 2}
    print(m.remove(false) else 0)

## mapk.keys_values[bool]
fn s10()
    m := {false: 1, true: 2}
    print(m.keys().len() + m.values().len())

## mapk.top[bool]
fn s11()
    m := {false: 1, true: 2}
    print(m.top(1).len())

## mapk.for[bool]
fn s12()
    m := {false: 1, true: 2}
    mut n := 0
    for k, v in m
        n += v
    print(n)

## mapk.any_all_count[bool]
fn s13()
    m := {false: 1, true: 2}
    print(m.any(|k, v| v > 1))
    print(m.all(|k, v| v > 1))
    print(m.count(|k, v| v > 1))

## mapk.fold[bool]
fn s14()
    m := {false: 1, true: 2}
    print(m.fold(0, |acc, k, v| acc + v))

## mapk.filter[bool]
fn s15()
    m := {false: 1, true: 2}
    print(m.filter(|k, v| v > 1).len())

## mapk.map[bool]
fn s16()
    m := {false: 1, true: 2}
    print(m.map(|k, v| v).len())

## mapk.flat_map[bool]
fn s17()
    m := {false: 1, true: 2}
    print(m.flat_map(|k, v| [v, v]).len())

## mapk.map_values[bool]
fn s18()
    m := {false: 1, true: 2}
    print(m.map_values(|k, v| v * 2).len())

## mapk.push[bool]
fn s19()
    mut m := Map[bool, List[int]]()
    m.push(false, 1)
    m.push(false, 2)
    print(m[false].len())

## mapk.eq[bool]
fn s20()
    m := {false: 1}
    print(m == {false: 1})

## mapk.print[bool]
fn s21()
    m := {false: 1}
    print(m)

## mapk.is_empty[bool]
fn s22()
    m := {false: 1}
    print(m.is_empty())

fn main()
    print("-- mapk.literal[bool]")
    s0()
    print("-- mapk.empty[bool]")
    s1()
    print("-- mapk.typed_by_use[bool]")
    s2()
    print("-- mapk.index[bool]")
    s3()
    print("-- mapk.assign[bool]")
    s4()
    print("-- mapk.op_assign[bool]")
    s5()
    print("-- mapk.get[bool]")
    s6()
    print("-- mapk.get_or[bool]")
    s7()
    print("-- mapk.contains[bool]")
    s8()
    print("-- mapk.remove[bool]")
    s9()
    print("-- mapk.keys_values[bool]")
    s10()
    print("-- mapk.top[bool]")
    s11()
    print("-- mapk.for[bool]")
    s12()
    print("-- mapk.any_all_count[bool]")
    s13()
    print("-- mapk.fold[bool]")
    s14()
    print("-- mapk.filter[bool]")
    s15()
    print("-- mapk.map[bool]")
    s16()
    print("-- mapk.flat_map[bool]")
    s17()
    print("-- mapk.map_values[bool]")
    s18()
    print("-- mapk.push[bool]")
    s19()
    print("-- mapk.eq[bool]")
    s20()
    print("-- mapk.print[bool]")
    s21()
    print("-- mapk.is_empty[bool]")
    s22()
