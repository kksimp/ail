struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_list
    items List[List[int]]

fn add_list(mut xs List[List[int]], x List[int])
    xs.push(x)

fn wrap_list(x List[int]) List[int]?
    x

fn nothing_list() List[int]?
    none

K_list := [[1], [1, 2]]

## heap.empty_push_pop[list]
fn s0()
    mut h := Heap[List[int]]()
    h.push([1, 2])
    h.push([1])
    if x := h.pop()
        print(h.len())

## heap.max_first[list]
fn s1()
    mut h := Heap[List[int]](max_first: true)
    h.push([1])
    h.push([1, 2])
    if x := h.peek()
        print(h.len())

## heap.from[list]
fn s2()
    h := Heap.from([[2], [1], [1, 2]])
    print(h.len())

## heap.from_max[list]
fn s3()
    h := Heap.from_max([[2], [1], [1, 2]])
    print(h.to_sorted().len())

## heap.is_empty[list]
fn s4()
    h := Heap[List[int]]()
    print(h.is_empty())

## heap.drain[list]
fn s5()
    mut h := Heap.from([[2], [1], [1, 2]])
    mut n := 0
    while x := h.pop()
        n += 1
    print(n)

fn main()
    print("-- heap.empty_push_pop[list]")
    s0()
    print("-- heap.max_first[list]")
    s1()
    print("-- heap.from[list]")
    s2()
    print("-- heap.from_max[list]")
    s3()
    print("-- heap.is_empty[list]")
    s4()
    print("-- heap.drain[list]")
    s5()
