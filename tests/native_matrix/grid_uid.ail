struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_uid
    items List[Uid]

fn add_uid(mut xs List[Uid], x Uid)
    xs.push(x)

fn wrap_uid(x Uid) Uid?
    x

fn nothing_uid() Uid?
    none

K_uid := [Uid(1), Uid(2)]

## grid.fill[uid]
fn s0()
    g := Grid.fill(2, 3, Uid(1))
    print(g.rows * g.cols)

## grid.from[uid]
fn s1()
    g := Grid.from([[Uid(1), Uid(2)], [Uid(3), Uid(1)]])
    print(g.cells.len())

## grid.index[uid]
fn s2()
    g := Grid.fill(2, 2, Uid(1))
    x := g[1, 1]
    print(x == x)

## grid.index_assign[uid]
fn s3()
    mut g := Grid.fill(2, 2, Uid(1))
    g[0, 1] = Uid(2)
    print(g.rows)

## grid.row[uid]
fn s4()
    g := Grid.from([[Uid(1), Uid(2)], [Uid(3), Uid(1)]])
    print(g.row(1).len())

## grid.to_list[uid]
fn s5()
    g := Grid.fill(2, 2, Uid(1))
    print(g.to_list().len())

## grid.cells_for[uid]
fn s6()
    g := Grid.fill(2, 2, Uid(1))
    mut n := 0
    for x in g.cells
        n += 1
    print(n)

fn main()
    print("-- grid.fill[uid]")
    s0()
    print("-- grid.from[uid]")
    s1()
    print("-- grid.index[uid]")
    s2()
    print("-- grid.index_assign[uid]")
    s3()
    print("-- grid.row[uid]")
    s4()
    print("-- grid.to_list[uid]")
    s5()
    print("-- grid.cells_for[uid]")
    s6()
