    print("-- list.zip_into[char]")
    s45()
    print("-- list.for[char]")
    s46()
    print("-- list.for_mut[char]")
    s47()
    print("-- list.comprehension[char]")
    s48()
    print("-- list.set_comprehension[char]")
    s49()
    print("-- list.map_comprehension[char]")
    s50()
    print("-- list.eq[char]")
    s51()
    print("-- list.lt[char]")
