struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_float
    items List[float]

fn add_float(mut xs List[float], x float)
    xs.push(x)

fn wrap_float(x float) float?
    x

fn nothing_float() float?
    none

K_float := [1.5, 2.5]

## seq.of_collect[float]
fn s0()
    s := Seq.of([1.5, 2.5])
    print(s.collect().len())

## seq.map_filter[float]
fn s1()
    s := Seq.of([1.5, 2.5])
    print(s.filter(|x| x == 1.5).map(|x| x).collect().len())

## seq.take_skip[float]
fn s2()
    s := Seq.of([1.5, 2.5, 3.5])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[float]
fn s3()
    s := Seq.of([1.5, 2.5])
    print(s.enumerate().collect().len())

## seq.zip_chain[float]
fn s4()
    s := Seq.of([1.5, 2.5])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[float]
fn s5()
    s := Seq.of([1.5])
    t := Seq.of([2.5])
    print(s.chain(move t).collect().len())

## seq.next[float]
fn s6()
    mut s := Seq.of([1.5, 2.5])
    if x := s.next()
        print(1)

## seq.for[float]
fn s7()
    s := Seq.of([1.5, 2.5])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[float]
fn s8()
    s := Seq.of([1.5, 2.5])
    print(s.count(|x| x == 1.5))

## seq.fold[float]
fn s9()
    s := Seq.of([1.5, 2.5])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[float]
fn s10()
    s := Seq.of([1.5, 2.5])
    if x := s.find(|x| x == 2.5)
        print(1)

## seq.flat_map[float]
fn s11()
    s := Seq.of([1.5, 2.5])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[float]
fn s12()
    s := Seq.of([1.5, 2.5])
    print(s.take_while(|x| x == 1.5).collect().len())

## seq.skip_while[float]
fn s13()
    s := Seq.of([1.5, 2.5])
    print(s.skip_while(|x| x == 1.5).collect().len())

fn main()
    print("-- seq.of_collect[float]")
    s0()
    print("-- seq.map_filter[float]")
    s1()
    print("-- seq.take_skip[float]")
    s2()
    print("-- seq.enumerate[float]")
    s3()
    print("-- seq.zip_chain[float]")
    s4()
    print("-- seq.chain[float]")
    s5()
    print("-- seq.next[float]")
    s6()
    print("-- seq.for[float]")
    s7()
    print("-- seq.count_any[float]")
    s8()
    print("-- seq.fold[float]")
    s9()
    print("-- seq.find[float]")
    s10()
    print("-- seq.flat_map[float]")
    s11()
    print("-- seq.while[float]")
    s12()
    print("-- seq.skip_while[float]")
    s13()
