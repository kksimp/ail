struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_u8
    items List[u8]

fn add_u8(mut xs List[u8], x u8)
    xs.push(x)

fn wrap_u8(x u8) u8?
    x

fn nothing_u8() u8?
    none

K_u8 := [1.to_u8(), 2.to_u8()]

## value.eq[u8]
fn s0()
    print(1.to_u8() == 1.to_u8())
    print(1.to_u8() != 2.to_u8())

## value.lt[u8]
fn s1()
    print(1.to_u8() < 2.to_u8())
    print(2.to_u8() >= 1.to_u8())

## value.print[u8]
fn s2()
    print(1.to_u8())

## value.interp[u8]
fn s3()
    x := 1.to_u8()
    print("<{x}>")

## value.to_str_len[u8]
fn s4()
    x := 1.to_u8()
    print("{x}".len() > 0)

## value.optional_else[u8]
fn s5()
    o := wrap_u8(1.to_u8())
    x := o else 2.to_u8()
    print(1)

## value.optional_if[u8]
fn s6()
    o := wrap_u8(1.to_u8())
    if x := o
        print(1)

## value.optional_none[u8]
fn s7()
    o := nothing_u8()
    print(o == none)

## value.optional_print[u8]
fn s8()
    o := wrap_u8(1.to_u8())
    print(o)

## value.tuple[u8]
fn s9()
    t := (1.to_u8(), 1)
    print(t.1)
    a, b := t
    print(b)

## value.tuple_eq[u8]
fn s10()
    t := (1.to_u8(), 1)
    print(t == (1.to_u8(), 1))

## value.tuple_print[u8]
fn s11()
    t := (1.to_u8(), 1)
    print(t)

## value.tuple_list_sorted[u8]
fn s12()
    xs := [(2.to_u8(), 1), (1.to_u8(), 2)]
    print(xs.sorted().len())

## value.tuple_key[u8]
fn s13()
    mut m := Map[(u8, int), int]()
    m[(1.to_u8(), 1)] = 2
    print(m[(1.to_u8(), 1)])

## value.struct_field[u8]
fn s14()
    b := Box_u8(items: [1.to_u8()])
    c := b
    print(c == b)

## value.struct_print[u8]
fn s15()
    b := Box_u8(items: [1.to_u8()])
    print(b)

## value.ref[u8]
fn s16()
    r := ref Box_u8(items: [1.to_u8()])
    s := r
    s.items.push(2.to_u8())
    print(r.items.len())

## value.generic_id[u8]
fn s17()
    x := ident(1.to_u8())
    print(1)

## value.generic_box[u8]
fn s18()
    g := GBox(v: 1.to_u8())
    print(g.v == 1.to_u8())

## value.fn_value[u8]
fn s19()
    f := |x u8| x
    y := f(1.to_u8())
    print(1)

## value.closure_capture[u8]
fn s20()
    a := 1.to_u8()
    f := || a
    y := f()
    print(1)

## value.match_eq[u8]
fn s21()
    x := 1.to_u8()
    print(if x == 1.to_u8() then 1 else 0)

## value.const_list[u8]
fn s22()
    print(K_u8.len())

fn main()
    print("-- value.eq[u8]")
    s0()
    print("-- value.lt[u8]")
    s1()
    print("-- value.print[u8]")
    s2()
    print("-- value.interp[u8]")
    s3()
    print("-- value.to_str_len[u8]")
    s4()
    print("-- value.optional_else[u8]")
    s5()
    print("-- value.optional_if[u8]")
    s6()
    print("-- value.optional_none[u8]")
    s7()
    print("-- value.optional_print[u8]")
    s8()
    print("-- value.tuple[u8]")
    s9()
    print("-- value.tuple_eq[u8]")
    s10()
    print("-- value.tuple_print[u8]")
    s11()
    print("-- value.tuple_list_sorted[u8]")
    s12()
    print("-- value.tuple_key[u8]")
    s13()
    print("-- value.struct_field[u8]")
    s14()
    print("-- value.struct_print[u8]")
    s15()
    print("-- value.ref[u8]")
    s16()
    print("-- value.generic_id[u8]")
    s17()
    print("-- value.generic_box[u8]")
    s18()
    print("-- value.fn_value[u8]")
    s19()
    print("-- value.closure_capture[u8]")
    s20()
    print("-- value.match_eq[u8]")
    s21()
    print("-- value.const_list[u8]")
    s22()
