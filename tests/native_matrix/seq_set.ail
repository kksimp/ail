struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_set
    items List[Set[int]]

fn add_set(mut xs List[Set[int]], x Set[int])
    xs.push(x)

fn wrap_set(x Set[int]) Set[int]?
    x

fn nothing_set() Set[int]?
    none

K_set := [{1}, {2}]

## seq.of_collect[set]
fn s0()
    s := Seq.of([{1}, {2}])
    print(s.collect().len())

## seq.map_filter[set]
fn s1()
    s := Seq.of([{1}, {2}])
    print(s.filter(|x| x == {1}).map(|x| x.len()).collect().len())

## seq.take_skip[set]
fn s2()
    s := Seq.of([{1}, {2}, {3}])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[set]
fn s3()
    s := Seq.of([{1}, {2}])
    print(s.enumerate().collect().len())

## seq.zip_chain[set]
fn s4()
    s := Seq.of([{1}, {2}])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[set]
fn s5()
    s := Seq.of([{1}])
    t := Seq.of([{2}])
    print(s.chain(move t).collect().len())

## seq.next[set]
fn s6()
    mut s := Seq.of([{1}, {2}])
    if x := s.next()
        print(1)

## seq.for[set]
fn s7()
    s := Seq.of([{1}, {2}])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[set]
fn s8()
    s := Seq.of([{1}, {2}])
    print(s.count(|x| x == {1}))

## seq.fold[set]
fn s9()
    s := Seq.of([{1}, {2}])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[set]
fn s10()
    s := Seq.of([{1}, {2}])
    if x := s.find(|x| x == {2})
        print(1)

## seq.flat_map[set]
fn s11()
    s := Seq.of([{1}, {2}])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[set]
fn s12()
    s := Seq.of([{1}, {2}])
    print(s.take_while(|x| x == {1}).collect().len())

## seq.skip_while[set]
fn s13()
    s := Seq.of([{1}, {2}])
    print(s.skip_while(|x| x == {1}).collect().len())

fn main()
    print("-- seq.of_collect[set]")
    s0()
    print("-- seq.map_filter[set]")
    s1()
    print("-- seq.take_skip[set]")
    s2()
    print("-- seq.enumerate[set]")
    s3()
    print("-- seq.zip_chain[set]")
    s4()
    print("-- seq.chain[set]")
    s5()
    print("-- seq.next[set]")
    s6()
    print("-- seq.for[set]")
    s7()
    print("-- seq.count_any[set]")
    s8()
    print("-- seq.fold[set]")
    s9()
    print("-- seq.find[set]")
    s10()
    print("-- seq.flat_map[set]")
    s11()
    print("-- seq.while[set]")
    s12()
    print("-- seq.skip_while[set]")
    s13()
