struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_int
    items List[int]

fn add_int(mut xs List[int], x int)
    xs.push(x)

fn wrap_int(x int) int?
    x

fn nothing_int() int?
    none

K_int := [1, 2]

## mapk.literal[int]
fn s0()
    m := {1: 1, 2: 2}
    print(m.len())

## mapk.empty[int]
fn s1()
    m := Map[int, int]()
    print(m.len())

## mapk.typed_by_use[int]
fn s2()
    mut m := {}
    m[1] += 1
    print(m.len())

## mapk.index[int]
fn s3()
    m := {1: 1}
    print(m[1])

## mapk.assign[int]
fn s4()
    mut m := Map[int, int]()
    m[1] = 1
    m[2] = 2
    print(m.len())

## mapk.op_assign[int]
fn s5()
    mut m := Map[int, int]()
    m[1] += 3
    print(m[1])

## mapk.get[int]
fn s6()
    m := {1: 1}
    print(m.get(1) else 0)

## mapk.get_or[int]
fn s7()
    m := {1: 1}
    print(m.get_or(2, 7))

## mapk.contains[int]
fn s8()
    m := {1: 1}
    print(m.contains(1))

## mapk.remove[int]
fn s9()
    mut m := {1: 1, 2: 2}
    print(m.remove(1) else 0)

## mapk.keys_values[int]
fn s10()
    m := {1: 1, 2: 2}
    print(m.keys().len() + m.values().len())

## mapk.keys_sorted[int]
fn s11()
    m := {2: 1, 1: 2}
    print(m.keys().sorted().len())

## mapk.top[int]
fn s12()
    m := {1: 1, 2: 2}
    print(m.top(1).len())

## mapk.for[int]
fn s13()
    m := {1: 1, 2: 2}
    mut n := 0
    for k, v in m
        n += v
    print(n)

## mapk.any_all_count[int]
fn s14()
    m := {1: 1, 2: 2}
    print(m.any(|k, v| v > 1))
    print(m.all(|k, v| v > 1))
    print(m.count(|k, v| v > 1))

## mapk.fold[int]
fn s15()
    m := {1: 1, 2: 2}
    print(m.fold(0, |acc, k, v| acc + v))

## mapk.filter[int]
fn s16()
    m := {1: 1, 2: 2}
    print(m.filter(|k, v| v > 1).len())

## mapk.map[int]
fn s17()
    m := {1: 1, 2: 2}
    print(m.map(|k, v| v).len())

## mapk.flat_map[int]
fn s18()
    m := {1: 1, 2: 2}
    print(m.flat_map(|k, v| [v, v]).len())

## mapk.map_values[int]
fn s19()
    m := {1: 1, 2: 2}
    print(m.map_values(|k, v| v * 2).len())

## mapk.push[int]
fn s20()
    mut m := Map[int, List[int]]()
    m.push(1, 1)
    m.push(1, 2)
    print(m[1].len())

## mapk.eq[int]
fn s21()
    m := {1: 1}
    print(m == {1: 1})

## mapk.print[int]
fn s22()
    m := {1: 1}
    print(m)

## mapk.is_empty[int]
fn s23()
    m := {1: 1}
    print(m.is_empty())

fn main()
    print("-- mapk.literal[int]")
    s0()
    print("-- mapk.empty[int]")
    s1()
    print("-- mapk.typed_by_use[int]")
    s2()
    print("-- mapk.index[int]")
    s3()
    print("-- mapk.assign[int]")
    s4()
    print("-- mapk.op_assign[int]")
    s5()
    print("-- mapk.get[int]")
    s6()
    print("-- mapk.get_or[int]")
    s7()
    print("-- mapk.contains[int]")
    s8()
    print("-- mapk.remove[int]")
    s9()
    print("-- mapk.keys_values[int]")
    s10()
    print("-- mapk.keys_sorted[int]")
    s11()
    print("-- mapk.top[int]")
    s12()
    print("-- mapk.for[int]")
    s13()
    print("-- mapk.any_all_count[int]")
    s14()
    print("-- mapk.fold[int]")
    s15()
    print("-- mapk.filter[int]")
    s16()
    print("-- mapk.map[int]")
    s17()
    print("-- mapk.flat_map[int]")
    s18()
    print("-- mapk.map_values[int]")
    s19()
    print("-- mapk.push[int]")
    s20()
    print("-- mapk.eq[int]")
    s21()
    print("-- mapk.print[int]")
    s22()
    print("-- mapk.is_empty[int]")
    s23()
