struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_tuple
    items List[(int, str)]

fn add_tuple(mut xs List[(int, str)], x (int, str))
    xs.push(x)

fn wrap_tuple(x (int, str)) (int, str)?
    x

fn nothing_tuple() (int, str)?
    none

K_tuple := [(1, "a"), (2, "b")]

## seq.of_collect[tuple]
fn s0()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.collect().len())

## seq.map_filter[tuple]
fn s1()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.filter(|x| x == (1, "a")).map(|x| x.0).collect().len())

## seq.take_skip[tuple]
fn s2()
    s := Seq.of([(1, "a"), (2, "b"), (3, "c")])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[tuple]
fn s3()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.enumerate().collect().len())

## seq.zip_chain[tuple]
fn s4()
    s := Seq.of([(1, "a"), (2, "b")])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[tuple]
fn s5()
    s := Seq.of([(1, "a")])
    t := Seq.of([(2, "b")])
    print(s.chain(move t).collect().len())

## seq.next[tuple]
fn s6()
    mut s := Seq.of([(1, "a"), (2, "b")])
    if x := s.next()
        print(1)

## seq.for[tuple]
fn s7()
    s := Seq.of([(1, "a"), (2, "b")])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[tuple]
fn s8()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.count(|x| x == (1, "a")))

## seq.fold[tuple]
fn s9()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[tuple]
fn s10()
    s := Seq.of([(1, "a"), (2, "b")])
    if x := s.find(|x| x == (2, "b"))
        print(1)

## seq.flat_map[tuple]
fn s11()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[tuple]
fn s12()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.take_while(|x| x == (1, "a")).collect().len())

## seq.skip_while[tuple]
fn s13()
    s := Seq.of([(1, "a"), (2, "b")])
    print(s.skip_while(|x| x == (1, "a")).collect().len())

fn main()
    print("-- seq.of_collect[tuple]")
    s0()
    print("-- seq.map_filter[tuple]")
    s1()
    print("-- seq.take_skip[tuple]")
    s2()
    print("-- seq.enumerate[tuple]")
    s3()
    print("-- seq.zip_chain[tuple]")
    s4()
    print("-- seq.chain[tuple]")
    s5()
    print("-- seq.next[tuple]")
    s6()
    print("-- seq.for[tuple]")
    s7()
    print("-- seq.count_any[tuple]")
    s8()
    print("-- seq.fold[tuple]")
    s9()
    print("-- seq.find[tuple]")
    s10()
    print("-- seq.flat_map[tuple]")
    s11()
    print("-- seq.while[tuple]")
    s12()
    print("-- seq.skip_while[tuple]")
    s13()
