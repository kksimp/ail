struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_ordstruct
    items List[Q]

fn add_ordstruct(mut xs List[Q], x Q)
    xs.push(x)

fn wrap_ordstruct(x Q) Q?
    x

fn nothing_ordstruct() Q?
    none

K_ordstruct := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]

## list.literal[ordstruct]
fn s0()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 3, name: "c")]
    print(xs.len())

## list.empty[ordstruct]
fn s1()
    xs := List[Q]()
    print(xs.len())

## list.typed_by_push[ordstruct]
fn s2()
    mut xs := []
    xs.push(Q(n: 1, name: "a"))
    print(xs.len())

## list.len[ordstruct]
fn s3()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.len())

## list.is_empty[ordstruct]
fn s4()
    xs := [Q(n: 1, name: "a")]
    print(xs.is_empty())

## list.index[ordstruct]
fn s5()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    x := xs[1]
    print(x.n == x.n)

## list.index_assign[ordstruct]
fn s6()
    mut xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    xs[0] = Q(n: 3, name: "c")
    print(xs.len())

## list.slice[ordstruct]
fn s7()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 3, name: "c")]
    print(xs[1..].len() + xs[..1].len() + xs[0..2].len())

## list.push[ordstruct]
fn s8()
    mut xs := [Q(n: 1, name: "a")]
    xs.push(Q(n: 2, name: "b"))
    print(xs.len())

## list.pop[ordstruct]
fn s9()
    mut xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    if x := xs.pop()
        print(xs.len())

## list.swap[ordstruct]
fn s10()
    mut xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    xs.swap(0, 1)
    print(xs.len())

## list.first_last[ordstruct]
fn s11()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    if x := xs.first()
        print(1)
    if x := xs.last()
        print(2)

## list.insert[ordstruct]
fn s12()
    mut xs := [Q(n: 1, name: "a")]
    xs.insert(0, Q(n: 2, name: "b"))
    print(xs.len())

## list.remove_at[ordstruct]
fn s13()
    mut xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    x := xs.remove_at(0)
    print(xs.len())

## list.extend[ordstruct]
fn s14()
    mut xs := [Q(n: 1, name: "a")]
    xs.extend([Q(n: 2, name: "b"), Q(n: 3, name: "c")])
    print(xs.len())

## list.clear[ordstruct]
fn s15()
    mut xs := [Q(n: 1, name: "a")]
    xs.clear()
    print(xs.len())

## list.reverse[ordstruct]
fn s16()
    mut xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    xs.reverse()
    print(xs.len())

## list.reversed[ordstruct]
fn s17()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.reversed().len())

## list.contains[ordstruct]
fn s18()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.contains(Q(n: 2, name: "b")))

## list.index_of[ordstruct]
fn s19()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.index_of(Q(n: 2, name: "b")) else -1)

## list.join[ordstruct]
fn s20()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.join(",").len() > 0)

## list.min_max[ordstruct]
fn s21()
    xs := [Q(n: 2, name: "b"), Q(n: 1, name: "a"), Q(n: 3, name: "c")]
    if x := xs.min()
        print(1)
    if x := xs.max()
        print(2)

## list.sorted[ordstruct]
fn s22()
    xs := [Q(n: 3, name: "c"), Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.sorted().len())

## list.sort[ordstruct]
fn s23()
    mut xs := [Q(n: 3, name: "c"), Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    xs.sort()
    print(xs.len())

## list.sorted_by[ordstruct]
fn s24()
    xs := [Q(n: 3, name: "c"), Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.sorted(by: |x| x.n).len())

## list.sort_by[ordstruct]
fn s25()
    mut xs := [Q(n: 3, name: "c"), Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    xs.sort(by: |x| x.n)
    print(xs.len())

## list.min_by[ordstruct]
fn s26()
    xs := [Q(n: 3, name: "c"), Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    if x := xs.min(by: |x| x.n)
        print(1)
    if x := xs.max(by: |x| x.n)
        print(2)

## list.take_skip[ordstruct]
fn s27()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 3, name: "c")]
    print(xs.take(2).len() + xs.skip(1).len())

## list.set_ops[ordstruct]
fn s28()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    ys := [Q(n: 2, name: "b"), Q(n: 3, name: "c")]
    print(xs.union(ys).len() + xs.intersect(ys).len() + xs.difference(ys).len())

## list.chunks_windows[ordstruct]
fn s29()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 3, name: "c")]
    print(xs.chunks(2).len() + xs.windows(2).len())

## list.counts[ordstruct]
fn s30()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 1, name: "a")]
    c := xs.counts()
    print(c.len())

## list.flatten[ordstruct]
fn s31()
    xs := [[Q(n: 1, name: "a")], [Q(n: 2, name: "b"), Q(n: 3, name: "c")]]
    print(xs.flatten().len())

## list.enumerate[ordstruct]
fn s32()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    for i, x in xs.enumerate()
        print(i)

## list.any_all[ordstruct]
fn s33()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.any(|x| x == Q(n: 1, name: "a")))
    print(xs.all(|x| x == Q(n: 1, name: "a")))

## list.find[ordstruct]
fn s34()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    if x := xs.find(|x| x == Q(n: 2, name: "b"))
        print(1)

## list.filter[ordstruct]
fn s35()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.filter(|x| x == Q(n: 1, name: "a")).len())

## list.map[ordstruct]
fn s36()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.map(|x| x.n).len())

## list.map_to_self[ordstruct]
fn s37()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.map(|x| x).len())

## list.group_by[ordstruct]
fn s38()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 1, name: "a")]
    g := xs.group_by(|x| x.n)
    print(g.len())

## list.count[ordstruct]
fn s39()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 1, name: "a")]
    print(xs.count(|x| x == Q(n: 1, name: "a")))

## list.fold[ordstruct]
fn s40()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.fold(0, |acc, x| acc + 1))

## list.flat_map[ordstruct]
fn s41()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.flat_map(|x| [x, x]).len())

## list.take_skip_while[ordstruct]
fn s42()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs.take_while(|x| x == Q(n: 1, name: "a")).len() + xs.skip_while(|x| x == Q(n: 1, name: "a")).len())

## list.zip[ordstruct]
fn s43()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    for x, y in xs.zip([1, 2])
        print(y)

## list.zip_into[ordstruct]
fn s44()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    for y, x in [1, 2].zip(xs)
        print(y)

## list.for[ordstruct]
fn s45()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    mut n := 0
    for x in xs
        n += 1
    print(n)

## list.for_mut[ordstruct]
fn s46()
    mut xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    for mut x in xs
        x = Q(n: 3, name: "c")
    print(xs.len())

## list.comprehension[ordstruct]
fn s47()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    ys := [x for x in xs if x == Q(n: 1, name: "a")]
    print(ys.len())

## list.set_comprehension[ordstruct]
fn s48()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 1, name: "a")]
    s := {x for x in xs}
    print(s.len())

## list.map_comprehension[ordstruct]
fn s49()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    m := {x: 1 for x in xs}
    print(m.len())

## list.eq[ordstruct]
fn s50()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    ys := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs == ys)
    print(xs != [Q(n: 3, name: "c")])

## list.lt[ordstruct]
fn s51()
    xs := [Q(n: 1, name: "a")]
    ys := [Q(n: 2, name: "b")]
    print(xs < ys)

## list.print[ordstruct]
fn s52()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print(xs)

## list.interp[ordstruct]
fn s53()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    print("{xs}".len() > 0)

## list.nested_push[ordstruct]
fn s54()
    mut xs := [[Q(n: 1, name: "a")]]
    xs[0].push(Q(n: 2, name: "b"))
    print(xs[0].len())

## list.in_struct[ordstruct]
fn s55()
    mut b := Box_ordstruct(items: [Q(n: 1, name: "a")])
    b.items.push(Q(n: 2, name: "b"))
    print(b.items.len())

## list.pass_mut[ordstruct]
fn s56()
    mut xs := [Q(n: 1, name: "a")]
    add_ordstruct(mut xs, Q(n: 2, name: "b"))
    print(xs.len())

## list.generic_first[ordstruct]
fn s57()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    if x := first_of(xs)
        print(1)

## list.generic_ord[ordstruct]
fn s58()
    xs := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]
    if x := biggest(xs)
        print(1)

## list.contains_list[ordstruct]
fn s59()
    xs := [[Q(n: 1, name: "a")], [Q(n: 2, name: "b")]]
    print(xs.contains([Q(n: 2, name: "b")]))

## list.sorted_nested[ordstruct]
fn s60()
    xs := [[Q(n: 2, name: "b")], [Q(n: 1, name: "a")]]
    print(xs.sorted().len())

