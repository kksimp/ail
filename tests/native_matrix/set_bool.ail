struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bool
    items List[bool]

fn add_bool(mut xs List[bool], x bool)
    xs.push(x)

fn wrap_bool(x bool) bool?
    x

fn nothing_bool() bool?
    none

K_bool := [false, true]

## set.literal[bool]
fn s0()
    s := {false, true}
    print(s.len())

## set.empty[bool]
fn s1()
    s := Set[bool]()
    print(s.len())

## set.from_list[bool]
fn s2()
    s := {x for x in [false, true, false]}
    print(s.len())

## set.add_remove[bool]
fn s3()
    mut s := Set[bool]()
    print(s.add(false))
    print(s.remove(false))

## set.contains[bool]
fn s4()
    s := {false, true}
    print(s.contains(false))

## set.is_empty[bool]
fn s5()
    s := {false}
    print(s.is_empty())

## set.to_list[bool]
fn s6()
    s := {false, true}
    print(s.to_list().len())

## set.is_subset[bool]
fn s7()
    s := {false}
    t := {false, true}
    print(s.is_subset(t))

## set.any_all_find[bool]
fn s8()
    s := {false, true}
    print(s.any(|x| x == false))
    print(s.all(|x| x == false))
    if x := s.find(|x| x == true)
        print(1)

## set.filter_map[bool]
fn s9()
    s := {false, true}
    print(s.filter(|x| x == false).len() + s.map(|x| x).len())

## set.group_by[bool]
fn s10()
    s := {false, true}
    print(s.group_by(|x| x).len())

## set.count_fold[bool]
fn s11()
    s := {false, true}
    print(s.count(|x| x == false))
    print(s.fold(0, |acc, x| acc + 1))

## set.flat_map[bool]
fn s12()
    s := {false, true}
    print(s.flat_map(|x| [x]).len())

## set.zip_enumerate[bool]
fn s13()
    s := {false, true}
    print(s.zip([1, 2]).len() + s.enumerate().len())

## set.for[bool]
fn s14()
    s := {false, true}
    mut n := 0
    for x in s
        n += 1
    print(n)

## set.eq[bool]
fn s15()
    s := {false, true}
    print(s == {true, false})

## set.print[bool]
fn s16()
    s := {false}
    print(s)

## set.in_map[bool]
fn s17()
    mut m := Map[str, Set[bool]]()
    m["a"] = Set[bool]()
    m["a"].add(false)
    print(m["a"].len())

## set.in_list[bool]
fn s18()
    mut xs := [Set[bool]()]
    xs[0].add(false)
    print(xs[0].len())

fn main()
    print("-- set.literal[bool]")
    s0()
    print("-- set.empty[bool]")
    s1()
    print("-- set.from_list[bool]")
    s2()
    print("-- set.add_remove[bool]")
    s3()
    print("-- set.contains[bool]")
    s4()
    print("-- set.is_empty[bool]")
    s5()
    print("-- set.to_list[bool]")
    s6()
    print("-- set.is_subset[bool]")
    s7()
    print("-- set.any_all_find[bool]")
    s8()
    print("-- set.filter_map[bool]")
    s9()
    print("-- set.group_by[bool]")
    s10()
    print("-- set.count_fold[bool]")
    s11()
    print("-- set.flat_map[bool]")
    s12()
    print("-- set.zip_enumerate[bool]")
    s13()
    print("-- set.for[bool]")
    s14()
    print("-- set.eq[bool]")
    s15()
    print("-- set.print[bool]")
    s16()
    print("-- set.in_map[bool]")
    s17()
    print("-- set.in_list[bool]")
    s18()
