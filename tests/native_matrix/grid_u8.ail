struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_u8
    items List[u8]

fn add_u8(mut xs List[u8], x u8)
    xs.push(x)

fn wrap_u8(x u8) u8?
    x

fn nothing_u8() u8?
    none

K_u8 := [1.to_u8(), 2.to_u8()]

## grid.fill[u8]
fn s0()
    g := Grid.fill(2, 3, 1.to_u8())
    print(g.rows * g.cols)

## grid.from[u8]
fn s1()
    g := Grid.from([[1.to_u8(), 2.to_u8()], [3.to_u8(), 1.to_u8()]])
    print(g.cells.len())

## grid.index[u8]
fn s2()
    g := Grid.fill(2, 2, 1.to_u8())
    x := g[1, 1]
    print(x == x)

## grid.index_assign[u8]
fn s3()
    mut g := Grid.fill(2, 2, 1.to_u8())
    g[0, 1] = 2.to_u8()
    print(g.rows)

## grid.row[u8]
fn s4()
    g := Grid.from([[1.to_u8(), 2.to_u8()], [3.to_u8(), 1.to_u8()]])
    print(g.row(1).len())

## grid.to_list[u8]
fn s5()
    g := Grid.fill(2, 2, 1.to_u8())
    print(g.to_list().len())

## grid.cells_for[u8]
fn s6()
    g := Grid.fill(2, 2, 1.to_u8())
    mut n := 0
    for x in g.cells
        n += 1
    print(n)

fn main()
    print("-- grid.fill[u8]")
    s0()
    print("-- grid.from[u8]")
    s1()
    print("-- grid.index[u8]")
    s2()
    print("-- grid.index_assign[u8]")
    s3()
    print("-- grid.row[u8]")
    s4()
    print("-- grid.to_list[u8]")
    s5()
    print("-- grid.cells_for[u8]")
    s6()
