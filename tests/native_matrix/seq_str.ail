struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_str
    items List[str]

fn add_str(mut xs List[str], x str)
    xs.push(x)

fn wrap_str(x str) str?
    x

fn nothing_str() str?
    none

K_str := ["a", "b"]

## seq.of_collect[str]
fn s0()
    s := Seq.of(["a", "b"])
    print(s.collect().len())

## seq.map_filter[str]
fn s1()
    s := Seq.of(["a", "b"])
    print(s.filter(|x| x == "a").map(|x| x).collect().len())

## seq.take_skip[str]
fn s2()
    s := Seq.of(["a", "b", "c"])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[str]
fn s3()
    s := Seq.of(["a", "b"])
    print(s.enumerate().collect().len())

## seq.zip_chain[str]
fn s4()
    s := Seq.of(["a", "b"])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[str]
fn s5()
    s := Seq.of(["a"])
    t := Seq.of(["b"])
    print(s.chain(move t).collect().len())

## seq.next[str]
fn s6()
    mut s := Seq.of(["a", "b"])
    if x := s.next()
        print(1)

## seq.for[str]
fn s7()
    s := Seq.of(["a", "b"])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[str]
fn s8()
    s := Seq.of(["a", "b"])
    print(s.count(|x| x == "a"))

## seq.fold[str]
fn s9()
    s := Seq.of(["a", "b"])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[str]
fn s10()
    s := Seq.of(["a", "b"])
    if x := s.find(|x| x == "b")
        print(1)

## seq.flat_map[str]
fn s11()
    s := Seq.of(["a", "b"])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[str]
fn s12()
    s := Seq.of(["a", "b"])
    print(s.take_while(|x| x == "a").collect().len())

## seq.skip_while[str]
fn s13()
    s := Seq.of(["a", "b"])
    print(s.skip_while(|x| x == "a").collect().len())

fn main()
    print("-- seq.of_collect[str]")
    s0()
    print("-- seq.map_filter[str]")
    s1()
    print("-- seq.take_skip[str]")
    s2()
    print("-- seq.enumerate[str]")
    s3()
    print("-- seq.zip_chain[str]")
    s4()
    print("-- seq.chain[str]")
    s5()
    print("-- seq.next[str]")
    s6()
    print("-- seq.for[str]")
    s7()
    print("-- seq.count_any[str]")
    s8()
    print("-- seq.fold[str]")
    s9()
    print("-- seq.find[str]")
    s10()
    print("-- seq.flat_map[str]")
    s11()
    print("-- seq.while[str]")
    s12()
    print("-- seq.skip_while[str]")
    s13()
