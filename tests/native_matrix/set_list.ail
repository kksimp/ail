struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_list
    items List[List[int]]

fn add_list(mut xs List[List[int]], x List[int])
    xs.push(x)

fn wrap_list(x List[int]) List[int]?
    x

fn nothing_list() List[int]?
    none

K_list := [[1], [1, 2]]

## set.literal[list]
fn s0()
    s := {[1], [1, 2]}
    print(s.len())

## set.empty[list]
fn s1()
    s := Set[List[int]]()
    print(s.len())

## set.from_list[list]
fn s2()
    s := {x for x in [[1], [1, 2], [1]]}
    print(s.len())

## set.add_remove[list]
fn s3()
    mut s := Set[List[int]]()
    print(s.add([1]))
    print(s.remove([1]))

## set.contains[list]
fn s4()
    s := {[1], [1, 2]}
    print(s.contains([1]))

## set.is_empty[list]
fn s5()
    s := {[1]}
    print(s.is_empty())

## set.sorted[list]
fn s6()
    s := {[1, 2], [1]}
    print(s.sorted().len())

## set.is_subset[list]
fn s7()
    s := {[1]}
    t := {[1], [1, 2]}
    print(s.is_subset(t))

## set.set_ops[list]
fn s8()
    s := {[1], [1, 2]}
    t := {[1, 2], [2]}
    print(s.union(t).len() + s.intersect(t).len() + s.difference(t).len())

## set.any_all_find[list]
fn s9()
    s := {[1], [1, 2]}
    print(s.any(|x| x == [1]))
    print(s.all(|x| x == [1]))
    if x := s.find(|x| x == [1, 2])
        print(1)

## set.filter_map[list]
fn s10()
    s := {[1], [1, 2]}
    print(s.filter(|x| x == [1]).len() + s.map(|x| x.len()).len())

## set.group_by[list]
fn s11()
    s := {[1], [1, 2]}
    print(s.group_by(|x| x.len()).len())

## set.count_fold[list]
fn s12()
    s := {[1], [1, 2]}
    print(s.count(|x| x == [1]))
    print(s.fold(0, |acc, x| acc + 1))

## set.flat_map[list]
fn s13()
    s := {[1], [1, 2]}
    print(s.flat_map(|x| [x]).len())

## set.take_skip[list]
fn s14()
    s := {[1], [1, 2], [2]}
    print(s.take(1).len() + s.skip(1).len() + s.take_while(|x| x == [1]).len() + s.skip_while(|x| x == [1]).len())

## set.zip_enumerate[list]
fn s15()
    s := {[1], [1, 2]}
    print(s.zip([1, 2]).len() + s.enumerate().len())

## set.min_max[list]
fn s16()
    s := {[1], [1, 2]}
    if x := s.min()
        print(1)
    if x := s.max()
        print(2)

## set.for[list]
fn s17()
    s := {[1], [1, 2]}
    mut n := 0
    for x in s
        n += 1
    print(n)

## set.eq[list]
fn s18()
    s := {[1], [1, 2]}
    print(s == {[1, 2], [1]})

## set.print[list]
fn s19()
    s := {[1]}
    print(s)

## set.in_map[list]
fn s20()
    mut m := Map[str, Set[List[int]]]()
    m["a"] = Set[List[int]]()
    m["a"].add([1])
    print(m["a"].len())

## set.in_list[list]
fn s21()
    mut xs := [Set[List[int]]()]
    xs[0].add([1])
    print(xs[0].len())

fn main()
    print("-- set.literal[list]")
    s0()
    print("-- set.empty[list]")
    s1()
    print("-- set.from_list[list]")
    s2()
    print("-- set.add_remove[list]")
    s3()
    print("-- set.contains[list]")
    s4()
    print("-- set.is_empty[list]")
    s5()
    print("-- set.sorted[list]")
    s6()
    print("-- set.is_subset[list]")
    s7()
    print("-- set.set_ops[list]")
    s8()
    print("-- set.any_all_find[list]")
    s9()
    print("-- set.filter_map[list]")
    s10()
    print("-- set.group_by[list]")
    s11()
    print("-- set.count_fold[list]")
    s12()
    print("-- set.flat_map[list]")
    s13()
    print("-- set.take_skip[list]")
    s14()
    print("-- set.zip_enumerate[list]")
    s15()
    print("-- set.min_max[list]")
    s16()
    print("-- set.for[list]")
    s17()
    print("-- set.eq[list]")
    s18()
    print("-- set.print[list]")
    s19()
    print("-- set.in_map[list]")
    s20()
    print("-- set.in_list[list]")
    s21()
