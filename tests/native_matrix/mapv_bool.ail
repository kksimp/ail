struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bool
    items List[bool]

fn add_bool(mut xs List[bool], x bool)
    xs.push(x)

fn wrap_bool(x bool) bool?
    x

fn nothing_bool() bool?
    none

K_bool := [false, true]

## mapv.literal[bool]
fn s0()
    m := {"a": false, "b": true}
    print(m.len())

## mapv.empty[bool]
fn s1()
    m := Map[str, bool]()
    print(m.len())

## mapv.index[bool]
fn s2()
    m := {"a": false}
    x := m["a"]
    print(x == x)

## mapv.assign[bool]
fn s3()
    mut m := Map[str, bool]()
    m["a"] = false
    print(m.len())

## mapv.get[bool]
fn s4()
    m := {"a": false}
    if x := m.get("a")
        print(1)

## mapv.get_else[bool]
fn s5()
    m := {"a": false}
    x := m.get("z") else true
    print(1)

## mapv.get_or[bool]
fn s6()
    m := {"a": false}
    x := m.get_or("b", true)
    print(1)

## mapv.remove[bool]
fn s7()
    mut m := {"a": false}
    if x := m.remove("a")
        print(m.len())

## mapv.values[bool]
fn s8()
    m := {"a": false, "b": true}
    print(m.values().len())

## mapv.for[bool]
fn s9()
    m := {"a": false, "b": true}
    mut n := 0
    for k, v in m
        n += 1
    print(n)

## mapv.map_values[bool]
fn s10()
    m := {"a": false}
    print(m.map_values(|k, v| v).len())

## mapv.filter[bool]
fn s11()
    m := {"a": false, "b": true}
    print(m.filter(|k, v| v == false).len())

## mapv.nested_update[bool]
fn s12()
    mut m := Map[str, List[bool]]()
    m["a"] = [false]
    m["a"].push(true)
    print(m["a"].len())

## mapv.eq[bool]
fn s13()
    m := {"a": false}
    print(m == {"a": false})

## mapv.print[bool]
fn s14()
    m := {"a": false}
    print(m)

fn main()
    print("-- mapv.literal[bool]")
    s0()
    print("-- mapv.empty[bool]")
    s1()
    print("-- mapv.index[bool]")
    s2()
    print("-- mapv.assign[bool]")
    s3()
    print("-- mapv.get[bool]")
    s4()
    print("-- mapv.get_else[bool]")
    s5()
    print("-- mapv.get_or[bool]")
    s6()
    print("-- mapv.remove[bool]")
    s7()
    print("-- mapv.values[bool]")
    s8()
    print("-- mapv.for[bool]")
    s9()
    print("-- mapv.map_values[bool]")
    s10()
    print("-- mapv.filter[bool]")
    s11()
    print("-- mapv.nested_update[bool]")
    s12()
    print("-- mapv.eq[bool]")
    s13()
    print("-- mapv.print[bool]")
    s14()
