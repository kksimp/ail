    print("-- list.any_all[bytes]")
    s34()
    print("-- list.find[bytes]")
    s35()
    print("-- list.filter[bytes]")
    s36()
    print("-- list.map[bytes]")
    s37()
    print("-- list.map_to_self[bytes]")
    s38()
    print("-- list.group_by[bytes]")
    s39()
    print("-- list.count[bytes]")
    s40()
    print("-- list.fold[bytes]")
    s41()
    print("-- list.flat_map[bytes]")
    s42()
    print("-- list.take_skip_while[bytes]")
    s43()
    print("-- list.zip[bytes]")
    s44()
    print("-- list.zip_into[bytes]")
    s45()
    print("-- list.for[bytes]")
    s46()
    print("-- list.for_mut[bytes]")
    s47()
    print("-- list.comprehension[bytes]")
    s48()
    print("-- list.set_comprehension[bytes]")
    s49()
    print("-- list.map_comprehension[bytes]")
    s50()
    print("-- list.eq[bytes]")
    s51()
    print("-- list.lt[bytes]")
    s52()
    print("-- list.print[bytes]")
    s53()
    print("-- list.interp[bytes]")
    s54()
    print("-- list.nested_push[bytes]")
    s55()
    print("-- list.in_struct[bytes]")
    s56()
    print("-- list.pass_mut[bytes]")
