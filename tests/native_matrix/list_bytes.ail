struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bytes
    items List[bytes]

fn add_bytes(mut xs List[bytes], x bytes)
    xs.push(x)

fn wrap_bytes(x bytes) bytes?
    x

fn nothing_bytes() bytes?
    none

K_bytes := [b"a", b"b"]

## list.literal[bytes]
fn s0()
    xs := [b"a", b"b", b"c"]
    print(xs.len())

## list.empty[bytes]
fn s1()
    xs := List[bytes]()
    print(xs.len())

## list.typed_by_push[bytes]
fn s2()
    mut xs := []
    xs.push(b"a")
    print(xs.len())

## list.len[bytes]
fn s3()
    xs := [b"a", b"b"]
    print(xs.len())

## list.is_empty[bytes]
fn s4()
    xs := [b"a"]
    print(xs.is_empty())

## list.index[bytes]
fn s5()
    xs := [b"a", b"b"]
    x := xs[1]
    print(x.len() == x.len())

## list.index_assign[bytes]
fn s6()
    mut xs := [b"a", b"b"]
    xs[0] = b"c"
    print(xs.len())

## list.slice[bytes]
fn s7()
    xs := [b"a", b"b", b"c"]
    print(xs[1..].len() + xs[..1].len() + xs[0..2].len())

## list.slice_method[bytes]
fn s8()
    xs := [b"a", b"b", b"c"]
    print(xs.slice(1).len() + xs.slice(0, 2).len())

## list.push[bytes]
fn s9()
    mut xs := [b"a"]
    xs.push(b"b")
    print(xs.len())

## list.pop[bytes]
fn s10()
    mut xs := [b"a", b"b"]
    if x := xs.pop()
        print(xs.len())

## list.swap[bytes]
fn s11()
    mut xs := [b"a", b"b"]
    xs.swap(0, 1)
    print(xs.len())

## list.first_last[bytes]
fn s12()
    xs := [b"a", b"b"]
    if x := xs.first()
        print(1)
    if x := xs.last()
        print(2)

## list.insert[bytes]
fn s13()
    mut xs := [b"a"]
    xs.insert(0, b"b")
    print(xs.len())

## list.remove_at[bytes]
fn s14()
    mut xs := [b"a", b"b"]
    x := xs.remove_at(0)
    print(xs.len())

## list.extend[bytes]
fn s15()
    mut xs := [b"a"]
    xs.extend([b"b", b"c"])
    print(xs.len())

## list.clear[bytes]
fn s16()
    mut xs := [b"a"]
    xs.clear()
    print(xs.len())

## list.reverse[bytes]
fn s17()
    mut xs := [b"a", b"b"]
    xs.reverse()
    print(xs.len())

## list.reversed[bytes]
fn s18()
    xs := [b"a", b"b"]
    print(xs.reversed().len())

## list.contains[bytes]
fn s19()
    xs := [b"a", b"b"]
    print(xs.contains(b"b"))

## list.index_of[bytes]
fn s20()
    xs := [b"a", b"b"]
    print(xs.index_of(b"b") else -1)

## list.join[bytes]
fn s21()
    xs := [b"a", b"b"]
    print(xs.join(",").len() > 0)

## list.min_max[bytes]
fn s22()
    xs := [b"b", b"a", b"c"]
    if x := xs.min()
        print(1)
    if x := xs.max()
        print(2)

## list.sorted[bytes]
fn s23()
    xs := [b"c", b"a", b"b"]
    print(xs.sorted().len())

## list.sort[bytes]
fn s24()
    mut xs := [b"c", b"a", b"b"]
    xs.sort()
    print(xs.len())

## list.sorted_by[bytes]
fn s25()
    xs := [b"c", b"a", b"b"]
    print(xs.sorted(by: |x| x.len()).len())

## list.sort_by[bytes]
fn s26()
    mut xs := [b"c", b"a", b"b"]
    xs.sort(by: |x| x.len())
    print(xs.len())

## list.min_by[bytes]
fn s27()
    xs := [b"c", b"a", b"b"]
    if x := xs.min(by: |x| x.len())
        print(1)
    if x := xs.max(by: |x| x.len())
        print(2)

## list.take_skip[bytes]
fn s28()
    xs := [b"a", b"b", b"c"]
    print(xs.take(2).len() + xs.skip(1).len())

## list.set_ops[bytes]
fn s29()
    xs := [b"a", b"b"]
    ys := [b"b", b"c"]
    print(xs.union(ys).len() + xs.intersect(ys).len() + xs.difference(ys).len())

## list.chunks_windows[bytes]
fn s30()
    xs := [b"a", b"b", b"c"]
    print(xs.chunks(2).len() + xs.windows(2).len())

## list.counts[bytes]
fn s31()
    xs := [b"a", b"b", b"a"]
    c := xs.counts()
    print(c.len())

## list.flatten[bytes]
fn s32()
    xs := [[b"a"], [b"b", b"c"]]
    print(xs.flatten().len())

## list.enumerate[bytes]
fn s33()
    xs := [b"a", b"b"]
    for i, x in xs.enumerate()
        print(i)

## list.any_all[bytes]
fn s34()
    xs := [b"a", b"b"]
    print(xs.any(|x| x == b"a"))
    print(xs.all(|x| x == b"a"))

## list.find[bytes]
fn s35()
    xs := [b"a", b"b"]
    if x := xs.find(|x| x == b"b")
        print(1)

## list.filter[bytes]
fn s36()
    xs := [b"a", b"b"]
    print(xs.filter(|x| x == b"a").len())

## list.map[bytes]
fn s37()
    xs := [b"a", b"b"]
    print(xs.map(|x| x.len()).len())

## list.map_to_self[bytes]
fn s38()
    xs := [b"a", b"b"]
    print(xs.map(|x| x).len())

## list.group_by[bytes]
fn s39()
    xs := [b"a", b"b", b"a"]
    g := xs.group_by(|x| x.len())
    print(g.len())

## list.count[bytes]
fn s40()
    xs := [b"a", b"b", b"a"]
    print(xs.count(|x| x == b"a"))

## list.fold[bytes]
fn s41()
    xs := [b"a", b"b"]
    print(xs.fold(0, |acc, x| acc + 1))

## list.flat_map[bytes]
fn s42()
    xs := [b"a", b"b"]
    print(xs.flat_map(|x| [x, x]).len())

## list.take_skip_while[bytes]
fn s43()
    xs := [b"a", b"b"]
    print(xs.take_while(|x| x == b"a").len() + xs.skip_while(|x| x == b"a").len())

## list.zip[bytes]
fn s44()
    xs := [b"a", b"b"]
    for x, y in xs.zip([1, 2])
        print(y)

## list.zip_into[bytes]
fn s45()
    xs := [b"a", b"b"]
    for y, x in [1, 2].zip(xs)
        print(y)

## list.for[bytes]
fn s46()
    xs := [b"a", b"b"]
    mut n := 0
    for x in xs
        n += 1
    print(n)

## list.for_mut[bytes]
fn s47()
    mut xs := [b"a", b"b"]
    for mut x in xs
        x = b"c"
    print(xs.len())

## list.comprehension[bytes]
fn s48()
    xs := [b"a", b"b"]
    ys := [x for x in xs if x == b"a"]
    print(ys.len())

## list.set_comprehension[bytes]
fn s49()
    xs := [b"a", b"b", b"a"]
    s := {x for x in xs}
    print(s.len())

## list.map_comprehension[bytes]
fn s50()
    xs := [b"a", b"b"]
    m := {x: 1 for x in xs}
    print(m.len())

## list.eq[bytes]
fn s51()
    xs := [b"a", b"b"]
    ys := [b"a", b"b"]
    print(xs == ys)
    print(xs != [b"c"])

## list.lt[bytes]
fn s52()
    xs := [b"a"]
    ys := [b"b"]
    print(xs < ys)

## list.print[bytes]
fn s53()
    xs := [b"a", b"b"]
    print(xs)

## list.interp[bytes]
fn s54()
    xs := [b"a", b"b"]
    print("{xs}".len() > 0)

## list.nested_push[bytes]
fn s55()
    mut xs := [[b"a"]]
    xs[0].push(b"b")
    print(xs[0].len())

## list.in_struct[bytes]
fn s56()
    mut b := Box_bytes(items: [b"a"])
    b.items.push(b"b")
    print(b.items.len())

## list.pass_mut[bytes]
fn s57()
    mut xs := [b"a"]
    add_bytes(mut xs, b"b")
    print(xs.len())

## list.generic_first[bytes]
fn s58()
    xs := [b"a", b"b"]
    if x := first_of(xs)
        print(1)

## list.generic_ord[bytes]
fn s59()
    xs := [b"a", b"b"]
    if x := biggest(xs)
        print(1)

## list.contains_list[bytes]
fn s60()
    xs := [[b"a"], [b"b"]]
    print(xs.contains([b"b"]))

## list.sorted_nested[bytes]
fn s61()
    xs := [[b"b"], [b"a"]]
    print(xs.sorted().len())

fn main()
    print("-- list.literal[bytes]")
    s0()
