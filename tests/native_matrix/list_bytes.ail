    s11()
    print("-- list.first_last[bytes]")
    s12()
    print("-- list.insert[bytes]")
    s13()
    print("-- list.remove_at[bytes]")
    s14()
    print("-- list.extend[bytes]")
    s15()
    print("-- list.clear[bytes]")
    s16()
    print("-- list.reverse[bytes]")
    s17()
    print("-- list.reversed[bytes]")
    s18()
    print("-- list.contains[bytes]")
    s19()
    print("-- list.index_of[bytes]")
    s20()
    print("-- list.join[bytes]")
    s21()
    print("-- list.min_max[bytes]")
    s22()
    print("-- list.sorted[bytes]")
    s23()
    print("-- list.sort[bytes]")
    s24()
    print("-- list.sorted_by[bytes]")
    s25()
    print("-- list.sort_by[bytes]")
