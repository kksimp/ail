struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bytes
    items List[bytes]

fn add_bytes(mut xs List[bytes], x bytes)
    xs.push(x)

fn wrap_bytes(x bytes) bytes?
    x

fn nothing_bytes() bytes?
    none

K_bytes := [b"a", b"b"]

## deque.empty_push[bytes]
fn s0()
    mut d := Deque[bytes]()
    d.push_back(b"a")
    d.push_front(b"b")
    print(d.len())

## deque.from[bytes]
fn s1()
    d := Deque.from([b"a", b"b"])
    print(d.len())

## deque.pop[bytes]
fn s2()
    mut d := Deque.from([b"a", b"b", b"c"])
    if x := d.pop_front()
        print(1)
    if x := d.pop_back()
        print(2)

## deque.first_last[bytes]
fn s3()
    d := Deque.from([b"a", b"b"])
    if x := d.first()
        print(1)
    if x := d.last()
        print(2)

## deque.index[bytes]
fn s4()
    d := Deque.from([b"a", b"b"])
    x := d[1]
    print(x.len() == x.len())

## deque.at_set[bytes]
fn s5()
    mut d := Deque.from([b"a", b"b"])
    d.set(0, b"c")
    x := d.at(0)
    print(d.len())

## deque.to_list[bytes]
fn s6()
    d := Deque.from([b"a", b"b"])
    print(d.to_list().len())

## deque.for[bytes]
fn s7()
    d := Deque.from([b"a", b"b"])
    mut n := 0
    for x in d
        n += 1
    print(n)

## deque.vocab[bytes]
fn s8()
    d := Deque.from([b"a", b"b"])
    print(d.filter(|x| x == b"a").len() + d.map(|x| x.len()).len() + d.flat_map(|x| [x]).len())
    print(d.any(|x| x == b"a"))
    print(d.all(|x| x == b"a"))
    print(d.count(|x| x == b"a"))
    print(d.fold(0, |acc, x| acc + 1))
    if x := d.find(|x| x == b"a")
        print(1)

## deque.take_skip[bytes]
fn s9()
    d := Deque.from([b"a", b"b", b"c"])
    print(d.take(1).len() + d.skip(1).len() + d.take_while(|x| x == b"a").len() + d.skip_while(|x| x == b"a").len())

## deque.enumerate_zip[bytes]
fn s10()
    d := Deque.from([b"a", b"b"])
    print(d.enumerate().len() + d.zip([1, 2]).len())

## deque.is_empty[bytes]
fn s11()
    d := Deque[bytes]()
    print(d.is_empty())

fn main()
    print("-- deque.empty_push[bytes]")
    s0()
    print("-- deque.from[bytes]")
    s1()
    print("-- deque.pop[bytes]")
    s2()
    print("-- deque.first_last[bytes]")
    s3()
    print("-- deque.index[bytes]")
    s4()
    print("-- deque.at_set[bytes]")
    s5()
    print("-- deque.to_list[bytes]")
    s6()
    print("-- deque.for[bytes]")
    s7()
    print("-- deque.vocab[bytes]")
    s8()
    print("-- deque.take_skip[bytes]")
    s9()
    print("-- deque.enumerate_zip[bytes]")
    s10()
    print("-- deque.is_empty[bytes]")
    s11()
