struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_map
    items List[Map[str, int]]

fn add_map(mut xs List[Map[str, int]], x Map[str, int])
    xs.push(x)

fn wrap_map(x Map[str, int]) Map[str, int]?
    x

fn nothing_map() Map[str, int]?
    none

K_map := [{"a": 1}, {"b": 2}]

## deque.empty_push[map]
fn s0()
    mut d := Deque[Map[str, int]]()
    d.push_back({"a": 1})
    d.push_front({"b": 2})
    print(d.len())

## deque.from[map]
fn s1()
    d := Deque.from([{"a": 1}, {"b": 2}])
    print(d.len())

## deque.pop[map]
fn s2()
    mut d := Deque.from([{"a": 1}, {"b": 2}, {"c": 3}])
    if x := d.pop_front()
        print(1)
    if x := d.pop_back()
        print(2)

## deque.first_last[map]
fn s3()
    d := Deque.from([{"a": 1}, {"b": 2}])
    if x := d.first()
        print(1)
    if x := d.last()
        print(2)

## deque.index[map]
fn s4()
    d := Deque.from([{"a": 1}, {"b": 2}])
    x := d[1]
    print(x.len() == x.len())

## deque.at_set[map]
fn s5()
    mut d := Deque.from([{"a": 1}, {"b": 2}])
    d.set(0, {"c": 3})
    x := d.at(0)
    print(d.len())

## deque.to_list[map]
fn s6()
    d := Deque.from([{"a": 1}, {"b": 2}])
    print(d.to_list().len())

## deque.for[map]
fn s7()
    d := Deque.from([{"a": 1}, {"b": 2}])
    mut n := 0
    for x in d
        n += 1
    print(n)

## deque.vocab[map]
fn s8()
    d := Deque.from([{"a": 1}, {"b": 2}])
    print(d.filter(|x| x == {"a": 1}).len() + d.map(|x| x.len()).len() + d.flat_map(|x| [x]).len())
    print(d.any(|x| x == {"a": 1}))
    print(d.all(|x| x == {"a": 1}))
    print(d.count(|x| x == {"a": 1}))
    print(d.fold(0, |acc, x| acc + 1))
    if x := d.find(|x| x == {"a": 1})
        print(1)

## deque.take_skip[map]
fn s9()
    d := Deque.from([{"a": 1}, {"b": 2}, {"c": 3}])
    print(d.take(1).len() + d.skip(1).len() + d.take_while(|x| x == {"a": 1}).len() + d.skip_while(|x| x == {"a": 1}).len())

## deque.enumerate_zip[map]
fn s10()
    d := Deque.from([{"a": 1}, {"b": 2}])
    print(d.enumerate().len() + d.zip([1, 2]).len())

## deque.is_empty[map]
fn s11()
    d := Deque[Map[str, int]]()
    print(d.is_empty())

fn main()
    print("-- deque.empty_push[map]")
    s0()
    print("-- deque.from[map]")
    s1()
    print("-- deque.pop[map]")
    s2()
    print("-- deque.first_last[map]")
    s3()
    print("-- deque.index[map]")
    s4()
    print("-- deque.at_set[map]")
    s5()
    print("-- deque.to_list[map]")
    s6()
    print("-- deque.for[map]")
    s7()
    print("-- deque.vocab[map]")
    s8()
    print("-- deque.take_skip[map]")
    s9()
    print("-- deque.enumerate_zip[map]")
    s10()
    print("-- deque.is_empty[map]")
    s11()
