struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bytes
    items List[bytes]

fn add_bytes(mut xs List[bytes], x bytes)
    xs.push(x)

fn wrap_bytes(x bytes) bytes?
    x

fn nothing_bytes() bytes?
    none

K_bytes := [b"a", b"b"]

## heap.empty_push_pop[bytes]
fn s0()
    mut h := Heap[bytes]()
    h.push(b"b")
    h.push(b"a")
    if x := h.pop()
        print(h.len())

## heap.max_first[bytes]
fn s1()
    mut h := Heap[bytes](max_first: true)
    h.push(b"a")
    h.push(b"b")
    if x := h.peek()
        print(h.len())

## heap.from[bytes]
fn s2()
    h := Heap.from([b"c", b"a", b"b"])
    print(h.len())

## heap.from_max[bytes]
fn s3()
    h := Heap.from_max([b"c", b"a", b"b"])
    print(h.to_sorted().len())

## heap.is_empty[bytes]
fn s4()
    h := Heap[bytes]()
    print(h.is_empty())

## heap.drain[bytes]
fn s5()
    mut h := Heap.from([b"c", b"a", b"b"])
    mut n := 0
    while x := h.pop()
        n += 1
    print(n)

fn main()
    print("-- heap.empty_push_pop[bytes]")
    s0()
    print("-- heap.max_first[bytes]")
    s1()
    print("-- heap.from[bytes]")
    s2()
    print("-- heap.from_max[bytes]")
    s3()
    print("-- heap.is_empty[bytes]")
    s4()
    print("-- heap.drain[bytes]")
    s5()
