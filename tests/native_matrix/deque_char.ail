struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_char
    items List[char]

fn add_char(mut xs List[char], x char)
    xs.push(x)

fn wrap_char(x char) char?
    x

fn nothing_char() char?
    none

K_char := ['a', 'b']

## deque.empty_push[char]
fn s0()
    mut d := Deque[char]()
    d.push_back('a')
    d.push_front('b')
    print(d.len())

## deque.from[char]
fn s1()
    d := Deque.from(['a', 'b'])
    print(d.len())

## deque.pop[char]
fn s2()
    mut d := Deque.from(['a', 'b', 'c'])
    if x := d.pop_front()
        print(1)
    if x := d.pop_back()
        print(2)

## deque.first_last[char]
fn s3()
    d := Deque.from(['a', 'b'])
    if x := d.first()
        print(1)
    if x := d.last()
        print(2)

## deque.index[char]
fn s4()
    d := Deque.from(['a', 'b'])
    x := d[1]
    print(x == x)

## deque.at_set[char]
fn s5()
    mut d := Deque.from(['a', 'b'])
    d.set(0, 'c')
    x := d.at(0)
    print(d.len())

## deque.to_list[char]
fn s6()
    d := Deque.from(['a', 'b'])
    print(d.to_list().len())

## deque.for[char]
fn s7()
    d := Deque.from(['a', 'b'])
    mut n := 0
    for x in d
        n += 1
    print(n)

## deque.vocab[char]
fn s8()
    d := Deque.from(['a', 'b'])
    print(d.filter(|x| x == 'a').len() + d.map(|x| x).len() + d.flat_map(|x| [x]).len())
    print(d.any(|x| x == 'a'))
    print(d.all(|x| x == 'a'))
    print(d.count(|x| x == 'a'))
    print(d.fold(0, |acc, x| acc + 1))
    if x := d.find(|x| x == 'a')
        print(1)

## deque.take_skip[char]
fn s9()
    d := Deque.from(['a', 'b', 'c'])
    print(d.take(1).len() + d.skip(1).len() + d.take_while(|x| x == 'a').len() + d.skip_while(|x| x == 'a').len())

## deque.enumerate_zip[char]
fn s10()
    d := Deque.from(['a', 'b'])
    print(d.enumerate().len() + d.zip([1, 2]).len())

## deque.is_empty[char]
fn s11()
    d := Deque[char]()
    print(d.is_empty())

fn main()
    print("-- deque.empty_push[char]")
    s0()
    print("-- deque.from[char]")
    s1()
    print("-- deque.pop[char]")
    s2()
    print("-- deque.first_last[char]")
    s3()
    print("-- deque.index[char]")
    s4()
    print("-- deque.at_set[char]")
    s5()
    print("-- deque.to_list[char]")
    s6()
    print("-- deque.for[char]")
    s7()
    print("-- deque.vocab[char]")
    s8()
    print("-- deque.take_skip[char]")
    s9()
    print("-- deque.enumerate_zip[char]")
    s10()
    print("-- deque.is_empty[char]")
    s11()
