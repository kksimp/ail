struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_bool
    items List[bool]

fn add_bool(mut xs List[bool], x bool)
    xs.push(x)

fn wrap_bool(x bool) bool?
    x

fn nothing_bool() bool?
    none

K_bool := [false, true]

## value.eq[bool]
fn s0()
    print(false == false)
    print(false != true)

## value.print[bool]
fn s1()
    print(false)

## value.interp[bool]
fn s2()
    x := false
    print("<{x}>")

## value.to_str_len[bool]
fn s3()
    x := false
    print("{x}".len() > 0)

## value.optional_else[bool]
fn s4()
    o := wrap_bool(false)
    x := o else true
    print(1)

## value.optional_if[bool]
fn s5()
    o := wrap_bool(false)
    if x := o
        print(1)

## value.optional_none[bool]
fn s6()
    o := nothing_bool()
    print(o == none)

## value.optional_print[bool]
fn s7()
    o := wrap_bool(false)
    print(o)

## value.tuple[bool]
fn s8()
    t := (false, 1)
    print(t.1)
    a, b := t
    print(b)

## value.tuple_eq[bool]
fn s9()
    t := (false, 1)
    print(t == (false, 1))

## value.tuple_print[bool]
fn s10()
    t := (false, 1)
    print(t)

## value.tuple_key[bool]
fn s11()
    mut m := Map[(bool, int), int]()
    m[(false, 1)] = 2
    print(m[(false, 1)])

## value.struct_field[bool]
fn s12()
    b := Box_bool(items: [false])
    c := b
    print(c == b)

## value.struct_print[bool]
fn s13()
    b := Box_bool(items: [false])
    print(b)

## value.ref[bool]
fn s14()
    r := ref Box_bool(items: [false])
    s := r
    s.items.push(true)
    print(r.items.len())

## value.generic_id[bool]
fn s15()
    x := ident(false)
    print(1)

## value.generic_box[bool]
fn s16()
    g := GBox(v: false)
    print(g.v == false)

## value.fn_value[bool]
fn s17()
    f := |x bool| x
    y := f(false)
    print(1)

## value.closure_capture[bool]
fn s18()
    a := false
    f := || a
    y := f()
    print(1)

## value.match_eq[bool]
fn s19()
    x := false
    print(if x == false then 1 else 0)

## value.const_list[bool]
fn s20()
    print(K_bool.len())

fn main()
    print("-- value.eq[bool]")
    s0()
    print("-- value.print[bool]")
    s1()
    print("-- value.interp[bool]")
    s2()
    print("-- value.to_str_len[bool]")
    s3()
    print("-- value.optional_else[bool]")
    s4()
    print("-- value.optional_if[bool]")
    s5()
    print("-- value.optional_none[bool]")
    s6()
    print("-- value.optional_print[bool]")
    s7()
    print("-- value.tuple[bool]")
    s8()
    print("-- value.tuple_eq[bool]")
    s9()
    print("-- value.tuple_print[bool]")
    s10()
    print("-- value.tuple_key[bool]")
    s11()
    print("-- value.struct_field[bool]")
    s12()
    print("-- value.struct_print[bool]")
    s13()
    print("-- value.ref[bool]")
    s14()
    print("-- value.generic_id[bool]")
    s15()
    print("-- value.generic_box[bool]")
    s16()
    print("-- value.fn_value[bool]")
    s17()
    print("-- value.closure_capture[bool]")
    s18()
    print("-- value.match_eq[bool]")
    s19()
    print("-- value.const_list[bool]")
    s20()
