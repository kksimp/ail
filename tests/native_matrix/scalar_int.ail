struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


## int.0
fn s0()
    print(6.bit_and(3))

## int.1
fn s1()
    print(6.bit_or(3))

## int.2
fn s2()
    print(6.bit_xor(3))

## int.3
fn s3()
    print(6.bit_not())

## int.4
fn s4()
    print(1.shl(3))

## int.5
fn s5()
    print(8.shr(2))

## int.6
fn s6()
    print(1.checked_add(2) else 0)

## int.7
fn s7()
    print(1.checked_sub(2) else 0)

## int.8
fn s8()
    print(2.checked_mul(3) else 0)

## int.9
fn s9()
    print(6.checked_div(0) else -1)

## int.10
fn s10()
    print(5.checked_neg() else 0)

## int.11
fn s11()
    print(7.checked_rem(3) else 0)

## int.12
fn s12()
    print(5.wrapping_neg())

## int.13
fn s13()
    print(1.wrapping_add(2))

## int.14
fn s14()
    print(1.wrapping_sub(2))

## int.15
fn s15()
    print(2.wrapping_mul(3))

## int.16
fn s16()
