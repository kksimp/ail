## int.17
fn s17()
    print(1.saturating_sub(2))

## int.18
fn s18()
    print(2.saturating_mul(3))

## int.19
fn s19()
    print((-3).abs())

## int.20
fn s20()
    print(3.to_float())

## int.21
fn s21()
    print(255.to_hex())

## int.22
fn s22()
