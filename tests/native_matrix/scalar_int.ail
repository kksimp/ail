## int.27
fn s27()
    print(3.to_u16())

## int.28
fn s28()
    print(3.to_u32())

## int.29
fn s29()
    print(3.to_u64())

## int.30
fn s30()
    print(3.to_f32())

## int.31
fn s31()
    print(7 / 2)

## int.32
fn s32()
    print(7 % 3)

