struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_int
    items List[int]

fn add_int(mut xs List[int], x int)
    xs.push(x)

fn wrap_int(x int) int?
    x

fn nothing_int() int?
    none

K_int := [1, 2]

## grid.fill[int]
fn s0()
    g := Grid.fill(2, 3, 1)
    print(g.rows * g.cols)

## grid.from[int]
fn s1()
    g := Grid.from([[1, 2], [3, 1]])
    print(g.cells.len())

## grid.index[int]
fn s2()
    g := Grid.fill(2, 2, 1)
    x := g[1, 1]
    print(x == x)

## grid.index_assign[int]
fn s3()
    mut g := Grid.fill(2, 2, 1)
    g[0, 1] = 2
    print(g.rows)

## grid.row[int]
fn s4()
    g := Grid.from([[1, 2], [3, 1]])
    print(g.row(1).len())

## grid.to_list[int]
fn s5()
    g := Grid.fill(2, 2, 1)
    print(g.to_list().len())

## grid.cells_for[int]
fn s6()
    g := Grid.fill(2, 2, 1)
    mut n := 0
    for x in g.cells
        n += 1
    print(n)

fn main()
    print("-- grid.fill[int]")
    s0()
    print("-- grid.from[int]")
    s1()
    print("-- grid.index[int]")
    s2()
    print("-- grid.index_assign[int]")
    s3()
    print("-- grid.row[int]")
    s4()
    print("-- grid.to_list[int]")
    s5()
    print("-- grid.cells_for[int]")
    s6()
