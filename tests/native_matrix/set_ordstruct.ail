struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_ordstruct
    items List[Q]

fn add_ordstruct(mut xs List[Q], x Q)
    xs.push(x)

fn wrap_ordstruct(x Q) Q?
    x

fn nothing_ordstruct() Q?
    none

K_ordstruct := [Q(n: 1, name: "a"), Q(n: 2, name: "b")]

## set.literal[ordstruct]
fn s0()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.len())

## set.empty[ordstruct]
fn s1()
    s := Set[Q]()
    print(s.len())

## set.from_list[ordstruct]
fn s2()
    s := {x for x in [Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 1, name: "a")]}
    print(s.len())

## set.add_remove[ordstruct]
fn s3()
    mut s := Set[Q]()
    print(s.add(Q(n: 1, name: "a")))
    print(s.remove(Q(n: 1, name: "a")))

## set.contains[ordstruct]
fn s4()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.contains(Q(n: 1, name: "a")))

## set.is_empty[ordstruct]
fn s5()
    s := {Q(n: 1, name: "a")}
    print(s.is_empty())

## set.sorted[ordstruct]
fn s6()
    s := {Q(n: 2, name: "b"), Q(n: 1, name: "a")}
    print(s.sorted().len())

## set.to_list[ordstruct]
fn s7()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.to_list().len())

## set.is_subset[ordstruct]
fn s8()
    s := {Q(n: 1, name: "a")}
    t := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.is_subset(t))

## set.set_ops[ordstruct]
fn s9()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    t := {Q(n: 2, name: "b"), Q(n: 3, name: "c")}
    print(s.union(t).len() + s.intersect(t).len() + s.difference(t).len())

## set.any_all_find[ordstruct]
fn s10()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.any(|x| x == Q(n: 1, name: "a")))
    print(s.all(|x| x == Q(n: 1, name: "a")))
    if x := s.find(|x| x == Q(n: 2, name: "b"))
        print(1)

## set.filter_map[ordstruct]
fn s11()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.filter(|x| x == Q(n: 1, name: "a")).len() + s.map(|x| x.n).len())

## set.group_by[ordstruct]
fn s12()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.group_by(|x| x.n).len())

## set.count_fold[ordstruct]
fn s13()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.count(|x| x == Q(n: 1, name: "a")))
    print(s.fold(0, |acc, x| acc + 1))

## set.flat_map[ordstruct]
fn s14()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.flat_map(|x| [x]).len())

## set.take_skip[ordstruct]
fn s15()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b"), Q(n: 3, name: "c")}
    print(s.take(1).len() + s.skip(1).len() + s.take_while(|x| x == Q(n: 1, name: "a")).len() + s.skip_while(|x| x == Q(n: 1, name: "a")).len())

## set.zip_enumerate[ordstruct]
fn s16()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s.zip([1, 2]).len() + s.enumerate().len())

## set.min_max[ordstruct]
fn s17()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    if x := s.min()
        print(1)
    if x := s.max()
        print(2)

## set.for[ordstruct]
fn s18()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    mut n := 0
    for x in s
        n += 1
    print(n)

## set.eq[ordstruct]
fn s19()
    s := {Q(n: 1, name: "a"), Q(n: 2, name: "b")}
    print(s == {Q(n: 2, name: "b"), Q(n: 1, name: "a")})

## set.print[ordstruct]
fn s20()
    s := {Q(n: 1, name: "a")}
    print(s)

## set.in_map[ordstruct]
fn s21()
    mut m := Map[str, Set[Q]]()
    m["a"] = Set[Q]()
    m["a"].add(Q(n: 1, name: "a"))
    print(m["a"].len())

## set.in_list[ordstruct]
fn s22()
    mut xs := [Set[Q]()]
    xs[0].add(Q(n: 1, name: "a"))
    print(xs[0].len())

fn main()
    print("-- set.literal[ordstruct]")
    s0()
    print("-- set.empty[ordstruct]")
    s1()
    print("-- set.from_list[ordstruct]")
    s2()
    print("-- set.add_remove[ordstruct]")
    s3()
    print("-- set.contains[ordstruct]")
    s4()
    print("-- set.is_empty[ordstruct]")
    s5()
    print("-- set.sorted[ordstruct]")
    s6()
    print("-- set.to_list[ordstruct]")
    s7()
    print("-- set.is_subset[ordstruct]")
    s8()
    print("-- set.set_ops[ordstruct]")
    s9()
    print("-- set.any_all_find[ordstruct]")
    s10()
    print("-- set.filter_map[ordstruct]")
    s11()
    print("-- set.group_by[ordstruct]")
    s12()
    print("-- set.count_fold[ordstruct]")
    s13()
    print("-- set.flat_map[ordstruct]")
    s14()
    print("-- set.take_skip[ordstruct]")
    s15()
    print("-- set.zip_enumerate[ordstruct]")
    s16()
    print("-- set.min_max[ordstruct]")
    s17()
    print("-- set.for[ordstruct]")
    s18()
    print("-- set.eq[ordstruct]")
    s19()
    print("-- set.print[ordstruct]")
    s20()
    print("-- set.in_map[ordstruct]")
    s21()
    print("-- set.in_list[ordstruct]")
    s22()
