struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_struct
    items List[P]

fn add_struct(mut xs List[P], x P)
    xs.push(x)

fn wrap_struct(x P) P?
    x

fn nothing_struct() P?
    none

K_struct := [P(name: "a", n: 1), P(name: "b", n: 2)]

## deque.empty_push[struct]
fn s0()
    mut d := Deque[P]()
    d.push_back(P(name: "a", n: 1))
    d.push_front(P(name: "b", n: 2))
    print(d.len())

## deque.from[struct]
fn s1()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    print(d.len())

## deque.pop[struct]
fn s2()
    mut d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2), P(name: "c", n: 3)])
    if x := d.pop_front()
        print(1)
    if x := d.pop_back()
        print(2)

## deque.first_last[struct]
fn s3()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    if x := d.first()
        print(1)
    if x := d.last()
        print(2)

## deque.index[struct]
fn s4()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    x := d[1]
    print(x.n == x.n)

## deque.at_set[struct]
fn s5()
    mut d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    d.set(0, P(name: "c", n: 3))
    x := d.at(0)
    print(d.len())

## deque.to_list[struct]
fn s6()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    print(d.to_list().len())

## deque.for[struct]
fn s7()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    mut n := 0
    for x in d
        n += 1
    print(n)

## deque.vocab[struct]
fn s8()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    print(d.filter(|x| x == P(name: "a", n: 1)).len() + d.map(|x| x.n).len() + d.flat_map(|x| [x]).len())
    print(d.any(|x| x == P(name: "a", n: 1)))
    print(d.all(|x| x == P(name: "a", n: 1)))
    print(d.count(|x| x == P(name: "a", n: 1)))
    print(d.fold(0, |acc, x| acc + 1))
    if x := d.find(|x| x == P(name: "a", n: 1))
        print(1)

## deque.take_skip[struct]
fn s9()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2), P(name: "c", n: 3)])
    print(d.take(1).len() + d.skip(1).len() + d.take_while(|x| x == P(name: "a", n: 1)).len() + d.skip_while(|x| x == P(name: "a", n: 1)).len())

## deque.enumerate_zip[struct]
fn s10()
    d := Deque.from([P(name: "a", n: 1), P(name: "b", n: 2)])
    print(d.enumerate().len() + d.zip([1, 2]).len())

## deque.is_empty[struct]
fn s11()
    d := Deque[P]()
    print(d.is_empty())

fn main()
    print("-- deque.empty_push[struct]")
    s0()
    print("-- deque.from[struct]")
    s1()
    print("-- deque.pop[struct]")
    s2()
    print("-- deque.first_last[struct]")
    s3()
    print("-- deque.index[struct]")
    s4()
    print("-- deque.at_set[struct]")
    s5()
    print("-- deque.to_list[struct]")
    s6()
    print("-- deque.for[struct]")
    s7()
    print("-- deque.vocab[struct]")
    s8()
    print("-- deque.take_skip[struct]")
    s9()
    print("-- deque.enumerate_zip[struct]")
    s10()
    print("-- deque.is_empty[struct]")
    s11()
