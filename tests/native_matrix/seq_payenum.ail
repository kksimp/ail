struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_payenum
    items List[Shape]

fn add_payenum(mut xs List[Shape], x Shape)
    xs.push(x)

fn wrap_payenum(x Shape) Shape?
    x

fn nothing_payenum() Shape?
    none

K_payenum := [Shape.Circle(r: 1), Shape.Square(s: 2)]

## seq.of_collect[payenum]
fn s0()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.collect().len())

## seq.map_filter[payenum]
fn s1()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.filter(|x| x == Shape.Circle(r: 1)).map(|x| 1).collect().len())

## seq.take_skip[payenum]
fn s2()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2), Shape.Circle(r: 3)])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[payenum]
fn s3()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.enumerate().collect().len())

## seq.zip_chain[payenum]
fn s4()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[payenum]
fn s5()
    s := Seq.of([Shape.Circle(r: 1)])
    t := Seq.of([Shape.Square(s: 2)])
    print(s.chain(move t).collect().len())

## seq.next[payenum]
fn s6()
    mut s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    if x := s.next()
        print(1)

## seq.for[payenum]
fn s7()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[payenum]
fn s8()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.count(|x| x == Shape.Circle(r: 1)))

## seq.fold[payenum]
fn s9()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[payenum]
fn s10()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    if x := s.find(|x| x == Shape.Square(s: 2))
        print(1)

## seq.flat_map[payenum]
fn s11()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[payenum]
fn s12()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.take_while(|x| x == Shape.Circle(r: 1)).collect().len())

## seq.skip_while[payenum]
fn s13()
    s := Seq.of([Shape.Circle(r: 1), Shape.Square(s: 2)])
    print(s.skip_while(|x| x == Shape.Circle(r: 1)).collect().len())

fn main()
    print("-- seq.of_collect[payenum]")
    s0()
    print("-- seq.map_filter[payenum]")
    s1()
    print("-- seq.take_skip[payenum]")
    s2()
    print("-- seq.enumerate[payenum]")
    s3()
    print("-- seq.zip_chain[payenum]")
    s4()
    print("-- seq.chain[payenum]")
    s5()
    print("-- seq.next[payenum]")
    s6()
    print("-- seq.for[payenum]")
    s7()
    print("-- seq.count_any[payenum]")
    s8()
    print("-- seq.fold[payenum]")
    s9()
    print("-- seq.find[payenum]")
    s10()
    print("-- seq.flat_map[payenum]")
    s11()
    print("-- seq.while[payenum]")
    s12()
    print("-- seq.skip_while[payenum]")
    s13()
