struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_enum
    items List[Color]

fn add_enum(mut xs List[Color], x Color)
    xs.push(x)

fn wrap_enum(x Color) Color?
    x

fn nothing_enum() Color?
    none

K_enum := [Color.Red, Color.Green]

## seq.of_collect[enum]
fn s0()
    s := Seq.of([Color.Red, Color.Green])
    print(s.collect().len())

## seq.map_filter[enum]
fn s1()
    s := Seq.of([Color.Red, Color.Green])
    print(s.filter(|x| x == Color.Red).map(|x| 1).collect().len())

## seq.take_skip[enum]
fn s2()
    s := Seq.of([Color.Red, Color.Green, Color.Blue])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[enum]
fn s3()
    s := Seq.of([Color.Red, Color.Green])
    print(s.enumerate().collect().len())

## seq.zip_chain[enum]
fn s4()
    s := Seq.of([Color.Red, Color.Green])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[enum]
fn s5()
    s := Seq.of([Color.Red])
    t := Seq.of([Color.Green])
    print(s.chain(move t).collect().len())

## seq.next[enum]
fn s6()
    mut s := Seq.of([Color.Red, Color.Green])
    if x := s.next()
        print(1)

## seq.for[enum]
fn s7()
    s := Seq.of([Color.Red, Color.Green])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[enum]
fn s8()
    s := Seq.of([Color.Red, Color.Green])
    print(s.count(|x| x == Color.Red))

## seq.fold[enum]
fn s9()
    s := Seq.of([Color.Red, Color.Green])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[enum]
fn s10()
    s := Seq.of([Color.Red, Color.Green])
    if x := s.find(|x| x == Color.Green)
        print(1)

## seq.flat_map[enum]
fn s11()
    s := Seq.of([Color.Red, Color.Green])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[enum]
fn s12()
    s := Seq.of([Color.Red, Color.Green])
    print(s.take_while(|x| x == Color.Red).collect().len())

## seq.skip_while[enum]
fn s13()
    s := Seq.of([Color.Red, Color.Green])
    print(s.skip_while(|x| x == Color.Red).collect().len())

fn main()
    print("-- seq.of_collect[enum]")
    s0()
    print("-- seq.map_filter[enum]")
    s1()
    print("-- seq.take_skip[enum]")
    s2()
    print("-- seq.enumerate[enum]")
    s3()
    print("-- seq.zip_chain[enum]")
    s4()
    print("-- seq.chain[enum]")
    s5()
    print("-- seq.next[enum]")
    s6()
    print("-- seq.for[enum]")
    s7()
    print("-- seq.count_any[enum]")
    s8()
    print("-- seq.fold[enum]")
    s9()
    print("-- seq.find[enum]")
    s10()
    print("-- seq.flat_map[enum]")
    s11()
    print("-- seq.while[enum]")
    s12()
    print("-- seq.skip_while[enum]")
    s13()
