    print("-- list.push[int]")
    s8()
    print("-- list.pop[int]")
    s9()
    print("-- list.swap[int]")
    s10()
    print("-- list.first_last[int]")
    s11()
    print("-- list.insert[int]")
    s12()
    print("-- list.remove_at[int]")
    s13()
    print("-- list.extend[int]")
