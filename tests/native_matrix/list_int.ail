struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_int
    items List[int]

fn add_int(mut xs List[int], x int)
    xs.push(x)

fn wrap_int(x int) int?
    x

fn nothing_int() int?
    none

K_int := [1, 2]

## list.literal[int]
fn s0()
    xs := [1, 2, 3]
    print(xs.len())

## list.empty[int]
fn s1()
    xs := List[int]()
    print(xs.len())

## list.typed_by_push[int]
fn s2()
    mut xs := []
    xs.push(1)
    print(xs.len())

## list.len[int]
fn s3()
    xs := [1, 2]
    print(xs.len())

## list.is_empty[int]
fn s4()
    xs := [1]
    print(xs.is_empty())

## list.index[int]
fn s5()
    xs := [1, 2]
    x := xs[1]
    print(x == x)

## list.index_assign[int]
fn s6()
    mut xs := [1, 2]
    xs[0] = 3
    print(xs.len())

## list.slice[int]
fn s7()
    xs := [1, 2, 3]
    print(xs[1..].len() + xs[..1].len() + xs[0..2].len())

## list.push[int]
fn s8()
    mut xs := [1]
    xs.push(2)
    print(xs.len())

## list.pop[int]
fn s9()
    mut xs := [1, 2]
    if x := xs.pop()
        print(xs.len())

## list.swap[int]
fn s10()
    mut xs := [1, 2]
    xs.swap(0, 1)
    print(xs.len())

## list.first_last[int]
fn s11()
    xs := [1, 2]
    if x := xs.first()
        print(1)
    if x := xs.last()
        print(2)

## list.insert[int]
fn s12()
    mut xs := [1]
    xs.insert(0, 2)
    print(xs.len())

## list.remove_at[int]
fn s13()
    mut xs := [1, 2]
    x := xs.remove_at(0)
    print(xs.len())

## list.extend[int]
fn s14()
    mut xs := [1]
    xs.extend([2, 3])
    print(xs.len())

## list.clear[int]
fn s15()
    mut xs := [1]
    xs.clear()
    print(xs.len())

## list.reverse[int]
fn s16()
    mut xs := [1, 2]
    xs.reverse()
    print(xs.len())

## list.reversed[int]
fn s17()
    xs := [1, 2]
    print(xs.reversed().len())

## list.contains[int]
fn s18()
    xs := [1, 2]
    print(xs.contains(2))

## list.index_of[int]
fn s19()
    xs := [1, 2]
    print(xs.index_of(2) else -1)

## list.join[int]
fn s20()
    xs := [1, 2]
    print(xs.join(",").len() > 0)

## list.sum[int]
fn s21()
    xs := [1, 2]
    s := xs.sum()
    print(1)

## list.min_max[int]
fn s22()
    xs := [2, 1, 3]
    if x := xs.min()
        print(1)
    if x := xs.max()
        print(2)

## list.sorted[int]
fn s23()
    xs := [3, 1, 2]
    print(xs.sorted().len())

## list.sort[int]
fn s24()
    mut xs := [3, 1, 2]
    xs.sort()
    print(xs.len())

## list.sorted_by[int]
fn s25()
    xs := [3, 1, 2]
    print(xs.sorted(by: |x| x).len())

## list.sort_by[int]
fn s26()
    mut xs := [3, 1, 2]
    xs.sort(by: |x| x)
    print(xs.len())

## list.min_by[int]
fn s27()
    xs := [3, 1, 2]
    if x := xs.min(by: |x| x)
        print(1)
    if x := xs.max(by: |x| x)
        print(2)

## list.take_skip[int]
fn s28()
    xs := [1, 2, 3]
    print(xs.take(2).len() + xs.skip(1).len())

## list.set_ops[int]
fn s29()
    xs := [1, 2]
    ys := [2, 3]
    print(xs.union(ys).len() + xs.intersect(ys).len() + xs.difference(ys).len())

## list.chunks_windows[int]
fn s30()
    xs := [1, 2, 3]
    print(xs.chunks(2).len() + xs.windows(2).len())

## list.counts[int]
fn s31()
    xs := [1, 2, 1]
    c := xs.counts()
    print(c.len())

## list.flatten[int]
fn s32()
    xs := [[1], [2, 3]]
    print(xs.flatten().len())

## list.enumerate[int]
fn s33()
    xs := [1, 2]
    for i, x in xs.enumerate()
        print(i)

## list.any_all[int]
fn s34()
    xs := [1, 2]
    print(xs.any(|x| x == 1))
    print(xs.all(|x| x == 1))

## list.find[int]
fn s35()
    xs := [1, 2]
    if x := xs.find(|x| x == 2)
        print(1)

## list.filter[int]
fn s36()
    xs := [1, 2]
    print(xs.filter(|x| x == 1).len())

## list.map[int]
fn s37()
    xs := [1, 2]
    print(xs.map(|x| x).len())

## list.map_to_self[int]
fn s38()
    xs := [1, 2]
    print(xs.map(|x| x).len())

## list.group_by[int]
fn s39()
    xs := [1, 2, 1]
    g := xs.group_by(|x| x)
    print(g.len())

## list.count[int]
fn s40()
    xs := [1, 2, 1]
    print(xs.count(|x| x == 1))

## list.fold[int]
fn s41()
    xs := [1, 2]
    print(xs.fold(0, |acc, x| acc + 1))

## list.flat_map[int]
fn s42()
    xs := [1, 2]
    print(xs.flat_map(|x| [x, x]).len())

## list.take_skip_while[int]
fn s43()
    xs := [1, 2]
    print(xs.take_while(|x| x == 1).len() + xs.skip_while(|x| x == 1).len())

## list.zip[int]
fn s44()
    xs := [1, 2]
    for x, y in xs.zip([1, 2])
        print(y)

## list.zip_into[int]
fn s45()
    xs := [1, 2]
    for y, x in [1, 2].zip(xs)
        print(y)

## list.for[int]
fn s46()
    xs := [1, 2]
    mut n := 0
    for x in xs
        n += 1
    print(n)

## list.for_mut[int]
fn s47()
    mut xs := [1, 2]
    for mut x in xs
        x = 3
    print(xs.len())

## list.comprehension[int]
fn s48()
    xs := [1, 2]
    ys := [x for x in xs if x == 1]
    print(ys.len())

## list.set_comprehension[int]
fn s49()
    xs := [1, 2, 1]
    s := {x for x in xs}
    print(s.len())

## list.map_comprehension[int]
fn s50()
    xs := [1, 2]
    m := {x: 1 for x in xs}
    print(m.len())

## list.eq[int]
fn s51()
    xs := [1, 2]
    ys := [1, 2]
    print(xs == ys)
    print(xs != [3])

## list.lt[int]
fn s52()
    xs := [1]
    ys := [2]
    print(xs < ys)

## list.print[int]
fn s53()
    xs := [1, 2]
    print(xs)

## list.interp[int]
fn s54()
    xs := [1, 2]
    print("{xs}".len() > 0)

## list.nested_push[int]
fn s55()
    mut xs := [[1]]
    xs[0].push(2)
    print(xs[0].len())

## list.in_struct[int]
fn s56()
    mut b := Box_int(items: [1])
    b.items.push(2)
    print(b.items.len())

## list.pass_mut[int]
fn s57()
    mut xs := [1]
    add_int(mut xs, 2)
    print(xs.len())

## list.generic_first[int]
fn s58()
    xs := [1, 2]
    if x := first_of(xs)
        print(1)

## list.generic_ord[int]
fn s59()
    xs := [1, 2]
    if x := biggest(xs)
        print(1)

## list.contains_list[int]
fn s60()
    xs := [[1], [2]]
    print(xs.contains([2]))

## list.sorted_nested[int]
fn s61()
    xs := [[2], [1]]
    print(xs.sorted().len())

fn main()
    print("-- list.literal[int]")
    s0()
