    s34()
    print("-- list.find[int]")
    s35()
    print("-- list.filter[int]")
    s36()
    print("-- list.map[int]")
    s37()
    print("-- list.map_to_self[int]")
    s38()
    print("-- list.group_by[int]")
    s39()
    print("-- list.count[int]")
    s40()
    print("-- list.fold[int]")
    s41()
    print("-- list.flat_map[int]")
    s42()
