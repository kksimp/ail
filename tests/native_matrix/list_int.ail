    s46()
    print("-- list.for_mut[int]")
    s47()
    print("-- list.comprehension[int]")
    s48()
    print("-- list.set_comprehension[int]")
    s49()
    print("-- list.map_comprehension[int]")
    s50()
    print("-- list.eq[int]")
    s51()
    print("-- list.lt[int]")
    s52()
    print("-- list.print[int]")
    s53()
    print("-- list.interp[int]")
    s54()
    print("-- list.nested_push[int]")
