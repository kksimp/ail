struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_list
    items List[List[int]]

fn add_list(mut xs List[List[int]], x List[int])
    xs.push(x)

fn wrap_list(x List[int]) List[int]?
    x

fn nothing_list() List[int]?
    none

K_list := [[1], [1, 2]]

## seq.of_collect[list]
fn s0()
    s := Seq.of([[1], [1, 2]])
    print(s.collect().len())

## seq.map_filter[list]
fn s1()
    s := Seq.of([[1], [1, 2]])
    print(s.filter(|x| x == [1]).map(|x| x.len()).collect().len())

## seq.take_skip[list]
fn s2()
    s := Seq.of([[1], [1, 2], [2]])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[list]
fn s3()
    s := Seq.of([[1], [1, 2]])
    print(s.enumerate().collect().len())

## seq.zip_chain[list]
fn s4()
    s := Seq.of([[1], [1, 2]])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[list]
fn s5()
    s := Seq.of([[1]])
    t := Seq.of([[1, 2]])
    print(s.chain(move t).collect().len())

## seq.next[list]
fn s6()
    mut s := Seq.of([[1], [1, 2]])
    if x := s.next()
        print(1)

## seq.for[list]
fn s7()
    s := Seq.of([[1], [1, 2]])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[list]
fn s8()
    s := Seq.of([[1], [1, 2]])
    print(s.count(|x| x == [1]))

## seq.fold[list]
fn s9()
    s := Seq.of([[1], [1, 2]])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[list]
fn s10()
    s := Seq.of([[1], [1, 2]])
    if x := s.find(|x| x == [1, 2])
        print(1)

## seq.flat_map[list]
fn s11()
    s := Seq.of([[1], [1, 2]])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[list]
fn s12()
    s := Seq.of([[1], [1, 2]])
    print(s.take_while(|x| x == [1]).collect().len())

## seq.skip_while[list]
fn s13()
    s := Seq.of([[1], [1, 2]])
    print(s.skip_while(|x| x == [1]).collect().len())

fn main()
    print("-- seq.of_collect[list]")
    s0()
    print("-- seq.map_filter[list]")
    s1()
    print("-- seq.take_skip[list]")
    s2()
    print("-- seq.enumerate[list]")
    s3()
    print("-- seq.zip_chain[list]")
    s4()
    print("-- seq.chain[list]")
    s5()
    print("-- seq.next[list]")
    s6()
    print("-- seq.for[list]")
    s7()
    print("-- seq.count_any[list]")
    s8()
    print("-- seq.fold[list]")
    s9()
    print("-- seq.find[list]")
    s10()
    print("-- seq.flat_map[list]")
    s11()
    print("-- seq.while[list]")
    s12()
    print("-- seq.skip_while[list]")
    s13()
