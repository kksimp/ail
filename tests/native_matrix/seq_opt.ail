struct P
    name str
    n int

struct Q
    n int
    name str

impl Ord for Q

enum Color
    Red
    Green
    Blue

enum Shape
    Circle(r int)
    Square(s int)

type Uid = int

fn oi(n int) int?
    if n < 0
        return none
    n

fn first_of[T](xs List[T]) T?
    xs.first()

fn biggest[T Ord](xs List[T]) T?
    mut best := xs.first() else return none
    for x in xs
        if x > best
            best = x
    best

fn ident[T](x T) T
    x

struct GBox[T]
    v T


struct Box_opt
    items List[int?]

fn add_opt(mut xs List[int?], x int?)
    xs.push(x)

fn nothing_opt() int??
    none

K_opt := [oi(1), oi(2)]

## seq.of_collect[opt]
fn s0()
    s := Seq.of([oi(1), oi(2)])
    print(s.collect().len())

## seq.map_filter[opt]
fn s1()
    s := Seq.of([oi(1), oi(2)])
    print(s.filter(|x| x == oi(1)).map(|x| (x else 0)).collect().len())

## seq.take_skip[opt]
fn s2()
    s := Seq.of([oi(1), oi(2), oi(-1)])
    print(s.skip(1).take(1).collect().len())

## seq.enumerate[opt]
fn s3()
    s := Seq.of([oi(1), oi(2)])
    print(s.enumerate().collect().len())

## seq.zip_chain[opt]
fn s4()
    s := Seq.of([oi(1), oi(2)])
    t := Seq.of([1, 2])
    print(s.zip(move t).collect().len())

## seq.chain[opt]
fn s5()
    s := Seq.of([oi(1)])
    t := Seq.of([oi(2)])
    print(s.chain(move t).collect().len())

## seq.next[opt]
fn s6()
    mut s := Seq.of([oi(1), oi(2)])
    if x := s.next()
        print(1)

## seq.for[opt]
fn s7()
    s := Seq.of([oi(1), oi(2)])
    mut n := 0
    for x in s
        n += 1
    print(n)

## seq.count_any[opt]
fn s8()
    s := Seq.of([oi(1), oi(2)])
    print(s.count(|x| x == oi(1)))

## seq.fold[opt]
fn s9()
    s := Seq.of([oi(1), oi(2)])
    print(s.fold(0, |acc, x| acc + 1))

## seq.find[opt]
fn s10()
    s := Seq.of([oi(1), oi(2)])
    if x := s.find(|x| x == oi(2))
        print(1)

## seq.flat_map[opt]
fn s11()
    s := Seq.of([oi(1), oi(2)])
    print(s.flat_map(|x| [x, x]).collect().len())

## seq.while[opt]
fn s12()
    s := Seq.of([oi(1), oi(2)])
    print(s.take_while(|x| x == oi(1)).collect().len())

## seq.skip_while[opt]
fn s13()
    s := Seq.of([oi(1), oi(2)])
    print(s.skip_while(|x| x == oi(1)).collect().len())

fn main()
    print("-- seq.of_collect[opt]")
    s0()
    print("-- seq.map_filter[opt]")
    s1()
    print("-- seq.take_skip[opt]")
    s2()
    print("-- seq.enumerate[opt]")
    s3()
    print("-- seq.zip_chain[opt]")
    s4()
    print("-- seq.chain[opt]")
    s5()
    print("-- seq.next[opt]")
    s6()
    print("-- seq.for[opt]")
    s7()
    print("-- seq.count_any[opt]")
    s8()
    print("-- seq.fold[opt]")
    s9()
    print("-- seq.find[opt]")
    s10()
    print("-- seq.flat_map[opt]")
    s11()
    print("-- seq.while[opt]")
    s12()
    print("-- seq.skip_while[opt]")
    s13()
