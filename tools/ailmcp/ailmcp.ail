## `ail mcp` in AIL (ADR 0918, mcp.*): the compiler's own tools as an MCP server on stdio.
##   ail mcp
## One JSON-RPC message per line in, one per line out. Each tool runs the matching `ail` command in
## the current directory and returns its output as text; it adds no analysis of its own.
## `warm` (mcp.warm.1-4) skips the launcher and answers repeated read-only calls from a memo.
use warm

PROTOCOL := "2025-03-26"

## The tools (mcp.tools.1). A tool: its name, description, the string arguments it takes and which are required.
struct Tool
    name str
    about str
    props List[str]
    needs List[str]

fn tools() List[Tool]
    [
        Tool(
            name: "ail_check",
            about: "Check a program; `fix` applies safe fixes first.",
            props: ["program", "fix"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_test",
            about: "Run tests; `since` limits to affected, `bundle` reruns a failure.",
            props: ["program", "since", "bundle"],
            needs: [],
        ),
        Tool(
            name: "ail_verify",
            about: "What a change since a revision proved and left untested.",
            props: ["program", "rev"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_ask",
            about: "Ask who writes a field or calls a function, not grep.",
            props: ["program", "question"],
            needs: ["program", "question"],
        ),
        Tool(
            name: "ail_impact",
            about: "What a change since a revision touches.",
            props: ["program", "rev"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_context",
            about: "One function with callees, callers, types, tests, before editing.",
            props: ["program", "symbol", "budget", "json"],
            needs: ["program", "symbol"],
        ),
        Tool(
            name: "ail_edit",
            about: "Apply edits (JSON or hunks) all or none, then check; `test`, `dry_run`.",
            props: ["program", "edits", "test", "impact", "dry_run", "budget"],
            needs: ["program", "edits"],
        ),
        Tool(
            name: "ail_fix",
            about: "Apply the checker's machine fixes; `dry_run` shows a diff.",
            props: ["program", "dry_run", "budget"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_explain",
            about: "Spec rule text and fix by ID from a diagnostic.",
            props: ["rule", "budget", "json"],
            needs: [],
        ),
        Tool(
            name: "ail_api",
            about: "A program's public API instead of reading files.",
            props: ["program", "form", "module", "budget", "json"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_review",
            about: "A change between two revisions by meaning.",
            props: ["range", "path", "budget", "json"],
            needs: ["range"],
        ),
        Tool(
            name: "ail_card",
            about: "The core language card, or one `topic` of the full card.",
            props: ["topic"],
            needs: [],
        ),
        Tool(
            name: "ail_find",
            about: "Find a std function by `words` or `sig` before writing one.",
            props: ["words", "sig"],
            needs: [],
        ),
        Tool(
            name: "ail_try",
            about: "Check and test each patch set in `sets` on a copy, one verdict each.",
            props: ["program", "sets"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_prove",
            about: "Which `requires` and `ensures` the prover discharges.",
            props: ["program"],
            needs: ["program"],
        ),
        Tool(
            name: "ail_infer",
            about: "Propose contracts for a function from its tests; writes nothing.",
            props: ["program", "function"],
            needs: ["program", "function"],
        ),
        Tool(
            name: "ail_merge_check",
            about: "New errors a merge adds: `base`, `ours`, `theirs` files, or revisions.",
            props: ["base", "ours", "theirs", "path"],
            needs: ["ours", "theirs"],
        ),
        Tool(
            name: "ail_verify_check",
            about: "Re-run a change certificate (`cert`) and say if it holds.",
            props: ["cert"],
            needs: ["cert"],
        ),
        Tool(
            name: "task_start",
            about: "Open a task: goal and base revision.",
            props: ["program", "goal", "rev"],
            needs: ["program", "goal"],
        ),
        Tool(
            name: "task_status",
            about: "Open task's impact and verified state.",
            props: [],
            needs: [],
        ),
        Tool(
            name: "task_verify",
            about: "Check and test the task; `fix` applies safe fixes.",
            props: ["fix"],
            needs: [],
        ),
        Tool(
            name: "task_finish",
            about: "Close a verified task and write its certificate.",
            props: [],
            needs: [],
        ),
        Tool(
            name: "task_abort",
            about: "Close the task unfinished.",
            props: [],
            needs: [],
        ),
    ]

fn member(key str, value Json) JsonMember
    JsonMember(key: key, value: value)

fn obj(members List[JsonMember]) Json
    Json.Obj(members)

fn strs(xs List[str]) Json
    Json.Arr([Json.Str(x) for x in xs])

## The boolean properties of a tool (mcp.tools.1); `budget` is an integer, the rest strings.
fn flags(name str) List[str]
    match name
        "ail_context" => ["json"]
        "ail_edit" => ["test", "impact", "dry_run"]
        "ail_fix" => ["dry_run"]
        "ail_explain" => ["json"]
        "ail_api" => ["json"]
        "ail_review" => ["json"]
        _ => []

fn prop_type(tool str, p str) str
    if p == "budget"
        return "integer"
    for f in flags(tool)
        if f == p
            return "boolean"
    "string"

## One property's schema; `sets` is a list of patch sets (ail_try), a string each.
fn prop_schema(tool str, p str) Json
    if p == "sets"
        return obj([
            member("type", Json.Str("array")),
            member("items", obj([member("type", Json.Str("string"))])),
        ])
    obj([member("type", Json.Str(prop_type(tool, p)))])

fn tool_json(t Tool) Json
    props := obj([member(p, prop_schema(t.name, p)) for p in t.props])
    mut parts := [member("type", Json.Str("object")), member("properties", props)]
    if not t.needs.is_empty()
        parts.push(member("required", strs(t.needs)))
    schema := obj(parts)
    obj([
        member("name", Json.Str(t.name)),
        member("description", Json.Str(t.about)),
        member("inputSchema", schema),
    ])

## The `ail` arguments for a tool call, or why the call is wrong (mcp.call.2).
struct Cmd
    argv List[str]
    why str
    stdin str

## A boolean argument: a JSON `true` or the text "true".
fn on(a Json, key str) bool
    a.flag(key, false) or a.text(key, "") == "true"

## The `--budget N` pair for a call that gave `budget` as a number or as text, else nothing.
fn budget_args(a Json) List[str]
    n := a.int("budget") else
        t := a.text("budget", "")
        return if t == "" then [] else ["--budget", t]
    ["--budget", "{n}"]

## The first argument that would be read as an option, or "" (mcp.call.4).
fn dashed(a Json, keys List[str]) str
    for k in keys
        if a.text(k, "").starts_with("-")
            return k
    ""

fn command(name str, a Json) Cmd
    mut out := List[str]()
    mut stdin := ""
    for t in tools()
        if t.name != name
            continue
        for n in t.needs
            if (a.str(n) else "") == ""
                return Cmd(argv: [], why: "{name} needs `{n}`", stdin: "")
        bad := dashed(a, [
            "program", "symbol", "rule", "range", "path", "module", "form", "topic", "words", "sig",
            "function", "base", "ours", "theirs", "cert",
        ])
        if bad != ""
            return Cmd(
                argv: [],
                why: "{name}: `{bad}` must not start with - (mcp.call.4)",
                stdin: "",
            )
        program := a.text("program", "")
        since := a.text("since", "")
        rev := a.text("rev", "")
        match name
            "ail_check" => out = if a.text("fix", "") == "true" then [
                "check",
                "--fix",
                program,
            ] else ["check", program]
            "ail_test" =>
                bundle := a.text("bundle", "")
                if program == "" and bundle == ""
                    return Cmd(argv: [], why: "ail_test needs `program` or `bundle`", stdin: "")
                if bundle != ""
                    out = ["test", "--bundle", bundle]
                else
                    out = ["test", program, "--bundle-failure"]
                    if since != ""
                        out.extend(["--affected", "--since", since])
            "ail_ask" =>
                out = ["ask", program]
                out.extend(a.text("question", "").split(" "))
            "ail_verify" => out = [
                "verify",
                "--diff",
                "--json",
                "--rev",
                if rev == "" then "HEAD" else rev,
                program,
            ]
            "ail_impact" => out = [
                "ask",
                program,
                "--affected",
                "--json",
                "--rev",
                if rev == "" then "HEAD" else rev,
            ]
            "ail_context" =>
                out = ["context", program, a.text("symbol", "")]
                out.extend(budget_args(a))
                if on(a, "json")
                    out.push("--json")
            "ail_edit" =>
                out = ["edit"]
                out.extend(budget_args(a))
                for f in ["test", "impact", "dry_run"]
                    if on(a, f)
                        out.push("--{f.replace("_", "-")}")
                out.push(program)
                # The edits may arrive as text or, leniently, as a JSON value (mcp.tools.2).
                e := a.get("edits") else Json.Null
                stdin = e.as_str() else e.to_text()
            "ail_fix" =>
                out = ["fix"]
                out.extend(budget_args(a))
                if on(a, "dry_run")
                    out.push("--dry-run")
                out.push(program)
            "ail_explain" =>
                out = ["explain"]
                out.extend(budget_args(a))
                if on(a, "json")
                    out.push("--json")
                if a.text("rule", "") != ""
                    out.push(a.text("rule", ""))
            "ail_api" =>
                form := a.text("form", "card")
                match form
                    "card" => out = ["api", "--card"]
                    "index" => out = ["api", "--card", "--index"]
                    "outline" => out = ["api", "--outline"]
                    "symbols" => out = ["api", "--symbols"]
                    "text" => out = ["api", "--text"]
                    "pretty" => out = ["api", "--pretty"]
                    _ => return Cmd(argv: [], why: "ail_api: unknown form {form}", stdin: "")
                if a.text("module", "") != ""
                    out.extend(["--module", a.text("module", "")])
                out.extend(budget_args(a))
                if on(a, "json")
                    out.push("--json")
                out.push(program)
            "ail_review" =>
                out = ["review", a.text("range", "")]
                if a.text("path", "") != ""
                    out.push(a.text("path", ""))
                out.extend(budget_args(a))
                if on(a, "json")
                    out.push("--json")
            "ail_card" =>
                out = ["card"]
                if a.text("topic", "") != ""
                    out.push(a.text("topic", ""))
            "ail_find" =>
                words := a.text("words", "")
                sig := a.text("sig", "")
                if words == "" and sig == ""
                    return Cmd(argv: [], why: "ail_find needs `words` or `sig`", stdin: "")
                out = ["ask", "std"]
                if sig != ""
                    out.extend(["--sig", sig])
                else
                    out.extend(words.split(" "))
            "ail_try" =>
                # try.in.2: the patch sets travel as one JSON array on standard input; `--apply` is never passed.
                sets := a.get("sets") else Json.Null
                mut items := List[Json]()
                if listed := sets.as_arr()
                    items = listed
                else
                    one := sets.as_str() else ""
                    if one.trim() != ""
                        items.push(Json.Str(one))
                if items.is_empty()
                    return Cmd(argv: [], why: "ail_try needs `sets`: a list of patch sets", stdin: "")
                out = ["try", program, "--sets-json"]
                stdin = Json.Arr(items).to_text()
            "ail_prove" => out = ["prove", program]
            "ail_infer" => out = ["infer", "--contracts", a.text("function", ""), program]
            "ail_merge_check" =>
                out = ["merge", "--check"]
                base := a.text("base", "")
                if base != ""
                    out.extend([base, a.text("ours", ""), a.text("theirs", "")])
                else
                    out.extend([a.text("ours", ""), a.text("theirs", "")])
                    if a.text("path", "") != ""
                        out.push(a.text("path", ""))
            "ail_verify_check" => out = ["verify", "--check", a.text("cert", "")]
            "task_start" =>
                out = ["task", "start", program, a.text("goal", ""), "--json"]
                if rev != ""
                    out.extend(["--rev", rev])
            "task_verify" =>
                out = ["task", "verify", "--json"]
                if a.text("fix", "") == "true"
                    out.push("--fix")
            _ => out = ["task", name.slice(5, name.len()), "--json"]
        return Cmd(argv: out, why: "", stdin: stdin)
    Cmd(argv: [], why: "unknown tool {name}", stdin: "")

fn reply(id Json, result Json)
    print(
        obj([
            member("jsonrpc", Json.Str("2.0")),
            member("id", id),
            member("result", result),
        ]).to_text(),
    )

fn failure(id Json, code int, message str)
    err := obj([member("code", Json.Num(code.to_float())), member("message", Json.Str(message))])
    print(
        obj([member("jsonrpc", Json.Str("2.0")), member("id", id), member("error", err)]).to_text(),
    )

## A tool result (mcp.call.1): the text and whether the command failed (mcp.call.1).
## When the command ran with `--json` and printed one JSON object, that object also goes
## out as `structuredContent` (mcp.call.3).
## `_meta` says how the call was answered (mcp.warm.4).
fn tool_result(text str, bad bool, structured Json?, how str) Json
    content := Json.Arr([obj([member("type", Json.Str("text")), member("text", Json.Str(text))])])
    mut members := [member("content", content), member("isError", Json.Bool(bad))]
    if s := structured
        members.push(member("structuredContent", s))
    members.push(member("_meta", obj([member("ail/warm", Json.Str(how))])))
    obj(members)

fn has_json(argv List[str]) bool
    for x in argv
        if x == "--json"
            return true
    false

## The parsed standard output of a `--json` command when it is exactly one object, else none.
fn structured_of(cmd Cmd, out str) Json?
    if not has_json(cmd.argv)
        return none
    v := parse_json(out.trim()) else return none
    _ := v.as_obj() else return none
    v

## The tools that only read their program and the toolchain, so an unchanged call can be
## answered from the memo (mcp.warm.2).
fn pure(name str, a Json) bool
    match name
        "ail_check" | "ail_ask" | "ail_context" | "ail_api" | "ail_explain" => true
        "ail_card" | "ail_find" | "ail_prove" => true
        "ail_fix" => on(a, "dry_run")
        _ => false

fn call(mut w warm.Warm, id Json, params Json)
    name := params.text("name", "")
    args := params.get("arguments") else obj([])
    cmd := command(name, args)
    if cmd.why != ""
        failure(id, -32602, cmd.why)
        return
    ail := env.get("AIL") else "./ail"
    program := args.text("program", "")
    got := w.run(ail, cmd.argv, cmd.stdin, pure(name, args), program) else err
        reply(id, tool_result("can't run ail: {err}", true, none, "launcher"))
        return
    ran := got.out
    text := "{ran.out}{ran.err}"
    # A clean check prints nothing; say so (mcp.call.1).
    shown := if text.trim() == "" then "ok (exit {ran.status})" else text
    reply(id, tool_result(shown, ran.status != 0, structured_of(cmd, ran.out), got.how))

## One message (mcp.proto.1: `initialize`, `ping`, `tools/list`, `tools/call`; anything else is -32601).
fn handle(mut w warm.Warm, req Json)
    method := req.text("method", "")
    id := req.get("id") else
        # A notification (`notifications/initialized`) has no id and gets no reply (mcp.proto.2).
        return
    params := req.get("params") else obj([])
    match method
        "initialize" =>
            info := obj([member("name", Json.Str("ail")), member("version", Json.Str("0.1.0"))])
            caps := obj([member("tools", obj([]))])
            reply(id, obj([
                member("protocolVersion", Json.Str(params.text("protocolVersion", PROTOCOL))),
                member("capabilities", caps),
                member("serverInfo", info),
            ]))
        "ping" => reply(id, obj([]))
        "tools/list" => reply(id, obj([member("tools", Json.Arr([tool_json(t) for t in tools()]))]))
        "tools/call" => call(mut w, id, params)
        _ => failure(id, -32601, "unknown method {method}")

fn main() !
    mut w := warm.start()
    while true
        line := io.read_line() else break
        if line.trim() == ""
            continue
        req := parse_json(line) else err
            failure(Json.Null, -32700, err.message)
            continue
        handle(mut w, req)
