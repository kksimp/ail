# Regex: find every token like abc123 in N generated words, then replace the vowels.
use std.regex

WORDS := ["alpha7", "beta42", "gamma", "delta1234", "eps", "zeta99", "eta12345", "theta", "iota3", "kappa808"]

fn size(default int) int
    args := env.args()
    if args.len() == 0
        return default
    n := args[0].to_int() else return default
    n

fn main()
    n := size(100000)
    mut seed := 11
    mut ws := List[str]()
    for _ in 0..n
        seed = (seed * 3877 + 29573) % 139968
        ws.push(WORDS[seed % WORDS.len()])
    text := ws.join(" ")
    tok := regex.compile(r"[a-z]+[0-9]{2,4}") else return
    found := regex.find_all(tok, text)
    mut total := 0
    for m in found
        total += m.text.len()
    vowels := regex.compile(r"[aeiou]") else return
    swapped := regex.replace(vowels, text, "_")
    print("tokens {found.len()}, token bytes {total}, replaced {swapped.len()} {swapped.slice(0, 30)}")
