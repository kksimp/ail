# URL parsing: N URLs with a port, path, query and fragment; totals of the parts.
use std.url

fn size(default int) int
    args := env.args()
    if args.len() == 0
        return default
    n := args[0].to_int() else return default
    n

fn main() !
    n := size(100000)
    mut ports := 0
    mut chars := 0
    for i in 0..n
        s := "https://host{i % 50}.example.com:{8000 + i % 100}/a/b{i}?q={i}&r=x#f{i}"
        u := url.parse(s)?
        ports += u.port else 0
        chars += u.host.len() + u.path.len() + u.query.len() + u.fragment.len()
    print("urls {n}, ports {ports}, chars {chars}")
