## `ail verify --diff` (ADR 0909, verify.run.1-4): what a change proved, what the
## tests exercised and what nothing looked at.
##   ail run tools/verify/verify.ail --diff [--rev REV] [--json] FILE
## It composes the commands that exist: `ail ask FILE --affected` for the changes
## and the tests they reach (api.impact.1-4), `ail check FILE` for the proof and
## `ail test FILE --affected` for the tests. The exit status is 0 when the program
## checks and no affected test fails, 1 when not, and 2 for a usage error.

## The compiler to drive: `$AIL`, else `./ail`.
fn ail_path() str
    env.get("AIL") else "./ail"

fn usage() int
    io.eprint("usage: ail verify --diff [--rev REV] [--json] FILE")
    io.exit(2)
    2

## The strings of the array member `key` of `doc`.
fn strs(doc Json, key str) List[str]
    mut out := List[str]()
    items := doc.arr(key) else return out
    for j in items
        if s := j.as_str()
            out.push(s)
    out

fn obj(members List[(str, Json)]) Json
    Json.Obj([JsonMember(m.0, m.1) for m in members])

fn text_list(xs List[str]) Json
    Json.Arr([Json.Str(x) for x in xs])

fn main() !
    mut rev := "HEAD"
    mut json := false
    mut diff := false
    mut want := ""
    mut files := List[str]()
    for a in env.args()
        if want == "--rev"
            rev = a
            want = ""
        elif a == "--rev"
            want = a
        elif a == "--diff"
            diff = true
        elif a == "--json"
            json = true
        else
            files.push(a)
    if not want.is_empty() or not diff or files.len() != 1
        io.exit(usage())
    file := files[0]
    # verify.run.1: the changes since REV, and the tests they can reach.
    asked := proc.run(ail_path(), [
        "ask",
        file,
        "--affected",
        "--rev",
        rev,
        "--json",
    ])? "running ail ask"
    if asked.status != 0
        io.eprint(asked.err)
        io.exit(2)
    impact := parse_json(asked.out.trim()) else err
        io.eprint("error: can't read the impact of {file}: {err.message}")
        io.exit(2)
        return
    changed := strs(impact, "changed")
    mut effects := List[str]()
    for e in impact.arr("effects") else []
        effects.push("{e.text("id", "?")}: {strs(e, "old").join(" ")} -> {strs(e, "new").join(" ")}")
    # verify.run.2: proved is what the checker accepts; the missing `main` of a library is not an error.
    checked := proc.run(ail_path(), ["check", file])? "running ail check"
    check_ok := checked.status == 0 or checked.err.contains("error[mod.main.1]")
    mut check_errors := List[str]()
    if not check_ok
        check_errors = [l for l in checked.err.lines() if l.contains("error[")]
    # verify.run.3: tested is the affected tests that ran.
    mut passed := List[str]()
    mut failed := List[str]()
    mut skipped := List[str]()
    if check_ok
        ran := proc.run(ail_path(), [
            "test",
            file,
            "--affected",
            "--since",
            rev,
            "--json",
        ])? "running ail test"
        for t in parse_json_lines(ran.out)
            name := t.text("test", "")
            if name.is_empty()
                continue
            status := t.text("status", "")
            note := t.text("message", "")
            if status == "pass"
                passed.push(name)
            elif status == "fail"
                failed.push("{name}: {note}")
            else
                skipped.push("{name}: {note}")
    # verify.run.4: unverified is what no test result speaks for.
    mut unverified := List[str]()
    if check_ok and not changed.is_empty() and passed.len() + failed.len() == 0
        unverified.push("no test ran for the {changed.len()} changed declarations")
    for e in effects
        unverified.push("effects changed: {e}")
    for s in skipped
        unverified.push("test skipped: {s}")
    mut failures := List[str]()
    for e in check_errors
        failures.push("check: {e}")
    for f in failed
        failures.push("test: {f}")
    if json
        print(
            obj([
                ("verify", Json.Num(1.0)),
                ("rev", Json.Str(rev)),
                ("proved", obj([("check", Json.Str(if check_ok then "ok" else "errors")), ("changed", text_list(changed))])),
                ("tested", obj([("passed", text_list(passed)), ("failed", text_list(failed))])),
                ("unverified", text_list(unverified)),
                ("failures", text_list(failures)),
            ]).to_text(),
        )
    else
        print("verify {file} against {rev}")
        print("proved: check {if check_ok then "ok" else "FAILED"}; {changed.len()} changed declarations")
        for c in changed
            print("  {c}")
        print("tested: {passed.len()} passed, {failed.len()} failed")
        for p in passed
            print("  ok {p}")
        print("unverified: {unverified.len()}")
        for u in unverified
            print("  {u}")
        print("failures: {failures.len()}")
        for f in failures
            print("  {f}")
    io.exit(if failures.is_empty() then 0 else 1)
