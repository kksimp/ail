## `ail verify --diff` (ADR 0909, verify.run.1-5): what a change proved, what the
## tests exercised and what nothing looked at.
##   ail run tools/verify/verify.ail --diff [--rev REV] [--json] FILE
##   ail run tools/verify/verify.ail --diff [--rev REV] [--mutate [--max N]] --attest OUT FILE
##   ail run tools/verify/verify.ail --check CERT
## `--attest` writes the change certificate and `--check` re-runs it (ADR 1052, verify.cert.1-4).
## It composes the commands that exist: `ail ask FILE --affected` for the changes
## and the tests they reach (api.impact.1-4), `ail check FILE` for the proof and
## `ail test FILE --affected` for the tests. The exit status is 0 when the program
## checks and no affected test fails that did not already fail at REV, 1 when not, and 2 for a usage error.

use std.hash

## The name every scratch directory of this program starts with (ADR 1059); `remove_scrap` removes no other tree.
SCRAP_PREFIX := "ail-verify-"

## The `tar` to unpack with: on Windows its own `tar.exe`, since Git's GNU tar reads `C:/x` as a host name.
fn tar_path() str
    if (env.get("OS") else "") != "Windows_NT"
        return "tar"
    own := "{(env.get("SystemRoot") else "C:/Windows").replace("\\", "/")}/System32/tar.exe"
    if fs.exists(own) then own else "tar"

## `rm -f`: a failure is ignored.
fn rm_file(target str)
    fs.remove(target) else return

## Remove the scratch directory `root` and everything in it, which `fs.make_temp_dir` made (ADR 1059). It refuses
## any other name, and a symbolic link to a directory is removed as a link (`fs.walk` lists it as a file).
fn remove_scrap(root str)
    if not path.base(root).starts_with(SCRAP_PREFIX)
        return
    files := fs.walk(root) else return
    mut links := Set[str]()
    for f in files
        links.add(f)
    scrap_tree(root, links)

fn scrap_tree(dir str, files Set[str])
    names := fs.list_dir(dir) else return
    for name in names
        p := path.join(dir, name)
        if files.contains(p)
            rm_file(p)
            continue
        scrap_tree(p, files)
    rm_file(dir)

## The compiler to drive: `$AIL`, else `./ail`.
fn ail_path() str
    env.get("AIL") else "./ail"

fn usage() int
    io.eprint("usage: ail verify --diff [--rev REV] [--json] [--mutate [--max N]] [--attest OUT] FILE")
    io.eprint("       ail verify --check CERT")
    io.exit(2)
    2

## The strings of the array member `key` of `doc`.
fn strs(doc Json, key str) List[str]
    mut out := List[str]()
    items := doc.arr(key) else return out
    for j in items
        if s := j.as_str()
            out.push(s)
    out

fn obj(members List[(str, Json)]) Json
    Json.Obj([JsonMember(m.0, m.1) for m in members])

## The number member `key` of `doc`, 0 when it is missing.
fn num_of(doc Json, key str) float
    doc.num(key) else 0.0

fn text_list(xs List[str]) Json
    Json.Arr([Json.Str(x) for x in xs])

## The names of the tests that fail in the program at git revision `rev` (verify.run.5), and none
## when that revision can't be built or run. The tree at REV is unpacked into a scratch directory.
fn failing_at(file str, rev str) BaseRun
    mut names := List[str]()
    if file.starts_with("/")
        return BaseRun(names: names, ran: false)
    tmp := fs.make_temp_dir(SCRAP_PREFIX) else return BaseRun(names: names, ran: false)
    pre := proc.run("git", ["rev-parse", "--show-prefix"]) else
        remove_scrap(tmp)
        return BaseRun(names: names, ran: false)
    # `git archive` to a tar file, then `tar` reads it: no shell pipe (ADR 1059).
    tar := "{tmp}/.rev.tar"
    cut := proc.run("git", ["archive", "--format=tar", "-o", tar, rev]) else
        remove_scrap(tmp)
        return BaseRun(names: names, ran: false)
    unpacked := proc.run(tar_path(), ["-x", "-f", tar, "-C", tmp]) else
        remove_scrap(tmp)
        return BaseRun(names: names, ran: false)
    rm_file(tar)
    mut ran := false
    if cut.status == 0 and unpacked.status == 0
        old := run_tests("{tmp}/{pre.out.trim()}{file}", [])
        # Status 0 is all passed and 1 some failed (verify.run.3); anything else is no result.
        ran = old.status == 0 or old.status == 1
        for t in parse_json_lines(old.out)
            if t.text("status", "") == "fail"
                names.push(t.text("test", ""))
    remove_scrap(tmp)
    BaseRun(names: names, ran: ran)

## The failing tests of the tree at a revision, and whether that tree could be tested at all (verify.run.5).
struct BaseRun
    names List[str]
    ran bool

## `ail test FILE --json` with `extra` arguments; a failure to start it is status 127.
fn run_tests(file str, extra List[str]) proc.Output
    mut args := ["test", file]
    args.extend(extra)
    args.push("--json")
    r := proc.run(ail_path(), args) else return proc.Output(
        status: 127,
        out: "",
        err: "could not start ail test",
    )
    r

## The first non-blank line of `s`, trimmed.
fn first_line(s str) str
    for l in s.lines()
        if not l.trim().is_empty()
            return l.trim()
    ""

fn status_of(doc Json) str
    doc.text("status", "")

fn unavailable(reason str) Json
    obj([("status", Json.Str("unavailable")), ("reason", Json.Str(reason))])

## The contracts `ail prove` discharges (verify.run.6): how many of the program's checks are proved, and each
## unproved check of a changed declaration. `unavailable` says why when `ail prove` gave no answer.
fn prove_contracts(file str, changed List[str]) Json
    ran := proc.run(ail_path(), [
        "prove",
        "--json",
        file,
    ]) else return unavailable("could not start ail prove")
    if ran.status != 0
        return unavailable("ail prove exited {ran.status}: {first_line(ran.err)}")
    doc := parse_json(ran.out.trim()) else return unavailable("ail prove printed no JSON")
    mut open := List[str]()
    for c in doc.arr("contracts") else []
        if c.flag("proved", false)
            continue
        callee := c.text("fn", "")
        caller := c.text("in", "")
        mut hit := false
        for d in changed
            if names_fn(d, callee) or (not caller.is_empty() and names_fn(d, caller))
                hit = true
        if hit
            open.push("{c.text("at", "")}: {c.text("kind", "")} `{c.text("cond", "")}` of {callee} is checked at run time, not proved")
    obj([
        ("status", Json.Str("ok")),
        ("proved", Json.Num(num_of(doc, "proved"))),
        ("total", Json.Num(num_of(doc, "total"))),
        ("unproved_in_changed", text_list(open)),
    ])

## The environment a result depends on (verify.cert.1): the host, and the settings that change what a run does.
fn environment() Json
    mut host := "Windows_NT"
    if (env.get("OS") else "") != "Windows_NT"
        u := proc.run("uname", ["-sm"]) else return obj([("host", Json.Str("unknown"))])
        host = first_line(u.out)
    settings := obj([
        ("AIL_THREADS", Json.Str(env.get("AIL_THREADS") else "unset")),
        ("AIL_PARALLEL", Json.Str(env.get("AIL_PARALLEL") else "unset")),
        ("AIL_MAX_MEMORY_MB", Json.Str(env.get("AIL_MAX_MEMORY_MB") else "unset")),
        ("AIL_TIMEOUT_MS", Json.Str(env.get("AIL_TIMEOUT_MS") else "unset")),
        ("AIL_ALLOW", Json.Str(env.get("AIL_ALLOW") else "unset")),
        ("AIL_OPT_OFF", Json.Str(env.get("AIL_OPT_OFF") else "unset")),
    ])
    obj([("host", Json.Str(host)), ("settings", settings)])

## The package root of `file`: its directory, or the nearest ancestor with an `ail.pkg`.
fn input_root(file str) str
    mut dir := path.dir(file)
    if dir.is_empty()
        dir = "."
    mut probe := dir
    for _ in 0..8
        if fs.exists(path.join(probe, "ail.pkg"))
            return probe
        up := path.dir(probe)
        if up.is_empty() or up == probe
            break
        probe = up
    dir

## What the program is made of (verify.cert.1): one digest over the `.ail` and `.h` files under the root and its
## `ail.pkg` and `ail.lock`, whether or not git tracks them, as `files` counts only the changed ones.
fn inputs(file str) Json
    root := input_root(file)
    found := fs.walk(root) else return obj([
        ("root", Json.Str(root)),
        ("error", Json.Str("could not list the files")),
    ])
    mut lines := List[str]()
    for f in found
        cut := f.slice(root.len(), f.len())
        rel := if cut.starts_with("/") then cut.slice(1, cut.len()) else cut
        if rel.starts_with(".git/") or rel.starts_with(".ail/") or rel.starts_with(".native/")
            continue
        base := path.base(f)
        if f.ends_with(".ail") or f.ends_with(".h") or base == "ail.pkg" or base == "ail.lock"
            data := fs.read_bytes(f) else continue
            lines.push("{hash.sha256(data)} {rel}")
    lines.sort()
    obj([
        ("root", Json.Str(root)),
        ("count", Json.Num(lines.len().to_float())),
        ("sha256", Json.Str(hash.sha256("{lines.join("\n")}\n"))),
    ])

## The paths changed since `rev` (tracked changes and new files) with the git hash of each (verify.cert.1).
fn changed_files(rev str, attest str) Json
    mut paths := List[str]()
    tracked := proc.run("git", [
        "diff",
        "--name-only",
        "--relative",
        rev,
        "--",
    ]) else return Json.Arr([])
    for l in tracked.out.lines()
        if not l.trim().is_empty()
            paths.push(l.trim())
    fresh := proc.run("git", [
        "ls-files",
        "--others",
        "--exclude-standard",
    ]) else return Json.Arr([])
    for l in fresh.out.lines()
        if not l.trim().is_empty() and not paths.contains(l.trim())
            paths.push(l.trim())
    paths.sort()
    mut out := List[Json]()
    for p in paths
        # The certificate being written, and the one a `--check` re-run reads, are not part of the change.
        if p == attest or "{p}.recheck" == attest
            continue
        # Tool state (`ail task`'s ledger and certificate) is not part of the change either (task.finish.3).
        if p.starts_with(".ail/") or p == ".ail-task"
            continue
        h := proc.run("git", ["hash-object", "--", p]) else continue
        digest := if h.status == 0 then h.out.trim() else "deleted"
        out.push(obj([("path", Json.Str(p)), ("hash", Json.Str(digest))]))
    Json.Arr(out)

## Whether the declaration id `id` is the function `name`.
fn names_fn(id str, name str) bool
    id == name or id.ends_with(".{name}") or id.ends_with(" {name}") or id.contains(".{name}(")

## The mutation score of `file` and the surviving mutants in the changed declarations (verify.cert.1, ADR 1022).
fn mutation(file str, changed List[str], limit str) Json
    ran := proc.run(ail_path(), ["test", "--mutate", "--json", "--max", limit, file]) else
        return obj([("error", Json.Str("could not run ail test --mutate"))])
    mut survivors := List[str]()
    mut summary := obj([("error", Json.Str("no mutation summary: {ran.err.trim()}"))])
    for m in parse_json_lines(ran.out)
        if m.flag("mutate", false)
            summary = obj([
                ("mutants", Json.Num(num_of(m, "mutants"))),
                ("killed", Json.Num(num_of(m, "killed"))),
                ("survived", Json.Num(num_of(m, "survived"))),
                ("invalid", Json.Num(num_of(m, "invalid"))),
            ])
        elif m.text("status", "") == "survived"
            name := m.text("fn", "")
            mut hit := false
            for c in changed
                if names_fn(c, name)
                    hit = true
            if hit
                at := "{m.text("file", file)}:{num_of(m, "line").to_int()}"
                survivors.push("{at}: {m.text("mutation", "")} (in {name})")
    obj([
        ("max", Json.Str(limit)),
        ("score", summary),
        ("survivors_in_changed", text_list(survivors)),
    ])

## The compact text of member `key` of `doc`, or `absent`.
fn member_text(doc Json, key str) str
    v := doc.get(key) else return "absent"
    v.to_text()

## The members of a certificate that a re-run must reproduce, in order. `rev` is left out: `base` names the revision.
fn cert_keys() List[str]
    [
        "cert",
        "base",
        "file",
        "compiler",
        "env",
        "inputs",
        "files",
        "checked",
        "contracts",
        "tested",
        "unverified",
        "failures",
        "effects",
        "mutation",
    ]

## `ail verify --check CERT` (verify.cert.3-4): re-run the certificate against its base and name every member that differs.
fn check_cert(path str) int
    text := fs.read_text(path) else
        io.eprint("error[verify.cert.4]: can't read {path}")
        return 2
    cert := parse_json(text.trim()) else err
        io.eprint("error[verify.cert.4]: {path} is not a certificate: {err.message}")
        return 2
    if num_of(cert, "cert") == 1.0
        io.eprint("error[verify.cert.4]: {path} is a version 1 certificate; make it again with `ail verify --attest`")
        return 2
    if num_of(cert, "cert") != 2.0
        io.eprint("error[verify.cert.4]: {path} is not a change certificate")
        return 2
    file := cert.text("file", "")
    base := cert.text("base", "")
    if file.is_empty() or base.is_empty()
        io.eprint("error[verify.cert.4]: {path} lacks `file` or `base`")
        return 2
    # The re-run's certificate goes beside CERT, so no scratch directory is needed.
    out := "{path}.recheck"
    mut args := ["verify", "--diff", "--rev", base, "--attest", out]
    if m := cert.get("mutation")
        args.push("--mutate")
        args.push("--max")
        args.push(m.text("max", "50"))
    args.push(file)
    ran := proc.run(ail_path(), args) else
        io.eprint("error[verify.cert.4]: can't run ail verify")
        return 2
    if ran.status == 2
        io.eprint("error[verify.cert.4]: the re-run failed: {ran.err.trim()}")
        return 2
    fresh_text := fs.read_text(out) else
        io.eprint("error[verify.cert.4]: the re-run wrote no certificate")
        return 2
    fs.remove(out) else return 2
    fresh := parse_json(fresh_text.trim()) else
        io.eprint("error[verify.cert.4]: the re-run wrote no certificate")
        return 2
    mut differs := List[str]()
    for k in cert_keys()
        old_v := member_text(cert, k)
        new_v := member_text(fresh, k)
        if old_v != new_v
            differs.push(k)
            print("differs: {k}")
            print("  certificate: {old_v}")
            print("  now:         {new_v}")
    if differs.is_empty()
        print("certificate holds: {cert_keys().len()} members reproduce")
        return 0
    print("certificate differs in {differs.len()} members")
    1

fn main() !
    mut rev := "HEAD"
    mut json := false
    mut diff := false
    mut want := ""
    mut files := List[str]()
    mut attest := ""
    mut check := ""
    mut mutate := false
    mut limit := "50"
    for a in env.args()
        if want == "--rev"
            rev = a
            want = ""
        elif want == "--attest"
            attest = a
            want = ""
        elif want == "--check"
            check = a
            want = ""
        elif want == "--max"
            limit = a
            want = ""
        elif a == "--rev" or a == "--attest" or a == "--check" or a == "--max"
            want = a
        elif a == "--mutate"
            mutate = true
        elif a == "--diff"
            diff = true
        elif a == "--json"
            json = true
        else
            files.push(a)
    if not check.is_empty()
        and want.is_empty()
        and not diff
        and files.is_empty()
        and attest.is_empty()
        io.exit(check_cert(check))
    # verify.cert.2: `--attest` needs `--diff`, and `--mutate` needs `--attest`.
    if not want.is_empty()
        or not diff
        or files.len() != 1
        or not check.is_empty()
        or (mutate and attest.is_empty())
        io.exit(usage())
    file := files[0]
    # verify.run.1: the changes since REV, and the tests they can reach.
    asked := proc.run(ail_path(), [
        "ask",
        file,
        "--affected",
        "--rev",
        rev,
        "--json",
    ])? "running ail ask"
    if asked.status != 0
        io.eprint(asked.err)
        io.exit(2)
    impact := parse_json(asked.out.trim()) else err
        io.eprint("error: can't read the impact of {file}: {err.message}")
        io.exit(2)
        return
    changed := strs(impact, "changed")
    # verify.run.4: the changed declarations each affected test reaches (`reaches`, api.impact.4), when given.
    mut reached := Set[str]()
    mut per_test := false
    if reaches := impact.get("reaches")
        per_test = true
        for t in strs(impact, "tests")
            for id in strs(reaches, t)
                reached.add(id)
    mut effects := List[str]()
    for e in impact.arr("effects") else []
        effects.push("{e.text("id", "?")}: {strs(e, "old").join(" ")} -> {strs(e, "new").join(" ")}")
    # verify.run.2: proved is what the checker accepts; the missing `main` of a library is not an error.
    checked := proc.run(ail_path(), ["check", "--no-tests", file])? "running ail check"
    check_ok := checked.status == 0 or checked.err.contains("error[mod.main.1]")
    mut check_errors := List[str]()
    if not check_ok
        check_errors = [l for l in checked.err.lines() if l.contains("error[")]
    # verify.run.6: contracts are what `ail prove` discharges; it needs a program that checks.
    mut contracts := unavailable("the program does not check")
    if check_ok
        contracts = prove_contracts(file, changed)
    # verify.run.3: tested is the affected tests that ran, in one of five states.
    mut passed := List[str]()
    mut failed := List[str]()
    mut skipped := List[str]()
    mut state := "not-tested"
    mut test_note := "the program does not check"
    if check_ok
        ran := run_tests(file, ["--affected", "--since", rev])
        for t in parse_json_lines(ran.out)
            name := t.text("test", "")
            if name.is_empty()
                continue
            status := t.text("status", "")
            note := t.text("message", "")
            if status == "pass"
                passed.push(name)
            elif status == "fail"
                failed.push("{name}: {note}")
            else
                skipped.push("{name}: {note}")
        test_note = ""
        if passed.len() + failed.len() + skipped.len() == 0 and ran.status != 0
            state = "could-not-run"
            test_note = first_line("{ran.err}\n{ran.out}")
        elif failed.len() > 0
            state = "failed"
        elif passed.len() > 0
            state = "passed"
        else
            state = "none-ran"
    # verify.run.4: unverified is what no test result speaks for.
    mut unverified := List[str]()
    if state == "could-not-run"
        unverified.push("the tests could not run: {test_note}")
    elif state == "not-tested"
        unverified.push("no test ran: {test_note}")
    elif not changed.is_empty() and passed.len() + failed.len() == 0
        unverified.push("no test ran for the {changed.len()} changed declarations")
    elif per_test
        for c in changed
            if not reached.contains(c)
                unverified.push("no test reaches {c}")
    if impact.flag("partial", false)
        unverified.push("the edited version has check errors, so the impact is partial")
    for e in effects
        unverified.push("effects changed: {e}")
    for s in skipped
        unverified.push("test skipped: {s}")
    if c := contracts.get("reason")
        unverified.push("contracts not checked by ail prove: {c.as_str() else ""}")
    for u in strs(contracts, "unproved_in_changed")
        unverified.push("contract not proved: {u}")
    mut failures := List[str]()
    for e in check_errors
        failures.push("check: {e}")
    # verify.run.5: a failing test that also fails at REV is old; the rest are new.
    mut old_fails := List[str]()
    mut base_state := "not-needed"
    if not failed.is_empty()
        base := failing_at(file, rev)
        old_fails = base.names
        base_state = if base.ran then "ran" else "could-not-run"
        if not base.ran
            unverified.push("{rev} could not be tested, so old failures can't be told from new")
    mut blocking := check_errors.len()
    for f in failed
        name := f.slice(0, f.find(":") else f.len())
        if old_fails.contains(name)
            failures.push("old test: {f}")
        else
            failures.push("new test: {f}")
            blocking += 1
    checked_part := obj([
        ("static", Json.Str(if check_ok then "ok" else "errors")),
        ("changed", text_list(changed)),
    ])
    tested_part := obj([
        ("state", Json.Str(state)),
        ("passed", text_list(passed)),
        ("failed", text_list(failed)),
        ("skipped", text_list(skipped)),
        ("base", Json.Str(base_state)),
    ])
    if json
        print(
            obj([
                ("verify", Json.Num(2.0)),
                ("rev", Json.Str(rev)),
                ("checked", checked_part),
                ("contracts", contracts),
                ("tested", tested_part),
                ("unverified", text_list(unverified)),
                ("failures", text_list(failures)),
            ]).to_text(),
        )
    else
        print("verify {file} against {rev}")
        print("checked: static check {if check_ok then "ok" else "FAILED"}; {changed.len()} changed declarations")
        for c in changed
            print("  {c}")
        if status_of(contracts) == "ok"
            print("contracts: {num_of(contracts, "proved").to_int()} of {num_of(contracts, "total").to_int()} proved by ail prove")
        else
            print("contracts: unavailable ({contracts.text("reason", "")})")
        print("tested: {state}; {passed.len()} passed, {failed.len()} failed, {skipped.len()} skipped")
        for p in passed
            print("  ok {p}")
        print("unverified: {unverified.len()}")
        for u in unverified
            print("  {u}")
        print("failures: {failures.len()}")
        for f in failures
            print("  {f}")
    # verify.cert.1: the certificate is the same evidence plus what it was made from.
    if not attest.is_empty()
        base := proc.run("git", ["rev-parse", rev]) else
            io.eprint("error[verify.cert.1]: can't resolve {rev}")
            io.exit(2)
            return
        ver := proc.run(ail_path(), ["version"]) else
            io.eprint("error: can't run ail version")
            io.exit(2)
            return
        mut members := [
            ("cert", Json.Num(2.0)),
            ("base", Json.Str(base.out.trim())),
            ("rev", Json.Str(rev)),
            ("file", Json.Str(file)),
            ("compiler", Json.Str(ver.out.trim())),
            ("env", environment()),
            ("inputs", inputs(file)),
            ("files", changed_files(rev, attest)),
            ("checked", checked_part),
            ("contracts", contracts),
            ("tested", tested_part),
            ("unverified", text_list(unverified)),
            ("failures", text_list(failures)),
            ("effects", text_list(effects)),
        ]
        if mutate and check_ok
            members.push(("mutation", mutation(file, changed, limit)))
        fs.write_text(attest, "{obj(members).to_text()}\n") else
            io.eprint("error[verify.cert.1]: can't write {attest}")
            io.exit(2)
            return
    io.exit(if blocking == 0 then 0 else 1)
