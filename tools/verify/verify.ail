## `ail verify --diff` (ADR 0909, verify.run.1-5): what a change proved, what the
## tests exercised and what nothing looked at.
##   ail run tools/verify/verify.ail --diff [--rev REV] [--json] FILE
##   ail run tools/verify/verify.ail --diff [--rev REV] [--mutate [--max N]] --attest OUT FILE
##   ail run tools/verify/verify.ail --check CERT
## `--attest` writes the change certificate and `--check` re-runs it (ADR 1052, verify.cert.1-4).
## It composes the commands that exist: `ail ask FILE --affected` for the changes
## and the tests they reach (api.impact.1-4), `ail check FILE` for the proof and
## `ail test FILE --affected` for the tests. The exit status is 0 when the program
## checks and no affected test fails that did not already fail at REV, 1 when not, and 2 for a usage error.

## The compiler to drive: `$AIL`, else `./ail`.
fn ail_path() str
    env.get("AIL") else "./ail"

fn usage() int
    io.eprint("usage: ail verify --diff [--rev REV] [--json] [--mutate [--max N]] [--attest OUT] FILE | ail verify --check CERT")
    io.exit(2)
    2

## The strings of the array member `key` of `doc`.
fn strs(doc Json, key str) List[str]
    mut out := List[str]()
    items := doc.arr(key) else return out
    for j in items
        if s := j.as_str()
            out.push(s)
    out

fn obj(members List[(str, Json)]) Json
    Json.Obj([JsonMember(m.0, m.1) for m in members])

## The number member `key` of `doc`, 0 when it is missing.
fn num_of(doc Json, key str) float
    doc.num(key) else 0.0

fn text_list(xs List[str]) Json
    Json.Arr([Json.Str(x) for x in xs])

## The names of the tests that fail in the program at git revision `rev` (verify.run.5), and none
## when that revision can't be built or run. The tree at REV is unpacked into a scratch directory.
fn failing_at(file str, rev str) List[str]
    if file.starts_with("/")
        return []
    mut names := List[str]()
    made := proc.run("mktemp", ["-d"]) else return names
    tmp := made.out.trim()
    pre := proc.run("git", ["rev-parse", "--show-prefix"]) else return names
    unpacked := proc.run("sh", ["-c", "git archive '{rev}' | tar -x -C '{tmp}'"]) else return names
    if unpacked.status == 0
        old := proc.run(ail_path(), [
            "test",
            "{tmp}/{pre.out.trim()}{file}",
            "--json",
        ]) else return names
        for t in parse_json_lines(old.out)
            if t.text("status", "") == "fail"
                names.push(t.text("test", ""))
    _ := proc.run("rm", ["-rf", tmp]) else return names
    names

## The paths changed since `rev` (tracked changes and new files) with the git hash of each (verify.cert.1).
fn changed_files(rev str) Json
    mut paths := List[str]()
    tracked := proc.run("git", ["diff", "--name-only", "--relative", rev, "--"]) else return Json.Arr([])
    for l in tracked.out.lines()
        if not l.trim().is_empty()
            paths.push(l.trim())
    fresh := proc.run("git", ["ls-files", "--others", "--exclude-standard"]) else return Json.Arr([])
    for l in fresh.out.lines()
        if not l.trim().is_empty() and not paths.contains(l.trim())
            paths.push(l.trim())
    paths.sort()
    mut out := List[Json]()
    for p in paths
        h := proc.run("git", ["hash-object", "--", p]) else continue
        hash := if h.status == 0 then h.out.trim() else "deleted"
        out.push(obj([("path", Json.Str(p)), ("hash", Json.Str(hash))]))
    Json.Arr(out)

## Whether the declaration id `id` is the function `name`.
fn names_fn(id str, name str) bool
    id == name or id.ends_with(".{name}") or id.ends_with(" {name}") or id.contains(".{name}(")

## The mutation score of `file` and the surviving mutants in the changed declarations (verify.cert.1, ADR 1022).
fn mutation(file str, changed List[str], max str) Json
    ran := proc.run(ail_path(), ["test", "--mutate", "--json", "--max", max, file]) else
        return obj([("error", Json.Str("could not run ail test --mutate"))])
    mut survivors := List[str]()
    mut summary := obj([("error", Json.Str("no mutation summary: {ran.err.trim()}"))])
    for m in parse_json_lines(ran.out)
        if m.flag("mutate", false)
            summary = obj([
                ("mutants", Json.Num(num_of(m, "mutants"))),
                ("killed", Json.Num(num_of(m, "killed"))),
                ("survived", Json.Num(num_of(m, "survived"))),
                ("invalid", Json.Num(num_of(m, "invalid"))),
            ])
        elif m.text("status", "") == "survived"
            name := m.text("fn", "")
            mut hit := false
            for c in changed
                if names_fn(c, name)
                    hit = true
            if hit
                survivors.push("{m.text("file", file)}:{num_of(m, "line").to_int()}: {m.text("mutation", "")} (in {name})")
    obj([("max", Json.Str(max)), ("score", summary), ("survivors_in_changed", text_list(survivors))])

## The members of a certificate that a re-run must reproduce, in order. `rev` is left out: `base` names the revision.
fn cert_keys() List[str]
    ["cert", "base", "file", "compiler", "files", "proved", "tested", "unverified", "failures", "effects", "mutation"]

## `ail verify --check CERT` (verify.cert.3-4): re-run the certificate against its base and name every member that differs.
fn check_cert(path str) int
    text := fs.read_text(path) else
        io.eprint("error[verify.cert.4]: can't read {path}")
        return 2
    cert := parse_json(text.trim()) else err
        io.eprint("error[verify.cert.4]: {path} is not a certificate: {err.message}")
        return 2
    if num_of(cert, "cert") != 1.0
        io.eprint("error[verify.cert.4]: {path} is not a change certificate")
        return 2
    file := cert.text("file", "")
    base := cert.text("base", "")
    if file.is_empty() or base.is_empty()
        io.eprint("error[verify.cert.4]: {path} lacks `file` or `base`")
        return 2
    made := proc.run("mktemp", ["-d"])? "running mktemp"
    tmp := made.out.trim()
    out := "{tmp}/cert.json"
    mut args := ["verify", "--diff", "--rev", base, "--attest", out]
    if m := cert.get("mutation")
        args.push("--mutate")
        args.push("--max")
        args.push(m.text("max", "50"))
    args.push(file)
    _ := proc.run(ail_path(), args)? "running ail verify"
    fresh_text := fs.read_text(out) else
        _ := proc.run("rm", ["-rf", tmp]) else return 2
        io.eprint("error[verify.cert.4]: the re-run wrote no certificate")
        return 2
    _ := proc.run("rm", ["-rf", tmp]) else return 2
    fresh := parse_json(fresh_text.trim()) else
        io.eprint("error[verify.cert.4]: the re-run wrote no certificate")
        return 2
    mut differs := List[str]()
    for k in cert_keys()
        old_v := if v := cert.get(k) then v.to_text() else "absent"
        new_v := if v := fresh.get(k) then v.to_text() else "absent"
        if old_v != new_v
            differs.push(k)
            print("differs: {k}")
            print("  certificate: {old_v}")
            print("  now:         {new_v}")
    if differs.is_empty()
        print("certificate holds: {cert_keys().len()} members reproduce")
        return 0
    print("certificate differs in {differs.len()} members")
    1

fn main() !
    mut rev := "HEAD"
    mut json := false
    mut diff := false
    mut want := ""
    mut files := List[str]()
    mut attest := ""
    mut check := ""
    mut mutate := false
    mut max := "50"
    for a in env.args()
        if want == "--rev"
            rev = a
            want = ""
        elif want == "--attest"
            attest = a
            want = ""
        elif want == "--check"
            check = a
            want = ""
        elif want == "--max"
            max = a
            want = ""
        elif a == "--rev" or a == "--attest" or a == "--check" or a == "--max"
            want = a
        elif a == "--mutate"
            mutate = true
        elif a == "--diff"
            diff = true
        elif a == "--json"
            json = true
        else
            files.push(a)
    if not check.is_empty() and want.is_empty() and not diff and files.is_empty() and attest.is_empty()
        io.exit(check_cert(check))
    # verify.cert.2: `--attest` needs `--diff`, and `--mutate` needs `--attest`.
    if not want.is_empty() or not diff or files.len() != 1 or not check.is_empty() or (mutate and attest.is_empty())
        io.exit(usage())
    file := files[0]
    # verify.run.1: the changes since REV, and the tests they can reach.
    asked := proc.run(ail_path(), [
        "ask",
        file,
        "--affected",
        "--rev",
        rev,
        "--json",
    ])? "running ail ask"
    if asked.status != 0
        io.eprint(asked.err)
        io.exit(2)
    impact := parse_json(asked.out.trim()) else err
        io.eprint("error: can't read the impact of {file}: {err.message}")
        io.exit(2)
        return
    changed := strs(impact, "changed")
    # verify.run.4: the changed declarations each affected test reaches (`reaches`, api.impact.4), when given.
    mut reached := Set[str]()
    mut per_test := false
    if reaches := impact.get("reaches")
        per_test = true
        for t in strs(impact, "tests")
            for id in strs(reaches, t)
                reached.add(id)
    mut effects := List[str]()
    for e in impact.arr("effects") else []
        effects.push("{e.text("id", "?")}: {strs(e, "old").join(" ")} -> {strs(e, "new").join(" ")}")
    # verify.run.2: proved is what the checker accepts; the missing `main` of a library is not an error.
    checked := proc.run(ail_path(), ["check", file])? "running ail check"
    check_ok := checked.status == 0 or checked.err.contains("error[mod.main.1]")
    mut check_errors := List[str]()
    if not check_ok
        check_errors = [l for l in checked.err.lines() if l.contains("error[")]
    # verify.run.3: tested is the affected tests that ran.
    mut passed := List[str]()
    mut failed := List[str]()
    mut skipped := List[str]()
    if check_ok
        ran := proc.run(ail_path(), [
            "test",
            file,
            "--affected",
            "--since",
            rev,
            "--json",
        ])? "running ail test"
        for t in parse_json_lines(ran.out)
            name := t.text("test", "")
            if name.is_empty()
                continue
            status := t.text("status", "")
            note := t.text("message", "")
            if status == "pass"
                passed.push(name)
            elif status == "fail"
                failed.push("{name}: {note}")
            else
                skipped.push("{name}: {note}")
    # verify.run.4: unverified is what no test result speaks for.
    mut unverified := List[str]()
    if check_ok and not changed.is_empty() and passed.len() + failed.len() == 0
        unverified.push("no test ran for the {changed.len()} changed declarations")
    elif per_test
        for c in changed
            if not reached.contains(c)
                unverified.push("no test reaches {c}")
    if impact.flag("partial", false)
        unverified.push("the edited version has check errors, so the impact is partial")
    for e in effects
        unverified.push("effects changed: {e}")
    for s in skipped
        unverified.push("test skipped: {s}")
    mut failures := List[str]()
    for e in check_errors
        failures.push("check: {e}")
    # verify.run.5: a failing test that also fails at REV is old; the rest are new.
    mut old_fails := List[str]()
    if not failed.is_empty()
        old_fails = failing_at(file, rev)
    mut blocking := check_errors.len()
    for f in failed
        name := f.slice(0, f.find(":") else f.len())
        if old_fails.contains(name)
            failures.push("old test: {f}")
        else
            failures.push("new test: {f}")
            blocking += 1
    if json
        print(
            obj([
                ("verify", Json.Num(1.0)),
                ("rev", Json.Str(rev)),
                ("proved", obj([("check", Json.Str(if check_ok then "ok" else "errors")), ("changed", text_list(changed))])),
                ("tested", obj([("passed", text_list(passed)), ("failed", text_list(failed))])),
                ("unverified", text_list(unverified)),
                ("failures", text_list(failures)),
            ]).to_text(),
        )
    else
        print("verify {file} against {rev}")
        print("proved: check {if check_ok then "ok" else "FAILED"}; {changed.len()} changed declarations")
        for c in changed
            print("  {c}")
        print("tested: {passed.len()} passed, {failed.len()} failed")
        for p in passed
            print("  ok {p}")
        print("unverified: {unverified.len()}")
        for u in unverified
            print("  {u}")
        print("failures: {failures.len()}")
        for f in failures
            print("  {f}")
    # verify.cert.1: the certificate is the same evidence plus what it was made from.
    if not attest.is_empty()
        base := proc.run("git", ["rev-parse", rev]) else
            io.eprint("error[verify.cert.1]: can't resolve {rev}")
            io.exit(2)
            return
        ver := proc.run(ail_path(), ["version"]) else
            io.eprint("error: can't run ail version")
            io.exit(2)
            return
        mut members := [
            ("cert", Json.Num(1.0)),
            ("base", Json.Str(base.out.trim())),
            ("rev", Json.Str(rev)),
            ("file", Json.Str(file)),
            ("compiler", Json.Str(ver.out.trim())),
            ("files", changed_files(rev)),
            ("proved", obj([("check", Json.Str(if check_ok then "ok" else "errors")), ("changed", text_list(changed))])),
            ("tested", obj([("passed", text_list(passed)), ("failed", text_list(failed))])),
            ("unverified", text_list(unverified)),
            ("failures", text_list(failures)),
            ("effects", text_list(effects)),
        ]
        if mutate and check_ok
            members.push(("mutation", mutation(file, changed, max)))
        fs.write_text(attest, "{obj(members).to_text()}\n") else
            io.eprint("error[verify.cert.1]: can't write {attest}")
            io.exit(2)
            return
    io.exit(if blocking == 0 then 0 else 1)
