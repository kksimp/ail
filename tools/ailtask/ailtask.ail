## `ail task` in AIL (ADR 0917, task.*): one open task per directory, kept in `.ail-task`.
##   ail run tools/ailtask/ailtask.ail start PROGRAM GOAL... [--rev REV]
##   ail run tools/ailtask/ailtask.ail status|verify|finish|abort|log [--json]
##   finish                  writes the change certificate `.ail/cert.json` (task.finish.3)
##   verify --fix            applies the compiler's safe fixes before the check (fix.check.2)
## Every `verify` adds a line to `.ail/task-log.jsonl` (task.log.1-3); nothing leaves the machine.
## It adds no analysis: `status` is `ail ask PROGRAM --affected --json`, `verify` is `ail check`
## then `ail test --affected`, and every answer ends with `next`, the one command to run after it.

## The task file in the current directory (task.state.1).
STATE := ".ail-task"

## The ledger of verify runs, one JSON object a line (task.log.1).
LOG_DIR := ".ail"

LOG := ".ail/task-log.jsonl"

## The change certificate `finish` writes (task.finish.3, verify.cert.1).
CERT := ".ail/cert.json"

## Lines of failing output `verify` shows (task.verify.3).
TAIL_LINES := 20

struct Job
    program str
    goal str
    rev str
    ## `none`, `green` or `red`: the last `verify`.
    last str
    ## Lines the ledger had when the task opened: the task's own lines come after them (task.log.2).
    mark int

## The compiler to drive: `$AIL`, else `./ail`.
fn ail_path() str
    env.get("AIL") else "./ail"

fn quote(s str) str
    "\"{s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")}\""

fn load_task() Job?
    text := fs.read_text(STATE) else return none
    mut t := Job(program: "", goal: "", rev: "", last: "none", mark: 0)
    for l in text.lines()
        at := l.find("=") else continue
        k := l.slice(0, at)
        v := l.slice(at + 1, l.len())
        if k == "program"
            t.program = v
        elif k == "goal"
            t.goal = v
        elif k == "rev"
            t.rev = v
        elif k == "last"
            t.last = v
        elif k == "mark"
            t.mark = v.to_int() else 0
    if t.program.is_empty()
        return none
    t

fn save_task(t Job) !
    fs.write_text(
        STATE,
        "program={t.program}\ngoal={t.goal}\nrev={t.rev}\nlast={t.last}\nmark={t.mark}\n",
    )? "writing {STATE}"

## The output's last `TAIL_LINES` lines.
fn tail(out str) str
    ls := [l for l in out.lines() if l.trim() != ""]
    from := if ls.len() > TAIL_LINES then ls.len() - TAIL_LINES else 0
    ls[from..].join("\n")

struct Ran
    status int
    ## Stdout, then stderr.
    out str

## Runs `ail ARGS...`.
fn ail(args List[str]) Ran
    r := proc.run(ail_path(), args) else err
        return Ran(status: 2, out: "can't run ail: {err}")
    Ran(status: r.status, out: "{r.out}{r.err}")

## A cheap token estimate, the one `ail api --card` uses (api.card.3, ADR 0311): a run of letters or digits
## costs one token per five characters (at least one), any other non-space character one, a newline one.
fn estimate_tokens(s str) int
    mut tokens := 0
    mut run := 0
    for c in s.chars()
        if c.is_alpha() or c.is_digit() or c == '_'
            run += 1
            continue
        if run > 0
            tokens += (run + 4) / 5
            run = 0
        if c == '\n' or not c.is_space()
            tokens += 1
    tokens + (run + 4) / 5

## The rule IDs a toolchain output names, in order of first appearance: `error[R]`, `warning[R]`, `trap[R]` (task.log.1).
fn rules_in(out str) List[str]
    mut found := List[str]()
    for l in out.lines()
        t := l.trim()
        for p in ["error[", "warning[", "trap["]
            # A diagnostic line is `FILE:L:C: error[R]: ...` (a trap has no prefix).
            from := if t.starts_with(p) then 0 else (t.find(": {p}") else -1) + 2
            if from >= 0 and (t.starts_with(p) or from > 1)
                rest := t.slice(from + p.len(), t.len())
                at := rest.find("]") else continue
                r := rest.slice(0, at)
                if not r.is_empty()
                    found.push(r)
    found

## `{"a":2,"b":1}` of the rules with how often each appears, first seen first.
fn counts_json(rules List[str]) str
    mut order := List[str]()
    for r in rules
        if not order.contains(r)
            order.push(r)
    mut parts := List[str]()
    for r in order
        parts.push("{quote(r)}:{[x for x in rules if x == r].len()}")
    "\{{parts.join(",")}}"

fn ledger_lines() List[str]
    text := fs.read_text(LOG) else return []
    [l for l in text.lines() if l.trim() != ""]

## Adds one line to the ledger (task.log.1).
fn append_log(line str) !
    if not fs.exists(LOG_DIR)
        fs.make_dir(LOG_DIR)? "making {LOG_DIR}"
    fs.append_text(LOG, "{line}\n")? "writing {LOG}"

## The text of `"key":` in a ledger line up to the next `,` or `}` (the ledger's own fixed layout, task.log.1).
fn field(line str, key str) str
    at := line.find("\"{key}\":") else return ""
    rest := line.slice(at + key.len() + 3, line.len())
    if rest.starts_with("\"")
        return rest.slice(1, rest.len()).split("\"")[0]
    if rest.starts_with("\{")
        cut := rest.find("}") else rest.len() - 1
        return "{rest.slice(0, cut)}}"
    rest.split(",")[0].split("}")[0]

## The rules `{"a":2}` holds, one entry per count.
fn rules_of(obj str) List[str]
    mut out := List[str]()
    body := obj.trim().strip_prefix("\{") else ""
    inner := body.strip_suffix("}") else ""
    if inner.is_empty()
        return out
    for pair in inner.split(",")
        cut := pair.split("\":")
        if cut.len() != 2
            continue
        name := cut[0].trim().strip_prefix("\"") else ""
        for _ in 0..(cut[1].to_int() else 0)
            out.push(name)
    out

## The summary of ledger lines (task.log.2): `rounds`, `red` rounds, `fixed` fixes, toolchain `tokens` and the `rules` hit.
fn summary_json(lines List[str]) str
    mut red := 0
    mut fixed := 0
    mut tokens := 0
    mut rules := List[str]()
    for l in lines
        if field(l, "result") == "red"
            red += 1
        fixed += field(l, "fixed").to_int() else 0
        tokens += field(l, "tokens").to_int() else 0
        rules.extend(rules_of(field(l, "rules")))
    "\{\"rounds\":{lines.len()},\"red\":{red},\"fixed\":{fixed},\"tokens\":{tokens},\"rules\":{counts_json(rules)}}"

## The ledger lines of the open task, or all of them with none open (task.log.2).
fn scope_lines() List[str]
    all := ledger_lines()
    if t := load_task()
        if t.mark < all.len()
            return all[t.mark..]
        return []
    all

fn usage() int
    io.eprint("usage: ailtask start PROGRAM GOAL... [--rev REV] | status | verify [--fix] | finish | abort | log  [--json]")
    io.exit(2)
    2

## Prints the answer (task.out.1): `fields` are JSON members already rendered, `text` the same for a person.
fn answer(json bool, fields List[str], text str)
    if json
        print("\{{fields.join(",")}}")
    else
        print(text)

## No open task (task.state.2).
fn no_task() int
    io.eprint("error: no open task here; start one with `ail task start PROGRAM GOAL...` (task.state.2)")
    2

## `start` (task.start.1: the base must compare; task.state.2: one open task per directory).
fn start(args List[str], json bool) !int
    mut rev := "HEAD"
    mut words := List[str]()
    mut i := 0
    while i < args.len()
        a := args[i]
        i += 1
        if a == "--rev"
            if i >= args.len()
                io.eprint("error: `--rev` needs a git revision (task.start.1)")
                return 2
            rev = args[i]
            i += 1
        elif a != "--json"
            words.push(a)
    if words.len() < 2
        return usage()
    if open := load_task()
        io.eprint("error: task `{open.goal}` is already open; run `ail task finish` or `ail task abort` first (task.state.2)")
        return 2
    got := ail(["ask", words[0], "--affected", "--rev", rev, "--json"])
    if got.status != 0
        io.eprint("error: {rev} can't be compared with {words[0]} (task.start.1)\n{got.out}")
        return 2
    t := Job(
        program: words[0],
        goal: words[1..].join(" "),
        rev: rev,
        last: "none",
        mark: ledger_lines().len(),
    )
    save_task(t)?
    next := "edit {t.program}, then `ail task verify`"
    answer(
        json,
        [
            "\"task\":\"open\"",
            "\"program\":{quote(t.program)}",
            "\"goal\":{quote(t.goal)}",
            "\"rev\":{quote(rev)}",
            "\"next\":{quote(next)}",
        ],
        "task open: {t.goal}\nbase {rev}; next: {next}",
    )
    0

## `status` (task.status.1): the impact since the base and the last verify.
fn status(json bool) int
    t := load_task() else return no_task()
    got := ail(["ask", t.program, "--affected", "--rev", t.rev, "--json"])
    if got.status != 0
        io.eprint("error: {got.out}")
        return 2
    next := if t.last == "green" then "ail task finish" else "ail task verify"
    answer(
        json,
        [
            "\"task\":\"open\"",
            "\"goal\":{quote(t.goal)}",
            "\"verified\":{quote(t.last)}",
            "\"impact\":{got.out.trim()}",
            "\"next\":{quote(next)}",
        ],
        "task: {t.goal}\nverified: {t.last}\nimpact: {got.out.trim()}\nnext: {next}",
    )
    0

## The `fixed N: ...` line `check --fix` printed (fix.check.1), or "".
fn fixed_line_of(out str) str
    for l in out.lines()
        if l.starts_with("fixed ") and "0123456789".contains(l.slice(6, 7))
            return l.trim()
    ""

## N of `fixed N: ...`, 0 for no line.
fn fixed_count(line str) int
    if line == ""
        return 0
    n := line.slice(6, line.len()).split(":")[0]
    n.to_int() else 0

## `verify` (task.verify.1-3): check, then the affected tests; records the result for `finish`.
## With `fix` the check applies the safe fixes first (fix.check.2). Every run adds a ledger line (task.log.1).
fn verify(json bool, fix bool) !int
    mut t := load_task() else return no_task()
    t0 := time.now_ms()
    mut stage := "check"
    mut ok := true
    mut shown := ""
    mut fixed := ""
    mut raw := ""
    # The reproducible failure files `ail test --bundle-failure` wrote (task.verify.4).
    mut bundles := List[str]()
    chk := ail(
        if fix then [
            "check",
            "--no-tests",
            "--fix",
            t.program,
        ] else ["check", "--no-tests", t.program],
    )
    fixed = fixed_line_of(chk.out)
    raw = chk.out
    if chk.status != 0
        ok = false
        shown = tail(chk.out)
    else
        stage = "test"
        tst := ail(["test", t.program, "--affected", "--since", t.rev, "--bundle-failure"])
        raw = "{raw}{tst.out}"
        if tst.status != 0
            ok = false
            shown = tail(tst.out)
            bundles = [
                l.trim().slice(8, l.trim().len())
                for l in tst.out.lines() if l.trim().starts_with("bundle: ")
            ]
    # A green run adds what `ail verify --diff` says no test looked at (task.verify.5).
    mut report := "null"
    if ok
        rep := ail(["verify", "--diff", "--rev", t.rev, "--json", t.program])
        if rep.out.trim().starts_with("\{")
            report = rep.out.trim()
    t.last = if ok then "green" else "red"
    save_task(t)?
    mut next := if ok then "ail task finish" else "fix the {stage} failure above, then `ail task verify`"
    if bundles.len() > 0
        next = "`ail test --bundle {bundles[0]}` reruns the first failure; fix it, then `ail task verify`"
    result := if ok then "green" else "red"
    fields := [
        "\"result\":\"{result}\"",
        "\"stage\":{quote(stage)}",
        "\"fixed\":{quote(fixed)}",
        "\"output\":{quote(shown)}",
        "\"bundles\":[{[quote(b) for b in bundles].join(",")}]",
        "\"diff\":{report}",
        "\"next\":{quote(next)}",
    ]
    lead := if fixed == "" then "" else "{fixed}\n"
    text := "{lead}verify {result} at {stage}\n{shown}\nnext: {next}"
    printed := if json then "\{{fields.join(",")}}" else text
    nfixed := fixed_count(fixed)
    # task.log.1: the wall time is the one field that differs between two runs of the same change.
    append_log("\{\"stage\":{quote(stage)},\"result\":\"{result}\",\"tokens\":{estimate_tokens(printed)},\"fixed\":{nfixed},\"rules\":{counts_json(rules_in(raw))},\"ms\":{time.now_ms() - t0}}")?
    print(printed)
    # task.verify.2
    if ok then 0 else 1

## `finish` (task.finish.1-2, task.finish.2: the state file goes): refuses unless the last `verify` was green, then reports and closes the task.
fn finish(json bool) !int
    t := load_task() else return no_task()
    if t.last != "green"
        io.eprint("error: the last verify was {t.last}; run `ail task verify` first (task.finish.1)")
        return 1
    got := ail(["ask", t.program, "--affected", "--rev", t.rev, "--json"])
    if got.status != 0
        io.eprint("error: {got.out}")
        return 2
    # task.finish.3: the change certificate; a failing one keeps the task open.
    if not fs.exists(LOG_DIR)
        fs.make_dir(LOG_DIR)? "making {LOG_DIR}"
    cert := ail(["verify", "--diff", "--rev", t.rev, "--attest", CERT, t.program])
    if cert.status != 0
        io.eprint("error: the change certificate failed (task.finish.3); the task stays open\n{tail(cert.out)}")
        return 1
    sum := summary_json(scope_lines())
    if fs.exists(STATE)
        fs.remove(STATE) else return 2
    answer(
        json,
        [
            "\"task\":\"done\"",
            "\"goal\":{quote(t.goal)}",
            "\"verified\":\"green\"",
            "\"impact\":{got.out.trim()}",
            "\"certificate\":{quote(CERT)}",
            "\"summary\":{sum}",
            "\"next\":\"none\"",
        ],
        "task done: {t.goal}\nimpact: {got.out.trim()}\ncertificate: {CERT}\nsummary: {sum}",
    )
    0

fn abort() int
    t := load_task() else return no_task()
    if fs.exists(STATE)
        fs.remove(STATE) else return 2
    print("task aborted: {t.goal}")
    0

## `log` (task.log.3): the ledger lines of the open task (all of them with none open), then their summary.
fn log(json bool) int
    lines := scope_lines()
    sum := summary_json(lines)
    if json
        print("\{\"log\":[{lines.join(",")}],\"summary\":{sum}}")
    else
        for l in lines
            print(l)
        print("summary: {sum}")
    0

fn main() !
    args := env.args()
    if args.len() == 0
        io.exit(usage())
    json := args.contains("--json")
    rest := args[1..]
    mut code := 2
    match args[0]
        "start" => code = start(rest, json)?
        "status" => code = status(json)
        "verify" => code = verify(json, args.contains("--fix"))?
        "log" => code = log(json)
        "finish" => code = finish(json)?
        "abort" => code = abort()
        _ => code = usage()
    io.exit(code)
