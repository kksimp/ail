## The gate in AIL (RR-4, ADR 0855): drives `ail` over the suites the Rust
## selftest checks for programs, without cargo, and prints only what failed.
##   ail run tools/gate/gate.ail [SUITE...]      from the repository root
## Suites: `examples` (each examples/NAME.ail with a NAME.out builds natively
## and prints it), `native` (each bootstrap/tests/native/run program builds
## natively and behaves like `ail run`), `selfhost` (tools/self-host/run.sh).
## No argument runs them all. The last line is `GATE GREEN` or
## `GATE RED (N failures)`; the exit status is 0 only for green.

## Examples without a `native_` name that the native backend takes today
## (the list bootstrap/tests/native_examples.rs keeps). The others find files
## beside `env.program()` or stop at a construct outside the native subset, so
## the selftest runs them with `ail run` only.
NATIVE_EXTRA := [
    "bits",
    "gradebook",
    "hello",
    "parallel",
    "perms",
    "route",
    "shapes",
    "std_args",
    "std_math",
]

struct Gate
    fails int
    built int
    unbuilt List[str]

fn temp_dir() str
    base := env.get("TMPDIR") else "/tmp"
    # Not `ail-gate`: mac-gate.sh keeps its logs there.
    "{base}/ail-gate-ail"

## The programs tests/native.rs skips on macOS (its MACOS_KNOWN list: they
## differ from the interpreter by design), read from that list.
fn macos_known() List[str]
    u := proc.run("uname", []) else return []
    if not u.out.starts_with("Darwin")
        return []
    text := fs.read_text("bootstrap/tests/native.rs") else return []
    at := text.find("MACOS_KNOWN: &[&str]") else return []
    rest := text.slice(at, text.len())
    end := rest.find("];") else return []
    parts := rest.slice(0, end).split("\"")
    # The names are the quoted parts: every second one.
    [parts[i] for i in 0..parts.len() if i % 2 == 1]

## Build `src` natively into `exe`; false (with the reason) if it can't.
fn build(src str, exe str) str?
    r := proc.run("./ail", ["build", src, "-o", exe]) else return "could not start ail"
    if r.status == 0
        return none
    r.err.lines().first() else "build failed"

fn first_lines(text str, n int) str
    text.lines().take(n).join("\n")

fn Gate.red(mut self, name str, why str)
    fails += 1
    print("RED {name}")
    print(first_lines(why, 3))

fn Gate.examples(mut self, tmp str)
    for name in fs.list_dir("examples") else []
        if not name.ends_with(".ail")
            continue
        stem := name.replace(".ail", "")
        if not (stem.starts_with("native_") or NATIVE_EXTRA.contains(stem))
            or not fs.exists("examples/{stem}.out")
            continue
        exe := "{tmp}/ex_{stem}"
        if why := build("examples/{name}", exe)
            unbuilt.push("examples/{name}")
            continue
        built += 1
        got := proc.run(exe, []) else
            red("examples/{name}", "could not run the executable")
            continue
        want := fs.read_text("examples/{stem}.out") else ""
        if got.status != 0 or got.out != want
            red(
                "examples/{name}",
                "exit {got.status}; output differs from {stem}.out\n{got.out}{got.err}",
            )

## A native program must behave like the interpreter: same stdout, same exit.
fn Gate.native(mut self, tmp str)
    skip := macos_known()
    for name in fs.list_dir("bootstrap/tests/native/run") else []
        if not name.ends_with(".ail")
            continue
        stem := name.replace(".ail", "")
        if skip.contains(stem)
            continue
        src := "bootstrap/tests/native/run/{name}"
        exe := "{tmp}/nt_{stem}"
        if why := build(src, exe)
            red(src, "native build failed: {why}")
            continue
        built += 1
        want := proc.run("./ail", ["run", src]) else
            red(src, "ail run could not start")
            continue
        got := proc.run(exe, []) else
            red(src, "could not run the executable")
            continue
        if got.status != want.status or got.out != want.out
            red(src, "differs from `ail run`: exit {got.status} vs {want.status}\n{got.out}")

fn Gate.selfhost(mut self)
    r := proc.run("tools/self-host/run.sh", [], none, 3600000) else
        red("selfhost", "could not start tools/self-host/run.sh")
        return
    if r.status != 0
        red("selfhost", r.out.lines().last() else "failed")

fn main() !
    args := env.args()
    all := ["examples", "native", "selfhost"]
    suites := if args.len() == 0 then all else args
    tmp := temp_dir()
    fs.make_dir(tmp)? "creating {tmp}"
    mut g := Gate(fails: 0, built: 0, unbuilt: [])
    for s in suites
        match s
            "examples" => g.examples(tmp)
            "native" => g.native(tmp)
            "selfhost" => g.selfhost()
            _ =>
                io.eprint("unknown suite {s}; suites: {all.join(" ")}")
                io.exit(2)
    _ := proc.run("rm", ["-rf", tmp]) else return
    if g.unbuilt.len() > 0
        print("{g.unbuilt.len()} examples are not native yet: {g.unbuilt.join(" ")}")
    if g.fails == 0
        print("GATE GREEN ({g.built} built)")
    else
        print("GATE RED ({g.fails} failures)")
        io.exit(1)
