## The gate in AIL (RR-4, ADR 0855): drives `./ail` over the suites and prints only what failed.
##   ail run tools/gate/gate.ail [SUITE...]      from the repository root
## Suites: `examples` (each examples/NAME.ail with a NAME.out builds natively and prints it), `corpus` and `corpus_sets` (ADR 1174), `cases`, `explain`, `fix`,
## `cli`, `mistakes`, `contracts`, `snapshot`, `misc`, `docs`, `fmt`, `budget`, `limits`, `diff`, `build_cache`,
## `api_queries`, `replay`, `api_card`, `edit`, `git_deps`, `net` (starts tools/gate/net_server.py), `spec` (runs
## tools/gate/spec.ail), `crypto` (the TLS and crypto vectors, and the parser fuzzers, of tools/native-tls), `tools` (the editor, Garlic and the PDF reader), `std` (the AIL std sources check, format and are
## called), `agent_tools` (context, infer, probes, sanitize, leak, fuzz, mutate and the language server), `apicontract` (positions, fix edits and the MCP schemas as a contract, ADR 1117), `parity` (tools/gate/parity.ail:
## one line per feature, the same on the three hosts but for tests/parity/expected-differences.txt), `selfhost` (tools/self-host/run.sh, or run.ps1 on Windows; only when named).
## The native run programs are tools/gate/goldens.ail and nativex.
## Run it through tools/gate/mac-gate.sh, or with AIL_APP_HOST set to a missing path: a std.app program
## (examples/app_todo.ail) would otherwise open the host's window and wait for ever.
## No argument runs every suite but `selfhost`. The last line is `GATE GREEN` or
## `GATE RED (N failures)`; the exit status is 0 only for green.

## Examples without a `native_` name that the native backend takes today
## (the list tools/gate/goldens.ail keeps). The others find files
## beside `env.program()` or stop at a construct outside the native subset, so
## the selftest runs them with `ail run` only.
NATIVE_EXTRA := [
    "bits",
    "gradebook",
    "hello",
    "parallel",
    "perms",
    "route",
    "shapes",
    "std_args",
    "std_math",
]

struct Gate
    fails int
    built int
    unbuilt List[str]
    # `NAME@K/N` runs shard K (from 0) of N of a suite that has shards (`cases`): item i belongs to shard i % N.
    # Every item is counted in `seq` whichever shard runs it, so the shards cover the suite exactly once.
    part int
    shard_count int
    seq int
    ran int

## True when this run's shard owns the next item of a sharded suite (always, for an unsharded run).
fn Gate.mine(mut self) bool
    i := self.seq
    self.seq += 1
    owned := self.shard_count <= 1 or i % self.shard_count == self.part
    if owned
        self.ran += 1
    owned

## The names directly under `dir`, sorted. A sharded run takes them from git (`git ls-files`), not the working tree: each
## shard is its own process, started at its own time, and a file a running test writes beside the sources (the hidden
## copy of an `ail fix` round, say) gave one shard of `cases` a different total from the others. Outside a git checkout,
## and in an unsharded run, it is the directory listing.
fn Gate.listing(self, dir str) List[str]
    listed := (fs.list_dir(dir) else []).sorted()
    if self.shard_count <= 1
        return listed
    r := proc.run("git", ["ls-files", "--", dir]) else return listed
    if r.status != 0
        return listed
    mut found := Set[str]()
    mut picked := List[str]()
    for l in r.out.lines()
        if l.starts_with("{dir}/")
            first := l.slice(dir.len() + 1, l.len()).split("/")[0]
            if not found.contains(first)
                found.add(first)
                picked.push(first)
    if picked.is_empty() then listed else picked.sorted()

fn temp_dir() str
    # A Windows TMPDIR has backslashes, which `sh -c` scripts would eat: use `/`, which Windows takes too.
    raw := (env.get("TMPDIR") else "/tmp").replace("\\", "/")
    base := if raw.len() > 1 and raw.ends_with("/") then raw.slice(0, raw.len() - 1) else raw
    # Not `ail-gate`: mac-gate.sh keeps its logs there.
    "{base}/ail-gate-ail"

## Build `src` natively into `exe`; false (with the reason) if it can't.
fn build(src str, exe str) str?
    r := proc.run("./ail", ["build", src, "-o", exe]) else return "could not start ail"
    if r.status == 0
        return none
    r.err.lines().first() else "build failed"

## `text` with CRLF line ends as LF.
fn lf(text str) str
    text.replace("\r\n", "\n")

fn alarm_for(stem str) int
    60

fn first_lines(text str, n int) str
    text.lines().take(n).join("\n")

fn Gate.red(mut self, name str, why str)
    self.fails += 1
    print("RED {name}")
    print(first_lines(why, 30))

fn Gate.examples(mut self, tmp str)
    for name in fs.list_dir("examples") else []
        if not name.ends_with(".ail")
            continue
        stem := name.replace(".ail", "")
        if not (stem.starts_with("native_") or NATIVE_EXTRA.contains(stem))
            or not fs.exists("examples/{stem}.out")
            continue
        exe := "{tmp}/ex_{stem}"
        # A std.app program waits for an app host (the cases suite runs those against a fake one).
        if (fs.read_text("examples/{name}") else "").contains("use std.app")
            continue
        if why := build("examples/{name}", exe)
            self.unbuilt.push("examples/{name}")
            continue
        self.built += 1
        # Under a 60 second alarm: one hang is one red example, not a stuck gate.
        got := proc.run("perl", ["-e", "alarm {alarm_for(stem)}; exec @ARGV", exe]) else
            self.red("examples/{name}", "could not run the executable")
            continue
        want := fs.read_text("examples/{stem}.out") else ""
        # Windows may hand a program's lines back as CRLF (a checkout with autocrlf, the console's translation): compare LF.
        if got.status != 0 or lf(got.out) != lf(want)
            self.red(
                "examples/{name}",
                "exit {got.status}; output differs from {stem}.out (got {got.out.len()} bytes, want {want.len()})\n{got.out}{got.err}",
            )

## The public corpus (ADR 1174; the format is corpus/README.md): each program builds natively, prints its `.out`, and passes
## its own `@test`s. The `.out` is the Python twin's output, so the twin is the oracle (tools/corpus/corpus.py check --twins).
## `corpus` is the first set, corpus/NAME/{NAME.ail, NAME.py, NAME.out}; `corpus_sets` is every corpus/sets/SET/NAME/.
fn Gate.corpus(mut self, tmp str)
    for name in self.listing("corpus")
        # Not programs: the other sets, and the mistakes pairs' explanations.
        if name == "sets" or name == "mistakes"
            continue
        self.corpus_program(tmp, "corpus/{name}", name)

fn Gate.corpus_sets(mut self, tmp str)
    for group in self.listing("corpus/sets")
        for name in self.listing("corpus/sets/{group}")
            self.corpus_program(tmp, "corpus/sets/{group}/{name}", name)

## One corpus program, the directory `dir` named `name`; a plain file (a README) is passed over.
fn Gate.corpus_program(mut self, tmp str, dir str, name str)
    meta := fs.metadata(dir) else return
    if not meta.is_dir
        return
    # Sharded (`corpus@K/N`): every program is counted, only this shard's are run (see Gate.mine).
    if not self.mine()
        return
    # corpus/waiting.txt: `NAME reason` lines for programs that wait on a compiler fix; the gate skips them (and says so).
    for w in (fs.read_text("corpus/waiting.txt") else "").lines()
        if w.starts_with("{name} ")
            print("corpus {name} waits on a compiler fix (corpus/waiting.txt)")
            return
    src := "{dir}/{name}.ail"
    if not fs.exists(src) or not fs.exists("{dir}/{name}.py") or not fs.exists("{dir}/{name}.out")
        self.red(dir, "needs {name}.ail, {name}.py and {name}.out")
        return
    exe := "{tmp}/co_{name}"
    if why := build(src, exe)
        self.red(src, "does not build: {why}")
        return
    self.built += 1
    got := proc.run("perl", ["-e", "alarm 60; exec @ARGV", exe]) else
        self.red(src, "could not run the executable")
        return
    want := fs.read_text("{dir}/{name}.out") else ""
    if got.status != 0 or lf(got.out) != lf(want)
        self.red(
            src,
            "exit {got.status}; output differs from {name}.out (got {got.out.len()} bytes, want {want.len()})\n{got.out}{got.err}",
        )
        return
    t := proc.run("./ail", ["test", src], none, 120000) else
        self.red(src, "could not start ail test")
        return
    if t.status != 0
        self.red(src, "ail test failed\n{t.out}{t.err}")

## The check-means-build matrix (ADR 1109): tests/native_matrix/NAME.ail, one program per collection and element
## type that tools/native-matrix/matrix.py wrote with every snippet `ail check` accepts. Each must pass `ail check`,
## build natively and print its NAME.out; a red one is a method the checker accepts and the native build refuses.
fn Gate.native_matrix(mut self, tmp str)
    for name in (fs.list_dir("tests/native_matrix") else []).sorted()
        if not name.ends_with(".ail")
            continue
        if not self.mine()
            continue
        stem := name.replace(".ail", "")
        src := "tests/native_matrix/{name}"
        c := proc.run("./ail", ["check", src]) else
            self.red(src, "could not start ail check")
            continue
        if c.status != 0
            self.red(
                src,
                "ail check refuses it (regenerate with tools/native-matrix/matrix.py)\n{c.out}{c.err}",
            )
            continue
        exe := "{tmp}/nm_{stem}"
        if why := build(src, exe)
            self.red(src, "ail check accepts it but the native build refuses it: {why}")
            continue
        self.built += 1
        got := proc.run("perl", ["-e", "alarm 60; exec @ARGV", exe]) else
            self.red(src, "could not run the executable")
            continue
        want := fs.read_text("tests/native_matrix/{stem}.out") else ""
        if got.status != 0 or lf(got.out) != lf(want)
            self.red(
                src,
                "exit {got.status}; output differs from {stem}.out (got {got.out.len()} bytes, want {want.len()})\n{got.out}{got.err}",
            )

fn Gate.selfhost(mut self)
    # Windows has the fixed point in PowerShell (stages 1 to 3); its native test programs are nativex's.
    mut cmd := "tools/self-host/run.sh"
    mut cmd_args := List[str]()
    if (env.get("OS") else "") == "Windows_NT"
        cmd = "powershell"
        cmd_args = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "tools/self-host/run.ps1"]
    r := proc.run(cmd, cmd_args, none, 3600000) else
        self.red("selfhost", "could not start {cmd}")
        return
    if r.status != 0
        self.red("selfhost", r.out.lines().last() else "failed")

## The parity probe (ADR 0925): tools/gate/parity.ail prints one line per feature, and every line must be
## `FEATURE works` but for the ones tests/parity/expected-differences.txt lists for this host (`HOST FEATURE STATE`,
## then the reason). A listed line that works again is red too, so the file never keeps a difference that is gone.
## The lines are printed, so the three hosts' logs can be laid side by side.
fn Gate.parity(mut self)
    mut host := "linux"
    if (env.get("OS") else "") == "Windows_NT"
        host = "windows"
    elif sh_run("uname -s").out.trim() == "Darwin"
        host = "macos"
    mut expected := Map[str, str]()
    for l in slurp("tests/parity/expected-differences.txt").lines()
        w := l.words()
        if w.len() >= 3 and w[0] == host
            expected[w[1]] = w[2]
    r := proc.run("./ail", ["run", "tools/gate/parity.ail"], "", 3600000) else
        self.red("parity", "could not start tools/gate/parity.ail")
        return
    out_lines := lf(r.out).lines()
    last := out_lines.last() else ""
    if r.status != 0 or not last.starts_with("PARITY ")
        self.red("parity", "parity.ail exit {r.status}\n{r.out}{r.err}")
        return
    mut seen := 0
    for l in out_lines
        print(l)
        w := l.words()
        if w.len() < 2 or w[0] == "PARITY"
            continue
        seen += 1
        want_state := expected.get(w[0]) else "works"
        if w[1] != want_state and want_state == "works"
            self.red(
                "parity {w[0]}",
                "{l}\nnot the same as on the other hosts, and not in tests/parity/expected-differences.txt for {host}",
            )
        elif w[1] != want_state
            self.red(
                "parity {w[0]}",
                "{l}\ntests/parity/expected-differences.txt says `{want_state}` for {host}: update or delete that line",
            )
    if last != "PARITY {seen} features" or seen < 50
        self.red("parity", "the probe printed {seen} feature lines and ended with `{last}`")

## The tools written in AIL. Each check
## runs `ail` from `root` (the repository) and compares its output.
fn cat(a List[str], b List[str]) List[str]
    mut r := a
    r.extend(b)
    r

fn repo_root() str
    # `pwd` from Git's sh names `/c/Users/..`, which Windows programs can't open: take the directory as the
    # runtime sees it, with `/` for the separator (Windows takes it too).
    env.cwd().replace("\\", "/")

## Run `./ail ARGS` in `dir` with `AIL` set, as the editor tests need.
fn ail_in(root str, dir str, args List[str]) proc.Output
    script := "r=$0; d=$1; shift; cd \"$d\" && AIL=\"$r/ail\" exec \"$r/ail\" \"$@\""
    run_args := cat([root, dir], args)
    r := proc.run("sh", cat(["-c", script], run_args)) else return proc.Output(
        status: 127,
        out: "",
        err: "could not start sh",
    )
    r

fn sh_run(script str) proc.Output
    r := proc.run("sh", ["-c", script]) else return proc.Output(
        status: 127,
        out: "",
        err: "could not start sh",
    )
    r

fn Gate.want(mut self, name str, text str, wants List[str])
    for w in wants
        if not text.contains(w)
            self.red(name, "lacks `{w}`:\n{text}")
            return

fn Gate.check_clean(mut self, root str, path str)
    r := ail_in(root, root, ["check", path])
    if r.status != 0 or not r.err.is_empty()
        self.red("ail check {path}", r.err)

fn Gate.tests_pass(mut self, root str, path str)
    r := ail_in(root, root, ["test", path])
    if r.status != 0 or not r.out.contains(" 0 failed")
        self.red("ail test {path}", r.out)

## The end-to-end cases: `examples/` and
## `tests/cases/` hold NAME.ail with one expectation file beside
## it, and `cases/packages/NAME/` a package with expected.EXT files. `at` is
## the path `ail` gets; `exp` the expectation path up to the extension.
fn slurp(p str) str
    fs.read_text(p) else ""

## `ail ARGS`: programs that start `ail` themselves (std.app hosts) find it through AIL.
fn ail_run(args List[str]) proc.Output ! proc.ProcError
    proc.run("sh", cat(
        ["-c", "exec perl -e 'alarm 120; exec @ARGV' \"$PWD/ail\" \"$@\"", "sh"],
        args,
    ))

## A case goes through `./ail`, each under an alarm (`alarm_for`) so one hang is one red case, not a stuck gate (item 309).
fn case_run(args List[str]) proc.Output ! proc.ProcError
    secs := alarm_for(path.stem(args.last() else ""))
    script := "perl -e 'alarm {secs}; exec @ARGV' \"$PWD/ail\" \"$@\""
    proc.run("sh", cat(["-c", script, "sh"], args))

## tests/cases/native_only.txt: the stems of cases that use features only the native CLI has.
fn native_only() List[str]
    text := fs.read_text("tests/cases/native_only.txt") else return []
    [l.trim() for l in text.lines() if not l.trim().is_empty() and not l.starts_with("#")]

## The interpreter always ran tasks in the fixed order (conc.sched.3); the
## native default is free, so the conc cases ask for it. (Not every case:
## `--schedule=fixed` hangs fuzz_net_status_digits natively.)
fn sched(at str) List[str]
    if at.contains("/conc_")
        return ["--schedule=fixed"]
    []

fn run_case(at str, exp str) str?
    out_file := "{exp}out"
    want_out := if fs.exists(out_file) then slurp(out_file) else ""
    if fs.exists("{exp}stderr")
        # trace.run.1: `ail run` with the options in NAME.args, one line.
        flags := slurp("{exp}args").words()
        r := case_run(cat(
            cat(cat(["run"], sched(at)), flags),
            [at],
        )) else return "could not start ail"
        want := slurp("{exp}stderr").replace("$FILE", at)
        if r.status == 2 or r.err != want
            return "standard error differs\n--- expected\n{want}--- actual (exit {r.status})\n{r.err}"
        if r.out != want_out
            return "output differs\n--- expected\n{want_out}--- actual\n{r.out}"
        return none
    if fs.exists("{exp}test")
        r := case_run(["test", "--json", at]) else return "could not start ail"
        want := slurp("{exp}test")
        want_exit := if want.contains("\"status\":\"fail\"") then 1 else 0
        if r.status != want_exit or r.out != want
            return "ail test output differs\n--- expected (exit {want_exit})\n{want}--- actual (exit {r.status})\n{r.out}"
        return none
    if fs.exists("{exp}err")
        flags := slurp("{exp}args").words()
        r := case_run(cat(
            cat(cat(["run"], sched(at)), flags),
            [at],
        )) else return "could not start ail"
        want := slurp("{exp}err").replace("$FILE", at)
        if r.status != 1 or r.err != want
            return "expected exit 1 and this report\n--- expected\n{want}--- actual (exit {r.status})\n{r.err}"
        if r.out != want_out
            return "output differs\n--- expected\n{want_out}--- actual\n{r.out}"
        return none
    if fs.exists("{exp}trap")
        r := case_run(cat(cat(["run"], sched(at)), [at])) else return "could not start ail"
        mut rule := slurp("{exp}trap").trim()
        if r.status != 1 or not r.err.contains("trap[{rule}]")
            return "expected trap[{rule}] (exit 1), got {r.status}\n{r.err}"
        if r.out != want_out
            return "output differs\n--- expected\n{want_out}--- actual\n{r.out}"
        return none
    if fs.exists(out_file)
        r := case_run(cat(cat(["run"], sched(at)), [at])) else return "could not start ail"
        if r.status != 0
            return "exit {r.status}\n{r.err}"
        if r.out != want_out
            return "output differs\n--- expected\n{want_out}--- actual\n{r.out}"
        return none
    if fs.exists("{exp}rules")
        r := case_run(["check", "--json", at]) else return "could not start ail"
        want_exit := if r.err.contains("\"severity\":\"error\"") then 2 else 0
        if r.status != want_exit
            return "expected exit {want_exit}, got {r.status}\n{r.err}"
        mut got := List[str]()
        for l in r.err.lines()
            parts := l.split("\"rule\":\"")
            if parts.len() > 1
                got.push(parts[1].split("\"")[0])
        want := slurp("{exp}rules").lines()
        if got != want
            return "rules differ\n  expected {want}\n  got      {got}\n{r.err}"
        return none
    "needs a .out, .rules, .trap or .err file"

## Stems listed one per line in `path`; `#` starts a comment line.
fn stem_list(path str) List[str]
    text := fs.read_text(path) else ""
    [l.trim() for l in text.lines() if not l.trim().is_empty() and not l.starts_with("#")]

fn Gate.case_dir(mut self, dir str)
    pending_cases := stem_list("tests/native/golden/pending.txt")
    names := self.listing(dir)
    for name in names
        if not name.ends_with(".ail")
            continue
        at := "{dir}/{name}"
        # golden/pending.txt names features the native CLI lacks for now
        # (`ail test --coverage`, `--update`): named here, not checked.
        if pending_cases.contains(name.replace(".ail", ""))
            if self.mine()
                print("PENDING {at}")
            continue
        if not self.mine()
            continue
        if why := run_case(at, "{dir}/{name.replace(".ail", "")}.")
            self.red(at, why)
        else
            self.built += 1

fn Gate.packages(mut self)
    root := "tests/cases/packages"
    names := self.listing(root)
    for name in names
        at := "{root}/{name}"
        if not fs.exists("{at}/expected.out")
            and not fs.exists("{at}/expected.rules")
            and not fs.exists("{at}/expected.trap")
            and not fs.exists("{at}/expected.err")
            continue
        if not self.mine()
            continue
        if why := run_case(at, "{at}/expected.")
            self.red(at, why)
        else
            self.built += 1

## The small checks of cases.rs that name their commands and outputs.
fn Gate.cli_checks(mut self)
    u := ail_run(["nonsense"]) else return
    if u.status != 2
        self.red("usage error", "exit {u.status}, want 2")
    # Diagnostics schema v1 (ADR 0145): version, span and machine-applicable fixes.
    path := "tests/cases/diag_fixes.ail"
    r := ail_run(["check", "--json", path]) else return
    lines := r.err.lines()
    if lines.len() != 2
        or not lines[0].starts_with("\{\"api\":1,")
        or not lines[1].starts_with("\{\"api\":1,")
        self.red("json diagnostics", r.err)
    else
        self.want(
            "json diagnostics: fix of `mut total`",
            lines[0],
            ["\"end_line\":4,\"end_col\":18,\"notes\":[\{\"line\":2,\"col\":9,\"message\":\"`total` is first declared here\"}],\"fixes\":[\{\"title\":\"assign to `total` with `=`\",\"edits\":[\{\"line\":4,\"col\":9,\"end_line\":4,\"end_col\":13,\"text\":\"\",\"expect\":\"mut \"},\{\"line\":4,\"col\":19,\"end_line\":4,\"end_col\":21,\"text\":\"=\",\"expect\":\":=\"}]}]"],
        )
        self.want(
            "json diagnostics: fix of `prnt`",
            lines[1],
            ["\"edits\":[\{\"line\":5,\"col\":5,\"end_line\":5,\"end_col\":9,\"text\":\"print\",\"expect\":\"prnt\"}]"],
        )
    t := ail_run(["check", path]) else return
    self.want("text diagnostics fix line", t.err, [
        "\nfix: write `print(total)`",
        "\nnext: ail fix {path}",
    ])
    # check.out.1-3, check.exit.1: the ok line, the summary record, the next line of an unfixable error, exit statuses.
    ok := ail_run(["check", "examples/hello.ail"]) else return
    if ok.status != 0
        or not ok.out.starts_with("ok examples/hello.ail: ")
        or not ok.out.contains(" functions, 0 warnings")
        self.red("check ok line", "exit {ok.status}\n{ok.out}{ok.err}")
    oj := ail_run(["check", "--json", "examples/hello.ail"]) else return
    if oj.status != 0
        or oj.out.trim() != "\{\"api\":1,\"summary\":true,\"errors\":0,\"warnings\":0,\"fixable\":0}"
        self.red("check --json summary", "exit {oj.status}\n{oj.out}{oj.err}")
    sj := ail_run(["check", "--json", path]) else return
    if sj.status != 2 or not sj.out.contains("\"summary\":true,\"errors\":2,")
        self.red("check --json summary of errors", "exit {sj.status}\n{sj.out}")
    if bad := schema_problem(sj.out.trim())
        self.red("check --json summary schema", bad)
    un := ail_run(["check", "tests/mistakes/abs_function.ail"]) else return
    if un.status != 2 or not un.err.contains("\nnext: ail ")
        self.red("check next line", "exit {un.status}\n{un.err}")
    # check.exit.1: a program that doesn't compile stops `ail run` (2, as `check`) and `ail test` (not 0) before anything runs.
    rb := ail_run(["run", "tests/mistakes/abs_function.ail"]) else return
    if rb.status != 2 or not rb.out.is_empty()
        self.red("run of a program with errors", "exit {rb.status}\n{rb.out}{rb.err}")
    tb := ail_run(["test", "tests/mistakes/abs_function.ail"]) else return
    if tb.status == 0
        self.red("test of a program with errors", "exit 0\n{tb.out}{tb.err}")
    nt := ail_run(["test", "examples/hello.ail"]) else return
    if nt.status != 0
        or not nt.out.starts_with("no tests found in examples/hello.ail\n0 passed, 0 failed")
        self.red("test of a file with no tests", "exit {nt.status}\n{nt.out}{nt.err}")
    nf := ail_run(["check", "tests/cases/no_such_file.ail"]) else return
    if nf.status != 2
        self.red("check missing file exit", "exit {nf.status}, want 2")
    # `ail explain` (ADR 0146): a known rule, JSON, and an unknown rule.
    e1 := ail_run(["explain", "expr.hole.2"]) else return
    if e1.status != 0 or not e1.out.starts_with("expr.hole.2 (05-expressions.md:")
        self.red("explain", e1.out)
    self.want("explain", e1.out, ["Evaluating a hole MUST trap", "(ADR 0147)"])
    e2 := ail_run(["explain", "--json", "expr.bind.4"]) else return
    if not e2.out.starts_with("\{\"api\":1,\"rule\":\"expr.bind.4\",\"file\":\"docs/spec/05-expressions.md\"")
        self.red("explain --json", e2.out)
    self.want("explain --json", e2.out, ["\{\"id\":\"0039\",\"title\":", "\"example\":\"fn total("])
    e3 := ail_run(["explain", "expr.bind.99"]) else return
    if e3.status != 2
        or not e3.err.starts_with("error: unknown rule `expr.bind.99`\nhelp: known rules nearby: expr.bind.1")
        self.red("explain unknown rule", e3.err)
    e4 := ail_run(["explain", "bootstrap.unsupported"]) else return
    if e4.status != 0
        self.red("explain bootstrap.unsupported", "exit {e4.status}")
    # test.prop.3: `--cases` and `--seed` fix a property's inputs.
    prop := "tests/cases/test_prop_fail.ail"
    a := prop_run(["--seed", "7", "--cases", "50"], prop)
    if a != prop_run(
        ["--cases", "50", "--seed", "7"],
        prop,
    ) or a == prop_run(["--seed", "8", "--cases", "50"], prop)
        self.red("property options replay", a)
    self.want("property options replay", a, ["\"seed\":7,", "\"cases\":50"])
    pc := ail_run(["test", "--cases", "x", prop]) else return
    if pc.status != 2
        self.red("property --cases x", "exit {pc.status}, want 2")
    # trace.test.1-2: a failing test's events go in its JSON entry only.
    tp := "tests/trace/test_trace_fail.ail"
    plain := prop_run([], tp)
    if plain.contains("\"trace\"")
        self.red("test --trace", "a plain run has a trace key:\n{plain}")
    traced := prop_run(["--trace=calls"], tp).lines()
    if traced.len() < 2
        or not traced[0].contains("\"test\":\"passes\"")
        or traced[0].contains("\"trace\"")
        self.red("test --trace=calls", "{traced}")
    else
        self.want("test --trace=calls", traced[1], [
            "\"test\":\"fails\"",
            "\"trace\":[\{",
            "\"fn\":\"Counter.bump\"",
        ])
    self.want(
        "test --trace-limit",
        prop_run(["--trace", "--trace-limit", "1"], tp),
        ["\"trace\":\"dropped\""],
    )
    h := native_run(["test", "--trace=calls", tp]) else return
    self.want("test --trace=calls human", h.out, ["  trace: call fails()"])
    # fix.note.1: a duplicate declaration points at the first.
    for pair in [
        [
            "fix_notes_fn",
            "\"notes\":[\{\"line\":1,\"col\":4,\"message\":\"`helper` is first declared here\"}]",
        ],
        [
            "fix_notes",
            "\"notes\":[\{\"line\":2,\"col\":5,\"message\":\"`n` is first declared here\"}]",
        ],
    ]
        d := ail_run(["check", "--json", "tests/cases/{pair[0]}.ail"]) else return
        self.want("duplicate notes {pair[0]}", d.err, [pair[1]])
    # trace.run.1, trace.run.4, trace.watch.1: bad tracing options are rejected before anything runs.
    hello := "examples/hello.ail"
    for pair in [
        ["check --trace", "work with `ail run` and `ail test`"],
        ["run --trace=bogus", "trace.run.1"],
        ["run --trace-limit many", "trace.run.4"],
        ["run --watch", "trace.watch.1"],
    ]
        d := native_run(cat(pair[0].words(), [hello])) else return
        if d.status != 2 or not d.err.contains(pair[1]) or not d.out.is_empty()
            self.red("trace options {pair[0]}", "exit {d.status}\n{d.err}")
    # trace.run.2: a trace goes to standard error; standard output is unchanged.
    plain_run := native_run(["run", hello]) else return
    traced_run := native_run(["run", "--trace", hello]) else return
    if plain_run.out != traced_run.out or not traced_run.err.contains("trace: summary:")
        self.red("trace run", traced_run.err)

fn prop_run(extra List[str], path str) str
    r := native_run(cat(cat(["test", "--json"], extra), [path])) else return ""
    r.out

## `ail api` (ADR 0150) outlines every example and every accepted case,
## with and without `--symbols`, and rejects a program with errors (api.out.5).
fn Gate.api_outlines(mut self)
    mut files := List[str]()
    native_only := stem_list("tests/cases/native_only.txt")
    for dir in ["examples", "tests/cases"]
        for name in fs.list_dir(dir) else []
            stem := name.replace(".ail", "")
            if native_only.contains(stem)
                continue
            if name.ends_with(".ail") and (dir == "examples" or fs.exists("{dir}/{stem}.out"))
                files.push("{dir}/{name}")
    for path in files
        for extra in ["", "--symbols", "--pretty", "--text"]
            args := if extra.is_empty() then ["api", path] else ["api", extra, path]
            r := ail_run(args) else return
            if r.status != 0
                self.red("api {extra} {path}", r.err)
    r := ail_run(["api", "--json", "tests/cases/condition_not_bool.ail"]) else return
    if r.status != 2 or not r.err.contains("\"rule\":")
        self.red("api on a rejected program", r.err)
    b := ail_run(["api", "--bogus", "x.ail"]) else return
    if b.status != 2
        self.red("api --bogus", "exit {b.status}, want 2")

fn Gate.cases(mut self)
    self.case_dir("examples")
    self.case_dir("tests/cases")
    self.packages()
    # The two small groups have no items of their own to split: shard 0 runs them.
    if self.part == 0
        self.cli_checks()
        self.api_outlines()

## `ail explain` and `ail fix` coverage: every rule a diagnostic can carry has a spec entry, the spec cites
## only rules that exist, compiler/explain/fixable.txt matches the fixes the corpora
## produce, and an explain entry stays short (explain.cover.1-4).
fn is_lower_us(c char) bool
    k := c.code()
    (k >= 97 and k <= 122) or k == 95

fn is_id_char(c char) bool
    k := c.code()
    (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57) or k == 95 or k == 46

fn all_chars(s str, digits bool) bool
    if s.is_empty()
        return false
    for c in s.chars()
        ok := if digits then c.is_digit() and c.code() < 128 else is_lower_us(c)
        if not ok
            return false
    true

## A rule ID is `chapter.section.n`: two lowercase words and a number.
fn id_shaped(w str) bool
    parts := w.split(".")
    parts.len() == 3 and all_chars(
        parts[0],
        false,
    ) and all_chars(parts[1], false) and all_chars(parts[2], true)

fn trim_dots(w str) str
    mut a := 0
    mut b := w.len()
    cs := w.chars()
    while a < b and cs[a] == '.'
        a += 1
    while b > a and cs[b - 1] == '.'
        b -= 1
    w.slice(a, b)

## The rule-ID-shaped words of `text`.
fn ids_in(text str) List[str]
    mut out := List[str]()
    mut word := ""
    for c in text.chars()
        if is_id_char(c)
            word = "{word}{c}"
        else
            w := trim_dots(word)
            if id_shaped(w)
                out.push(w)
            word = ""
    w := trim_dots(word)
    if id_shaped(w)
        out.push(w)
    out

## The IDs defined in docs/spec: a line starting `**id**`.
fn spec_rules() Set[str]
    mut out := Set[str]()
    for path in fs.glob("docs/spec/**/*.md")
        for l in slurp(path).lines()
            if l.starts_with("**")
                id := l.slice(2, l.len()).split("**")[0]
                found := ids_in(id)
                if found.len() == 1 and found[0] == id
                    out.add(id)
    out

## The IDs that appear as string literals in the compiler's sources.
fn emitted_rules() Set[str]
    mut out := Set[str]()
    for path in fs.glob("compiler/**/*.ail")
        parts := slurp(path).split("\"")
        for i in 0..parts.len()
            if i % 2 == 1 and not parts[i].contains(" ") and id_shaped(parts[i])
                out.add(parts[i])
    out

fn Gate.explain_coverage(mut self)
    spec := spec_rules()
    # explain.cover.1: IDs the sources spell as examples of a missing rule are not rules.
    mut missing := List[str]()
    for r in emitted_rules().sorted()
        if not spec.contains(r) and r != "expr.nope.1"
            missing.push(r)
    if not missing.is_empty()
        self.red("explain.cover.1", "rule IDs in src/ with no rule in docs/spec: {missing}")
    # explain.cover.2
    mut bad := List[str]()
    for path in fs.glob("docs/spec/**/*.md")
        mut n := 0
        for l in slurp(path).lines()
            n += 1
            for id in ids_in(l)
                if not spec.contains(id)
                    bad.push("{path}:{n}: {id}")
    if not bad.is_empty()
        self.red(
            "explain.cover.2",
            "docs/spec cites rules that no chapter defines:\n{bad.join("\n")}",
        )
    # explain.cover.3
    mut seen := Set[str]()
    mut files := fs.glob("tests/**/*.ail")
    files.extend(fs.glob("examples/**/*.ail"))
    for f in files
        r := ail_run(["check", "--json", f]) else continue
        for l in "{r.err}\n{r.out}".lines()
            if l.contains("\"fixes\":[\{")
                parts := l.split("\"rule\":\"")
                if parts.len() > 1
                    seen.add(parts[1].split("\"")[0])
    mut listed := Set[str]()
    for l in slurp("compiler/explain/fixable.txt").lines()
        listed.add(l)
    if listed.sorted() != seen.sorted()
        extra := [r for r in seen.sorted() if not listed.contains(r)]
        gone := [r for r in listed.sorted() if not seen.contains(r)]
        self.red(
            "explain.cover.3",
            "compiler/explain/fixable.txt is out of step with the fixes the test programs produce; produced but not listed: {extra}; listed but not produced: {gone}",
        )
    for r in listed.sorted()
        if not spec.contains(r)
            self.red("explain.cover.3", "src/fixable.txt names a rule missing from docs/spec: {r}")
    j := ail_run(["explain", "--json"]) else return
    self.want("explain --json", j.out, [
        "\"fixable\":{listed.len()}",
        "\"rule\":\"trait.op.3\",\"chapter\":\"trait\"",
        "\"fix\":true",
    ])
    # explain.cover.4: an entry stays short (ADR 0336); 120 tokens are about 400 characters.
    mut total := 0
    mut longest := 0
    mut longest_id := ""
    for r in spec.sorted()
        e := ail_run(["explain", r]) else continue
        n := e.out.len()
        total += n
        if n > longest
            longest = n
            longest_id = r
    mean := total / spec.len()
    if mean >= 400
        self.red(
            "explain.cover.4",
            "mean explain entry is {mean} characters; longest is {longest_id} ({longest})",
        )

## `ail fix` (fix.apply.1-4): each
## tests/fix/NAME.ail is fixed in a scratch copy; the result must equal
## NAME.fixed, check clean, and be stable.
fn Gate.fix(mut self, tmp str)
    dir := "tests/fix"
    scratch := "{tmp}/fix"
    mut count := 0
    for name in fs.list_dir(dir) else []
        if not name.ends_with(".ail")
            continue
        count += 1
        stem := name.replace(".ail", "")
        work := "{scratch}/{name}"
        sh_run("rm -rf {scratch}; mkdir -p {scratch}; cp {dir}/{name} {work}")
        f := ail_run(["fix", work]) else continue
        if f.status != 0
            self.red("fix {stem}", "ail fix exit {f.status}\n{f.out}{f.err}")
            continue
        if slurp(work) != slurp("{dir}/{stem}.fixed")
            self.red("fix {stem}", "fixed text differs\n{f.out}")
        c := ail_run(["check", work]) else continue
        if c.status != 0
            self.red("fix {stem}", "fixed file doesn't check\n{c.err}")
        again := ail_run(["fix", "--json", work]) else continue
        if not again.out.contains("\"applied\":0,\"rounds\":0")
            or not again.out.contains("\"clean\":true")
            self.red("fix {stem}", "not stable\n{again.out}")
    if count < 6
        self.red("fix", "expected the fix fixtures, found {count}")
    work := "{scratch}/x.ail"
    src := "fn main()\n    n := 1\n    n = 2\n    print(n)\n"
    sh_run("rm -rf {scratch}; mkdir -p {scratch}")
    fs.write_text(work, src) else return
    d := ail_run(["fix", "--dry-run", work]) else return
    if d.status != 0
        self.red("fix --dry-run", d.out)
    self.want("fix --dry-run", d.out, ["+    mut n := 1", "would apply 1 fix(es)"])
    if slurp(work) != src
        self.red("fix --dry-run", "changed the file")
    fs.write_text(work, "fn main()\n    print(y)\n") else return
    u := ail_run(["fix", "--json", work]) else return
    if u.status != 1 or not u.out.contains("\"applied\":0") or not u.out.contains("\"clean\":false")
        self.red("fix unfixable", "exit {u.status}\n{u.out}")
    self.auto_fix(scratch)
    sh_run("rm -rf {scratch}")

## `./ail` with certain fixes on (`AIL_FIX=1`): the gate itself runs with them off (fix.auto.3).
fn ail_run_fixing(args List[str]) proc.Output ! proc.ProcError
    proc.run("sh", cat(
        ["-c", "AIL_FIX=1 exec perl -e 'alarm 120; exec @ARGV' \"$PWD/ail\" \"$@\"", "sh"],
        args,
    ))

## fix.auto.1-3 (ADR 1130): `ail run` writes the certain fixes of a file's errors into
## it and goes on; a fix that is a guess, `--no-fix` and `AIL_FIX=0` leave it alone.
fn Gate.auto_fix(mut self, scratch str)
    work := "{scratch}/auto.ail"
    src := "fn main()\n    m := Map[str, int]()\n    m[\"a\"] = 1\n    eprint(\"x\")\n    if true && false\n        println(\"no\")\n    else if m.contains_key(\"a\")\n        print(m[\"b\"] else 0)\n"
    want := "fn main()\n    mut m := Map[str, int]()\n    m[\"a\"] = 1\n    io.eprint(\"x\")\n    if true and false\n        print(\"no\")\n    elif m.contains(\"a\")\n        print(m.get(\"b\") else 0)\n"
    sh_run("rm -rf {scratch}; mkdir -p {scratch}")
    fs.write_text(work, src) else return
    off := ail_run(["check", work]) else return
    if off.status == 0 or slurp(work) != src
        self.red("auto-fix off", "AIL_FIX=0 changed the file or it checked\n{off.err}")
    flag := ail_run_fixing(["check", "--no-fix", work]) else return
    if flag.status == 0 or slurp(work) != src
        self.red("auto-fix --no-fix", "--no-fix changed the file or it checked\n{flag.err}")
    r := ail_run_fixing(["run", work]) else return
    if r.status != 0 or r.out.trim() != "0"
        self.red("auto-fix run", "exit {r.status}\n{r.out}{r.err}")
    self.want("auto-fix run", r.err, [
        "fixed ",
        "[expr.name.1]",
        "[expr.if.1]",
        "certain fix(es) written to",
    ])
    if slurp(work) != want
        self.red("auto-fix text", slurp(work))
    guess := "fn main()\n    count := 1\n    print(cuont)\n"
    fs.write_text(work, guess) else return
    g := ail_run_fixing(["check", work]) else return
    if g.status == 0 or slurp(work) != guess
        self.red("auto-fix guess", "a did-you-mean fix was applied\n{g.err}")
    self.auto_fix_slips(work)

## The string slips of ADR 1138 are certain fixes: a `\{` that only text can follow, `\}`, `sep.join(xs)` and `+` with
## a character literal in brackets are written by `check` itself; `{n` (a forgotten closer) is a guess and is not.
fn Gate.auto_fix_slips(mut self, work str)
    src := [
        "fn main()",
        "    n := 3",
        "    xs := [\"a\", \"b\"]",
        "    print(\"\{\")",
        "    print(\"    \{\\\"sku\\\": \{n},\")",
        "    print(\"a\\}\")",
        "    print(\", \".join(xs))",
        "    print(\"\\\\u00\" + n.to_str().pad_left(2, '0'))",
    ]
    want := [
        "fn main()",
        "    n := 3",
        "    xs := [\"a\", \"b\"]",
        "    print(\"\\\{\")",
        "    print(\"    \\\{\\\"sku\\\": \{n},\")",
        "    print(\"a}\")",
        "    print(xs.join(\", \"))",
        "    print(\"\\\\u00\{n.to_str().pad_left(2, '0')}\")",
    ]
    fs.write_text(work, "{src.join("\n")}\n") else return
    r := ail_run_fixing(["check", work]) else return
    if r.status != 0 or slurp(work) != "{want.join("\n")}\n"
        self.red("auto-fix string slips", "exit {r.status}\n{slurp(work)}\n{r.err}")
    bare := "fn main()\n    n := 3\n    print(\"\{n\")\n"
    fs.write_text(work, bare) else return
    b := ail_run_fixing(["check", work]) else return
    if b.status == 0 or slurp(work) != bare
        self.red("auto-fix string slips", "a forgotten closer was applied as certain\n{b.err}")

## Every command word `ail` dispatches. `ail.ps1` is the Windows twin (feature parity, ADR 0842): a word, or a `run`
## flag, that one wrapper has and the other lacks is red. A text check, not a behaviour check.
WRAPPER_COMMANDS := [
    "help",
    "doctor",
    "run",
    "build",
    "check",
    "test",
    "fmt",
    "fix",
    "diff",
    "explain",
    "edit",
    "ask",
    "attach",
    "api",
    "effects",
    "pkg",
    "new",
    "header",
    "verify",
    "infer",
    "task",
    "mcp",
    "lsp",
    "sanitize",
    "leak",
    "replay",
    "selftest",
    "version",
    "context",
    "review",
]

## The `--flag` words in the arm heads of `run`'s option loop in `ail` (between `run_args=("$@")` and `run_skip=$k`),
## without a trailing `)` or an `=VALUE`.
fn run_flags(wp_text str) List[str]
    mut wp_flags := List[str]()
    mut wp_in := false
    for wp_line in wp_text.lines()
        if wp_line.contains("run_args=(\"$@\")")
            wp_in = true
            continue
        if wp_line.contains("run_skip=$k")
            wp_in = false
        if not wp_in
            continue
        for wp_word in wp_line.trim().words()
            if wp_word == "|"
                continue
            if not wp_word.starts_with("--")
                break
            mut wp_flag := wp_word
            if wp_flag.ends_with(")")
                wp_flag = wp_flag.slice(0, wp_flag.len() - 1)
            if wp_at := wp_flag.find("=")
                wp_flag = wp_flag.slice(0, wp_at)
            if not wp_flags.contains(wp_flag)
                wp_flags.push(wp_flag)
            if wp_word.ends_with(")")
                break
    wp_flags

fn Gate.wrapper_parity(mut self)
    wp_sh := slurp("ail")
    wp_ps := slurp("ail.ps1")
    if wp_sh.is_empty() or wp_ps.is_empty()
        self.red("wrapper parity", "could not read ail or ail.ps1")
        return
    for wp_cmd in WRAPPER_COMMANDS
        mut wp_known := wp_sh.contains("= {wp_cmd} ]") or wp_sh.contains("{wp_cmd} |")
        if wp_sh.contains("{wp_cmd})")
            wp_known = true
        if not wp_known
            self.red("wrapper parity: ail", "`{wp_cmd}` is not dispatched in ail")
        if not wp_ps.contains("'{wp_cmd}'")
            self.red("wrapper parity: ail.ps1", "`{wp_cmd}` is not dispatched in ail.ps1")
    wp_flags := run_flags(wp_sh)
    if wp_flags.len() < 20
        self.red("wrapper parity", "only {wp_flags.len()} run flags found in ail")
    for wp_flag in wp_flags
        if not wp_ps.contains(wp_flag)
            self.red("wrapper parity: ail.ps1", "`run {wp_flag}` is in ail but not in ail.ps1")

## `ail help` (tool.help.1-3, ADR 1057): its table is the list of commands both launchers route, `CMD --help` answers for
## each, and a symlinked `ail` finds the toolchain (tool.path.1, ADR 1058). A text check of the launchers, as the
## wrapper parity check is, plus one run per command.
fn Gate.cli_help(mut self, tmp str)
    h := ail_run(["help", "--json"]) else return
    if h.status != 0
        self.red("help --json", "exit {h.status}\n{h.err}")
        return
    sh_text := slurp("ail")
    ps_text := slurp("ail.ps1")
    parsed := parse_json(h.out) else
        self.red("help --json", "not JSON:\n{h.out}")
        return
    mut listed := 0
    for item in parsed.as_arr() else []
        n := item.text("name", "")
        listed += 1
        known := sh_text.contains("= {n} ]")
            or sh_text.contains("{n} |")
            or sh_text.contains("| {n}")
            or sh_text.contains("{n})")
        if not known
            self.red("help routes: ail", "`{n}` is listed by `ail help` but not routed in ail")
        if not ps_text.contains("'{n}'")
            self.red(
                "help routes: ail.ps1",
                "`{n}` is listed by `ail help` but not routed in ail.ps1",
            )
        r := ail_run([n, "--help"]) else return
        if r.status != 0 or not r.out.contains("usage: ail {n}")
            self.red("{n} --help", "exit {r.status}\n{r.out}{r.err}")
    if listed < 30
        self.red("help --json", "only {listed} commands listed")
    bare := ail_run([]) else return
    if bare.status != 0 or not bare.out.contains("Build and run")
        self.red("ail with no arguments", "exit {bare.status}\n{bare.out}{bare.err}")
    u := ail_run(["nosuchcommand"]) else return
    if u.status != 2 or not u.err.contains("unknown command nosuchcommand; run `ail help`")
        self.red("unknown command", "exit {u.status}\n{u.err}")
    # tool.path.1: a symlink to `ail` runs the same toolchain (a link needs no privilege off Windows).
    if (env.get("OS") else "") != "Windows_NT"
        link := "{tmp}/ail-link"
        sh_run("rm -f {link}; ln -s \"{repo_root()}/ail\" {link}")
        l := proc.run(link, ["help", "run"]) else return
        if l.status != 0 or not l.out.contains("usage: ail run")
            self.red("symlinked ail", "exit {l.status}\n{l.out}{l.err}")
        d := proc.run(link, ["doctor", "--path"]) else return
        if d.status != 0 or not d.out.contains(repo_root())
            self.red("symlinked ail doctor --path", "exit {d.status}\n{d.out}{d.err}")
        sh_run("rm -f {link}")

## `ail effects` and `--deny` (effects.rs), `check --errors` and `fails_with`
## (error_paths.rs), and the process-level diagnostics of cli_errors.rs.
fn Gate.cli_effects(mut self, tmp str)
    self.wrapper_parity()
    e := ail_run(["effects", "examples/commands.ail"]) else return
    if e.status != 0 or e.out != slurp("tests/effects/commands.effects")
        self.red("effects commands.ail", e.out)
    r := ail_run(["run", "--deny", "all", "examples/hello.ail"]) else return
    if r.status != 0
        self.red("run --deny all", r.err)
    r2 := ail_run(["check", "--deny", "fs,proc", "examples/commands.ail"]) else return
    if r2.status != 0
        self.red("check --deny fs,proc", r2.err)
    # An error at the end of the input (an unclosed `fn broken(`) has a real line, not the next file's base line.
    eof := "{tmp}/eof.ail"
    fs.write_text(eof, "fn main()\n    print(1)\n\nfn broken(\n") else return
    eo := ail_run(["check", eof]) else return
    if eo.status == 0 or eo.err.contains("1048576") or not eo.err.contains("eof.ail:5:1")
        self.red("error at end of input", "exit {eo.status}\n{eo.err}")
    r3 := ail_run(["run", "--deny", "disk", "examples/hello.ail"]) else return
    if r3.status != 2 or not r3.err.contains("eff.cap.2")
        self.red("--deny disk", "exit {r3.status}\n{r3.err}")
    p := native_run(["effects", "--parallel", "examples/parallel.ail"]) else return
    if p.status != 0 or p.out != slurp("tests/effects/parallel.loops")
        self.red("effects --parallel", "{p.out}{p.err}")
    pj := native_run(["effects", "--parallel", "--json", "examples/parallel.ail"]) else return
    if not pj.out.starts_with("\{\"ail_api\":1,\"loops\":[\{\"at\":\"examples/parallel.ail:32:5\"")
        or pj.out.count("\"verdict\":\"parallel\"") != 3
        self.red("effects --parallel --json", pj.out)
    # error_paths.rs, on cases/err_paths_ok.ail
    case := "tests/cases/err_paths_ok.ail"
    c := native_run(["check", "--errors", case]) else return
    if c.status != 0
        self.red("check --errors", c.err)
    self.want("check --errors", c.out, [
        "\"id\":\"fn:both\",\"name\":\"both\",\"line\":17,\"fails_with\":[\"A\",\"B\"]",
        "\{\"line\":18,\"col\":14,\"kind\":\"propagate\",\"call\":\"a\",\"errors\":[\"A\"],\"context\":true}",
        "\{\"line\":19,\"col\":14,\"kind\":\"propagate\",\"call\":\"b\",\"errors\":[\"B\"]}",
        "\"id\":\"fn:a\",\"name\":\"a\",\"line\":7,\"fails_with\":[\"A\"]",
        "\"name\":\"main\",\"line\":22,\"paths\":[\{\"line\":23,\"col\":11,\"kind\":\"handle\",\"how\":\"default\"",
    ])
    a := ail_run(["api", case]) else return
    self.want("api fails_with", a.out, ["\"returns\":\"!int\",\"fails_with\":[\"A\",\"B\"]"])
    at := ail_run(["api", "--text", case]) else return
    self.want("api --text fails_with", at.out, ["fn both(n int) !int\n           fails with A | B"])
    x := ail_run(["explain", "err.ret.1"]) else return
    self.want("explain err.ret.1", x.out, ["rejected example:", "repaired:"])
    if x.out.contains("\nexample:")
        self.red("explain err.ret.1", x.out)
    # cli_errors.rs: diagnostics the case harness can't check.
    dir := "{tmp}/cli"
    sh_run("rm -rf {dir}; mkdir -p {dir}/gone")
    main := "{dir}/main.ail"
    fs.write_text(main, "fn main()\n    print(1)\n") else return
    d := ail_run(["run", "--deny", "io", main]) else return
    if d.status != 2 or not d.err.contains("(eff.cap.3)")
        self.red("--deny io", "exit {d.status}\n{d.err}")
    fs.write_text(main, "use std.env\n\nfn main()\n    print(env.cwd())\n") else return
    root := repo_root()
    # Windows refuses to remove a directory a process is in, so std.env.3 can't be reached there.
    if (env.get("OS") else "") != "Windows_NT"
        w := sh_run("cd {dir}/gone && rmdir {dir}/gone && exec {bin_path(root)} run {main}")
        if w.status != 1 or not w.err.contains("trap[std.env.3]")
            self.red("env.cwd removed", "exit {w.status}\n{w.err}")
    for t in [["print(io.read_line())", "std.io.1"], ["print(io.read_all().len())", "std.io.2"]]
        fs.write_text(main, "use std.io\n\nfn main()\n    {t[0]}\n") else return
        i := sh_run("{bin_path(root)} run {main} < {dir}")
        if i.status != 1 or not i.err.contains("trap[{t[1]}]")
            self.red("stdin a directory {t[1]}", "exit {i.status}\n{i.err}")
    fs.write_text(
        main,
        "extern c fn abs(n int) int\n\nfn main()\n    unsafe\n        print(abs(-3))\n",
    ) else return
    b := ail_run(["build", main, "-o", "{dir}/main.out", "--no-cache"]) else return
    # ffi.native.1, ADR 0870: a C function outside the libc subset builds (it binds at the first call).
    if b.status != 0 or not fs.exists("{dir}/main.out")
        self.red("build extern c fn", "exit {b.status}\n{b.err}")
    sh_run("rm -rf {dir}")

## The mistakes corpus (gram.help.2,
## ADR 0262): the first rule names the mistake, every error has a `help`,
## and `ail fix` yields NAME.fixed (check clean, stable) when it exists.
fn rule_of(line str) str
    line.split("\"rule\":\"")[1].split("\"")[0]

## check.out.3: a problem with one `ail check --json` record against docs/design/check-json.schema.json, or none.
fn schema_problem(l str) str?
    d := parse_json(l) else return "not JSON"
    if (d.int("api") else 0) != 1
        return "`api` is not 1"
    if d.get("summary") != none
        for k in ["errors", "warnings", "fixable"]
            if d.int(k) == none
                return "summary lacks integer `{k}`"
        return none
    sev := d.text("severity", "")
    if sev != "error" and sev != "warning"
        return "`severity` is `{sev}`"
    for k in ["rule", "file", "message"]
        if d.text(k, "") == ""
            return "`{k}` is missing or empty"
    for k in ["line", "col", "end_line", "end_col"]
        v := d.int(k) else return "`{k}` is not an integer"
        if v < 1
            return "`{k}` is below 1"
    if sev == "error" and d.text("next", "") == ""
        return "an error has no `next`"
    none

fn Gate.mistakes(mut self, tmp str)
    dir := "tests/mistakes"
    scratch := "{tmp}/mistakes"
    mut names := fs.list_dir(dir) else []
    names.sort()
    mut total := 0
    mut fixed_count := 0
    for name in names
        if not name.ends_with(".ail")
            continue
        total += 1
        stem := name.replace(".ail", "")
        path := "{dir}/{name}"
        r := ail_run(["check", "--json", path]) else continue
        mut rules := List[str]()
        for l in r.err.lines()
            if bad := schema_problem(l)
                self.red("mistakes {stem}", "record breaks check-json.schema.json: {bad}\n{l}")
            if l.contains("\"severity\":\"error\"")
                rules.push(rule_of(l))
                if not l.contains("\"help\":\"")
                    self.red("mistakes {stem}", "a diagnostic has no help\n{l}")
                if rule_of(l) == "bootstrap.unsupported"
                    self.red("mistakes {stem}", "a mistake is reported as unsupported\n{l}")
        want_rules := slurp("{dir}/{stem}.rules").lines()
        if rules != want_rules
            self.red("mistakes {stem}", "rules differ\n  expected {want_rules}\n  got      {rules}")
        work := "{scratch}/{name}"
        sh_run("rm -rf {scratch}; mkdir -p {scratch}; cp {path} {work}")
        f := ail_run(["fix", work]) else continue
        c := ail_run(["check", work]) else continue
        if fs.exists("{dir}/{stem}.fixed")
            fixed_count += 1
            if slurp(work) != slurp("{dir}/{stem}.fixed")
                self.red("mistakes {stem}", "fixed text differs\n--- actual\n{slurp(work)}")
            if c.status != 0
                self.red("mistakes {stem}", "the fixed file doesn't check\n{c.err}")
            again := ail_run(["fix", "--json", work]) else continue
            if not again.out.contains("\"applied\":0,\"rounds\":0")
                self.red("mistakes {stem}", "a second `ail fix` still changes the file")
        elif c.status == 0 or f.status == 0
            self.red(
                "mistakes {stem}",
                "has no .fixed file, but `ail fix` resolved it; record the result",
            )
    sh_run("rm -rf {scratch}")
    # The targets of ADR 0262: at least 60 mistakes, 60% fixed.
    # The coverage figure is printed here so it can't drift from the corpus (fix.check.1, ADR 1047).
    print("mistakes: `ail fix` resolves {fixed_count} of {total} ({fixed_count * 100 / total}%)")
    if total < 60
        self.red("mistakes", "the corpus has {total} programs")
    if fixed_count * 100 < total * 60
        self.red("mistakes", "`ail fix` resolves only {fixed_count} of {total}")

## `requires`, `ensures`, `old`, inheritance and invariants end to end
##.
fn case_path(name str) str
    "tests/cases/{name}.ail"

fn Gate.trap_has(mut self, label str, case str, wants List[str])
    r := ail_run(["run", case_path(case)]) else return
    if r.status != 1
        self.red(label, "exit {r.status}, want 1\n{r.err}")
    self.want(label, r.err, wants)

fn Gate.api_has(mut self, label str, flag str, case str, wants List[str])
    args := if flag.is_empty() then ["api", case_path(case)] else ["api", flag, case_path(case)]
    r := ail_run(args) else return
    self.want(label, r.out, wants)

fn Gate.contracts(mut self)
    self.trap_has(
        "contract requires trap",
        "contract_requires_trap",
        [":8:11: trap[contract.req.1]: `divide` requires `b != 0`, but it was called with a = 7, b = 0 (contract at 3:5)"],
    )
    self.trap_has(
        "contract ensures trap",
        "contract_ensures_trap",
        [":4:5: trap[contract.ens.1]: `divide` ensures `result * b == a`, but it returned 3 at 5:5 with a = 7, b = 2"],
    )
    n := native_run(["run", "--no-contracts", case_path("contract_ensures_trap")]) else return
    if n.status != 0 or n.out != "4\n3\n"
        self.red("--no-contracts", "exit {n.status}\n{n.out}{n.err}")
    self.api_has(
        "api contracts",
        "",
        "contract_ensures_trap",
        ["\"requires\":[\"b != 0\"],\"ensures\":[\"result * b == a\"]"],
    )
    self.api_has(
        "api --text contracts",
        "--text",
        "contract_ensures_trap",
        ["fn divide(a int, b int) int\n           requires b != 0\n"],
    )
    for rule in [
        "contract.decl.3",
        "contract.req.1",
        "contract.ens.1",
        "contract.run.3",
        "contract.ens.3",
        "contract.inh.1",
        "contract.inh.2",
        "contract.inh.3",
        "contract.inv.1",
        "contract.inv.2",
        "contract.inv.3",
        "contract.api.2",
    ]
        e := ail_run(["explain", rule]) else return
        if e.status != 0
            self.red("explain {rule}", "exit {e.status}")
    old := native_run(["run", "--values", case_path("contract_old_trap")]) else return
    if old.status != 1
        self.red("contract old trap", "exit {old.status}, want 1\n{old.err}")
    self.want("contract old trap", old.err, [
        "`Counter.add` ensures `n == old(n) + k`, but it returned at 4:5 with self = Counter(n: 4), k = 2",
        "values: self = Counter(n: 4), old(n) = 1, k = 2",
    ])
    self.trap_has(
        "inherited requires",
        "contract_trait_requires_trap",
        ["`Plain.scale` requires `k > 0` (inherited from `Shape.scale`), but it was called with self = Plain(side: 4), factor = 0 (contract at 5:9)"],
    )
    self.trap_has(
        "inherited ensures",
        "contract_trait_ensures_trap",
        ["`Odd.area` ensures `result >= 0` (inherited from `Shape.area`), but it returned -6"],
    )
    self.trap_has(
        "invariant method",
        "contract_invariant_method_trap",
        ["`Account` invariant `balance >= 0` was broken by `Account.withdraw`, which returned at 7:5 with self = Account(balance: -7) (invariant at 4:5)"],
    )
    self.trap_has(
        "invariant built",
        "contract_invariant_built_trap",
        ["`Range` invariant `lo <= hi` doesn't hold for Range(lo: 3, hi: 2), built at 9:16 (invariant at 5:5)"],
    )
    self.api_has(
        "api inherited",
        "",
        "contract_trait_inherit",
        ["\"inherits\":\"Shape.scale\",\"inherited_requires\":[\"k > 0\"],\"inherited_ensures\":[\"result >= 0\"]"],
    )
    self.api_has(
        "api invariants",
        "",
        "contract_invariant",
        ["\"invariants\":[\"balance >= 0\",\"balance <= limit\"]"],
    )
    self.api_has(
        "api --text inherited",
        "--text",
        "contract_trait_inherit",
        ["requires k > 0 (inherited)"],
    )
    self.proved_contracts()

## contract.prove.1-3, prove.cmd.1-2 (ADR 1055). A proved check is left out of the build, so a
## prover bug would remove a check silently: every contract case must run the same with proving
## on and with `AIL_OPT_OFF=prove`, which keeps every check (same status, output and traps).
fn Gate.proved_contracts(mut self)
    mut names := fs.list_dir("tests/cases") else []
    names.sort()
    for name in names
        if not name.ends_with(".ail")
            continue
        if not (name.starts_with("contract_") or name.starts_with("prove_"))
            continue
        at := "tests/cases/{name}"
        lean := ail_run(["run", at]) else return
        kept := ail_env("AIL_OPT_OFF=prove", ["run", at]) else return
        if lean.status != kept.status or lean.out != kept.out or lean.err != kept.err
            self.red(
                "proved checks {name}",
                "proving on: exit {lean.status}\n{lean.out}{lean.err}\nAIL_OPT_OFF=prove: exit {kept.status}\n{kept.out}{kept.err}",
            )
    p := ail_run(["prove", case_path("prove_contracts")]) else return
    if p.status != 0
        self.red("ail prove", "exit {p.status}\n{p.err}")
    self.want("ail prove", p.out, [
        "requires `i < xs.len()` of `at` in `total`: proved\n",
        "requires `i < xs.len()` of `at` in `main`: proved\n",
        "ensures `result < 10` of `digit`: proved\n",
        "ensures `result >= 0` of `clamp_low`: proved\n",
        "8 of 8 contract checks proved\n",
    ])
    # The negative cases: a `mut` name, a call into another file, and a contract the facts
    # don't settle keep their checks (they trap in the cases suite, both ways above).
    m := ail_run(["prove", case_path("prove_mut_trap")]) else return
    self.want("ail prove mut", m.out, [
        "requires `n >= 0` of `half` in `main`: checked\n",
        "0 of 2 contract checks proved\n",
    ])
    x := ail_run(["prove", case_path("prove_module_trap")]) else return
    self.want("ail prove other file", x.out, [
        "requires `n > 0` of `go` in `main`: proved\n",
        "2 of 2 contract checks proved\n",
    ])
    j := ail_run(["prove", "--json", case_path("prove_unproved_trap")]) else return
    self.want("ail prove --json", j.out, [
        "\"ail_api\":1,\"prove\":1,\"proved\":1,\"total\":2,",
        "\"kind\":\"requires\",\"fn\":\"half\",\"cond\":\"n >= 0\",",
        "\"in\":\"half_less\",\"proved\":false}",
    ])
    u := ail_run(["prove"]) else return
    if u.status != 2
        self.red("ail prove usage", "exit {u.status}, want 2")

## `ail test --update` (snap.update.1-6).
fn Gate.snapshot(mut self, tmp str)
    program := "## Doubles.\n##\n## ```ail\n## print(double(2))\n## # => 5\n## ```\nfn double(x int) int\n    x * 2\n\nfn greet(n str) str\n    \"hi, \{n}!\"\n\n@test fn greets()\n    assert_eq(greet(\"bo\"), \"hello\")\n    assert_eq(double(-2), 7)\n    assert_eq([double(1), 3], [0])\n\nfn main()\n    print(greet(\"x\"))\n"
    updated := "## Doubles.\n##\n## ```ail\n## print(double(2))\n## # => 4\n## ```\nfn double(x int) int\n    x * 2\n\nfn greet(n str) str\n    \"hi, \{n}!\"\n\n@test fn greets()\n    assert_eq(greet(\"bo\"), \"hi, bo!\")\n    assert_eq(double(-2), -4)\n    assert_eq([double(1), 3], [2, 3])\n\nfn main()\n    print(greet(\"x\"))\n"
    d := "{tmp}/snapshot"
    # snap.update.1-2, snap.update.4-5: literals, `# =>` lines and `.out` are rewritten.
    sh_run("rm -rf {d}; mkdir -p {d}")
    f := "{d}/p.ail"
    fs.write_text(f, program) else return
    fs.write_text("{d}/p.out", "old\n") else return
    r := native_run(["test", "--update", f]) else return
    self.want("snapshot update", r.out, [
        "-    assert_eq(greet(\"bo\"), \"hello\")\n",
        "+    assert_eq(greet(\"bo\"), \"hi, bo!\")\n",
        "updated 5 snapshots in 2 files\n",
    ])
    if r.status != 0 or not r.out.ends_with("ok greets\nok doc:double\n2 passed, 0 failed\n")
        self.red("snapshot update", "exit {r.status}\n{r.out}")
    if slurp(f) != updated or slurp("{d}/p.out") != "hi, x!\n"
        self.red("snapshot update", "files not rewritten:\n{slurp(f)}")
    again := native_run(["test", "--update", f]) else return
    if not again.out.starts_with("updated 0 snapshots in 0 files\n")
        self.red("snapshot update again", again.out)
    # snap.update.6: `--dry-run` writes nothing; `--json` lists each change.
    sh_run("rm -rf {d}; mkdir -p {d}")
    fs.write_text(f, program) else return
    j := native_run(["test", "--update", "--dry-run", "--json", f]) else return
    if slurp(f) != program
        self.red("snapshot dry-run", "wrote the file")
    self.want("snapshot --json", j.out, [
        "\{\"snapshot\":\"assert_eq\",\"file\":\"{f}\",\"line\":14,\"col\":28,\"old\":\"\\\"hello\\\"\",\"new\":\"\\\"hi, bo!\\\"\"}\n",
        "\{\"snapshot\":\"doc\",",
        "\{\"snapshots\":true,\"dry_run\":true,\"updated\":4,\"files\":1,\"skipped\":0}\n",
    ])
    # snap.update.3: a literal reached with different values stays, and the test fails.
    sh_run("rm -rf {d}; mkdir -p {d}")
    src := "@test fn loops()\n    for i in 0..3\n        assert_eq(i * 2, 0)\n\n@test fn named()\n    want := 3\n    assert_eq(1 + 1, want)\n"
    fs.write_text(f, src) else return
    c := native_run(["test", "--update", f]) else return
    if c.status != 1
        self.red("snapshot conflict", "exit {c.status}\n{c.out}")
    self.want("snapshot conflict", c.out, [
        "left 1 whose value differed between runs (snap.update.3)",
        "FAIL loops: trap[test.assert.1]: assertion failed: left is 4, right is 0",
        "FAIL named:",
    ])
    if slurp(f) != src
        self.red("snapshot conflict", "rewrote the file")
    sh_run("rm -rf {d}")

## Small end-to-end checks of derive_json.rs, ct_limit.rs, deterministic.rs,
## test_stderr.rs and schedule.rs, ported.
fn ail_env(var str, args List[str]) proc.Output ! proc.ProcError
    proc.run("env", cat([var, bin_path(".")], args))

fn Gate.misc(mut self, tmp str)
    # json.derive.1-3, ADR 0343
    a := ail_run(["api", "--expanded", "tests/cases/derive_json_enum_payloads.ail"]) else return
    if a.status != 0
        self.red("api --expanded", a.err)
    self.want("api --expanded", a.out, [
        "\"signature\":\"fn from_json(j Json) Self ! JsonError\"",
        "name := j.variant_name()?",
        "return Shape.Poly(points: v_points)",
        "return e.under(\\\"points[\{v_points_i}]\\\")",
        "JsonMember(\\\"kind\\\", Json.Str(\\\"Circle\\\"))",
        "\"generator\":\"fn:derive_from_json\"",
    ])
    # ct.eval.3: a constant that runs too many statements stops with a rule-named trap.
    spin := "tests/ct_limit/spin.ail"
    c := ail_env("AIL_CT_MAX_STEPS=1000", ["run", spin]) else return
    if c.status != 1
        self.red("ct limit", "exit {c.status}\n{c.err}")
    self.want("ct limit", c.err, ["trap[ct.eval.3]", "the constant `BIG`"])
    c2 := ail_env("AIL_CT_MAX_STEPS=100000", ["run", spin]) else return
    if c2.status != 0 or c2.out.trim() != "499500"
        self.red("ct limit under", "exit {c2.status}\n{c2.out}{c2.err}")
    # std.random.3, std.random.5
    unseeded := "tests/deterministic/unseeded.ail"
    s11 := ail_run(["run", "--seed", "11", unseeded]) else return
    s11b := ail_run(["run", "--seed", "11", unseeded]) else return
    s12 := ail_run(["run", "--seed", "12", unseeded]) else return
    if s11.status != 0 or s11.out != s11b.out or s11.out == s12.out
        self.red("--seed repeats", "{s11.out}|{s11b.out}|{s12.out}\n{s11.err}")
    for program in [unseeded, "tests/deterministic/clock.ail", "tests/deterministic/proc.ail"]
        d := native_run(["run", "--deterministic", program]) else return
        if d.status != 2 or not d.err.contains("eff.cap.1")
            self.red("--deterministic {program}", "exit {d.status}\n{d.err}")
    h1 := native_run(["run", "--deterministic", "examples/hello.ail"]) else return
    h2 := native_run(["run", "--deterministic", "examples/hello.ail"]) else return
    if h1.status != 0 or h1.out != h2.out
        self.red("--deterministic hello", h1.err)
    sx := ail_run(["run", "--seed", "x", unseeded]) else return
    if sx.status != 2 or not sx.err.contains("std.random.3")
        self.red("--seed x", "exit {sx.status}\n{sx.err}")
    # test.run.2: `ail test` captures standard error; `ail run` does not.
    dir := "{tmp}/misc"
    sh_run("rm -rf {dir}; mkdir -p {dir}")
    fs.write_text(
        "{dir}/captures.ail",
        "use std.io\n@test fn quiet_pass()\n    io.eprint(\"noise from a passing test\")\n\n@test fn loud_fail()\n    io.eprint(\"boom on stderr\")\n    assert(1 == 2)\n",
    ) else return
    t := ail_run(["test", "{dir}/captures.ail"]) else return
    if t.status != 1
        or not t.out.contains("  ! boom on stderr")
        or t.out.contains("noise from a passing test")
        or t.err.contains("noise from a passing test")
        self.red("test stderr capture", "exit {t.status}\n{t.out}{t.err}")
    fs.write_text("{dir}/run.ail", "use std.io\nfn main()\n    io.eprint(\"direct\")\n") else return
    r := ail_run(["run", "{dir}/run.ail"]) else return
    if r.status != 0 or r.err != "direct\n"
        self.red("run stderr direct", "exit {r.status}\n{r.err}")
    sh_run("rm -rf {dir}")
    # conc.sched.1-2: a seed picks the task switch points, so a failing interleaving replays.
    race := "tests/schedule/race.ail"
    # The native scheduler maps seeds to switch points differently: seed 2 loses the update there.
    fail_seed := "2"
    pass_seed := "1"
    first := ail_run(["test", "--json", "--schedule=random:{fail_seed}", race]) else return
    if first.status != 1
        or not first.out.contains("left is 1, right is 2")
        or not first.out.ends_with("\{\"summary\":true,\"passed\":0,\"failed\":1,\"schedule_seed\":{fail_seed}}\n")
        self.red("schedule seed {fail_seed}", "exit {first.status}\n{first.out}")
    for _ in 0..3
        again := ail_run(["test", "--json", "--schedule=random:{fail_seed}", race]) else return
        if again.out != first.out
            self.red("schedule replay", again.out)
    passed := ail_run(["test", "--json", "--schedule=random:{pass_seed}", race]) else return
    if passed.status != 0
        or not passed.out.ends_with("\{\"summary\":true,\"passed\":1,\"failed\":0}\n")
        self.red("schedule seed {pass_seed}", "exit {passed.status}\n{passed.out}")
    human := ail_run(["test", "--schedule=random:{fail_seed}", race]) else return
    self.want(
        "schedule prints the seed",
        human.out,
        ["schedule seed {fail_seed}: replay with `ail test --schedule=random:{fail_seed} "],
    )
    bad := ail_run(["test", "--schedule=sometimes", race]) else return
    if bad.status != 2
        self.red("schedule sometimes", "exit {bad.status}, want 2")
    # conc.cancel.3-4, conc.atomic.7: cancel trees and orderings pass every seed.
    for seed in 1..25
        x := ail_run(["test", "--schedule=random:{seed}", "tests/schedule/cancel.ail"]) else return
        if x.status != 0 or not x.out.ends_with("4 passed, 0 failed\n")
            self.red("schedule cancel seed {seed}", x.out)

## The documentation checks in tools/ (doc_scripts.rs, ported; ADR 0002).
fn Gate.docs(mut self)
    if proc.which("python3") == none
        print("docs: python3 not found; skipping")
        return
    for args in [
        ["tools/check-doc-links.py"],
        ["tools/check-grammar.py", "--self-test"],
        ["tools/check-grammar.py"],
        ["tools/check-doc-dupes.py"],
        ["tools/check-doc-dupes.py", "--self-test"],
        ["tools/check-method-table.py"],
        ["tools/collection-vocab-audit.py"],
        ["tools/check-card-coverage.py"],
        ["tools/gen-llms-full.py", "--check"],
        ["tools/corpus/corpus.py", "self-test"],
        ["tools/corpus/corpus.py", "check"],
    ]
        r := proc.run("python3", cat(["-I"], args)) else return
        if r.status != 0
            self.red("{args.join(" ")}", "{r.out}{r.err}")

## checkbench (ADR 1111): `ail check` against one injected mistake per copy of the corpus and examples programs
## (tools/checkbench). The fast form's totals may not fall below tools/checkbench/floors.txt.
fn Gate.checkbench(mut self)
    if proc.which("python3") == none
        print("checkbench: python3 not found; skipping")
        return
    r := proc.run("python3", [
        "-I",
        "tools/checkbench/checkbench.py",
        "--fast",
        "--jobs",
        "2",
        "--floors",
        "tools/checkbench/floors.txt",
    ]) else return
    if r.status != 0
        self.red("checkbench", "{r.out}{r.err}")

## golden (D0, OQ-143): explain, fmt, fix, api and edit against tests/golden/*.tsv (tools/golden/golden.py).
## A stale row (its input changed) is skipped, not a failure; refreeze on purpose with `golden.py freeze`.
## Not on Windows: the rows hash output frozen on macOS.
fn Gate.golden(mut self)
    if proc.which("python3") == none
        print("golden: python3 not found; skipping")
        return
    if (env.get("OS") else "") == "Windows_NT"
        print("golden: frozen on macOS; skipped on Windows")
        return
    r := proc.run("python3", [
        "-I",
        "tools/golden/golden.py",
        "check",
        "explain",
        "fmt",
        "fix",
        "api",
        "edit",
    ]) else return
    if r.status != 0
        self.red("golden", "{r.out}{r.err}")

## `ail fmt` end to end (fmt.rs, ported; ADR 0170).
fn Gate.fmt(mut self, tmp str)
    dir := "{tmp}/fmt"
    sh_run("rm -rf {dir}; mkdir -p {dir}")
    mut names := fs.list_dir("examples") else []
    names.sort()
    mut checked := 0
    for name in names
        if not name.ends_with(".ail")
            continue
        f := "examples/{name}"
        formatted := ail_run(["fmt", "--stdout", f]) else continue
        if formatted.status != 0
            self.red("fmt {f}", formatted.err)
            continue
        source := slurp(f)
        # ADR 0218: programs that find fixtures from their own path can't run as a copy.
        if source.contains("env.program()") or source.contains("/../ail")
            if formatted.out != source
                self.red("fmt {f}", "not in canonical layout")
            checked += 1
            continue
        # std.ui and std.app programs open a real window; only their formatting is checked.
        if source.contains("ui.open(") or source.contains("use std.app")
            checked += 1
            continue
        copy := "{dir}/{name}"
        fs.write_text(copy, formatted.out) else continue
        before := ail_run(["run", f]) else continue
        after := ail_run(["run", copy]) else continue
        if before.status != after.status or before.out != after.out
            self.red("fmt {f}", "output changed after formatting")
        checked += 1
    if checked < 6
        self.red("fmt examples", "only {checked} checked")
    messy := "{dir}/messy.ail"
    fs.write_text(
        messy,
        "fn main()\n    x:=[\n        1,\n        2]\n    print( x )\n",
    ) else return
    ch := ail_run(["fmt", "--check", messy]) else return
    if ch.status != 1
        self.red("fmt --check", "exit {ch.status}, want 1")
    self.want("fmt --check diff", ch.out, [
        "\n-    print( x )\n",
        "\n+    print(x)\n",
        "+    x := [1, 2]\n",
    ])
    tidy := "fn main()\n    x := [1, 2]\n    print(x)\n"
    so := ail_run(["fmt", "--stdout", messy]) else return
    if so.out != tidy
        self.red("fmt --stdout", so.out)
    w := ail_run(["fmt", messy]) else return
    if w.status != 0 or slurp(messy) != tidy
        self.red("fmt rewrite", "exit {w.status}\n{slurp(messy)}")
    ck := ail_run(["fmt", "--check", messy]) else return
    if ck.status != 0
        self.red("fmt --check after rewrite", ck.out)
    broken := "{dir}/broken.ail"
    fs.write_text(broken, "fn main()\n   print(1)\n") else return
    b := ail_run(["fmt", broken]) else return
    if b.status != 2
        or not b.err.contains("lex.block.2")
        or slurp(broken) != "fn main()\n   print(1)\n"
        self.red("fmt broken file", "exit {b.status}\n{b.err}")
    # A directory is checked file by file: one layout diff in a tree is exit 1 and names the file.
    tree := "{dir}/tree"
    fs.make_dir(tree) else return
    fs.write_text("{tree}/ok.ail", tidy) else return
    fs.write_text("{tree}/off.ail", "fn main()\n    print( 1 )\n") else return
    td := ail_run(["fmt", "--check", tree]) else return
    if td.status != 1 or not td.out.contains("off.ail") or td.out.contains("ok.ail")
        self.red("fmt --check directory", "exit {td.status}\n{td.out}")
    # fmt.self (ADR 1081): `fmt` writes `self.` before bare members, and has no option to keep them.
    bare := [
        "struct Pt",
        "    x int",
        "    y int",
        "",
        "trait Named",
        "    fn name(self) str",
        "    fn hello(self) str",
        "        \"hi \{name()}\"",
        "",
        "impl Named for Pt",
        "    fn name(self) str",
        "        \"pt\"",
        "",
        "fn Pt.sum(self) int",
        "    x + y",
        "",
        "fn Pt.shift(mut self, d int)",
        "    x += d",
        "    print(\"now \{x} \{sum()}\")",
        "",
        "fn Pt.scaled(self, k int) Pt",
        "    Pt(x: x * k, y: self.y * k)",
        "",
        "fn Pt.copy(self) Pt",
        "    Pt(x, y)",
        "",
        "fn main()",
        "    mut p := Pt(x: 1, y: 2)",
        "    p.shift(3)",
        "    print(p.scaled(2).sum())",
        "    print(p.copy().sum())",
        "    print(p.hello())",
        "",
    ].join("\n")
    explicit := bare
        .replace("\{name()}", "\{self.name()}")
        .replace("    x + y", "    self.x + self.y")
        .replace("    x += d", "    self.x += d")
        .replace("\{x} \{sum()}", "\{self.x} \{self.sum()}")
        .replace("x: x * k", "x: self.x * k")
        # Shorthand fields of one type: named, so they are never positional (type.struct.7).
        .replace("    Pt(x, y)", "    Pt(x: self.x, y: self.y)")
    members := "{dir}/members.ail"
    fs.write_text(members, bare) else return
    sf := ail_run(["fmt", "--stdout", members]) else return
    if sf.status != 0 or sf.out != explicit
        self.red("fmt.self", "exit {sf.status}\n{sf.out}{sf.err}")
    run_bare := ail_run(["run", members]) else return
    fs.write_text(members, explicit) else return
    again := ail_run(["fmt", "--check", members]) else return
    if again.status != 0
        self.red("fmt.self --check", "exit {again.status}\n{again.out}{again.err}")
    run_explicit := ail_run(["run", members]) else return
    if run_bare.out != "now 4 6\n12\n6\nhi pt\n" or run_explicit.out != run_bare.out
        self.red("fmt.self meaning", "{run_bare.out}{run_bare.err}---\n{run_explicit.out}")
    # The staging switch `--self` is gone (ADR 1081): one layout, no option.
    gone := ail_run(["fmt", "--self", "--stdout", members]) else return
    if gone.status != 2 or not gone.err.contains("unknown option --self")
        self.red("fmt --self removed", "exit {gone.status}\n{gone.err}")
    # Every source file of the compiler and the gate is canonical (ready-check checks the files a
    # branch changes; DK missed a layout diff in compiler/main.ail because this suite looked only at examples).
    for root in ["compiler", "tools/gate"]
        tr := ail_run(["fmt", "--check", root]) else continue
        if tr.status != 0
            self.red("fmt --check {root}", "run `./ail fmt {root}`:\n{tr.out}{tr.err}")
    sh_run("rm -rf {dir}")

## `--budget N [--from K]` on every command (budget.rs, ported; budget.out.1-6, ADR 0394).
fn Gate.budget(mut self, tmp str)
    dir := "{tmp}/budget"
    sh_run("rm -rf {dir}; mkdir -p {dir}")
    # Two warnings (holes) before one error, in source order.
    mixed := "fn f() int\n    todo\n\nfn g() int\n    todo\n\nfn main()\n    print(nope)\n"
    f := "{dir}/mixed.ail"
    fs.write_text(f, mixed) else return
    plain := ail_run(["check", f]) else return
    fits := ail_run(["check", "--budget", "100000", f]) else return
    if plain.err != fits.err or plain.status != 2 or fits.status != 2
        self.red("budget.out.1", "fitting output changed:\n{fits.err}")
    # budget.out.3-4: the error comes before the warnings; the note counts the rest.
    w := plain.err.find("warning[") else 0
    e := plain.err.find("error[") else 0
    if w >= e
        self.red("budget.out.3", "a warning is not before the error:\n{plain.err}")
    cut := ail_run(["check", "--budget", "10", f]) else return
    if not cut.err.contains("error[")
        or cut.err.contains("warning[")
        or not cut.err.ends_with("not shown: 2 warnings; continue with --from 1]\n")
        self.red("budget.out.3", cut.err)
    next := ail_run(["check", "--budget", "10", "--from", "1", f]) else return
    if not next.err.starts_with("{f}:2:") or next.err.contains("error[")
        self.red("budget --from", next.err)
    # budget.out.4: the JSON note.
    j := ail_run(["check", "--json", "--budget", "10", f]) else return
    last := j.err.lines().last() else ""
    if not last.starts_with("\{\"budget\":10,\"from\":0,\"shown\":1,\"full\":1,\"total\":3,\"tokens\":")
        or not last.ends_with("\"omitted\":\{\"warning\":2},\"next\":1}")
        self.red("budget json note", last)
    # budget.out.3: a test summary is always shown; failures come first.
    t := "{dir}/t.ail"
    fs.write_text(
        t,
        "@test fn a()\n    assert(1 == 1)\n\n@test fn b()\n    assert(1 == 2)\n",
    ) else return
    tr := ail_run(["test", "--budget", "5", t]) else return
    if not tr.out.starts_with("FAIL b:")
        or not tr.out.contains("1 passed, 1 failed\n")
        or not tr.out.ends_with("not shown: 1 passed test; continue with --from 1]\n")
        or tr.status != 1
        self.red("budget test summary", "exit {tr.status}\n{tr.out}")
    # budget.out.1, std.env.1: a `--budget` after FILE belongs to the program.
    a := "{dir}/args.ail"
    fs.write_text(
        a,
        "use std.env\n\nfn main()\n    for a in env.args()\n        print(a)\n",
    ) else return
    ra := ail_run(["run", "--budget", "1", a, "x", "--budget", "y"]) else return
    if not ra.out.starts_with("x\n[budget 1: records 1-1 of 3")
        self.red("budget run args", ra.out)
    # budget.out.5: a bare `--budget` takes the command's default.
    bare := ail_run(["check", "--budget", f]) else return
    if bare.err != plain.err
        self.red("bare --budget", bare.err)
    bad := ail_run(["check", "--from", "x", f]) else return
    if not bad.err.contains("budget.out.4") or bad.status != 2
        self.red("--from x", "exit {bad.status}\n{bad.err}")
    sh_run("rm -rf {dir}")

## Run limits and coverage (limits.rs, ported; run.limit.1-4, test.cover.1-3, test.run.5).
fn Gate.limits(mut self, tmp str)
    case := "tests/limits"
    r := ail_run(["run", "--timeout", "200", "{case}/limit_endless.ail"]) else return
    if r.status != 1 or not r.err.contains("trap[run.limit.1]") or not r.err.contains("in main(")
        self.red("--timeout", "exit {r.status}\n{r.err}")
    # run.limit.3 is native only (ADR 0883): the Rust binary doesn't know `--max-steps`.
    a := native_run(["run", "--max-steps", "1000", "{case}/limit_endless.ail"]) else return
    b := native_run(["run", "--max-steps", "1000", "{case}/limit_endless.ail"]) else return
    if a.status != 1 or not a.err.contains("trap[run.limit.3]") or a.err != b.err
        self.red("--max-steps", "exit {a.status}\n{a.err}")
    # trace.watch.5: native `--watch`, live and over a recording (ADR 0868 item 4).
    w := native_run(["run", "--watch", "n", "{case}/watch_when.ail"]) else return
    if w.status != 0
        or not w.err.contains("watch: n = 0 at 5:5\n")
        or not w.err.contains("(watch 4)")
        self.red("--watch", "exit {w.status}\n{w.err}")
    rec := "{tmp}/watch.rec"
    _r := native_run(["run", "--record", rec, "{case}/watch_when.ail"]) else return
    w2 := native_run(["run", "--replay", rec, "--watch", "n"]) else return
    if w2.status != 0 or w2.err != w.err
        self.red("--watch over --replay", "exit {w2.status}\n{w2.err}")
    m := ail_run(["run", "--max-memory", "100", "{case}/limit_memory.ail"]) else return
    if m.status != 1 or not m.err.contains("trap[run.limit.2]")
        self.red("--max-memory", "exit {m.status}\n{m.err}")
    t := ail_run(["test", "--timeout", "200", "{case}/limit_test_timeout.ail"]) else return
    if t.status != 1
        self.red("test --timeout", "exit {t.status}\n{t.out}")
    self.want("test --timeout", t.out, [
        "FAIL slow: trap[run.limit.1]",
        "ok quick",
        "1 passed, 1 failed",
    ])
    for args in [
        ["run", "--timeout", "0", "x.ail"],
        ["run", "--max-steps", "x", "x.ail"],
        ["check", "--timeout", "5", "x.ail"],
    ]
        mut u := proc.Output(status: 127, out: "", err: "")
        if args[1] == "--max-steps"
            u = native_run(args) else return
        else
            u = ail_run(args) else return
        if u.status != 2 or not u.err.contains("run.limit.4")
            self.red("limit usage {args}", "exit {u.status}\n{u.err}")
    c := native_run(["test", "--coverage=lines", "{case}/coverage_two_fns.ail"]) else return
    if c.status != 0
        self.red("coverage", "exit {c.status}\n{c.err}{c.out}")
    self.want("coverage", c.out, [
        "coverage ",
        ": lines 3/5 (60%), functions 1/2",
        "  not run: 11-12",
    ])
    cj := native_run(["test", "--json", "--coverage", "{case}/coverage_two_fns.ail"]) else return
    line := cj.out.lines().last() else ""
    if not line.starts_with("\{\"coverage\":true,\"file\":")
        or not line.ends_with("\"lines\":5,\"lines_hit\":3,\"functions\":2,\"functions_hit\":1,\"missed\":[[11,12]]}")
        self.red("coverage --json", cj.out)
    # Native traps show their values only under `--values` (ADR 0886).
    k := ail_run(["test", "--values", "{case}/limit_test_contract.ail"]) else return
    if k.status != 1
        self.red("test contract", "exit {k.status}")
    self.want("test contract", k.out, ["trap[contract.req.1]", "values: x = 0", "in boom()"])
    kj := ail_run(["test", "--json", "{case}/limit_test_contract.ail"]) else return
    self.want("test contract json", kj.out, ["\"snapshot\":\""])

## `ail diff OLD NEW` (diff.rs, ported; diff.out.1-7, ADRs 0396, 0399).
## The binary the suites call.
fn bin_path(root str) str
    "{root}/ail"

fn Gate.diff(mut self, tmp str)
    old_src := "fn add(a int, b int) int\n    a + b\n\nfn gone() int\n    1\n\nfn same() int\n    2\n\n@test fn adds()\n    assert(add(1, 2) == 3)\n\nfn main()\n    print(add(1, 2))\n"
    new_src := "## Adds.\npub fn add(a int, b int, c int) int\n    requires c >= 0\n    a + b\n\nfn same() int\n    2\n\nfn fresh() int\n    todo\n\n@test fn adds()\n    assert(add(1, 2, 0) == 4)\n\nfn main()\n    print(add(1, 2, 0))\n"
    d := "{tmp}/diff"
    sh_run("rm -rf {d}; mkdir -p {d}/old {d}/new")
    old := "{d}/old/p.ail"
    new := "{d}/new/p.ail"
    fs.write_text(old, old_src) else return
    fs.write_text(new, new_src) else return
    t := ail_run(["diff", old, new]) else return
    if t.status != 1
        self.red("diff text", "exit {t.status}\n{t.out}{t.err}")
    self.want("diff text", t.out, [
        "~ fn:add (doc, body changed)\n    signature: fn add(a int, b int) int -> fn add(a int, b int, c int) int\n    pub: false -> true\n    requires: (none) -> [\"c >= 0\"]\n    +requires c >= 0\n",
        "+ fn:fresh fn fresh() int\n~ fn:adds (body changed)\n    -assert(add(1, 2) == 3)\n    +assert(add(1, 2, 0) == 4)\n~ fn:main (body changed)\n    -print(add(1, 2))\n    +print(add(1, 2, 0))\n",
        "- fn:gone fn gone() int\n",
        "+ warning[expr.hole.1] {new}:10: hole: expected `int`; in scope: nothing\n",
        "test adds: pass -> fail: trap[test.assert.1]: assertion failed\n",
        "1 added, 1 removed, 3 changed; diagnostics +1 -0; failing tests 0 -> 1\n",
    ])
    if t.out.contains("fn:same")
        self.red("diff text", "reports an unchanged fn:\n{t.out}")
    n := ail_run(["diff", "--no-tests", old, old]) else return
    if n.status != 0 or n.out != "0 added, 0 removed, 0 changed; diagnostics +0 -0; tests not run\n"
        self.red("diff no change", "exit {n.status}\n{n.out}")
    # An attribute on its own line or on the declaration's line is layout, not a change (api.impact.1):
    # the `@test` above `fn t` was once counted as the body of the function before it.
    fs.write_text(old, "fn a() int\n    1\n\n@test\nfn t()\n    assert(a() == 1)\n") else return
    fs.write_text(new, "fn a() int\n    1\n\n@test fn t()\n    assert(a() == 1)\n") else return
    at := ail_run(["diff", "--no-tests", old, new]) else return
    if at.status != 0
        or at.out != "0 added, 0 removed, 0 changed; diagnostics +0 -0; tests not run\n"
        self.red("diff attribute layout", "exit {at.status}\n{at.out}")
    # diff.out.9: the same function under another name is a rename, not a removal and an addition.
    fs.write_text(
        old,
        "fn plus(a int, b int) int\n    a + b\n\nfn main()\n    print(plus(1, 2))\n",
    ) else return
    fs.write_text(
        new,
        "fn sum(a int, b int) int\n    a + b\n\nfn main()\n    print(sum(1, 2))\n",
    ) else return
    rn := ail_run(["diff", "--no-tests", old, new]) else return
    self.want("diff rename", rn.out, [
        "> fn:plus -> fn:sum (renamed)\n",
        "~ fn:main (body changed)\n",
        "0 added, 0 removed, 1 changed, 1 renamed; diagnostics +0 -0; tests not run\n",
    ])
    fs.write_text(old, old_src) else return
    fs.write_text(new, new_src) else return
    j := ail_run(["diff", "--json", old, new]) else return
    self.want("diff --json", j.out, [
        "\{\"change\":\"api\",\"op\":\"added\",\"id\":\"fn:fresh\",\"kind\":\"fn\",\"signature\":\"fn fresh() int\"}\n",
        "\{\"change\":\"test\",\"test\":\"adds\",\"old\":\"pass\",\"new\":\"fail\",\"status\":\"fail\",",
        "\"pub\":\{\"old\":\"false\",\"new\":\"true\"}",
    ])
    last := j.out.lines().last() else ""
    if not last.starts_with("\{\"summary\":true,")
        or not last.ends_with("\"added\":1,\"removed\":1,\"changed\":3,\"diagnostics_added\":1,\"diagnostics_removed\":0,\"tests_changed\":1,\"failing_before\":0,\"failing_after\":1}")
        self.red("diff --json summary", last)
    # diff.out.5: `--rev REV PATH` compares against git's copy.
    if proc.which("git") != none
        root := repo_root()
        g := "{d}/rev"
        sh_run("rm -rf {g}; mkdir -p {g}")
        fs.write_text("{g}/p.ail", old_src) else return
        s1 := sh_run("cd {g} && git init -q && git add p.ail && git -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -q -m old")
        if s1.status != 0
            self.red("diff --rev", "git setup failed: {s1.err}")
        fs.write_text("{g}/p.ail", new_src) else return
        bin := bin_path(root)
        r := sh_run("cd {g} && {bin} diff --rev HEAD --no-tests p.ail")
        if not r.out.ends_with("1 added, 1 removed, 3 changed; diagnostics +1 -0; tests not run\n")
            self.red("diff --rev", "{r.out}{r.err}")
        bad := sh_run("cd {g} && {bin} diff --rev nosuchrev p.ail")
        if bad.status != 2 or not bad.err.contains("(diff.out.5)")
            self.red("diff --rev nosuchrev", "exit {bad.status}\n{bad.err}")
    sh_run("rm -rf {d}")
    self.edit_oracle(tmp)

## The edit oracle of `ail test` against git's `HEAD` (test.oracle.1-6, ADR 1189): a changed pure function is
## reported with an input, its caller is not reported again, an equal rewrite is named as the same, a function
## the edit's own test calls is left out, and a clean or untracked file prints nothing.
fn Gate.edit_oracle(mut self, tmp str)
    if proc.which("git") == none
        return
    g := "{tmp}/oracle"
    bin := bin_path(repo_root())
    old_src := "fn fee(amount int, rate int) int\n    amount * rate / 100\n\nfn total(amount int, rate int) int\n    amount + fee(amount, rate)\n\nfn twice(a int) int\n    a + a\n\nfn half(a int) int\n    a / 2\n\n@test fn fee_of_hundred()\n    assert_eq(fee(100, 5), 5)\n"
    new_src := "fn fee(amount int, rate int) int\n    amount * rate / (100 - rate)\n\nfn total(amount int, rate int) int\n    amount + fee(amount, rate)\n\nfn twice(a int) int\n    a * 2\n\nfn half(a int) int\n    a / 3\n\n@test fn fee_of_hundred()\n    assert_eq(fee(100, 5), 5)\n\n@test fn half_is_a_third_now()\n    assert_eq(half(9), 3)\n"
    sh_run("rm -rf {g}; mkdir -p {g}")
    fs.write_text("{g}/p.ail", old_src) else return
    s1 := sh_run("cd {g} && git init -q && git add p.ail && git -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -q -m old")
    if s1.status != 0
        self.red("edit oracle", "git setup failed: {s1.err}")
        return
    # test.oracle.1: an unchanged file and a new one get no oracle.
    clean := sh_run("cd {g} && cp p.ail fresh.ail && {bin} test p.ail && {bin} test fresh.ail")
    if clean.status != 0 or clean.out.contains("behaviour")
        self.red("edit oracle: unchanged file", "exit {clean.status}\n{clean.out}{clean.err}")
    fs.write_text("{g}/p.ail", new_src) else return
    r := sh_run("cd {g} && AIL_TEST_ORACLE=why {bin} test p.ail")
    if r.status != 0
        self.red("edit oracle", "exit {r.status}\n{r.out}{r.err}")
    # test.oracle.5: the lines follow the summary.
    self.want("edit oracle", r.out, [
        "2 passed, 0 failed\nchanged behaviour: fee(amount: ",
        " inputs differ)\n",
        "same behaviour: twice (old against new on generated inputs)\n",
    ])
    # test.oracle.4: `total` differs through `fee`, and `half` has a new test of its own.
    if r.out.contains("total(") or r.out.contains("half(")
        self.red("edit oracle: explained functions", r.out)
    j := sh_run("cd {g} && {bin} test --json p.ail")
    last := j.out.lines().last() else ""
    if not last.starts_with("\{\"summary\":true,") or not j.out.contains("\{\"oracle\":\"changed\",\"fn\":\"fee\",")
        self.red("edit oracle --json", "{j.out}{j.err}")
    # test.oracle.6: both switches.
    quiet := sh_run("cd {g} && {bin} test --no-oracle p.ail && AIL_TEST_ORACLE=0 {bin} test p.ail")
    if quiet.status != 0 or quiet.out.contains("behaviour")
        self.red("edit oracle: off", "exit {quiet.status}\n{quiet.out}{quiet.err}")
    left := sh_run("cd {g} && ls -A . | grep ail-test; ls -A .. | grep ail-test-old")
    if not left.out.trim().is_empty()
        self.red("edit oracle: scratch files left", left.out)
    sh_run("rm -rf {g}")

## The `ail build` cache (build_cache.rs, ported; ADR 0655, native.build.5).
fn cache_entries(dir str) int
    # A Windows entry is the 64-digit key with `.exe`.
    r := sh_run("ls {dir} 2>/dev/null | awk 'length($0) == 64 || (length($0) == 68 && $0 ~ /[.]exe$/)' | wc -l")
    r.out.trim().to_int() else 0

fn Gate.build_cache(mut self, tmp str)
    root := repo_root()
    d := "{tmp}/build_cache"
    backend := "{tmp}/build_cache_compiler"
    cache := "{d}/cache"
    prog := "{d}/prog.ail"
    # A private copy of the backend: the cache key covers every file of it.
    sh_run("rm -rf {d} {backend}; mkdir -p {d}; cp -R {root}/compiler {backend}")
    fs.write_text(prog, "fn main()\n    print(\"one\")\n") else return
    bin := bin_path(root)
    f := build_with(bin, backend, cache, prog, "{d}/first", "")
    if f.status != 0
        self.red("build cache", "first build failed: {f.err}")
    if cache_entries(cache) != 1
        self.red("build cache", "a build is stored")
    build_with(bin, backend, cache, prog, "{d}/second", "")
    if cache_entries(cache) != 1
        self.red("build cache", "an unchanged program is a hit")
    build_with(bin, backend, "{d}/nocache_cache", prog, "{d}/plain", "--no-cache")
    if cache_entries("{d}/nocache_cache") != 0
        self.red("build cache", "--no-cache stores nothing")
    same := sh_run("cmp -s {d}/first {d}/second")
    if same.status != 0
        self.red("build cache", "a hit returns the stored bytes")
    plain := sh_run("cmp -s {d}/first {d}/plain")
    if plain.status != 0
        self.red("build cache", "cached and uncached builds are not the same bytes")
    # A changed program, and a changed file beside it, are new entries.
    fs.write_text(prog, "fn main()\n    print(\"two\")\n") else return
    build_with(bin, backend, cache, prog, "{d}/fresh", "")
    if cache_entries(cache) != 2
        self.red("build cache", "a changed program is a new entry")
    if sh_run("cmp -s {d}/first {d}/fresh").status == 0
        self.red("build cache", "a changed program gave the same bytes")
    fs.write_text("{d}/other.ail", "fn unused() int\n    1\n") else return
    build_with(bin, backend, cache, prog, "{d}/fresh", "")
    if cache_entries(cache) != 3
        self.red("build cache", "any .ail file of the package is part of the key")
    sh_run("rm -rf {d} {backend}")

fn build_with(bin str, backend str, cache str, prog str, out str, extra str) proc.Output
    sh_run("env -u AIL_NO_CACHE AIL_CACHE_DIR={cache} AIL_COMPILER={backend} {bin} build {prog} -o {out} {extra}")

## `ail api --locals/--type/--refs` (api_queries.rs, ported; api.loc, api.type, api.refs, api.pkg).
fn Gate.api_queries(mut self, tmp str)
    d := "{tmp}/api_queries"
    sh_run("rm -rf {d}; mkdir -p {d}/geo")
    fs.write_text(
        "{d}/geo/shapes.ail",
        "pub struct P\n    pub x int\n\npub fn origin() P\n    P(x: 0)\n",
    ) else return
    main := "{d}/main.ail"
    fs.write_text(
        main,
        "use geo\n\nfn main()\n    p := geo.origin()\n    print(\"\{p.x}\")\n",
    ) else return
    r := ail_run(["api", "--refs", main, "4", "12"]) else return
    if r.status != 0
        self.red("api --refs", r.err)
    self.want("api --refs", r.out, [
        "\"symbol\":\"fn:geo.origin\"",
        "\{\"file\":\"{d}/geo/shapes.ail\",\"line\":4,\"col\":8,\"def\":true}",
        "\"line\":4,\"col\":10,\"def\":false",
    ])
    ty := ail_run(["api", "--type", main, "4", "12"]) else return
    if not ty.out.contains("\"type\":\"geo.P\"")
        or not (ty.out.contains("\"signature\":\"fn geo.origin() P\"") or ty.out.contains("\"id\":\"fn:geo.origin\""))
        self.red("api --type", ty.out)
    # api.query.1: nothing at the position is exit 1 with a JSON error on stderr.
    n := ail_run(["api", "--type", main, "3", "1"]) else return
    if n.status != 1 or not n.err.starts_with("\{\"api\":1,\"severity\":\"error\"")
        self.red("api --type nothing", "exit {n.status}\n{n.err}")
    m := ail_run(["api", "--locals", main]) else return
    if m.status != 2
        self.red("api --locals no position", "exit {m.status}, want 2")
    fs.write_text("{d}/bad.ail", "fn main()\n    x\n") else return
    b := ail_run(["api", "--locals", "--json", "{d}/bad.ail", "2", "5"]) else return
    if b.status != 2 or not b.err.contains("\"rule\":")
        self.red("api --locals rejected", "exit {b.status}\n{b.err}")
    sh_run("rm {d}/bad.ail")
    for name in fs.list_dir("examples") else []
        stem := name.replace(".ail", "")
        if name.ends_with(".ail") and fs.exists("examples/{stem}.out")
            lines := slurp("examples/{name}").lines().len()
            e := ail_run(["api", "--locals", "examples/{name}", "{lines}", "5"]) else continue
            if e.status != 0
                self.red("api --locals examples/{name}", e.err)
    # api.pkg.1: a package directory is outlined whole.
    fs.write_text(
        main,
        "use geo\n\nfn main()\n    p := geo.origin()\n    print(\"\{p.x} \{far()}\")\n",
    ) else return
    util := "{d}/util.ail"
    fs.write_text(util, "use geo\n\npub fn far() int\n    geo.origin().x\n") else return
    o := ail_run(["api", "--outline", d]) else return
    if o.status != 0 or not o.out.starts_with("\{\"api\":1,\"package\":")
        self.red("api --outline", "exit {o.status}\n{o.err}{o.out}")
    self.want("api --outline", o.out, [
        "\"id\":\"fn:geo.origin\"",
        "\"id\":\"type:geo.P\"",
        "\"id\":\"fn:far\"",
        "\"module\":\"geo\"",
        "util.ail",
    ])
    sy := ail_run(["api", "--symbols", d]) else return
    self.want("api --symbols", sy.out, ["\"references\":[", "\"id\":\"fn:geo.origin\""])
    tx := ail_run(["api", "--text", d]) else return
    self.want("api --text package", tx.out, ["fn geo.origin() geo.P"])
    # api.pkg.2-3: `--refs DIR FILE LINE COL` finds uses in every file of the package.
    shapes := "{d}/geo/shapes.ail"
    for q in [[util, "4", "9"], [util, "4", "5"], [shapes, "4", "8"]]
        a := ail_run(["api", "--refs", d, q[0], q[1], q[2]]) else return
        if a.status != 0 or not a.out.contains("\"symbol\":\"fn:geo.origin\"")
            self.red("api --refs package {q}", "exit {a.status}\n{a.err}{a.out}")
        for file in ["main.ail", "util.ail", "geo/shapes.ail"]
            if not a.out.contains("{d}/{file}\"")
                self.red("api --refs package {q}", "{file} missing in\n{a.out}")
    # api.pkg.4: the single-file form keeps working; a file outside the package is an error.
    single := "{tmp}/api_queries_single"
    sh_run("rm -rf {single}; mkdir -p {single}/geo; cp {d}/geo/shapes.ail {single}/geo/")
    fs.write_text(
        "{single}/main.ail",
        "use geo\n\nfn main()\n    p := geo.origin()\n    print(\"\{p.x}\")\n",
    ) else return
    sf := ail_run(["api", "--refs", "{single}/main.ail", "4", "12"]) else return
    if sf.status != 0
        self.red("api --refs single file", sf.err)
    stray := "{tmp}/stray.ail"
    fs.write_text(stray, "fn main()\n    print(\"x\")\n") else return
    st := ail_run(["api", "--refs", d, stray, "1", "4"]) else return
    if st.status != 2 or not st.err.contains("api.pkg.2")
        self.red("api --refs stray", "exit {st.status}\n{st.err}")
    sh_run("rm -rf {d} {single} {stray}")
    # `ail api --text` prints the outline of every standard-library file (std/ui/ui.ail once failed to compile).
    root := repo_root()
    listed := proc.run(
        "sh",
        ["-c", "cd \"$0/std\" && find . -name '*.ail' | sort", root],
        "",
    ) else return
    for rel in listed.out.lines()
        if rel.trim() == ""
            continue
        name := rel.trim().strip_prefix("./") else rel.trim()
        f := "{root}/std/{name}"
        t := ail_run(["api", "--text", f]) else return
        if t.status != 0 or t.out.trim() == ""
            self.red("api --text {f}", "exit {t.status}\n{t.err}")

## Record and replay (replay.rs, ported; replay.rec, replay.cap, replay.run, ADR 0398).
fn rpl(dir str, input str, args List[str]) proc.Output
    root := repo_root()
    script := "d=$0; bin=$1; shift; cd \"$d\" && REPLAY_NAME=first exec \"$bin\" \"$@\""
    r := proc.run(
        "sh",
        cat(["-c", script, dir, "{root}/ail"], args),
        input,
    ) else return proc.Output(status: 127, out: "", err: "could not start sh")
    r

fn Gate.replay(mut self, tmp str)
    root := repo_root()
    base := "{tmp}/replay"
    sh_run("rm -rf {base}; mkdir -p {base}/world {base}/repeat {base}/diverge {base}/handles {base}/tests {base}/options")
    program := "fn main() !\n    t := time.now_ms()\n    n := random.int(1, 1000000)\n    data := fs.read_text(\"input.txt\")?\n    name := env.get(\"REPLAY_NAME\") else \"nobody\"\n    line := io.read_line() else \"eof\"\n    gone := fs.read_text(\"missing.txt\") else e\n        \"\{e.kind}\"\n    print(\"\{t} \{n} \{name} \{line} \{data.lines().len()} \{gone}\")\n    xs := [1, 2]\n    print(xs[data.lines().len()])\n"
    # replay.rec.1-2, replay.run.1-2: a replay prints what the recorded run printed.
    d := "{base}/repeat"
    fs.write_text("{d}/prog.ail", program) else return
    fs.write_text("{d}/input.txt", "a\nb\nc\n") else return
    first := rpl(d, "hello\n", ["run", "--record", "r.json", "prog.ail"])
    if first.status != 1
        or not first.out.contains(" first hello 3 fs.IoKind.NotFound")
        or not first.err.contains("prog.ail:11:13: trap[type.coll.4]")
        self.red("replay record", "exit {first.status}\n{first.out}{first.err}")
    rec := slurp("{d}/r.json")
    if not rec.starts_with("\{\"ail_record\":1,\"program\":\"prog.ail\"")
        or not rec.contains("\{\"call\":\"io.read_line\",\"line\":6,\"col\":16,\"result\":\"hello\"}")
        self.red("replay recording", rec)
    fs.write_text("{d}/input.txt", "x\n") else return
    again := rpl(d, "", ["run", "--replay", "r.json"])
    if again.out != first.out or again.err != first.err or again.status != 1
        self.red("replay repeats the run", "exit {again.status}\n{again.out}{again.err}")
    # replay.run.1: `--replay R FILE` runs FILE, and an argument after the recording is not its program.
    rf := rpl(d, "hello\n", ["run", "--replay", "r.json", "prog.ail"])
    if rf.out != again.out or rf.err != again.err
        self.red("replay with a file", "{rf.out}{rf.err}|{again.out}{again.err}")
    # replay.run.3: a program that changed since the recording traps at the first call that differs.
    d2 := "{base}/diverge"
    fs.write_text(
        "{d2}/prog.ail",
        "fn main()\n    print(env.get(\"REPLAY_NAME\") else \"\")\n",
    ) else return
    if rpl(d2, "", ["run", "--record", "r.json", "prog.ail"]).status != 0
        self.red("replay diverge", "recording failed")
    fs.write_text("{d2}/prog.ail", "fn main()\n    print(fs.exists(\"x\"))\n") else return
    dv := rpl(d2, "", ["run", "--replay", "r.json", "prog.ail"])
    self.want("replay diverges", dv.err, [
        "prog.ail:2:14: trap[replay.run.3]",
        "the recording's next effect is `env.get`",
    ])
    # replay.nat.1: a child process is recorded with its streams, and a replay answers it.
    d3 := "{base}/handles"
    exe := "{root}/ail"
    fs.write_text(
        "{d3}/start.ail",
        "fn main() !\n    print(\"a\")\n    p := proc.start(\"{exe}\", [\"version\"])?\n",
    ) else return
    rpl(d3, "", ["run", "--record", "s.json", "start.ail"])
    if not slurp("{d3}/s.json").contains("\"call\":\"proc.start\",\"line\":3,\"col\":15,\"result\":")
        self.red("replay handle", slurp("{d3}/s.json"))
    h := rpl(d3, "", ["run", "--replay", "s.json"])
    if h.out != "a\n" or h.status != 0
        self.red("replay handle", "{h.out}{h.err}")
    # replay.nat.1: lists, structs, maps, a child's streams and the HTTP client replay without the world.
    d6 := "{base}/world"
    sh_run("rm -rf {d6}; mkdir -p {d6}/dir; echo hello > {d6}/dir/a.txt; touch {d6}/dir/b.txt")
    fs.write_text(
        "{d6}/w.ail",
        "fn main() !\n    print(\"\{fs.list_dir(\"dir\")?}\")\n    m := fs.metadata(\"dir/a.txt\")?\n    print(\"\{m.size} \{m.is_dir}\")\n    print(\"\{env.vars().get(\"REPLAY_NAME\") else \"none\"}\")\n    o := proc.run(\"echo\", [\"hi\", \"there\"])?\n    print(\"\{o.status} \{o.out.trim()}\")\n    c := proc.start(\"sh\", [\"-c\", \"read x; echo got $x; echo oops >&2\"])?\n    c.stdin.send(\"in\\n\")\n    c.stdin.close()\n    for l in c.out\n        print(\"out \{l}\")\n    for l in c.err\n        print(\"err \{l}\")\n    print(\"\{proc.wait(move c)?}\")\n",
    ) else return
    w1 := rpl(d6, "", ["run", "--record", "w.json", "w.ail"])
    sh_run("rm -rf {d6}/dir")
    w2 := rpl(d6, "", ["run", "--replay", "w.json"])
    if w1.status != 0 or w2.out != w1.out or w2.status != 0 or not w1.out.contains("out got in")
        self.red("replay world", "{w1.out}{w1.err}|{w2.out}{w2.err}")
    fs.write_text("{d3}/sleep.ail", "fn main()\n    time.sleep_ms(-1)\n") else return
    sf := rpl(d3, "", ["run", "--record", "t.json", "sleep.ail"])
    sa := rpl(d3, "", ["run", "--replay", "t.json"])
    if not sf.err.contains("trap[std.time.2]") or sa.err != sf.err
        self.red("replay trap in a call", "{sf.err}|{sa.err}")
    # replay.rec.1, replay.rec.5, replay.run.1: `ail test --record` keeps the failed tests' effects.
    d4 := "{base}/tests"
    fs.write_text(
        "{d4}/t.ail",
        "fn greeting() str\n    \"hi \{env.get(\"REPLAY_NAME\") else \"x\"} \{random.int(1, 1000000)}\"\n\n@test\nfn passes()\n    assert_eq(1 + 1, 2)\n\n@test\nfn flaky()\n    assert_eq(greeting(), \"hi first 0\")\n",
    ) else return
    tf := rpl(d4, "", ["test", "--record", "r.json", "t.ail"])
    trec := slurp("{d4}/r.json")
    if tf.status != 1
        or not trec.contains("\{\"test\":\"flaky\"}\n\{\"call\":\"env.get\"")
        or trec.contains("passes")
        or not trec.contains("\{\"call\":\"env.get\",\"line\":2,")
        self.red("test --record", "exit {tf.status}\n{trec}")
    ta := rpl(d4, "", ["test", "--replay", "r.json"])
    mut fail_a := ""
    for l in tf.out.lines()
        if l.starts_with("FAIL flaky")
            fail_a = l
    mut fail_b := ""
    for l in ta.out.lines()
        if l.starts_with("FAIL flaky")
            fail_b = l
    if fail_a != fail_b or not ta.out.contains("0 passed, 1 failed")
        self.red("test --replay", ta.out)
    # replay.rec.1: the options need `run` or `test` and a file.
    d5 := "{base}/options"
    o1 := rpl(d5, "", ["check", "--record", "r.json", "x.ail"])
    if o1.status != 2 or not o1.err.contains("(replay.rec.1)")
        self.red("check --record", "exit {o1.status}\n{o1.err}")
    o2 := rpl(d5, "", ["run", "--replay", "nothing.json"])
    if o2.status != 2 or not o2.err.contains("can't read the recording nothing.json")
        self.red("--replay nothing", "exit {o2.status}\n{o2.err}")
    sh_run("rm -rf {base}")

## `ail api --card` (api_card.rs, ported; api.card.1-7, ADRs 0310-0311, 0703).
fn card_pkg(tmp str, name str) str
    dir := "{tmp}/api_card/{name}/notes"
    sh_run("rm -rf {dir}; mkdir -p {dir}/geo {dir}/examples {dir}/../textkit")
    fs.write_text(
        "{dir}/ail.pkg",
        "# manifest\npackage notes\ndep textkit path ../textkit caps fs\n",
    ) else return dir
    fs.write_text(
        "{dir}/geo/shapes.ail",
        "## A point on the plane.\npub struct P\n    pub x int\n    pub y int\n\n## The origin.\npub fn origin() P\n    P(x: 0, y: 0)\n\nfn hidden() int\n    1\n\nfn hidden_two(a int, b int) int\n    a + b\n\nfn hidden_three(a int, b int) int\n    a * b\n\nfn hidden_four(a int, b int) int\n    a - b\n\nfn hidden_five(a int, b int) int\n    a / b\n",
    ) else return dir
    fs.write_text(
        "{dir}/main.ail",
        "use geo\n\n## Shows the origin.\npub fn show(p geo.P, n int) str\n    requires n > 0\n    \"\{p.x}\"\n\n@test fn shows_origin()\n    assert(show(geo.origin(), 1) == \"0\")\n\nfn main()\n    print(show(geo.origin(), 1))\n",
    ) else return dir
    fs.write_text(
        "{dir}/examples/hello.ail",
        "## Prints a greeting.\nfn main()\n    print(\"hi\")\n",
    ) else return dir
    dir

fn card_of(dir str, extra List[str]) str
    r := ail_run(cat(cat(["api", "--card"], extra), [dir])) else return ""
    if r.status != 0
        return "EXIT {r.status}\n{r.err}"
    r.out

fn last_line(text str) str
    text.lines().last() else ""

fn Gate.api_card(mut self, tmp str)
    # api.card.1
    dir := card_pkg(tmp, "lists")
    card := card_of(dir, [])
    self.want("card lists the program", card, [
        "# notes\n",
        "entry: main in main.ail\n",
        "tests: shows_origin\n",
        "    package notes\n",
        "    dep textkit path ../textkit caps fs\n",
        "    hello.ail  ## Prints a greeting.\n",
        "## (root)\n",
        "pub fn show(p geo.P, n int) str  ## Shows the origin.\n",
        "    requires n > 0\n",
        "## geo\n",
        "pub fn geo.origin() geo.P  ## The origin.\n",
        "pub struct geo.P  ## A point on the plane.\n",
        "fn geo.hidden() int\n",
    ])
    if card.contains("trimmed")
        self.red("card lists the program", "trimmed:\n{card}")
    a := card.find("## (root)") else 0
    b := card.find("## geo") else 0
    if a >= b
        self.red("card module order", card)
    # api.card.3: over budget, private items go first, and the card says so.
    full := card_of(dir, [])
    mut found := ""
    mut budget := full.len() / 3 - 1
    while budget >= 1 and found.is_empty()
        c := card_of(dir, ["--budget", "{budget}"])
        if last_line(c).ends_with("dropped: private items")
            found = c
        budget -= 1
    if found.is_empty()
        self.red("card private items", "no budget drops only private items")
    elif found.contains("hidden()")
        or not found.contains("pub fn geo.origin() geo.P  ## The origin.")
        or not last_line(found).starts_with("trimmed to fit ")
        self.red("card private items", found)
    # a tiny budget drops docs, parameter names, then signatures.
    docs_gone := card_of(dir, ["--budget", "120"])
    if docs_gone.contains("## The origin.")
        or not last_line(docs_gone).contains("private items, doc comments")
        self.red("card small budget", docs_gone)
    names := card_of(dir, ["--budget", "1"])
    if not names.contains("items)") or not last_line(names).ends_with("signatures (names only)")
        self.red("card budget 1", names)
    # api.card.3 (ADR 0703): the middle level keeps each public signature and the first sentence of its doc.
    mid := "{tmp}/api_card/middle/pkg"
    sh_run("rm -rf {mid}; mkdir -p {mid}")
    fs.write_text("{mid}/ail.pkg", "package middle\n") else return
    mut src := "fn main()\n    print(1)\n"
    for i in 0..60
        src = "{src}\n## Step {i} of the walk. It is long and says more.\npub fn step{i}(x int) int\n    x + {i}\n"
    fs.write_text("{mid}/main.ail", src) else return
    mut middle := ""
    mut b2 := 8000
    while b2 >= 1 and middle.is_empty()
        c := card_of(mid, ["--budget", "{b2}"])
        if last_line(c).ends_with("(docs past their first sentence)")
            middle = c
        b2 -= 40
    if middle.is_empty()
        self.red("card middle level", "no budget gives the middle level")
    elif not middle.contains("pub fn step3(int) int  ## Step 3 of the walk.")
        or middle.contains("It is long")
        self.red("card middle level", middle)
    # api.card.2: the JSON form has the same content.
    j := ail_run(["api", "--card", "--json", dir]) else return
    self.want("card json", j.out, [
        "\"card\":\"notes\"",
        "\"entry\":\"main in main.ail\"",
        "\"tests\":[\"shows_origin\"]",
        "\"module\":\"geo\"",
        "\"signature\":\"fn geo.origin() geo.P\"",
        "\"requires\":[\"n > 0\"]",
        "\"dropped\":[]",
    ])
    # api.card.4: a program the checker rejects has no card; a bad option is a usage error.
    bad := "{tmp}/api_card/bad"
    sh_run("rm -rf {bad}; mkdir -p {bad}")
    fs.write_text("{bad}/main.ail", "fn main()\n    x := nope()\n") else return
    r1 := ail_run(["api", "--card", bad]) else return
    if r1.status != 2 or not r1.out.is_empty()
        self.red("card rejected program", "exit {r1.status}\n{r1.out}")
    r2 := ail_run(["api", "--card", "--budget", "many", bad]) else return
    if r2.status != 2
        self.red("card --budget many", "exit {r2.status}")
    # api.card.6, api.card.7: the committed module and index cards, and the whole cards, are fresh.
    for pair in [["compiler", "compiler"], ["std", "std"]]
        index := ail_run(["api", "--card", "--index", pair[0]]) else return
        if index.status != 0
            self.red("card index {pair[0]}", index.err)
            continue
        if slurp("docs/design/cards/{pair[1]}/index.md") != index.out
            self.red(
                "card {pair[1]}/index.md",
                "is stale; regenerate it for {pair[0]} (see docs/design/cards/README.md)",
            )
        mut first := true
        for line in index.out.lines()
            if first
                first = false
                continue
            module := line.words()[0]
            file := if module == "(root)" then "root" else module
            m := ail_run([
                "api",
                "--card",
                "--budget",
                "2000",
                "--module",
                module,
                pair[0],
            ]) else return
            if m.status != 0
                self.red("card module {module}", m.err)
            elif slurp("docs/design/cards/{pair[1]}/{file}.md") != m.out
                self.red("card {pair[1]}/{file}.md", "is stale; regenerate it for {pair[0]}")
    for pair in [["std", "std.md"], ["compiler", "compiler.md"]]
        w := ail_run(["api", "--card", pair[0]]) else return
        if w.status != 0
            self.red("card {pair[0]}", w.err)
        elif slurp("docs/design/cards/{pair[1]}") != w.out
            self.red(
                "card {pair[1]}",
                "is stale; run `./ail api --card {pair[0]} > docs/design/cards/{pair[1]}`",
            )
    # api.card.6: `--module` prints one module; an unknown module or `--index` with it is exit 2.
    geo := card_of(dir, ["--module", "geo", "--budget", "4000"])
    if not geo.starts_with("# notes: geo\n")
        or not geo.contains("pub struct geo.P")
        or geo.contains("show(p")
        or geo.contains("entry:")
        or geo.contains("ail.pkg")
        or geo.contains("examples:")
        self.red("card --module geo", geo)
    root := card_of(dir, ["--module", "(root)"])
    self.want("card --module (root)", root, ["entry: main in main.ail\n", "tests: shows_origin\n"])
    if root.contains("geo.origin")
        self.red("card --module (root)", root)
    nope := ail_run(["api", "--card", "--module", "nope", dir]) else return
    if nope.status != 2 or not nope.err.contains("--index")
        self.red("card --module nope", "exit {nope.status}\n{nope.err}")
    both := ail_run(["api", "--card", "--index", "--module", "geo", dir]) else return
    if both.status != 2
        self.red("card --index --module", "exit {both.status}")
    # api.card.7: `--index` lists each module with its count, root first.
    index := card_of(dir, ["--index"])
    if index != "# notes\n(root)  2 items\ngeo  7 items\n"
        self.red("card --index", index)
    ij := card_of(dir, ["--index", "--json"])
    if not ij.contains("\{\"module\":\"geo\",\"count\":7}") or not ij.starts_with("\{\"api\"")
        self.red("card --index --json", ij)
    sh_run("rm -rf {tmp}/api_card")

## `ail edit PATH < EDITS` (edit.rs, ported; edit.in, edit.id, edit.op, edit.out, ADRs 0397, 0399).
fn edit_run(path str, flags List[str], edits str) proc.Output
    r := proc.run(
        bin_path("."),
        cat(cat(["edit"], flags), [path]),
        edits,
    ) else return proc.Output(status: 127, out: "", err: "could not start ail")
    r

fn Gate.edit(mut self, tmp str)
    src := "struct Point\n    x int\n\nfn Point.shift(mut self, d int)\n    x += d\n\n## Adds.\nfn add(a int, b int) int\n    requires a >= 0\n    a + b\n\nfn old() int\n    1\n\nfn main()\n    mut p := Point(x: add(1, 2))\n    p.shift(add(3, 4))\n    print(p)\n"
    d := "{tmp}/edit"
    sh_run("rm -rf {d}; mkdir -p {d}")
    f := "{d}/p.ail"
    fs.write_text(f, src) else return
    ops := "[\n\{\"op\":\"rename\",\"id\":\"fn:add\",\"to\":\"plus\"},\n\{\"op\":\"replace_body\",\"id\":\"fn:plus\",\"body\":\"a+b+0\"},\n\{\"op\":\"insert\",\"after\":\"fn:plus\",\"text\":\"## Twice.\\nfn twice(n int) int\\n    plus(n, n)\"},\n\{\"op\":\"delete\",\"id\":\"fn:old\"},\n\{\"op\":\"import\",\"module\":\"std.fs\"},\n\{\"op\":\"rename\",\"id\":\"type:Point\",\"to\":\"Pt\"},\n\{\"op\":\"rename\",\"id\":\"field:Pt.x\",\"to\":\"xx\"},\n\{\"op\":\"replace\",\"id\":\"fn:main\",\"text\":\"fn main()\\n    mut p := Pt(xx: twice(2))\\n    p.shift(plus(3, 4))\\n    print(p)\"}\n]"
    o := edit_run(f, [], ops)
    want_text := "use std.fs\n\nstruct Pt\n    xx int\n\nfn Pt.shift(mut self, d int)\n    self.xx += d\n\n## Adds.\nfn plus(a int, b int) int\n    requires a >= 0\n    a + b + 0\n\n## Twice.\nfn twice(n int) int\n    plus(n, n)\n\nfn main()\n    mut p := Pt(xx: twice(2))\n    p.shift(plus(3, 4))\n    print(p)\n"
    if o.status != 0 or o.out != "edited 1 file; 0 errors\n" or slurp(f) != want_text
        self.red("edit every op", "exit {o.status}\n{o.out}{o.err}\n{slurp(f)}")
    # edit.in.2: a failing edit stops the run and nothing is written.
    fs.write_text(f, src) else return
    a := edit_run(
        f,
        [],
        "[\{\"op\":\"delete\",\"id\":\"fn:old\"},\{\"op\":\"delete\",\"id\":\"fn:nope\"}]",
    )
    if a.status != 2
        or a.err != "error: edit 2 of 2: no declaration has the id `fn:nope` (edit.id.1); nothing was written\n"
        or slurp(f) != src
        self.red("edit all or nothing", "exit {a.status}\n{a.err}")
    bad := edit_run(f, [], "[\{\"op\":")
    self.want("edit bad json", bad.err, ["(edit.in.1)"])
    # edit.out.2-3: the new diagnostics; `--if-clean` and `--dry-run` write nothing.
    broken := "[\{\"op\":\"replace_body\",\"id\":\"fn:main\",\"body\":\"print(nope)\"}]"
    c := edit_run(f, ["--if-clean"], broken)
    if c.status != 2
        or not c.err.contains("error[expr.name.1]: unknown name `nope`")
        or not c.out.starts_with("not written (--if-clean) 1 file; 1 error")
        or slurp(f) != src
        self.red("edit --if-clean", "exit {c.status}\n{c.out}{c.err}")
    dr := edit_run(f, ["--dry-run", "--json"], "[\{\"op\":\"delete\",\"id\":\"fn:old\"}]")
    self.want("edit --dry-run", dr.out, ["-fn old() int\n", "\"written\":false"])
    if slurp(f) != src
        self.red("edit --dry-run", "wrote the file")
    w := edit_run(f, [], broken)
    if w.status != 2 or not slurp(f).contains("print(nope)")
        self.red("edit writes a broken file", "exit {w.status}")
    # edit.id.2, edit.op.5: in a package, ids carry the module and a rename reaches every file.
    pkg := "{d}/app"
    sh_run("mkdir -p {pkg}/geo")
    fs.write_text("{pkg}/geo/shapes.ail", "pub fn origin() int\n    0\n") else return
    fs.write_text("{pkg}/main.ail", "use geo\n\nfn main()\n    print(geo.origin())\n") else return
    p := edit_run(pkg, [], "[\{\"op\":\"rename\",\"id\":\"fn:geo.origin\",\"to\":\"zero\"}]")
    if p.status != 0
        or slurp("{pkg}/geo/shapes.ail") != "pub fn zero() int\n    0\n"
        or slurp("{pkg}/main.ail") != "use geo\n\nfn main()\n    print(geo.zero())\n"
        self.red("edit package rename", "exit {p.status}\n{p.out}{p.err}")
    # edit.in.3, edit.id.3, edit.op.7, edit.out.4: compact hunks.
    avg := "fn average(xs List[int]) int\n    mut total := 0\n    for x in xs\n        total += x\n    total / xs.len()\n\n@test fn empty_is_zero()\n    assert_eq(average([]), 0)\n"
    g := "{d}/avg.ail"
    fs.write_text(g, avg) else return
    h := edit_run(g, ["--test"], "average\n+if xs.len() == 0\n+    return 0\n mut total := 0\n")
    if h.status != 0
        or h.out != "edited 1 file; 0 errors\nok empty_is_zero\n1 passed, 0 failed\n"
        or not slurp(g).starts_with("fn average(xs List[int]) int\n    if xs.len() == 0\n        return 0\n    mut total")
        self.red("edit compact hunk", "exit {h.status}\n{h.out}{h.err}")
    h2 := edit_run(g, [], "fn:average\n-total / xs.len()\n+total / xs.len().max(1)\n")
    if h2.status != 0 or not slurp(g).contains("    total / xs.len().max(1)\n")
        self.red("edit compact part", "exit {h2.status}\n{h2.err}")
    h3 := edit_run(g, [], "average\n-total\n+sum\n")
    if h3.status != 2
        or not h3.err.contains("`total` occurs 3 times; quote more of its line in `fn:average` (edit.op.7)")
        self.red("edit ambiguous", "exit {h3.status}\n{h3.err}")
    h4 := edit_run(g, [], "average\n-nothing here\n+x\n")
    self.want("edit not found", h4.err, ["`nothing here` is not found"])
    # edit.in.3: `rename OLD NEW` and lines that are neither.
    fs.write_text(g, avg) else return
    r1 := edit_run(g, [], "rename average mean\n")
    if r1.status != 0 or not slurp(g).contains("assert_eq(mean([]), 0)")
        self.red("edit rename", "exit {r1.status}\n{r1.err}")
    r2 := edit_run(g, [], "mean is wrong\n")
    if r2.status != 2 or not r2.err.contains("line 1: expected an id")
        self.red("edit bad line", "exit {r2.status}\n{r2.err}")
    # edit.out.3: a preview or a refused edit never writes the file, even for a moment.
    fs.write_text(f, src) else return
    before := sh_run("stat -c %Y {f} 2>/dev/null || stat -f %m {f}").out
    nope := "[\{\"op\":\"replace_body\",\"id\":\"fn:old\",\"body\":\"nope\"}]"
    m1 := edit_run(f, ["--dry-run"], nope)
    m2 := edit_run(f, ["--if-clean"], nope)
    after := sh_run("stat -c %Y {f} 2>/dev/null || stat -f %m {f}").out
    if m1.status != 2 or m2.status != 2 or before != after or slurp(f) != src
        self.red("edit from memory", "{m1.status} {m2.status} {before}|{after}")
    sh_run("rm -rf {d}")

## Git dependencies and `ail.lock` (git_deps.rs, ported; mod.pkg.6-9, eff.cap.4),
## with a local bare repository as the remote: no network.
fn git_in(dir str, cmd str) str
    r := sh_run("cd {dir} && git -c user.name=ail -c user.email=ail@example.com -c init.defaultBranch=main -c tag.gpgSign=false -c commit.gpgSign=false {cmd}")
    r.out.trim()

fn gd_commit(dir str, url str, body str, tag str) str
    work := "{dir}/work"
    fs.write_text("{work}/ail.pkg", "package geo\n") else return ""
    fs.write_text(
        "{work}/geo.ail",
        "use std.fs\n\npub fn area(w int, h int) int\n    {body}\n\npub fn cached() bool\n    fs.exists(\"no-such-file\")\n",
    ) else return ""
    git_in(work, "add -A")
    git_in(work, "commit -qm 'c'")
    git_in(work, "tag -f {tag}")
    git_in(work, "push -q -f {url} HEAD:refs/heads/main refs/tags/{tag}")
    git_in(work, "rev-parse HEAD")

fn gd_manifest(dir str, url str, rest str)
    fs.write_text("{dir}/app/ail.pkg", "package app\ndep geo git \"{url}\" {rest}\n") else return

## `ail ARGS` in `dir` with AIL_HOME set (and an optional PATH override).
fn gd_ail(dir str, cwd str, path str, args str) proc.Output
    root := repo_root()
    p := if path.is_empty() then "" else "PATH={path} "
    sh_run("cd {cwd} && AIL_HOME={dir}/home {p}{bin_path(root)} {args}")

## A `file://` URL of the absolute path `p`; a Windows drive path (`C:/..`) takes a third slash.
fn file_url(p str) str
    if p.starts_with("/")
        return "file://{p}"
    "file:///{p}"

fn gd_setup(tmp str, name str) str
    dir := "{tmp}/git-deps-{name}"
    sh_run("chmod -R u+w {dir} 2>/dev/null; rm -rf {dir}; mkdir -p {dir}/work {dir}/app")
    git_in(dir, "init -q --bare remote.git")
    git_in("{dir}/work", "init -q")
    url := file_url("{dir}/remote.git")
    gd_commit(dir, url, "w * h", "v1")
    fs.write_text(
        "{dir}/app/main.ail",
        "use geo\n\nfn main()\n    print(geo.area(3, 4))\n    print(geo.cached())\n",
    ) else return dir
    gd_manifest(dir, url, "tag v1 caps fs")
    dir

fn Gate.git_deps(mut self, tmp str)
    if proc.which("git") == none
        print("git_deps: no git; skipping")
        return
    dir := gd_setup(tmp, "lock")
    url := file_url("{dir}/remote.git")
    first := git_in("{dir}/work", "rev-parse HEAD")
    lock := "{dir}/app/ail.lock"
    # mod.pkg.7-8: the first run fetches into the cache and writes the lock.
    r := gd_ail(dir, dir, "", "run app")
    if r.out != "12\nfalse\n"
        or not slurp(lock).contains("dep geo git {url} tag v1 commit {first}\n")
        self.red("git dep first run", "{r.out}{r.err}\n{slurp(lock)}")
    cached := "{dir}/home/deps/geo-{first}"
    # Windows keeps no write bits in the file mode, so only the `.git` half is checked there.
    writable := (env.get("OS") else "") != "Windows_NT"
        and sh_run("test -z \"$(find {cached}/geo.ail -perm -u+w)\"").status != 0
    if fs.exists("{cached}/.git") or writable
        self.red("git dep cache", "cache files must be read-only and have no .git")
    # A moved tag changes nothing while the lock pins the commit.
    second := gd_commit(dir, url, "w * h + 1", "v1")
    if gd_ail(dir, dir, "", "run app").out != "12\nfalse\n"
        self.red("git dep locked", "the moved tag changed the run")
    # mod.pkg.9: `ail pkg update geo` locks what the tag names now.
    u := gd_ail(dir, "{dir}/app", "", "pkg update geo")
    if u.out != "locked geo {second}\n"
        self.red("git dep update", "{u.out}{u.err}")
    if gd_ail(dir, dir, "", "run app").out != "13\nfalse\n" or not slurp(lock).contains(second)
        self.red("git dep after update", slurp(lock))
    if gd_ail(dir, dir, "", "run --deterministic app").out != "13\nfalse\n"
        self.red("git dep --deterministic", "differs")
    # mod.pkg.8: a manifest that no longer matches the lock is stale.
    gd_manifest(dir, url, "rev {first} caps fs")
    st := gd_ail(dir, dir, "", "run --deterministic app")
    if st.status != 2
        or not st.err.contains("error[mod.pkg.8]")
        or not st.err.contains("ail pkg update geo")
        or not slurp(lock).contains(second)
        self.red("git dep stale lock", "exit {st.status}\n{st.err}")
    rl := gd_ail(dir, dir, "", "run app")
    if rl.out != "12\nfalse\n" or not slurp(lock).contains("rev {first} commit {first}")
        self.red("git dep relock", "exit {rl.status}\n{rl.out}{rl.err}\n{slurp(lock)}")
    # eff.cap.4: grants apply to git dependencies as to path ones.
    gd_manifest(dir, url, "rev {first}")
    cp := gd_ail(dir, dir, "", "check app")
    self.want("git dep caps", cp.err, ["error[eff.cap.4]"])
    sh_run("chmod -R u+w {dir}; rm -rf {dir}")
    # fetch errors name the dependency.
    dir2 := gd_setup(tmp, "errors")
    url2 := file_url("{dir2}/remote.git")
    n := gd_ail(dir2, dir2, "", "check --deny net app")
    self.want(
        "git dep --deny net",
        n.err,
        ["error[mod.pkg.7]: dependency `geo` isn't in the cache"],
    )
    if fs.exists("{dir2}/app/ail.lock")
        self.red("git dep --deny net", "wrote a lock")
    gd_manifest(dir2, url2, "tag v9 caps fs")
    t := gd_ail(dir2, dir2, "", "run app")
    self.want("git dep unknown tag", t.err, ["dependency `geo`", "has no tag `v9`"])
    if fs.exists("{dir2}/app/ail.lock")
        self.red("git dep unknown tag", "a failed fetch wrote a lock")
    fs.write_text(
        "{dir2}/app/ail.pkg",
        "package app\ndep geo git \"file:///no/such/repo.git\" tag v1\n",
    ) else return
    ur := gd_ail(dir2, dir2, "", "run app")
    self.want("git dep unreachable", ur.err, ["error[mod.pkg.7]: can't fetch dependency `geo`"])
    gd_manifest(dir2, url2, "tag v1 caps fs")
    # A PATH without git: the shell tools `./ail` itself uses are linked in, git is not.
    # Windows has no `./ail` script to run on such a PATH.
    if (env.get("OS") else "") != "Windows_NT"
        sh_run("mkdir -p {dir2}/empty; for c in bash dirname uname sed cat mkdir rm mv cp ls tr head tail grep awk env; do p=$(command -v $c) && ln -sf $p {dir2}/empty/$c; done")
        ng := gd_ail(dir2, dir2, "{dir2}/empty", "run app")
        self.want(
            "git dep no git",
            ng.err,
            ["error[mod.pkg.7]: can't run `git` to fetch dependency `geo`"],
        )
    nu := gd_ail(dir2, "{dir2}/app", "", "pkg update nope")
    self.want("git dep update nope", nu.err, ["error[mod.pkg.9]"])
    sh_run("chmod -R u+w {dir2}; rm -rf {dir2}")

## `std.net` end to end (net.rs, ported; std.net.1-5, 13, 14): a loopback HTTP
## server (tools/gate/net_server.py) and `openssl s_server`, so no network.
## Starts `cmd` in the background and returns its pid once `port` accepts connections.
fn net_start(cmd str, port int) int
    r := sh_run("{cmd} </dev/null >/dev/null 2>&1 & echo $!")
    pid := r.out.trim().to_int() else return 0
    for _ in 0..100
        probe := sh_run("python3 -I -c \"import socket; socket.create_connection(('127.0.0.1', {port}), 1).close()\"")
        if probe.status == 0
            return pid
        sh_run("sleep 0.1")
    pid

fn net_stop(pid int)
    # On Windows (Git's sh) `kill` reaches only sh's own processes: the Windows pid is in /proc/PID/winpid.
    sh_run("kill {pid} 2>/dev/null; [ -r /proc/{pid}/winpid ] && taskkill //F //PID $(cat /proc/{pid}/winpid) >/dev/null 2>&1; true")

fn net_port(salt int) int
    r := proc.run("sh", ["-c", "echo $$"]) else return 20000 + salt
    20000 + ((r.out.trim().to_int() else 0) * 7 + salt * 131) % 10000

fn Gate.net(mut self)
    root := repo_root()
    port := net_port(1)
    pid := net_start("python3 -I tools/gate/net_server.py {port}", port)
    c := ail_run(["run", "tests/net/client.ail", "http://127.0.0.1:{port}"]) else return
    net_stop(pid)
    if c.status != 0 or c.out != slurp("tests/net/client.out")
        self.red("net client", "exit {c.status}\n{c.out}{c.err}")
    # eff.cap.1, std.net.1: `--deny net` and `--deterministic` refuse it.
    for flags in [["--deny", "net"], ["--deterministic"]]
        r := ail_run(cat(cat(["run"], flags), ["tests/net/client.ail"])) else return
        if r.status != 2 or not r.err.contains("eff.cap.1") or not r.err.contains("`net`")
            self.red("net is a capability {flags}", "exit {r.status}\n{r.err}")
    e := ail_run(["effects", "tests/net/client.ail"]) else return
    self.want("net effects", e.out, ["net"])
    # attach.cli.1-3: `ail attach` finds the program's socket from its discovery file, sends the token
    # and the query's fields, and prints the reply line.
    ad := "{repo_root()}/.gate-attach"
    sh_run("rm -rf {ad}; mkdir -p {ad}")
    aport := net_port(2)
    apid := net_start("python3 -I tools/gate/attach_server.py {aport} {ad}/req.txt", aport)
    fs.write_text(
        "{ad}/ail-attach-{aport}.json",
        "\{\"addr\":\"127.0.0.1:{aport}\",\"token\":\"tok\"}",
    ) else return
    at := sh_run("TMPDIR={ad} ./ail attach observe names=n,m since=2")
    net_stop(apid)
    req := slurp("{ad}/req.txt")
    if at.status != 0 or at.out != "\{\"v\":1,\"rev\":1,\"values\":\{}}\n"
        self.red("attach reply", "exit {at.status}\n{at.out}{at.err}")
    self.want("attach request", req, [
        "\"q\":\"observe\"",
        "\"token\":\"tok\"",
        "\"names\":[\"n\",\"m\"]",
        "\"since\":2",
    ])
    # attach.input.1-2: `input` sends its pairs as members; `kind` and `id` stay strings, `x` a number.
    apid2 := net_start("python3 -I tools/gate/attach_server.py {aport} {ad}/req.txt", aport)
    ip := sh_run("TMPDIR={ad} ./ail attach input kind=click id=cv x=3 y=4 shift=true")
    net_stop(apid2)
    self.want("attach input request", slurp("{ad}/req.txt"), [
        "\"q\":\"input\"",
        "\"kind\":\"click\"",
        "\"id\":\"cv\"",
        "\"x\":3",
        "\"shift\":true",
    ])
    if ip.status != 0
        self.red("attach input", "exit {ip.status}\n{ip.out}{ip.err}")
    nobody := sh_run("TMPDIR={ad}/nowhere ./ail attach")
    if nobody.status != 1 or not nobody.err.contains("no program publishes")
        self.red("attach none", "exit {nobody.status}\n{nobody.err}")
    bad := sh_run("TMPDIR={ad} ./ail attach set x=1")
    if bad.status != 2 or not bad.err.contains("the queries are observe, screen, heap and tools")
        self.red("attach unknown query", "exit {bad.status}\n{bad.err}")
    sh_run("rm -rf {ad}")
    # std.net.5, std.net.13: https and a raw TLS Conn against `openssl s_server`.
    v := sh_run("openssl version").out
    if not (v.starts_with("OpenSSL 3") or v.starts_with("OpenSSL 1.1.1"))
        print("net: openssl is `{v.trim()}`; skipping the TLS tests")
    else
        data := "{root}/tests/data/net/x509"
        tport := net_port(2)
        srv := "cd {data} && exec openssl s_server -quiet -www -tls1_3 -accept {tport} -key localhost_leaf.key.pem -cert localhost_leaf.pem -cert_chain inter.pem"
        spid := net_start("sh -c '{srv}'", tport)
        ok := "https://localhost:{tport}/"
        by_ip := "https://127.0.0.1:{tport}/"
        a := sh_run("SSL_CERT_FILE={data}/root.pem {root}/ail run tests/net/https.ail {ok} {by_ip}")
        if a.status != 0
            or a.out != "200 <HTML><BODY BGCOLOR=\"#ffffff\">\nnet.NetKind.Tls: the server's certificate isn't valid for `127.0.0.1`; it covers localhost\n"
            self.red("net https", "exit {a.status}\n{a.out}{a.err}")
        b := sh_run("SSL_CERT_FILE={data}/rsa_leaf.pem {root}/ail run tests/net/https.ail {ok}")
        if b.out
            != "net.NetKind.Tls: the certificate for `localhost` doesn't lead to a trusted root: it was issued by `AIL Test Intermediate`, which isn't in the system's root store\n"
            self.red("net https untrusted root", "{b.out}{b.err}")
        t := sh_run("SSL_CERT_FILE={data}/root.pem {root}/ail run tests/net/tls_conn.ail {tport}")
        if t.status != 0
            or t.out != "HTTP/1.0 200 ok\nnet.NetKind.Tls: the server's certificate isn't valid for `127.0.0.1`; it covers localhost\n"
            self.red("net tls conn", "exit {t.status}\n{t.out}{t.err}")
        net_stop(spid)
        sh_run("pkill -f 'openssl s_server.*{tport}' 2>/dev/null")
    # std.net.14: serving is a capability of its own, on top of `net`.
    program := "tests/cases/std_net_serve.ail"
    d := ail_run(["run", "--deny", "net.serve", program]) else return
    if d.status != 2 or not d.err.contains("eff.cap.1") or not d.err.contains("`net.serve`")
        self.red("net.serve capability", "exit {d.status}\n{d.err}")
    for args in [["check", "--deny", "net", program], ["check", "--deterministic", program]]
        x := ail_run(args) else return
        if x.status != 2
            self.red("net.serve denied by {args}", "exit {x.status}")
    k := ail_run(["check", "--deny", "net.serve", "tests/net/client.ail"]) else return
    if k.status != 0
        self.red("client-only program", k.err)
    ef := ail_run(["effects", program]) else return
    self.want("net.serve effects", ef.out, [
        "fn:main \{fail, io, net, net.serve, spawn}",
        "fn:worker \{fail, io, net}",
    ])

## The spec conformance harness (spec.rs, ported to tools/gate/spec.ail; ADR 0002).
fn Gate.spec(mut self)
    # A shard (`spec@K/N`) goes on to spec.ail, which checks the fences i % N == K.
    shard := if self.shard_count > 1 then ["{self.part}/{self.shard_count}"] else []
    r := proc.run("./ail", cat(["run", "tools/gate/spec.ail"], shard), "", 3600000) else
        self.red("spec", "could not start tools/gate/spec.ail")
        return
    for l in r.out.lines()
        if l.starts_with("SHARD ")
            print(l)
    if r.status != 0
        errl := r.err.lines()
        mut tail := List[str]()
        for i in 0..errl.len()
            if i < 8
                tail.push(errl[i])
        self.red("spec", "{r.out}\nspec.ail exit {r.status}; stderr:\n{tail.join("\n")}")

## The native runtime's tests, the refusals of ADR 0900, and the native subset table
## (native_runtime.rs, native_test.rs, native_subset_table.rs, ported).
fn owner_ok(owner str) bool
    if owner == "-"
        return true
    for part in owner.split(", ")
        mut digits := ""
        if part.starts_with("#")
            digits = part.slice(1, part.len())
        elif part.starts_with("lane ")
            digits = part.slice(5, part.len())
        if digits.is_empty()
            return false
        for c in digits.chars()
            if not (c.is_digit() and c.code() < 128)
                return false
    true

## ported to tools/gate/nativex.ail (B6). It prints only
## failures and ends with `NATIVEX GREEN` or `NATIVEX RED`.
## Native-only features (ADR 0865) build here, so nativex runs on `./ail` with no AIL_BINARY.
fn Gate.nativex(mut self)
    # `nativex@K/N`: one shard, one process (the gate's pool supplies the parallelism); see nativex.ail.
    shard := if self.shard_count > 1 then " --shard {self.part}/{self.shard_count}" else ""
    r := proc.run("sh", [
        "-c",
        "unset AIL_BINARY; exec \"$PWD/ail\" run tools/gate/nativex.ail{shard}",
    ]) else
        self.red("nativex", "could not start tools/gate/nativex.ail")
        return
    for l in r.out.lines()
        if l.starts_with("SHARD ")
            print(l)
    if r.status != 0 or not r.out.contains("NATIVEX GREEN")
        self.red("nativex", "{r.out}{r.err}")

## ported to tools/gate/globals.ail (B6).
fn Gate.globals(mut self)
    r := ail_run(["run", "tools/gate/globals.ail"]) else
        self.red("globals", "could not start tools/gate/globals.ail")
        return
    if r.status != 0 or not r.out.contains("GLOBALS GREEN")
        self.red("globals", "{r.out}{r.err}")

## ported to tools/gate/pe.ail (B6).
fn Gate.pe(mut self)
    r := ail_run(["run", "tools/gate/pe.ail"]) else
        self.red("pe", "could not start tools/gate/pe.ail")
        return
    if r.status != 0 or not r.out.contains("PE GREEN")
        self.red("pe", "{r.out}{r.err}")

## ported to tools/gate/asm.ail (B6).
fn Gate.asm(mut self)
    r := ail_run(["run", "tools/gate/asm.ail"]) else
        self.red("asm", "could not start tools/gate/asm.ail")
        return
    if r.status != 0 or not r.out.contains("ASM GREEN")
        self.red("asm", "{r.out}{r.err}")

fn Gate.native_misc(mut self)
    r := ail_run(["test", "compiler/rt/rt.ail"]) else return
    if r.status != 0 or not r.out.contains(" 0 failed")
        self.red("native runtime tests", "{r.out}{r.err}")
    mixed := "tests/native_test/mixed.ail"
    # ADR 0900: `test --native` is refused; `ail test` runs the same tests natively.
    n := native_run(["test", "--native", mixed]) else return
    if n.status != 2 or not n.err.contains("ADR 0900")
        self.red("test --native refusal", "exit {n.status}\n{n.out}{n.err}")
    nt := native_run(["test", mixed]) else return
    self.want("test mixed", nt.out, ["adds", "fails_on_purpose", "uses_defer"])
    # test.stub.1-6 (ADR 1101): every stub works in a test run.
    sb := native_run(["test", "tests/native_test/stubs.ail"]) else return
    if sb.status != 0 or not sb.out.contains(" 0 failed")
        self.red("std.test stubs", "exit {sb.status}\n{sb.out}{sb.err}")
    st := native_run(["selftest", "--test", "x"]) else return
    if st.status != 2 or not st.err.contains("ADR 0900")
        self.red("selftest --test refusal", "exit {st.status}\n{st.out}{st.err}")
    # ADR 0746: every row of the table has a construct, a wording and an owner.
    mut rows := List[List[str]]()
    for l in slurp("docs/design/native-subset-constructs.md").lines()
        if l.starts_with("|")
            cells := l.trim().split("|")
            mut row := List[str]()
            for i in 1..cells.len() - 1
                row.push(cells[i].trim())
            if row.len() == 3 and row[0] != "Construct" and not row[0].starts_with("---")
                rows.push(row)
    if rows.len() < 10
        self.red("native subset table", "the table has {rows.len()} rows")
    mut text := slurp("docs/design/native-coverage.md").replace("`", "")
    for f in fs.glob("compiler/**/*.ail")
        text = "{text}{slurp(f).replace("`", "")}"
    for row in rows
        if not owner_ok(row[2])
            self.red("native subset table", "bad owner `{row[2]}` for `{row[0]}`")
        if not text.contains(row[1])
            self.red("native subset table", "wording `{row[1]}` for `{row[0]}` is in no diagnostic")

## The `std` suite (ported from std_sources.rs and std_call_gate.rs): the AIL std sources check and format
## cleanly, a program importing every module checks, and every public std
## function is called by a test, a corpus program or an example (std.use.1).
## (file, function, why no case calls it); an entry that is now called fails
## too, so the list only shrinks.
STD_UNTESTABLE := [
    ["term/term.ail", "poll", "it waits on a terminal's keyboard; the gate has no terminal"],
    ["time/date.ail", "now_local", "its value is the clock in the machine's zone"],
    ["attach/serve.ail", "run", "it serves until its window closes; attach_watched covers the wire"],
    [
        "attach/serve.ail",
        "run_with",
        "only the `ail run` shim calls it by name (attach.run.1); attach_run_with runs it through the shim",
    ],
    [
        "gfx/watch.ail",
        "run",
        "it serves the attach socket and opens a window until it closes; std_gfx_attach covers its loop",
    ],
    [
        "gfx/host.ail",
        "run",
        "it opens a window and runs until it closes; the std-gfx.md norun example covers the types",
    ],
    ["audio/device.ail", "play", "it plays through the sound hardware, which a headless case lacks"],
    ["audio/device.ail", "record", "it records from the microphone, which a headless case lacks"],
    ["net/http.ail", "serve_dir", "it serves until the program stops, so a case cannot end it"],
]

## Modules only `ail build` reads (ADR 0819).
STD_NATIVE_ONLY := ["regex/regex.ail"]

fn is_word(c char) bool
    c.is_alnum() or c == '_'

## Whether `text` holds `needle` not preceded by a word character.
fn has_call(text str, needle str) bool
    mut from := 0
    while from <= text.len()
        rest := text.slice(from, text.len())
        at := rest.find(needle) else return false
        i := from + at
        if i == 0 or not is_word(text.char_at(i - 1) else ' ')
            return true
        from = i + 1
    false

## Every file below `dir` whose name ends in one of `exts`, sorted, with `/` separators (std.fs.8). Done in AIL
## because `find` and `sort` on Windows are other programs.
fn walk_ext(dir str, exts List[str]) List[str]
    all := fs.walk(dir) else []
    mut out := []
    for p in all
        path := p.replace("\\", "/")
        for e in exts
            if path.ends_with(e)
                out.push(path)
                break
    out.sort()
    out

fn Gate.std(mut self, tmp str)
    root := "std"
    prefix := "{root}/"
    mut files := []
    for p in walk_ext(root, [".ail"])
        files.push(if p.starts_with(prefix) then p.slice(prefix.len(), p.len()) else p)
    if files.is_empty()
        self.red("std", "no std files found: the listing is broken")
        return
    for n in STD_NATIVE_ONLY
        r := sh_run("./ail check {root}/{n} 2>&1 | grep 'error\\[' | grep -v 'mod.main.1'")
        if not r.out.is_empty()
            self.red("std native-only {n}", r.out)
    mut uses := ""
    for f in files
        if f == "types.ail" or STD_NATIVE_ONLY.contains(f)
            continue
        parts := f.slice(0, f.len() - 4).split("/")
        stem := parts[parts.len() - 1]
        dotted := if parts.len() == 2 and parts[0] == stem then stem else parts.join(".")
        uses = "{uses}use std.{dotted}\n"
    dir := "{tmp}/std"
    fs.make_dir(dir) else return
    fs.write_text("{dir}/all_std.ail", "{uses}\nfn main()\n    print(1)\n") else return
    chk := proc.run("./ail", ["check", "{dir}/all_std.ail"]) else return
    if chk.status != 0 or "{chk.out}{chk.err}".contains("error[")
        self.red("std modules import", "{chk.out}{chk.err}")
    m := proc.run("./ail", ["fmt", "--check", root]) else return
    if m.status != 0
        self.red("std layout", "run `./ail fmt {root}`: {m.out}{m.err}")
    # Callers: tests, the token corpus and the examples.
    mut callers := ""
    for d in ["tests", "tools/tokbench/corpus", "examples"]
        for f in walk_ext(d, [".ail", ".rs", ".test"])
            callers = "{callers}{slurp(f)}\n"
    mut seen := 0
    for f in files
        stem := f.slice(0, f.len() - 4).split("/").last() else ""
        parent := if f.contains("/") then (f.split("/").first() else "") else ""
        for line in slurp("{root}/{f}").lines()
            if not line.starts_with("pub fn ")
                continue
            rest := line.slice(7, line.len())
            mut head := ""
            for ch in rest.chars()
                if is_word(ch) or ch == '.'
                    head = "{head}{ch}"
                else
                    break
            mut name := head
            mut calls := ["{stem}.{head}(", "{parent}.{head}("]
            if dot := head.find(".")
                name = head.slice(dot + 1, head.len())
                calls = [".{name}("]
            seen += 1
            mut called := false
            for call in calls
                if has_call(callers, call) or (call.starts_with(".") and callers.contains(call))
                    called = true
            mut listed := false
            for u in STD_UNTESTABLE
                if u[0] == f and u[1] == name
                    listed = true
            if not called and not listed
                self.red(
                    "std call gate",
                    "{f}: {name} is called by no test (add a case, or a STD_UNTESTABLE entry)",
                )
            if called and listed
                self.red(
                    "std call gate",
                    "{f}: {name} is called now; remove it from STD_UNTESTABLE",
                )
    if seen <= 50
        self.red("std call gate", "found only {seen} public std functions: the scan is broken")

## ail run --deterministic, --schedule and --seed on the native runtime (conc.sched.1-3, eff.det.1-3,
## ADRs 0186, 0207, 0322, 0873): sched.ail runs tasks one at a time.
fn native_run(args List[str]) proc.Output ! proc.ProcError
    proc.run("./ail", args, "", 600000)

fn Gate.sched(mut self)
    # conc.sched.3: a fixed order that repeats and matches the expected output.
    order := "tests/sched/order.ail"
    first := native_run(["run", "--deterministic", order]) else return
    if first.status != 0 or first.out != slurp("tests/sched/order.out")
        self.red("--deterministic order", "exit {first.status}\n{first.out}{first.err}")
    for _ in 0..2
        again := native_run(["run", "--deterministic", order]) else return
        if again.out != first.out
            self.red("--deterministic repeat", again.out)
    fixed := native_run(["run", "--schedule=fixed", order]) else return
    if fixed.out != first.out
        self.red("--schedule=fixed", fixed.out)
    # conc.sched.1: a seed replays, and different seeds find a lost update that seed 1 does not.
    race := "tests/schedule/race.ail"
    fail_seed := "2"
    bad := native_run(["test", "--json", "--schedule=random:{fail_seed}", race]) else return
    if bad.status != 1
        or not bad.out.contains("left is 1, right is 2")
        or not bad.out.ends_with("\{\"summary\":true,\"passed\":0,\"failed\":1,\"schedule_seed\":{fail_seed}}\n")
        self.red("schedule seed {fail_seed}", "exit {bad.status}\n{bad.out}")
    for _ in 0..2
        again := native_run(["test", "--json", "--schedule=random:{fail_seed}", race]) else return
        if again.out != bad.out
            self.red("schedule replay", again.out)
    passed := native_run(["test", "--json", "--schedule=random:1", race]) else return
    if passed.status != 0
        or not passed.out.ends_with("\{\"summary\":true,\"passed\":1,\"failed\":0}\n")
        self.red("schedule seed 1", "exit {passed.status}\n{passed.out}")
    human := native_run(["test", "--schedule=random:{fail_seed}", race]) else return
    self.want(
        "schedule prints the seed",
        human.out,
        ["schedule seed {fail_seed}: replay with `ail test --schedule=random:{fail_seed} "],
    )
    nonsense := native_run(["test", "--schedule=sometimes", race]) else return
    if nonsense.status != 2
        self.red("schedule sometimes", "exit {nonsense.status}, want 2")
    # conc.cancel.3-4, conc.atomic.7: cancel trees pass every seed.
    for seed in 1..9
        x := native_run([
            "test",
            "--schedule=random:{seed}",
            "tests/schedule/cancel.ail",
        ]) else return
        if x.status != 0 or not x.out.ends_with("4 passed, 0 failed\n")
            self.red("schedule cancel seed {seed}", x.out)
    # conc.task.7: a deadlock still traps, from any task that finds it.
    for case in ["conc_deadlock", "conc_for_channel_deadlock"]
        d := native_run(["run", "--deterministic", "tests/cases/{case}.ail"]) else return
        if d.status != 1 or not d.err.contains("trap[conc.task.7]")
            self.red("deterministic {case}", "exit {d.status}\n{d.err}")
    # std.random.3, eff.det.3: --seed repeats; eff.det.1-2: --deterministic denies clock, proc, random.
    unseeded := "tests/deterministic/unseeded.ail"
    s11 := native_run(["run", "--seed", "11", unseeded]) else return
    s11b := native_run(["run", "--seed", "11", unseeded]) else return
    s12 := native_run(["run", "--seed", "12", unseeded]) else return
    if s11.status != 0 or s11.out != s11b.out or s11.out == s12.out
        self.red("--seed repeats", "{s11.out}|{s11b.out}|{s12.out}\n{s11.err}")
    for program in [unseeded, "tests/deterministic/clock.ail", "tests/deterministic/proc.ail"]
        e := native_run(["run", "--deterministic", program]) else return
        if e.status != 2 or not e.err.contains("eff.cap.1")
            self.red("--deterministic {program}", "exit {e.status}\n{e.err}")
    sx := native_run(["run", "--seed", "x", unseeded]) else return
    if sx.status != 2 or not sx.err.contains("std.random.3")
        self.red("--seed x", "exit {sx.status}\n{sx.err}")

## ---- agent_tools: the commands an AI agent drives (ADRs 0921, 0966, 0967, 0969, 1015, 1020, 1022, 1023)

## `ail ARGS` in `d`: the exit status must be `status` and the output (out then err) must hold every want.
fn Gate.tool(mut self, label str, d str, args List[str], status int, wants List[str]) proc.Output
    r := ail_in(repo_root(), d, args)
    text := "{r.out}{r.err}"
    if r.status != status
        self.red(label, "exit {r.status}, want {status}\n{text}")
    else
        self.want(label, text, wants)
    r

fn src_of(ls List[str]) str
    "{ls.join("\n")}\n"

## A JSON message written with `'` for `"`, `~` for `{` and `^` for `}`.
fn jm(s str) str
    s.replace("'", "\"").replace("~", "\{").replace("^", "}")

fn jreq(id int, method str, params str) str
    jm("~'jsonrpc':'2.0','id':{id},'method':'{method}','params':{params}^")

fn jnote(method str, params str) str
    jm("~'jsonrpc':'2.0','method':'{method}','params':{params}^")

fn lsp_frame(body str) str
    "Content-Length: {body.byte_len()}\r\n\r\n{body}"

fn lsp_pos(uri str, line int, ch int) str
    "~'textDocument':~'uri':'{uri}'^,'position':~'line':{line},'character':{ch}^^"

## One `ail lsp` session in `d`: the messages in order, then `shutdown` and `exit`. Returns the server's frames.
fn lsp_session(d str, uri str, text str, msgs List[str]) proc.Output
    escaped := text.replace("\n", "\\n")
    mut all := [
        jreq(1, "initialize", "~'processId':null,'rootUri':null,'capabilities':~^^"),
        jnote("initialized", "~^"),
        jnote(
            "textDocument/didOpen",
            "~'textDocument':~'uri':'{uri}','languageId':'ail','version':1,'text':'{escaped}'^^",
        ),
    ]
    all.extend(msgs)
    all.push(jreq(90, "shutdown", "null"))
    all.push(jnote("exit", "null"))
    mut input := ""
    for m in all
        input = "{input}{lsp_frame(m)}"
    script := "cd \"$0\" && AIL=\"$1\" exec \"$1\" lsp"
    r := proc.run(
        "sh",
        ["-c", script, d, "{repo_root()}/ail"],
        input,
    ) else return proc.Output(status: 127, out: "", err: "could not start sh")
    r

## One `ail mcp` session in `d`: the requests in order, one per line. Returns the server's lines.
fn mcp_session(d str, msgs List[str]) proc.Output
    mut input := ""
    for m in msgs
        input = "{input}{m}\n"
    script := "cd \"$0\" && AIL=\"$1\" exec \"$1\" mcp"
    r := proc.run(
        "sh",
        ["-c", script, d, "{repo_root()}/ail"],
        input,
    ) else return proc.Output(status: 127, out: "", err: "could not start sh")
    r

## The line of an MCP session's output that answers request `id`, or "".
fn reply_of(out str, id int) str
    for line in out.lines()
        if line.contains("\"id\":{id},")
            return line
    ""

fn mcp_call(id int, name str, args str) str
    jreq(id, "tools/call", "~'name':'{name}','arguments':~{args}^^")

## ---- cert: `ail verify --diff --attest` and `--check` (ADR 1052, verify.cert.1-4)

fn Gate.cert(mut self, tmp str)
    base := "{tmp}/cert"
    sh_run("rm -rf {base}; mkdir -p {base}")
    git := "git -c user.name=gate -c user.email=gate@example.com"
    fs.write_text("{base}/prog.ail", src_of([
        "fn sign(n int) int",
        "    if n > 0",
        "        return 1",
        "    0",
        "",
        "@test fn positive()",
        "    assert(sign(5) == 1)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    sh_run("cd {base} && git init -q . && git add prog.ail && {git} commit -q -m base")
    fs.write_text("{base}/prog.ail", src_of([
        "fn sign(n int) int",
        "    if n > 0",
        "        return 1",
        "    if n < 0",
        "        return -1",
        "    0",
        "",
        "@test fn positive()",
        "    assert(sign(5) == 1)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    self.tool(
        "attest",
        base,
        ["verify", "--diff", "--mutate", "--attest", "cert.json", "prog.ail"],
        0,
        [],
    )
    doc := fs.read_text("{base}/cert.json") else
        self.red("cert", "no certificate written")
        return
    self.want("cert members", doc, [
        "\"cert\":2",
        "\"base\":\"",
        "\"env\":",
        "\"inputs\":",
        "\"static\":\"ok\"",
        "\"contracts\":",
        "\"state\":\"passed\"",
        "\"hash\":\"",
        "\"compiler\":\"ail ",
        "\"mutation\":",
        "\"survivors_in_changed\":",
    ])
    self.tool("check holds", base, ["verify", "--check", "cert.json"], 0, ["certificate holds"])
    # verify.cert.3: whatever the certificate was made from changes, the re-run differs in that member.
    good := slurp("{base}/prog.ail")
    # a source file
    fs.write_text("{base}/prog.ail", good.replace("return -1", "return -2")) else return
    self.cert_differs("cert: source changed", base, "", "files")
    # a test
    fs.write_text("{base}/prog.ail", good.replace("sign(5) == 1", "sign(6) == 1")) else return
    self.cert_differs("cert: test changed", base, "", "files")
    fs.write_text("{base}/prog.ail", good) else return
    # a dependency or configuration file, even one git does not track
    fs.write_text("{base}/ail.lock", "") else return
    self.cert_differs("cert: lock added", base, "", "inputs")
    sh_run("rm -f {base}/ail.lock")
    # the compiler version
    sh_run("cd {base} && sed 's/\"compiler\":\"ail [^\"]*\"/\"compiler\":\"ail 0.0.0 (older, native)\"/' cert.json > {tmp}/cert-compiler.json")
    self.cert_differs_on("cert: compiler version", base, "", "compiler", "{tmp}/cert-compiler.json")
    # the environment: run-time settings
    self.cert_differs("cert: AIL_THREADS", base, "AIL_THREADS=2", "env")
    self.cert_differs("cert: AIL_TIMEOUT_MS", base, "AIL_TIMEOUT_MS=600000", "env")
    # the base revision: a certificate edited to name another commit no longer reproduces
    self.tool(
        "cert: restored holds",
        base,
        ["verify", "--check", "cert.json"],
        0,
        ["certificate holds"],
    )
    sh_run("cd {base} && {git} commit -q -am change")
    self.tool(
        "cert: committing the change keeps it",
        base,
        ["verify", "--check", "cert.json"],
        0,
        ["certificate holds"],
    )
    head := sh_run("cd {base} && git rev-parse HEAD").out.trim()
    sh_run("cd {base} && sed 's/\"base\":\"[0-9a-f]*\"/\"base\":\"{head}\"/' cert.json > {tmp}/cert-other.json")
    self.cert_differs_on("cert: base changed", base, "", "files", "{tmp}/cert-other.json")
    # a version 1 certificate is refused with its reason
    sh_run("cd {base} && sed 's/\"cert\":2/\"cert\":1/' cert.json > {tmp}/cert-old.json")
    self.tool(
        "cert: version 1",
        base,
        ["verify", "--check", "{tmp}/cert-old.json"],
        2,
        ["version 1 certificate"],
    )
    # verify.run.2-6: the report names its evidence
    fs.write_text("{base}/prog.ail", good.replace("sign(5) == 1", "sign(5) == 2")) else return
    self.tool(
        "verify: failed test state",
        base,
        ["verify", "--diff", "--json", "prog.ail"],
        1,
        ["\"verify\":2", "\"static\":\"ok\"", "\"contracts\":", "\"state\":\"failed\""],
    )
    fs.write_text("{base}/prog.ail", good.replace("fn sign", "fn sign_")) else return
    self.tool(
        "verify: check errors are not tested",
        base,
        ["verify", "--diff", "--json", "prog.ail"],
        1,
        ["\"static\":\"errors\"", "\"state\":\"not-tested\"", "\"status\":\"unavailable\""],
    )
    self.tool("check missing", base, ["verify", "--check", "nosuch.json"], 2, ["can't read"])
    # api.impact.4, verify.run.4: a test that changed together with the function it calls still reaches it.
    fs.write_text(
        "{base}/prog.ail",
        good.replace("return -1", "return -3").replace("sign(5) == 1", "sign(6) == 1"),
    ) else return
    # `verify` lists unverified declarations; the per-test `reaches` is in `ail ask --affected`.
    self.tool(
        "impact: changed test and callee",
        base,
        ["ask", "prog.ail", "--affected", "--rev", "HEAD", "--json"],
        0,
        ["\"reaches\":\{\"positive\":[\"fn:positive\",\"fn:sign\"]}"],
    )
    ver := sh_run("cd {base} && AIL={repo_root()}/ail {repo_root()}/ail verify --diff prog.ail")
    if "{ver.out}{ver.err}".contains("no test reaches fn:sign")
        self.red("verify: changed test and callee", "fn:sign reported untested\n{ver.out}{ver.err}")

## `ail verify --check` run in `dir` with `pre` (`NAME=VALUE`) in front, on `cert`: it exits 1 and names `key` as differing.
fn Gate.cert_differs(mut self, label str, dir str, pre str, key str)
    self.cert_differs_on(label, dir, pre, key, "cert.json")

fn Gate.cert_differs_on(mut self, label str, dir str, pre str, key str, cert str)
    r := sh_run("cd {dir} && AIL={repo_root()}/ail {pre} {repo_root()}/ail verify --check {cert}")
    self.want(label, "{r.out}{r.err}", ["differs: {key}"])
    if r.status != 1
        self.red(label, "exit {r.status}, want 1")

## ---- try: `ail try` (ADR 0893, try.*), several patch sets in one call on scratch copies

fn Gate.try_cmd(mut self, tmp str)
    d := "{tmp}/try"
    sh_run("rm -rf {d}; mkdir -p {d}")
    prog := src_of([
        "fn add(a int, b int) int",
        "    a + b",
        "@test fn adds()",
        "    assert_eq(add(1, 2), 3)",
        "fn main()",
        "    print(add(1, 2))",
    ])
    fs.write_text("{d}/p.ail", prog) else return
    good := "[\{\"op\":\"replace_body\",\"id\":\"fn:add\",\"body\":\"a + b + 0\"}]"
    broken := "[\{\"op\":\"replace_body\",\"id\":\"fn:add\",\"body\":\"a + nope\"}]"
    wrong := "[\{\"op\":\"replace_body\",\"id\":\"fn:add\",\"body\":\"a - b\"}]"
    nowhere := "[\{\"op\":\"delete\",\"id\":\"fn:missing\"}]"
    fs.write_text("{d}/good.json", good) else return
    fs.write_text("{d}/broken.json", broken) else return
    fs.write_text("{d}/wrong.json", wrong) else return
    fs.write_text("{d}/nowhere.json", nowhere) else return
    # try.in.1, try.run.1, try.verdict.1-4: one line per set, nothing on disk changes, status 1 when any set is not clean.
    res := self.tool(
        "try sets",
        d,
        [
            "try",
            "p.ail",
            "--set",
            "good.json",
            "--set",
            "broken.json",
            "--set",
            "wrong.json",
            "--set",
            "nowhere.json",
        ],
        1,
        [
            "set good.json: check ok; tests 1 passed, 0 failed; patch ~",
            "set broken.json: check 1 error; tests skipped; patch ~",
            "error[expr.name.1]",
            "set wrong.json: check ok; tests 0 passed, 1 failed; patch ~",
            "FAIL adds",
            "set nowhere.json: patch does not apply; check and tests skipped; patch ~",
        ],
    )
    if slurp("{d}/p.ail") != prog
        self.red("try writes nothing", "p.ail changed\n{res.out}")
    left := sh_run("test -e {d}/.ail/try/0 && echo left")
    if left.out.contains("left")
        self.red("try removes its copies", "{d}/.ail/try/0 is still there")
    # try.in.1: one set on standard input; try.verdict.4: status 0 when clean.
    one := sh_run("cd {d} && AIL=\"{repo_root()}/ail\" \"{repo_root()}/ail\" try p.ail < good.json")
    if one.status != 0
        self.red("try stdin", "exit {one.status}\n{one.out}{one.err}")
    else
        self.want("try stdin", one.out, ["set stdin: check ok; tests 1 passed, 0 failed"])
    # try.run.1: `ail try .` from inside a directory program; the copy leaves out the `.ail` scratch.
    sh_run("mkdir -p {d}/pkg")
    fs.write_text("{d}/pkg/main.ail", prog) else return
    fs.write_text("{d}/pkg/good.json", good) else return
    self.tool(
        "try directory",
        "{d}/pkg",
        ["try", ".", "--set", "good.json"],
        0,
        ["check ok; tests 1 passed"],
    )
    # try.apply.1: a clean set is written, a red one and several sets are not.
    self.tool(
        "try apply refuses red",
        d,
        ["try", "p.ail", "--set", "wrong.json", "--apply"],
        1,
        ["not applied"],
    )
    if slurp("{d}/p.ail") != prog
        self.red("try apply refuses red", "p.ail changed")
    self.tool(
        "try apply wants one",
        d,
        ["try", "p.ail", "--set", "good.json", "--set", "wrong.json", "--apply"],
        2,
        ["try.apply.1"],
    )
    self.tool(
        "try apply",
        d,
        ["try", "p.ail", "--set", "good.json", "--apply"],
        0,
        ["applied to p.ail"],
    )
    if not slurp("{d}/p.ail").contains("a + b + 0")
        self.red("try apply writes", "p.ail lacks the patch\n{slurp("{d}/p.ail")}")

fn Gate.agent_tools(mut self, tmp str)
    # api.find.2, api.find.8: `ail ask std` indexes every std `pub fn`, and each synonym row answers.
    std_index := ["run", "tests/std_index/check.ail"]
    self.tool("std index", repo_root(), std_index, 0, ["std index GREEN"])
    base := "{tmp}/agent_tools"
    sh_run("rm -rf {base}; mkdir -p {base}/ctx {base}/infer {base}/probe {base}/san {base}/leak {base}/fuzz {base}/fuzz2 {base}/mut {base}/mut2 {base}/lsp1 {base}/lsp2 {base}/lsp3 {base}/mcp")
    # task.log.1, fix.check.1-2 (ADRs 1047, 1048): verify --fix repairs, and the ledger line is the same on a rerun but for `ms`.
    sh_run("mkdir -p {base}/ledger && cp -R {repo_root()}/tests/cases/packages/task_fix/. {base}/ledger/")
    self.tool(
        "verify --fix",
        "{base}/ledger",
        ["task", "verify", "--fix"],
        1,
        ["fixed 1: expr.op.1"],
    )
    first := slurp("{base}/ledger/.ail/task-log.jsonl")
    for piece in ["\"stage\":\"check\",\"result\":\"red\"", "\"fixed\":1", "\"expr.name.1\":1"]
        if not first.contains(piece)
            self.red("task ledger line", "no {piece}\n{first}")
    if slurp("{base}/ledger/main.ail").contains("&&")
        self.red("check --fix", "the file still has `&&`")
    sh_run("cd {base}/ledger && rm -rf .ail && printf 'fn main()\\n    a := true\\n    b := false\\n    if a && b\\n        print(undefined_name)\\n' > main.ail")
    self.tool(
        "verify --fix again",
        "{base}/ledger",
        ["task", "verify", "--fix"],
        1,
        ["fixed 1: expr.op.1"],
    )
    second := slurp("{base}/ledger/.ail/task-log.jsonl")
    if first.split(",\"ms\":")[0] != second.split(",\"ms\":")[0]
        self.red("task ledger is stable", "two runs differ\n{first}{second}")
    # task.finish.3 (ADR 1046): `finish` writes the change certificate and names it.
    sh_run("mkdir -p {base}/cert")
    fs.write_text("{base}/cert/main.ail", "fn main()\n    print(1)\n") else return
    sh_run("cd {base}/cert && git init -q && git add -A && git -c user.name=g -c user.email=g@g commit -qm seed")
    self.tool(
        "task start for finish",
        "{base}/cert",
        ["task", "start", "main.ail", "print", "two"],
        0,
        ["task open"],
    )
    fs.write_text("{base}/cert/main.ail", "fn main()\n    print(2)\n") else return
    self.tool("task verify for finish", "{base}/cert", ["task", "verify"], 0, ["green"])
    self.tool(
        "task finish certificate",
        "{base}/cert",
        ["task", "finish", "--json"],
        0,
        ["\"certificate\":\".ail/cert.json\""],
    )
    self.want(
        "task finish writes the certificate",
        slurp("{base}/cert/.ail/cert.json"),
        ["\"cert\"", "main.ail"],
    )
    if fs.exists("{base}/cert/.ail-task")
        self.red("task finish", "the task is still open")
    # api.ctx.1-7 (ADR 1020)
    ctx := src_of([
        "fn show(n int) str",
        "    \"\{n}\"",
        "fn pay(n int) str",
        "    show(n)",
        "@test fn pays()",
        "    assert_eq(pay(1), \"1\")",
        "fn main()",
        "    print(pay(1))",
    ])
    fs.write_text("{base}/ctx/prog.ail", ctx) else return
    full := self.tool("context", "{base}/ctx", ["context", "prog.ail", "pay"], 0, [
        "signature",
        "callees",
        "show",
        "callers",
        "main",
        "tests",
        "pays",
    ])
    if full.out.contains("cut:")
        self.red("context full pack", "a default budget cut a tiny program\n{full.out}")
    again := ail_in(repo_root(), "{base}/ctx", ["context", "prog.ail", "fn:pay"])
    if again.out != full.out
        self.red("context is deterministic", "`fn:pay` and `pay` differ\n{again.out}")
    self.tool(
        "context budget",
        "{base}/ctx",
        ["context", "prog.ail", "pay", "--budget", "1"],
        0,
        ["cut:", "--budget"],
    )
    self.tool(
        "context json",
        "{base}/ctx",
        ["context", "prog.ail", "pay", "--budget", "1", "--json"],
        0,
        ["\"target\":\"fn:pay\"", "\"cut\":"],
    )
    self.tool(
        "context unknown symbol",
        "{base}/ctx",
        ["context", "prog.ail", "nosuch"],
        2,
        ["api.ctx.6"],
    )
    self.tool(
        "context zero budget",
        "{base}/ctx",
        ["context", "prog.ail", "pay", "--budget", "0"],
        2,
        ["positive"],
    )
    # infer.cand.1-6, infer.out.1-4 (ADR 1023)
    infer := src_of([
        "fn pay(n int) int",
        "    n + 1",
        "@test fn pays()",
        "    for i in 1..30",
        "        assert_eq(pay(i), i + 1)",
        "fn main()",
        "    print(pay(1))",
    ])
    fs.write_text("{base}/infer/prog.ail", infer) else return
    self.tool(
        "infer proposes",
        "{base}/infer",
        ["infer", "--contracts", "pay", "prog.ail"],
        0,
        ["requires n > 0", "proved"],
    )
    self.tool(
        "infer json",
        "{base}/infer",
        ["infer", "--contracts", "pay", "prog.ail", "--json"],
        0,
        ["\"kind\":\"requires\"", "\"cond\":\"n > 0\"", "\"applied\":false"],
    )
    if slurp("{base}/infer/prog.ail") != infer
        self.red("infer without --apply", "wrote the file")
    self.tool(
        "infer min",
        "{base}/infer",
        ["infer", "--contracts", "pay", "prog.ail", "--min", "100"],
        0,
        ["needed"],
    )
    self.tool(
        "infer bad function",
        "{base}/infer",
        ["infer", "--contracts", "nosuch", "prog.ail"],
        2,
        ["infer.cand.1"],
    )
    self.tool(
        "infer apply",
        "{base}/infer",
        ["infer", "--contracts", "pay", "prog.ail", "--apply"],
        0,
        ["edited"],
    )
    applied := slurp("{base}/infer/prog.ail")
    if not applied.contains("requires n > 0")
        self.red("infer --apply", "the file has no `requires n > 0`:\n{applied}")
    self.tool("infer applied file checks", "{base}/infer", ["check", "prog.ail"], 0, [""])
    self.tool("infer applied file tests", "{base}/infer", ["test", "prog.ail"], 0, [" 0 failed"])
    self.tool(
        "infer holds",
        "{base}/infer",
        ["infer", "--contracts", "pay", "prog.ail"],
        0,
        ["holds"],
    )
    # probe.run.1-4 (ADR 0921): natively, and over a replay
    fs.write_text("{base}/probe/prog.ail", src_of([
        "fn main()",
        "    mut total := 0",
        "    for n in 1..4",
        "        total += n",
        "    print(total)",
    ])) else return
    probe := self.tool(
        "probe",
        "{base}/probe",
        ["run", "--at", "prog.ail:4", "--show", "n,total", "prog.ail"],
        0,
        [
            "probe: prog.ail:4 n = 1, total = 0",
            "probe: prog.ail:4 n = 2, total = 1",
            "probe: prog.ail:4 n = 3, total = 3",
        ],
    )
    if probe.out != "6\n"
        self.red("probe leaves the output alone", probe.out)
    self.tool(
        "probe unset",
        "{base}/probe",
        ["run", "--at", "prog.ail:4", "--show", "nosuch", "prog.ail"],
        0,
        ["nosuch = <unset>"],
    )
    self.tool(
        "probe needs --show",
        "{base}/probe",
        ["run", "--at", "prog.ail:4", "prog.ail"],
        2,
        ["probe.run.4"],
    )
    self.tool("probe record", "{base}/probe", ["run", "--record", "r.json", "prog.ail"], 0, [""])
    self.tool(
        "probe over replay",
        "{base}/probe",
        ["run", "--replay", "r.json", "--at", "prog.ail:4", "--show", "n,total"],
        0,
        ["probe: prog.ail:4 n = 3, total = 3"],
    )
    # san.sched.1-2 (ADR 0967): a clean program, and a lost update that seed 2 shows (the native scheduler, see `misc`)
    fs.write_text("{base}/san/prog.ail", "fn main()\n    print(1)\n") else return
    self.tool(
        "sanitize clean",
        "{base}/san",
        ["sanitize", "prog.ail"],
        0,
        ["8 schedules, 0 differ from the fixed schedule"],
    )
    self.tool("sanitize bad arguments", "{base}/san", ["sanitize"], 2, ["usage: ail sanitize"])
    race := "{repo_root()}/tests/schedule/race.ail"
    self.tool(
        "sanitize finds the lost update",
        "{base}/san",
        ["sanitize", "--tests", "--seeds", "2", race],
        1,
        ["warning[san.sched.1]: schedule seed 2", "2 schedules, 1 differ from the fixed schedule"],
    )
    self.tool(
        "sanitize json",
        "{base}/san",
        ["sanitize", "--tests", "--seeds", "2", "--json", race],
        1,
        [
            "\"rule\":\"san.sched.1\"",
            "\"seed\":2",
            "\"summary\":true,\"seeds\":2,\"schedule_dependent\":1",
        ],
    )
    # san.leak.1-4 (ADR 0969): 48 MiB held by a local that stays live
    fs.write_text("{base}/leak/prog.ail", src_of([
        "fn main()",
        "    mut keep := List[List[int]]()",
        "    mut i := 0",
        "    while i < 48",
        "        mut row := List[int]()",
        "        mut j := 0",
        "        while j < 131072",
        "            row.push(j)",
        "            j += 1",
        "        keep.push(row)",
        "        i += 1",
        "    print(keep.len())",
    ])) else return
    lk := self.tool(
        "leak grows",
        "{base}/leak",
        ["leak", "prog.ail"],
        0,
        ["leak[san.leak.1]", "growing"],
    )
    if lk.out != "48\n"
        self.red("leak leaves the output alone", lk.out)
    self.tool("leak json", "{base}/leak", ["leak", "--json", "prog.ail"], 0, [
        "\"rule\":\"san.leak.1\"",
        "\"summary\":true,\"collections\":",
        "\"grew\":true",
    ])
    fs.write_text("{base}/leak/small.ail", "fn main()\n    print(1)\n") else return
    self.tool("leak quiet", "{base}/leak", ["leak", "small.ail"], 0, ["no growth"])
    # eff.allow.1-9 (ADR 1072): scoped capabilities. Each program runs under `ail run --allow`; a denial is one trap line.
    sh_run("mkdir -p {base}/allow/data {base}/allow/secret")
    fs.write_text("{base}/allow/data/a.txt", "alpha") else return
    fs.write_text("{base}/allow/secret/s.txt", "hidden") else return
    fs.write_text("{base}/allow/inside.ail", src_of([
        "use std.fs",
        "",
        "fn main()",
        "    print(fs.read_text(\"data/a.txt\") else \"no\")",
    ])) else return
    self.tool(
        "allow read in scope",
        "{base}/allow",
        ["run", "--allow", "fs.read=./data", "inside.ail"],
        0,
        ["alpha"],
    )
    self.tool(
        "allow read, bare fs",
        "{base}/allow",
        ["run", "--allow", "fs", "inside.ail"],
        0,
        ["alpha"],
    )
    self.tool(
        "allow read, two entries",
        "{base}/allow",
        ["run", "--allow", "fs.read=./nothing,fs.read=./data", "inside.ail"],
        0,
        ["alpha"],
    )
    self.tool(
        "allow read out of scope",
        "{base}/allow",
        ["run", "--allow", "fs.read=./secret", "inside.ail"],
        1,
        ["trap[eff.allow.3]", "fs.read of", "by fs.read_text", "--allow fs.read="],
    )
    self.tool(
        "allow nothing",
        "{base}/allow",
        ["run", "--allow", "none", "inside.ail"],
        2,
        ["eff.cap.1", "fs"],
    )
    fs.write_text("{base}/allow/outside.ail", src_of([
        "use std.fs",
        "",
        "fn main()",
        "    print(fs.read_text(\"secret/s.txt\") else \"no\")",
    ])) else return
    self.tool(
        "allow read outside",
        "{base}/allow",
        ["run", "--allow", "fs.read=./data", "outside.ail"],
        1,
        ["trap[eff.allow.3]", "secret", "--allow fs.read="],
    )
    fs.write_text("{base}/allow/dots.ail", src_of([
        "use std.fs",
        "",
        "fn main()",
        "    print(fs.read_text(\"data/../secret/s.txt\") else \"no\")",
    ])) else return
    self.tool(
        "allow dotdot traversal",
        "{base}/allow",
        ["run", "--allow", "fs.read=./data", "dots.ail"],
        1,
        ["trap[eff.allow.3]", "secret"],
    )
    fs.write_text("{base}/allow/dots2.ail", src_of([
        "use std.fs",
        "",
        "fn main()",
        "    print(fs.read_text(\"./data/../data/a.txt\") else \"no\")",
    ])) else return
    self.tool(
        "allow dotdot inside scope",
        "{base}/allow",
        ["run", "--allow", "fs.read=./data", "dots2.ail"],
        0,
        ["alpha"],
    )
    fs.write_text("{base}/allow/prefix.ail", src_of([
        "use std.fs",
        "",
        "fn main()",
        "    print(fs.exists(\"data_extra/a.txt\"))",
    ])) else return
    self.tool(
        "allow sibling with the same prefix",
        "{base}/allow",
        ["run", "--allow", "fs.read=./data", "prefix.ail"],
        1,
        ["trap[eff.allow.3]", "data_extra"],
    )
    fs.write_text("{base}/allow/writer.ail", src_of([
        "use std.fs",
        "",
        "fn main() !",
        "    fs.write_text(\"data/b.txt\", \"beta\")?",
        "    print(\"done\")",
    ])) else return
    self.tool(
        "allow write needs fs.write",
        "{base}/allow",
        ["run", "--allow", "fs.read=./data", "writer.ail"],
        1,
        ["trap[eff.allow.3]", "fs.write of", "--allow fs.write="],
    )
    self.tool(
        "allow write in scope",
        "{base}/allow",
        ["run", "--allow", "fs.write=./data", "writer.ail"],
        0,
        ["done"],
    )
    if slurp("{base}/allow/data/b.txt") != "beta"
        self.red("allow write in scope", "the file was not written")
    # A link made inside the scope that points out of it (skipped where links can't be made, Windows without developer mode).
    fs.write_text("{base}/allow/linker.ail", src_of([
        "use std.fs",
        "",
        "fn main()",
        "    fs.symlink(\"../secret\", \"data/escape\") else",
        "        print(\"nolink\")",
        "        return",
        "    print(fs.read_text(\"data/escape/s.txt\") else \"no\")",
    ])) else return
    sh_run("rm -rf {base}/allow/data/escape")
    link := ail_in(repo_root(), "{base}/allow", [
        "run",
        "--allow",
        "fs.read=./data,fs.write=./data",
        "linker.ail",
    ])
    if not link.out.contains("nolink")
        if link.status != 1
            or not link.err.contains("trap[eff.allow.3]")
            or not link.err.contains("secret")
            self.red("allow link escape", "exit {link.status}\n{link.out}{link.err}")
    sh_run("rm -rf {base}/allow/data/escape")
    fs.write_text("{base}/allow/net.ail", src_of([
        "use std.net",
        "",
        "fn main()",
        "    r := net.get(\"http://127.0.0.1:1/\") else err",
        "        print(\"not-trapped\")",
        "        return",
        "    print(r.status)",
    ])) else return
    self.tool(
        "allow net host",
        "{base}/allow",
        ["run", "--allow", "net=api.example.com", "net.ail"],
        1,
        ["trap[eff.allow.4]", "127.0.0.1:1", "--allow net=127.0.0.1:1"],
    )
    self.tool(
        "allow net by address",
        "{base}/allow",
        ["run", "--allow", "net=127.0.0.1:1", "net.ail"],
        0,
        ["not-trapped"],
    )
    self.tool(
        "allow net wrong port",
        "{base}/allow",
        ["run", "--allow", "net=127.0.0.1:2", "net.ail"],
        1,
        ["trap[eff.allow.4]"],
    )
    self.tool(
        "allow net domain scope",
        "{base}/allow",
        ["run", "--allow", "net=*.example.com", "net.ail"],
        1,
        ["trap[eff.allow.4]"],
    )
    self.tool(
        "allow net is not fs",
        "{base}/allow",
        ["run", "--allow", "fs", "net.ail"],
        2,
        ["eff.cap.1", "net"],
    )
    fs.write_text("{base}/allow/proc.ail", src_of([
        "use std.proc",
        "",
        "fn main()",
        "    r := proc.run(\"echo\", [\"hi\"]) else err",
        "        print(\"not-trapped\")",
        "        return",
        "    print(r.status >= 0)",
    ])) else return
    self.tool(
        "allow proc by name",
        "{base}/allow",
        ["run", "--allow", "proc=git", "proc.ail"],
        1,
        ["trap[eff.allow.5]", "`echo`", "--allow proc=echo"],
    )
    fs.write_text("{base}/allow/env.ail", src_of([
        "use std.env",
        "",
        "fn main()",
        "    print(env.get(\"PATH\") else \"unset\") ",
        "    print(env.get(\"HOME\") else \"unset\")",
    ])) else return
    self.tool(
        "allow env by name",
        "{base}/allow",
        ["run", "--allow", "env=PATH", "env.ail"],
        1,
        ["trap[eff.allow.6]", "`HOME`", "--allow env=HOME"],
    )
    fs.write_text("{base}/allow/vars.ail", src_of([
        "use std.env",
        "",
        "fn main()",
        "    vs := env.vars()",
        "    print(vs.contains(\"PATH\") or vs.contains(\"Path\") or vs.contains(\"AIL_ALLOW\"))",
        "    print(vs.contains(\"HOME\") or vs.contains(\"USERPROFILE\") or vs.contains(\"USER\"))",
    ])) else return
    self.tool(
        "allow env.vars is filtered",
        "{base}/allow",
        ["run", "--allow", "env=AIL_*", "vars.ail"],
        0,
        ["true\nfalse"],
    )
    fs.write_text("{base}/allow/unsafe.ail", src_of([
        "use std.mem",
        "",
        "fn main()",
        "    unsafe",
        "        xs := mem.alloc(4, 0)",
        "        print(\"ok\")",
    ])) else return
    self.tool(
        "allow refuses unsafe code",
        "{base}/allow",
        ["check", "--allow", "fs", "unsafe.ail"],
        2,
        ["eff.cap.1", "unsafe"],
    )
    self.tool(
        "allow accepts unsafe when listed",
        "{base}/allow",
        ["check", "--allow", "fs,unsafe", "unsafe.ail"],
        0,
        [],
    )
    self.tool(
        "allow unknown name",
        "{base}/allow",
        ["check", "--allow", "disk", "inside.ail"],
        2,
        ["eff.allow.2", "disk"],
    )
    self.tool(
        "allow empty scope",
        "{base}/allow",
        ["check", "--allow", "fs=", "inside.ail"],
        2,
        ["eff.allow.2"],
    )
    self.tool(
        "allow scope on a name without scopes",
        "{base}/allow",
        ["check", "--allow", "clock=now", "inside.ail"],
        2,
        ["eff.allow.2"],
    )
    self.tool(
        "allow with deny",
        "{base}/allow",
        ["check", "--allow", "fs", "--deny", "fs", "inside.ail"],
        2,
        ["eff.cap.1"],
    )
    # test.fuzz.1-5 (ADR 1015)
    fs.write_text("{base}/fuzz/prog.ail", src_of([
        "@test fn small(n int)",
        "    assert(n < 100)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    self.tool(
        "fuzz finds a failure",
        "{base}/fuzz",
        ["test", "--fuzz", "small", "--cases", "400", "--corpus", "corpus", "prog.ail"],
        1,
        ["input:"],
    )
    mut crash := false
    for f in fs.list_dir("{base}/fuzz/corpus") else []
        if f.starts_with("crash-")
            crash = true
    if not crash
        self.red("fuzz corpus", "no crash- file in {base}/fuzz/corpus")
    self.tool(
        "fuzz replays the crash first",
        "{base}/fuzz",
        ["test", "--fuzz", "small", "--cases", "400", "--corpus", "corpus", "prog.ail"],
        1,
        ["input:"],
    )
    self.tool(
        "fuzz unknown test",
        "{base}/fuzz",
        ["test", "--fuzz", "nosuch", "prog.ail"],
        2,
        ["test.fuzz.1"],
    )
    fs.write_text("{base}/fuzz2/prog.ail", src_of([
        "@test fn small(n int)",
        "    assert(n + 0 == n)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    self.tool(
        "fuzz clean run",
        "{base}/fuzz2",
        ["test", "--fuzz", "small", "--cases", "50", "prog.ail"],
        0,
        ["fuzz small: ", " runs, ", " statements reached"],
    )
    # test.mutate.1-5 (ADR 1022)
    fs.write_text("{base}/mut/prog.ail", src_of([
        "fn sign(n int) int",
        "    if n > 0",
        "        return 1",
        "    if n < 0",
        "        return -1",
        "    0",
        "",
        "@test fn positive()",
        "    assert(sign(5) == 1)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    self.tool(
        "mutate survivors",
        "{base}/mut",
        ["test", "--mutate", "prog.ail"],
        1,
        ["survived ", "(in sign)", "mutants: ", "score "],
    )
    self.tool(
        "mutate json",
        "{base}/mut",
        ["test", "--mutate", "--json", "prog.ail"],
        1,
        ["\"mutant\":true", "\"fn\":\"sign\"", "\"status\":\"survived\"", "\"mutate\":true"],
    )
    fs.write_text("{base}/mut2/prog.ail", src_of([
        "fn double(n int) int",
        "    n * 2",
        "",
        "@test fn doubles()",
        "    assert_eq(double(3), 6)",
        "    assert_eq(double(0), 0)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    self.tool(
        "mutate all killed",
        "{base}/mut2",
        ["test", "--mutate", "prog.ail"],
        0,
        ["mutants: 2 run, 2 killed, 0 survived, 0 invalid, score 100%"],
    )
    fs.write_text("{base}/mut2/bad.ail", src_of([
        "fn five() int",
        "    5",
        "",
        "@test fn bad()",
        "    assert(five() == 6)",
        "",
        "fn main()",
        "    print(\"x\")",
    ])) else return
    self.tool(
        "mutate needs green tests",
        "{base}/mut2",
        ["test", "--mutate", "bad.ail"],
        1,
        ["test.mutate.1"],
    )
    # lsp.complete.1-2, lsp.rename.1-2, lsp.action.1-2 (ADR 0966): real sessions over stdin and stdout
    prog1 := src_of([
        "struct Pt",
        "    x int",
        "    y int",
        "",
        "fn norm(p Pt) int",
        "    p.x + p.y",
        "",
        "fn main()",
        "    q := Pt(x: 1, y: 2)",
        "    print(norm(q))",
    ])
    fs.write_text("{base}/lsp1/main.ail", prog1) else return
    u1 := "file://{base}/lsp1/main.ail"
    s1 := lsp_session("{base}/lsp1", u1, prog1, [
        jreq(2, "textDocument/completion", lsp_pos(u1, 9, 12)),
        jreq(3, "textDocument/prepareRename", lsp_pos(u1, 4, 4)),
        jreq(
            4,
            "textDocument/rename",
            "~'textDocument':~'uri':'{u1}'^,'position':~'line':4,'character':4^,'newName':'size'^",
        ),
        jreq(
            5,
            "textDocument/rename",
            "~'textDocument':~'uri':'{u1}'^,'position':~'line':4,'character':4^,'newName':'1x'^",
        ),
    ])
    self.want("lsp initialize", s1.out, [
        "\"completionProvider\"",
        "\"renameProvider\"",
        "\"codeActionProvider\"",
    ])
    self.want("lsp completion", s1.out, ["\"label\":\"norm\""])
    if s1.out.contains("\"label\":\"main\"")
        self.red("lsp completion prefix", "`main` was offered after `no`")
    if s1.out.split("\"newText\":\"size\"").len() != 3
        self.red("lsp rename", "want the declaration and the call renamed\n{s1.out}")
    self.want("lsp rename refuses a bad name", s1.out, ["-32602"])
    if slurp("{base}/lsp1/main.ail") != prog1
        self.red("lsp rename", "wrote the file")
    prog2 := src_of([
        "struct Pt",
        "    x int",
        "    y int",
        "",
        "fn main()",
        "    q := Pt(x: 1, y: 2)",
        "    print(q.x)",
    ])
    typing := src_of([
        "struct Pt",
        "    x int",
        "    y int",
        "",
        "fn main()",
        "    q := Pt(x: 1, y: 2)",
        "    print(q.",
    ])
    fs.write_text("{base}/lsp2/main.ail", prog2) else return
    u2 := "file://{base}/lsp2/main.ail"
    s2 := lsp_session("{base}/lsp2", u2, typing, [jreq(
        2,
        "textDocument/completion",
        lsp_pos(u2, 6, 12),
    )])
    self.want("lsp completion after a dot", s2.out, ["\"label\":\"x\"", "\"label\":\"y\""])
    prog3 := src_of([
        "fn main()",
        "    a := 1",
        "    b := 2",
        "    a = 3",
        "    b = 4",
        "    print(a + b)",
    ])
    fs.write_text("{base}/lsp3/main.ail", prog3) else return
    u3 := "file://{base}/lsp3/main.ail"
    s3 := lsp_session("{base}/lsp3", u3, prog3, [jreq(
        2,
        "textDocument/codeAction",
        "~'textDocument':~'uri':'{u3}'^,'range':~'start':~'line':0,'character':0^,'end':~'line':5,'character':0^^,'context':~'diagnostics':[]^^",
    )])
    self.want("lsp code actions", s3.out, ["\"quickfix\"", "mut ", "source.fixAll.ail"])
    # mcp.tools.1, mcp.call.3, mcp.call.4 (ADR 0918, amended): the tools added to `ail mcp`
    fs.write_text("{base}/mcp/prog.ail", ctx) else return
    listed := mcp_session("{base}/mcp", [jreq(1, "tools/list", "~^")])
    self.want("mcp tools/list", listed.out, [
        "ail_context",
        "ail_edit",
        "ail_fix",
        "ail_explain",
        "ail_api",
        "ail_review",
        "task_abort",
        "ail_card",
        "ail_find",
        "ail_try",
        "ail_prove",
        "ail_infer",
        "ail_merge_check",
        "ail_verify_check",
    ])
    # mcp.tools.3: the whole `tools/list` answer stays under 1,500 tokens (about 4 bytes each).
    if listed.out.len() > 6000
        self.red(
            "mcp tools/list size",
            "{listed.out.len()} bytes; mcp.tools.3 allows about 1,500 tokens",
        )
    m1 := mcp_session("{base}/mcp", [
        mcp_call(2, "ail_context", "'program':'prog.ail','symbol':'pay','budget':400"),
        mcp_call(3, "ail_context", "'program':'prog.ail','symbol':'pay','json':true"),
        mcp_call(4, "ail_explain", "'rule':'api.ctx.1'"),
        mcp_call(5, "ail_api", "'program':'prog.ail','form':'index'"),
        mcp_call(6, "ail_api", "'program':'prog.ail','form':'bogus'"),
        mcp_call(7, "ail_fix", "'program':'prog.ail','dry_run':true"),
        mcp_call(8, "ail_context", "'program':'--files','symbol':'pay'"),
    ])
    self.want("mcp context, explain, api, fix", m1.out, [
        "signature",
        "structuredContent",
        "ail context",
        "(root)",
        "unknown form bogus",
        "must not start with - (mcp.call.4)",
    ])
    self.want("mcp fix is not an error", m1.out, [jm("'id':7,'result':~'content'")])
    m2 := mcp_session("{base}/mcp", [mcp_call(
        2,
        "ail_edit",
        "'program':'prog.ail','edits':'rename show display','test':true,'impact':true",
    )])
    self.want("mcp edit with test and impact", m2.out, ["passed", "tests", "\"isError\":false"])
    if not slurp("{base}/mcp/prog.ail").contains("display")
        self.red("mcp edit wrote the file", slurp("{base}/mcp/prog.ail"))
    m3 := mcp_session(repo_root(), [mcp_call(
        2,
        "ail_review",
        "'range':'HEAD..HEAD','path':'examples/hello.ail'",
    )])
    self.want("mcp review", m3.out, ["\"isError\":false"])
    # mcp.tools.1 (round 2): one real session per added tool.
    fs.write_text("{base}/mcp/prove.ail", src_of([
        "fn at(xs List[int], i int) int",
        "    requires i < xs.len()",
        "    xs[i]",
        "",
        "fn main()",
        "    xs := [3, 1, 4]",
        "    for i in 0..xs.len()",
        "        print(at(xs, i))",
    ])) else return
    fs.write_text("{base}/mcp/try.ail", ctx) else return
    fs.write_text("{base}/mcp/ours.ail", ctx) else return
    fs.write_text("{base}/mcp/theirs.ail", ctx) else return
    r2 := mcp_session("{base}/mcp", [
        mcp_call(2, "ail_card", "'topic':''"),
        mcp_call(3, "ail_card", "'topic':''"),
        mcp_call(4, "ail_card", "'topic':'errors'"),
        mcp_call(5, "ail_find", "'words':'read text file'"),
        mcp_call(6, "ail_find", "'sig':'(str) bytes'"),
        mcp_call(7, "ail_find", "'words':''"),
        mcp_call(
            8,
            "ail_try",
            "'program':'try.ail','sets':['rename show shown','rename nosuch other']",
        ),
        mcp_call(9, "ail_prove", "'program':'prove.ail'"),
        mcp_call(10, "ail_infer", "'program':'try.ail','function':'pay'"),
        mcp_call(11, "ail_merge_check", "'base':'prog.ail','ours':'ours.ail','theirs':'theirs.ail'"),
        mcp_call(12, "ail_verify_check", "'cert':'-x'"),
        mcp_call(13, "ail_find", "'how':'sort descending'"),
    ])
    self.want("mcp card", reply_of(r2.out, 2), ["AIL core card", "\"isError\":false"])
    self.want("mcp card repeat is memoised", reply_of(r2.out, 3), [jm("'ail/warm':'memo'")])
    self.want("mcp card topic", reply_of(r2.out, 4), ["\"isError\":false"])
    self.want("mcp find by words", reply_of(r2.out, 5), ["fs.read_text(path"])
    self.want("mcp find by shape", reply_of(r2.out, 6), ["read_bytes(path"])
    self.want("mcp find needs words or sig", reply_of(r2.out, 7), ["-32602", "words"])
    # api.find.7: `how` reaches `ail ask how`.
    self.want("mcp find how", reply_of(r2.out, 13), ["sorted(by:"])
    self.want("mcp try", reply_of(r2.out, 8), ["set 1: check ok", "set 2: patch does not apply"])
    if slurp("{base}/mcp/try.ail") != ctx
        self.red("mcp try", "wrote the program")
    self.want("mcp prove", reply_of(r2.out, 9), ["proved", "\"isError\":false"])
    self.want("mcp infer", reply_of(r2.out, 10), ["\"isError\":false"])
    if slurp("{base}/mcp/try.ail") != ctx
        self.red("mcp infer", "wrote the program")
    self.want("mcp merge check", reply_of(r2.out, 11), ["merged and checked", "\"isError\":false"])
    self.want("mcp verify check refuses an option", reply_of(r2.out, 12), ["-32602", "cert"])
    r3 := mcp_session("{base}/cert", [mcp_call(2, "ail_verify_check", "'cert':'.ail/cert.json'")])
    self.want("mcp verify check", reply_of(r3.out, 2), ["certificate holds", "\"isError\":false"])
    # attach.tool.3-5 (ADR 0986): `ail attach mcp` lists an app's `@tool` next to the fixed tools, and a call
    # reaches the app as a `call` request with the tool's name and arguments.
    td := "{base}/attach_mcp"
    sh_run("rm -rf {td}; mkdir -p {td}")
    tport := net_port(3)
    fs.write_text(
        "{td}/reply.json",
        jm("~'v':1,'tools':[~'name':'add','doc':'Adds n.','params':[~'name':'n','type':'int'^],'result':'int'^]^"),
    ) else return
    fs.write_text(
        "{td}/ail-attach-{tport}.json",
        "\{\"addr\":\"127.0.0.1:{tport}\",\"token\":\"tok\"}",
    ) else return
    tpid := net_start(
        "python3 -I tools/gate/attach_server.py {tport} {td}/req.txt {td}/reply.json",
        tport,
    )
    tl := sh_run("cd {repo_root()} && printf '%s\\n' '{jreq(1, "tools/list", "~^")}' '{mcp_call(2, "add", "'n':2")}' | TMPDIR={td} ./ail attach mcp")
    net_stop(tpid)
    self.want("attach mcp tools/list", tl.out, [
        "app_observe",
        "app_input",
        "\"name\":\"add\"",
        "\"integer\"",
    ])
    self.want("attach mcp call", reply_of(tl.out, 2), ["\"isError\":false"])
    self.want("attach mcp call request", slurp("{td}/req.txt"), [
        "\"q\":\"call\"",
        "\"name\":\"add\"",
        "\"token\":\"tok\"",
        "\"n\":2",
    ])
    # mcp.warm.1-4 (E14): a repeated read-only call comes from the memo, a changed file is
    # checked again, and `AIL_MCP_COLD` goes through the launcher.
    fs.write_text("{base}/mcp/warm.ail", ctx) else return
    w1 := mcp_session("{base}/mcp", [
        mcp_call(2, "ail_check", "'program':'warm.ail'"),
        mcp_call(3, "ail_check", "'program':'warm.ail'"),
        mcp_call(4, "ail_edit", "'program':'warm.ail','edits':'rename show shown'"),
        mcp_call(5, "ail_check", "'program':'warm.ail'"),
        mcp_call(6, "ail_test", "'program':'warm.ail'"),
    ])
    self.want("mcp warm first call", reply_of(w1.out, 2), [jm("'ail/warm':'direct'")])
    self.want("mcp warm repeat", reply_of(w1.out, 3), [jm("'ail/warm':'memo'")])
    self.want("mcp warm after an edit", reply_of(w1.out, 5), [jm("'ail/warm':'direct'")])
    self.want(
        "mcp warm test keeps the launcher",
        reply_of(w1.out, 6),
        [jm("'ail/warm':'launcher'")],
    )
    warm_again := mcp_call(3, "ail_check", "'program':'warm.ail'")
    cold := proc.run(
        "sh",
        [
            "-c",
            "cd \"$0\" && AIL_MCP_COLD=1 AIL=\"$1\" exec \"$1\" mcp",
            "{base}/mcp",
            "{repo_root()}/ail",
        ],
        "{warm_again}\n{warm_again}\n",
    ) else proc.Output(status: 127, out: "", err: "could not start sh")
    self.want("mcp cold", reply_of(cold.out, 3), [jm("'ail/warm':'launcher'")])
    # tool.new.1-4 (ADR 1046): the agent kit that `ail new` writes, and `--no-agent`.
    sh_run("mkdir -p {base}/new")
    self.tool("new writes the kit", "{base}/new", ["new", "kit"], 0, ["AGENTS.md", ".mcp.json"])
    kit := fs.read_text("{base}/new/kit/AGENTS.md") else return
    self.want("new AGENTS.md", kit, [
        "ail task start",
        "ail context",
        "ail task verify",
        "ail task finish",
        "ail explain",
        "ail ask",
        "Never grep",
        "ail card",
        "ail ask std",
        "ail check --fix",
        "ail try",
        "cert.json",
        "ail mcp",
        "Read `ail card` once",
        "Compiles, but is not what you meant",
        "Habits from other languages",
        "print `fixed ...`",
        "Read the file again",
    ])
    if kit.contains("ail api --card")
        self.red("new AGENTS.md", "still sends the agent to the full card")
    if kit.len() > 1900
        self.red("new AGENTS.md size", "{kit.len()} bytes; tool.new.3 allows 475 tokens")
    # mcp.proto.4 (ADR 1137): `initialize` sends the kit's lesson lines as `instructions`, word for word.
    hello := mcp_session("{base}/mcp", [jreq(1, "initialize", "~'protocolVersion':'2024-11-05'^")])
    told := parse_json(reply_of(hello.out, 1)) else Json.Null
    said := jpath(told, ["result"]) else Json.Null
    sent := said.text("instructions", "")
    if sent == ""
        self.red("mcp initialize", "no instructions\n{hello.out}")
    for row in kit.lines()
        if row.starts_with("- Read `ail card`") or row.starts_with("- `ail check`, `build`")
            if not sent.contains(row)
                self.red("mcp instructions", "differ from the AGENTS.md line: {row}")
    mcp := fs.read_text("{base}/new/kit/.mcp.json") else return
    self.want("new .mcp.json", mcp, ["\"mcpServers\"", "\"command\": \"ail\"", "\"mcp\""])
    self.tool("new --no-agent", "{base}/new", ["new", "--no-agent", "bare"], 0, ["created bare/"])
    if fs.exists("{base}/new/bare/AGENTS.md") or fs.exists("{base}/new/bare/.mcp.json")
        self.red("new --no-agent", "the kit was written")
    self.tool("new refuses an existing name", "{base}/new", ["new", "kit"], 2, ["tool.new.1"])
    # tool.new.5: `ail new .` writes only the kit, into a project that already has `.ail` files, and overwrites nothing.
    sh_run("mkdir -p {base}/here {base}/empty")
    self.tool("new . outside a project", "{base}/empty", ["new", "."], 2, ["tool.new.5"])
    fs.write_text("{base}/here/main.ail", "fn main()\n    print(1)\n") else return
    self.tool("new .", "{base}/here", ["new", "."], 0, ["wrote AGENTS.md, .mcp.json"])
    self.want("new . kit", slurp("{base}/here/AGENTS.md"), ["ail card", "ail task finish"])
    fs.write_text("{base}/here/AGENTS.md", "mine\n") else return
    fs.remove("{base}/here/.mcp.json") else return
    self.tool(
        "new . keeps AGENTS.md",
        "{base}/here",
        ["new", "."],
        0,
        ["left alone", "ail task start", "wrote .mcp.json"],
    )
    if slurp("{base}/here/AGENTS.md") != "mine\n"
        self.red("new .", "changed an existing AGENTS.md")
    self.tool("new . --no-agent", "{base}/here", ["new", "--no-agent", "."], 2, ["tool.new.5"])
    sh_run("rm -rf {base}")

## The `crypto` suite (docs/design/crypto-assurance.md): the native TLS primitives against the published and
## OpenSSL vectors, a short mutation fuzz of the X.509 and ServerHello parsers, and the client against a server
## that sends mutated flights. `ail selftest crypto`; the long runs are tools/native-tls/fuzz-check.sh N SEED
## and wire-fuzz.sh N SEED.
fn Gate.crypto(mut self)
    v := sh_run("bash tools/native-tls/prim-check.sh 2>&1")
    if v.status != 0 or not v.out.contains(" 0 failed")
        self.red("crypto vectors", "exit {v.status}\n{v.out}")
    f := sh_run("bash tools/native-tls/fuzz-check.sh 1500 1 2>&1")
    if f.status != 0
        self.red("crypto parser fuzz", "exit {f.status}\n{f.out}")
    w := sh_run("bash tools/native-tls/wire-fuzz.sh 60 1 2>&1")
    if w.status != 0
        self.red("crypto wire fuzz", "exit {w.status}\n{w.out}")

## The checker fuzz in its fast form (fuzz.chk.1-3, ADR 1112): 300 mutants, the extremes, and files of
## five functions with one mistake each. `ail check` must neither hang nor trap, and must report all five.
fn Gate.checkfuzz(mut self, tmp str)
    r := sh_run("perl -e 'alarm 900; exec @ARGV' \"$PWD/ail\" run tools/fuzz/check_fuzz.ail 300 1 \"{tmp}/checkfuzz\" 2>&1")
    if r.status != 0 or not r.out.contains("CHECKFUZZ GREEN")
        self.red("checkfuzz", "exit {r.status}\n{r.out}")

## ---- apicontract: the semantic API as a contract (ADR 1117; docs/design/semantic-api.md)
## Positions (Unicode, tabs, CRLF, EOF, multi-line), fix edits that carry the text they replace and refuse to apply
## when it changed, determinism, exit statuses, and the `ail mcp` tool schemas and error replies.

fn chop_r(l str) str
    if r := l.strip_suffix("\r")
        return r
    l

fn lines_of(src str) List[str]
    [chop_r(l) for l in src.split("\n")]

## The text of the span (1-based characters, exclusive end), read here and not by the compiler.
fn span_of(src str, line int, col int, end_line int, end_col int) str
    ls := lines_of(src)
    mut parts := List[str]()
    for n in line..(end_line + 1)
        if n < 1 or n > ls.len()
            return "<outside the file>"
        cs := ls[n - 1].chars()
        a := if n == line then col - 1 else 0
        b := if n == end_line then end_col - 1 else cs.len()
        if a < 0 or b > cs.len() or a > b
            return "<outside the file>"
        parts.push(cs[a..b].join(""))
    parts.join("\n")

fn jpath(d Json, keys List[str]) Json?
    mut cur := d
    for k in keys
        nxt := cur.get(k) else return none
        cur = nxt
    cur

## `{"op":"span",...}` for one edit record of `ail check --json`.
fn span_op(e Json) str
    line := e.int("line") else -1
    col := e.int("col") else -1
    end_line := e.int("end_line") else -1
    end_col := e.int("end_col") else -1
    head := jm("~'op':'span','line':{line},'col':{col},'end_line':{end_line},'end_col':{end_col},'expect':")
    tail := jm(",'text':")
    "{head}{Json.Str(e.text("expect", "")).to_text()}{tail}{Json.Str(e.text("text", "")).to_text()}}"

## The error records of `ail check --json PATH` that name `needle`, first one only.
fn Gate.position_case(mut self, name str, src str, needle str, dir str)
    path := "{dir}/{name}.ail"
    fs.write_text(path, src) else return
    r := ail_run(["check", "--json", path]) else return
    r2 := ail_run(["check", "--json", path]) else return
    if r.status != 2
        self.red("contract position {name}", "exit {r.status}, want 2\n{r.err}")
    if r.err != r2.err or r.out != r2.out
        self.red("contract determinism {name}", "two runs differ\n{r.err}\n{r2.err}")
    for l in "{r.err}\n{r.out}".lines()
        if l.trim() == ""
            continue
        if bad := schema_problem(l)
            self.red("contract schema {name}", "{bad}\n{l}")
    ls := lines_of(src)
    mut want_line := 0
    mut want_col := 0
    for i in 0..ls.len()
        if want_line == 0 and ls[i].contains(needle)
            want_line = i + 1
            want_col = ls[i].split(needle)[0].len() + 1
    mut found := false
    for l in r.err.lines()
        d := parse_json(l) else continue
        if d.text("severity", "") != "error" or not d.text("message", "").contains(needle)
            continue
        found = true
        got_line := d.int("line") else -1
        got_col := d.int("col") else -1
        got_end_line := d.int("end_line") else -1
        got_end_col := d.int("end_col") else -1
        got := [got_line, got_col, got_end_line, got_end_col]
        want := [want_line, want_col, want_line, want_col + needle.len()]
        if got != want
            self.red(
                "contract position {name}",
                "line, col, end_line, end_col: got {got}, want {want}\n{l}",
            )
        if d.text("file", "") != path
            self.red("contract position {name}", "`file` is not the path as given\n{l}")
        t := ail_run(["check", path]) else return
        if not "{t.out}{t.err}".contains("{path}:{want_line}:{want_col}:")
            self.red("contract position {name}", "the text output disagrees with the JSON\n{t.err}")
        break
    if not found
        self.red("contract position {name}", "no error names `{needle}`\n{r.err}")

## The same program with LF and with CRLF must give the same records.
fn Gate.crlf_case(mut self, name str, lf str, dir str)
    path := "{dir}/{name}.ail"
    fs.write_text(path, lf) else return
    a := ail_run(["check", "--json", path]) else return
    fs.write_text(path, lf.replace("\n", "\r\n")) else return
    b := ail_run(["check", "--json", path]) else return
    if a.status != b.status or a.err != b.err or a.out != b.out
        self.red("contract crlf {name}", "LF and CRLF differ\n--- LF\n{a.err}\n--- CRLF\n{b.err}")

## A file that ends inside a construct: every position is inside the file and the records follow the schema.
fn Gate.eof_case(mut self, name str, src str, dir str)
    path := "{dir}/{name}.ail"
    fs.write_text(path, src) else return
    r := ail_run(["check", "--json", path]) else return
    if r.status != 0 and r.status != 2
        self.red("contract eof {name}", "exit {r.status}\n{r.err}")
    nlines := lines_of(src).len()
    for l in r.err.lines()
        d := parse_json(l) else continue
        if bad := schema_problem(l)
            self.red("contract eof {name}", "{bad}\n{l}")
        ln := d.int("line") else 0
        el := d.int("end_line") else 0
        if ln > nlines or el > nlines or el < ln
            self.red("contract eof {name}", "a position is outside the {nlines} lines\n{l}")

## The edits of every fix in `ail check --json PATH`: `expect` is the text the span holds, edits don't overlap and
## are in source order. Returns how many edits it checked.
fn Gate.edit_contract(mut self, label str, path str) int
    src := slurp(path)
    r := ail_run(["check", "--json", path]) else return 0
    mut n := 0
    for l in r.err.lines()
        d := parse_json(l) else continue
        fixes := (d.get("fixes") else Json.Null).as_arr() else []
        for f in fixes
            mut prev_line := 0
            mut prev_col := 0
            edits := (f.get("edits") else Json.Null).as_arr() else []
            for e in edits
                n += 1
                line := e.int("line") else -1
                col := e.int("col") else -1
                el := e.int("end_line") else -1
                ec := e.int("end_col") else -1
                if e.get("expect") == none
                    self.red(label, "an edit has no `expect`\n{l}")
                    continue
                held := span_of(src, line, col, el, ec)
                if e.text("expect", "") != held
                    self.red(
                        label,
                        "`expect` is `{e.text("expect", "")}` but the span holds `{held}`\n{l}",
                    )
                if line < prev_line or (line == prev_line and col < prev_col)
                    self.red(label, "the edits of one fix are not in source order\n{l}")
                prev_line = el
                prev_col = ec
    n

fn Gate.apicontract(mut self, tmp str)
    dir := "{tmp}/apicontract"
    sh_run("rm -rf {dir}; mkdir -p {dir}")
    # ---- positions: columns are characters, the end is exclusive (semantic-api.md, Versioning)
    self.position_case("ascii", "fn main()\n    qzxv(1)\n", "qzxv", dir)
    self.position_case(
        "multibyte",
        "fn main()\n    r := [\"héllo 日本語\", qzxv(1)]\n    print(r)\n",
        "qzxv",
        dir,
    )
    self.position_case(
        "emoji",
        "fn main()\n    r := [\"😀😀\", qzxv(1)]\n    print(r)\n",
        "qzxv",
        dir,
    )
    self.position_case("tab", "fn main()\n    r := [1,\tqzxv(1)]\n    print(r)\n", "qzxv", dir)
    self.position_case("no_final_newline", "fn main()\n    qzxv(1)", "qzxv", dir)
    self.position_case(
        "crlf",
        "fn main()\r\n    r := [\"日本\", qzxv(1)]\r\n    print(r)\r\n",
        "qzxv",
        dir,
    )
    self.position_case(
        "multiline",
        "fn main()\n    r := [\n        1,\n        qzxv(2),\n    ]\n    print(r)\n",
        "qzxv",
        dir,
    )
    self.position_case("long_name", "fn main()\n    ééé_qzxv_日本(1)\n", "ééé_qzxv_日本", dir)
    self.crlf_case("crlf_pair", "fn main()\n    r := [\"日本é\", qzxv(1)]\n    print(r)\n", dir)
    self.crlf_case("crlf_fix", "fn main()\n    print(\"é\", prnt(1))\n", dir)
    self.eof_case("eof_open_call", "fn main()\n    print(1\n", dir)
    self.eof_case("eof_no_newline", "fn main()\n    print(1", dir)
    self.eof_case("eof_empty", "", dir)
    self.eof_case("eof_one_char", "f", dir)
    self.crlf_case("eof_crlf", "fn main()\n    print(1\n", dir)
    # ---- exit statuses
    ok_path := "{dir}/ok.ail"
    fs.write_text(ok_path, "fn main()\n    print(1)\n") else return
    ok := ail_run(["check", ok_path]) else return
    if ok.status != 0 or not ok.out.starts_with("ok ")
        self.red("contract exit check clean", "exit {ok.status}\n{ok.out}{ok.err}")
    usage := ail_run(["api", "--refs", ok_path]) else return
    if usage.status != 2
        self.red(
            "contract exit usage",
            "api --refs with no position: exit {usage.status}, want 2\n{usage.err}",
        )
    # ---- an empty answer is told from "could not determine" (api.query.1, api.refs.4)
    refs_src := "fn twice(n int) int\n    m := n + 1\n    m + n\n\nfn main()\n    print(twice(2))\n"
    refs_path := "{dir}/refs.ail"
    fs.write_text(refs_path, refs_src) else return
    blank := ail_run(["api", "--refs", refs_path, "4", "1"]) else return
    if blank.status != 1
        or not blank.err.contains("\"severity\":\"error\"")
        or not blank.err.contains("\"api\":1")
        self.red(
            "contract refs off a name",
            "exit {blank.status}, want 1 and a JSON error\n{blank.out}{blank.err}",
        )
    fn_refs := ail_run(["api", "--refs", refs_path, "6", "11"]) else return
    local_refs := ail_run(["api", "--refs", refs_path, "2", "5"]) else return
    for pair in [("fn", fn_refs, "program"), ("local", local_refs, "file")]
        res := pair.1
        if res.status != 0 or not res.out.starts_with("\{\"api\":1,")
            self.red("contract refs {pair.0}", "exit {res.status}\n{res.out}{res.err}")
            continue
        j := parse_json(res.out) else
            self.red("contract refs {pair.0}", "not JSON\n{res.out}")
            continue
        if j.get("complete") == none or j.text("scope", "") != pair.2
            self.red("contract refs {pair.0}", "want `complete` and scope `{pair.2}`\n{res.out}")
    again := ail_run(["api", "--refs", refs_path, "2", "5"]) else return
    if again.out != local_refs.out
        self.red("contract refs determinism", "{again.out}\n{local_refs.out}")
    # ---- every JSON answer carries `"api":1` first and is byte-stable
    forms := [
        ["api", refs_path],
        ["api", "--locals", refs_path, "3", "5"],
        ["api", "--type", refs_path, "3", "5"],
        ["api", "--card", "--json", refs_path],
        ["explain", "--json", "expr.name.1"],
        ["context", refs_path, "twice", "--json"],
    ]
    for form in forms
        a := ail_run(form) else continue
        b := ail_run(form) else continue
        if a.status != 0 or not a.out.starts_with("\{\"api\":1,")
            self.red(
                "contract api version {form.join(" ")}",
                "exit {a.status}\n{first_lines(a.out, 3)}{a.err}",
            )
        if a.out != b.out
            self.red("contract determinism {form.join(" ")}", "two runs differ")
    # ---- fix edits carry the text they replace
    mut checked := 0
    mut names := fs.list_dir("tests/fix") else []
    names.sort()
    for name in names
        if name.ends_with(".ail")
            checked += self.edit_contract("contract fix edits {name}", "tests/fix/{name}")
    if checked < 20
        self.red(
            "contract fix edits",
            "only {checked} edits were checked; the corpus has many more",
        )
    # ---- `ail fix`: a dry run writes nothing, and a second run changes nothing
    for name in names
        if not name.ends_with(".ail")
            continue
        work := "{dir}/fix_{name}"
        sh_run("cp tests/fix/{name} {work}")
        orig := slurp(work)
        _ := ail_run(["fix", "--dry-run", work]) else continue
        if slurp(work) != orig
            self.red("contract fix dry run {name}", "--dry-run changed the file")
        _ := ail_run(["fix", work]) else continue
        once := slurp(work)
        _ := ail_run(["fix", work]) else continue
        if slurp(work) != once
            self.red("contract fix idempotent {name}", "a second `ail fix` changed the file")
    self.mcp_contract(dir)
    # ... and `ail edit` applies them by span, refuses them when the text moved, and is idempotent
    stale := "{dir}/stale.ail"
    fs.write_text(stale, "fn main()\n    prnt(\"hi\")\n") else return
    sr := ail_run(["check", "--json", stale]) else return
    mut ops := List[str]()
    for l in sr.err.lines()
        d := parse_json(l) else continue
        for f in (d.get("fixes") else Json.Null).as_arr() else []
            if ops.is_empty()
                mut es := List[str]()
                for e in (f.get("edits") else Json.Null).as_arr() else []
                    es.push(span_op(e))
                mut k := es.len() - 1
                while k >= 0
                    ops.push(es[k])
                    k -= 1
    if ops.is_empty()
        self.red("contract stale", "the check offered no fix for `prnt`\n{sr.err}")
        return
    payload := "[{ops.join(",")}]"
    before := slurp(stale)
    dry := edit_run(stale, ["--dry-run"], payload)
    if dry.status != 0 or not dry.out.contains("would edit") or slurp(stale) != before
        self.red(
            "contract edit dry run",
            "exit {dry.status}; file changed: {slurp(stale) != before}\n{dry.out}{dry.err}",
        )
    live := edit_run(stale, [], payload)
    if live.status != 0 or slurp(stale) != "fn main()\n    print(\"hi\")\n"
        self.red(
            "contract edit applies",
            "exit {live.status}\n{live.out}{live.err}\n{slurp(stale)}",
        )
    # The same edit again: the span now holds `print`, so it is stale and nothing is written.
    after := slurp(stale)
    redo := edit_run(stale, [], payload)
    if redo.status != 2
        or not "{redo.out}{redo.err}".contains("stale edit")
        or slurp(stale) != after
        self.red("contract edit refuses a stale span", "exit {redo.status}\n{redo.out}{redo.err}")
    # Text that moved under the span (same length, other letters) is refused too.
    fs.write_text(stale, "fn main()\n    prnx(\"hi\")\n") else return
    moved := edit_run(stale, [], payload)
    if moved.status != 2
        or not "{moved.out}{moved.err}".contains("stale edit")
        or slurp(stale) != "fn main()\n    prnx(\"hi\")\n"
        self.red("contract edit refuses moved text", "exit {moved.status}\n{moved.out}{moved.err}")
    # A span edit on multibyte text in a CRLF file lands on the right characters.
    mb := "{dir}/mb.ail"
    fs.write_text(mb, "fn main()\r\n    print(\"日本é😀\", prnt(1))\r\n") else return
    mr := ail_run(["check", "--json", mb]) else return
    mut mops := List[str]()
    for l in mr.err.lines()
        d := parse_json(l) else continue
        if d.text("rule", "") != "expr.name.1"
            continue
        for f in (d.get("fixes") else Json.Null).as_arr() else []
            if mops.is_empty()
                for e in (f.get("edits") else Json.Null).as_arr() else []
                    mops.push(span_op(e))
    if mops.is_empty()
        self.red("contract edit multibyte", "the check offered no fix\n{mr.err}")
    else
        me := edit_run(mb, [], "[{mops.join(",")}]")
        if "{me.out}{me.err}".contains("stale edit")
            or not slurp(mb).contains("print(\"日本é😀\", print(1))")
            self.red("contract edit multibyte", "exit {me.status}\n{me.out}{me.err}\n{slurp(mb)}")

## `ail mcp`: the tool schemas against the spec and what each tool accepts; errors are structured.
fn Gate.mcp_contract(mut self, dir str)
    work := "{dir}/mcp"
    sh_run("mkdir -p {work}")
    fs.write_text("{work}/prog.ail", "fn main()\n    print(1)\n") else return
    listed := mcp_session(work, [jreq(1, "tools/list", "~^")])
    listed2 := mcp_session(work, [jreq(1, "tools/list", "~^")])
    if listed.out != listed2.out
        self.red("contract mcp tools/list determinism", "two sessions differ")
    rep := parse_json(reply_of(listed.out, 1)) else
        self.red("contract mcp tools/list", "not JSON\n{listed.out}")
        return
    tools := (jpath(rep, ["result", "tools"]) else Json.Null).as_arr() else []
    spec := slurp("docs/spec/22-tools.md")
    mut sentence := ""
    for l in spec.lines()
        if l.starts_with("**mcp.tools.1**")
            sentence = l.split(". ")[0]
    pieces := sentence.split("`")
    mut spec_names := List[str]()
    for i in 0..pieces.len()
        if i % 2 == 1 and (pieces[i].starts_with("ail_") or pieces[i].starts_with("task_"))
            spec_names.push(pieces[i])
    mut listed_names := List[str]()
    for t in tools
        listed_names.push(t.text("name", ""))
    spec_names.sort()
    listed_names.sort()
    if spec_names.is_empty() or spec_names != listed_names
        self.red("contract mcp tools vs mcp.tools.1", "spec {spec_names}\nlist {listed_names}")
    for t in tools
        name := t.text("name", "")
        if t.text("description", "") == ""
            self.red("contract mcp {name}", "no description")
        schema := t.get("inputSchema") else
            self.red("contract mcp {name}", "no inputSchema")
            continue
        if schema.text("type", "") != "object"
            self.red("contract mcp {name}", "inputSchema is not an object")
        props := schema.get("properties") else Json.Null
        needs := (schema.get("required") else Json.Null).as_arr() else []
        if schema.get("required") != none and needs.is_empty()
            self.red("contract mcp {name}", "`required` is present and empty (mcp.tools.3)")
        for r in needs
            key := r.as_str() else ""
            if props.get(key) == none
                self.red("contract mcp {name}", "`{key}` is required but not a property")
        want_bool := ["json", "test", "impact", "dry_run"]
        for m in props.as_obj() else []
            k := m.key
            ty := (props.get(k) else Json.Null).text("type", "")
            mut want := "string"
            if k == "budget"
                want = "integer"
            elif k == "sets"
                want = "array"
            elif want_bool.contains(k)
                want = "boolean"
            if ty != want
                self.red(
                    "contract mcp {name}",
                    "property `{k}` has type `{ty}`, mcp.tools.1 says `{want}`",
                )
        # A call that lacks a required argument is -32602, and the reply is a structured error (mcp.call.2).
        if not needs.is_empty()
            miss := mcp_session(work, [mcp_call(2, name, "")])
            e := parse_json(reply_of(miss.out, 2)) else
                self.red("contract mcp {name} missing argument", "not JSON\n{miss.out}")
                continue
            err := jpath(e, ["error"]) else Json.Null
            code := err.int("code") else 0
            msg := err.text("message", "")
            if code != -32602 or msg == "" or e.text("jsonrpc", "") != "2.0"
                self.red(
                    "contract mcp {name} missing argument",
                    "want error -32602 with a message\n{miss.out}",
                )
    # An argument that would be read as an option is refused for every tool that takes one (mcp.call.4).
    for pair in [
        ("ail_context", "program"),
        ("ail_api", "program"),
        ("ail_fix", "program"),
        ("ail_review", "range"),
        ("ail_verify_check", "cert"),
        ("ail_explain", "rule"),
        ("ail_card", "topic"),
    ]
        r := mcp_session(work, [mcp_call(
            2,
            pair.0,
            "'{pair.1}':'-x','symbol':'s','range':'a..b','cert':'c'",
        )])
        if not reply_of(r.out, 2).contains("-32602")
            self.red("contract mcp {pair.0} dashed {pair.1}", reply_of(r.out, 2))
    # Protocol errors are structured, with a null id when the request has none (mcp.proto.3).
    p := mcp_session(work, [
        "not json",
        "42",
        "[1]",
        jreq(3, "nosuch/method", "~^"),
        mcp_call(4, "no_such_tool", ""),
        jnote("notifications/initialized", "~^"),
        jreq(5, "ping", "~^"),
    ])
    rows := p.out.lines()
    if rows.len() != 6
        self.red(
            "contract mcp protocol",
            "want 6 replies (a notification gets none), got {rows.len()}\n{p.out}",
        )
    else
        want_codes := [-32700, -32600, -32600, -32601, -32602]
        for i in 0..5
            e := parse_json(rows[i]) else
                self.red("contract mcp protocol", "reply {i} is not JSON\n{rows[i]}")
                continue
            err := jpath(e, ["error"]) else Json.Null
            code := err.int("code") else 0
            if code != want_codes[i] or err.text("message", "") == ""
                self.red(
                    "contract mcp protocol",
                    "reply {i}: want code {want_codes[i]} and a message\n{rows[i]}",
                )
        if not rows[5].contains("\"id\":5")
            self.red("contract mcp protocol", "the ping is not answered\n{rows[5]}")
    # A command that fails is a result with isError, not a protocol error; a clean one says so (mcp.call.1).
    bad := mcp_session(work, [
        mcp_call(2, "ail_check", "'program':'missing.ail'"),
        mcp_call(3, "ail_check", "'program':'prog.ail'"),
    ])
    self.want(
        "contract mcp failing command",
        reply_of(bad.out, 2),
        ["\"isError\":true", "\"content\":["],
    )
    self.want("contract mcp clean command", reply_of(bad.out, 3), ["\"isError\":false", "ok "])
    if reply_of(bad.out, 2).contains("\"error\":")
        self.red(
            "contract mcp failing command",
            "a failed command is a result, not an error\n{reply_of(bad.out, 2)}",
        )

## A built program through the shell with `env` (`NAME=value`, or empty) set, under a 15 minute alarm, standard error merged in.
fn stress_run(env str, exe str) proc.Output
    sh_run("{env} perl -e 'alarm 900; exec @ARGV' {exe} 2>&1")

## The cheap GC and concurrency stress checks (ADR 1118). tests/stress/*.ail are self-checking programs with fixed totals
## that end with `STRESS GREEN`. Each is built once (so the setting below does not reach the compiler) and run by default,
## on one thread (`AIL_THREADS=1`), with `AIL_GC_VERIFY=1` (every block's header checked at each collection, exit 70 on a
## bad one) and with a strided heap check during allocation. `conc_sched.ail` runs under random schedules instead
## (`ail run --schedule=random:N`). Then every `par_*` case that has only an `.out` file must print it with
## `AIL_THREADS=1`, so a loop that auto-parallelised wrongly (or only gave the right answer on one thread) is red.
fn Gate.stress(mut self, tmp str)
    modes := [
        ["default", ""],
        ["one thread", "AIL_THREADS=1"],
        ["heap verify", "AIL_GC_VERIFY=1"],
        ["strided heap verify", "AIL_GC_VERIFY=0,100000000,997"],
    ]
    for name in (fs.list_dir("tests/stress") else []).sorted()
        if not name.ends_with(".ail")
            continue
        stem := name.replace(".ail", "")
        at := "tests/stress/{name}"
        exe := "{tmp}/stress_{stem}"
        if why := build(at, exe)
            self.red("stress {name}", "did not build: {why}")
            continue
        for m in modes
            if stem == "conc_sched" and m[0] != "default"
                continue
            r := stress_run(m[1], exe)
            if r.status != 0 or not lf(r.out).trim().ends_with("STRESS GREEN")
                self.red("stress {name} ({m[0]})", "exit {r.status}\n{r.out}")
    for seed in 1..9
        r := sh_run("perl -e 'alarm 900; exec @ARGV' \"$PWD/ail\" run --schedule=random:{seed} tests/stress/conc_sched.ail 2>&1")
        if r.status != 0 or not lf(r.out).trim().ends_with("STRESS GREEN")
            self.red("stress conc_sched.ail (schedule seed {seed})", "exit {r.status}\n{r.out}")
    for name in (fs.list_dir("tests/cases") else []).sorted()
        if not name.starts_with("par_") or not name.ends_with(".ail")
            continue
        stem := name.replace(".ail", "")
        exp := "tests/cases/{stem}."
        if not fs.exists("{exp}out")
            or fs.exists("{exp}trap")
            or fs.exists("{exp}args")
            or fs.exists("{exp}stderr")
            or fs.exists("{exp}err")
            or fs.exists("{exp}test")
            or fs.exists("{exp}rules")
            continue
        r := sh_run("AIL_THREADS=1 perl -e 'alarm 300; exec @ARGV' \"$PWD/ail\" run tests/cases/{name} 2>/dev/null")
        if r.status != 0 or lf(r.out) != lf(slurp("{exp}out"))
            self.red("stress {name} (AIL_THREADS=1)", "exit {r.status}\n{r.out}")

## The C ABI fixtures (ADR 1074): every struct class of System V x86-64, AAPCS64 and Win64 passes both ways, and C calls
## AIL callbacks that allocate enough for the collector to run while C is on the stack. tools/ffi-abi/run.sh builds
## abi.c with the host's C compiler, builds abi.ail with this checkout's compiler and compares with abi.out.
fn Gate.ffi_abi(mut self)
    mut script := "bash tools/ffi-abi/run.sh 2>&1"
    if (env.get("OS") else "") == "Windows_NT"
        script = "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ffi-abi/run.ps1 2>&1"
    r := sh_run(script)
    if r.status != 0 or not (r.out.contains("ffi-abi: GREEN") or r.out.contains("ffi-abi: SKIPPED"))
        self.red("ffi-abi", "exit {r.status}\n{r.out}")

fn main() !
    args := env.args()
    all := [
        "examples",
        "cases",
        "explain",
        "fix",
        "cli",
        "mistakes",
        "contracts",
        "snapshot",
        "nativex",
        "globals",
        "pe",
        "asm",
        "std",
        "sched",
        "agent_tools",
        "cert",
        "try",
        "parity",
        "corpus",
        "corpus_sets",
        "native_matrix",
        "checkfuzz",
        "checkbench",
        "golden",
        "apicontract",
        "stress",
        "ffi_abi",
    ]
    suites := if args.len() == 0 then all else args
    tmp := temp_dir()
    fs.make_dir(tmp)? "creating {tmp}"
    mut g := Gate(fails: 0, built: 0, unbuilt: [], part: 0, shard_count: 1, seq: 0, ran: 0)
    for asked in suites
        # `NAME@K/N`: shard K of N of suite NAME (see Gate.mine; `spec` takes it too).
        mut s := asked
        g.part = 0
        g.shard_count = 1
        g.seq = 0
        g.ran = 0
        if asked.contains("@")
            halves := asked.split("@")
            s = halves[0]
            kn := halves[1].split("/")
            mut n := 0
            if kn.len() == 2
                n = kn[1].to_int() else 0
            k := kn[0].to_int() else -1
            if n < 1 or k < 0 or k >= n
                io.eprint("bad shard `{asked}`: write NAME@K/N with 0 <= K < N")
                io.exit(2)
            g.part = k
            g.shard_count = n
        match s
            "examples" => g.examples(tmp)
            "corpus" => g.corpus(tmp)
            "corpus_sets" => g.corpus_sets(tmp)
            "native_matrix" => g.native_matrix(tmp)
            "cases" => g.cases()
            "explain" => g.explain_coverage()
            "fix" => g.fix(tmp)
            "cli" =>
                g.cli_effects(tmp)
                g.cli_help(tmp)
            "mistakes" => g.mistakes(tmp)
            "contracts" => g.contracts()
            "snapshot" => g.snapshot(tmp)
            "misc" => g.misc(tmp)
            "sched" => g.sched()
            "docs" => g.docs()
            "fmt" => g.fmt(tmp)
            "budget" => g.budget(tmp)
            "limits" => g.limits(tmp)
            "diff" => g.diff(tmp)
            "build_cache" => g.build_cache(tmp)
            "api_queries" => g.api_queries(tmp)
            "replay" => g.replay(tmp)
            "api_card" => g.api_card(tmp)
            "edit" => g.edit(tmp)
            "git_deps" => g.git_deps(tmp)
            "net" => g.net()
            "crypto" => g.crypto()
            "spec" => g.spec()
            "nativex" => g.nativex()
            "globals" => g.globals()
            "pe" => g.pe()
            "asm" => g.asm()
            "native_misc" => g.native_misc()
            "selfhost" => g.selfhost()
            "std" => g.std(tmp)
            "agent_tools" => g.agent_tools(tmp)
            "cert" => g.cert(tmp)
            "try" => g.try_cmd(tmp)
            "parity" => g.parity()
            "checkfuzz" => g.checkfuzz(tmp)
            "checkbench" => g.checkbench()
            "golden" => g.golden()
            "apicontract" => g.apicontract(tmp)
            "stress" => g.stress(tmp)
            "ffi_abi" => g.ffi_abi()
            _ =>
                io.eprint("unknown suite {s}; suites: {all.join(" ")} selfhost")
                io.exit(2)
        if g.shard_count > 1 and g.seq > 0
            print("SHARD {s} {g.part}/{g.shard_count} total {g.seq} ran {g.ran}")
    # Cleanup must never skip the verdict below: with no `rm` (Windows without Git's usr\bin on PATH) the run still reports.
    _ := proc.run("rm", ["-rf", tmp]) else proc.Output(status: 127, out: "", err: "")
    if g.unbuilt.len() > 0
        print("{g.unbuilt.len()} examples are not native yet: {g.unbuilt.join(" ")}")
    if g.fails == 0
        print("GATE GREEN ({g.built} built)")
    else
        print("GATE RED ({g.fails} failures)")
        io.exit(1)
