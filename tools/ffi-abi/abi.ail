# The AIL side of the FFI ABI check (tools/ffi-abi/run.sh, ADR 1074): every
# struct class of System V x86-64, AAPCS64 and Win64 by value, both ways, and
# C code calling AIL callbacks, against the library abi.c builds.
struct I2
    a i32
    b i32

struct I3
    a int
    b int
    c int

struct D2
    x float
    y float

struct F3
    x f32
    y f32
    z f32

struct D4
    a float
    b float
    c float
    d float

struct Mix
    i i32
    f f32

struct DN
    d float
    n int

struct Tiny
    a u8
    b u16
    c i8

struct Nest
    inner I2
    w float

struct BV
    ok bool
    v int

extern c "ailabi" fn i2_make(a i32, b i32) I2
extern c "ailabi" fn i2_sum(p I2) int
extern c "ailabi" fn i3_scale(p I3, k int) I3
extern c "ailabi" fn i3_sum(p I3) int
extern c "ailabi" fn d2_add(a D2, b D2) D2
extern c "ailabi" fn f3_scale(v F3, k f32) F3
extern c "ailabi" fn d4_make(s float) D4
extern c "ailabi" fn d4_sum(v D4) float
extern c "ailabi" fn mix_swap(m Mix) Mix
extern c "ailabi" fn dn_make(d float, n int) DN
extern c "ailabi" fn tiny_echo(t Tiny) Tiny
extern c "ailabi" fn nest_make(a i32, b i32, w float) Nest
extern c "ailabi" fn nest_sum(n Nest) float
extern c "ailabi" fn bv_flip(x BV) BV
extern c "ailabi" fn many(a int, b D2, c I3, d int, e D2, f int, g int, h F3, i int, j int, k float) float
extern c "ailabi" fn hfa_spill(a D4, b D4, c f32, d i32, e D2) float
extern c "ailabi" fn apply_cb(f fn(int, float) int, x int, y float) int
extern c "ailabi" fn call_narrow(f fn(i8, u16, bool, f32) i32) i32
extern c "ailabi" fn call6(f fn(int, int, int, int, int, float) int) int
extern c "ailabi" fn repeat_cb(f fn(int) int, n int) int

fn mul_add(x int, y float) int
    x * 10 + (y * 4.0).to_int()

fn narrow(a i8, b u16, c bool, d f32) i32
    mut n := a.to_int() + b.to_int() + (d.to_float() * 2.0).to_int()
    if c
        n += 100
    n.to_i32()

fn six(a int, b int, c int, d int, e int, f float) int
    a + b * 10 + c * 100 + d * 1000 + e * 10000 + (f * 2.0).to_int()

## Allocates on every call, so the collector runs while C is on the stack.
fn churn(i int) int
    s := "{i}-{i * 2}-{[i, i + 1, i + 2]}"
    s.len() % 7

fn s32(x float) f32
    x.to_f32()

fn main()
    unsafe
        p := i2_make(3, -4)
        print("i2 {p.a} {p.b} {i2_sum(p)}")
        q := i3_scale(I3(a: 1, b: 2, c: 3), 7)
        print("i3 {q.a} {q.b} {q.c} {i3_sum(q)}")
        d := d2_add(D2(x: 1.5, y: 2.25), D2(x: 0.5, y: 0.75))
        print("d2 {d.x} {d.y}")
        v := f3_scale(F3(x: s32(1.0), y: s32(2.0), z: s32(3.5)), s32(2.0))
        print("f3 {v.x.to_float()} {v.y.to_float()} {v.z.to_float()}")
        w := d4_make(1.5)
        print("d4 {w.a} {w.b} {w.c} {w.d} {d4_sum(w)}")
        m := mix_swap(Mix(i: 7, f: s32(-3.0)))
        print("mix {m.i} {m.f.to_float()}")
        dn := dn_make(0.25, -9)
        print("dn {dn.d} {dn.n}")
        t := tiny_echo(Tiny(a: 254, b: 65534, c: -128))
        print("tiny {t.a} {t.b} {t.c}")
        n := nest_make(5, 6, 0.5)
        print("nest {n.inner.a} {n.inner.b} {n.w} {nest_sum(n)}")
        b := bv_flip(BV(ok: false, v: 12))
        print("bv {b.ok} {b.v}")
        print("many {many(1, D2(x: 2.0, y: 3.0), I3(a: 4, b: 5, c: 6), 7, D2(x: 8.0, y: 9.0), 10, 11, F3(x: s32(12.0), y: s32(13.0), z: s32(14.0)), 15, 16, 17.0)}")
        print("spill {hfa_spill(d4_make(1.0), d4_make(0.5), s32(0.5), 3, D2(x: 0.75, y: 0.25))}")
        print("cb {apply_cb(mul_add, 4, 0.5)}")
        print("narrow {call_narrow(narrow)}")
        print("six {call6(six)}")
        print("churn {repeat_cb(churn, 300000)}")
