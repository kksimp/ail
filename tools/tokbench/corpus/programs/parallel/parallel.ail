WIDTH := 48
HEIGHT := 16
LIMIT := 200

fn escape(cr float, ci float) int
    mut zr := 0.0
    mut zi := 0.0
    mut n := 0
    while n < LIMIT and zr * zr + zi * zi <= 4.0
        t := zr * zr - zi * zi + cr
        zi = 2.0 * zr * zi + ci
        zr = t
        n += 1
    n

fn shade(n int) str
    if n >= LIMIT
        return "#"
    if n > 12
        return "+"
    if n > 4
        return "."
    " "

fn main()
    mut rows := List[str]()
    for _ in 0..HEIGHT
        rows.push("")
    for y in 0..HEIGHT
        mut line := ""
        for x in 0..WIDTH
            cr := -2.2 + 3.0 * x.to_float() / WIDTH.to_float()
            ci := -1.2 + 2.4 * y.to_float() / HEIGHT.to_float()
            line = "{line}{shade(escape(cr, ci))}"
        rows[y] = line
    for row in rows
        print(row)
    mut steps := 0
    for y in 0..HEIGHT
        steps += escape(-0.5, y.to_float() / HEIGHT.to_float())
    print("steps: {steps}")
