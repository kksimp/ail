fn main() !
    here := path.dir(env.program())
    ail := proc.which("ail") else "{here}/../../../../../ail"
    data := "{here}/../../../../../tools/tokbench/corpus/agent-r5/data"
    for name in ["scale.ail", "report.ail"]
        r := proc.run(ail, [
            "diff",
            "--json",
            "{data}/v1/{name}",
            "{data}/v2/{name}",
        ])? "diffing {name}"
        for line in r.out.lines()
            d := parse_json(line) else continue
            summary := d.flag("summary", false)
            if summary
                added := d.int("added") else 0
                removed := d.int("removed") else 0
                changed := d.int("changed") else 0
                tests := d.int("tests_changed") else 0
                print("{name}: added {added}, removed {removed}, changed {changed}, tests changed {tests}")
