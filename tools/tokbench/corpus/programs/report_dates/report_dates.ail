use std.time.date

struct Event
    ts int
    kind str

fn parse(text str) List[Event]
    mut events := []
    for line in text.lines()[1..]
        cells := line.split(",")
        events.push(Event(ts: cells[0].to_int() else 0, kind: cells[1]))
    events

fn main() !
    text := fs.read_text("{path.dir(env.program())}/agent-data/events.csv")? "reading events"
    mut per_day := {}
    mut kinds := {}
    for e in parse(text)
        day := date.utc(e.ts * 1000).format("%Y-%m-%d")
        per_day[day] += 1
        kinds[e.kind] += 1
    for day in per_day.keys().sorted()
        print("{day}  {per_day[day]} events")
    names := kinds.keys().sorted().join(", ")
    print("kinds: {names}")
