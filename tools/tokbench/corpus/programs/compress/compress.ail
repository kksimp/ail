use std.compress

fn main() ! compress.CompressError
    mut log := ""
    for i in 0..200
        log = "{log}level=info msg=ok\n"
    packed := compress.gzip(log)
    print("gzip is smaller: {packed.len() < log.len()}")
    back := compress.gunzip(packed)?
    print("round trip equal: {back.to_str() == log}")
    bad := b"\x01\x02\x03"
    empty := compress.gunzip(bad) else b""
    print("corrupt input rejected: {empty.len() == 0}")
