fn main() !
    here := path.dir(env.program())
    ail := proc.which("ail") else "{here}/../../../../../ail"
    data := "{here}/../../../../../tools/tokbench/corpus/agent-r5/data"
    for file in ["{data}/pkg/mathx.ail", "{data}/ok.ail"]
        r := proc.run(ail, ["api", file])? "reading {path.base(file)}"
        doc := parse_json(r.out)? "parsing {path.base(file)}"
        for item in doc.arr("items") else []
            kind := item.text("kind", "")
            if kind == "fn"
                doc_text := item.text("doc", "")
                documented := doc_text.len() > 0
                fname := item.text("name", "")
                sig := item.text("signature", "")
                print("{path.base(file)} {fname} doc={documented} {sig}")
