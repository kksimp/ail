use std.time.date

fn main() !
    dir := env.args().first() else "{path.dir(env.program())}/agent-data"
    text := fs.read_text("{dir}/dates.txt")? "reading dates"
    for line in text.lines()
        d := date.parse_date(line)?
        later := d.add_days(7)
        print("{d.iso()} is a {d.weekday()}, a week later {later.iso()}")
