fn main() !
    dir := env.args().first() else "{path.dir(env.program())}/agent-data"
    text := fs.read_text("{dir}/records.txt")? "reading records"
    mut big := ""
    for i in 0..50
        big = "{big}{text}"
    packed := compress.gzip(big)
    print("gzip is smaller: {packed.len() < big.byte_len()}")
    back := compress.gunzip(packed)?
    print("round trip equal: {back.text() == big}")
