fn main() !
    data := fs.read_bytes("{path.dir(env.program())}/agent-data/status.json")?
    mut offset := 0
    while offset < data.len()
        end := if offset + 16 < data.len() then offset + 16 else data.len()
        print("{offset:>6}  {data[offset..end].hex(" ")}")
        offset += 16
    n := data.len()
    print("{n} bytes")
