fn main() !
    here := path.dir(env.program())
    ail := proc.which("ail") else "{here}/../../../../../ail"
    file := "{here}/../../../../../tools/tokbench/corpus/agent-r5/data/tests.ail"
    r := proc.run(ail, ["test", file])? "running tests"
    for line in r.out.lines()
        if line.starts_with("ok ")
            print("pass {line.replace("ok ", "")}")
        elif line.starts_with("FAIL ")
            name := (line.replace("FAIL ", "").split(":").first()) else ""
            print("fail {name}")
        elif line.contains(" passed, ")
            print(line.trim())
    print("exit {r.status}")
