
fn main() !
    here := path.dir(env.program())
    r := proc.run("{here}/../ail", ["explain", "--json"])? "listing rules"
    doc := parse_json(r.out)? "reading the rule list"
    rules := doc.arr("rules") else []
    mut total := Map[str, int]()
    mut fixable := Map[str, int]()
    for rule in rules
        chapter := rule.str("chapter") else "?"
        seen := total.get(chapter) else 0
        total[chapter] = seen + 1
        can_fix := rule.bool("fix") else false
        if can_fix
            fixed := fixable.get(chapter) else 0
            fixable[chapter] = fixed + 1
    for chapter in total.keys().sorted()
        print("{chapter} {total[chapter]} {fixable.get(chapter) else 0}")
    print("all {rules.len()} {doc.int("fixable") else 0}")
