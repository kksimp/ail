struct Stack[T]
    items List[T]

fn Stack.new() Stack[T]
    Stack(items: [])

fn Stack.push(mut self, x T)
    self.items.push(x)

fn Stack.pop(mut self) T?
    if self.items.len() == 0
        return none
    self.items.pop()

fn Stack.peek(self) T?
    n := self.items.len()
    if n == 0
        return none
    self.items[n - 1]

fn Stack.len(self) int
    self.items.len()

struct Pair[A, B]
    first A
    second B

fn Pair.swap(self) Pair[B, A]
    Pair(first: self.second, second: self.first)

impl Show for Stack
    fn show(self) str
        "Stack{self.items}"

fn main()
    mut s := Stack[int].new()
    s.push(1)
    s.push(2)
    top := s.pop() else 0
    p := Pair(first: 1, second: "a")
    print("{top} {s.len()} {p.swap()}")
