which 0: connection 1 request 1
which 1: connection 1 request 2
which 2: connection 1 request 3
hello: 200 hello over h2
  x-proto h2
  set-cookie a=1|b=2
head: 200 
hdrs: 200 :method: GET
:authority: localhost:PORT
:scheme: https
:path: /hdrs
user-agent: ail
accept: */*
accept-encoding: gzip, deflate, br
hdrs custom: 200 :method: GET
:authority: localhost:PORT
:scheme: https
:path: /hdrs
sec-ch-ua: "Garlic";v="1"
user-agent: Mozilla/5.0 (compat) Garlic/1
accept: text/html
accept-encoding: gzip, deflate, br
accept-language: en-US,en;q=0.9
x-custom: one
cookie: k=v
redirect: 200 hello over h2
nobody: 204 
missing: 404 nope
gzip: 200 zipped over h2
interim: 200 after interim
split: 200 split and padded
ping: 200 pinged
trailers: 200 with trailers
  names content-type
huffman: 200 huffman ok
  names content-type,x-dyn,x-huff
  x-dyn dynamic value|dynamic value|second
  x-huff www.example.com
big: 200 300000 bytes true
huge: 200 8388608 bytes true
post: 200 got 200000 bytes, same
goaway: error protocol true
rst: error protocol true
