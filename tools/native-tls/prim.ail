# Runs the primitive vectors of tests/data/net/crypto/crosscheck.txt
# through the native runtime: see tools/native-tls/prim-check.sh. In this build
# `hash.hmac_sha256(op, args)` is the test hook (a temporary compiler directory
# maps it to `tlsprim_call`); the vectors files are the arguments: crosscheck.txt
# and signatures.txt.
use std.hash

## Run the crosscheck-format file `path`: `[ok, failed]`.
fn run_file(path str) List[int]
    text := fs.read_text(path) else ""
    mut ok := 0
    mut bad := 0
    for line in text.lines()
        if line.starts_with("#") or line == ""
            continue
        f := line.split(" ")
        op := f[0]
        if op == "x25519"
            or op == "poly1305"
            or op == "chacha20poly1305"
            or op == "aesgcm"
            or op == "sha256"
            or op == "sha384"
            or op == "sha512"
            or op == "hmac256"
            or op == "hkdf256"
            or op == "hmac384"
            or op == "hkdf384"
            or op == "aesgcm_open"
            or op == "chacha_open"
            want := f[f.len() - 1]
            mut got := hash.hmac_sha256(op, f[1..f.len() - 1].join(" "))
            if got == ""
                got = "-"
            if got == want
                ok += 1
            else
                bad += 1
                print("FAIL {op}: want {want} got {got}")
    [ok, bad]

fn main()
    a := run_file(env.args()[0])
    b := run_file(env.args()[3])
    wy := run_file(env.args()[5])
    mut ok := a[0] + b[0] + wy[0]
    mut bad := a[1] + b[1] + wy[1]
    sched := hash.hmac_sha256("rfc8448", "")
    if sched
        == "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a 6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"
        ok += 1
    else
        bad += 1
        print("FAIL rfc8448: got {sched}")
    for path in [env.args()[1], env.args()[4]]
        sigs := fs.read_text(path) else ""
        for line in sigs.lines()
            if line.starts_with("#") or line == ""
                continue
            f := line.split(" ")
            got := hash.hmac_sha256(f[0], "{f[1].replace(":", " ")} {f[2]} {f[3]}")
            if got == f[4]
                ok += 1
            else
                bad += 1
                print("FAIL {f[0]}: want {f[4]} got {got} for {f[1].slice(0, 20)}")
    pki := fs.read_text(env.args()[2]) else ""
    mut certs := Map[str, str]()
    for line in pki.lines()
        if line.starts_with("#") or line == ""
            continue
        kv := line.split(" ")
        certs[kv[0]] = kv[1]
    # NAMES|HOST|WANT: WANT is "ok", a message, or "~part" for a substring.
    # Mirrors the former Rust x509 tests (NOW is 2027-01-01).
    cases := [
        "leaf,inter|example.test|ok",
        "leaf,inter|EXAMPLE.test.|ok",
        "leaf,inter|a.wild.test|ok",
        "leaf,inter|127.0.0.1|ok",
        "leaf,inter|::1|ok",
        "leaf,inter|[::1]|ok",
        "rsa_leaf,inter|rsa.test|ok",
        "pss_signed,inter|pss.test|ok",
        "sha512_leaf,inter|example.test|ok",
        "leaf,inter,root|example.test|ok",
        "leaf,self_signed,constrained,inter|example.test|ok",
        "constrained_ok,constrained|x.allowed.test|ok",
        "leaf,inter|other.test|the server's certificate isn't valid for `other.test`; it covers example.test, *.wild.test, 127.0.0.1, ::1",
        "leaf,inter|a.b.wild.test|~isn't valid for",
        "leaf,inter|wild.test|~isn't valid for",
        "leaf,inter|example.test.evil|~isn't valid for",
        "leaf,inter|127.0.0.2|~isn't valid for",
        "expired,inter|example.test|the certificate for `example.test` expired on 2026-06-01",
        "future,inter|example.test|the certificate for `example.test` isn't valid until 2030-01-01",
        "client_eku,inter|example.test|~isn't for servers",
        "unknown_critical,inter|example.test|~unknown critical extension",
        "self_signed|example.test|~doesn't lead to a trusted root",
        "leaf|example.test|the certificate for `example.test` doesn't lead to a trusted root: it was issued by `AIL Test Intermediate`, which isn't in the system's root store",
        "under_not_ca,not_ca|example.test|~isn't a certificate authority",
        "under_sub_ca,sub_ca,inter|example.test|~intermediate certificate(s) below it",
        "constrained_bad,constrained|x.other.test|~name constraints",
    ]
    for c in cases
        part := c.split("|")
        mut args := "{part[1]} 1798761600 {certs["root"]}"
        for n in part[0].split(",")
            args = "{args} {certs[n]}"
        got := hash.hmac_sha256("chain", args)
        want := part[2]
        good := if want.starts_with("~") then got.contains(want.slice(
            1,
            want.len(),
        )) else got == want
        if good
            ok += 1
        else
            bad += 1
            print("FAIL chain {c}: got {got}")
    print("{ok} ok, {bad} failed")
