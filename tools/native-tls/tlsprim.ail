## Test-only runtime file for tools/native-tls/prim-check.sh: it is copied
## next to the real runtime in a temporary compiler directory, never shipped.
## `tlsprim_call(op, args)` runs one TLS primitive on hex arguments (`-` is
## empty, fields separated by spaces) and returns its output as hex, so the
## vectors of tests/data/net/crypto can be checked natively.

fn tlsprim_nibble(c int) int
    if c >= 48 and c <= 57
        return c - 48
    if c >= 97 and c <= 102
        return c - 87
    c - 55

## The bytes of the hex text `s` as `[address, length]` in a list of two.
fn tlsprim_bytes(s str) List[int]
    p := str_addr(s)
    n := load64(p)
    if n == 1 and load8(p + 16) == 45
        return [alloc_raw(8, KIND_BYTES), 0]
    out := alloc_raw(n / 2 + 8, KIND_BYTES)
    for i in 0..n / 2
        store8(
            out + i,
            tlsprim_nibble(load8(p + 16 + 2 * i)) * 16 + tlsprim_nibble(load8(p + 17 + 2 * i)),
        )
    [out, n / 2]

fn tlsprim_hex(p int, n int) str
    sb_reset()
    for i in 0..n
        b := load8(p + i)
        sb_byte(if b / 16 < 10 then 48 + b / 16 else 87 + b / 16)
        sb_byte(if b % 16 < 10 then 48 + b % 16 else 87 + b % 16)
    sb_str()

## The space-separated fields of `s`, each as `[address, length]`.
fn tlsprim_fields(s str) List[List[int]]
    mut out := List[List[int]]()
    p := str_addr(s)
    n := load64(p)
    mut start := 0
    for i in 0..n + 1
        if i == n or load8(p + 16 + i) == 32
            out.push(tlsprim_bytes(str_sub(p, start, i)))
            start = i + 1
    out

## One line of signatures.txt: `ecdsa_CURVE_HASH` with `public msg sig`, or
## `rsa_pkcs1_HASH` / `rsa_pss_HASH` with `n e msg sig`; "1" if it verifies.
fn tlsprim_verify(op str, f List[List[int]]) str
    alg := if op.ends_with("sha256") then 0 else if op.ends_with("sha384") then 1 else 2
    digest := alloc_raw(64, KIND_BYTES)
    ok := false
    if op.starts_with("ecdsa_")
        curve := if op.starts_with("ecdsa_p256") then 0 else 1
        sig := f[2][0]
        sig_hash(alg, f[1][0], f[1][1], digest)
        # The DER of the signature is read by the same strict parser the TLS client uses (x_ecdsa_sig).
        rs := x_ecdsa_sig(sig, 0, f[2][1])
        if rs.len() == 0
            return "0"
        ok = ecdsa_verify(
            curve,
            f[0][0],
            f[0][1],
            digest,
            sig_hlen(alg),
            sig + rs[0],
            rs[1],
            sig + rs[2],
            rs[3],
        )
    elif op.starts_with("rsa_pss")
        ok = rsa_verify_pss(
            alg,
            f[0][0],
            f[0][1],
            f[1][0],
            f[1][1],
            f[2][0],
            f[2][1],
            f[3][0],
            f[3][1],
        )
    else
        ok = rsa_verify_pkcs1(
            alg,
            f[0][0],
            f[0][1],
            f[1][0],
            f[1][1],
            f[2][0],
            f[2][1],
            f[3][0],
            f[3][1],
        )
    if ok then "1" else "0"

## `chain`: `HOST NOW ROOT CERT...` (HOST text, NOW decimal seconds, ROOT and
## the certificates hex; ROOT `-` for none). "ok" or the verifier's message.
fn tlsprim_chain(args str) str
    w := args.split(" ")
    mut rest := w[2]
    for i in 3..w.len()
        rest = "{rest} {w[i]}"
    f := tlsprim_fields(rest)
    mut roots := List[List[int]]()
    if f[0][1] > 0
        roots.push(x_parse(f[0][0], f[0][1]))
    mut chain := List[List[int]]()
    for i in 1..f.len()
        chain.push(f[i])
    e := tv_chain(chain, roots, w[0], str_to_int(w[1]))
    if e == "" then "ok" else e

## `serverhello BODY`: the ServerHello body (hex, without its 4-byte handshake
## header) through `tc_server_hello` with the session id `e0 e1 .. ff` echoed
## (the id of tests/data/net/tls/illustrated-tls13.txt). "ok", "retry" for a
## HelloRetryRequest, or the client's message. Used by tools/native-tls/fuzz.ail.
fn tlsprim_serverhello(args str) str
    f := tlsprim_fields(args)
    st := obj_new(TS_BYTES, 4)
    for i in 0..TS_BYTES / 8
        store64(st + 8 * i, 0)
    sid := alloc_raw(40, KIND_BYTES)
    for i in 0..32
        store8(sid + i, 224 + i)
    share := alloc_raw(40, KIND_BYTES)
    ck := alloc_raw(32, KIND_BYTES)
    for i in 0..4
        store64(ck + 8 * i, 0)
    e := tc_server_hello(st, f[0][0], f[0][1], sid, share, ck)
    if e == 0
        return "ok"
    if e == 1
        return "retry"
    str_at(load64(st + TS_MSG))

## `aesbench MIB`: seal then open `MIB` MiB of zeros with AES-128-GCM, timed by
## the caller (tools/native-tls/aes-bench.sh); "ok" when the open succeeds.
fn tlsprim_aesbench(args str) str
    mib := args.to_int() else 16
    n := mib * 1048576
    # 1248 bytes is AK_SIZE; the literal also builds against older runtimes.
    ak := alloc_raw(1248, KIND_BYTES)
    key := alloc_raw(16, KIND_BYTES)
    nonce := alloc_raw(12, KIND_BYTES)
    aad := alloc_raw(8, KIND_BYTES)
    plain := alloc_raw(n + 16, KIND_BYTES)
    sealed := alloc_raw(n + 16, KIND_BYTES)
    back := alloc_raw(n + 16, KIND_BYTES)
    for i in 0..16
        store8(key + i, i)
    aes_setup(ak, key, 16)
    aes_gcm_seal(ak, nonce, aad, 0, plain, n, sealed)
    if aes_gcm_open(ak, nonce, aad, 0, sealed, n + 16, back) != 0
        return "open failed"
    "ok"

## ---- timing (tools/native-tls/timing-check.sh, ADR 1118) ----

## Nanoseconds on a clock that does not go back (the same clocks as `lim_now`, with a buffer of its own).
fn tlsprim_now(buf int) int
    t := target()
    if t == 3
        return win_mono_ns()
    if t == 2
        syscall(116, buf, 0, 0, 0, 0, 0)
        return load64(buf) * 1000000000 + load64(buf + 8).bit_and(4294967295) * 1000
    syscall(if t == 0 then 228 else 113, 1, buf, 0, 0, 0, 0)
    load64(buf) * 1000000000 + load64(buf + 8)

## A 31-bit linear congruential byte (not cryptographic: the test only needs inputs that differ).
fn tlsprim_rnd(cell int) int
    x := (load64(cell) * 1103515245 + 12345) % 2147483648
    store64(cell, x)
    x / 65536 % 256

## `n` bytes at `p`: a fixed pattern, or random bytes.
fn tlsprim_fill(p int, n int, random bool, cell int)
    for i in 0..n
        store8(p + i, if random then tlsprim_rnd(cell) else (i * 37 + 11) % 256)

## The control: a comparison that stops at the first difference, which a timing test must flag.
fn tlsprim_naive_eq(a int, b int, n int) bool
    for i in 0..n
        if load8(a + i) != load8(b + i)
            return false
    true

## `OP CLASS REPS SEED`: build REPS inputs of class `fixed` or `random` first (outside the timed part), then time one
## run of the operation over all of them and return the nanoseconds. `ct_eq` and `naive_eq` compare two 64-byte
## buffers (class fixed: equal; class random: different from the first byte); the others vary the secret (a scalar or key).
fn tlsprim_time(args str) str
    w := args.split(" ")
    op := w[0]
    random := w[1] == "random"
    reps := str_to_int(w[2])
    cell := alloc_raw(8, KIND_BYTES)
    store64(cell, str_to_int(w[3]))
    clock := alloc_raw(16, KIND_BYTES)
    a := alloc_raw(64 * reps + 8, KIND_BYTES)
    b := alloc_raw(64 * reps + 8, KIND_BYTES)
    out := alloc_raw(128, KIND_BYTES)
    fixed := alloc_raw(64, KIND_BYTES)
    tlsprim_fill(fixed, 64, false, cell)
    for r in 0..reps
        tlsprim_fill(a + 64 * r, 64, false, cell)
        if op == "ct_eq" or op == "naive_eq"
            tlsprim_fill(b + 64 * r, 64, false, cell)
            if random
                store8(b + 64 * r, load8(b + 64 * r).bit_xor(1 + tlsprim_rnd(cell) % 255))
        else
            # a secret of the class in b (64 bytes cover a 32-byte scalar or key)
            tlsprim_fill(b + 64 * r, 64, random, cell)
    mut sink := 0
    ak := alloc_raw(AK_SIZE, KIND_BYTES)
    t0 := tlsprim_now(clock)
    for r in 0..reps
        if op == "ct_eq"
            if tls_ct_eq(a + 64 * r, b + 64 * r, 64)
                sink += 1
        elif op == "naive_eq"
            if tlsprim_naive_eq(a + 64 * r, b + 64 * r, 64)
                sink += 1
        elif op == "x25519"
            x25519_raw(out, b + 64 * r, fixed)
            sink += load8(out)
        elif op == "chacha"
            chacha_seal(b + 64 * r, fixed, fixed, 0, a + 64 * r, 64, out)
            sink += load8(out)
        elif op == "aesgcm"
            aes_setup(ak, b + 64 * r, 16)
            aes_gcm_seal(ak, fixed, fixed, 0, a + 64 * r, 64, out)
            sink += load8(out)
        elif op == "poly1305"
            poly1305_raw(b + 64 * r, a + 64 * r, 64, out)
            sink += load8(out)
    t1 := tlsprim_now(clock)
    "{t1 - t0} {sink % 2}"

fn tlsprim_call(op str, args str) str
    if op == "time"
        return tlsprim_time(args)
    if op == "chain"
        return tlsprim_chain(args)
    if op == "aesbench"
        return tlsprim_aesbench(args)
    if op == "serverhello"
        return tlsprim_serverhello(args)
    f := tlsprim_fields(args)
    if op == "poly1305"
        out := alloc_raw(16, KIND_BYTES)
        poly1305_raw(f[0][0], f[1][0], f[1][1], out)
        return tlsprim_hex(out, 16)
    if op == "chacha20poly1305"
        n := f[3][1]
        out := alloc_raw(n + 16, KIND_BYTES)
        chacha_seal(f[0][0], f[1][0], f[2][0], f[2][1], f[3][0], n, out)
        back := alloc_raw(n + 16, KIND_BYTES)
        if chacha_open(f[0][0], f[1][0], f[2][0], f[2][1], out, n + 16, back) != 0
            return "open failed"
        if not tls_ct_eq(back, f[3][0], n)
            return "open differs"
        # A flipped bit anywhere in the sealed bytes must fail.
        store8(out, load8(out).bit_xor(1))
        if chacha_open(f[0][0], f[1][0], f[2][0], f[2][1], out, n + 16, back) == 0
            return "tamper accepted"
        store8(out, load8(out).bit_xor(1))
        return tlsprim_hex(out, n + 16)
    if op == "aesgcm"
        n := f[3][1]
        klen := f[0][1]
        ak := alloc_raw(AK_SIZE, KIND_BYTES)
        aes_setup(ak, f[0][0], klen)
        out := alloc_raw(n + 16, KIND_BYTES)
        aes_gcm_seal(ak, f[1][0], f[2][0], f[2][1], f[3][0], n, out)
        back := alloc_raw(n + 16, KIND_BYTES)
        if aes_gcm_open(ak, f[1][0], f[2][0], f[2][1], out, n + 16, back) != 0
            return "open failed"
        if not tls_ct_eq(back, f[3][0], n)
            return "open differs"
        store8(out, load8(out).bit_xor(1))
        if aes_gcm_open(ak, f[1][0], f[2][0], f[2][1], out, n + 16, back) == 0
            return "tamper accepted"
        store8(out, load8(out).bit_xor(1))
        return tlsprim_hex(out, n + 16)
    if op == "aesgcm_open" or op == "chacha_open"
        # `KEY NONCE AAD CT TAG`: the plaintext, or "reject" when the tag does not verify (Wycheproof, ADR 1118).
        n := f[3][1]
        sealed := alloc_raw(n + 24, KIND_BYTES)
        copy_bytes(sealed, f[3][0], n)
        copy_bytes(sealed + n, f[4][0], 16)
        back := alloc_raw(n + 24, KIND_BYTES)
        mut rc := 1
        if op == "chacha_open"
            rc = chacha_open(f[0][0], f[1][0], f[2][0], f[2][1], sealed, n + 16, back)
        else
            ak := alloc_raw(AK_SIZE, KIND_BYTES)
            aes_setup(ak, f[0][0], f[0][1])
            rc = aes_gcm_open(ak, f[1][0], f[2][0], f[2][1], sealed, n + 16, back)
        if rc != 0
            return "reject"
        return tlsprim_hex(back, n)
    if op == "x25519"
        out := alloc_raw(32, KIND_BYTES)
        x25519_raw(out, f[0][0], f[1][0])
        return tlsprim_hex(out, 32)
    if op == "sha256"
        out := alloc_raw(32, KIND_BYTES)
        hash_sha256_raw(f[0][0], f[0][1], out)
        return tlsprim_hex(out, 32)
    if op == "hmac256"
        out := alloc_raw(32, KIND_BYTES)
        kdf_hmac(f[0][0], f[0][1], f[1][0], f[1][1], out)
        return tlsprim_hex(out, 32)
    if op == "hkdf256"
        len := load8(f[3][0]) * 256 + load8(f[3][0] + 1)
        prk := alloc_raw(32, KIND_BYTES)
        kdf_extract(f[0][0], f[0][1], f[1][0], f[1][1], prk)
        out := alloc_raw(len + 8, KIND_BYTES)
        kdf_expand(prk, f[2][0], f[2][1], len, out)
        return tlsprim_hex(out, len)
    if op == "sha384" or op == "sha512"
        out := alloc_raw(64, KIND_BYTES)
        hash_sha512_raw(f[0][0], f[0][1], out, op == "sha512")
        return tlsprim_hex(out, if op == "sha512" then 64 else 48)
    if op == "hmac384"
        out := alloc_raw(48, KIND_BYTES)
        kdh_hmac(48, f[0][0], f[0][1], f[1][0], f[1][1], out)
        return tlsprim_hex(out, 48)
    if op == "hkdf384"
        len := load8(f[3][0]) * 256 + load8(f[3][0] + 1)
        prk := alloc_raw(48, KIND_BYTES)
        kdh_extract(48, f[0][0], f[0][1], f[1][0], f[1][1], prk)
        out := alloc_raw(len + 8, KIND_BYTES)
        kdh_expand(48, prk, f[2][0], f[2][1], len, out)
        return tlsprim_hex(out, len)
    if op == "rfc8448"
        # RFC 8448 section 3: the early secret, then its `derived` secret.
        zeros := alloc_raw(32, KIND_BYTES)
        for i in 0..4
            store64(zeros + 8 * i, 0)
        early := alloc_raw(32, KIND_BYTES)
        kdf_extract(zeros, 0, zeros, 32, early)
        empty := alloc_raw(32, KIND_BYTES)
        hash_sha256_raw(zeros, 0, empty)
        out := alloc_raw(32, KIND_BYTES)
        kdf_derive_secret(early, "derived", empty, out)
        return "{tlsprim_hex(early, 32)} {tlsprim_hex(out, 32)}"
    if op.starts_with("ecdsa_") or op.starts_with("rsa_")
        return tlsprim_verify(op, f)
    "unknown op"
