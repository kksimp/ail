## Random AIL programs for differential checking (ADR 0753): well-typed by
## construction, and with `MISTAKES` chance in 4 of having one typed mistake
## put in, so the diagnostics path is exercised as well as the happy path.
##
##   ail run tools/fuzz/gen/gen.ail N SEED OUTDIR
##
## writes OUTDIR/p0.ail .. p{N-1}.ail; program k comes from seed SEED + k, so a
## seed alone reproduces a program.

## Types of a generated variable: int, bool, str, ints (List[int]), map
## (Map[str, int]), opt (int?), pt (Pt), shape (Shape).
struct Var
    name str
    ty str
    mutable bool

struct Gen
    lines List[str]
    vars List[Var]
    ind int
    fresh int
    loops int
    ## The number of statements before the mistake goes in, and its kind (0: none).
    mistake_at int
    mistake int
    stmts int
    ## Whether the program has the module `geo` (a package, not a single file).
    mods bool

PRELUDE := [
    "struct Pt",
    "    a int",
    "    b int",
    "",
    "fn Pt.sum(self) int",
    "    a + b",
    "",
    "fn Pt.shift(mut self, d int)",
    "    a += d",
    "",
    "enum Shape",
    "    Circle(r int)",
    "    Rect(w int, h int)",
    "    Dot",
    "",
    "fn Shape.area(self) int",
    "    match self",
    "        Circle(r) => 3 * r * r",
    "        Rect(w, h) => w * h",
    "        Dot => 0",
    "",
    "fn mul(a int, b int) int",
    "    a * b",
    "",
    "fn bump(mut n int)",
    "    n += 1",
    "",
    "error enum Fail",
    "    Neg(n int)",
    "",
    "fn check_pos(x int) int ! Fail",
    "    if x < 0",
    "        return Fail.Neg(n: x)",
    "    x",
    "",
    "fn chain(x int) !int",
    "    y := check_pos(x)? \"chain\"",
    "    y + 1",
    "",
    "fn pick(xs List[int], i int) int?",
    "    if i >= 0 and i < xs.len()",
    "        return xs[i]",
    "    none",
    "",
    "struct Stack[T]",
    "    items List[T]",
    "",
    "fn Stack.push(mut self, x T)",
    "    self.items.push(x)",
    "",
    "fn Stack.peek(self) T?",
    "    n := self.items.len()",
    "    if n == 0",
    "        return none",
    "    self.items[n - 1]",
    "",
    "fn Stack.len(self) int",
    "    self.items.len()",
    "",
    "fn Stack[T Ord].max(self) T?",
    "    if self.items.len() == 0",
    "        return none",
    "    mut best := self.items[0]",
    "    for x in self.items",
    "        if x > best",
    "            best = x",
    "    best",
    "",
    "struct Pair[A, B]",
    "    first A",
    "    second B",
    "",
    "fn Pair.swap(self) Pair[B, A]",
    "    Pair(first: self.second, second: self.first)",
    "",
    "trait Area",
    "    fn area(self) int",
    "    fn label(self) str",
    "        \"area \{self.area()}\"",
    "",
    "struct Sq",
    "    side int",
    "",
    "impl Area for Sq",
    "    fn area(self) int",
    "        self.side * self.side",
    "",
    "impl Area for Pt",
    "    fn area(self) int",
    "        self.a * self.b",
    "    fn label(self) str",
    "        \"pt\"",
    "",
    "fn show(x any Area) str",
    "    x.label()",
    "",
    "fn total[T Area](xs List[T]) int",
    "    mut t := 0",
    "    for x in xs",
    "        t += x.area()",
    "    t",
    "",
    "fn inc(x int) int",
    "    x + 1",
    "",
    "fn twice(f fn(int) int, x int) int",
    "    f(f(x))",
    "",
    "fn load(n int) int",
    "    n * 2",
    "",
    "fn largest[T Ord](items List[T]) T",
    "    mut best := items[0]",
    "    for x in items",
    "        if x > best",
    "            best = x",
    "    best",
    "",
]

## Separates a package program's `main.ail` from its `geo/geo.ail`.
MODULE_MARK := "#--- geo/geo.ail"

GEO := [
    "pub struct Vec2",
    "    pub x int",
    "    pub y int",
    "",
    "pub fn add(a int, b int) int",
    "    a + b",
    "",
    "pub fn len2(v Vec2) int",
    "    v.x * v.x + v.y * v.y",
    "",
    "fn hidden(a int) int",
    "    a",
]

fn Gen.emit(mut self, s str)
    self.lines.push("{" ".repeat(4 * self.ind)}{s}")

fn Gen.with_type(self, ty str) List[Var]
    [v for v in self.vars if v.ty == ty]

fn pick_of(xs List[str]) str
    xs[random.int(0, xs.len() - 1)]

fn Gen.var_of(self, ty str) str?
    vs := self.with_type(ty)
    if vs.len() == 0
        return none
    vs[random.int(0, vs.len() - 1)].name

## An expression of type `ty`; `depth` bounds its size.
fn Gen.expr(self, ty str, depth int) str
    deep := depth <= 0
    match ty
        "int" =>
            if v := self.var_of("int")
                if deep or random.int(0, 2) == 0
                    return v
            k := random.int(0, 9)
            if deep or k < 2
                return "{random.int(0, 20)}"
            if k == 2
                return "({self.expr("int", depth - 1)} + {self.expr("int", depth - 1)})"
            if k == 3
                return "({self.expr("int", depth - 1)} - {self.expr("int", depth - 1)})"
            if k == 4
                return "mul({self.expr("int", depth - 1)}, {random.int(1, 5)})"
            if k == 5
                return "({self.expr("int", depth - 1)} % {random.int(2, 9)})"
            if k == 6
                if p := self.var_of("pt")
                    return "{p}.sum()"
            if k == 7
                if xs := self.var_of("ints")
                    return "{xs}.len()"
            if k == 8
                if m := self.var_of("map")
                    return "({m}.get({self.expr("str", 0)}) else 0)"
            if k == 9
                if o := self.var_of("opt")
                    return "({o} else 0)"
            "{random.int(0, 20)}"
        "bool" =>
            if v := self.var_of("bool")
                if deep or random.int(0, 2) == 0
                    return v
            k := random.int(0, 4)
            if deep or k == 0
                return pick_of(["true", "false"])
            if k == 1
                return "{self.expr("int", depth - 1)} {pick_of(["<", "<=", ">", ">=", "==", "!="])} {self.expr("int", depth - 1)}"
            if k == 2
                return "not ({self.expr("bool", depth - 1)})"
            if k == 3
                return "({self.expr("bool", depth - 1)} and {self.expr("bool", depth - 1)})"
            "({self.expr("bool", depth - 1)} or {self.expr("bool", depth - 1)})"
        "str" =>
            if v := self.var_of("str")
                if deep or random.int(0, 2) == 0
                    return v
            k := random.int(0, 3)
            if deep or k == 0
                return pick_of(["\"a\"", "\"b\"", "\"ab\"", "\"\"", "\"Hi\""])
            if k == 1
                return "\"n=\{{self.expr("int", depth - 1)}}\""
            if k == 2
                return "{self.expr("str", depth - 1)}.to_upper()"
            "{self.expr("str", depth - 1)}.trim()"
        "ints" =>
            if v := self.var_of("ints")
                if deep or random.int(0, 2) == 0
                    return v
            "[{self.expr("int", 0)}, {self.expr("int", 0)}, {self.expr("int", 0)}]"
        "opt" =>
            if xs := self.var_of("ints")
                if random.int(0, 1) == 0
                    return "pick({xs}, {self.expr("int", 0)})"
            "pick([1, 2, 3], {self.expr("int", 0)})"
        "pt" =>
            "Pt(a: {self.expr("int", 0)}, b: {self.expr("int", 0)})"
        "shape" =>
            pick_of([
                "Shape.Dot",
                "Shape.Circle(r: {random.int(1, 4)})",
                "Shape.Rect(w: {random.int(1, 4)}, h: {random.int(1, 4)})",
            ])
        _ =>
            "0"

fn Gen.name(mut self) str
    self.fresh += 1
    "v{self.fresh}"

fn Gen.declare(mut self, ty str, mutable bool) str
    n := self.name()
    self.vars.push(Var(name: n, ty: ty, mutable: mutable))
    n

fn Gen.block(mut self, count int)
    saved := self.vars.len()
    self.ind += 1
    for _ in 0..count
        self.stmt()
    # a block must not be empty
    self.emit("print({self.expr("int", 1)})")
    self.ind -= 1
    while self.vars.len() > saved
        self.vars.pop()

fn Gen.stmt(mut self)
    self.stmts += 1
    if self.mistake > 0 and self.stmts == self.mistake_at
        self.wrong()
        return
    k := random.int(0, 31)
    if k <= 2
        ty := pick_of(["int", "bool", "str", "ints", "pt", "shape", "opt"])
        e := self.expr(ty, 2)
        mutable := ty != "opt" and random.int(0, 1) == 0
        n := self.declare(ty, mutable)
        self.emit("{if mutable then "mut " else ""}{n} := {e}")
    elif k == 3
        vs := [v for v in self.vars if v.mutable and v.ty == "int"]
        if vs.len() > 0
            v := vs[random.int(0, vs.len() - 1)]
            self.emit("{v.name} {pick_of(["=", "+=", "-="])} {self.expr("int", 2)}")
        else
            self.emit("print({self.expr("str", 1)})")
    elif k == 4
        self.emit("print({self.expr(pick_of(["int", "bool", "str", "ints"]), 2)})")
    elif k == 5
        self.emit("if {self.expr("bool", 2)}")
        self.block(random.int(1, 2))
        if random.int(0, 1) == 0
            self.emit("else")
            self.block(1)
    elif k == 6
        self.emit("for {self.name()} in 0..{random.int(1, 4)}")
        self.loops += 1
        self.block(random.int(1, 2))
        self.loops -= 1
    elif k == 7
        c := self.declare("int", true)
        self.emit("mut {c} := 0")
        self.emit("while {c} < {random.int(1, 3)}")
        self.loops += 1
        self.ind += 1
        self.emit("{c} += 1")
        self.ind -= 1
        self.block(1)
        self.loops -= 1
    elif k == 8
        if xs := self.var_of("ints")
            self.emit("{pick_of(["mut ", ""])}{self.name()} := {xs}.sorted()")
        else
            self.emit("print(1)")
    elif k == 9
        if sh := self.var_of("shape")
            self.emit("print({sh}.area())")
        else
            self.emit("print(2)")
    elif k == 10
        if sh := self.var_of("shape")
            self.emit("match {sh}")
            self.ind += 1
            self.emit("Circle(r) => print(r)")
            self.emit("Rect(w, h) => print(w + h)")
            self.emit("Dot => print(0)")
            self.ind -= 1
        else
            self.emit("print(3)")
    elif k == 14
        self.emit("print(largest({self.expr("ints", 1)}))")
    elif k == 15
        s := self.name()
        self.emit("mut {s} := Stack(items: {self.expr("ints", 1)})")
        self.emit("{s}.push({self.expr("int", 1)})")
        self.emit("print({s}.peek() else 0)")
        self.emit("print({s}.max() else {self.expr("int", 0)} + {s}.len())")
    elif k == 16
        p := self.name()
        self.emit("{p} := Pair(first: {self.expr("int", 1)}, second: {self.expr("str", 1)})")
        self.emit("print({p}.swap().first)")
        self.emit("print({p}.swap().swap().second)")
    elif k == 17
        self.emit("print(show(Sq(side: {self.expr("int", 1)})))")
        self.emit("print(show(Pt(a: 1, b: {self.expr("int", 1)})))")
    elif k == 18
        self.emit("print(total([Sq(side: 1), Sq(side: {self.expr("int", 1)})]))")
    elif k == 19
        self.emit("print(Sq(side: {self.expr("int", 0)}).area() + Pt(a: 2, b: 3).area())")
    elif k == 20
        self.emit("print(twice(inc, {self.expr("int", 1)}))")
    elif k == 21
        g := self.name()
        self.emit("{g} := inc")
        self.emit("print({g}({self.expr("int", 1)}) + twice({g}, 2))")
    elif k == 22
        t := self.name()
        self.emit("{t} := spawn load({self.expr("int", 1)})")
        self.emit("print({t}.wait() else 0)")
    elif k == 23
        a := self.name()
        self.emit("{a} := Atomic(0)")
        self.emit("{a}.add({self.expr("int", 1)})")
        self.emit("print({a}.load())")
    elif k == 24
        m := self.name()
        self.emit("{m} := Mutex(0)")
        self.emit("with {m} as mut x")
        self.ind += 1
        self.emit("x += {random.int(1, 5)}")
        self.ind -= 1
    elif k == 25
        o := self.name()
        self.emit("mut {o} := [0, 0, 0]")
        self.emit("par for i in 0..3")
        self.ind += 1
        self.emit("{o}[i] = i * {random.int(1, 4)}")
        self.ind -= 1
        self.emit("print({o})")
    elif k == 26
        c := self.name()
        self.emit("{c} := Channel[int](4)")
        self.emit("{c}.send({self.expr("int", 1)})")
        self.emit("{c}.close()")
        self.emit("for v in {c}")
        self.ind += 1
        self.emit("print(v)")
        self.ind -= 1
    elif k == 27 and self.mods
        self.emit("print(geo.add({self.expr("int", 1)}, {self.expr("int", 1)}))")
    elif k == 28 and self.mods
        v := self.name()
        self.emit("{v} := geo.Vec2(x: 1, y: {self.expr("int", 1)})")
        self.emit("print(geo.len2({v}) + {v}.x)")
    elif k == 29
        self.emit("print([q1 * {random.int(1, 4)} + {self.expr("int", 1)} for q1 in 0..{random.int(0, 8)} if q1 % {random.int(2, 3)} != {random.int(0, 1)}])")
    elif k == 30
        self.emit("print([q1 + q2 * {random.int(1, 3)} for q1 in {self.expr("ints", 1)} for q2 in 0..{random.int(0, 4)} if q1 > q2])")
    elif k == 31
        self.emit("print(\{q1 % {random.int(2, 5)} for q1 in 0..{random.int(0, 9)}}.len())")
        self.emit("print(\{q1: q1 * {self.expr("int", 1)} for q1 in 0..{random.int(1, 5)}}[0])")
    elif k == 11
        self.emit("print(chain({self.expr("int", 1)}) else 0)")
    elif k == 12
        if self.loops > 0
            self.emit("if {self.expr("bool", 1)}")
            self.ind += 1
            self.emit(pick_of(["break", "continue"]))
            self.ind -= 1
        else
            self.emit("print(4)")
    else
        self.emit("print({self.expr("int", 2)} {pick_of(["+", "*"])} {self.expr("int", 1)})")

## One typed mistake, of the kind `mistake`.
fn Gen.wrong(mut self)
    iv := self.var_of("int") else "7"
    match self.mistake
        1 => self.emit("{self.name()} := mul({iv})")
        2 => self.emit("bump({iv})")
        3 => self.emit("{pick_of(["x1", "x2"])} := 1")
        4 => self.emit("{self.name()} := {self.name()}")
        5 => self.emit("{self.name()} := {iv} + \"text\"")
        6 => self.emit("{self.name()} := {iv}.nosuch()")
        7 => self.emit("{self.name()} := check_pos({iv})")
        8 => self.emit("{self.name()} := pick([1], 0) else \"x\"")
        9 => self.emit("{self.name()} := pick([1], 0) + 1")
        10 => self.emit("{self.name()} := [1, 2][0] + \"x\"")
        11 => self.emit("return 1")
        12 => self.emit("if {iv}")
        13 => self.emit("break")
        14 => self.emit("{self.name()} := Pt(a: 1, b: 2).zz")
        15 => self.emit("{iv} = \"s\"")
        16 => self.emit("{self.name()} := mul({iv}, {iv}, {iv})")
        17 => self.emit("{self.name()} := Shape.Square")
        18 => self.emit("print({self.name()}.len())")
        19 => self.emit("{self.name()} := chain({iv})")
        20 => self.emit("{self.name()} := largest([Pt(a: 1, b: 2)])")
        21 => self.emit("{self.name()} := Stack(items: [{iv}]).push(\"x\")")
        22 => self.emit("{self.name()} := Pair(first: {iv})")
        23 => self.emit("{self.name()} := largest({iv})")
        24 => self.emit("{self.name()} := Stack(items: [Pt(a: 1, b: 2)]).max()")
        25 => self.emit("{self.name()} := show({iv})")
        26 => self.emit("{self.name()} := total([{iv}])")
        27 => self.emit("{self.name()} := Sq(side: 1).nosuch()")
        28 => self.emit("{self.name()} := Sq(side: 1).area({iv})")
        29 => self.emit("print(0)")
        30 => self.emit("print(0)")
        31 => self.emit("{self.name()} := total(Sq(side: 1))")
        32 => self.emit("{self.name()} := twice(mul, {iv})")
        33 => self.emit("{self.name()} := twice({iv}, {iv})")
        34 => self.emit("{self.name()} := twice(inc)")
        35 => self.emit("{self.name()} := twice(bump, {iv})")
        36 => self.emit("print(twice(inc, 1)(2))")
        37 => self.emit("{self.name()} := spawn load({iv})")
        38 => self.emit("t := spawn load(1)\n{" ".repeat(4 * self.ind)}print(t.wait() else 0)\n{" ".repeat(4 * self.ind)}print(t.wait() else 0)")
        39 => self.emit("mut o := [0, 0, 0]\n{" ".repeat(4 * self.ind)}par for i in 0..3\n{" ".repeat(4 * self.ind)}    o[0] = i")
        40 => self.emit("mut tot := 0\n{" ".repeat(4 * self.ind)}par for i in 0..3\n{" ".repeat(4 * self.ind)}    tot += i")
        41 => self.emit("{self.name()} := Atomic(0).add(\"x\")")
        42 => self.emit("{self.name()} := Channel[int](4).send(\"x\")")
        43 => self.emit("{self.name()} := spawn nosuch(1)")
        44 => self.emit("{self.name()} := geo.hidden({iv})")
        45 => self.emit("{self.name()} := geo.nosuch({iv})")
        46 => self.emit("{self.name()} := geo.add(\"x\", {iv})")
        47 => self.emit("{self.name()} := geo.Vec2(x: {iv})")
        48 => self.emit("{self.name()} := add({iv}, 1)")
        _ => self.emit("{self.name()} := nomod.add({iv}, 1)")

fn program(seed int) str
    random.seed(seed)
    mut g := Gen(
        lines: [],
        vars: [],
        ind: 1,
        fresh: 0,
        loops: 0,
        mistake_at: 0,
        mistake: 0,
        stmts: 0,
        mods: false,
    )
    g.mods = random.int(0, 4) == 0
    if random.int(0, 3) == 0
        g.mistake = random.int(1, if g.mods then 49 else 43)
        g.mistake_at = random.int(1, 12)
    # a few helper functions of two ints, then main
    mut helpers := ""
    for h in 0..random.int(0, 2)
        mut hg := Gen(
            lines: [],
            vars: [],
            ind: 1,
            fresh: 100 * (h + 1),
            loops: 0,
            mistake_at: 0,
            mistake: 0,
            stmts: 0,
            mods: false,
        )
        hg.vars.push(Var(name: "a", ty: "int", mutable: false))
        hg.vars.push(Var(name: "b", ty: "int", mutable: false))
        for _ in 0..random.int(1, 4)
            hg.stmt()
        helpers = "{helpers}fn f{h}(a int, b int) int\n{hg.lines.join("\n")}\n    {hg.expr("int", 2)}\n\n"
    for _ in 0..random.int(4, 14)
        g.stmt()
    bad := match g.mistake
        29 => "struct Bad\n    n int\n\nimpl Area for Bad\n    fn label(self) str\n        \"bad\"\n\n"
        30 => "struct Bad\n    n int\n\nimpl Area for Bad\n    fn area(self) str\n        \"bad\"\n\n"
        _ => ""
    text := "{PRELUDE.join("\n")}\n{bad}{helpers}fn main()\n{g.lines.join("\n")}\n    print(0)\n"
    if g.mods
        return "use geo\n\n{text}{MODULE_MARK}\n{GEO.join("\n")}\n"
    text

fn main() !
    args := env.args()
    if args.len() < 3
        io.eprint("usage: ail run tools/fuzz/gen/gen.ail N SEED OUTDIR")
        io.exit(2)
    n := args[0].to_int() else 0
    seed := args[1].to_int() else 1
    fs.make_dir(args[2])?
    for k in 0..n
        text := program(seed + k)
        if text.contains(MODULE_MARK)
            parts := text.split(MODULE_MARK)
            fs.make_dir("{args[2]}/p{k}")?
            fs.make_dir("{args[2]}/p{k}/geo")?
            fs.write_text("{args[2]}/p{k}/main.ail", parts[0])?
            fs.write_text("{args[2]}/p{k}/geo/geo.ail", parts[1].trim_start())?
        else
            fs.write_text("{args[2]}/p{k}.ail", text)?
