## Doc examples as tests for `ail test` in AIL (RR-4, test.doc.1-3, ADRs 0200,
## 0201), ported from `bootstrap/src/doctest.rs`: each ```` ```ail ```` block in a
## `##` doc comment becomes a test of its own, in the scope of the file.
##
## The runner (ailtest.ail) uses this module's `Verdict` and calls three functions:
##   `doctest.collect(lines)`          the examples of a file, in source order
##   `doctest.augment(file, lines, docs)`  the lines with each example appended as an
##                             `@test fn doc_example_N()`; the copy is checked first, and a
##                             problem in an example stops the run with exit status 2, at the
##                             example's line, as the Rust `ail test` does
##   `doctest.finish(verdicts, docs, base, origin)`  renames the verdicts to `doc:NAME`, compares an
##                             example's output with its `# =>` lines (test.doc.2) and puts a
##                             failure at its line in the doc comment (test.doc.3)
## The runner keeps a passing test's standard output in its verdict's `message`, for `finish`
## to compare and clear.

## One example.
pub struct DocTest
    ## `doc:Type.method` (test.doc.3).
    pub name str
    ## The generated function's name.
    pub fn_name str
    ## The lines `# => text` asked for (test.doc.2).
    pub has_expected bool
    pub expected List[str]
    ## The code, and the line of each code line in the original file.
    pub code List[str]
    pub code_lines List[int]
    ## The line of the opening fence.
    pub fence int

## One test's result.
pub struct Verdict
    pub name str
    pub status str
    pub message str

struct Entry
    line int
    text str

fn ident_end(s str, dots bool) str
    mut out := List[str]()
    for c in s.chars()
        if c.is_alpha() or c.is_digit() or c == '_' or (dots and c == '.')
            out.push(c.to_str())
        else
            break
    out.join("")

fn lead(l str) int
    l.chars().len() - l.trim_start().chars().len()

## `s` without a leading `word `, as many times as it starts with one.
fn drop_words(s str) str
    mut t := s
    for w in ["pub ", "error "]
        if t.starts_with(w)
            t = t.slice(w.chars().len(), t.chars().len())
    t

## `s` without the attributes that start it on its line (`@inline fn f()`).
fn skip_attrs(s str) str
    mut t := s
    while t.starts_with("@")
        mut depth := 0
        mut cut := t.chars().len()
        mut k := 0
        for c in t.chars()
            if c == '(' or c == '['
                depth += 1
            elif c == ')' or c == ']'
                depth -= 1
            elif c == ' ' and depth == 0
                cut = k
                break
            k += 1
        t = t.slice(cut, t.chars().len()).trim_start()
    t

## The name `ail test` gives the example of the declaration on line `i`, or "" when
## the line declares nothing a doc comment attaches to.
fn decl_name(lines List[str], i int) str
    l := lines[i]
    t := drop_words(skip_attrs(l.trim_start()))
    n := lead(l)
    if t.starts_with("fn ")
        return ident_end(t.slice(3, t.chars().len()).trim_start(), true)
    for kw in ["struct ", "enum ", "trait "]
        if t.starts_with(kw)
            return ident_end(t.slice(kw.chars().len(), t.chars().len()).trim_start(), false)
    if n == 0
        name := ident_end(t, false)
        rest := t.slice(name.chars().len(), t.chars().len()).trim_start()
        if name != "" and rest.starts_with(":=")
            return name
        return ""
    # An enum's variant: the first line above it that is less indented heads an enum.
    mut j := i - 1
    while j >= 0
        p := lines[j]
        if p.trim() != "" and not p.trim_start().starts_with("#") and lead(p) < n
            h := drop_words(p.trim_start())
            if h.starts_with("enum ")
                e := ident_end(h.slice(5, h.chars().len()).trim_start(), false)
                v := ident_end(t, false)
                if v != ""
                    return "{e}.{v}"
            return ""
        j -= 1
    ""

## The runnable blocks of one doc comment, unnamed.
fn blocks(run List[Entry]) List[DocTest]
    mut out := List[DocTest]()
    mut open := false
    mut fence := 0
    mut code := List[str]()
    mut code_lines := List[int]()
    for e in run
        t := e.text.trim()
        if not open
            if t == "```ail"
                open = true
                fence = e.line
                code = []
                code_lines = []
        elif t == "```"
            open = false
            mut nonblank := false
            for c in code
                if c.trim() != ""
                    nonblank = true
            if nonblank
                mut expected := List[str]()
                for c in code
                    if c.trim().starts_with("# =>")
                        w := c.trim().slice(4, c.trim().chars().len())
                        expected.push(w.strip_prefix(" ") else w)
                out.push(DocTest(
                    name: "",
                    fn_name: "",
                    has_expected: expected.len() > 0,
                    expected: expected,
                    code: code,
                    code_lines: code_lines,
                    fence: fence,
                ))
        else
            code.push(e.text)
            code_lines.push(e.line)
    out

## The ```` ```ail ```` blocks of every doc comment, in source order (test.doc.1).
## A block tagged anything but exactly `ail` (`ail fragment`, `text`) is not run.
pub fn collect(lines List[str]) List[DocTest]
    mut found := List[DocTest]()
    mut seen := Map[str, int]()
    mut run := List[Entry]()
    for i in 0..lines.len()
        line := lines[i].trim_start()
        if line.starts_with("##")
            text := line.slice(2, line.chars().len())
            run.push(Entry(line: i + 1, text: (text.strip_prefix(" ") else text).trim_end()))
            continue
        if run.len() > 0 and line != "" and not line.starts_with("#")
            name := decl_name(lines, i)
            if name != ""
                for b in blocks(run)
                    n := (seen.get(name) else 0) + 1
                    seen[name] = n
                    label := if n == 1 then "doc:{name}" else "doc:{name}#{n}"
                    found.push(DocTest(
                        name: label,
                        fn_name: "",
                        has_expected: b.has_expected,
                        expected: b.expected,
                        code: b.code,
                        code_lines: b.code_lines,
                        fence: b.fence,
                    ))
        run = []
    mut named := List[DocTest]()
    for k in 0..found.len()
        d := found[k]
        named.push(DocTest(
            name: d.name,
            fn_name: "doc_example_{k + 1}",
            has_expected: d.has_expected,
            expected: d.expected,
            code: d.code,
            code_lines: d.code_lines,
            fence: d.fence,
        ))
    named

## The original line of every appended line, in order.
fn origins(docs List[DocTest]) List[int]
    mut out := List[int]()
    for d in docs
        out.push(d.fence)
        for l in d.code_lines
            out.push(l)
    out

## The source with each example appended as a test (test.doc.1). A problem the checker
## finds in the result ends the run (exit status 2), reported at the example's own line.
pub fn augment(file str, lines List[str], docs List[DocTest]) List[str]
    if docs.len() == 0
        return lines
    mut out := lines
    for d in docs
        out.push("@test fn {d.fn_name}()")
        for c in d.code
            out.push(if c.trim() == "" then "" else "    {c}")
    dir := path.dir(file)
    copy_name := ".ail-doccheck-{path.stem(file)}.ail"
    copy := if dir.is_empty() then copy_name else "{dir}/{copy_name}"
    fs.write_text(copy, "{out.join("\n")}\n") else err
        io.eprint("error: can't write {copy}: {err.kind}")
        io.exit(2)
        return out
    ail := env.get("AIL") else "./ail"
    r := proc.run(ail, ["check", copy]) else
        io.eprint("error: can't run {ail} check")
        io.exit(2)
        return out
    _ := proc.run("rm", ["-f", copy]) else
        io.eprint("note: can't remove {copy}")
        return out
    if r.status != 0
        map := origins(docs)
        mut shown := List[str]()
        for l in r.err.lines()
            mut text := l
            if l.starts_with("{copy}:")
                parts := l.slice(copy.chars().len() + 1, l.chars().len()).split(":")
                at := (parts[0].to_int() else 0) - lines.len() - 1
                if at >= 0 and at < map.len()
                    rest := parts[1..].join(":")
                    text = "{file}:{map[at]}:{rest}"
                else
                    text = "{file}:{parts.join(":")}"
            shown.push(text)
        io.eprint(shown.join("\n"))
        io.exit(2)
    out

## `s` as Rust's `{:?}` writes a string.
fn debug_str(s str) str
    mut out := "\""
    for c in s.chars()
        if c == '"'
            out = "{out}\\\""
        elif c == '\\'
            out = "{out}\\\\"
        elif c == '\n'
            out = "{out}\\n"
        elif c == '\t'
            out = "{out}\\t"
        elif c.code() == 13
            out = "{out}\\r"
        else
            out = "{out}{c}"
    "{out}\""

fn debug_list(xs List[str]) str
    "[{[debug_str(x) for x in xs].join(", ")}]"

## The failure of an example whose output differs from its `# =>` lines (test.doc.2), or "".
fn check_output(d DocTest, output str) str
    if not d.has_expected
        return ""
    got := output.lines()
    if got.len() == d.expected.len()
        mut same := true
        for k in 0..got.len()
            if got[k].trim_end() != d.expected[k].trim_end()
                same = false
        if same
            return ""
    "trap[test.doc.2]: output differs: expected {debug_list(d.expected)}, found {debug_list(got)}"

## Puts a failure's trailing ` at L:C` (a line of the checked copy, `origin` giving the
## line of the examples-appended source each copy line came from) at the line in the doc
## comment it came from (test.doc.3).
fn relocate(message str, docs List[DocTest], base int, origin List[int]) str
    idx := message.rfind(" at ") else return message
    parts := message.slice(idx + 4, message.chars().len()).split(":")
    if parts.len() != 2
        return message
    ln := parts[0].to_int() else return message
    map := origins(docs)
    mut at := ln - 1 - base
    # An assertion names a line of the source with the examples appended; any other trap, a
    # line of the checked copy.
    if not message.contains("assertion failed at ")
        if ln < 1 or ln > origin.len() or origin[ln - 1] < 0
            return message
        at = origin[ln - 1] - base
    if at < 0 or at >= map.len()
        return message
    "{message.slice(0, idx)} at {map[at]}:{parts[1]}"

## The verdicts with the examples under their `doc:NAME`, and every other passing test's
## kept output cleared. `base` is the number of the file's own lines and `origin` the runner's last map from
## the checked copy's lines to the source with the examples appended.
pub fn finish(verdicts List[Verdict], docs List[DocTest], base int, origin List[int]) List[Verdict]
    mut out := List[Verdict]()
    for v in verdicts
        mut hit := -1
        for k in 0..docs.len()
            if docs[k].fn_name == v.name
                hit = k
        if hit < 0
            if v.status == "pass"
                out.push(Verdict(name: v.name, status: v.status, message: ""))
            else
                out.push(v)
            continue
        d := docs[hit]
        if v.status == "pass"
            bad := check_output(d, v.message)
            if bad != ""
                out.push(Verdict(name: d.name, status: "fail", message: "{bad} at {d.fence}:1"))
            else
                out.push(Verdict(name: d.name, status: "pass", message: ""))
        elif v.status == "fail"
            out.push(Verdict(
                name: d.name,
                status: "fail",
                message: relocate(v.message, docs, base, origin),
            ))
        else
            out.push(Verdict(name: d.name, status: v.status, message: v.message))
    out
