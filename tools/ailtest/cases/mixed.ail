error struct Empty
    why str

fn parse(s str) int ! Empty
    if s == ""
        return Empty(why: "empty")
    7

fn add(a int, b int) int
    a + b

@test fn plain()
    assert_eq(add(1, 2), 3)

@test fn reads_ok()
    n := parse("x")?
    assert(n == 7)

@test fn reads_bad()
    n := parse("")?
    assert(n == 7)

@test fn add_commutes(a int, b int)
    assert_eq(add(a, b), add(b, a))

@test fn small(x int)
    assert(x < 10)

@test fn listy(xs List[int], s str, f float, b bool, c char)
    assert(xs.len() < 3 or s.len() < 100)

fn main()
    print("ok")
