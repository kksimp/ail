## `ail test` in AIL (RR-4, ADR 0855, test.run.1-4): checks FILE, builds its
## `@test` functions natively and runs each in its own process.
##   ail run tools/ailtest/ailtest.ail [--json] FILE
## The native backend has no `assert` and refuses to call a `@test` function,
## so the build is of a rewritten copy beside FILE (so its `use` lines
## resolve): `@test` becomes `fn NAME() !`, `assert(c)` and `assert_eq(a, b)`
## become calls of a checking function that knows the line and column, and
## `main` becomes a dispatcher that picks a test by the length of its first
## argument. A test the backend can't build yet is reported `skip` with the
## first construct that blocks it. A test is `fn NAME() !`, so `?` works in it
## (test.attr.4). A property test (test.prop.1-5) takes `int`, `float`, `bool`,
## `char`, `str`, `List`, `Set`, `Map`, optionals, tuples and the file's own
## non-generic structs and enums: this tool generates the inputs (the
## interpreter's splitmix64, sizes and shrinking), runs the binary once per case
## with the inputs as arguments (the binary decodes them with generated
## functions), and shrinks a failing input. A parameter of another type
## (`bytes`, a type from another module) makes the test `skip`. The exit status is 0 if every test that ran passed.
##   ail run tools/ailtest/ailtest.ail [--json] [--cases N] [--seed S] FILE
## `--fuzz NAME [--time MS] [--corpus DIR]` fuzzes the property test NAME with coverage guidance (test.fuzz.1-5).
## `--mutate [--max N]` changes the reached lines of the program one way at a time and reports the changes no test notices (test.mutate.1-5).
## `--contracts` fuzzes every function's `requires` and `ensures` and reports a counterexample (contract.fuzz.1).
## `--affected [--since REV]` runs only the tests that the changes since git revision REV
## (default `HEAD`) can reach, from `ail ask FILE --affected` (test.affected.1).
## Rewriting follows native.test.2.

## The compiler to drive: `$AIL`, else `./ail`.
fn windows() bool
    (env.get("OS") else "") == "Windows_NT"

## The name every scratch directory of this program starts with (ADR 1059); `remove_scrap` removes no other tree.
SCRAP_PREFIX := ".ail-test-"

## `rm -f`: a failure is ignored.
fn rm_file(target str)
    fs.remove(target) else return

## Remove the scratch directory `root` and everything in it, which this program made with `SCRAP_PREFIX` (ADR 1059).
## It refuses any other name, and a symbolic link to a directory is removed as a link (`fs.walk` lists it as a file).
fn remove_scrap(root str)
    if not path.base(root).starts_with(SCRAP_PREFIX)
        return
    files := fs.walk(root) else return
    mut links := Set[str]()
    for f in files
        links.add(f)
    scrap_tree(root, links)

fn scrap_tree(dir str, files Set[str])
    names := fs.list_dir(dir) else return
    for name in names
        p := path.join(dir, name)
        if files.contains(p)
            rm_file(p)
            continue
        scrap_tree(p, files)
    rm_file(dir)

fn ail_path() str
    env.get("AIL") else "./ail"

## How many rounds of dropping tests the backend rejects before giving up.
MAX_ROUNDS := 12

## Time one test may run, in milliseconds.
RUN_LIMIT_MS := 30000

struct Param
    name str
    ty str

struct TestFn
    name str
    first int
    last int
    header int
    ## The header line from `fn` on, without the attributes in front of it.
    head str
    ## The generated parameters only; a fixture's parameter is not one (test.fixture.3).
    params List[Param]
    ## The fixtures the test lists with `@needs`, in order.
    fx List[str]
    ## The arguments of the call, in parameter order: `ail_fN` for a fixture, `ail_aN` for a generated input.
    call List[str]

## A `@fixture` function (test.fixture.1-2): `end` is its teardown function, empty if none.
struct Fixture
    name str
    end str
    first int
    header int
    head str
    can_fail bool

struct Span
    first int
    last int

struct Skipped
    name str
    why str

struct Found
    tests List[TestFn]
    skipped List[Skipped]
    left_out List[Span]
    fixtures List[Fixture]

struct Verdict
    name str
    status str
    message str
    cases int
    seed int
    input str
    snaps List[SnapRec]
    frames str
    ## test.run.2: what the test wrote, `  | ` standard output and `  ! ` standard error lines.
    shown str

fn plain(name str, status str, message str) Verdict
    Verdict(
        name: name,
        status: status,
        message: message,
        cases: 0,
        seed: 0,
        input: "",
        snaps: [],
        frames: "",
        shown: "",
    )

fn indent(l str) int
    l.len() - l.trim_start().len()

## The last line of the block starting at `first` (a column-0 header).
fn block_end(lines List[str], first int) int
    mut last := first
    for j in first + 1..lines.len()
        l := lines[j]
        if l.trim().is_empty() or (l.trim_start().starts_with("#") and indent(l) == 0)
            continue
        if indent(l) == 0
            break
        last = j
    last

## The parts of `text` between top-level commas (outside brackets and parentheses).
fn split_top(text str) List[str]
    mut out := List[str]()
    mut depth := 0
    mut start := 0
    cs := text.chars()
    for j in 0..cs.len() + 1
        if j == cs.len() or (cs[j] == ',' and depth == 0)
            part := text.slice(start, j).trim()
            if not part.is_empty()
                out.push(part)
            start = j + 1
        elif cs[j] == '[' or cs[j] == '('
            depth += 1
        elif cs[j] == ']' or cs[j] == ')'
            depth -= 1
    out

## `name type` pairs, as written in a parameter list or a variant's fields.
fn parse_params(text str) List[Param]
    mut out := List[Param]()
    for part in split_top(text)
        # `a(int, str)`: a tuple type may follow its name with no space.
        mut sp := part.len()
        for k in 0..part.len()
            c := part.slice(k, k + 1)
            if c == " " or c == "("
                sp = k
                break
        out.push(Param(name: part.slice(0, sp), ty: part.slice(sp, part.len()).trim()))
    out

SCALARS := ["int", "float", "bool", "char", "str", "bytes"]

## A variant of an enum, or the one unnamed variant of a struct.
struct Variant
    name str
    fields List[Param]

## A non-generic struct or enum declared in the file.
struct Decl
    name str
    is_enum bool
    variants List[Variant]

## A parameter type: kind is a scalar name, `list`, `set`, `map`, `opt`, `tuple`, `struct` or `enum`.
## A struct's or enum's fields are found through its declaration.
struct Ty
    kind str
    name str
    text str
    kids List[Ty]

fn ty_of(kind str, name str, text str, kids List[Ty]) Ty
    Ty(kind: kind, name: name, text: text, kids: kids)

## The structs and enums declared at column 0 of the file (test.prop.2). Error and generic ones
## are left out, so a parameter of such a type is unsupported.
fn parse_decls(lines List[str]) Map[str, Decl]
    mut out := Map[str, Decl]()
    mut i := 0
    while i < lines.len()
        l := lines[i]
        mut head := l
        if head.starts_with("pub ")
            head = head.slice(4, head.len())
        is_struct := head.starts_with("struct ")
        is_enum := head.starts_with("enum ")
        if is_struct or is_enum
            name := head.slice(head.find(" ") else 0, head.len()).trim()
            last := block_end(lines, i)
            if name.find("[") == none and name.find(" ") == none and name.find("(") == none
                mut variants := List[Variant]()
                mut fields := List[Param]()
                for j in i + 1..last + 1
                    f := lines[j].trim()
                    if f.is_empty()
                        or f.starts_with("#")
                        or f.starts_with("@")
                        or f.starts_with("fn ")
                        continue
                    if indent(lines[j]) != indent(lines[i + 1])
                        continue
                    if is_struct
                        w := f.split(" ")[0]
                        if w != "invariant" and w != "requires"
                            fields.push(Param(name: w, ty: f.slice(w.len(), f.len()).trim()))
                    else
                        po := f.find("(")
                        if po == none
                            variants.push(Variant(name: f, fields: []))
                        elif v := po
                            variants.push(Variant(
                                name: f.slice(0, v),
                                fields: if f.ends_with(")") then parse_params(f.slice(
                                    v + 1,
                                    f.len() - 1,
                                )) else [],
                            ))
                if is_struct
                    variants.push(Variant(name: "", fields: fields))
                out[name] = Decl(name: name, is_enum: is_enum, variants: variants)
            i = last
        i += 1
    out

## The type named by `text`, or none when this runner can't generate it.
fn parse_ty(text str, decls Map[str, Decl]) Ty?
    t := text.trim()
    if t.ends_with("?")
        inner := parse_ty(t.slice(0, t.len() - 1), decls) else return none
        return ty_of("opt", "", t, [inner])
    if t.starts_with("(") and t.ends_with(")")
        mut kids := List[Ty]()
        for part in split_top(t.slice(1, t.len() - 1))
            kids.push(parse_ty(part, decls) else return none)
        return ty_of("tuple", "", t, kids)
    if SCALARS.contains(t)
        return ty_of(t, t, t, [])
    if t.ends_with("]")
        open := t.find("[") else return none
        head := t.slice(0, open)
        mut kids := List[Ty]()
        for part in split_top(t.slice(open + 1, t.len() - 1))
            kids.push(parse_ty(part, decls) else return none)
        if head == "List" and kids.len() == 1
            return ty_of("list", head, t, kids)
        if head == "Set" and kids.len() == 1
            return ty_of("set", head, t, kids)
        if head == "Map" and kids.len() == 2
            return ty_of("map", head, t, kids)
        return none
    if d := decls.get(t)
        return ty_of(if d.is_enum then "enum" else "struct", t, t, [])
    none

## Why a type can't be generated, or "" (test.prop.2). `seen` stops recursive types.
fn why_not(text str, decls Map[str, Decl], mut seen Set[str]) str
    ty := parse_ty(text, decls) else
        return "a property test with a `{text}` parameter (not generated by this runner yet)"
    why_ty(ty, decls, mut seen)

fn why_ty(ty Ty, decls Map[str, Decl], mut seen Set[str]) str
    for k in ty.kids
        r := why_ty(k, decls, mut seen)
        if not r.is_empty()
            return r
    if (ty.kind == "struct" or ty.kind == "enum") and not seen.contains(ty.name)
        seen.add(ty.name)
        for v in decls[ty.name].variants
            for f in v.fields
                r := why_not(f.ty, decls, mut seen)
                if not r.is_empty()
                    return r
    ""

fn bad_params(text str, decls Map[str, Decl]) str
    mut seen := Set[str]()
    for p in parse_params(text)
        if p.ty.is_empty()
            return "a property test with an untyped parameter"
        r := why_not(p.ty, decls, mut seen)
        if not r.is_empty()
            return r
    ""

## The text between the parentheses opened at `open` of `sig`, and what follows the closing one.
fn paren_parts(sig str, open int)(str, str)?
    cs := sig.chars()
    mut depth := 0
    for j in open..cs.len()
        if cs[j] == '('
            depth += 1
        elif cs[j] == ')'
            depth -= 1
            if depth == 0
                return (sig.slice(open + 1, j), sig.slice(j + 1, cs.len()).trim())
    none

struct Synth
    lines List[str]
    names Set[str]
    skipped List[Skipped]

## The effects of function `name`, from `ail effects --json` text; `none` when it isn't listed.
fn effects_of(json str, name str) str?
    key := "\"fn:{name}\":["
    at := json.find(key) else return none
    rest := json.slice(at + key.len(), json.len())
    end := rest.find("]") else return none
    rest.slice(0, end)

## contract.fuzz.1-3: a property test for each free function that has `requires` or
## `ensures` lines. It skips an input that fails the `requires`, and calls the
## function, whose own `ensures` then traps on a counterexample, which the
## property machinery shrinks. A method, a generic function and a function with a `mut`
## or `move` parameter are left alone.
fn contract_tests(lines List[str], effects str) Synth
    mut out := Synth(lines: [], names: Set[str](), skipped: [])
    mut i := 0
    while i < lines.len()
        l := lines[i]
        i += 1
        text := (l.strip_prefix("pub ") else l)
        if not text.starts_with("fn ")
            continue
        sig := text.slice(3, text.len())
        open := sig.find("(") else continue
        name := sig.slice(0, open).trim()
        if name.is_empty() or name.contains(".") or name.contains("[")
            continue
        parts := paren_parts(sig, open) else continue
        mut conds := List[str]()
        mut has_ensures := false
        mut j := i
        while j < lines.len() and indent(lines[j]) > 0
            c := lines[j].trim()
            if c.starts_with("requires ")
                conds.push(c.slice(9, c.len()))
            elif c.starts_with("ensures ")
                has_ensures = true
            else
                break
            j += 1
        if conds.is_empty() and not has_ensures
            continue
        params := parse_params(parts.0)
        mut plain := true
        for p in params
            if p.name == "mut" or p.name == "move"
                plain = false
        if not plain
            continue
        # contract.fuzz.3: a function with effects is not called with generated inputs.
        fx := effects_of(effects, name) else ""
        if fx != ""
            out.skipped.push(Skipped(
                name: "contract_{name}",
                why: "has effects ({fx.replace("\"", "")}), so it isn't run with generated inputs",
            ))
            continue
        args := [p.name for p in params].join(", ")
        fallible := parts.1.contains("!")
        call := if fallible then "_ := {name}({args}) else return" else "_ := {name}({args})"
        test_name := "contract_{name}"
        out.names.add(test_name)
        out.lines.push("")
        out.lines.push("@test fn {test_name}({parts.0})")
        for c in conds
            out.lines.push("    if not ({c})")
            out.lines.push("        return")
        out.lines.push("    {call}")
    out

## `text` without the leading attribute `@NAME` (and its `("ARG")`, returned in `arg`), if it starts with it.
struct Attr
    rest str
    arg str

fn lead_attr(text str, name str) Attr?
    t := text.trim_start()
    key := "@{name}"
    if not t.starts_with(key)
        return none
    mut rest := t.slice(key.len(), t.len())
    mut arg := ""
    if rest.starts_with("(\"")
        close := rest.find("\")") else return none
        arg = rest.slice(2, close)
        rest = rest.slice(close + 2, rest.len())
    elif not rest.is_empty() and not rest.starts_with(" ")
        return none
    Attr(rest: rest.trim_start(), arg: arg)

## `text` with its leading `@NAME` attribute taken off (`@fixture`, `@needs("x")`); unchanged otherwise.
fn strip_attr(text str, name str) str
    a := lead_attr(text, name) else return text
    a.rest

## Every plain `@test fn NAME()`, the property tests, and the `@fixture` functions.
fn find_tests(lines List[str]) Found
    mut found := Found(tests: [], skipped: [], left_out: [], fixtures: [])
    decls := parse_decls(lines)
    mut i := 0
    while i < lines.len()
        l := lines[i]
        if lead_attr(l, "fixture") != none
            mut cur := i
            mut text := l
            mut end := ""
            for _ in 0..16
                if a := lead_attr(text, "fixture")
                    end = a.arg
                    text = a.rest
                elif text.trim().is_empty()
                    mut nxt := -1
                    for j in cur + 1..lines.len()
                        if not lines[j].trim().is_empty()
                            nxt = j
                            break
                    if nxt < 0
                        break
                    cur = nxt
                    text = lines[nxt]
                else
                    break
            if text.starts_with("fn ")
                sig := text.slice(3, text.len())
                if open := sig.find("(")
                    close := sig.find(")") else open
                    found.fixtures.push(Fixture(
                        name: sig.slice(0, open).trim(),
                        end: end,
                        first: i,
                        header: cur,
                        head: text,
                        can_fail: sig.slice(close, sig.len()).contains("!"),
                    ))
        if lead_attr(l, "test") != none or lead_attr(l, "needs") != none
            mut cur := i
            mut text := l
            mut names := List[str]()
            mut saw := false
            for _ in 0..16
                if a := lead_attr(text, "test")
                    saw = true
                    text = a.rest
                elif a := lead_attr(text, "needs")
                    names.push(a.arg)
                    text = a.rest
                elif text.trim().is_empty()
                    mut nxt := -1
                    for j in cur + 1..lines.len()
                        if not lines[j].trim().is_empty()
                            nxt = j
                            break
                    if nxt < 0
                        break
                    cur = nxt
                    text = lines[nxt]
                else
                    break
            if saw and text.starts_with("fn ")
                header := cur
                sig := text.slice(3, text.len())
                if open := sig.find("(")
                    name := sig.slice(0, open).trim()
                    last := block_end(lines, header)
                    # A bare `!` is a test that may fail with `?` (test.attr.4).
                    trimmed := sig.trim_end()
                    core := if trimmed.ends_with(" !") then trimmed.slice(
                        0,
                        trimmed.len() - 2,
                    ).trim_end() else trimmed
                    close := core.len() - 1
                    all := parse_params(sig.slice(open + 1, close))
                    mut gen := List[Param]()
                    mut gen_text := List[str]()
                    mut call := List[str]()
                    for p in all
                        fxi := names.index_of(p.name) else -1
                        if fxi >= 0
                            call.push("ail_f{fxi}")
                        else
                            call.push("ail_a{gen.len()}")
                            gen.push(p)
                            gen_text.push("{p.name} {p.ty}")
                    why := bad_params(gen_text.join(", "), decls)
                    if not core.ends_with(")")
                        found.skipped.push(Skipped(
                            name: name,
                            why: "a signature with a return type",
                        ))
                        found.left_out.push(Span(first: i, last: last))
                    elif not why.is_empty()
                        found.skipped.push(Skipped(name: name, why: why))
                        found.left_out.push(Span(first: i, last: last))
                    else
                        found.tests.push(TestFn(
                            name: name,
                            first: i,
                            last: last,
                            header: header,
                            head: text,
                            params: gen,
                            fx: names,
                            call: call,
                        ))
                    i = last
        i += 1
    found

struct Rewritten
    ## Lines added above the original text.
    lead int
    text str
    ## For each line of `text`, the original line it came from (-1: added).
    origin List[int]

fn contains_line(lines List[str], want str) bool
    for l in lines
        if l.trim_end() == want
            return true
    false

## A parameterless `@test` in a module the file imports (`use NAME`, a directory beside it).
## The module is built from a scratch copy of the directory, where the test is made `pub`
## so the dispatcher in the file's copy can call it as `NAME.test()`.
struct ModTest
    module str
    file str
    t TestFn

struct ModFiles
    fixtures Map[str, List[Fixture]]
    tests List[ModTest]
    skipped List[Skipped]
    lines Map[str, List[str]]

fn use_names(lines List[str]) List[str]
    mut out := List[str]()
    for l in lines
        if l.starts_with("use ")
            n := l.slice(4, l.len()).trim()
            if not n.starts_with("std.")
                and not n.contains(".")
                and not n.is_empty()
                and not out.contains(n)
                out.push(n)
    out

## The tests of the modules `lines` imports from directories under `dir`.
fn module_tests(lines List[str], dir str) ModFiles
    mut out := ModFiles(
        fixtures: Map[str, List[Fixture]](),
        tests: [],
        skipped: [],
        lines: Map[str, List[str]](),
    )
    base := if dir.is_empty() then "." else dir
    for m in use_names(lines)
        for f in (fs.list_dir("{base}/{m}") else []).sorted()
            if not f.ends_with(".ail")
                continue
            src := (fs.read_text("{base}/{m}/{f}") else "").lines()
            found := find_tests(src)
            if found.tests.is_empty() and found.skipped.is_empty()
                continue
            key := "{m}/{f}"
            out.lines[key] = src
            out.fixtures[key] = found.fixtures
            for t in found.tests
                if t.params.is_empty()
                    out.tests.push(ModTest(module: m, file: key, t: t))
                else
                    out.skipped.push(Skipped(
                        name: "{m}.{t.name}",
                        why: "a property test in a module",
                    ))
            for s in found.skipped
                out.skipped.push(Skipped(name: "{m}.{s.name}", why: s.why))
    out

## The function that runs test `t` with its fixtures (test.fixture.4): each is set up in the order
## listed, a setup that fails ends the test as `setup of fixture NAME: ...` with the ones already
## set up torn down, and each teardown is deferred right after its setup so it always runs.
fn fx_wrapper(t TestFn, fixtures List[Fixture]) List[str]
    mut gen := List[str]()
    for g in 0..t.params.len()
        gen.push("ail_a{g} {t.params[g].ty}")
    mut out := ["", "fn ail_fx_{t.name}({gen.join(", ")}) !"]
    for k in 0..t.fx.len()
        for fx in fixtures
            if fx.name != t.fx[k]
                continue
            if fx.can_fail
                out.push("    ail_f{k} := {fx.name}()? \"setup of fixture {fx.name}\"")
            else
                out.push("    ail_f{k} := {fx.name}()")
            if not fx.end.is_empty()
                out.push("    defer {fx.end}(ail_f{k})")
    out.push("    {t.name}({t.call.join(", ")})?")
    out

## The module files of `scratch` with their kept tests made `pub fn NAME() !`; left-out ones are blank.
fn write_modules(scratch str, mf ModFiles, dropped Set[int]) !
    for key in mf.lines.keys()
        mut keep := mf.lines[key]
        for fx in mf.fixtures.get(key) else []
            for j in fx.first..fx.header
                keep[j] = ""
            keep[fx.header] = fx.head
        for i in 0..mf.tests.len()
            if mf.tests[i].file != key
                continue
            t := mf.tests[i].t
            if dropped.contains(i)
                for j in t.first..t.last + 1
                    keep[j] = ""
            else
                for j in t.first..t.header
                    keep[j] = ""
                keep[t.header] = fallible(t.head)
                # `pub` can't carry a bare `!`, so a wrapper reports the failure as an assertion.
                keep.push("")
                keep.push("pub fn ail_run_{t.name}()")
                callee := if t.fx.is_empty() then t.name else "ail_fx_{t.name}"
                keep.push("    {callee}() else err")
                keep.push("        assert_eq(\"\{err}\", \"\")")
                if not t.fx.is_empty()
                    keep.extend(fx_wrapper(t, mf.fixtures.get(key) else []))
        fs.write_text("{scratch}/{key}", keep.join("\n"))? "writing {key}"

## `sig` as a signature that can fail.
fn fallible(sig str) str
    t := sig.trim_end()
    if t.ends_with("!") then t else "{t} !"

## The rewritten copy; left-out tests and `main` become blank lines.
fn rewrite(
    w World,
    lines List[str],
    f Found,
    dropped Set[int],
    mf ModFiles,
    mdropped Set[int],
    snap_lines int,
    keep_main bool,
) Rewritten
    mut keep := lines
    for i in 0..f.tests.len()
        t := f.tests[i]
        if dropped.contains(i)
            for j in t.first..t.last + 1
                keep[j] = ""
        else
            for j in t.first..t.header
                keep[j] = ""
            keep[t.header] = fallible(t.head)
    for fx in f.fixtures
        for j in fx.first..fx.header
            keep[j] = ""
        keep[fx.header] = fx.head
    for r in f.left_out
        for j in r.first..r.last + 1
            keep[j] = ""
    for m in 0..lines.len()
        if lines[m].starts_with("fn main(")
            if keep_main
                # Coverage counts its statements: it stays, never called (test.cover.1).
                keep[m] = "fn ail_main_orig({lines[m].slice(8, lines[m].len())}"
            else
                for j in m..block_end(lines, m) + 1
                    keep[j] = ""
            break
    if snap_lines > 0
        for j in 0..snap_lines.min(keep.len())
            keep[j] = snap_line(keep[j], j + 1)
    rewritten := keep
    mut out := List[str]()
    mut origin := List[int]()
    for l in ["use std.env", "use std.io"]
        if not contains_line(lines, l)
            out.push(l)
            origin.push(-1)
    lead := out.len()
    for j in 0..rewritten.len()
        for piece in rewritten[j].split("\n")
            out.push(piece)
            origin.push(j)
    mut tail := "\nfn main() !\n    ail_args := env.args()\n    k := ail_args[0].len()\n"
    mut slot := 1
    mut done := Set[str]()
    mut decs := ""
    mut wrap := ""
    for i in 0..f.tests.len()
        if dropped.contains(i)
            continue
        t := f.tests[i]
        mut call := List[str]()
        tail = "{tail}    if k == {slot}\n"
        for pi in 0..t.params.len()
            ty := parse_ty(t.params[pi].ty, w.decls) else continue
            decs = "{decs}{decoders(w, ty, mut done)}"
            tail = "{tail}        mut ail_c{pi} := AilCur(i: 0)\n        ail_p{pi} := {decoder_name(ty)}(ail_args[{pi + 1}].split(\"\\u\{1f}\"), mut ail_c{pi})\n"
            call.push("ail_p{pi}")
        callee := if t.fx.is_empty() then t.name else "ail_fx_{t.name}"
        tail = "{tail}        {callee}({call.join(", ")})?\n        io.exit(0)\n"
        if not t.fx.is_empty()
            wrap = "{wrap}{fx_wrapper(t, f.fixtures).join("\n")}\n"
        slot += 1
    for i in 0..mf.tests.len()
        if mdropped.contains(i)
            continue
        mt := mf.tests[i]
        tail = "{tail}    if k == {slot}\n        {mt.module}.ail_run_{mt.t.name}()\n        io.exit(0)\n"
        slot += 1
    tail = "{tail}    io.exit(4)\n"
    if snap_lines > 0
        tail = "{tail}{fs.read_text("{env.get("AIL_ROOT") else "."}/tools/ailtest/snap_rt.ail") else ""}"
    tail = "{tail}{wrap}"
    if not decs.is_empty()
        tail = "{tail}\nstruct AilCur\n    i int\n{decs}"
    for l in tail.split("\n")
        out.push(l)
        origin.push(-1)
    Rewritten(text: out.join("\n"), origin: origin, lead: lead)

fn short(msg str) str
    msg.split("\n").first() else msg

## The first line of a trap or failure, as `trap[RULE]: text at L:C`.
fn describe(err str, lead int) str
    mut first := err.lines().first() else ""
    # Lines the test wrote to standard error come before the trap report.
    for l in err.lines()
        if l.contains(": trap[")
            first = l
            break
    if idx := first.find(": trap[")
        head := first.slice(0, idx)
        parts := head.split(":")
        if parts.len() >= 3
            line := (parts[parts.len() - 2].to_int() else lead) - lead
            return "{first.slice(idx + 2, first.len())} at {line}:{parts[parts.len() - 1]}"
    for l in err.lines()
        if l.starts_with("  at ") and not l.contains(" in ")
            parts := l.split(":")
            if parts.len() >= 3
                if ln := parts[parts.len() - 2].to_int()
                    return "{first} at {ln - lead}:{parts[parts.len() - 1]}"
    first

## `msg` with its ` at L:C` mapped from the augmented source back to FILE's lines.
fn remap_at(msg str, origin List[int]) str
    w := where_at(msg) else return msg
    cut := msg.rfind(" at ") else return msg
    if w.0 < 1 or w.0 > origin.len() or origin[w.0 - 1] <= 0
        return msg
    "{msg.slice(0, cut)} at {origin[w.0 - 1]}:{w.1}"

## What a failed test wrote (test.run.2): standard output as `  | LINE`, then standard error as
## `  ! LINE`, without the trap report, its frames or the snapshot records.
## A line of the trap report's own source excerpt, `  3 | code` or `    | ^`: the verdict prints it itself.
fn is_excerpt_line(l str) bool
    rest := l.trim_start()
    mut i := 0
    while i < rest.len() and rest.slice(i, i + 1) >= "0" and rest.slice(i, i + 1) <= "9"
        i += 1
    tail := rest.slice(i, rest.len()).trim_start()
    tail == "|" or tail.starts_with("| ")

fn shown_of(out str, err str) str
    mut lines := List[str]()
    for l in out.lines()
        lines.push("  | {l}")
    for l in err.lines()
        if l.contains(": trap[")
            or l.starts_with("  at ")
            or l.starts_with("ail-snapshot ")
            or is_excerpt_line(l)
            continue
        lines.push("  ! {l}")
    lines.join("\n")

## The call-stack lines of a trap report, `  at L:C in fn()`, with the copy's lead lines taken off.
fn frames_of(err str, lead int) str
    mut out := List[str]()
    for l in err.lines()
        rest := l.strip_prefix("  at ") else continue
        sp := rest.find(" in ") else continue
        if rest.slice(sp, rest.len()) == " in main()"
            continue
        pos := rest.slice(0, sp).split(":")
        if pos.len() != 2
            continue
        ln := pos[0].to_int() else continue
        out.push("  at {ln - lead}:{pos[1]}{rest.slice(sp, rest.len())}")
    out.join("\n")

## The excerpt of a trap's snapshot: the source line and a caret under the column.
fn snap_excerpt(src List[str], line int, col int) str
    if line < 1 or line > src.len()
        return ""
    gutter := "  {line}"
    "{gutter} | {src[line - 1]}\n{spaces(gutter.len())} | {spaces(col - 1)}^"

## ---- Property tests (test.prop.1-5) ----

## splitmix64 on a wrapping `int` (test.prop.3); the same stream as the interpreter's.
struct Rng
    state int

fn shr_u(x int, n int) int
    x.shr(n).bit_and((1.shl(63 - n) - 1) * 2 + 1)

fn Rng.next(mut self) int
    state = state.wrapping_add(-7046029254386353131)
    mut z := state
    z = z.bit_xor(shr_u(z, 30)).wrapping_mul(-4658895280553007687)
    z = z.bit_xor(shr_u(z, 27)).wrapping_mul(-7723592293110705685)
    z.bit_xor(shr_u(z, 31))

## `x mod n` for the unsigned reading of `x`.
fn mod_u(x int, n int) int
    if x >= 0
        return x % n
    h := shr_u(x, 1)
    ((h % n) * 2 + x.bit_and(1)) % n

fn Rng.below(mut self, n int) int
    if n == 0 then 0 else mod_u(next(), n)

fn Rng.range(mut self, lo int, hi int) int
    lo + below(hi - lo + 1)

## FNV-1a of the name: the default seed (test.prop.3).
fn default_seed(name str) int
    mut h := -3750763034362895579
    for c in name.chars()
        h = h.bit_xor(c.code()).wrapping_mul(1099511628211)
    h

## The decimal text of `x` read as unsigned.
fn unsigned_text(x int) str
    if x >= 0
        return "{x}"
    q := shr_u(x, 1) / 5
    "{q}{x.wrapping_sub(q.wrapping_mul(10))}"

## One generated value. Which fields are used depends on the type: `n` is an int, a bool (0 or 1)
## or an enum's variant index, `x` a float, `s` a char or str, `kids` the elements of a list, set
## (one each) or map (key, value, key, value...), the value of a present optional, or the fields
## of a struct, variant or tuple.
struct Node
    n int
    x float
    s str
    kids List[Node]

fn num_node(n int) Node
    Node(n: n, x: 0.0, s: "", kids: [])

fn flt_node(x float) Node
    Node(n: 0, x: x, s: "", kids: [])

fn txt_node(s str) Node
    Node(n: 0, x: 0.0, s: s, kids: [])

fn kid_node(kids List[Node]) Node
    Node(n: 0, x: 0.0, s: "", kids: kids)

## What generation and shrinking need to know about the file's types.
struct World
    decls Map[str, Decl]

ODD := ['\n', '\t', 'é', 'λ', '日', '"', '\\']

fn gen_char(mut rng Rng) char
    if rng.below(12) == 0
        return ODD[rng.below(ODD.len())]
    char.from_code(rng.range(0x20, 0x7e)) else 'a'

## The fields of a struct, or of a variant of an enum.
fn fields_of(w World, ty Ty, variant int) List[Ty]
    mut out := List[Ty]()
    d := w.decls[ty.name]
    for f in d.variants[variant].fields
        out.push(parse_ty(f.ty, w.decls) else ty)
    out

## The variant with the fewest fields: the simplest one to build.
fn simplest_variant(w World, ty Ty) int
    d := w.decls[ty.name]
    mut best := 0
    for i in 0..d.variants.len()
        if d.variants[i].fields.len() < d.variants[best].fields.len()
            best = i
    best

## Adds `key` (and `val` in a map, `stride` 2) unless the key is there; a map then takes the new value.
fn put(w World, kt Ty, mut kids List[Node], stride int, key Node, val Node)
    ks := tokens(w, kt, key).join("\u{1f}")
    mut i := 0
    while i < kids.len()
        if tokens(w, kt, kids[i]).join("\u{1f}") == ks
            if stride == 2
                kids[i + 1] = val
            return
        i += stride
    kids.push(key)
    if stride == 2
        kids.push(val)

## A random value; `size` grows from 1 to 100 over the run (test.prop.3).
fn gen(w World, ty Ty, mut rng Rng, size int, depth int) Node
    bound := 10 + size * 10
    k := ty.kind
    if k == "int"
        r := rng.below(20)
        if r == 0
            return num_node([0, 1, -1][rng.below(3)])
        if r == 1
            return num_node(rng.range(-2147483648, 2147483648))
        return num_node(rng.range(-bound, bound))
    if k == "float"
        x := if rng.below(20) == 0 then 0.0 else rng.range(
            -bound * 100,
            bound * 100,
        ).to_float() / 100.0
        return flt_node(x)
    if k == "bool"
        return num_node(if rng.below(2) == 0 then 1 else 0)
    if k == "char"
        return txt_node("{gen_char(mut rng)}")
    if k == "str"
        mut text := ""
        for _ in 0..rng.below(size / 4 + 2)
            text = "{text}{gen_char(mut rng)}"
        return txt_node(text)
    if k == "bytes"
        mut octets := List[Node]()
        for _ in 0..rng.below(size / 4 + 2)
            r := rng.below(8)
            if r == 0
                octets.push(num_node(0))
            elif r == 1
                octets.push(num_node(255))
            elif r == 2
                octets.push(num_node(97 + rng.below(26)))
            else
                octets.push(num_node(rng.below(256)))
        return kid_node(octets)
    if k == "list" or k == "set" or k == "map"
        n := if depth >= 3 then 0 else rng.below((size / 10).min(10) + 2)
        mut kids := List[Node]()
        for _ in 0..n
            if k == "list"
                kids.push(gen(w, ty.kids[0], mut rng, size, depth + 1))
            elif k == "set"
                put(
                    w,
                    ty.kids[0],
                    mut kids,
                    1,
                    gen(w, ty.kids[0], mut rng, size, depth + 1),
                    num_node(0),
                )
            else
                key := gen(w, ty.kids[0], mut rng, size, depth + 1)
                put(w, ty.kids[0], mut kids, 2, key, gen(w, ty.kids[1], mut rng, size, depth + 1))
        return kid_node(kids)
    if k == "opt"
        if depth >= 3 or rng.below(4) == 0
            return kid_node([])
        return kid_node([gen(w, ty.kids[0], mut rng, size, depth + 1)])
    if k == "tuple"
        mut kids := List[Node]()
        for kt in ty.kids
            kids.push(gen(w, kt, mut rng, size, depth + 1))
        return kid_node(kids)
    mut v := 0
    if k == "enum"
        v = if depth >= 3 then simplest_variant(
            w,
            ty,
        ) else rng.below(w.decls[ty.name].variants.len())
    mut kids := List[Node]()
    for ft in fields_of(w, ty, v)
        kids.push(gen(w, ft, mut rng, size, depth + 1))
    Node(n: v, x: 0.0, s: "", kids: kids)

## The simplest value of a type, the end of every shrink.
fn minimal(w World, ty Ty) Node
    k := ty.kind
    if k == "int" or k == "bool"
        return num_node(0)
    if k == "float"
        return flt_node(0.0)
    if k == "char"
        return txt_node("a")
    if k == "str"
        return txt_node("")
    if k == "tuple"
        return kid_node([minimal(w, kt) for kt in ty.kids])
    if k == "struct"
        return kid_node([minimal(w, ft) for ft in fields_of(w, ty, 0)])
    if k == "enum"
        return minimal_variant(w, ty, simplest_variant(w, ty))
    kid_node([])

fn minimal_variant(w World, ty Ty, v int) Node
    Node(n: v, x: 0.0, s: "", kids: [minimal(w, ft) for ft in fields_of(w, ty, v)])

## Shorter versions of a sequence of `stride`-sized units: empty, each half, each of the first 8 removed.
fn shorten(kids List[Node], stride int) List[List[Node]]
    mut out := List[List[Node]]()
    u := kids.len() / stride
    if u == 0
        return out
    out.push([])
    if u > 1
        out.push(kids[..u / 2 * stride])
        out.push(kids[u / 2 * stride..])
    for i in 0..u.min(8)
        mut d := List[Node]()
        for j in 0..kids.len()
            if j / stride != i
                d.push(kids[j])
        out.push(d)
    out

fn chars_text(cs List[char], from int, to int) str
    mut out := ""
    for i in from..to
        out = "{out}{cs[i]}"
    out

fn rebuilt(w World, ty Ty, units List[Node]) Node
    mut kids := List[Node]()
    stride := if ty.kind == "map" then 2 else 1
    mut i := 0
    while i < units.len()
        put(
            w,
            ty.kids[0],
            mut kids,
            stride,
            units[i],
            if stride == 2 then units[i + 1] else units[i],
        )
        i += stride
    kid_node(kids)

## Simpler values than `v`, simplest first (test.prop.5).
fn shrinks(w World, ty Ty, v Node) List[Node]
    mut out := List[Node]()
    k := ty.kind
    if k == "int"
        if v.n != 0
            out.push(num_node(0))
            out.push(num_node(v.n / 2))
            if v.n < 0
                out.push(num_node(-v.n))
            out.push(num_node(v.n - (if v.n < 0 then -1 else 1)))
    elif k == "float"
        if v.x != 0.0
            out.push(flt_node(0.0))
            out.push(flt_node(v.x.to_int().to_float()))
            out.push(flt_node(v.x / 2.0))
    elif k == "bool"
        if v.n == 1
            out.push(num_node(0))
    elif k == "char"
        if v.s != "a"
            out.push(txt_node("a"))
    elif k == "str"
        cs := v.s.chars()
        if not cs.is_empty()
            out.push(txt_node(""))
            if cs.len() > 1
                out.push(txt_node(chars_text(cs, 0, cs.len() / 2)))
                out.push(txt_node(chars_text(cs, cs.len() / 2, cs.len())))
            for i in 0..cs.len().min(8)
                out.push(txt_node("{chars_text(cs, 0, i)}{chars_text(cs, i + 1, cs.len())}"))
            for i in 0..cs.len().min(8)
                if cs[i] != 'a'
                    out.push(txt_node("{chars_text(cs, 0, i)}a{chars_text(cs, i + 1, cs.len())}"))
    elif k == "bytes"
        for shorter in shorten(v.kids, 1)
            out.push(kid_node(shorter))
        for i in 0..v.kids.len().min(8)
            if v.kids[i].n != 0
                mut d := v.kids
                d[i] = num_node(0)
                out.push(kid_node(d))
    elif k == "list" or k == "set" or k == "map"
        stride := if k == "map" then 2 else 1
        for shorter in shorten(v.kids, stride)
            out.push(if k == "list" then kid_node(shorter) else rebuilt(w, ty, shorter))
        u := v.kids.len() / stride
        for i in 0..u.min(8)
            mut taken := 0
            for sv in shrinks(w, ty.kids[0], v.kids[i * stride])
                if taken == (if k == "map" then 2 else 3)
                    break
                taken += 1
                mut d := v.kids
                d[i * stride] = sv
                out.push(if k == "list" then kid_node(d) else rebuilt(w, ty, d))
            if k == "map"
                taken = 0
                for sv in shrinks(w, ty.kids[1], v.kids[i * 2 + 1])
                    if taken == 3
                        break
                    taken += 1
                    mut d := v.kids
                    d[i * 2 + 1] = sv
                    out.push(rebuilt(w, ty, d))
    elif k == "opt"
        if not v.kids.is_empty()
            out.push(kid_node([]))
            for sv in shrinks(w, ty.kids[0], v.kids[0])
                out.push(kid_node([sv]))
    elif k == "tuple" or k == "struct" or k == "enum"
        mut fts := ty.kids
        if k != "tuple"
            fts = fields_of(w, ty, v.n)
        if k == "enum"
            for earlier in 0..v.n
                out.push(minimal_variant(w, ty, earlier))
        for j in 0..v.kids.len()
            for sv in shrinks(w, fts[j], v.kids[j])
                mut d := v.kids
                d[j] = sv
                out.push(Node(n: v.n, x: 0.0, s: "", kids: d))
    out

## The values' text forms (trait.auto.2), as `ail test` reports an input.
fn show(w World, ty Ty, v Node) str
    k := ty.kind
    if k == "int"
        return "{v.n}"
    if k == "float"
        return "{v.x}"
    if k == "bool"
        return if v.n == 1 then "true" else "false"
    if k == "char"
        return "'{escape(v.s, "'")}'"
    if k == "str"
        return "\"{escape(v.s, "\"")}\""
    if k == "bytes"
        mut text := "b\""
        for o in v.kids
            text = "{text}{byte_text(o.n)}"
        return "{text}\""
    if k == "list"
        return "[{[show(w, ty.kids[0], x) for x in v.kids].join(", ")}]"
    if k == "set"
        return "\{{[show(w, ty.kids[0], x) for x in v.kids].join(", ")}}"
    if k == "map"
        mut parts := List[str]()
        for i in 0..v.kids.len() / 2
            parts.push("{show(w, ty.kids[0], v.kids[i * 2])}: {show(w, ty.kids[1], v.kids[i * 2 + 1])}")
        return "\{{parts.join(", ")}}"
    if k == "opt"
        return if v.kids.is_empty() then "none" else show(w, ty.kids[0], v.kids[0])
    if k == "tuple"
        return "({[show(w, ty.kids[j], v.kids[j]) for j in 0..v.kids.len()].join(", ")})"
    d := w.decls[ty.name]
    vr := d.variants[v.n]
    fts := fields_of(w, ty, v.n)
    mut parts := List[str]()
    for j in 0..v.kids.len()
        parts.push("{vr.fields[j].name}: {show(w, fts[j], v.kids[j])}")
    head := if k == "enum" then "{ty.name}.{vr.name}" else ty.name
    if parts.is_empty() then head else "{head}({parts.join(", ")})"

## One byte inside a `b"..."` literal (type.bytes.2).
fn byte_text(n int) str
    if n == 34
        return "\\\""
    if n == 92
        return "\\\\"
    if n == 10
        return "\\n"
    if n == 9
        return "\\t"
    if n == 13
        return "\\r"
    if n >= 32 and n <= 126
        return "{char.from_code(n) else 'a'}"
    "\\x{if n < 16 then "0" else ""}{n.to_hex()}"

fn escape(s str, quote str) str
    mut out := ""
    for c in s.chars()
        t := "{c}"
        if t == "\n"
            out = "{out}\\n"
        elif t == "\t"
            out = "{out}\\t"
        elif t == "\\"
            out = "{out}\\\\"
        elif t == quote
            out = "{out}\\{t}"
        else
            out = "{out}{t}"
    out

## The command-line form of a value: tokens that the test binary's decoder reads back in order.
fn tokens(w World, ty Ty, v Node) List[str]
    mut out := List[str]()
    k := ty.kind
    if k == "int"
        out.push("{v.n}")
    elif k == "bool"
        out.push(if v.n == 1 then "true" else "false")
    elif k == "float"
        out.push("{v.x}")
    elif k == "char" or k == "str"
        out.push(v.s)
    elif k == "bytes"
        mut hex := ""
        for o in v.kids
            hex = "{hex}{if o.n < 16 then "0" else ""}{o.n.to_hex()}"
        out.push(hex)
    elif k == "list" or k == "set"
        out.push("{v.kids.len()}")
        for x in v.kids
            out.extend(tokens(w, ty.kids[0], x))
    elif k == "map"
        out.push("{v.kids.len() / 2}")
        for i in 0..v.kids.len()
            out.extend(tokens(w, ty.kids[i % 2], v.kids[i]))
    elif k == "opt"
        out.push(if v.kids.is_empty() then "0" else "1")
        for x in v.kids
            out.extend(tokens(w, ty.kids[0], x))
    elif k == "tuple"
        for j in 0..v.kids.len()
            out.extend(tokens(w, ty.kids[j], v.kids[j]))
    else
        if k == "enum"
            out.push("{v.n}")
        fts := fields_of(w, ty, v.n)
        for j in 0..v.kids.len()
            out.extend(tokens(w, fts[j], v.kids[j]))
    out

## A name for the decoder of a type, made of letters, digits and `_`.
fn mangle(text str) str
    mut out := ""
    for c in text.chars()
        t := "{c}"
        if c.is_alpha() or c.is_digit() or c == '_'
            out = "{out}{t}"
        elif c == '['
            out = "{out}_L"
        elif c == ']'
            out = "{out}_R"
        elif c == ','
            out = "{out}_C"
        elif c == '?'
            out = "{out}_Q"
        elif c == '('
            out = "{out}_T"
        elif c == ')'
            out = "{out}_E"
    out

fn decoder_name(ty Ty) str
    "ail_d_{mangle(ty.text)}"

## The decoder functions (source text) that read a value of `ty` from tokens, with the ones its
## parts need. `done` holds the types that already have one.
fn decoders(w World, ty Ty, mut done Set[str]) str
    if done.contains(ty.text)
        return ""
    done.add(ty.text)
    mut out := ""
    for kt in ty.kids
        out = "{out}{decoders(w, kt, mut done)}"
    k := ty.kind
    if k == "struct" or k == "enum"
        for vi in 0..w.decls[ty.name].variants.len()
            for ft in fields_of(w, ty, vi)
                out = "{out}{decoders(w, ft, mut done)}"
    mut body := ""
    if k == "int"
        body = "    x := t[c.i].to_int() else 0\n    c.i += 1\n    x\n"
    elif k == "float"
        body = "    x := t[c.i].to_float() else 0.0\n    c.i += 1\n    x\n"
    elif k == "bool"
        body = "    x := t[c.i] == \"true\"\n    c.i += 1\n    x\n"
    elif k == "char"
        body = "    x := t[c.i].chars()[0]\n    c.i += 1\n    x\n"
    elif k == "str"
        body = "    x := t[c.i]\n    c.i += 1\n    x\n"
    elif k == "bytes"
        body = "    x := bytes.from_hex(t[c.i]) else b\"\"\n    c.i += 1\n    x\n"
    elif k == "list" or k == "set"
        add := if k == "list" then "push" else "add"
        body = "    n := t[c.i].to_int() else 0\n    c.i += 1\n    mut out := {ty.text}()\n    for _ in 0..n\n        out.{add}({decoder_name(ty.kids[0])}(t, mut c))\n    out\n"
    elif k == "map"
        body = "    n := t[c.i].to_int() else 0\n    c.i += 1\n    mut out := {ty.text}()\n    for _ in 0..n\n        key := {decoder_name(ty.kids[0])}(t, mut c)\n        out[key] = {decoder_name(ty.kids[1])}(t, mut c)\n    out\n"
    elif k == "opt"
        body = "    flag := t[c.i]\n    c.i += 1\n    if flag == \"1\"\n        return {decoder_name(ty.kids[0])}(t, mut c)\n    none\n"
    elif k == "tuple"
        mut names := List[str]()
        for j in 0..ty.kids.len()
            body = "{body}    a{j} := {decoder_name(ty.kids[j])}(t, mut c)\n"
            names.push("a{j}")
        body = "{body}    ({names.join(", ")})\n"
    elif k == "struct"
        body = struct_body(w, ty, 0, ty.name)
    else
        body = "    v := t[c.i].to_int() else 0\n    c.i += 1\n"
        d := w.decls[ty.name]
        for vi in 0..d.variants.len()
            vr := d.variants[vi]
            last := vi == d.variants.len() - 1
            if not last
                body = "{body}    if v == {vi}\n"
            inner := struct_body(w, ty, vi, "{ty.name}.{vr.name}")
            for l in inner.split("\n")
                if not l.is_empty()
                    body = "{body}{if last then "" else "    "}{l}\n"
    "{out}\nfn {decoder_name(ty)}(t List[str], mut c AilCur) {ty.text}\n{body}"

## Statements that read the fields of one variant (or a struct) and build it; the last is the value.
fn struct_body(w World, ty Ty, variant int, ctor str) str
    mut body := ""
    fts := fields_of(w, ty, variant)
    fs := w.decls[ty.name].variants[variant].fields
    mut args := List[str]()
    for j in 0..fts.len()
        body = "{body}    f{j} := {decoder_name(fts[j])}(t, mut c)\n"
        args.push("{fs[j].name}: f{j}")
    if args.is_empty()
        return "{body}    return {ctor}\n"
    "{body}    return {ctor}({args.join(", ")})\n"

struct Prop
    status str
    message str
    cases int
    input str

## Runs the binary on one input: none when it passes, else the failure line.
fn try_case(w World, lead int, exe str, slot int, t TestFn, tys List[Ty], args List[Node]) str?
    try_case_in(w, lead, exe, slot, tys, args, List[str]())

## `try_case` with the environment variables `envs` set for the run (`NAME=VALUE` each).
fn try_case_in(
    w World,
    lead int,
    exe str,
    slot int,
    tys List[Ty],
    args List[Node],
    envs List[str],
) str?
    mut all := [["x" for _ in 0..slot].join("")]
    for i in 0..args.len()
        all.push(tokens(w, tys[i], args[i]).join("\u{1f}"))
    mut prog := exe
    mut argv := all
    if not envs.is_empty()
        prog = "env"
        argv = envs
        argv.push(exe)
        argv.extend(all)
    r := proc.run(prog, argv, none, RUN_LIMIT_MS) else
        return "error: can't start the test binary"
    if r.status == 0
        return none
    if r.status == 4
        return "error: no such test"
    describe(r.err, lead)

## The parsed parameter types of `t`, or none when one is not generatable.
fn param_tys(w World, t TestFn) List[Ty]?
    mut tys := List[Ty]()
    for p in t.params
        tys.push(parse_ty(p.ty, w.decls) else return none)
    tys

## Shrinks a failing input (test.prop.5): the smallest `args` that still fail, and the failure line.
fn shrink_input(
    w World,
    lead int,
    exe str,
    slot int,
    t TestFn,
    tys List[Ty],
    first List[Node],
    first_fail str,
)(List[Node], str)
    mut args := first
    mut fail := first_fail
    mut budget := 2000
    mut again := true
    while again and budget > 0
        again = false
        for i in 0..args.len()
            if again or budget == 0
                break
            for cand in shrinks(w, tys[i], args[i])
                if budget == 0
                    break
                budget -= 1
                mut trial := args
                trial[i] = cand
                if f := try_case(w, lead, exe, slot, t, tys, trial)
                    args = trial
                    fail = f
                    again = true
                    break
    (args, fail)

fn run_prop(w World, lead int, exe str, slot int, t TestFn, cases int, seed int) Prop
    mut rng := Rng(state: seed)
    tys := param_tys(w, t) else return Prop(
        status: "fail",
        message: "error: unsupported type",
        cases: 0,
        input: "",
    )
    for n in 1..cases + 1
        size := 1 + (n - 1) * 99 / (cases.max(2) - 1)
        mut args := List[Node]()
        for ty in tys
            args.push(gen(w, ty, mut rng, size, 0))
        fail := try_case(w, lead, exe, slot, t, tys, args) else continue
        small := shrink_input(w, lead, exe, slot, t, tys, args, fail)
        mut shown := List[str]()
        for i in 0..small.0.len()
            shown.push("{t.params[i].name} = {show(w, tys[i], small.0[i])}")
        return Prop(status: "fail", message: small.1, cases: n, input: shown.join(", "))
    Prop(status: "pass", message: "", cases: cases, input: "")

## ---- Coverage-guided fuzzing of a property test (test.fuzz.1-5, ADR 1015) ----

## A mutated copy of `v` (test.fuzz.2): a small step on a number, an edit of a string, an element
## added, dropped or changed in a collection, one field of a struct changed.
fn mutate(w World, ty Ty, v Node, mut rng Rng, depth int) Node
    k := ty.kind
    if k == "int"
        edge := [0, 1, -1, 255, 256, 65535, 2147483647, -2147483648, 4294967295]
        picks := [
            v.n.wrapping_add(1),
            v.n.wrapping_sub(1),
            v.n.wrapping_mul(2),
            0.wrapping_sub(v.n),
            v.n / 2,
            rng.range(-256, 256),
            v.n.wrapping_add(rng.range(-16, 16)),
            edge[rng.below(edge.len())],
        ]
        return num_node(picks[rng.below(picks.len())])
    if k == "float"
        picks := [
            v.x + 1.0,
            v.x - 1.0,
            0.0 - v.x,
            0.0,
            v.x / 2.0,
            rng.range(-100000, 100000).to_float() / 100.0,
        ]
        return flt_node(picks[rng.below(picks.len())])
    if k == "bool"
        return num_node(1 - v.n)
    if k == "char"
        return txt_node("{gen_char(mut rng)}")
    if k == "str"
        cs := v.s.chars()
        r := rng.below(3)
        if cs.len() > 200 or (r == 1 and not cs.is_empty())
            cut := rng.below(cs.len())
            return txt_node("{chars_text(cs, 0, cut)}{chars_text(cs, cut + 1, cs.len())}")
        if r == 2 and not cs.is_empty()
            cut := rng.below(cs.len())
            head := chars_text(cs, 0, cut)
            return txt_node("{head}{gen_char(mut rng)}{chars_text(cs, cut + 1, cs.len())}")
        at := rng.below(cs.len() + 1)
        return txt_node("{chars_text(cs, 0, at)}{gen_char(mut rng)}{chars_text(cs, at, cs.len())}")
    if k == "bytes"
        mut octets := v.kids
        if octets.is_empty() or rng.below(3) == 0
            octets.push(num_node(rng.below(256)))
        elif rng.below(2) == 0
            octets.remove_at(rng.below(octets.len()))
        else
            at := rng.below(octets.len())
            octets[at] = num_node(rng.below(256))
        return kid_node(octets)
    if k == "list" or k == "set" or k == "map"
        stride := if k == "map" then 2 else 1
        count := v.kids.len() / stride
        r := rng.below(4)
        if count == 0 or r == 0 or depth >= 3
            mut grown := v.kids
            fresh := gen(w, ty.kids[0], mut rng, 20, depth + 1)
            if k == "list"
                grown.push(fresh)
            elif k == "set"
                put(w, ty.kids[0], mut grown, 1, fresh, num_node(0))
            else
                put(w, ty.kids[0], mut grown, 2, fresh, gen(w, ty.kids[1], mut rng, 20, depth + 1))
            return kid_node(grown)
        i := rng.below(count)
        mut units := List[Node]()
        for j in 0..count * stride
            if j / stride != i
                units.push(v.kids[j])
        if r == 1
            return rebuilt(w, ty, units)
        if k == "list"
            mut same := v.kids
            moved := mutate(w, ty.kids[0], v.kids[i], mut rng, depth + 1)
            same[i] = moved
            return kid_node(same)
        if k == "map" and rng.below(2) == 0
            mut same := v.kids
            moved := mutate(w, ty.kids[1], v.kids[i * 2 + 1], mut rng, depth + 1)
            same[i * 2 + 1] = moved
            return kid_node(same)
        moved := mutate(w, ty.kids[0], v.kids[i * stride], mut rng, depth + 1)
        mut rest := units
        put(
            w,
            ty.kids[0],
            mut rest,
            stride,
            moved,
            if stride == 2 then v.kids[i * 2 + 1] else num_node(0),
        )
        return kid_node(rest)
    if k == "opt"
        if v.kids.is_empty()
            return kid_node([gen(w, ty.kids[0], mut rng, 20, depth + 1)])
        if rng.below(4) == 0
            return kid_node([])
        return kid_node([mutate(w, ty.kids[0], v.kids[0], mut rng, depth + 1)])
    if k == "tuple"
        mut same := v.kids
        j := rng.below(same.len())
        moved := mutate(w, ty.kids[j], v.kids[j], mut rng, depth + 1)
        same[j] = moved
        return kid_node(same)
    if k == "enum" and rng.below(4) == 0
        return gen(w, ty, mut rng, 20, depth)
    fts := fields_of(w, ty, v.n)
    if fts.is_empty()
        return v
    j := rng.below(fts.len())
    mut same := v.kids
    moved := mutate(w, fts[j], v.kids[j], mut rng, depth + 1)
    same[j] = moved
    Node(n: v.n, x: 0.0, s: "", kids: same)

## A corpus token (test.fuzz.3): `\`, a newline and a return are written as `\\`, `\n` and `\r`.
fn tok_escape(s str) str
    mut out := ""
    for c in s.chars()
        t := "{c}"
        if t == "\\"
            out = "{out}\\\\"
        elif t == "\n"
            out = "{out}\\n"
        elif t == "\r"
            out = "{out}\\r"
        else
            out = "{out}{t}"
    out

fn tok_unescape(s str) str
    mut out := ""
    mut esc := false
    for c in s.chars()
        t := "{c}"
        if esc
            if t == "n"
                out = "{out}\n"
            elif t == "r"
                out = "{out}\r"
            else
                out = "{out}{t}"
            esc = false
        elif t == "\\"
            esc = true
        else
            out = "{out}{t}"
    out

## A corpus file (test.fuzz.3): one `=TOKEN` line per token of the arguments, in order.
fn corpus_text(w World, tys List[Ty], args List[Node]) str
    mut out := ""
    for i in 0..args.len()
        for t in tokens(w, tys[i], args[i])
            out = "{out}={tok_escape(t)}\n"
    out

## The octets of a hex text, or none.
fn hex_octets(h str) List[Node]?
    cs := h.chars()
    if cs.len() % 2 != 0
        return none
    mut out := List[Node]()
    mut i := 0
    while i < cs.len()
        hi := cs[i].to_digit(16) else return none
        lo := cs[i + 1].to_digit(16) else return none
        out.push(num_node(hi * 16 + lo))
        i += 2
    out

## The value of type `ty` that the tokens `t` hold from `at` on (the inverse of `tokens`), or none.
fn untokens(w World, ty Ty, t List[str], mut at int) Node?
    if at >= t.len()
        return none
    k := ty.kind
    if k == "int"
        n := t[at].to_int() else return none
        at += 1
        return num_node(n)
    if k == "float"
        x := t[at].to_float() else return none
        at += 1
        return flt_node(x)
    if k == "bool"
        b := t[at] == "true"
        at += 1
        return num_node(if b then 1 else 0)
    if k == "char" or k == "str"
        text := t[at]
        at += 1
        return txt_node(text)
    if k == "bytes"
        octets := hex_octets(t[at]) else return none
        at += 1
        return kid_node(octets)
    if k == "list" or k == "set" or k == "map"
        count := t[at].to_int() else return none
        if count < 0 or count > 100000
            return none
        at += 1
        mut kids := List[Node]()
        for _ in 0..count
            kids.push(untokens(w, ty.kids[0], t, mut at) else return none)
            if k == "map"
                kids.push(untokens(w, ty.kids[1], t, mut at) else return none)
        return kid_node(kids)
    if k == "opt"
        flag := t[at]
        at += 1
        if flag != "1"
            return kid_node([])
        return kid_node([untokens(w, ty.kids[0], t, mut at) else return none])
    if k == "tuple"
        mut kids := List[Node]()
        for kt in ty.kids
            kids.push(untokens(w, kt, t, mut at) else return none)
        return kid_node(kids)
    mut v := 0
    if k == "enum"
        v = t[at].to_int() else return none
        if v < 0 or v >= w.decls[ty.name].variants.len()
            return none
        at += 1
    mut kids := List[Node]()
    for ft in fields_of(w, ty, v)
        kids.push(untokens(w, ft, t, mut at) else return none)
    Node(n: v, x: 0.0, s: "", kids: kids)

## The arguments a corpus file holds, or none when it does not fit the parameters.
fn corpus_args(w World, tys List[Ty], text str) List[Node]?
    mut toks := List[str]()
    for l in text.lines()
        if l.starts_with("=")
            toks.push(tok_unescape(l.slice(1, l.len())))
    mut at := 0
    mut args := List[Node]()
    for ty in tys
        args.push(untokens(w, ty, toks, mut at) else return none)
    if at != toks.len()
        return none
    args

struct FuzzRun
    fail str?
    ids Set[int]

## One run of the instrumented binary: the failure line, if any, and the ids of the statements it ran.
fn fuzz_case(w World, lead int, exe str, slot int, tys List[Ty], args List[Node], hits str) !FuzzRun
    fs.write_text(hits, "")?
    fail := try_case_in(w, lead, exe, slot, tys, args, ["AIL_INSTRUMENT_OUT={hits}"])
    FuzzRun(fail: fail, ids: hit_ids(hits))

## Fuzzes the property test `t` (test.fuzz.1-5): inputs that reach a statement no earlier input did
## are kept (and written to `dir` when there is one), the next inputs are mutations of the kept ones,
## and the first failure is shrunk (test.prop.5) and written to `dir`. Stops after `max_ms`
## milliseconds or `max_runs` runs (when above 0).
fn run_fuzz(
    w World,
    lead int,
    exe str,
    slot int,
    t TestFn,
    hits str,
    dir str,
    max_ms int,
    max_runs int,
    seed int,
) !Prop
    tys := param_tys(w, t) else return Prop(
        status: "fail",
        message: "error: unsupported type",
        cases: 0,
        input: "",
    )
    mut rng := Rng(state: seed)
    mut seen := Set[int]()
    mut corpus := List[List[Node]]()
    mut queue := List[List[Node]]()
    mut known := Set[str]()
    if not dir.is_empty()
        fs.make_dir(dir)?
        for name in fs.list_dir(dir)?.sorted()
            body := fs.read_text("{dir}/{name}") else continue
            if a := corpus_args(w, tys, body)
                queue.push(a)
                known.add(body)
    mut first := List[Node]()
    for ty in tys
        first.push(minimal(w, ty))
    queue.push(first)
    start := time.now_ms()
    mut runs := 0
    while true
        if max_runs > 0 and runs >= max_runs
            break
        if time.now_ms() - start >= max_ms
            break
        mut args := List[Node]()
        if runs < queue.len()
            args = queue[runs]
        elif corpus.is_empty() or rng.below(10) == 0
            for ty in tys
                args.push(gen(w, ty, mut rng, 1 + rng.below(100), 0))
        else
            args = corpus[rng.below(corpus.len())]
            for _ in 0..1 + rng.below(3)
                j := rng.below(args.len())
                moved := mutate(w, tys[j], args[j], mut rng, 0)
                args[j] = moved
        runs += 1
        res := fuzz_case(w, lead, exe, slot, tys, args, hits)?
        if fail := res.fail
            small := shrink_input(w, lead, exe, slot, t, tys, args, fail)
            body := corpus_text(w, tys, small.0)
            if not dir.is_empty() and not known.contains(body)
                path := "{dir}/crash-{unsigned_text(default_seed(body))}"
                fs.write_text(path, body)?
                io.eprint("fuzz: wrote {path}")
            mut shown := List[str]()
            for i in 0..small.0.len()
                shown.push("{t.params[i].name} = {show(w, tys[i], small.0[i])}")
            return Prop(status: "fail", message: small.1, cases: runs, input: shown.join(", "))
        mut fresh := false
        for id in res.ids.sorted()
            if not seen.contains(id)
                seen.add(id)
                fresh = true
        if fresh
            corpus.push(args)
            body := corpus_text(w, tys, args)
            if not dir.is_empty() and not known.contains(body)
                fs.write_text("{dir}/id-{unsigned_text(default_seed(body))}", body)?
                known.add(body)
    io.eprint("fuzz {t.name}: {runs} runs, {corpus.len()} kept, {seen.len()} statements reached")
    Prop(status: "pass", message: "", cases: runs, input: "")

## Run the test binary on `arg`, with the trace limit `lim` (trace.run.4) when there is one.
fn started(exe str, arg str, envs List[str]) !proc.Output
    if envs.is_empty()
        return proc.run(exe, [arg], none, RUN_LIMIT_MS)?
    mut argv := envs
    argv.push(exe)
    argv.push(arg)
    if windows()
        # Windows has no `env` program (ADR 1059): the command interpreter sets the variables for this one process.
        mut line := ""
        for e in envs
            line = "{line}set {e}&& "
        # cmd.exe reads `/` in the command word as a switch (`tests/x.exe` runs `tests`): use backslashes.
        win_exe := exe.replace("/", "\\")
        return proc.run("cmd", ["/d", "/c", "{line}{win_exe} {arg}"], none, RUN_LIMIT_MS)?
    proc.run("env", argv, none, RUN_LIMIT_MS)?

## ---- Record and replay of tests (replay.rec.1, replay.run.1, replay.nat.1) ----

## The environment of one test's process: the trace limit, and the file its calls go to or come from.
fn test_env(lim str, rec str, rep str, seed int, steps str) List[str]
    mut envs := List[str]()
    if not steps.is_empty()
        envs.push("AIL_MAX_STEPS={steps}")
    if not lim.is_empty()
        envs.push("AIL_TRACE_LIMIT={lim}")
    if not rec.is_empty()
        envs.push("AIL_RECORD={rec}")
        envs.push("AIL_SEED={seed}")
    if not rep.is_empty()
        envs.push("AIL_REPLAY={rep}")
        envs.push("AIL_SEED={seed}")
    envs

fn rec_header(file str, seed int) str
    "\{\"ail_record\":1,\"program\":{json_str(file)},\"args\":[],\"seed\":{seed},\"limit\":67108864}"

## A recording's sections: each `{"test":NAME}` line and the call lines after it.
fn rec_sections(text str) Map[str, str]
    mut out := Map[str, str]()
    mut name := ""
    for l in text.lines()
        if l.starts_with("\{\"test\":\"")
            name = l.slice(9, l.len() - 2)
            out[name] = ""
        elif not name.is_empty()
            out[name] = "{out[name]}{l}\n"
    out

fn rec_seed(text str) int
    head := text.lines().first() else ""
    at := head.find("\"seed\":") else return 0
    rest := head.slice(at + 7, head.len())
    end := rest.find(",") else rest.len()
    rest.slice(0, end).to_int() else 0

## The environment for the test NAME under `--record` or `--replay`, with its recording file written first.
fn rec_prepare(
    mode str,
    exe str,
    name str,
    seed int,
    head str,
    secs Map[str, str],
    lim str,
    steps str,
) !List[str]
    tmp := "{exe}.rec"
    if mode == "record"
        fs.write_text(tmp, "")? "writing {tmp}"
        return test_env(lim, tmp, "", seed, steps)
    if mode == "replay"
        fs.write_text(tmp, "{head}\n{secs.get(name) else ""}")? "writing {tmp}"
        return test_env(lim, "", tmp, seed, steps)
    test_env(lim, "", "", 0, steps)

## `line` with the `"line":N` of each call line moved up by `lead`, the lines the runner added at the top.
fn rec_unlead(body str, lead int) str
    if lead == 0
        return body
    mut out := List[str]()
    for l in body.lines()
        at := l.find("\"line\":") else
            out.push(l)
            continue
        rest := l.slice(at + 7, l.len())
        end := rest.find(",") else rest.len()
        n := rest.slice(0, end).to_int() else 0
        out.push("{l.slice(0, at + 7)}{n - lead}{rest.slice(end, rest.len())}")
    "{out.join("\n")}\n"

## The recorded lines of the test NAME when it failed, as a section of the recording (replay.rec.2).
fn rec_section(mode str, exe str, name str, v Verdict, lead int) str
    if mode != "record" or v.status != "fail"
        return ""
    body := fs.read_text("{exe}.rec") else ""
    "\{\"test\":{json_str(name)}}\n{rec_unlead(body, lead)}"

## ---- Failure bundles (bundle.write.1-2, bundle.run.1-2, ADR 0910) ----

## The hash a bundle records of its program's text (FNV-1a, as `default_seed`).
fn text_hash(text str) int
    default_seed(text)

## The name of a test as a file name: letters, digits and `_` stay, the rest becomes `-`.
fn bundle_file_name(name str) str
    mut out := ""
    for c in name.chars()
        k := c.code()
        if (k >= 97 and k <= 122) or (k >= 65 and k <= 90) or (k >= 48 and k <= 57) or k == 95
            out = "{out}{c}"
        else
            out = "{out}-"
    out

## The whole number after `"KEY":` on `line`, and 0 when it is missing.
fn num_after(line str, key str) int
    at := line.find("\"{key}\":") else return 0
    rest := line.slice(at + key.len() + 3, line.len())
    comma := rest.find(",") else rest.len()
    brace := rest.find("}") else rest.len()
    end := if comma < brace then comma else brace
    rest.slice(0, end).to_int() else 0

## `text` without its first line when it is a bundle (`bundle`), which is a header line before a recording.
fn strip_bundle(text str, bundle bool) str
    if not bundle
        return text
    lines := text.lines()
    if lines.len() < 2
        return ""
    "{lines[1..].join("\n")}\n"

## Writes a bundle for each failed test into `dir`: a header line, the recording's header and the test's
## recorded calls (bundle.write.1-2). Returns how many it wrote.
fn write_bundles(dir str, file str, text str, vs List[Verdict], head str, rec_out str) !int
    secs := rec_sections("{head}\n{rec_out}")
    mut n := 0
    got := proc.run(ail_path(), ["--version"])? "running ail --version"
    ver := got.out.trim()
    sched := env.get("AIL_SCHEDULE") else ""
    for v in vs
        if v.status != "fail"
            continue
        if n == 0
            fs.make_dir(dir)? "creating {dir}"
        calls := secs.get(v.name) else ""
        header := "\{\"ail_bundle\":1,\"test\":{json_str(v.name)},\"program\":{json_str(file)},\"program_hash\":{text_hash(text)},\"compiler\":{json_str(ver)},\"message\":{json_str(v.message)},\"cases\":{v.cases},\"property_seed\":{unsigned_text(v.seed)},\"input\":{json_str(v.input)},\"schedule\":{json_str(sched)}}"
        at := "{dir}/{bundle_file_name(v.name)}.json"
        fs.write_text(
            at,
            "{header}\n{head}\n\{\"test\":{json_str(v.name)}}\n{calls}",
        )? "writing the bundle {at}"
        io.eprint("bundle: {at}")
        n += 1
    n

fn run_one(exe str, slot int, lead int, envs List[str]) Verdict
    arg := ["x" for _ in 0..slot].join("")
    r := started(exe, arg, envs) else
        return plain("", "fail", "error: can't start the test binary")
    if r.status == 0
        return Verdict(
            name: "",
            status: "pass",
            message: "",
            cases: 0,
            seed: 0,
            input: "",
            snaps: snap_records(r.err),
            frames: "",
            shown: "",
        )
    if r.status == 4
        return plain("", "fail", "error: no such test")
    Verdict(
        name: "",
        status: "fail",
        message: describe(r.err, lead),
        cases: 0,
        seed: 0,
        input: "",
        snaps: [],
        frames: frames_of(r.err, lead),
        shown: shown_of(r.out, r.err),
    )

## ---- Doc examples (test.doc.1-3) ----

## The doc examples of FILE as `@test` functions appended to its source, by the native CLI's
## `doctests` command (compiler/doc); `names` maps each generated function to `doc:Name`.
struct Augmented
    lines List[str]
    origin List[int]
    fences Map[str, int]
    names Map[str, str]
    where Map[str, List[int]]
    note str

fn native_cli() str
    root := env.get("AIL_ROOT") else "."
    "{root}/.native/ail"

## Builds the native CLI when it is missing or older than the compiler's sources.
fn ensure_native_cli() bool
    cli := native_cli()
    if not native_cli_stale(cli)
        return true
    fs.make_dir(path.dir(cli)) else return false
    b := proc.run(ail_path(), ["build", "compiler/main.ail", "-o", "{cli}.new"]) else return false
    if b.status != 0
        return false
    fs.rename("{cli}.new", cli) else return false
    true

## Whether `cli` is missing or older than a `.ail` file under `compiler` or `std` (no `sh` or `find`, ADR 1059).
fn native_cli_stale(cli str) bool
    built := fs.metadata(cli) else return true
    for root in ["compiler", "std"]
        files := fs.walk(root) else continue
        for f in files
            if not f.ends_with(".ail")
                continue
            m := fs.metadata(f) else continue
            if m.modified_ms > built.modified_ms
                return true
    false

fn doc_augment(file str) Augmented
    none_found := Augmented(lines: [], names: {}, where: {}, fences: {}, origin: [], note: "")
    if not ensure_native_cli()
        return Augmented(
            lines: [],
            names: {},
            where: {},
            fences: {},
            origin: [],
            note: "the native CLI for doc examples didn't build",
        )
    r := proc.run(native_cli(), ["doctests", file]) else
        return Augmented(
            lines: [],
            names: {},
            where: {},
            fences: {},
            origin: [],
            note: "the native CLI for doc examples didn't run",
        )
    if r.status != 0
        return Augmented(
            lines: [],
            names: {},
            where: {},
            fences: {},
            origin: [],
            note: "doc examples: {short(r.err)}",
        )
    out := r.out.split("\n")
    mut names := Map[str, str]()
    mut where := Map[str, List[int]]()
    mut fences := Map[str, int]()
    mut i := 0
    while i < out.len() and out[i].contains(" doc_example_") and out[i].starts_with("doc:")
        parts := out[i].split(" ")
        names[parts[1]] = parts[0]
        for part in parts
            if f := part.strip_prefix("fence=")
                fences[parts[0]] = f.to_int() else 0
            if csv := part.strip_prefix("lines=")
                where[parts[1]] = [n.to_int() else 0 for n in csv.split(",") if not n.is_empty()]
        i += 1
    if names.is_empty()
        return none_found
    # The source, then an empty line from `print`, then the origin list.
    mut end := out.len()
    mut origin := List[int]()
    while end > i and (out[end - 1].is_empty() or out[end - 1].starts_with("["))
        if out[end - 1].starts_with("[")
            inner := out[end - 1].slice(1, out[end - 1].len() - 1)
            origin = [w.trim().to_int() else 0 for w in inner.split(",") if not w.trim().is_empty()]
        end -= 1
    Augmented(
        lines: out[i..end],
        names: names,
        where: where,
        fences: fences,
        origin: origin,
        note: "",
    )

## The lines a doc example's output must equal: its `# =>` lines (test.doc.2).
fn doc_expected(lines List[str], t TestFn) List[str]
    mut out := List[str]()
    for j in t.header + 1..t.last + 1
        if rest := lines[j].trim().strip_prefix("# =>")
            out.push(rest.strip_prefix(" ") else rest)
    out

fn debug_list(xs List[str]) str
    mut parts := List[str]()
    for x in xs
        parts.push("\"{x.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")}\"")
    "[{parts.join(", ")}]"

fn run_doc(
    exe str,
    slot int,
    lead int,
    expected List[str],
    update bool,
    orig List[int],
    envs List[str],
) Verdict
    arg := ["x" for _ in 0..slot].join("")
    r := started(exe, arg, envs) else
        return plain("", "fail", "error: can't start the test binary")
    if r.status != 0
        return plain("", "fail", describe(r.err, lead))
    if expected.is_empty()
        return plain("", "pass", "")
    got := r.out.lines()
    mut same := got.len() == expected.len()
    if same
        for k in 0..got.len()
            if got[k].trim_end() != expected[k].trim_end()
                same = false
    if same
        return plain("", "pass", "")
    if update and not orig.is_empty()
        csv := ["{n}" for n in orig].join(",")
        rec := SnapRec(line: orig[0], col: -1, text: "{csv}\n{r.out}")
        return Verdict(
            name: "",
            status: "pass",
            message: "",
            cases: 0,
            seed: 0,
            input: "",
            snaps: [rec],
            frames: "",
            shown: "",
        )
    plain(
        "",
        "fail",
        "trap[test.doc.2]: output differs: expected {debug_list(expected)}, found {debug_list(got)}",
    )

fn json_str(s str) str
    mut out := "\""
    for c in s.chars()
        if c == '"'
            out = "{out}\\\""
        elif c == '\\'
            out = "{out}\\\\"
        elif c == '\n'
            out = "{out}\\n"
        else
            out = "{out}{c}"
    "{out}\""

## The `L:C` a message ends with (`... at 4:14`), or none.
fn where_at(msg str)(int, int)?
    i := msg.rfind(" at ") else return none
    parts := msg.slice(i + 4, msg.len()).split(":")
    if parts.len() != 2
        return none
    l := parts[0].to_int() else return none
    c := parts[1].to_int() else return none
    (l, c)

fn spaces(n int) str
    mut out := ""
    for _ in 0..n
        out = "{out} "
    out

## The interpreter's source excerpt: the line and a caret under the column.
fn excerpt(src List[str], line int, col int) str
    if line < 1 or line > src.len()
        return ""
    "{"{line}".pad_left(5, ' ')} | {src[line - 1]}\n{spaces(5)} | {spaces(col - 1)}^"

## ---- Snapshot updating (snap.update.1-6, ADR 0395) ----

struct SnapRec
    line int
    col int
    text str

fn starts_at(cs List[char], at int, s str) bool
    sc := s.chars()
    if at + sc.len() > cs.len()
        return false
    for k in 0..sc.len()
        if cs[at + k] != sc[k]
            return false
    true

fn find_from(cs List[char], at int, s str) int
    mut i := at
    while i < cs.len()
        if starts_at(cs, i, s)
            return i
        i += 1
    -1

## The index where the literal starting at `at` ends, or -1: a string (plain, raw or `"""`), a character, a
## number with an optional `-`, `true`, `false`, or a list of these.
fn literal_end(cs List[char], at int) int
    if at >= cs.len()
        return -1
    first := cs[at]
    if starts_at(cs, at, "\"\"\"") or starts_at(cs, at, "r\"\"\"")
        open := if first == 'r' then 4 else 3
        f := find_from(cs, at + open, "\"\"\"")
        if f < 0
            return -1
        mut end := f + 3
        while end < cs.len() and cs[end] == '"'
            end += 1
        return end
    if starts_at(cs, at, "r\"")
        f := find_from(cs, at + 2, "\"")
        return if f < 0 then -1 else f + 1
    if first == '"' or first == '\''
        mut i := at + 1
        while i < cs.len()
            c := cs[i]
            if c == '\\'
                i += 2
            elif c == first
                return i + 1
            elif c == '\n'
                return -1
            else
                i += 1
        return -1
    if starts_at(cs, at, "true")
        return at + 4
    if starts_at(cs, at, "false")
        return at + 5
    if first == '-' or first.is_digit()
        mut i := if first == '-' then at + 1 else at
        start := i
        while i < cs.len()
            c := cs[i]
            sign := (c == '+' or c == '-') and i > at and (cs[i - 1] == 'e' or cs[i - 1] == 'E')
            if c.is_digit() or c.is_alpha() or c == '_' or c == '.' or sign
                i += 1
            else
                break
        return if i > start then i else -1
    if first == '['
        mut depth := 0
        mut i := at
        while i < cs.len()
            c := cs[i]
            if c == '['
                depth += 1
            elif c == ']'
                depth -= 1
                if depth == 0
                    return i + 1
            elif c == '"' or c == '\''
                e := literal_end(cs, i)
                if e < 0
                    return -1
                i = e
                continue
            i += 1
    -1

## The helper suffix of the literal `t` (snap.update.2), or "" when it has no usable form.
fn snap_kind(t str) str
    if t.starts_with("\"") or t.starts_with("r\"")
        return "str"
    if t.starts_with("'")
        return "char"
    if t == "true" or t == "false"
        return "bool"
    if t.starts_with("[")
        inner := t.slice(1, t.len()).trim_start()
        if inner.starts_with("]") or inner.starts_with("[")
            return ""
        k := snap_kind(inner)
        return if k.is_empty() then "" else "list_{k}"
    if t.starts_with("0x") or t.starts_with("-0x") or t.starts_with("0b") or t.starts_with("0o")
        return "int"
    if t.contains(".") or t.contains("e") or t.contains("E")
        return "float"
    "int"

## The index of the `)` closing a call whose arguments start at `from`, or -1; `comma` is the one top-level comma.
fn call_parts(cs List[char], from int) List[int]
    mut depth := 0
    mut comma := -1
    mut commas := 0
    mut i := from
    while i < cs.len()
        c := cs[i]
        if c == '"' or c == '\''
            e := literal_end(cs, i)
            if e < 0
                return []
            i = e
            continue
        if c == '(' or c == '['
            depth += 1
        elif c == ']'
            depth -= 1
        elif c == ')'
            if depth == 0
                return if commas == 1 then [comma, i] else []
            depth -= 1
        elif c == ',' and depth == 0
            commas += 1
            comma = i
        i += 1
    []

## `line` (number `ln` in the file) with each `assert_eq(actual, LITERAL)` made a recording call.
fn snap_line(l str, ln int) str
    cs := l.chars()
    mut out := ""
    mut copied := 0
    mut i := 0
    while i < cs.len()
        prev_ok := i == 0
            or not (cs[i - 1].is_alpha() or cs[i - 1].is_digit() or cs[i - 1] == '_' or cs[i - 1] == '.')
        if prev_ok and starts_at(cs, i, "assert_eq(")
            open := i + 10
            parts := call_parts(cs, open)
            if parts.len() == 2
                mut ls := parts[0] + 1
                while ls < parts[1] and cs[ls] == ' '
                    ls += 1
                le := literal_end(cs, ls)
                mut after := le
                while after >= 0 and after < parts[1] and cs[after] == ' '
                    after += 1
                if le > 0 and after == parts[1]
                    kind := snap_kind(chars_text(cs, ls, le))
                    if not kind.is_empty()
                        out = "{out}{chars_text(cs, copied, i)}ail_snap_{kind}({chars_text(cs, open, parts[0])}, {chars_text(cs, ls, le)}, {ln}, {ls + 1})"
                        copied = parts[1] + 1
                        i = parts[1] + 1
                        continue
        i += 1
    "{out}{chars_text(cs, copied, cs.len())}"

## The `ail-snapshot LINE COL TEXT` lines a test wrote to standard error.
fn snap_records(err str) List[SnapRec]
    mut out := List[SnapRec]()
    for l in err.lines()
        rest := l.strip_prefix("ail-snapshot ") else continue
        sp1 := rest.find(" ") else continue
        sp2 := rest.slice(sp1 + 1, rest.len()).find(" ") else continue
        line := rest.slice(0, sp1).to_int() else continue
        col := rest.slice(sp1 + 1, sp1 + 1 + sp2).to_int() else continue
        out.push(SnapRec(line: line, col: col, text: rest.slice(sp1 + sp2 + 2, rest.len())))
    out

struct SnapChange
    kind str
    line int
    col int
    old str
    new str

fn snap_report(path str, old str, new str, changes List[SnapChange], json bool) str
    if not json
        return unified_diff(path, old, new)
    mut out := ""
    for c in changes
        out = "{out}\{\"snapshot\":{json_str(c.kind)},\"file\":{json_str(path)},\"line\":{c.line},\"col\":{c.col},\"old\":{json_str(c.old)},\"new\":{json_str(c.new)}}\n"
    out

## Writes (unless `dry`) and prints what the tests recorded for `file`, and the `.out` file next to it
## (snap.update.1, 2, 3, 5, 6). The doc examples' `# =>` lines (snap.update.4) are not updated yet.
fn snap_update(file str, text str, recs List[SnapRec], dry bool, json bool) !
    cs := text.chars()
    mut starts := [0]
    for k in 0..cs.len()
        if cs[k] == '\n'
            starts.push(k + 1)
    mut seen := Map[str, str]()
    mut skipped := 0
    mut order := List[SnapRec]()
    mut conflict := Set[str]()
    for r in recs
        if r.col < 0
            continue
        key := "{r.line}:{r.col}"
        if conflict.contains(key)
            continue
        if seen.contains(key)
            if seen[key] != r.text
                conflict.add(key)
                skipped += 1
            continue
        seen[key] = r.text
        order.push(r)
    mut spans := List[SnapChange]()
    mut bounds := List[(int, int)]()
    for r in order
        if conflict.contains("{r.line}:{r.col}") or r.line < 1 or r.line > starts.len()
            continue
        start := starts[r.line - 1] + r.col - 1
        end := literal_end(cs, start)
        if end < 0
            continue
        old := chars_text(cs, start, end)
        if old != r.text
            spans.push(SnapChange(
                kind: "assert_eq",
                line: r.line,
                col: r.col,
                old: old,
                new: r.text,
            ))
            bounds.push((start, end))
    idx := [k for k in 0..spans.len()].sorted(by: |k| bounds[k].0)
    mut new := ""
    mut at := 0
    mut sorted := List[SnapChange]()
    for k in idx
        new = "{new}{chars_text(cs, at, bounds[k].0)}{spans[k].new}"
        at = bounds[k].1
        sorted.push(spans[k])
    new = "{new}{chars_text(cs, at, cs.len())}"
    # snap.update.4: a doc example whose output differs takes its `# =>` lines from the output; later examples first.
    docs := [r for r in recs if r.col < 0].sorted(by: |r| -r.line)
    mut dl := new.split("\n")
    for r in docs
        cut := r.text.find("\n") else continue
        nums := [n.to_int() else 0 for n in r.text.slice(0, cut).split(",")]
        output := r.text.slice(cut + 1, r.text.len())
        first := nums[0]
        if first < 1 or first > dl.len()
            continue
        model := dl[first - 1]
        mark := model.find("# =>") else continue
        prefix := model.slice(0, mark)
        replaced := [
            if l.is_empty() then "{prefix}# =>" else "{prefix}# => {l}"
            for l in output.lines()
        ]
        mut before := List[str]()
        for n in nums
            if n >= 1 and n <= dl.len()
                before.push(dl[n - 1])
        if before.len() == replaced.len() and [b.trim_end() for b in before] == [
            b.trim_end()
            for b in replaced
        ]
            continue
        mut kept := List[str]()
        for i in 0..dl.len()
            if i + 1 == first
                kept.extend(replaced)
            elif not nums.contains(i + 1)
                kept.push(dl[i])
        dl = kept
        sorted.push(SnapChange(
            kind: "doc",
            line: first,
            col: 1,
            old: before.join("\n"),
            new: replaced.join("\n"),
        ))
    new = dl.join("\n")
    sorted = sorted.sorted(by: |c| (c.line, c.col))
    mut out := ""
    mut count := 0
    mut changed := 0
    if not sorted.is_empty()
        out = snap_report(file, text, new, sorted, json)
        count += sorted.len()
        changed += 1
        if not dry
            fs.write_text(file, new)? "writing {file}"
    stem := file.strip_suffix(".ail") else file
    expected := "{stem}.out"
    if stem != file and fs.exists(expected)
        run := proc.run(ail_path(), ["run", file]) else return
        old := fs.read_text(expected) else ""
        if run.out != old
            change := SnapChange(kind: "out", line: 1, col: 1, old: old, new: run.out)
            out = "{out}{snap_report(expected, old, run.out, [change], json)}"
            count += 1
            changed += 1
            if not dry
                fs.write_text(expected, run.out)? "writing {expected}"
    verb := if dry then "would update" else "updated"
    if json
        out = "{out}\{\"snapshots\":true,\"dry_run\":{dry},\"updated\":{count},\"files\":{changed},\"skipped\":{skipped}}\n"
    else
        s1 := if count == 1 then "" else "s"
        s2 := if changed == 1 then "" else "s"
        left := if skipped > 0 then "; left {skipped} whose value differed between runs (snap.update.3)" else ""
        out = "{out}{verb} {count} snapshot{s1} in {changed} file{s2}{left}\n"
    print(out.trim_end())

fn unified_diff(path str, old str, new str) str
    a := old.lines()
    b := new.lines()
    if a == b and old.ends_with("\n") == new.ends_with("\n")
        return ""
    # Longest common subsequence, then hunks with three lines of context.
    n := a.len()
    m := b.len()
    mut lcs := [[0 for c in 0..m + 1] for r in 0..n + 1]
    mut i := n - 1
    while i >= 0
        mut j := m - 1
        while j >= 0
            lcs[i][j] = if a[i]
                == b[j] then lcs[i + 1][j + 1] + 1 else lcs[i + 1][j].max(lcs[i][j + 1])
            j -= 1
        i -= 1
    # (' ' | '-' | '+', index in a, index in b)
    mut ops := List[Op]()
    i = 0
    mut j := 0
    while i < n or j < m
        if i < n and j < m and a[i] == b[j]
            ops.push(Op(kind: ' ', i: i, j: j))
            i += 1
            j += 1
        elif i < n and (j == m or lcs[i + 1][j] >= lcs[i][j + 1])
            ops.push(Op(kind: '-', i: i, j: j))
            i += 1
        else
            ops.push(Op(kind: '+', i: i, j: j))
            j += 1
    mut out := ["--- {path}", "+++ {path} (updated)"]
    changed := [k for k in 0..ops.len() if ops[k].kind != ' ']
    if changed.len() == 0
        out.push("\\ the files differ only in the final newline")
        return "{out.join("\n")}\n"
    mut k := 0
    while k < changed.len()
        start := if changed[k] > 3 then changed[k] - 3 else 0
        mut end := changed[k] + 1
        while k < changed.len() and changed[k] <= end + 5
            end = (changed[k] + 4).min(ops.len())
            k += 1
        hunk := ops[start..end]
        mut a_len := 0
        mut b_len := 0
        for o in hunk
            if o.kind != '+'
                a_len += 1
            if o.kind != '-'
                b_len += 1
        out.push("@@ -{hunk[0].i + 1},{a_len} +{hunk[0].j + 1},{b_len} @@")
        for o in hunk
            text := if o.kind == '+' then b[o.j] else a[o.i]
            out.push("{o.kind}{text}")
    "{out.join("\n")}\n"

struct Op
    kind char
    i int
    j int

## ---- Coverage (test.cover.1-3) ----

struct FileCover
    file str
    lines Set[int]
    hit_lines Set[int]
    fns Set[str]
    hit_fns Set[str]

## The ids in the hits file, as a set (the runtime appends one id per line per run).
fn hit_ids(path str) Set[int]
    mut ids := Set[int]()
    text := fs.read_text(path) else return ids
    for l in text.lines()
        n := l.to_int() else continue
        ids.add(n)
    ids

## Per-file coverage from the site table the build wrote and the ids the runs hit. `copy` is the
## rewritten source (its first `lead` lines were added, and only its first `orig_len` lines are the
## file's own), `scratch` the copied package directory when there is one, and `skip` the names of
## the functions that are not the program's own (the tests, their wrappers).
fn collect_cover(
    sites str,
    hits str,
    file str,
    copy str,
    lead int,
    orig_len int,
    scratch str,
    dir str,
    skip Set[str],
) List[FileCover]
    ids := hit_ids(hits)
    mut files := List[FileCover]()
    mut at := Map[str, int]()
    text := fs.read_text(sites) else return files
    for l in text.lines()
        c := l.split("\t")
        if c.len() < 5
            continue
        id := c[0].to_int() else continue
        mut line := c[2].to_int() else continue
        name := c[3]
        if skip.contains(name) or name.starts_with("ail_run_")
            continue
        mut shown := c[1]
        if c[1] == copy
            line -= lead
            if line < 1 or line > orig_len
                continue
            shown = file
        elif not scratch.is_empty() and c[1].starts_with("{scratch}/")
            shown = "{dir}/{c[1].slice(scratch.len() + 1, c[1].len())}"
        if not at.contains(shown)
            at[shown] = files.len()
            files.push(FileCover(
                file: shown,
                lines: Set[int](),
                hit_lines: Set[int](),
                fns: Set[str](),
                hit_fns: Set[str](),
            ))
        k := at[shown]
        files[k].lines.add(line)
        if c[4] == "1"
            files[k].fns.add(name)
        if ids.contains(id)
            files[k].hit_lines.add(line)
            if c[4] == "1"
                files[k].hit_fns.add(name)
    files

## The unexecuted lines as inclusive ranges, in file order.
fn missed_ranges(c FileCover) List[Span]
    mut out := List[Span]()
    for line in c.lines.sorted()
        if c.hit_lines.contains(line)
            continue
        if out.len() > 0 and out[out.len() - 1].last + 1 == line
            out[out.len() - 1].last = line
        else
            out.push(Span(first: line, last: line))
    out

## One file's coverage line, or JSON line (test.cover.2-3).
fn print_cover(c FileCover, json bool, detail bool)
    total := c.lines.len()
    hit := c.hit_lines.len()
    ranges := missed_ranges(c)
    if json
        parts := ["[{r.first},{r.last}]" for r in ranges]
        print("\{\"coverage\":true,\"file\":{json_str(c.file)},\"lines\":{total},\"lines_hit\":{hit},\"functions\":{c.fns.len()},\"functions_hit\":{c.hit_fns.len()},\"missed\":[{parts.join(",")}]}")
        return
    pct := if total == 0 then 100 else hit * 100 / total
    print("coverage {c.file}: lines {hit}/{total} ({pct}%), functions {c.hit_fns.len()}/{c.fns.len()}")
    if detail and ranges.len() > 0
        shown := [if r.first == r.last then "{r.first}" else "{r.first}-{r.last}" for r in ranges]
        print("  not run: {shown.join(", ")}")

## ---- Traces (trace.test.1-2) ----

## One event of a test's trace, from a line the run wrote to `EXE.trace`
## (`call<TAB>FN<TAB>LINE<TAB>COL<TAB>NAME=VALUE...`), as JSON; "" for a line that isn't the program's.
## ---- Mutation testing (test.mutate.1-5, ADR 1022) ----

struct Mutant
    at_line int
    shown str
    newl str
    owner str

fn ident_char(c char) bool
    c.is_alpha() or c.is_digit() or c == '_'

## The line with the characters `a` to `b` replaced by `repl`.
fn splice(cs List[char], a int, b int, repl str) str
    "{chars_text(cs, 0, a)}{repl}{chars_text(cs, b, cs.len())}"

## The name of the function a top-level `fn` or `pub fn` line declares, or "".
fn decl_name(l str) str
    mut s := l
    if s.starts_with("pub ")
        s = s.slice(4, s.len())
    if not s.starts_with("fn ")
        return ""
    rest := s.slice(3, s.len())
    cut := rest.find("(") else rest.len()
    rest.slice(0, cut).trim()

## The replacement of an operator at `i` (test.mutate.2): its text, and the length it replaces, or none.
fn op_swap(cs List[char], i int)(str, int)?
    c := cs[i]
    nxt := if i + 1 < cs.len() then cs[i + 1] else ' '
    prv := if i > 0 then cs[i - 1] else ' '
    if nxt == '='
        if c == '=' and prv != '=' and prv != '!' and prv != '<' and prv != '>' and prv != ':'
            return ("!=", 2)
        if c == '!'
            return ("==", 2)
        if c == '<' and prv != '<'
            return ("<", 2)
        if c == '>' and prv != '>' and prv != '-' and prv != '='
            return (">", 2)
        if c == '+'
            return ("-=", 2)
        if c == '-'
            return ("+=", 2)
        return none
    if c == '<' and nxt != '<' and prv != '<' and nxt != '-'
        return ("<=", 1)
    if c == '>' and nxt != '>' and prv != '>' and prv != '-' and prv != '='
        return (">=", 1)
    if c == '+' and nxt != '+' and prv != '+'
        return ("-", 1)
    if c == '-' and nxt != '>' and prv != '-'
        return ("+", 1)
    if c == '*' and nxt != '*' and prv != '*'
        return ("+", 1)
    if c == '/' and nxt != '/' and prv != '/'
        return ("*", 1)
    none

## The mutants of one source line, in column order (test.mutate.2): a branch condition negated,
## a comparison, arithmetic or boolean operator flipped, `true` and `false` swapped, `not`
## dropped, and a whole number changed by one. Strings, comments, declarations and checks are left alone.
fn line_mutants(l str, ln int, owner str) List[Mutant]
    mut out := List[Mutant]()
    cs := l.chars()
    mut lead := 0
    while lead < cs.len() and cs[lead] == ' '
        lead += 1
    if lead == 0 or lead >= cs.len()
        return out
    trimmed := l.trim()
    for skip in ["#", "@", "assert", "requires", "ensures", "use "]
        if trimmed.starts_with(skip)
            return out
    for kw in ["if ", "elif "]
        if trimmed.starts_with(kw) and not trimmed.contains(" then ") and not trimmed.contains("#")
            cond := trimmed.slice(kw.len(), trimmed.len())
            now := "{kw}not ({cond})"
            out.push(Mutant(
                at_line: ln,
                shown: "{trimmed} -> {now}",
                newl: "{l.slice(0, lead)}{now}",
                owner: owner,
            ))
    mut i := lead
    while i < cs.len()
        c := cs[i]
        if c == '#'
            break
        if c == '"' or c == '\''
            e := literal_end(cs, i)
            if e < 0
                break
            i = e
            continue
        if c.is_alpha() or c == '_'
            mut j := i
            while j < cs.len() and ident_char(cs[j])
                j += 1
            word := chars_text(cs, i, j)
            mut now := ""
            if word == "and"
                now = "or"
            elif word == "or"
                now = "and"
            elif word == "true"
                now = "false"
            elif word == "false"
                now = "true"
            if not now.is_empty()
                out.push(Mutant(
                    at_line: ln,
                    shown: "{word} -> {now}",
                    newl: splice(cs, i, j, now),
                    owner: owner,
                ))
            elif word == "not" and j < cs.len() and cs[j] == ' '
                out.push(Mutant(
                    at_line: ln,
                    shown: "not -> removed",
                    newl: splice(cs, i, j + 1, ""),
                    owner: owner,
                ))
            i = j
            continue
        if c.is_digit()
            mut j := i
            while j < cs.len() and (cs[j].is_digit() or cs[j] == '_')
                j += 1
            before := i > 0 and (ident_char(cs[i - 1]) or cs[i - 1] == '.')
            frac := j + 1 < cs.len() and cs[j] == '.' and cs[j + 1].is_digit()
            tail := j < cs.len() and cs[j].is_alpha()
            if not before and not frac and not tail
                digits := chars_text(cs, i, j)
                if n := digits.replace("_", "").to_int()
                    now := if n == 0 then "1" else "{n + 1}"
                    out.push(Mutant(
                        at_line: ln,
                        shown: "{digits} -> {now}",
                        newl: splice(cs, i, j, now),
                        owner: owner,
                    ))
            i = j
            continue
        if sw := op_swap(cs, i)
            out.push(Mutant(
                at_line: ln,
                shown: "{chars_text(cs, i, i + sw.1)} -> {sw.0}",
                newl: splice(cs, i, i + sw.1, sw.0),
                owner: owner,
            ))
            i += sw.1
            continue
        i += 1
    out

## At most `limit` of the mutants, spread evenly and in order (test.mutate.3).
fn pick_mutants(cands List[Mutant], limit int) List[Mutant]
    if limit <= 0 or cands.len() <= limit
        return cands
    mut out := List[Mutant]()
    for i in 0..limit
        out.push(cands[i * cands.len() / limit])
    out

## How many `"status":"pass"` lines a `--json` run printed.
fn count_passed(out str) int
    mut n := 0
    for l in out.lines()
        if l.contains("\"status\":\"pass\"")
            n += 1
    n

## Runs the tests against each mutant of the reached lines of `file` and reports the survivors
## (test.mutate.1-5). `base` is the baseline exit status and `base_pass` its passing tests.
fn run_mutants(
    file str,
    text str,
    tests List[TestFn],
    reached Set[int],
    limit int,
    timeout str,
    json bool,
    base_pass int,
    built bool,
    base int,
) !int
    if not built
        io.eprint("error[test.mutate.1]: the tests did not build, so no mutant can be judged")
        return 2
    if base != 0
        io.eprint("error[test.mutate.1]: the tests fail, so no mutant can be judged; fix them first")
        return base
    if base_pass == 0
        io.eprint("error[test.mutate.1]: no test passed, so no mutant can be killed")
        return 2
    src := text.lines()
    mut owners := List[str]()
    mut cur := ""
    for l in src
        if not l.is_empty() and not l.starts_with(" ") and not l.starts_with("#")
            cur = decl_name(l)
        owners.push(cur)
    mut cands := List[Mutant]()
    for ln in reached.sorted()
        if ln < 1 or ln > src.len() or owners[ln - 1] == "main" or owners[ln - 1].is_empty()
            continue
        mut in_test := false
        for t in tests
            if ln - 1 >= t.first and ln - 1 <= t.last
                in_test = true
        if in_test
            continue
        for m in line_mutants(src[ln - 1], ln, owners[ln - 1])
            cands.push(m)
    chosen := pick_mutants(cands, limit)
    dir := path.dir(file)
    copy := if dir.is_empty() then ".ail-mutant-{path.stem(file)}.ail" else "{dir}/.ail-mutant-{path.stem(file)}.ail"
    limit_ms := if timeout.is_empty() then "5000" else timeout
    mut killed := 0
    mut survived := 0
    for m in chosen
        mut body := src
        body[m.at_line - 1] = m.newl
        fs.write_text(copy, "{body.join("\n")}\n")? "writing {copy}"
        r := proc.run(
            ail_path(),
            ["test", "--json", "--timeout", limit_ms, copy],
            none,
            120000,
        ) else continue
        if r.status == 1
            killed += 1
        elif r.status == 0 and count_passed(r.out) == base_pass
            survived += 1
            if json
                print("\{\"mutant\":true,\"file\":{json_str(file)},\"line\":{m.at_line},\"fn\":{json_str(m.owner)},\"mutation\":{json_str(m.shown)},\"status\":\"survived\"}")
            else
                print("survived {file}:{m.at_line}: {m.shown} (in {m.owner})")
    rm_file(copy)
    invalid := chosen.len() - killed - survived
    if json
        print("\{\"mutate\":true,\"mutants\":{chosen.len()},\"killed\":{killed},\"survived\":{survived},\"invalid\":{invalid}}")
    else
        judged := killed + survived
        score := if judged == 0 then 100 else killed * 100 / judged
        print("mutants: {chosen.len()} run, {killed} killed, {survived} survived, {invalid} invalid, score {score}%")
    if survived > 0 then 1 else 0

fn trace_json(line str) str
    c := line.split("\t")
    if c.len() == 1
        n := line.to_int() else return ""
        return "\{\"api\":1,\"trace\":\"dropped\",\"count\":{n}}"
    if c.len() < 4 or c[0] != "call" or c[1] == "main" or c[1].starts_with("ail_")
        return ""
    mut args := List[str]()
    for a in c[4..]
        eq := a.find("=") else continue
        args.push("{json_str(a.slice(0, eq))}:{json_str(a.slice(eq + 1, a.len()))}")
    "\{\"api\":1,\"trace\":\"call\",\"fn\":{json_str(c[1])},\"args\":\{{args.join(",")}},\"line\":{c[2]},\"col\":{c[3]}}"

## The same event as a line of the human form.
fn trace_text(line str) str
    c := line.split("\t")
    if c.len() == 1
        n := line.to_int() else return ""
        return "trace: {n} more events dropped"
    if c.len() < 4 or c[0] != "call" or c[1] == "main" or c[1].starts_with("ail_")
        return ""
    mut args := List[str]()
    for a in c[4..]
        eq := a.find("=") else continue
        args.push("{a.slice(0, eq)} = {a.slice(eq + 1, a.len())}")
    "trace: call {c[1]}({args.join(", ")})"

## The events a run wrote, and none when it wrote nothing; the file is removed.
fn take_trace(exe str) List[str]
    path := "{exe}.trace"
    text := fs.read_text(path) else return []
    fs.remove(path) else return text.lines()
    text.lines()

fn report(
    vs List[Verdict],
    json bool,
    src List[str],
    traces Map[str, List[str]],
    at_pos Map[str, (int, int)],
) int
    mut passed := 0
    mut failed := 0
    mut skipped := 0
    for v in vs
        if v.status == "pass"
            passed += 1
        elif v.status == "fail"
            failed += 1
        else
            skipped += 1
        tail := if v.cases > 0 then " ({v.cases} cases, seed {unsigned_text(v.seed)})" else ""
        if json
            extra := if v.cases > 0 then ",\"cases\":{v.cases},\"seed\":{unsigned_text(v.seed)}" else ""
            input := if v.input.is_empty() then "" else ",\"input\":{json_str(v.input)}"
            mut at := if w := where_at(v.message) then ",\"line\":{w.0},\"col\":{w.1}" else ""
            if at.is_empty()
                and (v.status == "pass" or v.name.starts_with("doc:"))
                and at_pos.contains(v.name)
                at = ",\"line\":{at_pos[v.name].0},\"col\":{at_pos[v.name].1}"
            raw := traces.get(v.name) else []
            mut events := List[str]()
            for e in raw
                j := trace_json(e)
                if not j.is_empty()
                    events.push(j)
            shown := if events.is_empty() then "" else ",\"trace\":[{events.join(",")}]"
            mut msg := v.message
            if w := where_at(msg)
                if cut := msg.rfind(" at ")
                    msg = msg.slice(0, cut)
            mut snap := ""
            if v.status == "fail"
                and v.cases == 0
                and not v.frames.is_empty()
                and msg.starts_with("trap[")
                if w := where_at(v.message)
                    ex := snap_excerpt(src, w.0, w.1)
                    if not ex.is_empty()
                        snap = ",\"snapshot\":{json_str("{ex}\n{v.frames}")}"
            print("\{\"test\":{json_str(v.name)},\"status\":\"{v.status}\"{at},\"message\":{json_str(msg)}{extra}{input}{snap}{shown}}")
        elif v.status == "pass"
            print("ok {v.name}{tail}")
        elif v.status == "fail"
            print("FAIL {v.name}: {v.message}{tail}")
            if w := where_at(v.message)
                shown := excerpt(src, w.0, w.1)
                if not shown.is_empty()
                    print(shown)
            # trace.snap.1: the call stack of a trap, as the JSON snapshot carries it.
            if not v.frames.is_empty() and v.message.starts_with("trap[")
                print(v.frames)
            seen := traces.get(v.name) else []
            for e in seen
                t := trace_text(e)
                if not t.is_empty()
                    print("  {t}")
            if not v.input.is_empty()
                print("  input: {v.input}")
            if not v.shown.is_empty()
                print(v.shown)
        else
            print("skip {v.name}: {v.message}")
    # conc.sched.2: a failure under a random schedule names the seed that replays it.
    sched := env.get("AIL_SCHEDULE") else ""
    seed := if failed > 0 and sched.starts_with("random:") then sched.slice(7, sched.len()) else ""
    if json
        more := if skipped > 0 then ",\"skipped\":{skipped}" else ""
        at := if seed.is_empty() then "" else ",\"schedule_seed\":{seed}"
        print("\{\"summary\":true,\"passed\":{passed},\"failed\":{failed}{more}{at}}")
    else
        more := if skipped > 0 then ", {skipped} skipped" else ""
        print("{passed} passed, {failed} failed{more}")
        if not seed.is_empty()
            print("schedule seed {seed}: replay with `ail test --schedule=random:{seed} FILE`")
    if failed > 0 then 1 else 0

fn seed_for(name str, has_seed bool, given int) int
    if has_seed then given else default_seed(name)

## The tests that changes since git revision `since` can reach (`ail ask FILE --affected`).
fn affected_names(file str, since str) List[str]
    r := proc.run(ail_path(), ["ask", file, "--affected", "--rev", since]) else err
        io.eprint("error: can't run `ail ask`: {err}")
        io.exit(2)
        return []
    if r.status != 0
        io.eprint(r.err)
        io.exit(2)
    [l.trim() for l in r.out.lines() if l.trim() != ""]

## The `ail build` arguments: `extra` options, the time limit baked in (run.limit.1), the copy and the executable.
fn build_args(extra List[str], timeout str, copy str, exe str) List[str]
    mut a := ["build"]
    a.extend(extra)
    if not timeout.is_empty()
        a.extend(["--timeout", timeout])
    a.extend([copy, "-o", exe])
    a

fn usage() int
    io.eprint("usage: ailtest [--json] [--affected [--since REV]] [--bundle-failure[=DIR]] [--bundle FILE] [--contracts] [--update [--dry-run]] [--coverage[=lines]] [--trace[=calls]] [--trace-limit N] [--timeout MS] [--values] [--cases N] [--seed S] [--fuzz NAME [--time MS] [--corpus DIR]] [--mutate [--max N]] [--filter PATTERN]... [--list] FILE")
    io.exit(2)
    2

## Whether `pat` matches `name` (test.filter.1): the pattern is a substring of the name, and `*` in it stands for any run of characters.
fn glob_has(name str, pat str) bool
    mut at := 0
    for part in pat.split("*")
        if part.is_empty()
            continue
        rest := name.slice(at, name.len())
        k := rest.find(part) else return false
        at += k + part.len()
    true

## Whether `name` matches any of `pats`; no patterns match every name.
fn name_matches(name str, pats List[str]) bool
    if pats.is_empty()
        return true
    for p in pats
        if glob_has(name, p)
            return true
    false

fn main() !
    mut filters := List[str]()
    mut list_only := false
    mut json := false
    mut update := false
    mut dry := false
    mut coverage := ""
    mut files := List[str]()
    mut cases := 100
    mut has_seed := false
    mut seed_given := 0
    mut want := ""
    mut trace := false
    mut trace_limit := ""
    mut affected := false
    mut since := "HEAD"
    mut contracts := false
    mut max_steps := ""
    mut timeout := ""
    mut values := false
    mut rec_mode := ""
    mut rec_file := ""
    mut bundle_dir := ""
    mut bundle_run := ""
    mut fuzz := ""
    mut corpus_dir := ""
    mut fuzz_ms := 0
    mut cases_given := false
    mut mutating := false
    mut mutate_max := 50
    for a in env.args()
        if want == "--since"
            since = a
            want = ""
        elif a == "--affected"
            affected = true
        elif a == "--contracts"
            contracts = true
        elif a == "--since"
            want = a
        elif want == "--cases"
            cases = a.to_int() else usage()
            cases_given = true
            want = ""
        elif a == "--mutate"
            mutating = true
        elif want == "--filter"
            filters.push(a)
            want = ""
        elif a == "--filter"
            want = a
        elif a == "--list"
            list_only = true
        elif want == "--max"
            mutate_max = a.to_int() else usage()
            want = ""
        elif a == "--max"
            want = a
        elif want == "--fuzz"
            fuzz = a
            want = ""
        elif want == "--corpus"
            corpus_dir = a
            want = ""
        elif want == "--time"
            fuzz_ms = a.to_int() else usage()
            want = ""
        elif a == "--fuzz" or a == "--corpus" or a == "--time"
            want = a
        elif want == "--seed"
            seed_given = a.to_int() else usage()
            has_seed = true
            want = ""
        elif a == "--json"
            json = true
        elif a == "--update"
            update = true
        elif a == "--trace" or a == "--trace=calls" or a == "--trace=all" or a == "--trace=effects"
            trace = true
        elif want == "--trace-limit"
            trace_limit = a
            want = ""
        elif a == "--trace-limit"
            want = a
        elif want == "--max-steps"
            max_steps = a
            want = ""
        elif a == "--max-steps"
            want = a
        elif want == "--timeout"
            # run.limit.1, run.limit.4: each test gets the whole allowance, in its own process.
            if (a.to_int() else 0) < 1
                io.eprint("error[run.limit.4]: `--timeout` needs a positive whole number of milliseconds")
                io.exit(2)
            timeout = a
            want = ""
        elif a == "--timeout"
            want = a
        elif a == "--values"
            # trace.frame.3, ADR 0886: the traps of the tests show the values in scope.
            values = true
        elif want == "--bundle"
            bundle_run = a
            rec_mode = "replay"
            rec_file = a
            want = ""
        elif want == "--record" or want == "--replay"
            rec_mode = want.slice(2, want.len())
            rec_file = a
            want = ""
        elif a == "--record" or a == "--replay" or a == "--bundle"
            want = a
        elif a == "--bundle-failure"
            bundle_dir = ".ail/bundles"
        elif a.starts_with("--bundle-failure=")
            bundle_dir = a.slice(17, a.len())
        elif a == "--dry-run"
            dry = true
        elif a == "--coverage"
            coverage = "table"
        elif a == "--coverage=lines"
            coverage = "lines"
        elif a == "--cases" or a == "--seed"
            want = a
        else
            files.push(a)
    if not want.is_empty()
        io.exit(usage())
    if rec_mode == "replay" and files.is_empty()
        # replay.run.1: the recording's own program.
        rhead := strip_bundle(
            fs.read_text(rec_file) else "",
            not bundle_run.is_empty(),
        ).lines().first() else ""
        pat := rhead.find("\"program\":\"") else 0
        prest := rhead.slice(pat + 11, rhead.len())
        files.push(prest.slice(0, prest.find("\"") else 0))
    if files.len() != 1 or (dry and not update)
        io.exit(usage())
    file := files[0]
    if not filters.is_empty() and (update or mutating)
        io.eprint("error[test.filter.3]: `--filter` can't be combined with `--update` or `--mutate`, which need every test")
        io.exit(2)
    if mutating and coverage.is_empty()
        # test.mutate.1: the build counts the statements run, to leave out code no test reaches.
        coverage = "lines"
    mut own_rec := false
    if not bundle_dir.is_empty() and rec_mode.is_empty()
        # bundle.write.1: the failures are recorded as `--record` does, into a file of ours.
        rec_mode = "record"
        rec_file = "{bundle_dir}.rec"
        own_rec = true
    mut rec_head := ""
    mut rec_secs := Map[str, str]()
    mut rec_seed_n := 0
    mut rec_out := ""
    if rec_mode == "replay"
        mut rtext := fs.read_text(rec_file) else
            io.eprint("error: can't read the recording {rec_file} (replay.run.1)")
            io.exit(2)
        rtext = strip_bundle(rtext, not bundle_run.is_empty())
        rec_head = rtext.lines().first() else ""
        rec_secs = rec_sections(rtext)
        rec_seed_n = rec_seed(rtext)
    elif rec_mode == "record"
        rec_seed_n = (env.get("AIL_SEED") else "").to_int() else time.now_ms()
        rec_head = rec_header(file, rec_seed_n)
    checked := proc.run(ail_path(), ["check", file])? "running ail check"
    if checked.status != 0 and not checked.err.contains("error[mod.main.1]")
        io.eprint(checked.err)
        io.exit(2)
    text := fs.read_text(file)? "reading {file}"
    if not bundle_run.is_empty()
        saved := num_after(
            (fs.read_text(bundle_run) else "").lines().first() else "",
            "program_hash",
        )
        if saved != text_hash(text)
            io.eprint("note: {file} differs from the program the bundle was written for, so the failure may have changed (bundle.run.2)")
    mut lines := text.lines()
    mut doc_names := Map[str, str]()
    mut doc_where := Map[str, List[int]]()
    mut doc_origin := List[int]()
    mut at_pos := Map[str, (int, int)]()
    mut has_docs := false
    for l in lines
        if l.trim() == "## ```ail"
            has_docs = true
    mut doc_note := ""
    if has_docs
        aug := doc_augment(file)
        if aug.lines.is_empty()
            doc_note = aug.note
        else
            lines = aug.lines
            doc_names = aug.names
            doc_where = aug.where
            doc_origin = aug.origin
            for fname in aug.fences.keys()
                at_pos[fname] = (aug.fences[fname], 1)
    mut synth := Set[str]()
    mut skipped_contracts := List[Skipped]()
    if contracts
        fxr := proc.run(ail_path(), ["effects", "--json", file])? "running ail effects"
        made := contract_tests(lines, fxr.out)
        if made.names.is_empty() and made.skipped.is_empty()
            print("no contracts to check")
            io.exit(0)
        for k in made.skipped
            skipped_contracts.push(k)
        lines.extend(made.lines)
        synth = made.names
    mut found := find_tests(lines)
    if not fuzz.is_empty()
        # test.fuzz.1: only the named property test is built and run.
        mut only := List[TestFn]()
        for t in found.tests
            if t.name == fuzz
                only.push(t)
            else
                found.left_out.push(Span(first: t.first, last: t.last))
        found.tests = only
        found.skipped = [k for k in found.skipped if k.name == fuzz]
        if only.is_empty() and found.skipped.is_empty()
            io.eprint("error[test.fuzz.1]: no property test named {fuzz} in {file}")
            io.exit(2)
        if not only.is_empty() and only[0].params.is_empty()
            io.eprint("error[test.fuzz.1]: {fuzz} has no parameters, so there is nothing to generate")
            io.exit(2)
    if contracts
        # contract.fuzz.1: only the generated checks run.
        mut only := List[TestFn]()
        for t in found.tests
            if synth.contains(t.name)
                only.push(t)
            else
                found.left_out.push(Span(first: t.first, last: t.last))
        found.tests = only
        found.skipped = [k for k in found.skipped if synth.contains(k.name)]
    if affected
        # test.affected.1: only the tests the changes since `since` can reach; the
        # rest are left out of the build like a test the backend can't build.
        names := affected_names(file, since)
        mut keep := List[TestFn]()
        for t in found.tests
            if names.contains(t.name)
                keep.push(t)
            else
                found.left_out.push(Span(first: t.first, last: t.last))
        io.eprint("affected: {keep.len()} of {found.tests.len()} tests")
        found.tests = keep
    mut listed_of := 0
    mut selected_of := 0
    if not filters.is_empty()
        # test.filter.1: only the tests whose name matches; the rest are left out of the build.
        mut keep := List[TestFn]()
        for t in found.tests
            listed_of += 1
            if name_matches(
                if doc_names.contains(t.name) then doc_names[t.name] else t.name,
                filters,
            )
                keep.push(t)
            else
                found.left_out.push(Span(first: t.first, last: t.last))
        selected_of = keep.len()
        found.tests = keep
        found.skipped = [k for k in found.skipped if name_matches(k.name, filters)]
        skipped_contracts = [k for k in skipped_contracts if name_matches(k.name, filters)]
    w := World(decls: parse_decls(lines))
    for t in found.tests
        if t.header < lines.len()
            col := (lines[t.header].find(t.name) else 0) + 1
            at_pos[t.name] = (t.header + 1, col)
    mut verdicts := List[Verdict]()
    for s in found.skipped
        verdicts.push(plain(s.name, "skip", s.why))
    for s in skipped_contracts
        verdicts.push(plain(s.name, "skip", s.why))
    if not doc_note.is_empty()
        verdicts.push(plain("doc examples", "skip", doc_note))
    dir := path.dir(file)
    mut mf := module_tests(lines, dir)
    if contracts or not fuzz.is_empty()
        mf = ModFiles(
            fixtures: Map[str, List[Fixture]](),
            tests: [],
            skipped: [],
            lines: Map[str, List[str]](),
        )
    mut mfilt := Set[int]()
    mut mwhy := Map[int, str]()
    if not filters.is_empty()
        for mi in 0..mf.tests.len()
            listed_of += 1
            if name_matches("{mf.tests[mi].module}.{mf.tests[mi].t.name}", filters)
                selected_of += 1
            else
                mfilt.add(mi)
        mf.skipped = [k for k in mf.skipped if name_matches(k.name, filters)]
        if selected_of == 0
            and found.skipped.is_empty()
            and mf.skipped.is_empty()
            and skipped_contracts.is_empty()
            io.eprint("error[test.filter.1]: no test of {file} matches {filters.join(", ")} ({listed_of} tests; `ail test --list FILE` shows their names)")
            io.exit(2)
        io.eprint("filter: {selected_of} of {listed_of} tests")
    for sk in mf.skipped
        verdicts.push(plain(sk.name, "skip", sk.why))
    if list_only
        mut names := List[str]()
        mut lns := List[int]()
        for t in found.tests
            names.push(if doc_names.contains(t.name) then doc_names[t.name] else t.name)
            lns.push(if at_pos.contains(t.name) then at_pos[t.name].0 else 0)
        for k in found.skipped
            names.push(k.name)
            lns.push(0)
        for mi in 0..mf.tests.len()
            if not mfilt.contains(mi)
                names.push("{mf.tests[mi].module}.{mf.tests[mi].t.name}")
                lns.push(0)
        for k in mf.skipped
            names.push(k.name)
            lns.push(0)
        for k in skipped_contracts
            names.push(k.name)
            lns.push(0)
        for q in 0..names.len()
            if json
                print("\{\"test\":{json_str(names[q])},\"line\":{lns[q]}}")
            else
                print(names[q])
        if json
            print("\{\"summary\":true,\"listed\":{names.len()}}")
        io.exit(0)
    if found.tests.len() == 0 and mf.tests.len() == mfilt.len()
        # snap.update.5: a program with no tests still has its `.out` to update.
        if update
            snap_update(file, text, [], dry, json)?
        io.exit(report(verdicts, json, text.lines(), {}, at_pos))
    stem := path.stem(file)
    copy_name := ".ail-test-{stem}.ail"
    mut scratch := ""
    if not mf.tests.is_empty()
        # The directory is copied so the modules' tests can be made `pub` without touching the tree.
        # Beside the directory, so its package's relative `dep ... path ../x` lines still find their modules.
        pkg_dir := if dir.is_empty() then "." else dir
        scratch = "{pkg_dir}/../{SCRAP_PREFIX}{time.now_ms()}-{random.int(0, 999999999)}"
        fs.make_dir(scratch)? "creating {scratch}"
        fs.copy(pkg_dir, scratch)? "copying {dir}"
    plain_copy := if dir.is_empty() then copy_name else "{dir}/{copy_name}"
    copy := if scratch.is_empty() then plain_copy else "{scratch}/{copy_name}"
    exe := "{copy}.bin"
    mut mdropped := mfilt
    mut with_main := not coverage.is_empty()
    mut dropped := Set[int]()
    mut why := Map[int, str]()
    mut blocked := ""
    mut built := false
    mut last_lead := 0
    for _ in 0..MAX_ROUNDS
        if dropped.len() == found.tests.len() and mdropped.len() == mf.tests.len()
            break
        rw := rewrite(
            w,
            lines,
            found,
            dropped,
            mf,
            mdropped,
            if update then text.lines().len() else 0,
            with_main,
        )
        if not mf.tests.is_empty()
            write_modules(scratch, mf, mdropped)? "writing the modules"
        last_lead = rw.lead
        fs.write_text(copy, rw.text)? "writing {copy}"
        modes := [
            m
            for m in [
                if coverage.is_empty() and fuzz.is_empty() then "" else "lines",
                if trace then "tests" else "",
                if rec_mode.is_empty() then "" else "record",
                if max_steps.is_empty() then "" else "steps",
                if values then "values" else "",
            ] if m != ""
        ].join(",")
        # native.instr.2-3, test.cover.4, trace.test.1: the build counts the statements run and notes the calls (rt/native/instr.ail).
        mut prog := ail_path()
        mut cmd := List[str]()
        if not modes.is_empty()
            prog = "env"
            cmd = ["AIL_INSTRUMENT={modes}", "AIL_INSTRUMENT_SITES={exe}.sites", ail_path()]
        cmd.extend(build_args(
            if modes.is_empty() then List[str]() else ["--no-cache"],
            timeout,
            copy,
            exe,
        ))
        b := proc.run(prog, cmd)? "running ail build"
        if b.status == 0
            built = true
            break
        mut progressed := false
        mut outside := ""
        for l in b.err.lines()
            pos := l.find(": error[") else continue
            msg := l.slice(pos + 2, l.len())
            parts := l.slice(0, pos).split(":")
            if parts.len() >= 3
                mut hit := false
                for mi in 0..mf.tests.len()
                    t := mf.tests[mi].t
                    ln := parts[parts.len() - 2].to_int() else 0
                    if not mdropped.contains(mi)
                        and parts[parts.len() - 3].ends_with(mf.tests[mi].file)
                        and ln - 1 >= t.first
                        and ln - 1 <= t.last
                        mdropped.add(mi)
                        mwhy[mi] = "{short(msg)} (line {ln})"
                        progressed = true
                        hit = true
                if hit
                    continue
            if parts.len() < 3 or not parts[parts.len() - 3].ends_with(copy_name)
                if outside.is_empty()
                    outside = msg
                continue
            ln := parts[parts.len() - 2].to_int() else continue
            o := rw.origin[ln - 1]
            mut owner := -1
            for i in 0..found.tests.len()
                if not dropped.contains(i)
                    and o >= found.tests[i].first
                    and o <= found.tests[i].last
                    owner = i
            if owner < 0 or o < 0
                if outside.is_empty()
                    outside = "{short(msg)} (line {ln})"
            elif not dropped.contains(owner)
                dropped.add(owner)
                why[owner] = "{short(msg)} (line {o + 1})"
                progressed = true
        if not progressed and with_main
            # The file's own `main` didn't build: count without it.
            with_main = false
            progressed = true
        if not progressed
            # An unparsed failure still says why: the first line the build wrote, and its exit status.
            mut why_text := "the build failed (exit {b.status})"
            for l in "{b.err}\n{b.out}".lines()
                if not l.trim().is_empty()
                    why_text = "the build failed (exit {b.status}): {short(l.trim())}"
                    break
            blocked = if outside.is_empty() then why_text else outside
            break
    if not coverage.is_empty()
        rm_file("{exe}.hits")
    mut traces := Map[str, List[str]]()
    for i in 0..found.tests.len()
        t := found.tests[i]
        if dropped.contains(i)
            verdicts.push(plain(t.name, "skip", "not in the native subset yet: {why[i]}"))
        elif not blocked.is_empty()
            verdicts.push(plain(t.name, "skip", "outside the tests: {blocked}"))
        elif not built
            verdicts.push(plain(t.name, "skip", "no build within the round limit"))
        else
            mut slot := 1
            for j in 0..i
                if not dropped.contains(j)
                    slot += 1
            vname := if doc_names.contains(t.name) then doc_names[t.name] else t.name
            if rec_mode == "replay" and not rec_secs.contains(vname)
                continue
            if doc_names.contains(t.name)
                envs := rec_prepare(
                    rec_mode,
                    exe,
                    vname,
                    rec_seed_n,
                    rec_head,
                    rec_secs,
                    trace_limit,
                    max_steps,
                )?
                v := run_doc(
                    exe,
                    slot,
                    last_lead,
                    doc_expected(lines, t),
                    update,
                    doc_where.get(t.name) else [],
                    envs,
                )
                rec_out = "{rec_out}{rec_section(rec_mode, exe, vname, v, last_lead)}"
                verdicts.push(Verdict(
                    name: doc_names[t.name],
                    status: v.status,
                    message: remap_at(v.message, doc_origin),
                    cases: 0,
                    seed: 0,
                    input: "",
                    snaps: v.snaps,
                    frames: v.frames,
                    shown: v.shown,
                ))
                if trace and v.status == "fail"
                    traces[doc_names[t.name]] = take_trace(exe)
                elif trace
                    take_trace(exe)
            elif t.params.is_empty()
                envs := rec_prepare(
                    rec_mode,
                    exe,
                    vname,
                    rec_seed_n,
                    rec_head,
                    rec_secs,
                    trace_limit,
                    max_steps,
                )?
                v := run_one(exe, slot, last_lead, envs)
                rec_out = "{rec_out}{rec_section(rec_mode, exe, vname, v, last_lead)}"
                if trace and v.status == "fail"
                    traces[t.name] = take_trace(exe)
                elif trace
                    take_trace(exe)
                verdicts.push(Verdict(
                    name: t.name,
                    status: v.status,
                    message: v.message,
                    cases: 0,
                    seed: 0,
                    input: "",
                    snaps: v.snaps,
                    frames: v.frames,
                    shown: v.shown,
                ))
            else
                mut p := Prop(status: "pass", message: "", cases: 0, input: "")
                if fuzz.is_empty()
                    p = run_prop(
                        w,
                        last_lead,
                        exe,
                        slot,
                        t,
                        cases,
                        seed_for(t.name, has_seed, seed_given),
                    )
                else
                    # test.fuzz.1: the time allowance is 10 s unless `--time` or `--cases` says otherwise.
                    mut allowance := 10000
                    if fuzz_ms > 0
                        allowance = fuzz_ms
                    elif cases_given
                        allowance = 3600000
                    p = run_fuzz(
                        w,
                        last_lead,
                        exe,
                        slot,
                        t,
                        "{exe}.fuzz",
                        corpus_dir,
                        allowance,
                        if cases_given then cases else 0,
                        seed_for(t.name, has_seed, seed_given),
                    )?
                verdicts.push(Verdict(
                    name: t.name,
                    status: p.status,
                    message: p.message,
                    cases: p.cases,
                    seed: seed_for(t.name, has_seed, seed_given),
                    input: p.input,
                    snaps: [],
                    frames: "",
                    shown: "",
                ))
    mut kept := 0
    for j in 0..found.tests.len()
        if not dropped.contains(j)
            kept += 1
    for mi in 0..mf.tests.len()
        mt := mf.tests[mi]
        name := "{mt.module}.{mt.t.name}"
        if mfilt.contains(mi)
            continue
        elif mdropped.contains(mi)
            verdicts.push(plain(name, "skip", "not in the native subset yet: {mwhy[mi]}"))
        elif not blocked.is_empty()
            verdicts.push(plain(name, "skip", "outside the tests: {blocked}"))
        elif not built
            verdicts.push(plain(name, "skip", "no build within the round limit"))
        else
            mut slot := kept + 1
            for j in 0..mi
                if not mdropped.contains(j)
                    slot += 1
            if rec_mode == "replay" and not rec_secs.contains(name)
                continue
            envs := rec_prepare(
                rec_mode,
                exe,
                name,
                rec_seed_n,
                rec_head,
                rec_secs,
                trace_limit,
                max_steps,
            )?
            v := run_one(exe, slot, 0, envs)
            rec_out = "{rec_out}{rec_section(rec_mode, exe, name, v, 0)}"
            verdicts.push(plain(name, v.status, v.message))
    if rec_mode == "record" and not own_rec
        fs.write_text(rec_file, "{rec_head}\n{rec_out}")? "writing the recording {rec_file}"
    if not bundle_dir.is_empty()
        _ := write_bundles(bundle_dir, file, text, verdicts, rec_head, rec_out)?
    if update
        mut recs := List[SnapRec]()
        # snap.update.3: the assertion that reaches a literal with a second, different value fails.
        cs := text.chars()
        mut starts := [0]
        for k in 0..cs.len()
            if cs[k] == '\n'
                starts.push(k + 1)
        mut seen := Map[str, str]()
        mut failed := Set[str]()
        for i in 0..verdicts.len()
            for r in verdicts[i].snaps
                if r.col < 0
                    continue
                key := "{r.line}:{r.col}"
                prior := seen.get(key) else ""
                if not seen.contains(key)
                    seen[key] = r.text
                elif prior != r.text
                    and not failed.contains(key)
                    and r.line >= 1
                    and r.line <= starts.len()
                    failed.add(key)
                    start := starts[r.line - 1] + r.col - 1
                    end := literal_end(cs, start)
                    if end >= 0 and verdicts[i].status == "pass"
                        verdicts[i].status = "fail"
                        verdicts[i].message = "trap[test.assert.1]: assertion failed: left is {r.text}, right is {chars_text(cs, start, end)}"
        for v in verdicts
            for r in v.snaps
                if r.col != 0
                    recs.push(r)
        snap_update(file, text, recs, dry, json)?
    code := report(verdicts, json, text.lines(), traces, at_pos)
    mut reached := Set[int]()
    mut base_pass := 0
    for v in verdicts
        if v.status == "pass"
            base_pass += 1
    if not coverage.is_empty() and built
        mut skip := Set[str]()
        for t in found.tests
            skip.add(t.name)
        for mt in mf.tests
            skip.add(mt.t.name)
        for c in collect_cover(
            "{exe}.sites",
            "{exe}.hits",
            file,
            copy,
            last_lead,
            lines.len(),
            scratch,
            dir,
            skip,
        )
            if mutating
                if c.file == file
                    reached = c.hit_lines
            else
                print_cover(c, json, coverage == "lines")
    mut exit_code := code
    if mutating
        exit_code = run_mutants(
            file,
            text,
            found.tests,
            reached,
            mutate_max,
            timeout,
            json,
            base_pass,
            built,
            code,
        )?
    if scratch.is_empty()
        for f in [copy, exe, "{exe}.sites", "{exe}.hits", "{exe}.fuzz", "{exe}.trace", "{exe}.rec"]
            rm_file(f)
    else
        remove_scrap(scratch)
    io.exit(exit_code)
