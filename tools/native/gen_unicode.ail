## Writes `compiler/rt/native/unicode.ail`: the Unicode tables of the native
## runtime (native.str.1, ADR 0567), read off the interpreter, which is the
## reference (ADR 0032):
##
##     ./ail run tools/native/gen_unicode.ail > compiler/rt/native/unicode.ail
##
## Every table is a string constant of 3-character numbers in base 91 over
## the printable ASCII characters except `"`, `\`, `{` and `}`.
## - `UNI_ALPHA`, `UNI_UPPER`, `UNI_LOWER`: sorted (first, last) pairs of the
##   scalar values for which `is_alpha`, `is_upper`, `is_lower` hold.
## - `UNI_TO_UPPER`, `UNI_TO_LOWER`: sorted runs (first, count, stride,
##   zigzag delta) of the single-character mapping of `to_upper`, `to_lower`.
## - `UNI_UP_SPECIAL`, `UNI_LO_SPECIAL`: sorted records of 13 characters, the
##   scalar value then the length and three scalar values, of the characters
##   whose `str` case mapping has several characters (`"ß".to_upper()`).

DIGITS := 91

fn digit_char(d int) str
    mut b := 32 + d
    # Skip `"` (34), `\` (92), `{` (123) and `}` (125).
    if b >= 34
        b += 1
    if b >= 92
        b += 1
    if b >= 123
        b += 1
    if b >= 125
        b += 1
    c := char.from_code(b) else return "x"
    c.to_str()

fn number(n int) str
    if n < 0 or n >= 753571
        io.eprint("value {n} doesn't fit in three digits")
        io.exit(1)
    "{digit_char(n / 8281)}{digit_char(n / 91 % 91)}{digit_char(n % 91)}"

fn zigzag(d int) int
    if d >= 0 then d * 2 else 0 - d * 2 - 1

fn ranges(name str, holds List[bool]) str
    mut out := List[str]()
    mut start := -1
    for n in 0..holds.len()
        if holds[n] and start < 0
            start = n
        if not holds[n] and start >= 0
            out.push(number(start))
            out.push(number(n - 1))
            start = -1
    if start >= 0
        out.push(number(start))
        out.push(number(holds.len() - 1))
    "{name} := \"{out.join("")}\""

fn runs(name str, from List[int], to List[int]) str
    mut out := List[str]()
    mut i := 0
    while i < from.len()
        delta := to[i] - from[i]
        mut stride := 1
        mut j := i + 1
        if i + 1 < from.len()
            step := from[i + 1] - from[i]
            if (step == 1 or step == 2) and to[i + 1] - from[i + 1] == delta
                stride = step
                j = i + 2
                while j < from.len()
                    and from[j] - from[j - 1] == stride
                    and to[j] - from[j] == delta
                    j += 1
        out.push(number(from[i]))
        out.push(number(j - i))
        out.push(number(stride))
        out.push(number(zigzag(delta)))
        i = j
    "{name} := \"{out.join("")}\""

fn specials(name str, codes List[int], texts List[List[int]]) str
    mut out := List[str]()
    for i in 0..codes.len()
        out.push(number(codes[i]))
        out.push(digit_char(texts[i].len()))
        for k in 0..3
            out.push(number(if k < texts[i].len() then texts[i][k] else 0))
    "{name} := \"{out.join("")}\""

fn main()
    top := 1114112
    mut alpha := [false for _ in 0..top]
    mut upper := [false for _ in 0..top]
    mut lower := [false for _ in 0..top]
    mut up_from := List[int]()
    mut up_to := List[int]()
    mut lo_from := List[int]()
    mut lo_to := List[int]()
    mut up_codes := List[int]()
    mut up_texts := List[List[int]]()
    mut lo_codes := List[int]()
    mut lo_texts := List[List[int]]()
    for n in 0..top
        c := char.from_code(n) else continue
        alpha[n] = c.is_alpha()
        upper[n] = c.is_upper()
        lower[n] = c.is_lower()
        u := c.to_upper()
        if u != c
            up_from.push(n)
            up_to.push(u.code())
        l := c.to_lower()
        if l != c
            lo_from.push(n)
            lo_to.push(l.code())
        if n >= 128
            us := c.to_str().to_upper().chars()
            if us.len() > 3
                io.eprint("{n}: upper case longer than three characters")
                io.exit(1)
            if us.len() != 1
                up_codes.push(n)
                up_texts.push([x.code() for x in us])
            ls := c.to_str().to_lower().chars()
            if ls.len() > 3
                io.eprint("{n}: lower case longer than three characters")
                io.exit(1)
            if ls.len() != 1
                lo_codes.push(n)
                lo_texts.push([x.code() for x in ls])
    print("## Runtime: part of the AIL native runtime; linked into user executables")
    print("## under the Runtime Exception (see LICENSE).")
    print("##")
    print("## Generated by tools/native/gen_unicode.ail from the interpreter's Unicode")
    print("## tables (native.str.1, ADR 0567). Do not edit; run the generator.")
    print("")
    print(ranges("UNI_ALPHA", alpha))
    print(ranges("UNI_UPPER", upper))
    print(ranges("UNI_LOWER", lower))
    print(runs("UNI_TO_UPPER", up_from, up_to))
    print(runs("UNI_TO_LOWER", lo_from, lo_to))
    print(specials("UNI_UP_SPECIAL", up_codes, up_texts))
    print(specials("UNI_LO_SPECIAL", lo_codes, lo_texts))
