## Writes `compiler/derive/gens.ail`: the prelude's derive generators and
## the reflection types they read, inside the native compiler, so it fills in
## `impl ToJson for T` and the like without the Rust front end (ADR 0850):
##
##     ./ail run tools/native/gen_derive.ail > compiler/derive/gens.ail
##
## The blocks are copied from `tools/native/prelude.ail` with `pub` added,
## so the generators run the same code in the interpreter and natively.

WANT_FNS := [
    "json_members",
    "json_write",
    "json_fields",
    "json_read",
    "json_tuple_parts",
    "json_optional",
    "default_of",
]

WANT_TYPES := [
    "struct TypeInfo",
    "enum TypeKind",
    "struct FieldInfo",
    "struct VariantInfo",
    "error struct DeriveError",
]

## Whether the block with header line `head` is one the compiler keeps.
fn wanted(head str) bool
    for t in WANT_TYPES
        if head == t
            return true
    if h := head.strip_prefix("fn ")
        name := h.split("(")[0].split("[")[0]
        return name.starts_with("derive_") or WANT_FNS.contains(name)
    false

## The block with `pub` on its header and, for a struct, on its fields.
fn publish(block List[str], head int) List[str]
    mut out := List[str]()
    is_struct := block[head].contains("struct ")
    for k in 0..block.len()
        line := block[k]
        if k == head
            out.push("pub {line}")
        elif is_struct and k > head and line.starts_with("    ") and not line.starts_with("     ")
            out.push("    pub {line.slice(4, line.len())}")
        else
            out.push(line)
    out

fn main() !
    text := fs.read_text("tools/native/prelude.ail")?
    mut blocks := List[List[str]]()
    mut cur := List[str]()
    mut head := -1
    for line in text.lines()
        top := line != "" and not line.starts_with(" ")
        if top and head >= 0 and not line.starts_with("##")
            blocks.push(cur)
            cur = []
            head = -1
        elif top and head >= 0
            blocks.push(cur)
            cur = []
            head = -1
        if top and not line.starts_with("##") and head < 0
            head = cur.len()
        cur.push(line)
    if head >= 0
        blocks.push(cur)
    print("## Generated by tools/native/gen_derive.ail from tools/native/prelude.ail")
    print("## (ADR 0850). Do not edit; run the generator.")
    for b in blocks
        mut h := 0
        while h < b.len() and (b[h] == "" or b[h].starts_with("##"))
            h += 1
        if h >= b.len() or not wanted(b[h])
            continue
        print("")
        mut lines := [l for l in publish(b, h) if not l.starts_with("## @module")]
        while lines.len() > 0 and lines[lines.len() - 1] == ""
            lines = lines[..lines.len() - 1]
        print(lines.join("\n"))
