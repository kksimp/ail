## The standard traits and `Ordering` (ADR 0127). The bootstrap reads this
## before every program, so its declarations are built in.

enum Ordering
    Less
    Equal
    Greater

## An atomic operation's memory ordering, given as `a.load(order: Relaxed)`
## (conc.atomic.7, ADR 0352). Leaving it out means `SeqCst`.
enum AtomicOrder
    SeqCst
    Acquire
    Release
    AcqRel
    Relaxed

trait Eq
    fn eq(self, other Self) bool

## `Ord` requires `Eq` (trait.std.2, trait.super.1).
trait Ord Eq
    fn cmp(self, other Self) Ordering
    fn min(self, other Self) Self
        if self.cmp(other) == Greater
            other
        else
            self
    fn max(self, other Self) Self
        if self.cmp(other) == Less
            other
        else
            self

trait ToStr
    fn to_str(self) str

## Map keys and set elements. Automatic, with no methods (trait.auto.5);
## requires `Eq` (trait.super.1, ADR 0133).
trait Hash Eq

## The cleanup of a unique type: runs once when the value's owner goes out
## of scope, unless it was moved away first (own.uniq.3, ADR 0191).
trait Drop
    fn drop(mut self)

## The arithmetic operators of a type (trait.op.1, ADR 1124): `a + b` calls
## `a.add(b)`, and likewise `-` sub, `*` mul, `/` div, `%` rem; unary `-a`
## calls `a.neg()`. `a += b` is `a = a + b`. Built-in numbers keep their own
## operators and implement none of these.
trait Add
    fn add(self, other Self) Self

trait Sub
    fn sub(self, other Self) Self

trait Mul
    fn mul(self, other Self) Self

trait Div
    fn div(self, other Self) Self

trait Rem
    fn rem(self, other Self) Self

trait Neg
    fn neg(self) Self

## What `Task.wait()` fails with when the task trapped (conc.task.6, err.trap.2, ADR 0187):
## the trap's rule and its message.
error struct Trapped
    rule str
    message str

## What `?` fails with on `none` in a function whose errors are inferred
## (err.prop.5, ADR 0279).
error struct Absent "a value is absent"

## What `task.check()` fails with once the running task is cancelled
## (conc.cancel.2, ADR 0321).
error struct Cancelled "the task was cancelled"
## @module json
## `std.json` (lane 5, plan section 4): a JSON value, parser and printer. It
## is read only when the program names one of its public items and doesn't
## declare that name itself, so other programs pay nothing for it
## (json.prelude.1).
## TODO(lane 4): once `use std.NAME` exists, move these to `use std.json` as
## `json.parse`, `json.Value`, and so on (ADR 0161).

## The JSON value (json.type.1).
enum Json
    Null
    Bool(b bool)
    Num(n float)
    Str(s str)
    Arr(items List[Json])
    Obj(members List[JsonMember])

struct JsonMember
    key str
    value Json

## `at` is the 0-based character offset of the problem (json.err.1).
error struct JsonError
    at int
    message str

struct JsonParser
    chars List[char]
    pos int

fn JsonParser.fail_at(self, at int, message str) JsonError
    JsonError(at, message)

fn JsonParser.fail(self, message str) JsonError
    JsonError(self.pos, message)

fn JsonParser.at_end(self) bool
    self.pos >= self.chars.len()

fn JsonParser.peek(self) char?
    if self.at_end()
        return none
    self.chars[self.pos]

fn JsonParser.unexpected(self) JsonError
    if c := self.peek()
        return self.fail("unexpected character '{c}'")
    self.fail("unexpected end of input")

fn JsonParser.skip_space(mut self)
    while not self.at_end() and " \t\n\r".contains(self.chars[self.pos])
        self.pos += 1

fn JsonParser.document(mut self) !Json
    value := self.value()?
    self.skip_space()
    if not self.at_end()
        return self.fail("extra data after value")
    value

fn JsonParser.value(mut self) !Json
    self.skip_space()
    c := self.peek() else return self.unexpected()
    if c == '-' or c.is_digit()
        return self.number()
    match c
        '{' => self.object()
        '[' => self.array()
        '"' => Str(self.string()?)
        _ =>
            if self.word("true")
                return Bool(true)
            if self.word("false")
                return Bool(false)
            if self.word("null")
                return Null
            self.unexpected()

fn JsonParser.word(mut self, w str) bool
    end := self.pos + w.chars().len()
    if end > self.chars.len() or self.chars[self.pos..end].join("") != w
        return false
    self.pos = end
    true

fn JsonParser.object(mut self) !Json
    self.pos += 1
    self.skip_space()
    if self.peek() == '}'
        self.pos += 1
        return Obj([])
    mut members := []
    while true
        self.skip_space()
        if self.peek() != '"'
            return self.unexpected()
        key := self.string()?
        self.skip_space()
        if self.peek() != ':'
            if self.at_end()
                return self.unexpected()
            return self.fail("expected ':' after object key")
        self.pos += 1
        members.push(JsonMember(key, self.value()?))
        if self.container_end('}')?
            return Obj(members)

fn JsonParser.array(mut self) !Json
    self.pos += 1
    self.skip_space()
    if self.peek() == ']'
        self.pos += 1
        return Arr([])
    mut items := []
    while true
        items.push(self.value()?)
        if self.container_end(']')?
            return Arr(items)

fn JsonParser.container_end(mut self, close char) !bool
    self.skip_space()
    if self.peek() == close
        self.pos += 1
        return true
    if self.peek() != ','
        return self.unexpected()
    comma := self.pos
    self.pos += 1
    self.skip_space()
    if self.peek() == ']' or self.peek() == '}'
        return self.fail_at(comma, "trailing comma")
    false

fn JsonParser.string(mut self) !str
    start := self.pos
    self.pos += 1
    mut text := []
    while true
        c := self.peek() else return self.fail_at(start, "unterminated string")
        match c
            '"' => break
            '\n' => return self.fail_at(start, "unterminated string")
            '\\' => text.push(self.escape(start)?)
            _ =>
                if c.code() < 0x20
                    return self.fail("control character in string")
                text.push(c)
                self.pos += 1
    self.pos += 1
    text.join("")

fn JsonParser.escape(mut self, start int) !char
    at := self.pos
    self.pos += 1
    c := self.peek() else return self.fail_at(start, "unterminated string")
    self.pos += 1
    match c
        '"' | '\\' | '/' => c
        'b' => '\u{8}'
        'f' => '\u{c}'
        'n' => '\n'
        'r' => '\r'
        't' => '\t'
        'u' => self.unicode(at)
        _ => return self.fail_at(at, "invalid escape '\\{c}'")

## Four hex digits at `pos`, advancing past them.
fn JsonParser.hex4(mut self, at int) !int
    end := self.pos + 4
    if end > self.chars.len()
        return self.fail_at(at, "invalid unicode escape")
    mut code := 0
    for d in self.chars[self.pos..end]
        code = code * 16 + (d.to_digit(16) else return self.fail_at(at, "invalid unicode escape"))
    self.pos = end
    code

## A `\u` escape; a high surrogate must be followed by `\u` and a low one.
fn JsonParser.unicode(mut self, at int) !char
    mut code := self.hex4(at)?
    if code >= 0xDC00 and code <= 0xDFFF
        return self.fail_at(at, "unpaired surrogate escape")
    if code >= 0xD800 and code <= 0xDBFF
        if self.pos + 2 > self.chars.len()
            or self.chars[self.pos] != '\\'
            or self.chars[self.pos + 1] != 'u'
            return self.fail_at(at, "unpaired surrogate escape")
        low_at := self.pos
        self.pos += 2
        low := self.hex4(low_at)?
        if low < 0xDC00 or low > 0xDFFF
            return self.fail_at(at, "unpaired surrogate escape")
        code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)
    ch := char.from_code(code) else return self.fail_at(at, "invalid unicode escape")
    ch

fn JsonParser.digits(mut self) int
    start := self.pos
    while not self.at_end() and self.chars[self.pos].is_digit()
        self.pos += 1
    self.pos - start

fn JsonParser.number(mut self) !Json
    start := self.pos
    if self.peek() == '-'
        self.pos += 1
    if self.peek() == '0'
        self.pos += 1
    elif self.digits() == 0
        return self.fail("invalid number")
    if self.peek() == '.'
        self.pos += 1
        if self.digits() == 0
            return self.fail("invalid number")
    if self.peek() == 'e' or self.peek() == 'E'
        self.pos += 1
        if self.peek() == '+' or self.peek() == '-'
            self.pos += 1
        if self.digits() == 0
            return self.fail("invalid number")
    text := self.chars[start..self.pos].join("")
    n := text.to_float() else return self.fail_at(start, "invalid number")
    ## json.parse.2: an infinite or NaN number fails at its first character.
    if n - n != 0.0
        return self.fail_at(start, "number out of range")
    Num(n)

## Every line of `text` that is one JSON document, in order; other lines are
## skipped (json.lines.1).
fn parse_json_lines(text str) List[Json]
    mut docs := []
    for line in text.lines()
        doc := parse_json(line) else continue
        docs.push(doc)
    docs

## Parse one JSON document (json.parse.1).
fn parse_json(text str) Json ! JsonError
    mut p := JsonParser(text.chars(), 0)
    p.document()

## A number as JSON text: whole numbers below 1e15 without a fraction (json.print.1),
## infinite and NaN as `null` (json.print.2).
fn json_num(n float) str
    if n - n != 0.0
        return "null"
    if n.abs() < 1000000000000000.0 and n.floor() == n
        return "{n.to_int()}"
    "{n}"

fn json_quote(s str) str
    mut out := ["\""]
    for c in s.chars()
        piece := match c
            '"' => "\\\""
            '\\' => "\\\\"
            '\n' => "\\n"
            '\r' => "\\r"
            '\t' => "\\t"
            '\u{8}' => "\\b"
            '\u{c}' => "\\f"
            _ =>
                if c.code() < 0x20
                    "\\u{c.code().to_hex().pad_left(4, '0')}"
                else
                    "{c}"
        out.push(piece)
    out.push("\"")
    out.join("")

## Compact text: no spaces, object members in document order (json.print.1).
## Infinite and NaN numbers print as `null` (json.print.2).
fn Json.to_text(self) str
    match self
        Null => "null"
        Bool(b) => "{b}"
        Num(n) => json_num(n)
        Str(s) => json_quote(s)
        Arr(items) =>
            mut parts := []
            for item in items
                parts.push(item.to_text())
            "[{parts.join(",")}]"
        Obj(members) =>
            mut parts := []
            for m in members
                parts.push("{json_quote(m.key)}:{m.value.to_text()}")
            "\{{parts.join(",")}}"

## The text form is the JSON text, so `j.to_str()`, `print(j)` and `"{j}"` write JSON
## (json.print.3, trait.std.3).
impl ToStr for Json
    fn to_str(self) str
        self.to_text()

## The first member named `key`; `none` unless this is an object (json.query.1).
fn Json.get(self, key str) Json?
    match self
        Obj(members) =>
            for m in members
                if m.key == key
                    return m.value
            none
        Null | Bool(_) | Num(_) | Str(_) | Arr(_) => none

fn Json.at(self, i int) Json?
    match self
        Arr(items) =>
            if i < 0 or i >= items.len()
                return none
            items[i]
        Null | Bool(_) | Num(_) | Str(_) | Obj(_) => none

fn Json.as_str(self) str?
    match self
        Str(s) => s
        Null | Bool(_) | Num(_) | Arr(_) | Obj(_) => none

fn Json.as_num(self) float?
    match self
        Num(n) => n
        Null | Bool(_) | Str(_) | Arr(_) | Obj(_) => none

fn Json.as_bool(self) bool?
    match self
        Bool(b) => b
        Null | Num(_) | Str(_) | Arr(_) | Obj(_) => none

fn Json.as_arr(self) List[Json]?
    match self
        Arr(items) => items
        Null | Bool(_) | Num(_) | Str(_) | Obj(_) => none

fn Json.as_obj(self) List[JsonMember]?
    match self
        Obj(members) => members
        Null | Bool(_) | Num(_) | Str(_) | Arr(_) => none

## Typed fields: member `key` when it holds that variant, else `none` (json.query.2).
fn Json.str(self, key str) str?
    self.get(key)?.as_str()

fn Json.num(self, key str) float?
    self.get(key)?.as_num()

fn Json.bool(self, key str) bool?
    self.get(key)?.as_bool()

fn Json.arr(self, key str) List[Json]?
    self.get(key)?.as_arr()

## The text member `key`, or `default` when it is missing or not text (json.query.5).
fn Json.text(self, key str, default str) str
    v := self.get(key) else return default
    v.as_str() else default

## The bool member `key`, or `default` when it is missing or not a bool (json.query.6).
fn Json.flag(self, key str, default bool) bool
    v := self.get(key) else return default
    v.as_bool() else default

## Replaces the first member named `key`, or adds one at the end; traps unless
## this is an object (json.query.3).
fn Json.set(mut self, key str, value Json)
    mut members := self.as_obj() else unreachable("json.query.3: `set` needs a JSON object")
    if i := [m.key for m in members].index_of(key)
        members[i].value = value
    else
        members.push(JsonMember(key: key, value: value))
    self = Json.Obj(members)

## The value at a JSON Pointer (RFC 6901), or `none` (json.pointer.1).
fn Json.pointer(self, path str) Json?
    if path == ""
        return self
    if not path.starts_with("/")
        return none
    mut cur := self
    for raw in path.split("/").skip(1)
        cur = cur.pointer_step(raw.replace("~1", "/").replace("~0", "~"))?
    cur

## One decoded pointer token: a member of an object, or an index of an array
## (no sign, no leading zero; `-` is past the end, so `none`).
fn Json.pointer_step(self, tok str) Json?
    match self
        Obj(_) => self.get(tok)
        Arr(_) =>
            if tok == "" or (tok.len() > 1 and tok.starts_with("0"))
                return none
            for c in tok.chars()
                if not c.is_digit()
                    return none
            i := tok.to_int()?
            self.at(i)
        Null | Bool(_) | Num(_) | Str(_) => none

## `self` with the JSON Merge Patch `patch` applied (RFC 7386, json.merge.1): an
## object patch merges member by member, a `null` member removes the key, and
## any other patch replaces the value.
fn Json.merge(self, patch Json) Json
    match patch
        Obj(pm) =>
            mut members := self.as_obj() else List[JsonMember]()
            for m in pm
                if m.value.kind() == "null"
                    members = [x for x in members if x.key != m.key]
                elif i := [x.key for x in members].index_of(m.key)
                    members[i].value = members[i].value.merge(m.value)
                else
                    members.push(JsonMember(key: m.key, value: Json.Null.merge(m.value)))
            Json.Obj(members)
        Null | Bool(_) | Num(_) | Str(_) | Arr(_) => patch

## A whole number, or `none` unless this is a number without a fraction.
fn Json.as_int(self) int?
    n := self.as_num()?
    if n.floor() != n
        return none
    n.to_int()

fn Json.int(self, key str) int?
    self.get(key)?.as_int()

## The JSON kind of this value, for messages: `null`, `bool`, `number`, ...
fn Json.kind(self) str
    match self
        Null => "null"
        Bool(_) => "bool"
        Num(_) => "number"
        Str(_) => "string"
        Arr(_) => "array"
        Obj(_) => "object"

## Member `key`, or a `JsonError` naming it (json.query.4). The `need_*`
## forms fail with the kind they expected; derived `from_json` uses them.
## `at` is -1: the value isn't tied to a place in a text.
fn Json.need(self, key str) Json ! JsonError
    v := self.get(key) else return JsonError(-1, "missing {key}")
    v

fn Json.need_str(self) str ! JsonError
    v := self.as_str() else return JsonError(-1, "expected a string, found {self.kind()}")
    v

fn Json.need_num(self) float ! JsonError
    v := self.as_num() else return JsonError(-1, "expected a number, found {self.kind()}")
    v

fn Json.need_int(self) int ! JsonError
    v := self.as_int() else return JsonError(-1, "expected a whole number, found {self.to_text()}")
    v

fn Json.need_bool(self) bool ! JsonError
    v := self.as_bool() else return JsonError(-1, "expected a bool, found {self.kind()}")
    v

fn Json.need_arr(self) List[Json] ! JsonError
    v := self.as_arr() else return JsonError(-1, "expected an array, found {self.kind()}")
    v

fn Json.need_obj(self) List[JsonMember] ! JsonError
    v := self.as_obj() else return JsonError(-1, "expected an object, found {self.kind()}")
    v

## `self`, or `none` when it is `null` (json.query.4).
fn Json.non_null(self) Json?
    if self == Json.Null
        return none
    self

## Member `key` unless it is missing or `null` (json.query.4).
fn Json.opt(self, key str) Json?
    v := self.get(key)?
    v.non_null()

## The variant a derived `from_json` reads: a string, or the member `kind`
## of an object (json.derive.2).
fn Json.variant_name(self) str ! JsonError
    if s := self.as_str()
        return s
    if self.as_obj() == none
        return JsonError(
            -1,
            "expected a variant name or an object with `kind`, found {self.kind()}",
        )
    k := self.need("kind")?
    s := k.need_str() else e
        return e.under("kind")
    s

## This error under `part` of a path, a member name or `[i]` (json.derive.3):
## `missing kind` under `items[2]` gives `missing items[2].kind`, and
## `expected a string, found number` under `name` gives
## `name: expected a string, found number`.
fn JsonError.under(self, part str) JsonError
    if rest := self.message.strip_prefix("missing ")
        return JsonError(self.at, "missing {json_path(part, rest)}")
    if i := self.message.find(": ")
        head := self.message.slice(0, i)
        if not head.contains(" ")
            return JsonError(self.at, json_path(part, self.message))
    JsonError(self.at, "{part}: {self.message}")

fn json_path(part str, rest str) str
    if rest.starts_with("[")
        return "{part}{rest}"
    "{part}.{rest}"

## @module jsonderive
## A value with a JSON form. `impl ToJson for T` with no methods derives
## `to_json` with `derive_to_json` (ct.derive.2, ADR 0307).
@derive(derive_to_json) trait ToJson
    fn to_json(self) Json

impl ToJson for Json
    fn to_json(self) Json
        self

impl ToJson for str
    fn to_json(self) Json
        Json.Str(self)

impl ToJson for int
    fn to_json(self) Json
        Json.Num(self.to_float())

impl ToJson for float
    fn to_json(self) Json
        Json.Num(self)

impl ToJson for bool
    fn to_json(self) Json
        Json.Bool(self)

impl ToJson for List[T ToJson]
    fn to_json(self) Json
        Json.Arr([x.to_json() for x in self])

## json.derive.4: a map is an object of its entries, each key's text form
## naming its member, in the map's order (ADR 1093). `m.to_json()` on a
## `Map[K, V ToJson]` calls this.
fn json_of_map[K Hash, V ToJson](m Map[K, V]) Json
    Json.Obj([JsonMember("{k}", m[k].to_json()) for k in m.keys()])

## json.derive.4: `none` is `null` and a present value its own JSON
## (ADR 1093). `x.to_json()` on a `T?` whose `T` is `ToJson` calls this.
fn json_of_opt[T ToJson](v T?) Json
    if x := v
        return x.to_json()
    Json.Null

## A type that can be read from JSON. `impl FromJson for T` with no
## functions derives `from_json` with `derive_from_json` (ct.derive.2,
## ADR 0307); generic code calls it as `T.from_json(j)` (trait.assoc.2,
## ADR 0350).
@derive(derive_from_json) trait FromJson
    fn from_json(j Json) Self ! JsonError

impl FromJson for Json
    fn from_json(j Json) Json ! JsonError
        j

impl FromJson for str
    fn from_json(j Json) str ! JsonError
        j.need_str()

impl FromJson for int
    fn from_json(j Json) int ! JsonError
        j.need_int()

impl FromJson for float
    fn from_json(j Json) float ! JsonError
        j.need_num()

impl FromJson for bool
    fn from_json(j Json) bool ! JsonError
        j.need_bool()

impl FromJson for List[T FromJson]
    fn from_json(j Json) List[T] ! JsonError
        a := j.need_arr()?
        mut out := List[T]()
        for i in 0..a.len()
            x := T.from_json(a[i]) else e
                return e.under("[{i}]")
            out.push(x)
        out

## json.load.1: reads the file at `path` and decodes it as a `T`. A file that
## can't be read fails with a `JsonError` that starts with the path and the
## I/O kind.
fn load_json[T FromJson](path str) T ! JsonError
    text := fs.read_text(path) else e
        return JsonError(-1, "{path}: {e.kind}")
    T.from_json(parse_json(text)?)?

## json.load.2: prints `v` as one line of JSON.
fn print_json[T ToJson](v T)
    print(v.to_json().to_text())

## A struct becomes an object of its fields in declaration order; an enum
## variant without fields becomes its name, one with fields an object
## `{"kind": "Name", fields...}` (json.derive.1). A field `T?` that is
## `none` becomes `null`.
fn derive_to_json(t TypeInfo) str ! DeriveError
    if t.kind == TypeKind.Struct
        return "fn to_json(self) Json\n    Json.Obj({json_members(t.fields, "self.", "    ", "")})\n"
    mut out := ["fn to_json(self) Json\n    match self\n"]
    for v in t.variants
        if v.fields.len() == 0
            out.push("        {v.name} => Json.Str(\"{v.name}\")\n")
        else
            # `v_` keeps a keyword-named field a plain name (lex.kw.3, ADR 1085).
            names := ["v_{f.name}" for f in v.fields]
            kind := "{"                JsonMember(\"kind\", Json.Str(\"{v.name}\")),\n"}"
            body := "Json.Obj({json_members(v.fields, "v_", "            ", kind)})"
            out.push("        {v.name}({names.join(", ")}) => {body}\n")
    out.join("")

## `[JsonMember(...), ...]` for `fields` after the member text `first`, one
## per line after `indent`.
fn json_members(fields List[FieldInfo], prefix str, indent str, first str) str
    if fields.len() == 0 and first == ""
        return "List[JsonMember]()"
    mut parts := [first]
    for f in fields
        value := json_write(f.type_text, "{prefix}{f.name}", 0)
        parts.push("{indent}    JsonMember(\"{f.name}\", {value}),\n")
    "[\n{parts.join("")}{indent}]"

## An expression giving the `Json` of `e`, a `type_text`: lists and maps
## of values without `to_json` convert each element (json.derive.1).
fn json_write(type_text str, e str, depth int) str
    x := "x{depth}"
    if inner := type_text.strip_suffix("?")
        if json_tuple_parts(inner) != none
            return "(if {x} := {e} then {json_write(inner, x, depth + 1)} else Json.Null)"
        return "{e}?.to_json() else Json.Null"
    # type.tuple.8: a tuple is an array of its elements.
    if parts := json_tuple_parts(type_text)
        items := [json_write(parts[i], "{e}.{i}", depth + 1) for i in 0..parts.len()]
        return "Json.Arr([{items.join(", ")}])"
    if inner := type_text.strip_prefix("Map[str, ")
        elem := inner.slice(0, inner.chars().len() - 1)
        return "Json.Obj([JsonMember({x}, {json_write(elem, "{e}[{x}]", depth + 1)}) for {x} in {e}.keys()])"
    if inner := type_text.strip_prefix("List[")
        elem := inner.slice(0, inner.chars().len() - 1)
        if elem.contains("[") or elem.contains("(") or elem.ends_with("?")
            mut w := json_write(elem, x, depth + 1)
            if elem.ends_with("?")
                w = "({w})"
            return "Json.Arr([{w} for {x} in {e}])"
    "{e}.to_json()"

## A struct reads each field from the member of its name; a field `T?` may
## be missing or `null`. An enum reads a variant's name, or an object
## `{"kind": "Name", fields...}` (json.derive.2). A failure names its path,
## such as `missing items[2].kind` (json.derive.3).
fn derive_from_json(t TypeInfo) str ! DeriveError
    head := "fn from_json(j Json) Self ! JsonError\n"
    if t.kind == TypeKind.Struct
        reads := json_fields(t.fields, "    ")?
        args := ["{f.name}: v_{f.name}" for f in t.fields]
        return "{head}{reads}    {t.name}({args.join(", ")})\n"
    if [v for v in t.variants if v.fields.len() > 0].len() == 0
        mut out := [head, "    name := j.need_str()?\n"]
        for v in t.variants
            out.push("    if name == \"{v.name}\"\n        return {t.name}.{v.name}\n")
        out.push("    return JsonError(-1, \"unknown {t.name} `\{name}`\")\n")
        return out.join("")
    for v in t.variants
        if [f for f in v.fields if f.name == "kind"].len() > 0
            return DeriveError("`{t.name}.{v.name}` has a field `kind`, which would clash with the member `kind` that names the variant in JSON")
    mut out := [head, "    name := j.variant_name()?\n"]
    for v in t.variants
        out.push("    if name == \"{v.name}\"\n")
        if v.fields.len() == 0
            out.push("        return {t.name}.{v.name}\n")
        else
            out.push(json_fields(v.fields, "        ")?)
            args := ["{f.name}: v_{f.name}" for f in v.fields]
            out.push("        return {t.name}.{v.name}({args.join(", ")})\n")
    out.push("    return JsonError(-1, \"unknown {t.name} `\{name}`\")\n")
    out.join("")

## Statements reading each of `fields` from the object `j` into `v_NAME`.
fn json_fields(fields List[FieldInfo], indent str) str ! DeriveError
    mut out := []
    for f in fields
        dest := "v_{f.name}"
        if inner := f.type_text.strip_suffix("?")
            out.push(json_optional(inner, "j.opt(\"{f.name}\")", dest, f.name, indent, 0)?)
        else
            out.push("{indent}x_{f.name} := j.need(\"{f.name}\")?\n")
            out.push(json_read(f.type_text, "x_{f.name}", dest, f.name, indent, 0)?)
    out.join("")

## Statements at `indent` that read a `type_text` from the `Json` expression
## `src` into a new local `dest`; a failure is returned under `path`, the
## text of a string literal naming the place (json.derive.3).
fn json_read(type_text str, src str, dest str, path str, indent str, depth int) str ! DeriveError
    fail := "else e\n{indent}    return e.under(\"{path}\")\n"
    reader := match type_text
        "str" => "need_str"
        "float" => "need_num"
        "int" => "need_int"
        "bool" => "need_bool"
        _ => ""
    if reader != ""
        return "{indent}{dest} := {src}.{reader}() {fail}"
    if type_text == "Json"
        return "{indent}{dest} := {src}\n"
    if inner := type_text.strip_suffix("?")
        return json_optional(inner, "{src}.non_null()", dest, path, indent, depth)
    y := "{dest}_y"
    deeper := "{indent}    "
    # type.tuple.8: an array of exactly the tuple's elements.
    if parts := json_tuple_parts(type_text)
        a := "{dest}_a"
        mut out := ["{indent}{a} := {src}.need_arr() {fail}"]
        out.push("{indent}if {a}.len() != {parts.len()}\n{deeper}return JsonError(-1, \"expected {parts.len()} elements, found \{{a}.len()}\").under(\"{path}\")\n")
        for i in 0..parts.len()
            out.push(
                json_read(parts[i], "{a}[{i}]", "{dest}_{i}", "{path}[{i}]", indent, depth + 1)?,
            )
        names := ["{dest}_{i}" for i in 0..parts.len()]
        out.push("{indent}{dest} := ({names.join(", ")})\n")
        return out.join("")
    if inner := type_text.strip_prefix("List[")
        elem := inner.slice(0, inner.chars().len() - 1)
        a := "{dest}_a"
        i := "{dest}_i"
        body := json_read(elem, "{a}[{i}]", y, "{path}[\{{i}}]", deeper, depth + 1)?
        return "{indent}{a} := {src}.need_arr() {fail}{indent}mut {dest} := List[{elem}]()\n{indent}for {i} in 0..{a}.len()\n{body}{deeper}{dest}.push({y})\n"
    if inner := type_text.strip_prefix("Map[str, ")
        elem := inner.slice(0, inner.chars().len() - 1)
        o := "{dest}_o"
        m := "{dest}_m"
        body := json_read(elem, "{m}.value", y, "{path}.\{{m}.key}", deeper, depth + 1)?
        return "{indent}{o} := {src}.need_obj() {fail}{indent}mut {dest} := Map[str, {elem}]()\n{indent}for {m} in {o}\n{body}{deeper}{dest}[{m}.key] = {y}\n"
    if type_text.contains("[") or type_text.contains(" ")
        return DeriveError("it can't read the type `{type_text}`; it reads scalars, `Json`, `List[T]`, `Map[str, T]`, `T?`, tuples and types that derive `FromJson`")
    "{indent}{dest} := {type_text}.from_json({src}) {fail}"

## The element types of a tuple type text `(A, B)`, split at the commas
## outside brackets (type.tuple.8), or `none` for another type.
fn json_tuple_parts(type_text str) List[str]?
    if not type_text.starts_with("(") or not type_text.ends_with(")")
        return none
    cs := type_text.chars()
    mut parts := List[str]()
    mut depth := 0
    mut start := 1
    for i in 1..cs.len() - 1
        c := cs[i]
        if c == '[' or c == '('
            depth += 1
        elif c == ']' or c == ')'
            depth -= 1
        elif c == ',' and depth == 0
            parts.push(type_text.slice(start, i).trim())
            start = i + 1
    parts.push(type_text.slice(start, cs.len() - 1).trim())
    parts

## Statements reading an optional `inner?` from the `Json?` expression `src`.
fn json_optional(inner str, src str, dest str, path str, indent str, depth int) str ! DeriveError
    l := "{dest}_l"
    x := "{dest}_x"
    y := "{dest}_y"
    deeper := "{indent}    "
    body := json_read(inner, x, y, path, deeper, depth + 1)?
    "{indent}mut {l} := List[{inner}]()\n{indent}if {x} := {src}\n{body}{deeper}{l}.push({y})\n{indent}{dest} := {l}.first()\n"

## @module default
## A type with a default value, `T.default()` (trait.assoc.1, ADR 0350).
## `impl Default for T` with no functions derives it for a struct whose
## fields all have defaults: `0`, `0.0`, `""`, `false`, an empty list or
## map, `none`, or the field type's own `default()`.
@derive(derive_default) trait Default
    fn default() Self

impl Default for int
    fn default() int
        0

impl Default for float
    fn default() float
        0.0

impl Default for str
    fn default() str
        ""

impl Default for bool
    fn default() bool
        false

impl Default for List[T]
    fn default() List[T]
        List[T]()

## A struct of each field's default (trait.assoc.1); an enum has no
## default variant to pick, so it writes its own.
fn derive_default(t TypeInfo) str ! DeriveError
    if t.kind == TypeKind.Enum
        return DeriveError("an enum has no default variant to pick; write `fn default() Self` in the `impl`")
    args := ["{f.name}: {default_of(f.type_text)}" for f in t.fields]
    "fn default() Self\n    {t.name}({args.join(", ")})\n"

## The default value of a field's `type_text`.
fn default_of(type_text str) str
    if type_text.ends_with("?")
        return "none"
    if type_text.starts_with("List[")
        or type_text.starts_with("Map[")
        or type_text.starts_with("Set[")
        return "{type_text}()"
    match type_text
        "int" => "0"
        "float" => "0.0"
        "str" => "\"\""
        "bool" => "false"
        _ => "{type_text}.default()"

## @module argsderive
## What was wrong with the command line, with the usage text (std.args.6).
error struct ArgsFailure "{self.why}\n{self.usage}"
    why str
    usage str

## A struct read from the command line: `impl FromArgs for Opts` derives
## `Opts.parse(name, about, words)` from the fields (std.args.7).
@derive(derive_from_args) trait FromArgs
    fn parse(name str, about str, words List[str]) Self ! ArgsFailure

## A `bool` field is a switch, `T?` of `str`, `int` or `float` an option, a
## `List[str]` the rest, any other field a positional; the field's `##`
## comment is its help, and a switch or option gets the short name of its
## first letter unless another field or `-h` has it (std.args.7).
fn derive_from_args(t TypeInfo) str ! DeriveError
    mut specs := List[str]()
    mut reads := List[str]()
    mut used := Set[str]()
    used.add("h")
    fail := " else e\n        return ArgsFailure(why: e.why, usage: e.usage)\n"
    for f in t.fields
        n := f.name
        help := f.doc.replace("\n", " ").replace("\\", "\\\\").replace("\"", "\\\"")
        first := n.slice(0, 1)
        short := if used.contains(first) then "" else first
        ty := f.type_text
        if ty == "bool"
            used.add(first)
            specs.push("args.flag(\"{n}\", \"{short}\", \"{help}\")")
            reads.push("    v_{n} := a.flag(\"{n}\")\n")
        elif ty == "str?" or ty == "int?" or ty == "float?"
            used.add(first)
            specs.push("args.opt(\"{n}\", \"{short}\", \"{help}\", \"\")")
            kind := ty.slice(0, ty.len() - 1)
            call := if kind == "str" then "opt" else "opt_{kind}"
            if kind != "str"
                reads.push("    if a.has(\"{n}\")\n        _ := a.{kind}(\"{n}\"){fail.replace("\n    ", "\n        ")}")
            reads.push("    v_{n} := a.{call}(\"{n}\")\n")
        elif ty == "List[str]"
            specs.push("args.rest(\"{n}\", \"{help}\")")
            reads.push("    v_{n} := a.rest\n")
        elif ty == "str"
            specs.push("args.pos(\"{n}\", \"{help}\")")
            reads.push("    v_{n} := a.get(\"{n}\")\n")
        elif ty == "int" or ty == "float"
            specs.push("args.pos(\"{n}\", \"{help}\")")
            reads.push("    v_{n} := a.{ty}(\"{n}\"){fail}")
        else
            return DeriveError("field `{n}` has the type `{ty}`; FromArgs reads `bool`, `str`, `int`, `float`, `str?`, `int?`, `float?` and `List[str]`")
    if t.kind != TypeKind.Struct
        return DeriveError("`FromArgs` needs a struct; `{t.name}` is an enum")
    ctor := ["{f.name}: v_{f.name}" for f in t.fields]
    head := "fn parse(name str, about str, words List[str]) Self ! ArgsFailure\n"
    call := "    a := args.parse(name, about, [{specs.join(", ")}], words){fail}"
    "{head}{call}{reads.join("")}    {t.name}({ctor.join(", ")})\n"
## @module derive
## Derive generators (ct.derive.1-4, refl.info.1-3, ADRs 0227, 0229, 0306):
## the compiler passes a generator the `TypeInfo` of the deriving type.

## One struct or enum as declared (refl.info.1).
struct TypeInfo
    name str
    id str
    module str
    kind TypeKind
    is_error bool
    params List[str]
    fields List[FieldInfo]
    variants List[VariantInfo]

enum TypeKind
    Struct
    Enum

struct FieldInfo
    name str
    type_text str
    public bool
    doc str

struct VariantInfo
    name str
    fields List[FieldInfo]

## Why a generator can't derive its trait for a type (ct.derive.4).
error struct DeriveError
    message str
## @module grid
## `Grid[T]` (type.grid.1-6, ADR 0937): a 2-D list in one flat block, row by
## row. It is read only when the program names `Grid` and doesn't declare
## that name itself.

## `rows`, `cols` and `cells` are read, never assigned (type.grid.2).
struct Grid[T]
    rows int
    cols int
    cells List[T]

## A `rows` by `cols` grid of `v` (type.grid.1).
fn Grid.fill(rows int, cols int, v T) Self
    if rows < 0 or cols < 0
        unreachable("type.grid.1: a grid can't be {rows} by {cols}")
    Grid(rows: rows, cols: cols, cells: [v for _ in 0..rows * cols])

## A grid of the lists `xs`, which must all have the same length (type.grid.1).
fn Grid.from(xs List[List[T]]) Self
    c := if xs.len() == 0 then 0 else xs[0].len()
    mut cells := List[T]()
    for x in xs
        if x.len() != c
            unreachable("type.grid.1: the rows of a grid must have the same length")
        cells.extend(x)
    Grid(rows: xs.len(), cols: c, cells: cells)

## Row `i` as a list (type.grid.4).
fn Grid.row(self, i int) List[T]
    self.cells[i * self.cols..(i + 1) * self.cols]

## The rows as lists (type.grid.4).
fn Grid.to_list(self) List[List[T]]
    [self.row(i) for i in 0..self.rows]
## @module heap
## `Heap[T]` (type.heap.1-5, ADR 1086): a priority queue, smallest first, or
## largest first with `max_first: true`. It is read only when the program
## names `Heap` and doesn't declare that name itself.

## `Heap[int]()` is empty and min-first; `Heap[int](max_first: true)` is
## max-first (type.heap.1). `items` is the binary heap's array, in no
## particular order (type.heap.5).
struct Heap[T Ord]
    items List[T] = []
    max_first bool = false

## A min-first heap of `xs` (type.heap.2).
fn Heap.from(xs List[T]) Self
    mut h := Heap(items: xs, max_first: false)
    h.heapify()
    h

## A max-first heap of `xs` (type.heap.2).
fn Heap.from_max(xs List[T]) Self
    mut h := Heap(items: xs, max_first: true)
    h.heapify()
    h

## Whether `a` comes out before `b`.
fn Heap.before(self, a T, b T) bool
    if self.max_first then a > b else a < b

fn Heap.heapify(mut self)
    mut k := self.items.len() / 2
    while k > 0
        k -= 1
        self.sift_down(k)

fn Heap.sift_down(mut self, start int)
    mut i := start
    while true
        l := 2 * i + 1
        r := l + 1
        mut m := i
        if l < self.items.len() and self.before(self.items[l], self.items[m])
            m = l
        if r < self.items.len() and self.before(self.items[r], self.items[m])
            m = r
        if m == i
            break
        self.items.swap(i, m)
        i = m

## Add `x` (type.heap.3).
fn Heap.push(mut self, x T)
    self.items.push(x)
    mut i := self.items.len() - 1
    while i > 0
        parent := (i - 1) / 2
        if self.before(self.items[i], self.items[parent])
            self.items.swap(i, parent)
            i = parent
        else
            break

## Remove and return the element that comes first, or `none` when the heap is
## empty (type.heap.3).
fn Heap.pop(mut self) T?
    if self.items.is_empty()
        return none
    last := self.items.len() - 1
    self.items.swap(0, last)
    top := self.items.pop()
    self.sift_down(0)
    top

## The element `pop` would return, left in place (type.heap.3).
fn Heap.peek(self) T?
    self.items.first()

## The number of elements (type.heap.4).
fn Heap.len(self) int
    self.items.len()

fn Heap.is_empty(self) bool
    self.items.is_empty()

## Every element in the order `pop` returns them, leaving the heap as it is
## (type.heap.4).
fn Heap.to_sorted(self) List[T]
    mut h := Heap(items: self.items, max_first: self.max_first)
    mut out := List[T]()
    while x := h.pop()
        out.push(x)
    out
## @module deque
## `Deque[T]` (type.deque.1-7, ADR 1086): a double-ended queue with amortised
## O(1) pushes and pops at both ends and O(1) access by position. It is read
## only when the program names `Deque` and doesn't declare that name itself.

## `Deque[int]()` is empty (type.deque.1). The elements, first to last, are
## `front` reversed followed by `back` (type.deque.5).
struct Deque[T]
    front List[T] = []
    back List[T] = []

## A deque of the elements of `xs`, in order (type.deque.1).
fn Deque.from(xs List[T]) Self
    Deque(front: [], back: xs)

## Add `x` as the last element (type.deque.2).
fn Deque.push_back(mut self, x T)
    self.back.push(x)

## Add `x` as the first element (type.deque.2).
fn Deque.push_front(mut self, x T)
    self.front.push(x)

## Remove and return the last element, or `none` when empty (type.deque.2).
fn Deque.pop_back(mut self) T?
    if self.back.is_empty()
        n := self.front.len()
        if n == 0
            return none
        k := (n + 1) / 2
        self.back = [self.front[k - 1 - i] for i in 0..k]
        self.front = self.front[k..]
    self.back.pop()

## Remove and return the first element, or `none` when empty (type.deque.2).
fn Deque.pop_front(mut self) T?
    if self.front.is_empty()
        n := self.back.len()
        if n == 0
            return none
        k := (n + 1) / 2
        self.front = [self.back[k - 1 - i] for i in 0..k]
        self.back = self.back[k..]
    self.front.pop()

## The first element, or `none` when empty (type.deque.3).
fn Deque.first(self) T?
    if self.front.is_empty()
        return self.back.first()
    self.front[self.front.len() - 1]

## The last element, or `none` when empty (type.deque.3).
fn Deque.last(self) T?
    if self.back.is_empty()
        return self.front.first()
    self.back[self.back.len() - 1]

## The number of elements (type.deque.3).
fn Deque.len(self) int
    self.front.len() + self.back.len()

fn Deque.is_empty(self) bool
    self.front.is_empty() and self.back.is_empty()

## The element at position `i` from the front; an index outside `0..len()`
## traps (type.deque.4).
fn Deque.at(self, i int) T
    n := self.front.len()
    if i < 0 or i >= n + self.back.len()
        unreachable("type.deque.4: index {i} is outside 0..{n + self.back.len()}")
    if i < n then self.front[n - 1 - i] else self.back[i - n]

## The elements, first to last, as a list (type.deque.4).
fn Deque.to_list(self) List[T]
    mut out := List[T]()
    for i in 0..self.front.len()
        out.push(self.front[self.front.len() - 1 - i])
    out.extend(self.back)
    out

## The elements `keep` is true for, as a deque (type.deque.6, type.coll.24).
fn Deque.filter(self, keep fn(T) bool) Deque[T]
    Deque.from(self.to_list().filter(keep))

## `f` of each element, first to last, as a list (type.deque.6, type.coll.25).
fn Deque.map[U](self, f fn(T) U) List[U]
    self.to_list().map(f)

## The elements of the lists `f` gives for each element (type.deque.6, type.coll.30).
fn Deque.flat_map[U](self, f fn(T) List[U]) List[U]
    self.to_list().flat_map(f)

## Whether `keep` is true for some element (type.deque.6, type.coll.22).
fn Deque.any(self, keep fn(T) bool) bool
    self.to_list().any(keep)

## Whether `keep` is true for every element (type.deque.6, type.coll.22).
fn Deque.all(self, keep fn(T) bool) bool
    self.to_list().all(keep)

## The first element `keep` is true for, or `none` (type.deque.6, type.coll.23).
fn Deque.find(self, keep fn(T) bool) T?
    self.to_list().find(keep)

## How many elements `keep` is true for (type.deque.6, type.coll.28).
fn Deque.count(self, keep fn(T) bool) int
    self.to_list().count(keep)

## `f(acc, x)` over the elements in order from `init` (type.deque.6, type.coll.29).
fn Deque.fold[A](self, init A, f fn(A, T) A) A
    self.to_list().fold(init, f)

## The first `n` elements, as a deque (type.deque.6, type.coll.15).
fn Deque.take(self, n int) Deque[T]
    Deque.from(self.to_list().take(n))

## The elements after the first `n`, as a deque (type.deque.6, type.coll.31).
fn Deque.skip(self, n int) Deque[T]
    Deque.from(self.to_list().skip(n))

## The elements up to the first `keep` is false for (type.deque.6, type.coll.31).
fn Deque.take_while(self, keep fn(T) bool) Deque[T]
    Deque.from(self.to_list().take_while(keep))

## The elements from the first `keep` is false for (type.deque.6, type.coll.31).
fn Deque.skip_while(self, keep fn(T) bool) Deque[T]
    Deque.from(self.to_list().skip_while(keep))

## Each element with its index from 0, as a list (type.deque.6, type.tuple.9).
fn Deque.enumerate(self) List[(int, T)]
    self.to_list().enumerate()

## Pairs of elements of this deque and the list `other`, until either ends
## (type.deque.6, type.coll.31).
fn Deque.zip[U](self, other List[U]) List[(T, U)]
    self.to_list().zip(other)

## Replace the element at position `i` with `v`; an index outside `0..len()`
## traps (type.deque.6).
fn Deque.set(mut self, i int, v T)
    n := self.front.len()
    if i < 0 or i >= n + self.back.len()
        unreachable("type.deque.6: index {i} is outside 0..{n + self.back.len()}")
    if i < n
        self.front[n - 1 - i] = v
    else
        self.back[i - n] = v

## The next element for a `for` loop, taken from the front (type.deque.7).
fn Deque.next(mut self) T?
    self.pop_front()

## @module seq
## `Seq[T]` (expr.yield.1-4, expr.iter.1-3, ADR 1073): a lazy sequence, what a
## generator returns. It is read only when the program names `Seq` and doesn't
## declare that name itself.

## A sequence whose elements are made as they are read: `step` gives the next
## one, or `none` at the end. It is unique: reading it uses it up, so it is
## never copied (own.uniq.1), and `for x in s` takes it over (expr.iter.1).
unique struct Seq[T]
    step fn() T?

## The next element, or `none` once the sequence has ended (expr.iter.2).
fn Seq.next(mut self) T?
    f := self.step
    f()

## The elements of `xs`, in order (expr.iter.3).
fn Seq.of(xs List[T]) Seq[T]
    for x in xs
        yield x

## `f` of each element (expr.iter.3).
fn Seq.map[U](move self, f fn(T) U) Seq[U]
    for x in self
        yield f(x)

## The elements for which `keep` is true (expr.iter.3).
fn Seq.filter(move self, keep fn(T) bool) Seq[T]
    for x in self
        if keep(x)
            yield x

## The elements up to the first for which `keep` is false (expr.iter.3).
fn Seq.take_while(move self, keep fn(T) bool) Seq[T]
    for x in self
        if not keep(x)
            return
        yield x

## The first `n` elements; no more are read (expr.iter.3).
fn Seq.take(move self, n int) Seq[T]
    mut s := self
    mut left := n
    while left > 0
        x := s.next() else return
        yield x
        left -= 1

## The elements after the first `n` (expr.iter.3).
fn Seq.skip(move self, n int) Seq[T]
    mut k := 0
    for x in self
        if k >= n
            yield x
        k += 1

## Each element with its index from 0, as `(i, x)` (expr.iter.3).
fn Seq.enumerate(move self) Seq[(int, T)]
    mut i := 0
    for x in self
        yield (i, x)
        i += 1

## Pairs of elements of the two sequences, until either ends (expr.iter.3).
fn Seq.zip[U](move self, move other Seq[U]) Seq[(T, U)]
    mut a := self
    mut b := other
    while true
        x := a.next() else return
        y := b.next() else return
        yield (x, y)

## The elements of this sequence, then those of `other` (expr.iter.3).
fn Seq.chain(move self, move other Seq[T]) Seq[T]
    for x in self
        yield x
    for y in other
        yield y

## The elements in a list (expr.iter.3).
fn Seq.collect(move self) List[T]
    mut out := List[T]()
    for x in self
        out.push(x)
    out

## How many elements `keep` is true for (expr.iter.4, type.coll.28).
fn Seq.count(move self, keep fn(T) bool) int
    mut n := 0
    for x in self
        if keep(x)
            n += 1
    n

## Whether `keep` is true for some element; reads no further than the first
## that settles it (expr.iter.4, type.coll.22).
fn Seq.any(move self, keep fn(T) bool) bool
    for x in self
        if keep(x)
            return true
    false

## Whether `keep` is true for every element (expr.iter.4, type.coll.22).
fn Seq.all(move self, keep fn(T) bool) bool
    for x in self
        if not keep(x)
            return false
    true

## The first element `keep` is true for, or `none` (expr.iter.4, type.coll.23).
fn Seq.find(move self, keep fn(T) bool) T?
    for x in self
        if keep(x)
            return x
    none

## `f(acc, x)` for each element in order, starting from `init`, and the last
## `acc` (expr.iter.4, type.coll.29).
fn Seq.fold[A](move self, init A, f fn(A, T) A) A
    mut acc := init
    for x in self
        acc = f(acc, x)
    acc

## The elements of the lists `f` gives for each element, in order (expr.iter.4,
## type.coll.30).
fn Seq.flat_map[U](move self, f fn(T) List[U]) Seq[U]
    for x in self
        for y in f(x)
            yield y

## The elements from the first one `keep` is false for (expr.iter.4, type.coll.31).
fn Seq.skip_while(move self, keep fn(T) bool) Seq[T]
    mut skipping := true
    for x in self
        if skipping and not keep(x)
            skipping = false
        if not skipping
            yield x

## @module fail
## The standard text failure (err.fail.1, ADR 1140): `fn f() ! Fail` and
## `return Fail(msg: "...")`. It displays as its text. A program that
## declares its own `Fail` uses that one.
error struct Fail "{self.msg}"
    msg str
