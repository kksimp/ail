## OCR of a scanned page, on demand (ADR 0511, ADR 0512): only a page that
## is shown or searched, has images and no text is recognized, once. Its
## glyphs go through the same line builder as text-layer glyphs, so search,
## JSON and the viewer treat OCR lines like any others.

use image
use reader

## The reference shapes, parsed the first time a page needs them.
struct ShapeCache
    shapes List[Shapes]

pub struct Ocr
    cache ref ShapeCache
    pub on bool

pub fn Ocr.new(on bool) Ocr
    Ocr(cache: ref ShapeCache(shapes: []), on: on)

pub fn Ocr.shapes(self) Shapes
    if cache.shapes.len() == 0
        cache.shapes.push(Shapes.load(SHAPES))
    cache.shapes[0]

## A recognized word in image pixels.
pub struct Word
    pub text str
    pub x0 int
    pub y0 int
    pub x1 int
    pub y1 int
    pub sure float
    ## Each character's left and right edge.
    pub starts List[int]
    pub ends List[int]

## A recognized line: its words, baseline and text size in pixels.
pub struct TextRow
    pub words List[Word]
    pub base int
    pub size int

## Recognizes the text of a grey image.
pub fn read_gray(g image.Gray, shapes Shapes) List[TextRow]
    read_runs(ink_runs(g), shapes)

## Recognizes the text in rows of black runs.
pub fn read_runs(runs List[List[Run]], shapes Shapes) List[TextRow]
    if shapes.labels.len() == 0
        return []
    lines := lines_of(blobs_of(runs))
    mut glyphs := List[Blob]()
    mut owners := List[GlyphLine]()
    for l in lines
        for b in l.glyphs
            glyphs.push(b)
            owners.push(l)
    rows_of(lines, shapes.classify(features_of(glyphs, owners)))

## Lines of glyphs and their guesses, in order, as words.
fn rows_of(lines List[GlyphLine], guesses List[Guess]) List[TextRow]
    mut out := List[TextRow]()
    mut k := 0
    for l in lines
        mut words := List[Word]()
        for wi in 0..l.words.len()
            a := l.words[wi]
            z := if wi + 1 < l.words.len() then l.words[wi + 1] else l.glyphs.len()
            mut text := ""
            mut sure := 1.0
            mut starts := List[int]()
            mut ends := List[int]()
            labels := in_context([guesses[k + i].label for i in a..z])
            for i in a..z
                label := labels[i - a]
                text = "{text}{label}"
                sure = sure.min(guesses[k + i].sure)
                b := l.glyphs[i]
                n := label.chars().len()
                for c in 0..n
                    starts.push(b.x0 + b.w() * c / n)
                    ends.push(b.x0 + b.w() * (c + 1) / n)
            gs := l.glyphs[a..z]
            words.push(Word(
                text: text,
                x0: [b.x0 for b in gs].min() else 0,
                y0: [b.y0 for b in gs].min() else 0,
                x1: [b.x1 for b in gs].max() else 0,
                y1: [b.y1 for b in gs].max() else 0,
                sure: sure,
                starts: starts,
                ends: ends,
            ))
        k += l.glyphs.len()
        out.push(TextRow(words: words, base: l.base, size: l.size))
    out

## Glyphs that look alike (l, I, 1, |, !; o, O, 0; S, 5; Z, 2) settled
## by the word around them: digits among digits, letters among letters.
pub fn in_context(labels List[str]) List[str]
    bars := {"l", "I", "1", "|", "!"}
    rounds := {"o", "O", "0"}
    mut lower := 0
    mut upper := 0
    mut digits := 0
    for l in labels
        if bars.contains(l) or rounds.contains(l)
            continue
        for c in l.chars()
            if c >= 'a' and c <= 'z'
                lower += 1
            elif c >= 'A' and c <= 'Z'
                upper += 1
            elif c >= '0' and c <= '9'
                digits += 1
    number := digits > 0 and lower == 0 and upper == 0
    mut out := List[str]()
    for i in 0..labels.len()
        l := labels[i]
        last := i == labels.len() - 1
        if bars.contains(l)
            if number
                out.push("1")
            elif l == "!" and last and i > 0
                out.push("!")
            elif lower > 0
                out.push(if i == 0 and l == "I" then "I" else "l")
            elif upper > 0 or labels.len() == 1
                out.push("I")
            else
                out.push(l)
        elif rounds.contains(l)
            if number
                out.push("0")
            elif l == "0"
                out.push(if lower > 0 then "o" else "O")
            else
                out.push(l)
        elif number and (l == "S" or l == "s")
            out.push("5")
        elif number and (l == "Z" or l == "z")
            out.push("2")
        else
            out.push(l)
    out

## The page with OCR lines when it is a scan and OCR is on; the result is
## kept in the page cache, so each page is recognized once.
pub fn Ocr.page(self, ps reader.Pages, i int) reader.Page
    p := ps.get(i)
    if not wants(p)
        return p
    mut job := job_for(i, p)
    while not job.done
        step(mut job, ps, self)
    ps.get(i)

## Whether OCR is on and page `p` is a scan not read yet.
pub fn Ocr.wants(self, p reader.Page) bool
    on and needs_ocr(p)

fn needs_ocr(p reader.Page) bool
    p.model.image_only and not p.model.ocr

## Glyphs per feature or classify step: about a tenth of a second each on
## the interpreter, so a viewer stepping OCR between events stays
## responsive.
CHUNK := 120

## OCR of one page in steps (ADR 0512): decode an image, find its lines,
## describe and classify its glyphs a chunk at a time, place its words;
## then the next image; then the page goes into the cache. `Ocr.page` runs
## every step at once; the viewer runs them while it waits for keys.
pub struct Job
    pub page int
    base reader.Page
    img int
    stage int
    ink Ink
    lines List[GlyphLine]
    glyphs List[Blob]
    owners List[GlyphLine]
    feats List[List[float]]
    guesses List[Guess]
    out List[reader.Glyph]
    sure float
    words int
    pub done bool

pub fn job_for(i int, p reader.Page) Job
    Job(
        page: i,
        base: p,
        img: 0,
        stage: 0,
        ink: Ink(width: 0, height: 0, rows: []),
        lines: [],
        glyphs: [],
        owners: [],
        feats: [],
        guesses: [],
        out: [],
        sure: 0,
        words: 0,
        done: false,
    )

## Does one step of `job`; the last one puts the page in `ps`'s cache.
pub fn step(mut job Job, ps reader.Pages, o Ocr)
    if job.done
        return
    if job.img >= job.base.placed.len()
        ps.put(job.page, finish(job.base, job.out, job.sure, job.words))
        job.done = true
        return
    if job.stage == 0
        # Decode the image; too small to hold text, or unreadable: skip it.
        g := ink_of(ps.doc, job.base.placed[job.img].obj) else Ink(width: 0, height: 0, rows: [])
        if g.width < 64 or g.height < 32
            job.img += 1
            return
        job.ink = g
        job.stage = 1
    elif job.stage == 1
        job.lines = lines_of(blobs_of(job.ink.rows))
        job.glyphs = []
        job.owners = []
        for l in job.lines
            for b in l.glyphs
                job.glyphs.push(b)
                job.owners.push(l)
        job.feats = []
        job.guesses = []
        job.stage = 2
    elif job.stage == 2
        a := job.feats.len()
        z := (a + CHUNK).min(job.glyphs.len())
        job.feats.extend(features_of(job.glyphs[a..z], job.owners[a..z]))
        if z == job.glyphs.len()
            job.stage = 3
    elif job.stage == 3
        a := job.guesses.len()
        z := (a + CHUNK).min(job.feats.len())
        job.guesses.extend(o.shapes().classify(job.feats[a..z]))
        if z == job.feats.len()
            job.stage = 4
    else
        place(mut job, rows_of(job.lines, job.guesses))
        job.img += 1
        job.stage = 0
        job.ink = Ink(width: 0, height: 0, rows: [])

## Page `x` of the image's pixel coordinate (`u` across, at height `v` in
## its unit square) through the matrix it was painted with.
fn px_x(m List[float], u float, v float) float
    m[0] * u + m[2] * v + m[4]

fn px_y(m List[float], u float, v float) float
    m[1] * u + m[3] * v + m[5]

## Maps an image's words to page space (pixel (x, y) is (x / w, 1 - y / h)
## in the image's unit square) as glyphs for the line builder.
fn place(mut job Job, rows List[TextRow])
    m := job.base.placed[job.img].ctm
    fw := job.ink.width.to_float()
    fh := job.ink.height.to_float()
    for row in rows
        v := 1.0 - row.base.to_float() / fh
        # Tall letters stand about 0.7 em above the baseline.
        size := (m[3] * row.size.to_float() / fh).abs() / 0.7
        for w in row.words
            cs := w.text.chars()
            for c in 0..cs.len()
                u0 := w.starts[c].to_float() / fw
                # Each glyph reaches the next one, so only word gaps read
                # as spaces.
                u1 := (if c + 1 < cs.len() then w.starts[c + 1] else w.ends[c]).to_float() / fw
                x0 := px_x(m, u0, v)
                job.out.push(reader.Glyph(
                    text: "{cs[c]}",
                    x: x0,
                    y: px_y(m, u0, v),
                    w: px_x(m, u1, v) - x0,
                    size: size,
                    known: true,
                ))
            ux := w.x1.to_float() / fw
            job.out.push(reader.Glyph(
                text: " ",
                x: px_x(m, ux, v),
                y: px_y(m, ux, v),
                w: size * 0.25,
                size: size,
                known: true,
            ))
            job.sure += w.sure
            job.words += 1

## The page with OCR's glyphs as its lines.
fn finish(p reader.Page, glyphs List[reader.Glyph], sure float, words int) reader.Page
    lines := reader.lines_of(glyphs)
    mut model := p.model
    model.lines = [
        reader.TextLine(
            text: l.text,
            x: reader.r2(l.x),
            y: reader.r2(l.y),
            size: reader.r2(l.size),
            right: reader.r2(l.right()),
        )
        for l in lines
    ]
    model.ocr = true
    model.confidence = if words > 0 then reader.r2(sure / words.to_float()) else 0.0
    reader.Page(model: model, lines: lines, placed: p.placed)

## The order pages are read in the background from page `at` of `count`:
## that page, then its neighbours outwards, next before previous.
pub fn nearest_first(at int, count int) List[int]
    mut out := [at]
    for d in 1..count
        if at + d < count
            out.push(at + d)
        if at - d >= 0
            out.push(at - d)
    out

@test fn reads_outwards_from_the_page_shown()
    assert_eq(nearest_first(2, 6), [2, 3, 1, 4, 0, 5])
    assert_eq(nearest_first(0, 3), [0, 1, 2])
