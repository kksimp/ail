# Compute-bound and independent per element (conc.par.2-4): with `par for`
# the interpreter runs it on the thread pool (conc.par.8). `AIL_THREADS=1`
# runs it on one thread for comparison; the output is the same.

# The number of steps the Collatz sequence from `n` takes to reach 1.
fn steps(n int) int
    mut x := n
    mut k := 0
    while x != 1
        if x % 2 == 0
            x = x / 2
        else
            x = 3 * x + 1
        k += 1
    k

fn main()
    n := 100000
    mut lengths := List[int]()
    for _ in 0..n
        lengths.push(0)
    mut total := 0
    par for i in 0..n
        s := steps(i + 1)
        lengths[i] = s
        total += s
    mut longest := 0
    for i in 0..n
        if lengths[i] > lengths[longest]
            longest = i
    print("total steps: {total}")
    print("longest: {longest + 1} with {lengths[longest]} steps")
