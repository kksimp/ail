# Spectral norm of the infinite matrix A(i, j) = 1 / ((i+j)(i+j+1)/2 + i + 1),
# estimated by 10 power iterations on an N x N slice. Float sums in loop order.
# Plain List[float], no matrix type. N comes from argv.

fn size(default int) int
    args := env.args()
    if args.len() == 0
        return default
    n := args[0].to_int() else return default
    n

fn eval_a(i int, j int) float
    d := (i + j) * (i + j + 1) / 2 + i + 1
    1.0 / d.to_float()

fn mul_av(v List[float], n int) List[float]
    mut out := []
    for i in 0..n
        mut sum := 0.0
        for j in 0..n
            sum += eval_a(i, j) * v[j]
        out.push(sum)
    out

fn mul_atv(v List[float], n int) List[float]
    mut out := []
    for i in 0..n
        mut sum := 0.0
        for j in 0..n
            sum += eval_a(j, i) * v[j]
        out.push(sum)
    out

fn mul_ata(v List[float], n int) List[float]
    mul_atv(mul_av(v, n), n)

fn main()
    n := size(250)
    mut u := []
    for _ in 0..n
        u.push(1.0)
    mut v := []
    for _ in 0..n
        v.push(0.0)
    for _ in 0..10
        v = mul_ata(u, n)
        u = mul_ata(v, n)
    mut vbv := 0.0
    mut vv := 0.0
    for i in 0..n
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    print("{(vbv / vv).sqrt():.9}")
