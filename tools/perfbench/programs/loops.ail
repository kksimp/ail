# Tight loops for interpreter timing: integer arithmetic, list pushes, map
# updates and string building. Sized for roughly one second.

fn collatz(start int) int
    mut n := start
    mut steps := 0
    while n != 1
        if n % 2 == 0
            n = n / 2
        else
            n = 3 * n + 1
        steps += 1
    steps

fn main()
    mut total := 0
    for i in 1..30000
        total += collatz(i)
    print(total)

    mut xs := []
    for i in 0..200000
        xs.push(i * 3 % 1000)
    mut sum := 0
    for x in xs
        sum += x
    print(sum)

    mut counts := {0: 0}
    for i in 0..100000
        k := i % 500
        counts[k] = (counts.get(k) else 0) + 1
    print(counts.len())

    mut s := ""
    for i in 0..20000
        s = "{s}{i % 10}"
    print(s.chars().len())
