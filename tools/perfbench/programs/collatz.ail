# Collatz: total steps and the longest chain for starts 1 up to N (exclusive).
# Integer-only loops with no allocation: the tight-loop case. N comes from argv.

fn steps(start int) int
    mut n := start
    mut k := 0
    while n != 1
        if n % 2 == 0
            n = n / 2
        else
            n = 3 * n + 1
        k += 1
    k

fn size(default int) int
    args := env.args()
    if args.len() == 0
        return default
    n := args[0].to_int() else return default
    n

fn main()
    limit := size(100000)
    mut total := 0
    mut best := 1
    mut best_steps := 0
    for i in 1..limit
        s := steps(i)
        total += s
        if s > best_steps
            best = i
            best_steps = s
    print("total steps: {total}")
    print("longest: {best} with {best_steps} steps")
