# LZMA-style compressor and decompressor (the 7-Zip family), written from scratch:
# LZ77 matches found with hash chains over a 1 MB window and one step of lazy
# matching, then every symbol coded by an adaptive binary range coder.
#   is-match flag (context: previous token), literal bit-tree (context: top 3 bits of
#   the previous byte), match length bit-tree, distance slot bit-tree (context: length),
#   direct bits for the rest of the distance.
# Probabilities are 11 bits, adapted by 1/32. N input bytes come from argv.

fn size(default int) int
    args := env.args()
    if args.len() == 0
        return default
    n := args[0].to_int() else return default
    n

fn gen(n int) List[int]
    mut out := List[int]()
    mut seed := 7
    while out.len() < n
        seed = (seed * 3877 + 29573) % 139968
        k := seed % 32768
        for j in 0..3 + k % 7
            out.push(97 + (k * 7 + j * 3 + k / 64) % 26)
        out.push(32)
    out

# probability slots: 0..1 is-match, 2..65 length, 66..321 distance slot, 322.. literals
struct Enc
    low int
    rng int
    cache int
    cache_size int
    out List[int]
    probs List[int]

fn Enc.shift_low(mut self)
    if self.low < 4278190080 or self.low >= 4294967296
        carry := self.low.shr(32)
        mut temp := self.cache
        while true
            self.out.push((temp + carry).bit_and(255))
            temp = 255
            self.cache_size -= 1
            if self.cache_size == 0
                break
        self.cache = self.low.shr(24).bit_and(255)
    self.cache_size += 1
    self.low = self.low.bit_and(16777215).shl(8)

fn Enc.bit(mut self, idx int, b int)
    p := self.probs[idx]
    bound := self.rng.shr(11) * p
    if b == 0
        self.rng = bound
        self.probs[idx] = p + (2048 - p).shr(5)
    else
        self.low += bound
        self.rng -= bound
        self.probs[idx] = p - p.shr(5)
    while self.rng < 16777216
        self.rng = self.rng.shl(8)
        self.shift_low()

fn Enc.direct(mut self, v int, nbits int)
    mut i := nbits - 1
    while i >= 0
        self.rng = self.rng.shr(1)
        if v.shr(i).bit_and(1) == 1
            self.low += self.rng
        while self.rng < 16777216
            self.rng = self.rng.shl(8)
            self.shift_low()
        i -= 1

fn Enc.tree(mut self, base int, nbits int, v int)
    mut m := 1
    mut i := nbits - 1
    while i >= 0
        b := v.shr(i).bit_and(1)
        self.bit(base + m, b)
        m = m * 2 + b
        i -= 1

struct Dec
    code int
    rng int
    pos int
    data List[int]
    probs List[int]

fn Dec.next(mut self) int
    b := self.data[self.pos]
    self.pos += 1
    b

fn Dec.bit(mut self, idx int) int
    p := self.probs[idx]
    bound := self.rng.shr(11) * p
    mut r := 0
    if self.code < bound
        self.rng = bound
        self.probs[idx] = p + (2048 - p).shr(5)
    else
        self.code -= bound
        self.rng -= bound
        self.probs[idx] = p - p.shr(5)
        r = 1
    if self.rng < 16777216
        self.rng = self.rng.shl(8)
        x := self.next()
        self.code = self.code.shl(8).bit_or(x)
    r

fn Dec.direct(mut self, nbits int) int
    mut v := 0
    for _ in 0..nbits
        self.rng = self.rng.shr(1)
        mut b := 0
        if self.code >= self.rng
            self.code -= self.rng
            b = 1
        v = v.shl(1).bit_or(b)
        if self.rng < 16777216
            self.rng = self.rng.shl(8)
            x := self.next()
            self.code = self.code.shl(8).bit_or(x)
    v

fn Dec.tree(mut self, base int, nbits int) int
    mut m := 1
    mut top := 1
    for _ in 0..nbits
        m = m * 2 + self.bit(base + m)
        top *= 2
    m - top

fn hash3(a int, b int, c int) int
    ((a * 65536 + b * 256 + c) * 2654435761).bit_and(4294967295).shr(12)

fn insert(mut head List[int], mut prev List[int], data List[int], p int, n int)
    if p + 2 < n
        h := hash3(data[p], data[p + 1], data[p + 2])
        prev[p] = head[h]
        head[h] = p

fn find(data List[int], head List[int], prev List[int], i int, n int) int
    mut best_len := 0
    mut best_dist := 0
    if i + 2 < n
        mut cand := head[hash3(data[i], data[i + 1], data[i + 2])]
        mut chain := 0
        while cand >= 0 and i - cand <= 1048576 and chain < 32
            mut l := 0
            while l < 66 and i + l < n and data[cand + l] == data[i + l]
                l += 1
            if l > best_len
                best_len = l
                best_dist = i - cand
            cand = prev[cand]
            chain += 1
    if best_len < 3
        return 0
    best_len * 2097152 + best_dist

fn dist_slot(d int) int
    if d < 4
        return d
    mut n := 0
    mut t := d
    while t > 1
        t = t.shr(1)
        n += 1
    2 * n + d.shr(n - 1).bit_and(1)

fn compress(data List[int]) List[int]
    n := data.len()
    mut head := [-1 for _ in 0..1048576]
    mut prev := [-1 for _ in 0..n]
    mut e := Enc(
        low: 0,
        rng: 4294967295,
        cache: 0,
        cache_size: 1,
        out: [],
        probs: [1024 for _ in 0..2400],
    )
    mut ins := 0
    mut st := 0
    mut i := 0
    while i < n
        while ins < i
            insert(mut head, mut prev, data, ins, n)
            ins += 1
        mut m := find(data, head, prev, i, n)
        if m > 0 and i + 1 < n
            while ins < i + 1
                insert(mut head, mut prev, data, ins, n)
                ins += 1
            if find(data, head, prev, i + 1, n) / 2097152 > m / 2097152 + 1
                m = 0
        if m > 0
            l := m / 2097152 - 3
            d := m % 2097152 - 1
            e.bit(st, 1)
            e.tree(2, 6, l)
            slot := dist_slot(d)
            e.tree(66 + l.min(3) * 64, 6, slot)
            if slot >= 4
                nb := slot.shr(1) - 1
                e.direct(d - (2 + slot.bit_and(1)).shl(nb), nb)
            st = 1
            i += l + 3
        else
            ctx := if i > 0 then data[i - 1].shr(5) else 0
            e.bit(st, 0)
            e.tree(322 + ctx * 256, 8, data[i])
            st = 0
            i += 1
    for _ in 0..5
        e.shift_low()
    e.out

fn decompress(comp List[int], n int) List[int]
    mut d := Dec(code: 0, rng: 4294967295, pos: 1, data: comp, probs: [1024 for _ in 0..2400])
    for _ in 0..4
        x := d.next()
        d.code = d.code.shl(8).bit_or(x)
    mut out := List[int]()
    mut st := 0
    while out.len() < n
        if d.bit(st) == 0
            ctx := if out.len() > 0 then out[out.len() - 1].shr(5) else 0
            out.push(d.tree(322 + ctx * 256, 8))
            st = 0
        else
            l := d.tree(2, 6)
            slot := d.tree(66 + l.min(3) * 64, 6)
            mut dist := slot
            if slot >= 4
                nb := slot.shr(1) - 1
                dist = (2 + slot.bit_and(1)).shl(nb) + d.direct(nb)
            start := out.len() - (dist + 1)
            for k in 0..l + 3
                out.push(out[start + k])
            st = 1
    out

fn main()
    n := size(12000000)
    data := gen(n)
    comp := compress(data)
    back := decompress(comp, data.len())
    mut cks := 0
    for u in comp
        cks = (cks * 31 + u) % 1000000007
    print("input {data.len()}")
    print("compressed {comp.len()}")
    print("permille {comp.len() * 1000 / data.len()}")
    print("checksum {cks}")
    print("roundtrip {back == data}")
