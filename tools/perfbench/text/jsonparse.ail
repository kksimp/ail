# std.json: parse a document of N records, print it back, and compare, R times.
# The twin jsonparse.py gives the same output with the json module.
fn size(at int, default int) int
    args := env.args()
    if args.len() <= at
        return default
    n := args[at].to_int() else return default
    n

fn record(i int) Json
    tags := [Json.Str("a{i % 5}"), Json.Str("tag \u{e9} {i % 11}"), Json.Str("x")]
    Json.Obj([
        JsonMember("id", Json.Num(i.to_float())),
        JsonMember("name", Json.Str("item {i}\t\"q\"\nline \u{e9}")),
        JsonMember("score", Json.Num((i % 7).to_float() + 0.5)),
        JsonMember("ok", Json.Bool(i % 2 == 0)),
        JsonMember("note", Json.Null),
        JsonMember("tags", Json.Arr(tags)),
    ])

fn main()
    n := size(0, 2000)
    reps := size(1, 20)
    mut items := List[Json]()
    for i in 0..n
        items.push(record(i))
    text := Json.Arr(items).to_text()
    mut same := 0
    for _ in 0..reps
        doc := parse_json(text) else
            return
        if doc.to_text() == text
            same += 1
    print("records {n} chars {text.chars().len()} same {same}")
