fn size(default int) int
    args := env.args()
    if args.len() == 0
        return default
    n := args[0].to_int() else return default
    n

fn main()
    n := size(30000000)
    mut keep := List[str]()
    for i in 0..500000
        keep.push("row {i}")
    mut total := 0
    for i in 0..n
        s := "{i}"
        total += s.len()
    print("chars {total} keep {keep[499999]}")
